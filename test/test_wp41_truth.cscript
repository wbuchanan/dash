* ==== S03 BY-27: per-panel range(varname) ====
local only : env WP41_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w41_run' {
    display as text "S03 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4103-2: function and kdensity range(weight) under by() span each
    // panel's own weight, as twoway's generators summarise it per panel
    // (by_scale_range_truth.json R01-R03; Total = every row by() keeps).
    // twoway's pairs are its panels' summarize, measured here.
    // ------------------------------------------------------------
    local q2d "`w41_work'/q2"
    capture mkdir "`q2d'"
    foreach q2 in "foreign|0 1|" "rep78, total|1 2 3 4 5|total" {
        gettoken q2by q2 : q2, parse("|")
        gettoken _bar q2 : q2, parse("|")
        gettoken q2lev q2 : q2, parse("|")
        gettoken _bar q2tot : q2, parse("|")
        local q2var = word(subinstr("`q2by'", ",", " ", .), 1)
        sysuse auto, clear
        local q2want ""
        foreach k of local q2lev {
            quietly summarize weight if `q2var' == `k', meanonly
            local q2want "`q2want'|`=strofreal(r(min), "%21.0g")' `=strofreal(r(max), "%21.0g")'"
        }
        if "`q2tot'" != "" {
            quietly summarize weight if !missing(`q2var'), meanonly
            local q2want "`q2want'|`=strofreal(r(min), "%21.0g")' `=strofreal(r(max), "%21.0g")'"
        }
        local q2want = substr("`q2want'", 2, .)
        capture noisily twoway (scatter mpg weight) (function y=40-x/200, range(weight)), by(`q2by') name(w41q2, replace)
        local q2twrc = _rc
        capture graph drop w41q2
        dash clear
        capture noisily dash (scatter mpg weight) (function y=40-x/200, range(weight)), by(`q2by') name(q2)
        local q2rc = _rc
        _w41_expect Q4103-2 "(`q2twrc' == 0 & `q2rc' == 0)" "function by(`q2by'): twoway rc `q2twrc', dash rc `q2rc'"
        capture erase "`q2d'/fn.json"
        capture noisily _dash_serve_spec, specpath("`q2d'/fn.json") datapath("`q2d'/fnd.json")
        python: __import__("__main__")._q4103_panels("`q2d'/fn.json", "q4103_got")
        python: __import__("__main__")._q4103_close("${q4103_got}", "`q2want'", "q4103_bad")
        _w41_expect Q4103-2 `"("${q4103_bad}" == "")"' `"function by(`q2by'): ${q4103_bad}"'
        if "`q2tot'" == "" {
            dash clear
            capture noisily dash (scatter mpg weight) (kdensity weight, range(weight)), by(`q2by') name(q2k)
            local q2rc = _rc
            _w41_expect Q4103-2 "(`q2rc' == 0)" "kdensity by(`q2by'): dash rc `q2rc'"
            capture erase "`q2d'/kd.json"
            capture noisily _dash_serve_spec, specpath("`q2d'/kd.json") datapath("`q2d'/kdd.json")
            python: __import__("__main__")._q4103_panels("`q2d'/kd.json", "q4103_got")
            python: __import__("__main__")._q4103_close("${q4103_got_kd}", "`q2want'", "q4103_bad")
            _w41_expect Q4103-2 `"("${q4103_bad}" == "")"' `"kdensity by(`q2by'): ${q4103_bad}"'
            // The one-segment form holds by() twice (the segment's and
            // the graph's); each panel still has its own pair.
            dash clear
            capture noisily dash kdensity weight, range(weight) by(`q2by') name(q2k1)
            local q2rc = _rc
            _w41_expect Q4103-2 "(`q2rc' == 0)" "one-segment kdensity by(`q2by'): dash rc `q2rc'"
            capture erase "`q2d'/kd.json"
            capture noisily _dash_serve_spec, specpath("`q2d'/kd.json") datapath("`q2d'/kdd.json")
            python: __import__("__main__")._q4103_panels("`q2d'/kd.json", "q4103_got")
            python: __import__("__main__")._q4103_close("${q4103_got_kd}", "`q2want'", "q4103_bad")
            _w41_expect Q4103-2 `"("${q4103_bad}" == "")"' `"one-segment kdensity by(`q2by'): ${q4103_bad}"'
        }
    }
    _w41_done Q4103-2 "function and kdensity range(weight) span each by() panel's own weight, as twoway draws them"
    macro drop q4103_got q4103_got_kd q4103_bad
    foreach f in fn fnd kd kdd {
        capture erase "`q2d'/`f'.json"
    }
    capture rmdir "`q2d'"

    // ------------------------------------------------------------
    // Q4103-3: _dash_range_panel takes the p-th "|"-separated pair.
    // ------------------------------------------------------------
    capture mata: st_local("q3a", _dash_range_panel("1 2|3 4|. .", 2))
    local q3rc = _rc
    capture mata: st_local("q3b", _dash_range_panel("1 2|3 4|. .", 3))
    capture mata: st_local("q3c", _dash_range_panel("1 2|3 4|. .", 4))
    capture mata: st_local("q3d", _dash_range_panel("", 1))
    _w41_expect Q4103-3 "(`q3rc' == 0)" "_dash_range_panel is not defined (rc `q3rc')"
    _w41_expect Q4103-3 `"("`q3a'" == "3 4" & "`q3b'" == ". ." & "`q3c'" == "" & "`q3d'" == "")"' `"got [`q3a'] [`q3b'] [`q3c'] [`q3d']"'
    _w41_done Q4103-3 "_dash_range_panel returns the p-th pair, empty out of range"
    dash clear
    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

// S04 helpers (BY-3, BY-13, BY-14): the by() grid of the saved page
// $W41_S04_PAGE (each <script type="application/json"> block loaded as
// a Bokeh document, as test_wp29_truth.cscript's _fx_plots_saved loads
// it): the GridPlot whose children hold a dash_by_* cell, each child's
// name ("" for a panel) and (row, col).
python:
_w41_s04_kids = []


def _w41_s04_read():
    import re as _re, json as _json
    from sfi import Macro as _M
    from bokeh.document import Document as _Doc
    from bokeh.models import GridPlot as _Grid
    with open(_M.getGlobal("W41_S04_PAGE"), encoding="utf-8") as _fh:
        _page = _fh.read()
    del _w41_s04_kids[:]
    for _blob in _re.findall(r'<script type="application/json" id="[^"]*">\s*(.*?)\s*</script>', _page, _re.S):
        for _dd in _json.loads(_blob).values():
            for _g in _Doc.from_json(_dd).select(dict(type=_Grid)):
                _ch = [(str(getattr(_c[0], "name", "") or ""), int(_c[1]), int(_c[2])) for _c in _g.children]
                if any(_n.startswith("dash_by_") for _n, _r, _c in _ch):
                    _w41_s04_kids.extend(_ch)


def _w41_s04_ans(ok):
    from sfi import Macro as _M
    _M.setGlobal("W41_S04_ANS", "1" if ok else "0")


def _w41_s04_hole1():
    """1 when the two panels sit in cells 2 and 3 of a 2 x 2 grid and no
    child sits in cell 1."""
    _p = [(r, c) for n, r, c in _w41_s04_kids if not n.startswith("dash_by_")]
    if len(_p) != 2:
        return _w41_s04_ans(False)
    r0, c0 = min(r for r, c in _p), min(c for r, c in _p)
    _w41_s04_ans(sorted(_p) == [(r0, c0 + 1), (r0 + 1, c0)] and not [
        1 for n, r, c in _w41_s04_kids if (r, c) == (r0, c0)])


def _w41_s04_below(name):
    """1 when cell *name* sits below every panel."""
    _p = [r for n, r, c in _w41_s04_kids if not n.startswith("dash_by_")]
    _k = [r for n, r, c in _w41_s04_kids if n == name]
    _w41_s04_ans(bool(_p) and len(_k) == 1 and _k[0] > max(_p))


def _w41_s04_has(name):
    """1 when the grid holds a cell *name*."""
    _w41_s04_ans(any(n == name for n, r, c in _w41_s04_kids))
end

* ==== S04 BY-3: by() at() holes ====
local only : env WP41_ONLY
if inlist("`only'", "", "S04") & `: list posof "S04" in w41_run' {
    display as text "S04 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4104-1: by(foreign, legend(off at(1))) keeps cell 1 empty whether
    // or not the legend is drawn: the panels in cells 2 and 3 of a 2 x 2
    // grid, as twoway's legend_hole (1, read live) places them
    // (by_chrome_truth.json K02).
    // ------------------------------------------------------------
    dash clear
    sysuse auto, clear
    capture noisily twoway (scatter mpg weight) (lfit mpg weight), by(foreign, legend(off at(1))) nodraw name(_q4104, replace)
    _w41_expect Q4104-1 "(_rc == 0)" "twoway ... by(foreign, legend(off at(1))) rc `=_rc'"
    _w41_expect Q4104-1 "(0`._q4104.legend_hole' == 1)" "twoway's legend_hole is not 1"
    capture graph drop _q4104
    capture erase "`w41_work'/q4104_1.html"
    quietly log using "`w41_work'/q4104_1.log", text replace name(_q4104)
    capture noisily dash (scatter mpg weight) (lfit mpg weight), by(foreign, legend(off at(1))) saving("`w41_work'/q4104_1.html", replace)
    local q1rc = _rc
    quietly log close _q4104
    _w41_expect Q4104-1 "(`q1rc' == 0)" "dash ... saving() rc `q1rc'"
    cert_log_has "`w41_work'/q4104_1.log", needle("not implemented")
    _w41_expect Q4104-1 "(r(found) == 0)" "the build named a by() sub-option as not implemented"
    global W41_S04_PAGE "`w41_work'/q4104_1.html"
    capture noisily python: _w41_s04_read()
    _w41_expect Q4104-1 "(_rc == 0)" "the page could not be read (rc `=_rc')"
    capture noisily python: _w41_s04_hole1()
    _w41_expect Q4104-1 "(0${W41_S04_ANS} == 1)" "the panels are not in cells 2 and 3 with cell 1 empty"
    _w41_done Q4104-1 "by()'s undrawn legend keeps its at() hole, as twoway keeps it"
    macro drop W41_S04_PAGE W41_S04_ANS
    capture erase "`w41_work'/q4104_1.log"
    capture erase "`w41_work'/q4104_1.html"
    dash clear

    display as text "S04 end " c(current_date) " " c(current_time)
}
