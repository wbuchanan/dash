*! test_wp41_truth.cscript
*! WP-41's ONE certification script (.ultraplan/sections/index.md PD-6):
*! every comparison with twoway's drawing or with Stata's own values that
*! WP-41's sections need lives here, one block per GAPS4 row (or per
*! harness tool), appended above the "append new blocks above this line"
*! marker in section order.  Refusal, message and return-code checks join
*! the EXISTING script for their area (merge rule R1).
*!
*! Made from test/templates/wp_truth_template.cscript (41 -> the WP's
*! number).  S00 is the scaffold smoke (Q4100-1).  A section appends
*! `* ==== S<MM> <lead id>: <what> ====` ... `* ==== end S<MM> ====` (or
*! `S<MM> tool: <what>` for a section with no item), its helper programs
*! directly above its first header, and writes only inside its own
*! blocks.  Case ids are Q41<MM>-<k> (PD-5).
*!
*! Usage: via run_all_cscripts.do.  One block alone: WP41_ONLY=S<MM> in
*! the driver's environment.  Each block prints "S<MM> start" and "S<MM>
*! end" with the date and time.  The suite runs it in every session;
*! DASH_CERT_SHARD=k/N runs part k of N of the blocks; a part with no
*! block ends 0.

cscript "WP-41 truth: twoway comparisons" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off


do "cert_helpers.do"
quietly do "cert_svg.do"
qui do "../dash_parse.mata"
qui do "../dash.ado"
global dash_nobrowser 1

// ----------------------------------------------------------------
// Tally helpers -- test_wp29_truth.cscript's _w29_expect/_w29_done,
// renamed _w41_ for this script.  A case is any number of
// _w41_expect lines closed by one _w41_done.
// ----------------------------------------------------------------
global w41_nfail    = 0
global w41_faillist ""
global w41_bad      = 0
global w41_ncase    = 0

capture program drop _w41_expect
program define _w41_expect
    version 19
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global w41_bad = 1
    }
end

capture program drop _w41_done
program define _w41_done
    version 19
    args id msg
    if ${w41_bad} {
        global w41_nfail    = ${w41_nfail} + 1
        global w41_faillist "${w41_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global w41_bad   = 0
    global w41_ncase = ${w41_ncase} + 1
end

// A fresh directory for this run's files, never one that already exists:
// a fixed name in a shared temp directory could be planted by another
// account (rule 1), so a name Stata has not handed out before is made and
// the run fails if it cannot be.  Every block writes only under it.
tempfile w41_base
local w41_work "`w41_base'_w41"
capture mkdir "`w41_work'"
if _rc {
    display as error "test_wp41_truth: cannot create the work directory `w41_work' (rc `=_rc')"
    exit 9
}

// ---- parts: begin (WP-41 test performance) ----
// The certification suite runs this script in every one of its sessions
// (its row in run_all_cscripts.do's shard table is "* * *"); with
// DASH_CERT_SHARD=k/N set, the session runs part k of N of the blocks.
// The parts are balanced longest first onto the least loaded part (the
// lowest numbered of equals), by the seconds below -- a block not listed
// counts 1 s (section-01 D-01.f) -- the rule scripts/cert_shards.py uses
// for the scripts.  Unset, or with WP41_ONLY set
// (which keeps its precedence), every block runs.  A block runs when its
// gate finds its id in w41_run.
// Seconds: each block's start/end lines in the WP's last measured
// certification run, rounded up, at least 1; a block not listed
// counts 1 s.
local w41_secs S00 1
local w41_sh : environment DASH_CERT_SHARD
mata: st_local("w41_ok", strofreal(st_local("w41_sh") == "" | ustrregexm(st_local("w41_sh"), "^[1-4]/[1-4]$")))
if !`w41_ok' {
    display as error "test_wp41_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 4"
    exit 198
}
local w41_k 1
local w41_N 1
if "`w41_sh'" != "" {
    local w41_k = real(substr("`w41_sh'", 1, 1))
    local w41_N = real(substr("`w41_sh'", 3, 1))
}
local w41_only : env WP41_ONLY
if `"`macval(w41_only)'"' != "" | `w41_N' == 1 {
    local w41_k 1
    local w41_N 1
}
if `w41_k' > `w41_N' {
    display as error "test_wp41_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 4"
    exit 198
}
capture confirm file "test_wp41_truth.cscript"
if _rc {
    display as error "test_wp41_truth: run it from test/, where it reads its own blocks"
    exit 601
}
capture mata: mata drop _w41_part()
mata:
// The ids of the blocks (their header lines, in file order), and those of
// part k of n: longest first onto the least loaded part.
void _w41_part(string scalar file, string scalar table, real scalar k,
               real scalar n)
{
    string colvector lines, ids
    string rowvector tok
    real colvector sec, o, at
    real rowvector load
    real scalar i, j, p, best
    string scalar run

    lines = cat(file)
    ids = J(0, 1, "")
    for (i = 1; i <= rows(lines); i++) {
        if (ustrregexm(lines[i], "^\* ==== (S[0-9]+) ")) {
            if (!anyof(ids, ustrregexs(1))) ids = ids \ ustrregexs(1)
        }
    }
    sec = J(rows(ids), 1, 1)
    tok = tokens(table)
    for (j = 1; j + 1 <= cols(tok); j = j + 2) {
        for (i = 1; i <= rows(ids); i++) {
            if (ids[i] == tok[j]) sec[i] = strtoreal(tok[j + 1])
        }
    }
    o = order((-sec, (1::rows(ids))), (1, 2))
    load = J(1, n, 0)
    at = J(rows(ids), 1, 0)
    for (i = 1; i <= rows(o); i++) {
        best = 1
        for (p = 2; p <= n; p++) if (load[p] < load[best]) best = p
        load[best] = load[best] + sec[o[i]]
        at[o[i]] = best
    }
    run = ""
    for (i = 1; i <= rows(ids); i++) if (at[i] == k) run = run + " " + ids[i]
    st_local("w41_run", strtrim(run))
}
end
mata: _w41_part("test_wp41_truth.cscript", st_local("w41_secs"), `w41_k', `w41_N')
display as text "test_wp41_truth: part `w41_k'/`w41_N' runs `: word count `w41_run'' blocks: `w41_run'"
// ---- parts: end ----

* ==== S00 scaffold: the helpers load and a twoway SVG is read ====
local only : env WP41_ONLY
if inlist("`only'", "", "S00") & `: list posof "S00" in w41_run' {
    display as text "S00 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4100-1: cert_svg_export and cert_svg_texts on one twoway scatter,
    // and dash's own programs are loaded from this tree.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(w41s01, replace)
    cert_svg_export, name(w41s01) file("`w41_work'/w41s01.svg")
    local s01_rc   = r(rc)
    local s01_file "`r(file)'"
    _w41_expect Q4100-1 "(`s01_rc' == 0)" "cert_svg_export rc `s01_rc'"
    capture confirm file "`s01_file'"
    _w41_expect Q4100-1 "(_rc == 0)" "r(file) `s01_file' does not exist"
    cert_svg_texts, file("`s01_file'")
    local s01_n    = r(n)
    local s01_list "`r(list)'"
    _w41_expect Q4100-1 "(`s01_n' > 0)" "cert_svg_texts found no text elements"
    capture program list _dash_serve
    _w41_expect Q4100-1 "(_rc == 0)" "dash.ado's _dash_serve is not loaded"
    _w41_done Q4100-1 "a twoway SVG was written and read (`s01_n' texts); dash is loaded"

    capture erase "`s01_file'"
    capture erase "`s01_list'"
    capture graph drop w41s01
    display as text "S00 end " c(current_date) " " c(current_time)
}
* ==== end S00 ====

// S01 helpers (WP-41 BY-28).  _w41s01_cuts: the inner levels of every
// contour layer (ContourRenderer tagged dash_contour) of the saved page
// <path>, each compared with the cuts in global w41s01_want to 1e-9;
// "" into global w41s01_v when every layer matches, else what differs,
// and the number of layers into global w41s01_n.
python:
import base64 as _w41s01_b64
import gzip as _w41s01_gzip
import json as _w41s01_json
import re as _w41s01_re
import struct as _w41s01_struct
from html import unescape as _w41s01_unescape
from sfi import Macro as _w41s01_M


def _w41s01_dec(v):
    """A list of the page's JSON as floats (an encoded array decoded)."""
    if isinstance(v, dict) and v.get("type") == "ndarray":
        arr = v.get("array")
        if isinstance(arr, dict) and arr.get("type") == "bytes":
            raw = _w41s01_b64.b64decode(arr.get("data", ""))
            if raw[:2] == b"\x1f\x8b":
                raw = _w41s01_gzip.decompress(raw)
            f = {"float64": "d", "float32": "f", "int32": "i",
                 "int64": "q"}.get(str(v.get("dtype")))
            if f is None:
                return []
            n = len(raw) // _w41s01_struct.calcsize(f)
            return [float(x) for x in _w41s01_struct.unpack(
                "<%d%s" % (n, f), raw[:n * _w41s01_struct.calcsize(f)])]
        v = arr
    return [float(x) for x in v] if isinstance(v, list) else []


def _w41s01_cuts(path):
    bad, n = [], 0
    try:
        want = [float(t) for t in _w41s01_M.getGlobal("w41s01_want").split()]
        page = open(path, encoding="utf-8").read()
        m = _w41s01_re.search(
            r'<script[^>]+type=["\']application/json["\'][^>]*>', page)
        body = page[m.end():page.index("</script>", m.end())]
        objs = []

        def walk(node):
            if isinstance(node, dict):
                if node.get("name") == "ContourRenderer":
                    objs.append(node)
                for v in node.values():
                    walk(v)
            elif isinstance(node, list):
                for v in node:
                    walk(v)

        walk(_w41s01_json.loads(_w41s01_unescape(body)))
        for o in objs:
            a = o.get("attributes") or {}
            if "dash_contour" not in (a.get("tags") or []):
                continue
            n += 1
            got = _w41s01_dec(a.get("levels", []))[1:-1]
            if len(got) != len(want) or any(
                    abs(g - w) > 1e-9 * max(1.0, abs(w))
                    for g, w in zip(got, want)):
                bad.append("layer %d cut at %s" % (n, " ".join(
                    "%g" % g for g in got)))
    except Exception as e:
        bad.append("error " + str(e))
    _w41s01_M.setGlobal("w41s01_v", "; ".join(bad)[:400].replace(
        '"', "'").replace("`", "'").replace("$", "S"))
    _w41s01_M.setGlobal("w41s01_n", str(n))
end

* ==== S01 BY-28: contour under by() cut at the first panel's cuts ====
local only : env WP41_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w41_run' {
    display as text "S01 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4101-1: every by() panel of dash's contour, the Total panel too,
    // is cut at twoway's first panel's cuts (lastcuts after export):
    // by(nf) with Foreign first, by(rep78, total) and levels(4).
    // ------------------------------------------------------------
    sysuse auto, clear
    generate byte nf = 1 - foreign
    local s01_h "`w41_work'/q4101.html"
    local s01_s "`w41_work'/q4101.svg"
    local s01_c1 "contour price mpg weight, by(nf)"
    local s01_c2 "contour price mpg weight, by(rep78, total)"
    local s01_c3 "contour price mpg weight, levels(4) by(nf)"
    forvalues k = 1/3 {
        local cmd "`s01_c`k''"
        capture noisily twoway `cmd' name(w41q1, replace)
        _w41_expect Q4101-1 "(_rc == 0)" "twoway `cmd': rc `=_rc'"
        capture erase "`s01_s'"
        cert_svg_export, name(w41q1) file("`s01_s'")
        local np = `.w41q1.graphs.arrnels'
        local want "`.w41q1.graphs[1].plotregion1.plot1.lastcuts'"
        _w41_expect Q4101-1 `"("`want'" != "")"' "twoway `cmd': no lastcuts"
        capture erase "`s01_h'"
        capture noisily dash `cmd' saving("`s01_h'", replace)
        _w41_expect Q4101-1 "(_rc == 0)" "dash `cmd': rc `=_rc'"
        global w41s01_want "`want'"
        python: _w41s01_cuts(r"`s01_h'")
        _w41_expect Q4101-1 `"("${w41s01_v}" == "")"' "dash `cmd': ${w41s01_v}; twoway `want'"
        _w41_expect Q4101-1 "(${w41s01_n} == `np')" "dash `cmd': ${w41s01_n} layers, twoway `np' panels"
        capture dash clear
    }
    _w41_done Q4101-1 "every by() panel cut at the first panel's cuts, as twoway cuts it"

    capture erase "`s01_h'"
    capture erase "`s01_s'"
    capture graph drop w41q1
    macro drop w41s01_*
    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====

// S02 helpers (BY-1, BY-12): the saved page $W41_S02_PAGE's by() cells,
// each Plot named dash_by_* mapped to the texts of the Titles it
// references (each <script type="application/json"> block loaded as a
// Bokeh document, as test_wp29_truth.cscript's _fx_plots_saved loads it).
python:
_w41_s02_cells = {}


def _w41_s02_read():
    import re as _re, json as _json
    from sfi import Macro as _M
    from bokeh.document import Document as _Doc
    from bokeh.models import Plot as _Plot, Title as _Title
    with open(_M.getGlobal("W41_S02_PAGE"), encoding="utf-8") as _fh:
        _page = _fh.read()
    _w41_s02_cells.clear()
    for _blob in _re.findall(r'<script type="application/json" id="[^"]*">\s*(.*?)\s*</script>', _page, _re.S):
        for _dd in _json.loads(_blob).values():
            for _p in _Doc.from_json(_dd).select(dict(type=_Plot)):
                _nm = str(_p.name or "")
                if _nm.startswith("dash_by_"):
                    _w41_s02_cells.setdefault(_nm, []).extend(
                        str(_m.text) for _m in _p.references()
                        if isinstance(_m, _Title) and _m.text)


def _w41_s02_has(name, text):
    """$W41_S02_ANS = 1 when cell *name* holds a Title *text*, else 0."""
    from sfi import Macro as _M
    _M.setGlobal("W41_S02_ANS",
                 "1" if text in _w41_s02_cells.get(name, []) else "0")


def _w41_s02_none(start):
    """$W41_S02_ANS = 1 when no dash_by_* cell holds a Title that starts
    with *start*, else 0."""
    from sfi import Macro as _M
    _bad = [t for v in _w41_s02_cells.values() for t in v
            if t.startswith(start)]
    _M.setGlobal("W41_S02_ANS", "0" if _bad else "1")
end

* ==== S02 BY-1: by() ring(0) chrome ====
local only : env WP41_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w41_run' {
    display as text "S02 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4102-1: by(foreign, note("NNN", ring(0))) draws NNN in the foot
    // cell in place of "Graphs by", as twoway draws it (by_text_truth.json
    // bp68); the build names nothing as not implemented.
    // ------------------------------------------------------------
    dash clear
    sysuse auto, clear
    capture noisily dash scatter mpg weight, by(foreign, note("NNN", ring(0))) name(q1)
    _w41_expect Q4102-1 "(_rc == 0)" "dash scatter ... by(foreign, note(..., ring(0))) rc `=_rc'"
    capture erase "`w41_work'/q4102_1.html"
    quietly log using "`w41_work'/q4102_1.log", text replace name(_q4102)
    capture noisily dash build, saving("`w41_work'/q4102_1.html", replace) nobrowser
    local q1rc = _rc
    quietly log close _q4102
    _w41_expect Q4102-1 "(`q1rc' == 0)" "dash build rc `q1rc'"
    cert_log_has "`w41_work'/q4102_1.log", needle("not implemented")
    _w41_expect Q4102-1 "(r(found) == 0)" "the build named a by() sub-option as not implemented"
    global W41_S02_PAGE "`w41_work'/q4102_1.html"
    capture noisily python: _w41_s02_read()
    _w41_expect Q4102-1 "(_rc == 0)" "the page could not be read (rc `=_rc')"
    capture noisily python: _w41_s02_has("dash_by_foot", "NNN")
    _w41_expect Q4102-1 "(${W41_S02_ANS} == 1)" "the foot cell holds no Title NNN"
    capture noisily python: _w41_s02_none("Graphs by")
    _w41_expect Q4102-1 "(${W41_S02_ANS} == 1)" "a by() cell still holds the Graphs by note"
    _w41_done Q4102-1 "by()'s ring(0) note is drawn in the foot cell in place of Graphs by"
    macro drop W41_S02_PAGE W41_S02_ANS
    capture erase "`w41_work'/q4102_1.log"
    capture erase "`w41_work'/q4102_1.html"
    dash clear

    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

python:
def _q4103_panels(sp, glob):
    """global *glob* = each panel's "lo hi" of the function layer's x in
    dash's spec at *sp* (x0 to x0 + dx (n - 1)), "|"-joined in panel
    order (WP-41 BY-27), and
    glob + "_kd" = the first kdensity layer's range_panels option."""
    import json
    from sfi import Macro
    spec = json.load(open(sp, encoding="utf-8"))
    out = []
    for tab in (spec.get("function_points") or {}).values():
        for pts in tab.values():
            pan = (pts or {}).get("panels")
            if not isinstance(pan, dict):
                out.append("flat")
                continue
            for k in sorted(pan, key=int):
                pk = pan[k] or {}
                n = len(pk.get("y") or [])
                if not n:
                    out.append(". .")
                    continue
                x0, dx = float(pk["x0"]), float(pk.get("dx") or 0.0)
                out.append("%.17g %.17g" % (x0, x0 + dx * (n - 1)))
    Macro.setGlobal(glob, "|".join(out))
    kd = ""
    for g in spec.get("graphs") or []:
        for pl in g.get("plots") or []:
            if pl.get("type") == "kdensity" and not kd:
                kd = str((pl.get("options") or {}).get("range_panels") or "")
    Macro.setGlobal(glob + "_kd", kd)


def _q4103_close(got, want, glob):
    """global *glob* = "" when the "|"-joined "lo hi" pairs *got* equal
    *want* (relative 1e-9), else what differs."""
    from sfi import Macro
    g = [p.split() for p in got.split("|")] if got else []
    w = [p.split() for p in want.split("|")] if want else []
    bad = ""
    if len(g) != len(w):
        bad = "%d panels, twoway %d (%s)" % (len(g), len(w), got)
    else:
        for i, (a, b) in enumerate(zip(g, w)):
            try:
                ok = all(abs(float(x) - float(y)) <= 1e-9 * max(1.0, abs(float(y)))
                         for x, y in zip(a, b)) and len(a) == len(b)
            except ValueError:
                ok = a == b
            if not ok:
                bad = "panel %d: dash %s, twoway %s" % (i + 1, " ".join(a), " ".join(b))
                break
    Macro.setGlobal(glob, bad)
end

* ==== S03 BY-2: by() scale() ====
local only : env WP41_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w41_run' {
    display as text "S03 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4103-1: by(, scale(1.5)) is drawn, as twoway draws it (by_scale_
    // range_truth.json S03: every text 1.5 x), so the build no longer
    // names it as ignored.  The note is printed by Python at build.
    // ------------------------------------------------------------
    sysuse auto, clear
    dash clear
    capture noisily twoway scatter mpg weight, by(foreign, scale(1.5)) name(w41q1, replace)
    local q1_twrc = _rc
    capture graph drop w41q1
    capture noisily dash scatter mpg weight, by(foreign, scale(1.5)) name(q1)
    local q1_rc = _rc
    capture erase "`w41_work'/q1.html"
    quietly log using "`w41_work'/q1.log", text replace name(_q4103) nomsg
    capture noisily dash build, saving("`w41_work'/q1.html", replace) nobrowser
    local q1_brc = _rc
    quietly log close _q4103
    cert_log_has "`w41_work'/q1.log", needle("not implemented and ignored")
    local q1_found = r(found)
    _w41_expect Q4103-1 "(`q1_twrc' == 0)" "twoway rc `q1_twrc'"
    _w41_expect Q4103-1 "(`q1_rc' == 0 & `q1_brc' == 0)" "dash rc `q1_rc', build rc `q1_brc'"
    _w41_expect Q4103-1 "(`q1_found' == 0)" "the build named by(, scale(1.5)) as not implemented and ignored"
    _w41_done Q4103-1 "by(foreign, scale(1.5)) is drawn with no ignored note, as twoway draws it"
    capture erase "`w41_work'/q1.html"
    capture erase "`w41_work'/q1.log"
    dash clear
    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

* ==== S03 BY-27: per-panel range(varname) ====
local only : env WP41_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w41_run' {
    display as text "S03 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4103-2: function and kdensity range(weight) under by() span each
    // panel's own weight, as twoway's generators summarise it per panel
    // (by_scale_range_truth.json R01-R03; Total = every row by() keeps).
    // twoway's pairs are its panels' summarize, measured here.
    // ------------------------------------------------------------
    local q2d "`w41_work'/q2"
    capture mkdir "`q2d'"
    foreach q2 in "foreign|0 1|" "rep78, total|1 2 3 4 5|total" {
        gettoken q2by q2 : q2, parse("|")
        gettoken _bar q2 : q2, parse("|")
        gettoken q2lev q2 : q2, parse("|")
        gettoken _bar q2tot : q2, parse("|")
        local q2var = word(subinstr("`q2by'", ",", " ", .), 1)
        sysuse auto, clear
        local q2want ""
        foreach k of local q2lev {
            quietly summarize weight if `q2var' == `k', meanonly
            local q2want "`q2want'|`=strofreal(r(min), "%21.0g")' `=strofreal(r(max), "%21.0g")'"
        }
        if "`q2tot'" != "" {
            quietly summarize weight if !missing(`q2var'), meanonly
            local q2want "`q2want'|`=strofreal(r(min), "%21.0g")' `=strofreal(r(max), "%21.0g")'"
        }
        local q2want = substr("`q2want'", 2, .)
        capture noisily twoway (scatter mpg weight) (function y=40-x/200, range(weight)), by(`q2by') name(w41q2, replace)
        local q2twrc = _rc
        capture graph drop w41q2
        dash clear
        capture noisily dash (scatter mpg weight) (function y=40-x/200, range(weight)), by(`q2by') name(q2)
        local q2rc = _rc
        _w41_expect Q4103-2 "(`q2twrc' == 0 & `q2rc' == 0)" "function by(`q2by'): twoway rc `q2twrc', dash rc `q2rc'"
        capture erase "`q2d'/fn.json"
        capture noisily _dash_serve_spec, specpath("`q2d'/fn.json") datapath("`q2d'/fnd.json")
        python: __import__("__main__")._q4103_panels("`q2d'/fn.json", "q4103_got")
        python: __import__("__main__")._q4103_close("${q4103_got}", "`q2want'", "q4103_bad")
        _w41_expect Q4103-2 `"("${q4103_bad}" == "")"' `"function by(`q2by'): ${q4103_bad}"'
        if "`q2tot'" == "" {
            dash clear
            capture noisily dash (scatter mpg weight) (kdensity weight, range(weight)), by(`q2by') name(q2k)
            local q2rc = _rc
            _w41_expect Q4103-2 "(`q2rc' == 0)" "kdensity by(`q2by'): dash rc `q2rc'"
            capture erase "`q2d'/kd.json"
            capture noisily _dash_serve_spec, specpath("`q2d'/kd.json") datapath("`q2d'/kdd.json")
            python: __import__("__main__")._q4103_panels("`q2d'/kd.json", "q4103_got")
            python: __import__("__main__")._q4103_close("${q4103_got_kd}", "`q2want'", "q4103_bad")
            _w41_expect Q4103-2 `"("${q4103_bad}" == "")"' `"kdensity by(`q2by'): ${q4103_bad}"'
            // The one-segment form holds by() twice (the segment's and
            // the graph's); each panel still has its own pair.
            dash clear
            capture noisily dash kdensity weight, range(weight) by(`q2by') name(q2k1)
            local q2rc = _rc
            _w41_expect Q4103-2 "(`q2rc' == 0)" "one-segment kdensity by(`q2by'): dash rc `q2rc'"
            capture erase "`q2d'/kd.json"
            capture noisily _dash_serve_spec, specpath("`q2d'/kd.json") datapath("`q2d'/kdd.json")
            python: __import__("__main__")._q4103_panels("`q2d'/kd.json", "q4103_got")
            python: __import__("__main__")._q4103_close("${q4103_got_kd}", "`q2want'", "q4103_bad")
            _w41_expect Q4103-2 `"("${q4103_bad}" == "")"' `"one-segment kdensity by(`q2by'): ${q4103_bad}"'
        }
    }
    _w41_done Q4103-2 "function and kdensity range(weight) span each by() panel's own weight, as twoway draws them"
    macro drop q4103_got q4103_got_kd q4103_bad
    foreach f in fn fnd kd kdd {
        capture erase "`q2d'/`f'.json"
    }
    capture rmdir "`q2d'"

    // ------------------------------------------------------------
    // Q4103-3: _dash_range_panel takes the p-th "|"-separated pair.
    // ------------------------------------------------------------
    capture mata: st_local("q3a", _dash_range_panel("1 2|3 4|. .", 2))
    local q3rc = _rc
    capture mata: st_local("q3b", _dash_range_panel("1 2|3 4|. .", 3))
    capture mata: st_local("q3c", _dash_range_panel("1 2|3 4|. .", 4))
    capture mata: st_local("q3d", _dash_range_panel("", 1))
    _w41_expect Q4103-3 "(`q3rc' == 0)" "_dash_range_panel is not defined (rc `q3rc')"
    _w41_expect Q4103-3 `"("`q3a'" == "3 4" & "`q3b'" == ". ." & "`q3c'" == "" & "`q3d'" == "")"' `"got [`q3a'] [`q3b'] [`q3c'] [`q3d']"'
    _w41_done Q4103-3 "_dash_range_panel returns the p-th pair, empty out of range"
    dash clear
    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

// S06 helper (BY-16): the text of every Title named dash_by_label in the
// saved page $W41_Q2_PAGE, sorted, into $W41_Q2_GOT (each
// <script type="application/json"> block loaded as a Bokeh document, as
// test_wp29_truth.cscript's _fx_plots_saved loads it).
python:
def _w41_s06_labels():
    import re as _re, json as _json
    from sfi import Macro as _M
    from bokeh.document import Document as _Doc
    from bokeh.models import Title as _Title
    with open(_M.getGlobal("W41_Q2_PAGE"), encoding="utf-8") as _fh:
        _page = _fh.read()
    _got = []
    for _blob in _re.findall(r'<script type="application/json" id="[^"]*">\s*(.*?)\s*</script>', _page, _re.S):
        for _dd in _json.loads(_blob).values():
            for _t in _Doc.from_json(_dd).select(dict(type=_Title)):
                if _t.name == "dash_by_label":
                    _got.append(str(_t.text))
    _M.setGlobal("W41_Q2_GOT", " ".join(sorted(_got)))
end

* ==== S06 BY-10: panel-label sub-options ====
local only : env WP41_ONLY
if inlist("`only'", "", "S06") & `: list posof "S06" in w41_run' {
    display as text "S06 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4106-1: subtitle(, justification(left) nobexpand) on a by()
    // graph is drawn, as twoway draws both (by_label_truth.json L01,
    // L03): the build names neither.  The note is the renderer's, so the
    // page is built.
    // ------------------------------------------------------------
    dash clear
    sysuse auto, clear
    capture noisily dash scatter mpg weight, subtitle(, justification(left) nobexpand) by(foreign) name(q1)
    _w41_expect Q4106-1 "(_rc == 0)" "dash scatter ... by(foreign) rc `=_rc'"
    capture erase "`w41_work'/q1.html"
    quietly log using "`w41_work'/q1.log", text replace name(_q4106)
    capture noisily dash build, saving("`w41_work'/q1.html", replace) nobrowser
    local q1rc = _rc
    quietly log close _q4106
    _w41_expect Q4106-1 "(`q1rc' == 0)" "dash build rc `q1rc'"
    cert_log_has "`w41_work'/q1.log", needle("not implemented")
    _w41_expect Q4106-1 "(r(found) == 0)" "the build named a subtitle() sub-option as not implemented"
    _w41_done Q4106-1 "justification(left) nobexpand on the panel labels are drawn, not named"
    capture erase "`w41_work'/q1.log"
    capture erase "`w41_work'/q1.html"
    dash clear

    display as text "S06 end " c(current_date) " " c(current_time)
}
* ==== end S06 ====

* ==== S06 BY-16: panel label values ====
local only : env WP41_ONLY
if inlist("`only'", "", "S06") & `: list posof "S06" in w41_run' {
    display as text "S06 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4106-2: by(d) on a %td date with no value label titles its panels
    // with the number, as twoway writes it (by_label_truth.json D01:
    // 14610, 14611), in the saved page's label Titles.
    // ------------------------------------------------------------
    dash clear
    sysuse auto, clear
    generate d = mdy(1, 1, 2000) + foreign
    format d %td
    capture erase "`w41_work'/q2.html"
    capture noisily dash scatter mpg weight, by(d) saving("`w41_work'/q2.html", replace)
    _w41_expect Q4106-2 "(_rc == 0)" "dash scatter ... by(d) saving() rc `=_rc'"
    global W41_Q2_PAGE "`w41_work'/q2.html"
    global W41_Q2_GOT ""
    capture noisily python: _w41_s06_labels()
    _w41_expect Q4106-2 "(_rc == 0)" "the page could not be read (rc `=_rc')"
    local q2ok = (`"${W41_Q2_GOT}"' == "14610 14611")
    _w41_expect Q4106-2 "(`q2ok')" `"the panel labels read ${W41_Q2_GOT}, not 14610 14611"'
    _w41_done Q4106-2 "a date by() variable's panels read 14610 and 14611, as twoway writes them"
    macro drop W41_Q2_PAGE W41_Q2_GOT
    capture erase "`w41_work'/q2.html"
    dash clear

    display as text "S06 end " c(current_date) " " c(current_time)
}
* ==== end S06 ====

* ==== append new blocks above this line ====

// ----------------------------------------------------------------
// Summary (test_wp29_truth.cscript's shape)
// ----------------------------------------------------------------
capture graph drop _all
capture dash clear
capture rmdir "`w41_work'"
local nfail    = ${w41_nfail}
local faillist "${w41_faillist}"
local ncase    = ${w41_ncase}
local only : env WP41_ONLY
macro drop w41_nfail w41_faillist w41_bad w41_ncase
display as text ""
display as text "============================================================"
if `ncase' == 0 {
    if `w41_N' > 1 & `"`macval(only)'"' == "" & "`w41_run'" == "" {
        display as text "test_wp41_truth: part `w41_k'/`w41_N' has no block to run"
        display as text "============================================================"
        exit 0
    }
    // A WP41_ONLY that names no block, or only a stub, ran nothing:
    // that is not a pass.
    display as error "  test_wp41_truth: no case ran (WP41_ONLY=`only')"
    display as text "============================================================"
    exit 9
}
else if `nfail' == 0 {
    display as text "  test_wp41_truth: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_wp41_truth: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
