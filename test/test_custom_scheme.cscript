*! test_custom_scheme.cscript
*! Certification script: a scheme is named by one of dash's shipped
*! translations, a theme alias, or a scheme Stata finds along the ado-path
*! (scheme-NAME.scheme, then NAME.scheme; WP-30 P1.25b; the working
*! directory is on it) -- the same rule on every entry point
*! -- and an explicit scheme() or theme() that is none of those is refused
*! in Stata, before Python runs.  A shipped name may be written with the
*! extension too (scheme(s2color.scheme), in any case): the renderer reads
*! that spelling from the package's dash-<name>.scheme, so the gate accepts it with
*! no file in the working directory.  The session's own c(scheme) is inherited
*! when nothing is requested, and one warning names the cause when dash
*! cannot translate it.
*!
*! ROADMAP WP-17 / GAPS.md G1, G2, G8 and F4's bare-name row.  Measured
*! 22sep2026 (scratchpad/wp17/probe): `scheme(mytheme)' with mytheme.scheme
*! in the working directory drew the FIGURE with mytheme and the page chrome
*! with s2color, under a warning that mytheme "is not a known theme or
*! scheme" -- half applied, on the immediate route, on a registered graph
*! and on `dash build' alike; `scheme(mytheme.scheme)' worked everywhere;
*! scheme(nosuchthing) and theme(nosuchtheme) were rc 0 plus that warning;
*! and `set scheme s2color8' -- which cscript does for every session -- put
*! the same warning into eleven of twelve certification logs.
*!
*! The gate is dash.ado's own (`scheme' kind in the WP-15 table, applied to
*! graph-level scheme() by the existing loops and to build/serve scheme()
*! and theme() in _dash_prepare_spec), so a refusal is one `display as
*! error' line naming the option, exit 198, and no Python traceback.  The
*! list of shipped names lives in one place, _dash_shipped_schemes.
*!
*! The cases run in a temporary working directory holding mytheme.scheme
*! (dash-s1rcolor.scheme with `color background #123456' substituted)
*! and scheme-zzdashtest.scheme (`#include s2color', for `set scheme').  A
*! page is fingerprinted by the custom background #123456 and by s2color's
*! heading colour #1e2d53, which the half-applied page carried:
*!
*!   CS-01  dash scatter ..., scheme(mytheme) saving(a.html, replace)
*!          rc 0, no note, a.html carries #123456
*!   CS-02  the same with scheme(mytheme.scheme)
*!   CS-03  name(g) then dash build, scheme(mytheme)
*!          rc 0, no note, #123456 present, #1e2d53 ABSENT
*!   CS-04  the same with scheme(mytheme.scheme)
*!   CS-05  registered with graph-level scheme(mytheme), built with no
*!          scheme(): #123456 present, #1e2d53 absent
*!   CS-06  scheme(nosuchthing) on scatter      rc 0, twoway's note (ST-16)
*!   CS-07  scheme(nosuchthing) on dash build   rc 198, names scheme()
*!   CS-08  theme(nosuchtheme) on dash build    rc 198, names theme()
*!   CS-09  scheme(../mytheme): scatter rc 0 with the note, build rc 198
*!   CS-10  set scheme zzdashtest, build with no scheme(): rc 0, no
*!          note, the file's own #2a3b4c drawn (WP-30 P1.25b: a session
*!          scheme Stata found is found by dash)
*!   CS-11  set scheme s2color8, build: rc 0 and NO warning (s2color8 ships)
*!   CS-12  every one of the twenty-six shipped names on dash build, scheme():
*!          rc 0 and no warning; the list holds twenty-six
*!   CS-13  _dash_serve_spec ..., scheme(nosuchthing) rc 198 naming
*!          scheme(); theme(nosuchtheme) rc 198 naming theme()
*!   CS-14  dash build, scheme(s2color.scheme) -- a shipped name written
*!          with the extension, no such file in the working directory:
*!          rc 0, no note, page is s2color (#1e2d53 present,
*!          #123456 absent).  Measured before the fix: rc 198, the
*!          extension form was looked for as a working-directory file only
*!   CS-15  a scheme with two #include lines that resolve nowhere: each
*!          of twoway's "(note: scheme X not found, using s2color)" lines
*!          once per build -- immediate route, registered graph with
*!          scheme(), dash build scheme(), served build -- as twoway
*!          prints it once.  Measured before the fix (S3 batch): twice on
*!          the immediate route and the registered graph, where the
*!          build's scheme and the graph's were parsed separately
*!   SP-01  scheme(nosuchthing): on scatter rc 0 with twoway's note (ST-16);
*!          on build and _dash_serve_spec rc 198, the refusal lists the
*!          twenty-six names and the themes
*!   SP-02  scheme(sub/x), scheme(a:b), scheme(my theme): rc 0, the note (ST-16; was rc 198, "is not
*!          looked for", no Traceback
*!   SP-03  scheme-sp03.scheme in the working directory, scheme(sp03) on
*!          scatter, build and _dash_serve_spec: rc 0, no note, #3c4d5e
*!   SP-04  set scheme _SP04_ from PERSONAL (grstyle's layout): unschemed
*!          build rc 0, no note, #4d5e6f
*!   SP-05  PLUS/s/scheme-sp05.scheme: scheme(sp05), then set scheme sp05
*!          and an unschemed build: rc 0, no note, #5e6f70
*!   SP-06  scheme-sp06.scheme on an added directory, a link out of it:
*!          rc 0, one note "was not read", s2color drawn
*!   SP-07  scheme-sp07.scheme of 1,048,577 bytes: rc 0, one note "larger
*!          than 1,048,576 bytes", s2color drawn
*!   SP-08  scheme(dash-s2color) with no working-directory file: rc 0, the note (ST-16)
*!   CQ-01  scheme(myquoted) (s1rcolor with `color background "255 0 0"')
*!          rc 0, no note, q1.html carries #ff0000 (WP-28 GAPS2 D1)
*!   CQ-02  the same with `color background "255 0 0 %50"' (myquoted50)
*!          into q2.html: #ff0000 present, no warning
*!   CQ-03  scheme(myp1) (s1rcolor plus an appended `color p1 "31 119
*!          180"' line) into q3.html: #1f77b4 present, no warning
*!
*! Every render is read back out of a captured log with Stata's wrapped
*! lines re-joined, as test_suboption_reporting.cscript does.  The session
*! scheme is restored at the end.
*!
*! Usage:  via run_all_cscripts.do (the dash directory must be on the
*!         ado-path for the render to find dash_render.py).

cscript "dash custom schemes" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off


do "cert_helpers.do"
qui do "../dash_parse.mata"
qui do "../dash.ado"

global dash_nobrowser 1
sysuse auto, clear

// ----------------------------------------------------------------
// The working directory for the cases.  Everything that follows resolves
// relative to it: the immediate route's saving(), dash build's saving(),
// the .scheme lookups, and `set scheme' (the working directory is on the
// ado-path).  The source scheme is located before the cd.
// ----------------------------------------------------------------
local cs_home    "`c(pwd)'"
local cs_scheme0 "`c(scheme)'"
local cs_src     "`cs_home'/../dash-s1rcolor.scheme"
local cs_dir     "`c(tmpdir)'dash_cs_wd"
capture mkdir "`cs_dir'"

capture mata: mata drop _cs_write_theme()
capture mata: mata drop _cs_write_quoted()
capture mata: mata drop _cs_scan()
mata:
// Copy `src' to `dst' with the `color background' directive replaced by
// #123456; returns the number of lines replaced (one, when the source is
// the file this script expects).
real scalar _cs_write_theme(string scalar src, string scalar dst)
{
    string colvector L
    string scalar    c
    real scalar      i, fh, n
    L = cat(src)
    n = 0
    for (i = 1; i <= rows(L); i++) {
        if (strpos(L[i], "color background") == 1) {
            c = substr(L[i], 17, 1)
            if (c == " " | c == char(9)) {
                L[i] = "color background      #123456"
                n = n + 1
            }
        }
    }
    _unlink(dst)
    fh = fopen(dst, "w")
    for (i = 1; i <= rows(L); i++) fput(fh, L[i])
    fclose(fh)
    return(n)
}

// WP-28 GAPS2 D1: copy `src' to `dst'; when `bgline' is not empty, replace
// the `color background' directive with it verbatim (quotes and all, as
// in `color background      "255 0 0"'); when `extra' is not empty,
// append it as one more line.  Returns the number of `color background'
// lines replaced (0 when `bgline' is empty, as for myp1.scheme).
real scalar _cs_write_quoted(string scalar src, string scalar dst,
    string scalar bgline, string scalar extra)
{
    string colvector L
    string scalar    c
    real scalar      i, fh, n
    L = cat(src)
    n = 0
    if (bgline != "") {
        for (i = 1; i <= rows(L); i++) {
            if (strpos(L[i], "color background") == 1) {
                c = substr(L[i], 17, 1)
                if (c == " " | c == char(9)) {
                    L[i] = bgline
                    n = n + 1
                }
            }
        }
    }
    _unlink(dst)
    fh = fopen(dst, "w")
    for (i = 1; i <= rows(L); i++) fput(fh, L[i])
    if (extra != "") fput(fh, extra)
    fclose(fh)
    return(n)
}

// Log scanner: re-join "> " continuations, then count the logical lines
// that carry `needle' and hand back the first.
void _cs_scan(string scalar fn, string scalar needle)
{
    real scalar   fh, n
    string scalar line, full, first
    fh = fopen(fn, "r")
    n = 0
    full = ""
    first = ""
    while ((line = fget(fh)) != J(0, 0, "")) {
        if (substr(line, 1, 2) == "> ") {
            full = full + substr(line, 3, .)
            continue
        }
        if (strpos(full, needle)) {
            n = n + 1
            if (first == "") first = full
        }
        full = line
    }
    if (strpos(full, needle)) {
        n = n + 1
        if (first == "") first = full
    }
    fclose(fh)
    st_local("_cs_n", strofreal(n))
    st_local("_cs_line", first)
}
end

mata: st_local("cs_nsub", strofreal(_cs_write_theme(st_local("cs_src"), ///
    st_local("cs_dir") + "/mytheme.scheme")))
if `cs_nsub' != 1 {
    display as error "SETUP FAIL: expected one `color background' line in `cs_src', replaced `cs_nsub'"
    exit 9
}

tempname fh
file open `fh' using "`cs_dir'/scheme-zzdashtest.scheme", write text replace
file write `fh' "#include s2color" _n
file write `fh' "color background #2a3b4c" _n
file close `fh'

cd "`cs_dir'"

// ----------------------------------------------------------------
// Helpers
// ----------------------------------------------------------------
// Run `prep' (a registration, or nothing) and then `main' with the log
// captured.  r(prc) and r(rc) are their return codes; the caller reads
// them into locals at once, because the next helper overwrites r().
capture program drop _cs_run
program define _cs_run, rclass
    version 16.0
    args prep main
    local logfile "`c(tmpdir)'dash_cs.log"
    set linesize 80
    capture log close _cslog
    capture erase "`logfile'"
    capture dash clear
    log using "`logfile'", name(_cslog) text replace
    local prc = 0
    if `"`macval(prep)'"' != "" {
        capture noisily `macval(prep)'
        local prc = _rc
    }
    capture noisily `macval(main)'
    local rc = _rc
    log close _cslog
    return scalar rc  = `rc'
    return scalar prc = `prc'
    return local logfile "`logfile'"
end

capture program drop _cs_count
program define _cs_count, rclass
    version 16.0
    args logfile needle
    mata: _cs_scan(st_local("logfile"), st_local("needle"))
    return scalar n = `_cs_n'
    return local line `"`macval(_cs_line)'"'
end

// The tally lives in globals: a helper program cannot read the do-file's
// locals.  (A global's name cannot start with an underscore.)
global cs_nfail    = 0
global cs_faillist ""
global cs_bad      = 0

// One assertion of the case in progress: on failure print the detail and
// mark the case bad.  `cond' arrives already expanded.
capture program drop _cs_expect
program define _cs_expect
    version 16.0
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global cs_bad = 1
    }
end

// Close the case: one PASS line, or one entry in the tally.
capture program drop _cs_done
program define _cs_done
    version 16.0
    args id msg
    if ${cs_bad} {
        global cs_nfail    = ${cs_nfail} + 1
        global cs_faillist "${cs_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global cs_bad = 0
end

// The log of the case just run must carry `needle' exactly `want' times
// (`want' = -1: at least once).
capture program drop _cs_log
program define _cs_log
    version 16.0
    args id logfile needle want
    _cs_count "`logfile'" `"`macval(needle)'"'
    local n = r(n)
    local line `"`r(line)'"'
    if `want' == -1 {
        _cs_expect "`id'" "(`n' > 0)" `"the log does not say `macval(needle)'"'
    }
    else {
        _cs_expect "`id'" "(`n' == `want')" `"expected `want' log line(s) with `macval(needle)', found `n': `macval(line)'"'
    }
end

// The log of the case just run must carry `want' note lines, "(note:",
// and no Python warning line, "Warning:" (WP-30 P1.26a: a note prints as
// twoway prints its notes, never as a raw Python warning, so a count of
// Python's warning class name could no longer fail).
capture program drop _cs_notes
program define _cs_notes
    version 19
    args id logfile want
    _cs_log "`id'" "`logfile'" "(note:" `want'
    _cs_log "`id'" "`logfile'" "Warning:" 0
end

// The page must (want = 1) or must not (want = 0) carry `needle'.
capture program drop _cs_page
program define _cs_page
    version 16.0
    args id html needle want
    capture confirm file "`html'"
    if _rc {
        _cs_expect "`id'" "(0)" "`html' was not written"
        exit
    }
    cert_file_has "`html'", needle("`needle'")
    local found = r(found)
    if `want' {
        _cs_expect "`id'" "(`found' == 1)" "`html' does not carry `needle'"
    }
    else {
        _cs_expect "`id'" "(`found' == 0)" "`html' carries `needle'"
    }
end

// ----------------------------------------------------------------
// CS-01 / CS-02: the immediate route, bare name and file name
// ----------------------------------------------------------------
capture erase "a.html"
_cs_run "" `"dash scatter mpg weight, scheme(mytheme) saving(a.html, replace)"'
local rc = r(rc)
local lg `"`r(logfile)'"'
_cs_expect CS-01 "(`rc' == 0)" "rc `rc' (expected 0)"
_cs_notes CS-01 "`lg'" 0
_cs_page CS-01 "a.html" "#123456" 1
_cs_done CS-01 "scheme(mytheme) on the immediate route: rc 0, no warning, mytheme drawn"

capture erase "a.html"
_cs_run "" `"dash scatter mpg weight, scheme(mytheme.scheme) saving(a.html, replace)"'
local rc = r(rc)
local lg `"`r(logfile)'"'
_cs_expect CS-02 "(`rc' == 0)" "rc `rc' (expected 0)"
_cs_notes CS-02 "`lg'" 0
_cs_page CS-02 "a.html" "#123456" 1
_cs_done CS-02 "scheme(mytheme.scheme) on the immediate route: rc 0, no warning, mytheme drawn"

// ----------------------------------------------------------------
// CS-03 / CS-04: dash build, bare name and file name; the chrome too
// ----------------------------------------------------------------
capture erase "b.html"
_cs_run `"dash scatter mpg weight, name(g)"' `"dash build, saving(b.html) scheme(mytheme) replace"'
local rc  = r(rc)
local prc = r(prc)
local lg `"`r(logfile)'"'
_cs_expect CS-03 "(`prc' == 0)" "registration rc `prc' (expected 0)"
_cs_expect CS-03 "(`rc' == 0)" "rc `rc' (expected 0)"
_cs_notes CS-03 "`lg'" 0
_cs_page CS-03 "b.html" "#123456" 1
_cs_page CS-03 "b.html" "#1e2d53" 0
_cs_done CS-03 "dash build, scheme(mytheme): rc 0, no warning, figure AND chrome from mytheme"

capture erase "b.html"
_cs_run `"dash scatter mpg weight, name(g)"' `"dash build, saving(b.html) scheme(mytheme.scheme) replace"'
local rc  = r(rc)
local prc = r(prc)
local lg `"`r(logfile)'"'
_cs_expect CS-04 "(`prc' == 0)" "registration rc `prc' (expected 0)"
_cs_expect CS-04 "(`rc' == 0)" "rc `rc' (expected 0)"
_cs_notes CS-04 "`lg'" 0
_cs_page CS-04 "b.html" "#123456" 1
_cs_page CS-04 "b.html" "#1e2d53" 0
_cs_done CS-04 "dash build, scheme(mytheme.scheme): rc 0, no warning, figure and chrome from mytheme"

// ----------------------------------------------------------------
// CS-05: graph-level scheme(mytheme), built with no scheme()
// ----------------------------------------------------------------
capture erase "b.html"
_cs_run `"dash scatter mpg weight, name(g) scheme(mytheme)"' `"dash build, saving(b.html) replace"'
local rc  = r(rc)
local prc = r(prc)
local lg `"`r(logfile)'"'
_cs_expect CS-05 "(`prc' == 0)" "registration with scheme(mytheme) rc `prc' (expected 0)"
_cs_expect CS-05 "(`rc' == 0)" "rc `rc' (expected 0)"
_cs_notes CS-05 "`lg'" 0
_cs_page CS-05 "b.html" "#123456" 1
_cs_page CS-05 "b.html" "#1e2d53" 0
_cs_done CS-05 "a registered graph's scheme(mytheme): rc 0, no warning, figure and chrome from mytheme"

// ----------------------------------------------------------------
// CS-06 .. CS-09: an explicit name that resolves to nothing is refused
// ----------------------------------------------------------------
// Flipped (WP-45 ST-16): twoway draws s2color with a note for a scheme it cannot find (ST-16): rc 0, its one note, no refusal.
_cs_run "" `"dash scatter mpg weight, scheme(nosuchthing) saving(a.html, replace)"'
local rc = r(rc)
local lg `"`r(logfile)'"'
_cs_expect CS-06 "(`rc' == 0)" "rc `rc' (expected 0)"
_cs_log CS-06 "`lg'" "(note: scheme nosuchthing not found, using s2color)" 1
_cs_log CS-06 "`lg'" "scheme() must be one of" 0
_cs_log CS-06 "`lg'" "Traceback" 0
_cs_done CS-06 "scheme(nosuchthing) on scatter draws s2color with twoway's note, rc 0"

_cs_run `"dash scatter mpg weight, name(g)"' `"dash build, saving(b.html) scheme(nosuchthing) replace"'
local rc  = r(rc)
local prc = r(prc)
local lg `"`r(logfile)'"'
_cs_expect CS-07 "(`prc' == 0)" "registration rc `prc' (expected 0)"
_cs_expect CS-07 "(`rc' == 198)" "rc `rc' (expected 198)"
_cs_log CS-07 "`lg'" "dash build: scheme() must be one of economist, meta," -1
_cs_notes CS-07 "`lg'" 0
_cs_done CS-07 "scheme(nosuchthing) on dash build is refused, rc 198, naming scheme()"

_cs_run `"dash scatter mpg weight, name(g)"' `"dash build, saving(b.html) theme(nosuchtheme) replace"'
local rc  = r(rc)
local prc = r(prc)
local lg `"`r(logfile)'"'
_cs_expect CS-08 "(`prc' == 0)" "registration rc `prc' (expected 0)"
_cs_expect CS-08 "(`rc' == 198)" "rc `rc' (expected 198)"
_cs_log CS-08 "`lg'" "dash build: theme() must be one of" -1
_cs_notes CS-08 "`lg'" 0
_cs_done CS-08 "theme(nosuchtheme) on dash build is refused, rc 198, naming theme()"

// Flipped (WP-45 ST-16): twoway draws s2color with a note for a scheme it cannot find (ST-16): the path is never read.
_cs_run "" `"dash scatter mpg weight, scheme(../mytheme) saving(a.html, replace)"'
local rc = r(rc)
local lg `"`r(logfile)'"'
_cs_expect CS-09 "(`rc' == 0)" "scatter: rc `rc' (expected 0)"
_cs_log CS-09 "`lg'" "(note: scheme ../mytheme not found, using s2color)" 1
_cs_run `"dash scatter mpg weight, name(g)"' `"dash build, saving(b.html) scheme(../mytheme) replace"'
local rc = r(rc)
local lg `"`r(logfile)'"'
_cs_expect CS-09 "(`rc' == 198)" "dash build: rc `rc' (expected 198)"
_cs_log CS-09 "`lg'" "scheme() must be one of economist, meta," -1
_cs_done CS-09 "scheme(../mytheme) draws s2color with twoway's note on scatter and is refused on dash build, rc 198"

// ----------------------------------------------------------------
// CS-10: a session scheme Stata found is drawn, with no note (WP-30 P1.25b)
// ----------------------------------------------------------------
capture noisily set scheme zzdashtest
local src = _rc
capture erase "b.html"
_cs_run `"dash scatter mpg weight, name(g)"' `"dash build, saving(b.html) replace"'
local rc  = r(rc)
local prc = r(prc)
local lg `"`r(logfile)'"'
_cs_expect CS-10 "(`src' == 0)" "set scheme zzdashtest rc `src' (expected 0; is the working directory on the ado-path?)"
_cs_expect CS-10 `"("`c(scheme)'" == "zzdashtest")"' "c(scheme) is `c(scheme)' (expected zzdashtest)"
_cs_expect CS-10 "(`prc' == 0)" "registration rc `prc' (expected 0)"
_cs_expect CS-10 "(`rc' == 0)" "rc `rc' (expected 0)"
_cs_notes CS-10 "`lg'" 0
_cs_page CS-10 "b.html" "#2a3b4c" 1
_cs_done CS-10 "set scheme zzdashtest: rc 0, no note, the file's own #2a3b4c drawn"

// ----------------------------------------------------------------
// CS-11: the session scheme cscript sets now ships
// ----------------------------------------------------------------
capture noisily set scheme s2color8
local src = _rc
capture erase "b.html"
_cs_run `"dash scatter mpg weight, name(g)"' `"dash build, saving(b.html) replace"'
local rc  = r(rc)
local prc = r(prc)
local lg `"`r(logfile)'"'
_cs_expect CS-11 "(`src' == 0)" "set scheme s2color8 rc `src' (expected 0)"
_cs_expect CS-11 "(`prc' == 0)" "registration rc `prc' (expected 0)"
_cs_expect CS-11 "(`rc' == 0)" "rc `rc' (expected 0)"
_cs_notes CS-11 "`lg'" 0
_cs_page CS-11 "b.html" "#1e2d53" 1
_cs_done CS-11 "set scheme s2color8 then dash build: rc 0 and no warning"

// ----------------------------------------------------------------
// CS-12: every shipped name, from the one list
// ----------------------------------------------------------------
local _dash_schemes ""
capture noisily _dash_shipped_schemes
local lrc = _rc
_cs_expect CS-12 "(`lrc' == 0)" "_dash_shipped_schemes rc `lrc' (expected 0)"
local nsh : word count `_dash_schemes'
_cs_expect CS-12 "(`nsh' == 26)" "the shipped list holds `nsh' names (expected 26): `_dash_schemes'"
local nrun = 0
foreach nm of local _dash_schemes {
    capture erase "c.html"
    _cs_run `"dash scatter mpg weight, name(g)"' `"dash build, saving(c.html) scheme(`nm') replace"'
    local rc = r(rc)
    local lg `"`r(logfile)'"'
    _cs_expect CS-12 "(`rc' == 0)" "scheme(`nm'): rc `rc' (expected 0)"
    foreach w in "(note:" "Warning:" {
        _cs_count "`lg'" "`w'"
        local nw = r(n)
        local line `"`r(line)'"'
        _cs_expect CS-12 "(`nw' == 0)" `"scheme(`nm'): `nw' `w' line(s): `macval(line)'"'
    }
    local ++nrun
}
_cs_done CS-12 "all `nrun' shipped names build with rc 0 and no warning"

// ----------------------------------------------------------------
// CS-13: dash serve's spec path refuses the same names
// ----------------------------------------------------------------
tempfile mj dj
_cs_run `"dash scatter mpg weight, name(g)"' `"_dash_serve_spec, specpath("`mj'") datapath("`dj'") scheme(nosuchthing)"'
local rc  = r(rc)
local prc = r(prc)
local lg `"`r(logfile)'"'
_cs_expect CS-13 "(`prc' == 0)" "registration rc `prc' (expected 0)"
_cs_expect CS-13 "(`rc' == 198)" "scheme(nosuchthing): rc `rc' (expected 198)"
_cs_log CS-13 "`lg'" "dash serve: scheme() must be one of economist, meta," -1
_cs_run `"dash scatter mpg weight, name(g)"' `"_dash_serve_spec, specpath("`mj'") datapath("`dj'") theme(nosuchtheme)"'
local rc = r(rc)
local lg `"`r(logfile)'"'
_cs_expect CS-13 "(`rc' == 198)" "theme(nosuchtheme): rc `rc' (expected 198)"
_cs_log CS-13 "`lg'" "dash serve: theme() must be one of" -1
_cs_done CS-13 "dash serve's spec path refuses scheme(nosuchthing) and theme(nosuchtheme), rc 198"

// ----------------------------------------------------------------
// CS-14: a shipped name written with the extension needs no file in
// the working directory -- the renderer reads dash-s2color.scheme
// ----------------------------------------------------------------
capture confirm file "s2color.scheme"
local nofile = _rc
_cs_expect CS-14 "(`nofile' != 0)" "the working directory holds an s2color.scheme, so the case proves nothing"
capture erase "b.html"
_cs_run `"dash scatter mpg weight, name(g)"' `"dash build, saving(b.html) scheme(s2color.scheme) replace"'
local rc  = r(rc)
local prc = r(prc)
local lg `"`r(logfile)'"'
_cs_expect CS-14 "(`prc' == 0)" "registration rc `prc' (expected 0)"
_cs_expect CS-14 "(`rc' == 0)" "rc `rc' (expected 0)"
_cs_log CS-14 "`lg'" "scheme() must be" 0
_cs_notes CS-14 "`lg'" 0
_cs_page CS-14 "b.html" "#1e2d53" 1
_cs_page CS-14 "b.html" "#123456" 0
_cs_done CS-14 "dash build, scheme(s2color.scheme) with no such file in the working directory: rc 0, no warning, page is s2color"

// ----------------------------------------------------------------
// CS-15: an #include that resolves nowhere is noted ONCE per build,
// as twoway notes it once per graph.  cs15inc.scheme includes two
// names that resolve nowhere, so each note must appear exactly once
// (one note is not allowed to swallow the other).  Measured before the
// fix (S3 batch, 24sep2026): the immediate route and a registered graph
// carrying scheme() printed each note twice -- the build's scheme and
// the graph's own were parsed separately in one render.
// ----------------------------------------------------------------
tempname fh15
file open `fh15' using "cs15inc.scheme", write text replace
file write `fh15' "#include cs15nosuch" _n "#include cs15other" _n "color background #123456" _n
file close `fh15'
local n15a "(note: scheme cs15nosuch not found, using s2color)"
local n15b "(note: scheme cs15other not found, using s2color)"
// twoway itself: each note once (the control this case holds dash to)
_cs_run "" "twoway scatter mpg weight, scheme(cs15inc) nodraw"
local rc = r(rc)
local lg `"`r(logfile)'"'
_cs_expect CS-15 "(`rc' == 0)" "twoway: rc `rc'"
_cs_log CS-15 "`lg'" "`n15a'" 1
_cs_log CS-15 "`lg'" "`n15b'" 1
// the immediate route
capture erase "a.html"
_cs_run "" "dash scatter mpg weight, scheme(cs15inc) saving(a.html, replace)"
local rc = r(rc)
local lg `"`r(logfile)'"'
_cs_expect CS-15 "(`rc' == 0)" "immediate: rc `rc'"
_cs_log CS-15 "`lg'" "`n15a'" 1
_cs_log CS-15 "`lg'" "`n15b'" 1
_cs_page CS-15 "a.html" "#123456" 1
// a registered graph carrying scheme(), built with no scheme()
capture erase "b.html"
_cs_run "dash scatter mpg weight, name(g) scheme(cs15inc)" "dash build, saving(b.html) replace"
local rc = r(rc)
local lg `"`r(logfile)'"'
_cs_expect CS-15 "(`rc' == 0)" "registered graph: rc `rc'"
_cs_log CS-15 "`lg'" "`n15a'" 1
_cs_log CS-15 "`lg'" "`n15b'" 1
// dash build, scheme(), saved and served
capture erase "c.html"
_cs_run "dash scatter mpg weight, name(g)" "dash build, saving(c.html) scheme(cs15inc) replace"
local lg `"`r(logfile)'"'
_cs_log CS-15 "`lg'" "`n15a'" 1
_cs_log CS-15 "`lg'" "`n15b'" 1
capture erase "c15.py"
_cs_run "dash scatter mpg weight, name(g) scheme(cs15inc)" "dash build, saving(c15.py) scheme(cs15inc) server replace"
local rc = r(rc)
local lg `"`r(logfile)'"'
_cs_expect CS-15 "(`rc' == 0)" "served build: rc `rc'"
_cs_log CS-15 "`lg'" "`n15a'" 1
_cs_log CS-15 "`lg'" "`n15b'" 1
_cs_done CS-15 "each unresolvable #include is noted once per build, on every route, as twoway notes it once"

// ----------------------------------------------------------------
// CQ-01..CQ-03 (WP-28 GAPS2 D1): a working-directory scheme written with
// Stata's own quoted RGB and %opacity is read, not dropped without a
// warning.  myquoted.scheme and myquoted50.scheme are s1rcolor with the
// `color background' line replaced by a quoted triplet, with and without
// %opacity; myp1.scheme is s1rcolor plus an appended `color p1' line.
// Measured before the fix: SchemeParser._parse_lines took the last
// whitespace-split token as the value, so `color background "255 0 0"'
// landed under the malformed key `color background "255 0', mytheme's
// own #123456 fixture is untouched by this, and the quoted-scheme pages
// carried s1rcolor's own background (#000000) and its `color p1' default
// instead of #ff0000 / #1f77b4.
// ----------------------------------------------------------------
mata: _cs_write_quoted(st_local("cs_src"), "myquoted.scheme", ///
    "color background      " + char(34) + "255 0 0" + char(34), "")
mata: _cs_write_quoted(st_local("cs_src"), "myquoted50.scheme", ///
    "color background      " + char(34) + "255 0 0 %50" + char(34), "")
mata: _cs_write_quoted(st_local("cs_src"), "myp1.scheme", "", ///
    "color p1 " + char(34) + "31 119 180" + char(34))

// WP-30 P1.28a: CS-15's nodraw twoway graph would add dash's graph
// export note to the counts below (setup only; the counts are unchanged).
quietly graph drop _all
capture erase "q1.html"
_cs_run "" `"dash scatter mpg weight, scheme(myquoted) saving(q1.html, replace)"'
local rc = r(rc)
local lg `"`r(logfile)'"'
_cs_expect CQ-01 "(`rc' == 0)" "rc `rc' (expected 0)"
_cs_notes CQ-01 "`lg'" 0
_cs_page CQ-01 "q1.html" "#ff0000" 1
_cs_done CQ-01 "scheme(myquoted), a quoted color background directive: rc 0, no warning, #ff0000 drawn"

capture erase "q2.html"
_cs_run "" `"dash scatter mpg weight, scheme(myquoted50) saving(q2.html, replace)"'
local rc = r(rc)
local lg `"`r(logfile)'"'
_cs_expect CQ-02 "(`rc' == 0)" "rc `rc' (expected 0)"
_cs_notes CQ-02 "`lg'" 0
_cs_page CQ-02 "q2.html" "#ff0000" 1
_cs_done CQ-02 "scheme(myquoted50), a quoted color background directive with %opacity: rc 0, no warning, #ff0000 drawn"

capture erase "q3.html"
_cs_run "" `"dash scatter mpg weight, scheme(myp1) saving(q3.html, replace)"'
local rc = r(rc)
local lg `"`r(logfile)'"'
_cs_expect CQ-03 "(`rc' == 0)" "rc `rc' (expected 0)"
_cs_notes CQ-03 "`lg'" 0
_cs_page CQ-03 "q3.html" "#1f77b4" 1
_cs_done CQ-03 "scheme(myp1), an appended quoted color p1 directive: rc 0, no warning, #1f77b4 drawn"

// WP-30 P1.4b: a directive dash does not draw yet is kept with the scheme
// and never noted (ratification row 4), on every route.
tempname mkfh
file open `mkfh' using "w33s.scheme", write text replace
file write `mkfh' "#include s2color" _n "textboxstyle title subheading" _n "textboxstyle axis_title heading" _n "clockdir p 9" _n "yesno plabelboxed yes" _n "textboxstyle key_label heading" _n "textboxstyle tick heading" _n
file close `mkfh'
file open `mkfh' using "w33m.scheme", write text replace
file write `mkfh' "#include s2color" _n
forvalues i = 1/15 {
    file write `mkfh' "clockdir p`i' 9" _n
}
file write `mkfh' "clockdir p 9" _n "textboxstyle tick heading" _n
file close `mkfh'
quietly graph drop _all

capture erase "a.html"
_cs_run "" `"dash scatter mpg weight, mlabel(make) scheme(w33s) saving(a.html, replace)"'
local rc = r(rc)
local lg `"`r(logfile)'"'
_cs_expect MK-06 "(`rc' == 0)" "rc `rc' (expected 0)"
_cs_notes MK-06 "`lg'" 0
_cs_done MK-06 "scheme(w33s), six directives dash does not draw: rc 0, no note"

capture erase "b.html"
_cs_run "dash scatter mpg weight, mlabel(make) name(g)" "dash build, scheme(w33s) saving(b.html) replace"
local rc = r(rc)
local lg `"`r(logfile)'"'
_cs_expect MK-07 "(`rc' == 0)" "saved build: rc `rc' (expected 0)"
_cs_notes MK-07 "`lg'" 0
capture erase "c15.py"
_cs_run "dash scatter mpg weight, mlabel(make) name(g)" "dash build, scheme(w33s) saving(c15.py) server replace"
local rc = r(rc)
local lg `"`r(logfile)'"'
_cs_expect MK-07 "(`rc' == 0)" "served build: rc `rc' (expected 0)"
_cs_notes MK-07 "`lg'" 0
_cs_done MK-07 "dash build, scheme(w33s), saved and served: rc 0, no note"

capture erase "a.html"
_cs_run "" `"dash scatter mpg weight, scheme(w33m) saving(a.html, replace)"'
local rc = r(rc)
local lg `"`r(logfile)'"'
_cs_expect MK-08 "(`rc' == 0)" "rc `rc' (expected 0)"
_cs_notes MK-08 "`lg'" 0
_cs_done MK-08 "scheme(w33m), clockdir p1 to p15 and p: rc 0, no note"

// ----------------------------------------------------------------
// SP-01 .. SP-08 (WP-30 P1.25b): Stata's scheme lookup along the ado-path
// ----------------------------------------------------------------
local sp_needle1 "scheme() must be one of economist, meta, s1color,"
local sp_needle2 "a theme (clean, dark, default, economist, mono, sj); or a scheme Stata finds along the ado-path as scheme-NAME.scheme or NAME.scheme (got: nosuchthing)"
quietly graph drop _all
// Flipped (WP-45 ST-16): twoway draws s2color with a note for a scheme it cannot find (ST-16): the scatter route; build and serve keep the refusal.
_cs_run "" `"dash scatter mpg weight, scheme(nosuchthing) saving(a.html, replace)"'
local rc = r(rc)
local lg `"`r(logfile)'"'
_cs_expect SP-01 "(`rc' == 0)" "scatter: rc `rc' (expected 0)"
_cs_log SP-01 "`lg'" "(note: scheme nosuchthing not found, using s2color)" 1
_cs_run `"dash scatter mpg weight, name(g)"' `"dash build, saving(b.html) scheme(nosuchthing) replace"'
local rc = r(rc)
local lg `"`r(logfile)'"'
_cs_expect SP-01 "(`rc' == 198)" "build: rc `rc' (expected 198)"
_cs_log SP-01 "`lg'" "dash build: `sp_needle1'" -1
_cs_log SP-01 "`lg'" "`sp_needle2'" -1
_cs_run `"dash scatter mpg weight, name(g)"' `"_dash_serve_spec, specpath("`mj'") datapath("`dj'") scheme(nosuchthing)"'
local rc = r(rc)
local lg `"`r(logfile)'"'
_cs_expect SP-01 "(`rc' == 198)" "serve spec: rc `rc' (expected 198)"
_cs_log SP-01 "`lg'" "dash serve: `sp_needle1'" -1
_cs_log SP-01 "`lg'" "`sp_needle2'" -1
_cs_done SP-01 "scheme(nosuchthing) draws s2color with twoway's note on scatter and is refused r(198) on build and serve, listing the schemes and themes"

capture mkdir "sub"
tempname spfh
file open `spfh' using "sub/scheme-x.scheme", write text replace
file write `spfh' "#include s2color" _n
file close `spfh'
file open `spfh' using "scheme-my theme.scheme", write text replace
file write `spfh' "#include s2color" _n
file close `spfh'
foreach v in "sub/x" "a:b" "my theme" {
    _cs_run "" `"dash scatter mpg weight, scheme(`v') saving(a.html, replace)"'
    local rc = r(rc)
    local lg `"`r(logfile)'"'
    // Flipped (WP-45 ST-16): twoway draws s2color with a note for a scheme it cannot find (ST-16); the file is never looked for (sub/scheme-x.scheme exists).
    _cs_expect SP-02 "(`rc' == 0)" "scheme(`v'): rc `rc' (expected 0)"
    _cs_log SP-02 "`lg'" "(note: scheme `v' not found, using s2color)" 1
    _cs_log SP-02 "`lg'" "Traceback" 0
}
_cs_done SP-02 "a path, a colon or a blank in scheme() draws s2color with twoway's note before any file is looked for"

file open `spfh' using "scheme-sp03.scheme", write text replace
file write `spfh' "#include s2color" _n "color background #3c4d5e" _n
file close `spfh'
capture erase "a.html"
_cs_run "" `"dash scatter mpg weight, scheme(sp03) saving(a.html, replace)"'
local rc = r(rc)
local lg `"`r(logfile)'"'
_cs_expect SP-03 "(`rc' == 0)" "scatter: rc `rc' (expected 0)"
_cs_notes SP-03 "`lg'" 0
_cs_page SP-03 "a.html" "#3c4d5e" 1
capture erase "b.html"
_cs_run `"dash scatter mpg weight, name(g)"' `"dash build, saving(b.html) scheme(sp03) replace"'
local rc = r(rc)
local lg `"`r(logfile)'"'
_cs_expect SP-03 "(`rc' == 0)" "build: rc `rc' (expected 0)"
_cs_notes SP-03 "`lg'" 0
_cs_page SP-03 "b.html" "#3c4d5e" 1
_cs_run `"dash scatter mpg weight, name(g)"' `"_dash_serve_spec, specpath("`mj'") datapath("`dj'") scheme(sp03)"'
local rc = r(rc)
local lg `"`r(logfile)'"'
_cs_expect SP-03 "(`rc' == 0)" "serve spec: rc `rc' (expected 0)"
_cs_notes SP-03 "`lg'" 0
_cs_done SP-03 "scheme(sp03) from Stata's scheme-sp03.scheme: rc 0 on all three routes, no note, drawn"

local sp_personal "`c(sysdir_personal)'"
local sp_plus "`c(sysdir_plus)'"
capture mkdir "`cs_dir'/personal"
file open `spfh' using "`cs_dir'/personal/scheme-_SP04_.scheme", write text replace
file write `spfh' "#include s2color" _n "color background #4d5e6f" _n
file close `spfh'
sysdir set PERSONAL "`cs_dir'/personal/"
capture noisily set scheme _SP04_
local src = _rc
capture erase "b.html"
_cs_run `"dash scatter mpg weight, name(g)"' `"dash build, saving(b.html) replace"'
local rc = r(rc)
local lg `"`r(logfile)'"'
set scheme s2color
sysdir set PERSONAL "`sp_personal'"
_cs_expect SP-04 "(`src' == 0)" "set scheme _SP04_: rc `src' (expected 0)"
_cs_expect SP-04 "(`rc' == 0)" "rc `rc' (expected 0)"
_cs_notes SP-04 "`lg'" 0
_cs_page SP-04 "b.html" "#4d5e6f" 1
_cs_done SP-04 "set scheme of a PERSONAL scheme: an unschemed build draws it, no note"

capture mkdir "`cs_dir'/plus"
capture mkdir "`cs_dir'/plus/s"
file open `spfh' using "`cs_dir'/plus/s/scheme-sp05.scheme", write text replace
file write `spfh' "#include s2color" _n "color background #5e6f70" _n
file close `spfh'
sysdir set PLUS "`cs_dir'/plus/"
capture erase "a.html"
_cs_run "" `"dash scatter mpg weight, scheme(sp05) saving(a.html, replace)"'
local rc = r(rc)
local lg `"`r(logfile)'"'
_cs_expect SP-05 "(`rc' == 0)" "scheme(sp05): rc `rc' (expected 0)"
_cs_notes SP-05 "`lg'" 0
_cs_page SP-05 "a.html" "#5e6f70" 1
capture noisily set scheme sp05
local src = _rc
capture erase "b.html"
_cs_run `"dash scatter mpg weight, name(g)"' `"dash build, saving(b.html) replace"'
local rc = r(rc)
local lg `"`r(logfile)'"'
set scheme s2color
sysdir set PLUS "`sp_plus'"
_cs_expect SP-05 "(`src' == 0)" "set scheme sp05: rc `src' (expected 0)"
_cs_expect SP-05 "(`rc' == 0)" "inherited build: rc `rc' (expected 0)"
_cs_notes SP-05 "`lg'" 0
_cs_page SP-05 "b.html" "#5e6f70" 1
_cs_done SP-05 "a PLUS/s scheme, named and inherited: rc 0, no note, drawn"

capture mkdir "`cs_dir'/add6"
capture mkdir "`cs_dir'/out"
file open `spfh' using "`cs_dir'/out/x.scheme", write text replace
file write `spfh' "#include s2color" _n "color background #6f7081" _n
file close `spfh'
capture erase "`cs_dir'/add6/scheme-sp06.scheme"
shell ln -s "`cs_dir'/out/x.scheme" "`cs_dir'/add6/scheme-sp06.scheme"
adopath + "`cs_dir'/add6"
capture erase "a.html"
_cs_run "" `"dash scatter mpg weight, scheme(sp06) saving(a.html, replace)"'
local rc = r(rc)
local lg `"`r(logfile)'"'
adopath - "`cs_dir'/add6"
_cs_expect SP-06 "(`rc' == 0)" "rc `rc' (expected 0)"
_cs_notes SP-06 "`lg'" 1
_cs_log SP-06 "`lg'" "was not read" 1
_cs_page SP-06 "a.html" "#1e2d53" 1
_cs_page SP-06 "a.html" "#6f7081" 0
_cs_done SP-06 "a scheme linked out of its ado-path directory is not read: one note, s2color"

mata: _cs_big = fopen("scheme-sp07.scheme", "w"); fwrite(_cs_big, "#include s2color" + char(10)); fwrite(_cs_big, "*" * (1048577 - 17)); fclose(_cs_big)
capture erase "a.html"
_cs_run "" `"dash scatter mpg weight, scheme(sp07) saving(a.html, replace)"'
local rc = r(rc)
local lg `"`r(logfile)'"'
_cs_expect SP-07 "(`rc' == 0)" "rc `rc' (expected 0)"
_cs_notes SP-07 "`lg'" 1
_cs_log SP-07 "`lg'" "larger than 1,048,576 bytes" 1
_cs_page SP-07 "a.html" "#1e2d53" 1
_cs_done SP-07 "a scheme file over 1,048,576 bytes is not read: one note, s2color"

// Flipped (WP-45 ST-16): twoway draws s2color with a note for a scheme it
// cannot find (ST-16); the package's dash-s2color.scheme is still never
// read for the name.
_cs_run "" `"dash scatter mpg weight, scheme(dash-s2color) saving(a.html, replace)"'
local rc = r(rc)
local lg `"`r(logfile)'"'
_cs_expect SP-08 "(`rc' == 0)" "rc `rc' (expected 0)"
_cs_log SP-08 "`lg'" "(note: scheme dash-s2color not found, using s2color)" 1
_cs_done SP-08 "scheme(dash-s2color) with no working-directory file is not found, s2color drawn with twoway's note: dash- names stay working-directory only"

// ----------------------------------------------------------------
// Restore the session, leave the working directory as it was found
// ----------------------------------------------------------------
capture set scheme `cs_scheme0'
capture dash clear
cd "`cs_home'"
foreach f in a.html b.html c.html c15.py cs15inc.scheme mytheme.scheme scheme-zzdashtest.scheme q1.html q2.html q3.html myquoted.scheme myquoted50.scheme myp1.scheme w33s.scheme w33m.scheme sub/scheme-x.scheme "scheme-my theme.scheme" scheme-sp03.scheme personal/scheme-_SP04_.scheme plus/s/scheme-sp05.scheme add6/scheme-sp06.scheme out/x.scheme scheme-sp07.scheme {
    capture erase "`cs_dir'/`f'"
}
foreach d in sub personal plus/s plus add6 out {
    capture rmdir "`cs_dir'/`d'"
}
capture rmdir "`cs_dir'"
capture erase "`c(tmpdir)'dash_cs.log"

// ----------------------------------------------------------------
// Summary
// ----------------------------------------------------------------
local nfail    = ${cs_nfail}
local faillist "${cs_faillist}"
macro drop cs_nfail cs_faillist cs_bad
display as text ""
display as text "============================================================"
if `nfail' == 0 {
    display as text "  test_custom_scheme: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_custom_scheme: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
