*! test_e2e_multi.cscript
*! End-to-end certification script for multi-graph dashboard output.
*!
*! Tests: P1B-67 through P1B-69
*!
*! Usage:  do test/test_e2e_multi.cscript
*!
*! Requires: dash_setup completed, Python + bokeh installed
*! Version: 1.0.0  25mar2026

cscript "dash multi-graph E2E" adodir ".."

// ----------------------------------------------------------------
// Setup
// ----------------------------------------------------------------
capture which jsonio
if _rc != 0 {
    display as error "SKIP: jsonio not installed. Run dash_setup first."
    exit 222
}

// Do NOT probe with `capture python: pass'.  Measured: that returns a
// nonzero rc inside the runner even though the very same session renders
// Bokeh output through `dash build' moments later, and it made 9 of the 14
// scripts -- every end-to-end one -- skip while the suite reported ALL TESTS
// PASSED.  c(python_exec) is set by Stata's own Python configuration and
// reads without executing anything, so it cannot fail for reasons unrelated
// to Python being present.
if "`c(python_exec)'" == "" {
    display as error "SKIP: Python not available."
    exit 222
}

qui sysuse auto, clear

do "../dash_parse.mata"
do "../dash.ado"

// Shared certification helpers.  cert_file_has searches a file from Mata,
// where a line is a value rather than macro text, so no character in the
// generated HTML can end a quote or be parsed as Stata code.
do "cert_helpers.do"

// ================================================================
// P1B-67 — 3 named graphs + dash build → HTML file exists and is non-empty
// ================================================================
dash clear

dash scatter mpg weight, name(s1) title("MPG vs Weight")
dash scatter mpg length, name(s2) title("MPG vs Length")
dash histogram mpg,      name(h1) title("MPG Distribution")

tempfile outfile
local outpath = "`outfile'.html"
capture erase "`outpath'"

dash build, saving("`outpath'") layout(2 2) replace

// Verify file exists
capture confirm file "`outpath'"
assert _rc == 0
display "P1B-67a PASS: multi-graph HTML file created"

// Verify non-empty.
//
// This used to read the first line into a local and test
// assert length(`"`line'"') > 0.  That expands a line of the generated
// HTML into an expression, which is the same defect as the search loops
// below: a double quote in the embedded JSON ends the expansion early and
// the remainder is parsed as Stata code.  Seeking to end-of-file and asking
// for the offset measures the same thing -- the file holds at least one
// byte -- without expanding the file's contents at all.
tempname fh
file open `fh' using "`outpath'", read text
file seek `fh' eof
file seek `fh' query
local fsize = r(loc)
file close `fh'
assert `fsize' > 0
display "P1B-67b PASS: multi-graph HTML file is non-empty"

// ================================================================
// P1B-68 — all 3 registered graphs reach the dashboard
// ================================================================
// This searched the HTML for the strings "s1", "s2" and "h1" -- the name()
// values -- on the theory that they appear as Bokeh model ids or data
// attributes.  They do not.  dash uses a graph's name() purely as a
// registry key; the only user-supplied name that reaches the document is a
// KPI's, as id="kpi_val_<name>".  Measured: "s1" and "s2" occur exactly
// once each in the repo's own dashboard.html, both inside a base64
// "type":"bytes" data blob, and "h1" occurs inside the minified BokehJS
// bundle as n.h1=d("h1"); scatter.html contains neither "s1" nor "s2" at
// all.  So the check was both vacuous and flaky -- a dataset whose base64
// payload happened not to contain "s1" would have failed it for no product
// reason -- and it could only ever pass by coincidence.
//
// What identifies a graph in the output is its TITLE, which the renderer
// draws on the figure.  That is what is asserted now: each of the three
// registered graphs must be present, and a dropped graph fails.  (The
// structural form of the same guarantee -- that every Figure built is
// placed in the layout -- is asserted in the Python suite by
// test_layout_facets.py::TestNoGraphVanishes.)
cert_file_has "`outpath'", needle("MPG vs Weight")
local found_s1 = r(found)
cert_file_has "`outpath'", needle("MPG vs Length")
local found_s2 = r(found)
cert_file_has "`outpath'", needle("MPG Distribution")
local found_h1 = r(found)
assert `found_s1' == 1
assert `found_s2' == 1
assert `found_h1' == 1
display "P1B-68 PASS: all three registered graphs reach the dashboard"

// ================================================================
// P1B-69 — output HTML contains Bokeh gridplot structure
// ================================================================
// Bokeh's gridplot emits a JSON model with type "GridPlot" or
// embeds "gridplot" references in the Bokeh document JSON.
// This was a scan that ORed three needles through
// strpos(lower(`"`ln3'"'), ...) on every line, and it could not reach a
// verdict for the same reason as P1B-68: the double quotes in the Bokeh
// document end the compound quotes the line is expanded in, and Stata then
// parses the rest of the line as code.  Three calls combined with max()
// preserved the original any-one-of-three assertion, case-insensitively as
// lower() made it.
//
// And the first of the three decided it alone.  Measured 24sep2026:
// gridplot, lower-cased, occurs 6 times in the BokehJS the page inlines --
// BokehJS's own name for its GridPlot model and module -- and grid_plot
// once, so the max() was 1 on any Bokeh page whatever its layout, while
// gridlayout occurs nowhere.  The grid is read from the model now.  The page
// writes its GridPlot once: "name":"GridPlot" occurs once, and never in the
// library.  And the document's grid holds the three figures in the cells
// layout(2 2) gives them, filled a row at a time: MPG vs Weight at (0,0),
// MPG vs Length at (0,1), MPG Distribution at (1,0).  The document is
// decoded as BokehJS decodes it (JSON.parse of the unescaped block) and
// read with Document.from_json, as test_conformance.cscript C-03 does.
cert_file_count "`outpath'", needle(`""name":"GridPlot""')
assert r(count) == 1
local p169page "`outpath'"
python:
import json
import re
from sfi import Macro
from bokeh.document import Document
from bokeh.models import GridPlot, Plot


def _p169_doc(path):
    with open(path, encoding="utf-8") as fh:
        page = fh.read()
    ents = {"amp": "&", "lt": "<", "gt": ">", "quot": chr(34),
            "#x27": chr(39), "#x60": chr(96)}
    blocks = re.findall(
        r'<script type="application/json" id="[^"]+">\s*(.*?)\s*</script>',
        page, re.S)
    docs = [d for b in blocks
            for d in json.loads(re.sub(r"&(amp|lt|gt|quot|#x27|#x60);",
                                       lambda m: ents[m.group(1)], b)).values()]
    return Document.from_json(docs[0]) if len(docs) == 1 else None


_p169 = _p169_doc(Macro.getLocal("p169page"))
_p169g = ([m for m in _p169.models if isinstance(m, GridPlot)]
          if _p169 is not None else [])
_p169c = sorted((c[1], c[2], c[0].title.text
                 if isinstance(c[0], Plot) and c[0].title is not None
                 else type(c[0]).__name__)
                for g in _p169g for c in g.children)
Macro.setLocal("p169_ngrid", str(len(_p169g)))
Macro.setLocal("p169_cells", "|".join("%d,%d %s" % c for c in _p169c))
del _p169, _p169g, _p169c
end
display `"P1B-69: grid cells `p169_cells'"'
assert `p169_ngrid' == 1
assert "`p169_cells'" == "0,0 MPG vs Weight|0,1 MPG vs Length|1,0 MPG Distribution"
display "P1B-69 PASS: HTML contains Bokeh gridplot structure"

// ================================================================
// P1B-70 — graphs with if() conditions do not cause r(198) in dash build
//
// Regression test for bug: `if "${dash_json_name}" != ""` broke when
// the JSON contained embedded double-quotes (e.g. "if_expr":"rep78==1").
// The fix: use `local _chk : strlen global dash_json_name` to check
// whether the global is set without embedding its content in a
// double-quoted expression context.
// ================================================================
dash clear

qui sysuse auto, clear

// Register a multi-plot graph with if() conditions (categorical encoding)
dash (scatter mpg weight if rep78==1, mc(navy)         ms(circle)  msi(small)) ///
     (scatter mpg weight if rep78==2, mc(maroon)       ms(square)  msi(small)) ///
     (scatter mpg weight if rep78==3, mc(forest_green) ms(triangle) msi(small)) ///
     (scatter mpg weight if rep78==4, mc(orange)       ms(diamond) msi(small)) ///
     (scatter mpg weight if rep78==5, mc(purple)       ms(inverted_triangle) msi(small)), ///
     name(cat1) title("Rep78 Categorical")

// Register a plain graph alongside
dash scatter mpg weight, name(plain1) title("MPG vs Weight")

tempfile outfile_if
local outpath_if = "`outfile_if'.html"
capture erase "`outpath_if'"

// This call must NOT produce r(198) (the regression)
dash build, saving("`outpath_if'") layout(auto) replace

// Verify file exists and is non-empty
capture confirm file "`outpath_if'"
assert _rc == 0
display "P1B-70a PASS: dash build with if() conditions completed without r(198)"

// This read the first line into a local and tested
// assert length("`line_if'") > 0.  Expanded inside plain double quotes, a
// double quote in the HTML closes the Stata string early and the rest of
// the line is parsed as code -- and this file is the likeliest to trip it,
// since the if() expressions are written into the JSON as quoted strings.
// Seeking to end-of-file and reading the offset asserts the same thing,
// that the file holds at least one byte, without expanding its contents.
tempname fh_if
file open `fh_if' using "`outpath_if'", read text
file seek `fh_if' eof
file seek `fh_if' query
local fsize_if = r(loc)
file close `fh_if'
assert `fsize_if' > 0
display "P1B-70b PASS: HTML output from if() graphs is non-empty"

// ================================================================
// P1B-71 — a placement whose first name begins with bs is a placement
// ================================================================
// Measured 23sep2026: layout(bsales:1,1 g2:1,2) was refused ("layout()
// must be 'auto', ...") because every reader took a value starting with
// bs for the Bootstrap form, and the renderer drew it as layout(bs);
// layout(g2:1,1 bsales:1,2) built.  A value that reads whole as
// placements is one -- a graph named bs placed first as well -- and a
// Bootstrap page is the only one with db-col-lg- cells.
dash clear
dash scatter mpg weight, name(bsales)
dash scatter price weight, name(g2)
tempfile p171
local p171f = "`p171'.html"
capture noisily dash build, saving("`p171f'") replace nobrowser layout(bsales:1,1 g2:1,2)
assert _rc == 0
cert_file_has "`p171f'", needle("db-col-lg-")
assert r(found) == 0
dash clear
dash scatter mpg weight, name(bs)
dash scatter price weight, name(g2)
capture noisily dash build, saving("`p171f'") replace nobrowser layout(bs:1,1 g2:1,2)
assert _rc == 0
cert_file_has "`p171f'", needle("db-col-lg-")
assert r(found) == 0
capture noisily dash build, saving("`p171f'") replace nobrowser layout(bs)
assert _rc == 0
cert_file_has "`p171f'", needle("db-col-lg-")
assert r(found) == 1
display "P1B-71 PASS: a placement layout naming a graph that begins with bs builds as placed"

// ================================================================
// Cleanup
// ================================================================
dash clear

display ""
display "All multi-graph E2E tests PASSED."
