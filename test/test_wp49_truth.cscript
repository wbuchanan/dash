*! test_wp49_truth.cscript
*! WP-49's ONE certification script (.ultraplan/sections/index.md PD-6):
*! every comparison with twoway's drawing or with Stata's own values that
*! WP-49's sections need lives here, one block per GAPS4 row (or per
*! harness tool), appended above the "append new blocks above this line"
*! marker in section order.  Refusal, message and return-code checks join
*! the EXISTING script for their area (merge rule R1).
*!
*! Made from test/templates/wp_truth_template.cscript (49 -> the WP's
*! number).  S00 is the scaffold smoke (Q4900-1).  A section appends
*! `* ==== S<MM> <lead id>: <what> ====` ... `* ==== end S<MM> ====` (or
*! `S<MM> tool: <what>` for a section with no item), its helper programs
*! directly above its first header, and writes only inside its own
*! blocks.  Case ids are Q49<MM>-<k> (PD-5).
*!
*! Usage: via run_all_cscripts.do.  One block alone: WP49_ONLY=S<MM> in
*! the driver's environment.  Each block prints "S<MM> start" and "S<MM>
*! end" with the date and time.  The suite runs it in every session;
*! DASH_CERT_SHARD=k/N runs part k of N of the blocks; a part with no
*! block ends 0.

cscript "WP-49 truth: twoway comparisons" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off


do "cert_helpers.do"
quietly do "cert_svg.do"
qui do "../dash_parse.mata"
qui do "../dash.ado"
global dash_nobrowser 1

// ----------------------------------------------------------------
// Tally helpers -- test_wp29_truth.cscript's _w29_expect/_w29_done,
// renamed _w49_ for this script.  A case is any number of
// _w49_expect lines closed by one _w49_done.
// ----------------------------------------------------------------
global w49_nfail    = 0
global w49_faillist ""
global w49_bad      = 0
global w49_ncase    = 0

capture program drop _w49_expect
program define _w49_expect
    version 19
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global w49_bad = 1
    }
end

capture program drop _w49_done
program define _w49_done
    version 19
    args id msg
    if ${w49_bad} {
        global w49_nfail    = ${w49_nfail} + 1
        global w49_faillist "${w49_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global w49_bad   = 0
    global w49_ncase = ${w49_ncase} + 1
end

// A fresh directory for this run's files, never one that already exists:
// a fixed name in a shared temp directory could be planted by another
// account (rule 1), so a name Stata has not handed out before is made and
// the run fails if it cannot be.  Every block writes only under it.
tempfile w49_base
local w49_work "`w49_base'_w49"
capture mkdir "`w49_work'"
if _rc {
    display as error "test_wp49_truth: cannot create the work directory `w49_work' (rc `=_rc')"
    exit 9
}

// ---- parts: begin (WP-49 test performance) ----
// The certification suite runs this script in every one of its sessions
// (its row in run_all_cscripts.do's shard table is "* * *"); with
// DASH_CERT_SHARD=k/N set, the session runs part k of N of the blocks.
// The parts are balanced longest first onto the least loaded part (the
// lowest numbered of equals), by the seconds below -- a block not listed
// counts 1 s (section-01 D-01.f) -- the rule scripts/cert_shards.py uses
// for the scripts.  Unset, or with WP49_ONLY set
// (which keeps its precedence), every block runs.  A block runs when its
// gate finds its id in w49_run.
// Seconds: each block's start/end lines in the WP's last measured
// certification run, rounded up, at least 1; a block not listed
// counts 1 s.
local w49_secs S00 1
local w49_sh : environment DASH_CERT_SHARD
mata: st_local("w49_ok", strofreal(st_local("w49_sh") == "" | ustrregexm(st_local("w49_sh"), "^[1-4]/[1-4]$")))
if !`w49_ok' {
    display as error "test_wp49_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 4"
    exit 198
}
local w49_k 1
local w49_N 1
if "`w49_sh'" != "" {
    local w49_k = real(substr("`w49_sh'", 1, 1))
    local w49_N = real(substr("`w49_sh'", 3, 1))
}
local w49_only : env WP49_ONLY
if `"`macval(w49_only)'"' != "" | `w49_N' == 1 {
    local w49_k 1
    local w49_N 1
}
if `w49_k' > `w49_N' {
    display as error "test_wp49_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 4"
    exit 198
}
capture confirm file "test_wp49_truth.cscript"
if _rc {
    display as error "test_wp49_truth: run it from test/, where it reads its own blocks"
    exit 601
}
capture mata: mata drop _w49_part()
mata:
// The ids of the blocks (their header lines, in file order), and those of
// part k of n: longest first onto the least loaded part.
void _w49_part(string scalar file, string scalar table, real scalar k,
               real scalar n)
{
    string colvector lines, ids
    string rowvector tok
    real colvector sec, o, at
    real rowvector load
    real scalar i, j, p, best
    string scalar run

    lines = cat(file)
    ids = J(0, 1, "")
    for (i = 1; i <= rows(lines); i++) {
        if (ustrregexm(lines[i], "^\* ==== (S[0-9]+) ")) {
            if (!anyof(ids, ustrregexs(1))) ids = ids \ ustrregexs(1)
        }
    }
    sec = J(rows(ids), 1, 1)
    tok = tokens(table)
    for (j = 1; j + 1 <= cols(tok); j = j + 2) {
        for (i = 1; i <= rows(ids); i++) {
            if (ids[i] == tok[j]) sec[i] = strtoreal(tok[j + 1])
        }
    }
    o = order((-sec, (1::rows(ids))), (1, 2))
    load = J(1, n, 0)
    at = J(rows(ids), 1, 0)
    for (i = 1; i <= rows(o); i++) {
        best = 1
        for (p = 2; p <= n; p++) if (load[p] < load[best]) best = p
        load[best] = load[best] + sec[o[i]]
        at[o[i]] = best
    }
    run = ""
    for (i = 1; i <= rows(ids); i++) if (at[i] == k) run = run + " " + ids[i]
    st_local("w49_run", strtrim(run))
}
end
mata: _w49_part("test_wp49_truth.cscript", st_local("w49_secs"), `w49_k', `w49_N')
display as text "test_wp49_truth: part `w49_k'/`w49_N' runs `: word count `w49_run'' blocks: `w49_run'"
// ---- parts: end ----

* ==== S00 scaffold: the helpers load and a twoway SVG is read ====
local only : env WP49_ONLY
if inlist("`only'", "", "S00") & `: list posof "S00" in w49_run' {
    display as text "S00 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4900-1: cert_svg_export and cert_svg_texts on one twoway scatter,
    // and dash's own programs are loaded from this tree.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(w49s01, replace)
    cert_svg_export, name(w49s01) file("`w49_work'/w49s01.svg")
    local s01_rc   = r(rc)
    local s01_file "`r(file)'"
    _w49_expect Q4900-1 "(`s01_rc' == 0)" "cert_svg_export rc `s01_rc'"
    capture confirm file "`s01_file'"
    _w49_expect Q4900-1 "(_rc == 0)" "r(file) `s01_file' does not exist"
    cert_svg_texts, file("`s01_file'")
    local s01_n    = r(n)
    local s01_list "`r(list)'"
    _w49_expect Q4900-1 "(`s01_n' > 0)" "cert_svg_texts found no text elements"
    capture program list _dash_serve
    _w49_expect Q4900-1 "(_rc == 0)" "dash.ado's _dash_serve is not loaded"
    _w49_done Q4900-1 "a twoway SVG was written and read (`s01_n' texts); dash is loaded"

    capture erase "`s01_file'"
    capture erase "`s01_list'"
    capture graph drop w49s01
    display as text "S00 end " c(current_date) " " c(current_time)
}
* ==== end S00 ====

// _w49_first_line(file): the first line a log holds that is not the
// command's echo, blanks collapsed, quotes and backticks made ', at most
// 200 characters (section 49-01).
capture mata: mata drop _w49_first_line()
mata:
string scalar _w49_first_line(string scalar f)
{
    string colvector l
    real scalar      i

    l = cat(f)
    for (i = 1; i <= rows(l); i++) {
        if (strtrim(l[i]) == "" | substr(l[i], 1, 2) == ". " | substr(l[i], 1, 2) == "> ") continue
        return(substr(subinstr(subinstr(subinstr(stritrim(strtrim(l[i])), char(34), "'"), char(96), "'"), "$", "S"), 1, 200))
    }
    return("")
}
end

// _w49_first <who> <command>: runs `<who> <command>' under a text log
// and leaves its rc in _w49_rc and its first printed line (blanks
// collapsed, quotes and backticks made ', at most 200 characters) in
// _w49_line (section 49-01).
capture program drop _w49_first
program define _w49_first
    version 19
    gettoken who 0 : 0
    capture graph drop _all
    capture dash clear
    set linesize 255
    capture log close _w49log
    tempfile lg
    quietly log using "`lg'", name(_w49log) text replace
    capture noisily `who' `0'
    local rc = _rc
    quietly log close _w49log
    set linesize 80
    mata: st_local("_w49_s", _w49_first_line(st_local("lg")))
    c_local _w49_rc `rc'
    c_local _w49_line `"`_w49_s'"'
    capture graph drop _all
    capture dash clear
end

// _w49_same <case> <command>: twoway's and dash's rc agree, and when
// both refuse, their first lines.
capture program drop _w49_same
program define _w49_same
    version 19
    args case cmd
    _w49_first twoway `cmd'
    local trc `_w49_rc'
    local tl `"`_w49_line'"'
    _w49_first dash `cmd'
    // A drawn graph's lines are dash's page path: only the rc is compared.
    local same = (`trc' == `_w49_rc') & (`trc' == 0 | `"`macval(tl)'"' == `"`macval(_w49_line)'"')
    _w49_expect `case' "(`same' == 1)" `"`macval(cmd)': twoway rc `trc' `macval(tl)'; dash rc `_w49_rc' `macval(_w49_line)'"'
end

* ==== S01 plot:PT-7: first lines in twoway's words ====
local only : env WP49_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w49_run' {
    display as text "S01 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4901-9: live, beside twoway: the option as typed at each refusal
    // site, and the syn:SD-12 lines (test_option_validation.cscript's
    // Q4901-1 and Q4901-3 read the same probes from the fixture).
    // ------------------------------------------------------------
    sysuse auto, clear
    foreach c in "function y = x, ba(3)" "dropline mpg weight, ba(3)" ///
        "scatter mpg weight, deg(2)" "scatter mpg weight, ker(gaussian)" ///
        "lpoly mpg weight, deg(abc)" "lpoly mpg weight, n(2.5)" ///
        "scatter mpg weight, ato" "scatter mpg weight, fitp(line)" ///
        "scatter mpg weight, pcyc(abc)" "scatter mpg weight, ccut(1 2)" ///
        "scatter mpg weight, disc" "scatter mpg weight, mwid" ///
        "scatter mpg weight, nowe" ///
        "(scatter mpg weight, xsize(3)) (line mpg weight, xsiz(4))" ///
        "(scatter mpg weight" "scatter mpg weight, by(nosuch)" ///
        "scatter mpg weight, mlabel(nosuch)" "[aw=price] scatter mpg weight" ///
        "scatter mpg weight, legloc(6)" "(scatter mpg weight), legloc(abc)" ///
        "scatter mpg weight, useplotregion(1)" {
        _w49_same Q4901-9 `"`c'"'
    }
    _w49_done Q4901-9 "first lines are twoway's, the option as typed"
    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====

* ==== S01 plot:PT-6: tsset, glued weights, %tb lines ====
local only : env WP49_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w49_run' {
    display as text "S01 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4901-10: live, beside twoway: tsline and tsrline without tsset, a
    // weight glued to the type, and a date tline() on a %tb axis
    // (test_parser.cscript's Q4901-6..8 read the same probes from
    // test/fixtures/refusal_line_truth.json).
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly generate yl = mpg - 1
    quietly generate yh = mpg + 1
    // The weight before the varlist with a blank after the type, with
    // nothing after it, and on the types twoway answers otherwise
    // (measured 12nov2026: varlist required r(100), expression required
    // r(100), weights not allowed r(198) and r(101)).
    foreach c in "tsline mpg" "tsrline yl yh" "scatter[aw=price] mpg weight" ///
        "hist[fw=rep78] mpg" "scatter mpg weight [aw=price]" ///
        "scatter [aw=price] mpg weight" "scatter[aw=price]" ///
        "scatter mpg weight || line[aw=price] mpg weight" ///
        "scatter[aw=price] if foreign" "function [aw=price]" ///
        "function[aw=price] y = x" "scatteri[aw=price]" ///
        "scatteri[aw=price] 1 2" "contour[aw=price] mpg weight turn" {
        _w49_same Q4901-10 `"`c'"'
    }
    quietly sysuse sp500, clear
    quietly bcal create "`w49_work'/u49", from(date) replace
    adopath + "`w49_work'"
    quietly generate tb = bofd("u49", date)
    format tb %tbu49
    foreach c in "scatter close tb, tline(10nov2001)" "scatter close tb, tline(100)" {
        _w49_same Q4901-10 `"`c'"'
    }
    adopath - "`w49_work'"
    capture erase "`w49_work'/u49.stbcal"
    _w49_done Q4901-10 "tsset, glued-weight and %tb lines are twoway's"
    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====

* ==== S02 basic:PT-12: silent where twoway is silent ====
local only : env WP49_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w49_run' {
    display as text "S02 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4902-1 (WP-49 basic:PT-12): one sampled row per catch-all option
    // of the generated tw_silent table -- the option at a value
    // noted_option_truth.json measures, on a type its row names -- run
    // beside twoway: twoway prints no note and dash names nothing.
    // Q4902-2: one row per option still noted where twoway draws another
    // picture: dash still names it.  The bases are
    // extract_noted_option_truth.do's.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly gen yl = mpg - 1
    quietly gen yh = mpg + 1
    quietly gen t = _n
    quietly tsset t
    quietly gen gx = mod(_n - 1, 9) + 1 if _n <= 72
    quietly gen gy = floor((_n - 1) / 9) + 1 if _n <= 72
    quietly gen gz = gx * gy + gy
    local q1log "`w49_work'/q4902_1.log"
    local q1_n 0
    foreach q1 in ///
        `"back|mspline mpg weight, back"' ///
        `"bargap|bar mpg weight, bargap(50)"' ///
        `"below|scatter mpg weight, below"' ///
        `"bmcolor|scatter mpg weight, bmcolor(red)"' ///
        `"bmlalign|scatter mpg weight, bmlalign(outside)"' ///
        `"bmlcolor|scatter mpg weight, bmlcolor(red)"' ///
        `"bmlpattern|scatter mpg weight, bmlpattern(dash)"' ///
        `"bmlwidth|scatter mpg weight, bmlwidth(thick)"' ///
        `"bmsize|scatter mpg weight, bmsize(large)"' ///
        `"clalign|line mpg weight, clalign(outside)"' ///
        `"copyscheme|scatter mpg weight, copyscheme"' ///
        `"dlpattern|scatter mpg weight, dlpattern(dot)"' ///
        `"logging|scatter mpg weight, logging"' ///
        `"nologging|scatter mpg weight, nologging"' ///
        `"norefscheme|scatter mpg weight, norefscheme"' ///
        `"norescaling|scatter mpg weight, norescaling"' ///
        `"notitling|scatter mpg weight, notitling"' ///
        `"omitallmiss|line mpg weight, omitallmiss"' ///
        `"omitdupmiss|line mpg weight, omitdupmiss"' ///
        `"omitnothing|line mpg weight, omitnothing"' ///
        `"onepanel|tsline mpg, onepanel"' ///
        `"refscheme|scatter mpg weight, refscheme"' ///
        `"rescaling|scatter mpg weight, rescaling"' ///
        `"titling|scatter mpg weight, titling"' ///
        `"zvarformat|contourline gz gy gx, zvarformat(%9.1f)"' {
        gettoken q1o q1c : q1, parse("|")
        local q1c = substr(`"`q1c'"', 2, .)
        local ++q1_n
        capture log close _q49
        capture erase "`q1log'"
        quietly log using "`q1log'", text replace name(_q49)
        capture noisily twoway `q1c' name(q49tw, replace) nodraw
        local q1trc = _rc
        quietly log close _q49
        capture graph drop q49tw
        cert_log_has "`q1log'", needle("(note:")
        local q1tn = r(found)
        _w49_expect Q4902-1 "(`q1trc' == 0 & !`q1tn')" `"twoway `q1c': r(`q1trc'), a note `q1tn'"'
        capture erase "`q1log'"
        quietly log using "`q1log'", text replace name(_q49)
        capture noisily dash `q1c' saving("`w49_work'/q4902_1.html", replace)
        local q1rc = _rc
        quietly log close _q49
        capture dash clear
        cert_log_has "`q1log'", needle("ignoring unsupported")
        _w49_expect Q4902-1 "(`q1rc' == 0 & !r(found))" `"dash `q1c': r(`q1rc'), named `q1o' where twoway is silent"'
    }
    _w49_done Q4902-1 "`q1_n' catch-all options twoway draws the same with are taken in silence"

    foreach q2 in ///
        `"clalign|contour gz gy gx, clalign(outside)"' ///
        `"dlpattern|dot mpg weight, dlpattern(dot)"' ///
        `"omitanymiss|line mpg weight, omitanymiss"' {
        gettoken q2o q2c : q2, parse("|")
        local q2c = substr(`"`q2c'"', 2, .)
        capture erase "`q1log'"
        quietly log using "`q1log'", text replace name(_q49)
        capture noisily dash `q2c' saving("`w49_work'/q4902_1.html", replace)
        local q2rc = _rc
        quietly log close _q49
        capture dash clear
        cert_log_has "`q1log'", needle("ignoring unsupported option(s): `q2o'")
        _w49_expect Q4902-2 "(`q2rc' == 0 & r(found))" `"dash `q2c': r(`q2rc'), `q2o' not named"'
    }
    _w49_done Q4902-2 "an option twoway draws differently with is still named"
    capture erase "`q1log'"
    capture erase "`w49_work'/q4902_1.html"
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

// _q4902_progs(file): the names of file's "program define" lines, one
// blank between them (S02 plot:PT-11, Q4902-7).
capture mata: mata drop _q4902_progs()
mata:
string scalar _q4902_progs(string scalar file)
{
    string colvector l
    string scalar    out
    real scalar      i

    l = cat(file)
    out = ""
    for (i = 1; i <= rows(l); i++) {
        if (ustrregexm(l[i], "^program define ([A-Za-z_0-9]+)")) out = out + " " + ustrregexs(1)
    }
    return(out)
}
end

* ==== S02 plot:PT-11: no library messages ====
local only : env WP49_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w49_run' {
    display as text "S02 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4902-7 (WP-49 plot:PT-11): no text of dash's Mata library reaches
    // the log -- after discard (the library still in memory, dash.ado
    // loaded again), after one library function is dropped (the repair
    // in _dash_require_mata), after the whole library is dropped and
    // discard run (dash.ado loads it), and through stat:PT-22's fpfit
    // estcmd(poisson) sequence.  Neither "already exists" nor "lines
    // skipped" nor mata describe's line for the probe is printed, and each
    // command ends r(0).
    // ------------------------------------------------------------
    // dash.ado was run by this script (qui do), so discard alone keeps its
    // programs; they are dropped by name (its "program define" lines) so
    // the next dash command loads dash.ado from the ado-path, as a user's
    // session does after discard.
    capture program drop _q4902_unload
    program define _q4902_unload
        version 19
        mata: st_local("q7p", _q4902_progs("../dash.ado"))
        foreach p of local q7p {
            capture program drop `p'
        }
        discard
    end
    sysuse auto, clear
    local q7log "`w49_work'/q4902_7.log"
    capture log close _q49
    capture erase "`q7log'"
    quietly log using "`q7log'", text replace name(_q49)
    _q4902_unload
    capture noisily dash scatter mpg weight, saving("`w49_work'/q4902_7a.html", replace)
    local q7a = _rc
    capture mata: mata drop _dash_dp_format()
    capture noisily dash scatter mpg weight, saving("`w49_work'/q4902_7b.html", replace)
    local q7b = _rc
    capture noisily dash fpfit mpg weight, estcmd(poisson) saving("`w49_work'/q4902_7c.html", replace)
    local q7c = _rc
    _q4902_unload
    capture mata: mata drop _dash_*()
    capture noisily dash scatter mpg weight, saving("`w49_work'/q4902_7d.html", replace)
    local q7d = _rc
    quietly log close _q49
    capture dash clear
    capture program drop _q4902_unload
    _w49_expect Q4902-7 "(`q7a' == 0 & `q7b' == 0 & `q7c' == 0 & `q7d' == 0)" "r(`q7a') r(`q7b') r(`q7c') r(`q7d')"
    foreach q7n in "already exists" "lines skipped" "string scalar" {
        cert_log_has "`q7log'", needle("`q7n'")
        _w49_expect Q4902-7 "(!r(found))" `"the log holds "`q7n'" (`r(count)' times)"'
    }
    _w49_done Q4902-7 "no library text after discard, a repair, a dropped library or the fpfit sequence"
    capture erase "`q7log'"
    foreach q7f in a b c d {
        capture erase "`w49_work'/q4902_7`q7f'.html"
    }
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

* ==== append new blocks above this line ====

// ----------------------------------------------------------------
// Summary (test_wp29_truth.cscript's shape)
// ----------------------------------------------------------------
capture graph drop _all
capture dash clear
capture rmdir "`w49_work'"
local nfail    = ${w49_nfail}
local faillist "${w49_faillist}"
local ncase    = ${w49_ncase}
local only : env WP49_ONLY
macro drop w49_nfail w49_faillist w49_bad w49_ncase
display as text ""
display as text "============================================================"
if `ncase' == 0 {
    if `w49_N' > 1 & `"`macval(only)'"' == "" & "`w49_run'" == "" {
        display as text "test_wp49_truth: part `w49_k'/`w49_N' has no block to run"
        display as text "============================================================"
        exit 0
    }
    // A WP49_ONLY that names no block, or only a stub, ran nothing:
    // that is not a pass.
    display as error "  test_wp49_truth: no case ran (WP49_ONLY=`only')"
    display as text "============================================================"
    exit 9
}
else if `nfail' == 0 {
    display as text "  test_wp49_truth: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_wp49_truth: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
