*! test_e2e_serve.cscript
*! End-to-end certification script for dash serve subcommand and
*! dash build, server option.
*!
*! Tests: P4-73 through P4-83
*!
*! Usage:  do test/test_e2e_serve.cscript
*!
*! Requires: dash_setup completed, Python + bokeh installed
*! Version: 1.0.0  25mar2026

cscript "dash serve E2E" adodir ".."

// ----------------------------------------------------------------
// Setup — check dependencies
// ----------------------------------------------------------------

// Do NOT probe with `capture python: pass'.  Measured: that returns a
// nonzero rc inside the runner even though the very same session renders
// Bokeh output through `dash build' moments later, and it made 9 of the 14
// scripts -- every end-to-end one -- skip while the suite reported ALL TESTS
// PASSED.  c(python_exec) is set by Stata's own Python configuration and
// reads without executing anything, so it cannot fail for reasons unrelated
// to Python being present.
if "`c(python_exec)'" == "" {
    display as error "SKIP: Python not available."
    exit 222
}

// Check Bokeh available
// Whether bokeh is importable can only be answered by importing it, so
// this probe does run Python -- but the FIRST python call of a session
// returns a nonzero rc under the runner for reasons that have nothing to do
// with the import (see the c(python_exec) note above).  Spend that failure
// on a throwaway call, then ask the real question, then ask it once more.
capture python: pass
capture python: import bokeh
if _rc != 0 capture python: import bokeh
if _rc != 0 {
    display as error "SKIP: bokeh not installed. Run dash_setup first."
    exit 222
}

qui sysuse auto, clear

// Load the dash command and parser
do "../dash_parse.mata"
do "../dash.ado"

// Shared certification helpers.  cert_file_has searches a file from Mata,
// where a line is a value rather than macro text, so no character in the
// generated server app can end a quote or be parsed as Stata code.
do "cert_helpers.do"

// ================================================================
// P4-73 — cscript header and dependency checks passed
// ================================================================
display "P4-73 PASS: Python and bokeh both available"

// ================================================================
// P4-74 — dash serve with empty registry → rc == 198
// ================================================================
dash clear
capture dash serve
assert _rc == 198
display "P4-74 PASS: dash serve with empty registry returns rc=198"

// ================================================================
// P4-75 — dash serve, port(99999) → rc == 198
// ================================================================
qui sysuse auto, clear
dash scatter mpg weight, name(s1)
capture dash serve, port(99999)
assert _rc == 198
display "P4-75 PASS: dash serve, port(99999) returns rc=198"
dash clear

// ================================================================
// P4-76 — dash serve, port(0) → rc == 198
// ================================================================
qui sysuse auto, clear
dash scatter mpg weight, name(s1)
capture dash serve, port(0)
assert _rc == 198
display "P4-76 PASS: dash serve, port(0) returns rc=198"
dash clear

// ================================================================
// P4-77 — dash serve, port(abc) → rc == 198
// ================================================================
qui sysuse auto, clear
dash scatter mpg weight, name(s1)
capture dash serve, port(abc)
assert _rc == 198
display "P4-77 PASS: dash serve, port(abc) returns rc=198"
dash clear

// ================================================================
// P4-78 — dash build, server → .py file created
// ================================================================
qui sysuse auto, clear
dash scatter mpg weight, name(s1)

tempfile outpy
local outpath = "`outpy'.py"
capture erase "`outpath'"

dash build, saving("`outpath'") server replace

// Verify file exists
capture confirm file "`outpath'"
assert _rc == 0
display "P4-78a PASS: dash build server → .py file created"

// Verify file is non-empty.
//
// This used to read the first line into a local and test
// `assert length(`"`line'"') > 0'.  That expands a line of the generated
// app into an expression, which is the same defect as the search loops
// below: the " characters in the base64 constants and in the embedded JS
// end the expansion early and the remainder is parsed as Stata code.
// Seeking to end-of-file and asking for the offset measures the same thing
// -- the file holds at least one byte -- and never expands the file's
// contents.
tempname fh
file open `fh' using "`outpath'", read text
file seek `fh' eof
file seek `fh' query
local fsize = r(loc)
file close `fh'
assert `fsize' > 0
display "P4-78b PASS: generated .py file is non-empty"

dash clear

// ================================================================
// P4-79 — generated .py is syntactically valid Python (ast.parse)
// ================================================================
qui sysuse auto, clear
dash scatter mpg weight, name(s1)

tempfile outpy2
local outpath2 = "`outpy2'.py"
capture erase "`outpath2'"
dash build, saving("`outpath2'") server replace

// A `python: ... end' block cannot be nested inside `capture { }'.  The
// python block swallows the brace block's own closing `}' and then every
// line after it up to the next `end', hands the lot to Python as source,
// and -capture- hides the SyntaxError that results.  Measured in the suite
// log: after `capture {' here the next line the do-file echoed was the
// `tempname fh3' of P4-80.  Everything between -- this test's `assert',
// its PASS message, and P4-80's `tempfile outpy3', `local outpath3' and
// `dash build' -- was eaten as Python source, which is why P4-80 then
// opened an EMPTY path and the script died with r(198) "invalid file
// specification".  So P4-79 never asserted anything either.  This is the
// same interaction as Bug 15, where python:...end closed a `program
// define' early (see test_ado_loads.cscript).
//
// The block therefore runs at the top level, the form the passing
// test_abbreviations.cscript uses, and reports its own failure through a
// global rather than through braces and -capture-.
local parse_rc = 0
global ZSRV_PARSE_RC "0"
python:
import ast
import sfi

try:
    with open(r"`outpath2'", "r", encoding="utf-8") as _f:
        _src = _f.read()
    ast.parse(_src)
except Exception:
    sfi.Macro.setGlobal("ZSRV_PARSE_RC", "1")
end
local parse_rc = $ZSRV_PARSE_RC
macro drop ZSRV_PARSE_RC

assert `parse_rc' == 0
display "P4-79 PASS: generated .py file passes ast.parse()"

dash clear

// ================================================================
// P4-80 — generated .py contains "make_document"
// ================================================================
qui sysuse auto, clear
dash scatter mpg weight, name(s1)

tempfile outpy3
local outpath3 = "`outpy3'.py"
capture erase "`outpath3'"
dash build, saving("`outpath3'") server replace

// This check used to be two overlapping pieces and neither reached a
// verdict.
//
// The first was a `capture { python: ... end }' block that set `found_mk'
// from Python.  No assertion ever read `found_mk', so it certified
// nothing, and it was the second instance of the brace-nested python block
// described at P4-79.  It is gone: removing it removes no assertion.
//
// The second was a line-by-line scan testing
// `strpos(`"`line'"', "make_document")'.  The generated app carries the
// spec and the data as quoted base64 constants and embeds its JS callbacks
// as quoted strings, so its lines are dense with " characters; a sequence
// such as "' or `" inside one terminates the compound quotes the macro is
// expanded in and Stata parses the rest of the app's own content as code.
// cert_file_has runs the same search in Mata, where a line is a value and
// nothing in it is ever expanded, and it exits 603 rather than reporting
// "not found" if the file cannot be opened.  The search is case-sensitive,
// as the loop's was.
cert_file_has "`outpath3'", needle("make_document")
local found_in_file = r(found)
assert `found_in_file' == 1
display "P4-80 PASS: generated .py contains 'make_document'"

dash clear

// ================================================================
// P4-81 — generated .py contains "Server"
// ================================================================
qui sysuse auto, clear
dash scatter mpg weight, name(s1)

tempfile outpy4
local outpath4 = "`outpy4'.py"
capture erase "`outpath4'"
dash build, saving("`outpath4'") server replace

// This was a line-by-line scan testing `strpos(`"`line'"', "Server")'.  It
// could not reach a verdict for the reason given at P4-80: a line of the
// generated app is full of " characters, which end the compound quotes the
// line is expanded in and leave Stata parsing the app's content as code.
// The search is case-sensitive, as the loop's was: "Server" is the Bokeh
// class name, and a case-insensitive search would also match the word
// "server" in the paths, comments and mode strings the file is full of.
cert_file_has "`outpath4'", needle("Server")
local found_server = r(found)
assert `found_server' == 1
display "P4-81 PASS: generated .py contains 'Server'"

dash clear

// ================================================================
// P4-82 — generated .py contains "allow_websocket_origin"
// ================================================================
qui sysuse auto, clear
dash scatter mpg weight, name(s1)

tempfile outpy5
local outpath5 = "`outpy5'.py"
capture erase "`outpath5'"
dash build, saving("`outpath5'") server replace

// This was a line-by-line scan testing
// `strpos(`"`line'"', "allow_websocket_origin")'.  Same defect as P4-80 and
// P4-81: expanding a line of the generated app into a compound-quoted macro
// cannot survive the " characters it is made of.  That matters here in
// particular -- this is the check that the server app pins its websocket
// origin, and it has never actually run.  The search is case-sensitive, as
// the loop's was; the needle is a Python keyword argument and its case is
// fixed.
cert_file_has "`outpath5'", needle("allow_websocket_origin")
local found_wso = r(found)
assert `found_wso' == 1

// The needle cannot see the keyword argument go.  The generator also writes
// allow_websocket_origin into _dash_server_app's docstring and into a
// comment in its body, so with the argument deleted the search
// above still finds it (measured 24sep2026), and the value -- which origins
// the websocket admits -- is never read.  So the app's own launcher is run
// with Server replaced by a recorder: nothing binds a port, and what Server
// would have been handed is read back.  The origins must be exactly the two
// spellings of loopback on the port asked for.
local p482app "`outpath5'"
global ZSRV_WSO ""
python:
import importlib.util
import sfi

try:
    _p482s = importlib.util.spec_from_file_location(
        "_test_serve_p482", sfi.Macro.getLocal("p482app"))
    _p482m = importlib.util.module_from_spec(_p482s)
    _p482s.loader.exec_module(_p482m)
    _p482kw = {}
    _p482m.Server = lambda *a, **k: _p482kw.update(k)
    # WP-29 P0.12a: a key installed, as dash serve's is, so no link file
    # is made; the Server must carry Gate A, the key's provider.
    _p482m._DASH_SERVE_TOKEN = "dashTestKey_0123456789abcdefghijklmnopqrstuvwxyz"
    _p482m._dash_server_app(port=5006)
    sfi.Macro.setGlobal("ZSRV_WSO", repr(_p482kw.get("allow_websocket_origin")))
    sfi.Macro.setGlobal("ZSRV_AUTH", type(_p482kw.get("auth_provider")).__name__)
    del _p482s, _p482m, _p482kw
except Exception as _p482e:
    sfi.Macro.setGlobal("ZSRV_WSO", "error: " + repr(_p482e))
    sfi.Macro.setGlobal("ZSRV_AUTH", "error")
end
local p482wso `"$ZSRV_WSO"'
local p482auth `"$ZSRV_AUTH"'
macro drop ZSRV_WSO ZSRV_AUTH
display `"P4-82: the launcher hands Server allow_websocket_origin=`p482wso'"'
assert `"`p482wso'"' == `"['localhost:5006', '127.0.0.1:5006']"'
display `"P4-82: the launcher hands Server auth_provider of type `p482auth'"'
assert "`p482auth'" == "_DashTokenAuth"
display "P4-82 PASS: generated .py contains 'allow_websocket_origin'"

dash clear

// ================================================================
// P4-83 — call make_document on a Bokeh Document; no error; has roots
// ================================================================
qui sysuse auto, clear
dash scatter mpg weight, name(s1)
dash kpi mean(mpg), title("Avg MPG") name(k1) fmt(%9.1f)

tempfile outpy6
local outpath6 = "`outpy6'.py"
capture erase "`outpath6'"
dash build, saving("`outpath6'") server replace

// Restructured for the reason given at P4-79: a `python: ... end' block
// nested inside `capture { }' swallows the closing brace and every line
// after it up to the next `end'.  This was the last such block in the
// script, so there was no later `end' to stop at -- it would have eaten the
// assert below, the PASS message and the whole final summary, and the
// script would have run off the end reporting success without ever calling
// make_document.  Run it at the top level and let Python report its own
// failure through a global.
//
// "Has roots" could not fail: the served app always adds one root, its
// layout, whatever went into it -- measured 24sep2026, with the KPI left
// out of that layout make_document still added one root.  What was
// registered is checked instead: one root, one figure drawing one Scatter
// of mpg against weight over the 74 observations, and one KPI card, k1's,
// titled Avg MPG and reading the mean as Stata's %9.1f writes it.
quietly summarize mpg
local p483mean : display %9.1f r(mean)
local p483mean = strtrim("`p483mean'")
local make_doc_rc = 0
global ZSRV_MAKEDOC_RC "0"
python:
import importlib.util, sys
import re
import sfi
from bokeh.document import Document
from bokeh.models import Div, GlyphRenderer, Plot, Scatter

try:
    _spec = importlib.util.spec_from_file_location("_test_serve_app", r"`outpath6'")
    _mod = importlib.util.module_from_spec(_spec)
    _spec.loader.exec_module(_mod)
    _doc = Document()
    _mod.make_document(_doc)
    assert len(_doc.roots) == 1, "make_document produced %d roots" % len(_doc.roots)
    _figs = [m for m in _doc.models if isinstance(m, Plot)]
    _rends = [m for m in _doc.models if isinstance(m, GlyphRenderer)]
    _divs = [m for m in _doc.models if isinstance(m, Div)]
    assert len(_figs) == 1, "%d figures" % len(_figs)
    assert len(_rends) == 1 and isinstance(_rends[0].glyph, Scatter), \
        "renderers: %r" % [type(r.glyph).__name__ for r in _rends]
    _g = _rends[0].glyph
    # A live document keeps the column name as given; a decoded one, as a field.
    assert tuple(getattr(v, "field", v) for v in (_g.x, _g.y)) == \
        ("weight", "mpg"), (_g.x, _g.y)
    assert len(_rends[0].data_source.data["weight"]) == 74, "not 74 rows"
    assert len(_divs) == 1, "%d Divs" % len(_divs)
    _kv = re.findall(r'<div id="kpi_val_([^"]*)"[^>]*>([^<]*)</div>', _divs[0].text)
    assert _kv == [("k1", sfi.Macro.getLocal("p483mean"))], "card: %r" % _kv
    assert ">Avg MPG</div>" in _divs[0].text, "the card has no title Avg MPG"
    del _spec, _mod, _doc, _figs, _rends, _divs, _g, _kv
except Exception as _p483e:
    print("P4-83: " + repr(_p483e))
    sfi.Macro.setGlobal("ZSRV_MAKEDOC_RC", "1")
end
local make_doc_rc = $ZSRV_MAKEDOC_RC
macro drop ZSRV_MAKEDOC_RC

assert `make_doc_rc' == 0
display "P4-83 PASS: make_document builds one root holding the registered scatter and KPI card"

dash clear

// ================================================================
// Final summary
// ================================================================
display ""
display "All dash serve E2E tests PASSED."
display "  P4-74: empty registry → error"
display "  P4-75: port 99999 → error"
display "  P4-76: port 0 → error"
display "  P4-77: port abc → error"
display "  P4-78: dash build server → .py file created"
display "  P4-79: generated .py passes ast.parse()"
display "  P4-80: generated .py contains make_document"
display "  P4-81: generated .py contains Server"
display "  P4-82: generated .py contains allow_websocket_origin; Server admits localhost and 127.0.0.1 only"
display "  P4-83: make_document builds the registered scatter and KPI card"
