* ==== S05 basic:PT-13: dash's own value bounds lifted ====
local only : env WP35_ONLY
if inlist("`only'", "", "S05") & `: list posof "S05" in w35_run' {
    display as text "S05 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3505-3 (WP-35 basic:PT-13): each value twoway draws that dash's own
    // bound refused registers, rc 0 and not named in the note, and its
    // spec is the reference's where twoway's picture is the reference's
    // (value_codes_truth.json *_ref, per_type rc 0, mband_n_*, msize(1e400)
    // drawn as msize(0), D60), and holds the value where it is not
    // (jitter(150), barwidth(0), barwidth(-2)).  aspectratio(-1) stays
    // refused (D59).
    // ------------------------------------------------------------
    quietly sysuse auto, clear
    local s05n 0
    foreach s05x in "scatter mpg weight, jitter(-3)|scatter mpg weight" ///
        "scatter mpg weight, jitter(abc)|scatter mpg weight" ///
        "scatter mpg weight, jitter(5) jitterseed(abc)|scatter mpg weight, jitter(5)" ///
        "scatter mpg weight, jitter(5) jitterseed(-1)|scatter mpg weight, jitter(5)" ///
        "bar mpg foreign, barwidth(-1)|bar mpg foreign" ///
        "scatter mpg weight, lwidth(-1)|scatter mpg weight" ///
        "line mpg weight, mlwidth(-1)|line mpg weight" ///
        "line mpg weight, msangle(400)|line mpg weight" ///
        "mband mpg weight, n(0)|mband mpg weight" ///
        "mband mpg weight, n(-5)|mband mpg weight" ///
        "scatter mpg weight, msize(1e400)|scatter mpg weight, msize(0)" {
        local s05bar = strpos("`s05x'", "|")
        local s05a = substr("`s05x'", 1, `s05bar' - 1)
        local s05b = substr("`s05x'", `s05bar' + 1, .)
        if !strpos("`s05b'", ",") local s05b "`s05b',"
        capture dash clear
        capture log close s05log
        capture erase "`c(tmpdir)'dash_s05.log"
        quietly log using "`c(tmpdir)'dash_s05.log", text replace name(s05log) nomsg
        capture noisily dash `s05a' name(s05g)
        local s05ra = _rc
        quietly log close s05log
        mata: _s05_json = st_global("dash_json_s05g")
        capture dash clear
        capture noisily dash `s05b' name(s05g)
        local s05rb = _rc
        mata: st_local("s05same", strofreal(_s05_json == st_global("dash_json_s05g") & _s05_json != ""))
        capture mata: mata drop _s05_json
        capture dash clear
        cert_log_has "`c(tmpdir)'dash_s05.log", needle("ignoring unsupported")
        local s05nt = r(found)
        _w35_expect Q3505-3 "(`s05ra' == 0 & `s05rb' == 0 & `s05nt' == 0)" `"`s05a': rc `s05ra' (reference rc `s05rb'), named in the note `s05nt'"'
        _w35_expect Q3505-3 "(`s05same' == 1)" `"`s05a' registered another spec than `s05b'"'
    }
    foreach s05c in "scatter mpg weight, jitter(150)|jitter|150" "bar mpg foreign, barwidth(0)|barwidth|0" "bar mpg foreign, barwidth(-2)|barwidth|-2" {
        gettoken s05a s05r : s05c, parse("|")
        gettoken s05o s05r : s05r, parse("|")
        gettoken s05o s05r : s05r, parse("|")
        local s05v = substr("`s05r'", 2, .)
        capture dash clear
        capture noisily dash `s05a' name(s05g)
        local s05ra = _rc
        mata: st_local("s05has", strofreal(strpos(st_global("dash_json_s05g"), char(34) + "`s05o'" + char(34) + ":" + char(34) + "`s05v'" + char(34)) > 0))
        _w35_expect Q3505-3 "(`s05ra' == 0 & `s05has' == 1)" `"`s05a': rc `s05ra', the spec holds `s05o' `s05v' `s05has'"'
    }
    capture dash clear
    capture noisily dash scatter mpg weight, aspectratio(-1) name(s05g)
    local s05ra = _rc
    _w35_expect Q3505-3 "(`s05ra' == 198)" "aspectratio(-1): rc `s05ra', refused as D59 rules"
    capture dash clear
    capture erase "`c(tmpdir)'dash_s05.log"
    _w35_done Q3505-3 "the values twoway draws register as twoway draws them"

    // ------------------------------------------------------------
    // Q3505-4 (WP-35 basic:PT-13): lwidth(*#) on line refused as twoway
    // refuses it, r(198) and its gm_linewidth line, from *33334
    // (value_codes_truth.json lwidth_mult_line*: *30000 drawn, *35000 and
    // *40000 refused); on scatter, which draws no line, never.
    // ------------------------------------------------------------
    foreach s05c in "line|40000|198" "line|35000|198" "line|30000|0" "scatter|40000|0" {
        tokenize "`s05c'", parse("|")
        capture dash clear
        capture log close s05log
        capture erase "`c(tmpdir)'dash_s05.log"
        quietly log using "`c(tmpdir)'dash_s05.log", text replace name(s05log) nomsg
        capture noisily dash `1' mpg weight, lwidth(*`3') name(s05g)
        local s05r = _rc
        quietly log close s05log
        // The first words: twoway's line holds a run of blanks the
        // fixture's joined message makes one.
        cert_file_count "`c(tmpdir)'dash_s05.log", needle("gm_linewidth must be between 0.000 and")
        local s05c2 = r(count)
        local s05w = cond(`5' == 198, 1, 0)
        _w35_expect Q3505-4 "(`s05r' == `5' & (`s05c2' >= 1) == `s05w')" `"`1' lwidth(*`3'): rc `s05r' (twoway `5'), the gm_linewidth line `s05c2' times"'
    }
    capture dash clear
    capture erase "`c(tmpdir)'dash_s05.log"
    _w35_done Q3505-4 "lwidth(*#) refused where twoway refuses it"

    display as text "S05 end " c(current_date) " " c(current_time)
}
* ==== end S05 ====

* ==== S06 GW-4: fxsiz() and fysiz() applied ====
local only : env WP35_ONLY
if inlist("`only'", "", "S06") & `: list posof "S06" in w35_run' {
    display as text "S06 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3506-4 (WP-35 GW-4): twoway reads fxsiz() and fysiz() as fxsize()
    // and fysize() (graph_refusal_truth.json fx.fxsiz and fx.fysiz draw
    // the plot region of fx.fxsize and fx.fysize; fxsi(), fxs() and fysi()
    // are refused).  dash registers the spec of the full spelling for the
    // shortest one, after a plot's comma and after the plot groups'
    // comma, and names neither; fxsi() is refused as twoway refuses it.
    // ------------------------------------------------------------
    quietly sysuse auto, clear
    foreach s06p in "scatter mpg weight, @(50)" "(scatter mpg weight), @(50)" {
        foreach s06o in fxsiz fysiz {
            local s06f = cond("`s06o'" == "fxsiz", "fxsize", "fysize")
            local s06s : subinstr local s06p "@" "`s06o'"
            local s06l : subinstr local s06p "@" "`s06f'"
            capture dash clear
            capture log close s06log
            capture erase "`c(tmpdir)'dash_s06.log"
            quietly log using "`c(tmpdir)'dash_s06.log", text replace name(s06log) nomsg
            capture noisily dash `s06s' name(s06g)
            local s06rs = _rc
            quietly log close s06log
            mata: _s06_json = st_global("dash_json_s06g")
            capture dash clear
            capture noisily dash `s06l' name(s06g)
            local s06rl = _rc
            mata: st_local("s06same", strofreal(_s06_json == st_global("dash_json_s06g") & _s06_json != ""))
            capture mata: mata drop _s06_json
            capture dash clear
            _w35_expect Q3506-4 "(`s06rs' == 0 & `s06rl' == 0)" `"`s06s': dash rc `s06rs', `s06l' rc `s06rl'"'
            _w35_expect Q3506-4 "(`s06same' == 1)" `"`s06s' registered another spec than `s06l'"'
            cert_log_has "`c(tmpdir)'dash_s06.log", needle("ignoring unsupported")
            _w35_expect Q3506-4 "(r(found) == 0)" `"`s06s': dash named it in the note"'
        }
    }
    foreach s06o in fxsi fxs fysi {
        capture dash clear
        capture noisily dash scatter mpg weight, `s06o'(50) name(s06g)
        local s06r = _rc
        _w35_expect Q3506-4 "(`s06r' == 198)" "`s06o'(50): dash rc `s06r', twoway r(198)"
    }
    capture dash clear
    capture erase "`c(tmpdir)'dash_s06.log"
    _w35_done Q3506-4 "fxsiz() and fysiz() register fxsize()'s and fysize()'s spec"

    display as text "S06 end " c(current_date) " " c(current_time)
}
* ==== end S06 ====

* ==== S07 DT-15: dash-only words per ruling ====
local only : env WP35_ONLY
if inlist("`only'", "", "S07") & `: list posof "S07" in w35_run' {
    display as text "S07 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3507-2 (WP-35 DT-15; DECISIONS.md P4-7): hover() and table, which
    // only a dashboard has, are kept -- twoway refuses both
    // (dash_only_words_truth.json hover, table) and dash registers them,
    // rc 0 -- and twoway's own spelling of a second axis's title,
    // ytitle(T, axis(2)), registers and reaches the spec (ytitle2, the
    // key _dash_route_axis2 writes), where ytitle2(T) is refused.
    // ------------------------------------------------------------
    quietly sysuse auto, clear
    foreach s07c in "scatter mpg weight, hover(make)" "scatter mpg weight, table" "scatter mpg weight, hov(make price)" {
        capture dash clear
        capture noisily dash `s07c' name(s07g)
        local s07r = _rc
        mata: st_local("s07n", strofreal(st_global("dash_json_s07g") != ""))
        _w35_expect Q3507-2 "(`s07r' == 0 & `s07n' == 1)" "`s07c': dash rc `s07r', registered `s07n'"
    }
    capture dash clear
    capture noisily dash (line mpg weight) (line price weight, yaxis(2)), ytitle(T, axis(2)) name(s07g)
    local s07r = _rc
    mata: st_local("s07k", strofreal(strpos(st_global("dash_json_s07g"), char(34) + "ytitle2" + char(34) + ":") > 0))
    _w35_expect Q3507-2 "(`s07r' == 0 & `s07k' == 1)" "ytitle(T, axis(2)): dash rc `s07r', ytitle2 in the spec `s07k'"
    capture dash clear
    capture noisily dash (line mpg weight) (line price weight, yaxis(2)), ytitle2(T) name(s07g)
    local s07r = _rc
    _w35_expect Q3507-2 "(`s07r' == 198)" "ytitle2(T): dash rc `s07r', twoway r(198)"
    capture dash clear
    _w35_done Q3507-2 "hover() and table kept; ytitle(T, axis(2)) drawn; ytitle2() refused"

    // ------------------------------------------------------------
    // Q3507-3 (D62, 27oct2026): inside p1() twoway reads marker() as its
    // markerstyle option, mstyle() (dash_only_words_truth.json p.marker,
    // pmarker.*: p1(marker(O)) draws mstyle(O)'s picture, the plain one,
    // with "named style O not found in class markerstyle, default
    // attributes used"; p1(marker(p3)) draws mstyle(p3)'s; p1(mark(O)) is
    // refused).  dash registers p1(marker(<v>)) as mstyle(<v>), the same
    // spec, prints the note when it draws and refuses p1(mark(O)).
    // ------------------------------------------------------------
    quietly sysuse auto, clear
    foreach s07v in O p3 {
        capture dash clear
        capture noisily dash scatter mpg weight, mstyle(`s07v') name(s07g)
        mata: _s07_json = st_global("dash_json_s07g")
        capture dash clear
        capture noisily dash scatter mpg weight, p1(marker(`s07v')) name(s07g)
        local s07r = _rc
        mata: st_local("s07same", strofreal(_s07_json == st_global("dash_json_s07g") & _s07_json != ""))
        mata: st_local("s07m", strofreal(strpos(st_global("dash_json_s07g"), char(34) + "marker" + char(34)) > 0))
        capture mata: mata drop _s07_json
        _w35_expect Q3507-3 "(`s07r' == 0 & `s07same' == 1 & `s07m' == 0)" "p1(marker(`s07v')): dash rc `s07r', spec of mstyle(`s07v') `s07same', marker key `s07m'"
    }
    capture dash clear
    tempfile s07h
    capture erase "`s07h'.html"
    capture log close s07log
    capture erase "`c(tmpdir)'dash_s07.log"
    local s07ls = c(linesize)
    set linesize 255
    quietly log using "`c(tmpdir)'dash_s07.log", text replace name(s07log) nomsg
    capture noisily dash scatter mpg weight, p1(marker(O)) saving("`s07h'.html", replace)
    local s07r = _rc
    quietly log close s07log
    set linesize `s07ls'
    capture erase "`s07h'.html"
    cert_log_has "`c(tmpdir)'dash_s07.log", needle("named style O not found in class markerstyle, default attributes used")
    _w35_expect Q3507-3 "(`s07r' == 0 & r(found) == 1)" "p1(marker(O)) drawn: dash rc `s07r', twoway's markerstyle note found `r(found)'"
    capture dash clear
    capture noisily dash scatter mpg weight, p1(mark(O)) name(s07g)
    local s07r = _rc
    _w35_expect Q3507-3 "(`s07r' == 198)" "p1(mark(O)): dash rc `s07r', twoway r(198)"
    capture dash clear
    _w35_done Q3507-3 "p1(marker()) is mstyle(), as twoway reads it"

    display as text "S07 end " c(current_date) " " c(current_time)
}
* ==== end S07 ====

// S08 helpers (WP-35 section 35-08, DT-19): _w35s08_spec reads a spec
// file's _dash_prefix, a graph's qual_col and build_options.frame_cols;
// _w35s08_data reads a data file's column names and one column's sum;
// _w35s08_same compares two data files less variableIndices (the
// variables' positions in the frame they were written from);
// _w35s08_page reads each Scatter's point count and y sum, and the label
// texts, on a saved page (or the served app's document built from a spec
// and a data file).
python:
import json as _w35s08_json
import re as _w35s08_re
from sfi import Macro as _w35s08_M


def _w35s08_spec(path, gname):
    try:
        spec = _w35s08_json.load(open(path, encoding="utf-8"))
        g = [x for x in spec.get("graphs", [])
             if x.get("graph_options", {}).get("name") == gname]
        _w35s08_M.setGlobal("w35s08_pfx", str(spec.get("_dash_prefix", "")))
        _w35s08_M.setGlobal("w35s08_qcol",
                            str(g[0].get("qual_col", "")) if g else "")
        fc = spec.get("build_options", {}).get("frame_cols", {})
        _w35s08_M.setGlobal("w35s08_fcols", _w35s08_json.dumps(fc, sort_keys=True))
    except Exception as e:
        _w35s08_M.setGlobal("w35s08_pfx", "error " + str(e)[:100])


def _w35s08_data(path, col):
    import base64
    import numpy as np
    try:
        d = _w35s08_json.load(open(path, encoding="utf-8"))
        _w35s08_M.setGlobal("w35s08_cols", " ".join(d["columns"]))
        v = d["columns"].get(col)
        s = "none"
        if v is not None:
            a = np.frombuffer(base64.b64decode(v["base64"]), dtype=v["dtype"])
            s = "%g" % float(np.nansum(a.astype(float)))
        _w35s08_M.setGlobal("w35s08_sum", s)
    except Exception as e:
        _w35s08_M.setGlobal("w35s08_cols", "error " + str(e)[:100])
        _w35s08_M.setGlobal("w35s08_sum", "error")


def _w35s08_same(a, b):
    try:
        da = _w35s08_json.load(open(a, encoding="utf-8"))
        db = _w35s08_json.load(open(b, encoding="utf-8"))
        da.pop("variableIndices", None)
        db.pop("variableIndices", None)
        _w35s08_M.setGlobal("w35s08_same", "1" if da == db else "0")
    except Exception:
        _w35s08_M.setGlobal("w35s08_same", "0")


def _w35s08_page(path, spec=None, data=None):
    """Global w35s08_pts: "<n>:<y sum>" for each Scatter, in model order,
    sorted; w35s08_txt: every string a source holds, blank-joined."""
    from bokeh.document import Document
    from bokeh.models import ColumnDataSource, GlyphRenderer, Scatter
    try:
        if spec is not None:
            import os
            import tempfile
            import importlib.util
            _sp = importlib.util.spec_from_file_location(
                "_w35s08_dr", os.path.abspath(os.path.join("..", "dash_render.py")))
            _dr = importlib.util.module_from_spec(_sp)
            import sys as _w35s08_sys
            _w35s08_sys.modules["_w35s08_dr"] = _dr
            _sp.loader.exec_module(_dr)
            app = os.path.join(tempfile.mkdtemp(), "w35s08_app.py")
            _dr.ServerAppBuilder(spec, data).build(app)
            from bokeh.io.doc import patch_curdoc
            doc = Document()
            with patch_curdoc(doc):
                exec(compile(open(app, encoding="utf-8").read(), app, "exec"),
                     {"__name__": "_w35s08_app", "_DASH_TRIAL": True})
        else:
            page = open(path, encoding="utf-8").read()
            ents = {"amp": "&", "lt": "<", "gt": ">", "quot": chr(34),
                    "#x27": chr(39), "#x60": chr(96)}
            blocks = _w35s08_re.findall(
                r'<script type="application/json" id="[^"]+">\s*(.*?)\s*</script>',
                page, _w35s08_re.S)
            docs = [d for b in blocks for d in _w35s08_json.loads(
                _w35s08_re.sub(r"&(amp|lt|gt|quot|#x27|#x60);",
                               lambda m: ents[m.group(1)], b)).values()]
            doc = Document.from_json(docs[0])
        pts, txt, hov = [], set(), []
        for m in doc.models:
            if isinstance(m, GlyphRenderer) and isinstance(m.glyph, Scatter):
                y = m.glyph.y
                y = y.get("field") if isinstance(y, dict) else getattr(y, "field", y)
                vals = [v for v in m.data_source.data.get(y, [])
                        if v is not None and v == v]
                pts.append("%d:%g" % (len(vals), sum(vals)))
                h = [v for v in m.data_source.data.get("__dash_row__", [])
                     if v is not None and v == v]
                if h:
                    hov.append("%d:%g" % (len(h), sum(h)))
            if isinstance(m, ColumnDataSource):
                for col in m.data.values():
                    for v in list(col)[:200]:
                        if isinstance(v, str):
                            txt.add(v)
        _w35s08_M.setGlobal("w35s08_pts", " ".join(sorted(pts)))
        _w35s08_M.setGlobal("w35s08_txt", " ".join(sorted(txt)))
        _w35s08_M.setGlobal("w35s08_hov", " ".join(sorted(hov)))
    except Exception as e:
        _w35s08_M.setGlobal("w35s08_pts", "error " + str(e)[:200])
        _w35s08_M.setGlobal("w35s08_txt", "")
end

* ==== S08 DT-19: working columns never clash ====
local only : env WP35_ONLY
if inlist("`only'", "", "S08") & `: list posof "S08" in w35_run' {
    display as text "S08 start " c(current_date) " " c(current_time)
    local s08d "`w35_work'"

    // ------------------------------------------------------------
    // Q3508-1 (WP-35 DT-19): twoway draws data holding variables named
    // __dashq1, __dashs1, __dash_row__ and __dashm_mpg; dash drew them too
    // only under r(110).  Now the export's prefix is __dsh1_: the spec's
    // qualifier column is __dsh1_q1, the data file holds it beside the
    // user's __dashq1, and both modes draw the user's 22 values; the
    // user's __dash_row__ (here mpg's values) is what hover() shows, the
    // renderers' row identity being __dsh1__row__.
    // ------------------------------------------------------------
    quietly sysuse auto, clear
    foreach s08v in __dashq1 __dashs1 __dash_row__ __dashm_mpg {
        quietly generate `s08v' = mpg
    }
    capture noisily twoway scatter __dashq1 weight, nodraw
    local s08tw = _rc
    capture dash clear
    capture noisily dash scatter __dashq1 weight if foreign, hover(__dash_row__) name(s08)
    local s08r = _rc
    _w35_expect Q3508-1 "(`s08tw' == 0 & `s08r' == 0)" "twoway rc `s08tw', dash rc `s08r'"
    capture erase "`s08d'/q1.json"
    capture erase "`s08d'/q1.csv"
    capture noisily _dash_serve_spec, specpath("`s08d'/q1.json") datapath("`s08d'/q1.csv")
    local s08r = _rc
    python: _w35s08_spec(r"`s08d'/q1.json", "s08")
    python: _w35s08_data(r"`s08d'/q1.csv", "__dashq1")
    _w35_expect Q3508-1 "(`s08r' == 0)" "_dash_serve_spec rc `s08r'"
    _w35_expect Q3508-1 `"("${w35s08_pfx}" == "__dsh1_" & "${w35s08_qcol}" == "__dsh1_q1")"' "prefix ${w35s08_pfx}, qual_col ${w35s08_qcol}"
    local s08c "${w35s08_cols}"
    _w35_expect Q3508-1 `"(`: list posof "__dsh1_q1" in s08c' > 0 & `: list posof "__dashq1" in s08c' > 0)"' "data columns `s08c'"
    quietly summarize mpg
    local s08all = r(sum)
    _w35_expect Q3508-1 `"("${w35s08_sum}" == "`s08all'")"' "the user's __dashq1 sums ${w35s08_sum}, mpg `s08all'"
    quietly summarize mpg if foreign
    local s08want "22:`r(sum)'"
    capture erase "`s08d'/q1.html"
    capture noisily dash build, saving("`s08d'/q1.html") filter(__dashq1) nobrowser
    local s08r = _rc
    python: _w35s08_page(r"`s08d'/q1.html")
    _w35_expect Q3508-1 `"(`s08r' == 0 & "${w35s08_pts}" == "`s08want'")"' "saved page: rc `s08r', points ${w35s08_pts}, want `s08want'"
    _w35_expect Q3508-1 `"("${w35s08_hov}" == "`s08want'")"' "saved page: hover(__dash_row__) holds ${w35s08_hov}, the user's `s08want'"
    python: _w35s08_page(None, r"`s08d'/q1.json", r"`s08d'/q1.csv")
    _w35_expect Q3508-1 `"("${w35s08_pts}" == "`s08want'")"' "served app: points ${w35s08_pts}, want `s08want'"
    _w35_expect Q3508-1 `"("${w35s08_hov}" == "`s08want'")"' "served app: hover(__dash_row__) holds ${w35s08_hov}, the user's `s08want'"
    capture dash clear
    _w35_done Q3508-1 "a variable named __dash... is drawn as data in both modes"

    // ------------------------------------------------------------
    // Q3508-2: the plan by value (no set maxvar anywhere); the refusal's
    // words; and three live builds whose data files are the same with the
    // columns made in place and in a temporary frame ($dash__force_frame),
    // the frame branch run (and only under the flag) per $dash__frame_trace.
    // ------------------------------------------------------------
    global dash__force_frame
    _dash_maxvar_plan 2 10 3 12
    local s08p1 "`_mv_plan'"
    _dash_maxvar_plan 4 10 3 12
    local s08p2 "`_mv_plan'"
    _dash_maxvar_plan 10 10 3 12
    local s08p3 "`_mv_plan'"
    global dash__force_frame 1
    _dash_maxvar_plan 2 10 3 12
    local s08p4 "`_mv_plan'"
    global dash__force_frame
    _w35_expect Q3508-2 `"("`s08p1' `s08p2' `s08p3' `s08p4'" == "inplace frame refuse frame")"' "plans `s08p1' `s08p2' `s08p3' `s08p4'"
    capture log close q3508
    capture erase "`s08d'/q3508_2.log"
    quietly log using "`s08d'/q3508_2.log", text replace name(q3508)
    capture noisily _dash_maxvar_room 200000 0 0 0 "dash" 5 q8f
    local s08ra = _rc
    capture noisily _dash_maxvar_room 200000 0 0 0 "dash" 5
    local s08rb = _rc
    quietly log close q3508
    _w35_expect Q3508-2 "(`s08ra' == 900 & `s08rb' == 900)" "refusal rc `s08ra' and `s08rb'"
    cert_log_has "`s08d'/q3508_2.log", needle("variables in frame q8f, and set maxvar allows")
    _w35_expect Q3508-2 "(r(found) == 1)" "the line naming the frame"
    cert_log_has "`s08d'/q3508_2.log", needle("variables, and set maxvar allows")
    _w35_expect Q3508-2 "(r(found) == 1)" "the line without a frame"
    cert_log_has "`s08d'/q3508_2.log", needle("beside the 5 variables the dashboard exports")
    _w35_expect Q3508-2 "(r(found) == 1)" "the room beside the exported variables"
    forvalues s08b = 1/3 {
        capture dash clear
        if `s08b' == 1 {
            clear
            quietly set obs 20
            quietly generate id = ceil(_n/10)
            quietly generate t = mod(_n - 1, 10) + 1
            quietly generate y = _n^1.5
            quietly tsset id t
            quietly dash line L.y t if id == 1, name(q8l)
        }
        else if `s08b' == 2 {
            quietly sysuse auto, clear
            quietly regress mpg weight if foreign
            quietly dash scatter mpg weight if e(sample), name(q8e)
        }
        else {
            quietly sysuse auto, clear
            quietly dash scatter mpg weight, name(q8w)
        }
        local s08filt ""
        if `s08b' == 3 local s08filt "filter(rep78)"
        foreach s08f in 0 1 {
            global dash__force_frame = cond(`s08f', "1", "")
            global dash__frame_trace ""
            capture erase "`s08d'/q2_`s08b'_`s08f'.json"
            capture erase "`s08d'/q2_`s08b'_`s08f'.csv"
            capture noisily _dash_serve_spec, specpath("`s08d'/q2_`s08b'_`s08f'.json") datapath("`s08d'/q2_`s08b'_`s08f'.csv") `s08filt'
            local s08r_`s08f' = _rc
            local s08t_`s08f' = strtrim("${dash__frame_trace}")
        }
        global dash__force_frame
        python: _w35s08_same(r"`s08d'/q2_`s08b'_0.csv", r"`s08d'/q2_`s08b'_1.csv")
        _w35_expect Q3508-2 "(`s08r_0' == 0 & `s08r_1' == 0 & ${w35s08_same} == 1)" "build `s08b': rc `s08r_0'/`s08r_1', same file ${w35s08_same}"
        _w35_expect Q3508-2 `"("`s08t_1'" == "`c(frame)'" & "`s08t_0'" == "")"' "build `s08b': trace [`s08t_1'] under the flag, [`s08t_0'] without"
        if `s08b' == 2 {
            python: _w35s08_data(r"`s08d'/q2_2_1.csv", "__dashq1")
            _w35_expect Q3508-2 `"("${w35s08_sum}" == "22")"' "e(sample)'s column holds ${w35s08_sum} ones, twoway's count 22"
        }
    }
    global dash__frame_trace
    capture dash clear
    _w35_done Q3508-2 "the plan, its refusal, and the frame branch's data file"

    // ------------------------------------------------------------
    // Q3508-3: two frames (33-07's frame f: prefix).  One prefix over
    // both frames' names; each frame's own temporary frame; e(sample)
    // read in each frame as twoway reads it; 33-07's split columns and
    // label copies named from the prefix, the user's label sets untouched.
    // ------------------------------------------------------------
    quietly sysuse auto, clear
    capture frame drop q8f
    frame create q8f
    frame q8f: quietly sysuse auto, clear
    frame q8f: quietly generate __dashq1 = mpg
    capture dash clear
    quietly dash scatter mpg weight if foreign, name(q8a)
    quietly frame q8f: dash scatter __dashq1 weight, name(q8b)
    foreach s08f in 0 1 {
        global dash__force_frame = cond(`s08f', "1", "")
        global dash__frame_trace ""
        capture erase "`s08d'/q8_`s08f'.json"
        capture erase "`s08d'/q8_`s08f'.csv"
        capture noisily _dash_serve_spec, specpath("`s08d'/q8_`s08f'.json") datapath("`s08d'/q8_`s08f'.csv")
        local s08r_`s08f' = _rc
        local s08t_`s08f' = strtrim("${dash__frame_trace}")
    }
    global dash__force_frame
    python: _w35s08_spec(r"`s08d'/q8_0.json", "q8b")
    python: _w35s08_same(r"`s08d'/q8_0.csv", r"`s08d'/q8_1.csv")
    _w35_expect Q3508-3 "(`s08r_0' == 0 & `s08r_1' == 0 & ${w35s08_same} == 1)" "two frames: rc `s08r_0'/`s08r_1', same file ${w35s08_same}"
    _w35_expect Q3508-3 `"("${w35s08_pfx}" == "__dsh1_")"' "two frames: prefix ${w35s08_pfx}"
    local s08tl "`s08t_1'"
    _w35_expect Q3508-3 `"(`: word count `s08tl'' == 2 & `: list posof "`c(frame)'" in s08tl' > 0 & `: list posof "q8f" in s08tl' > 0 & "`s08t_0'" == "")"' "two frames: trace [`s08t_1'], [`s08t_0'] without the flag"
    capture erase "`s08d'/q8.html"
    capture noisily dash build, saving("`s08d'/q8.html") nobrowser
    local s08r = _rc
    python: _w35s08_page(r"`s08d'/q8.html")
    quietly summarize mpg if foreign
    local s08wa "22:`r(sum)'"
    quietly summarize mpg
    local s08wb "74:`r(sum)'"
    local s08pts "${w35s08_pts}"
    _w35_expect Q3508-3 `"(`s08r' == 0 & `: list posof "`s08wa'" in s08pts' > 0 & `: list posof "`s08wb'" in s08pts' > 0)"' "two frames: build rc `s08r', points `s08pts'"
    // e(sample): 22 rows in the estimation frame, none in q8f (30 rows of
    // rep78 == 3 there), with and without the flag.
    capture dash clear
    quietly regress mpg weight if foreign
    quietly dash scatter mpg weight if e(sample), name(q8c)
    quietly frame q8f: dash scatter mpg weight if e(sample) | rep78 == 3, name(q8d)
    foreach s08f in 0 1 {
        global dash__force_frame = cond(`s08f', "1", "")
        capture erase "`s08d'/q8e_`s08f'.json"
        capture erase "`s08d'/q8e_`s08f'.csv"
        capture noisily _dash_serve_spec, specpath("`s08d'/q8e_`s08f'.json") datapath("`s08d'/q8e_`s08f'.csv")
        local s08r_`s08f' = _rc
    }
    global dash__force_frame
    python: _w35s08_same(r"`s08d'/q8e_0.csv", r"`s08d'/q8e_1.csv")
    _w35_expect Q3508-3 "(`s08r_0' == 0 & `s08r_1' == 0 & ${w35s08_same} == 1)" "e(sample) in two frames: rc `s08r_0'/`s08r_1', same file ${w35s08_same}"
    capture erase "`s08d'/q8e.html"
    capture noisily dash build, saving("`s08d'/q8e.html") nobrowser
    local s08r = _rc
    python: _w35s08_page(r"`s08d'/q8e.html")
    local s08pts "${w35s08_pts}"
    local s08n ""
    foreach s08w of local s08pts {
        local s08n `s08n' `=substr("`s08w'", 1, strpos("`s08w'", ":") - 1)'
    }
    local s08n : list sort s08n
    _w35_expect Q3508-3 `"(`s08r' == 0 & "`s08n'" == "22 30")"' "e(sample) in two frames: points `s08pts'"
    // 33-07's split column and label copy, named from the prefix.
    capture dash clear
    capture frame drop q8g
    frame create q8g
    frame q8g: quietly sysuse auto, clear
    frame q8g: label define origin 0 "US" 1 "Abroad", replace
    frame q8g: label define __dashl1 1 "one"
    quietly dash scatter mpg weight, mlabel(foreign) name(q8h)
    quietly frame q8g: dash scatter mpg weight, mlabel(foreign) name(q8i)
    capture erase "`s08d'/q8j.html"
    capture noisily dash build, saving("`s08d'/q8j.html") nobrowser
    local s08r = _rc
    capture erase "`s08d'/q8j.json"
    capture erase "`s08d'/q8j.csv"
    capture noisily _dash_serve_spec, specpath("`s08d'/q8j.json") datapath("`s08d'/q8j.csv")
    local s08r2 = _rc
    python: _w35s08_spec(r"`s08d'/q8j.json", "q8i")
    _w35_expect Q3508-3 `"(`s08r' == 0 & `s08r2' == 0 & "${w35s08_pfx}" == "__dsh1_")"' "label sets: rc `s08r'/`s08r2', prefix ${w35s08_pfx}"
    _w35_expect Q3508-3 `"(strpos(`"${w35s08_fcols}"', `""q8i": {"foreign": {"col": "__dsh1_m1", "frame": "q8g"}}"') > 0)"' `"frame_cols ${w35s08_fcols}"'
    python: _w35s08_page(r"`s08d'/q8j.html")
    local s08tx "${w35s08_txt}"
    _w35_expect Q3508-3 `"(`: list posof "Domestic" in s08tx' > 0 & `: list posof "Foreign" in s08tx' > 0 & `: list posof "US" in s08tx' > 0 & `: list posof "Abroad" in s08tx' > 0)"' "marker labels: `s08tx'"
    frame q8g: quietly label list __dashl1
    local s08l1 = r(min) == 1 & r(max) == 1
    frame q8g: quietly label list origin
    local s08l2 = r(min) == 0 & r(max) == 1
    frame q8g: local s08o0 : label origin 0
    _w35_expect Q3508-3 `"(`s08l1' & `s08l2' & "`s08o0'" == "US")"' "the user's label sets in q8g"
    capture dash clear
    capture frame drop q8g
    capture frame drop q8f
    global dash__force_frame
    global dash__frame_trace
    _w35_done Q3508-3 "one prefix over two frames, each frame's own temporary frame, e(sample) per frame"

    display as text "S08 end " c(current_date) " " c(current_time)
}
* ==== end S08 ====

* ==== S09 plot:PT-3: plot-type names in lower case only ====
local only : env WP35_ONLY
if inlist("`only'", "", "S09") & `: list posof "S09" in w35_run' {
    display as text "S09 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3509-1 (a guard): the lower-case spelling of every case.* word of
    // fixtures/command_grammar_truth.json that twoway takes (lc_rc 0)
    // registers, rc 0, as the plot type it names; only capitals change.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly gen yl = mpg - 1
    quietly gen yh = mpg + 1
    quietly gen gx = mod(_n - 1, 9) + 1 if _n <= 72
    quietly gen gy = floor((_n - 1) / 9) + 1 if _n <= 72
    quietly gen gz = gx * gy + gy
    python: import json as _q9j, sfi as _q9s
    python: _q9T = _q9j.load(open("fixtures/command_grammar_truth.json", encoding="utf-8"))
    python: _q9s.Macro.setLocal("q9keys", " ".join(k[5:] for k in sorted(_q9T) if k.startswith("case.") and _q9T[k]["lc_rc"] == 0))
    // The type each spelling names, lower-cased.
    local q9full Area:area BAR:bar Bar:bar Con:connected Connected:connected ///
        Contour:contour Fn:function Fun:function Function:function ///
        Hist:histogram Histogram:histogram Kdensity:kdensity LFIT:lfit ///
        Li:line Line:line Lowess:lowess Mband:mband Mbands:mband ///
        Pcarrowi:pcarrowi Rcap:rcap Rcon:rconnected Rl:rline Rsc:rscatter ///
        SCATTER:scatter Sc:scatter Scatter:scatter Scatteri:scatteri
    local q91n 0
    foreach w of local q9keys {
        local want ""
        foreach pr of local q9full {
            if substr("`pr'", 1, strpos("`pr'", ":") - 1) == "`w'" local want = substr("`pr'", strpos("`pr'", ":") + 1, .)
        }
        python: _q9c = _q9T["case." + _q9s.Macro.getLocal("w")]["cmd"].split(" ", 2); _q9s.Macro.setLocal("q9cmd", "dash " + _q9c[1].lower() + " " + _q9c[2] + ("" if "," in _q9c[2] else ","))
        dash clear
        capture noisily `q9cmd' name(q3509a)
        local rc = _rc
        local got ""
        if !`rc' {
            python: _q9s.Macro.setLocal("got", " ".join(p["type"] for p in _q9j.loads(_q9s.Macro.getGlobal("dash_json_q3509a"))["plots"]))
        }
        local ok = (`rc' == 0 & "`got'" == "`want'" & "`want'" != "")
        _w35_expect Q3509-1 "(`ok')" `"`q9cmd': rc `rc', registered [`got'], want `want'"'
        local ++q91n
    }
    _w35_expect Q3509-1 "(`q91n' == 27)" "`q91n' lower-case spellings read, 27 expected"
    _w35_done Q3509-1 "the `q91n' lower-case spellings register as the types they name"
    dash clear
    display as text "S09 end " c(current_date) " " c(current_time)
}
* ==== end S09 ====

* ==== S09 plot:PT-4: the empty graph ====
local only : env WP35_ONLY
if inlist("`only'", "", "S09") & `: list posof "S09" in w35_run' {
    display as text "S09 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3509-4: twoway, title(T) draws no axis (command_grammar_truth.json
    // empty.svg.title: no <line>, the text T alone); the saved page and
    // the served app of dash, title(T) hide every axis and grid and draw
    // the title.
    // ------------------------------------------------------------
    local q94d "`w35_work'/s09pt4"
    capture mkdir "`q94d'"
    sysuse auto, clear
    capture dash clear
    capture noisily dash, title(T) name(q3509e)
    _w35_expect Q3509-4 "(_rc == 0)" "dash, title(T) name() rc `=_rc'"
    capture erase "`q94d'/e.html"
    capture noisily dash build, saving("`q94d'/e.html") replace nobrowser
    _w35_expect Q3509-4 "(_rc == 0)" "dash build rc `=_rc'"
    python: import __main__ as _q9m; _q9m._q3509_axes(r"`q94d'/e.html", "page")
    _w35_expect Q3509-4 `"("${q3509_bad}" == "")"' `"saved: ${q3509_bad}"'
    capture erase "`q94d'/e.py"
    capture noisily dash build, server saving("`q94d'/e.py") replace nobrowser
    _w35_expect Q3509-4 "(_rc == 0)" "dash build, server rc `=_rc'"
    python: import __main__ as _q9m; _q9m._q3509_axes(r"`q94d'/e.py", "app")
    _w35_expect Q3509-4 `"("${q3509_bad}" == "")"' `"served: ${q3509_bad}"'
    _w35_done Q3509-4 "the empty graph: no axis or grid shown, the title drawn, saved and served"
    macro drop q3509_bad
    capture erase "`q94d'/e.html"
    capture erase "`q94d'/e.py"
    capture rmdir "`q94d'"
    dash clear
    display as text "S09 end " c(current_date) " " c(current_time)
}
* ==== end S09 ====

* ==== S09 syn:SD-1: a bare plot after a group ====
local only : env WP35_ONLY
if inlist("`only'", "", "S09") & `: list posof "S09" in w35_run' {
    display as text "S09 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3509-6: every group.* form twoway draws (rc 0) registers with
    // twoway's plots -- a bare plot after a parenthesised group is one
    // more plot (command_grammar_truth.json group.*).
    // ------------------------------------------------------------
    sysuse auto, clear
    python: import __main__ as _q9m; _q9m._q3509_forms("group.")
    local q96n 0
    foreach k of global q3509_keys {
        python: import __main__ as _q9m; _q9m._q3509_drawn("`k'", "")
        dash clear
        capture noisily ${q3509_cmd}
        local rc = _rc
        _w35_expect Q3509-6 "(`rc' == 0)" `"${q3509_cmd}: rc `rc'"'
        global q3509_bad ""
        if !`rc' {
            python: import __main__ as _q9m; _q9m._q3509_drawn("`k'", "q3509g")
        }
        _w35_expect Q3509-6 `"("${q3509_bad}" == "")"' `"${q3509_bad}"'
        local ++q96n
    }
    _w35_expect Q3509-6 "(`q96n' == 5)" "`q96n' forms read, 5 expected"
    _w35_done Q3509-6 "the `q96n' group forms twoway draws register its plots"
    macro drop q3509_keys q3509_cmd q3509_bad
    dash clear
    display as text "S09 end " c(current_date) " " c(current_time)
}
* ==== end S09 ====

* ==== S09 syn:SD-13: || inside one group ====
local only : env WP35_ONLY
if inlist("`only'", "", "S09") & `: list posof "S09" in w35_run' {
    display as text "S09 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3509-8: every inner.* form twoway draws (rc 0) -- || inside the
    // command's one group, with no option -- draws what the same plots
    // without the parentheses draw (twoway: the fixture's plot count).
    // No option may be added (twoway refuses one there), so each is
    // drawn on the one-line route and its page read.
    // ------------------------------------------------------------
    sysuse auto, clear
    python: import __main__ as _q9m; _q9m._q3509_forms("inner.")
    local q98n 0
    foreach k of global q3509_keys {
        python: import json as _q9j; from sfi import Macro as _q9M; _q9M.setLocal("q98cmd", "dash" + _q9j.load(open("fixtures/command_grammar_truth.json", encoding="utf-8"))[_q9M.getLocal("k")]["cmd"][len("twoway"):])
        python: from sfi import Macro as _q9M; _q9M.setLocal("q98flat", _q9M.getLocal("q98cmd").replace("dash (", "dash ", 1).rstrip().rstrip(",").rstrip()[:-1])
        dash clear
        capture noisily `q98cmd'
        local rc = _rc
        local f1 "`r(filename)'"
        _w35_expect Q3509-8 "(`rc' == 0)" `"`q98cmd': rc `rc'"'
        capture noisily `q98flat'
        local f2 "`r(filename)'"
        global q3509_g1 ""
        global q3509_g2 ""
        if !`rc' {
            python: import __main__ as _q9m; _q9m._q3509_glyphs(r"`f1'", "q3509_g1")
            python: import __main__ as _q9m; _q9m._q3509_glyphs(r"`f2'", "q3509_g2")
        }
        _w35_expect Q3509-8 `"("${q3509_g1}" == "${q3509_g2}" & "${q3509_g1}" != "")"' `"`q98cmd': glyphs [${q3509_g1}], `q98flat' [${q3509_g2}]"'
        python: import json as _q9j; from sfi import Macro as _q9M; _q9M.setLocal("q98np", str(_q9j.load(open("fixtures/command_grammar_truth.json", encoding="utf-8"))[_q9M.getLocal("k")]["nplots"]))
        _w35_expect Q3509-8 "(`q98np' == 2)" "`k': twoway draws `q98np' plots"
        capture erase "`f1'"
        capture erase "`f2'"
        local ++q98n
    }
    _w35_expect Q3509-8 "(`q98n' == 2)" "`q98n' forms read, 2 expected"
    _w35_done Q3509-8 "the `q98n' option-less || groups draw the plots twoway draws"
    macro drop q3509_keys q3509_g1 q3509_g2
    dash clear
    display as text "S09 end " c(current_date) " " c(current_time)
}
* ==== end S09 ====

* ==== append new blocks above this line ====

// ----------------------------------------------------------------
// Summary (test_wp29_truth.cscript's shape)
// ----------------------------------------------------------------
capture graph drop _all
capture dash clear
capture rmdir "`w35_work'"
local nfail    = ${w35_nfail}
local faillist "${w35_faillist}"
local ncase    = ${w35_ncase}
local only : env WP35_ONLY
macro drop w35_nfail w35_faillist w35_bad w35_ncase
display as text ""
display as text "============================================================"
if `ncase' == 0 {
    if `w35_N' > 1 & `"`macval(only)'"' == "" & "`w35_run'" == "" {
        display as text "test_wp35_truth: part `w35_k'/`w35_N' has no block to run"
        display as text "============================================================"
        exit 0
    }
    // A WP35_ONLY that names no block, or only a stub, ran nothing:
    // that is not a pass.
    display as error "  test_wp35_truth: no case ran (WP35_ONLY=`only')"
    display as text "============================================================"
    exit 9
}
else if `nfail' == 0 {
    display as text "  test_wp35_truth: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_wp35_truth: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
