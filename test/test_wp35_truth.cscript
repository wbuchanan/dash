*! test_wp35_truth.cscript
*! WP-35's ONE certification script (.ultraplan/sections/index.md PD-6):
*! every comparison with twoway's drawing or with Stata's own values that
*! WP-35's sections need lives here, one block per GAPS4 row (or per
*! harness tool), appended above the "append new blocks above this line"
*! marker in section order.  Refusal, message and return-code checks join
*! the EXISTING script for their area (merge rule R1).
*!
*! Made from test/templates/wp_truth_template.cscript (35 -> the WP's
*! number).  S00 is the scaffold smoke (Q3500-1).  A section appends
*! `* ==== S<MM> <lead id>: <what> ====` ... `* ==== end S<MM> ====` (or
*! `S<MM> tool: <what>` for a section with no item), its helper programs
*! directly above its first header, and writes only inside its own
*! blocks.  Case ids are Q35<MM>-<k> (PD-5).
*!
*! Usage: via run_all_cscripts.do.  One block alone: WP35_ONLY=S<MM> in
*! the driver's environment.  Each block prints "S<MM> start" and "S<MM>
*! end" with the date and time.  The suite runs it in every session;
*! DASH_CERT_SHARD=k/N runs part k of N of the blocks; a part with no
*! block ends 0.

cscript "WP-35 truth: twoway comparisons" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off


do "cert_helpers.do"
quietly do "cert_svg.do"
qui do "../dash_parse.mata"
qui do "../dash.ado"
global dash_nobrowser 1

// ----------------------------------------------------------------
// Tally helpers -- test_wp29_truth.cscript's _w29_expect/_w29_done,
// renamed _w35_ for this script.  A case is any number of
// _w35_expect lines closed by one _w35_done.
// ----------------------------------------------------------------
global w35_nfail    = 0
global w35_faillist ""
global w35_bad      = 0
global w35_ncase    = 0

capture program drop _w35_expect
program define _w35_expect
    version 19
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global w35_bad = 1
    }
end

capture program drop _w35_done
program define _w35_done
    version 19
    args id msg
    if ${w35_bad} {
        global w35_nfail    = ${w35_nfail} + 1
        global w35_faillist "${w35_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global w35_bad   = 0
    global w35_ncase = ${w35_ncase} + 1
end

// A fresh directory for this run's files, never one that already exists:
// a fixed name in a shared temp directory could be planted by another
// account (rule 1), so a name Stata has not handed out before is made and
// the run fails if it cannot be.  Every block writes only under it.
tempfile w35_base
local w35_work "`w35_base'_w35"
capture mkdir "`w35_work'"
if _rc {
    display as error "test_wp35_truth: cannot create the work directory `w35_work' (rc `=_rc')"
    exit 9
}

// ---- parts: begin (WP-35 test performance) ----
// The certification suite runs this script in every one of its sessions
// (its row in run_all_cscripts.do's shard table is "* * *"); with
// DASH_CERT_SHARD=k/N set, the session runs part k of N of the blocks.
// The parts are balanced longest first onto the least loaded part (the
// lowest numbered of equals), by the seconds below -- a block not listed
// counts 1 s (section-01 D-01.f) -- the rule scripts/cert_shards.py uses
// for the scripts.  Unset, or with WP35_ONLY set
// (which keeps its precedence), every block runs.  A block runs when its
// gate finds its id in w35_run.
// Seconds: each block's start/end lines in the WP's last measured
// certification run, rounded up, at least 1; a block not listed
// counts 1 s.
local w35_secs S00 1 S01 31 S02 2 S03 1 S04 1 S05 1 S06 1 S07 1 S08 6 S09 1
local w35_sh : environment DASH_CERT_SHARD
mata: st_local("w35_ok", strofreal(st_local("w35_sh") == "" | ustrregexm(st_local("w35_sh"), "^[1-8]/[1-8]$")))
if !`w35_ok' {
    display as error "test_wp35_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 8"
    exit 198
}
local w35_k 1
local w35_N 1
if "`w35_sh'" != "" {
    local w35_k = real(substr("`w35_sh'", 1, 1))
    local w35_N = real(substr("`w35_sh'", 3, 1))
}
local w35_only : env WP35_ONLY
if `"`macval(w35_only)'"' != "" | `w35_N' == 1 {
    local w35_k 1
    local w35_N 1
}
if `w35_k' > `w35_N' {
    display as error "test_wp35_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 8"
    exit 198
}
capture confirm file "test_wp35_truth.cscript"
if _rc {
    display as error "test_wp35_truth: run it from test/, where it reads its own blocks"
    exit 601
}
capture mata: mata drop _w35_part()
mata:
// The ids of the blocks (their header lines, in file order), and those of
// part k of n: longest first onto the least loaded part.
void _w35_part(string scalar file, string scalar table, real scalar k,
               real scalar n)
{
    string colvector lines, ids
    string rowvector tok
    real colvector sec, o, at
    real rowvector load
    real scalar i, j, p, best
    string scalar run

    lines = cat(file)
    ids = J(0, 1, "")
    for (i = 1; i <= rows(lines); i++) {
        if (ustrregexm(lines[i], "^\* ==== (S[0-9]+) ")) {
            if (!anyof(ids, ustrregexs(1))) ids = ids \ ustrregexs(1)
        }
    }
    sec = J(rows(ids), 1, 1)
    tok = tokens(table)
    for (j = 1; j + 1 <= cols(tok); j = j + 2) {
        for (i = 1; i <= rows(ids); i++) {
            if (ids[i] == tok[j]) sec[i] = strtoreal(tok[j + 1])
        }
    }
    o = order((-sec, (1::rows(ids))), (1, 2))
    load = J(1, n, 0)
    at = J(rows(ids), 1, 0)
    for (i = 1; i <= rows(o); i++) {
        best = 1
        for (p = 2; p <= n; p++) if (load[p] < load[best]) best = p
        load[best] = load[best] + sec[o[i]]
        at[o[i]] = best
    }
    run = ""
    for (i = 1; i <= rows(ids); i++) if (at[i] == k) run = run + " " + ids[i]
    st_local("w35_run", strtrim(run))
}
end
// The part this session runs: the runner's shard table may turn the
// parts (cert_helpers.do's cert_split_part, 11nov2026), so that
// each script's longest part lands on a different session.
cert_split_part "test_wp35_truth.cscript" `w35_k' `w35_N'
local w35_p = r(part)
mata: _w35_part("test_wp35_truth.cscript", st_local("w35_secs"), `w35_p', `w35_N')
display as text "test_wp35_truth: session `w35_k'/`w35_N' runs part `w35_p', `: word count `w35_run'' blocks: `w35_run'"
// ---- parts: end ----

* ==== S00 scaffold: the helpers load and a twoway SVG is read ====
local only : env WP35_ONLY
if inlist("`only'", "", "S00") & `: list posof "S00" in w35_run' {
    display as text "S00 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3500-1: cert_svg_export and cert_svg_texts on one twoway scatter,
    // and dash's own programs are loaded from this tree.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(w35s01, replace)
    cert_svg_export, name(w35s01) file("`w35_work'/w35s01.svg")
    local s01_rc   = r(rc)
    local s01_file "`r(file)'"
    _w35_expect Q3500-1 "(`s01_rc' == 0)" "cert_svg_export rc `s01_rc'"
    capture confirm file "`s01_file'"
    _w35_expect Q3500-1 "(_rc == 0)" "r(file) `s01_file' does not exist"
    cert_svg_texts, file("`s01_file'")
    local s01_n    = r(n)
    local s01_list "`r(list)'"
    _w35_expect Q3500-1 "(`s01_n' > 0)" "cert_svg_texts found no text elements"
    capture program list _dash_serve
    _w35_expect Q3500-1 "(_rc == 0)" "dash.ado's _dash_serve is not loaded"
    _w35_done Q3500-1 "a twoway SVG was written and read (`s01_n' texts); dash is loaded"

    capture erase "`s01_file'"
    capture erase "`s01_list'"
    capture graph drop w35s01
    display as text "S00 end " c(current_date) " " c(current_time)
}
* ==== end S00 ====

// ----------------------------------------------------------------
// S01 helpers (WP-35 MS-1).  _s01_pair id work R E: R is a command with
// an option given twice, E the same command with only its last copy
// (twoway syntax without the leading "twoway").  twoway must draw R and E
// alike (equal SVG text, ids aside; a pair twoway draws differently is a wrong
// probe), and dash must take both, register one spec for both, and name
// nothing as unsupported.
// _s01_first work cmd: runs cmd under a log of its own and returns its
// rc in r(rc) and the first line it printed in r(line).
// ----------------------------------------------------------------
capture program drop _s01_pair
program define _s01_pair
    version 19
    args id work R E
    foreach w in R E {
        capture graph drop _all
        capture twoway ``w''
        local trc_`w' = _rc
        mata: _s01_svg_`w' = J(0, 1, "")
        if !`trc_`w'' {
            capture erase "`work'/s01_`w'.svg"
            quietly graph export "`work'/s01_`w'.svg", replace as(svg)
            mata: _s01_svg_`w' = _s01_svg(st_local("work") + "/s01_`w'.svg")
            capture erase "`work'/s01_`w'.svg"
        }
    }
    capture graph drop _all
    mata: st_local("tsame", strofreal(_s01_svg_same(_s01_svg_R, _s01_svg_E)))
    capture mata: mata drop _s01_svg_R _s01_svg_E
    _w35_expect `id' "(`trc_R' == 0 & `trc_E' == 0)" ///
        `"twoway refused the pair (rc `trc_R', `trc_E'): `R'"'
    _w35_expect `id' "(`tsame' == 1)" ///
        `"wrong pair: twoway draws R and E differently: `R'"'
    capture dash clear
    capture log close s01log
    capture erase "`work'/s01_dash.log"
    quietly log using "`work'/s01_dash.log", text replace name(s01log) nomsg
    capture noisily dash `R' name(s01g)
    local drc_R = _rc
    mata: _s01_json = st_global("dash_json_s01g")
    capture dash clear
    capture noisily dash `E' name(s01g)
    local drc_E = _rc
    quietly log close s01log
    mata: st_local("same", strofreal(_s01_json == st_global("dash_json_s01g") & _s01_json != ""))
    capture dash clear
    capture mata: mata drop _s01_json
    _w35_expect `id' "(`drc_R' == 0)" `"dash refused (rc `drc_R'): `R'"'
    _w35_expect `id' "(`drc_E' == 0)" `"dash refused (rc `drc_E'): `E'"'
    _w35_expect `id' "(`same' == 1)" `"dash registered another spec for: `R'"'
    cert_log_has "`work'/s01_dash.log", needle("ignoring unsupported")
    _w35_expect `id' "(r(found) == 0)" `"dash named an option unsupported: `R'"'
    capture erase "`work'/s01_dash.log"
end

capture program drop _s01_first
program define _s01_first, rclass
    version 19
    args work cmd
    capture log close s01log
    capture erase "`work'/s01_first.log"
    quietly log using "`work'/s01_first.log", text replace name(s01log) nomsg
    capture noisily `cmd'
    local rc = _rc
    quietly log close s01log
    mata: st_local("line", _s01_first_line(st_local("work") + "/s01_first.log"))
    capture erase "`work'/s01_first.log"
    capture graph drop _all
    capture dash clear
    return scalar rc = `rc'
    return local line `"`macval(line)'"'
end

capture mata: mata drop _s01_first_line()
capture mata: mata drop _s01_svg()
capture mata: mata drop _s01_svg_same()
mata:
// An SVG's text with the clip-path ids Stata draws at random each export
// (path_<8 letters>, clipPath_<8 letters>) written as one id, so two
// exports of one drawing compare equal.
string colvector _s01_svg(string scalar file)
{
    string colvector l
    real scalar i
    l = cat(file)
    for (i = 1; i <= rows(l); i++) {
        l[i] = ustrregexra(ustrregexra(l[i], "path_[A-Za-z]{8}", "path_X"),
                           "Path_[A-Za-z]{8}", "Path_X")
    }
    return(l)
}

// 1 when two SVGs' lines (from _s01_svg) are the same, and not empty.
real scalar _s01_svg_same(string colvector a, string colvector b)
{
    if (rows(a) == 0 | rows(a) != rows(b)) return(0)
    return(all(a :== b))
}

// The first non-blank line of a log, trimmed.
string scalar _s01_first_line(string scalar file)
{
    string colvector l
    real scalar i
    l = cat(file)
    for (i = 1; i <= rows(l); i++) if (strtrim(l[i]) != "") return(strtrim(l[i]))
    return("")
}
end

* ==== S01 MS-1: repeated options taken rightmost ====
local only : env WP35_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w35_run' {
    display as text "S01 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3501-1: yvarlabel(), xvarlabel(), mlabprefix(), mlabsuffix(),
    // lalign(), mlabstyle() given twice draw their last copy, as twoway
    // draws it (yvarl() is yvarlabel()).
    // ------------------------------------------------------------
    sysuse auto, clear
    // Sorted by weight and mpg once, so line draws ties in one order: the
    // sort option leaves the order of equal weights to chance.
    sort weight mpg
    _s01_pair Q3501-1 "`w35_work'" `"scatter mpg weight, yvarlabel("Q") yvarlabel("R")"' `"scatter mpg weight, yvarlabel("R")"'
    _s01_pair Q3501-1 "`w35_work'" `"scatter mpg weight, xvarlabel("Q") xvarlabel("R")"' `"scatter mpg weight, xvarlabel("R")"'
    _s01_pair Q3501-1 "`w35_work'" `"scatter mpg weight, mlabel(make) mlabprefix("[") mlabprefix("<")"' `"scatter mpg weight, mlabel(make) mlabprefix("<")"'
    _s01_pair Q3501-1 "`w35_work'" `"scatter mpg weight, mlabel(make) mlabsuffix("]") mlabsuffix(">")"' `"scatter mpg weight, mlabel(make) mlabsuffix(">")"'
    _s01_pair Q3501-1 "`w35_work'" `"line mpg weight, lalign(inside) lalign(center)"' `"line mpg weight, lalign(center)"'
    _s01_pair Q3501-1 "`w35_work'" `"scatter mpg weight, mlabel(make) mlabstyle(p1) mlabstyle(p2)"' `"scatter mpg weight, mlabel(make) mlabstyle(p2)"'
    _s01_pair Q3501-1 "`w35_work'" `"scatter mpg weight, yvarlabel("Q") yvarl("R")"' `"scatter mpg weight, yvarlabel("R")"'
    _w35_done Q3501-1 "seven repeated label options drawn as their last copy, as twoway draws them"

    // ------------------------------------------------------------
    // Q3501-2: contour's valued options given twice draw their last
    // copy (twoway_zyx2view_parse.class: _parse combop ... rightmost).
    // ------------------------------------------------------------
    sysuse sandstone, clear
    local c "contour depth northing easting"
    local cl "contourline depth northing easting"
    _s01_pair Q3501-2 "`w35_work'" `"`c', levels(5) levels(6)"' `"`c', levels(6)"'
    _s01_pair Q3501-2 "`w35_work'" `"`c', ccuts(7600 7800) ccuts(7500 7700 7900)"' `"`c', ccuts(7500 7700 7900)"'
    _s01_pair Q3501-2 "`w35_work'" `"`c', scolor(red) scolor(blue)"' `"`c', scolor(blue)"'
    _s01_pair Q3501-2 "`w35_work'" `"`c', ecolor(red) ecolor(green)"' `"`c', ecolor(green)"'
    _s01_pair Q3501-2 "`w35_work'" `"`c', crule(hue) crule(linear)"' `"`c', crule(linear)"'
    _s01_pair Q3501-2 "`w35_work'" `"`c', interp(none) interp(thinplatespline)"' `"`c', interp(thinplatespline)"'
    _s01_pair Q3501-2 "`w35_work'" `"`c', levels(3) ccolors(red green blue yellow) ccolors(navy maroon olive teal)"' `"`c', levels(3) ccolors(navy maroon olive teal)"'
    _s01_pair Q3501-2 "`w35_work'" `"`c', format(%9.0f) format(%9.2f)"' `"`c', format(%9.2f)"'
    _s01_pair Q3501-2 "`w35_work'" `"`cl', clwidths(thin) clwidths(thick)"' `"`cl', clwidths(thick)"'
    _s01_pair Q3501-2 "`w35_work'" `"`cl', clpatterns(dash) clpatterns(solid)"' `"`cl', clpatterns(solid)"'
    _s01_pair Q3501-2 "`w35_work'" `"`cl', ccuts(7600 7800) clabels("a" "b" "c") clabels("x" "y" "z")"' `"`cl', ccuts(7600 7800) clabels("x" "y" "z")"'
    _w35_done Q3501-2 "eleven repeated contour options drawn as their last copy, as twoway draws them"

    // ------------------------------------------------------------
    // Q3501-3: a contour flag given twice is refused, with twoway's
    // return code and first line.
    // ------------------------------------------------------------
    foreach f in "`c', minmax minmax" "`c', reversekey reversekey" "`c', outlines outlines" "`cl', colorlines colorlines" {
        _s01_first "`w35_work'" `"twoway `f'"'
        local trc = r(rc)
        local tln `"`r(line)'"'
        _s01_first "`w35_work'" `"dash `f' name(s01g)"'
        local drc = r(rc)
        local dln `"`r(line)'"'
        _w35_expect Q3501-3 "(`trc' != 0)" `"twoway took `f'"'
        _w35_expect Q3501-3 "(`drc' == `trc')" `"`f': dash rc `drc', twoway rc `trc'"'
        mata: st_local("same", strofreal(st_local("dln") == st_local("tln")))
        _w35_expect Q3501-3 "(`same' == 1)" `"`f': dash said [`dln'], twoway said [`tln']"'
    }
    // 5 -> 4 flags: one contour no longer takes leaves the list (D65).
    _w35_done Q3501-3 "four repeated contour flags refused as twoway refuses them"

    sysuse auto, clear
    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====

// S02 helpers (WP-35 section 35-02, syn:SD-3): _w35s02_run runs one dash
// command into a log (inside a program, so the command is not echoed);
// _w35s02_read reads that log's first error line and note, and the named
// graph's plot <k> mcolor from its registered spec; _w35s02_page counts
// a page's red Scatter fills and the largest y of each.
capture program drop _w35s02_run
program define _w35s02_run
    version 19
    args log cmd
    capture erase "`log'"
    quietly log using "`log'", replace text name(w35s02)
    capture noisily dash `cmd'
    global w35s02_rc = _rc
    quietly log close w35s02
end

python:
import json as _w35s02_json
import re as _w35s02_re
from sfi import Macro as _w35s02_M


def _w35s02_read(log, name, k):
    try:
        text = open(log, encoding="utf-8", errors="replace").read()
    except OSError:
        text = ""
    lines = [s.strip() for s in text.replace("\n> ", "").splitlines()]
    msg = [s for s in lines if s and not s.startswith("r(")
           and not s.startswith(("name:", "log:", "log type:", "opened on:",
                                 "closed on:")) and set(s) != {"-"}]
    note = " ".join(s for s in msg if "ignoring unsupported" in s)
    _w35s02_M.setGlobal("w35s02_first", msg[0] if msg else "")
    _w35s02_M.setGlobal("w35s02_pnote", "1" if _w35s02_re.search(
        r"\bp[0-9]+\(", note) else "0")
    mc = ""
    try:
        spec = _w35s02_json.loads(_w35s02_M.getGlobal("dash_json_" + name))
        mc = str(spec["plots"][int(k) - 1]["options"].get("mcolor", ""))
    except Exception as e:
        mc = "?" + str(e)[:60]
    _w35s02_M.setGlobal("w35s02_mc", mc)


def _w35s02_page(path, app=None):
    """Global w35s02_red: the largest y of each Scatter filled red, and
    w35s02_n the number of Scatter renderers, on the saved page path (or
    on the served app's document, built from app, when app is given)."""
    from bokeh.document import Document
    from bokeh.models import GlyphRenderer, Scatter
    try:
        if app is not None:
            from bokeh.io.doc import patch_curdoc
            doc = Document()
            with patch_curdoc(doc):
                exec(compile(open(app, encoding="utf-8").read(), app, "exec"),
                     {"__name__": "_w35s02_app", "_DASH_TRIAL": True})
        else:
            page = open(path, encoding="utf-8").read()
            ents = {"amp": "&", "lt": "<", "gt": ">", "quot": chr(34),
                    "#x27": chr(39), "#x60": chr(96)}
            blocks = _w35s02_re.findall(
                r'<script type="application/json" id="[^"]+">\s*(.*?)\s*</script>',
                page, _w35s02_re.S)
            docs = [d for b in blocks for d in _w35s02_json.loads(
                _w35s02_re.sub(r"&(amp|lt|gt|quot|#x27|#x60);",
                               lambda m: ents[m.group(1)], b)).values()]
            doc = Document.from_json(docs[0])
        red, n = [], 0
        for m in doc.models:
            # Flipped (WP-43 LT-21, 097a8f7): a legend-only key proxy
            # draws the layer's key (its y a NaN value), not a scatter.
            if (str(getattr(m, "name", "") or "") == "__dash_keyproxy" or "dash_key_proxy" in (getattr(m, "tags", None) or [])):
                continue
            if isinstance(m, GlyphRenderer) and isinstance(m.glyph, Scatter):
                n += 1
                fc = m.glyph.fill_color
                fc = fc.get("value") if isinstance(fc, dict) else getattr(fc, "value", fc)
                if str(fc).lower() in ("red", "#ff0000", "#f00"):
                    y = m.glyph.y
                    y = y.get("field") if isinstance(y, dict) else getattr(y, "field", y)
                    vals = [v for v in m.data_source.data.get(y, [])
                            if v is not None and v == v]
                    red.append("%g" % max(vals) if vals else "none")
        _w35s02_M.setGlobal("w35s02_red", " ".join(red))
        _w35s02_M.setGlobal("w35s02_n", str(n))
    except Exception as e:
        _w35s02_M.setGlobal("w35s02_red", "error " + str(e)[:200])
        _w35s02_M.setGlobal("w35s02_n", "0")
end

* ==== S02 syn:SD-3: p1() .. p20() mapped onto their plots ====
local only : env WP35_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w35_run' {
    display as text "S02 start " c(current_date) " " c(current_time)

    // Each probe twoway draws (test/fixtures/pnum_truth.json, from
    // scripts/extract_pnum_truth.do): its key, the place in dash's plots
    // of the plot it styles, and whether twoway drew it red.
    local s02_keys g_p1:1 g_p3:3 g_p19:1 g_p20:1 multi_y:2 multi_own:2 ///
        multi_short:2 plot_level:2 prec_own:1 prec_grp:1 twice:1 ///
        ci_after:2 ci_nofit_after:2 ci_p2:2 plot_n1:1 plot_over:1 ///
        own_prec:1 own_vs_grp:1 own_twice:1 g_empty:1 bars_p2:2 bars_p1:1
    python: _w35s02_M.setGlobal("w35s02_fx", _w35s02_json.dumps(_w35s02_json.load(open(r"fixtures/pnum_truth.json", encoding="utf-8"))["probes"]))

    // ------------------------------------------------------------
    // Q3502-1: dash draws each p#() on the plot twoway draws it on -- red
    // where twoway counts red markers, not red where it counts none --
    // and names no p#() in its note.
    // ------------------------------------------------------------
    sysuse auto, clear
    foreach kk of local s02_keys {
        gettoken key k : kk, parse(":")
        local k = substr("`k'", 2, .)
        python: _w35s02_fxp = _w35s02_json.loads(_w35s02_M.getGlobal("w35s02_fx"))["`key'"]; _w35s02_M.setLocal("s02_cmd", _w35s02_fxp["cmd"][len("twoway "):]); _w35s02_M.setLocal("s02_trc", str(_w35s02_fxp["rc"])); _w35s02_M.setLocal("s02_tred", str(_w35s02_fxp["red"] or 0))
        _w35_expect Q3502-1 "(`s02_trc' == 0)" "`key': the fixture's twoway rc is `s02_trc'"
        // name() after the graph's comma, or after a new one when the
        // command (its last || segment) has none.
        mata: _s02c = st_local("s02_cmd"); if (strpos(_s02c, "||")) _s02c = substr(_s02c, strrpos(_s02c, "||") + 2, .); st_local("s02_sep", (ustrregexm(_s02c, "^\s*\(") & !strpos(_s02c, "), ")) | !strpos(_s02c, ",") ? "," : "")
        capture dash clear
        _w35s02_run "`w35_work'/s02.log" `"`s02_cmd'`s02_sep' name(s02)"'
        python: _w35s02_read(r"`w35_work'/s02.log", "s02", "`k'")
        _w35_expect Q3502-1 "(${w35s02_rc} == 0)" `"`key': dash `s02_cmd' rc ${w35s02_rc} (${w35s02_first})"'
        _w35_expect Q3502-1 "(${w35s02_pnote} == 0)" "`key': dash named a p#() in its note"
        if `s02_tred' > 0 {
            _w35_expect Q3502-1 `"("${w35s02_mc}" == "red")"' "`key': twoway draws plot `k' red, dash's mcolor is ${w35s02_mc}"
        }
        else {
            _w35_expect Q3502-1 `"("${w35s02_mc}" != "red")"' "`key': twoway draws plot `k' with no red, dash's mcolor is red"
        }
    }
    capture erase "`w35_work'/s02.log"
    _w35_done Q3502-1 "p#() after the comma and inside a plot styles the plot twoway styles"

    // ------------------------------------------------------------
    // Q3502-2: the refusals -- p21() and above after the comma and inside
    // a plot, an option twoway does not take inside p1(), and a plot's own
    // refusal before the comma's p21() -- in twoway's rc and first line.
    // ------------------------------------------------------------
    foreach key in g_p21 g_p100 own_p21 bad_inner order_p21 {
        python: _w35s02_fxp = _w35s02_json.loads(_w35s02_M.getGlobal("w35s02_fx"))["`key'"]; _w35s02_M.setLocal("s02_cmd", _w35s02_fxp["cmd"][len("twoway "):]); _w35s02_M.setLocal("s02_trc", str(_w35s02_fxp["rc"])); _w35s02_M.setLocal("s02_tl", _w35s02_fxp["first_line"])
        capture dash clear
        _w35s02_run "`w35_work'/s02.log" `"`s02_cmd'"'
        python: _w35s02_read(r"`w35_work'/s02.log", "s02", "1")
        _w35_expect Q3502-2 "(${w35s02_rc} == `s02_trc')" "`key': twoway rc `s02_trc', dash rc ${w35s02_rc}"
        _w35_expect Q3502-2 `"(`"${w35s02_first}"' == `"`s02_tl'"')"' `"`key': twoway `s02_tl', dash ${w35s02_first}"'
    }
    capture erase "`w35_work'/s02.log"
    _w35_done Q3502-2 "p21(), p100(), p1(nosuch(1)) and a plot's own refusal are twoway's"

    // ------------------------------------------------------------
    // Q3502-3: g_p3 -- the saved page and the served app draw the third
    // plot (trunk, largest y 23) red and no other.
    // ------------------------------------------------------------
    sysuse auto, clear
    capture dash clear
    quietly dash (scatter mpg weight) (scatter price weight) (scatter trunk weight), p3(mcolor(red)) name(g3)
    capture erase "`w35_work'/s02_g3.html"
    capture noisily dash build, saving("`w35_work'/s02_g3.html") replace nobrowser
    _w35_expect Q3502-3 "(_rc == 0)" "dash build rc `=_rc'"
    python: _w35s02_page(r"`w35_work'/s02_g3.html")
    _w35_expect Q3502-3 `"("${w35s02_red}" == "23")"' "saved page: red scatters' largest y ${w35s02_red} (want 23)"
    _w35_expect Q3502-3 "(${w35s02_n} == 3)" "saved page: ${w35s02_n} scatters"
    capture erase "`w35_work'/s02_g3.py"
    capture noisily dash build, server saving("`w35_work'/s02_g3.py") replace nobrowser
    _w35_expect Q3502-3 "(_rc == 0)" "dash build, server rc `=_rc'"
    python: _w35s02_page(None, r"`w35_work'/s02_g3.py")
    _w35_expect Q3502-3 `"("${w35s02_red}" == "23")"' "served app: red scatters' largest y ${w35s02_red} (want 23)"
    _w35_expect Q3502-3 "(${w35s02_n} == 3)" "served app: ${w35s02_n} scatters"
    capture erase "`w35_work'/s02_g3.html"
    capture erase "`w35_work'/s02_g3.py"
    _w35_done Q3502-3 "p3() draws the third plot red on the saved page and in the served app"
    macro drop w35s02_*
    capture dash clear

    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

// ----------------------------------------------------------------
// S03 helpers (WP-35 section 35-03).  _s03_same id work data A B: on a
// fresh copy of data (auto or sandstone), dash takes A and B (twoway
// syntax without the leading "twoway"), registers one spec for both and
// names nothing as unsupported.  _s03_rc id work data cmd rc line: dash
// gives cmd's rc and first line as twoway gives them
// (stat_accept_truth.json).
// ----------------------------------------------------------------
capture program drop _s03_same
program define _s03_same
    version 19
    args id work data A B
    capture dash clear
    capture log close s03log
    capture erase "`work'/s03_same.log"
    quietly log using "`work'/s03_same.log", text replace name(s03log) nomsg
    quietly sysuse `data', clear
    capture noisily dash `A' name(s03g)
    local drc_A = _rc
    mata: _s03_json = st_global("dash_json_s03g")
    capture dash clear
    quietly sysuse `data', clear
    capture noisily dash `B' name(s03g)
    local drc_B = _rc
    quietly log close s03log
    mata: st_local("same", strofreal(_s03_json == st_global("dash_json_s03g") & _s03_json != ""))
    capture dash clear
    capture mata: mata drop _s03_json
    _w35_expect `id' "(`drc_A' == 0)" `"dash refused (rc `drc_A'): `A'"'
    _w35_expect `id' "(`drc_B' == 0)" `"dash refused (rc `drc_B'): `B'"'
    _w35_expect `id' "(`same' == 1)" `"dash registered another spec for `A' than for `B'"'
    cert_log_has "`work'/s03_same.log", needle("ignoring unsupported")
    _w35_expect `id' "(r(found) == 0)" `"dash named an option unsupported: `A'"'
    capture erase "`work'/s03_same.log"
end

capture program drop _s03_rc
program define _s03_rc
    version 19
    args id work data cmd rc line
    quietly sysuse `data', clear
    _s01_first "`work'" `"dash `cmd' name(s03g)"'
    local drc = r(rc)
    local dline `"`r(line)'"'
    if `rc' == 0 local dline ""
    _w35_expect `id' "(`drc' == `rc')" `"dash rc `drc', twoway `rc': `cmd'"'
    mata: st_local("same", strofreal(st_local("dline") == st_local("line")))
    _w35_expect `id' "(`same' == 1)" `"dash said "`macval(dline)'", twoway "`macval(line)'": `cmd'"'
end

// _s03_samefp id work A B: dash takes the function commands A and B and
// stores the same function points for both (the graph's point file,
// _dash_fpts_get; WP-36 plat:PT-4).
capture program drop _s03_samefp
program define _s03_samefp
    version 19
    args id work A B
    quietly sysuse auto, clear
    capture dash clear
    capture log close s03log
    capture erase "`work'/s03_fp.log"
    quietly log using "`work'/s03_fp.log", text replace name(s03log) nomsg
    capture noisily dash `A' name(s03g)
    local drc_A = _rc
    // Flipped (WP-36 plat:PT-4): read through _dash_fpts_get.
    mata: _s03_fp = _dash_fpts_get("s03g")
    capture dash clear
    quietly sysuse auto, clear
    capture noisily dash `B' name(s03g)
    local drc_B = _rc
    quietly log close s03log
    mata: st_local("same", strofreal(_s03_fp == _dash_fpts_get("s03g") & _s03_fp != ""))
    capture dash clear
    capture mata: mata drop _s03_fp
    _w35_expect `id' "(`drc_A' == 0)" `"dash refused (rc `drc_A'): `A'"'
    _w35_expect `id' "(`drc_B' == 0)" `"dash refused (rc `drc_B'): `B'"'
    _w35_expect `id' "(`same' == 1)" `"dash's points for `A' are not those of `B'"'
    cert_log_has "`work'/s03_fp.log", needle("ignoring unsupported")
    _w35_expect `id' "(r(found) == 0)" `"dash named an option unsupported: `A'"'
    capture erase "`work'/s03_fp.log"
end

// _s03_quiet id work cmd: dash takes cmd, stores twoway's generator's
// points for it (its point file; WP-36 plat:PT-4), and prints no line but its
// registration line, as twoway prints none (stat_accept_truth.json
// n.<type>.-1 notes).
capture program drop _s03_quiet
program define _s03_quiet
    version 19
    args id work cmd
    quietly sysuse auto, clear
    capture dash clear
    capture log close s03log
    capture erase "`work'/s03_q.log"
    quietly log using "`work'/s03_q.log", text replace name(s03log) nomsg
    capture noisily dash `cmd' name(s03g)
    local drc = _rc
    quietly log close s03log
    // Flipped (WP-36 plat:PT-4): read through _dash_fpts_get.
    mata: st_local("fp", strofreal(_dash_fpts_get("s03g") != ""))
    capture dash clear
    mata: _s03_l = cat(st_local("work") + "/s03_q.log")
    mata: _s03_l = select(_s03_l, strtrim(_s03_l) :!= "")
    mata: _s03_l = select(_s03_l, !strmatch(_s03_l, "dash: graph '*' registered."))
    mata: st_local("extra", strofreal(rows(_s03_l)))
    mata: st_local("first", rows(_s03_l) ? _s03_l[1] : "")
    capture mata: mata drop _s03_l
    _w35_expect `id' "(`drc' == 0)" `"dash refused (rc `drc'): `cmd'"'
    _w35_expect `id' "(`fp' == 1)" `"dash stored no generator points for: `cmd'"'
    _w35_expect `id' "(`extra' == 0)" `"dash printed "`macval(first)'", twoway nothing: `cmd'"'
    capture erase "`work'/s03_q.log"
end

* ==== S03 stat:PT-7: lowess m read as mean ====
local only : env WP35_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w35_run' {
    display as text "S03 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3503-1: lowess m is lowess mean (twoway_lowess_parse.class Mean;
    // stat_accept_truth.json lowess_m and lowess_mean draw one curve):
    // dash takes it and registers mean's spec.
    // ------------------------------------------------------------
    _s03_same Q3503-1 "`w35_work'" auto "lowess mpg weight, m" "lowess mpg weight, mean"
    quietly sysuse auto, clear
    capture dash lowess mpg weight, m name(s03g)
    mata: st_local("s03_mean", strofreal(strpos(st_global("dash_json_s03g"), char(34) + "mean" + char(34)) > 0))
    capture dash clear
    _w35_expect Q3503-1 "(`s03_mean' == 1)" "dash's spec for lowess m holds no mean"
    _w35_done Q3503-1 "lowess m is read as mean"

    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

* ==== S03 syn:SD-5: bwi() read as bwidth() ====
local only : env WP35_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w35_run' {
    display as text "S03 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3503-2: bwi() is bwidth() on lowess, kdensity, lpoly and lpolyci
    // (each parse class declares BWidth; stat_accept_truth.json bwi.<type>
    // draws bwidth.<type>'s serset): dash registers bwidth()'s spec.
    // ------------------------------------------------------------
    _s03_same Q3503-2 "`w35_work'" auto "lowess mpg weight, bwi(.5)" "lowess mpg weight, bwidth(.5)"
    _s03_same Q3503-2 "`w35_work'" auto "kdensity mpg, bwi(2)" "kdensity mpg, bwidth(2)"
    _s03_same Q3503-2 "`w35_work'" auto "lpoly mpg weight, bwi(500)" "lpoly mpg weight, bwidth(500)"
    _s03_same Q3503-2 "`w35_work'" auto "lpolyci mpg weight, bwi(500)" "lpolyci mpg weight, bwidth(500)"
    _w35_done Q3503-2 "bwi() is read as bwidth() on the four bandwidth types"

    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

* ==== S03 stat:PT-13: contour's documented abbreviations ====
local only : env WP35_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w35_run' {
    display as text "S03 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3503-3: on contour and contourline twoway reads i() .. interp() as
    // interp(), colorl .. colorlines as colorlines, clp() .. clpatterns()
    // as clpatterns() and clw() .. clwidths() as clwidths()
    // (twoway_zyx2view_parse.class Interp, COLORLines, CLPatterns,
    // CLWidths; stat_accept_truth.json contour.*): dash registers the full
    // spelling's spec.
    // ------------------------------------------------------------
    _s03_same Q3503-3 "`w35_work'" sandstone "contour depth northing easting, i(none)" "contour depth northing easting, interp(none)"
    _s03_same Q3503-3 "`w35_work'" sandstone "contour depth northing easting, int(none)" "contour depth northing easting, interp(none)"
    _s03_same Q3503-3 "`w35_work'" sandstone "contourline depth northing easting, colorl" "contourline depth northing easting, colorlines"
    _s03_same Q3503-3 "`w35_work'" sandstone "contourline depth northing easting, colorli" "contourline depth northing easting, colorlines"
    _s03_same Q3503-3 "`w35_work'" sandstone "contourline depth northing easting, clp(dash)" "contourline depth northing easting, clpatterns(dash)"
    _s03_same Q3503-3 "`w35_work'" sandstone "contourline depth northing easting, clw(thick)" "contourline depth northing easting, clwidths(thick)"
    _s03_same Q3503-3 "`w35_work'" sandstone "contour depth northing easting, interp(thinplatespline) i(none)" "contour depth northing easting, interp(none)"
    _w35_done Q3503-3 "contour's documented abbreviations are read as twoway reads them"

    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

* ==== S03 stat:PT-6: function subchar() honoured ====
local only : env WP35_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w35_run' {
    display as text "S03 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3503-4: twoway_function_parse.class SUBChar(name) names the
    // expression's variable (stat_accept_truth.json subchar.*): t^2 with
    // subchar(t) draws x^2's points (0 .25 1 2.25 4), subc() is its
    // minimum, the last of two copies is read; a value that is not a name,
    // two names, the option off function and sub() are refused in
    // twoway's words, and an unknown word before it is named first.
    // ------------------------------------------------------------
    _s03_samefp Q3503-4 "`w35_work'" "function y = t^2, subchar(t) range(0 2) n(5)" "function y = x^2, range(0 2) n(5)"
    _s03_samefp Q3503-4 "`w35_work'" "function y = t^2, subc(t) range(0 2) n(5)" "function y = x^2, range(0 2) n(5)"
    _s03_samefp Q3503-4 "`w35_work'" "function y = t^2, subchar(s) subchar(t) range(0 2) n(5)" "function y = x^2, range(0 2) n(5)"
    _s03_rc Q3503-4 "`w35_work'" auto "function y = t^2, subchar(1t) range(0 2) n(5)" 198 "1t invalid name"
    _s03_rc Q3503-4 "`w35_work'" auto "function y = t^2, subchar(t t) range(0 2) n(5)" 103 "option subchar():  too many names specified"
    _s03_rc Q3503-4 "`w35_work'" auto "scatter mpg weight, subchar(t)" 198 "option subchar() not allowed"
    _s03_rc Q3503-4 "`w35_work'" auto "scatter mpg weight, bogus subchar(t)" 198 "option bogus not allowed"
    _s03_rc Q3503-4 "`w35_work'" auto "function y = t^2, sub(t) range(0 2) n(5)" 111 "error in expression:  t^2"
    _w35_done Q3503-4 "function subchar() names the expression's variable, as twoway reads it"

    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

* ==== S03 stat:PT-9: edge n() and bands() values ====
local only : env WP35_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w35_run' {
    display as text "S03 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3503-5: the edge values twoway takes (stat_accept_truth.json):
    // bands(-1) on mspline and mband draws the default (the same SVG as
    // none), fpfitci takes any integer n() and draws as without it, and
    // n(-1) on lfit, qfit, lfitci and qfitci is drawn by twoway's own
    // generator (an empty fit, its legend key kept), silently; n(0) there
    // is "'0' invalid observation number", r(198).
    // ------------------------------------------------------------
    _s03_same Q3503-5 "`w35_work'" auto "mspline mpg weight, bands(-1)" "mspline mpg weight,"
    _s03_same Q3503-5 "`w35_work'" auto "mband mpg weight, bands(-1)" "mband mpg weight,"
    _s03_same Q3503-5 "`w35_work'" auto "fpfitci mpg weight, n(0)" "fpfitci mpg weight,"
    _s03_same Q3503-5 "`w35_work'" auto "fpfitci mpg weight, n(-1)" "fpfitci mpg weight,"
    foreach t in lfit qfit lfitci qfitci {
        _s03_quiet Q3503-5 "`w35_work'" "`t' mpg weight, n(-1)"
        _s03_rc Q3503-5 "`w35_work'" auto "`t' mpg weight, n(0)" 198 "'0' invalid observation number"
    }
    _w35_done Q3503-5 "the edge n() and bands() values twoway takes are drawn as twoway draws them"

    // ------------------------------------------------------------
    // Q3503-12: twoway's whole n() rule on the fit types
    // (stat_accept_truth.json nr.<type>.<v>): from -1 to minus the
    // dataset's observations an empty fit, drawn silently; below that
    // "'<n>' invalid observation number"; no upper bound; a number that
    // is no integer, or missing, "option n() not allowed", r(198), as is
    // fpfitci's; fpfitci takes any integer.
    // ------------------------------------------------------------
    _s03_quiet Q3503-12 "`w35_work'" "lfit mpg weight, n(-74)"
    _s03_quiet Q3503-12 "`w35_work'" "qfitci mpg weight, n(-5)"
    _s03_rc Q3503-12 "`w35_work'" auto "lfit mpg weight, n(-75)" 198 "'-75' invalid observation number"
    _s03_rc Q3503-12 "`w35_work'" auto "lfitci mpg weight, n(-100)" 198 "'-100' invalid observation number"
    _s03_rc Q3503-12 "`w35_work'" auto "lfit mpg weight, n(10001)" 0 ""
    _s03_rc Q3503-12 "`w35_work'" auto "qfit mpg weight, n(1e3)" 0 ""
    _s03_rc Q3503-12 "`w35_work'" auto "lfit mpg weight, n(2.5)" 198 "option n() not allowed"
    _s03_rc Q3503-12 "`w35_work'" auto "qfitci mpg weight, n(.)" 198 "option n() not allowed"
    _s03_rc Q3503-12 "`w35_work'" auto "fpfitci mpg weight, n(2.5)" 198 "option n() not allowed"
    _s03_same Q3503-12 "`w35_work'" auto "fpfitci mpg weight, n(-1000000)" "fpfitci mpg weight,"
    _w35_done Q3503-12 "every n() twoway takes on the fit types is taken, and the rest refused in its words"

    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

* ==== S03 syn:SD-7: ty() on the ci types ====
local only : env WP35_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w35_run' {
    display as text "S03 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3503-6: the ci types' parse classes declare TYPE and RECASTas, so
    // only type() in full (and recast() .. recastas()) is refused, "type()
    // option not allowed", r(198); ty() and typ() draw as ciplot() does
    // (stat_accept_truth.json ty.<type> and ciplot.<type>: one SVG).
    // ------------------------------------------------------------
    foreach t in lfitci qfitci fpfitci lpolyci {
        _s03_same Q3503-6 "`w35_work'" auto "`t' mpg weight, ty(line)" "`t' mpg weight, ciplot(line)"
        _s03_rc Q3503-6 "`w35_work'" auto "`t' mpg weight, type(line)" 198 "type() option not allowed"
    }
    _s03_same Q3503-6 "`w35_work'" auto "lfitci mpg weight, typ(line)" "lfitci mpg weight, ciplot(line)"
    _s03_rc Q3503-6 "`w35_work'" auto "lfitci mpg weight, recastas(line)" 198 "recastas() option not allowed"
    _w35_done Q3503-6 "ty() is read on the ci types, and only type() in full is refused"

    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

* ==== S03 syn:SD-20a: dot dsi() read as dsize() ====
local only : env WP35_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w35_run' {
    display as text "S03 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3503-7: twoway's minimum of dsize() is dsi (abbrev_truth.json
    // options.dsize; stat_accept_truth.json sd20a.dsi draws dsize()'s SVG).
    // ------------------------------------------------------------
    _s03_same Q3503-7 "`w35_work'" auto "dot mpg weight, dsi(small)" "dot mpg weight, dsize(small)"
    _w35_done Q3503-7 "dsi() is read as dsize()"

    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

* ==== S03 syn:SD-20b: fpfit est() read as twoway reads it ====
local only : env WP35_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w35_run' {
    display as text "S03 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3503-8: on fpfit twoway reads est() as estopts() (ESTopts, minimum
    // est; estcmd()'s is estc): est(glm) draws estopts(glm)'s SVG, not
    // estcmd(glm)'s (stat_accept_truth.json sd20b.*).
    // ------------------------------------------------------------
    _s03_same Q3503-8 "`w35_work'" auto "fpfit mpg weight, est(glm)" "fpfit mpg weight, estopts(glm)"
    _s03_same Q3503-8 "`w35_work'" auto "fpfit mpg weight, estc(glm)" "fpfit mpg weight, estcmd(glm)"
    _w35_done Q3503-8 "est() is estopts() and estc() estcmd(), as twoway reads them"

    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

