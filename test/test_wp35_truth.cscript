*! test_wp35_truth.cscript
*! WP-35's ONE certification script (.ultraplan/sections/index.md PD-6):
*! every comparison with twoway's drawing or with Stata's own values that
*! WP-35's sections need lives here, one block per GAPS4 row (or per
*! harness tool), appended above the "append new blocks above this line"
*! marker in section order.  Refusal, message and return-code checks join
*! the EXISTING script for their area (merge rule R1).
*!
*! Made from test/templates/wp_truth_template.cscript (35 -> the WP's
*! number).  S00 is the scaffold smoke (Q3500-1).  A section appends
*! `* ==== S<MM> <lead id>: <what> ====` ... `* ==== end S<MM> ====` (or
*! `S<MM> tool: <what>` for a section with no item), its helper programs
*! directly above its first header, and writes only inside its own
*! blocks.  Case ids are Q35<MM>-<k> (PD-5).
*!
*! Usage: via run_all_cscripts.do.  One block alone: WP35_ONLY=S<MM> in
*! the driver's environment.  Each block prints "S<MM> start" and "S<MM>
*! end" with the date and time.  The suite runs it in every session;
*! DASH_CERT_SHARD=k/N runs part k of N of the blocks; a part with no
*! block ends 0.

cscript "WP-35 truth: twoway comparisons" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off

if `"`c(python_exec)'"' == "" {
    display as error "SKIP: Python not available."
    exit 222
}

do "cert_helpers.do"
quietly do "cert_svg.do"
qui do "../dash_parse.mata"
qui do "../dash.ado"
global dash_nobrowser 1

// ----------------------------------------------------------------
// Tally helpers -- test_wp29_truth.cscript's _w29_expect/_w29_done,
// renamed _w35_ for this script.  A case is any number of
// _w35_expect lines closed by one _w35_done.
// ----------------------------------------------------------------
global w35_nfail    = 0
global w35_faillist ""
global w35_bad      = 0
global w35_ncase    = 0

capture program drop _w35_expect
program define _w35_expect
    version 19
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global w35_bad = 1
    }
end

capture program drop _w35_done
program define _w35_done
    version 19
    args id msg
    if ${w35_bad} {
        global w35_nfail    = ${w35_nfail} + 1
        global w35_faillist "${w35_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global w35_bad   = 0
    global w35_ncase = ${w35_ncase} + 1
end

// A fresh directory for this run's files, never one that already exists:
// a fixed name in a shared temp directory could be planted by another
// account (rule 1), so a name Stata has not handed out before is made and
// the run fails if it cannot be.  Every block writes only under it.
tempfile w35_base
local w35_work "`w35_base'_w35"
capture mkdir "`w35_work'"
if _rc {
    display as error "test_wp35_truth: cannot create the work directory `w35_work' (rc `=_rc')"
    exit 9
}

// ---- parts: begin (WP-35 test performance) ----
// The certification suite runs this script in every one of its sessions
// (its row in run_all_cscripts.do's shard table is "* * *"); with
// DASH_CERT_SHARD=k/N set, the session runs part k of N of the blocks.
// The parts are balanced longest first onto the least loaded part (the
// lowest numbered of equals), by the seconds below -- a block not listed
// counts 1 s (section-01 D-01.f) -- the rule scripts/cert_shards.py uses
// for the scripts.  Unset, or with WP35_ONLY set
// (which keeps its precedence), every block runs.  A block runs when its
// gate finds its id in w35_run.
// Seconds: each block's start/end lines in the WP's last measured
// certification run, rounded up, at least 1; a block not listed
// counts 1 s.
local w35_secs S00 1
local w35_sh : environment DASH_CERT_SHARD
mata: st_local("w35_ok", strofreal(st_local("w35_sh") == "" | ustrregexm(st_local("w35_sh"), "^[1-4]/[1-4]$")))
if !`w35_ok' {
    display as error "test_wp35_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 4"
    exit 198
}
local w35_k 1
local w35_N 1
if "`w35_sh'" != "" {
    local w35_k = real(substr("`w35_sh'", 1, 1))
    local w35_N = real(substr("`w35_sh'", 3, 1))
}
local w35_only : env WP35_ONLY
if `"`macval(w35_only)'"' != "" | `w35_N' == 1 {
    local w35_k 1
    local w35_N 1
}
if `w35_k' > `w35_N' {
    display as error "test_wp35_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 4"
    exit 198
}
capture confirm file "test_wp35_truth.cscript"
if _rc {
    display as error "test_wp35_truth: run it from test/, where it reads its own blocks"
    exit 601
}
capture mata: mata drop _w35_part()
mata:
// The ids of the blocks (their header lines, in file order), and those of
// part k of n: longest first onto the least loaded part.
void _w35_part(string scalar file, string scalar table, real scalar k,
               real scalar n)
{
    string colvector lines, ids
    string rowvector tok
    real colvector sec, o, at
    real rowvector load
    real scalar i, j, p, best
    string scalar run

    lines = cat(file)
    ids = J(0, 1, "")
    for (i = 1; i <= rows(lines); i++) {
        if (ustrregexm(lines[i], "^\* ==== (S[0-9]+) ")) {
            if (!anyof(ids, ustrregexs(1))) ids = ids \ ustrregexs(1)
        }
    }
    sec = J(rows(ids), 1, 1)
    tok = tokens(table)
    for (j = 1; j + 1 <= cols(tok); j = j + 2) {
        for (i = 1; i <= rows(ids); i++) {
            if (ids[i] == tok[j]) sec[i] = strtoreal(tok[j + 1])
        }
    }
    o = order((-sec, (1::rows(ids))), (1, 2))
    load = J(1, n, 0)
    at = J(rows(ids), 1, 0)
    for (i = 1; i <= rows(o); i++) {
        best = 1
        for (p = 2; p <= n; p++) if (load[p] < load[best]) best = p
        load[best] = load[best] + sec[o[i]]
        at[o[i]] = best
    }
    run = ""
    for (i = 1; i <= rows(ids); i++) if (at[i] == k) run = run + " " + ids[i]
    st_local("w35_run", strtrim(run))
}
end
mata: _w35_part("test_wp35_truth.cscript", st_local("w35_secs"), `w35_k', `w35_N')
display as text "test_wp35_truth: part `w35_k'/`w35_N' runs `: word count `w35_run'' blocks: `w35_run'"
// ---- parts: end ----

* ==== S00 scaffold: the helpers load and a twoway SVG is read ====
local only : env WP35_ONLY
if inlist("`only'", "", "S00") & `: list posof "S00" in w35_run' {
    display as text "S00 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3500-1: cert_svg_export and cert_svg_texts on one twoway scatter,
    // and dash's own programs are loaded from this tree.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(w35s01, replace)
    cert_svg_export, name(w35s01) file("`w35_work'/w35s01.svg")
    local s01_rc   = r(rc)
    local s01_file "`r(file)'"
    _w35_expect Q3500-1 "(`s01_rc' == 0)" "cert_svg_export rc `s01_rc'"
    capture confirm file "`s01_file'"
    _w35_expect Q3500-1 "(_rc == 0)" "r(file) `s01_file' does not exist"
    cert_svg_texts, file("`s01_file'")
    local s01_n    = r(n)
    local s01_list "`r(list)'"
    _w35_expect Q3500-1 "(`s01_n' > 0)" "cert_svg_texts found no text elements"
    capture program list _dash_serve
    _w35_expect Q3500-1 "(_rc == 0)" "dash.ado's _dash_serve is not loaded"
    _w35_done Q3500-1 "a twoway SVG was written and read (`s01_n' texts); dash is loaded"

    capture erase "`s01_file'"
    capture erase "`s01_list'"
    capture graph drop w35s01
    display as text "S00 end " c(current_date) " " c(current_time)
}
* ==== end S00 ====

// ----------------------------------------------------------------
// S01 helpers (WP-35 MS-1).  _s01_pair id work R E: R is a command with
// an option given twice, E the same command with only its last copy
// (twoway syntax without the leading "twoway").  twoway must draw R and E
// alike (equal SVG text, ids aside; a pair twoway draws differently is a wrong
// probe), and dash must take both, register one spec for both, and name
// nothing as unsupported.
// _s01_first work cmd: runs cmd under a log of its own and returns its
// rc in r(rc) and the first line it printed in r(line).
// ----------------------------------------------------------------
capture program drop _s01_pair
program define _s01_pair
    version 19
    args id work R E
    foreach w in R E {
        capture graph drop _all
        capture twoway ``w''
        local trc_`w' = _rc
        mata: _s01_svg_`w' = J(0, 1, "")
        if !`trc_`w'' {
            capture erase "`work'/s01_`w'.svg"
            quietly graph export "`work'/s01_`w'.svg", replace as(svg)
            mata: _s01_svg_`w' = _s01_svg(st_local("work") + "/s01_`w'.svg")
            capture erase "`work'/s01_`w'.svg"
        }
    }
    capture graph drop _all
    mata: st_local("tsame", strofreal(_s01_svg_same(_s01_svg_R, _s01_svg_E)))
    capture mata: mata drop _s01_svg_R _s01_svg_E
    _w35_expect `id' "(`trc_R' == 0 & `trc_E' == 0)" ///
        `"twoway refused the pair (rc `trc_R', `trc_E'): `R'"'
    _w35_expect `id' "(`tsame' == 1)" ///
        `"wrong pair: twoway draws R and E differently: `R'"'
    capture dash clear
    capture log close s01log
    capture erase "`work'/s01_dash.log"
    quietly log using "`work'/s01_dash.log", text replace name(s01log) nomsg
    capture noisily dash `R' name(s01g)
    local drc_R = _rc
    mata: _s01_json = st_global("dash_json_s01g")
    capture dash clear
    capture noisily dash `E' name(s01g)
    local drc_E = _rc
    quietly log close s01log
    mata: st_local("same", strofreal(_s01_json == st_global("dash_json_s01g") & _s01_json != ""))
    capture dash clear
    capture mata: mata drop _s01_json
    _w35_expect `id' "(`drc_R' == 0)" `"dash refused (rc `drc_R'): `R'"'
    _w35_expect `id' "(`drc_E' == 0)" `"dash refused (rc `drc_E'): `E'"'
    _w35_expect `id' "(`same' == 1)" `"dash registered another spec for: `R'"'
    cert_log_has "`work'/s01_dash.log", needle("ignoring unsupported")
    _w35_expect `id' "(r(found) == 0)" `"dash named an option unsupported: `R'"'
    capture erase "`work'/s01_dash.log"
end

capture program drop _s01_first
program define _s01_first, rclass
    version 19
    args work cmd
    capture log close s01log
    capture erase "`work'/s01_first.log"
    quietly log using "`work'/s01_first.log", text replace name(s01log) nomsg
    capture noisily `cmd'
    local rc = _rc
    quietly log close s01log
    mata: st_local("line", _s01_first_line(st_local("work") + "/s01_first.log"))
    capture erase "`work'/s01_first.log"
    capture graph drop _all
    capture dash clear
    return scalar rc = `rc'
    return local line `"`macval(line)'"'
end

capture mata: mata drop _s01_first_line()
capture mata: mata drop _s01_svg()
capture mata: mata drop _s01_svg_same()
mata:
// An SVG's text with the clip-path ids Stata draws at random each export
// (path_<8 letters>, clipPath_<8 letters>) written as one id, so two
// exports of one drawing compare equal.
string colvector _s01_svg(string scalar file)
{
    string colvector l
    real scalar i
    l = cat(file)
    for (i = 1; i <= rows(l); i++) {
        l[i] = ustrregexra(ustrregexra(l[i], "path_[A-Za-z]{8}", "path_X"),
                           "Path_[A-Za-z]{8}", "Path_X")
    }
    return(l)
}

// 1 when two SVGs' lines (from _s01_svg) are the same, and not empty.
real scalar _s01_svg_same(string colvector a, string colvector b)
{
    if (rows(a) == 0 | rows(a) != rows(b)) return(0)
    return(all(a :== b))
}

// The first non-blank line of a log, trimmed.
string scalar _s01_first_line(string scalar file)
{
    string colvector l
    real scalar i
    l = cat(file)
    for (i = 1; i <= rows(l); i++) if (strtrim(l[i]) != "") return(strtrim(l[i]))
    return("")
}
end

* ==== S01 MS-1: repeated options taken rightmost ====
local only : env WP35_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w35_run' {
    display as text "S01 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3501-1: yvarlabel(), xvarlabel(), mlabprefix(), mlabsuffix(),
    // lalign(), mlabstyle() given twice draw their last copy, as twoway
    // draws it (yvarl() is yvarlabel()).
    // ------------------------------------------------------------
    sysuse auto, clear
    // Sorted by weight and mpg once, so line draws ties in one order: the
    // sort option leaves the order of equal weights to chance.
    sort weight mpg
    _s01_pair Q3501-1 "`w35_work'" `"scatter mpg weight, yvarlabel("Q") yvarlabel("R")"' `"scatter mpg weight, yvarlabel("R")"'
    _s01_pair Q3501-1 "`w35_work'" `"scatter mpg weight, xvarlabel("Q") xvarlabel("R")"' `"scatter mpg weight, xvarlabel("R")"'
    _s01_pair Q3501-1 "`w35_work'" `"scatter mpg weight, mlabel(make) mlabprefix("[") mlabprefix("<")"' `"scatter mpg weight, mlabel(make) mlabprefix("<")"'
    _s01_pair Q3501-1 "`w35_work'" `"scatter mpg weight, mlabel(make) mlabsuffix("]") mlabsuffix(">")"' `"scatter mpg weight, mlabel(make) mlabsuffix(">")"'
    _s01_pair Q3501-1 "`w35_work'" `"line mpg weight, lalign(inside) lalign(center)"' `"line mpg weight, lalign(center)"'
    _s01_pair Q3501-1 "`w35_work'" `"scatter mpg weight, mlabel(make) mlabstyle(p1) mlabstyle(p2)"' `"scatter mpg weight, mlabel(make) mlabstyle(p2)"'
    _s01_pair Q3501-1 "`w35_work'" `"scatter mpg weight, yvarlabel("Q") yvarl("R")"' `"scatter mpg weight, yvarlabel("R")"'
    _w35_done Q3501-1 "seven repeated label options drawn as their last copy, as twoway draws them"

    // ------------------------------------------------------------
    // Q3501-2: contour's valued options given twice draw their last
    // copy (twoway_zyx2view_parse.class: _parse combop ... rightmost).
    // ------------------------------------------------------------
    sysuse sandstone, clear
    local c "contour depth northing easting"
    local cl "contourline depth northing easting"
    _s01_pair Q3501-2 "`w35_work'" `"`c', levels(5) levels(6)"' `"`c', levels(6)"'
    _s01_pair Q3501-2 "`w35_work'" `"`c', ccuts(7600 7800) ccuts(7500 7700 7900)"' `"`c', ccuts(7500 7700 7900)"'
    _s01_pair Q3501-2 "`w35_work'" `"`c', scolor(red) scolor(blue)"' `"`c', scolor(blue)"'
    _s01_pair Q3501-2 "`w35_work'" `"`c', ecolor(red) ecolor(green)"' `"`c', ecolor(green)"'
    _s01_pair Q3501-2 "`w35_work'" `"`c', crule(hue) crule(linear)"' `"`c', crule(linear)"'
    _s01_pair Q3501-2 "`w35_work'" `"`c', interp(none) interp(thinplatespline)"' `"`c', interp(thinplatespline)"'
    _s01_pair Q3501-2 "`w35_work'" `"`c', levels(3) ccolors(red green blue yellow) ccolors(navy maroon olive teal)"' `"`c', levels(3) ccolors(navy maroon olive teal)"'
    _s01_pair Q3501-2 "`w35_work'" `"`c', format(%9.0f) format(%9.2f)"' `"`c', format(%9.2f)"'
    _s01_pair Q3501-2 "`w35_work'" `"`cl', clwidths(thin) clwidths(thick)"' `"`cl', clwidths(thick)"'
    _s01_pair Q3501-2 "`w35_work'" `"`cl', clpatterns(dash) clpatterns(solid)"' `"`cl', clpatterns(solid)"'
    _s01_pair Q3501-2 "`w35_work'" `"`cl', ccuts(7600 7800) clabels("a" "b" "c") clabels("x" "y" "z")"' `"`cl', ccuts(7600 7800) clabels("x" "y" "z")"'
    _w35_done Q3501-2 "eleven repeated contour options drawn as their last copy, as twoway draws them"

    // ------------------------------------------------------------
    // Q3501-3: a contour flag given twice is refused, with twoway's
    // return code and first line.
    // ------------------------------------------------------------
    foreach f in "`c', minmax minmax" "`c', reversekey reversekey" "`c', heatmap heatmap" "`c', outlines outlines" "`cl', colorlines colorlines" {
        _s01_first "`w35_work'" `"twoway `f'"'
        local trc = r(rc)
        local tln `"`r(line)'"'
        _s01_first "`w35_work'" `"dash `f' name(s01g)"'
        local drc = r(rc)
        local dln `"`r(line)'"'
        _w35_expect Q3501-3 "(`trc' != 0)" `"twoway took `f'"'
        _w35_expect Q3501-3 "(`drc' == `trc')" `"`f': dash rc `drc', twoway rc `trc'"'
        mata: st_local("same", strofreal(st_local("dln") == st_local("tln")))
        _w35_expect Q3501-3 "(`same' == 1)" `"`f': dash said [`dln'], twoway said [`tln']"'
    }
    _w35_done Q3501-3 "five repeated contour flags refused as twoway refuses them"

    sysuse auto, clear
    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====

* ==== append new blocks above this line ====

// ----------------------------------------------------------------
// Summary (test_wp29_truth.cscript's shape)
// ----------------------------------------------------------------
capture graph drop _all
capture dash clear
capture rmdir "`w35_work'"
local nfail    = ${w35_nfail}
local faillist "${w35_faillist}"
local ncase    = ${w35_ncase}
local only : env WP35_ONLY
macro drop w35_nfail w35_faillist w35_bad w35_ncase
display as text ""
display as text "============================================================"
if `ncase' == 0 {
    if `w35_N' > 1 & `"`macval(only)'"' == "" & "`w35_run'" == "" {
        display as text "test_wp35_truth: part `w35_k'/`w35_N' has no block to run"
        display as text "============================================================"
        exit 0
    }
    // A WP35_ONLY that names no block, or only a stub, ran nothing:
    // that is not a pass.
    display as error "  test_wp35_truth: no case ran (WP35_ONLY=`only')"
    display as text "============================================================"
    exit 9
}
else if `nfail' == 0 {
    display as text "  test_wp35_truth: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_wp35_truth: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
