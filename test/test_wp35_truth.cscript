// _q3509_axes <page or app> <kind>: every axis and grid model of a saved
// page (kind "page") or of the document a served app builds (kind "app")
// is hidden, and a title T is drawn; the problems go to global q3509_bad.
python:
def _q3509_walk(obj, out):
    if isinstance(obj, dict):
        if obj.get("type") == "object" and isinstance(obj.get("name"), str):
            out.append(obj)
        for v in obj.values():
            _q3509_walk(v, out)
    # Flipped (WP-41 41-05, DECISIONS D66): lists alone was wrong once the
    # width scale's callback, a map whose entries Document.to_json gives
    # as tuples, is where a figure's title and axes are first written.
    elif isinstance(obj, (list, tuple)):
        for v in obj:
            _q3509_walk(v, out)


def _q3509_axes(path, kind):
    import json, re
    from sfi import Macro
    bad = []
    try:
        if kind == "page":
            text = open(path, encoding="utf-8").read()
            docs = [json.loads(m) for m in re.findall(
                r'<script type="application/json"[^>]*>\s*(.*?)\s*</script>',
                text, re.S)]
        else:
            from bokeh.document import Document
            from bokeh.io.doc import patch_curdoc
            ns = {"__name__": "_q3509_app", "_DASH_TRIAL": True}
            doc = Document()
            with patch_curdoc(doc):
                exec(compile(open(path, encoding="utf-8").read(), path,
                             "exec"), ns)
            docs = [doc.to_json()]
        objs = []
        _q3509_walk(docs, objs)
        axes = [o for o in objs if o["name"].endswith("Axis")]
        grids = [o for o in objs if o["name"] == "Grid"]
        if not axes or not grids:
            bad.append("%d axes, %d grids found" % (len(axes), len(grids)))
        for o in axes + grids:
            if (o.get("attributes") or {}).get("visible", True) is not False:
                bad.append("%s %s visible" % (o["name"], o.get("id")))
        titles = [o for o in objs if o["name"] == "Title"
                  and (o.get("attributes") or {}).get("text") == "T"]
        if not titles:
            bad.append("no title T")
    except Exception as e:
        bad.append(repr(e)[:200])
    Macro.setGlobal("q3509_bad", "; ".join(bad)[:400])


def _q3509_forms(prefix):
    """The rc-0 keys of command_grammar_truth.json under prefix, into
    global q3509_keys."""
    import json
    from sfi import Macro
    t = json.load(open("fixtures/command_grammar_truth.json",
                       encoding="utf-8"))
    Macro.setGlobal("q3509_keys", " ".join(
        k for k in sorted(t) if k.startswith(prefix) and t[k]["rc"] == 0))


def _q3509_drawn(key, name):
    """dash's command for a fixture key, into global q3509_cmd; then, when
    name is given, its registered plots against twoway's (count, and line
    or scatter by twoway's style name), the problem into q3509_bad."""
    import json
    from sfi import Macro
    row = json.load(open("fixtures/command_grammar_truth.json",
                         encoding="utf-8"))[key]
    cmd = "dash" + row["cmd"][len("twoway"):]
    Macro.setGlobal("q3509_cmd", cmd + (" name(q3509g)" if "," in cmd
                                        else ", name(q3509g)"))
    if not name:
        return
    want = ["line" if p.endswith("line") else "scatter" for p in row["plots"]]
    try:
        got = [p["type"] for p in json.loads(
            Macro.getGlobal("dash_json_" + name))["plots"]]
    except Exception as e:
        got = [repr(e)[:80]]
    Macro.setGlobal("q3509_bad", "" if got == want else
                    "%s: dash %s, twoway %s" % (key, got, want))


def _q3509_glyphs(path, out):
    """The glyph kinds a saved page's renderers draw, sorted, into global
    out (a one-line page: the forms of Q3509-8 take no option)."""
    import json, re
    from sfi import Macro
    try:
        text = open(path, encoding="utf-8").read()
        docs = [json.loads(m) for m in re.findall(
            r'<script type="application/json"[^>]*>\s*(.*?)\s*</script>',
            text, re.S)]
        objs = []
        _q3509_walk(docs, objs)
        kinds = []
        for o in objs:
            if o["name"] == "GlyphRenderer":
                g = (o.get("attributes") or {}).get("glyph") or {}
                kinds.append(g.get("name", "?"))
        Macro.setGlobal(out, " ".join(sorted(kinds)))
    except Exception as e:
        Macro.setGlobal(out, "error " + repr(e)[:100])
end

// ----------------------------------------------------------------
// Section 35-04's helper: _s04_take key sets the locals s04_cmd (the
// fixture's twoway command without its first word), s04_rc and s04_msg
// (twoway's rc and first line) from test/fixtures/stat_refusal_truth.json.
// ----------------------------------------------------------------
python:
def _s04_take(key):
    import json
    from sfi import Macro
    r = json.load(open("fixtures/stat_refusal_truth.json",
                       encoding="utf-8"))[key]
    c = r["cmd"].strip()
    Macro.setLocal("s04_cmd", c[len("twoway "):] if c.startswith("twoway ") else c)
    Macro.setLocal("s04_rc", str(r["rc"]))
    Macro.setLocal("s04_msg", r["message"])
end

