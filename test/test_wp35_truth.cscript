if inlist("`only'", "", "S05") & `: list posof "S05" in w35_run' {
    display as text "S05 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3505-5 (WP-35 basic:PT-9): lpoly with n() above the rows in memory
    // prints twoway's note, once, as text (value_codes_truth.json
    // lpoly_n_100: "(n() set to 74)", rc 0); n(50) prints none.
    // ------------------------------------------------------------
    python: import json; from sfi import Macro; Macro.setLocal("s05note", json.load(open("fixtures/value_codes_truth.json", encoding="utf-8"))["probes"]["lpoly_n_100"]["first"])
    quietly sysuse auto, clear
    foreach s05t in lpoly lpolyci {
        foreach s05n in 100 50 {
            capture dash clear
            capture log close s05log
