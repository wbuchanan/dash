// ================================================================
// HC1-11 -- dash build's syntax
// ================================================================
dash clear
quietly dash scatter mpg weight, name(g11)
quietly dash kpi mean(mpg), title("M") name(k11)
local out11 "`c(tmpdir)'dash_hc1_11.html"
local py11  "`c(tmpdir)'dash_hc1_11.py"
capture erase "`out11'"
capture erase "`py11'"
capture noisily dash build, ti("T")
local rca = _rc
capture noisily dash build, sav("`out11'") ti("T") sub("S") lay(auto) link(_all) filter(foreign, type(dropdown) exclude(k11) label("F")) tabs(One: g11 / Two: k11) filterpos(left) theme(dark) nobr replace csv
local rcb = _rc
capture confirm file "`out11'"
local fb = _rc
capture noisily dash build, sav("`out11'") sch(s1mono) nobr
local rcc = _rc
capture noisily dash build, sav("`out11'") filterpos(middle) nobr replace
local rcd = _rc
capture noisily dash build, saving("`py11'") server replace
local rce = _rc
capture confirm file "`py11'"
local fe = _rc
capture {
    assert `rca' == 198
    assert `rcb' == 0 & `fb' == 0
    assert `rcc' == 198
    assert `rcd' == 198
    assert `rce' == 0 & `fe' == 0
}
