// ================================================================
// HC1-18 -- link(), filter(), layout(), theme() are dash's own
// ================================================================
local bad18 ""
foreach o in "link(g1)" "filter(foreign)" "layout(auto)" "theme(dark)" {
    graph drop _all
    capture twoway scatter mpg weight, `o' nodraw
    if _rc != 198 local bad18 `"`bad18' [twoway `o' `=_rc']"'
}
// ... and so are dash's subcommands: "kpi is not a twoway plot type".
foreach s in "kpi mean(mpg)" "build" "serve" "clear" {
    graph drop _all
    capture twoway `s', nodraw
    if _rc != 198 local bad18 `"`bad18' [twoway `s' `=_rc']"'
}
dash clear
quietly dash scatter mpg weight, name(g1)
local out18 "`c(tmpdir)'dash_hc1_18.html"
capture noisily dash build, saving("`out18'") link(g1) filter(foreign, type(dropdown)) layout(auto) theme(dark) nobrowser replace
if _rc local bad18 `"`bad18' [dash build `=_rc']"'
if `"`bad18'"' != "" {
    display as error `"HC1-18 FAIL:`bad18'"'
    local nfail = `nfail' + 1
    local faillist `"`faillist' HC1-18"'
}
else display as text "HC1-18 PASS: twoway refuses link(), filter(), layout(), theme() and dash's subcommands; dash build takes the options"
dash clear

// ================================================================
// HC1-19 -- no plot type: r(198) with the list; the five by name
// ================================================================
_hc_logged 19 dash zqnotaplottype mpg weight, name(hc19)
local rc = r(rc)
local lf "`r(logfile)'"
// The words of the message from "Supported:" to the next command line,
// read in Mata by value.
mata: _hc_supported(st_local("lf"))
local want19 scatter line connected area bar spike dropline dot scatteri pci ///
        pcarrowi rarea rbar rspike rcap rcapsym rscatter rline rconnected ///
        pcspike pccapsym pcarrow pcbarrow pcscatter tsline tsrline lfit qfit ///
        fpfit lfitci qfitci fpfitci lowess lpoly lpolyci mspline mband ///
        histogram kdensity function
local miss19 : list want19 - _hc_sup
local extra19 : list _hc_sup - want19
local miss19 "`miss19' `extra19'"
local miss19 = strtrim("`miss19'")
local bad19 ""
foreach t in contour contourline heatmap rpcap rpspike {
    local a "mpg weight turn"
    if inlist("`t'", "rpcap", "rpspike") local a "mpg lo hi weight"
    graph drop _all
    capture twoway `t' `a', nodraw
    local twrc = _rc
    dash clear
    _hc_logged 19b dash `t' `a', name(hc19)
    local drc = r(rc)
    cert_file_has "`r(logfile)'", needle("'`t'' is a twoway plot type dash does not draw")
    if `twrc' != 0 | `drc' != 198 | !r(found) local bad19 `"`bad19' [`t': twoway `twrc' dash `drc']"'
}
capture {
    assert `rc' == 198 & "`miss19'" == "" & `"`bad19'"' == ""
}
if _rc {
    display as error `"HC1-19 FAIL: rc=`rc' missing from the list:[`miss19'] undrawn:`bad19'"'
    local nfail = `nfail' + 1
    local faillist `"`faillist' HC1-19"'
}
else display as text "HC1-19 PASS: a word that is no plot type is r(198) with all 40 plot types listed; the five undrawn twoway types are refused by name"
dash clear

// ================================================================
// HC1-20 -- where a graph-level option is written, and which one wins
// ================================================================
// twoway's title, read from its saved .gph: the line
//   .insert (title = .sized_textbox.new, mtextq(`""ZQB""') style(scheme title) ...
// holds the title text; which of the ZQ tokens it holds is compared with
// the title dash registers for the same command.
capture mata: mata drop _hc_ztokens()
capture mata: mata drop _hc_gph_title()
mata:
// The ZQ tokens a title text holds, in a fixed order; read by value, so
// the text's quotes and backquotes are never Stata syntax.
string scalar _hc_ztokens(string scalar s)
{
    string scalar r
    real scalar   k
    string vector z
    z = ("ZQA", "ZQB", "ZQI", "ZQF")
    r = ""
    for (k = 1; k <= 4; k++) {
        if (strpos(s, z[k])) r = r + " " + z[k]
    }
    return(strtrim(r))
}
void _hc_gph_title(string scalar fn)
{
    real scalar   fh
    string scalar line, t
    fh = fopen(fn, "r")
    t = ""
    while ((line = fget(fh)) != J(0, 0, "")) {
        if (strpos(line, ".insert (title = .sized_textbox.new, mtextq(") == 1) {
            t = line
            break
        }
    }
    fclose(fh)
    st_local("twz", _hc_ztokens(t))
}
end
local g20 "`c(tmpdir)'dash_hc1_20.gph"
local bad20 ""
forvalues c = 1/5 {
    graph drop _all
    dash clear
    if `c' == 1 {
        twoway (scatter mpg weight, title("ZQA")) (line mpg weight, title("ZQB")), nodraw name(zhc20)
        quietly dash (scatter mpg weight, title("ZQA")) (line mpg weight, title("ZQB")), name(hc20)
        local want "ZQB"
    }
    if `c' == 2 {
        twoway (scatter mpg weight, title("ZQA")) (line mpg weight), nodraw name(zhc20)
        quietly dash (scatter mpg weight, title("ZQA")) (line mpg weight), name(hc20)
        local want "ZQA"
    }
    if `c' == 3 {
        twoway (scatter mpg weight, title("ZQI")) (line mpg weight), title("ZQF") nodraw name(zhc20)
        quietly dash (scatter mpg weight, title("ZQI")) (line mpg weight), title("ZQF") name(hc20)
        local want "ZQF"
    }
    if `c' == 4 {
        twoway (scatter mpg weight, title("ZQA")) (line mpg weight, title("")), nodraw name(zhc20)
        quietly dash (scatter mpg weight, title("ZQA")) (line mpg weight, title("")), name(hc20)
        local want ""
    }
    if `c' == 5 {
        twoway scatter mpg weight, title("ZQA") || line mpg weight, title("ZQB") nodraw name(zhc20)
        quietly dash scatter mpg weight, title("ZQA") || line mpg weight, title("ZQB") name(hc20)
        local want "ZQB"
    }
    graph save zhc20 "`g20'", replace
    local twz ""
    mata: _hc_gph_title(st_local("g20"))
    mata: _dash_json_get_str(st_global("dash_json_hc20"), "title", "_hc_dt")
    mata: st_local("dsz", _hc_ztokens(st_local("_hc_dt")))
    if "`twz'" != "`want'" | "`dsz'" != "`want'" {
        local bad20 `"`bad20' [case `c': twoway `twz' dash `dsz' want `want']"'
    }
}
graph drop _all
dash clear
if `"`bad20'"' != "" {
    display as error `"HC1-20 FAIL:`bad20'"'
    local nfail = `nfail' + 1
    local faillist `"`faillist' HC1-20"'
}
else display as text "HC1-20 PASS: a graph option inside a segment or after the comma, and which one wins, as twoway reads them"

// ================================================================
// HC1-21 -- adversarial, bypass: the qualifier reader cannot be walked
// past, nor handed text that is not a qualifier
// ================================================================
local bad21 ""
dash clear
// the keyword is lower case, as -syntax- and twoway read it
capture noisily dash (scatter mpg weight) IF foreign==1, name(hc21a)
if _rc != 198 local bad21 "`bad21' [IF rc=`=_rc']"
// qualifier words inside a quoted option are text, not a qualifier
capture noisily dash (scatter mpg weight, title("x) if foreign==1 (y")), name(hc21b)
local rcb = _rc
local gifb "unset"
local tb ""
if `rcb' == 0 {
    mata: _hc_graph_q("hc21b")
    mata: _dash_json_get_str(st_local("_hc_gtail"), "if_expr", "gifb")
    _hc_key hc21b title
    local tb `"`r(value)'"'
}
if `rcb' != 0 | `"`gifb'"' != "" | !strpos(`"`tb'"', "x) if foreign==1 (y") {
    local bad21 `"`bad21' [quoted: rc=`rcb' if=`gifb']"'
}
// a || inside a quoted string does not end the qualifier
capture noisily dash (scatter mpg weight) if make=="a || b", name(hc21c)
local rcc = _rc
local gifc ""
if `rcc' == 0 {
    mata: _hc_graph_q("hc21c")
    mata: _dash_json_get_str(st_local("_hc_gtail"), "if_expr", "gifc")
}
local wantc = `"make=="a || b""'
if `rcc' != 0 | `"`macval(gifc)'"' != `"`macval(wantc)'"' {
    local bad21 `"`bad21' [quoted ||: rc=`rcc']"'
}
// an unbalanced or unmatched parenthesis in it is refused, not drawn
capture noisily dash (scatter mpg weight) if (foreign==1, name(hc21d)
if _rc != 198 local bad21 "`bad21' [unbalanced rc=`=_rc']"
capture noisily dash (scatter mpg weight) if foreign==1), name(hc21e)
if _rc != 198 local bad21 "`bad21' [unmatched rc=`=_rc']"
local reg `"${dash_graph_registry}"'
if `"`reg'"' != "hc21b hc21c" local bad21 `"`bad21' [registry: `reg']"'
dash clear
if `"`bad21'"' != "" {
    display as error `"HC1-21 FAIL:`bad21'"'
    local nfail = `nfail' + 1
    local faillist `"`faillist' HC1-21"'
}
else display as text "HC1-21 PASS: IF, a quoted if, a quoted ||, and an unbalanced qualifier cannot pass as, or past, the graph's qualifier"

// ================================================================
// HC1-22 -- adversarial, injection: the qualifier reaches the page only
// through the renderer's whitelist, and Stata refuses code in it
// ================================================================
local bad22 ""
local out22 "`c(tmpdir)'dash_hc1_22.html"
capture erase "`out22'"
dash clear
capture noisily dash (scatter mpg weight) (line mpg weight) if make=="</script><script>alert(1)</script>", saving("`out22'")
local rca = _rc
capture confirm file "`out22'"
local fa = _rc
local raw = -1
if `fa' == 0 {
    cert_file_has "`out22'", needle("<script>alert(1)")
    local raw = r(found)
}
if `rca' != 0 | `fa' != 0 | `raw' != 0 {
    local bad22 "`bad22' [markup: rc=`rca' file=`fa' raw=`raw']"
}
// Python in the qualifier: -syntax- parses the expression and refuses the
// function, r(133), before anything reaches Python; nothing is run
capture erase "zq_hc22_pwned"
capture noisily dash (scatter mpg weight) (line mpg weight) if __import__("os").system("touch zq_hc22_pwned")==0, name(hc22b)
local rcb = _rc
capture confirm file "zq_hc22_pwned"
local fb = _rc
if `rcb' != 133 | `fb' == 0 | `"${dash_graph_registry}"' != "" {
    local bad22 "`bad22' [python: rc=`rcb' file=`fb']"
}
dash clear
if `"`bad22'"' != "" {
    display as error `"HC1-22 FAIL:`bad22'"'
    local nfail = `nfail' + 1
    local faillist `"`faillist' HC1-22"'
}
else display as text "HC1-22 PASS: markup in the qualifier never reaches the page raw, and code in it is refused before Python, r(133)"

// ================================================================
// HC1-23 -- adversarial, exhaustion: deep and long qualifiers are
// bounded
// ================================================================
local bad23 ""
local deep = 200*"(" + "foreign==1" + 200*")"
local terms = "foreign==1" + 500*" | foreign==1"
local out23 "`c(tmpdir)'dash_hc1_23.html"
capture erase "`out23'"
dash clear
timer clear 23
timer on 23
capture noisily dash (scatter mpg weight) (line mpg weight) if `deep', saving("`out23'")
local rca = _rc
capture noisily dash (scatter mpg weight) if `terms', name(hc23b)
local rcb = _rc
timer off 23
quietly timer list 23
local t23 = r(t23)
capture confirm file "`out23'"
local fa = _rc
if `rca' != 0 | `fa' != 0 | `rcb' != 130 | `t23' > 120 {
    local bad23 "`bad23' [deep rc=`rca' file=`fa'; long rc=`rcb'; `t23's]"
}
dash clear
if `"`bad23'"' != "" {
    display as error `"HC1-23 FAIL:`bad23'"'
    local nfail = `nfail' + 1
    local faillist `"`faillist' HC1-23"'
}
else display as text "HC1-23 PASS: a qualifier 200 parentheses deep draws, and one of 501 terms is r(130), in bounded time"

// ================================================================
// HC1-24 -- the sections render: no SMCL directive survives as text
// ================================================================
// Stata's own renderer, smcl2txt.  From the Title to the Option values
// item -- the sections this script certifies -- the text holds no brace:
// an unknown or broken directive is printed literally.  Measured at
// 4ede074: `{it:if}/{in} qualifiers' printed "if/{in} qualifiers" in the
// Description, {in} being no directive.
local txt24 "`c(tmpdir)'dash_hc1_24.txt"
capture erase "`txt24'"
quietly translate "../dash.sthlp" "`txt24'", translator(smcl2txt) replace
capture mata: mata drop _hc_rendered_braces()
mata:
void _hc_rendered_braces(string scalar fn)
{
    real scalar   fh, on, n
    string scalar line, bad
    fh = fopen(fn, "r")
    on = 0
    n = 0
    bad = ""
    while ((line = fget(fh)) != J(0, 0, "")) {
        if (!on & strtrim(line) == "Title") on = 1
        if (on & strpos(line, "Option values.  A value is refused")) break
        if (on) {
            n++
            if (strpos(line, "{") | strpos(line, "}")) {
                bad = bad + " [" + strtrim(line) + "]"
            }
        }
    }
    fclose(fh)
    st_local("_hc_rb", bad)
    st_local("_hc_rn", strofreal(n))
}
end
mata: _hc_rendered_braces(st_local("txt24"))
capture {
    assert `_hc_rn' > 200
    assert `"`macval(_hc_rb)'"' == ""
}
if _rc {
    display as error `"HC1-24 FAIL (`_hc_rn' lines):`macval(_hc_rb)'"'
    local nfail = `nfail' + 1
    local faillist `"`faillist' HC1-24"'
}
else display as text "HC1-24 PASS: the Title to Differences sections render with no directive left as text (`_hc_rn' lines)"

// ----------------------------------------------------------------
// Summary
// ----------------------------------------------------------------
display as text ""
display as text "============================================================"
if `nfail' == 0 {
    display as text "  test_help_claims_1: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_help_claims_1: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
