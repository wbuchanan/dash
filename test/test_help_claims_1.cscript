    display as error "HC1-12 FAIL: twoway left [`twmem'], dash left [`dmem'] in graph memory"
    local nfail = `nfail' + 1
    local faillist `"`faillist' HC1-12"'
}
else display as text "HC1-12 PASS: dash's name() registers the graph and leaves Stata's graph memory alone; twoway's stores it"
