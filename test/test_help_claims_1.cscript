local ksta `"${dash_kpi_k10__sta}"'
capture {
    assert `rca' == 0 & `rcb' == 198 & `rcc' == 198 & `rcd' == 0
    assert `"`ktit'"' == "T2" & `"`ksta'"' == "max"
    assert "${dash_graph_registry}" == "k10"
}
