local named = r(found)
_hc_key hc14b title
local t14b `"`r(value)'"'
capture {
    assert `rca' == 0 & `"`t14'"' == "zqT14"
    assert `rcb' == 0 & `named' == 1 & `"`t14b'"' == ""
}
if _rc {
    display as error `"HC1-14 FAIL: titl rc=`rca' title=[`t14']; titel rc=`rcb' named=`named' title=[`t14b']"'
    local nfail = `nfail' + 1
    local faillist `"`faillist' HC1-14"'
}
else display as text "HC1-14 PASS: titl() abbreviates title(); titel() is not an option and is named in the note"
