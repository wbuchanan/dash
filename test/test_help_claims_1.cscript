// ================================================================
// HC1-13 -- an unknown option is named without its value
// ================================================================
_hc_logged 13 dash scatter mpg weight, zqunknownopt(zq_secret_value_13) name(hc13)
local rc = r(rc)
local lf "`r(logfile)'"
cert_file_has "`lf'", needle("dash: ignoring unsupported option(s): zqunknownopt()")
local named = r(found)
cert_file_has "`lf'", needle("zq_secret_value_13)")
local echoed_cmd = r(found)
// the note line is the only place the name appears besides the command
// echo; the value must not be in any line that is not the echoed command
tempname fh
local leak 0
file open `fh' using "`lf'", read text
file read `fh' ln
while r(eof) == 0 {
    mata: st_local("_l13", strofreal(strpos(st_local("ln"), "zq_secret_value_13") > 0 & strpos(st_local("ln"), "dash scatter") == 0))
    if `_l13' local leak 1
    file read `fh' ln
}
file close `fh'
capture {
    assert `rc' == 0 & `named' == 1 & `leak' == 0
}
if _rc {
    display as error "HC1-13 FAIL: rc=`rc' named=`named' value shown outside the command=`leak'"
    local nfail = `nfail' + 1
    local faillist `"`faillist' HC1-13"'
}
else display as text "HC1-13 PASS: an unknown option is accepted and named in the note, without its value"
dash clear

