*! test_alias_semantics.cscript
*! Certification script: the bw() alias means what twoway means by it.
*!
*! ROADMAP WP-13 TR-13.4 / GAPS.md E4.  dash.ado folded bw() to barwidth()
*! unconditionally, before the plot type was known.  Measured (22sep2026,
*! this script's own twoway probes): twoway accepts bw() ONLY as an
*! abbreviation of bwidth(), and only on the bandwidth plot types -- lpoly,
*! lpolyci, lowess, kdensity (rc 0) -- and rejects it everywhere else with
*! r(198) "option bw() not allowed".  So
*!
*!     . dash (lpoly mpg weight, bw(400))
*!
*! wrote {"barwidth":"400"} into the spec, drew the rule-of-thumb bandwidth
*! and said nothing: a valid twoway command whose meaning changed silently.
*!
*! The contract certified here, per plot type, is measured against twoway
*! in the same run rather than written down:
*!
*!   AS-01  a bandwidth type (twoway rc 0):  dash records bwidth, not
*!          barwidth, and emits no note.
*!   AS-02  the bar family (twoway r(198)):  dash refuses it in twoway's
*!          words, r(198) "option bw() not allowed", and a second line says
*!          "use barwidth()" (P4-9).  Flipped (WP-35 stat:PT-14): dash's
*!          reading of bw() as barwidth() there was wrong because twoway
*!          refuses bw() off the bandwidth types (P4-7).
*!   AS-03  every other type (twoway r(198)):  dash refuses it in twoway's
*!          words, with no barwidth() line.  Flipped (WP-35 stat:PT-14):
*!          naming it in the note was wrong for the same reason.
*!   AS-04  bw() together with bwidth() on a bandwidth type is the repeated
*!          option twoway rejects; dash returns twoway's own rc.
*!   AS-05  the other short forms still land on their targets: t("top")
*!          records t1title, bins(5) records bin (bw(100) on bar, which
*!          recorded barwidth, is refused since WP-35 stat:PT-14: AS-02).
*!   AS-06  the side titles: every spelling of t1title() .. r2title(), and
*!          t(), b(), l() and r(), lands where twoway puts it at plot level,
*!          inside a plot's parentheses, after them and after ||; and a
*!          third spelling on one side is a second copy of *1title(), kept
*!          as twoway keeps it, never dropped; drawn, so never named in the
*!          note (flipped, WP-31 D2).
*!
*! No dashboard is rendered: every probe registers with name(), so the spec
*! JSON can be read back out of the registry global.
*!
*! Usage:  do test/test_alias_semantics.cscript   (or via run_all_cscripts.do)

cscript "dash alias semantics: bw() per plot type" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off
set graphics off

do "cert_helpers.do"
qui do "../dash_parse.mata"
qui do "../dash.ado"

global dash_nobrowser 1
sysuse auto, clear

local logfile "`c(tmpdir)'dash_alias_semantics.log"

// ----------------------------------------------------------------
// Helpers
// ----------------------------------------------------------------
capture mata: mata drop _zas_has()
mata:
// Does the registered spec for graph `g' carry the quoted key `key'?
real scalar _zas_has(string scalar g, string scalar key)
{
    string scalar js
    js = st_global("dash_json_" + g)
    return(strpos(js, char(34) + key + char(34) + ":") > 0)
}
end

capture program drop _zas_has
program define _zas_has, rclass
    args g key
    mata: st_local("_zh", strofreal(_zas_has(st_local("g"), st_local("key"))))
    return scalar found = `_zh'
end

// Run one dash command under a named log; return its rc and whether the
// log carries the ignoring note naming bw().
capture program drop _zas_probe
program define _zas_probe, rclass
    args cmdtext logpath
    capture log close _zaslog
    capture erase "`logpath'"
    capture dash clear
    log using "`logpath'", name(_zaslog) text replace
    capture noisily `cmdtext'
    local rc = _rc
    log close _zaslog
    cert_file_has "`logpath'", needle("ignoring unsupported")
    local nnote = r(found)
    cert_file_has "`logpath'", needle("bw()")
    local named = r(found)
    cert_file_has "`logpath'", needle("option bw() not allowed")
    local refused = r(found)
    cert_file_has "`logpath'", needle("use barwidth()")
    local hint = r(found)
    return scalar rc    = `rc'
    return scalar nnote = `nnote'
    return scalar named = `named'
    return scalar refused = `refused'
    return scalar hint  = `hint'
end

local nfail = 0
local faillist ""

// ----------------------------------------------------------------
// The probe table: type | varlist | bw value.  twoway is asked first,
// in this run, so the expectation is measured rather than assumed.
// ----------------------------------------------------------------
local types  "lpoly lpolyci lowess kdensity bar rbar histogram dot spike scatter line fpfit"
local vars_lpoly     "mpg weight"
local vars_lpolyci   "mpg weight"
local vars_lowess    "mpg weight"
local vars_kdensity  "mpg"
local vars_bar       "mpg weight"
local vars_rbar      "mpg price weight"
local vars_histogram "mpg"
local vars_dot       "mpg weight"
local vars_spike     "mpg weight"
local vars_scatter   "mpg weight"
local vars_line      "mpg weight"
local vars_fpfit     "mpg weight"
local bw_lpoly     400
local bw_lpolyci   400
local bw_lowess    0.3
local bw_kdensity  2
local bw_bar       100
local bw_rbar      100
local bw_histogram 2
local bw_dot       100
local bw_spike     100
local bw_scatter   100
local bw_line      100
local bw_fpfit     400
local barfamily "bar rbar histogram dot spike"

foreach t of local types {
    local v  `vars_`t''
    local bw `bw_`t''
    capture twoway `t' `v', bw(`bw')
    local tw_rc = _rc
    _zas_probe `"dash (`t' `v', bw(`bw')), name(zqas)"' "`logfile'"
    local drc    = r(rc)
    local nnote  = r(nnote)
    local named  = r(named)
    local refused = r(refused)
    local hint   = r(hint)
    _zas_has zqas bwidth
    local has_bwidth = r(found)
    _zas_has zqas barwidth
    local has_barwidth = r(found)

    local bad = 0
    if `drc' != `tw_rc' {
        display as error "AS FAIL `t': dash rc=`drc', twoway rc=`tw_rc'"
        local bad = 1
    }
    else if `tw_rc' == 0 {
        // AS-01: twoway takes bw() here as bwidth().
        if `has_bwidth' != 1 | `has_barwidth' != 0 | `nnote' != 0 {
            display as error "AS-01 FAIL `t': twoway rc 0 (bw means bwidth) but dash recorded bwidth=`has_bwidth' barwidth=`has_barwidth' note=`nnote'"
            local bad = 1
        }
        else display as text "AS-01 PASS `t': bw(`bw') is bwidth, no note"
    }
    else if `: list t in barfamily' {
        // AS-02: twoway rejects bw() on the bar family; so does dash, in
        // its words, and names barwidth() on a second line (P4-9).
        if `refused' != 1 | `hint' != 1 | `nnote' != 0 {
            display as error "AS-02 FAIL `t': twoway r(`tw_rc'); dash refused=`refused' hint=`hint' note=`nnote'"
            local bad = 1
        }
        else display as text "AS-02 PASS `t': bw(`bw') refused, use barwidth() named"
    }
    else {
        // AS-03: twoway rejects it; so does dash, with no barwidth() line.
        if `refused' != 1 | `hint' != 0 | `nnote' != 0 {
            display as error "AS-03 FAIL `t': twoway r(`tw_rc'); dash refused=`refused' hint=`hint' note=`nnote'"
            local bad = 1
        }
        else display as text "AS-03 PASS `t': bw(`bw') refused in twoway's words"
    }
    if `bad' {
        local nfail = `nfail' + 1
        local faillist "`faillist' AS(`t')"
    }
}

// ----------------------------------------------------------------
// AS-04 -- bw() and bwidth() together on a bandwidth type: twoway's own rc.
// ----------------------------------------------------------------
capture twoway lpoly mpg weight, bw(400) bwidth(500)
local tw_rc = _rc
_zas_probe `"dash (lpoly mpg weight, bw(400) bwidth(500)), name(zqas)"' "`logfile'"
if r(rc) != `tw_rc' {
    display as error "AS-04 FAIL: twoway r(`tw_rc') for bw() with bwidth(); dash rc=`r(rc)'"
    local nfail = `nfail' + 1
    local faillist "`faillist' AS-04"
}
else display as text "AS-04 PASS: bw() with bwidth() gives twoway's rc `tw_rc'"

// ----------------------------------------------------------------
// AS-05 -- the other short forms are unchanged.  t() is T1title()'s own
// minimum abbreviation, no longer a fold (AS-06); bins() is.  Flipped
// (WP-35 stat:PT-14): bar bw(100) recording barwidth was wrong because
// twoway refuses bw() off the bandwidth types (P4-7); AS-02 pins the
// refusal.
// ----------------------------------------------------------------
local bad = 0
_zas_probe `"dash scatter mpg weight, t("top") name(zqas)"' "`logfile'"
_zas_has zqas t1title
if r(found) != 1 {
    display as error "AS-05 FAIL: t(\"top\") did not record t1title"
    local bad = 1
}
_zas_probe `"dash histogram mpg, bins(5) name(zqas)"' "`logfile'"
_zas_has zqas bin
if r(found) != 1 {
    display as error "AS-05 FAIL: bins(5) did not record bin"
    local bad = 1
}
if `bad' {
    local nfail = `nfail' + 1
    local faillist "`faillist' AS-05"
}
else display as text "AS-05 PASS: t() and bins() still land on their targets"

// ----------------------------------------------------------------
// AS-06 -- the side titles.  t(), b(), l(), r() and every spelling of
// t1title() .. r2title(), at plot level, inside a plot's parentheses,
// after them (graph level) and after ||.  twoway is asked first, in this
// run: each spelling is saved to a live-format .gph and read back, so the
// key it must land on is measured, not assumed.
//
// WP-23 TR-23.6 removed T(), B(), L() and R() from _dash_parse_graph_opts,
// with the fold that copied them into t1title() .. r1title().  A digit ends
// -syntax-'s run of capitals, so T1title()'s minimum is t: t() was always
// T1title()'s, at every level, and nothing here may change without them.
// What they did do was swallow a THIRD t() written after t1title() and
// t2title(): the fold dropped it, and at graph level the note never named
// it, where every other level did.  AS-06b holds all four levels to naming
// it.
// ----------------------------------------------------------------
capture mata: mata drop _zas_val()
capture mata: mata drop _zas_gphbox()
mata:
// The value recorded under the quoted key `key' in graph `g''s spec, or
// <none>.  The probe values here carry no quote or backslash.
string scalar _zas_val(string scalar g, string scalar key)
{
    string scalar js, pat, rest
    real scalar p, e
    js  = st_global("dash_json_" + g)
    pat = char(34) + key + char(34) + ":" + char(34)
    p   = strpos(js, pat)
    if (p == 0) return("<none>")
    rest = substr(js, p + strlen(pat), .)
    e = strpos(rest, char(34))
    return(e ? substr(rest, 1, e - 1) : "<none>")
}

// Does the live-format .gph at `path' insert the text box `key' holding
// the text ZQV?  twoway inserts every title box, empty or not, so the box
// alone says nothing: the line that creates it must carry the value.
real scalar _zas_gphbox(string scalar path, string scalar key)
{
    real scalar fh, found
    string scalar ln, head
    fh = _fopen(path, "r")
    if (fh < 0) return(-1)
    head  = "(" + key + " = .sized_textbox.new"
    found = 0
    while ((ln = fget(fh)) != J(0, 0, "")) {
        if (strpos(ln, head) & strpos(ln, "ZQV")) {
            found = 1
            break
        }
    }
    fclose(fh)
    return(found)
}
end

// Run one dash command under a named log; return its rc and whether the
// log's note names `needle'.
capture program drop _zas_note
program define _zas_note, rclass
    args cmdtext logpath needle
    capture log close _zaslog
    capture erase "`logpath'"
    capture dash clear
    log using "`logpath'", name(_zaslog) text replace
    capture noisily `cmdtext'
    local rc = _rc
    log close _zaslog
    cert_file_has "`logpath'", needle("ignoring unsupported")
    local nnote = r(found)
    cert_file_has "`logpath'", needle("`needle'")
    return scalar rc    = `rc'
    return scalar nnote = `nnote'
    return scalar named = r(found)
end

local gphfile "`c(tmpdir)'dash_alias_semantics.gph"
local levels "P Q G V"
local n06 = 0
local bad06 = 0
foreach s in t b l r {
    foreach k in 1 2 {
        local key "`s'`k'title"
        local sib = cond(`k' == 1, "`s'2title", "`s'1title")
        // The single letter is t1title()'s (twoway's measured minimum);
        // t2title() starts at t2.
        local ladder = cond(`k' == 1, "`s'", "")
        forvalues L = 2/7 {
            local ladder "`ladder' `=substr("`key'", 1, `L')'"
        }
        foreach sp of local ladder {
            local n06 = `n06' + 1
            // twoway first: the value lands in the text box named after
            // the option the spelling resolved to.
            capture erase "`gphfile'"
            capture twoway scatter mpg weight, `sp'(ZQV) nodraw saving("`gphfile'", replace)
            local tw_rc = _rc
            local tw_key = 0
            local tw_sib = 1
            if `tw_rc' == 0 {
                mata: st_local("tw_key", strofreal(_zas_gphbox(st_local("gphfile"), st_local("key"))))
                mata: st_local("tw_sib", strofreal(_zas_gphbox(st_local("gphfile"), st_local("sib"))))
            }
            if `tw_rc' != 0 | `tw_key' != 1 | `tw_sib' != 0 {
                display as error "AS-06 FAIL `sp'(): twoway rc=`tw_rc', `key' box=`tw_key', `sib' box=`tw_sib' -- the expectation below is wrong"
                local bad06 = `bad06' + 1
                continue
            }
            foreach lev of local levels {
                if "`lev'" == "P" local c `"dash scatter mpg weight, `sp'(ZQV) name(zqas)"'
                if "`lev'" == "Q" local c `"dash (scatter mpg weight, `sp'(ZQV)), name(zqas)"'
                if "`lev'" == "G" local c `"dash (scatter mpg weight), `sp'(ZQV) name(zqas)"'
                if "`lev'" == "V" local c `"dash scatter mpg weight || line mpg weight, `sp'(ZQV) name(zqas)"'
                _zas_note `"`c'"' "`logfile'" " `key'()"
                local drc   = r(rc)
                local named = r(named)
                mata: st_local("v_key", _zas_val("zqas", "`key'"))
                mata: st_local("v_sib", _zas_val("zqas", "`sib'"))
                // Flipped (WP-31 D2): `named' != 1 -- the note naming
                // the side title -- was wrong because dash draws it now,
                // as twoway does (edge_title_truth.json): never named.
                if `drc' != 0 | "`v_key'" != "ZQV" | "`v_sib'" != "<none>" | `named' != 0 {
                    display as error "AS-06 FAIL `lev' `sp'(): rc=`drc' `key'=[`v_key'] `sib'=[`v_sib'] note names `key'()=`named'"
                    local bad06 = `bad06' + 1
                }
            }
        }
    }
    // AS-06b: a third spelling on the same side, after the *1title() and
    // *2title() are filled, is a second copy of *1title(): twoway draws
    // its text as the *1title (measured here from the .gph; [G-4] repeated
    // options, the rightmost copy of a title).  dash keeps it there too
    // (test_twoway_option_parity.cscript TP-14) -- it had named it in the
    // note as an option of its own -- and names *1title() in the note, so
    // nothing is dropped in silence, at every level.
    local o `"`s'1title(ZQA) `s'2title(ZQB) `s'(ZQV)"'
    capture erase "`gphfile'"
    capture twoway scatter mpg weight, `o' nodraw saving("`gphfile'", replace)
    local tw_rc = _rc
    mata: st_local("tw_key", strofreal(_zas_gphbox(st_local("gphfile"), "`s'1title")))
    if `tw_rc' != 0 | `tw_key' != 1 {
        display as error "AS-06b FAIL `o': twoway rc=`tw_rc', `s'1title box holds ZQV=`tw_key' -- the expectation below is wrong"
        local bad06 = `bad06' + 1
    }
    foreach lev of local levels {
        if "`lev'" == "P" local c `"dash scatter mpg weight, `o' name(zqas)"'
        if "`lev'" == "Q" local c `"dash (scatter mpg weight, `o'), name(zqas)"'
        if "`lev'" == "G" local c `"dash (scatter mpg weight), `o' name(zqas)"'
        if "`lev'" == "V" local c `"dash scatter mpg weight || line mpg weight, `o' name(zqas)"'
        _zas_note `"`c'"' "`logfile'" " `s'1title()"
        local drc = r(rc)
        local named = r(named)
        mata: st_local("v_1", _zas_val("zqas", "`s'1title"))
        mata: st_local("v_2", _zas_val("zqas", "`s'2title"))
        // Flipped (WP-31 D2): drawn now, so not named.
        if `drc' != 0 | `named' != 0 | "`v_1'" != "ZQV" | "`v_2'" != "ZQB" {
            display as error "AS-06b FAIL `lev' `o': rc=`drc', `s'1title=[`v_1'] `s'2title=[`v_2'], the note names `s'1title()=`named'"
            local bad06 = `bad06' + 1
        }
    }
}
capture erase "`gphfile'"
if `bad06' {
    display as error "AS-06 FAIL: `bad06' check(s) over `n06' spellings at `: word count `levels'' levels"
    local nfail = `nfail' + 1
    local faillist "`faillist' AS-06"
}
else display as text "AS-06 PASS: `n06' side-title spellings land where twoway puts them at every level, and a third one is kept as the 1 title"

// ----------------------------------------------------------------
// Summary
// ----------------------------------------------------------------
capture dash clear
capture erase "`logfile'"
display as text ""
display as text "============================================================"
if `nfail' == 0 {
    display as text "  test_alias_semantics: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_alias_semantics: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
