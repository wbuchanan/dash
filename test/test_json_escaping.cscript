local jg_tk "`jg_tk'`r(ok)'"
_jg_stored jg46k "graph_options xtitle2"
local jg_tk "`jg_tk'`r(ok)'"
mata: st_global("JG_WANT", _jg_pq(char(39) + "90s x"))
_jg_stored jg46j "graph_options xtitle"
local jg_tk "`jg_tk'`r(ok)'"
mata: st_global("JG_WANT", _jg_cq(char(39) + "90s y"))
