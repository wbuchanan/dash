// ----------------------------------------------------------------
// JSE-46 -- the other texts a title shares its path with: subtitle(),
// note(), caption() and a legend label, in comma mode and after a paren
// command's comma; by()'s title(); text(), at() and options dash does not
// know, which it keeps and names; an alias folded onto its option; and the
// axis and side titles, xtitle() .. ytitle2() and t1title() .. r2title()
// ----------------------------------------------------------------
// Each text is its own, so each count names one option in one form.  A
// compound-quoted legend label is drawn as twoway's exported SVG draws it,
// '90s lc (the renderer read only a plain-quoted label until 24sep2026 and
// drew the variable's label).  by()'s title() is stored and not drawn --
// dash draws by()'s cols(), missing and total and names the rest -- so its
// case holds the facets drawn, Stata's 52 and 22 rows, in both forms: the
// renderer's by() reader held the whole by() text to its injection pattern
// and drew the compound form's graph as one panel of 74, without a word
// (measured 24sep2026, _dash_parse_by), where twoway draws the two.
// twoway, measured the same day: the plain
// subtitle, caption, legend label and text() r(100) in comma mode and a
// legend label or text() r(109) after a paren command's comma; by(foreign,
// title("'90s by")) r(109); foo("'x") r(100); each compound form rc 0.
quietly count if foreign == 0
local jg_nd = r(N)
quietly count if foreign == 1
local jg_nf = r(N)
capture noisily dash scatter mpg weight, subtitle("'90s sp") note(`"'90s nc"') caption("'90s cp") legend(label(1 "'90s lp")) name(jg46a)
local jg_r1 = _rc
