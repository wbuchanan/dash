*! test_json_escaping.cscript  v1.0
*! Certification script for _dash_json_str, and for the saving() path that
*! was read back out of the document it writes.
*!
*! JSON forbids EVERY unescaped byte below 0x20 inside a string.
*! _dash_json_str escaped five of them -- backslash, quote, TAB, LF, CR --
*! and left the other twenty-seven raw.  Measured:
*!
*!     dash build, title("bad" + char(1) + "title")   -> r(7102)
*!     dash scatter ..., title("bad" + char(1) + ...) -> r(7102)
*!
*! both a Python JSONDecodeError, with no message from dash.  \b (8) and \f
*! (12) were missing too, although both have short forms in the grammar.
*!
*! ESCAPING, NOT REJECTING.  The user story asks for "either a clean dash
*! error or a correct dashboard".  A correct dashboard is the better of the
*! two, so a control character pasted in from a web page now survives into
*! the title rather than stopping the build.  ROADMAP AC-08.2 asks for an
*! error; this delivers the other half of the same sentence, and the value is
*! preserved instead of lost.
*!
*! THE PATH THAT CAME BACK OUT WRONG.  _dash_plot writes saving() into the
*! spec through _dash_json_str, and _dash_render_immediate read it back by
*! slicing the raw document at the first quote after "saving":" -- so it got
*! the ESCAPED text and used it as a filesystem path.  Measured:
*!
*!     dash scatter mpg weight, saving("<dir>a\b.html") replace
*!         rc 0, and the file written was "<dir>a\\b.html"
*!         confirm file "<dir>a\b.html"  -> r(601), it is not there
*!
*! Every Windows saving() path on the immediate route landed somewhere other
*! than where it was asked to.  Slicing at the first quote also truncated any
*! path containing one, since \" is a quote in the document but not in the
*! value.  It now goes through _dash_json_get_str, the same reader dash uses
*! for every other spec value.
*!
*! THE READER THAT NEVER READ AN ESCAPE.  _dash_extract_qual_vars finds the
*! variables a graph's by() and if, and a KPI's if, name -- the ones no plot
*! key carries -- so that they are exported with the data.  It meant to step
*! over each JSON escape but compared the character with the Mata literal
*! "\\", which is two characters, so it never did: the quote of \" ended the
*! value.  Measured 23sep2026 at ad13a0f, for make != "AMC Concord" &
*! foreign == 1 as the spec carries it, the reader returned make alone,
*! foreign was not exported, and the saved page and the served app each
*! warned "if_expr filter skipped" and drew all 74 cars instead of 22.
*!
*! THE QUALIFIER THAT NEVER REACHED IT.  dash scatter ... if make != "AMC
*! Concord" & foreign == 1 stored "if_expr":"" (the qualifier handed to
*! _dash_json_str in plain quotes), a KPI's qualifier was read back cut at
*! its first quote, and _dash_json_str lost any text holding "' -- so both
*! modes drew all 74 cars, and a compound-quoted title() was stored empty.
*! JSE-20..31 run the commands as typed; JSE-32..36 are CLAUDE.md rule 18
*! cases whose literals hold Python code, SMCL, markup, JSON punctuation and
*! 20,000 characters, each of which must be data in both render modes.
*!
*! Tests: JSE-01 through JSE-72.  JSE-38 reads every C0 escape back;
*! JSE-39..41 write a ~/ saving() path on each of the three routes.  The
*! rest are 24sep2026's.  JSE-42..49 run text holding a quote and an
*! apostrophe ("'90s cars", "' or 1 or '") through the plot commands as
*! typed -- titles, text options, a plot's and a graph's qualifier, the
*! one-line form -- and JSE-47..49 are the rule-18 bypass, injection and
*! exhaustion cases.  JSE-50..59: dash kpi, dash build and dash serve take
*! the user's text as written -- a KPI's title and qualifier, a dashboard's
*! title, update(), filterposition(), link(), filter() and saving() holding
*! "' or macro characters -- with CLAUDE.md rule 18's bypass, injection and
*! exhaustion cases for those surfaces.  JSE-60..64 hold the renderer to
*! twoway's reading of a text -- title(`"a "b" c"') is the one line a "b" c,
*! in both modes -- and are CLAUDE.md rule 18 cases for it.  JSE-65..69
*! hold the plot commands to expanding a macro in the user's text once,
*! where the user typed it, and never again; JSE-70 holds the dash entry
*! to the same when it hands dash kpi, dash build and dash serve their
*! text.  JSE-71 holds a by() whose text holds a dollar sign, a backslash,
*! a backtick or a nested compound quote to twoway's two panels, and JSE-72
*! a nested compound title and legend label to twoway's reading.
*!
*! Usage:  do test/test_json_escaping.cscript
*! Version: 1.2  24sep2026

cscript "every spec string is valid JSON on the way out" adodir ".."
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}

// `cscript' drops every global macro, the runner's $dash_nobrowser with them;
// set it again before this script builds a dashboard (test_cscript_hygiene.py).
global dash_nobrowser 1

if "`c(python_exec)'" == "" {
    display as error "SKIP: Python not available."
    exit 222
}

// WP-28 B7 (jg46l below) reads twoway's own SVG for the second axis's
// title through the shared helper (S02); loaded here, before any `cd'.
quietly do "cert_svg.do"

qui sysuse auto, clear
do "../dash_parse.mata"
do "../dash.ado"

mata:
// Does the escaped text still carry a raw byte below 0x20?
real scalar _jse_has_raw_c0(string scalar s)
{
    real scalar i, b
    for (i = 1; i <= strlen(s); i++) {
        b = ascii(substr(s, i, 1))
        if (b < 32) return(1)
    }
    return(0)
}
end


// ================================================================
// JSE-01..02 — every C0 byte leaves as an escape, none of them raw
// ================================================================
local nbad = 0
local badlist ""
forvalues c = 1/31 {
    local raw = "a" + char(`c') + "b"
    _dash_json_str `"`raw'"' _esc
    mata: st_local("_jse_raw", strofreal(_jse_has_raw_c0(st_local("_esc"))))
    if `_jse_raw' != 0 {
        local nbad = `nbad' + 1
        local badlist "`badlist' `c'"
    }
}
if `nbad' > 0 display as error "raw control byte(s) survived escaping:`badlist'"
assert `nbad' == 0
display "JSE-01 PASS: no C0 byte 1-31 survives _dash_json_str raw"

// And each leaves as its own escape.  The check above passes an escaper
// that DELETES a byte, JSE-02 looks at five of the thirty-one, and JSE-03/04
// compared with an empty needle (see there), so until 24sep2026 nothing
// here would have seen bytes 1-7, 11 or 14-31 dropped.  The escape is
// JSON's short form for the five that have one, else a backslash, u and
// four lower-case hex digits -- the form test_parser.cscript holds
// _json_escape to for 1, 27 and 31.  The digits come from Mata's inbase(),
// not from the escaper's own table.
mata:
string scalar _jse_c0_want(real scalar c)
{
    string scalar bs, h
    bs = char(92)
    if (c == 8)  return(bs + "b")
    if (c == 9)  return(bs + "t")
    if (c == 10) return(bs + "n")
    if (c == 12) return(bs + "f")
    if (c == 13) return(bs + "r")
    h = inbase(16, c)
    return(bs + "u" + (4 - strlen(h)) * "0" + h)
}
end
local nbad = 0
local badlist ""
forvalues c = 1/31 {
    local raw = "a" + char(`c') + "b"
    _dash_json_str `"`raw'"' _esc
    mata: st_local("_jse_ok", strofreal(st_local("_esc") == "a" + _jse_c0_want(`c') + "b"))
    if `_jse_ok' != 1 {
        local nbad = `nbad' + 1
        local badlist "`badlist' `c'"
    }
}
if `nbad' > 0 display as error "C0 byte(s) not written as their JSON escape:`badlist'"
assert `nbad' == 0
display "JSE-01b PASS: every C0 byte 1-31 leaves as its exact JSON escape"

// The five with short forms must use them, because that is what a reader of
// the document expects to see.
_dash_json_str `"a`=char(8)'b"'  _e8
assert strpos(`"`_e8'"',  "\b") > 0
_dash_json_str `"a`=char(9)'b"'  _e9
assert strpos(`"`_e9'"',  "\t") > 0
_dash_json_str `"a`=char(10)'b"' _e10
assert strpos(`"`_e10'"', "\n") > 0
_dash_json_str `"a`=char(12)'b"' _e12
assert strpos(`"`_e12'"', "\f") > 0
_dash_json_str `"a`=char(13)'b"' _e13
assert strpos(`"`_e13'"', "\r") > 0
display "JSE-02 PASS: backspace, tab, newline, formfeed and CR use short forms"


// ================================================================
// JSE-03..04 — the two that were never escaped at all
// ================================================================
// Each asserts the whole escaped text.  Until WP-24 the needle was the
// control byte itself -- the escape meant here had been written out as
// the raw byte -- and Stata drops a control byte from a do-file line as
// it reads it (measured: strlen() of that literal is 0), so both lines
// asserted strpos(s, "") > 0, which is 1 for every s: they could not fail.
_dash_json_str `"a`=char(1)'b"' _e1
assert `"`_e1'"' == "a\u0001b"
display "JSE-03 PASS: 0x01 becomes \u0001"

_dash_json_str `"a`=char(31)'b"' _e31
assert `"`_e31'"' == "a\u001fb"
display "JSE-04 PASS: 0x1f becomes \u001f"


// ================================================================
// JSE-05..06 — the ordinary escapes are unchanged
// ================================================================
_dash_json_str `"a\b"' _eb
assert `"`_eb'"' == `"a\\b"'
display "JSE-05 PASS: a backslash is still doubled, and first"

_dash_json_str `"say "hi""' _eq
assert strpos(`"`_eq'"', `"\""') > 0
display "JSE-06 PASS: a double quote is still escaped"


// ================================================================
// JSE-07 — a control character in title() builds, it does not abort
// ================================================================
// This is the r(7102) the whole exercise is about.
dash clear
dash scatter mpg weight, name(j1)
tempfile jout
local badtitle = "bad" + char(1) + "title"
capture noisily dash build, saving("`jout'.html") replace nobrowser ///
    title(`"`badtitle'"')
assert _rc == 0
display "JSE-07 PASS: a control byte in title() builds cleanly"

// And on the immediate route, which assembles its own spec.
dash clear
tempfile jout2
capture noisily dash scatter mpg weight, title(`"`badtitle'"') ///
    saving("`jout2'.html") replace
assert _rc == 0
display "JSE-08 PASS: and on the immediate route too"


// ================================================================
// JSE-09..10 — the saving() path survives its own escaping
// ================================================================
// A backslash in the path used to be doubled on the way in and never undone
// on the way out, so the file was written somewhere else entirely.
tempfile jbase
local jdir = substr("`jbase'", 1, strlen("`jbase'") - 9)
dash clear
capture noisily dash scatter mpg weight, saving(`"`jdir'js_a\b.html"') replace
assert _rc == 0
capture confirm file `"`jdir'js_a\b.html"'
assert _rc == 0
display "JSE-09 PASS: a backslash in saving() writes the path the user gave"

capture confirm file `"`jdir'js_a\\b.html"'
assert _rc != 0
display "JSE-10 PASS: and does not write the doubled one"


// ================================================================
// JSE-11..19 -- the qualifier reader reads a JSON escape as an escape
// ================================================================
// _dash_extract_qual_vars walks each "by" and "if_expr" value to its
// closing quote.  It tested every character against the Mata literal "\\"
// to step over an escape, and that literal is TWO characters -- strlen("\\")
// is 2 -- so the backslash of \" was kept and the quote after it ended the
// value: every name after the first string literal was lost, and with it
// the qualifier.  The escaped text below is made the way every spec string
// is, by _dash_json_str in compound quotes, never typed.
qui sysuse auto, clear
capture dash clear
do "cert_helpers.do"

local jse_q1 `"make == "AMC" & foreign == 1"'
_dash_json_str `"`jse_q1'"' jse_e1

// JSE-11 -- a KPI's if, in the shape _dash_prepare_spec hands the reader
// (dash.ado builds {"if_expr":"..."} around the escaped qualifier).
local jse_v11 ""
mata: _dash_extract_qual_vars(`"{"if_expr":"`jse_e1'"}"', "jse_v11")
display as text "  read: [`jse_v11']"
assert `: list posof "make" in jse_v11' > 0
assert `: list posof "foreign" in jse_v11' > 0
display "JSE-11 PASS: a KPI's if -- the name after a string literal is read"

// JSE-12 -- a graph of two plots: the qualifier with the literal on the
// first, a plain one on the second.  Every name of both is read, and
// nothing from outside the two values.  The graph is dash's own; only the
// first plot's empty if_expr is replaced.
dash (scatter mpg weight) (scatter price weight if rep78 == 3), name(jse12)
mata: st_local("jse_g12", subinstr(st_global("dash_json_jse12"), ///
    char(34) + "if_expr" + char(34) + ":" + char(34) + char(34), ///
    char(34) + "if_expr" + char(34) + ":" + char(34) + st_local("jse_e1") + char(34), 1))
local jse_v12 ""
mata: _dash_extract_qual_vars(st_local("jse_g12"), "jse_v12")
display as text "  read: [`jse_v12']"
foreach jse_w in make foreign rep78 {
    assert `: list posof "`jse_w'" in jse_v12' > 0
}
foreach jse_w of local jse_v12 {
    assert inlist("`jse_w'", "make", "AMC", "foreign", "rep78")
}
display "JSE-12 PASS: a plot's if -- every name of every plot's qualifier, nothing else"
capture dash clear

// JSE-13 -- a backslash in the literal.  \\ is one escape and the \" after
// it another, so the value neither ends early nor runs on into "in_expr".
// Single segment: the plot and the graph level both carry the qualifier.
local jse_q3 `"make == "C:\" | foreign == 1"'
_dash_json_str `"`jse_q3'"' jse_e3
dash scatter mpg weight, name(jse13)
mata: st_local("jse_g13", subinstr(st_global("dash_json_jse13"), ///
    char(34) + "if_expr" + char(34) + ":" + char(34) + char(34), ///
    char(34) + "if_expr" + char(34) + ":" + char(34) + st_local("jse_e3") + char(34), .))
local jse_v13 ""
mata: _dash_extract_qual_vars(st_local("jse_g13"), "jse_v13")
display as text "  read: [`jse_v13']"
assert `: list posof "make" in jse_v13' > 0
assert `: list posof "foreign" in jse_v13' > 0
foreach jse_w of local jse_v13 {
    assert inlist("`jse_w'", "make", "C", "foreign")
}
display "JSE-13 PASS: a graph-level if -- an escaped backslash before an escaped quote"
capture dash clear

// JSE-14 -- the escapes JSON has that no qualifier dash registers can
// carry today: Stata refuses a control character in an if ("invalid
// name", r(198)) and dash refuses one in by() (r(111)), both measured.  The
// reader is a JSON reader all the same: \t between two names in by() keeps
// them two names, and \uXXXX is six characters, not two.
local jse_v14a ""
mata: _dash_extract_qual_vars("{" + char(34) + "by" + char(34) + ":" + char(34) + ///
    "foreign" + char(92) + "trep78, cols(1)" + char(34) + "}", "jse_v14a")
display as text "  read: [`jse_v14a']"
assert "`jse_v14a'" == "foreign rep78"
local jse_v14b ""
mata: _dash_extract_qual_vars("{" + char(34) + "if_expr" + char(34) + ":" + char(34) + ///
    "price > 0 &" + char(92) + "u0001foreign == 1" + char(34) + "}", "jse_v14b")
display as text "  read: [`jse_v14b']"
assert "`jse_v14b'" == "price foreign"
display "JSE-14 PASS: \t and \uXXXX are read as escapes, in by() and in if"

// ----------------------------------------------------------------
// JSE-15..17 -- the build, end to end, for
//     dash scatter mpg weight if make != "AMC Concord" & foreign == 1
// foreign is named by the qualifier and nowhere else.  The registry holds
// the graph as _dash_plot writes it with the plot's if_expr escaped like
// every other spec string (the graph-level copy already is).  It is set
// here from the escaper because _dash_process_segment hands the plot's if
// to _dash_json_str inside plain double quotes, which loses any qualifier
// holding a double quote at registration (measured 23sep2026) -- a defect
// of its own, upstream of this reader.
// ----------------------------------------------------------------
qui sysuse auto, clear
capture dash clear
dash scatter mpg weight, name(jse15)
local jse_q5 `"make != "AMC Concord" & foreign == 1"'
_dash_json_str `"`jse_q5'"' jse_e5
mata: st_global("dash_json_jse15", subinstr(st_global("dash_json_jse15"), ///
    char(34) + "if_expr" + char(34) + ":" + char(34) + char(34), ///
    char(34) + "if_expr" + char(34) + ":" + char(34) + st_local("jse_e5") + char(34), .))
quietly count if make != "AMC Concord" & foreign == 1
local jse_n15 = r(N)
assert `jse_n15' == 22

// JSE-15 -- what dash build and dash serve export: the qualifier's answer,
// the column __dashq1 Stata filled, read whole (WP-27).  foreign, which
// only the qualifier names, is no longer exported for a renderer to
// translate the qualifier with.
tempfile jse_s15 jse_d15
_dash_prepare_spec, specpath("`jse_s15'") datapath("`jse_d15'")
local jse_x15 `"`r(vars)'"'
display as text "  exported: [`jse_x15']"
assert `: list posof "foreign" in jse_x15' == 0
cert_file_has "`jse_d15'", needle("__dashq1")
assert r(found) == 1
display "JSE-15 PASS: the build exports the answer of a string-literal qualifier"

// JSE-16 -- both render modes, on that export, draw the 22 rows the
// qualifier selects, and neither reports the qualifier skipped.  The saved
// page is DashRenderer; the served app is the generated app's
// make_document on a fresh Document.  The renderer is the one dash itself
// uses, loaded by path under its own name.  No backslash, backtick or
// dollar sign is written in the block: Stata reads its lines for macros.
// Every call's value is assigned: a python block echoes a bare
// expression's value, and render() returns the whole page.
_dash_find_render
global JSE_RENDER `"`r(fn)'"'
global JSE_SPEC   "`jse_s15'"
global JSE_DATA   "`jse_d15'"
tempfile jse_app16
global JSE_APP    "`jse_app16'"
global JSE_ROWS_SAVED  ""
global JSE_ROWS_SERVED ""
global JSE_SKIPPED     ""
python:
import importlib.util as _jse_il
import sys as _jse_sys
import warnings as _jse_w
from sfi import Macro as _jse_M
from bokeh.document import Document as _jse_Doc
from bokeh.models import GlyphRenderer as _jse_GR, Plot as _jse_Plot

def _jse_rows(roots):
    out = []
    for root in roots:
        for fig in root.select({"type": _jse_Plot}):
            for r in fig.renderers:
                if isinstance(r, _jse_GR) and type(r.glyph).__name__ == "Scatter":
                    out.append(max((len(v) for v in r.data_source.data.values()), default=0))
    return out

# Registered while it is used: ServerAppBuilder copies helpers into the app
# from its own source, which it finds through sys.modules.
_jse_spec = _jse_il.spec_from_file_location("_jse16_dash_render", _jse_M.getGlobal("JSE_RENDER"))
_jse_dr = _jse_il.module_from_spec(_jse_spec)
_jse_sys.modules["_jse16_dash_render"] = _jse_dr
_jse_spec.loader.exec_module(_jse_dr)
_jse_sp = _jse_M.getGlobal("JSE_SPEC")
_jse_dp = _jse_M.getGlobal("JSE_DATA")
_jse_msgs = []

with _jse_w.catch_warnings(record=True) as _jse_c:
    _jse_w.simplefilter("always")
    _jse_r = _jse_dr.DashRenderer(_jse_sp, _jse_dp)
    _jse_page = _jse_r.render()
_jse_msgs += [str(x.message) for x in _jse_c]
_jse_M.setGlobal("JSE_ROWS_SAVED", " ".join(str(n) for n in _jse_rows([_jse_r._last_layout_root])))

_jse_ap = _jse_M.getGlobal("JSE_APP")
with _jse_w.catch_warnings(record=True) as _jse_c:
    _jse_w.simplefilter("always")
    _jse_built = _jse_dr.ServerAppBuilder(_jse_sp, _jse_dp).build(_jse_ap)
_jse_msgs += [str(x.message) for x in _jse_c]
with open(_jse_ap, encoding="utf-8") as _jse_fh:
    _jse_src = _jse_fh.read()
_jse_attach = "if __name__ != '__main__':" + chr(10) + "    make_document(curdoc())"
assert _jse_attach in _jse_src, "the generated app's curdoc attach moved"
_jse_ns = {"__name__": "_jse16_app"}
with _jse_w.catch_warnings():
    _jse_w.simplefilter("ignore")
    exec(compile(_jse_src.replace(_jse_attach, "pass"), "_jse16_app.py", "exec"), _jse_ns)
with _jse_w.catch_warnings(record=True) as _jse_c:
    _jse_w.simplefilter("always")
    _jse_doc = _jse_Doc()
    _jse_made = _jse_ns["make_document"](_jse_doc)
_jse_msgs += [str(x.message) for x in _jse_c]
_jse_M.setGlobal("JSE_ROWS_SERVED", " ".join(str(n) for n in _jse_rows(_jse_doc.roots)))
_jse_M.setGlobal("JSE_SKIPPED", str(sum(1 for m in _jse_msgs if "filter skipped" in m)))
_jse_gone = _jse_sys.modules.pop("_jse16_dash_render", None)
end
local jse_rs "$JSE_ROWS_SAVED"
local jse_rv "$JSE_ROWS_SERVED"
local jse_sk "$JSE_SKIPPED"
display as text "  saved rows: [`jse_rs']  served rows: [`jse_rv']  skip warnings: [`jse_sk']"
assert "`jse_rs'" == "`jse_n15'"
assert "`jse_rv'" == "`jse_n15'"
assert "`jse_sk'" == "0"
display "JSE-16 PASS: the saved page and the served app draw the 22 rows, no qualifier skipped"
macro drop JSE_*

// JSE-17 -- and dash build itself, on the same registry: rc 0, and nothing
// in what it prints says the qualifier was skipped.  Before WP-30 it
// printed Python's "UserWarning: dash: if_expr filter skipped -- invalid
// syntax"; since WP-30 P1.26a that note is a "(note:  dash: ...)" line.
//
// The log is searched with cert_log_has, which rejoins the lines Stata
// wraps: the Python warning began with the path to dash_render.py, and a
// note is as long as its text, so where it wraps varies, and a search of the file's
// bytes does not see "filter skipped" broken across two lines.  And the
// same search must find those words where the renderer does skip a
// qualifier -- the control below -- or their absence proves nothing.  Since
// WP-27 no spec dash build writes can be skipped: dash.ado evaluates every
// qualifier in Stata and ships its answer as a column.  The control is
// therefore a spec written by hand, as dash.ado no longer writes one -- the
// qualifier as text, if mpg > mpg[1], and no column -- handed to the same
// renderer through _dash_do_render: a subscript is a construct the
// renderer's translation refuses, so it reports it skipped, rc 0.
capture program drop _jse17_build
program define _jse17_build, rclass
    args page logfile spec data
    local ls = c(linesize)
    set linesize 255
    capture log close _jse17
    capture erase "`logfile'"
    quietly log using "`logfile'", name(_jse17) text replace
    if "`spec'" == "" {
        capture noisily dash build, saving("`page'") replace nobrowser
    }
    else {
        _dash_find_render
        capture noisily _dash_do_render, spec("`spec'") data("`data'") ///
            output("`page'") renderpy(`"`r(fn)'"')
    }
    local rc = _rc
    quietly log close _jse17
    set linesize `ls'
    cert_log_has "`logfile'", needle("filter skipped")
    return scalar skipped = r(found)
    return scalar rc      = `rc'
end
// A spec written by hand: the first "if_expr":"" of the file dash wrote --
// the plot's -- given the text of args 2.  Read and written by value.
capture program drop _jse_handspec
program define _jse_handspec
    args specpath qualifier
    mata: _jse_hs_t = ""
    mata: assert(_cert_read(st_local("specpath"), _jse_hs_t))
    mata: _jse_hs_t = subinstr(_jse_hs_t, char(34) + "if_expr" + char(34) + ":" + char(34) + char(34), ///
        char(34) + "if_expr" + char(34) + ":" + char(34) + st_local("qualifier") + char(34), 1)
    mata: unlink(st_local("specpath"))
    mata: _jse_hs_fh = fopen(st_local("specpath"), "w")
    mata: fwrite(_jse_hs_fh, _jse_hs_t)
    mata: fclose(_jse_hs_fh)
end
tempfile jse_h17
local jse_log "`c(tmpdir)'dash_jse17.log"
_jse17_build "`jse_h17'.html" "`jse_log'"
local jse_rc17 = r(rc)
local jse_sk17 = r(skipped)
assert `jse_rc17' == 0
confirm file "`jse_h17'.html"
assert `jse_sk17' == 0
capture dash clear
quietly dash scatter mpg weight, name(jse17c)
tempfile jse_s17c jse_d17c
_dash_prepare_spec, specpath("`jse_s17c'") datapath("`jse_d17c'")
_jse_handspec "`jse_s17c'" "mpg > mpg[1]"
_jse17_build "`jse_h17'.html" "`jse_log'" "`jse_s17c'" "`jse_d17c'"
local jse_rc17c = r(rc)
local jse_sk17c = r(skipped)
display as text "  skip reported -- this qualifier: `jse_sk17'  the control: `jse_sk17c'"
assert `jse_rc17c' == 0
assert `jse_sk17c' == 1
capture program drop _jse17_build
capture erase "`jse_log'"
capture erase "`jse_h17'.html"
capture dash clear
display "JSE-17 PASS: dash build applies the qualifier and reports nothing skipped"

// JSE-18 -- a long qualifier is read whole, in bounded time.  30,000
// string literals, each a different word, then the name after the last:
// about 620,000 characters, under c(macrolen) (645,200 at the default
// maxvar), so an if that long can be held and handed to dash.  The reader
// grew the value one character at a time (quadratic: measured 48.6 s for a
// value of 1,000,000 characters) and listed names by searching the whole
// list for every word (quadratic in the words); only its stop at the first
// escape kept a long escaped qualifier from paying for either.  The text is
// kept in Mata, never in a macro.  A literal's words are not names since
// 24sep2026: they were read as names too, and a word that named or
// abbreviated a variable exported it (test_qualifier_literals.cscript
// QL-21), so the reader returns make and foreign and none of the 30,000.
mata: _jse_q18 = "{" + char(34) + "if_expr" + char(34) + ":" + char(34) + ///
    invtokens("make == " + char(92) + char(34) + "w" :+ strofreal(1..30000) :+ ///
    char(92) + char(34), " | ") + " | foreign == 1" + char(34) + "}"
mata: st_local("jse_l18", strofreal(strlen(_jse_q18)))
timer clear 18
timer on 18
local jse_v18 ""
mata: _dash_extract_qual_vars(_jse_q18, "jse_v18")
timer off 18
quietly timer list 18
local jse_t18 = r(t18)
mata: mata drop _jse_q18
local jse_n18 : word count `jse_v18'
display as text "  `jse_l18' characters read in `jse_t18' s; `jse_n18' words"
assert `jse_l18' > 600000
assert `jse_n18' == 2
assert "`jse_v18'" == "make foreign"
assert `jse_t18' < 30
display "JSE-18 PASS: a 620,000-character qualifier is read whole in bounded time"

// JSE-19 -- a value that names nothing: one word, and not a name (a number,
// a Python constant, -.5).  It is read and passed over, and the other
// values' names still come back.  The linear rewrite of the reader died
// here with a conformability error, r(3200), before any user saw it:
// select() of one word, not kept, is 0 x 1, not 1 x 0.  Measured on
// dash scatter mpg weight if ~foreign, when ~ was not read as Stata's not;
// it is now (JSE-30), so -.5 stands in for it.
local jse_v19 ""
mata: _dash_extract_qual_vars("{" + char(34) + "plots" + char(34) + ":[{" + ///
    char(34) + "if_expr" + char(34) + ":" + char(34) + "1" + char(34) + "},{" + ///
    char(34) + "if_expr" + char(34) + ":" + char(34) + "-.5" + char(34) + "},{" + ///
    char(34) + "if_expr" + char(34) + ":" + char(34) + "mpg > 1" + char(34) + "}]," + ///
    char(34) + "if_expr" + char(34) + ":" + char(34) + "True" + char(34) + "}", "jse_v19")
display as text "  read: [`jse_v19']"
assert "`jse_v19'" == "mpg"
display "JSE-19 PASS: a value that names nothing is passed over, not refused"


// ================================================================
// JSE-20..37 -- a qualifier holding a string literal, and other text with
// quotes in it, through the commands a user types
// ================================================================
// JSE-11..19 read a qualifier as the registry would hold it once escaped.
// It never held it.  Measured 23sep2026 at ad13a0f, Stata's own counts the
// oracle:
//   * dash scatter mpg weight if make != "AMC Concord" & foreign == 1
//     stored "if_expr":"".  _dash_process_segment handed the qualifier to
//     _dash_json_str inside plain double quotes and -args- split it at its
//     first inner quote, so both modes drew all 74 cars, not 22, without a
//     word -- the immediate route too.  make != "<b>" stopped with "_<
//     invalid name": the word after the quote was the NAME the result was
//     stored under.
//   * _dash_prepare_spec read a KPI's qualifier back with  local _kifx =
//     "${...}", which ended at its first quote: if make != "AMC" &
//     rep78 == 3 exported no rep78 and both modes showed 6165.26 for
//     Stata's 6429.23; "AMC Concord" stopped dash build, r(198) "invalid
//     'Concord'".
//   * _dash_json_str lost any text holding "': title(`"A "B" C"') stored
//     "title":"", legend(label(1 `"L "q""')) stored label(1 ), and a
//     compound-quoted literal was cut out of a qualifier.
//   * if ~foreign named no variable (the reader's operators had ~= and no
//     ~), nor did an if on a Unicode name (its pattern was ASCII).
qui sysuse auto, clear
capture dash clear
quietly count if make != "AMC Concord" & foreign == 1
local j2_n22 = r(N)
assert `j2_n22' == 22
quietly summarize price if make != "AMC Concord" & rep78 == 3, meanonly
local j2_k25 : display %9.2f r(mean)
local j2_k25 = strtrim("`j2_k25'")
quietly summarize price if make != "AMC" & rep78 == 3, meanonly
local j2_k26 : display %9.2f r(mean)
local j2_k26 = strtrim("`j2_k26'")
_dash_find_render
global J2_RENDER `"`r(fn)'"'

// Helpers.  Both render modes on the spec and data named by J2_SPEC and
// J2_DATA -- the saved page is DashRenderer, the served app the generated
// app's make_document on a fresh Document -- with the renderer dash itself
// uses, loaded by path and registered while used (ServerAppBuilder copies
// helpers from its own source through sys.modules).  Results come back as
// globals.  No backslash, backtick or dollar sign is written in the block,
// and every call's value is assigned: a python block echoes a bare
// expression's value.
python:
import html as _j2_html
import importlib.util as _j2_il
import json as _j2_json
import re as _j2_re
import sys as _j2_sys
import warnings as _j2_w
from sfi import Macro as _j2_M

def _j2_dr():
    name = "_j2_dash_render"
    if name not in _j2_sys.modules:
        spec = _j2_il.spec_from_file_location(name, _j2_M.getGlobal("J2_RENDER"))
        mod = _j2_il.module_from_spec(spec)
        _j2_sys.modules[name] = mod
        spec.loader.exec_module(mod)
    return _j2_sys.modules[name]

def _j2_scatter_rows(roots):
    from bokeh.models import GlyphRenderer, Plot
    out = []
    for root in roots:
        for fig in root.select({"type": Plot}):
            for r in fig.renderers:
                if isinstance(r, GlyphRenderer) and type(r.glyph).__name__ == "Scatter":
                    out.append(max((len(v) for v in r.data_source.data.values()), default=0))
    return " ".join(str(n) for n in out)

def _j2_kpi_values(roots):
    from bokeh.models import Div
    out = []
    for root in roots:
        for d in root.select({"type": Div}):
            m = _j2_re.search('id="kpi_val_[^"]*"[^>]*>([^<]*)<', d.text or "")
            if m:
                out.append(m.group(1).strip())
    return " ".join(out)

def _j2_modes():
    dr = _j2_dr()
    sp, dp, ap = (_j2_M.getGlobal(k) for k in ("J2_SPEC", "J2_DATA", "J2_APP"))
    msgs = []
    with _j2_w.catch_warnings(record=True) as caught:
        _j2_w.simplefilter("always")
        r = dr.DashRenderer(sp, dp)
        page = r.render()
        built = dr.ServerAppBuilder(sp, dp).build(ap)
    msgs += [str(x.message) for x in caught]
    with open(ap, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':" + chr(10) + "    make_document(curdoc())"
    assert attach in src, "the generated app's curdoc attach moved"
    ns = {"__name__": "_j2_app"}
    with _j2_w.catch_warnings():
        _j2_w.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "_j2_app.py", "exec"), ns)
    from bokeh.document import Document
    with _j2_w.catch_warnings(record=True) as caught:
        _j2_w.simplefilter("always")
        doc = Document()
        made = ns["make_document"](doc)
    msgs += [str(x.message) for x in caught]
    _j2_M.setGlobal("J2_SAVED_ROWS", _j2_scatter_rows([r._last_layout_root]))
    _j2_M.setGlobal("J2_SERVED_ROWS", _j2_scatter_rows(doc.roots))
    _j2_M.setGlobal("J2_SAVED_KPI", _j2_kpi_values([r._last_layout_root]))
    _j2_M.setGlobal("J2_SERVED_KPI", _j2_kpi_values(doc.roots))
    _j2_M.setGlobal("J2_SKIPPED", str(sum(1 for m in msgs if "filter skipped" in m)))

def _j2_page_rows():
    with open(_j2_M.getGlobal("J2_PAGE"), encoding="utf-8") as fh:
        page = fh.read()
    m = _j2_re.search('<script type="application/json"[^>]*>(.*?)</script>', page, _j2_re.S)
    docs = _j2_json.loads(_j2_html.unescape(m.group(1)))
    objs, stack = {}, [docs]
    while stack:
        v = stack.pop()
        if isinstance(v, dict):
            if v.get("type") == "object" and "id" in v and "name" in v:
                objs[v["id"]] = v
            stack.extend(v.values())
        elif isinstance(v, list):
            stack.extend(v)
    def ref(v):
        return objs.get(v["id"], v) if isinstance(v, dict) and "id" in v else v
    out = []
    for o in objs.values():
        if o["name"] != "GlyphRenderer":
            continue
        a = o.get("attributes", {})
        if ref(a.get("glyph", {})).get("name") != "Scatter":
            continue
        data = ref(a.get("data_source", {})).get("attributes", {}).get("data", {})
        n = 0
        for key, val in data.get("entries", []):
            if isinstance(val, dict) and val.get("type") == "ndarray":
                n = max(n, int(val.get("shape", [0])[0]))
            elif isinstance(val, list):
                n = max(n, len(val))
        out.append(n)
    _j2_M.setGlobal("J2_PAGE_ROWS", " ".join(str(n) for n in out))

# J2_OK is 1 when a string of J2_PAGE's document holds J2_NEEDLE: the
# embedded JSON read back as the browser reads it, HTML-unescaped and
# parsed, every key and value walked.  0 when the page has no document.
def _j2_page_has():
    with open(_j2_M.getGlobal("J2_PAGE"), encoding="utf-8") as fh:
        page = fh.read()
    m = _j2_re.search('<script type="application/json"[^>]*>(.*?)</script>', page, _j2_re.S)
    needle = _j2_M.getGlobal("J2_NEEDLE")
    found = False
    stack = [_j2_json.loads(_j2_html.unescape(m.group(1)))] if m else []
    while stack and not found:
        v = stack.pop()
        if isinstance(v, str):
            found = needle in v
        elif isinstance(v, dict):
            stack.extend(v.keys())
            stack.extend(v.values())
        elif isinstance(v, list):
            stack.extend(v)
    _j2_M.setGlobal("J2_OK", "1" if found else "0")

def _j2_json_field():
    data = _j2_json.loads(_j2_M.getGlobal(_j2_M.getGlobal("J2_FROM")))
    for part in _j2_M.getGlobal("J2_PATH").split():
        data = data[int(part)] if part.isdigit() else data[part]
    _j2_M.setGlobal("J2_OK", "1" if data == _j2_M.getGlobal("J2_WANT") else "0")

def _j2_round_trip():
    raw, esc = _j2_M.getGlobal("J2_V"), _j2_M.getGlobal("J2_E")
    ok = (_j2_json.loads(chr(34) + esc + chr(34)) == raw
          and not any(ch in esc for ch in (chr(39), chr(96), chr(36))))
    _j2_M.setGlobal("J2_OK", "1" if ok else "0")
end

// One command with its output captured to a log: r(rc), r(log).  Run from
// a program, so the log holds what the command printed and not its text.
capture program drop _j2_run
program define _j2_run, rclass
    version 16.0
    args cmdtext
    local logfile "`c(tmpdir)'dash_jse_run.log"
    local ls = c(linesize)
    set linesize 255
    capture log close _j2log
    capture erase "`logfile'"
    quietly log using "`logfile'", name(_j2log) text replace
    capture noisily `cmdtext'
    local rc = _rc
    quietly log close _j2log
    set linesize `ls'
    return scalar rc  = `rc'
    return local  log "`logfile'"
end

// JSE-20 -- a one-segment qualifier with a string literal, stored whole at
// the plot and at the graph level.
dash scatter mpg weight if make != "AMC Concord" & foreign == 1, name(jse20)
global J2_FROM "dash_json_jse20"
global J2_WANT `"make != "AMC Concord" & foreign == 1"'
global J2_PATH "plots 0 if_expr"
python: _j2_json_field()
local j2_ok1 "$J2_OK"
global J2_PATH "if_expr"
python: _j2_json_field()
local j2_ok2 "$J2_OK"
display as text "  stored whole -- plot level: `j2_ok1'  graph level: `j2_ok2'"
assert "`j2_ok1'" == "1"
assert "`j2_ok2'" == "1"
display "JSE-20 PASS: a qualifier holding a string literal is stored whole, at both levels"
capture dash clear

// JSE-21 -- two segments: each plot keeps its own qualifier whole, and the
// graph level stays empty.
dash (scatter mpg weight if make != "AMC Concord" & foreign == 1) (scatter price weight if rep78 == 3), name(jse21)
global J2_FROM "dash_json_jse21"
global J2_WANT `"make != "AMC Concord" & foreign == 1"'
global J2_PATH "plots 0 if_expr"
python: _j2_json_field()
local j2_ok1 "$J2_OK"
global J2_WANT "rep78 == 3"
global J2_PATH "plots 1 if_expr"
python: _j2_json_field()
local j2_ok2 "$J2_OK"
global J2_WANT ""
global J2_PATH "if_expr"
python: _j2_json_field()
local j2_ok3 "$J2_OK"
display as text "  plot 1: `j2_ok1'  plot 2: `j2_ok2'  graph level empty: `j2_ok3'"
assert "`j2_ok1'" == "1" & "`j2_ok2'" == "1" & "`j2_ok3'" == "1"
display "JSE-21 PASS: two plots keep their own qualifiers whole"
capture dash clear

// JSE-22 -- a compound-quoted literal, the only way a Stata literal holds a
// double quote: stored whole, and the reader finds the names around it.
dash scatter mpg weight if make != `"AMC Concord"' & foreign == 1, name(jse22)
global J2_FROM "dash_json_jse22"
global J2_WANT `"make != `"AMC Concord"' & foreign == 1"'
global J2_PATH "plots 0 if_expr"
python: _j2_json_field()
local j2_ok1 "$J2_OK"
global J2_PATH "if_expr"
python: _j2_json_field()
local j2_ok2 "$J2_OK"
local j2_v22 ""
mata: _dash_extract_qual_vars(st_global("dash_json_jse22"), "j2_v22")
display as text "  stored whole: `j2_ok1' `j2_ok2'  read: [`j2_v22']"
assert "`j2_ok1'" == "1" & "`j2_ok2'" == "1"
assert `: list posof "make" in j2_v22' > 0 & `: list posof "foreign" in j2_v22' > 0
display "JSE-22 PASS: a compound-quoted literal is stored whole"
capture dash clear

// JSE-23 -- dash build, end to end, on the command as typed: the
// qualifier's answer is exported as its column (and foreign, which only
// the qualifier names, is not: WP-27), both modes draw Stata's 22 rows,
// nothing is reported skipped.
dash scatter mpg weight if make != "AMC Concord" & foreign == 1, name(jse23)
tempfile j2_s23 j2_d23 j2_a23
_dash_prepare_spec, specpath("`j2_s23'") datapath("`j2_d23'")
local j2_x23 `"`r(vars)'"'
display as text "  exported: [`j2_x23']"
assert `: list posof "foreign" in j2_x23' == 0
cert_file_has "`j2_d23'", needle("__dashq1")
assert r(found) == 1
global J2_SPEC "`j2_s23'"
global J2_DATA "`j2_d23'"
global J2_APP  "`j2_a23'"
python: _j2_modes()
display as text "  saved rows: [$J2_SAVED_ROWS]  served rows: [$J2_SERVED_ROWS]  skipped: [$J2_SKIPPED]"
assert "$J2_SAVED_ROWS" == "`j2_n22'"
assert "$J2_SERVED_ROWS" == "`j2_n22'"
assert "$J2_SKIPPED" == "0"
_j2_run `"dash build, saving("`j2_s23'.html") replace nobrowser"'
assert r(rc) == 0
cert_log_has "`r(log)'", needle("filter skipped")
local j2_sk23 = r(found)
assert `j2_sk23' == 0
// The control, through the same run and the same search (JSE-17 says why):
// a qualifier the renderer does skip is reported in those words -- in a
// spec written by hand, as no build writes one since WP-27.
capture dash clear
quietly dash scatter mpg weight, name(jse23c)
tempfile j2_s23c j2_d23c
_dash_prepare_spec, specpath("`j2_s23c'") datapath("`j2_d23c'")
_jse_handspec "`j2_s23c'" "mpg > mpg[1]"
_dash_find_render
global J2_RPY `"`r(fn)'"'
_j2_run `"_dash_do_render, spec("`j2_s23c'") data("`j2_d23c'") output("`j2_s23'.html") renderpy("$J2_RPY")"'
assert r(rc) == 0
cert_log_has "`r(log)'", needle("filter skipped")
local j2_sk23c = r(found)
display as text "  skip reported -- this qualifier: `j2_sk23'  the control: `j2_sk23c'"
assert `j2_sk23c' == 1
capture erase "`j2_s23'.html"
display "JSE-23 PASS: dash build exports the qualifier's variable and draws Stata's rows"
capture dash clear

// JSE-24 -- the immediate route: the saved page draws Stata's 22 rows.
tempfile j2_p24
global J2_PAGE "`j2_p24'.html"
dash scatter mpg weight if make != "AMC Concord" & foreign == 1, saving("`j2_p24'.html")
python: _j2_page_rows()
display as text "  page rows: [$J2_PAGE_ROWS]"
assert "$J2_PAGE_ROWS" == "`j2_n22'"
capture erase "`j2_p24'.html"
display "JSE-24 PASS: the immediate route draws Stata's rows"
capture dash clear

// JSE-25 -- a KPI's qualifier with a blank inside its literal: dash build's
// export step runs, its answer is exported as a column (rep78, which only
// the qualifier names, is not: WP-27), and both modes show Stata's value.
dash scatter mpg weight, name(jse25g)
dash kpi mean(price) if make != "AMC Concord" & rep78 == 3, title("P") fmt(%9.2f) name(jse25)
tempfile j2_s25 j2_d25 j2_a25
capture noisily _dash_prepare_spec, specpath("`j2_s25'") datapath("`j2_d25'")
local j2_rc25 = _rc
local j2_x25 `"`r(vars)'"'
display as text "  rc: `j2_rc25'  exported: [`j2_x25']"
assert `j2_rc25' == 0
assert `: list posof "rep78" in j2_x25' == 0
global J2_SPEC "`j2_s25'"
global J2_DATA "`j2_d25'"
global J2_APP  "`j2_a25'"
python: _j2_modes()
display as text "  KPI saved: [$J2_SAVED_KPI]  served: [$J2_SERVED_KPI]  Stata: [`j2_k25']"
assert "$J2_SAVED_KPI" == "`j2_k25'"
assert "$J2_SERVED_KPI" == "`j2_k25'"
assert "$J2_SKIPPED" == "0"
display "JSE-25 PASS: a KPI qualifier with a blank in its literal builds and shows Stata's value"
capture dash clear

// JSE-26 -- and without a blank, where it was cut rather than refused.
dash scatter mpg weight, name(jse26g)
dash kpi mean(price) if make != "AMC" & rep78 == 3, title("P") fmt(%9.2f) name(jse26)
tempfile j2_s26 j2_d26 j2_a26
_dash_prepare_spec, specpath("`j2_s26'") datapath("`j2_d26'")
local j2_x26 `"`r(vars)'"'
assert `: list posof "rep78" in j2_x26' == 0
global J2_SPEC "`j2_s26'"
global J2_DATA "`j2_d26'"
global J2_APP  "`j2_a26'"
python: _j2_modes()
display as text "  KPI saved: [$J2_SAVED_KPI]  served: [$J2_SERVED_KPI]  Stata: [`j2_k26']"
assert "$J2_SAVED_KPI" == "`j2_k26'"
assert "$J2_SERVED_KPI" == "`j2_k26'"
display "JSE-26 PASS: a KPI qualifier is read whole"
capture dash clear

// JSE-27 -- _dash_json_str keeps a text holding "' -- a compound-quoted
// title, "'quoted'", a compound literal in a qualifier -- and a backtick,
// apostrophe and dollar sign, which it now writes as \u escapes so that no
// spec line's compound quotes can be ended or expanded by them.  Each text
// is made in Mata, never typed, and must come back from Python's JSON
// reader exactly.  It is handed over through macval(), as dash's
// validators hand over a value: a substituted macro's own ` and $ are
// otherwise read again as references.
mata: st_local("j2_t1", char(96) + char(34) + "A " + char(34) + "B" + char(34) + " C" + char(34) + char(39))
mata: st_local("j2_t2", char(34) + char(39) + "quoted" + char(39) + char(34))
mata: st_local("j2_t3", "make == " + char(96) + char(34) + "AMC" + char(34) + char(39) + " & foreign == 1")
mata: st_local("j2_t4", "a" + char(96) + "b" + char(39) + " c" + char(36) + "x")
forvalues j = 1/4 {
    local j2_e ""
    _dash_json_str `"`macval(j2_t`j')'"' j2_e
    mata: st_global("J2_V", st_local("j2_t`j'"))
    mata: st_global("J2_E", st_local("j2_e"))
    python: _j2_round_trip()
    local j2_ok`j' "$J2_OK"
}
display as text "  round trips: `j2_ok1' `j2_ok2' `j2_ok3' `j2_ok4'"
assert "`j2_ok1'`j2_ok2'`j2_ok3'`j2_ok4'" == "1111"
display "JSE-27 PASS: _dash_json_str keeps text holding quote-apostrophe, backtick and dollar"

// JSE-28 -- _dash_json_get_str decodes every escape JSON has, so what
// _dash_json_str writes comes back whole; and a saving() path holding an
// apostrophe, which travels through both, is written where it was asked.
mata: st_local("j2_ok28", strofreal(1))
mata: _j2_bs = char(92)
mata: _j2_j = "{" + char(34) + "k" + char(34) + ":" + char(34) + "a" + _j2_bs + "u0027b" + _j2_bs + "u0060c" + _j2_bs + "u0024d" + _j2_bs + "u0001e" + _j2_bs + "bf" + _j2_bs + "fg" + _j2_bs + "/h" + _j2_bs + "u00e9i" + char(34) + "}"
mata: _dash_json_get_str(_j2_j, "k", "j2_g28")
mata: st_local("j2_ok28", strofreal(st_local("j2_g28") == "a" + char(39) + "b" + char(96) + "c" + char(36) + "d" + char(1) + "e" + char(8) + "f" + char(12) + "g/h" + uchar(233) + "i"))
mata: mata drop _j2_bs _j2_j
display as text "  every escape decoded: `j2_ok28'"
assert `j2_ok28' == 1
forvalues j = 1/4 {
    _dash_json_str `"`macval(j2_t`j')'"' j2_e
    mata: _dash_json_get_str("{" + char(34) + "k" + char(34) + ":" + char(34) + st_local("j2_e") + char(34) + "}", "k", "j2_back")
    mata: st_local("j2_rt", strofreal(st_local("j2_back") == st_local("j2_t`j'")))
    assert `j2_rt' == 1
}
local j2_ap "`c(tmpdir)'jse28_o'brien.html"
capture erase "`j2_ap'"
dash scatter mpg weight, saving("`j2_ap'")
confirm file "`j2_ap'"
capture erase "`j2_ap'"
display "JSE-28 PASS: _dash_json_get_str decodes every JSON escape; an apostrophe path survives"
capture dash clear

// JSE-29 -- title(), note(), a legend label and a by() title written with
// compound quotes are stored whole (_dash_json_str returned "" for each).
