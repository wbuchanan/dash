_jg_build "`jg_p46'.html"
local jg_rb3 = r(rc)
local jg_ta ""
mata: st_global("JG_WANT", "line 1" + char(10) + "line 2")
_jg_drawn LinearAxis
local jg_ta "`jg_ta'`r(n)'"
foreach jg_v in x y {
    mata: st_global("JG_WANT", char(39) + "90s " + st_local("jg_v"))
