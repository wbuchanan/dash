display "JSE-64 PASS: SMCL, markup, JSON and Python code in a title and note are drawn as typed and run nowhere"

python: _jr_gone = _jr_sys.modules.pop("_jr_dash_render", None)
macro drop JR_*
capture dash clear


// ================================================================
// JSE-65..69 -- a macro in the user's text is expanded once, by Stata, where
// the user typed it, and never again by dash
// ================================================================
// dash forwarded its command as a command line -- _dash_plot `0' -- and a
// command line built from a macro is expanded again, as was every copy of
// the text through compound quotes after it and the command of a one-line
// if: text typed escaped, so that it reaches dash as written -- a title
// Cost in \$US, a \`=exp' -- was expanded a second time, the global's value
// stored and the =exp evaluated (measured 24sep2026: \`=filewrite()' in a
// title wrote its file).  Each case types the text as a user keeps it
// literal: \$J6_G a global, \`=1+1' and \`=filewrite(...)' an =exp, the
// second writing a file whose absence is checked, and \`jgnone' a local
// reference to nothing.  What dash must receive is built in Mata.  Stata's
// own count on the same typed qualifier is the oracle for the rows.  twoway
// expands each of them again (measured 24sep2026): it draws $J6_G's value.

// ----------------------------------------------------------------
// JSE-65 -- a macro in a title, the text options, a legend label and an
// axis title, in comma mode: stored and drawn as typed, and nothing runs.
// yti2() is folded into ytitle2() by the plot parser: the fold hands the
// text on by value too (a copy through compound quotes expanded it again).
// ----------------------------------------------------------------
qui sysuse auto, clear
global J6_G "Audi 5000"
local jg_sent "`c(tmpdir)'j65"
capture erase "`jg_sent'"
mata: st_local("jg_M", "A" + char(36) + "J6_G B " + char(96) + "=1+1" + char(39) + " C " + ///
    char(96) + "=filewrite(c(tmpdir)+char(106)+char(54)+char(53),char(120))" + char(39) + ///
    " D " + char(96) + "jgnone" + char(39) + " E")
capture dash clear
capture noisily dash scatter mpg weight, title("A\$J6_G B \`=1+1' C \`=filewrite(c(tmpdir)+char(106)+char(54)+char(53),char(120))' D \`jgnone' E") subtitle("s\$J6_G \`=1+1'") note(`"n\`jgnone' \$J6_G"') caption("c\$J6_G") legend(label(1 "l\$J6_G")) xtitle("x\$J6_G \`=1+1'") yti2("y2\$J6_G \`jgnone'") name(jg65a)
local jg_r1 = _rc
local jg_ok ""
mata: st_global("JG_WANT", _jg_pq(st_local("jg_M")))
_jg_stored jg65a "graph_options title"
local jg_ok "`jg_ok'`r(ok)'"
mata: st_global("JG_WANT", _jg_pq("s" + char(36) + "J6_G " + char(96) + "=1+1" + char(39)))
_jg_stored jg65a "graph_options subtitle"
local jg_ok "`jg_ok'`r(ok)'"
mata: st_global("JG_WANT", _jg_cq("n" + char(96) + "jgnone" + char(39) + " " + char(36) + "J6_G"))
_jg_stored jg65a "graph_options note"
local jg_ok "`jg_ok'`r(ok)'"
mata: st_global("JG_WANT", _jg_pq("c" + char(36) + "J6_G"))
_jg_stored jg65a "graph_options caption"
local jg_ok "`jg_ok'`r(ok)'"
mata: st_global("JG_WANT", "label(1 " + _jg_pq("l" + char(36) + "J6_G") + ")")
_jg_stored jg65a "graph_options legend"
local jg_ok "`jg_ok'`r(ok)'"
mata: st_global("JG_WANT", _jg_pq("x" + char(36) + "J6_G " + char(96) + "=1+1" + char(39)))
_jg_stored jg65a "graph_options xtitle"
local jg_ok "`jg_ok'`r(ok)'"
mata: st_global("JG_WANT", _jg_pq("y2" + char(36) + "J6_G " + char(96) + "jgnone" + char(39)))
_jg_stored jg65a "graph_options ytitle2"
local jg_ok "`jg_ok'`r(ok)'"
tempfile jg_p65
_jg_build "`jg_p65'.html"
local jg_rb = r(rc)
local jg_dr ""
mata: st_global("JG_WANT", st_local("jg_M"))
_jg_drawn Title
local jg_dr "`jg_dr'`r(n)'"
foreach jg_x in "s" "n" "c" {
    if "`jg_x'" == "s" mata: st_global("JG_WANT", "s" + char(36) + "J6_G " + char(96) + "=1+1" + char(39))
    if "`jg_x'" == "n" mata: st_global("JG_WANT", "n" + char(96) + "jgnone" + char(39) + " " + char(36) + "J6_G")
    if "`jg_x'" == "c" mata: st_global("JG_WANT", "c" + char(36) + "J6_G")
    _jg_drawn Label
    local jg_dr "`jg_dr'`r(n)'"
}
mata: st_global("JG_WANT", "l" + char(36) + "J6_G")
_jg_drawn LegendItem
local jg_dr "`jg_dr'`r(n)'"
mata: st_global("JG_WANT", "x" + char(36) + "J6_G " + char(96) + "=1+1" + char(39))
_jg_drawn LinearAxis
local jg_dr "`jg_dr'`r(n)'"
capture erase "`jg_p65'.html"
capture confirm file "`jg_sent'"
local jg_ran = (_rc == 0)
display as text "  macro -- rc: `jg_r1'  stored as typed (title sub note cap legend xtitle yti2): `jg_ok'  build: `jg_rb'  drawn as typed (title sub note cap legend xtitle): `jg_dr'  filewrite ran: `jg_ran'"
assert `jg_r1' == 0
assert "`jg_ok'" == "1111111"
assert `jg_rb' == 0
assert "`jg_dr'" == "111111"
assert `jg_ran' == 0
display "JSE-65 PASS: a global, an =exp and a macro reference in a title, text option, legend label, axis title or folded alias are stored and drawn as typed, and nothing runs"
capture dash clear
macro drop J6_*

// ----------------------------------------------------------------
// JSE-66 -- a macro in a plot's qualifier, a plot group's and the graph's:
// stored as typed, applied as Stata applies the typed text, nothing runs
// ----------------------------------------------------------------
global J6_G "Audi 5000"
local jg_sent "`c(tmpdir)'j66"
capture erase "`jg_sent'"
quietly count if make != "\$J6_G" & foreign == 1
local jg_nl = r(N)
quietly count if make != "$J6_G" & foreign == 1
local jg_nx = r(N)
quietly count if make != "\`=filewrite(c(tmpdir)+char(106)+char(54)+char(54),char(120))'" & foreign == 1
local jg_nf = r(N)
capture confirm file "`jg_sent'"
local jg_ranc = (_rc == 0)
capture dash clear
capture noisily dash scatter mpg weight if make != "\$J6_G" & foreign == 1, name(jg66a)
local jg_r1 = _rc
capture noisily dash (scatter mpg weight if make != "\$J6_G" & foreign == 1) (line mpg weight), name(jg66b)
local jg_r2 = _rc
capture noisily dash (scatter mpg weight) (line mpg weight) if make != "\$J6_G" & foreign == 1, name(jg66c)
local jg_r3 = _rc
capture noisily dash scatter mpg weight if make != "\`=filewrite(c(tmpdir)+char(106)+char(54)+char(54),char(120))'" & foreign == 1, name(jg66d)
local jg_r4 = _rc
capture noisily dash scatter mpg weight if make != "\`jgnone'" & foreign == 1, name(jg66e)
local jg_r5 = _rc
local jg_ok ""
mata: st_global("JG_WANT", "make != " + _jg_pq(char(36) + "J6_G") + " & foreign == 1")
_jg_stored jg66a "plots 0 if_expr"
local jg_ok "`jg_ok'`r(ok)'"
_jg_stored jg66a "if_expr"
local jg_ok "`jg_ok'`r(ok)'"
_jg_stored jg66b "plots 0 if_expr"
local jg_ok "`jg_ok'`r(ok)'"
_jg_stored jg66c "if_expr"
local jg_ok "`jg_ok'`r(ok)'"
mata: st_global("JG_WANT", "make != " + _jg_pq(char(96) + "=filewrite(c(tmpdir)+char(106)+char(54)+char(54),char(120))" + char(39)) + " & foreign == 1")
_jg_stored jg66d "plots 0 if_expr"
local jg_ok "`jg_ok'`r(ok)'"
mata: st_global("JG_WANT", "make != " + _jg_pq(char(96) + "jgnone" + char(39)) + " & foreign == 1")
_jg_stored jg66e "plots 0 if_expr"
local jg_ok "`jg_ok'`r(ok)'"
tempfile jg_p66
_jg_build "`jg_p66'.html"
local jg_rb = r(rc)
local jg_rows "`r(rows)'"
capture erase "`jg_p66'.html"
// The typed qualifier is also the sample dash checks a weight and start()
// over.  Peugeot 604, the one foreign car below 15 mpg, is in the sample
// the typed text selects -- no make is the text $J6_P -- so a negative
// weight on its row and a start() above its mpg are refused, as twoway
// refuses them over a sample holding it: r(402) and r(198).  With the
// global expanded the car left the sample and both were accepted.
global J6_P "Peugeot 604"
quietly generate double jg_w66 = cond(make == "Peugeot 604", -1, 1)
quietly summarize mpg if make != "\$J6_P" & foreign == 1
local jg_min = r(min)
quietly count if jg_w66 < 0 & make != "\$J6_P" & foreign == 1
local jg_neg = r(N)
capture noisily dash lpoly mpg weight [aw=jg_w66] if make != "\$J6_P" & foreign == 1, name(jg66f)
local jg_r6 = _rc
capture noisily dash histogram mpg if make != "\$J6_P" & foreign == 1, start(15) name(jg66g)
local jg_r7 = _rc
drop jg_w66
local jg_reg "${dash_graph_registry}"
capture confirm file "`jg_sent'"
local jg_ran = (_rc == 0)
display as text "  macro -- rc: `jg_r1' `jg_r2' `jg_r3' `jg_r4' `jg_r5'  stored as typed: `jg_ok'  build: `jg_rb'  rows: [`jg_rows'] of Stata's `jg_nl' as typed (`jg_nx' with the global expanded)  filewrite ran: `jg_ranc' `jg_ran'"
display as text "  over the typed sample (min mpg `jg_min', negative weights `jg_neg') -- weight rc: `jg_r6'  start() rc: `jg_r7'  registry: [`jg_reg']"
assert `jg_nl' == 22 & `jg_nx' == 21 & `jg_nf' == 22 & `jg_ranc' == 0
assert `jg_r1' == 0 & `jg_r2' == 0 & `jg_r3' == 0 & `jg_r4' == 0 & `jg_r5' == 0
assert "`jg_ok'" == "111111"
assert `jg_rb' == 0
assert "`jg_rows'" == "`jg_nl' `jg_nl' `jg_nl' `jg_nl' `jg_nl'"
assert `jg_min' == 14 & `jg_neg' == 1
assert `jg_r6' == 402 & `jg_r7' == 198
assert "`jg_reg'" == "jg66a jg66b jg66c jg66d jg66e"
assert `jg_ran' == 0
display "JSE-66 PASS: a macro in a plot's, a group's or the graph's qualifier is stored as typed, gives Stata's rows and is the sample a weight and start() are checked over, and nothing runs"
capture dash clear
macro drop J6_*

// ----------------------------------------------------------------
// JSE-67 -- a macro in a title in a plot group, after a paren command's
// comma, in || mode and on the one-line form: stored and drawn as typed.
// After the comma, xti2() is folded into xtitle2() by the graph parser,
// by value.
// ----------------------------------------------------------------
global J6_G "Audi 5000"
local jg_sent "`c(tmpdir)'j67"
capture erase "`jg_sent'"
mata: st_local("jg_M", "A" + char(36) + "J6_G B " + char(96) + "=1+1" + char(39) + " C " + ///
    char(96) + "=filewrite(c(tmpdir)+char(106)+char(54)+char(55),char(120))" + char(39) + ///
    " D " + char(96) + "jgnone" + char(39) + " E")
quietly count if make != "\$J6_G" & foreign == 1
local jg_nl = r(N)
capture dash clear
capture noisily dash (scatter mpg weight, title("A\$J6_G B \`=1+1' C \`=filewrite(c(tmpdir)+char(106)+char(54)+char(55),char(120))' D \`jgnone' E")) (line mpg weight), name(jg67a)
local jg_r1 = _rc
capture noisily dash (scatter mpg weight) (line mpg weight), title("A\$J6_G B \`=1+1' C \`=filewrite(c(tmpdir)+char(106)+char(54)+char(55),char(120))' D \`jgnone' E") xti2("x2\$J6_G \`jgnone'") name(jg67b)
local jg_r2 = _rc
capture noisily dash scatter mpg weight, title("A\$J6_G B \`=1+1' C \`=filewrite(c(tmpdir)+char(106)+char(54)+char(55),char(120))' D \`jgnone' E") || line mpg weight, name(jg67c)
local jg_r3 = _rc
local jg_ok ""
mata: st_global("JG_WANT", _jg_pq(st_local("jg_M")))
foreach jg_g in jg67a jg67b jg67c {
    _jg_stored `jg_g' "graph_options title"
    local jg_ok "`jg_ok'`r(ok)'"
}
mata: st_global("JG_WANT", _jg_pq("x2" + char(36) + "J6_G " + char(96) + "jgnone" + char(39)))
_jg_stored jg67b "graph_options xtitle2"
local jg_ok "`jg_ok'`r(ok)'"
tempfile jg_p67
_jg_build "`jg_p67'.html"
local jg_rb = r(rc)
mata: st_global("JG_WANT", st_local("jg_M"))
_jg_drawn Title
local jg_d = r(n)
capture erase "`jg_p67'.html"
capture dash clear
capture erase "`jg_p67'o.html"
local jg_d1 = 0
local jg_row1 ""
capture noisily dash scatter mpg weight if make != "\$J6_G" & foreign == 1, title("A\$J6_G B \`=1+1' C \`=filewrite(c(tmpdir)+char(106)+char(54)+char(55),char(120))' D \`jgnone' E") saving("`jg_p67'o.html")
local jg_r4 = _rc
if `jg_r4' == 0 {
    global JG_PAGE "`jg_p67'o.html"
    mata: st_global("JG_WANT", st_local("jg_M"))
    _jg_drawn Title
    local jg_d1 = r(n)
    python: _jg_rows()
    local jg_row1 "$JG_ROWS"
}
capture erase "`jg_p67'o.html"
capture confirm file "`jg_sent'"
local jg_ran = (_rc == 0)
display as text "  macro -- rc: `jg_r1' `jg_r2' `jg_r3' `jg_r4'  stored as typed (3 titles, xti2): `jg_ok'  build: `jg_rb'  drawn as typed: `jg_d' of 3  one-line: `jg_d1' [`jg_row1'] of Stata's `jg_nl'  filewrite ran: `jg_ran'"
assert `jg_r1' == 0 & `jg_r2' == 0 & `jg_r3' == 0 & `jg_r4' == 0
assert "`jg_ok'" == "1111"
assert `jg_rb' == 0 & "`jg_d'" == "3"
assert "`jg_d1'" == "1" & "`jg_row1'" == "`jg_nl'"
assert `jg_ran' == 0
display "JSE-67 PASS: a macro in a title in paren and || mode and on the one-line form is stored and drawn as typed, and nothing runs"
capture dash clear
macro drop J6_*

// ----------------------------------------------------------------
// JSE-68 -- name() and saving() holding a macro, or a quote: the text as
// typed is judged, never what a global holds
// ----------------------------------------------------------------
// name(\$J6_N) was expanded and the graph registered under what J6_N held;
// name(`"q"7"') stopped with Stata's r(303), "equation [a-zA-Z_] not
// found"; saving("\$J6_D...") was expanded, so the page was written where
// J6_D pointed (measured 24sep2026).  Each is now dash's own refusal: a
// name is letters, digits and underscores, and a path holding $ is refused
// by the path check.  twoway expands name(\$J6_N) and names the graph
// hijack, rc 0; it refuses name(`"q"7"'), r(198).  A name holding an =exp
// is refused before any command line could evaluate it: the file it would
// write is checked for.
global J6_N "hijack"
global J6_D "`c(tmpdir)'"
capture erase "`c(tmpdir)'jse68.html"
local jg_sent "`c(tmpdir)'j68"
capture erase "`jg_sent'"
capture dash clear
local jg_l68 "`c(tmpdir)'dash_jse68.log"
_jg_log_on "`jg_l68'"
capture noisily dash scatter mpg weight, name(\$J6_N)
local jg_n1 = _rc
capture noisily dash scatter mpg weight, name(`"q"7"')
local jg_n2 = _rc
capture noisily dash scatter mpg weight, name(\`jgnone')
local jg_n3 = _rc
capture noisily dash scatter mpg weight, saving("\$J6_D/jse68.html")
local jg_n4 = _rc
capture noisily dash scatter mpg weight, name(\`=filewrite(c(tmpdir)+char(106)+char(54)+char(56),char(120))')
local jg_n5 = _rc
_jg_log_off
cert_log_has "`jg_l68'", needle("dash: invalid graph name")
local jg_c1 = r(count)
cert_log_has "`jg_l68'", needle("saving() path contains disallowed characters")
local jg_c2 = r(count)
capture erase "`jg_l68'"
capture confirm file "`c(tmpdir)'jse68.html"
local jg_w = (_rc == 0)
capture erase "`c(tmpdir)'jse68.html"
capture confirm file "`jg_sent'"
local jg_ran = (_rc == 0)
local jg_reg "${dash_graph_registry}"
local jg_hj `"${dash_json_hijack}"'
display as text "  name -- rc: `jg_n1' `jg_n2' `jg_n3' `jg_n4' `jg_n5'  refused in dash's words: `jg_c1' `jg_c2'  registry: [`jg_reg']  page written where J6_D points: `jg_w'  filewrite ran: `jg_ran'"
assert `jg_n1' == 198 & `jg_n2' == 198 & `jg_n3' == 198 & `jg_n4' == 198 & `jg_n5' == 198
assert `jg_c1' == 4 & `jg_c2' == 1
assert "`jg_reg'" == "" & `"`jg_hj'"' == ""
assert `jg_w' == 0
assert `jg_ran' == 0
display "JSE-68 PASS: a name() or saving() holding a macro, an =exp or a quote is judged as typed and refused in dash's words, and nothing runs"
capture dash clear
macro drop J6_*

// ----------------------------------------------------------------
// JSE-69 -- a macro in the values dash checks or keeps: by()'s title, a
// legend() word, text(), bw(), mlabel(), colormissing(), a weight and a
// weight expression, a scatteri label and mcolor()
// ----------------------------------------------------------------
// Each value is judged as typed: by()'s title and text() are kept, with no
// =exp run; legend(\$J6_T) is not the word top that J6_T holds, so it is
// kept, where twoway expands it and refuses top, r(198); bw() and mlabel()
// are refused showing the text, where both were expanded to nothing and
// dropped with rc 0; colormissing() is named in the note; a weight
// [aw=\$J6_W] is not the variable J6_W holds -- Stata's syntax refuses the
// text as typed, "$J6_W invalid name", r(198) -- where it weighted by price
// with rc 0; a weight expression is refused showing the text as typed,
// where it showed J6_G's value; a scatteri label and
// mcolor() are kept as typed; a bare string after the comma, kept by
// the catch-all, is named as typed; and mlabel() on histogram, which
// twoway never reads, is dropped, where read again it was refused, r(111)
// (measured 24sep2026).
global J6_G "Audi 5000"
global J6_T "top"
global J6_W "price"
local jg_sent "`c(tmpdir)'j69"
capture erase "`jg_sent'"
capture dash clear
local jg_l69 "`c(tmpdir)'dash_jse69.log"
_jg_log_on "`jg_l69'"
capture noisily dash scatter mpg weight, by(foreign, title("b\$J6_G \`=filewrite(c(tmpdir)+char(106)+char(54)+char(57),char(120))'")) name(jg69a)
local jg_v1 = _rc
capture noisily dash scatter mpg weight, text(30 3000 "t\$J6_G") legend(\$J6_T) name(jg69b)
local jg_v2 = _rc
capture noisily dash lpoly mpg weight, bw("\`jgnone'") name(jg69c)
local jg_v3 = _rc
capture noisily dash scatter mpg weight, mlabel("\`jgnone'") name(jg69d)
local jg_v4 = _rc
capture noisily dash line mpg weight, colormissing("\`jgnone'") name(jg69e)
local jg_v5 = _rc
capture noisily dash lfit mpg weight [aw=\$J6_W], name(jg69f)
local jg_v6 = _rc
capture noisily dash scatteri 20 3000 "s\$J6_G", name(jg69g)
local jg_v7 = _rc
capture noisily dash scatter mpg weight, mcolor("\$J6_G") name(jg69h)
local jg_v8 = _rc
// A bare string after the comma is kept by dash's catch-all and named in
// the note, as typed, never as the value J6_G holds.
capture noisily dash scatter mpg weight, "\$J6_G" name(jg69i)
local jg_v9 = _rc
// A weight expression is refused as one dash cannot evaluate, and shown as
// typed; mlabel() on histogram, which twoway never reads, is dropped
// before the value rules, so a reference to nothing is not refused there
// (twoway: rc 0).
capture noisily dash lfit mpg weight [aw=cond(make=="\$J6_G",1,2)], name(jg69j)
local jg_v10 = _rc
capture noisily dash histogram mpg, mlabel("\`jgnone'") name(jg69k)
local jg_v11 = _rc
_jg_log_off
cert_log_has "`jg_l69'", needle("J6_G()")
local jg_w6 = r(count)
cert_log_has "`jg_l69'", needle("Audi 5000")
local jg_w7 = r(count)
cert_log_has "`jg_l69'", needle("bwidth() must be a positive number (got: ")
local jg_w1 = r(count)
cert_log_has "`jg_l69'", needle("mlabel(): variable ")
local jg_w2 = r(count)
// Shown as typed, in dash's words: the refusals end "jgnone')" and
// "jgnone' not found", which the echoed commands -- "jgnone'")" -- do not.
cert_log_has "`jg_l69'", needle("jgnone')")
local jg_w3 = r(count)
cert_log_has "`jg_l69'", needle("jgnone' not found")
local jg_w3 = `jg_w3' + r(count)
cert_log_has "`jg_l69'", needle("ignoring unsupported option(s): colormissing()")
local jg_w4 = r(count)
cert_log_has "`jg_l69'", needle("J6_W invalid name")
local jg_w5 = r(count)
cert_log_has "`jg_l69'", needle(`"J6_G",1,2)] must name one variable"')
local jg_w8 = r(count)
capture erase "`jg_l69'"
local jg_ok ""
mata: st_global("JG_WANT", "foreign, title(" + _jg_pq("b" + char(36) + "J6_G " + char(96) + "=filewrite(c(tmpdir)+char(106)+char(54)+char(57),char(120))" + char(39)) + ")")
_jg_stored jg69a "graph_options by"
local jg_ok "`jg_ok'`r(ok)'"
mata: st_global("JG_WANT", "30 3000 " + _jg_pq("t" + char(36) + "J6_G"))
_jg_stored jg69b "graph_options text"
local jg_ok "`jg_ok'`r(ok)'"
mata: st_global("JG_WANT", char(36) + "J6_T")
_jg_stored jg69b "graph_options legend"
local jg_ok "`jg_ok'`r(ok)'"
mata: st_global("JG_WANT", "s" + char(36) + "J6_G")
_jg_stored jg69g "plots 0 values 0 2"
local jg_ok "`jg_ok'`r(ok)'"
mata: st_global("JG_WANT", char(36) + "J6_G")
_jg_stored jg69h "plots 0 options mcolor"
local jg_ok "`jg_ok'`r(ok)'"
local jg_reg "${dash_graph_registry}"
capture confirm file "`jg_sent'"
local jg_ran = (_rc == 0)
display as text "  values -- rc: `jg_v1' `jg_v2' `jg_v3' `jg_v4' `jg_v5' `jg_v6' `jg_v7' `jg_v8' `jg_v9' `jg_v10' `jg_v11'  in dash's words: `jg_w1' `jg_w2' `jg_w4' `jg_w5'  shown as typed: `jg_w3' `jg_w6' `jg_w8'  the global's value shown: `jg_w7'  stored as typed: `jg_ok'  registry: [`jg_reg']  filewrite ran: `jg_ran'"
assert `jg_v1' == 0 & `jg_v2' == 0 & `jg_v3' == 198 & `jg_v4' == 111
assert `jg_v5' == 0 & `jg_v6' == 198 & `jg_v7' == 0 & `jg_v8' == 0 & `jg_v9' == 0
assert `jg_v10' == 198 & `jg_v11' == 0
assert `jg_w1' == 1 & `jg_w2' == 1 & `jg_w4' == 1 & `jg_w5' == 1 & `jg_w3' == 2
assert `jg_w6' == 1 & `jg_w7' == 0 & `jg_w8' == 1
assert "`jg_ok'" == "11111"
assert "`jg_reg'" == "jg69a jg69b jg69e jg69g jg69h jg69i jg69k"
assert `jg_ran' == 0
display "JSE-69 PASS: a macro in a value dash checks or keeps is judged and kept as typed, and nothing runs"
capture dash clear
macro drop J6_*

macro drop JG_*


// ================================================================
// JSE-70 -- the dash entry hands dash kpi, dash build and dash serve
// their text as written
// ================================================================
// The entry forwards each subcommand as a command line built from a
// macro -- _dash_kpi `_args', _dash_build `_args', _dash_serve `_args' --
// and a command line built from a macro is expanded again: text a user
// typed escaped, so that it reaches dash as written, was expanded a
// second time before the subcommand saw it.  macval() hands it on as
// written.  JSE-65..69 hold the plot route to that; JSE-58 drives
// _dash_kpi and _dash_build directly, past the entry.  Here each of the
// three is typed through the entry: a global, an =exp, an =exp that
// would write a file and a local reference to nothing, in a KPI title,
// a dashboard title and subtitle, and dash serve's title.  What dash
// must receive is built in Mata; the file must not exist afterwards.
// ----------------------------------------------------------------
qui sysuse auto, clear
global J7_G "Audi 5000"
local j7_sent "`c(tmpdir)'j70"
capture erase "`j7_sent'"
confirm new file "`j7_sent'"
mata: st_global("J7_WANT", "A" + char(36) + "J7_G B " + char(96) + "=1+1" + char(39) + " C " + ///
    char(96) + "=filewrite(c(tmpdir)+char(106)+char(55)+char(48),char(120))" + char(39) + ///
    " D " + char(96) + "j7none" + char(39) + " E")
mata: st_global("J7_WSUB", "s" + char(36) + "J7_G " + char(96) + "=1+1" + char(39))
capture dash clear
dash scatter mpg weight, name(j70g)
capture noisily dash kpi mean(price), title("A\$J7_G B \`=1+1' C \`=filewrite(c(tmpdir)+char(106)+char(55)+char(48),char(120))' D \`j7none' E") fmt(%9.2f) name(j70k)
local j7_r1 = _rc
mata: st_local("j7_ok", strofreal(st_global("dash_kpi_j70k__tit") == st_global("J7_WANT")))
mata: _dash_say("txt", "  kpi title stored: [", st_global("dash_kpi_j70k__tit"), "]")
tempfile j7_p
capture noisily dash build, title("A\$J7_G B \`=1+1' C \`=filewrite(c(tmpdir)+char(106)+char(55)+char(48),char(120))' D \`j7none' E") subtitle("s\$J7_G \`=1+1'") saving("`j7_p'.html") replace nobrowser
local j7_r2 = _rc
mata: st_local("j7_ok", st_local("j7_ok") + strofreal(st_global("dash_opts_title") == st_global("J7_WANT")))
mata: st_local("j7_ok", st_local("j7_ok") + strofreal(st_global("dash_opts_subtitle") == st_global("J7_WSUB")))
mata: _dash_say("txt", "  build title stored: [", st_global("dash_opts_title"), "]")
// dash serve, run whole against a stand-in renderer that copies the spec
// it is handed to spec.json beside itself and exits (JSE-54's method), so
// no server starts.  The command is built in Mata, as the user's typed
// text reaches dash, and run through macval().
tempfile j7_sb
local j7_stub "`j7_sb'_stub"
capture mkdir "`j7_stub'"
tempname j7_fh
file open `j7_fh' using "`j7_stub'/dash_render.py", write text replace
file write `j7_fh' `"import os, shutil, sys"' _n
file write `j7_fh' `"_a = sys.argv[1:]"' _n
file write `j7_fh' `"_d = os.path.dirname(os.path.abspath(__file__))"' _n
file write `j7_fh' `"shutil.copyfile(_a[_a.index("--spec") + 1], os.path.join(_d, "spec.json"))"' _n
file write `j7_fh' `"open(_a[_a.index("--output") + 1], "w", encoding="utf-8").write("# app")"' _n
file close `j7_fh'
capture erase "`j7_stub'/spec.json"
global J7_SPECFILE "`j7_stub'/spec.json"
mata: st_local("j7_cmd", "dash serve, title(" + char(34) + st_global("J7_WANT") + char(34) + ") nobrowser")
adopath ++ "`j7_stub'"
capture noisily {
    _dash_find_render
    local j7_found `"`r(fn)'"'
    capture noisily `macval(j7_cmd)'
    local j7_r3 = _rc
}
local j7_r4 = _rc
adopath - "`j7_stub'"
mata: st_local("j7_isstub", strofreal(strpos(st_local("j7_found"), "_stub") > 0))
python:
import json as _j7_json
from sfi import Macro as _j7_M
try:
    with open(_j7_M.getGlobal("J7_SPECFILE"), encoding="utf-8") as _j7_fh:
        _j7_spec = _j7_json.load(_j7_fh)
    _j7_M.setGlobal("J7_OK", "1" if _j7_spec["build_options"]["title"] == _j7_M.getGlobal("J7_WANT") else "0")
except (OSError, ValueError, KeyError, TypeError):
    _j7_M.setGlobal("J7_OK", "0")
end
local j7_ok "`j7_ok'$J7_OK"
capture confirm file "`j7_sent'"
local j7_ran = (_rc == 0)
display as text "  rc: `j7_r1' `j7_r2' `j7_r3' `j7_r4'  stand-in ran: `j7_isstub'  stored as typed: `j7_ok'  filewrite ran: `j7_ran'"
assert `j7_r1' == 0 & `j7_r2' == 0 & `j7_r3' == 0 & `j7_r4' == 0
assert `j7_isstub' == 1
assert "`j7_ok'" == "1111"
assert `j7_ran' == 0
capture erase "`j7_p'.html"
capture erase "`j7_stub'/spec.json"
display "JSE-70 PASS: the dash entry hands kpi, build and serve their text as written, and nothing runs"
capture dash clear
macro drop J7_*


// ----------------------------------------------------------------
// JSE-71 -- a by() whose text holds a dollar sign, a backslash, a backtick
// or a nested compound quote draws twoway's two panels.  The renderer held
// the whole by() text to its injection pattern, so each of these drew one
// panel of 74 without a word (measured 24sep2026 at 2df1900; BUGS.md "A
// by() whose text holds a backtick, a dollar sign or a backslash draws no
// panels, without a word").  twoway draws the two panels for the first
// three (measured the same day, graph export .svg: Domestic and Foreign);
// it refuses the typed-escaped backtick, r(132), which dash stores as
// typed.  The served app is test_server_facets.py's
// TestAByTextHoldingMacroCharactersFacets.
// ----------------------------------------------------------------
qui sysuse auto, clear
capture dash clear
quietly count if foreign == 0
local j71_nd = r(N)
quietly count if foreign == 1
local j71_nf = r(N)
capture twoway scatter mpg weight, by(foreign, title("Cost in \$US")) nodraw
local j71_t1 = _rc
capture twoway scatter mpg weight, by(foreign, note("a\b c")) nodraw
local j71_t2 = _rc
capture twoway scatter mpg weight, by(foreign, title(`"a `"b"' c"')) nodraw
local j71_t3 = _rc
capture noisily dash scatter mpg weight, by(foreign, title("Cost in \$US")) name(j71a)
local j71_r1 = _rc
capture noisily dash scatter mpg weight, by(foreign, note("a\b c")) name(j71b)
local j71_r2 = _rc
capture noisily dash scatter mpg weight, by(foreign, title(`"a `"b"' c"')) name(j71c)
local j71_r3 = _rc
capture noisily dash scatter mpg weight, by(foreign, subtitle("tick \`x")) name(j71d)
local j71_r4 = _rc
local j71_ok ""
mata: st_global("JG_WANT", "foreign, title(" + _jg_pq("Cost in " + char(36) + "US") + ")")
_jg_stored j71a "graph_options by"
local j71_ok "`j71_ok'`r(ok)'"
mata: st_global("JG_WANT", "foreign, note(" + _jg_pq("a" + char(92) + "b c") + ")")
_jg_stored j71b "graph_options by"
local j71_ok "`j71_ok'`r(ok)'"
mata: st_global("JG_WANT", "foreign, title(" + _jg_cq("a " + _jg_cq("b") + " c") + ")")
_jg_stored j71c "graph_options by"
local j71_ok "`j71_ok'`r(ok)'"
mata: st_global("JG_WANT", "foreign, subtitle(" + _jg_pq("tick " + char(96) + "x") + ")")
_jg_stored j71d "graph_options by"
local j71_ok "`j71_ok'`r(ok)'"
tempfile j71_p
_jg_build "`j71_p'.html"
local j71_rb = r(rc)
local j71_rows "`r(rows)'"
capture erase "`j71_p'.html"
display as text "  twoway rc: `j71_t1' `j71_t2' `j71_t3'  dash rc: `j71_r1' `j71_r2' `j71_r3' `j71_r4'  stored: `j71_ok'  build: `j71_rb'"
display as text "  rows: [`j71_rows'] -- two panels each, Stata's `j71_nf' and `j71_nd'"
assert `j71_t1' == 0 & `j71_t2' == 0 & `j71_t3' == 0
assert `j71_r1' == 0 & `j71_r2' == 0 & `j71_r3' == 0 & `j71_r4' == 0
assert "`j71_ok'" == "1111"
assert `j71_rb' == 0
assert "`j71_rows'" == "`j71_nf' `j71_nf' `j71_nf' `j71_nf' `j71_nd' `j71_nd' `j71_nd' `j71_nd'"
display "JSE-71 PASS: a by() whose text holds a dollar sign, a backslash, a backtick or a nested compound quote draws the two panels"
capture dash clear

// ----------------------------------------------------------------
// JSE-72 -- a nested compound quote is accepted, as twoway accepts it, and
// drawn as twoway draws it: title(`"a `"b"' c"') is the one line a `"b"' c
// (twoway's SVG export, measured 24sep2026), and a legend label in the same
// form is that key's text.  dash refused both, "unterminated quotation in
// the plot specification", r(198): its quote scanner closed a compound
// quote at the first "' (BUGS.md "A compound quote nested inside another
// is refused, where twoway accepts it").  The legend label reader is
// test_textbox_multiline.py's TestALegendLabelIsReadAsStataReadsIt.
// ----------------------------------------------------------------
capture twoway (scatter mpg weight) (line mpg weight), title(`"a `"b"' c"') legend(label(1 `"k `"1"' x"') label(2 `"'90s l2"')) nodraw
local j72_tw = _rc
capture noisily dash (scatter mpg weight) (line mpg weight), title(`"a `"b"' c"') legend(label(1 `"k `"1"' x"') label(2 `"'90s l2"')) name(j72a)
local j72_rc = _rc
mata: st_global("JG_WANT", _jg_cq("a " + _jg_cq("b") + " c"))
_jg_stored j72a "graph_options title"
local j72_ok "`r(ok)'"
tempfile j72_p
_jg_build "`j72_p'.html"
local j72_rb = r(rc)
local j72_dr ""
mata: st_global("JG_WANT", "a " + _jg_cq("b") + " c")
_jg_drawn Title
local j72_dr "`j72_dr'`r(n)'"
mata: st_global("JG_WANT", "k " + _jg_cq("1") + " x")
_jg_drawn LegendItem
local j72_dr "`j72_dr'`r(n)'"
mata: st_global("JG_WANT", char(39) + "90s l2")
_jg_drawn LegendItem
local j72_dr "`j72_dr'`r(n)'"
capture erase "`j72_p'.html"
display as text "  twoway rc `j72_tw'  dash rc `j72_rc'  stored `j72_ok'  build `j72_rb'  drawn (title, key 1, key 2): `j72_dr'"
assert `j72_tw' == 0 & `j72_rc' == 0
assert "`j72_ok'" == "1"
assert `j72_rb' == 0
assert "`j72_dr'" == "111"
display "JSE-72 PASS: a nested compound title and legend label are accepted and drawn as twoway draws them"
capture dash clear

display ""
display "All JSON escaping tests PASSED."
