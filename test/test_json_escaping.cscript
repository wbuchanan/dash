// JSE-30 -- ~ is Stata's not: if ~foreign names foreign, which Stata now
// evaluates, so it is no longer exported for a renderer (WP-27).
dash scatter mpg weight if ~foreign, name(jse30)
local j2_v30 ""
mata: _dash_extract_qual_vars(st_global("dash_json_jse30"), "j2_v30")
