// JSE-37 -- a filter() label written with compound quotes, as dash build
// hands filter() on: _dash_json_str returned label() for it -- the label
// gone, rc 0 (measured at ad13a0f) -- and it is now kept whole.  dash build
// hands the text on as written, filter(<text>) through macval(), since a
// "' in a label closed the filter(`"<text>"') it used (JSE-57).
dash scatter mpg weight, name(jse37)
local j2_f `"weight, type(range) label(`"Curb "weight""')"'
tempfile j2_s37 j2_d37
_dash_prepare_spec, cmdname("dash build") specpath("`j2_s37'") datapath("`j2_d37'") filter(`macval(j2_f)')
mata: st_global("J2_SPECTXT", invtokens(cat(st_local("j2_s37"))', ""))
global J2_FROM "J2_SPECTXT"
global J2_PATH "build_options filter"
global J2_WANT `"`j2_f'"'
python: _j2_json_field()
local j2_ok37 "$J2_OK"
display as text "  filter kept whole: `j2_ok37'"
assert "`j2_ok37'" == "1"
display "JSE-37 PASS: a compound-quoted filter() label is stored whole"
capture dash clear

python: _j2_gone = _j2_sys.modules.pop("_j2_dash_render", None)
macro drop J2_*


// ================================================================
// JSE-38 -- every C0 byte reads back as itself
// ================================================================
// JSE-01 asserts that no control byte survives raw and JSE-02..04 pin
// seven escapes.  Neither asserts that an escape stands for the byte it
// replaced: a \u00XX with its two digits swapped is valid JSON and a
// different character.  Python's json module reads each one back, as the
// renderer's does.
local jse38_bad ""
forvalues c = 1/31 {
    local raw = "a" + char(`c') + "b"
    _dash_json_str `"`raw'"' _esc
    python: import json, sfi; sfi.Macro.setLocal("_jse_rt", "1" if json.loads('"' + sfi.Macro.getLocal("_esc") + '"') == "a" + chr(int(sfi.Macro.getLocal("c"))) + "b" else "0")
    if "`_jse_rt'" != "1" local jse38_bad "`jse38_bad' `c'"
}
if "`jse38_bad'" != "" display as error "escaped C0 byte(s) read back as something else:`jse38_bad'"
assert "`jse38_bad'" == ""
display "JSE-38 PASS: each of the 31 C0 bytes reads back as itself"


// ================================================================
// JSE-39..41 -- a leading ~/ is expanded where the file is written
// ================================================================
// _dash_validate_path expands a leading ~/ and publishes the result as
// _dash_vpath, and each of its three callers must read it back: a path
// still starting with ~ reaches Python, which expands nothing (measured
// before WP-08: r(7102)).  PV-17 tests the validator alone.  With any one
// caller's read-back removed, PV-01..19, JSE-01..37 and P2/P8 all passed
// (WP-24).  HOME is pointed at a scratch directory through Python -- Stata
// reads the process environment -- so nothing is written in the real home
// directory, and it is put back before anything is asserted.
local jse_home0 : environment HOME
tempfile jse_hb
local jse_fh "`jse_hb'_home"
mata: mkdir(st_local("jse_fh"))
python: import os, sfi; os.environ["HOME"] = sfi.Macro.getLocal("jse_fh")
local jse_hnow : environment HOME
qui sysuse auto, clear
capture dash clear
capture noisily dash scatter mpg weight, saving("~/jse39.html") replace
local jse39rc = _rc
capture noisily dash scatter mpg weight, name(jse40)
capture noisily dash build, saving("~/jse40.html") replace nobrowser
local jse40rc = _rc
capture noisily dash build, saving("~/jse41.py") server replace
local jse41rc = _rc
python: import os, sfi; _jh = sfi.Macro.getLocal("jse_home0"); (os.environ.__setitem__("HOME", _jh) if _jh else os.environ.pop("HOME", None))
local jse_hback : environment HOME
capture dash clear
foreach f in 39.html 40.html 41.py {
    capture confirm file "`jse_fh'/jse`f'"
    local jse_w`=substr("`f'", 1, 2)' = (_rc == 0)
    capture erase "`jse_fh'/jse`f'"
}
capture rmdir "`jse_fh'"
assert `"`jse_hback'"' == `"`jse_home0'"'
assert `"`jse_hnow'"' == `"`jse_fh'"'
assert `jse39rc' == 0
assert `jse_w39' == 1
display "JSE-39 PASS: the one-line form writes saving(~/x.html) under HOME"
assert `jse40rc' == 0
assert `jse_w40' == 1
display "JSE-40 PASS: dash build writes saving(~/x.html) under HOME"
assert `jse41rc' == 0
assert `jse_w41' == 1
display "JSE-41 PASS: dash build, server writes saving(~/x.py) under HOME"


// ================================================================
// JSE-42..49 -- text holding a double quote and an apostrophe, through
// the plot commands, as typed
// ================================================================
// A text that opens with an apostrophe inside double quotes -- the title
// "'90s cars", the literal "' or 1 or '" -- holds a double quote followed
// by an apostrophe, which is what closes a compound quote.  The plot chain
// put the command inside compound quotes at every step: the segment handed
// to _dash_process_segment's -args-, the Mata line that finds the options'
// comma, if tests of the form  if `"`x'"' != "",  _dash_graph_qualifier's
// regexr(), _dash_register_graph's -args-.  Measured 24sep2026, with the
// entry and the UTF-8 gates already reading the command by value:
//   * title("'90s cars") r(100) ") required" and its compound form r(133)
//     "unknown function ()" -- in comma mode, in a plot group, after || and
//     on the one-line form; after a paren command's comma r(109).
//     subtitle(), note(), caption() and a legend label alike.
//   * if make == "' or 1 or '" on a plot: r(198) "invalid syntax".
//   * after the plot groups, if make != "'x" registered with rc 0 -- the
//     qualifier cut to  make !=  and the graph stored as the one word x.
// twoway, measured the same day, refuses most of the plain forms --
// title("'90s cars") r(109), subtitle("'90s") and a legend label r(100),
// if make == "' or 1 or '" r(109), if make != "'x" & foreign == 1 r(198)
// -- and takes the compound ones, except  if make != `"'x"' & foreign == 1,
// r(133).  After the plot groups it takes  if make != "'x" & foreign == 1
// (rc 0) and refuses  if make == "' or 1 or '"  (r(109)).  dash stores
// every one as typed, plain and compound (the maintainer's request), and
// Stata's own count is the qualifier's oracle.  Each case asserts what the
// registry holds and what the saved page draws, read from its document.
qui sysuse auto, clear
capture dash clear
do "cert_helpers.do"
global dash_nobrowser 1

// Helpers.  JG_PAGE names a saved page; _jg_models() reads its embedded
// document back as the browser reads it (HTML-unescaped, parsed) and
// indexes every model by id -- none when there is no page, so a case whose
// command failed reports what it drew, nothing, rather than stopping.
//   _jg_count()             JG_N: how many models of kind JG_KIND (Title,
//                           Label, LegendItem, LinearAxis -- an axis's
//                           title) draw exactly JG_WANT
//   _jg_title_apostrophes() JG_N: the apostrophes the page's titles draw;
//                           JG_OK: 1 when they draw nothing else but blanks
//                           and line breaks
//   _jg_rows()              JG_ROWS: the rows each Scatter glyph draws,
//                           sorted -- through its view: a layer's own
//                           qualifier in a graph of several layers is a
//                           BooleanFilter over the graph's shared rows
//                           (measured 24sep2026: 22 of 74), and a view
//                           this does not know draws -1
//   _jg_field()             JG_OK: 1 when the registry global named by
//                           JG_FROM, read as JSON and walked down JG_PATH, is
//                           exactly JG_WANT; 0 when it differs, is missing or
//                           is not JSON
// No backslash, backtick or dollar sign is written in the block, and every
// call's value is assigned.  The block is read as an interactive session
// reads it, so it holds no comment line between definitions -- one there
// left the next definition open, and the last one never ran (measured
// 24sep2026) -- and it ends on a statement, not a definition.
python:
import base64 as _jg_b64
import html as _jg_html
import json as _jg_json
import re as _jg_re
from sfi import Macro as _jg_M

def _jg_models():
    try:
        with open(_jg_M.getGlobal("JG_PAGE"), encoding="utf-8") as fh:
            page = fh.read()
    except OSError:
        page = ""
    m = _jg_re.search('<script type="application/json"[^>]*>(.*?)</script>', page, _jg_re.S)
    objs, stack = {}, ([_jg_json.loads(_jg_html.unescape(m.group(1)))] if m else [])
    while stack:
        v = stack.pop()
        if isinstance(v, dict):
            if v.get("type") == "object" and "id" in v and "name" in v:
                objs[v["id"]] = v
            stack.extend(v.values())
        elif isinstance(v, list):
            stack.extend(v)
    return objs

def _jg_text(o):
    a = o.get("attributes", {})
    if o["name"] == "LegendItem":
        t = a.get("label")
    elif "axis_label" in a:
        t = a.get("axis_label")
    else:
        t = a.get("text")
    return t.get("value") if isinstance(t, dict) else t

def _jg_count():
    kind, want = _jg_M.getGlobal("JG_KIND"), _jg_M.getGlobal("JG_WANT")
    n = sum(1 for o in _jg_models().values() if o["name"] == kind and _jg_text(o) == want)
    _jg_M.setGlobal("JG_N", str(n))

def _jg_title_apostrophes():
    texts = [_jg_text(o) or "" for o in _jg_models().values() if o["name"] == "Title"]
    joined = "".join(texts)
    _jg_M.setGlobal("JG_N", str(joined.count(chr(39))))
    _jg_M.setGlobal("JG_OK", "1" if joined.replace(chr(39), "").split() == [] else "0")

def _jg_flags(v):
    if isinstance(v, dict) and v.get("type") == "ndarray":
        raw = v.get("array", {})
        if isinstance(raw, dict) and raw.get("type") == "bytes":
            return list(_jg_b64.b64decode(raw.get("data", "")))
        return list(raw) if isinstance(raw, list) else []
    return list(v) if isinstance(v, list) else []

def _jg_rows():
    objs = _jg_models()
    def ref(v):
        return objs.get(v["id"], v) if isinstance(v, dict) and "id" in v else v
    out = []
    for o in objs.values():
        if o["name"] != "GlyphRenderer":
            continue
        a = o.get("attributes", {})
        if ref(a.get("glyph", {})).get("name") != "Scatter":
            continue
        data = ref(a.get("data_source", {})).get("attributes", {}).get("data", {})
        n = 0
        for key, val in data.get("entries", []):
            if isinstance(val, dict) and val.get("type") == "ndarray":
                n = max(n, int(val.get("shape", [0])[0]))
            elif isinstance(val, list):
                n = max(n, len(val))
        filt = ref(ref(a.get("view", {})).get("attributes", {}).get("filter", {}))
        kind, fa = filt.get("name", "AllIndices"), filt.get("attributes", {})
        if kind == "BooleanFilter":
            n = sum(1 for f in _jg_flags(fa.get("booleans", []))[:n] if f)
        elif kind == "IndexFilter":
            n = len(_jg_flags(fa.get("indices", [])))
        elif kind != "AllIndices":
            n = -1
        out.append(n)
    _jg_M.setGlobal("JG_ROWS", " ".join(str(n) for n in sorted(out)))

def _jg_field():
    try:
        v = _jg_json.loads(_jg_M.getGlobal(_jg_M.getGlobal("JG_FROM")))
        for part in _jg_M.getGlobal("JG_PATH").split():
            v = v[int(part)] if part.isdigit() else v[part]
        ok = v == _jg_M.getGlobal("JG_WANT")
    except (ValueError, KeyError, IndexError, TypeError):
        ok = False
    _jg_M.setGlobal("JG_OK", "1" if ok else "0")

_jg_ready = True
end

// r(ok): the named graph's stored value at the path is exactly JG_WANT.
// A python line inside a program runs in a namespace of its own, where the
// block above defined nothing (measured 24sep2026: NameError, r(7102)), so
// the three programs reach the helpers through __main__.
capture program drop _jg_stored
program define _jg_stored, rclass
    version 16.0
    args g path
    global JG_FROM "dash_json_`g'"
    global JG_PATH "`path'"
    python: __import__("__main__")._jg_field()
    return local ok "$JG_OK"
end

// r(n): how many models of the kind named on the page JG_PAGE names draw
// exactly JG_WANT.
capture program drop _jg_drawn
program define _jg_drawn, rclass
    version 16.0
    args kind
    global JG_KIND "`kind'"
    python: __import__("__main__")._jg_count()
    return local n "$JG_N"
end

// r(rc), r(rows): dash build of the whole registry to the page named, and
// the rows its scatter glyphs draw.  JG_PAGE is left naming the page.
capture program drop _jg_build
program define _jg_build, rclass
    version 16.0
    args page
    capture erase "`page'"
    capture noisily dash build, saving("`page'") replace nobrowser
    local rc = _rc
    global JG_PAGE "`page'"
    global JG_ROWS ""
    if `rc' == 0 python: __import__("__main__")._jg_rows()
    return scalar rc = `rc'
    return local rows "$JG_ROWS"
end

// _jg_log_on / _jg_log_off: what the commands between them print, in the
// log named, at linesize 255.  The commands are typed between the two, at
// the top level, because no program can be handed a command holding "' in
// compound quotes -- the very defect these cases are about.
capture program drop _jg_log_on
program define _jg_log_on
    version 16.0
    args logfile
    capture log close _jglog
    capture erase "`logfile'"
    global JG_LS = c(linesize)
    set linesize 255
    quietly log using "`logfile'", name(_jglog) text replace
end
capture program drop _jg_log_off
program define _jg_log_off
    version 16.0
    quietly log close _jglog
    set linesize $JG_LS
end

// The texts the cases expect, made from char() so no expected value is
// typed inside the quotes it is about: _jg_pq() puts a text in plain
// quotes, _jg_cq() in compound quotes.
mata:
string scalar _jg_pq(string scalar s)
{
    return(char(34) + s + char(34))
}
string scalar _jg_cq(string scalar s)
{
    return(char(96) + char(34) + s + char(34) + char(39))
}
end

