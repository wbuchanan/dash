assert `jg_t1' == 0 & `jg_t2' == 0 & `jg_t3' == 0
assert "`jg_tk'" == "11111111"
assert `jg_rb3' == 0
// WP-28 B7: _dash_add_secondary_axes now reads {n}title2 through
// _dash_textbox, so jg46k's RIGHT axis draws "line 1\nline 2" too --
// the count of LinearAxis models with that exact label goes from 1 to 2
// (jg46i's left axis, and now jg46k's right one).
assert "`jg_ta'" == "211"
display "JSE-46 PASS: subtitle, note, caption, a legend label, by()'s title, text(), an unknown option and the axis and side titles are stored as typed, drawn or named"
capture dash clear

// jg46l (WP-28 B7): dash's right axis reads ytitle2() the way twoway
// reads ytitle(..., axis(2)) on its one axis -- no quotes, joined lines --
