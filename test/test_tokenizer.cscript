*! test_tokenizer.cscript
*! Certification script for the dash_parse.mata tokenizer (Pass 1).
*!
*! Tests: P1A-20 through P1A-30
*!
*! Usage:  do test/test_tokenizer.cscript
*!         (or cscript test_tokenizer using test/test_tokenizer.cscript)
*!
*! All assertions use -assert- so failures abort with a non-zero return code.
*! Version: 1.0.0  25mar2026

cscript "dash_parse.mata tokenizer" adodir ".."

// ----------------------------------------------------------------
// Setup: compile the Mata source and load a small dataset so that
// `confirm variable' calls inside the parser have something to work with.
// ----------------------------------------------------------------
qui sysuse auto, clear
do "../dash_parse.mata"

// ================================================================
// Helper: call the tokenizer via dash_parse and retrieve the JSON.
// We use a minimal spec with known variables to isolate tokenizer
// behaviour rather than full parser logic.
// We expose the tokenizer indirectly by parsing a valid spec and
// checking round-trip fidelity at the JSON output level.
// For direct tokenizer unit tests we call the Mata functions directly.
// ================================================================

// ----------------------------------------------------------------
// P1A-20 — single word tokenises to single WORD token
// ----------------------------------------------------------------
mata:
{
    tokens = _tokenize("scatter")
    assert(rows(tokens) == 1)
    assert(tokens[1,1] == strofreal(WORD()))
    assert(tokens[1,2] == "scatter")
}
end

display "P1A-20 PASS: single word → single WORD token"

// ----------------------------------------------------------------
// P1A-21 — double-quoted string preserved as QUOTED_STRING
// ----------------------------------------------------------------
mata:
{
    tokens = _tokenize(`""hello world""')
    assert(rows(tokens) == 1)
    assert(tokens[1,1] == strofreal(QUOTED_STRING()))
    assert(tokens[1,2] == "hello world")
}
end

display "P1A-21 PASS: double-quoted string → QUOTED_STRING token"

// ----------------------------------------------------------------
// P1A-22 — compound-quoted string `"..."' tokenises correctly
// ----------------------------------------------------------------
mata:
{
    // simulate `"compound string"'
    tokens = _tokenize(`"`"compound string"'"')
    assert(rows(tokens) == 1)
    assert(tokens[1,1] == strofreal(QUOTED_STRING()))
    assert(tokens[1,2] == "compound string")
}
end

display "P1A-22 PASS: compound-quoted string → QUOTED_STRING token"

// ----------------------------------------------------------------
// P1A-23 — parenthesis depth tracking: nested option parens
//           do not split incorrectly
//           e.g. "scatter mpg weight, mc(rgb(255 0 0))"
//           The inner ( and ) belong to the option value.
// ----------------------------------------------------------------
mata:
{
    tokens = _tokenize("foo bar, opt(rgb(255 0 0))")
    // Expected tokens: WORD(foo) WORD(bar) COMMA WORD(opt)
    //                  OPEN_PAREN WORD(rgb) OPEN_PAREN WORD(255) WORD(0) WORD(0)
    //                  CLOSE_PAREN CLOSE_PAREN
    // Verify total OPEN_PAREN count == 2, CLOSE_PAREN count == 2
    nopen = 0; nclose = 0
    for (r = 1; r <= rows(tokens); r++) {
        if (tokens[r,1] == strofreal(OPEN_PAREN()))  nopen  = nopen  + 1
        if (tokens[r,1] == strofreal(CLOSE_PAREN())) nclose = nclose + 1
    }
    assert(nopen  == 2)
    assert(nclose == 2)
}
end

display "P1A-23 PASS: nested option parens produce correct OPEN/CLOSE_PAREN counts"

// ----------------------------------------------------------------
// P1A-24 — comma at depth 0 produces COMMA token
// ----------------------------------------------------------------
mata:
{
    tokens = _tokenize("scatter mpg weight, mcolor(red)")
    commas = 0
    for (r = 1; r <= rows(tokens); r++) {
        if (tokens[r,1] == strofreal(COMMA())) commas = commas + 1
    }
    assert(commas == 1)
}
end

display "P1A-24 PASS: comma at depth 0 → COMMA token"

// ----------------------------------------------------------------
// P1A-25 — comma inside option parens does NOT produce a COMMA token
//           e.g. "mcolor(red,blue)" — the comma is inside parens
// ----------------------------------------------------------------
mata:
{
    // commas inside parens are still emitted as COMMA tokens by the
    // tokenizer (which is depth-agnostic at token level), but the
    // structural parser interprets depth.  The tokenizer itself does
    // emit COMMA for all commas.  This test verifies total comma count:
    // one inside parens, one at depth 0.
    tokens = _tokenize("a b, opt(x,y)")
    commas = 0
    for (r = 1; r <= rows(tokens); r++) {
        if (tokens[r,1] == strofreal(COMMA())) commas = commas + 1
    }
    // Should be 2: one top-level, one inside parens
    assert(commas == 2)
}
end

display "P1A-25 PASS: comma count correct (top-level + inside parens)"

// ----------------------------------------------------------------
// P1A-26 — || produces PIPE_PIPE token
// ----------------------------------------------------------------
mata:
{
    tokens = _tokenize("scatter mpg weight || lfit mpg weight")
    pipes = 0
    for (r = 1; r <= rows(tokens); r++) {
        if (tokens[r,1] == strofreal(PIPE_PIPE())) pipes = pipes + 1
    }
    assert(pipes == 1)
    // verify token text
    for (r = 1; r <= rows(tokens); r++) {
        if (tokens[r,1] == strofreal(PIPE_PIPE())) {
            assert(tokens[r,2] == "||")
        }
    }
}
end

display "P1A-26 PASS: || → PIPE_PIPE token"

// ----------------------------------------------------------------
// P1A-27 — empty input returns empty token array without error
// ----------------------------------------------------------------
mata:
{
    tokens = _tokenize("")
    assert(rows(tokens) == 0)
}
end

display "P1A-27 PASS: empty input → 0 tokens, no error"

// ----------------------------------------------------------------
// P1A-28 — 1000-character input (resource exhaustion boundary)
// ----------------------------------------------------------------
mata:
{
    // build a 1000-char word string
    big = ""
    for (k = 1; k <= 125; k++) {
        big = big + "abcdefgh"
    }
    // tokenizer should handle without crash
    tokens = _tokenize(big)
    assert(rows(tokens) == 1)
    assert(strlen(tokens[1,2]) == 1000)
}
end

display "P1A-28 PASS: 1000-character input handled without error"

// ----------------------------------------------------------------
// P1A-29 — unicode characters in quoted strings pass through correctly
// ----------------------------------------------------------------
mata:
{
    // ü (U+00FC) encoded as UTF-8: 0xC3 0xBC
    unicode_val = `""Müller""'
    tokens = _tokenize(unicode_val)
    assert(rows(tokens) == 1)
    assert(tokens[1,1] == strofreal(QUOTED_STRING()))
    assert(tokens[1,2] == "Müller")
}
end

display "P1A-29 PASS: unicode characters in quoted strings preserved"

// ----------------------------------------------------------------
// P1A-30 — unbalanced parentheses produces appropriate error
// ----------------------------------------------------------------
// The tokenizer itself does not error on unbalanced parens — it emits
// tokens faithfully.  The structural parser catches unbalanced state.
// We verify the tokenizer at least produces OPEN_PAREN without crashing,
// and that the depth mismatch is detectable from the token counts.
mata:
{
    tokens = _tokenize("scatter mpg weight, mc(red")
    // One OPEN_PAREN, zero CLOSE_PAREN
    nopen = 0; nclose = 0
    for (r = 1; r <= rows(tokens); r++) {
        if (tokens[r,1] == strofreal(OPEN_PAREN()))  nopen  = nopen  + 1
        if (tokens[r,1] == strofreal(CLOSE_PAREN())) nclose = nclose + 1
    }
    assert(nopen == 1)
    assert(nclose == 0)
    // Imbalance is detectable (nopen != nclose)
    assert(nopen != nclose)
}
end

display "P1A-30 PASS: unbalanced parens detectable from token counts"

display ""
display "All tokenizer tests PASSED."
