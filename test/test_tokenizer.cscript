*! test_tokenizer.cscript  v2.0
*! Certification script for dash_parse.mata segment-splitting utilities.
*!
*! In v2.0 the character-level tokeniser was removed; segment splitting
*! and option-key abbreviation expansion are now the Mata-level primitives.
*!
*! Tests: P1A-20 through P1A-30  (rewritten for new architecture)
*!
*! Usage:  do test/test_tokenizer.cscript
*! Version: 2.0  27mar2026

cscript "dash_parse.mata splitter and option expander" adodir ".."

// ----------------------------------------------------------------
// Setup
// ----------------------------------------------------------------
qui sysuse auto, clear
do "../dash_parse.mata"

// ================================================================
// P1A-20 — _dash_split_segs: single flat segment set correctly
// ================================================================
mata:
{
    _dash_split_segs("scatter mpg weight")
}
end
assert "`_n_segs'" == "1"
assert `"`_seg_1'"' == "scatter mpg weight"
assert `"`_graph_opts_raw'"' == ""
display "P1A-20 PASS: single segment stored in _seg_1"

// ================================================================
// P1A-21 — _dash_split_segs: two segments split on ||
// ================================================================
mata:
{
    _dash_split_segs("scatter mpg weight || lfit mpg weight")
}
end
assert "`_n_segs'" == "2"
assert `"`_seg_1'"' == "scatter mpg weight"
assert `"`_seg_2'"' == "lfit mpg weight"
display "P1A-21 PASS: || splits into two segments"

// ================================================================
// P1A-22 — _dash_split_segs: three segments
// ================================================================
mata:
{
    _dash_split_segs("scatter mpg weight || lfit mpg weight || qfit mpg weight")
}
end
assert "`_n_segs'" == "3"
assert `"`_seg_1'"' == "scatter mpg weight"
assert `"`_seg_2'"' == "lfit mpg weight"
assert `"`_seg_3'"' == "qfit mpg weight"
display "P1A-22 PASS: three || segments stored correctly"

// ================================================================
// P1A-23 — _dash_split_segs: || inside parens NOT treated as separator
// ================================================================
// A plot-level option value containing '||' inside parens should be preserved.
// We use a hypothetical option with || inside its value.
mata:
{
    _dash_split_segs("scatter mpg weight, note(a||b)")
}
end
// Should be ONE segment — the || inside parens is not a separator
assert "`_n_segs'" == "1"
assert strpos(`"`_seg_1'"', "note(a||b)") > 0
display "P1A-23 PASS: || inside parens not treated as segment separator"

// ================================================================
// P1A-24 — _dash_split_segs: paren syntax () extracts two segments
// ================================================================
mata:
{
    _dash_split_segs("(scatter mpg weight) (lfit mpg weight)")
}
end
assert "`_n_segs'" == "2"
assert `"`_seg_1'"' == "scatter mpg weight"
assert `"`_seg_2'"' == "lfit mpg weight"
display "P1A-24 PASS: paren syntax () splits into two segments"

// ================================================================
// P1A-25 — _dash_split_segs: paren syntax with trailing graph opts
// ================================================================
mata:
{
    _dash_split_segs(`"(scatter mpg weight) (lfit mpg weight), title(My Graph)"')
}
end
assert "`_n_segs'" == "2"
assert `"`_graph_opts_raw'"' != ""
assert strpos(`"`_graph_opts_raw'"', "title") > 0
display "P1A-25 PASS: paren syntax trailing graph opts stored in _graph_opts_raw"

// ================================================================
// P1A-26 — _dash_first_comma_pos: finds first top-level comma
// ================================================================
local cpos = 0
mata: _dash_comma_pos("scatter mpg weight, mc(red)", "cpos")
// "scatter mpg weight" is 19 chars, comma is at position 20
assert `cpos' == 20
display "P1A-26 PASS: _dash_first_comma_pos finds position 20"

// ================================================================
// P1A-27 — _dash_first_comma_pos: comma inside parens NOT top-level
// ================================================================
local cpos2 = 0
mata: _dash_comma_pos("scatter mpg weight, mc(red,blue)", "cpos2")
// First top-level comma is at position 20 (before mc), not inside mc()
assert `cpos2' == 20
display "P1A-27 PASS: comma inside parens not returned by _dash_first_comma_pos"

// ================================================================
// P1A-28 — _dash_first_comma_pos: no comma returns 0
// ================================================================
local cpos3 = 0
mata: _dash_comma_pos("scatter mpg weight", "cpos3")
assert `cpos3' == 0
display "P1A-28 PASS: no comma → returns 0"

// ================================================================
// P1A-29 — _dash_expand_opts_str: mc→mcolor, ms→msymbol
// ================================================================
local expanded ""
mata: _dash_expand_opts_str("mc(red) ms(oh)", "expanded")
assert strpos("`expanded'", "mcolor(red)") > 0
assert strpos("`expanded'", "msymbol(oh)") > 0
assert strpos("`expanded'", "mc(") == 0
assert strpos("`expanded'", "ms(") == 0
display "P1A-29 PASS: mc→mcolor, ms→msymbol expanded in opts string"

// ================================================================
// P1A-30 — _dash_expand_opts_str: values inside () preserved verbatim
// ================================================================
local expanded2 ""
mata: _dash_expand_opts_str(`"title(My Graph mc(red))"', "expanded2")
// The entire value "My Graph mc(red)" should be preserved — the mc inside
// the value should NOT be expanded
assert strpos(`"`expanded2'"', "title(My Graph mc(red))") > 0
display "P1A-30 PASS: values inside parens preserved without expansion"

display ""
display "All splitter and option-expander tests PASSED."
