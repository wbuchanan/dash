*! test_wp34_truth.cscript
*! WP-34's ONE certification script (.ultraplan/sections/index.md PD-6):
*! every comparison with twoway's drawing or with Stata's own values that
*! WP-34's sections need lives here, one block per GAPS4 row (or per
*! harness tool), appended above the "append new blocks above this line"
*! marker in section order.  Refusal, message and return-code checks join
*! the EXISTING script for their area (merge rule R1).
*!
*! Made from test/templates/wp_truth_template.cscript (34 -> the WP's
*! number).  S00 is the scaffold smoke (Q3400-1).  A section appends
*! `* ==== S<MM> <lead id>: <what> ====` ... `* ==== end S<MM> ====` (or
*! `S<MM> tool: <what>` for a section with no item), its helper programs
*! directly above its first header, and writes only inside its own
*! blocks.  Case ids are Q34<MM>-<k> (PD-5).
*!
*! Usage: via run_all_cscripts.do.  One block alone: WP34_ONLY=S<MM> in
*! the driver's environment.  Each block prints "S<MM> start" and "S<MM>
*! end" with the date and time.  The suite runs it in every session;
*! DASH_CERT_SHARD=k/N runs part k of N of the blocks; a part with no
*! block ends 0.

cscript "WP-34 truth: twoway comparisons" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off

if `"`c(python_exec)'"' == "" {
    display as error "SKIP: Python not available."
    exit 222
}

do "cert_helpers.do"
quietly do "cert_svg.do"
qui do "../dash_parse.mata"
qui do "../dash.ado"
global dash_nobrowser 1

// ----------------------------------------------------------------
// Tally helpers -- test_wp29_truth.cscript's _w29_expect/_w29_done,
// renamed _w34_ for this script.  A case is any number of
// _w34_expect lines closed by one _w34_done.
// ----------------------------------------------------------------
global w34_nfail    = 0
global w34_faillist ""
global w34_bad      = 0
global w34_ncase    = 0

capture program drop _w34_expect
program define _w34_expect
    version 19
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global w34_bad = 1
    }
end

capture program drop _w34_done
program define _w34_done
    version 19
    args id msg
    if ${w34_bad} {
        global w34_nfail    = ${w34_nfail} + 1
        global w34_faillist "${w34_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global w34_bad   = 0
    global w34_ncase = ${w34_ncase} + 1
end

// A fresh directory for this run's files, never one that already exists:
// a fixed name in a shared temp directory could be planted by another
// account (rule 1), so a name Stata has not handed out before is made and
// the run fails if it cannot be.  Every block writes only under it.
tempfile w34_base
local w34_work "`w34_base'_w34"
capture mkdir "`w34_work'"
if _rc {
    display as error "test_wp34_truth: cannot create the work directory `w34_work' (rc `=_rc')"
    exit 9
}

// ---- parts: begin (WP-34 test performance) ----
// The certification suite runs this script in every one of its sessions
// (its row in run_all_cscripts.do's shard table is "* * *"); with
// DASH_CERT_SHARD=k/N set, the session runs part k of N of the blocks.
// The parts are balanced longest first onto the least loaded part (the
// lowest numbered of equals), by the seconds below -- a block not listed
// counts 1 s (section-01 D-01.f) -- the rule scripts/cert_shards.py uses
// for the scripts.  Unset, or with WP34_ONLY set
// (which keeps its precedence), every block runs.  A block runs when its
// gate finds its id in w34_run.
// Seconds: each block's start/end lines in the WP's last measured
// certification run, rounded up, at least 1; a block not listed
// counts 1 s.
local w34_secs S00 1
local w34_sh : environment DASH_CERT_SHARD
mata: st_local("w34_ok", strofreal(st_local("w34_sh") == "" | ustrregexm(st_local("w34_sh"), "^[1-4]/[1-4]$")))
if !`w34_ok' {
    display as error "test_wp34_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 4"
    exit 198
}
local w34_k 1
local w34_N 1
if "`w34_sh'" != "" {
    local w34_k = real(substr("`w34_sh'", 1, 1))
    local w34_N = real(substr("`w34_sh'", 3, 1))
}
local w34_only : env WP34_ONLY
if `"`macval(w34_only)'"' != "" | `w34_N' == 1 {
    local w34_k 1
    local w34_N 1
}
if `w34_k' > `w34_N' {
    display as error "test_wp34_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 4"
    exit 198
}
capture confirm file "test_wp34_truth.cscript"
if _rc {
    display as error "test_wp34_truth: run it from test/, where it reads its own blocks"
    exit 601
}
capture mata: mata drop _w34_part()
mata:
// The ids of the blocks (their header lines, in file order), and those of
// part k of n: longest first onto the least loaded part.
void _w34_part(string scalar file, string scalar table, real scalar k,
               real scalar n)
{
    string colvector lines, ids
    string rowvector tok
    real colvector sec, o, at
    real rowvector load
    real scalar i, j, p, best
    string scalar run

    lines = cat(file)
    ids = J(0, 1, "")
    for (i = 1; i <= rows(lines); i++) {
        if (ustrregexm(lines[i], "^\* ==== (S[0-9]+) ")) {
            if (!anyof(ids, ustrregexs(1))) ids = ids \ ustrregexs(1)
        }
    }
    sec = J(rows(ids), 1, 1)
    tok = tokens(table)
    for (j = 1; j + 1 <= cols(tok); j = j + 2) {
        for (i = 1; i <= rows(ids); i++) {
            if (ids[i] == tok[j]) sec[i] = strtoreal(tok[j + 1])
        }
    }
    o = order((-sec, (1::rows(ids))), (1, 2))
    load = J(1, n, 0)
    at = J(rows(ids), 1, 0)
    for (i = 1; i <= rows(o); i++) {
        best = 1
        for (p = 2; p <= n; p++) if (load[p] < load[best]) best = p
        load[best] = load[best] + sec[o[i]]
        at[o[i]] = best
    }
    run = ""
    for (i = 1; i <= rows(ids); i++) if (at[i] == k) run = run + " " + ids[i]
    st_local("w34_run", strtrim(run))
}
end
mata: _w34_part("test_wp34_truth.cscript", st_local("w34_secs"), `w34_k', `w34_N')
display as text "test_wp34_truth: part `w34_k'/`w34_N' runs `: word count `w34_run'' blocks: `w34_run'"
// ---- parts: end ----

* ==== S00 scaffold: the helpers load and a twoway SVG is read ====
local only : env WP34_ONLY
if inlist("`only'", "", "S00") & `: list posof "S00" in w34_run' {
    display as text "S00 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3400-1: cert_svg_export and cert_svg_texts on one twoway scatter,
    // and dash's own programs are loaded from this tree.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(w34s01, replace)
    cert_svg_export, name(w34s01) file("`w34_work'/w34s01.svg")
    local s01_rc   = r(rc)
    local s01_file "`r(file)'"
    _w34_expect Q3400-1 "(`s01_rc' == 0)" "cert_svg_export rc `s01_rc'"
    capture confirm file "`s01_file'"
    _w34_expect Q3400-1 "(_rc == 0)" "r(file) `s01_file' does not exist"
    cert_svg_texts, file("`s01_file'")
    local s01_n    = r(n)
    local s01_list "`r(list)'"
    _w34_expect Q3400-1 "(`s01_n' > 0)" "cert_svg_texts found no text elements"
    capture program list _dash_serve
    _w34_expect Q3400-1 "(_rc == 0)" "dash.ado's _dash_serve is not loaded"
    _w34_done Q3400-1 "a twoway SVG was written and read (`s01_n' texts); dash is loaded"

    capture erase "`s01_file'"
    capture erase "`s01_list'"
    capture graph drop w34s01
    display as text "S00 end " c(current_date) " " c(current_time)
}
* ==== end S00 ====

python:
def _q34_has(page, kind, want):
    """q34_bad: "" when the saved page *page* holds a FixedTicker whose
    ticks are *want* (Stata values of a *kind* axis: "" a number), else
    the tick lists it holds (WP-31's _u45_has, renamed for WP-34)."""
    import re
    import json
    from sfi import Macro
    want = [float(v) for v in str(want).split()]
    if kind:
        import pandas as pd
        import dash_render as dr
        want = [float(v) for v in dr._stata_dates_to_datetime(
            pd.Series(want), kind).astype("int64")]
    with open(page, encoding="utf-8") as fh:
        html = fh.read()
    lists = [json.loads("[" + m + "]") for m in re.findall(
        r'"name":"FixedTicker","id":"[^"]+","attributes":\{"tags":\[[^\]]*\],"ticks":\[([^\]]*)\]', html)]
    ok = any([float(v) for v in t] == want for t in lists)
    Macro.setGlobal("q34_bad", "" if ok else ("want %s, page %s" % (want, lists))[:1500])
end

capture program drop _q34_drawn
program define _q34_drawn
    // q34_t: the ticks twoway drew on axis <ax> (x1, y1) of <graph object>
    // (WP-31's _u45_drawn, renamed for WP-34)
    args p ax
    local d = substr("`ax'", 1, 1)
    local k = substr("`ax'", 2, 1)
    local a "`p'.`d'axis`k'"
    local nt "`.`a'.major.dlg_tickpos.arrnels'"
    if "`nt'" == "" | "`nt'" == "." local nt 0
    local v ""
    forvalues i = 1/`nt' {
        local v "`v' `.`a'.major.dlg_tickpos[`i']'"
    }
    global q34_t "`v'"
end

* ==== S01 AX-4: histogram bin axis over the midpoints ====
local only : env WP34_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w34_run' {
    display as text "S01 start " c(current_date) " " c(current_time)
    local q01d "`w34_work'/s01ax4"
    capture mkdir "`q01d'"

    // Q3401-1: the bin axis dash draws is the one twoway draws, ticked
    // over the first and last bin midpoints (histogram mpg 15(5)40).
    local i 0
    foreach c in "mpg|x1" "price, width(2000)|x1" "rep78, discrete|x1" "mpg, horizontal|y1" {
        local ++i
        gettoken cmd ax : c, parse("|")
        local ax = substr("`ax'", 2, .)
        sysuse auto, clear
        capture graph drop _all
        quietly twoway histogram `cmd'
        _q34_drawn .Graph `ax'
        local comma = cond(strpos("`cmd'", ","), "", ",")
        capture erase "`q01d'/h`i'.html"
        capture noisily dash histogram `cmd'`comma' saving("`q01d'/h`i'.html", replace)
        _w34_expect Q3401-1 "(_rc == 0)" "dash histogram `cmd' rc `=_rc'"
        python: import __main__ as _q34_m; _q34_m._q34_has(r"`q01d'/h`i'.html", "", "${q34_t}")
        _w34_expect Q3401-1 `"("${q34_bad}" == "")"' `"`cmd' (twoway ${q34_t}): ${q34_bad}"'
    }
    _w34_done Q3401-1 "histogram mpg, price width(2000), rep78 discrete and mpg horizontal: twoway's bin-axis ticks"

    // Q3401-2: gap() and baroffset() move the bars, not the ticks.
    sysuse auto, clear
    capture graph drop _all
    quietly twoway histogram mpg, gap(50) baroffset(1)
    _q34_drawn .Graph x1
    capture erase "`q01d'/g.html"
    capture noisily dash histogram mpg, gap(50) baroffset(1) saving("`q01d'/g.html", replace)
    _w34_expect Q3401-2 "(_rc == 0)" "dash histogram mpg, gap(50) baroffset(1) rc `=_rc'"
    python: import __main__ as _q34_m; _q34_m._q34_has(r"`q01d'/g.html", "", "${q34_t}")
    _w34_expect Q3401-2 `"("${q34_bad}" == "")"' `"gap(50) baroffset(1) (twoway ${q34_t}): ${q34_bad}"'
    _w34_done Q3401-2 "histogram mpg, gap(50) baroffset(1): twoway's ticks; the bars are no tick input"

    // Q3401-3: a qualifier's rows are binned and ticked as twoway does.
    sysuse auto, clear
    capture graph drop _all
    quietly twoway histogram mpg if foreign
    _q34_drawn .Graph x1
    capture erase "`q01d'/f.html"
    capture noisily dash histogram mpg if foreign, saving("`q01d'/f.html", replace)
    _w34_expect Q3401-3 "(_rc == 0)" "dash histogram mpg if foreign rc `=_rc'"
    python: import __main__ as _q34_m; _q34_m._q34_has(r"`q01d'/f.html", "", "${q34_t}")
    _w34_expect Q3401-3 `"("${q34_bad}" == "")"' `"if foreign (twoway ${q34_t}): ${q34_bad}"'
    _w34_done Q3401-3 "histogram mpg if foreign: twoway's bin-axis ticks"

    capture graph drop _all
    capture dash clear
    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====

* ==== S03 AX-1: range() widens the axis, not its default ticks ====
local only : env WP34_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w34_run' {
    display as text "S03 start " c(current_date) " " c(current_time)
    local q03d "`w34_work'/s03ax1"
    capture mkdir "`q03d'"

    // Q3403-1: on an axis with no label rule range() widens the scale,
    // not the ticks (scatter mpg weight, yscale(range(0)): 10(10)40).
    local i 0
    foreach c in "yscale(range(0))|y1" "yscale(range(100))|y1" "xscale(range(0 6000))|x1" "xscale(range(1000 6100))|x1" "ylabel(, angle(0)) yscale(range(0))|y1" {
        local ++i
        gettoken opt ax : c, parse("|")
        local ax = substr("`ax'", 2, .)
        sysuse auto, clear
        capture graph drop _all
        quietly twoway scatter mpg weight, `opt'
        _q34_drawn .Graph `ax'
        capture erase "`q03d'/r`i'.html"
        capture noisily dash scatter mpg weight, `opt' saving("`q03d'/r`i'.html", replace)
        _w34_expect Q3403-1 "(_rc == 0)" "dash scatter mpg weight, `opt' rc `=_rc'"
        python: import __main__ as _q34_m; _q34_m._q34_has(r"`q03d'/r`i'.html", "", "${q34_t}")
        _w34_expect Q3403-1 `"("${q34_bad}" == "")"' `"`opt' (twoway ${q34_t}): ${q34_bad}"'
    }
    _w34_done Q3403-1 "range(0), range(100), xscale(range(0 6000)), xscale(range(1000 6100)) and ylabel(, angle(0)): twoway's ticks over the data"

    // Q3403-2: under #N, and in a by() graph, the ticks are placed over
    // the data and the range together, as twoway places them.
    local i 0
    foreach c in "ylabel(#5) yscale(range(100))|.Graph" "by(foreign) yscale(range(0))|.Graph.graphs[1]" {
        local ++i
        gettoken opt p : c, parse("|")
        local p = substr("`p'", 2, .)
        sysuse auto, clear
        capture graph drop _all
        quietly twoway scatter mpg weight, `opt'
        _q34_drawn `p' y1
        capture erase "`q03d'/w`i'.html"
        capture noisily dash scatter mpg weight, `opt' saving("`q03d'/w`i'.html", replace)
        _w34_expect Q3403-2 "(_rc == 0)" "dash scatter mpg weight, `opt' rc `=_rc'"
        _w34_expect Q3403-2 `"("${q34_t}" != "")"' "twoway drew no y tick under `opt'"
        python: import __main__ as _q34_m; _q34_m._q34_has(r"`q03d'/w`i'.html", "", "${q34_t}")
        _w34_expect Q3403-2 `"("${q34_bad}" == "")"' `"`opt' (twoway ${q34_t}): ${q34_bad}"'
    }
    _w34_done Q3403-2 "ylabel(#5) yscale(range(100)) and by(foreign) yscale(range(0)): the widened ticks twoway draws"

    capture graph drop _all
    capture dash clear
    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

python:
def _q3404_cmp(svg, page, ar):
    """q3404_bad: "" when twoway's plot region in *svg* and dash's frame on
    the saved *page* both have ratio *ar* within 2% and agree within 2%,
    and twoway's graph size (its canvas, 720 units an inch, at 96 px an
    inch) is the page figure's width and height within 1 px; else what
    differed.  The region's own margin m = 63.4 units is taken off each
    side ([S] section 7)."""
    import json
    import os
    import re
    import sys
    from sfi import Macro
    sys.path.insert(0, os.path.abspath(os.path.join("..", "scripts")))
    import svg_truth
    doc = svg_truth.svg_document(svg)
    p, c = doc["plotregion"], doc["canvas"]
    m = 63.4
    tw = (p["bottom"] - p["top"] - 2 * m) / (p["right"] - p["left"] - 2 * m)
    tw_w, tw_h = c["w"] / 720.0 * 96.0, c["h"] / 720.0 * 96.0
    with open(page, encoding="utf-8") as fh:
        html = fh.read()
    figs = []

    def walk(o):
        if isinstance(o, dict):
            if o.get("name") == "Figure" and isinstance(o.get("attributes"), dict):
                figs.append(o["attributes"])
            for v in o.values():
                walk(v)
        elif isinstance(o, list):
            for v in o:
                walk(v)

    for body in re.findall(r'<script type="application/json"[^>]*>(.*?)</script>', html, re.S):
        try:
            walk(json.loads(body))
        except ValueError:
            pass
    bad = []
    if len(figs) != 1:
        bad.append("%d figures on the page" % len(figs))
    else:
        f = figs[0]
        fw, fh_ = f.get("frame_width"), f.get("frame_height")
        dw = (fh_ / fw) if fw and fh_ else None
        if dw is None or abs(dw - ar) > 0.02 * ar:
            bad.append("dash's frame %sx%s is not ratio %s" % (fw, fh_, ar))
        if abs(tw - ar) > 0.02 * ar:
            bad.append("twoway's region ratio %.4f is not %s" % (tw, ar))
        if dw is not None and abs(dw - tw) > 0.02 * tw:
            bad.append("ratios differ: dash %.4f twoway %.4f" % (dw, tw))
        if f.get("width") is None or abs(f["width"] - tw_w) > 1 \
                or f.get("height") is None or abs(f["height"] - tw_h) > 1:
            bad.append("figure %sx%s, twoway's graph %.1fx%.1f px"
                       % (f.get("width"), f.get("height"), tw_w, tw_h))
    Macro.setGlobal("q3404_bad", "; ".join(bad)[:1500])
    Macro.setGlobal("q3404_got", "twoway region ratio %.4f, graph %.0fx%.0f px" % (tw, tw_w, tw_h))
end

* ==== S04 VF-3: aspectratio() with xsize()/ysize() draws its frame ====
local only : env WP34_ONLY
if inlist("`only'", "", "S04") & `: list posof "S04" in w34_run' {
    display as text "S04 start " c(current_date) " " c(current_time)
    local q04d "`w34_work'/s04vf3"
    capture mkdir "`q04d'"

    // Q3404-1: twoway's plot-region ratio and graph size against the
    // ratio and size of dash's figure on the saved page, live.
    // Q3404-2: building it prints no Bokeh validation line (E-1023 was
    // printed on every such build).
    sysuse auto, clear
    local q04_o1 "aspectratio(2) xsize(8) ysize(4)"
    local q04_r1 2
    local q04_o2 "aspectratio(1) xsize(5) ysize(5)"
    local q04_r2 1
    local q04_o3 "aspectratio(.5) xsize(6) ysize(3)"
    local q04_r3 .5
    // D55: a title, and a title with a subtitle, leave the ratio as it is.
    local q04_o4 `"aspectratio(2) xsize(8) ysize(4) title("T")"'
    local q04_r4 2
    local q04_o5 `"aspectratio(2) xsize(8) ysize(4) title("T") subtitle("S")"'
    local q04_r5 2
    local q04_b1 ""
    local q04_b2 ""
    forvalues i = 1/5 {
        capture graph drop q04g
        quietly twoway scatter mpg weight, `q04_o`i'' name(q04g, replace)
        cert_svg_export, name(q04g) file("`q04d'/tw`i'.svg")
        local q04_rc = r(rc)
        capture graph drop q04g
        capture erase "`q04d'/ar`i'.html"
        capture log close q3404
        quietly log using "`q04d'/ar`i'.log", text replace name(q3404)
        capture noisily dash scatter mpg weight, `q04_o`i'' saving("`q04d'/ar`i'.html", replace)
        local q04_drc = _rc
        quietly log close q3404
        if `q04_rc' | `q04_drc' {
            local q04_b1 `"`q04_b1' [`q04_o`i'': export rc `q04_rc', dash rc `q04_drc']"'
            continue
        }
        python: _q3404_cmp(r"`q04d'/tw`i'.svg", r"`q04d'/ar`i'.html", float("`q04_r`i''"))
        display as text `"Q3404-1 `q04_o`i'': ${q3404_got}"'
        if `"${q3404_bad}"' != "" local q04_b1 `"`q04_b1' [`q04_o`i'': ${q3404_bad}]"'
        foreach n in E-1023 E-10 W-10 {
            cert_file_has "`q04d'/ar`i'.log", needle("`n'")
            if r(found) local q04_b2 `"`q04_b2' [`q04_o`i'': `n' in the log]"'
        }
        capture erase "`q04d'/tw`i'.svg"
        capture erase "`q04d'/ar`i'.html"
        capture erase "`q04d'/ar`i'.log"
        dash clear
    }
    _w34_expect Q3404-1 `"(`"`q04_b1'"' == "")"' `"`q04_b1'"'
    _w34_done Q3404-1 "twoway's plot region and graph size are dash's frame ratio and figure size, five probes"
    _w34_expect Q3404-2 `"(`"`q04_b2'"' == "")"' `"`q04_b2'"'
    _w34_done Q3404-2 "no Bokeh validation line in the build log, five probes"

    global q3404_bad ""
    global q3404_got ""
    capture rmdir "`q04d'"
    display as text "S04 end " c(current_date) " " c(current_time)
}
* ==== end S04 ====

// S05 helpers (WP-34 section 34-05, PIC-1): _w34s05_tw reads the outline
// twoway strokes round an area in its exported SVG -- the <use> stroking
// the path a filled <use> fills -- and _w34s05_dash the dash page's ring
// (the Line tagged dash_area_outline).  Each sets global <p>_line (the
// stroke colour) and <p>_shape (the subpaths or runs: c|b per piece,
// closed and with base corners, 1 or 0).
python:
import json as _w34s05_json
import re as _w34s05_re
from sfi import Macro as _w34s05_M


def _w34s05_pieces(pts_list):
    out = []
    for pts, closed in pts_list:
        if not pts:
            continue
        ys = [p[1] for p in pts]
        xs = [p[0] for p in pts]
        lo, xmin, xmax = max(ys), min(xs), max(xs)
        c = closed or (abs(pts[0][0] - pts[-1][0]) <= 0.01
                       and abs(pts[0][1] - pts[-1][1]) <= 0.01)
        at = lambda x: any(abs(p[0] - x) <= 0.5 and abs(p[1] - lo) <= 0.5
                           for p in pts)
        out.append("%d%d" % (int(bool(c)), int(bool(at(xmin) and at(xmax)))))
    return " ".join(out)


def _w34s05_tw(path, p):
    svg = open(path, encoding="utf-8").read()
    ids = {}
    for m in _w34s05_re.finditer(r"<path\b([^>]*)>", svg):
        a = m.group(1)
        i = _w34s05_re.search(r'\bid="([^"]+)"', a)
        d = _w34s05_re.search(r'\bd="([^"]+)"', a)
        if i and d:
            ids[i.group(1)] = d.group(1)
    filled, stroked = set(), []
    for m in _w34s05_re.finditer(r"<use\b([^>]*)>", svg):
        a = m.group(1)
        h = _w34s05_re.search(r'href="#([^"]+)"', a)
        st = _w34s05_re.search(r'style="([^"]*)"', a)
        if not h or not st:
            continue
        st = st.group(1).lower()
        if "fill:none" not in st and "fill:#" in st:
            filled.add(h.group(1))
        sc = _w34s05_re.search(r"stroke:(#[0-9a-f]{6})", st)
        if sc and "fill:none" in st:
            stroked.append((h.group(1), sc.group(1)))
    hit = [(h, c) for h, c in stroked if h in filled and h in ids]
    if not hit:
        _w34s05_M.setGlobal(p + "_line", "none")
        _w34s05_M.setGlobal(p + "_shape", "none")
        return
    colour = hit[0][1]
    pieces = []
    num = _w34s05_re.compile(r"[-+]?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?")
    for h, _c in hit:
        _w34s05_path(ids[h], num, pieces)
    _w34s05_M.setGlobal(p + "_line", colour)
    _w34s05_M.setGlobal(p + "_shape", _w34s05_pieces(pieces))


def _w34s05_path(d, num, pieces):
    """Append the subpaths of SVG path data *d* to *pieces*."""
    cur, closed = None, False
    pos = (0.0, 0.0)
    for cmd, args in _w34s05_re.findall(r"([MLHVZmlhvz])([^MLHVZmlhvz]*)",
                                        d):
        v = [float(z) for z in num.findall(args)]
        rel = cmd.islower()
        if cmd in "Mm":
            if cur:
                pieces.append((cur, closed))
            cur, closed = [], False
        if cmd in "MmLl":
            for a, b in zip(v[0::2], v[1::2]):
                pos = (pos[0] + a, pos[1] + b) if rel else (a, b)
                cur.append(pos)
        elif cmd in "Hh":
            for a in v:
                pos = (pos[0] + a if rel else a, pos[1])
                cur.append(pos)
        elif cmd in "Vv":
            for b in v:
                pos = (pos[0], pos[1] + b if rel else b)
                cur.append(pos)
        else:
            closed = True
    if cur:
        pieces.append((cur, closed))


def _w34s05_dash(path, p):
    from bokeh.document import Document
    from bokeh.models import GlyphRenderer
    page = open(path, encoding="utf-8").read()
    ents = {"amp": "&", "lt": "<", "gt": ">", "quot": chr(34),
            "#x27": chr(39), "#x60": chr(96)}
    blocks = _w34s05_re.findall(
        r'<script type="application/json" id="[^"]+">\s*(.*?)\s*</script>',
        page, _w34s05_re.S)
    docs = [d for b in blocks for d in _w34s05_json.loads(
        _w34s05_re.sub(r"&(amp|lt|gt|quot|#x27|#x60);",
                       lambda m: ents[m.group(1)], b)).values()]
    doc = Document.from_json(docs[0])
    rings = [m for m in doc.models if isinstance(m, GlyphRenderer)
             and "dash_area_outline" in (m.tags or [])]
    if len(rings) != 1:
        _w34s05_M.setGlobal(p + "_line", "none")
        _w34s05_M.setGlobal(p + "_shape", "none")
        return
    g = rings[0].glyph
    d = rings[0].data_source.data
    fx = g.x if isinstance(g.x, str) else getattr(g.x, "field", None)
    fy = g.y if isinstance(g.y, str) else getattr(g.y, "field", None)
    xs = [float(v) for v in d[fx]]
    ys = [-float(v) for v in d[fy]]
    runs, cur = [], []
    for x, y in zip(xs, ys):
        if x != x or y != y:
            if cur:
                runs.append((cur, False))
            cur = []
        else:
            cur.append((x, y))
    if cur:
        runs.append((cur, False))
    _w34s05_M.setGlobal(p + "_line", str(g.line_color).lower())
    # Data units: y negated so the base is the largest y, as in the SVG;
    # the 0.5 tolerance is far below the gap between two vertices.
    _w34s05_M.setGlobal(p + "_shape", _w34s05_pieces(runs))
end

* ==== S05 PIC-1: the default area outline ====
local only : env WP34_ONLY
if inlist("`only'", "", "S05") & `: list posof "S05" in w34_run' {
    display as text "S05 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3405-1: twoway's stroked outline colour of `twoway area le_wm
    // year, scheme(<s>)' equals the line colour of dash's outline ring.
    // ------------------------------------------------------------
    foreach s in stcolor s2color economist {
        capture dash clear
        sysuse uslifeexp, clear
        quietly twoway area le_wm year, scheme(`s') name(w34s05, replace)
        cert_svg_export, name(w34s05) file("`w34_work'/s05_tw_`s'.svg")
        python: _w34s05_tw(r"`w34_work'/s05_tw_`s'.svg", "w34s05t")
        local s05_tw "${w34s05t_line}"
        capture erase "`w34_work'/s05_a_`s'.html"
        capture noisily dash area le_wm year, scheme(`s') saving("`w34_work'/s05_a_`s'.html", replace)
        _w34_expect Q3405-1 "(_rc == 0)" "dash area le_wm year, scheme(`s') refused: rc `=_rc'"
        python: _w34s05_dash(r"`w34_work'/s05_a_`s'.html", "w34s05d")
        local s05_d "${w34s05d_line}"
        _w34_expect Q3405-1 `"("`s05_tw'" != "none")"' "`s': no stroked outline found in twoway's SVG"
        _w34_expect Q3405-1 `"("`s05_tw'" == "`s05_d'")"' "`s': twoway strokes `s05_tw', dash's outline is `s05_d'"
        capture erase "`w34_work'/s05_tw_`s'.svg"
        capture erase "`w34_work'/s05_a_`s'.html"
        capture graph drop w34s05
    }
    _w34_done Q3405-1 "the outline colour is twoway's in stcolor, s2color and economist"

    // ------------------------------------------------------------
    // Q3405-2: the pieces twoway strokes (closed, with base corners) are
    // the runs of dash's ring, for the plain and gap probes (stcolor).
    // ------------------------------------------------------------
    foreach pr in plain gap {
        capture dash clear
        sysuse uslifeexp, clear
        local s05_o ""
        if "`pr'" == "gap" {
            quietly replace le_wm = . in 40/45
            local s05_o "cmissing(n)"
        }
        quietly twoway area le_wm year, `s05_o' scheme(stcolor) name(w34s05, replace)
        cert_svg_export, name(w34s05) file("`w34_work'/s05_tw_`pr'.svg")
        python: _w34s05_tw(r"`w34_work'/s05_tw_`pr'.svg", "w34s05t")
        local s05_tw "${w34s05t_shape}"
        capture erase "`w34_work'/s05_p_`pr'.html"
        capture noisily dash area le_wm year, `s05_o' scheme(stcolor) saving("`w34_work'/s05_p_`pr'.html", replace)
        _w34_expect Q3405-2 "(_rc == 0)" "dash area le_wm year, `s05_o' refused: rc `=_rc'"
        python: _w34s05_dash(r"`w34_work'/s05_p_`pr'.html", "w34s05d")
        local s05_d "${w34s05d_shape}"
        _w34_expect Q3405-2 `"("`s05_tw'" != "none")"' "`pr': no stroked outline found in twoway's SVG"
        _w34_expect Q3405-2 `"("`s05_tw'" == "`s05_d'")"' "`pr': twoway strokes pieces `s05_tw', dash's ring runs are `s05_d'"
        capture erase "`w34_work'/s05_tw_`pr'.svg"
        capture erase "`w34_work'/s05_p_`pr'.html"
        capture graph drop w34s05
    }
    _w34_done Q3405-2 "dash's ring has twoway's closed pieces and base corners (plain, gap)"
    macro drop w34s05t_line w34s05t_shape w34s05d_line w34s05d_shape
    capture dash clear

    display as text "S05 end " c(current_date) " " c(current_time)
}
* ==== end S05 ====

// S06 helper (WP-34 section 34-06, PIC-3): _w34s06_dash reads a saved
// dash page's Scatter fill colours and legend item labels into globals
// <p>_fill (space-separated hex) and <p>_keys (labels joined by "|").
python:
import json as _w34s06_json
import re as _w34s06_re
from sfi import Macro as _w34s06_M


def _w34s06_dash(path, p):
    from bokeh.document import Document
    from bokeh.models import GlyphRenderer, Legend, Scatter
    page = open(path, encoding="utf-8").read()
    ents = {"amp": "&", "lt": "<", "gt": ">", "quot": chr(34),
            "#x27": chr(39), "#x60": chr(96)}
    blocks = _w34s06_re.findall(
        r'<script type="application/json" id="[^"]+">\s*(.*?)\s*</script>',
        page, _w34s06_re.S)
    docs = [d for b in blocks for d in _w34s06_json.loads(
        _w34s06_re.sub(r"&(amp|lt|gt|quot|#x27|#x60);",
                       lambda m: ents[m.group(1)], b)).values()]
    doc = Document.from_json(docs[0])
    fills = []
    for m in doc.models:
        if isinstance(m, GlyphRenderer) and isinstance(m.glyph, Scatter):
            fc = m.glyph.fill_color
            if isinstance(fc, dict):
                fc = fc.get("value")
            else:
                fc = getattr(fc, "value", fc)
            fills.append(str(fc).lower())
    keys = []
    for lg in (m for m in doc.models if isinstance(m, Legend)):
        for it in lg.items:
            lab = it.label
            if isinstance(lab, dict):
                lab = lab.get("value")
            else:
                lab = getattr(lab, "value", lab)
            keys.append(str(lab))
    _w34s06_M.setGlobal(p + "_fill", " ".join(fills))
    _w34s06_M.setGlobal(p + "_keys", "|".join(keys))
end

* ==== S06 PIC-3: a ci fit with nofit is one plot ====
local only : env WP34_ONLY
if inlist("`only'", "", "S06") & `: list posof "S06" in w34_run' {
    display as text "S06 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3406-1: (lfitci, nofit) (scatter) (lfit) under stcolor -- the
    // scatter is twoway's plot 2, and dash's saved page fills it in
    // the named graph's plotregion1.plot2 marker colour.
    // ------------------------------------------------------------
    capture dash clear
    sysuse auto, clear
    quietly twoway (lfitci mpg weight, nofit) (scatter mpg weight) (lfit mpg weight), scheme(stcolor) nodraw name(w34s06, replace)
    local s06_rgb "`.w34s06.plotregion1.plot2.style.marker.fillcolor.rgb'"
    capture graph drop w34s06
    local s06_tw ""
    if wordcount("`s06_rgb'") >= 3 {
        python: _w34s06_M.setLocal("s06_tw", "#" + "".join("%02x" % int(v) for v in _w34s06_M.getLocal("s06_rgb").split()[:3]))
    }
    capture erase "`w34_work'/s06_a.html"
    capture noisily dash (lfitci mpg weight, nofit) (scatter mpg weight) (lfit mpg weight), scheme(stcolor) saving("`w34_work'/s06_a.html", replace)
    _w34_expect Q3406-1 "(_rc == 0)" "dash (lfitci, nofit) (scatter) (lfit) refused: rc `=_rc'"
    python: _w34s06_dash(r"`w34_work'/s06_a.html", "w34s06")
    _w34_expect Q3406-1 `"("`s06_tw'" != "")"' "twoway's plot2 has no marker colour (`s06_rgb')"
    _w34_expect Q3406-1 `"("${w34s06_fill}" == "`s06_tw'")"' "twoway fills the scatter `s06_tw', dash ${w34s06_fill}"
    capture erase "`w34_work'/s06_a.html"
    _w34_done Q3406-1 "the scatter after lfitci, nofit takes twoway's p2 colour"

    // ------------------------------------------------------------
    // Q3406-2: legend(order(2 3)) after the nofit layer keys the scatter
    // and the lfit, twoway's keys (ci_plot_index_truth.json
    // legend_nofit, from the bare SVG minus its legend(off) twin).
    // ------------------------------------------------------------
    capture dash clear
    sysuse auto, clear
    python: _w34s06_M.setGlobal("w34s06_want", "|".join(_w34s06_json.load(open(r"fixtures/ci_plot_index_truth.json", encoding="utf-8"))["legend_nofit"]["keys"]))
    capture erase "`w34_work'/s06_b.html"
    capture noisily dash (lfitci mpg weight, nofit) (scatter mpg weight) (lfit mpg weight), legend(order(2 3)) saving("`w34_work'/s06_b.html", replace)
    _w34_expect Q3406-2 "(_rc == 0)" "dash ..., legend(order(2 3)) refused: rc `=_rc'"
    python: _w34s06_dash(r"`w34_work'/s06_b.html", "w34s06")
    _w34_expect Q3406-2 `"("${w34s06_want}" == "Mileage (mpg)|Fitted values")"' "the fixture's keys are ${w34s06_want}"
    _w34_expect Q3406-2 `"(`"${w34s06_keys}"' == `"${w34s06_want}"')"' "twoway keys ${w34s06_want}, dash ${w34s06_keys}"
    capture erase "`w34_work'/s06_b.html"
    _w34_done Q3406-2 "order(2 3) after lfitci, nofit keys twoway's plots"

    // ------------------------------------------------------------
    // Q3406-3: pcycle(1.5) counts a nofit layer as one series -- drawn
    // with nofit (two series), refused without (three), as twoway does
    // (ci_plot_index_truth.json pcycle_nofit; _dash_pcycle_bad).
    // ------------------------------------------------------------
    sysuse auto, clear
    foreach f in "nofit" "" {
        capture quietly twoway (lfitci mpg weight, `f') (scatter mpg weight), pcycle(1.5) nodraw name(w34s06, replace)
        local s06_trc = _rc
        capture graph drop w34s06
        capture dash clear
        capture erase "`w34_work'/s06_c.html"
        capture quietly dash (lfitci mpg weight, `f') (scatter mpg weight), pcycle(1.5) saving("`w34_work'/s06_c.html", replace)
        local s06_drc = _rc
        capture erase "`w34_work'/s06_c.html"
        _w34_expect Q3406-3 "(`s06_trc' == `s06_drc')" "lfitci `f' pcycle(1.5): twoway rc `s06_trc', dash rc `s06_drc'"
    }
    _w34_done Q3406-3 "pcycle(1.5) is drawn and refused where twoway draws and refuses it around a nofit layer"
    macro drop w34s06_fill w34s06_keys w34s06_want
    capture dash clear

    display as text "S06 end " c(current_date) " " c(current_time)
}
* ==== end S06 ====

* ==== S08 DG-3: a(b)c rules crossing zero label 0 ====
local only : env WP34_ONLY
if inlist("`only'", "", "S08") & `: list posof "S08" in w34_run' {
    display as text "S08 start " c(current_date) " " c(current_time)
    local q08d "`w34_work'/s08dg3"
    capture mkdir "`q08d'"

    // Q3408-1: for ylabel(-.3(.1).3) and ylabel(-.7(.1).7) the saved
    // page's y ticks are the ticks twoway draws, so the middle tick is 0.
    local i 0
    foreach r in "-.3(.1).3" "-.7(.1).7" {
        local ++i
        clear
        quietly set obs 11
        quietly gen x = _n
        quietly gen y = (_n - 6) / 10 * 7
        capture graph drop _all
        quietly twoway scatter y x, ylabel(`r')
        _q34_drawn .Graph y1
        _w34_expect Q3408-1 `"(strpos(" ${q34_t} ", " 0 ") > 0)"' `"twoway ylabel(`r') ticks ${q34_t}: no tick at 0"'
        capture erase "`q08d'/z`i'.html"
        capture noisily dash scatter y x, ylabel(`r') saving("`q08d'/z`i'.html", replace)
        _w34_expect Q3408-1 "(_rc == 0)" "dash scatter y x, ylabel(`r') rc `=_rc'"
        // The y ticker carries no tags, which _q34_has's pattern needs.
        python: import re, json; from sfi import Macro; _q08h = open(r"`q08d'/z`i'.html", encoding="utf-8").read(); _q08l = [json.loads("[" + m + "]") for m in re.findall(r'"name":"FixedTicker","id":"[^"]+","attributes":\{(?:"tags":\[[^\]]*\],)?"ticks":\[([^\]]*)\]', _q08h)]; _q08w = [float(v) for v in "${q34_t}".split()]; Macro.setGlobal("q34_bad", "" if _q08w in _q08l else ("want %s, page %s" % (_q08w, _q08l))[:1500])
        _w34_expect Q3408-1 `"("${q34_bad}" == "")"' `"ylabel(`r') (twoway ${q34_t}): ${q34_bad}"'
    }
    _w34_done Q3408-1 "ylabel(-.3(.1).3) and ylabel(-.7(.1).7): twoway's ticks, the middle one 0"

    capture graph drop _all
    capture dash clear
    display as text "S08 end " c(current_date) " " c(current_time)
}
* ==== end S08 ====

* ==== append new blocks above this line ====

// ----------------------------------------------------------------
// Summary (test_wp29_truth.cscript's shape)
// ----------------------------------------------------------------
capture graph drop _all
capture dash clear
capture rmdir "`w34_work'"
local nfail    = ${w34_nfail}
local faillist "${w34_faillist}"
local ncase    = ${w34_ncase}
local only : env WP34_ONLY
macro drop w34_nfail w34_faillist w34_bad w34_ncase
display as text ""
display as text "============================================================"
if `ncase' == 0 {
    if `w34_N' > 1 & `"`macval(only)'"' == "" & "`w34_run'" == "" {
        display as text "test_wp34_truth: part `w34_k'/`w34_N' has no block to run"
        display as text "============================================================"
        exit 0
    }
    // A WP34_ONLY that names no block, or only a stub, ran nothing:
    // that is not a pass.
    display as error "  test_wp34_truth: no case ran (WP34_ONLY=`only')"
    display as text "============================================================"
    exit 9
}
else if `nfail' == 0 {
    display as text "  test_wp34_truth: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_wp34_truth: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
