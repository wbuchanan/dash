*! test_nodraw_honoured.cscript
*! Certification script: nodraw is honoured, and therefore never reported.
*!
*! ROADMAP WP-13 TR-13.3 / GAPS.md E1.  nodraw sat on both _dash_pending
*! lists while dash.ado honoured it at the browser-launch decision, so
*!
*!     . dash scatter mpg weight, nodraw
*!     dash: ignoring unsupported option(s): nodraw()
*!
*! reported ignoring an option it had just applied -- exactly the stale-list
*! failure the note exists to prevent, and invisible to
*! test_unsupported_report_is_true.py, which diffs rendered output and
*! cannot see an ado-side shell call.
*!
*!   ND-01  an immediate render with nodraw emits no ignoring note and still
*!          writes the file.
*!   ND-02  a real unsupported option beside it is still named; nodraw is not
*!          -- in the note's own words, which ND-01 searches for.
*!   ND-03  paren mode: the plot-level list does not name it either, and
*!          does name play() written beside it.
*!   ND-04  the launch decision itself, through its seam: nodraw keeps the
*!          browser shut, so does saving(), so does $dash_nobrowser; with
*!          none of them the window would open.  Nothing is launched: the
*!          seam only decides.
*!   ND-05  dash build honours a registered graph's nodraw, as dash.sthlp
*!          says it does.
*!
*! Usage:  do test/test_nodraw_honoured.cscript   (or via run_all_cscripts.do)

cscript "dash nodraw is honoured, not reported" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off

// The immediate renders need the render pipeline.
if `"`c(python_exec)'"' == "" {
    display as text "SKIP: no Python is linked to this Stata."
    exit 222
}

do "cert_helpers.do"
qui do "../dash_parse.mata"
qui do "../dash.ado"

global dash_nobrowser 1
sysuse auto, clear

local logfile "`c(tmpdir)'dash_nodraw_honoured.log"

capture program drop _nd_note_for
program define _nd_note_for, rclass
    args cmdtext logpath
    capture log close _ndlog
    capture erase "`logpath'"
    log using "`logpath'", name(_ndlog) text replace
    capture noisily `cmdtext'
    local rc = _rc
    log close _ndlog
    return scalar rc = `rc'
end

// ----------------------------------------------------------------
// ND-01
// ----------------------------------------------------------------
local out1 "`c(tmpdir)'nd_01.html"
capture erase "`out1'"
// The logs are searched with cert_log_has, which undoes Stata's wrapping.
_nd_note_for `"dash scatter mpg weight, nodraw saving("`out1'")"' "`logfile'"
assert r(rc) == 0
cert_log_has "`logfile'", needle("ignoring unsupported")
assert r(found) == 0
cert_log_has "`logfile'", needle("nodraw()")
assert r(found) == 0
confirm file "`out1'"
display as text "ND-01 PASS: nodraw emits no note and the file is written"

// ----------------------------------------------------------------
// ND-02
// ----------------------------------------------------------------
// The note ND-01 must not print is printed here, in the words ND-01
// searches for: without this, that absence could be of words dash no
// longer uses (nothing in this file found them before 24sep2026).
// // Flipped: WP-32 -- play() was named in the note, which was wrong because
// twoway refuses a recording it cannot find, r(601), or read, r(198), and
// dash now refuses it as twoway does (BUGS.md "play() is named in the
// note, where twoway refuses a recording it cannot find or read"); afcolor(), which twoway takes and dash names, is the
// named one.
_nd_note_for `"dash scatter mpg weight, afcolor(red) nodraw saving("`out1'", replace)"' "`logfile'"
assert r(rc) == 0
cert_log_has "`logfile'", needle("ignoring unsupported")
assert r(found) == 1
cert_log_has "`logfile'", needle("afcolor()")
assert r(found) == 1
cert_log_has "`logfile'", needle("nodraw()")
assert r(found) == 0
display as text "ND-02 PASS: afcolor() is named, nodraw is not"

// ----------------------------------------------------------------
// ND-03
// ----------------------------------------------------------------
_nd_note_for `"dash (scatter mpg weight, nodraw), saving("`out1'", replace)"' "`logfile'"
assert r(rc) == 0
cert_log_has "`logfile'", needle("nodraw()")
assert r(found) == 0
// And paren mode does report a plot group's options: afcolor() in the group
// is named, nodraw beside it is not.  Without this a paren mode that
// reported nothing at all passed.
_nd_note_for `"dash (scatter mpg weight, afcolor(red) nodraw), saving("`out1'", replace)"' "`logfile'"
assert r(rc) == 0
cert_log_has "`logfile'", needle("ignoring unsupported")
assert r(found) == 1
cert_log_has "`logfile'", needle("afcolor()")
assert r(found) == 1
cert_log_has "`logfile'", needle("nodraw()")
assert r(found) == 0
display as text "ND-03 PASS: paren mode does not name nodraw either"

// ----------------------------------------------------------------
// ND-04 -- the launch decision, through _dash_browser_wanted.  The global
// is dropped inside this block and restored on every path.
// WP-30 P1.27: the suite runs in batch, where no window opens now, so each
// call passes display(on) to keep testing its own reason.
// ----------------------------------------------------------------
macro drop dash_nobrowser
capture noisily {
    _dash_browser_wanted, spec(`"{"plots":[],"graph_options":{"nodraw":"nodraw"}}"') display(on)
    assert r(open) == 0
    _dash_browser_wanted, spec(`"{"plots":[],"graph_options":{}}"') display(on)
    assert r(open) == 1
    _dash_browser_wanted, spec(`"{"plots":[],"graph_options":{}}"') saving("x.html") display(on)
    assert r(open) == 0
}
local rc4 = _rc
global dash_nobrowser 1
if `rc4' != 0 {
    display as error "ND-04 FAIL: the launch decision does not honour nodraw/saving()/the global as documented (rc=`rc4')"
    exit `rc4'
}
_dash_browser_wanted, spec(`"{"plots":[],"graph_options":{}}"') display(on)
assert r(open) == 0
display as text "ND-04 PASS: nodraw, saving() and \$dash_nobrowser each keep the window shut"

// ----------------------------------------------------------------
// ND-05 -- dash build reads a registered graph's nodraw.
// ----------------------------------------------------------------
dash clear
dash scatter mpg weight, name(nd5) nodraw
_dash_registry_nodraw
assert r(nodraw) == 1
dash clear
dash scatter mpg weight, name(nd5b)
_dash_registry_nodraw
assert r(nodraw) == 0
display as text "ND-05 PASS: dash build sees a registered graph's nodraw"

// ----------------------------------------------------------------
// ND-06 -- WP-30 P1.27: saving(f, asis) with nodraw writes the page, a
// documented difference (twoway gives r(601) "no current graph").
// ----------------------------------------------------------------
dash clear
capture erase "`out1'"
capture noisily dash scatter mpg weight, saving("`out1'", asis) nodraw
assert _rc == 0
confirm file "`out1'"
display as text "ND-06 PASS: saving(, asis) with nodraw writes the page"

capture dash clear
capture erase "`out1'"
capture erase "`logfile'"
display as text ""
display as text "test_nodraw_honoured: ALL CHECKS PASSED"
