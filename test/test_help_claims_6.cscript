// The estimate-changing options dash cannot compute, which the help lists:
// twoway takes each (rc 0); dash names each in the note, and registers
// nothing for it.  With them dotextend() and droplines(), which the base()
// entry says dash does not draw.
local bad = 0
// Flipped (WP-31 C4): atobs, estopts(), predopts() and estcmd() left
// this list, which was wrong for them because twoway draws each; they are
// drawn (HC6-55c).
// Flipped (WP-31 C5): area() and boundary on kdensity and droplines() on
// function left this list too, which was wrong once they are drawn
// (test_wp31_truth.cscript U12-03, U12-04): they are asked below, with
// no note.
// Flipped (WP-31 B5b): dotextend() on dot left this list, which was wrong
// once dash draws twoway's dot rows (test_wp31_truth.cscript U18-01); it
// is asked below, with no note.  The list is empty.
local pairs ""
foreach p of local pairs {
    local b1 = strpos(`"`p'"', "|")
    local spec = substr(`"`p'"', 1, `b1' - 1)
    local rest = substr(`"`p'"', `b1' + 1, .)
    local b2 = strpos(`"`rest'"', "|")
    local opt   = substr(`"`rest'"', 1, `b2' - 1)
    local oname = substr(`"`rest'"', `b2' + 1, .)
    _hc6_tw `"`spec', `opt'"'
    if r(rc) != 0 {
        display as error `"HC6-55 FAIL: twoway `spec', `opt' rc=`r(rc)'"'
        local bad = 1
    }
    _hc6_dash `"dash `spec', `opt' name(hc6)"'
    local d = r(rc)
    _hc6_said "unsupported option(s): `oname'()"
    if `d' != 0 | r(n) != 1 {
        display as error `"HC6-55 FAIL: dash `spec', `opt': rc=`d', note naming `oname'() `r(n)' time(s)"'
        local bad = 1
    }
}
foreach p in "kdensity mpg|area(2)|area" "kdensity mpg|boundary|boundary" "function y = x|range(0 5) droplines(1 2)|droplines" "dot mpg weight|dotextend(no)|dotextend" {
    local b1 = strpos(`"`p'"', "|")
    local spec = substr(`"`p'"', 1, `b1' - 1)
    local rest = substr(`"`p'"', `b1' + 1, .)
    local b2 = strpos(`"`rest'"', "|")
    local opt   = substr(`"`rest'"', 1, `b2' - 1)
    local oname = substr(`"`rest'"', `b2' + 1, .)
    _hc6_dash `"dash `spec', `opt' name(hc6)"'
    local d = r(rc)
    _hc6_said "unsupported option"
    if `d' != 0 | r(n) != 0 {
        display as error `"HC6-55 FAIL: dash `spec', `opt': rc=`d', a note names an unsupported option `r(n)' time(s)"'
        local bad = 1
    }
}
_hc6_tally HC6-55 `bad' "area(), boundary, droplines() and dot's dotextend() are drawn, unnamed"


// HC6-55b (WP-29 P0.9): lpolyci's pwidth() and var() are honoured, as
// twoway honours them: rc 0 and no note naming either.
local bad = 0
_hc6_tw "lpolyci mpg weight, pwidth(500) var(2)"
if r(rc) != 0 local bad = 1
_hc6_dash "dash lpolyci mpg weight, pwidth(500) var(2) name(hc6)"
if r(rc) != 0 local bad = 1
_hc6_said "unsupported option"
if r(n) != 0 local bad = 1
if `bad' display as error "HC6-55b FAIL: lpolyci's pwidth() or var() is refused or named in the note"
_hc6_tally HC6-55b `bad' "lpolyci's pwidth() and var() are honoured, with no note"

// ================================================================
// HC6-32 .. 34 -- histogram
// ================================================================
_hc6_tw "histogram rep78, discrete bin(5)"
local t = r(rc)
_hc6_said "options discrete and bins() may not be combined"
local bad = (`t' != 198 | r(n) < 1)
_hc6_tally HC6-32 `bad' "twoway refuses discrete with bin(), r(198), in the words dash uses (SO-64)"

_hc6_ss hd 0 histogram rep78, discrete
_hc6_ss hd0 0 histogram rep78, discrete start(0)
// start(0)'s serset carries one more row, with no bar in it: compare the
// bars only.
preserve
quietly use "`c(tmpdir)'hc6_hd0.dta", clear
quietly drop if missing(c1)
quietly save "`c(tmpdir)'hc6_hd0b.dta", replace
restore
_hc6_same hd hd0b 3 0
local s = r(same)
_hc6_tw "histogram mpg, start(15)"
local t = r(rc)
_hc6_said "option start() may not be larger than minimum of mpg"
local bad = (`s' != 1 | `t' != 198 | r(n) < 1)
_hc6_tally HC6-33 `bad' "discrete bars do not move with start(); start() above the minimum is r(198), twoway's words"

_hc6_ss hc 0 histogram cst
local a = r(xmin)
_hc6_ss hcd 0 histogram cst, discrete
local b = r(xmin)
_hc6_ss hcw 0 histogram cst, width(3)
local c = r(xmin)
local bad = (`a' != 5.5 | `b' != 5 | `c' != 6.5)
_hc6_tally HC6-34 `bad' "one value: one bar centred at v + .5 (width 1), at v with discrete, at v + 1.5 with width(3)"

// ================================================================
// HC6-35, 36 -- lowess
// ================================================================
clear
quietly set obs 20
quietly generate double x = _n
quietly generate double y = 0.3
quietly replace y = 0.005 in 3
quietly replace y = 0.00005 in 7
_hc6_ss lwl 0 lowess y x, mean noweight bwidth(.05) logit
quietly use "`c(tmpdir)'hc6_lwl.dta", clear
local v3 = c1[3]
local v7 = c1[7]
quietly use `hc6_auto', clear
local bad = (abs(`v3' - ln(.005/.995)) > 1e-9 | abs(`v7' - ln(.05/.95)) > 1e-9)
_hc6_tally HC6-35 `bad' "lowess logit: a smooth of .005 is kept (ln(.005/.995)), one below .0001 becomes 1/N"

local bad = 0
foreach w in aw fw pw {
    _hc6_tw "lowess mpg weight [`w'=rep78]"
    if r(rc) != 101 local bad = 1
    _hc6_said "weights not allowed"
    if r(n) < 1 local bad = 1
}
_hc6_tally HC6-36 `bad' "twoway lowess takes no weight, r(101) weights not allowed (dash: SO-19..22)"

// ================================================================
// HC6-40 .. 50 -- weights
// ================================================================
local bad = 0
foreach f in lfitci lpolyci {
    _hc6_tw "`f' mpg weight [fw=gear_ratio]"
    if r(rc) != 401 local bad = 1
    _hc6_dash "dash `f' mpg weight [fw=gear_ratio], name(hc6)"
    if r(rc) != 401 local bad = 1
    _hc6_said "may not use noninteger frequency weights"
    if r(n) < 1 local bad = 1
}
_hc6_tally HC6-40 `bad' "a non-integer fweight on lfitci and lpolyci: r(401), in both"

_hc6_tw "lpolyci mpg weight [fw=negfw]"
local t = r(rc)
_hc6_dash "dash lpolyci mpg weight [fw=negfw], name(hc6)"
local d = r(rc)
_hc6_said "negative weights encountered"
local bad = (`t' != 402 | `d' != 402 | r(n) < 1)
_hc6_tally HC6-41 `bad' "a negative fweight on lpolyci: r(402), in both"

local bad = 0
foreach f in qfit qfitci fpfit {
    _hc6_ss ni_`f' 0 `f' mpg weight [fw=gear_ratio]
    if r(rc) != 0 | r(ny) != 0 {
        display as error "HC6-42 FAIL: twoway `f' [fw=gear_ratio]: rc=`r(rc)' points=`r(ny)'"
        local bad = 1
    }
    _hc6_dash "dash `f' mpg weight [fw=gear_ratio], name(hc6)"
    if r(rc) != 0 local bad = 1
}
_hc6_tally HC6-42 `bad' "a non-integer fweight: twoway qfit, qfitci and fpfit accept it and draw nothing; dash accepts it"

local bad = 0
foreach f in fpfit fpfitci {
    _hc6_ss neg_`f' 0 `f' mpg weight [aw=negw]
    if r(rc) != 0 | r(ny) != 0 local bad = 1
}
_hc6_tally HC6-43 `bad' "a negative weight: twoway fpfit and fpfitci accept it and draw nothing (dash: SO-86)"

local bad = 0
foreach t in lfit qfit lfitci qfitci {
    foreach w in aw pw {
        _hc6_ss n1 0 `t' mpg weight [`w'=negw]
        _hc6_ss n2 0 `t' mpg weight [`w'=negw] if negw > 0
        local nc = cond(inlist("`t'", "lfitci", "qfitci"), 4, 2)
        _hc6_same n1 n2 `nc' 0
        if r(same) != 1 {
            display as error "HC6-44 FAIL: twoway `t' [`w'=negw] differs from the fit on negw > 0"
            local bad = 1
        }
    }
    _hc6_ss n1 0 `t' mpg weight [fw=negfw]
    _hc6_ss n2 0 `t' mpg weight [fw=negfw] if negfw > 0
    local nc = cond(inlist("`t'", "lfitci", "qfitci"), 4, 2)
    _hc6_same n1 n2 `nc' 0
    if r(same) != 1 local bad = 1
}
_hc6_tally HC6-44 `bad' "a negative weight on lfit qfit lfitci qfitci: twoway draws the weighted fit on w > 0"

local bad = 0
foreach t in mband mspline {
    local s = cond("`t'" == "mband", 1, 2)
    _hc6_ss w0 `s' `t' mpg weight
    foreach w in zw mw {
        _hc6_ss w1 `s' `t' mpg weight [aw=`w']
        _hc6_same w1 w0 2 0
        if r(same) != 1 {
            display as error "HC6-45 FAIL: twoway `t' [aw=`w'] differs from the unweighted curve"
            local bad = 1
        }
    }
}
_hc6_tally HC6-45 `bad' "mband and mspline: a zero or missing weight changes nothing, not even the row count"

_hc6_ss zl 0 lfit mpg weight [aw=zw]
local a = r(xmin)
local b = r(xmax)
_hc6_ss zk 0 kdensity weight [aw=zw]
local c = r(c2min)
local bad = (`a' != 1800 | `b' != 4720 | `c' != 1800)
_hc6_tally HC6-46 `bad' "a zero weight leaves its row out of lfit and kdensity: both start at 1800, not 1760"

_hc6_ss sw 0 scatter mpg weight [aw=price]
local nc = r(ncol)
_hc6_dash "dash scatter mpg weight [aw=price], name(hc6)"
local d = r(rc)
_hc6_said "[aweight]"
local nn = r(n)
local _v ""
mata: _dash_extract_vars(st_global("dash_json_hc6"), "_v")
local ex : list posof "price" in _v
// Flipped (WP-31 C9): twoway sizes markers by the weight and says nothing
// (weighted_markers_truth.json W01); dash draws it too, so price is
// exported beside mpg and weight and the weight is named nowhere.
local bad = (`nc' != 3 | `d' != 0 | `nn' != 0 | `ex' == 0)
if `bad' display as error "HC6-47 FAIL: twoway serset columns `nc'; dash rc=`d' note=`nn' exported=`_v'"
_hc6_tally HC6-47 `bad' "scatter [aw]: twoway reads the weight (its serset carries it); dash exports price, sizes the markers and names nothing"

// twoway scatter sizes its markers by the weight: the SVG export of the
// first three cars draws the first marker with radius 31.19 under
// [aw=price] and 21.74 without (measured).
capture mata: mata drop _hc6_first_r()
mata:
real scalar _hc6_first_r(string scalar fn)
{
    real scalar   fh, r
    string scalar line
    fh = fopen(fn, "r")
    r = .
    while ((line = fget(fh)) != J(0, 0, "")) {
        if (regexm(line, `"<circle [^>]*r="([0-9.]+)""')) {
            r = strtoreal(regexs(1))
            break
        }
    }
    fclose(fh)
    return(r)
}
end
local sv1 "`c(tmpdir)'hc6_sw.svg"
local sv0 "`c(tmpdir)'hc6_s0.svg"
// The first marker's radius in twoway's SVG (asked in a live run, read
// back otherwise: cert_truth.do).
local _ct_q1 "twoway scatter mpg weight [aw=price] in 1/3"
local _ct_q0 "twoway scatter mpg weight in 1/3"
python: _dct.flag("_ct_l")
if `_ct_l' {
    quietly twoway scatter mpg weight [aw=price] in 1/3, name(hc6s, replace)
    cert_svg_export, name(hc6s) file("`sv1'")
    quietly twoway scatter mpg weight in 1/3, name(hc6s, replace)
    cert_svg_export, name(hc6s) file("`sv0'")
    capture graph drop hc6s
    mata: st_local("r1", strofreal(_hc6_first_r(st_local("sv1"))))
    mata: st_local("r0", strofreal(_hc6_first_r(st_local("sv0"))))
    python: _dct.val_put("svg first radius", "_ct_q1", "r1")
    python: _dct.val_put("svg first radius", "_ct_q0", "r0")
}
else {
    python: _dct.val_get("svg first radius", "_ct_q1", "r1")
    python: _dct.val_get("svg first radius", "_ct_q0", "r0")
    if "`r1'" == "" local r1 .
    if "`r0'" == "" local r0 .
}
local bad = (missing(`r1') | missing(`r0') | `r1' <= `r0')
if `bad' display as error "HC6-53 FAIL: marker radius `r1' with [aw=price], `r0' without"
_hc6_tally HC6-53 `bad' "twoway scatter sizes its markers by an aweight (radius `r1' against `r0')"

// A pweight: the aweight's fit, a different (robust) band.  dash's band
// equals twoway's to float precision (test_help_claims_6.py
// TestAPweightIsTheAweightFitWithARobustBand); here twoway's own shape.
local bad = 0
foreach t in lfitci qfitci fpfitci {
    _hc6_ss pw 0 `t' mpg weight [pw=price]
    _hc6_ss aw 0 `t' mpg weight [aw=price]
    preserve
    quietly use "`c(tmpdir)'hc6_pw.dta", clear
    rename (c1 c2 c3) (f_pw lo_pw hi_pw)
    quietly merge 1:1 _n using "`c(tmpdir)'hc6_aw.dta", nogenerate
    quietly count if reldif(f_pw, c1) > 1e-6
    local nf = r(N)
    quietly count if reldif(lo_pw, c2) > 1e-4
    local nb = r(N)
    restore
    if `nf' != 0 | `nb' == 0 {
        display as error "HC6-54 FAIL: twoway `t' [pw] fit differs at `nf' points, band at `nb'"
        local bad = 1
    }
}
_hc6_tally HC6-54 `bad' "a pweight: twoway draws the aweight fit with another band, on lfitci qfitci fpfitci"

// The immediate types and function (HC6-48).
local bad = 0
foreach w in aw fw pw {
    local wv = cond("`w'" == "fw", "rep78", "price")
    _hc6_tw "function y = x [`w'=`wv'], range(0 1)"
    if r(rc) != 0 local bad = 1
    _hc6_dash "dash function y = x [`w'=`wv'], range(0 1) name(hc6)"
    if r(rc) != 0 {
        display as error "HC6-48 FAIL: dash function [`w'=`wv'] rc=`r(rc)'"
        local bad = 1
    }
    local wn = cond("`w'" == "aw", "aweight", cond("`w'" == "fw", "fweight", "pweight"))
    // Flipped (WP-31 C9): the weight was named in the note, which was
    // wrong because twoway accepts a weight on function, draws nothing
    // different and says nothing (as on the markerless types,
    // weighted_markers_truth.json W07).
    _hc6_said "[`wn']"
    if r(n) != 0 local bad = 1
    foreach c in "scatteri 1 2" "pci 1 2 3 4" "pcarrowi 1 2 3 4" {
        _hc6_tw "`c' [`w'=`wv'],"
        if r(rc) != 198 local bad = 1
        _hc6_said "weights not allowed"
        local tw = r(n)
        _hc6_dash "dash `c' [`w'=`wv'], name(hc6)"
        if r(rc) != 198 {
            display as error "HC6-48 FAIL: dash `c' [`w'=`wv'] rc=`r(rc)', twoway r(198)"
            local bad = 1
        }
        _hc6_said "weights not allowed"
        if r(n) < 1 | `tw' < 1 local bad = 1
    }
}
foreach c in "function y = x [iw=price], range(0 1)" "scatteri 1 2 [iw=price]," "pci 1 2 3 4 [iw=price]," "pcarrowi 1 2 3 4 [iw=price]," {
    _hc6_tw "`c'"
    if r(rc) != 101 local bad = 1
    _hc6_said "iweights not allowed"
    local tw = r(n)
    _hc6_dash "dash `c' name(hc6)"
    if r(rc) != 101 {
        display as error "HC6-48 FAIL: dash `c' rc=`r(rc)', twoway r(101)"
        local bad = 1
    }
    _hc6_said "iweights not allowed"
    if r(n) < 1 | `tw' < 1 {
        display as error "HC6-48 FAIL: `c': not twoway's words (twoway said it `tw' times)"
        local bad = 1
    }
}
// twoway evaluates the weight before it refuses it: a variable that does
// not exist is r(111) on every one of them.
foreach c in "function y = x [aw=nosuch], range(0 1)" "scatteri 1 2 [aw=nosuch]," {
    _hc6_tw "`c'"
    if r(rc) != 111 local bad = 1
    _hc6_dash "dash `c' name(hc6)"
    if r(rc) != 111 local bad = 1
}
// A label that looks like a weight is a label, in twoway (rc 0, measured)
// and in dash -- declaring the weight clause up front made syntax read it
// as one.
foreach lab in "[aw=price]" "[iw=price]" "[x]" "a [x] b" {
    _hc6_tw `"scatteri 1 2 "`lab'","'
    if r(rc) != 0 local bad = 1
    _hc6_dash `"dash scatteri 1 2 "`lab'", name(hc6)"'
    if r(rc) != 0 {
        display as error `"HC6-48 FAIL: dash scatteri 1 2 "`lab'" rc=`r(rc)', a label"'
        local bad = 1
    }
    mata: st_local("j", strofreal(_hc6_json_has(st_local("lab"))))
    if `j' != 1 local bad = 1
}
_hc6_dash `"dash pci 1 2 3 4 "[aw=price]", name(hc6)"'
if r(rc) != 0 local bad = 1
// Tallied by hand, so the PASS line is a literal the adversarial matrix's
// case detector can read (test_adversarial_matrix.py).
if `bad' {
    global hc6_nfail    = ${hc6_nfail} + 1
    global hc6_faillist "${hc6_faillist} HC6-48"
}
else {
    display as text "HC6-48 PASS: weights on function, scatteri, pci, pcarrowi: twoway's codes and words; a bracketed label stays a label"
}

_hc6_tw "lfit mpg weight [aw=price+1]"
local t = r(rc)
_hc6_dash "dash lfit mpg weight [aw=price+1], name(hc6)"
local d = r(rc)
// Flipped (WP-31 A5): dash refused the expression, r(198), "must name
// one variable"; twoway evaluates the weight, and so does dash now, at
// export, as the help says.
_hc6_said "must name one variable"
local s1 = r(n)
_hc6_said "cannot evaluate"
local s2 = r(n)
local bad = (`t' != 0 | `d' != 0 | `s1' != 0 | `s2' != 0)
_hc6_tally HC6-49 `bad' "an expression weight: twoway evaluates it, and dash evaluates it at export, rc 0, as the help says"

local bad = 0
foreach w in aw fw {
    local wv = cond("`w'" == "fw", "rep78", "price")
    _hc6_tw "lpolyci mpg weight [`w'=`wv'], bwidth(400)"
    if r(rc) != 0 local bad = 1
    _hc6_dash "dash lpolyci mpg weight [`w'=`wv'], name(hc6)"
    if r(rc) != 0 local bad = 1
}
foreach w in pw iw {
    _hc6_tw "lpolyci mpg weight [`w'=price], bwidth(400)"
    if r(rc) != 101 local bad = 1
    _hc6_dash "dash lpolyci mpg weight [`w'=price], name(hc6)"
    if r(rc) != 101 local bad = 1
}
_hc6_tally HC6-50 `bad' "lpolyci takes aweight and fweight and refuses pweight and iweight, r(101), in both"

// HC6-56 (WP-27): a weight's values are checked over the plot's sample,
// and a qualifier written after the plot groups is part of that sample.
// Measured 24sep2026: `(lfit mpg weight [fw=halfint]) if foreign==1',
// halfint 1 on the foreign cars and 0.5 elsewhere, is rc 0 in twoway and
// was r(401) in dash, which checked every row; inside the parentheses it
// was rc 0 in both.  Each case asks twoway first and holds dash to its
// code.
local bad = 0
// No preserve here: _hc6_tw preserves around each twoway run.  auto is
// sorted by foreign, so 53/74 are the foreign cars.
quietly gen double hc6_hi = cond(foreign == 1, 1, 0.5)
quietly gen double hc6_ng = cond(foreign == 1, 1, -1)
quietly count if foreign == 1 & _n >= 53
assert r(N) == 22
foreach c in "(lfit mpg weight [fw=hc6_hi]) if foreign==1" ///
             "(lfit mpg weight [fw=hc6_hi] if mpg > 0) if foreign==1" ///
             "(lfit mpg weight [fw=hc6_hi]) (scatter mpg weight) if foreign==1" ///
             "(lfit mpg weight [fw=hc6_hi]) in 53/74" ///
             "(lfit mpg weight [fw=hc6_hi] in 40/74) in 53/74" ///
             "(lfit mpg weight [fw=hc6_hi]) if foreign==0" ///
             "(lfit mpg weight [fw=hc6_hi]) in 50/74" ///
             "(lpoly mpg weight [aw=hc6_ng]) if foreign==1" ///
             "(lpolyci mpg weight [fw=hc6_hi]) in 53/74" ///
             "(lpoly mpg weight [fw=hc6_ng]) if foreign==0" ///
             "(kdensity mpg [aw=hc6_ng]) if foreign==1" ///
             "(kdensity mpg [aw=hc6_ng] if foreign==1)" ///
             "(kdensity mpg [fw=hc6_hi]) in 53/74" ///
             "(kdensity mpg [aw=hc6_ng]) if foreign==0" ///
             "(histogram mpg [fw=hc6_hi]) if foreign==1" ///
             "(histogram mpg [fw=hc6_ng]) if foreign==1" ///
             "(histogram mpg, start(15)) if mpg > 20," ///
             "(histogram mpg, start(15)) if mpg > 5," {
    // A command whose plot holds a comma ends in one, so that _hc6_tw puts
    // its nodraw after the graph's comma and not inside the plot's.
    _hc6_tw "`c'"
    local trc = r(rc)
    local sep = cond(substr("`c'", -1, 1) == ",", "", ",")
    _hc6_dash "dash `c'`sep' name(hc6)"
    local drc = r(rc)
    if `trc' != `drc' {
        display as error "HC6-56 FAIL: `c': twoway rc `trc', dash rc `drc'"
        local bad = 1
    }
}
// The case the entry measured is one twoway accepts: a check that
// passes for both refusing it would pass the loop above.
_hc6_dash "dash (lfit mpg weight [fw=hc6_hi]) if foreign==1, name(hc6)"
if r(rc) != 0 local bad = 1
drop hc6_hi hc6_ng
_hc6_tally HC6-56 `bad' "a weight's values and histogram's start() are checked over the plot's sample with the qualifier after the plot groups in it, as twoway checks them"

// ================================================================
// HC6-51, 52
// ================================================================
local lg "`c(tmpdir)'hc6_run.log"
capture log close _hc6log
quietly log using "`lg'", name(_hc6log) text replace
capture noisily mata: mata which _lpoly_work()
local rc = _rc
quietly log close _hc6log
_hc6_said "_lpoly_work():  lmataado"
local bad = (`rc' != 0 | r(n) < 1)
_hc6_tally HC6-51 `bad' "lpoly's rule of thumb is in compiled Mata: _lpoly_work() lives in the library lmataado"

_hc6_tw "lfitci mpg weight, stdf stdr"
local t = r(rc)
_hc6_said "may not combine stdf stdr"
local bad = (`t' != 198 | r(n) < 1)
_hc6_tally HC6-52 `bad' "twoway refuses two band types, may not combine stdf stdr, r(198) (dash: SO-62)"

// HC6-55c (WP-31 C4): atobs, estopts(), predopts() and estcmd() are
// drawn, as twoway draws them: rc 0 and no note.  Last, as it asks
// twoway nothing: the answers after it keep their place.
local bad = 0
foreach c in "lfit mpg weight, atobs" "lfit mpg weight, estopts(noconstant)" "lfit mpg weight, predopts(residuals)" "fpfit mpg weight, estcmd(regress)" {
    _hc6_dash `"dash `c' name(hc6)"'
    local d = r(rc)
    _hc6_said "unsupported option(s)"
    if `d' != 0 | r(n) != 0 {
        display as error `"HC6-55c FAIL: dash `c': rc=`d', notes `r(n)'"'
        local bad = 1
    }
}
_hc6_tally HC6-55c `bad' "atobs estopts() predopts() estcmd(): drawn, rc 0 and no note"

// ----------------------------------------------------------------
// Summary
// ----------------------------------------------------------------
// twoway's answers: a question the fixture could not answer, or (with
// DASH_CERT_REMEASURE=1) an answer twoway no longer gives, fails the run.
cert_truth_close
if r(problems) {
    global hc6_nfail = ${hc6_nfail} + 1
    global hc6_faillist "${hc6_faillist} TRUTH"
}
capture dash clear
capture erase "`c(tmpdir)'hc6_run.log"
local nfail = ${hc6_nfail}
local faillist "${hc6_faillist}"
macro drop hc6_nfail hc6_faillist
display as text ""
display as text "============================================================"
if `nfail' == 0 {
    display as text "  test_help_claims_6: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_help_claims_6: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
