*! test_help_claims_6.cscript
*! Certification script: WP-23, dash.sthlp's "Statistical Layer Options"
*! and "Weights" sections, claim by claim -- the Stata side, with twoway
*! measured in the same run.
*!
*! ROADMAP WP-23 AC-23.1 ("every claim in dash.sthlp is verified by a test
*! or corrected") and TR-23.3 (bands(), n(), range() and base() each get an
*! entry naming the plot types that honour them, the default and the
*! bounds, measured against twoway).  Every case asks twoway first -- its
*! return code, its words, or the serset of the saved .gph (`graph use',
*! `serset use') -- and then dash.ado, so an expectation is measured rather
*! than written down.  The renderer's half of each claim is
*! test/test_help_claims_6.py, in both render modes.
*!
*! twoway's answers are measured once and replayed (WP-30 test performance,
*! B2; cert_truth.do): a certification run reads them from
*! test/fixtures/help_claims_6_truth.json, which
*! scripts/extract_twoway_oracle_truth.do writes by running this script
*! with twoway asked; DASH_CERT_REMEASURE=1 asks twoway in the run again and
*! fails on any answer that is no longer the fixture's (the release run).
*!
*! MEASURED STATUS WHEN THIS FILE WAS WRITTEN (4ede074's dash.ado, 23sep2026,
*! StataNow 19.5): every twoway case passed; the dash.ado cases of three
*! defects failed --
*!   HC6-26  `dash fpfitci mpg weight, stdp' was r(198) "option stdp not
*!           allowed", where twoway accepts it (rc 0) and the help says
*!           fpfitci takes stdp.  HC6-27, 28 pin twoway's refusals beside it.
*!   HC6-06  `dash kdensity mpg, width(2)' registered "width":"2", which the
*!           renderer read as nothing: twoway reads width() as the bandwidth
*!           (the serset equals bwidth(2)'s).  HC6-07: width() with bwidth()
*!           was rc 0; twoway refuses it, r(198).
*!   HC6-48  a weight on function, scatteri, pci or pcarrowi was r(101)
*!           "weights not allowed" whatever it was; twoway accepts aw, fw and
*!           pw on function, refuses them on the three immediate types with
*!           r(198) "weights not allowed", and refuses an iweight on all four
*!           with r(101) "iweights not allowed".
*!
*! CASES (HC6-nn; every case is tallied, the script exits 9 on any failure)
*!   Aliases:     01 bins() is twoway histogram's own name (bin() its
*!                abbreviation); 02 bins() bounds.
*!   bwidth():    03 kdensity bwidth(0); 04 lowess bwidth(1) is 0.8;
*!                05 lowess bwidth(1.5) and bwidth(0); 06-07 kdensity width().
*!   degree():    08.   kernel(): 09 abbreviations and case; 10 old syntax;
*!                57 every prefix of every name (WP-27).
*!   n():         11-12 lpoly; 13 kdensity; 14 the fits; 15 mspline;
*!                16 lpoly's grid under if, by() and a 30-row dataset;
*!                17 fpfitci and mband ignore n(); 18 function.
*!   bands():     19.   range(): 20-22.
*!   base():      23 where twoway takes it; 23b twoway's default base.
*!   level():     24 bounds; 25 c(level).
*!   fpfitci/fpfit std: 26-29.   fpfit's smoothing options: 30-31.
*!   histogram:   32-34.   lowess: 35-36.
*!   Weights:     40-50, 53 (twoway sizes scatter markers by the weight),
*!                54 (a pweight: the aweight fit, a robust band), 56 (the
*!                qualifier after the plot groups is part of the sample a
*!                weight is checked over, except on kdensity; WP-27).
*!   Misc:        51 _lpoly_work is compiled; 52 stdf stdr; 55 the options
*!                dash names in the note (dotextend()); 55c the
*!                fit options dash draws (atobs estopts() ...; WP-31 C4);
*!                area() boundary droplines(), drawn (WP-31 C5).
*!
*! Not in run_all_cscripts.do yet (WP-23 hands the wiring to the
*! coordinator).  Usage:  cd test, then do "test_help_claims_6.cscript"
*! (the dash directory on the ado-path).

cscript "dash help claims 6: statistical options and weights" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off
set graphics off

do "cert_helpers.do"
quietly do "cert_svg.do"
qui do "../dash_parse.mata"
qui do "../dash.ado"

// twoway's answers (WP-30 test performance, B2): every question below is
// asked of twoway in a run with DASH_CERT_REMEASURE set, and read from
// fixtures/help_claims_6_truth.json otherwise (cert_truth.do).  The
// questions of each case are keyed by the case before it (_hc6_tally).
do "cert_truth.do"
cert_truth_init help_claims_6
python: _dct = __import__("sys").modules["_dash_cert_truth"]

global dash_nobrowser 1

global hc6_nfail    = 0
global hc6_faillist ""

// ----------------------------------------------------------------
// Log scanner: re-join Stata's "> " continuation lines, then count the
// logical lines that carry `needle' and hand back the first.  Mata reads
// the log by value, so nothing in it is ever expanded as a macro.
// ----------------------------------------------------------------
capture mata: mata drop _hc6_scan()
capture mata: mata drop _hc6_json_has()
mata:
void _hc6_scan(string scalar fn, string scalar needle)
{
    real scalar   fh, n
    string scalar line, full, first
    fh = fopen(fn, "r")
    n = 0
    full = ""
    first = ""
    while ((line = fget(fh)) != J(0, 0, "")) {
        if (substr(line, 1, 2) == "> ") {
            full = full + substr(line, 3, .)
            continue
        }
        if (strpos(full, needle) & !strpos(full, "capture noisily")) {
            n = n + 1
            if (first == "") first = full
        }
        full = line
    }
    if (strpos(full, needle) & !strpos(full, "capture noisily")) {
        n = n + 1
        if (first == "") first = full
    }
    fclose(fh)
    st_local("_hc6_n", strofreal(n))
    st_local("_hc6_line", first)
}

real scalar _hc6_json_has(string scalar needle)
{
    return(strpos(st_global("dash_json_hc6"), needle) > 0)
}
end

capture program drop _hc6_tally
program define _hc6_tally
    version 16.0
    args id bad what
    cert_truth_ctx "after `id'"
    if `bad' {
        global hc6_nfail    = ${hc6_nfail} + 1
        global hc6_faillist "${hc6_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(what)'"'
end

// Run a dash command under its own log, from an empty registry; r(rc).
capture program drop _hc6_dash
program define _hc6_dash, rclass
    version 16.0
    args cmdtext
    local lg "`c(tmpdir)'hc6_run.log"
    capture log close _hc6log
    capture erase "`lg'"
    capture dash clear
    set linesize 80
    quietly log using "`lg'", name(_hc6log) text replace
    capture noisily `cmdtext'
    local rc = _rc
    quietly log close _hc6log
    return scalar rc = `rc'
end

// Does the last run's log say `needle'?  r(n) lines, r(line) the first.
capture program drop _hc6_said
program define _hc6_said, rclass
    version 16.0
    args needle
    mata: _hc6_scan("`c(tmpdir)'hc6_run.log", st_local("needle"))
    return scalar n = `_hc6_n'
    return local line `"`macval(_hc6_line)'"'
end

// twoway <plot>, nodraw under its own log, the data preserved and restored:
// `twoway lfit ..., n(0)' leaves the x variable renamed when it fails
// (measured: every later command then says "variable weight not found").
// r(rc).  A plot with no options gets its comma here.
capture program drop _hc6_tw
program define _hc6_tw, rclass
    version 16.0
    args cmdtext
    local lg "`c(tmpdir)'hc6_run.log"
    capture log close _hc6log
    capture erase "`lg'"
    if strpos(`"`cmdtext'"', ",") local twcmd `"twoway `cmdtext' nodraw"'
    else                          local twcmd `"twoway `cmdtext', nodraw"'
    // twoway's answer: asked here in a live run, read back otherwise
    // (cert_truth.do), the same words in the same log either way.
    python: _dct = __import__("sys").modules["_dash_cert_truth"]
    python: _dct.flag("_ct_l")
    if `_ct_l' {
        quietly log using "`lg'", name(_hc6log) text replace
        preserve
        capture noisily `twcmd'
        local rc = _rc
        restore
        quietly log close _hc6log
        python: _dct.log_put("twcmd", "rc", "lg")
    }
    else {
        python: _dct.log_get("twcmd", "lg", "rc")
        if "`rc'" == "" local rc 9
    }
    return scalar rc = `rc'
end

// _hc6_ss <key> <serset#> <twoway plot ...>: draw it (nodraw), save the
// graph, load serset #, name its columns c1..ck and save them to
// c(tmpdir)hc6_<key>.dta.  r(rc), r(N) rows, r(ny) rows with a first
// column, r(xmin)/r(xmax) of the last column over those rows (the x of a
// fit, a band or a histogram), r(c2min)/r(c2max) of the second (the grid
// of a kdensity, whose serset also carries the raw variable last).  The
// data in memory are restored whatever happens.
capture program drop _hc6_ss
program define _hc6_ss, rclass
    version 16.0
    gettoken key 0 : 0
    gettoken set 0 : 0
    local p "`c(tmpdir)'hc6_`key'.gph"
    local d "`c(tmpdir)'hc6_`key'.dta"
    capture erase "`p'"
    capture erase "`d'"
    // twoway's answer -- its rc and the serset's columns -- asked here in a
    // live run and read back otherwise (cert_truth.do): the question is the
    // serset's number and the plot, the saved .dta the same either way
    // (every column a double when read back).
    local _ct_q `"serset `set': twoway `0'"'
    python: _dct = __import__("sys").modules["_dash_cert_truth"]
    python: _dct.flag("_ct_l")
    if `_ct_l' {
        preserve
        capture twoway `0' || , nodraw saving("`p'", replace)
        local rc = _rc
        restore
        python: _dct.rc_put("_ct_q", "rc")
    }
    else {
        python: _dct.rc_get("_ct_q", "rc")
        if "`rc'" == "" local rc 9
    }
    return scalar rc = `rc'
    if `rc' exit
    preserve
    if `_ct_l' {
        capture graph drop _all
        capture serset drop _all
        quietly graph use "`p'"
        quietly serset set `set'
        quietly serset use, clear
        quietly ds
        local i = 0
        foreach v in `r(varlist)' {
            local ++i
            rename `v' c`i'
        }
        python: _dct.data_put("_ct_q")
    }
    else {
        clear
        python: _dct.data_get("_ct_q", "_ct_ok")
        if "`_ct_ok'" != "1" {
            restore
            return scalar rc = 9
            exit
        }
        quietly ds
        local i : word count `r(varlist)'
    }
    quietly count
    return scalar N = r(N)
    quietly count if !missing(c1)
    return scalar ny = r(N)
    quietly summarize c`i' if !missing(c1)
    return scalar xmin = r(min)
    return scalar xmax = r(max)
    if `i' >= 2 {
        quietly summarize c2 if !missing(c1)
        return scalar c2min = r(min)
        return scalar c2max = r(max)
    }
    return scalar ncol = `i'
    quietly save "`d'", replace
    restore
end

// _hc6_same <keyA> <keyB> <ncols> <tol>: are the first ncols columns of the
// two saved sersets equal row by row, to tol (0 = exactly), once each is
// sorted on its last compared column (x) and then the others?  Tied x come
// out of two graphs in different orders (measured: the lowess bwidth(1) and
// bwidth(.8) sersets hold the same 74 rows, five tied pairs swapped).
// r(same), r(maxdiff).
capture program drop _hc6_same
program define _hc6_same, rclass
    version 16.0
    args a b ncols tol
    local order "c`ncols'"
    forvalues j = 1/`=`ncols' - 1' {
        local order "`order' c`j'"
    }
    preserve
    quietly use "`c(tmpdir)'hc6_`b'.dta", clear
    local nb = _N
    sort `order'
    forvalues j = 1/`ncols' {
        rename c`j' b`j'
    }
    keep b*
    tempfile tb
    quietly save `tb'
    quietly use "`c(tmpdir)'hc6_`a'.dta", clear
    local na = _N
    sort `order'
    quietly merge 1:1 _n using `tb', nogenerate
    local same = (`na' == `nb')
    local maxd = 0
    forvalues j = 1/`ncols' {
        quietly count if missing(c`j') != missing(b`j')
        if r(N) local same = 0
        quietly generate double _d = abs(c`j' - b`j')
        quietly summarize _d, meanonly
        if r(N) & r(max) > `maxd' local maxd = r(max)
        drop _d
    }
    if `maxd' > `tol' local same = 0
    restore
    return scalar same = `same'
    return scalar maxdiff = `maxd'
end

sysuse auto, clear
quietly generate double negw  = price - 5000
quietly generate double negfw = round(price / 1000) - 5
quietly generate double zw    = cond(weight == 4840 | weight == 1760, 0, 1)
quietly generate double mw    = cond(weight == 4840 | weight == 1760, ., 1)
quietly generate double cst   = 5
// The helpers preserve the data themselves, and preserve does not nest:
// a case that needs other data loads it and reloads these afterwards.
tempfile hc6_auto
quietly save `hc6_auto'

// ================================================================
// HC6-01, 02 -- bins() is twoway histogram's own name for the bin count
// (twoway_histogram_parse.class: BINs(numlist max=1 >=0 integer)), so
// bin() is its abbreviation; both draw the same bars, and dash takes both
// (test_alias_semantics.cscript AS-05 pins dash's fold).
// ================================================================
_hc6_ss hbins 0 histogram mpg, bins(5)
local r1 = r(rc)
_hc6_ss hbin 0 histogram mpg, bin(5)
local r2 = r(rc)
_hc6_same hbins hbin 3 0
local bad = (`r1' != 0 | `r2' != 0 | r(same) != 1)
_hc6_tally HC6-01 `bad' "twoway histogram takes bins() and bin() alike, the same five bars"

_hc6_tw "histogram mpg, bins(0)"
local t0 = r(rc)
_hc6_tw "histogram mpg, bins(2000)"
local t1 = r(rc)
_hc6_dash "dash histogram mpg, bins(1001) name(hc6)"
local d1 = r(rc)
local bad = (`t0' == 0 | `t1' != 0 | `d1' != 198)
_hc6_tally HC6-02 `bad' "bins(): twoway refuses 0 (r(`t0')) and takes 2000; dash refuses 1001, r(198), its own bound"

// ================================================================
// HC6-03 .. 07 -- bwidth()
// ================================================================
_hc6_ss kbw0 0 kdensity mpg, bwidth(0)
local t = r(rc)
_hc6_ss kbwd 0 kdensity mpg
_hc6_same kbw0 kbwd 2 0
local s = r(same)
_hc6_dash "dash kdensity mpg, bwidth(0) name(hc6)"
// Flipped (WP-31 C10a): dash takes it, as twoway (value_bounds_truth.json).
local bad = (`t' != 0 | `s' != 1 | r(rc) != 0)
_hc6_tally HC6-03 `bad' "kdensity bwidth(0): twoway draws the default bandwidth's curve; dash takes it"

// lowess.ado:75-78: a bandwidth outside (0, 1) is reset to .8.
_hc6_ss lw1 0 lowess mpg weight, bwidth(1)
local r1 = r(rc)
_hc6_ss lw8 0 lowess mpg weight
_hc6_same lw1 lw8 2 0
local s1 = r(same)
_hc6_dash "dash lowess mpg weight, bwidth(1) name(hc6)"
local d = r(rc)
mata: st_local("j", strofreal(_hc6_json_has(char(34) + "bwidth" + char(34) + ":" + char(34) + "1" + char(34))))
local bad = (`r1' != 0 | `s1' != 1 | `d' != 0 | `j' != 1)
_hc6_tally HC6-04 `bad' "lowess bwidth(1): twoway plots the bwidth(.8) serset; dash takes it (the renderer resets it to .8)"

_hc6_ss lw15 0 lowess mpg weight, bwidth(1.5)
_hc6_same lw15 lw8 2 0
local s = r(same)
_hc6_ss lw0 0 lowess mpg weight, bwidth(0)
_hc6_same lw0 lw8 2 0
local s0 = r(same)
_hc6_dash "dash lowess mpg weight, bwidth(1.5) name(hc6)"
local d = r(rc)
_hc6_dash "dash lowess mpg weight, bwidth(0) name(hc6)"
// Flipped (WP-31 C10a): dash takes it, as twoway (value_bounds_truth.json).
local bad = (`s' != 1 | `s0' != 1 | `d' != 0 | r(rc) != 0)
_hc6_tally HC6-05 `bad' "lowess bwidth(1.5) and bwidth(0): twoway resets both to .8; dash takes both (the renderer resets them to .8)"

// twoway kdensity reads width() as the bandwidth.
_hc6_ss kdw 0 kdensity mpg, width(2)
_hc6_ss kdbw 0 kdensity mpg, bwidth(2)
_hc6_same kdw kdbw 2 0
local s = r(same)
_hc6_dash "dash kdensity mpg, width(2) name(hc6)"
local d = r(rc)
_hc6_said "unsupported option"
local nn = r(n)
mata: st_local("jb", strofreal(_hc6_json_has(char(34) + "bwidth" + char(34) + ":" + char(34) + "2" + char(34))))
mata: st_local("jw", strofreal(_hc6_json_has(char(34) + "width" + char(34) + ":")))
local bad = (`s' != 1 | `d' != 0 | `nn' != 0 | `jb' != 1 | `jw' != 0)
if `bad' display as error "HC6-06 FAIL: twoway same=`s'; dash rc=`d' note=`nn' bwidth=`jb' width=`jw'"
_hc6_tally HC6-06 `bad' "kdensity width(2): twoway draws bwidth(2)'s curve; dash registers it as bwidth(2), no note"

_hc6_tw "kdensity mpg, width(2) bwidth(2)"
local t = r(rc)
_hc6_said "options width() and bwidth() may not be combined"
local tw = r(n)
_hc6_dash "dash kdensity mpg, width(2) bwidth(2) name(hc6)"
local d = r(rc)
_hc6_said "options width() and bwidth() may not be combined"
local dw = r(n)
_hc6_dash "dash kdensity mpg, width(2) bw(2) name(hc6)"
local d2 = r(rc)
local bad = (`t' != 198 | `tw' < 1 | `d' != 198 | `dw' < 1 | `d2' != 198)
if `bad' display as error "HC6-07 FAIL: twoway rc=`t' said=`tw'; dash rc=`d' said=`dw'; with bw() rc=`d2'"
_hc6_tally HC6-07 `bad' "width() with bwidth() on kdensity: r(198), twoway's words, in both"

// ================================================================
// HC6-08 -- degree(): twoway takes any whole number from 0 up; dash 0-7
// Flipped (WP-31 C10b): degree(4) is drawn; degree(8), which twoway
// draws too (parsed_values_truth.json degree.8), is dash's bound.  The
// twoway reading stays degree(4)'s, the one this script's truth holds.
// ================================================================
_hc6_tw "lpoly mpg weight, bwidth(400) degree(4)"
local t4 = r(rc)
_hc6_tw "lpoly mpg weight, bwidth(400) degree(-1)"
local tm = r(rc)
// Flipped (WP-31 D35): degree(8) is registered as twoway draws it (the
// renderer notes that the result can differ from Stata's).
_hc6_dash "dash lpoly mpg weight, degree(8) name(hc6)"
local d4 = r(rc)
_hc6_said "dash fits local polynomials up to degree 7"
local dw = r(n)
local bad = (`t4' != 0 | `tm' != 198 | `d4' != 0 | `dw' != 0)
_hc6_tally HC6-08 `bad' "degree(8): twoway rc 0, degree(-1) r(198); dash takes 8"

// ================================================================
// HC6-09, 10 -- kernel()
// ================================================================
_hc6_tw "lpoly mpg weight, bwidth(400) kernel(gau)"
local ta = r(rc)
_hc6_tw "kdensity mpg, kernel(epan)"
local tb = r(rc)
_hc6_tw "lpoly mpg weight, bwidth(400) kernel(GAUSSIAN)"
local tc = r(rc)
// WP-27: dash takes twoway's abbreviations and registers the full name;
// it refused kernel(gau), r(198).  HC6-57 walks every prefix.
_hc6_dash "dash lpoly mpg weight, kernel(gau) name(hc6)"
local da = r(rc)
mata: st_local("ja", strofreal(_hc6_json_has(char(34) + "kernel" + char(34) + ":" + char(34) + "gaussian" + char(34))))
_hc6_dash "dash kdensity mpg, kernel(epan) name(hc6)"
local db = r(rc)
mata: st_local("jb", strofreal(_hc6_json_has(char(34) + "kernel" + char(34) + ":" + char(34) + "epanechnikov" + char(34))))
_hc6_dash "dash lpoly mpg weight, kernel(GAUSSIAN) name(hc6)"
local dc = r(rc)
mata: st_local("j", strofreal(_hc6_json_has(char(34) + "kernel" + char(34) + ":" + char(34) + "gaussian" + char(34))))
local bad = (`ta' != 0 | `tb' != 0 | `tc' != 198 | `da' != 0 | `ja' != 1 | `db' != 0 | `jb' != 1 | `dc' != 0 | `j' != 1)
_hc6_tally HC6-09 `bad' "kernel(): twoway takes gau and epan and refuses GAUSSIAN; dash takes gau and epan as gaussian and epanechnikov, and reads GAUSSIAN as gaussian"

// HC6-57 (WP-27): every prefix of every kernel name, on lpoly, lpolyci and
// kdensity: dash takes what twoway takes, refuses what it refuses with
// twoway's r(198), and registers the full name.  Measured 24sep2026: ep,
// epa and epan are epanechnikov; epan2 only in full; bi, cos, gau, par,
// rec and tri are the shortest of the others; e, co, ga, pa, re, tr are
// refused.
local bad = 0
foreach t in lpoly lpolyci kdensity {
    local vars = cond("`t'" == "kdensity", "mpg", "mpg weight")
    local bwo  = cond("`t'" == "kdensity", "", "bwidth(400)")
    foreach k in epanechnikov epan2 biweight cosine gaussian parzen rectangle triangle {
        forvalues i = 1/`=strlen("`k'")' {
            local a = substr("`k'", 1, `i')
            _hc6_tw "`t' `vars', `bwo' kernel(`a')"
            local trc = r(rc)
            _hc6_dash "dash `t' `vars', kernel(`a') name(hc6)"
            local drc = r(rc)
            if `trc' != `drc' {
                display as error "HC6-57 FAIL: `t' kernel(`a'): twoway rc `trc', dash rc `drc'"
                local bad = 1
            }
            if `drc' == 0 {
                // Which full name twoway's abbreviation stands for: the
                // name itself, except that ep, epa and epan are
                // epanechnikov's.
                local full "`k'"
                if "`k'" == "epan2" & `i' < 5 local full "epanechnikov"
                mata: st_local("jk", strofreal(_hc6_json_has(char(34) + "kernel" + char(34) + ":" + char(34) + st_local("full") + char(34))))
                if `jk' != 1 {
                    display as error "HC6-57 FAIL: `t' kernel(`a') did not register `full'"
                    local bad = 1
                }
            }
        }
    }
}
_hc6_tally HC6-57 `bad' "kernel(): every prefix twoway takes on lpoly, lpolyci and kdensity dash takes, as the full name, and every one it refuses dash refuses, r(198)"

_hc6_tw "lpoly mpg weight, bwidth(400) gaussian"
local t = r(rc)
_hc6_dash "dash lpoly mpg weight, gaussian name(hc6)"
local d = r(rc)
_hc6_said "unsupported option(s)"
local nn = r(n)
mata: st_local("j", strofreal(_hc6_json_has(char(34) + "kernel" + char(34) + ":" + char(34) + "gaussian" + char(34))))
local bad = (`t' != 0 | `d' != 0 | `nn' != 0 | `j' != 1)
_hc6_tally HC6-10 `bad' "a bare gaussian: twoway's old kernel syntax, drawn as kernel(gaussian); dash registers kernel(gaussian) and notes nothing (test_twoway_option_parity.cscript TP-16 holds every spelling to twoway's serset)"

// ================================================================
