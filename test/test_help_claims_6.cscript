// With no base(), when 0 lies outside y's range (mpg 17 to 22 on the first
// three cars), twoway's y axis stops at 17 and the bars, spikes, drops and
// area are drawn from the plot region's edge -- read off its SVG export
// too -- where base(0) takes the axis to 0.  dash draws them from the same
// place, in both modes (WP-30 P1.17b): its saved renderer's default base
// is read from the tagged base column and must equal twoway's 17.
python:
def _hc6_dash_base(sp, dp, local):
    import sys, os, warnings
    sys.path.insert(0, os.path.abspath(".."))
    import dash_render as dr
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
    out = []
    for f in r.figures.values():
        for rd in f.renderers:
            bs = dr._dash_base_spec(rd)
            if bs and bs["auto"]:
                v = getattr(rd.glyph, bs["prop"])
                fld = v if isinstance(v, str) else getattr(v, "field", None)
                out += sorted({"%g" % float(x) for x in rd.data_source.data[fld]})
    __import__("sfi").Macro.setLocal(local, " ".join(out))
__import__("__main__")._hc6_dash_base = _hc6_dash_base
end
local bad = 0
python: _dct.flag("_ct_l")
foreach t in bar spike dropline area {
    // twoway's y axis minimum (asked in a live run, read back otherwise)
    local _ct_q0 "twoway `t' mpg weight in 1/3"
    local _ct_q1 "twoway `t' mpg weight in 1/3, base(0)"
    if `_ct_l' {
        quietly twoway `t' mpg weight in 1/3, name(hc6b, replace)
        local m0 "`.hc6b.plotregion1.yscale.curmin'"
        quietly twoway `t' mpg weight in 1/3, base(0) name(hc6b, replace)
        local m1 "`.hc6b.plotregion1.yscale.curmin'"
        python: _dct.val_put("yscale.curmin", "_ct_q0", "m0")
        python: _dct.val_put("yscale.curmin", "_ct_q1", "m1")
    }
    else {
        python: _dct.val_get("yscale.curmin", "_ct_q0", "m0")
        python: _dct.val_get("yscale.curmin", "_ct_q1", "m1")
    }
    if "`m0'" != "17" | "`m1'" != "0" {
        display as error "HC6-23b FAIL: twoway `t': y axis from `m0' by default, `m1' with base(0)"
        local bad = 1
    }
    capture graph drop hc6b
    capture dash clear
    quietly dash `t' mpg weight in 1/3, name(hc6b)
    local _db_s "`c(tmpdir)'hc6b_spec.json"
    local _db_d "`c(tmpdir)'hc6b_data.json"
    quietly _dash_serve_spec, specpath("`_db_s'") datapath("`_db_d'")
    python: __import__("__main__")._hc6_dash_base(r"`_db_s'", r"`_db_d'", "_db_b")
    capture erase "`_db_s'"
    capture erase "`_db_d'"
    capture dash clear
    if "`_db_b'" != "`m0'" {
        display as error "HC6-23b FAIL: dash `t': drawn from `_db_b', twoway from `m0'"
        local bad = 1
    }
}
capture graph drop hc6b
_hc6_tally HC6-23b `bad' "twoway's default base: the axis stops at the data (17), not 0, on bar spike dropline area, and dash draws from 17"

