*! test_parser.cscript  v2.0
*! Certification script for the dash command parsing (syntax-based, v2.0 architecture).
*!
*! Tests: P1A-31 through P1A-85  (rewritten for syntax-based parsing), and
*!        FX-01 through FX-11 (function evaluated by Stata, WP-29 P0.6)
*!        FN-02 through FN-05 (a function layer without Stata's points, WP-30 P1.22)
*!
*! In v2.0 parsing is done via Stata's -syntax- command rather than a
*! hand-rolled Mata parser.  These tests exercise:
*!   - _dash_plot_opts  : option parsing program
*!   - _dash_parse_graph_opts : graph-level option parsing program
*!   - _dash_parse_varpart_std etc. : varlist/if/in parsing programs
*!   - _dash_process_segment : full segment parse to JSON fragment
*!   - End-to-end via dash command (no jsonio/render required)
*!
*! twoway's answers are measured once and replayed (WP-30 test performance,
*! B2; cert_truth.do): P1A-77..84 and FX-01..05 hold dash to twoway's
*! return codes, its words and the state it leaves, which a certification
*! run reads from test/fixtures/parser_twoway_truth.json;
*! scripts/extract_twoway_oracle_truth.do writes it by running this script
*! with twoway asked, and DASH_CERT_REMEASURE=1 asks twoway in the run again
*! and fails on any answer that is no longer the fixture's (the release run).
*!
*! NP-40..NP-42 (WP-30 P1.14a): the named styles and p() reach the spec by
*! value; p()'s drop list holds per series.
*!
*! Usage:  do test/test_parser.cscript
*! Version: 2.0  27mar2026

cscript "dash syntax-based parser" adodir ".."
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}

// ----------------------------------------------------------------
// Setup
// ----------------------------------------------------------------
qui sysuse auto, clear
do "../dash_parse.mata"
do "../dash.ado"

// twoway's answers (WP-30 test performance, B2): every question below is
// asked of twoway in a run with DASH_CERT_REMEASURE set, and read from
// fixtures/parser_twoway_truth.json otherwise (cert_truth.do).  Each is
// keyed by its case and the data in memory (cert_truth_ctx).
do "cert_truth.do"
cert_truth_init parser_twoway
python: _dct = __import__("sys").modules["_dash_cert_truth"]

// ================================================================
// P1A-31 — _dash_parse_varpart_std parses yvar xvar correctly
// ================================================================
_dash_parse_varpart_std mpg weight
assert "`s(varlist)'" == "mpg weight"
assert "`s(if_clause)'" == ""
assert "`s(in_clause)'" == ""
display "P1A-31 PASS: varpart_std parses mpg weight → correct varlist"

// ================================================================
// P1A-32 — _dash_parse_varpart_std parses if clause
// ================================================================
_dash_parse_varpart_std mpg weight if foreign == 1
assert "`s(varlist)'" == "mpg weight"
// syntax sets `if' = " if foreign == 1" (with leading keyword)
assert strpos(`"`s(if_clause)'"', "foreign == 1") > 0
display "P1A-32 PASS: varpart_std correctly extracts if clause"

// ================================================================
// P1A-33 — _dash_parse_varpart_std errors on non-existent variable
// ================================================================
capture {
    _dash_parse_varpart_std mpg nonexistent_var_xyz
}
assert _rc != 0
display "P1A-33 PASS: non-existent variable causes error"

// ================================================================
// P1A-34 — _dash_parse_plot_opts expands abbreviations via pre-expansion
// ================================================================
// Pre-expand then call
_dash_parse_plot_opts , mc(red) ms(circle)
assert "`s(mcolor)'" == "red"
assert "`s(msymbol)'" == "circle"
display "P1A-34 PASS: mc and ms resolved by syntax to mcolor/msymbol"

// ================================================================
// P1A-35 — _dash_parse_plot_opts: graph-level option separated
// ================================================================
_dash_parse_plot_opts , mc(red) title(My Title)
assert "`s(mcolor)'" == "red"
assert `"`s(g_title)'"' == "My Title"
display "P1A-35 PASS: plot opt mc and graph opt title correctly separated"

// ================================================================
// P1A-36 — _dash_parse_graph_opts: name() and saving() parsed
// ================================================================
_dash_parse_graph_opts , name(g1) saving(out.html)
assert `"`s(name)'"'   == "g1"
assert `"`s(saving)'"' == "out.html"
display "P1A-36 PASS: name() and saving() parsed by _dash_parse_graph_opts"

// ================================================================
// P1A-37 — _dash_process_segment: scatter produces correct JSON
// ================================================================
_dash_process_segment "scatter mpg weight" _pt _json
assert "`_pt'" == "scatter"
assert strpos(`"`_json'"', `"scatter"') > 0
assert strpos(`"`_json'"', "mpg") > 0
assert strpos(`"`_json'"', "weight") > 0
display "P1A-37 PASS: segment 'scatter mpg weight' → correct JSON fragment"

// ================================================================
// P1A-38 — _dash_process_segment: scatter with mc(red) puts mcolor in options
// ================================================================
_dash_process_segment "scatter mpg weight, mc(red)" _pt2 _json2
assert "`_pt2'" == "scatter"
// mcolor must be in the "options" sub-object, not at the top level
local opts_section = substr(`"`_json2'"', strpos(`"`_json2'"', `""options""'), .)
assert strpos(`"`opts_section'"', "mcolor") > 0
assert strpos(`"`opts_section'"', "red") > 0
display "P1A-38 PASS: mc(red) → mcolor:red inside options{} in JSON"

// ================================================================
// P1A-39 — _dash_process_segment: graph-level title propagated via c_local
// ================================================================
// The segment hands its graph-level options back as _sg_* locals, which
// _dash_plot merges into its g_* accumulators as twoway merges a repeated
// option (TP-14); it no longer writes over g_* itself.
local g_title ""
local _sg_title ""
_dash_process_segment `"scatter mpg weight, title(My Plot)"' _pt3 _json3
// _sg_title should now be set via c_local in _dash_process_segment
assert `"`_sg_title'"' == "My Plot"
assert `"`g_title'"' == ""
display "P1A-39 PASS: title() propagated to _sg_title via c_local"

// ================================================================
// P1A-40 — _dash_expand_plottype: abbreviation expansion works
// ================================================================
local pt_exp ""
mata: _dash_expand_plottype("sc", "_pttest")
assert "`_pttest'" == "scatter"
mata: _dash_expand_plottype("li", "_pttest2")
assert "`_pttest2'" == "line"
mata: _dash_expand_plottype("hist", "_pttest3")
assert "`_pttest3'" == "histogram"
display "P1A-40 PASS: sc→scatter, li→line, hist→histogram expanded"

// ================================================================
// P1A-41 — _dash_process_segment: unknown plot type → error 198
// ================================================================
capture {
    _dash_process_segment "foobar mpg weight" _ptx _jx
}
assert _rc == 198
display "P1A-41 PASS: unsupported plot type → error 198"

// ================================================================
// P1A-42 — _dash_process_segment: injection attempt in option value
//           treated as literal (no code execution)
// ================================================================
// The option value "; import os" should be stored as a literal string
capture {
    _dash_process_segment `"scatter mpg weight, mc(red; import os)"' _ptinj _jinj
}
// Parser should succeed (option value is opaque text)
assert _rc == 0
assert strpos(`"`_jinj'"', "mcolor") > 0
display "P1A-42 PASS: injection attempt in option value stored as literal"

// ================================================================
// P1A-43 — _dash_parse_varpart_1v enforces exactly 1 variable
// ================================================================
capture {
    _dash_parse_varpart_1v mpg weight
}
assert _rc != 0
_dash_parse_varpart_1v mpg
assert "`s(varlist)'" == "mpg"
display "P1A-43 PASS: varpart_1v enforces single variable"

// ================================================================
// P1A-44 — fa() still resolves to falpha() through Stata's syntax
// (regression: fa was historically a dash-only alias; it is kept as
//  falpha's minimum abbreviation now that the Mata table is gone)
// ================================================================
_dash_parse_plot_opts , fc(ltblue) fa(0.4)
assert "`s(fcolor)'"  == "ltblue"
assert "`s(falpha)'"  == "0.4"
display "P1A-44 PASS: fa and fc resolved by syntax to falpha/fcolor"

// ================================================================
// P1A-45 — fa() works on histogram in a compound spec (end-to-end)
// (regression: histogram, fc(ltblue) fa(0.4) previously error-ed)
// ================================================================
sysuse auto, clear
dash clear
capture {
    dash (histogram mpg, fc(ltblue) fa(0.4)) (kdensity mpg), name(u3)
}
assert _rc == 0
display "P1A-45 PASS: fa() accepted on histogram in compound spec"
dash clear

// ================================================================
// P1A-46 — _dash_parse_plot_opts accepts all Stata 18 colorvar_options
//           (regression: colordiscrete etc. previously caused r(198))
// ================================================================
_dash_parse_plot_opts , colorvar(foreign) colordiscrete coloruseplegend colornlevels(4) colorcuts(2000 3000 4000) colormissing(gray)
assert `"`s(colorvar)'"'      == "foreign"
assert `"`s(colordiscrete)'"' != ""
assert `"`s(coloruseplegend)'"' != ""
assert `"`s(colornlevels)'"'  == "4"
assert strpos(`"`s(colorcuts)'"', "2000") > 0
assert `"`s(colormissing)'"'  == "gray"
display "P1A-46 PASS: colorvar_options (colordiscrete, coloruseplegend, colornlevels, colorcuts, colormissing) accepted"

// ================================================================
// P1A-47 — _dash_process_segment: colordiscrete propagates into JSON
// ================================================================
_dash_process_segment "scatter mpg weight, colorvar(foreign) colordiscrete" _pt46 _json46
assert "`_pt46'" == "scatter"
local opts46 = substr(`"`_json46'"', strpos(`"`_json46'"', `""options""'), .)
assert strpos(`"`opts46'"', "colorvar") > 0
assert strpos(`"`opts46'"', "foreign") > 0
assert strpos(`"`opts46'"', "colordiscrete") > 0
display "P1A-47 PASS: colordiscrete propagates through segment JSON"

// ================================================================
// P1A-48 — _dash_extract_vars must include the colorvar() variable
// REGRESSION: previously colorvar was omitted from the jsonio varlist,
// so value labels for the colorvar variable never reached the renderer
// and the legend showed numeric codes instead of "Domestic"/"Foreign".
// ================================================================
local _seg_json `"{"type":"scatter","yvar":"mpg","xvar":"weight","options":{"colorvar":"foreign","colordiscrete":"colordiscrete"}}"'
mata: _dash_extract_vars(`"`_seg_json'"', "_p1a48_vars")
assert `: list posof "mpg"     in _p1a48_vars' > 0
assert `: list posof "weight"  in _p1a48_vars' > 0
assert `: list posof "foreign" in _p1a48_vars' > 0
display "P1A-48 PASS: _dash_extract_vars includes colorvar variable"

// ================================================================
// P1A-49..57 -- the twoway plot types dash refused (WP-22 TR-22.1, TR-22.4)
//
// Measured 23sep2026 with the console binary: twoway draws contour,
// contourline, pcarrowi and pccapsym (rc 0) and takes no abbreviation of
// any of them ("pccapsy is not a twoway plot type", r(198); `con' is
// connected, and cont .. contou are not plot types).  dash answered all
// four with r(198) "unrecognised plot type" and its Supported: list.
// pcarrowi and pccapsym are drawn now.  contour and contourline draw a
// surface interpolated over a grid -- another data model -- and are
// refused as what they are, with what to use instead.
// ================================================================
do "cert_helpers.do"

// Run one command under a log of its own, at a linesize that keeps each
// message on one line, and hand back its rc and the log.  A twoway
// command's answer -- its rc and the words it logs -- is asked here in a
// live run and read back otherwise (cert_truth.do), the same words in the
// same log either way; every other command (dash's) runs.
capture program drop _p1a_logrun
program define _p1a_logrun, rclass
    version 16.0
    args cmdtext
    local logfile "`c(tmpdir)'dash_p1a_run.log"
    mata: st_local("_ct_tw", strofreal(substr(st_local("cmdtext"), 1, 7) == "twoway "))
    local _ct_l 1
    if `_ct_tw' {
        python: _dct = __import__("sys").modules["_dash_cert_truth"]
        python: _dct.flag("_ct_l")
    }
    if `_ct_l' {
        local ls = c(linesize)
        set linesize 255
        capture log close _p1alog
        capture erase "`logfile'"
        quietly log using "`logfile'", name(_p1alog) text replace
        capture noisily `cmdtext'
        local rc = _rc
        quietly log close _p1alog
        set linesize `ls'
        if `_ct_tw' {
            python: _dct.log_put("cmdtext", "rc", "logfile")
        }
    }
    else {
        python: _dct.log_get("cmdtext", "logfile", "rc")
        if "`rc'" == "" local rc 9
    }
    return scalar rc  = `rc'
    return local  log "`logfile'"
end

// ================================================================
// P1A-49 -- twoway contour: drawn since WP-31 B4b
// ================================================================
// Flipped (WP-31 B4b): dash refused contour by name, r(198) "a twoway
// plot type dash does not draw"; the refusal was dash's gap, twoway draws
// contour, and so does dash now, z y x into the spec's zvar, yvar, xvar.
sysuse auto, clear
dash clear
_p1a_logrun "dash contour mpg weight length, name(p1a49)"
assert r(rc) == 0
local lg49 "`r(log)'"
cert_file_has "`lg49'", needle("a twoway plot type dash does not draw")
assert r(found) == 0
_dash_process_segment "contour mpg weight length" _pt49 _js49
assert "`_pt49'" == "contour"
assert strpos(`"`_js49'"', `""type":"contour","zvar":"mpg","yvar":"weight","xvar":"length""') > 0
dash clear
display "P1A-49 PASS: twoway contour registers z y x as zvar, yvar and xvar (drawn since WP-31 B4b)"

// ================================================================
// P1A-50 -- twoway contourline: drawn since WP-31 B4b
// ================================================================
// Flipped (WP-31 B4b): refused by name before; twoway draws it.
_p1a_logrun "dash contourline mpg weight length, name(p1a50)"
assert r(rc) == 0
_dash_process_segment "contourline mpg weight length" _pt50 _js50
assert "`_pt50'" == "contourline"
assert strpos(`"`_js50'"', `""type":"contourline","zvar":"mpg","yvar":"weight","xvar":"length""') > 0
dash clear
display "P1A-50 PASS: twoway contourline registers z y x (drawn since WP-31 B4b)"

// ================================================================
// P1A-51 -- the names in any case and inside a multi-plot command; no
// prefix is taken, as twoway takes none
// ================================================================
// Flipped (WP-31 B4b): the upper-case name and the multi-plot command
// were refused by name; both draw now.  The prefix part stands.
_p1a_logrun "dash CONTOUR mpg weight length, name(p1a51)"
assert r(rc) == 0
dash clear
_p1a_logrun "dash (scatter mpg weight) (contourline mpg weight length), name(p1a51b)"
assert r(rc) == 0
dash clear
// twoway takes no abbreviation of either name: "contourl is not a twoway
// plot type", in twoway's words (WP-31 A2).
_p1a_logrun "dash contourl mpg weight length, name(p1a51c)"
assert r(rc) == 198
cert_file_has "`r(log)'", needle("contourl is not a twoway plot type")
assert r(found) == 1
_p1a_logrun "dash contou mpg weight length, name(p1a51d)"
assert r(rc) == 198
cert_file_has "`r(log)'", needle("contou is not a twoway plot type")
assert r(found) == 1
assert "${dash_graph_registry}" == ""
display "P1A-51 PASS: contour and contourline draw in any case and inside a multi-plot command; their prefixes stay unrecognised"

// ================================================================
// P1A-52 -- pccapsym: four variables, the paired-coordinate keys
// ================================================================
_dash_process_segment "pccapsym mpg weight turn length, msymbol(D) mcolor(red) lcolor(navy) mlabel(make)" _pt52 _json52
assert "`_pt52'" == "pccapsym"
assert strpos(`"`_json52'"', `""type":"pccapsym","y1var":"mpg","x1var":"weight","y2var":"turn","x2var":"length""') > 0
foreach k in msymbol mcolor lcolor mlabel {
    assert strpos(`"`_json52'"', `""`k'":"') > 0
}
// twoway: "pccapsym requires 4 variables", r(102) for three, r(103) for five.
capture _dash_process_segment "pccapsym mpg weight turn" _ptx _jx
assert _rc == 102
capture _dash_process_segment "pccapsym mpg weight turn length price" _ptx _jx
assert _rc == 103
display "P1A-52 PASS: pccapsym is parsed as four variables and written with the paired-coordinate keys"

// ================================================================
// P1A-53 -- pcarrowi: twoway's immediate values, one record per arrow
//
// #y1 #x1 #y2 #x2 [(#clockpos)] ["label"] ... is written as
// [y1,x1,y2,x2] or [y1,x1,y2,x2,"label",clock].  Numbers are rewritten as
// JSON numbers (.5 is 0.5, 1d3 is 1000), "." and .a are null, and a label
// has every character JSON or a Stata macro could misread escaped: the
// apostrophe is written as a backslash and u0027, so no label can close a
// compound quote.  The backslash is char(92) here, never typed.
// ================================================================
local bs = char(92)
_dash_process_segment `"pcarrowi 0 0 0 1 (3) "3 o'clock" 0 0 1 0 (12) "12 o'clock""' _pt53 _json53
assert "`_pt53'" == "pcarrowi"
assert strpos(`"`_json53'"', `""values":[[0,0,0,1,"3 o`bs'u0027clock",3],[0,0,1,0,"12 o`bs'u0027clock",12]]"') > 0
_dash_process_segment "pcarrowi 20 3000 30 4000" _pt53 _json53
assert strpos(`"`_json53'"', `""values":[[20,3000,30,4000]]"') > 0
_dash_process_segment "pcarrowi .5 -.5 1e3 . +2 1d3 .a 7 (9)" _pt53 _json53
assert strpos(`"`_json53'"', `""values":[[0.5,-0.5,1000,null],[2,1000,null,7,"",9]]"') > 0
_dash_process_segment `"pcarrowi 1 2 3 4 "A" 5 6 7 8 `"say "hi""' 9 9 9 9 ( 12 )"' _pt53 _json53
assert strpos(`"`_json53'"', `""values":[[1,2,3,4,"A",null],[5,6,7,8,"say \"hi\"",null],[9,9,9,9,"",12]]"') > 0
// A clock position twoway accepts that is not a whole number is carried
// as written; the renderer draws it at 3 and says so.
_dash_process_segment "pcarrowi 0 0 0 1 (3.5) 0 0 1 0 (012)" _pt53 _json53
assert strpos(`"`_json53'"', `""values":[[0,0,0,1,"",3.5],[0,0,1,0,"",12]]"') > 0
display "P1A-53 PASS: pcarrowi's immediate values are written one record per arrow, with labels and clock positions"

// ================================================================
// P1A-54 -- pcarrowi refuses what twoway refuses, r(198)
//
// twoway: "invalid point," for a token that is not a number where a
// coordinate belongs -- a label or clock position before the first arrow,
// a second label, a label inside a record; "invalid position, 13" for a
// clock position outside 0..12; "invalid observation number" for no arrow.
// ================================================================
_p1a_logrun "dash pcarrowi 0 0 0 abc, name(p1a54)"
assert r(rc) == 198
cert_file_has "`r(log)'", needle("dash: pcarrowi takes four numbers for each arrow, #y1 #x1 #y2 #x2; 'abc' is not a number.")
assert r(found) == 1
_p1a_logrun "dash pcarrowi (3) 0 0 0 1, name(p1a54b)"
assert r(rc) == 198
cert_file_has "`r(log)'", needle("'(3)' is not a number.")
assert r(found) == 1
_p1a_logrun `"dash pcarrowi 0 0 0 1 (13) "x", name(p1a54c)"'
assert r(rc) == 198
cert_file_has "`r(log)'", needle("dash: pcarrowi: invalid position, 13; a clock position is a number from 0 to 12.")
assert r(found) == 1
_p1a_logrun `"dash pcarrowi "A", name(p1a54d)"'
assert r(rc) == 198
cert_file_has "`r(log)'", needle("dash: pcarrowi needs at least one arrow, four numbers #y1 #x1 #y2 #x2.")
assert r(found) == 1
foreach seg in `"pcarrowi 0 0 0 1 "A" "B" 1 1 2 2"' `"pcarrowi 0 0 "A" 0 1"' ///
               "pcarrowi 0 0 0 1 (-1)" "pcarrowi 0 0 0 1 (abc)" ///
               "pcarrowi 0 0 0 1 1 1 2 2x" "pcarrowi 1+1 0 0 1" {
    capture _dash_process_segment `"`seg'"' _ptx _jx
    assert _rc == 198
}
assert "${dash_graph_registry}" == ""
display "P1A-54 PASS: pcarrowi refuses a non-number where a coordinate belongs, a clock position outside 0..12, and an empty list"

// ================================================================
// P1A-55 -- what is left at the end, too little for an arrow, is dropped
// as twoway drops it (measured: `pcarrowi 0 0 0 1 0 0 1' draws one
// arrow, rc 0) -- and dash says so
// ================================================================
dash clear
_p1a_logrun "dash pcarrowi 0 0 0 1 0 0 1, name(p1a55)"
assert r(rc) == 0
cert_file_has "`r(log)'", needle("dash: pcarrowi ignored '0 0 1' at the end, too little for another arrow (#y1 #x1 #y2 #x2), as twoway does.")
assert r(found) == 1
assert strpos(`"${dash_json_p1a55}"', `""values":[[0,0,0,1]]"') > 0
_dash_process_segment `"pcarrowi 0 0 0 1 "x" (3)"' _pt55 _json55
assert strpos(`"`_json55'"', `""values":[[0,0,0,1,"x",null]]"') > 0
dash clear
display "P1A-55 PASS: an incomplete arrow at the end is dropped, as twoway drops it, with a note"

// ================================================================
// P1A-56 -- TR-22.4: every plot type is routed by list membership
//
// The range test was a string inlist() of ptype and nine literals,
// Stata's limit: a tenth range type would have been r(130).  Each family
// is a word list now (_dash_plottype_families).  Every type dash draws is
// routed here to its varlist parser and JSON keys, and a tenth and an
// eleventh range member are found by `: list ... in' where inlist() of
// the same membership is r(130).
// ================================================================
sysuse auto, clear
quietly generate double lo = mpg - 3
quietly generate double hi = mpg + 3
local fam_var   "histogram kdensity"
local fam_yvar1 "rarea rbar rspike rcap rline rconnected rcapsym rscatter"
local fam_y1var "pcspike pcarrow pcbarrow pcscatter pccapsym"
local fam_yvar  "scatter line connected area bar spike lfit qfit lfitci qfitci lowess lpoly lpolyci fpfit fpfitci dot dropline mspline mband"
local fam_rpt   "rpcap rpspike"
local n56 = 0
// tsline and tsrline, of the standard and the range family, draw against
// the time variable tsset set and take no x of their own, as twoway does
// (test_help_claims_1.cscript HC1-09): the x written is the time variable.
quietly generate int zt56 = _n
quietly tsset zt56
_dash_process_segment "tsline mpg" _pt56 _js56
assert "`_pt56'" == "tsline"
assert strpos(`"`_js56'"', `""type":"tsline","yvar":"mpg","xvar":"zt56""') > 0
_dash_process_segment "tsrline lo hi" _pt56 _js56
assert "`_pt56'" == "tsrline"
assert strpos(`"`_js56'"', `""type":"tsrline","yvar1":"lo","yvar2":"hi","xvar":"zt56""') > 0
local n56 = `n56' + 2
quietly tsset, clear
drop zt56
foreach t of local fam_var {
    _dash_process_segment "`t' mpg" _pt56 _js56
    assert "`_pt56'" == "`t'"
    assert strpos(`"`_js56'"', `""type":"`t'","var":"mpg""') > 0
    local ++n56
}
foreach t of local fam_yvar1 {
    _dash_process_segment "`t' lo hi weight" _pt56 _js56
    assert "`_pt56'" == "`t'"
    assert strpos(`"`_js56'"', `""type":"`t'","yvar1":"lo","yvar2":"hi","xvar":"weight""') > 0
    local ++n56
}
foreach t of local fam_y1var {
    _dash_process_segment "`t' mpg weight turn length" _pt56 _js56
    assert "`_pt56'" == "`t'"
    assert strpos(`"`_js56'"', `""type":"`t'","y1var":"mpg","x1var":"weight","y2var":"turn","x2var":"length""') > 0
    local ++n56
}
foreach t of local fam_yvar {
    _dash_process_segment "`t' mpg weight" _pt56 _js56
    assert "`_pt56'" == "`t'"
    assert strpos(`"`_js56'"', `""type":"`t'","yvar":"mpg","xvar":"weight""') > 0
    local ++n56
}
// WP-31 B1: rpcap and rpspike, y1 y2 y3 x.
foreach t of local fam_rpt {
    _dash_process_segment "`t' lo hi mpg weight" _pt56 _js56
    assert "`_pt56'" == "`t'"
    assert strpos(`"`_js56'"', `""type":"`t'","yvar1":"lo","yvar2":"hi","yvar":"mpg","xvar":"weight""') > 0
    local ++n56
}
// WP-31 B4b: contour and contourline, z y x.
foreach t in contour contourline {
    _dash_process_segment "`t' mpg weight length" _pt56 _js56
    assert "`_pt56'" == "`t'"
    assert strpos(`"`_js56'"', `""type":"`t'","zvar":"mpg","yvar":"weight","xvar":"length""') > 0
    local ++n56
}
_dash_process_segment "scatteri 20 3000" _pt56 _js56
assert strpos(`"`_js56'"', `""type":"scatteri","values":[[20,3000]]"') > 0
// pci is written one record per segment, as pcarrowi is (P1A-63): it was
// [[20,3000],[30,4000]], two points the renderer paired up again.
_dash_process_segment "pci 20 3000 30 4000" _pt56 _js56
assert strpos(`"`_js56'"', `""type":"pci","values":[[20,3000,30,4000]]"') > 0
_dash_process_segment "pcarrowi 20 3000 30 4000" _pt56 _js56
assert strpos(`"`_js56'"', `""type":"pcarrowi","values":[[20,3000,30,4000]]"') > 0
_dash_process_segment "function y=x" _pt56 _js56
assert strpos(`"`_js56'"', `""type":"function","expr":"x""') > 0
local n56 = `n56' + 4
// 40 -> 42: WP-31 B1 rpcap and rpspike drawn
// 42 -> 44: WP-31 B4b contour and contourline drawn
assert `n56' == 44
_dash_plottype_families
assert "`_pt_univar'"  == "histogram kdensity"
assert "`_pt_range'"   == "rarea rbar rspike rcap rline rconnected rcapsym rscatter tsrline"
assert "`_pt_pc'"      == "pcspike pcarrow pcbarrow pcscatter pccapsym"
assert "`_pt_rangept'" == "rpcap rpspike"
assert "`_pt_contour'" == "contour contourline"
assert "`_pt_literal'" == "scatteri pci pcarrowi function"
local _pt_range "`_pt_range' zz10 zz11"
foreach ptype in rarea tsrline zz10 zz11 {
    assert `: list ptype in _pt_range'
}
local ptype "zz12"
assert !`: list ptype in _pt_range'
capture noisily display inlist("zz10", "rarea", "rbar", "rspike", "rcap", "rline", "rconnected", "rcapsym", "rscatter", "tsrline", "zz10")
assert _rc == 130
display "P1A-56 PASS: all 44 plot types are routed by family lists, and a tenth range member is found where inlist() would be r(130)"

// ================================================================
// P1A-57 -- the Mata table: the full names only, as twoway takes them
// ================================================================
foreach t in pccapsym pcarrowi pcarrow pci scatteri pcspike {
    mata: _dash_expand_plottype("`t'", "_pt57")
    assert "`_pt57'" == "`t'"
}
mata: _dash_expand_plottype("PCCAPSYM", "_pt57")
assert "`_pt57'" == "pccapsym"
// Flipped (WP-31 B4b): contour and contourline expand to themselves
// now that dash draws them; their prefixes stay unrecognised.
foreach t in contour contourline {
    mata: _dash_expand_plottype("`t'", "_pt57")
    assert "`_pt57'" == "`t'"
}
foreach t in pc pcc pcca pccap pccaps pccapsy pcarr pcarro cont contou contourl contourlin {
    mata: _dash_expand_plottype("`t'", "_pt57")
    assert "`_pt57'" == ""
}
display "P1A-57 PASS: pccapsym and pcarrowi expand by their full names only, as twoway takes them"

// ================================================================
// P1A-58 -- the Mata helpers behind P1A-49..57, one by one
// Every expected backslash is char(92), never typed.
// ================================================================
mata:
bs = char(92)
q  = char(34)
// _dash_undrawn_plottype: the names, any case, and nothing else.
// Flipped (WP-31 B1): rpcap and rpspike are drawn, so no longer named.
// Flipped (WP-31 B4b): contour and contourline are drawn too.
assert(_dash_undrawn_plottype("contour") == "")
assert(_dash_undrawn_plottype(" CONTOURLINE ") == "")
assert(_dash_undrawn_plottype("RPCAP") == "")
assert(_dash_undrawn_plottype("rpspike") == "")
// WP-31 B2: sunflower, its full name only.
assert(_dash_undrawn_plottype("Sunflower") == "sunflower")
assert(_dash_undrawn_plottype("sunflow") == "")
assert(_dash_undrawn_plottype("contourl") == "")
assert(_dash_undrawn_plottype("rpca") == "")
assert(_dash_undrawn_plottype("scatter") == "")
assert(_dash_undrawn_plottype("") == "")
// _dash_json_escape: the backslash first, the quote, the five short forms,
// the rest of C0 as u00XX, and the three a macro could misread.
assert(_dash_json_escape("a" + bs + "b") == "a" + bs + bs + "b")
assert(_dash_json_escape(q) == bs + q)
assert(_dash_json_escape(char(8) + char(9) + char(10) + char(12) + char(13)) == bs + "b" + bs + "t" + bs + "n" + bs + "f" + bs + "r")
assert(_dash_json_escape(char(1) + char(27) + char(31)) == bs + "u0001" + bs + "u001b" + bs + "u001f")
assert(_dash_json_escape(char(96) + char(36) + char(39)) == bs + "u0060" + bs + "u0024" + bs + "u0027")
assert(_dash_json_escape("plain text 123") == "plain text 123")
// _dash_json_number: full precision, and a leading zero JSON requires.
assert(_dash_json_number(.5) == "0.5")
assert(_dash_json_number(-.25) == "-0.25")
assert(_dash_json_number(3000) == "3000")
assert(_dash_json_number(0) == "0")
assert(strtoreal(_dash_json_number(1/3)) == 1/3)
// _dash_imm_number: numbers, the missing literals, and nothing else.  It
// takes the token as twoway's gettoken hands it over, quotes stripped;
// which tokens are coordinates is the reader's business (P1A-67).
assert(_dash_imm_number("1e3") == "1000")
assert(_dash_imm_number(".") == "null")
assert(_dash_imm_number(".z") == "null")
assert(_dash_imm_number(".A") == "")
assert(_dash_imm_number("1+1") == "")
assert(_dash_imm_number("0x10") == "")
// _dash_imm_clock: a number from 0 to 12.
assert(_dash_imm_clock("0") == "0")
assert(_dash_imm_clock("012") == "12")
assert(_dash_imm_clock("3.5") == "3.5")
assert(_dash_imm_clock("12.000001") == "")
assert(_dash_imm_clock("-1") == "")
assert(_dash_imm_clock("") == "")
// The tokenizer, _dash_imm_next, reads one token at a time as twoway's
// gettoken does -- a (group) only where a clock position may stand -- and
// is tested in P1A-67: _dash_imm_tokens, which split the whole list at
// once and read every ( as a group, is gone.
end
display "P1A-58 PASS: the Mata helpers read, escape and number immediate values as twoway does"

// ================================================================
// P1A-59 -- rpcap and rpspike: twoway plot types in StataNow 19.5,
// drawn since WP-31 B1
// ================================================================
// Measured 23sep2026: twoway rpcap / rpspike y ylow yhigh x run (rc 0)
// and take no abbreviation -- rpc .. rpca and rpsp .. rpspik are not
// twoway plot types.  Flipped (WP-31 B1): dash refused both by name,
// r(198) "a twoway plot type dash does not draw"; the refusal was dash's
// gap, twoway draws them, and so does dash now.
sysuse auto, clear
dash clear
foreach p159 in rpcap rpspike {
    _p1a_logrun "dash `p159' mpg turn length weight, name(p1a59b)"
    assert r(rc) == 0
    _dash_process_segment "`p159' mpg turn length weight" _pt59 _js59
    assert "`_pt59'" == "`p159'"
    assert strpos(`"`_js59'"', `""type":"`p159'","yvar1":"mpg","yvar2":"turn","yvar":"length","xvar":"weight""') > 0
    dash clear
}
foreach p159 in rpca rpspik {
    _p1a_logrun "dash `p159' mpg turn length weight, name(p1a59c)"
    assert r(rc) == 198
    local lg59c "`r(log)'"
    // Flipped (WP-31 A2): twoway's sentence.
    cert_file_has "`lg59c'", needle("`p159' is not a twoway plot type")
    assert r(found) == 1
}
assert "${dash_graph_registry}" == ""
display "P1A-59 PASS: rpcap and rpspike register their four variables, as twoway reads them; their prefixes stay unrecognised"

// ================================================================
// U21-8 -- WP-31 B1: rpcap and rpspike take four variables, and any
// other count is refused in twoway's words and code, measured here
// beside dash's (twoway_y3xview_parse): one "too few variables
// specified", two, three or five "you must specify four variables with
// twoway rpcap", r(102) below four and r(103) above.  recast() on them
// finds rpcap or rpspike, else draws rpspike, as twoway does
// (test/fixtures/rangept_truth.json recast.*).
// ================================================================
sysuse auto, clear
quietly generate double lo = turn - 5
quietly generate double hi = turn + 5
foreach t in rpcap rpspike {
    foreach v in "turn" "turn weight" "lo hi weight" "lo hi turn weight price" {
        quietly log using "`c(tmpdir)'u218t.log", text replace name(u218t)
        capture noisily twoway `t' `v', nodraw
        local trc = _rc
        quietly log close u218t
        dash clear
        _p1a_logrun "dash `t' `v', name(u218)"
        local drc = r(rc)
        local lg218 "`r(log)'"
        assert `drc' == `trc' & inlist(`trc', 102, 103)
        local w218 = cond(`: word count `v'' == 1, "too few variables specified", "you must specify four variables with twoway `t'")
        cert_file_has "`c(tmpdir)'u218t.log", needle("`w218'")
        assert r(found) == 1
        cert_file_has "`lg218'", needle("`w218'")
        assert r(found) == 1
    }
    dash clear
    _dash_process_segment "`t' lo hi turn weight, recast(rspike)" _pt218 _js218
    // rpcap is drawn as rpspike; rpspike stays itself.
    local rf218 = cond("`t'" == "rpcap", `","recast_from":"rpcap""', "")
    assert strpos(`"`_js218'"', `""type":"rpspike"`rf218',"yvar1":"lo""') > 0
    _dash_process_segment "`t' lo hi turn weight, recast(rpcap)" _pt218 _js218
    assert strpos(`"`_js218'"', `""type":"rpcap""') > 0
}
capture erase "`c(tmpdir)'u218t.log"
drop lo hi
assert "${dash_graph_registry}" == ""
display "U21-8 PASS: rpcap and rpspike refuse 1, 2, 3 and 5 variables in twoway's words and codes; recast() finds rpcap and rpspike, else rpspike"

capture mata: mata drop _u269_first()
mata:
// The first line twoway printed that is no command echo and no note.
string scalar _u269_first(string scalar path)
{
    real scalar fh
    string matrix line
    fh = fopen(path, "r")
    while ((line = fget(fh)) != J(0, 0, "")) {
        line = strtrim(line)
        if (line == "" | substr(line, 1, 1) == "." | substr(line, 1, 1) == ">") continue
        if (strpos(line, "log:") | strpos(line, "log type:") | strpos(line, "opened on:") | strpos(line, "closed on:") | strpos(line, "name:")) continue
        if (substr(line, 1, 5) == "(note") continue
        fclose(fh)
        return(line)
    }
    fclose(fh)
    return("")
}
end
// ================================================================
// U26-9 -- WP-31 B4b: contour's refusals, asked of twoway here beside
// dash: ccuts() with levels(); a second contour, a second contourline
// (a contour and a contourline together draw); a string z; the variable
// counts; a weight; contour's options on another type; levels() and
// ccuts() that are no integer or numlist; crule() twoway has no style
// for.  Each rc equal to twoway's and twoway's first line in dash's log
// (twoway_zyx2view_parse.class, twowaygraph_g.class:349-394).
// ================================================================
sysuse auto, clear
local u269 `" "contour mpg weight length, ccuts(15 20) levels(5)" "(contour mpg weight length) (contour price weight length)" "(contourline mpg weight length) (contourline price weight length)" "(contour mpg weight length) (contourline price weight length)" "contour make weight length" "contour mpg" "contour mpg weight" "contour mpg weight length turn" "contour mpg weight length [aw=price]" "scatter mpg weight, ccuts(1 2)" "scatter mpg weight, levels(5)" "scatter mpg weight, crule(hue)" "scatter mpg weight, interp(none)" "scatter mpg weight, minmax" "contour mpg weight length, levels(a)" "contour mpg weight length, levels(-1)" "contour mpg weight length, ccuts(a b)" "contour mpg weight length, crule(bogus)" "(contour mpg weight length) (scatter mpg weight, colorvar(price))" "contour mpg weight length, le(5)" "contourline mpg weight length, le(5)" "contour mpg weight length, lev(5)" "contour mpg weight length, level(5)" "'
local n269 0
foreach c of local u269 {
    local ++n269
    // Drawn, as a named graph: twoway judges crule() when it draws
    // (with nodraw crule(bogus) is rc 0).
    local tc = cond(strpos(`"`c'"', ",") & substr(`"`c'"', 1, 1) != "(", `"`c' name(u269g, replace)"', `"`c', name(u269g, replace)"')
    quietly log using "`c(tmpdir)'u269t.log", text replace name(u269t)
    capture noisily twoway `tc'
    local trc = _rc
    quietly log close u269t
    dash clear
    _p1a_logrun "dash `c'"
    local drc = r(rc)
    local lg269 "`r(log)'"
    assert `drc' == `trc'
    local w269 ""
    if `trc' mata: st_local("w269", _u269_first("`c(tmpdir)'u269t.log"))
    if `: length local w269' {
        cert_file_has "`lg269'", needle(`"`w269'"')
        if !r(found) display as error `"U26-9 FAIL: `c' -- dash lacks twoway's "`w269'""'
        assert r(found) == 1
    }
}
assert `n269' == 23
capture erase "`c(tmpdir)'u269t.log"
capture graph drop u269g
dash clear
display "U26-9 PASS: contour's 23 refusals and acceptances match twoway's rc and first line"

// ================================================================
// U26-12 -- WP-31 B4b: a bare "string" beside a contour option is refused
// as twoway refuses it ("quotes unbalanced", r(198), measured 15oct2026 on
// contour, contourline and scatter alike), and nothing is registered.
// Flipped (WP-31 D16b): dash's catch-all named it in its note and read the
// options after it; the contour options' own -syntax- took the quotes off
// it, so `"abc" name()' was named whole and name() dropped (b1810e4 ..
// 9786da4).
// ================================================================
sysuse auto, clear
local bad12 ""
foreach c in `"contour mpg weight length, levels(5) "abc" name(u2612a)"' `"contourline mpg weight length, "x y" levels(3) name(u2612b)"' {
    dash clear
    capture twoway `c'
    local trc12 = _rc
    _p1a_logrun `"dash `c'"'
    local rc12 = r(rc)
    local lg12 "`r(log)'"
    local g12 = cond(strpos(`"`c'"', "u2612a"), "u2612a", "u2612b")
    cert_file_has "`lg12'", needle("quotes unbalanced")
    local f12 = r(found)
    if `rc12' != 198 | `trc12' != 198 | !`f12' | strpos(" ${dash_graph_registry} ", " `g12' ") {
        local bad12 `"`bad12' [`g12': rc `rc12', twoway `trc12', named `f12', registry ${dash_graph_registry}]"'
    }
}
capture graph drop _all
dash clear
if `"`bad12'"' != "" {
    display as error `"U26-12 FAIL:`bad12'"'
    exit 9
}
display "U26-12 PASS: a bare string beside a contour option is refused as twoway refuses it"

// ================================================================
// P1A-60..67 -- scatteri and pci read their immediate values as twoway
// reads them, through the reader pcarrowi uses (dash_parse.mata, 2c)
//
// Measured 23sep2026 with the console binary, at ad13a0f: dash wrote the
// tokens of scatteri's and pci's values into the spec as they were typed,
// checking only that there was an even number of them.  `dash pci 0 0 0
// abc', `dash pci 0 0 0 1 (3) "A" 0 0 1 0' and `dash scatteri .5 3000'
// registered with rc 0 -- "values":[[0,0],[0,abc]],
// [[0,0],[0,1],[(3),"A"],[0,0],[1,0]] and [[.5,3000]] -- and the render
// stopped on a Python JSONDecodeError, r(7102); so did `scatteri . 3000',
// `scatteri .a 1', `scatteri 1d3 2' and `scatteri 0x10 1'.  A label was
// cut at its first blank -- `scatteri 41 2040 "VW Diesel"', the example
// in twoway_scatteri.sthlp, was labelled "VW" -- `scatteri 1 2 (13)' drew
// the text "(13)" where twoway refuses the position, and `scatteri 1 2 (9)
// "A" 3 4', `scatteri 1 2 3', `pci 0 0 0 1 0 0 1' and `pci 0 0 0 1 "A"'
// were refused where twoway draws them.
//
// twoway's parsers (twoway_scatteri_parse.class, and twoway_pci_parse.class,
// which pcarrowi inherits) read #y #x -- #y1 #x1 #y2 #x2 for pci -- then an
// optional (#clockpos) and an optional "label", in a loop that ends when a
// record's last coordinate is empty.  What they take, refuse and draw was
// measured record by record, by loading the serset each command draws and
// reading each graph's SVG export.  Every expected backslash is char(92).
// ================================================================
local bs = char(92)
local tb = char(9)

// ================================================================
// P1A-60 -- scatteri: one record per point, [y,x] or [y,x,"label",clock]
// ================================================================
_dash_process_segment "scatteri .5 3000" _pt60 _js60
assert "`_pt60'" == "scatteri"
assert strpos(`"`_js60'"', `""type":"scatteri","values":[[0.5,3000]]"') > 0
// A missing value draws nothing: . and .a to .z; so does a number past a
// double's range (1e400, -1e400, 1e308) and one past a float's (1e39):
// twoway stores its immediate values as float.  1.7014117e38 is a float.
_dash_process_segment "scatteri . 3000 .a 1 .z 2 5 6" _pt60 _js60
assert strpos(`"`_js60'"', `""values":[[null,3000],[null,1],[null,2],[5,6]]"') > 0
_dash_process_segment "scatteri 1e400 2 -1e400 3 1e308 4 1e39 5 1.7014117e38 6" _pt60 _js60
assert strpos(`"`_js60'"', `""values":[[null,2],[null,3],[null,4],[null,5],[1.70141170000000e+38,6]]"') > 0
// Each spelling of a number twoway takes, written as a JSON number.
_dash_process_segment "scatteri -.5 +.25 1e3 1d3 1.8X+1 -0 00012 1." _pt60 _js60
assert strpos(`"`_js60'"', `""values":[[-0.5,0.25],[1000,1000],[3,0],[12,1]]"') > 0
// A coordinate in quotes is a number where twoway strips the quotes: the
// first of the list, any but the first of a record, and the first after a
// label.  Straight after a point, a quoted token is that point's label.
_dash_process_segment `"scatteri "1" 2 3 "4" "A" " 5 " 6"' _pt60 _js60
assert strpos(`"`_js60'"', `""values":[[1,2],[3,4,"A",null],[5,6]]"') > 0
// A clock position and a label, each optional, in that order.
_dash_process_segment `"scatteri 1 2 (9) "A" 3 4 (3) 5 6 "B" 7 8"' _pt60 _js60
assert strpos(`"`_js60'"', `""values":[[1,2,"A",9],[3,4,"",3],[5,6,"B",null],[7,8]]"') > 0
// A clock position is a number from 0 to 12, blanks around it allowed,
// read as twoway reads it -- 012 is 12, 1e1 is 10 -- and 3.5 is carried as
// written: the renderer draws it where twoway does, at 12 o'clock.
_dash_process_segment `"scatteri 1 2 ( 3 ) "A" 3 4 (012) 5 6 (1e1) 7 8 (3.5) 9 9 (0)"' _pt60 _js60
assert strpos(`"`_js60'"', `""values":[[1,2,"A",3],[3,4,"",12],[5,6,"",10],[7,8,"",3.5],[9,9,"",0]]"') > 0
// A label in compound quotes may hold double quotes and an apostrophe; an
// empty label is no label; a label may follow its clock position with no
// blank between them.
_dash_process_segment `"scatteri 1 2 `"say "hi" o'k"' 3 4 "" 5 6 (3)"C" 7 8"' _pt60 _js60
assert strpos(`"`_js60'"', `""values":[[1,2,"say `bs'"hi`bs'" o`bs'u0027k",null],[3,4],[5,6,"C",3],[7,8]]"') > 0
// A label is whole, blanks, a comma and || included -- it was cut at its
// first blank -- in the paren syntax too.
dash clear
_p1a_logrun `"dash scatteri 41 2040 "VW Diesel" 28 3260 (3) "Plymouth Arrow", name(p1a60)"'
assert r(rc) == 0
assert strpos(`"${dash_json_p1a60}"', `""values":[[41,2040,"VW Diesel",null],[28,3260,"Plymouth Arrow",3]]"') > 0
_p1a_logrun `"dash (scatteri 1 2 (3) "a, b || c") (scatter mpg weight), name(p1a60b)"'
assert r(rc) == 0
assert strpos(`"${dash_json_p1a60b}"', `""type":"scatteri","values":[[1,2,"a, b || c",3]]"') > 0
assert strpos(`"${dash_json_p1a60b}"', `""type":"scatter","yvar":"mpg","xvar":"weight""') > 0
dash clear
display "P1A-60 PASS: scatteri's values are written one record per point, numbers as JSON numbers, missing values as null, with labels and clock positions"

// ================================================================
// P1A-61 -- scatteri refuses what twoway refuses, r(198)
//
// twoway: "invalid point," where a coordinate belongs and is not a number
// (a label or clock position before the first point or inside one, a
// second label, a clock position after a label with a point after it);
// "invalid position, 13" for a clock position that is not a number from 0
// to 12; "'0' invalid observation number" for a list with no whole point.
// ================================================================
_p1a_logrun "dash scatteri 1 abc, name(p1a61)"
assert r(rc) == 198
cert_file_has "`r(log)'", needle("dash: scatteri takes two numbers for each point, #y #x; 'abc' is not a number.")
assert r(found) == 1
_p1a_logrun "dash scatteri (3) 1 2, name(p1a61)"
assert r(rc) == 198
cert_file_has "`r(log)'", needle("dash: scatteri takes two numbers for each point, #y #x; '(3)' is not a number.")
assert r(found) == 1
_p1a_logrun "dash scatteri 1 2 (13), name(p1a61)"
assert r(rc) == 198
cert_file_has "`r(log)'", needle("dash: scatteri: invalid position, 13; a clock position is a number from 0 to 12.")
assert r(found) == 1
_p1a_logrun "dash scatteri abc, name(p1a61)"
assert r(rc) == 198
local lg61 "`r(log)'"
cert_file_has "`lg61'", needle("dash: scatteri needs at least one point, two numbers #y #x.")
assert r(found) == 1
cert_file_has "`lg61'", needle("'abc' is too little for one.")
assert r(found) == 1
// 2/2 is read as twoway reads it, a division drawing 1 (WP-31 C18,
// U06-05); 1/2, a range of two values, is refused by twoway too.
// 1(1)1 is refused by twoway too, r(133).
foreach seg in "scatteri 1 2 (-1)" "scatteri 1 2 (.)" "scatteri 1 2 ()" ///
    `"scatteri 1 2 ("3")"' "scatteri 1 2 (12.000001)" "scatteri 1 2 ((3))" ///
    `"scatteri 1 2 "A" "B" 3 4"' `"scatteri 1 2 "A" (9) 4"' ///
    "scatteri 1 2 (3) (4) 5 6" `"scatteri 1 2 "A"(3) 4 5"' ///
    `"scatteri 1 2 "A" ( 3 )"' "scatteri 1 2 x(3 4) 5" ///
    "scatteri 0x10 1" "scatteri 1x3 1" "scatteri 1/2 1" ///
    "scatteri 1(1)1 2" "scatteri 1+1 2" `"scatteri 2"A" 1"' ///
    `"scatteri "" 2"' `"scatteri 1 """' "scatteri 1`tb'2" ///
    "scatteri .A 1" "scatteri -. 1" "scatteri .. 1" "scatteri 1.0X+400 1" ///
    `"scatteri "1 2" 3"' "scatteri 1 2 3 1e3.5" {
    capture _dash_process_segment `"`seg'"' _ptx _jx
    if _rc != 198 {
        display as error `"P1A-61: `seg' gave rc "' _rc
        exit 9
    }
}
assert "${dash_graph_registry}" == ""
display "P1A-61 PASS: scatteri refuses a non-number where a coordinate belongs, a clock position outside 0..12, and a list with no whole point"

// ================================================================
// U06-05 (WP-31 C18) -- a coordinate p/q is twoway's division: p == q
// draws 1 (0/0 missing), p != q is "invalid point"; each rc twoway's in
// the same run (test/fixtures/parsed_values_truth.json scatteri.*, pci.*)
// ================================================================
local u65bad ""
foreach c in "scatteri 2/2 1|[[1,1]]" "scatteri -1/-1 1|[[1,1]]" ///
    "scatteri 0/0 1|[[null,1]]" "scatteri 2/2 1/1|[[1,1]]" ///
    "scatteri 1 2 (1/1)|[[1,2," ///
    "pci 2/2 0 0 1|[[1,0,0,1]]" "scatteri 1/2 1|" "pci 1/2 0 0 1|" {
    local at = strpos(`"`c'"', "|")
    local cmd = substr(`"`c'"', 1, `at' - 1)
    local want = substr(`"`c'"', `at' + 1, .)
    quietly sysuse auto, clear
    capture twoway `cmd', nodraw
    local trc = _rc
    dash clear
    _p1a_logrun `"dash `cmd', name(u65)"'
    local drc = r(rc)
    if `trc' != `drc' local u65bad `"`u65bad' [`cmd': twoway `trc', dash `drc']"'
    if `"`want'"' != "" & !strpos(`"${dash_json_u65}"', `""values":`want'"') {
        local u65bad `"`u65bad' [`cmd': values not `want']"'
    }
}
// (1/1) is the clock position 1: no label, clock 1.
dash clear
_p1a_logrun `"dash scatteri 1 2 (1/1), name(u65)"'
if !strpos(`"${dash_json_u65}"', `""values":[[1,2,"",1]]"') {
    local u65bad `"`u65bad' [(1/1): not clock 1]"'
}
dash clear
if `"`u65bad'"' != "" {
    display as error `"U06-05 FAIL:`u65bad'"'
    exit 9
}
display "U06-05 PASS: scatteri and pci read p/p as twoway's division and refuse p/q, each rc twoway's"

// ================================================================
// U47-8 (WP-31 C18b) -- a hexadecimal literal coordinate: dash takes
// what twoway takes, as the value twoway holds (1.0X+3ff is missing, so
// the point draws nothing), and refuses what twoway refuses, with its rc,
// in the same run.
// ================================================================
local u478bad ""
foreach c in "scatteri 1.0X+3ff 1|[[null,1]]" "scatteri -1.0X+0 1|[[-1,1]]" ///
    "scatteri 1.8X+01 1|[[3,1]]" "scatteri 1 1.fX+3ff|[[1,null]]" ///
    "pci 1.0X+3ff 0 0 1|[[null,0,0,1]]" "scatteri 1.0X+400 1|" ///
    "scatteri 1.X+1 1|" "scatteri 2.0X+1 1|" {
    local at = strpos(`"`c'"', "|")
    local cmd = substr(`"`c'"', 1, `at' - 1)
    local want = substr(`"`c'"', `at' + 1, .)
    quietly sysuse auto, clear
    capture twoway `cmd', nodraw
    local trc = _rc
    dash clear
    _p1a_logrun `"dash `cmd', name(u478)"'
    local drc = r(rc)
    if `trc' != `drc' local u478bad `"`u478bad' [`cmd': twoway `trc', dash `drc']"'
    if `"`want'"' != "" & !strpos(`"${dash_json_u478}"', `""values":`want'"') {
        local u478bad `"`u478bad' [`cmd': values not `want']"'
    }
}
dash clear
if `"`u478bad'"' != "" {
    display as error `"U47-8 FAIL:`u478bad'"'
    exit 9
}
display "U47-8 PASS: scatteri and pci take the hexadecimal literals twoway takes and refuse the rest, each rc twoway's"

// ================================================================
// P1A-62 -- what twoway drops at the end of scatteri's list is dropped,
// and named
//
// twoway's loop ends when a point's last coordinate is empty: at the end
// of the list (`scatteri 1 2 3' draws one point, rc 0), or at a quoted ""
// (`scatteri 1 2 3 "" 5 6' draws one point, rc 0).  It says nothing; dash
// names what it dropped.
// ================================================================
dash clear
_p1a_logrun "dash scatteri 1 2 3, name(p1a62)"
assert r(rc) == 0
cert_file_has "`r(log)'", needle("dash: scatteri ignored '3' at the end, too little for another point (#y #x), as twoway does.")
assert r(found) == 1
assert strpos(`"${dash_json_p1a62}"', `""values":[[1,2]]"') > 0
_p1a_logrun `"dash scatteri 1 2 3 "" 5 6, name(p1a62b)"'
assert r(rc) == 0
cert_file_has "`r(log)'", needle(`"dash: scatteri ignored '3 "" 5 6' at the end: "" where a point's last number belongs ends the list, as in twoway scatteri."')
assert r(found) == 1
assert strpos(`"${dash_json_p1a62b}"', `""values":[[1,2]]"') > 0
// A needle holding "' -- the characters that close a compound quote --
// cannot pass through cert_file_has's -syntax-; it is built from char()
// and searched for from Mata, where it is a value.
_p1a_logrun `"dash scatteri 1 2 (3) "A" "B", name(p1a62c)"'
assert r(rc) == 0
local lg62 "`r(log)'"
mata: st_local("f62", strofreal(_cert_file_has(st_local("lg62"), "dash: scatteri ignored " + char(39) + char(34) + "B" + char(34) + char(39) + " at the end, too little for another point (#y #x), as twoway does.", 0)))
assert `f62' == 1
assert strpos(`"${dash_json_p1a62c}"', `""values":[[1,2,"A",3]]"') > 0
// A clock position after a label is not read: it is the next point's y.
_p1a_logrun `"dash scatteri 1 2 "A" (9), name(p1a62d)"'
assert r(rc) == 0
cert_file_has "`r(log)'", needle("dash: scatteri ignored '(9)' at the end")
assert r(found) == 1
assert strpos(`"${dash_json_p1a62d}"', `""values":[[1,2,"A",null]]"') > 0
// Quotes inside a word bind its blanks, as gettoken reads them.
_p1a_logrun `"dash scatteri 1 2 2"A B", name(p1a62e)"'
assert r(rc) == 0
local lg62 "`r(log)'"
mata: st_local("f62", strofreal(_cert_file_has(st_local("lg62"), "dash: scatteri ignored " + char(39) + "2" + char(34) + "A B" + char(34) + char(39) + " at the end", 0)))
assert `f62' == 1
assert strpos(`"${dash_json_p1a62e}"', `""values":[[1,2]]"') > 0
_p1a_logrun "dash scatteri 1 2 3 4 5, name(p1a62f)"
assert r(rc) == 0
assert strpos(`"${dash_json_p1a62f}"', `""values":[[1,2],[3,4]]"') > 0
// Nothing left, nothing said.
_p1a_logrun "dash scatteri 1 2 3 4, name(p1a62g)"
assert r(rc) == 0
cert_file_has "`r(log)'", needle("ignored")
assert r(found) == 0
dash clear
display "P1A-62 PASS: what twoway drops at the end of scatteri's list is dropped too, with a note naming it"

// ================================================================
// P1A-63 -- pci: one record per segment, [y1,x1,y2,x2] or
// [y1,x1,y2,x2,"label",clock], as pcarrowi's
// ================================================================
_dash_process_segment "pci 0 0 0 1" _pt63 _js63
assert "`_pt63'" == "pci"
assert strpos(`"`_js63'"', `""type":"pci","values":[[0,0,0,1]]"') > 0
_dash_process_segment `"pci 0 0 0 1 (3) "A" 0 0 1 0"' _pt63 _js63
assert strpos(`"`_js63'"', `""values":[[0,0,0,1,"A",3],[0,0,1,0]]"') > 0
_dash_process_segment "pci . 0 0 1 1 1 2 2 .a .b .c 1 .5 -.5 1e3 1d3" _pt63 _js63
assert strpos(`"`_js63'"', `""values":[[null,0,0,1],[1,1,2,2],[null,null,null,1],[0.5,-0.5,1000,1000]]"') > 0
_dash_process_segment `"pci "0" 0 0 1 2 "2" "3" "3" "A" "4" "4" "5" "5""' _pt63 _js63
assert strpos(`"`_js63'"', `""values":[[0,0,0,1],[2,2,3,3,"A",null],[4,4,5,5]]"') > 0
_dash_process_segment `"pci 0 0 0 1 (3.5) "A" 1 1 2 2 (7.25) "B" 2 2 3 3 "" 3 3 4 4 (9)"' _pt63 _js63
assert strpos(`"`_js63'"', `""values":[[0,0,0,1,"A",3.5],[1,1,2,2,"B",7.25],[2,2,3,3],[3,3,4,4,"",9]]"') > 0
display "P1A-63 PASS: pci's values are written one record per segment, with labels and clock positions, as pcarrowi's"

// ================================================================
// P1A-64 -- pci refuses what twoway refuses, r(198)
// ================================================================
_p1a_logrun "dash pci 0 0 0 abc, name(p1a64)"
assert r(rc) == 198
cert_file_has "`r(log)'", needle("dash: pci takes four numbers for each segment, #y1 #x1 #y2 #x2; 'abc' is not a number.")
assert r(found) == 1
_p1a_logrun "dash pci 0 0 0 1 (13), name(p1a64)"
assert r(rc) == 198
cert_file_has "`r(log)'", needle("dash: pci: invalid position, 13; a clock position is a number from 0 to 12.")
assert r(found) == 1
_p1a_logrun "dash pci 0 0 0, name(p1a64)"
assert r(rc) == 198
local lg64 "`r(log)'"
cert_file_has "`lg64'", needle("dash: pci needs at least one segment, four numbers #y1 #x1 #y2 #x2.")
assert r(found) == 1
cert_file_has "`lg64'", needle("'0 0 0' is too little for one.")
assert r(found) == 1
foreach seg in `"pci "A" 0 0 1"' `"pci 0 0 "A" 0 1"' ///
    `"pci 0 0 0 1 "A" "B" 1 1 2 2"' `"pci 0 0 0 1 "A" (3) 1 1 2 2"' ///
    "pci (3) 0 0 0 1" "pci 0 0 0 1 (-1)" "pci 0 0 0 1 (.)" ///
    "pci 0 0 0 1 1 1 2 2x" "pci 1+1 0 0 1" "pci 1/2 0 0 1" ///
    `"pci 0 0 0 """' `"pci 0 "" 0 1"' "pci 0 0 0 1`tb'1 1 2 2" {
    capture _dash_process_segment `"`seg'"' _ptx _jx
    if _rc != 198 {
        display as error `"P1A-64: `seg' gave rc "' _rc
        exit 9
    }
}
assert "${dash_graph_registry}" == ""
display "P1A-64 PASS: pci refuses a non-number where a coordinate belongs, a clock position outside 0..12, and a list with no whole segment"

// ================================================================
// P1A-65 -- pci: what twoway drops at the end is dropped and named, and
// a label, which twoway pci never draws, is named as not drawn
//
// twoway pci is an immediate pcspike: its serset carries the labels
// (measured), and no label reaches its SVG export, with mlabcolor() or
// mlabposition() or without.
// ================================================================
dash clear
_p1a_logrun "dash pci 0 0 0 1 0 0 1, name(p1a65)"
assert r(rc) == 0
cert_file_has "`r(log)'", needle("dash: pci ignored '0 0 1' at the end, too little for another segment (#y1 #x1 #y2 #x2), as twoway does.")
assert r(found) == 1
assert strpos(`"${dash_json_p1a65}"', `""values":[[0,0,0,1]]"') > 0
_p1a_logrun `"dash pci 0 0 0 1 1 1 2 "" 3 3 4 4, name(p1a65b)"'
assert r(rc) == 0
cert_file_has "`r(log)'", needle(`"dash: pci ignored '1 1 2 "" 3 3 4 4' at the end: "" where a segment's last number belongs ends the list, as in twoway pci."')
assert r(found) == 1
assert strpos(`"${dash_json_p1a65b}"', `""values":[[0,0,0,1]]"') > 0
_p1a_logrun `"dash pci 0 0 0 1 (3) "A" 0 0 1 0, name(p1a65c)"'
assert r(rc) == 0
local lg65 "`r(log)'"
cert_file_has "`lg65'", needle("dash: pci draws no labels, as twoway pci draws none; a scatteri layer can label a point.")
assert r(found) == 1
assert strpos(`"${dash_json_p1a65c}"', `""values":[[0,0,0,1,"A",3],[0,0,1,0]]"') > 0
// A clock position alone, or an empty label, is no label to name.
_p1a_logrun `"dash pci 0 0 0 1 (9) 1 1 2 2 "", name(p1a65d)"'
assert r(rc) == 0
cert_file_has "`r(log)'", needle("draws no labels")
assert r(found) == 0
_p1a_logrun `"dash pci 0 0 0 1 "A" (3), name(p1a65e)"'
assert r(rc) == 0
cert_file_has "`r(log)'", needle("dash: pci ignored '(3)' at the end")
assert r(found) == 1
assert strpos(`"${dash_json_p1a65e}"', `""values":[[0,0,0,1,"A",null]]"') > 0
dash clear
display "P1A-65 PASS: pci drops what twoway drops at the end, with a note, and names the labels it does not draw"

// ================================================================
// P1A-66 -- pcarrowi reads numbers as scatteri and pci now do
//
// Measured at ad13a0f: `dash pcarrowi -1e400 0 0 1' registered with rc 0
// as "values":[[-,0,0,1]] -- strtoreal() reads -1e400 as minus infinity,
// which is not missing, and strofreal() writes it as "-" -- and the
// render stopped on a JSONDecodeError, r(7102).  `dash pcarrowi 1e400 0
// 0 1' was refused, and 1e39 drawn, where twoway takes all three as
// missing (float storage).  A quoted coordinate is taken where twoway
// strips the quotes, and a tab separates nothing.
// ================================================================
_dash_process_segment "pcarrowi -1e400 0 0 1 1e400 0 0 1 1e39 0 0 1 1 1 2 2" _pt66 _js66
assert strpos(`"`_js66'"', `""values":[[null,0,0,1],[null,0,0,1],[null,0,0,1],[1,1,2,2]]"') > 0
_dash_process_segment `"pcarrowi "0" 0 "0" 1 "A" "1" 1 2 2"' _pt66 _js66
assert strpos(`"`_js66'"', `""values":[[0,0,0,1,"A",null],[1,1,2,2]]"') > 0
capture _dash_process_segment "pcarrowi 0 0 0 1`tb'1 1 2 2" _ptx _jx
assert _rc == 198
display "P1A-66 PASS: pcarrowi reads -1e400, 1e400 and 1e39 as missing, as twoway does, and quoted coordinates where twoway strips the quotes"

// ================================================================
// P1A-67 -- the Mata helpers behind P1A-60..66, one by one
// ================================================================
mata:
q  = char(34)
lq = char(96)
rq = char(39)
txt = ""
raw = ""
// _dash_imm_next: gettoken as twoway's parsers call it -- plain (0) and
// quotes (1) read "(" as any other character, match (2) reads a (group)
// -- and only a blank separates two tokens.  It takes the list's bytes,
// b = ascii(s), read once by its caller.  These cases called it through
// _dash_imm_gettoken, a wrapper that read the bytes at each call and that
// nothing shipped called; WP-26 deleted the wrapper (24sep2026).
s = "  12 " + q + "a b" + q + "c (3)x ( 4 ) " + lq + q + "x " + lq + q + "y" + q + rq + q + rq + " 2" + q + "A B" + q + " z"
b = ascii(s)
i = 1
assert(_dash_imm_next(s, b, i, 0, txt, raw) == 1)
assert(txt == "12" & raw == "12")
assert(_dash_imm_next(s, b, i, 0, txt, raw) == 2)
assert(txt == "a b" & raw == q + "a b" + q)
assert(_dash_imm_next(s, b, i, 0, txt, raw) == 1)
assert(txt == "c")
j = i
assert(_dash_imm_next(s, b, j, 0, txt, raw) == 1)
assert(txt == "(3)x")
assert(_dash_imm_next(s, b, i, 2, txt, raw) == 3)
assert(txt == "3" & raw == "(3)")
assert(_dash_imm_next(s, b, i, 2, txt, raw) == 1)
assert(txt == "x")
j = i
assert(_dash_imm_next(s, b, j, 1, txt, raw) == 1)
assert(txt == "(")
assert(_dash_imm_next(s, b, i, 2, txt, raw) == 3)
assert(txt == " 4 " & raw == "( 4 )")
assert(_dash_imm_next(s, b, i, 1, txt, raw) == 2)
assert(txt == "x " + lq + q + "y" + q + rq)
assert(_dash_imm_next(s, b, i, 0, txt, raw) == 1)
assert(txt == "2" + q + "A B" + q)
assert(_dash_imm_next(s, b, i, 0, txt, raw) == 1)
assert(txt == "z")
assert(_dash_imm_next(s, b, i, 0, txt, raw) == 0)
assert(txt == "" & raw == "")
s = "1" + char(9) + "2 3"
b = ascii(s)
i = 1
assert(_dash_imm_next(s, b, i, 0, txt, raw) == 1)
assert(txt == "1" + char(9) + "2")
s = "((3)) ()"
b = ascii(s)
i = 1
assert(_dash_imm_next(s, b, i, 2, txt, raw) == 3)
assert(txt == "(3)")
assert(_dash_imm_next(s, b, i, 2, txt, raw) == 3)
assert(txt == "" & raw == "()")
// _dash_imm_number: one coordinate as a JSON number, null for a missing
// value, or "" when twoway would call it an invalid point.
assert(_dash_imm_number("1e3") == "1000")
assert(_dash_imm_number(".5") == "0.5")
assert(_dash_imm_number(" -.5 ") == "-0.5")
assert(_dash_imm_number("1d3") == "1000")
assert(_dash_imm_number("1.8X+1") == "3")
assert(_dash_imm_number("-0") == "0")
assert(_dash_imm_number(".") == "null")
assert(_dash_imm_number(".z") == "null")
assert(_dash_imm_number("1e400") == "null")
assert(_dash_imm_number("-1e400") == "null")
assert(_dash_imm_number("1e308") == "null")
assert(_dash_imm_number("1e39") == "null")
assert(_dash_imm_number("1.7014117839e38") == "null")
assert(_dash_imm_number("1.7014117837e38") == "1.70141178370000e+38")
// WP-31 C18b (U47-8): a hexadecimal literal twoway takes but holds as
// missing (an exponent of +3ff is past c(maxdouble), which strtoreal()
// reads as missing) is a missing point; a malformed one or an exponent
// past 3ff stays no number (measured: 1.0X+400, 1.0X-400, 1.X+1, 2.0X+1).
assert(_dash_imm_number("1.0X+3ff") == "null")
assert(_dash_imm_number("1.fX+3ff") == "null")
assert(_dash_imm_number("1.0x+3FF") == "null")
assert(_dash_imm_number("-1.0X+3ff") == "null")
assert(_dash_imm_number("1.fffffffffffffX+3ff") == "null")
assert(_dash_imm_number("-1.0X+0") == "-1")
assert(_dash_imm_number("1.0X-3ff") == "0")
assert(_dash_imm_number("1.0X+400") == "")
assert(_dash_imm_number("1.0X-400") == "")
assert(_dash_imm_number("1.X+1") == "")
assert(_dash_imm_number("2.0X+1") == "")
assert(_dash_imm_number("1.0X+3ff0") == "")
assert(_dash_imm_number("1.00000000000000000X+1") == "")
assert(_dash_imm_number(".A") == "")
assert(_dash_imm_number("-.") == "")
assert(_dash_imm_number("") == "")
assert(_dash_imm_number("1+1") == "")
assert(_dash_imm_number("0x10") == "")
// Flipped (WP-31 C18): twoway's division.
assert(_dash_imm_number("2/2") == "1")
assert(_dash_imm_number("-1/-1") == "1")
assert(_dash_imm_number("0/0") == "null")
assert(_dash_imm_number("1/2") == "")
assert(_dash_imm_number("2/2/2") == "")
assert(_dash_imm_number("/2") == "")
assert(_dash_imm_clock("1/1") == "1")
assert(_dash_imm_number("1.0X+400") == "")
assert(_dash_imm_number(char(9) + "1") == "")
assert(_dash_imm_number("1 2") == "")
assert(_dash_imm_number(uchar(65297)) == "")
// _dash_imm_decimal: a decimal number by its grammar, whatever its size.
assert(_dash_imm_decimal("1e400") == 1)
assert(_dash_imm_decimal("-1.5D+400") == 1)
assert(_dash_imm_decimal("1.") == 1)
assert(_dash_imm_decimal(".5") == 1)
assert(_dash_imm_decimal(".e3") == 0)
assert(_dash_imm_decimal("5e") == 0)
assert(_dash_imm_decimal("1e+") == 0)
assert(_dash_imm_decimal("1.0X+3") == 0)
assert(_dash_imm_decimal("") == 0)
assert(_dash_imm_decimal("+") == 0)
assert(_dash_imm_decimal(".") == 0)
assert(_dash_imm_decimal("1e3.5") == 0)
// _dash_imm_clock: a number from 0 to 12.
assert(_dash_imm_clock(" 3 ") == "3")
assert(_dash_imm_clock("-0") == "0")
assert(_dash_imm_clock("1e1") == "10")
assert(_dash_imm_clock(".") == "")
assert(_dash_imm_clock(q + "3" + q) == "")
assert(_dash_imm_clock("(3)") == "")
// _dash_imm_records: the loop, for a point (2) and a segment (4).
err = ""
bad = ""
left = ""
stop = ""
n = .
nl = .
assert(_dash_imm_records("1 2 (9) " + q + "A" + q + " 3 4 5", 2, err, bad, left, stop, n, nl) == "[[1,2," + q + "A" + q + ",9],[3,4]]")
assert(err == "" & left == "5" & stop == "short" & n == 2 & nl == 1)
assert(_dash_imm_records("1 2 3 " + q + q + " 5 6", 2, err, bad, left, stop, n, nl) == "[[1,2]]")
assert(left == "3 " + q + q + " 5 6" & stop == "empty" & n == 1 & nl == 0)
assert(_dash_imm_records("1 abc", 2, err, bad, left, stop, n, nl) == "")
assert(err == "point" & bad == "abc")
assert(_dash_imm_records("1 2 (13)", 2, err, bad, left, stop, n, nl) == "")
assert(err == "position" & bad == "13")
assert(_dash_imm_records("abc", 2, err, bad, left, stop, n, nl) == "")
assert(err == "none" & left == "abc" & stop == "short" & n == 0)
assert(_dash_imm_records("1 " + q + q, 2, err, bad, left, stop, n, nl) == "")
assert(err == "none" & stop == "empty")
assert(_dash_imm_records("", 2, err, bad, left, stop, n, nl) == "")
assert(err == "none" & left == "")
assert(_dash_imm_records("0 0 0 1 (3) " + q + "A" + q + " 0 0 1 0", 4, err, bad, left, stop, n, nl) == "[[0,0,0,1," + q + "A" + q + ",3],[0,0,1,0]]")
assert(err == "" & left == "" & n == 2 & nl == 1)
// _dash_imm_echo: an echo of the user's text, cut at 80 characters.
assert(_dash_imm_echo("abc") == "abc")
assert(_dash_imm_echo(80 * "a") == 80 * "a")
assert(_dash_imm_echo(81 * "a") == 80 * "a" + "...")
end
// _dash_immediate: dash.ado's entry, into the caller's locals, for two
// coordinates a record (scatteri) and for four (pci and pcarrowi).
mata: _dash_immediate("1 2 3", 2)
assert `"`_pci_json'"' == "[[1,2]]"
assert "`_pci_err'" == "" & "`_pci_left'" == "3" & `_pci_hasleft' == 1
assert "`_pci_stop'" == "short" & `_pci_n' == 1 & `_pci_nlab' == 0
mata: _dash_immediate("0 0 0 1 0", 4)
assert `"`_pci_json'"' == "[[0,0,0,1]]"
assert "`_pci_left'" == "0" & `_pci_n' == 1
mata: _dash_immediate("1 2 " + 100 * "7" + "x", 2)
assert "`_pci_left'" == 80 * "7" + "..."
display "P1A-67 PASS: the Mata helpers read immediate values token by token as twoway does"

// ================================================================
// P1A-68..75 -- a plot type glued to its comma, a plot given nothing to
// draw, and a dashboard of immediate graphs alone
//
// Measured 24sep2026 with the console binary at a17c552, sysuse auto.
//
// twoway reads a plot type up to a blank or a comma: `twoway scatteri 1
// 2,name(x)' draws, and `twoway scatteri, name(x)' is refused for what it
// lacks.  dash took the first blank-delimited word for the type, so `dash
// scatteri, name(x)', `dash (pci, name(x))', `dash scatter, name(x)' and
// every other type with its comma glued on said "unrecognised plot type
// 'scatteri,'", r(198).
//
// A plot given nothing to draw -- the comma glued, spaced or absent, in
// parentheses, after ||, or with only an if, an in or a weight -- twoway
// refuses: a type that takes variables with "varlist required", r(100);
// scatteri, pci and pcarrowi with "'0' invalid observation number",
// r(198); function with "expression required", r(100), and `function y ='
// with "nothing found where expression expected", r(111).  dash registered
// `dash scatter , name(x)', a graph with no variables, with rc 0 -- and
// line, connected, area, bar, spike, dropline, dot, the fits, the
// smoothers and tsline the same way; it refused the bare `dash scatter'
// with "no variables identified in plot specification", r(198), and
// scatteri, pci, pcarrowi and function with "something required", r(100).
//
// twoway draws scatteri, pci, pcarrowi and function alone, with data in
// memory or none.  After `dash scatteri 1 2, name(a1)', `dash build' said
// "dash build: no variables identified across registered graphs.",
// r(198), in both modes; with no data in memory the one-line `dash
// scatteri 1 2 3 4, saving(f)' said "no variables identified in plot
// specification", r(198).  An immediate plot whose every point is missing
// drew nothing, as twoway does, and said "graph '?' plot 1 (scatteri) drew
// nothing from 1 observations", where twoway is silent.
// ================================================================
global dash_nobrowser 1

// ================================================================
// P1A-68 -- a plot type ends at a comma, as twoway reads it
// ================================================================
sysuse auto, clear
dash clear
_dash_process_segment "scatteri 1 2,mcolor(red)" _pt68 _js68
assert "`_pt68'" == "scatteri"
assert strpos(`"`_js68'"', `""values":[[1,2]]"') > 0
_dash_process_segment "scatter mpg weight,mcolor(red)" _pt68 _js68
assert "`_pt68'" == "scatter"
assert strpos(`"`_js68'"', `""yvar":"mpg","xvar":"weight""') > 0
// Each type with its comma glued on is read as that type, and refused for
// what it lacks (P1A-69..71) -- not as a type dash does not know.
foreach seg in "scatteri,name(p1a68)" "scatteri, name(p1a68)" ///
    "pci, name(p1a68)" "pcarrowi,mcolor(red)" "function, range(0 1)" ///
    "scatter, name(p1a68)" "histogram,name(p1a68)" "rcap, name(p1a68)" ///
    "pcspike, name(p1a68)" "(scatteri, name(p1a68))" ///
    "scatteri 1 2 || pci, name(p1a68)" "SC, name(p1a68)" "fn, name(p1a68)" {
    _p1a_logrun `"dash `seg'"'
    local rc68 = r(rc)
    // Flipped (WP-31 A2): the generic refusal is twoway's sentence.
    cert_file_has "`r(log)'", needle("is not a twoway plot type")
    if r(found) | !inlist(`rc68', 100, 198) {
        display as error `"P1A-68: dash `seg' gave rc `rc68'"'
        exit 9
    }
}
assert "${dash_graph_registry}" == ""
// A comma glued to a list that has what it needs was read, and still is.
_p1a_logrun "dash scatteri 1 2,name(p1a68)"
assert r(rc) == 0
_p1a_logrun "dash scatter mpg weight,name(p1a68b)"
assert r(rc) == 0
_p1a_logrun "dash (pci 0 0 1 1,name(p1a68c))"
assert r(rc) == 0
assert "${dash_graph_registry}" == "p1a68 p1a68b p1a68c"
dash clear
display "P1A-68 PASS: a plot type ends at a comma, as twoway reads it: no type is unrecognised for the comma glued to it"

// ================================================================
// P1A-69 -- a type that takes variables, given none, is refused as twoway
// refuses it -- "varlist required", r(100) -- and nothing is registered
// ================================================================
sysuse auto, clear
dash clear
local t69 "scatter line connected area bar spike dropline dot lfit qfit lfitci qfitci lowess lpoly lpolyci fpfit fpfitci mspline mband tsline histogram kdensity rarea rbar rspike rcap rline rconnected rcapsym rscatter tsrline pcspike pcarrow pcbarrow pcscatter pccapsym"
foreach t of local t69 {
    foreach form in "`t' , name(p1a69)" "`t', name(p1a69)" "`t'" ///
        "`t' if foreign, name(p1a69)" "`t' in 1/5, name(p1a69)" ///
        "(`t', name(p1a69))" "scatter mpg weight || `t', name(p1a69)" {
        capture dash `form'
        if _rc != 100 {
            display as error `"P1A-69: dash `form' gave rc "' _rc
            exit 9
        }
    }
}
assert "${dash_graph_registry}" == ""
// In twoway's words.
foreach form in "scatter , name(p1a69)" "tsline, name(p1a69)" "line" ///
    "(connected, name(p1a69))" "scatter mpg weight || lfit, name(p1a69)" ///
    "dot [aw=price], name(p1a69)" {
    _p1a_logrun `"dash `form'"'
    local rc69 = r(rc)
    cert_file_has "`r(log)'", needle("varlist required")
    if `rc69' != 100 | !r(found) {
        display as error `"P1A-69: dash `form' gave rc `rc69', not varlist required"'
        exit 9
    }
}
capture _dash_process_segment "scatter , mcolor(red)" _pt69 _js69
assert _rc == 100
assert "${dash_graph_registry}" == ""
display "P1A-69 PASS: every type that takes variables, given none -- the comma spaced, glued or absent, in parentheses, after ||, or with only an if, an in or a weight -- is refused r(100), varlist required, as twoway refuses it, and nothing is registered"

// ================================================================
// P1A-70 -- scatteri, pci and pcarrowi given no values are refused r(198),
// as twoway refuses them, in dash's words for a list with no whole point,
// segment or arrow (P1A-61), and nothing is registered
// ================================================================
sysuse auto, clear
dash clear
foreach t in scatteri pci pcarrowi {
    if "`t'" == "scatteri"  local u70 "point, two numbers #y #x"
    else if "`t'" == "pci"  local u70 "segment, four numbers #y1 #x1 #y2 #x2"
    else                    local u70 "arrow, four numbers #y1 #x1 #y2 #x2"
    foreach form in "`t' , name(p1a70)" "`t', name(p1a70)" "`t'" ///
        "`t' if foreign, name(p1a70)" "`t' in 1/2, name(p1a70)" ///
        "(`t', name(p1a70))" "scatteri 1 2 || `t', name(p1a70)" {
        _p1a_logrun `"dash `form'"'
        local rc70 = r(rc)
        local lg70 "`r(log)'"
        cert_file_has "`lg70'", needle("dash: `t' needs at least one `u70'.")
        local ok70 = r(found)
        cert_file_has "`lg70'", needle("something required")
        if `rc70' != 198 | !`ok70' | r(found) {
            display as error `"P1A-70: dash `form' gave rc `rc70'"'
            exit 9
        }
    }
}
assert "${dash_graph_registry}" == ""
display "P1A-70 PASS: scatteri, pci and pcarrowi given no values are refused r(198), as twoway refuses them, and nothing is registered"

// ================================================================
// P1A-71 -- function given no expression: "expression required", r(100),
// and `function y =' "nothing found where expression expected", r(111),
// as twoway says; nothing is registered
// ================================================================
sysuse auto, clear
dash clear
foreach form in "function , name(p1a71)" "function, name(p1a71)" "function" ///
    "function if foreign, name(p1a71)" "function in 1/5, name(p1a71)" ///
    "(function, name(p1a71))" "scatteri 1 2 || function, name(p1a71)" ///
    "function [aw=price], name(p1a71)" "fn, range(0 1)" {
    _p1a_logrun `"dash `form'"'
    local rc71 = r(rc)
    cert_file_has "`r(log)'", needle("expression required")
    if `rc71' != 100 | !r(found) {
        display as error `"P1A-71: dash `form' gave rc `rc71', not expression required"'
        exit 9
    }
}
foreach form in "function y =, name(p1a71)" "function y=, range(0 1)" ///
    "(function y = , name(p1a71))" {
    _p1a_logrun `"dash `form'"'
    local rc71 = r(rc)
    cert_file_has "`r(log)'", needle("nothing found where expression expected")
    if `rc71' != 111 | !r(found) {
        display as error `"P1A-71: dash `form' gave rc `rc71'"'
        exit 9
    }
}
assert "${dash_graph_registry}" == ""
// An expression is kept as it was written (V2-06).
_dash_process_segment "function y = x^2, range(0 2)" _pt71 _js71
assert strpos(`"`_js71'"', `""expr":"x^2""') > 0
display "P1A-71 PASS: function given no expression is refused as twoway refuses it, r(100) expression required, or r(111) after y =, and nothing is registered"

// ================================================================
// P1A-72 -- a dashboard of immediate graphs alone is built, in both modes,
// with the data in memory and with none, and exports no variable
// ================================================================
sysuse auto, clear
dash clear
dash scatteri 1 2 3 4, name(p1a72a)
dash pci 0 0 1 1, name(p1a72b)
dash pcarrowi 0 0 1 1 (3) "A", name(p1a72c)
dash function y = x^2, range(0 2) name(p1a72d)
tempfile s72 d72 h72
_dash_prepare_spec, specpath("`s72'") datapath("`d72'")
assert `"`r(vars)'"' == ""
// What is written is jsonio's layout holding no variable and no
// observation, which both renderers read (test_immediate_dashboards.py).
tempname fh72
file open `fh72' using "`d72'", read text
file read `fh72' line72
file close `fh72'
assert `"`macval(line72)'"' == `"{"values":[],"variableIsString":{},"variableNames":[],"variableLabels":{},"valueLabelNames":{},"valueLabels":{},"numberOfRecords":0,"numberOfVariables":0}"'
foreach mode in "" "server" {
    local ext72 = cond("`mode'" == "", "html", "py")
    _p1a_logrun `"dash build, saving("`h72'a.`ext72'") `mode' replace"'
    assert r(rc) == 0
    confirm file "`h72'a.`ext72'"
}
// With no data in memory: twoway draws them without any, and so does dash.
clear
foreach mode in "" "server" {
    local ext72 = cond("`mode'" == "", "html", "py")
    _p1a_logrun `"dash build, saving("`h72'b.`ext72'") `mode' replace"'
    assert r(rc) == 0
    confirm file "`h72'b.`ext72'"
}
_dash_prepare_spec, specpath("`s72'") datapath("`d72'")
assert `"`r(vars)'"' == ""
dash clear
_p1a_logrun `"dash scatteri 1 2 3 4, saving("`h72'c.html")"'
assert r(rc) == 0
confirm file "`h72'c.html"
_p1a_logrun `"dash function y = x^2, range(0 2) saving("`h72'd.html")"'
assert r(rc) == 0
confirm file "`h72'd.html"
_p1a_logrun `"dash (pci 0 0 1 1) (pcarrowi 1 1 0 0), saving("`h72'e.html")"'
assert r(rc) == 0
confirm file "`h72'e.html"
_p1a_logrun "dash scatteri 1 2 3 4, name(p1a72e)"
assert r(rc) == 0
assert "${dash_graph_registry}" == "p1a72e"
// A graph of immediate values beside one of data exports the data, as
// before.
sysuse auto, clear
dash clear
dash scatteri 1 2, name(p1a72f)
dash scatter mpg weight, name(p1a72g)
_dash_prepare_spec, specpath("`s72'") datapath("`d72'")
assert `"`r(vars)'"' == "mpg weight"
dash clear
display "P1A-72 PASS: a dashboard of scatteri, pci, pcarrowi and function graphs alone is built saved and served, with data in memory and with none, and exports no variable"

// ================================================================
// P1A-73 -- an immediate plot whose every point is missing draws nothing
// and says nothing, as twoway; a data layer that draws nothing is still
// named, and a graph with no name is not called '?'
// ================================================================
sysuse auto, clear
dash clear
tempfile h73
local i73 0
foreach c in "scatteri . . . .," "pci . 0 1 .," "pcarrowi . . . .," ///
    "function y = 1/0," "function y = sqrt(x), range(-2 -1)" {
    local ++i73
    _p1a_logrun `"dash `c' saving("`h73'`i73'.html")"'
    local rc73 = r(rc)
    cert_file_has "`r(log)'", needle("drew nothing")
    if `rc73' != 0 | r(found) {
        display as error `"P1A-73: dash `c' gave rc `rc73' or said it drew nothing"'
        exit 9
    }
}
// ... registered beside a scatter and built, too.
dash scatteri . ., name(p1a73a)
dash scatter mpg weight, name(p1a73b)
_p1a_logrun `"dash build, saving("`h73'g.html") replace"'
assert r(rc) == 0
cert_file_has "`r(log)'", needle("drew nothing")
assert r(found) == 0
dash clear
// A data layer that draws nothing is still named: by its graph when the
// graph has a name, by its place alone when it has none.  Flipped: WP-32
// -- the layer was a scatter, which dash now draws in silence as twoway
// does (BUGS.md "An all-missing scatter, a constant-x lowess and a
// constant kdensity keep dash's "drew nothing" note"); then the line, which
// dash draws in silence too, as twoway does (BUGS.md "An all-missing line,
// area, bar or other plain layer says "drew nothing", where twoway draws
// it in silence"): neither form names it now, and the place-or-name rule
// is certified by test_immediate_dashboards.py
// TestALayerThatDrewNothingIsNamedByWhatItHas.
generate m73 = .
_p1a_logrun `"dash line m73 weight, saving("`h73'h.html")"'
assert r(rc) == 0
local lg73 "`r(log)'"
cert_file_has "`lg73'", needle("drew nothing")
assert r(found) == 0
cert_file_has "`lg73'", needle("'?'")
assert r(found) == 0
dash line m73 weight, name(p1a73c)
_p1a_logrun `"dash build, saving("`h73'i.html") replace"'
assert r(rc) == 0
cert_file_has "`r(log)'", needle("drew nothing")
assert r(found) == 0
drop m73
dash clear
display "P1A-73 PASS: an immediate plot or a function missing everywhere draws nothing and says nothing, as twoway; an all-missing data layer draws nothing in silence, as twoway"

// ================================================================
// P1A-74 -- a graph that names no variable and is not immediate is still
// refused, on both routes: dash no longer registers one, but the registry
// is ordinary globals
// ================================================================
sysuse auto, clear
dash clear
tempfile h74
local j74a `"{"name":"p1a74","plots":[{"type":"scatter","yvar":"","xvar":"","options":{}}],"graph_options":{"name":"p1a74"},"if_expr":"","in_expr":""}"'
local j74b `"{"name":"p1a74","plots":[{"type":"scatteri","values":[[1,2]],"options":{}},{"type":"line","yvar":"","xvar":"","options":{}}],"graph_options":{"name":"p1a74"},"if_expr":"","in_expr":""}"'
foreach j in j74a j74b {
    global dash_graph_registry "p1a74"
    global dash_json_p1a74 `"``j''"'
    _p1a_logrun `"dash build, saving("`h74'.html") replace"'
    local rc74 = r(rc)
    cert_file_has "`r(log)'", needle("dash build: no variables identified across registered graphs.")
    if `rc74' != 198 | !r(found) {
        display as error "P1A-74: dash build of `j' gave rc `rc74'"
        exit 9
    }
    _p1a_logrun `"_dash_render_immediate `"``j''"' """'
    local rc74 = r(rc)
    cert_file_has "`r(log)'", needle("dash: no variables identified in plot specification.")
    if `rc74' != 198 | !r(found) {
        display as error "P1A-74: the one-line render of `j' gave rc `rc74'"
        exit 9
    }
}
dash clear
display "P1A-74 PASS: a graph that names no variable and is not all immediate is refused by dash build and by the one-line render, r(198)"

// ================================================================
// P1A-75 -- the helpers behind P1A-68..74, one by one
// ================================================================
// _dash_spec_types_in(json, allowed): 1 when the spec names a plot type
// and every type it names is a word of allowed.
local lit75 "scatteri pci pcarrowi function"
local j75a `"{"plots":[{"type":"scatteri","values":[[1,2]]},{"type":"function","expr":"x"}]}"'
local j75b `"{"plots":[{"type":"scatteri","values":[[1,2]]},{"type":"scatter","yvar":"mpg","xvar":"weight"}]}"'
local j75c `"{"plots":[]}"'
// A key written inside a string is text: its quotes are escaped.
local j75d `"{"plots":[{"type":"pcarrowi","values":[[0,0,1,1]]}],"graph_options":{"title":"a \"type\":\"scatter\" b"}}"'
local j75e `"{"plots":[{"type":"scatteri"}]}"'
mata: st_local("r75", strofreal(_dash_spec_types_in(st_local("j75a"), st_local("lit75"))))
assert `r75' == 1
mata: st_local("r75", strofreal(_dash_spec_types_in(st_local("j75b"), st_local("lit75"))))
assert `r75' == 0
mata: st_local("r75", strofreal(_dash_spec_types_in(st_local("j75c"), st_local("lit75"))))
assert `r75' == 0
mata: st_local("r75", strofreal(_dash_spec_types_in(st_local("j75d"), st_local("lit75"))))
assert `r75' == 1
// A type is matched whole: pcarrowi is not pci, and scatteri not scatter.
mata: st_local("r75", strofreal(_dash_spec_types_in(st_local("j75d"), "pci")))
assert `r75' == 0
mata: st_local("r75", strofreal(_dash_spec_types_in(st_local("j75e"), "scatter")))
assert `r75' == 0
// Nothing allowed allows nothing, and a word given twice counts once.
mata: st_local("r75", strofreal(_dash_spec_types_in(st_local("j75a"), "")))
assert `r75' == 0
mata: st_local("r75", strofreal(_dash_spec_types_in(st_local("j75a"), "scatteri scatteri function function")))
assert `r75' == 1
// In linear time: twenty thousand plots and a title of 100,000 characters.
mata: st_local("big75", "{" + char(34) + "plots" + char(34) + ":[" + 20000 * ("{" + char(34) + "type" + char(34) + ":" + char(34) + "scatteri" + char(34) + "},") + "{}]," + char(34) + "t" + char(34) + ":" + char(34) + 100000 * "a" + char(34) + "}")
timer clear 75
timer on 75
mata: st_local("r75", strofreal(_dash_spec_types_in(st_local("big75"), st_local("lit75"))))
timer off 75
quietly timer list 75
assert r(t75) < 5
assert `r75' == 1
local big75 ""
// _dash_empty_data path: the data file of a dashboard that exports no
// variable, one line, replacing what was there.
tempfile e75
_dash_empty_data "`e75'"
_dash_empty_data "`e75'"
tempname fh75
file open `fh75' using "`e75'", read text
file read `fh75' line75
assert `"`macval(line75)'"' == `"{"values":[],"variableIsString":{},"variableNames":[],"variableLabels":{},"valueLabelNames":{},"valueLabels":{},"numberOfRecords":0,"numberOfVariables":0}"'
file read `fh75' line75
assert r(eof) == 1
file close `fh75'
// _dash_parse_varpart_any takes nothing, or an if or in alone, and leaves
// what is missing to its caller (P1A-70, P1A-71).
sysuse auto, clear
_dash_parse_varpart_any
assert `"`s(vals)'"' == "" & `"`s(if_clause)'"' == "" & `"`s(in_clause)'"' == ""
_dash_parse_varpart_any if foreign
assert `"`s(vals)'"' == ""
assert strpos(`"`s(if_clause)'"', "foreign") > 0
_dash_parse_varpart_any 1 2 in 1/2
assert `"`s(vals)'"' == "1 2"
assert strpos(`"`s(in_clause)'"', "1/2") > 0
display "P1A-75 PASS: _dash_spec_types_in matches whole types in linear time, _dash_empty_data writes jsonio's layout with no variable, and _dash_parse_varpart_any takes an empty list"

// ================================================================
// P1A-76 -- every prefix of every plot-type name, through the real
// _dash_expand_plottype_str: the one row it reaches, or "" when it reaches
// none; and no prefix reaches two rows (WP-26 TR-26.6)
// ================================================================
// _dash_expand_plottype_str counted the rows a name reached and refused one
// that reached two, "an ambiguous prefix".  Nothing could: measured
// 24sep2026 at 480159f, each of the 186 prefixes of the 40 names reached
// at most one row, and twoway refuses every prefix of two of its plot-type
// names that reaches neither minimum -- "s is not a twoway plot type",
// r(198) -- as dash refuses it.  The count went, and the first row a name
// reaches is taken; that is right only while no name reaches two.  The
// rows are read here from dash_parse.mata itself, and every prefix of
// every name is checked against them: a row that let a prefix reach two
// fails this case.
mata:
_p76q  = char(34)
_p76rx = "[(]" + _p76q + "([a-z]+)" + _p76q + "," + _p76q + "([a-z]+)" + _p76q + "[)]"
_p76L  = cat("../dash_parse.mata")
_p76t  = J(0, 2, "")
_p76in = 0
for (_i = 1; _i <= rows(_p76L); _i++) {
    if (strpos(_p76L[_i], "string scalar _dash_expand_plottype_str(")) _p76in = 1
    else if (_p76in & substr(_p76L[_i], 1, 1) == "}") _p76in = 0
    if (_p76in & ustrregexm(_p76L[_i], _p76rx)) _p76t = _p76t \ (ustrregexs(1), ustrregexs(2))
}
_p76bad  = ""
_p76seen = J(0, 1, "")
_p76two  = 0
for (_r = 1; _r <= rows(_p76t); _r++) {
    for (_k = 1; _k <= strlen(_p76t[_r, 1]); _k++) {
        _p = substr(_p76t[_r, 1], 1, _k)
        if (anyof(_p76seen, _p)) continue
        _p76seen = _p76seen \ _p
        _hits = J(0, 1, "")
        for (_s = 1; _s <= rows(_p76t); _s++) {
            if (strlen(_p) >= strlen(_p76t[_s, 2]) &
                substr(_p76t[_s, 1], 1, strlen(_p)) == _p) _hits = _hits \ _p76t[_s, 1]
        }
        _want = (rows(_hits) == 1 ? _hits[1] : "")
        if (rows(_hits) > 1) {
            _p76two = _p76two + 1
            _p76bad = _p76bad + " '" + _p + "' reaches " + invtokens(_hits') + ";"
        }
        else if (_dash_expand_plottype_str(_p) != _want) {
            _p76bad = _p76bad + " '" + _p + "' gave '" + _dash_expand_plottype_str(_p) + "', want '" + _want + "';"
        }
    }
}
st_local("p76rows", strofreal(rows(_p76t)))
st_local("p76first", _p76t[1, 1] + "," + _p76t[1, 2])
st_local("p76last", _p76t[rows(_p76t), 1] + "," + _p76t[rows(_p76t), 2])
st_local("p76np", strofreal(rows(_p76seen)))
st_local("p76two", strofreal(_p76two))
st_global("P76_BAD", _p76bad)
end
display "P1A-76: `p76rows' rows read, `p76np' distinct prefixes, `p76two' reaching two rows"
// The table was read whole: its first row, its last, and at least the 40
// it held when this was written.
assert `p76rows' >= 40
assert "`p76first'" == "scatter,sc"
// WP-31 B1: rpspike was the last row once rpcap and rpspike were drawn;
// WP-31 B4b: contourline is, now contour and contourline are.
assert "`p76last'" == "contourline,contourline"
assert `p76np' >= 186
if `"$P76_BAD"' != "" {
    display as error "P1A-76 FAIL:$P76_BAD"
    exit 9
}
assert `p76two' == 0
macro drop P76_BAD
display "P1A-76 PASS: no prefix of a plot-type name reaches two rows, and _dash_expand_plottype_str returns the one each reaches, or nothing"

// ================================================================
// P1A-77 -- a function layer calling a function Stata does not have is
//           refused as twoway refuses it (BUGS.md, S3)
// ================================================================
// Measured 24sep2026 with the console binary, and again below, twoway's
// own codes (asked of twoway once and replayed: cert_truth.do):
// `twoway function y = nosuchfunction(x), range(0 10) nodraw' is
// "error in expression: nosuchfunction(x)", r(133); so is system(x), Sin(x)
// (functions are case-sensitive), a call anywhere in the expression, and
// the form with no `y ='.  normal(x), which Stata has, twoway draws (rc 0).
// dash registered every refused one, rc 0, and drew an empty layer.
// Flipped by WP-29 P0.6: dash now runs twoway's own generator, so its
// refusal is twoway's one line -- no "unknown function" line after it --
// and its codes are twoway's, for the long expressions too.
sysuse auto, clear
dash clear
cert_truth_ctx "P1A-77"
local rs77 = c(rngstate)
foreach e in "y = nosuchfunction(x)" "y = system(x)" "y = Sin(x)" ///
    "y = x*nosuch(x) + 2" "nosuchfunction(x)" "y = sin(x) + mpg(x)" {
    capture cert_tw twoway function `e', range(0 10) nodraw
    local tw77 = _rc
    _p1a_logrun `"dash function `e', range(0 10) name(p1a77)"'
    local rc77 = r(rc)
    local lg77 "`r(log)'"
    if `tw77' != 133 | `rc77' != 133 {
        display as error `"P1A-77: function `e': twoway r(`tw77'), dash r(`rc77'); both should be r(133)"'
        exit 9
    }
    cert_file_has "`lg77'", needle("error in expression: ")
    assert r(found) == 1
    cert_file_has "`lg77'", needle("unknown function ")
    assert r(found) == 0
}
capture cert_tw twoway (function y = nosuchfunction(x), range(0 10)) (scatter mpg weight), nodraw
assert _rc == 133
_p1a_logrun `"dash (function y = nosuchfunction(x), range(0 10)) (scatter mpg weight), name(p1a77)"'
assert r(rc) == 133
assert "${dash_graph_registry}" == ""
// Nothing was evaluated that could move the random-number state: Stata
// reads the whole expression before it evaluates any of it (the generator
// alone: y = runiform() + nosuch(x) is r(133), the state unchanged).
_p1a_logrun `"dash function y = runiform() + rnormal() + nosuch(x), range(0 1) name(p1a77)"'
assert r(rc) == 133
assert c(rngstate) == "`rs77'"
// What twoway draws is still registered: functions Stata has, whether or
// not the renderer draws them, and a name inside a string.
foreach e in "y = x^2" "y = sin(x) + sqrt(abs(x))" "y = normal(x)" ///
    "y = max(x, 1) + inlist(x, 1, 2)" `"y = strlen("nosuch(x)") + x"' {
    capture cert_tw twoway function `e', range(0 10) nodraw
    local tw77 = _rc
    capture dash clear
    _p1a_logrun `"dash function `e', range(0 10) name(p1a77ok)"'
    if `tw77' != 0 | r(rc) != 0 {
        display as error `"P1A-77: function `e': twoway r(`tw77'), dash r(`r(rc)'); both should draw it"'
        exit 9
    }
}
capture dash clear
// Adversarial (rule 18).  Injection: the expression is echoed only through
// _dash_say, so SMCL in it is shown as typed, never obeyed; the function
// name reaches a command line only as a Stata name.
_p1a_logrun "dash function y = nosuch(x) + {bf:BOLD} + {res}, range(0 1) name(p1a77)"
assert r(rc) == 133
cert_file_has "`r(log)'", needle("{bf:BOLD} + {res}")
assert r(found) == 1
// Resource exhaustion: 5,000 distinct unknown calls are refused at the
// first; 5,000 calls of one known function are twoway's answer (r(130),
// the expression too long, measured; replayed, cert_truth.do).
local e77 "x"
local k77 "x"
forvalues i = 1/5000 {
    local e77 "`e77' + f`i'(x)"
    local k77 "`k77' + sin(x)"
}
timer clear 77
timer on 77
_p1a_logrun `"dash function y = `e77', range(0 1) name(p1a77)"'
assert r(rc) == 133
// The refusal shows the first 197 characters of the text after the `=',
// as typed, not 55,000.
local lg77 "`r(log)'"
cert_file_has "`lg77'", needle("f22(x) + f23...")
assert r(found) == 1
cert_file_has "`lg77'", needle("f4999(x)")
assert r(found) == 0
capture cert_tw twoway function y = `k77', range(0 1) nodraw
local tw77 = _rc
_p1a_logrun `"dash function y = `k77', range(0 1) name(p1a77k)"'
assert r(rc) == `tw77'
timer off 77
quietly timer list 77
assert r(t77) < 10
capture dash clear
// (The scanner of dash's own pre-check, _dash_fn_names, went with the
// pre-check: the generator answers.)
display "P1A-77 PASS: a function layer calling a function Stata does not have is refused, r(133), as twoway refuses it; what twoway draws is registered"

// ================================================================
// P1A-78 -- a function layer with a blank between a name and its `(' is
//           refused as twoway refuses it (BUGS.md, S3)
// ================================================================
// Stata never reads sin (x) as a call.  Measured 24sep2026 with the console
// binary, and again below (twoway's codes, asked of twoway once and
// replayed: cert_truth.do): `twoway function y = sin (x)' is
// "error in expression:  sin (x)", r(111) -- sin looked for as a variable
// -- and so is any name the data does not have (abs, max, c, nosuch, X),
// anywhere in the expression and without `y ='; a name the data has (mpg,
// or mp for it), x, _n, _N and _pi are r(198), and so is a number, a
// string or a closing parenthesis before the blanks.  dash drew sin (x)
// as sin(x), rc 0.  An operator before the `(' -- 2 * (x), x + (1) -- is
// drawn by both.
sysuse auto, clear
dash clear
cert_truth_ctx "P1A-78"
foreach e in "y = sin (x)" "sin (x)" "y = x*sin (x)" "y = abs (x) + 1" ///
    "y = sin  (x)" "y = max (x, 1)" "y = sin(x) + cos (x)" "y = c (pi)*x" ///
    "y = mpg (x)" "y = mp (x)" "y = x (x)" "y = _pi (x)" "y = _n (x)" ///
    "y = 2 (x)" "y = 1.5 (x)" "y = sin(x) (x)" "y = (x) (x)" "y = nosuch (x)" ///
    "y = X (x)" "y = sin ( x )" "y = nosuch(x) + sin (x)" "y = sin (x) + nosuch(x)" {
    capture cert_tw twoway function `e', range(0 10) nodraw
    local tw78 = _rc
    _p1a_logrun `"dash function `e', range(0 10) name(p1a78)"'
    local rc78 = r(rc)
    if !inlist(`tw78', 111, 133, 198) | `rc78' != `tw78' {
        display as error `"P1A-78: function `e': twoway r(`tw78'), dash r(`rc78'); dash should refuse as twoway does"'
        exit 9
    }
    cert_file_has "`r(log)'", needle("error in expression: ")
    assert r(found) == 1
    assert "${dash_graph_registry}" == ""
}
// Tabs alone between the name and its `(' are r(133) in twoway, an
// unknown function; a tab and a space r(111).
local e78 = "y = sin" + char(9) + "(x)"
capture cert_tw twoway function `e78', range(0 10) nodraw
assert _rc == 133
_p1a_logrun `"dash function `e78', range(0 10) name(p1a78)"'
assert r(rc) == 133
local e78 = "y = sin" + char(9) + " (x)"
capture cert_tw twoway function `e78', range(0 10) nodraw
assert _rc == 111
_p1a_logrun `"dash function `e78', range(0 10) name(p1a78)"'
assert r(rc) == 111
// What twoway draws is registered.
foreach e in "y = sin(x)" "y = 2 * (x)" "y = x + (1)" "y = -(x)" "y = x^(2)" ///
    "y = sin( x )" "y = x > (1)" "y = x/(1+x)" "y = sin((x))" ///
    `"y = strlen("a (b") + x"' "y = 3*(x) + (1)" {
    capture cert_tw twoway function `e', range(0 10) nodraw
    local tw78 = _rc
    capture dash clear
    _p1a_logrun `"dash function `e', range(0 10) name(p1a78ok)"'
    if `tw78' != 0 | r(rc) != 0 {
        display as error `"P1A-78: function `e': twoway r(`tw78'), dash r(`r(rc)'); both should draw it"'
        exit 9
    }
}
capture dash clear
// In a plot group and after ||, as twoway.
capture cert_tw twoway (function y = sin (x), range(0 10)) (scatter mpg weight), nodraw
assert _rc == 111
_p1a_logrun `"dash (function y = sin (x), range(0 10)) (scatter mpg weight), name(p1a78)"'
assert r(rc) == 111
_p1a_logrun `"dash scatter mpg weight || function y = sin (x), range(0 10) name(p1a78)"'
assert r(rc) == 111
assert "${dash_graph_registry}" == ""
// Adversarial (rule 18).  Injection: the expression is echoed as typed,
// SMCL shown, not obeyed, and a name only reaches -confirm- as a Stata
// name.  Resource exhaustion: 5,000 terms before the blank are one pass.
// twoway's code for it (WP-29 P0.6: the generator answers; replayed,
// cert_truth.do).
capture cert_tw twoway function y = {bf:BOLD} + sin (x), range(0 1) nodraw
local tw78b = _rc
_p1a_logrun "dash function y = {bf:BOLD} + sin (x), range(0 1) name(p1a78)"
assert r(rc) == `tw78b' & `tw78b' != 0
cert_file_has "`r(log)'", needle("{bf:BOLD} + sin (x)")
assert r(found) == 1
// Since WP-29 P0.6 the codes for these are twoway's own (replayed,
// cert_truth.do): the generator answers r(130) for an expression this long
// (measured).
local e78 "x"
forvalues i = 1/5000 {
    local e78 "`e78' + (x)"
}
timer clear 78
timer on 78
capture cert_tw twoway function y = `e78' + sin (x), range(0 1) nodraw
local tw78 = _rc
_p1a_logrun `"dash function y = `e78' + sin (x), range(0 1) name(p1a78)"'
assert r(rc) == `tw78' & `tw78' != 0
capture cert_tw twoway function y = `e78', range(0 1) nodraw
local tw78 = _rc
_p1a_logrun `"dash function y = `e78', range(0 1) name(p1a78k)"'
assert r(rc) == `tw78'
timer off 78
quietly timer list 78
assert r(t78) < 10
capture dash clear
// (The scanner of dash's own pre-check, _dash_fn_space_call, went with the
// pre-check: the generator answers; WP-29 P0.6.)
display "P1A-78 PASS: a name or value written apart from its parenthesis is refused, r(111), r(133) or r(198), as twoway refuses it; what twoway draws is registered"


// ----------------------------------------------------------------
// P1A-79..81 share one check: the same command through twoway and
// dash, each logged; the codes must agree, and each needle must be in
// BOTH logs, so the words are twoway's own -- measured once and replayed
// (cert_truth.do), dash's on every run.
// ----------------------------------------------------------------
capture program drop _p1a_vs_tw
program define _p1a_vs_tw
    version 16.0
    // _p1a_vs_tw <id> <twoway command> <dash command> [<needle> [<needle>]]
    args id twcmd dcmd n1 n2
    // nodraw is added to the twoway command after its comma, or with one.
    if strpos(`"`twcmd'"', ",") local twcmd `"`twcmd' nodraw"'
    else                        local twcmd `"`twcmd', nodraw"'
    // Logged here rather than by _p1a_logrun: twoway fpfit's refusal of a
    // third variable leaves SMCL in paragraph mode, and its words stay
    // unwritten until a {p_end}, after the log has closed.  twoway's
    // answer -- its rc and its log -- is asked here in a live run and read
    // back otherwise (cert_truth.do), the same words in the same log
    // either way.
    local twlog "`c(tmpdir)'dash_p1a_tw.log"
    python: _dct = __import__("sys").modules["_dash_cert_truth"]
    python: _dct.flag("_ct_l")
    if `_ct_l' {
        graph drop _all
        local ls = c(linesize)
        set linesize 255
        capture log close _p1atw
        quietly log using "`twlog'", name(_p1atw) text replace
        capture noisily `twcmd'
        local twrc = _rc
        display as text "{p_end}"
        quietly log close _p1atw
        set linesize `ls'
        python: _dct.log_put("twcmd", "twrc", "twlog")
    }
    else {
        python: _dct.log_get("twcmd", "twlog", "twrc")
        if "`twrc'" == "" local twrc 9
    }
    _p1a_logrun `"`dcmd'"'
    local drc = r(rc)
    local dlog "`r(log)'"
    if `twrc' != `drc' {
        display as error `"`id': twoway r(`twrc'), dash r(`drc'): `dcmd'"'
        exit 9
    }
    foreach n in n1 n2 {
        if `"``n''"' == "" continue
        cert_file_has "`twlog'", needle(`"``n''"')
        local intw = r(found)
        cert_file_has "`dlog'", needle(`"``n''"')
        if `intw' != 1 | r(found) != 1 {
            display as error `"`id': "``n''" in twoway's log `intw', in dash's `r(found)': `dcmd'"'
            exit 9
        }
    }
end

// ================================================================
// P1A-81 -- a range or paired-coordinate type given the wrong number of
//           variables is refused as twoway refuses it (BUGS.md, S2)
// ================================================================
// Measured 24sep2026 with the console binary: a range type given one
// variable is "too few variables specified", r(102); two, "rscatter
// requires 3 variables: mpg weight", r(102); four or more, the same
// words, r(103).  tsrline, drawn against the tsset time variable, names
// it: "rline requires 3 variables: mpg t", r(102), and r(103) for three.
// A pc type: one variable r(102) "too few variables specified"; two or
// three "pcspike requires 4 variables: mpg weight", r(102); five, r(103).
// dash registered the range types with two, and the render stopped in a
// KeyError traceback, r(7102) (rspike drew nothing, rc 0); the pc types
// and the too-many forms were refused in -syntax-'s words.
sysuse auto, clear
dash clear
quietly generate t81 = _n
quietly tsset t81
cert_truth_ctx "P1A-81 tsset t81"
local V78 "mpg weight price length turn"
foreach t in rarea rbar rcap rcapsym rconnected rline rscatter rspike tsrline ///
    pcspike pccapsym pcarrow pcbarrow pcscatter {
    local need = cond(substr("`t'", 1, 2) == "pc", 4, cond("`t'" == "tsrline", 2, 3))
    forvalues n = 1/5 {
        if `n' == `need' continue
        local vl ""
        forvalues i = 1/`n' {
            local vl "`vl' `: word `i' of `V78''"
        }
        local vl = strtrim("`vl'")
        if "`t'" == "tsrline" local msg "rline requires 3 variables: `vl' t81"
        else if `n' == 1      local msg "too few variables specified"
        else                  local msg "`t' requires `need' variables: `vl'"
        // The one-line form, a registered graph, a plot group beside
        // another, and a || segment.
        foreach form in "`t' `vl'" "`t' `vl', name(p1a81)" ///
            "(scatter mpg weight) (`t' `vl'), name(p1a81)" ///
            "scatter mpg weight || `t' `vl', name(p1a81)" {
            _p1a_vs_tw P1A-81 "twoway `form'" "dash `form'" "`msg'"
        }
        _p1a_logrun "dash `t' `vl', name(p1a81)"
        cert_file_has "`r(log)'", needle("Traceback")
        assert r(found) == 0
    }
}
assert "${dash_graph_registry}" == ""
// The right number is still registered, in every form.
foreach form in "rscatter mpg weight price, name(p1a78a)" ///
    "(rcap mpg weight price), name(p1a78b)" ///
    "scatter mpg weight || rarea mpg weight price, name(p1a78c)" ///
    "tsrline mpg weight, name(p1a78d)" "pcspike mpg weight price length, name(p1a78e)" {
    capture noisily dash `form'
    assert _rc == 0
}
capture dash clear
// Untsset, tsrline asks for tsset first, whatever the count, as twoway.
quietly tsset, clear
cert_truth_ctx "P1A-81 not tsset"
foreach vl in "mpg" "mpg weight price" {
    _p1a_vs_tw P1A-81 "twoway tsrline `vl'" "dash tsrline `vl', name(p1a81)"
}
// Adversarial (rule 18).  Resource exhaustion: 2,000 variables to a range
// type are refused at once, r(103), and nothing is registered or drawn.
// Injection: the names are Stata names, echoed through _dash_say.
preserve
quietly {
    clear
    set obs 3
    forvalues i = 1/2000 {
        generate byte v`i' = `i'
    }
}
timer clear 81
timer on 81
_p1a_logrun "dash rarea v1-v2000, name(p1a81)"
timer off 81
assert r(rc) == 103
cert_file_has "`r(log)'", needle("rarea requires 3 variables: v1 v2 v3")
assert r(found) == 1
_p1a_logrun "dash pcspike v1-v2000"
assert r(rc) == 103
quietly timer list 81
assert r(t81) < 10
restore
assert "${dash_graph_registry}" == ""
display "P1A-81 PASS: a range or pc type given too few or too many variables is refused at registration, in twoway's words and with its code, in every form"
// ================================================================
// P1A-79 -- a fit or smoother type given more than two variables is
//           refused as twoway refuses it
// ================================================================
// Measured 24sep2026: `twoway lfit mpg weight price' is "too many
// variables specified: mpg weight price", r(103) -- and qfit, lfitci,
// qfitci, fpfit, fpfitci, mspline and mband; lowess, lpoly and lpolyci
// say "too many variables specified", r(103).  dash registered each and
// drew one fit per y variable, rc 0.  scatter, line and the other types
// that take several y variables are unchanged.
sysuse auto, clear
dash clear
cert_truth_ctx "P1A-79"
foreach t in lfit qfit lfitci qfitci fpfit fpfitci mspline mband lowess lpoly lpolyci {
    foreach vl in "mpg weight price" "mpg weight price length turn" {
        local msg "too many variables specified: `vl'"
        if inlist("`t'", "lowess", "lpoly", "lpolyci") local msg "too many variables specified"
        foreach form in "`t' `vl'" "`t' `vl', name(p1a79)" ///
            "(scatter mpg weight) (`t' `vl'), name(p1a79)" ///
            "scatter mpg weight || `t' `vl', name(p1a79)" {
            _p1a_vs_tw P1A-79 "twoway `form'" "dash `form'" "`msg'"
        }
    }
}
assert "${dash_graph_registry}" == ""
foreach t in scatter line connected area bar spike dropline dot {
    _p1a_vs_tw P1A-79 "twoway `t' mpg weight price length" "dash `t' mpg weight price length, name(p1a79`t')"
}
capture dash clear
display "P1A-79 PASS: a fit or smoother type given more than two variables is refused, r(103), in twoway's words; the several-y types still register"

// ================================================================
// P1A-80 -- a statistical plot with too few observations in its sample
//           is refused as twoway refuses it (BUGS.md, S3)
// ================================================================
// Measured 24sep2026 with the console binary, on no observations, on a
// sample the plot's if/in or the graph's qualifier empties, and on one
// observation:
//   histogram   _N == 0: "observation numbers out of range", r(198) --
//               whatever the qualifier or option; a sample emptied by a
//               qualifier or by missing values is drawn, rc 0
//   lpoly(ci)   no observation in the sample: "no observations", r(2000);
//               one: "insufficient observations", r(2001)
//   lfit(ci)    one: "(note:  regress could not fit model)", then
//               "insufficient observations", r(2001)
//   kdensity    one: "insufficient observations", r(2001)
//   fpfit(ci)   no observation the if and in select: "(note:  fracpoly
//               could not fit model)", then "observation numbers out of
//               range", r(198); emptied by missing values, the note, rc 0
//   mspline,    no observation the if and in select, and no bands():
//   mband       "bands must be between 1 and 200", r(198)
// The sample is the plot's if and in, the graph's qualifier, the rows
// whose variables are not missing, and, weighted, a weight above zero.
// dash registered every one, rc 0, and drew an empty layer.  With by()
// twoway answers panel by panel, and so does dash (P1A-83).
capture program drop _p1a80
program define _p1a80
    // _p1a80 <plot> <qualifier> [needle] [needle]: the plot in each form
    // <plot> is the plot with no options; <opts> its options, or "".
    args plot q opts n1 n2
    local pty : word 1 of `plot'
    local c ""
    if `"`opts'"' != "" local c ","
    _p1a_vs_tw "P1A-80 `pty' `q'" "twoway `plot' `q'`c' `opts'" "dash `plot' `q', `opts' name(p1a80)" "`n1'" "`n2'"
    _p1a_vs_tw "P1A-80 `pty' `q'" "twoway `plot' `q'`c' `opts'" "dash `plot' `q'`c' `opts'" "`n1'" "`n2'"
    _p1a_vs_tw "P1A-80 `pty' (`q')" "twoway (`plot'`c' `opts') `q'," "dash (`plot'`c' `opts') `q', name(p1a80)" "`n1'" "`n2'"
    _p1a_vs_tw "P1A-80 `pty' ||" "twoway scatter mpg weight || `plot' `q'`c' `opts'" "dash scatter mpg weight || `plot' `q', `opts' name(p1a80)" "`n1'" "`n2'"
    capture dash clear
end
local nfit "(note:  fracpoly could not fit model)"
local nreg "(note:  regress could not fit model)"
local oor  "observation numbers out of range"
local bnd  "bands must be between 1 and 200"
// _p1a80d <plot> <qualifier> [opts]: drawn by both, rc 0, registered
capture program drop _p1a80d
program define _p1a80d
    args plot q opts
    local c ""
    if `"`opts'"' != "" local c ","
    _p1a_vs_tw "P1A-80 `plot' `q' `opts'" "twoway `plot' `q'`c' `opts'" "dash `plot' `q', `opts' name(p1a80)"
    capture dash clear
end
// ---- no observation in the sample, by the qualifier
// (twoway's answers are keyed by the data in memory: a cert_truth_ctx
// after each change to it.)
sysuse auto, clear
dash clear
cert_truth_ctx "P1A-80 auto"
foreach q in "if price < 0" "in 1/5 if price > 100000" {
    _p1a80 "lpoly mpg weight"   "`q'" "" "no observations"
    _p1a80 "lpolyci mpg weight" "`q'" "" "no observations"
    _p1a80 "fpfit mpg weight"   "`q'" "" "`nfit'" "`oor'"
    _p1a80 "fpfitci mpg weight" "`q'" "" "`nfit'" "`oor'"
    _p1a80 "mspline mpg weight" "`q'" "" "`bnd'"
    _p1a80 "mband mpg weight"   "`q'" "" "`bnd'"
    _p1a80 "mband mpg weight"   "`q'" "n(20)" "`bnd'"
    foreach p in "lfit mpg weight" "qfitci mpg weight" "lowess mpg weight" ///
        "kdensity mpg" "histogram mpg" {
        _p1a80d "`p'" "`q'"
    }
    _p1a80d "mspline mpg weight" "`q'" "bands(5)"
    _p1a80d "histogram mpg" "`q'" "bin(5)"
}
// ---- one observation in the sample
foreach q in "if _n == 1" "in 1" {
    _p1a80 "lfit mpg weight"    "`q'" "" "`nreg'" "insufficient observations"
    _p1a80 "lfitci mpg weight"  "`q'" "" "`nreg'" "insufficient observations"
    _p1a80 "lpoly mpg weight"   "`q'" "" "insufficient observations"
    _p1a80 "lpolyci mpg weight" "`q'" "" "insufficient observations"
    _p1a80 "kdensity mpg"       "`q'" "" "insufficient observations"
    foreach p in "qfit mpg weight" "fpfit mpg weight" "lowess mpg weight" ///
        "mspline mpg weight" "mband mpg weight" "histogram mpg" {
        _p1a80d "`p'" "`q'"
    }
}
// Beside another plot: the group's own qualifier, and the graph's.
_p1a_vs_tw "P1A-80 two groups" "twoway (lfit mpg weight if _n==1) (lpoly mpg weight if _n<=2)" "dash (lfit mpg weight if _n==1) (lpoly mpg weight if _n<=2), name(p1a80)" "`nreg'" "insufficient observations"
_p1a_vs_tw "P1A-80 graph qualifier" "twoway (lfit mpg weight) (scatter mpg weight) if _n==1" "dash (lfit mpg weight) (scatter mpg weight) if _n==1, name(p1a80)" "insufficient observations"
assert "${dash_graph_registry}" == ""
// ---- the sample emptied by weights, and by missing values
generate w80 = cond(_n == 1, 1, .)
cert_truth_ctx "P1A-80 w80 1 then missing"
_p1a80 "lpoly mpg weight [aw=w80]" "" "" "insufficient observations"
_p1a80 "kdensity mpg [aw=w80]"     "" "" "insufficient observations"
quietly replace w80 = cond(_n == 1, 1, 0)
cert_truth_ctx "P1A-80 w80 1 then 0"
_p1a80 "lfit mpg weight [fw=w80]"  "" "" "`nreg'" "insufficient observations"
_p1a80 "lpoly mpg weight [fw=w80]" "" "" "insufficient observations"
quietly replace w80 = 0
cert_truth_ctx "P1A-80 w80 0"
_p1a80 "lpoly mpg weight [fw=w80]" "" "" "no observations"
foreach p in "fpfit mpg weight [fw=w80]" "lfit mpg weight [fw=w80]" "histogram mpg [fw=w80]" {
    _p1a80d "`p'" ""
}
quietly replace mpg = . if _n > 1
cert_truth_ctx "P1A-80 mpg in 1 only"
_p1a80 "lfit mpg weight" "" "" "`nreg'" "insufficient observations"
_p1a80 "kdensity mpg"    "" "" "insufficient observations"
// by(): twoway draws the panels, rc 0, and so does dash.
_p1a80d "lfit mpg weight" "" "by(foreign)"
quietly replace mpg = .
cert_truth_ctx "P1A-80 mpg missing"
_p1a80 "lpoly mpg weight" "" "" "no observations"
foreach p in "fpfit mpg weight" "mband mpg weight" "histogram mpg" "lfit mpg weight" {
    _p1a80d "`p'" ""
}
// ---- no observations at all
sysuse auto, clear
quietly drop in 1/l
cert_truth_ctx "P1A-80 no observations"
_p1a80 "histogram mpg"      "" ""       "`oor'"
_p1a80 "histogram mpg"      "" "bin(5)" "`oor'"
_p1a80 "histogram mpg"      "if price < 0" "discrete" "`oor'"
_p1a80 "lpoly mpg weight"   "" ""       "no observations"
_p1a80 "fpfitci mpg weight" "" ""       "`nfit'" "`oor'"
_p1a80 "mband mpg weight"   "" ""       "`bnd'"
foreach p in "lfit mpg weight" "qfit mpg weight" "lowess mpg weight" "kdensity mpg" {
    _p1a80d "`p'" ""
}
_p1a80d "mspline mpg weight" "" "bands(5)"
assert "${dash_graph_registry}" == ""
// ---- the note twoway gives where it draws, from the saved page
local h80 "`c(tmpdir)'dash_p1a80.html"
_p1a_logrun `"dash lfit mpg weight, saving("`h80'", replace)"'
assert r(rc) == 0
// Saved first: cert_file_has is rclass and replaces r(log).
local lg80 "`r(log)'"
cert_file_has "`lg80'", needle("`nreg'")
assert r(found) == 1
cert_file_has "`lg80'", needle("drew nothing")
assert r(found) == 0
capture erase "`h80'"
// Adversarial (rule 18).  The count runs the user's qualifier once, in
// Stata, as -syntax- read it: a qualifier that would write a file when
// expanded again is evaluated as text, and nothing is written.
sysuse auto, clear
local f80 "`c(tmpdir)'dash_p1a80_inj.txt"
capture erase "`f80'"
capture noisily dash lpoly mpg weight if make == `"\`=filewrite("`f80'","x")'"', name(p1a80)
assert _rc == 2000
capture confirm file "`f80'"
assert _rc != 0
// Resource exhaustion: 1,000,000 observations are counted in well under
// the time a render takes.
preserve
quietly {
    clear
    set obs 1000000
    generate y = runiform()
    generate x = runiform()
}
timer clear 80
timer on 80
_p1a_logrun "dash lpoly y x if x > 2, name(p1a80)"
timer off 80
assert r(rc) == 2000
quietly timer list 80
assert r(t80) < 10
restore
assert "${dash_graph_registry}" == ""
display "P1A-80 PASS: a statistical plot whose sample twoway cannot draw is refused at registration, in twoway's words and with its code"

// ================================================================
// P1A-82 -- a two-variable type given one variable is refused in
//           twoway's words (BUGS.md, S3)
// ================================================================
// Measured 24sep2026 with the console binary: every type that takes a y
// and an x -- scatter line connected area bar spike dropline dot and the
// fits and smoothers -- given one variable is "too few variables
// specified", r(102), in the one-line form, a plot group and after ||.
// dash gave twoway's code in its own words, "dash: scatter requires a y
// and an x variable (got: mpg)".  The words are checked in both logs, run
// by run (_p1a_vs_tw).
sysuse auto, clear
dash clear
cert_truth_ctx "P1A-82"
local few "too few variables specified"
foreach t in scatter line connected area bar spike dropline dot lfit qfit ///
    lfitci qfitci fpfit fpfitci lowess lpoly lpolyci mspline mband {
    _p1a_vs_tw "P1A-82 `t'" "twoway `t' mpg" "dash `t' mpg, name(p1a82)" "`few'"
    cert_file_has "`c(tmpdir)'dash_p1a_run.log", needle("requires a y and an x")
    assert r(found) == 0
    _p1a_vs_tw "P1A-82 (`t')" "twoway (scatter mpg weight) (`t' price if foreign)" "dash (scatter mpg weight) (`t' price if foreign), name(p1a82)" "`few'"
    _p1a_vs_tw "P1A-82 || `t'" "twoway scatter mpg weight || `t' price" "dash scatter mpg weight || `t' price, name(p1a82)" "`few'"
}
// The one-variable types still register.
foreach t in histogram kdensity {
    _p1a_vs_tw "P1A-82 `t'" "twoway `t' mpg" "dash `t' mpg, name(p1a82)"
    dash clear
}
// Adversarial: a variable name that is SMCL is not echoed at all now --
// twoway's words name no variable.
generate byte bf82 = 1
_p1a_logrun "dash scatter bf82, name(p1a82)"
assert r(rc) == 102
cert_file_has "`r(log)'", needle("bf82")
assert r(found) == 0
drop bf82
assert "${dash_graph_registry}" == ""
display "P1A-82 PASS: a two-variable type given one variable is refused, r(102), in twoway's words, in every form"

// ================================================================
// P1A-83 -- a by() graph answers an empty panel as twoway does
//           (BUGS.md, S3)
// ================================================================
// Measured 24sep2026 with the console binary (bygraph_g.class: a panel
// is a by() group some row of the graph selects; none is "nothing to
// graph", r(198)):
//   no row the plots' if and in and the graph's qualifier select, in any
//   group -- or the by() variable missing everywhere, without missing --
//   every type: "nothing to graph", r(198).  Missing values of the
//   plotted variables do not empty a panel.
//   a panel the plot's if and in select no row of, the panel there for
//   another plot: fpfit and fpfitci "(note:  fracpoly could not fit
//   model)" and "observation numbers out of range", r(198); mspline and
//   mband with no bands() "bands must be between 1 and 200", r(198); every
//   other type rc 0 (lfit, qfit, lfitci and qfitci with regress's note,
//   the renderer's: test_layer_reports.py).
//   a panel of one observation, or one its missing values empty: rc 0
//   for every type.
// dash drew each, rc 0, with no panel at all where twoway refuses.
sysuse auto, clear
dash clear
generate byte one83 = make == "Audi 5000"
cert_truth_ctx "P1A-83 one83"
local T83 "lfit qfit lfitci qfitci fpfit fpfitci lowess lpoly lpolyci mspline mband"
local ntg "nothing to graph"
// ---- no panel at all
foreach t of local T83 {
    _p1a_vs_tw "P1A-83 `t' none" "twoway `t' mpg weight if mpg > 1000, by(foreign)" "dash `t' mpg weight if mpg > 1000, by(foreign) name(p1a83)" "`ntg'"
}
foreach p in "kdensity mpg" "histogram mpg" {
    _p1a_vs_tw "P1A-83 `p' none" "twoway `p' in 1/5 if price > 100000, by(foreign)" "dash `p' in 1/5 if price > 100000, by(foreign) name(p1a83)" "`ntg'"
}
_p1a_vs_tw "P1A-83 graph qualifier" "twoway (scatter mpg weight) (lfit mpg weight) if mpg > 1000, by(foreign)" "dash (scatter mpg weight) (lfit mpg weight) if mpg > 1000, by(foreign) name(p1a83)" "`ntg'"
_p1a_vs_tw "P1A-83 each plot's if" "twoway (scatter mpg weight if mpg > 1000) (lpoly mpg weight if mpg > 1000), by(foreign)" "dash (scatter mpg weight if mpg > 1000) (lpoly mpg weight if mpg > 1000), by(foreign) name(p1a83)" "`ntg'"
// Several plots and no graph qualifier: every group is a panel, and one
// an empty lfit draws with its note.
_p1a_vs_tw "P1A-83 || lfit draws" "twoway scatter mpg weight if mpg > 1000 || lfit mpg weight if mpg > 1000, by(foreign)" "dash scatter mpg weight if mpg > 1000 || lfit mpg weight if mpg > 1000, by(foreign) name(p1a83)"
dash clear
_p1a_vs_tw "P1A-83 one plot draws" "twoway (scatter mpg weight) (lfit mpg weight if mpg > 1000), by(foreign)" "dash (scatter mpg weight) (lfit mpg weight if mpg > 1000), by(foreign) name(p1a83)"
dash clear
// Every panel left out: lpoly on none, lfit and kdensity on one.
_p1a_vs_tw "P1A-83 lfit every panel" "twoway lfit mpg weight if _n == 1 | _n == 60, by(foreign)" "dash lfit mpg weight if _n == 1 | _n == 60, by(foreign) name(p1a83)" "insufficient observations" "`ntg'"
_p1a_vs_tw "P1A-83 kdensity every panel" "twoway kdensity mpg if _n == 1 | _n == 60, by(foreign)" "dash kdensity mpg if _n == 1 | _n == 60, by(foreign) name(p1a83)" "`ntg'"
_p1a_vs_tw "P1A-83 lpolyci every panel" "twoway (scatter mpg weight) (lpolyci mpg weight if _n == 1 | _n == 60), by(foreign)" "dash (scatter mpg weight) (lpolyci mpg weight if _n == 1 | _n == 60), by(foreign) name(p1a83)" "`ntg'"
// The first plot that cannot draw in a panel decides it: lpoly leaves the
// panel out before fpfit can stop the command, and not after.
_p1a_vs_tw "P1A-83 lpoly first" "twoway (lpoly mpg weight if foreign==0) (fpfit mpg weight if foreign==0), by(foreign)" "dash (lpoly mpg weight if foreign==0) (fpfit mpg weight if foreign==0), by(foreign) name(p1a83)"
dash clear
_p1a_vs_tw "P1A-83 fpfit first" "twoway (fpfit mpg weight if foreign==0) (lpoly mpg weight if foreign==0), by(foreign)" "dash (fpfit mpg weight if foreign==0) (lpoly mpg weight if foreign==0), by(foreign) name(p1a83)" "`nfit'" "`oor'"
// A weight not above zero leaves the row out of the sample.
generate w83 = cond(foreign, 0, 1)
quietly replace w83 = 1 if one83
cert_truth_ctx "P1A-83 w83"
_p1a_vs_tw "P1A-83 weighted" "twoway (scatter mpg weight) (lpoly mpg weight [aw=w83]), by(foreign)" "dash (scatter mpg weight) (lpoly mpg weight [aw=w83]), by(foreign) name(p1a83)"
dash clear
drop w83
generate byte bm83 = .
cert_truth_ctx "P1A-83 bm83"
_p1a_vs_tw "P1A-83 by() missing" "twoway lfit mpg weight, by(bm83)" "dash lfit mpg weight, by(bm83) name(p1a83)" "`ntg'"
_p1a_vs_tw "P1A-83 by(, missing)" "twoway lfit mpg weight, by(bm83, missing)" "dash lfit mpg weight, by(bm83, missing) name(p1a83)"
dash clear
_p1a_vs_tw "P1A-83 by(, miss)" "twoway lfit mpg weight, by(bm83, miss)" "dash lfit mpg weight, by(bm83, miss) name(p1a83)"
dash clear
// ---- a panel the plot selects no row of
foreach t of local T83 {
    local n1 ""
    local n2 ""
    if inlist("`t'", "fpfit", "fpfitci") {
        local n1 "`nfit'"
        local n2 "`oor'"
    }
    if inlist("`t'", "mspline", "mband") local n1 "`bnd'"
    _p1a_vs_tw "P1A-83 `t' panel" "twoway (scatter mpg weight) (`t' mpg weight if foreign==0), by(foreign)" "dash (scatter mpg weight) (`t' mpg weight if foreign==0), by(foreign) name(p1a83)" "`n1'" "`n2'"
    capture dash clear
}
foreach p in "kdensity mpg" "histogram mpg" {
    _p1a_vs_tw "P1A-83 `p' panel" "twoway (scatter mpg weight) (`p' if foreign==0), by(foreign)" "dash (scatter mpg weight) (`p' if foreign==0), by(foreign) name(p1a83)"
    dash clear
}
_p1a_vs_tw "P1A-83 in" "twoway (scatter mpg weight) (fpfit mpg weight in 1/10), by(foreign)" "dash (scatter mpg weight) (fpfit mpg weight in 1/10), by(foreign) name(p1a83)" "`nfit'" "`oor'"
_p1a_vs_tw "P1A-83 || panel" "twoway scatter mpg weight || mband mpg weight if !foreign, by(foreign)" "dash scatter mpg weight || mband mpg weight if !foreign, by(foreign) name(p1a83)" "`bnd'"
foreach t in mspline mband {
    _p1a_vs_tw "P1A-83 `t' bands()" "twoway (scatter mpg weight) (`t' mpg weight if !foreign, bands(5)), by(foreign)" "dash (scatter mpg weight) (`t' mpg weight if !foreign, bands(5)), by(foreign) name(p1a83)"
    dash clear
}
// A graph qualifier that removes a group removes its panel: no refusal.
_p1a_vs_tw "P1A-83 no panel, no refusal" "twoway fpfit mpg weight if foreign==0, by(foreign)" "dash fpfit mpg weight if foreign==0, by(foreign) name(p1a83)"
dash clear
// ---- a panel of one observation, and one missing values empty
foreach t of local T83 {
    _p1a_vs_tw "P1A-83 `t' one" "twoway (scatter mpg weight) (`t' mpg weight if foreign==0 | one83), by(foreign)" "dash (scatter mpg weight) (`t' mpg weight if foreign==0 | one83), by(foreign) name(p1a83)"
    dash clear
}
preserve
quietly replace mpg = . if foreign
cert_truth_ctx "P1A-83 mpg missing if foreign"
foreach t in fpfit mspline mband lpoly {
    _p1a_vs_tw "P1A-83 `t' missing" "twoway (scatter weight length) (`t' mpg weight), by(foreign)" "dash (scatter weight length) (`t' mpg weight), by(foreign) name(p1a83)"
    dash clear
}
restore
// ---- the order of the data is kept
sort make
generate long o83 = _n
local sb83 : sortedby
capture noisily dash (scatter mpg weight) (fpfit mpg weight if foreign==0), by(foreign) name(p1a83)
assert _rc == 198
assert o83 == _n
assert "`: sortedby'" == "`sb83'"
capture noisily dash (scatter mpg weight) (lpoly mpg weight if foreign==0), by(foreign) name(p1a83)
assert _rc == 0
assert o83 == _n
dash clear
drop o83
// ---- the renderer's answer, from the saved page
local h83 "`c(tmpdir)'dash_p1a83.html"
_p1a_logrun `"dash (scatter mpg weight) (lfit mpg weight if foreign==0) (lowess mpg weight if foreign==0), by(foreign) saving("`h83'", replace)"'
assert r(rc) == 0
local lg83 "`r(log)'"
cert_file_has "`lg83'", needle("`nreg'")
assert r(found) == 1
cert_file_has "`lg83'", needle("drew nothing")
assert r(found) == 0
capture erase "`h83'"
// ---- adversarial (rule 18): each qualifier is evaluated as -syntax-
// read it, once, by value -- a qualifier that would write a file when
// expanded again writes nothing -- and a million observations in a
// thousand groups are counted in well under the time a render takes.
local f83 "`c(tmpdir)'dash_p1a83_inj.txt"
capture erase "`f83'"
capture noisily dash (scatter mpg weight) (fpfit mpg weight if make == `"\`=filewrite("`f83'","x")'"'), by(foreign) name(p1a83)
assert _rc == 198
capture confirm file "`f83'"
assert _rc != 0
capture noisily dash lfit mpg weight if make == `"\`=filewrite("`f83'","x")'"', by(foreign) name(p1a83)
assert _rc == 198
capture confirm file "`f83'"
assert _rc != 0
preserve
quietly {
    clear
    set obs 1000000
    generate long g = mod(_n, 1000)
    generate y = runiform()
    generate x = runiform()
}
timer clear 83
timer on 83
_p1a_logrun "dash (scatter y x) (mband y x if g > 0), by(g) name(p1a83)"
timer off 83
assert r(rc) == 198
quietly timer list 83
assert r(t83) < 10
restore
assert "${dash_graph_registry}" == ""
display "P1A-83 PASS: a by() graph with no panel, or a panel twoway refuses, is refused in twoway's words and with its code; every other panel is drawn"

// ================================================================
// P1A-84 -- a by() given in another || segment or plot group than the
//           plot, and by()'s Total panel, answered as twoway answers
//           them (BUGS.md, S3)
// ================================================================
// Measured 24sep2026 with the console binary (graph.ado reads the graph's
// by() from every segment before any plot is drawn; bygraph_g.class adds
// the Total panel after the groups and draws it as it draws them):
//   by() in a later || segment, a later plot group, a middle segment or
//   an earlier one: each plot is answered panel by panel (P1A-83) --
//   `lfit mpg weight if _n==1 || scatter mpg weight, by(foreign)' draws,
//   rc 0; `lpoly ... if _n==1 || scatter ..., by(foreign)' "nothing to
//   graph", r(198); histogram on no observations "nothing to graph".  dash
//   read the plots before the by() was known, and gave the one-graph
//   refusals: r(2001) "insufficient observations", r(2000) "no
//   observations", "observation numbers out of range".
//   by(, total): the Total panel holds the rows of every group (a row
//   whose by() value is missing only under missing), and is answered as
//   the groups are -- lfit and lfitci with one observation leave it out after
//   regress's note and "insufficient observations", lpoly and lpolyci
//   with one or none and kdensity with one leave it out in silence; it
//   counts toward "nothing to graph".  total is TOTal (tot, tota, total).
//   dash left the Total panel out of the count: `lfit mpg weight if _n==1
//   | _n==60, by(foreign, total)' was "nothing to graph", r(198), where
//   twoway draws the Total panel, rc 0.
sysuse auto, clear
dash clear
cert_truth_ctx "P1A-84 auto"
local ntg "nothing to graph"
local ins "insufficient observations"
local nfit "(note:  fracpoly could not fit model)"
local oor  "observation numbers out of range"
local bnd  "bands must be between 1 and 200"
// ---- (a) by() in another segment than the plot
_p1a_vs_tw "P1A-84 || lpoly none" "twoway lpoly mpg weight if mpg > 1000 || scatter mpg weight, by(foreign)" "dash lpoly mpg weight if mpg > 1000 || scatter mpg weight, by(foreign) name(p1a84)" "`ntg'"
_p1a_vs_tw "P1A-84 || lpoly one" "twoway lpoly mpg weight if _n==1 || scatter mpg weight, by(foreign)" "dash lpoly mpg weight if _n==1 || scatter mpg weight, by(foreign) name(p1a84)" "`ntg'"
_p1a_vs_tw "P1A-84 || lpolyci none" "twoway lpolyci mpg weight if mpg > 1000 || scatter mpg weight, by(foreign)" "dash lpolyci mpg weight if mpg > 1000 || scatter mpg weight, by(foreign) name(p1a84)" "`ntg'"
foreach t in lfit lfitci {
    _p1a_vs_tw "P1A-84 || `t' one" "twoway `t' mpg weight if _n==1 || scatter mpg weight, by(foreign)" "dash `t' mpg weight if _n==1 || scatter mpg weight, by(foreign) name(p1a84)"
    dash clear
}
_p1a_vs_tw "P1A-84 || kdensity one" "twoway kdensity mpg if _n==1 || scatter mpg weight, by(foreign)" "dash kdensity mpg if _n==1 || scatter mpg weight, by(foreign) name(p1a84)"
dash clear
_p1a_vs_tw "P1A-84 || fpfit" "twoway fpfit mpg weight if mpg > 1000 || scatter mpg weight, by(foreign)" "dash fpfit mpg weight if mpg > 1000 || scatter mpg weight, by(foreign) name(p1a84)" "`nfit'" "`oor'"
_p1a_vs_tw "P1A-84 || mband" "twoway mband mpg weight if mpg > 1000 || scatter mpg weight, by(foreign)" "dash mband mpg weight if mpg > 1000 || scatter mpg weight, by(foreign) name(p1a84)" "`bnd'"
_p1a_vs_tw "P1A-84 group lfit" "twoway (lfit mpg weight if _n==1) (scatter mpg weight, by(foreign))," "dash (lfit mpg weight if _n==1) (scatter mpg weight, by(foreign)), name(p1a84)"
dash clear
_p1a_vs_tw "P1A-84 group kdensity" "twoway (kdensity mpg if _n==1) (scatter mpg weight, by(foreign))," "dash (kdensity mpg if _n==1) (scatter mpg weight, by(foreign)), name(p1a84)"
dash clear
_p1a_vs_tw "P1A-84 group lpoly" "twoway (lpoly mpg weight if mpg > 1000) (scatter mpg weight, by(foreign))," "dash (lpoly mpg weight if mpg > 1000) (scatter mpg weight, by(foreign)), name(p1a84)" "`ntg'"
_p1a_vs_tw "P1A-84 middle" "twoway lpoly mpg weight if _n==1 || scatter mpg weight, by(foreign) || line mpg weight," "dash lpoly mpg weight if _n==1 || scatter mpg weight, by(foreign) || line mpg weight, name(p1a84)" "`ntg'"
_p1a_vs_tw "P1A-84 earlier kdensity" "twoway scatter mpg weight, by(foreign) || kdensity mpg if _n==1," "dash scatter mpg weight, by(foreign) || kdensity mpg if _n==1, name(p1a84)"
dash clear
_p1a_vs_tw "P1A-84 earlier lfit" "twoway scatter mpg weight, by(foreign) || lfit mpg weight if _n==1," "dash scatter mpg weight, by(foreign) || lfit mpg weight if _n==1, name(p1a84)"
dash clear
_p1a_vs_tw "P1A-84 earlier lpoly" "twoway scatter mpg weight, by(foreign) || lpoly mpg weight if mpg > 1000," "dash scatter mpg weight, by(foreign) || lpoly mpg weight if mpg > 1000, name(p1a84)" "`ntg'"
// Adversarial: by( written in a title, a quoted if or a note is no by().
_p1a_vs_tw "P1A-84 by in a title" "twoway lfit mpg weight if _n==1 || scatter mpg weight, title(by(foreign))" "dash lfit mpg weight if _n==1 || scatter mpg weight, title(by(foreign)) name(p1a84)" "`ins'"
_p1a_vs_tw "P1A-84 by in a string" `"twoway lpoly mpg weight if make == ", by(foreign)" || scatter mpg weight,"' `"dash lpoly mpg weight if make == ", by(foreign)" || scatter mpg weight, name(p1a84)"' "no observations"
_p1a_vs_tw "P1A-84 by in a note" `"twoway (kdensity mpg if _n==1) (scatter mpg weight, note("x, by(foreign)")),"' `"dash (kdensity mpg if _n==1) (scatter mpg weight, note("x, by(foreign)")), name(p1a84)"' "`ins'"
preserve
quietly {
    clear
    set obs 0
    generate foreign = .
    generate mpg = .
}
cert_truth_ctx "P1A-84 no observations"
_p1a_vs_tw "P1A-84 || histogram empty" "twoway histogram mpg || scatter mpg foreign, by(foreign)" "dash histogram mpg || scatter mpg foreign, by(foreign) name(p1a84)" "`ntg'"
restore
cert_truth_ctx "P1A-84 auto, total"
assert "${dash_graph_registry}" == ""
// ---- (b) by(, total)
foreach t in lfit lfitci lpoly lpolyci {
    _p1a_vs_tw "P1A-84 `t' total drawn" "twoway `t' mpg weight if _n==1 | _n==60, by(foreign, total)" "dash `t' mpg weight if _n==1 | _n==60, by(foreign, total) name(p1a84)"
    dash clear
    local n1 ""
    if inlist("`t'", "lfit", "lfitci") local n1 "`ins'"
    _p1a_vs_tw "P1A-84 `t' total out" "twoway `t' mpg weight if _n==1, by(foreign, total)" "dash `t' mpg weight if _n==1, by(foreign, total) name(p1a84)" "`ntg'" "`n1'"
}
_p1a_vs_tw "P1A-84 kdensity total drawn" "twoway kdensity mpg if _n==1 | _n==60, by(foreign, total)" "dash kdensity mpg if _n==1 | _n==60, by(foreign, total) name(p1a84)"
dash clear
_p1a_vs_tw "P1A-84 kdensity total out" "twoway kdensity mpg if _n==1, by(foreign, total)" "dash kdensity mpg if _n==1, by(foreign, total) name(p1a84)" "`ntg'"
_p1a_vs_tw "P1A-84 total tot" "twoway lfit mpg weight if _n==1 | _n==60, by(foreign, tot)" "dash lfit mpg weight if _n==1 | _n==60, by(foreign, tot) name(p1a84)"
dash clear
_p1a_vs_tw "P1A-84 total in a title" `"twoway lfit mpg weight if _n==1 | _n==60, by(foreign, title("total"))"' `"dash lfit mpg weight if _n==1 | _n==60, by(foreign, title("total")) name(p1a84)"' "`ntg'"
_p1a_vs_tw "P1A-84 total ||" "twoway lfit mpg weight if _n==1 || scatter mpg weight, by(foreign, total)" "dash lfit mpg weight if _n==1 || scatter mpg weight, by(foreign, total) name(p1a84)"
dash clear
_p1a_vs_tw "P1A-84 total lpoly first" "twoway lpoly mpg weight if _n==1 || lpoly mpg weight, by(foreign, total)" "dash lpoly mpg weight if _n==1 || lpoly mpg weight, by(foreign, total) name(p1a84)" "`ntg'"
_p1a_vs_tw "P1A-84 total group" "twoway (scatter mpg weight) (lpoly mpg weight if _n==1), by(foreign, total)" "dash (scatter mpg weight) (lpoly mpg weight if _n==1), by(foreign, total) name(p1a84)" "`ntg'"
_p1a_vs_tw "P1A-84 total fpfit" "twoway (scatter mpg weight) (fpfit mpg weight if foreign==0), by(foreign, total)" "dash (scatter mpg weight) (fpfit mpg weight if foreign==0), by(foreign, total) name(p1a84)" "`nfit'" "`oor'"
_p1a_vs_tw "P1A-84 total none" "twoway lfit mpg weight if mpg > 1000, by(foreign, total)" "dash lfit mpg weight if mpg > 1000, by(foreign, total) name(p1a84)" "`ntg'"
// The Total panel holds the rows of every group: a row whose by() value is
// missing only under missing.  (The samples are marked by variables, not
// _n: twoway reads a plot's if after sorting on the by() variables.)
generate g84 = foreign
quietly replace g84 = . in 1/5
generate byte m84 = _n <= 5
generate byte one84 = _n == 60
cert_truth_ctx "P1A-84 g84"
_p1a_vs_tw "P1A-84 total missing lfit" "twoway lfit mpg weight if m84 | one84, by(g84, total)" "dash lfit mpg weight if m84 | one84, by(g84, total) name(p1a84)" "`ins'" "`ntg'"
_p1a_vs_tw "P1A-84 total missing lpoly" "twoway (scatter mpg weight) (lpoly mpg weight if m84 | one84), by(g84, total)" "dash (scatter mpg weight) (lpoly mpg weight if m84 | one84), by(g84, total) name(p1a84)" "`ntg'"
_p1a_vs_tw "P1A-84 total missing lpoly missing" "twoway (scatter mpg weight) (lpoly mpg weight if m84 | one84), by(g84, total missing)" "dash (scatter mpg weight) (lpoly mpg weight if m84 | one84), by(g84, total missing) name(p1a84)"
dash clear
_p1a_vs_tw "P1A-84 total no group" "twoway scatter mpg weight if m84, by(g84, total)" "dash scatter mpg weight if m84, by(g84, total) name(p1a84)" "`ntg'"
drop g84 m84 one84
// Adversarial (rule 18): a qualifier that would write a file when expanded
// again writes nothing under total, and a million observations in a
// thousand groups with a Total panel are counted in well under 10 s.
local f84 "`c(tmpdir)'dash_p1a84_inj.txt"
capture erase "`f84'"
capture noisily dash lfit mpg weight if make == `"\`=filewrite("`f84'","x")'"', by(foreign, total) name(p1a84)
assert _rc == 198
capture confirm file "`f84'"
assert _rc != 0
capture noisily dash lfit mpg weight if make == `"\`=filewrite("`f84'","x")'"' || scatter mpg weight, by(foreign) name(p1a84)
capture confirm file "`f84'"
assert _rc != 0
dash clear
preserve
quietly {
    clear
    set obs 1000000
    generate long g = mod(_n, 1000)
    generate y = runiform()
    generate x = runiform()
}
timer clear 84
timer on 84
_p1a_logrun "dash (scatter y x) (lpoly y x if _n <= 1000), by(g, total) name(p1a84)"
timer off 84
assert r(rc) == 0
quietly timer list 84
assert r(t84) < 10
restore
dash clear
assert "${dash_graph_registry}" == ""
display "P1A-84 PASS: a by() in any segment, and by()'s Total panel, are answered panel by panel as twoway answers them"

// ================================================================
// U08-5 (WP-31 A2) -- the thirteen shorter plot-type spellings dash took
// are refused as twoway refuses them
// ================================================================
// Measured 13oct2026 (test/fixtures/bare_prefix_truth.json extras.*):
// twoway ar, ba, sp, lfi, qfi, low, lpo, fp, kde, dr, tsl, tsrl and msp
// are each "<word> is not a twoway plot type", r(198); twoway takes only
// its own minimums -- sc li con hist rsc rl rcon fun -- and mbands and fn.
// dash took all thirteen as the type they began.  dash prints twoway's
// line, then its Supported: list, and registers nothing.
sysuse auto, clear
dash clear
foreach w in ar ba sp lfi qfi low lpo fp kde dr tsl tsrl msp {
    _p1a_logrun "dash `w' mpg weight, name(u085)"
    local rc85 = r(rc)
    local lg85 "`r(log)'"
    if `rc85' != 198 {
        display as error "U08-5 FAIL: dash `w' mpg weight gave rc `rc85', twoway r(198)"
        exit 9
    }
    cert_file_has "`lg85'", needle("`w' is not a twoway plot type")
    if !r(found) {
        display as error "U08-5 FAIL: dash `w' did not say twoway's line"
        exit 9
    }
    cert_file_has "`lg85'", needle("Supported:")
    assert r(found) == 1
}
assert "${dash_graph_registry}" == ""
display "U08-5 PASS: ar ba sp lfi qfi low lpo fp kde dr tsl tsrl msp are refused, r(198), in twoway's words"

// ================================================================
// U08-6 (WP-31 A2) -- the full names and twoway's spellings still register
// ================================================================
dash clear
foreach c in "lfit mpg weight|lfit" "area mpg weight|area" ///
    "kdensity mpg|kdensity" "sc mpg weight|scatter" "rl turn mpg weight|rline" ///
    "hist mpg|histogram" "mbands mpg weight|mband" "fn y = x|function" {
    gettoken cmd86 typ86 : c, parse("|")
    local typ86 = substr("`typ86'", 2, .)
    capture noisily dash `cmd86', name(u086, replace)
    assert _rc == 0
    assert strpos(`"${dash_json_u086}"', `""type":"`typ86'""') > 0
}
dash clear
display "U08-6 PASS: lfit, area, kdensity and twoway's spellings register as their types"

// ================================================================
// TW-01 -- dash is twoway: `dash twoway ...' is `twoway twoway ...'
// ================================================================
// dash replaces twoway, so a twoway command word after dash is what it
// is after twoway: not a plot type.  Measured 14oct2026: twoway twoway,
// tw, two, twow, twowa, graph, gr, gra, grap, Twoway, TW and Graph, each
// before a plot, alone, or before options, are "<word> is not a twoway
// plot type", r(198).  dash read twoway, tw, two and graph twoway off as
// a prefix (WP-30 P1.27) and drew the rest.
sysuse auto, clear
dash clear
foreach w in twoway tw two twow twowa graph gr gra grap Twoway TW Graph {
    foreach tail in "scatter mpg weight" "" ", title(T)" "twoway scatter mpg weight" {
        capture twoway `w' `tail'
        local trc = _rc
        _p1a_logrun "dash `w' `tail'"
        local drc = r(rc)
        local lgd "`r(log)'"
        if `trc' != 198 | `drc' != 198 {
            display as error "TW-01 FAIL: `w' `tail': twoway rc `trc', dash rc `drc'"
            exit 9
        }
        cert_file_has "`lgd'", needle("`w' is not a twoway plot type")
        if !r(found) {
            display as error "TW-01 FAIL: dash `w' `tail' did not say twoway's line"
            exit 9
        }
    }
}
assert "${dash_graph_registry}" == ""
display "TW-01 PASS: dash twoway, tw, two, twow, twowa, graph, gr, gra, grap and their capitalised forms are refused as twoway refuses them after twoway, r(198)"

// ================================================================
// TW-02 -- dash alone is twoway alone: an empty graph
// ================================================================
// twoway with no plot draws an empty graph, rc 0, and takes graph options
// and a qualifier (test/fixtures/bare_prefix_truth.json bare.*; measured
// again here).  dash replaces twoway, so `dash', `dash, title(T)',
// `dash if foreign==1' and `dash ||' register a graph with no plot, as the
// maintainer decided 14oct2026; dash refused them, r(198).
sysuse auto, clear
dash clear
foreach f in "" ", title(T)" "if foreign==1" "||" {
    capture twoway `f'
    local trc = _rc
    capture graph drop _all
    // Without name() dash draws the page at once, as twoway draws the graph.
    _p1a_logrun "dash `f'"
    local drc = r(rc)
    local lg "`r(log)'"
    if `trc' != 0 | `drc' != 0 {
        display as error "TW-02 FAIL: [`f'] twoway rc `trc', dash rc `drc'"
        exit 9
    }
    foreach bad in "MISSING_RENDERERS" "empty plot specification" "no plot specifications" {
        cert_file_has "`lg'", needle("`bad'")
        if r(found) {
            display as error "TW-02 FAIL: [`f'] dash said `bad'"
            exit 9
        }
    }
    // With name() the empty graph registers with no plot.
    dash clear
    local nm = cond(`"`f'"' == "" | substr(`"`f'"', 1, 1) != ",", `"`f', name(tw02)"', `"`f' name(tw02)"')
    capture noisily dash `nm'
    assert _rc == 0
    if strpos(`"${dash_json_tw02}"', `""plots":[]"') == 0 {
        display as error "TW-02 FAIL: [`nm'] the graph holds a plot or did not register"
        exit 9
    }
    dash clear
}
dash clear
quietly dash, title(T) name(tw02t)
assert strpos(`"${dash_json_tw02t}"', `""title":"T""') > 0
dash clear
mata:
_tw2q = char(34)
st_local("tw2a", strofreal(_dash_spec_has_plots("{" + _tw2q + "plots" + _tw2q + ":[]," + _tw2q + "graph_options" + _tw2q + ":{}}")))
st_local("tw2b", strofreal(_dash_spec_has_plots("{" + _tw2q + "plots" + _tw2q + ":[ {" + _tw2q + "type" + _tw2q + ":" + _tw2q + "scatter" + _tw2q + "}]}")))
st_local("tw2c", strofreal(_dash_spec_has_plots("{}")))
end
assert `tw2a' == 0 & `tw2b' == 1 & `tw2c' == 0
display "TW-02 PASS: dash, dash, title(T), dash if foreign==1 and dash || draw twoway's empty graph"

// ================================================================
// P1A-85 -- a || segment with no plot: `|| , opts' and `|| if exp'
//           are the graph's, as twoway reads them
// ================================================================
// twoway splits the command at every top-level `||'; each piece is a
// bare plot, a run of parenthesised plots, or a piece with no plot, which
// holds only the graph's own [if] [in] [, options].  Measured 09oct2026
// with the console binary on auto (and tsset _n for tsline), rc 0 unless
// given:
//     a || b || , title("T")             title T, 2 plots
//     (a) || b || , title("T")           the same; (a) || (b) || , too
//     a || b || ,      a || b ||         2 plots, no title
//     a || , title("T") || b,            title T, 2 plots
//     a || || b                          2 plots
//     (a) (b), title("T") || c           title T, 3 plots
//     a || (b)                           2 plots
//     a || b || if foreign==1, title("T") both plots over the 22 foreign
//     a || b || , title("T") || , title("U")    title U
//     a, title("A") || b || , title("T")        title T
//     || , msymbol(Oh)    r(198) "option msymbol() not allowed"
//     || , (c)            r(198) "option ( not allowed"
//     || [fw=rep78]       r(198) "[ is not a twoway plot type"
//     || if a || if b     r(198) "multiple global if's not allowed"
//     (a) | (b)           r(198) "| is not a twoway plot type"
//     ((a) (b)), (a || b), (a) ((b)): r(198); (a (b)): r(111)
// dash read a piece with no plot as a plot and refused it -- "unrecognised
// plot type ','" -- for every option, and refused a bare plot after a
// parenthesised one, `(a) || line b', as text between plot groups; WP-30
// S51 wrote c45 as `tsline y || line y2 t, tlabel(...)' to get round it.
// It accepted `(a) | (b)', which twoway refuses.
dash clear
cert_truth_ctx "P1A-85 auto"
local _sm "scatter mpg weight"
local _lp "line price weight"
local _sp "scatter price weight"
foreach f in `"`_sm' || `_lp' || , title("T")"' ///
    `"(`_sm') || `_lp' || , title("T")"' ///
    `"(`_sm') || (`_lp') || , title("T")"' ///
    `"(`_sm') (`_lp') || , title("T")"' ///
    `"`_sm' || `_lp', title("T")"' ///
    `"`_sm' || , title("T") || `_lp',"' ///
    `"`_sm' || || `_lp',"' ///
    `"(`_sm') (`_lp'), title("T") || `_sp',"' ///
    `"`_sm' || (`_lp'),"' ///
    `"`_sm' || (`_lp') (`_sp'), title("T")"' ///
    `"`_sm' || `_lp' || if foreign==1, title("T")"' ///
    `"`_sm' || `_lp' || in 1/10, title("T")"' ///
    `"`_sm' || if foreign==1 || `_lp',"' ///
    `"`_sm' || `_lp' || if foreign==1 || in 1/40,"' ///
    `"`_sm' || `_lp' || , title("T") || , title("U")"' ///
    `"`_sm', title("A") || `_lp' || , title("T")"' ///
    `"`_sm' || `_lp' || , legend(off) xlabel(2000 4000) ytitle("Y") note("n")"' {
    _p1a_vs_tw `"P1A-85 `f'"' `"twoway `f'"' `"dash `f' name(p1a85)"'
    dash clear
}
// The graph's options and qualifier land on the graph.
_p1a_logrun `"dash `_sm' || `_lp' || , title("T") name(p1a85)"'
assert r(rc) == 0
mata: st_local("_j", st_global("dash_json_p1a85"))
mata: assert(strpos(st_local("_j"), `""graph_options":{"title":"\"T\"""') > 0)
mata: assert(strpos(st_local("_j"), `""type":"line","yvar":"price""') > 0)
dash clear
_p1a_logrun `"dash (`_sm') || `_lp' || if foreign==1, title("T") name(p1a85)"'
assert r(rc) == 0
mata: st_local("_j", st_global("dash_json_p1a85"))
mata: assert(strpos(st_local("_j"), `""type":"scatter","yvar":"mpg""') > 0)
mata: assert(strpos(st_local("_j"), `""type":"line","yvar":"price""') > 0)
mata: assert(strpos(st_local("_j"), `"},"if_expr":"foreign==1""') > 0)
dash clear
_p1a_logrun `"dash `_sm', title("A") || `_lp' || , title("T") || , title("U") name(p1a85)"'
assert r(rc) == 0
mata: assert(strpos(st_global("dash_json_p1a85"), `""title":"\"U\"""') > 0)
dash clear
_p1a_logrun `"dash (`_sm') (`_lp'), title("T") || `_sp', name(p1a85)"'
assert r(rc) == 0
mata: assert(strpos(st_global("dash_json_p1a85"), `""type":"scatter","yvar":"price""') > 0)
mata: assert(strpos(st_global("dash_json_p1a85"), `""title":"\"T\"""') > 0)
dash clear
// The two helpers, by name: which piece is a bare plot, and what a piece
// that is not one gives the graph.
mata: assert(_dash_piece_is_bare("scatter mpg weight") == 1)
mata: assert(_dash_piece_is_bare("ifx mpg weight") == 1)
mata: assert(_dash_piece_is_bare("IF foreign==1") == 1)
mata: assert(_dash_piece_is_bare(", title(T)") == 0)
mata: assert(_dash_piece_is_bare("(scatter mpg weight)") == 0)
mata: assert(_dash_piece_is_bare("if foreign==1, title(T)") == 0)
mata: assert(_dash_piece_is_bare("if(foreign==1)") == 0)
mata: assert(_dash_piece_is_bare("in 1/10") == 0)
mata: assert(_dash_piece_is_bare("if") == 0)
mata:
_p85s = J(1, 0, ""); _p85o = ""; _p85q = ""
_dash_split_groups(`"(scatter mpg weight) (line price weight, title("a,b")) if inlist(rep78,3,4), title(T)"', _p85s, _p85o, _p85q)
assert(_p85s == ("scatter mpg weight", `"line price weight, title("a,b")"'))
assert(strtrim(_p85o) == "title(T)" & strtrim(_p85q) == "if inlist(rep78,3,4)")
_dash_split_groups("in 1/10, note(n)", _p85s, _p85o, _p85q)
assert(cols(_p85s) == 2 & strtrim(_p85o) == "title(T) note(n)")
assert(strtrim(_p85q) == "if inlist(rep78,3,4) in 1/10")
mata drop _p85s _p85o _p85q
end
// `|| ,' and `||' with nothing after them add nothing.
foreach f in "`_sm' || `_lp' || ," "`_sm' || `_lp' ||" "|| `_sm' || `_lp'" {
    mata: _dash_split_segs(st_local("f"))
    assert `_n_segs' == 2
    assert "`_seg_1'" == "`_sm'" & "`_seg_2'" == "`_lp'"
    assert `"`_graph_opts_raw'"' == "" & `"`_graph_qual_raw'"' == ""
}
_p1a_logrun `"dash `_sm', name(p1a85) || `_lp' || ,"'
assert r(rc) == 0
dash clear
_p1a_logrun `"dash `_sm', name(p1a85) || `_lp' ||"'
assert r(rc) == 0
dash clear
// The t-options after `|| ,' (WP-30 S51, c45).
preserve
quietly generate t85 = _n
quietly tsset t85
cert_truth_ctx "P1A-85 tsset t85"
_p1a_vs_tw "P1A-85 tlabel" `"twoway tsline mpg || line price t85 || , tlabel(10 20) title("T")"' `"dash tsline mpg || line price t85 || , tlabel(10 20) title("T") name(p1a85)"'
dash clear
restore
cert_truth_ctx "P1A-85 auto refused"
// What twoway refuses, with its rc: a plot option or a plot group after
// `|| ,', a weight or a stray word in a piece with no plot, two
// global ifs, a single `|', and a plot group nested in another.
_p1a_vs_tw "P1A-85 plot option" `"twoway `_sm' || `_lp' || , title("T") msymbol(Oh)"' `"dash `_sm' || `_lp' || , title("T") msymbol(Oh) name(p1a85)"' "option msymbol() not allowed"
_p1a_vs_tw "P1A-85 group after comma" `"twoway `_sm' || `_lp' || , (`_sp')"' `"dash `_sm' || `_lp' || , (`_sp') name(p1a85)"'
_p1a_vs_tw "P1A-85 weight" `"twoway `_sm' || `_lp' || [fw=rep78],"' `"dash `_sm' || `_lp' || [fw=rep78], name(p1a85)"'
_p1a_vs_tw "P1A-85 stray word" `"twoway `_sm' || `_lp' || foo,"' `"dash `_sm' || `_lp' || foo, name(p1a85)"'
_p1a_vs_tw "P1A-85 two ifs" `"twoway `_sm' || `_lp' || if foreign==1 || if rep78>3,"' `"dash `_sm' || `_lp' || if foreign==1 || if rep78>3, name(p1a85)"'
_p1a_vs_tw "P1A-85 two ifs group" `"twoway (`_sm') if foreign==1 || `_lp' || if rep78>3,"' `"dash (`_sm') if foreign==1 || `_lp' || if rep78>3, name(p1a85)"'
_p1a_vs_tw "P1A-85 two schemes" `"twoway `_sm' || `_lp' || , scheme(s1mono) || , scheme(s2color)"' `"dash `_sm' || `_lp' || , scheme(s1mono) || , scheme(s2color) name(p1a85)"'
_p1a_vs_tw "P1A-85 single bar" `"twoway (`_sm') | (`_lp'),"' `"dash (`_sm') | (`_lp'), name(p1a85)"'
_p1a_vs_tw "P1A-85 nested pair" `"twoway ((`_sm') (`_lp')), title("T")"' `"dash ((`_sm') (`_lp')), title("T") name(p1a85)"'
_p1a_vs_tw "P1A-85 nested ||" `"twoway (`_sm' || `_lp'), title("T")"' `"dash (`_sm' || `_lp'), title("T") name(p1a85)"'
_p1a_vs_tw "P1A-85 nested || trailing" `"twoway (`_sm' || `_lp') || , title("T")"' `"dash (`_sm' || `_lp') || , title("T") name(p1a85)"'
_p1a_vs_tw "P1A-85 nested double" `"twoway (`_sm') ((`_lp')),"' `"dash (`_sm') ((`_lp')), name(p1a85)"'
_p1a_vs_tw "P1A-85 nested inside" `"twoway (`_sm' (`_lp')),"' `"dash (`_sm' (`_lp')), name(p1a85)"'
assert "${dash_graph_registry}" == ""
display "P1A-85 PASS: a || piece with no plot gives the graph its options and qualifier, and is refused where twoway refuses it"

// ================================================================
// FX-01 .. FX-10 -- a function layer is evaluated by Stata's own
// generator (WP-29 P0.6, section 04)
// ================================================================
// dash evaluated `function' itself, in Python, and lost Stata's grammar:
// it drew pi*x, x**2 and +x, which twoway refuses, and refused nothing
// twoway draws in a way twoway would.  It now runs twoway__function_gen,
// the generator twoway function itself calls, at twoway's point in the
// command, and stores the points.  Every case below compares with twoway's
// answer in the same session state: its return code, its words, the
// random-number state and the data it leaves, measured once and replayed
// (cert_truth.do).

// _fx_errline <log>: the first line of <log> holding "error in
// expression:", in r(line) (empty when there is none).
capture program drop _fx_errline
program define _fx_errline, rclass
    version 16.0
    args logf
    mata: st_local("_fxl", _fx_first_line(st_local("logf"), "error in expression:"))
    return local line : copy local _fxl
end
capture mata: mata drop _fx_first_line()
mata:
string scalar _fx_first_line(string scalar path, string scalar needle)
{
    real scalar fh
    string scalar line
    fh = fopen(path, "r")
    while ((line = fget(fh)) != J(0, 0, "")) {
        if (strpos(line, needle)) {
            fclose(fh)
            return(line)
        }
    }
    fclose(fh)
    return("")
}
end

// ================================================================
// FX-01 -- what twoway refuses, dash refuses with twoway's code and
//          one "error in expression:" line, registering nothing
// ================================================================
sysuse auto, clear
dash clear
cert_truth_ctx "FX-01"
local fx01_long "x"
forvalues i = 1/600 {
    local fx01_long "`fx01_long' + sin(x)"
}
foreach e in "pi*x" "e*x" "pi" "e" "PI" "E" "x**2" "x%2" "x//1" "+x" ///
    "2*+x" "(+x)" "x^" "2^^x" "ｓｉｎ(x)" "2x" "sin(x,1)" "sin (x)" ///
    "nosuch(x)" "`fx01_long'" {
    capture cert_tw twoway function y = `e', range(0 2) nodraw
    local tw01 = _rc
    _p1a_logrun `"dash function y = `e', range(0 2) name(fx01)"'
    local rc01 = r(rc)
    local lg01 "`r(log)'"
    if `tw01' == 0 | `rc01' != `tw01' {
        display as error `"FX-01: function y = `=substr(`"`e'"', 1, 40)': twoway r(`tw01'), dash r(`rc01'); dash should refuse as twoway does"'
        exit 9
    }
    assert "${dash_graph_registry}" == ""
    cert_log_has "`lg01'", needle("error in expression: ")
    if r(count) != 1 {
        display as error `"FX-01: function y = `=substr(`"`e'"', 1, 40)': "error in expression: " appears `r(count)' times; once is twoway's"'
        exit 9
    }
}
capture cert_tw twoway (function y = x**2) (scatter mpg weight), nodraw
local tw01 = _rc
_p1a_logrun `"dash (function y = x**2) (scatter mpg weight), name(fx01)"'
assert r(rc) == `tw01' & `tw01' == 198
assert "${dash_graph_registry}" == ""
capture cert_tw twoway scatter mpg weight || function y = pi*x, nodraw
local tw01 = _rc
_p1a_logrun `"dash scatter mpg weight || function y = pi*x, name(fx01)"'
assert r(rc) == `tw01' & `tw01' == 111
assert "${dash_graph_registry}" == ""
display "FX-01 PASS: what twoway function refuses is refused with twoway's code and one error line, and nothing is registered"

// ================================================================
// FX-02 -- the order of the checks is twoway's: plots and by() first,
//          then the function layers, then the graph options
// ================================================================
// twoway checks every plot's variables and options and the by()
// variables, then evaluates the layers in order, then checks the graph
// options (measured, section 04 E3).  So a runiform() layer advances the
// random-number state when a graph option is refused, and not when a
// plot or the by() variable is.  The pairs are "twoway text" "dash text"
// "rc": rc 1 compares the return codes, rc 0 the random-number state
// alone -- dash notes an option it does not know and draws, where twoway
// refuses it (an existing, documented difference, not this section's).
sysuse auto, clear
dash clear
cert_truth_ctx "FX-02"
// xsize(0) is checked when the graph is drawn, so twoway runs without
// nodraw there, with the graphics off.
local fx02_gr = c(graphics)
set graphics off
local fx02_n 0
foreach pair in ///
    `"(function y=runiform()) (scatter nosuch weight), nodraw"' `"(function y=runiform()) (scatter nosuch weight), name(fx02)"' 1 ///
    `"(function y=runiform()), badopt nodraw"' `"(function y=runiform()), badopt name(fx02)"' 0 ///
    `"(function y=runiform()), xsize(0)"' `"(function y=runiform()), xsize(0) name(fx02)"' 1 ///
    `"(function y=x**2) (scatter nosuch weight), nodraw"' `"(function y=x**2) (scatter nosuch weight), name(fx02)"' 1 ///
    `"(function y=x**2) (scatter mpg weight, badopt), nodraw"' `"(function y=x**2) (scatter mpg weight, badopt), name(fx02)"' 1 ///
    `"(function y=x**2) (scatter mpg weight), by(nosuchv) nodraw"' `"(function y=x**2) (scatter mpg weight), by(nosuchv) name(fx02)"' 1 ///
    `"(function y=runiform()) (scatter mpg weight), by(nosuchv) nodraw"' `"(function y=runiform()) (scatter mpg weight), by(nosuchv) name(fx02)"' 1 ///
    `"function y=nosuch(x), n(0) nodraw"' `"function y=nosuch(x), n(0) name(fx02)"' 1 ///
    `"function y=runiform(), n(0) nodraw"' `"function y=runiform(), n(0) name(fx02)"' 1 ///
    `"(function y=runiform(), range(0 2) n(3)) (function y=nosuch(x)), nodraw"' `"(function y=runiform(), range(0 2) n(3)) (function y=nosuch(x)), name(fx02)"' 1 {
    local ++fx02_n
    local fx02_`fx02_n' : copy local pair
}
// twoway's code and the random-number state it leaves: asked in a live
// run, read back otherwise (cert_truth.do).
python: _dct.flag("_ct_l")
forvalues i = 1(3)`fx02_n' {
    local twc : copy local fx02_`i'
    local dc  : copy local fx02_`=`i'+1'
    local cmprc = `fx02_`=`i'+2''
    local _ct_q `"twoway `twc'"'
    set seed 20261001
    if `_ct_l' {
        capture twoway `twc'
        local tw02 = _rc
        local st02 = c(rngstate)
        python: _dct.rc_put("_ct_q", "tw02")
        python: _dct.val_put("rngstate", "_ct_q", "st02")
    }
    else {
        python: _dct.rc_get("_ct_q", "tw02")
        python: _dct.val_get("rngstate", "_ct_q", "st02")
        if "`tw02'" == "" local tw02 9
    }
    set seed 20261001
    dash clear
    _p1a_logrun `"dash `dc'"'
    local rc02 = r(rc)
    if (`cmprc' & `rc02' != `tw02') | c(rngstate) != "`st02'" {
        display as error `"FX-02: `dc': twoway r(`tw02'), dash r(`rc02'); the random-number state `=cond(c(rngstate) == "`st02'", "agrees", "differs")'"'
        exit 9
    }
}
set graphics `fx02_gr'
dash clear
display "FX-02 PASS: plots and by() are checked before a function layer is evaluated, and the graph options after it, as twoway orders them"

// ================================================================
// FX-03 -- runiform() leaves the random-number state where twoway does
// ================================================================
sysuse auto, clear
dash clear
cert_truth_ctx "FX-03"
// The state twoway leaves: asked in a live run, read back otherwise
// (cert_truth.do).
local _ct_q "twoway function y = runiform(), nodraw"
python: _dct.flag("_ct_l")
set seed 42
if `_ct_l' {
    twoway function y = runiform(), nodraw
    local s03 = c(rngstate)
    python: _dct.val_put("rngstate", "_ct_q", "s03")
}
else {
    python: _dct.val_get("rngstate", "_ct_q", "s03")
    if "`s03'" == "" local s03 "."
}
set seed 42
dash function y = runiform(), name(fx03)
assert c(rngstate) == "`s03'"
dash clear
display "FX-03 PASS: function y = runiform() advances the random-number state exactly as twoway function does"

// ================================================================
// FX-04 -- the data are left as twoway leaves them
// ================================================================
// With at least n() observations the generator works in the data (no
// preserve) and twoway marks them changed; with fewer it preserves.  A
// dataset with observations and no variables ends with none, in both.
capture program drop _fx04_state
program define _fx04_state, rclass
    version 16.0
    quietly datasignature
    return local sig "`r(datasignature)'"
    return scalar N = _N
    return scalar changed = c(changed)
    return local sorted : sortedby
end
python: _dct.flag("_ct_l")
foreach setup in "sysuse auto, clear" "clear" {
    cert_truth_ctx "FX-04 `setup'"
    foreach e in "y = x" "y = nosuch(x)" {
        // twoway: its code and the state it leaves, asked in a live run
        // and read back otherwise (cert_truth.do)
        quietly `setup'
        if "`setup'" == "clear" {
            quietly set obs 2
            quietly gen v = _n
        }
        local _ct_q "twoway function `e', n(3) nodraw"
        if `_ct_l' {
            capture twoway function `e', n(3) nodraw
            local tw04 = _rc
            _fx04_state
            local t_sig "`r(sig)'"
            local t_N = r(N)
            local t_ch = r(changed)
            local t_so "`r(sorted)'"
            python: _dct.rc_put("_ct_q", "tw04")
            python: _dct.val_put("datasignature", "_ct_q", "t_sig")
            python: _dct.val_put("_N", "_ct_q", "t_N")
            python: _dct.val_put("c(changed)", "_ct_q", "t_ch")
            python: _dct.val_put("sortedby", "_ct_q", "t_so")
        }
        else {
            python: _dct.rc_get("_ct_q", "tw04")
            python: _dct.val_get("datasignature", "_ct_q", "t_sig")
            python: _dct.val_get("_N", "_ct_q", "t_N")
            python: _dct.val_get("c(changed)", "_ct_q", "t_ch")
            python: _dct.val_get("sortedby", "_ct_q", "t_so")
            if "`tw04'" == "" local tw04 9
            if "`t_N'" == "" local t_N .
            if "`t_ch'" == "" local t_ch .
        }
        // dash
        quietly `setup'
        if "`setup'" == "clear" {
            quietly set obs 2
            quietly gen v = _n
        }
        dash clear
        capture dash function `e', n(3) name(fx04)
        local rc04 = _rc
        _fx04_state
        if `rc04' != `tw04' | "`r(sig)'" != "`t_sig'" | r(N) != `t_N' | ///
            r(changed) != `t_ch' | "`r(sorted)'" != "`t_so'" {
            display as error `"FX-04: `setup' / `e': twoway rc `tw04' N `t_N' changed `t_ch' sorted `t_so'; dash rc `rc04' N `r(N)' changed `r(changed)' sorted `r(sorted)'"'
            exit 9
        }
    }
}
// A user variable named x is the user's.
sysuse auto, clear
gen x = 99
dash clear
dash function y = x^2, range(0 2) n(3) name(fx04)
assert x == 99
// Observations and no variables: twoway leaves none, and so does dash.
// (twoway's count is asked in a live run, read back otherwise.)
clear
set obs 5
cert_truth_ctx "FX-04 observations, no variables"
local _ct_q "twoway function y = x, nodraw"
if `_ct_l' {
    twoway function y = x, nodraw
    local n04 = _N
    python: _dct.val_put("_N", "_ct_q", "n04")
}
else {
    python: _dct.val_get("_N", "_ct_q", "n04")
    if "`n04'" == "" local n04 .
}
assert `n04' == 0
clear
set obs 5
dash clear
dash function y = x, name(fx04)
assert _N == 0
// A variable named pi is read as twoway reads it.
sysuse auto, clear
gen pi = 2
cert_truth_ctx "FX-04 pi"
capture cert_tw twoway function y = pi*x, nodraw
assert _rc == 0
dash clear
_p1a_logrun "dash function y = pi*x, name(fx04)"
assert r(rc) == 0
dash clear
display "FX-04 PASS: the data, their sort order, c(changed) and a variable named x are left as twoway function leaves them"

// ================================================================
// FX-05 -- the refusal is echoed as typed, in twoway's one line
// ================================================================
sysuse auto, clear
dash clear
cert_truth_ctx "FX-05"
_p1a_logrun "dash function y = nosuch(x) + {bf:BOLD}, name(fx05)"
assert r(rc) == 133
local lg05 "`r(log)'"
cert_file_has "`lg05'", needle("{bf:BOLD}")
assert r(found) == 1
cert_log_has "`lg05'", needle("unknown function")
assert r(count) == 0
// twoway's line is its logged answer (asked in a live run, read back
// otherwise: _p1a_logrun, cert_truth.do).
foreach e in "y = nosuch(x)" "y=nosuch(x)" "nosuch(x)" {
    _p1a_logrun `"twoway function `e', nodraw"'
    assert r(rc) == 133
    _fx_errline "`r(log)'"
    local tl05 `"`r(line)'"'
    _p1a_logrun `"dash function `e', name(fx05)"'
    assert r(rc) == 133
    _fx_errline "`r(log)'"
    if `"`r(line)'"' != `"`tl05'"' | `"`tl05'"' == "" {
        display as error `"FX-05: `e': twoway said [`tl05'], dash said [`r(line)']"'
        exit 9
    }
}
// Long: the text after = is cut to its first 197 characters, then "...".
local e05 "x"
forvalues i = 1/5000 {
    local e05 "`e05' + f`i'(x)"
}
_p1a_logrun `"dash function y = `e05', range(0 1) name(fx05)"'
assert r(rc) == 133
local lg05 "`r(log)'"
local w05 = substr(" `e05'", 1, 197) + "..."
cert_file_has "`lg05'", needle(`"error in expression: `w05'"')
assert r(found) == 1
cert_file_has "`lg05'", needle("f4999(x)")
assert r(found) == 0
assert "${dash_graph_registry}" == ""
display "FX-05 PASS: a refused expression is echoed as typed, in twoway's one line, and a long one is cut to 200 characters"

// ================================================================
// FX-06 -- hostile: no generator option can be injected; Break is r(1)
// ================================================================
sysuse auto, clear
dash clear
tempname fx06r fx06o
mata: st_strscalar(st_local("fx06r"), "y = x, generate(mpg weight, replace)")
mata: st_strscalar(st_local("fx06o"), "")
capture noisily _dash_fn_points `fx06r' 0 1 3 1 `fx06o'
assert _rc == 198
confirm variable mpg weight
mata: st_strscalar(st_local("fx06r"), "y = x")
capture noisily _dash_fn_points `fx06r' 0 1 3 1 `fx06o'
assert _rc == 0
mata: st_local("o06", st_strscalar(st_local("fx06o")))
assert `"`o06'"' == `""1":{"x0":0,"dx":0.5,"y":[0,0.5,1]}"'
// Break inside the generator: a stub that ends as Break ends, r(1).
quietly datasignature
local sig06 "`r(datasignature)'"
local n06 = _N
capture program drop twoway__function_gen
program define twoway__function_gen
    exit 1
end
_p1a_logrun "dash function y = x, name(fx06)"
local rc06 = r(rc)
local lg06 "`r(log)'"
capture program drop twoway__function_gen
assert `rc06' == 1
cert_log_has "`lg06'", needle("error in expression")
assert r(count) == 0
quietly datasignature
assert "`r(datasignature)'" == "`sig06'"
assert _N == `n06'
assert "${dash_graph_registry}" == ""
display "FX-06 PASS: a generator option cannot be injected through the expression, and Break ends the command r(1) with the data as they were"

// ================================================================
// FX-07 -- no point is ever truncated: one graph past c(macrolen) is
//          refused r(134); a dashboard past the old dash_max_bytes builds
//          (WP-33 33-15: no size cap, P4-3)
// ================================================================
sysuse auto, clear
dash clear
local reg07 "${dash_graph_registry}"
local l07 "(function y = sin(x)/x, range(-100 100) n(10000))"
_p1a_logrun `"dash `l07' `l07' `l07' `l07', name(fx07)"'
assert r(rc) == 134
local lg07 "`r(log)'"
cert_file_has "`lg07'", needle("n()")
assert r(found) == 1
cert_file_has "`lg07'", needle("`c(macrolen)'")
assert r(found) == 1
assert "${dash_graph_registry}" == "`reg07'"
assert `"${dash_fpts_fx07}"' == ""
local h07 "`c(tmpdir)'dash_fx07.html"
capture erase "`h07'"
_p1a_logrun `"dash `l07' `l07' `l07' `l07', saving("`h07'", replace)"'
assert r(rc) == 0
capture erase "`h07'"
_p1a_logrun `"dash function y = sin(x)/x, range(-100 100) n(10000) name(fx07b)"'
assert r(rc) == 0
_p1a_logrun `"dash build, saving("`h07'") replace"'
assert r(rc) == 0
local a07 "`c(tmpdir)'dash_fx07_app.py"
capture erase "`a07'"
_p1a_logrun `"dash build, saving("`a07'") server replace"'
assert r(rc) == 0
capture erase "`h07'"
capture erase "`a07'"
dash clear
clear
dash function y = x, n(300) name(fx07c)
// Flipped (WP-33 33-15): refused r(134) at dash_max_bytes 1000; the
// maintainer removed the size caps (P4-3), so it builds.
global dash_max_bytes 1000
capture erase "`h07'"
_p1a_logrun `"dash build, saving("`h07'") replace"'
local rc07 = r(rc)
local lg07 "`r(log)'"
macro drop dash_max_bytes
assert `rc07' == 0
cert_file_has "`lg07'", needle("characters of function points")
assert r(found) == 0
confirm file "`h07'"
capture erase "`h07'"
dash clear
display "FX-07 PASS: a graph whose points exceed one macro is refused r(134); a dashboard whose points pass 1,000 characters builds at dash_max_bytes 1000"

// ================================================================
// FX-08 -- the points live in $dash_fpts_<name>, which goes with its graph
// ================================================================
sysuse auto, clear
dash clear
dash function y = x, name(fx08)
assert `"${dash_fpts_fx08}"' != ""
dash scatter mpg weight, name(fx08, replace)
assert `"${dash_fpts_fx08}"' == ""
dash function y = x, name(fx08, replace)
assert `"${dash_fpts_fx08}"' != ""
dash kpi mean(price), name(fx08, replace) title("Price")
assert `"${dash_fpts_fx08}"' == ""
dash scatter mpg weight, name(fx08s)
assert `"${dash_fpts_fx08s}"' == ""
dash function y = x, name(fx08g)
assert `"${dash_fpts_fx08g}"' != ""
dash clear
assert `"${dash_fpts_fx08g}"' == ""
// Points that are not dash's are skipped at build, with a note.
dash function y = x, name(fx08g)
mata: st_global("dash_fpts_fx08g", `"}],"graphs":["')
local h08 "`c(tmpdir)'dash_fx08.html"
capture erase "`h08'"
_p1a_logrun `"dash build, saving("`h08'") replace"'
assert r(rc) == 0
cert_file_has "`r(log)'", needle("are not dash's")
assert r(found) == 1
capture confirm file "`h08'"
assert _rc == 0
capture erase "`h08'"
dash clear
display "FX-08 PASS: a function graph's points are stored in its own global, dropped with it, and skipped at build when they are not dash's"

// ================================================================
// FX-09 -- one expansion, inside the generator; the caller's version
// ================================================================
sysuse auto, clear
dash clear
global FXG 3
dash function y = \$FXG*x, range(0 2) n(3) name(fx09)
macro drop FXG
assert strpos(`"${dash_fpts_fx09}"', `""y":[0,3,6]"') > 0
version 17: dash function y = x, name(fx09v)
assert "`._Gr_Global.callerver'" == "17"
dash clear
display "FX-09 PASS: the expression is expanded once, by the generator, under the caller's version"

// ================================================================
// FX-10 -- the Mata writer: numbers that read back, and the spec tail
// ================================================================
mata: st_local("j10", invtokens(_dash_json_number17((0, -0, .5, -.5, 1/3, ., .a, 1e21)')', ","))
assert "`j10'" == "0,0,0.5,-0.5,0.33333333333333331,null,null,1.00000000000000000e+21"
preserve
clear
quietly set obs 3
gen double v10 = _n/2
mata: st_local("p10", _dash_fn_points_json("v10", 3, 0, 1))
restore
assert `"`p10'"' == `"{"x0":0,"dx":1,"y":[0.5,1,1.5]}"'
tempfile t10
capture erase "`t10'"
mata: _fx10_fh = fopen(st_local("t10"), "w"); fwrite(_fx10_fh, `"{"a":1"'); fclose(_fx10_fh)
mata: _dash_fn_spec_tail(st_local("t10"), "", "")
mata: st_local("f10", invtokens(cat(st_local("t10"))'))
assert `"`f10'"' == `"{"a":1}"'
tempname s10
mata: st_strscalar(st_local("s10"), `"{"1":{"x0":0,"dx":1,"y":[1]}}"')
capture erase "`t10'"
mata: _fx10_fh = fopen(st_local("t10"), "w"); fwrite(_fx10_fh, `"{"a":1"'); fclose(_fx10_fh)
mata: _dash_fn_spec_tail(st_local("t10"), "", st_local("s10"))
mata: st_local("f10", invtokens(cat(st_local("t10"))'))
assert `"`f10'"' == `"{"a":1,"function_points":{"":{"1":{"x0":0,"dx":1,"y":[1]}}}}"'
display "FX-10 PASS: points are written %24.17g with null for missing, and appended to the spec beside the graphs"

// ================================================================
// FX-11 -- a one-line graph with no function layer: its points scalar is
// empty, so the tail writes the bare } and says nothing.  Every one-line
// saving() printed "the function points stored for graph '' are not
// dash's" before this (548 times in one certification run, 02oct2026).
// ================================================================
tempname s11
mata: st_strscalar(st_local("s11"), "")
capture erase "`t10'"
mata: _fx10_fh = fopen(st_local("t10"), "w"); fwrite(_fx10_fh, `"{"a":1"'); fclose(_fx10_fh)
tempfile lg11
quietly log using "`lg11'", text replace name(fx11)
mata: _dash_fn_spec_tail(st_local("t10"), "", st_local("s11"))
quietly log close fx11
mata: st_local("f11", invtokens(cat(st_local("t10"))'))
assert `"`f11'"' == `"{"a":1}"'
mata: st_local("n11", strofreal(sum(strpos(cat(st_local("lg11")), "are not dash's") :> 0)))
if `n11' != 0 {
    display as error "FX-11 FAIL: an empty points scalar printed the not-dash's note `n11' time(s)"
    exit 9
}
display "FX-11 PASS: a graph with no function points writes the bare } and no note"

// ================================================================
// LB-41..LB-43 (WP-29 P0.9) -- lpolyci's pwidth() and var(): the Mata
// reader and the JSON key lpvar.  `var' is never an option key:
// _dash_extract_vars reads every "var": in a plot's JSON as a variable.
// Each case prints PASS or FAIL and the script goes on; a FAIL ends it
// with exit 9 below.
// ================================================================
global lb_pfail = 0
local lb41 ""
capture mata: _dash_extract_vars(`"{"type":"lpolyci","yvar":"mpg","xvar":"weight","options":{"pwidth":"800","lpvar":"10"}}"', "lb41")
if _rc | "`lb41'" != "mpg weight" {
    display as error `"LB-41 FAIL: _dash_extract_vars gave "`lb41'" (rc `=_rc')"'
    global lb_pfail = 1
}
else display "LB-41 PASS: _dash_extract_vars on an lpvar spec lists mpg weight"

// LB-42: _dash_lpolyci_opts(unk, ptype) -> _lpo_pwidth _lpo_var _lpo_rest
// _lpo_rc _lpo_msg.  _lb42 <input> <ptype> <rc> <pwidth> <var> <rest> <msg>
capture program drop _lb42
program define _lb42
    version 16.0
    args in pt wrc wpw wv wrest wmsg
    foreach k in _lpo_pwidth _lpo_var _lpo_rest _lpo_rc _lpo_msg {
        local `k' ""
    }
    capture mata: _dash_lpolyci_opts(st_local("in"), st_local("pt"))
    if _rc {
        display as error `"LB-42 FAIL: [`in'] _dash_lpolyci_opts rc `=_rc'"'
        global lb42_bad = 1
        exit
    }
    if "`_lpo_rc'" != "`wrc'" | (`wrc' != 0 & `"`_lpo_msg'"' != `"`wmsg'"') {
        display as error `"LB-42 FAIL: [`in' on `pt'] rc `_lpo_rc' "`_lpo_msg'", want `wrc' "`wmsg'""'
        global lb42_bad = 1
    }
    else if `wrc' == 0 & (real("`_lpo_pwidth'") != real("`wpw'") | real("`_lpo_var'") != real("`wv'") | strtrim(`"`_lpo_rest'"') != strtrim(`"`wrest'"')) {
        display as error `"LB-42 FAIL: [`in' on `pt'] pwidth "`_lpo_pwidth'" var "`_lpo_var'" rest "`_lpo_rest'""'
        global lb42_bad = 1
    }
end
global lb42_bad = 0
_lb42 "pwidth(800) var(10) msize(2)" lpolyci 0 "800" "10" "msize(2)" ""
_lb42 "pw(800) v(10)" lpolyci 0 "800" "10" "" ""
_lb42 "p(800)" lpolyci 0 "" "" "p(800)" ""
_lb42 "pwidth(1d3) var(1d1)" lpolyci 0 "1000" "10" "" ""
_lb42 "pwidth(.5e3) var(+10)" lpolyci 0 "500" "10" "" ""
_lb42 "pwidth(0)" lpolyci 198 "" "" "" "pwidth() must be a positive number"
_lb42 "pwidth(abc)" lpolyci 198 "" "" "" "pwidth() must be a positive number"
_lb42 "pwidth(800 900)" lpolyci 198 "" "" "" "pwidth() must be a positive number"
_lb42 "var(0)" lpolyci 0 "" "0" "" ""
_lb42 "var(abc)" lpolyci 7 "" "" "" "'abc' found where number expected"
_lb42 "var(10 20)" lpolyci 7 "" "" "" "'20' found where nothing expected"
_lb42 "pwidth(800) var(10)" lpoly 0 "" "" "pwidth(800) var(10)" ""
if ${lb42_bad} global lb_pfail = 1
else display "LB-42 PASS: _dash_lpolyci_opts reads pwidth() and var() by value, as twoway reads them, on lpolyci only"
macro drop lb42_bad

// LB-43: the variables dash exports for the plot are mpg and weight --
// read from the spec dash.ado itself registers -- and the rendered page
// carries no column named after var()'s value.
local bad = 0
sysuse auto, clear
capture dash clear
capture noisily dash lpolyci mpg weight, pwidth(800) var(10) name(lb43)
if _rc {
    display as error "LB-43 FAIL: rc `=_rc'"
    local bad = 1
}
else {
    local v43 ""
    mata: _dash_extract_vars(st_global("dash_json_lb43"), "v43")
    if "`v43'" != "mpg weight" {
        display as error `"LB-43 FAIL: _dash_extract_vars gave "`v43'""'
        local bad = 1
    }
}
if `"`c(python_exec)'"' != "" & !`bad' {
    local h43 "`c(tmpdir)'dash_lb43.html"
    capture erase "`h43'"
    capture noisily dash build, saving("`h43'") replace nobrowser
    if _rc {
        display as error "LB-43 FAIL: dash build rc `=_rc'"
        local bad = 1
    }
    else {
        mata: _p43 = invtokens(cat(st_local("h43"))'); st_local("b43", strofreal(strpos(_p43, char(34) + "10" + char(34) + ":[") > 0))
        mata: mata drop _p43
        if `b43' {
            display as error "LB-43 FAIL: the page carries a column named 10"
            local bad = 1
        }
    }
    capture erase "`h43'"
}
capture dash clear
if `bad' global lb_pfail = 1
else display "LB-43 PASS: dash lpolyci mpg weight, pwidth(800) var(10) exports mpg and weight, no column 10"
if ${lb_pfail} {
    macro drop lb_pfail
    exit 9
}
macro drop lb_pfail

// ================================================================
// KT-12 (WP-30 P1.16) -- a function's y name is any Stata name, as in
// twoway (twoway__function_gen's confirm name): `function _y =' and
// `function ü =' are refused "nothing found where expression expected",
// r(111), as twoway refuses them, and nothing is registered; the spec
// carries the name beside the expression.  dash said "error in
// expression: ", r(111) (measured at 41d6e10).
// ================================================================
sysuse auto, clear
dash clear
foreach form in "function _y =, name(kt12)" "function ü = , range(0 1)" {
    _p1a_logrun `"dash `form'"'
    local rckt = r(rc)
    cert_file_has "`r(log)'", needle("nothing found where expression expected")
    if `rckt' != 111 | !r(found) {
        display as error `"KT-12 FAIL: dash `form' gave rc `rckt'"'
        exit 9
    }
}
assert "${dash_graph_registry}" == ""
_dash_process_segment "function _y = x^2, range(0 2)" _ptk12 _jsk12
assert strpos(`"`_jsk12'"', `""expr":"x^2","yname":"_y""') > 0
display "KT-12 PASS: function _y = and function ü = are refused r(111) in twoway's words; the spec carries yname"

// ================================================================
// FN-02..FN-05 (WP-30 P1.22) -- a function layer without Stata's points
// says what it needs, saved and served, and stored points that are not
// dash's are said to be unused.  Dropping $dash_fpts_<name> is the one
// route from Stata into the points-free fallback (setting registry
// macros by hand is unsupported, dash.sthlp; it stands in here for a
// spec written by hand).
// ================================================================
sysuse auto, clear
quietly graph drop _all
dash clear
// Flipped (WP-31 F2): invlogit() is drawn by the fallback now;
// invlogit(), which it still refuses, takes its place in FN-02..FN-04.
dash function y = invlogit(x), range(-3 3) n(7) name(fn02)
macro drop dash_fpts_fn02
local h02 "`c(tmpdir)'dash_fn02.html"
capture erase "`h02'"
_p1a_logrun `"dash build, saving("`h02'") replace"'
assert r(rc) == 0
local lg02 "`r(log)'"
cert_log_has "`lg02'", needle("drew nothing: it needs the points Stata computes for it when dash registers the graph")
assert r(count) == 1
cert_log_has "`lg02'", needle("invlogit() is not one of them")
assert r(count) == 1
capture erase "`h02'"
display "FN-02 PASS: a saved build names invlogit() as what the fallback cannot evaluate, once, rc 0"

local a03 "`c(tmpdir)'dash_fn03.py"
capture erase "`a03'"
_p1a_logrun `"dash build, saving("`a03'") server replace"'
assert r(rc) == 0
local lg03 "`r(log)'"
cert_log_has "`lg03'", needle("drew nothing: it needs the points Stata computes for it when dash registers the graph")
assert r(count) == 1
cert_log_has "`lg03'", needle("invlogit() is not one of them")
assert r(count) == 1
capture erase "`a03'"
dash clear
display "FN-03 PASS: dash build, server prints the same note once, rc 0"

dash function y = invlogit(x), range(-3 3) n(7) name(fn04)
mata: st_global("dash_fpts_fn04", `"{"1":"abc"}"')
local h04 "`c(tmpdir)'dash_fn04.html"
capture erase "`h04'"
_p1a_logrun `"dash build, saving("`h04'") replace"'
assert r(rc) == 0
local lg04 "`r(log)'"
cert_log_has "`lg04'", needle("are not dash's and are not used; run the graph's dash command again to store Stata's points.")
assert r(count) == 1
cert_log_has "`lg04'", needle("drawn from its expression")
assert r(count) == 0
cert_log_has "`lg04'", needle("invlogit() is not one of them")
assert r(count) == 1
capture erase "`h04'"
dash clear
display "FN-04 PASS: points that are not dash's are said to be unused, and the layer's note names invlogit()"

dash function y = sin(x), range(0 2) n(5) name(fn05)
macro drop dash_fpts_fn05
local h05 "`c(tmpdir)'dash_fn05.html"
capture erase "`h05'"
_p1a_logrun `"dash build, saving("`h05'") replace"'
assert r(rc) == 0
cert_log_has "`r(log)'", needle("drew nothing")
assert r(count) == 0
capture erase "`h05'"
dash clear
display "FN-05 PASS: a function the fallback knows draws without a note"

// NP-40..NP-42 (WP-30 P1.14a): the named styles reach the spec.  NP-40
// every new key, by value; NP-41 a hostile name is stored as text; NP-42
// p()'s drop list holds on each series of a 3-y varlist.
dash clear
quietly sysuse auto, clear
dash line mpg weight, sort pstyle(p3) lstyle(p4) clstyle(p5) mstyle(p6) mlstyle(p7) astyle(p8) alstyle(p9) bstyle(p10) blstyle(p11) name(np40)
mata: _np_j = st_global("dash_json_np40")
foreach kv in pstyle:p3 lstyle:p4 clstyle:p5 mstyle:p6 mlstyle:p7 astyle:p8 alstyle:p9 bstyle:p10 blstyle:p11 {
    gettoken k v : kv, parse(":")
    local v = substr("`v'", 2, .)
    mata: assert(strpos(_np_j, char(34) + "`k'" + char(34) + ":" + char(34) + "`v'" + char(34)) > 0)
}
dash scatter mpg weight, p(p12) name(np40b)
mata: assert(strpos(st_global("dash_json_np40b"), char(34) + "p" + char(34) + ":" + char(34) + "p12" + char(34)) > 0)
display "NP-40 PASS: the nine named styles and p() reach the spec under their keys"
// The dollar sign is written \u0024 by _dash_json_str, never expanded.
dash scatter mpg weight, mstyle("\$HOME") name(np41)
mata: assert(strpos(st_global("dash_json_np41"), char(34) + "mstyle" + char(34) + ":" + char(34) + char(92) + "u0024HOME" + char(34)) > 0)
display "NP-41 PASS: a dollar sign in a style name is stored as text"
dash scatter mpg turn trunk weight, mcolor(red) msymbol(T) p(p3) name(np42)
mata: _np_j = st_global("dash_json_np42")
mata: assert(strpos(_np_j, "mcolor") == 0 & strpos(_np_j, "msymbol") == 0)
mata: assert((strlen(_np_j) - strlen(subinstr(_np_j, char(34) + "p" + char(34) + ":" + char(34) + "p3" + char(34), ""))) / 8 == 3)
dash clear
display "NP-42 PASS: under p() the style options are dropped on each of three series"

// ================================================================
// TSO: time-series operators in plot varlists (WP-30 P1.7)
//
// twoway draws L.close, D.close and L(1/2).close on 29 types and refuses
// them in its own words elsewhere; dash refused every one r(101).  Each
// case holds dash to twoway's answer for the same command, read from
// fixtures/ts_operator_truth.json (scripts/extract_ts_operator_truth.do):
// its rc and its first error line.  The data are the extractor's.
// ================================================================
capture program drop _tso_data
program define _tso_data
    version 19
    args ds
    if inlist("`ds'", "sp", "spd", "nt") {
        quietly sysuse sp500, clear
        quietly {
            gen t = _n
            format volume %12.0fc
            gen float xf = close / 7
            gen g = t > 124
            gen c80 = close
            label variable c80 "Closing price of the Standard and Poors 500 index on each trading day of 2001 US"
        }
        if "`ds'" == "sp"  quietly tsset t
        if "`ds'" == "spd" quietly tsset date
    }
    else if "`ds'" == "au" {
        quietly sysuse auto, clear
        quietly gen t = _n
        quietly tsset t
    }
end

// _tso_tw <probe>: twoway's rc and first error line for the probe.
capture program drop _tso_tw
program define _tso_tw, rclass
    version 19
    args pid
    python: import json as _tj, sfi as _ts
    python: _tp = _tj.load(open("fixtures/ts_operator_truth.json", encoding="utf-8"))["probes"][_ts.Macro.getLocal("pid")]["twoway"]
    python: _ts.Macro.setLocal("rc", str(_tp["rc"])); _ts.Macro.setLocal("err", (_tp["err"] or [""])[0])
    return scalar rc = `rc'
    return local err : copy local err
end

// _tso_vs <id> <probe> <ds> <dash command>: dash's rc and first error
// line equal twoway's.
capture program drop _tso_vs
program define _tso_vs
    version 19
    args id pid ds dcmd
    _tso_tw `pid'
    local twrc = r(rc)
    local twerr `"`r(err)'"'
    _tso_data `ds'
    quietly dash clear
    _p1a_logrun `"`dcmd'"'
    local drc = r(rc)
    if `drc' != `twrc' {
        display as error `"`id' FAIL: `pid' twoway r(`twrc'), dash r(`drc'): `dcmd'"'
        exit 9
    }
    if `twrc' {
        cert_file_has "`r(log)'", needle(`"`twerr'"')
        if !r(found) {
            display as error `"`id' FAIL: `pid' dash's log lacks twoway's "`twerr'": `dcmd'"'
            exit 9
        }
    }
end

capture program drop _tso_spec
program define _tso_spec
    version 19
    args stem
    capture erase "`c(tmpdir)'`stem'_s.json"
    capture erase "`c(tmpdir)'`stem'_d.json"
    _dash_prepare_spec, specpath("`c(tmpdir)'`stem'_s.json") datapath("`c(tmpdir)'`stem'_d.json")
end

if `"`c(python_exec)'"' != "" {
    quietly graph drop _all
    local tsotmp "`c(tmpdir)'"
    python: import json as _tj, sfi as _ts
    python: _tdir = _ts.Macro.getLocal("tsotmp")
    // TSO-01..03: drawn on the one-line route, and the spec maps the column
    // to the expression and twoway's text.
    local tsopg "`c(tmpdir)'dash_tso.html"
    local k 0
    foreach row in "T01|spd|line D.close date" "T04|sp|tsline D.close" "V02|sp|lfit close L.close" {
        local ++k
        gettoken pid rest : row, parse("|")
        gettoken bar rest : rest, parse("|")
        gettoken ds rest : rest, parse("|")
        local body = substr(`"`rest'"', 2, .)
        _tso_vs TSO-0`k' `pid' `ds' `"dash `body', saving("`tsopg'", replace)"'
        display "TSO-0`k' PASS: dash `body' draws, as twoway does"
    }
    _tso_data spd
    dash clear
    dash line D.close date, name(tso01)
    _tso_spec tso01
    cert_file_has "`c(tmpdir)'tso01_s.json", needle(`""ts_cols":{"__dasht1":{"expr":"D.close","label":"Closing price, D"}}"')
    assert r(found)
    display "TSO-01 PASS: the spec maps __dasht1 to D.close and Closing price, D"

    // TSO-04: every type twoway takes operators on registers them; the seven
    // it refuses them on refuse them in its words.
    python: _ts.Macro.setLocal("tso_ar", " ".join(sorted(k for k in _tj.load(open("fixtures/ts_operator_truth.json", encoding="utf-8"))["probes"] if k[0] in "AR")))
    foreach pid of local tso_ar {
        python: _ts.Macro.setLocal("tso_b", _tj.load(open("fixtures/ts_operator_truth.json", encoding="utf-8"))["probes"][_ts.Macro.getLocal("pid")]["body"])
        _tso_vs TSO-04 `pid' sp `"dash `tso_b', name(tso04)"'
    }
    dash clear
    display "TSO-04 PASS: the 29 types take operators and the 7 others refuse them, as twoway does"

    // TSO-05: no tsset, a string base, a factor variable, an unknown
    // operator, a missing variable -- twoway's codes and words.
    _tso_vs TSO-05 E01 nt "dash line L.close t, name(tso05)"
    foreach pid in E02 E03 E04 E05 {
        python: _ts.Macro.setLocal("tso_b", _tj.load(open("fixtures/ts_operator_truth.json", encoding="utf-8"))["probes"][_ts.Macro.getLocal("pid")]["body"])
        _tso_vs TSO-05 `pid' au `"dash `tso_b', name(tso05)"'
    }
    dash clear
    display "TSO-05 PASS: no tsset r(111), string r(109), factor r(101), X. r(198), a missing variable r(111), in twoway's words"

    // TSO-06: data sorted otherwise at build: tsrevar's "not sorted", r(5),
    // nothing left behind, the data unchanged; tsset cleared since
    // registration: "time variable not set", r(111).
    _tso_data sp
    dash clear
    dash scatter L.close t, name(tso06)
    sort close
    local so0 : sortedby
    local ch0 = c(changed)
    _p1a_logrun `"dash build, saving("`tsopg'") replace"'
    assert r(rc) == 5
    cert_file_has "`r(log)'", needle("not sorted")
    assert r(found)
    capture unab x : __dash*
    assert _rc == 111
    assert "`: sortedby'" == "`so0'" & c(changed) == `ch0'
    sort t
    tsset, clear
    _p1a_logrun `"dash build, saving("`tsopg'") replace"'
    assert r(rc) == 111
    cert_file_has "`r(log)'", needle("time variable not set")
    assert r(found)
    dash clear
    display "TSO-06 PASS: unsorted data r(5) not sorted and no tsset r(111) at build, nothing left behind"

    // TSO-08: dash build and dash serve write the same map and column.
    _tso_data sp
    dash clear
    dash scatter D.close t, name(tso08)
    _tso_spec tso08b
    _dash_prepare_spec, cmdname("dash serve") specpath("`c(tmpdir)'tso08s_s.json") datapath("`c(tmpdir)'tso08s_d.json")
    * WP-32 G3b: the data file holds binary columns; read one as values.
    quietly findfile dash_render.py
    python: import sys as _tsy, os as _tos; _tsy.path.insert(0, _tos.path.dirname(_tos.path.abspath(r"`r(fn)'")))
    python: import dash_render as _tdr, math as _tm
    python: _tso_col = lambda d, n: [None if (isinstance(v, float) and _tm.isnan(v)) else v for v in (_tdr._dash_decode_columns(d) or True) and (_tdr._dash_columns_frame(d)[n].tolist() if _tdr._dash_columns_frame(d) is not None else [r.get(n) for r in d["values"]])]
    python: _sb, _ss = [_tj.load(open(_tdir + _n, encoding="utf-8")) for _n in ("tso08b_s.json", "tso08s_s.json")]
    python: _db, _dv = [_tj.load(open(_tdir + _n, encoding="utf-8")) for _n in ("tso08b_d.json", "tso08s_d.json")]
    python: _ok = _sb["build_options"]["ts_cols"] == _ss["build_options"]["ts_cols"] == {"__dasht1": {"expr": "D.close", "label": "Closing price, D"}} and _tso_col(_db, "__dasht1") == _tso_col(_dv, "__dasht1")
    python: _ts.Macro.setLocal("tso_ok", "1" if _ok else "0")
    assert `tso_ok' == 1
    dash clear
    display "TSO-08 PASS: dash build and dash serve write the same ts_cols and __dasht1"

    // TSO-09: tsrevar's storage type, the base's format and value label,
    // and an 80-character label carried whole.
    local tso_ok 1
    foreach row in "sp|D.xf|float|%9.0g|" "au|L.mpg|int|%8.0g|" "sp|L.volume|double|%12.0fc|" "au|L.foreign|byte|%8.0g|origin" {
        tokenize `"`row'"', parse("|")
        _tso_data `1'
        dash clear
        dash scatter `3' t, name(tso09)
        _tso_spec tso09
        global TSO_W `"`5'|`7'|`9'"'
        python: _w = _ts.Macro.getGlobal("TSO_W").split("|"); _s = _tj.load(open(_tdir + "tso09_s.json", encoding="utf-8")); _dd = _tj.load(open(_tdir + "tso09_d.json", encoding="utf-8"))
        python: _ts.Macro.setLocal("tso_one", "1" if (_dd["storageTypes"]["__dasht1"] == _w[0] and _s["build_options"]["formats"]["__dasht1"] == _w[1] and _dd["valueLabelNames"].get("__dasht1", "") == _w[2]) else "0")
        if !`tso_one' {
            display as error `"TSO-09 FAIL: `3'"'
            local tso_ok 0
        }
    }
    macro drop TSO_W
    _tso_data sp
    dash clear
    dash line L.c80 t, name(tso09)
    _tso_spec tso09
    cert_file_has "`c(tmpdir)'tso09_s.json", needle(`""label":"Closing price of the Standard and Poors 500 index on each trading day of 2001 US, L""')
    assert r(found) & `tso_ok'
    dash clear
    display "TSO-09 PASS: storage float/int/double/byte as tsrevar, the base's format and value label, an 80-character label whole"

    // TSO-11: a registry edited by hand to smuggle text past the rewrite is
    // refused r(198) and the data are untouched.
    _tso_data sp
    foreach bad in "L.close;drop _all" "X.close" {
        dash clear
        dash scatter L.close t, name(tso11)
        mata: st_global("dash_json_tso11", subinstr(st_global("dash_json_tso11"), char(34) + "L.close" + char(34), char(34) + st_local("bad") + char(34)))
        local n0 = c(N)
        local k0 = c(k)
        _p1a_logrun `"dash build, saving("`tsopg'") replace"'
        assert r(rc) == 198
        cert_file_has "`r(log)'", needle("holds a variable dash cannot read")
        assert r(found) & c(N) == `n0' & c(k) == `k0'
    }
    dash clear
    display "TSO-11 PASS: a hand-edited operator expression is refused r(198), the data untouched"

    // TSO-12: [aw=L.weight] is taken, as twoway takes it, and computed as
    // the time-series column __dasht1 at build (Flipped, WP-31 A5: it was
    // refused r(198), where twoway evaluates the weight).
    _tso_data au
    dash clear
    _p1a_logrun "dash lfit mpg t [aw=L.weight], name(tso12)"
    assert r(rc) == 0
    _p1a_logrun `"dash build, saving("`tsopg'") replace"'
    assert r(rc) == 0
    capture describe __dash*, varlist
    assert _rc != 0
    display "TSO-12 PASS: a weight with an operator is taken and built, as twoway takes it"

    // TSO-13: a graph of operators alone draws, one-line and built.
    foreach body in "scatter D.close LD.close" "lfit D.close L.close" {
        _tso_data sp
        dash clear
        _p1a_logrun `"dash `body', saving("`tsopg'", replace)"'
        assert r(rc) == 0
        dash `body', name(tso13)
        _p1a_logrun `"dash build, saving("`tsopg'") replace"'
        assert r(rc) == 0
    }
    dash clear
    display "TSO-13 PASS: dash scatter D.close LD.close and dash lfit D.close L.close draw on both routes"

    // TSO-14: an operator in the qualifier keeps twoway's rows (a guard).
    _tso_data sp
    dash clear
    dash scatter close t if L.close > 1300, name(tso14)
    _tso_spec tso14
    quietly count if L.close > 1300 & !missing(close, t)
    local want = r(N)
    python: _dd = _tj.load(open(_tdir + "tso14_d.json", encoding="utf-8")); _ts.Macro.setLocal("tso_n", str(int(sum(v or 0 for v in _tso_col(_dd, "__dashq1")))))
    assert `tso_n' == `want' & `want' == 33
    dash clear
    display "TSO-14 PASS: if L.close > 1300 keeps twoway's 33 rows"

    // TSO-15: a qualifier is never expanded a second time on the parser
    // dispatch (P1A-80's attack on a type the ts parser reads, and on lpoly).
    _tso_data au
    local f15 "`c(tmpdir)'dash_tso15_inj.txt"
    foreach pt in scatter lpoly {
        capture erase "`f15'"
        dash clear
        capture noisily dash `pt' mpg weight if make == `"\`=filewrite("`f15'","x")'"', name(tso15)
        capture confirm file "`f15'"
        assert _rc != 0
    }
    dash clear
    display "TSO-15 PASS: a qualifier holding =filewrite() is not run, on scatter and lpoly"

    // TSO-07: by() with an operated plot variable in any layer is "not
    // sorted", r(5), then dash's hint; a bare sort with an operated x is
    // refused on the 18 types twoway refuses it on, in its two lines,
    // r(198), and drawn on the others and with an operated y.  Each
    // compared with twoway's answer (B and O probes, Y01).
    python: _ts.Macro.setLocal("tso_bo", " ".join(sorted(k for k in _tj.load(open("fixtures/ts_operator_truth.json", encoding="utf-8"))["probes"] if k[0] in "BOY")))
    foreach pid of local tso_bo {
        python: _tq = _tj.load(open("fixtures/ts_operator_truth.json", encoding="utf-8"))["probes"][_ts.Macro.getLocal("pid")]; _ts.Macro.setLocal("tso_b", _tq["body"]); _ts.Macro.setLocal("tso_o", _tq["opts"]); _ts.Macro.setLocal("tso_ds", _tq["ds"])
        if "`tso_ds'" == "xt" {
            clear
            quietly set obs 20
            quietly gen id = ceil(_n / 10)
            quietly gen tt = mod(_n - 1, 10) + 1
            quietly gen y = _n * _n
            quietly xtset id tt
            _tso_tw `pid'
            local twrc = r(rc)
            dash clear
            _p1a_logrun `"dash `tso_b', `tso_o' name(tso07)"'
            assert r(rc) == `twrc'
            continue
        }
        _tso_vs TSO-07 `pid' sp `"dash `tso_b', `tso_o' name(tso07)"'
        if substr("`pid'", 1, 1) == "B" & "`pid'" != "B04" {
            cert_file_has "`c(tmpdir)'dash_p1a_run.log", needle("generate the variable first, for example: generate double dclose = D.close")
            assert r(found)
        }
        if inlist("`pid'", "O01", "O15") {
            cert_file_has "`c(tmpdir)'dash_p1a_run.log", needle("option sort() incorrectly specified")
            assert r(found)
        }
    }
    dash clear
    display "TSO-07 PASS: by() with an operator r(5) with dash's hint; a bare sort with an operated x r(198) on the 18 types, as twoway"

    // TSO-10: a user variable __dasht1 is refused r(110), naming __dasht#.
    _tso_data sp
    quietly gen __dasht1 = 1
    dash clear
    _p1a_logrun `"dash scatter D.close t, saving("`tsopg'", replace)"'
    assert r(rc) == 110
    cert_file_has "`r(log)'", needle("its time-series columns __dasht#")
    assert r(found)
    drop __dasht1
    display "TSO-10 PASS: a variable named __dasht1 is refused r(110), naming the time-series columns"
    foreach f in tso01 tso08b tso08s tso09 tso14 {
        capture erase "`c(tmpdir)'`f'_s.json"
        capture erase "`c(tmpdir)'`f'_d.json"
    }
    capture erase "`tsopg'"
}

// twoway's answers: a question the fixture could not answer, or (with
// DASH_CERT_REMEASURE=1) an answer twoway no longer gives, fails the run.
cert_truth_close
if r(problems) > 0 {
    display as error "TRUTH FAIL: twoway's answers (fixtures/parser_twoway_truth.json): `r(problems)' problem(s)"
    exit 9
}

capture erase "`c(tmpdir)'dash_p1a_run.log"

display ""
display "All syntax-based parser tests PASSED."
