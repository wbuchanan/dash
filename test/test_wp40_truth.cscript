*! test_wp40_truth.cscript
*! WP-40's ONE certification script (.ultraplan/sections/index.md PD-6):
*! every comparison with twoway's drawing or with Stata's own values that
*! WP-40's sections need lives here, one block per GAPS4 row (or per
*! harness tool), appended above the "append new blocks above this line"
*! marker in section order.  Refusal, message and return-code checks join
*! the EXISTING script for their area (merge rule R1).
*!
*! Made from test/templates/wp_truth_template.cscript (40 -> the WP's
*! number).  S00 is the scaffold smoke (Q4000-1).  A section appends
*! `* ==== S<MM> <lead id>: <what> ====` ... `* ==== end S<MM> ====` (or
*! `S<MM> tool: <what>` for a section with no item), its helper programs
*! directly above its first header, and writes only inside its own
*! blocks.  Case ids are Q40<MM>-<k> (PD-5).
*!
*! Usage: via run_all_cscripts.do.  One block alone: WP40_ONLY=S<MM> in
*! the driver's environment.  Each block prints "S<MM> start" and "S<MM>
*! end" with the date and time.  The suite runs it in every session;
*! DASH_CERT_SHARD=k/N runs part k of N of the blocks; a part with no
*! block ends 0.

cscript "WP-40 truth: twoway comparisons" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off


do "cert_helpers.do"
quietly do "cert_svg.do"
qui run "../dash_parse.mata"
qui run "../dash.ado"
global dash_nobrowser 1

// ----------------------------------------------------------------
// Tally helpers -- test_wp29_truth.cscript's _w29_expect/_w29_done,
// renamed _w40_ for this script.  A case is any number of
// _w40_expect lines closed by one _w40_done.
// ----------------------------------------------------------------
global w40_nfail    = 0
global w40_faillist ""
global w40_bad      = 0
global w40_ncase    = 0

capture program drop _w40_expect
program define _w40_expect
    version 19
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global w40_bad = 1
    }
end

capture program drop _w40_done
program define _w40_done
    version 19
    args id msg
    if ${w40_bad} {
        global w40_nfail    = ${w40_nfail} + 1
        global w40_faillist "${w40_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global w40_bad   = 0
    global w40_ncase = ${w40_ncase} + 1
end

// A fresh directory for this run's files, never one that already exists:
// a fixed name in a shared temp directory could be planted by another
// account (rule 1), so a name Stata has not handed out before is made and
// the run fails if it cannot be.  Every block writes only under it.
tempfile w40_base
local w40_work "`w40_base'_w40"
capture mkdir "`w40_work'"
if _rc {
    display as error "test_wp40_truth: cannot create the work directory `w40_work' (rc `=_rc')"
    exit 9
}

// ---- parts: begin (WP-40 test performance) ----
// The certification suite runs this script in every one of its sessions
// (its row in run_all_cscripts.do's shard table is "* * *"); with
// DASH_CERT_SHARD=k/N set, the session runs part k of N of the blocks.
// The parts are balanced longest first onto the least loaded part (the
// lowest numbered of equals), by the seconds below -- a block not listed
// counts 1 s (section-01 D-01.f) -- the rule scripts/cert_shards.py uses
// for the scripts.  Unset, or with WP40_ONLY set
// (which keeps its precedence), every block runs.  A block runs when its
// gate finds its id in w40_run.
// Seconds: each block's start/end lines in the WP's last measured
// certification run, rounded up, at least 1; a block not listed
// counts 1 s.
local w40_secs S00 1 S01 5 S02 19
local w40_sh : environment DASH_CERT_SHARD
mata: st_local("w40_ok", strofreal(st_local("w40_sh") == "" | ustrregexm(st_local("w40_sh"), "^[1-8]/[1-8]$")))
if !`w40_ok' {
    display as error "test_wp40_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 8"
    exit 198
}
local w40_k 1
local w40_N 1
if "`w40_sh'" != "" {
    local w40_k = real(substr("`w40_sh'", 1, 1))
    local w40_N = real(substr("`w40_sh'", 3, 1))
}
local w40_only : env WP40_ONLY
if `"`macval(w40_only)'"' != "" | `w40_N' == 1 {
    local w40_k 1
    local w40_N 1
}
if `w40_k' > `w40_N' {
    display as error "test_wp40_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 8"
    exit 198
}
capture confirm file "test_wp40_truth.cscript"
if _rc {
    display as error "test_wp40_truth: run it from test/, where it reads its own blocks"
    exit 601
}
capture mata: mata drop _w40_part()
mata:
// The ids of the blocks (their header lines, in file order), and those of
// part k of n: longest first onto the least loaded part.
void _w40_part(string scalar file, string scalar table, real scalar k,
               real scalar n)
{
    string colvector lines, ids
    string rowvector tok
    real colvector sec, o, at
    real rowvector load
    real scalar i, j, p, best
    string scalar run

    lines = cat(file)
    ids = J(0, 1, "")
    for (i = 1; i <= rows(lines); i++) {
        if (ustrregexm(lines[i], "^\* ==== (S[0-9]+) ")) {
            if (!anyof(ids, ustrregexs(1))) ids = ids \ ustrregexs(1)
        }
    }
    sec = J(rows(ids), 1, 1)
    tok = tokens(table)
    for (j = 1; j + 1 <= cols(tok); j = j + 2) {
        for (i = 1; i <= rows(ids); i++) {
            if (ids[i] == tok[j]) sec[i] = strtoreal(tok[j + 1])
        }
    }
    o = order((-sec, (1::rows(ids))), (1, 2))
    load = J(1, n, 0)
    at = J(rows(ids), 1, 0)
    for (i = 1; i <= rows(o); i++) {
        best = 1
        for (p = 2; p <= n; p++) if (load[p] < load[best]) best = p
        load[best] = load[best] + sec[o[i]]
        at[o[i]] = best
    }
    run = ""
    for (i = 1; i <= rows(ids); i++) if (at[i] == k) run = run + " " + ids[i]
    st_local("w40_run", strtrim(run))
}
end
// The part this session runs: the runner's shard table may turn the
// parts (cert_helpers.do's cert_split_part, 11nov2026), so that
// each script's longest part lands on a different session.
cert_split_part "test_wp40_truth.cscript" `w40_k' `w40_N'
local w40_p = r(part)
mata: _w40_part("test_wp40_truth.cscript", st_local("w40_secs"), `w40_p', `w40_N')
display as text "test_wp40_truth: session `w40_k'/`w40_N' runs part `w40_p', `: word count `w40_run'' blocks: `w40_run'"
// ---- parts: end ----

* ==== S00 scaffold: the helpers load and a twoway SVG is read ====
local only : env WP40_ONLY
if inlist("`only'", "", "S00") & `: list posof "S00" in w40_run' {
    display as text "S00 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4000-1: cert_svg_export and cert_svg_texts on one twoway scatter,
    // and dash's own programs are loaded from this tree.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(w40s01, replace)
    cert_svg_export, name(w40s01) file("`w40_work'/w40s01.svg")
    local s01_rc   = r(rc)
    local s01_file "`r(file)'"
    _w40_expect Q4000-1 "(`s01_rc' == 0)" "cert_svg_export rc `s01_rc'"
    capture confirm file "`s01_file'"
    _w40_expect Q4000-1 "(_rc == 0)" "r(file) `s01_file' does not exist"
    cert_svg_texts, file("`s01_file'")
    local s01_n    = r(n)
    local s01_list "`r(list)'"
    _w40_expect Q4000-1 "(`s01_n' > 0)" "cert_svg_texts found no text elements"
    capture program list _dash_serve
    _w40_expect Q4000-1 "(_rc == 0)" "dash.ado's _dash_serve is not loaded"
    _w40_done Q4000-1 "a twoway SVG was written and read (`s01_n' texts); dash is loaded"

    capture erase "`s01_file'"
    capture erase "`s01_list'"
    capture graph drop w40s01
    display as text "S00 end " c(current_date) " " c(current_time)
}
* ==== end S00 ====

* ==== S01 plat:PT-7: only the rows the graphs draw are exported ====
local only : env WP40_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w40_run' {
    display as text "S01 start " c(current_date) " " c(current_time)

    // The stand-in renderer (test_wp29_truth.cscript PF-06's method): a
    // dash_render.py first on the ado-path, session-only, that copies the
    // data file dash hands it to <s1d>/data.json and writes --output.  The
    // export itself still runs the shipped module (_dash_xm_load).  The
    // readers: the data file's numberOfRecords, and the Bokeh sources a
    // saved page embeds (test_wp29_truth.cscript's page-JSON reader).
    local s1d "`w40_work'/s01"
    capture mkdir "`s1d'"
    tempname s1h
    file open `s1h' using "`s1d'/dash_render.py", write text replace
    file write `s1h' `"import shutil, sys"' _n
    file write `s1h' `"_a = sys.argv[1:]"' _n
    file write `s1h' `"shutil.copyfile(_a[_a.index("--data") + 1], r"`s1d'/data.json")"' _n
    file write `s1h' `"open(_a[_a.index("--output") + 1], "w", encoding="utf-8").write("x")"' _n
    file close `s1h'
    python:
import json as _s01j
import os as _s01os
import re as _s01re
from sfi import Macro as _s01M


def _s01_find(o):
    if isinstance(o, dict):
        if "numberOfRecords" in o:
            return o["numberOfRecords"]
        o = list(o.values())
    if isinstance(o, list):
        for v in o:
            r = _s01_find(v)
            if r is not None:
                return r
    return None


def _s01_nrec(name):
    """numberOfRecords of the data file the stand-in copied (-1: none),
    into local <name>; the copy is removed after it is read."""
    p = _s01os.path.join(_s01M.getLocal("s1d"), "data.json")
    try:
        with open(p, encoding="utf-8") as fh:
            r = _s01_find(_s01j.load(fh))
        _s01os.remove(p)
    except (OSError, ValueError):
        r = None
    _s01M.setLocal(name, str(-1 if r is None else int(r)))


def _s01_sources(path):
    from bokeh.document import Document
    from bokeh.models import ColumnDataSource
    with open(path, encoding="utf-8") as fh:
        page = fh.read()
    out = []
    for blob in _s01re.findall(r'<script type="application/json" id="[^"]*">\s*(.*?)\s*</script>', page, _s01re.S):
        for dd in _s01j.loads(blob).values():
            for s in Document.from_json(dd).select(dict(type=ColumnDataSource)):
                out.append(dict(s.data))
    return out


def _s01_xlp(path, name):
    """The x_lp counts of every lpoly source on the page, into <name>."""
    n = [len(d["x_lp"]) for d in _s01_sources(path) if "x_lp" in d]
    _s01M.setLocal(name, " ".join(str(k) for k in n))


def _s01_xs(path, name):
    """The distinct x values the page's sources hold, into <name>."""
    xs = set()
    for d in _s01_sources(path):
        for v in d.get("x", []):
            try:
                xs.add(int(round(float(v))))
            except (TypeError, ValueError):
                pass
    _s01M.setLocal(name, " ".join(str(k) for k in sorted(xs)))
end

    // ------------------------------------------------------------
    // Q4001-1: on 200,000 observations twoway draws in 1/100; dash's
    // one-line form exports the 100 rows, by in and by if _n <= 100.
    // Q4001-4: the data in memory are unchanged by it.
    // ------------------------------------------------------------
    clear
    set obs 200000
    gen double y = runiform()
    gen double x = _n
    capture noisily twoway scatter y x in 1/100, nodraw
    local q1tw = _rc
    _w40_expect Q4001-1 "(`q1tw' == 0)" "twoway scatter y x in 1/100 rc `q1tw'"
    quietly datasignature
    local q4sig0 "`r(datasignature)'"
    local q4k0 = c(k)
    local q4ch0 = c(changed)
    adopath ++ "`s1d'"
    capture noisily dash scatter y x in 1/100, saving("`s1d'/q1.html", replace)
    local q1rc = _rc
    python: _s01_nrec("q1n")
    quietly datasignature
    local q4sig1 "`r(datasignature)'"
    _w40_expect Q4001-1 "(`q1rc' == 0)" "dash scatter y x in 1/100 rc `q1rc'"
    _w40_expect Q4001-1 "(`q1n' == 100)" "in 1/100 exported `q1n' rows, not 100"
    capture noisily dash scatter y x if _n <= 100, saving("`s1d'/q1.html", replace)
    local q1rc = _rc
    python: _s01_nrec("q1n")
    _w40_expect Q4001-1 "(`q1rc' == 0)" "dash scatter y x if _n <= 100 rc `q1rc'"
    _w40_expect Q4001-1 "(`q1n' == 100)" "if _n <= 100 exported `q1n' rows, not 100"
    // 35-08's temporary export frame (dash__force_frame, its
    // certification switch): cut there, the same 100 rows.
    global dash__force_frame 1
    capture noisily dash scatter y x in 1/100, saving("`s1d'/q1.html", replace)
    local q1rc = _rc
    global dash__force_frame
    python: _s01_nrec("q1n")
    _w40_expect Q4001-1 "(`q1rc' == 0 & `q1n' == 100)" "in the export frame: rc `q1rc', `q1n' rows, not 100"
    _w40_done Q4001-1 "the one-line form exports the 100 rows in 1/100 and if _n <= 100 draw, of 200,000"
    _w40_expect Q4001-4 `"("`q4sig0'" == "`q4sig1'")"' "the data signature changed: `q4sig0' -> `q4sig1'"
    _w40_expect Q4001-4 "(`q4k0' == c(k))" "c(k) `q4k0' -> `c(k)'"
    _w40_expect Q4001-4 "(`q4ch0' == c(changed))" "c(changed) `q4ch0' -> `c(changed)'"
    _w40_expect Q4001-4 "(_N == 200000)" "_N is `=_N'"
    _w40_done Q4001-4 "the data in memory are unchanged by the one-line command"

    // ------------------------------------------------------------
    // Q4001-2: no qualifier exports every row; a lowess layer with
    // adjust, whose mean reads every observation, keeps every row.
    // ------------------------------------------------------------
    capture noisily dash scatter y x, saving("`s1d'/q2.html", replace)
    local q2rc = _rc
    python: _s01_nrec("q2n")
    _w40_expect Q4001-2 "(`q2rc' == 0 & `q2n' == 200000)" "no qualifier: rc `q2rc', `q2n' rows"
    capture noisily dash lowess y x in 1/100, adjust saving("`s1d'/q2.html", replace)
    local q2rc = _rc
    python: _s01_nrec("q2n")
    _w40_expect Q4001-2 "(`q2rc' == 0 & `q2n' == 200000)" "lowess, adjust: rc `q2rc', `q2n' rows"
    _w40_done Q4001-2 "no qualifier, and lowess with adjust, export all 200,000 rows"

    // ------------------------------------------------------------
    // Q4001-3: a saved build exports the drawn rows; a KPI card,
    // filter(), link(), brush(), csv and a served build export every row.
    // ------------------------------------------------------------
    local q3f "`s1d'/q3.html"
    dash clear
    dash scatter y x in 1/100, name(q3)
    capture noisily dash build, saving("`q3f'", replace) nobrowser
    local q3rc = _rc
    python: _s01_nrec("q3n")
    _w40_expect Q4001-3 "(`q3rc' == 0 & `q3n' == 100)" "a plain build: rc `q3rc', `q3n' rows, not 100"
    global dash__force_frame 1
    capture noisily dash build, saving("`q3f'", replace) nobrowser
    local q3rc = _rc
    global dash__force_frame
    python: _s01_nrec("q3n")
    _w40_expect Q4001-3 "(`q3rc' == 0 & `q3n' == 100)" "a build in the export frame: rc `q3rc', `q3n' rows, not 100"
    local q3i 0
    foreach q3o in kpi filter link brush csv server {
        local ++q3i
        dash clear
        dash scatter y x in 1/100, name(q3)
        dash scatter y x in 101/200, name(q3b)
        local q3opt ""
        if "`q3o'" == "kpi"    dash kpi mean(y), name(k3) title(K3)
        if "`q3o'" == "filter" local q3opt "filter(x)"
        if "`q3o'" == "link"   local q3opt "link(q3 q3b)"
        if "`q3o'" == "brush"  local q3opt "link(q3 q3b) brush(filter)"
        if "`q3o'" == "csv"    local q3opt "csv"
        if "`q3o'" == "server" {
            capture noisily dash build, server saving("`s1d'/q3.py", replace) nobrowser
        }
        else {
            capture noisily dash build, saving("`q3f'", replace) nobrowser `q3opt'
        }
        local q3rc = _rc
        python: _s01_nrec("q3n")
        _w40_expect Q4001-3 "(`q3rc' == 0 & `q3n' == 200000)" "`q3o': rc `q3rc', `q3n' rows, not 200,000"
    }
    _w40_done Q4001-3 "a plain build exports the 100 drawn rows; a KPI, filter(), link(), brush(), csv and a served build export all 200,000"
    dash clear

    // ------------------------------------------------------------
    // Q4001-5: two graphs' rows are the union: 20 of 1,000 exported;
    // the shipped renderer's page holds x 1..10 and 991..1000.
    // ------------------------------------------------------------
    clear
    set obs 1000
    gen double y = runiform()
    gen double x = _n
    dash scatter y x in 1/10, name(a)
    dash scatter y x in 991/1000, name(b)
    capture noisily dash build, saving("`s1d'/q5.html", replace) nobrowser
    local q5rc = _rc
    python: _s01_nrec("q5n")
    _w40_expect Q4001-5 "(`q5rc' == 0 & `q5n' == 20)" "stand-in: rc `q5rc', `q5n' rows, not 20"
    adopath - "`s1d'"
    capture erase "`s1d'/q5s.html"
    capture noisily dash build, saving("`s1d'/q5s.html", replace) nobrowser
    local q5rc = _rc
    local q5x ""
    if `q5rc' == 0 python: _s01_xs(r"`s1d'/q5s.html", "q5x")
    local q5want ""
    forvalues i = 1/10 {
        local q5want `q5want' `i'
    }
    forvalues i = 991/1000 {
        local q5want `q5want' `i'
    }
    _w40_expect Q4001-5 `"(`q5rc' == 0 & "`q5x'" == "`q5want'")"' "shipped: rc `q5rc', x values `q5x'"
    _w40_done Q4001-5 "two graphs export the 20 rows they draw, and the page holds x 1..10 and 991..1000"
    dash clear
    adopath ++ "`s1d'"

    // ------------------------------------------------------------
    // Q4001-6 (R3-7): a literal by() graph's panels read its by()
    // variable's rows: in 1/10 (all domestic) beside function, by(foreign)
    // exports every car, so both panels are drawn as twoway draws them.
    // ------------------------------------------------------------
    sysuse auto, clear
    capture noisily twoway function y = x, by(foreign) nodraw
    local q6tw = _rc
    dash scatter mpg weight in 1/10, name(s6)
    dash function y = x, by(foreign) name(f6)
    capture noisily dash build, saving("`s1d'/q6.html", replace) nobrowser
    local q6rc = _rc
    python: _s01_nrec("q6n")
    _w40_expect Q4001-6 "(`q6tw' == 0)" "twoway function, by(foreign) rc `q6tw'"
    _w40_expect Q4001-6 "(`q6rc' == 0 & `q6n' == 74)" "rc `q6rc', `q6n' rows, not 74"
    _w40_done Q4001-6 "a literal by() graph keeps its panels' rows: 74 exported"
    dash clear
    adopath - "`s1d'"

    // ------------------------------------------------------------
    // Q4001-7: _dash_sel_mark's rule, case by case, on six rows.
    // ------------------------------------------------------------
    clear
    set obs 6
    gen byte q1 = _n <= 2
    gen byte q2 = _n >= 5
    gen byte t1 = _n == 3
    gen byte m = 0
    local q7j1 `"{"plots":[{"type":"scatter","qual_col":"q1"}],"graph_options":{}}"'
    local q7w1 "_n <= 2"
    local q7j2 `"{"plots":[{"type":"scatter"}],"graph_options":{},"qual_col":"q2"}"'
    local q7w2 "_n >= 5"
    local q7j3 `"{"plots":[{"type":"scatter","qual_col":"q1"}],"graph_options":{},"qual_col":"q2"}"'
    local q7w3 "0"
    local q7j4 `"{"plots":[{"type":"scatter","qual_col":"q1"}],"graph_options":{},"qual_col_total":"t1"}"'
    local q7w4 "_n <= 2"
    local q7j5 `"{"plots":[{"type":"scatter"}],"graph_options":{},"qual_col":"q1","qual_col_total":"t1"}"'
    local q7w5 "_n <= 3"
    local q7j6 `"{"plots":[{"type":"function","expr":"x"}],"graph_options":{}}"'
    local q7w6 "0"
    local q7j7 `"{"plots":[{"type":"function","expr":"x"}],"graph_options":{"by":"foreign"},"qual_col":"q2"}"'
    local q7w7 "_n >= 5"
    local q7j8 `"{"plots":[{"type":"lowess","options":{"adjust":"adjust"},"qual_col":"q1"}],"graph_options":{}}"'
    local q7w8 "1"
    local q7j9 `"{"plots":[{"type":"lowess","options":{},"qual_col":"q1"}],"graph_options":{}}"'
    local q7w9 "_n <= 2"
    // Case 10 (WP-40 WE, test_wp29_truth ER-02): under by() a graph marks
    // its G rows beside its plots' -- twoway draws a by() group's panel
    // when no plot has a row in it.
    local q7j10 `"{"plots":[{"type":"scatter","qual_col":"q1"}],"graph_options":{"by":"foreign"},"qual_col":"q2"}"'
    local q7w10 "_n >= 5"
    forvalues i = 1/10 {
        quietly replace m = 0
        capture mata: _dash_sel_mark("m", st_local("q7j`i'"))
        local q7rc = _rc
        quietly count if m != (`q7w`i'')
        _w40_expect Q4001-7 "(`q7rc' == 0 & r(N) == 0)" "case `i': rc `q7rc', `r(N)' rows differ from `q7w`i''"
    }
    _w40_done Q4001-7 "_dash_sel_mark marks the rows each graph draws (ten cases)"

    // ------------------------------------------------------------
    // Q4001-8 (shipped renderer): lpoly's grid follows the graph's _N:
    // 50 points over the 22 foreign cars, as twoway draws it.  The page
    // holds the grid points that have a neighbour, so a bandwidth wider
    // than the data makes its x_lp count the grid's (Q4001-9 too).
    // ------------------------------------------------------------
    sysuse auto, clear
    capture noisily twoway lpoly mpg weight if foreign == 1, bwidth(5000) nodraw
    local q8tw = _rc
    capture erase "`s1d'/q8.html"
    capture noisily dash lpoly mpg weight if foreign == 1, bwidth(5000) saving("`s1d'/q8.html", replace)
    local q8rc = _rc
    local q8n ""
    if `q8rc' == 0 python: _s01_xlp(r"`s1d'/q8.html", "q8n")
    _w40_expect Q4001-8 "(`q8tw' == 0)" "twoway lpoly rc `q8tw'"
    _w40_expect Q4001-8 `"(`q8rc' == 0 & "`q8n'" == "50")"' "rc `q8rc', x_lp counts `q8n', not 50"
    _w40_done Q4001-8 "dash lpoly mpg weight if foreign == 1 draws 50 grid points over 22 cars"

    // ------------------------------------------------------------
    // Q4001-9 (shipped renderer; 33-07's stack): a graph of a 22-row
    // frame draws 22 grid points, its own frame's _N, not 50 from the
    // 96 stacked rows.
    // ------------------------------------------------------------
    sysuse auto, clear
    capture frame drop q9f
    frame create q9f
    frame q9f: sysuse auto, clear
    frame q9f: keep if foreign == 1
    dash clear
    frame q9f: dash lpoly mpg weight, bwidth(5000) name(q9f)
    dash scatter mpg weight, name(q9a)
    capture erase "`s1d'/q9.html"
    capture noisily dash build, saving("`s1d'/q9.html", replace) nobrowser
    local q9rc = _rc
    local q9n ""
    if `q9rc' == 0 python: _s01_xlp(r"`s1d'/q9.html", "q9n")
    frame q9f: lpoly mpg weight, bwidth(5000) nograph generate(q9x q9y)
    frame q9f: quietly count if !missing(q9x)
    local q9tw = r(N)
    _w40_expect Q4001-9 `"(`q9rc' == 0 & "`q9n'" == "`q9tw'" & `q9tw' == 22)"' "rc `q9rc', x_lp counts `q9n', lpoly's grid `q9tw'"
    _w40_done Q4001-9 "a 22-row frame's lpoly in a stack draws 22 grid points, as lpoly makes"
    frame drop q9f
    dash clear

    // ------------------------------------------------------------
    // Q4001-10: _dash_put_n_obs appends the graph's _N.
    // ------------------------------------------------------------
    local q10a `"{"plots":[]}"'
    local q10b `"{"plots":[]} "'
    local q10w `"{"plots":[],"n_obs":74}"'
    foreach q10 in q10a q10b {
        local q10r ""
        capture mata: st_local("q10r", _dash_put_n_obs(st_local("`q10'"), 74))
        _w40_expect Q4001-10 `"(_rc == 0 & `"`q10r'"' == `"`q10w'"')"' `"`q10': got `q10r'"'
    }
    capture mata: _dash_put_n_obs("abc", 1)
    _w40_expect Q4001-10 "(_rc == 3498)" "abc: rc `=_rc', not 3498"
    _w40_done Q4001-10 "_dash_put_n_obs appends n_obs and refuses JSON that does not end in }"

    python: import shutil as _s01sh; _s01sh.rmtree(_s01M.getLocal("s1d"), True)
    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====

// ----------------------------------------------------------------
// S02's helper (section 40-02): _w40_s02_run <log> <cmd> runs the dash
// command <cmd> under capture noisily with its output logged to <log>,
// sets c_local s02rc to its return code; _w40_s02_log <log> <needle> sets
// c_local s02c to the number of logical lines of <log> holding <needle>.
// ----------------------------------------------------------------
capture program drop _w40_s02_run
program define _w40_s02_run
    version 19
    gettoken logf 0 : 0
    capture log close s02l
    quietly log using "`logf'", text replace name(s02l) nomsg
    capture noisily `0'
    local rc = _rc
    quietly log close s02l
    c_local s02rc = `rc'
end
capture program drop _w40_s02_log
program define _w40_s02_log
    version 19
    cert_log_has "`1'", needle(`"`2'"')
    c_local s02c = r(count)
end

* ==== S02 plat:PT-8: no size cap, count caps ====
local only : env WP40_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w40_run' {
    display as text "S02 start " c(current_date) " " c(current_time)
    local s02d "`w40_work'/s02"
    capture mkdir "`s02d'"

    // ------------------------------------------------------------
    // Q4002-1 (plat:PT-8): 10,001 reference lines and 1,001 added texts
    // draw in twoway; dash refuses each with r(134), naming its limit
    // and global.  One xline() of 10,001 positions is refused by twoway
    // itself ("invalid line argument", r(198), measured 30oct2026), so
    // the positions are given in five xline() options.
    // ------------------------------------------------------------
    sysuse auto, clear
    local q1x "xline(1(1)2000) xline(2001(1)4000) xline(4001(1)6000) xline(6001(1)8000) xline(8001(1)10001)"
    capture noisily twoway scatter mpg weight, `q1x' nodraw
    local q1_trc = _rc
    _w40_expect Q4002-1 "(`q1_trc' == 0)" "twoway 10,001 xline() positions rc `q1_trc'"
    capture erase "`s02d'/q1a.html"
    _w40_s02_run "`s02d'/q1a.log" dash scatter mpg weight, `q1x' saving("`s02d'/q1a.html", replace)
    _w40_expect Q4002-1 "(`s02rc' == 134)" "dash 10,001 xline() positions rc `s02rc'"
    _w40_s02_log "`s02d'/q1a.log" "more than the 10,000"
    _w40_expect Q4002-1 "(`s02c' == 1)" "the refusal does not name 10,000"
    _w40_s02_log "`s02d'/q1a.log" "dash_max_reflines"
    _w40_expect Q4002-1 "(`s02c' == 1)" "the refusal does not name dash_max_reflines"
    local q1t ""
    forvalues i = 1/1001 {
        local q1t `"`q1t' 20 2000 "a""'
    }
    capture noisily twoway scatter mpg weight, text(`q1t') nodraw
    local q1_trc = _rc
    _w40_expect Q4002-1 "(`q1_trc' == 0)" "twoway 1,001 text() points rc `q1_trc'"
    capture erase "`s02d'/q1b.html"
    _w40_s02_run "`s02d'/q1b.log" dash scatter mpg weight, text(`q1t') saving("`s02d'/q1b.html", replace)
    _w40_expect Q4002-1 "(`s02rc' == 134)" "dash 1,001 text() points rc `s02rc'"
    _w40_s02_log "`s02d'/q1b.log" "more than the 1,000"
    _w40_expect Q4002-1 "(`s02c' == 1)" "the refusal does not name 1,000"
    _w40_s02_log "`s02d'/q1b.log" "dash_max_added_text"
    _w40_expect Q4002-1 "(`s02c' == 1)" "the refusal does not name dash_max_added_text"
    _w40_done Q4002-1 "10,001 reference lines and 1,001 texts: twoway draws, dash r(134) naming each limit"

    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

* ==== S02 plat:PT-9: plots, not variables ====
local only : env WP40_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w40_run' {
    display as text "S02 start " c(current_date) " " c(current_time)
    local s02d "`w40_work'/s02"
    capture mkdir "`s02d'"

    // ------------------------------------------------------------
    // Q4002-2 (plat:PT-9): twoway counts the variables of one plot (100,
    // x included), dash the plots of a graph (100 at the default).
    // ------------------------------------------------------------
    sysuse auto, clear
    forvalues i = 1/120 {
        quietly generate y`i' = mpg + `i'
    }
    capture noisily twoway scatter y1-y100 weight, nodraw
    local q2_trc = _rc
    _w40_expect Q4002-2 "(`q2_trc' == 103)" "twoway scatter y1-y100 weight rc `q2_trc'"
    capture erase "`s02d'/q2a.html"
    _w40_s02_run "`s02d'/q2a.log" dash scatter y1-y100 weight, saving("`s02d'/q2a.html", replace)
    _w40_expect Q4002-2 "(`s02rc' == 0)" "dash scatter y1-y100 weight rc `s02rc'"
    capture noisily twoway (scatter y1-y60 weight) (scatter y61-y120 weight), nodraw
    local q2_trc = _rc
    _w40_expect Q4002-2 "(`q2_trc' == 0)" "twoway 60 + 60 plots rc `q2_trc'"
    capture erase "`s02d'/q2b.html"
    _w40_s02_run "`s02d'/q2b.log" dash (scatter y1-y60 weight) (scatter y61-y120 weight), saving("`s02d'/q2b.html", replace)
    _w40_expect Q4002-2 "(`s02rc' == 134)" "dash 60 + 60 plots rc `s02rc'"
    _w40_s02_log "`s02d'/q2b.log" "dash_max_plots"
    _w40_expect Q4002-2 "(`s02c' == 1)" "the refusal does not name dash_max_plots"
    _w40_done Q4002-2 "y1-y100: twoway r(103), dash draws; 60 + 60 plots: twoway draws, dash r(134)"
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

* ==== S02 plat:PT-10: by() groups ====
local only : env WP40_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w40_run' {
    display as text "S02 start " c(current_date) " " c(current_time)
    local s02d "`w40_work'/s02"
    capture mkdir "`s02d'"

    // ------------------------------------------------------------
    // Q4002-3 (plat:PT-10): 120 by() groups of two rows each; twoway
    // draws 120 panels, dash the first 100 with a note naming
    // $dash_max_by_groups.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly expand 4
    quietly keep in 1/240
    generate g = mod(_n, 120)
    capture graph drop q4002g
    capture noisily twoway scatter mpg weight, by(g) nodraw name(q4002g)
    local q3_trc = _rc
    _w40_expect Q4002-3 "(`q3_trc' == 0)" "twoway by(g) rc `q3_trc'"
    local q3_np = 0`.q4002g.graphs.arrnels'
    _w40_expect Q4002-3 "(`q3_np' == 120)" "twoway drew `q3_np' panels, not 120"
    capture graph drop q4002g
    capture erase "`s02d'/q3.html"
    _w40_s02_run "`s02d'/q3.log" dash scatter mpg weight, by(g) saving("`s02d'/q3.html", replace)
    _w40_expect Q4002-3 "(`s02rc' == 0)" "dash by(g) rc `s02rc'"
    _w40_s02_log "`s02d'/q3.log" "has 120 groups, more than the 100 one graph draws"
    _w40_expect Q4002-3 "(`s02c' == 1)" "no note that 100 of 120 groups are drawn"
    _w40_s02_log "`s02d'/q3.log" "dash_max_by_groups"
    _w40_expect Q4002-3 "(`s02c' == 1)" "the note does not name dash_max_by_groups"
    _w40_done Q4002-3 "120 by() groups: twoway draws 120 panels, dash 100 with a note"
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

* ==== S02 stat:PT-15: n() and bin() bounds ====
local only : env WP40_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w40_run' {
    display as text "S02 start " c(current_date) " " c(current_time)
    local s02d "`w40_work'/s02"
    capture mkdir "`s02d'"

    // ------------------------------------------------------------
    // Q4002-4 (stat:PT-15): n() above 10,000 on a type with dash's bound
    // (kdensity) and bin() above 1,000 draw in twoway and are refused by
    // dash, r(198); mspline's n() above 300 is refused by both; the types
    // whose n() rule has no upper bound (lfit, fpfitci) take n(20000) as
    // twoway does.  35-03 lifted lfit's bound, so kdensity stands in for
    // the plan's lfit.
    // ------------------------------------------------------------
    sysuse auto, clear
    local q4i 0
    foreach q4c in "kdensity mpg, n(20000)" "histogram mpg, bin(2000)" "mspline mpg weight, n(301)" "lfit mpg weight, n(20000)" "fpfitci mpg weight, n(20000)" {
        local ++q4i
        capture noisily twoway `q4c' nodraw
        local q4_trc = _rc
        capture erase "`s02d'/q4_`q4i'.html"
        _w40_s02_run "`s02d'/q4_`q4i'.log" dash `q4c' saving("`s02d'/q4_`q4i'.html", replace)
        if `q4i' <= 2 {
            _w40_expect Q4002-4 "(`q4_trc' == 0)" "twoway `q4c' rc `q4_trc'"
            _w40_expect Q4002-4 "(`s02rc' == 198)" "dash `q4c' rc `s02rc'"
        }
        else if `q4i' == 3 {
            _w40_expect Q4002-4 "(`q4_trc' == 198)" "twoway `q4c' rc `q4_trc'"
            _w40_expect Q4002-4 "(`s02rc' == 198)" "dash `q4c' rc `s02rc'"
        }
        else {
            _w40_expect Q4002-4 "(`q4_trc' == 0)" "twoway `q4c' rc `q4_trc'"
            _w40_expect Q4002-4 "(`s02rc' == `q4_trc')" "dash `q4c' rc `s02rc', twoway `q4_trc'"
        }
    }
    _w40_s02_log "`s02d'/q4_1.log" "dash evaluates up to 10000"
    _w40_expect Q4002-4 "(`s02c' == 1)" "the n() refusal does not give dash's bound"
    _w40_s02_log "`s02d'/q4_2.log" "dash draws up to 1000 bins"
    _w40_expect Q4002-4 "(`s02c' == 1)" "the bin() refusal does not give dash's bound"
    _w40_done Q4002-4 "kdensity n(20000), bin(2000): twoway draws, dash r(198); mspline n(301) r(198) in both; lfit and fpfitci n(20000) draw in both"
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

* ==== S02 sil:SD-1: histogram bins ====
local only : env WP40_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w40_run' {
    display as text "S02 start " c(current_date) " " c(current_time)
    local s02d "`w40_work'/s02"
    capture mkdir "`s02d'"

    // ------------------------------------------------------------
    // Q4002-5 (sil:SD-1): histogram price, discrete needs 12,616 bins of
    // its width, empty ones counted; twoway draws the 74 that hold
    // observations (twoway__histogram_gen's bins), and with width(10) 68;
    // dash squeezes discrete into 1,000 bars and drops width(10), each
    // with a note.
    // ------------------------------------------------------------
    sysuse auto, clear
    capture noisily twoway histogram price, discrete nodraw
    local q5_trc = _rc
    _w40_expect Q4002-5 "(`q5_trc' == 0)" "twoway histogram price, discrete rc `q5_trc'"
    foreach q5o in discrete "width(10)" {
        capture drop q5h q5x
        quietly twoway__histogram_gen price, `q5o' generate(q5h q5x)
        quietly count if !missing(q5h)
        local q5n = r(N)
        local q5want = cond("`q5o'" == "discrete", 74, 68)
        _w40_expect Q4002-5 "(`q5n' == `q5want')" "twoway's `q5o' bins: `q5n', not `q5want'"
    }
    capture drop q5h q5x
    capture erase "`s02d'/q5a.html"
    _w40_s02_run "`s02d'/q5a.log" dash histogram price, discrete saving("`s02d'/q5a.html", replace)
    _w40_expect Q4002-5 "(`s02rc' == 0)" "dash histogram price, discrete rc `s02rc'"
    _w40_s02_log "`s02d'/q5a.log" "histogram discrete needs 12616 bins, more than the 1000 limit; using 1000 bins"
    _w40_expect Q4002-5 "(`s02c' == 1)" "no rebinning note for discrete"
    capture erase "`s02d'/q5b.html"
    _w40_s02_run "`s02d'/q5b.log" dash histogram price, width(10) saving("`s02d'/q5b.html", replace)
    _w40_expect Q4002-5 "(`s02rc' == 0)" "dash histogram price, width(10) rc `s02rc'"
    _w40_s02_log "`s02d'/q5b.log" "would need more than 1000 bins"
    _w40_expect Q4002-5 "(`s02c' == 1)" "no note that width(10) is dropped"
    _w40_done Q4002-5 "price discrete: twoway 74 bars, dash 1,000 with a note; width(10): twoway 68, dash drops it with a note"
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

* ==== S02 AX-16: ticks ====
local only : env WP40_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w40_run' {
    display as text "S02 start " c(current_date) " " c(current_time)
    local s02d "`w40_work'/s02"
    capture mkdir "`s02d'"

    // ------------------------------------------------------------
    // Q4002-6 (AX-16): xtick(1500(1)5000) asks for 3,501 ticks; twoway
    // draws them, dash keeps the default ticks with a note.  #N above
    // 2,000 is taken as 2,000 with no note.
    // ------------------------------------------------------------
    sysuse auto, clear
    capture noisily twoway scatter mpg weight, xtick(1500(1)5000) nodraw
    local q6_trc = _rc
    _w40_expect Q4002-6 "(`q6_trc' == 0)" "twoway xtick(1500(1)5000) rc `q6_trc'"
    capture erase "`s02d'/q6a.html"
    _w40_s02_run "`s02d'/q6a.log" dash scatter mpg weight, xtick(1500(1)5000) saving("`s02d'/q6a.html", replace)
    _w40_expect Q4002-6 "(`s02rc' == 0)" "dash xtick(1500(1)5000) rc `s02rc'"
    _w40_s02_log "`s02d'/q6a.log" "asks for more than 2,000 ticks"
    _w40_expect Q4002-6 "(`s02c' == 1)" "no note on the 3,501 ticks"
    capture noisily twoway scatter mpg weight, xlabel(#3000) nodraw
    local q6_trc = _rc
    _w40_expect Q4002-6 "(`q6_trc' == 0)" "twoway xlabel(#3000) rc `q6_trc'"
    capture erase "`s02d'/q6b.html"
    _w40_s02_run "`s02d'/q6b.log" dash scatter mpg weight, xlabel(#3000) saving("`s02d'/q6b.html", replace)
    _w40_expect Q4002-6 "(`s02rc' == 0)" "dash xlabel(#3000) rc `s02rc'"
    _w40_s02_log "`s02d'/q6b.log" "2,000"
    _w40_expect Q4002-6 "(`s02c' == 0)" "xlabel(#3000) printed a note on 2,000 ticks"
    _w40_done Q4002-6 "3,501 ticks: twoway draws, dash keeps the default with a note; #3000 taken silently"
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

* ==== S02 sil:SD-11: marker size ====
local only : env WP40_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w40_run' {
    display as text "S02 start " c(current_date) " " c(current_time)
    local s02d "`w40_work'/s02"
    capture mkdir "`s02d'"

    // ------------------------------------------------------------
    // Q4002-7 (sil:SD-11): msize(1500) draws in twoway; dash draws the
    // scheme's default size with a note naming msize().
    // ------------------------------------------------------------
    sysuse auto, clear
    capture noisily twoway scatter mpg weight, msize(1500) nodraw
    local q7_trc = _rc
    _w40_expect Q4002-7 "(`q7_trc' == 0)" "twoway msize(1500) rc `q7_trc'"
    capture erase "`s02d'/q7.html"
    _w40_s02_run "`s02d'/q7.log" dash scatter mpg weight, msize(1500) saving("`s02d'/q7.html", replace)
    _w40_expect Q4002-7 "(`s02rc' == 0)" "dash msize(1500) rc `s02rc'"
    _w40_s02_log "`s02d'/q7.log" "msize(1500)"
    _w40_expect Q4002-7 "(`s02c' >= 1)" "no note naming msize(1500)"
    _w40_s02_log "`s02d'/q7.log" "using the scheme's default"
    _w40_expect Q4002-7 "(`s02c' == 1)" "the note does not say the default is drawn"
    _w40_done Q4002-7 "msize(1500): twoway draws it, dash draws the default with a note"
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

* ==== S02 sil:SD-13: long text ====
local only : env WP40_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w40_run' {
    display as text "S02 start " c(current_date) " " c(current_time)
    local s02d "`w40_work'/s02"
    capture mkdir "`s02d'"

    // ------------------------------------------------------------
    // Q4002-8 (sil:SD-13): a text() whose global expands to 4,100
    // characters draws in twoway; dash refuses it, r(198), "text():
    // expanded text is too long".  The \$ keeps the global unexpanded
    // until the command reads it.  (Its value typed in the line, already
    // expanded, is no global for dash to expand: Q4002-9 draws it.)
    // ------------------------------------------------------------
    sysuse auto, clear
    global w40q8 = "a" * 4100
    capture noisily twoway scatter mpg weight, text(30 3000 "\$w40q8") nodraw
    local q8_trc = _rc
    _w40_expect Q4002-8 "(`q8_trc' == 0)" "twoway text() of 4,100 characters rc `q8_trc'"
    capture erase "`s02d'/q8.html"
    // Not through _w40_s02_run, whose `0' would expand the global
    // before dash reads it.
    capture log close s02l
    quietly log using "`s02d'/q8.log", text replace name(s02l) nomsg
    capture noisily dash scatter mpg weight, text(30 3000 "\$w40q8") saving("`s02d'/q8.html", replace)
    local s02rc = _rc
    quietly log close s02l
    _w40_expect Q4002-8 "(`s02rc' == 198)" "dash text() of 4,100 characters rc `s02rc'"
    _w40_s02_log "`s02d'/q8.log" "text(): expanded text is too long"
    _w40_expect Q4002-8 "(`s02c' == 1)" "no 'expanded text is too long' refusal"
    macro drop w40q8
    _w40_done Q4002-8 "a 4,100-character global in text(): twoway draws, dash r(198)"

    // ------------------------------------------------------------
    // Q4002-9: a text() typed in the line, of 4,100 characters or of 65
    // lines, draws in twoway (rc 0) and in dash, with no note that an
    // added text was not drawn.  The local expands before either
    // command reads the line, so each sees the text typed.
    // ------------------------------------------------------------
    sysuse auto, clear
    local q9a = "a" * 4100
    local q9l ""
    forvalues i = 1/65 {
        local q9l `"`q9l' "l`i'""'
    }
    local q9k 0
    foreach q9t in a l {
        local ++q9k
        if "`q9t'" == "a" local q9s `""`q9a'""'
        else local q9s `"`q9l'"'
        capture noisily twoway scatter mpg weight, text(30 3000 `q9s') nodraw
        local q9_trc = _rc
        _w40_expect Q4002-9 "(`q9_trc' == 0)" "twoway typed text() `q9t' rc `q9_trc'"
        capture erase "`s02d'/q9`q9k'.html"
        _w40_s02_run "`s02d'/q9`q9k'.log" dash scatter mpg weight, text(30 3000 `q9s') saving("`s02d'/q9`q9k'.html", replace)
        _w40_expect Q4002-9 "(`s02rc' == 0)" "dash typed text() `q9t' rc `s02rc'"
        _w40_s02_log "`s02d'/q9`q9k'.log" "not drawn"
        _w40_expect Q4002-9 "(`s02c' == 0)" "dash typed text() `q9t' noted as not drawn"
    }
    _w40_done Q4002-9 "a typed text() of 4,100 characters or 65 lines draws in both"
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

* ==== append new blocks above this line ====

// ----------------------------------------------------------------
// Summary (test_wp29_truth.cscript's shape)
// ----------------------------------------------------------------
capture graph drop _all
capture dash clear
capture rmdir "`w40_work'"
local nfail    = ${w40_nfail}
local faillist "${w40_faillist}"
local ncase    = ${w40_ncase}
local only : env WP40_ONLY
macro drop w40_nfail w40_faillist w40_bad w40_ncase
display as text ""
display as text "============================================================"
if `ncase' == 0 {
    if `w40_N' > 1 & `"`macval(only)'"' == "" & "`w40_run'" == "" {
        display as text "test_wp40_truth: part `w40_k'/`w40_N' has no block to run"
        display as text "============================================================"
        exit 0
    }
    // A WP40_ONLY that names no block, or only a stub, ran nothing:
    // that is not a pass.
    display as error "  test_wp40_truth: no case ran (WP40_ONLY=`only')"
    display as text "============================================================"
    exit 9
}
else if `nfail' == 0 {
    display as text "  test_wp40_truth: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_wp40_truth: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
