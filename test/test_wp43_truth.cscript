// S05 helpers (WP-43 43-05).  _q4305_docs: the figures a registered
// graph draws, saved and served (spec and data from _dash_serve_spec);
// _q4305_model: the model drawing a title-family key's text;
// _q4305_box: the box fill and line of that model against
// title_box_truth.json's probe <case> (the smallest filled and stroked
// rects holding the text), into globals q4305_s and q4305_v.
python:
import os as _q4305_os, sys as _q4305_sys, json as _q4305_json
for _q4305_p in (_q4305_os.path.abspath(".."),
                 _q4305_os.path.abspath(_q4305_os.path.join("..", "scripts"))):
    if _q4305_p not in _q4305_sys.path:
        _q4305_sys.path.insert(0, _q4305_p)
with open(_q4305_os.path.join("fixtures", "title_box_truth.json"),
          encoding="utf-8") as _q4305_fh:
    _q4305_T = _q4305_json.load(_q4305_fh)


def _q4305_docs(sp, dp, app):
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_q4305_app")
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_q4305_app.py",
                     "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    sv = [m for m in doc.models if type(m).__name__ == "figure"]
    return list(r.figures.values()), sv


def _q4305_model(fig, key):
    if key == "title" and fig.title is not None:
        return fig.title
    for side in ("center", "above", "below", "left", "right"):
        for m in getattr(fig, side):
            if key in list(getattr(m, "tags", None) or []):
                return m
    return None


def _q4305_svg_box(case, text):
    row = _q4305_T[case]
    t = [x for x in row["texts"] if x["text"] == text][0]
    holds = [r for r in row["rects"]
             if r["x"] <= t["x"] <= r["x"] + r["w"]
             and r["y"] - 1 <= t["y"] <= r["y"] + r["h"] + 1
             and r["w"] < row["viewbox"][2] / 2]
    f = min([r for r in holds if "fill:none" not in r["style"]],
            key=lambda r: r["w"])
    s = min([r for r in holds if "stroke:#" in r["style"]],
            key=lambda r: r["w"])

    def part(style, name):
        for kv in style.split(";"):
            if kv.startswith(name + ":"):
                return kv.split(":", 1)[1].lower()
        return None
    return part(f["style"], "fill"), part(s["style"], "stroke")


def _q4305_box(sp, dp, app, key, text, case):
    from sfi import Macro
    fill, stroke = _q4305_svg_box(case, text)
    a, b = _q4305_docs(sp, dp, app)
    for figs, sfx in ((a, "s"), (b, "v")):
        m = _q4305_model(figs[0], key) if len(figs) == 1 else None
        if m is None:
            Macro.setGlobal("q4305_" + sfx, "no model")
            continue
        got = (str(m.background_fill_color).lower(),
               str(m.border_line_color).lower())
        Macro.setGlobal("q4305_" + sfx, "ok" if got == (fill, stroke) else
                        "drawn %s, twoway %s" % (got, (fill, stroke)))
end

* ==== S05 LT-8: title boxes in the scheme's textbox fill and line ====
local only : env WP43_ONLY
if inlist("`only'", "", "S05") & `: list posof "S05" in w43_run' {
    display as text "S05 start " c(current_date) " " c(current_time)
    local q5d "`w43_work'/s05"
    capture mkdir "`q5d'"
    capture graph drop _all
    sysuse auto, clear

    // ------------------------------------------------------------
    // Q4305-1: title(), subtitle(), note() and caption() with box, under
    // stcolor and s2color, are filled and lined as twoway draws them
    // (title_box_truth.json box_<key>_<scheme>), saved and served.
    // ------------------------------------------------------------
    foreach s in stcolor s2color {
        foreach k in title subtitle note caption {
            local t = upper(substr("`k'", 1, 1))
            dash clear
            capture noisily dash scatter mpg weight, `k'("`t'", box) scheme(`s') name(q4305a)
            local rc = _rc
            _w43_expect Q4305-1 "(`rc' == 0)" "`k' `s': rc `rc'"
            if `rc' == 0 {
                capture erase "`q5d'/a.py"
                _dash_serve_spec, specpath("`q5d'/s.json") datapath("`q5d'/d.json")
                python: _q4305_box("`q5d'/s.json", "`q5d'/d.json", "`q5d'/a.py", "`k'", "`t'", "box_`k'_`s'")
                foreach m in s v {
                    _w43_expect Q4305-1 `"("${q4305_`m'}" == "ok")"' "`k' `s' `m': ${q4305_`m'}"
                }
            }
        }
    }
    _w43_done Q4305-1 "title-family boxes take their text box style's fill and line, saved and served"

    local q5f : dir "`q5d'" files "*"
    foreach f of local q5f {
        capture erase "`q5d'/`f'"
    }
    capture rmdir "`q5d'"
    capture graph drop _all
    dash clear
    macro drop q4305_*
    display as text "S05 end " c(current_date) " " c(current_time)
}
* ==== end S05 ====

// S05 LT-9 helper: _q4305_order -- in both modes, the model tagged
// <outer> (or the Legend, "legend") lies further out on panel <side>
// than the one tagged <inner>, as the probe <case> of title_box_truth.json
// measured; "center" for <outer> asks that the Legend be inside the plot.
python:
def _q4305_order(sp, dp, app, side, outer, inner):
    from sfi import Macro
    a, b = _q4305_docs(sp, dp, app)

    def at(panel, key):
        for i, m in enumerate(panel):
            if key == "legend" and type(m).__name__ == "Legend":
                return i
            if key in list(getattr(m, "tags", None) or []):
                return i
        return None
    for figs, sfx in ((a, "s"), (b, "v")):
        f = figs[0]
        if outer == "center":
            ok = any(type(m).__name__ == "Legend" for m in f.center)
            Macro.setGlobal("q4305_" + sfx, "ok" if ok else "legend not inside")
            continue
        panel = list(getattr(f, side))
        i, j = at(panel, outer), at(panel, inner)
        ok = i is not None and j is not None and i > j
        Macro.setGlobal("q4305_" + sfx, "ok" if ok else
                        "%s at %s, %s at %s" % (outer, i, inner, j))
end

* ==== S05 LT-9: real-valued rings ====
local only : env WP43_ONLY
if inlist("`only'", "", "S05") & `: list posof "S05" in w43_run' {
    display as text "S05 start " c(current_date) " " c(current_time)
    local q5d "`w43_work'/s05"
    capture mkdir "`q5d'"
    capture graph drop _all
    sysuse auto, clear

    // ------------------------------------------------------------
    // Q4305-2: subtitle("S", ring(7.5)), ring(100) and ring(101) draw S
    // outside T, as twoway draws them (title_box_truth.json ring_75,
    // ring_100, ring_101), saved and served; t1title("E", ring(7.5)) is
    // outside the title too.
    // ------------------------------------------------------------
    foreach r in 7.5 100 101 {
        dash clear
        capture noisily dash scatter mpg weight, title("T") subtitle("S", ring(`r')) name(q4305b)
        local rc = _rc
        _w43_expect Q4305-2 "(`rc' == 0)" "ring(`r'): rc `rc'"
        if `rc' == 0 {
            capture erase "`q5d'/a.py"
            _dash_serve_spec, specpath("`q5d'/s.json") datapath("`q5d'/d.json")
            python: _q4305_order("`q5d'/s.json", "`q5d'/d.json", "`q5d'/a.py", "above", "subtitle", "title")
            foreach m in s v {
                _w43_expect Q4305-2 `"("${q4305_`m'}" == "ok")"' "ring(`r') `m': ${q4305_`m'}"
            }
        }
    }
    dash clear
    capture noisily dash scatter mpg weight, title("T") t1title("E", ring(7.5)) name(q4305b)
    _dash_serve_spec, specpath("`q5d'/s.json") datapath("`q5d'/d.json")
    capture erase "`q5d'/a.py"
    python: _q4305_order("`q5d'/s.json", "`q5d'/d.json", "`q5d'/a.py", "above", "t1title", "title")
    foreach m in s v {
        _w43_expect Q4305-2 `"("${q4305_`m'}" == "ok")"' "t1title ring(7.5) `m': ${q4305_`m'}"
    }
    _w43_done Q4305-2 "fractional and large title rings are ordered by value, saved and served"

    // ------------------------------------------------------------
    // Q4305-3: legend(position(6) ring(4.5)) is outside note() (leg_45);
    // legend(ring(<w>)) for an abbreviation of inside draws the legend
    // inside the plot region, and dash prints what twoway prints (nothing).
    // ------------------------------------------------------------
    dash clear
    capture noisily dash (scatter mpg weight) (scatter trunk weight), note("N") legend(position(6) ring(4.5)) name(q4305c)
    _w43_expect Q4305-3 "(_rc == 0)" "ring(4.5): rc `=_rc'"
    capture erase "`q5d'/a.py"
    _dash_serve_spec, specpath("`q5d'/s.json") datapath("`q5d'/d.json")
    python: _q4305_order("`q5d'/s.json", "`q5d'/d.json", "`q5d'/a.py", "below", "legend", "note")
    foreach m in s v {
        _w43_expect Q4305-3 `"("${q4305_`m'}" == "ok")"' "legend ring(4.5) `m': ${q4305_`m'}"
    }
    foreach w in in i insid -1 {
        dash clear
        capture log close q4305l
        log using "`q5d'/lw.log", text replace name(q4305l)
        capture noisily twoway (scatter mpg weight) (scatter trunk weight), legend(ring(`w')) name(q4305t, replace)
        local trc = _rc
        capture noisily dash (scatter mpg weight) (scatter trunk weight), legend(ring(`w')) name(q4305c)
        local drc = _rc
        log close q4305l
        local q5n = strpos(fileread("`q5d'/lw.log"), "gridringstyle") > 0
        _w43_expect Q4305-3 "(`trc' == 0 & `drc' == 0 & `q5n' == 0)" "legend(ring(`w')): rc `trc' `drc', noted `q5n'"
        if `drc' == 0 {
            capture erase "`q5d'/a.py"
            _dash_serve_spec, specpath("`q5d'/s.json") datapath("`q5d'/d.json")
            python: _q4305_order("`q5d'/s.json", "`q5d'/d.json", "`q5d'/a.py", "center", "center", "")
            foreach m in s v {
                _w43_expect Q4305-3 `"("${q4305_`m'}" == "ok")"' "legend ring(`w') `m': ${q4305_`m'}"
            }
        }
    }
    _w43_done Q4305-3 "legend rings take reals and inside's abbreviations, drawn as twoway draws them"

    local q5f : dir "`q5d'" files "*"
    foreach f of local q5f {
        capture erase "`q5d'/`f'"
    }
    capture rmdir "`q5d'"
    capture graph drop _all
    dash clear
    macro drop q4305_*
    display as text "S05 end " c(current_date) " " c(current_time)
}
* ==== end S05 ====

// S06 helpers (WP-43 43-06).  _q4306_docs: the figures a registered
// graph draws, saved and served (spec and data from _dash_serve_spec);
// _q4306_al: the one added-text Label's y_offset against the shift
// alignment(<a>) gives (_DASH_ADDED_TEXT_VSHIFT), and no "draws no
// alignment()" note in the log, into globals q4306_s and q4306_v.
python:
import os as _q4306_os, sys as _q4306_sys
for _q4306_p in (_q4306_os.path.abspath(".."),
                 _q4306_os.path.abspath(_q4306_os.path.join("..", "scripts"))):
    if _q4306_p not in _q4306_sys.path:
        _q4306_sys.path.insert(0, _q4306_p)


def _q4306_docs(sp, dp, app):
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_q4306_app")
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_q4306_app.py",
                     "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    sv = [m for m in doc.models if type(m).__name__ == "figure"]
    return list(r.figures.values()), sv


def _q4306_labels(figs):
    from bokeh.models import Label
    return [m for f in figs for m in f.center if isinstance(m, Label)
            and "dash_added_text" in list(m.tags or [])]


def _q4306_al(sp, dp, app, word, log):
    import dash_render as dr
    from sfi import Macro
    with open(log, encoding="utf-8", errors="replace") as fh:
        noted = "draws no alignment()" in fh.read()
    a, b = _q4306_docs(sp, dp, app)
    for figs, sfx in ((a, "s"), (b, "v")):
        labs = _q4306_labels(figs)
        if len(labs) != 1:
            Macro.setGlobal("q4306_" + sfx, "%d labels" % len(labs))
            continue
        lab = labs[0]
        want = (dr._DASH_ADDED_TEXT_VSHIFT[word]
                * float(dr.OptionTranslator.css_to_pt(lab.text_font_size))
                * dr.OptionTranslator.PX_PER_PT)
        ok = abs(float(lab.y_offset) - want) < 0.01 and not noted
        Macro.setGlobal("q4306_" + sfx, "ok" if ok else
                        "y_offset %s, want %.4g, noted %s"
                        % (lab.y_offset, want, noted))
end

* ==== S06 LT-11: text() alignment() through dash ====
local only : env WP43_ONLY
if inlist("`only'", "", "S06") & `: list posof "S06" in w43_run' {
    display as text "S06 start " c(current_date) " " c(current_time)
    local q6d "`w43_work'/s06"
    capture mkdir "`q6d'"
    capture graph drop _all
    sysuse auto, clear

    // ------------------------------------------------------------
    // Q4306-1: text(30 3000 "hi", alignment(<a>)) typed through dash is
    // drawn at twoway's shift for <a> (added_text_box_truth.json al_<a>:
    // only the four full words are drawn as themselves), saved and
    // served, and nothing names alignment().
    // ------------------------------------------------------------
    foreach a in top bottom baseline middle {
        dash clear
        capture log close q4306
        log using "`q6d'/al_`a'.log", text replace name(q4306)
        capture noisily dash scatter mpg weight, text(30 3000 "hi", alignment(`a')) name(q4306a)
        local rc = _rc
        log close q4306
        _w43_expect Q4306-1 "(`rc' == 0)" "alignment(`a'): rc `rc'"
        if `rc' == 0 {
            capture erase "`q6d'/a.py"
            _dash_serve_spec, specpath("`q6d'/s.json") datapath("`q6d'/d.json")
            python: _q4306_al("`q6d'/s.json", "`q6d'/d.json", "`q6d'/a.py", "`a'", "`q6d'/al_`a'.log")
            foreach m in s v {
                _w43_expect Q4306-1 `"("${q4306_`m'}" == "ok")"' "alignment(`a') `m': ${q4306_`m'}"
            }
        }
    }
    _w43_done Q4306-1 "alignment() typed through dash is drawn, saved and served, with no note"

    local q6f : dir "`q6d'" files "*"
    foreach f of local q6f {
        capture erase "`q6d'/`f'"
    }
    capture rmdir "`q6d'"
