    foreach o in "ring(0) bplacement(nw)" "ring(0) bplacement(sw)" "ring(0) bplacement(ne)" "ring(0) bplacement(c)" "ring(0) pos(1) bplacement(sw)" "pos(0) bplacement(nw)" "ring(0) bplacement(nor)" "ring(0) bplacement(NE)" "ring(0) bplacement(3)" "ring(0) bplacement(bogus)" {
