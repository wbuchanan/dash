end

* ==== S02 LT-4: ring(0) bplacement ====
local only : env WP43_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w43_run' {
    display as text "S02 start " c(current_date) " " c(current_time)
    local q02d "`w43_work'/s02a"
    capture mkdir "`q02d'"
    capture graph drop _all
    sysuse auto, clear
    local three (scatter mpg weight) (scatter price weight) (scatter turn weight)

    // ------------------------------------------------------------
    // Q4302-1: legend(ring(0) bplacement(<x>)) and the compass spellings
    // twoway reads (nor, NE, a clock number; an unknown name is noted
    // and drawn east) -- live twoway's box against its plot region beside
    // the inside location of dash's legend, saved and served, and a note
    // from both exactly when twoway notes one.
    // ------------------------------------------------------------
    local k 0
    foreach o in "ring(0) bplacement(nw)" "ring(0) bplacement(sw)" "ring(0) bplacement(ne)" "ring(0) bplacement(c)" "ring(0) pos(1) bplacement(sw)" "pos(0) bplacement(nw)" "ring(0) bplacement(nor)" "ring(0) bplacement(NE)" "ring(0) bplacement(3)" "ring(0) bplacement(bogus)" {
        local ++k
        capture log close q02l
        quietly log using "`q02d'/tw`k'.log", text replace name(q02l)
        twoway `three', scheme(s2color) legend(`o') name(q02t`k', replace)
        quietly log close q02l
        python: from sfi import Macro as _q4302_M; _q4302_M.setGlobal("q4302_twn", str(int("not found in class compass2dir" in open("`q02d'/tw`k'.log", encoding="utf-8", errors="replace").read())))
        capture erase "`q02d'/q02t`k'.svg"
        cert_svg_export, name(q02t`k') file("`q02d'/q02t`k'.svg")
        python: import __main__ as _q4302_m; _q4302_m._q4302_tw("`q02d'/q02t`k'.svg")
        local tw "${q4302_tw}"
        _q4302_reg "`q02d'" bplacement `three', scheme(s2color) legend(`o') name(q02e)
        foreach m in s v {
            local got "${q4302_`m'}"
            gettoken gp rest : got
            gettoken gl rest : rest
            _w43_expect Q4302-1 `"("`gp' `gl'" == "center `tw'")"' `"`o' `m': dash `got'; twoway `tw'"'
            _w43_expect Q4302-1 "((${q4302_n`m'} > 0) == ${q4302_twn})" `"`o' `m': dash notes ${q4302_n`m'}; twoway noted ${q4302_twn}"'
        }
    }
    _w43_done Q4302-1 "an inside legend sits at the compass point bplacement() names, every twoway spelling read, saved and served"

    forvalues j = 1/`k' {
        capture erase "`q02d'/q02t`j'.svg"
        capture erase "`q02d'/tw`j'.log"
    }
    foreach f in s.json d.json a.py {
        capture erase "`q02d'/`f'"
    }
    capture rmdir "`q02d'"
    macro drop q4302_s q4302_v q4302_ns q4302_nv q4302_tw q4302_twn
    capture graph drop _all
    dash clear
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

// S02 LT-17 helpers (WP-43 43-02).  _q4302_hreg <dir> <dash command...>:
// the series legend's hole stylesheet both modes draw (its CSS, "none"
// without one) and its key count, into q4302_h<s|v>; _q4302_htw <svg>
// <base svg> <axis>: the CSS of twoway's tracks -- a key the hole moved
// against the same graph without holes sits after it -- into q4302_htw.
python:
def _q4302_hread(sp, dp, app):
    import dash_render as dr
    from sfi import Macro
    from bokeh.models import Legend, Plot
    for (models, _m), sfx in zip(_q4302_models(sp, dp, app), ("s", "v")):
        out = "none 0"
        for p in models:
            if not isinstance(p, Plot):
                continue
            for lg in p.legend:
                if str(lg.name or "") == dr._COLORVAR_LEGEND_NAME:
                    continue
                css = "".join(ss.css for ss in lg.stylesheets
                              if "dash_legend_holes" in (ss.tags or []))
                out = "%s %d" % (css or "none", len(lg.items))
        Macro.setGlobal("q4302_h" + sfx, out)


def _q4302_htw(path, base, axis):
    from sfi import Macro
    from svg_truth import svg_document
    k = [t for t in svg_document(path)["texts"] if not t["anchor"]]
    k0 = [t for t in svg_document(base)["texts"] if not t["anchor"]]
    a = "y" if axis == "row" else "x"
    if a == "y":
        before = sum(1 for p, q in zip(k, k0) if abs(p[a] - q[a]) > 10)
    else:
        before = sum(1 for p, q in zip(k, k0) if p[a] - q[a] < -10)
    tracks = [i + 1 if i < before else i + 2 for i in range(len(k))]
    css = ".bk-grid{grid-template-%ss:repeat(%d,max-content);}" % (
        axis, len(k) + 1) + "".join(
        ".bk-item:nth-child(%d){grid-%s:%d;}" % (i + 1, axis, t)
        for i, t in enumerate(tracks))
    Macro.setGlobal("q4302_htw", "%s %d" % (css, len(k)))
end

capture program drop _q4302_hreg
