*! test_wp43_truth.cscript
*! WP-43's ONE certification script (.ultraplan/sections/index.md PD-6):
*! every comparison with twoway's drawing or with Stata's own values that
*! WP-43's sections need lives here, one block per GAPS4 row (or per
*! harness tool), appended above the "append new blocks above this line"
*! marker in section order.  Refusal, message and return-code checks join
*! the EXISTING script for their area (merge rule R1).
*!
*! Made from test/templates/wp_truth_template.cscript (43 -> the WP's
*! number).  S00 is the scaffold smoke (Q4300-1).  A section appends
*! `* ==== S<MM> <lead id>: <what> ====` ... `* ==== end S<MM> ====` (or
*! `S<MM> tool: <what>` for a section with no item), its helper programs
*! directly above its first header, and writes only inside its own
*! blocks.  Case ids are Q43<MM>-<k> (PD-5).
*!
*! Usage: via run_all_cscripts.do.  One block alone: WP43_ONLY=S<MM> in
*! the driver's environment.  Each block prints "S<MM> start" and "S<MM>
*! end" with the date and time.  The suite runs it in every session;
*! DASH_CERT_SHARD=k/N runs part k of N of the blocks; a part with no
*! block ends 0.

cscript "WP-43 truth: twoway comparisons" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off


do "cert_helpers.do"
quietly do "cert_svg.do"
qui do "../dash_parse.mata"
qui do "../dash.ado"
global dash_nobrowser 1

// ----------------------------------------------------------------
// Tally helpers -- test_wp29_truth.cscript's _w29_expect/_w29_done,
// renamed _w43_ for this script.  A case is any number of
// _w43_expect lines closed by one _w43_done.
// ----------------------------------------------------------------
global w43_nfail    = 0
global w43_faillist ""
global w43_bad      = 0
global w43_ncase    = 0

capture program drop _w43_expect
program define _w43_expect
    version 19
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global w43_bad = 1
    }
end

capture program drop _w43_done
program define _w43_done
    version 19
    args id msg
    if ${w43_bad} {
        global w43_nfail    = ${w43_nfail} + 1
        global w43_faillist "${w43_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global w43_bad   = 0
    global w43_ncase = ${w43_ncase} + 1
end

// A fresh directory for this run's files, never one that already exists:
// a fixed name in a shared temp directory could be planted by another
// account (rule 1), so a name Stata has not handed out before is made and
// the run fails if it cannot be.  Every block writes only under it.
tempfile w43_base
local w43_work "`w43_base'_w43"
capture mkdir "`w43_work'"
if _rc {
    display as error "test_wp43_truth: cannot create the work directory `w43_work' (rc `=_rc')"
    exit 9
}

// ---- parts: begin (WP-43 test performance) ----
// The certification suite runs this script in every one of its sessions
// (its row in run_all_cscripts.do's shard table is "* * *"); with
// DASH_CERT_SHARD=k/N set, the session runs part k of N of the blocks.
// The parts are balanced longest first onto the least loaded part (the
// lowest numbered of equals), by the seconds below -- a block not listed
// counts 1 s (section-01 D-01.f) -- the rule scripts/cert_shards.py uses
// for the scripts.  Unset, or with WP43_ONLY set
// (which keeps its precedence), every block runs.  A block runs when its
// gate finds its id in w43_run.
// Seconds: each block's start/end lines in the WP's last measured
// certification run, rounded up, at least 1; a block not listed
// counts 1 s.
local w43_secs S00 1
local w43_sh : environment DASH_CERT_SHARD
mata: st_local("w43_ok", strofreal(st_local("w43_sh") == "" | ustrregexm(st_local("w43_sh"), "^[1-4]/[1-4]$")))
if !`w43_ok' {
    display as error "test_wp43_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 4"
    exit 198
}
local w43_k 1
local w43_N 1
if "`w43_sh'" != "" {
    local w43_k = real(substr("`w43_sh'", 1, 1))
    local w43_N = real(substr("`w43_sh'", 3, 1))
}
local w43_only : env WP43_ONLY
if `"`macval(w43_only)'"' != "" | `w43_N' == 1 {
    local w43_k 1
    local w43_N 1
}
if `w43_k' > `w43_N' {
    display as error "test_wp43_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 4"
    exit 198
}
capture confirm file "test_wp43_truth.cscript"
if _rc {
    display as error "test_wp43_truth: run it from test/, where it reads its own blocks"
    exit 601
}
capture mata: mata drop _w43_part()
mata:
// The ids of the blocks (their header lines, in file order), and those of
// part k of n: longest first onto the least loaded part.
void _w43_part(string scalar file, string scalar table, real scalar k,
               real scalar n)
{
    string colvector lines, ids
    string rowvector tok
    real colvector sec, o, at
    real rowvector load
    real scalar i, j, p, best
    string scalar run

    lines = cat(file)
    ids = J(0, 1, "")
    for (i = 1; i <= rows(lines); i++) {
        if (ustrregexm(lines[i], "^\* ==== (S[0-9]+) ")) {
            if (!anyof(ids, ustrregexs(1))) ids = ids \ ustrregexs(1)
        }
    }
    sec = J(rows(ids), 1, 1)
    tok = tokens(table)
    for (j = 1; j + 1 <= cols(tok); j = j + 2) {
        for (i = 1; i <= rows(ids); i++) {
            if (ids[i] == tok[j]) sec[i] = strtoreal(tok[j + 1])
        }
    }
    o = order((-sec, (1::rows(ids))), (1, 2))
    load = J(1, n, 0)
    at = J(rows(ids), 1, 0)
    for (i = 1; i <= rows(o); i++) {
        best = 1
        for (p = 2; p <= n; p++) if (load[p] < load[best]) best = p
        load[best] = load[best] + sec[o[i]]
        at[o[i]] = best
    }
    run = ""
    for (i = 1; i <= rows(ids); i++) if (at[i] == k) run = run + " " + ids[i]
    st_local("w43_run", strtrim(run))
}
end
mata: _w43_part("test_wp43_truth.cscript", st_local("w43_secs"), `w43_k', `w43_N')
display as text "test_wp43_truth: part `w43_k'/`w43_N' runs `: word count `w43_run'' blocks: `w43_run'"
// ---- parts: end ----

* ==== S00 scaffold: the helpers load and a twoway SVG is read ====
local only : env WP43_ONLY
if inlist("`only'", "", "S00") & `: list posof "S00" in w43_run' {
    display as text "S00 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4300-1: cert_svg_export and cert_svg_texts on one twoway scatter,
    // and dash's own programs are loaded from this tree.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(w43s01, replace)
    cert_svg_export, name(w43s01) file("`w43_work'/w43s01.svg")
    local s01_rc   = r(rc)
    local s01_file "`r(file)'"
    _w43_expect Q4300-1 "(`s01_rc' == 0)" "cert_svg_export rc `s01_rc'"
    capture confirm file "`s01_file'"
    _w43_expect Q4300-1 "(_rc == 0)" "r(file) `s01_file' does not exist"
    cert_svg_texts, file("`s01_file'")
    local s01_n    = r(n)
    local s01_list "`r(list)'"
    _w43_expect Q4300-1 "(`s01_n' > 0)" "cert_svg_texts found no text elements"
    capture program list _dash_serve
    _w43_expect Q4300-1 "(_rc == 0)" "dash.ado's _dash_serve is not loaded"
    _w43_done Q4300-1 "a twoway SVG was written and read (`s01_n' texts); dash is loaded"

    capture erase "`s01_file'"
    capture erase "`s01_list'"
    capture graph drop w43s01
    display as text "S00 end " c(current_date) " " c(current_time)
}
* ==== end S00 ====

// S01 helpers (WP-43 43-01).  _q4301_reg <dir> <dash command...>:
// register one graph and read the series legend both modes draw -- its
// title, the title's size over the key text's (3 decimals) and colour,
// into q4301_<s|v>, and the count of notes naming legend()'s title or
// subtitle into q4301_n<s|v>; _q4301_svg: twoway's T and S size over the
// key text's and their fills from an SVG, into q4301_tw (T) and
// q4301_sw (S).
python:
import os as _q4301_os, sys as _q4301_sys
for _q4301_p in (_q4301_os.path.abspath(".."),
                 _q4301_os.path.abspath(_q4301_os.path.join("..", "scripts"))):
    if _q4301_p not in _q4301_sys.path:
        _q4301_sys.path.insert(0, _q4301_p)


def _q4301_models(sp, dp, app):
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings(record=True) as w1:
        warnings.simplefilter("always")
        r = dr.DashRenderer(sp, dp)
        r.render()
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        dr.ServerAppBuilder(sp, dp).build(app)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_q4301_app")
    with warnings.catch_warnings(record=True) as w2:
        warnings.simplefilter("always")
        exec(compile(src.replace(attach, "pass"), "dash_q4301_app.py",
                     "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    return ((list(r._last_layout_root.references()), [str(x.message) for x in w1]),
            (list(doc.models), [str(x.message) for x in w2]))


def _q4301_pt(v):
    s = str(v).strip()
    f = float(s[:-2])
    return f if s.endswith("pt") else f * 0.75


def _q4301_read(sp, dp, app):
    from sfi import Macro
    from bokeh.models import Legend
    for (models, msgs), sfx in zip(_q4301_models(sp, dp, app), ("s", "v")):
        lgs = [m for m in models if isinstance(m, Legend) and m.items]
        out = "none"
        if lgs:
            lg = lgs[0]
            out = "%s %.3f %s" % (
                str(lg.title or "").replace("\n", "|"),
                _q4301_pt(lg.title_text_font_size)
                / _q4301_pt(lg.label_text_font_size),
                str(lg.title_text_color).lower())
        Macro.setGlobal("q4301_" + sfx, out)
        Macro.setGlobal("q4301_n" + sfx, str(sum(
            1 for m in msgs if "title" in m and "legend" in m)))


def _q4301_svg(path):
    from sfi import Macro
    from svg_truth import svg_document
    d = svg_document(path)
    keys = [t for t in d["texts"] if not t["anchor"]]
    ks = keys[0]["size"]
    for name, g in (("T", "q4301_tw"), ("S", "q4301_sw")):
        t = [x for x in d["texts"] if x["text"] == name]
        Macro.setGlobal(g, "%s %.3f %s" % (name, t[0]["size"] / ks, t[0]["fill"])
                        if t else "none")
end

capture program drop _q4301_reg
program define _q4301_reg
    version 19
    gettoken dir 0 : 0
    dash clear
    quietly dash `0'
    _dash_serve_spec, specpath("`dir'/s.json") datapath("`dir'/d.json")
    python: import __main__ as _q4301_m; _q4301_m._q4301_read("`dir'/s.json", "`dir'/d.json", "`dir'/a.py")
end

* ==== S01 LT-1: legend title and subtitle styles ====
local only : env WP43_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w43_run' {
    display as text "S01 start " c(current_date) " " c(current_time)
    local q01d "`w43_work'/s01a"
    capture mkdir "`q01d'"
    capture graph drop _all
    sysuse auto, clear

    // ------------------------------------------------------------
    // Q4301-1: legend(title("T")) and legend(subtitle("S")) alone are
    // drawn in the scheme's leg_title / leg_subtitle text boxes: the
    // text's size over the key text's (within 2%) and its colour are
    // twoway's, under stcolor and s2color, saved and served.
    // ------------------------------------------------------------
    foreach sch in stcolor s2color {
        foreach box in title subtitle {
            local w = cond("`box'" == "title", "T", "S")
            quietly twoway (scatter mpg weight) (scatter price weight), scheme(`sch') legend(title("T") subtitle("S")) name(q01t, replace)
            capture erase "`q01d'/q01t.svg"
            cert_svg_export, name(q01t) file("`q01d'/q01t.svg")
            python: import __main__ as _q4301_m; _q4301_m._q4301_svg("`q01d'/q01t.svg")
            local tw = cond("`box'" == "title", "${q4301_tw}", "${q4301_sw}")
            _q4301_reg "`q01d'" (scatter mpg weight) (scatter price weight), scheme(`sch') legend(`box'("`w'")) name(q01d)
            foreach m in s v {
                local got "${q4301_`m'}"
                gettoken gt rest : got
                gettoken gr gc : rest
                gettoken tt rest : tw
                gettoken tr tc : rest
                local gc = strtrim("`gc'")
                local tc = strtrim("`tc'")
                _w43_expect Q4301-1 `"("`gt'" == "`w'" & abs(`gr' / `tr' - 1) < 0.02 & "`gc'" == "`tc'")"' `"`sch' `box' `m': dash `got'; twoway `tw'"'
            }
        }
    }
    _w43_done Q4301-1 "legend(title()) and legend(subtitle()) in the scheme's leg_title and leg_subtitle text boxes, saved and served"

    // ------------------------------------------------------------
    // Q4301-2: nothing is printed for legend(title("T") subtitle("S")):
    // twoway draws both, saved and served.
    // ------------------------------------------------------------
    _q4301_reg "`q01d'" (scatter mpg weight) (scatter price weight), legend(title("T") subtitle("S")) name(q01d)
    _w43_expect Q4301-2 "(${q4301_ns} == 0 & ${q4301_nv} == 0)" "notes naming the title: saved ${q4301_ns}, served ${q4301_nv}"
    _w43_done Q4301-2 "no note for legend(title() subtitle()), saved and served"

    foreach f in q01t.svg s.json d.json a.py {
        capture erase "`q01d'/`f'"
    }
    capture rmdir "`q01d'"
    macro drop q4301_s q4301_v q4301_ns q4301_nv q4301_tw q4301_sw
    capture graph drop _all
    dash clear
    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====

// S06 helpers (WP-43 43-06).  _q4306_docs: the figures a registered
// graph draws, saved and served (spec and data from _dash_serve_spec);
// _q4306_al: the one added-text Label's y_offset against the shift
// alignment(<a>) gives (_DASH_ADDED_TEXT_VSHIFT), and no "draws no
// alignment()" note in the log, into globals q4306_s and q4306_v.
python:
import os as _q4306_os, sys as _q4306_sys
for _q4306_p in (_q4306_os.path.abspath(".."),
                 _q4306_os.path.abspath(_q4306_os.path.join("..", "scripts"))):
    if _q4306_p not in _q4306_sys.path:
        _q4306_sys.path.insert(0, _q4306_p)


def _q4306_docs(sp, dp, app):
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_q4306_app")
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_q4306_app.py",
                     "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    sv = [m for m in doc.models if type(m).__name__ == "figure"]
    return list(r.figures.values()), sv


def _q4306_labels(figs):
    from bokeh.models import Label
    return [m for f in figs for m in f.center if isinstance(m, Label)
            and "dash_added_text" in list(m.tags or [])]


def _q4306_al(sp, dp, app, word, log):
    import dash_render as dr
    from sfi import Macro
    with open(log, encoding="utf-8", errors="replace") as fh:
        noted = "draws no alignment()" in fh.read()
    a, b = _q4306_docs(sp, dp, app)
    for figs, sfx in ((a, "s"), (b, "v")):
        labs = _q4306_labels(figs)
        if len(labs) != 1:
            Macro.setGlobal("q4306_" + sfx, "%d labels" % len(labs))
            continue
        lab = labs[0]
        want = (dr._DASH_ADDED_TEXT_VSHIFT[word]
                * float(dr.OptionTranslator.css_to_pt(lab.text_font_size))
                * dr.OptionTranslator.PX_PER_PT)
        ok = abs(float(lab.y_offset) - want) < 0.01 and not noted
        Macro.setGlobal("q4306_" + sfx, "ok" if ok else
                        "y_offset %s, want %.4g, noted %s"
                        % (lab.y_offset, want, noted))
end

* ==== S06 LT-11: text() alignment() through dash ====
local only : env WP43_ONLY
if inlist("`only'", "", "S06") & `: list posof "S06" in w43_run' {
    display as text "S06 start " c(current_date) " " c(current_time)
    local q6d "`w43_work'/s06"
    capture mkdir "`q6d'"
    capture graph drop _all
    sysuse auto, clear

    // ------------------------------------------------------------
    // Q4306-1: text(30 3000 "hi", alignment(<a>)) typed through dash is
    // drawn at twoway's shift for <a> (added_text_box_truth.json al_<a>:
    // only the four full words are drawn as themselves), saved and
    // served, and nothing names alignment().
    // ------------------------------------------------------------
    foreach a in top bottom baseline middle {
        dash clear
        capture log close q4306
        log using "`q6d'/al_`a'.log", text replace name(q4306)
        capture noisily dash scatter mpg weight, text(30 3000 "hi", alignment(`a')) name(q4306a)
        local rc = _rc
        log close q4306
        _w43_expect Q4306-1 "(`rc' == 0)" "alignment(`a'): rc `rc'"
        if `rc' == 0 {
            capture erase "`q6d'/a.py"
            _dash_serve_spec, specpath("`q6d'/s.json") datapath("`q6d'/d.json")
            python: _q4306_al("`q6d'/s.json", "`q6d'/d.json", "`q6d'/a.py", "`a'", "`q6d'/al_`a'.log")
            foreach m in s v {
                _w43_expect Q4306-1 `"("${q4306_`m'}" == "ok")"' "alignment(`a') `m': ${q4306_`m'}"
            }
        }
    }
    _w43_done Q4306-1 "alignment() typed through dash is drawn, saved and served, with no note"

    local q6f : dir "`q6d'" files "*"
    foreach f of local q6f {
        capture erase "`q6d'/`f'"
    }
    capture rmdir "`q6d'"
    capture graph drop _all
    dash clear
    macro drop q4306_*
    display as text "S06 end " c(current_date) " " c(current_time)
}
* ==== end S06 ====

// S06 LT-20 helper.  _q4306_box: the one added-text Label of a
// registered graph, saved and served, against the fixture's box
// (added_text_box_truth.json x_w: its width in em of the text; x_lg: the
// line step; x_lp: a dashed frame) -- into globals q4306_s and q4306_v.
python:
def _q4306_box(sp, dp, app, fx):
    import json
    import dash_render as dr
    from sfi import Macro
    with open(fx, encoding="utf-8") as fh:
        pr = json.load(fh)["probes"]
    b = pr["x_w"]["boxes"][0]
    size = pr["x_w"]["texts"][0]["size"]
    em_w = (b["right"] - b["left"]) / size
    t = pr["x_lg"]["texts"]
    step = (t[1]["y_px"] - t[0]["y_px"]) / t[0]["size"]
    a, v = _q4306_docs(sp, dp, app)
    for figs, sfx in ((a, "s"), (v, "v")):
        labs = _q4306_labels(figs)
        if len(labs) != 1:
            Macro.setGlobal("q4306_" + sfx, "%d labels" % len(labs))
            continue
        lab = labs[0]
        f = (float(dr.OptionTranslator.css_to_pt(lab.text_font_size))
             * dr.OptionTranslator.PX_PER_PT)
        its = []
        for fg in figs:
            for cbs in fg.js_property_callbacks.values():
                for c in cbs:
                    if getattr(c, "code", None) == dr._DASH_TEXT_BOX_JS:
                        its.extend(i for i in c.args["items"] if i[0] is lab)
        bad = []
        if not its:
            bad.append("no box hook")
        else:
            o = its[0][1]
            if abs(o["w"] - em_w) > 1.0 / f:
                bad.append("w %s em, twoway %.4g" % (o["w"], em_w))
            if not o["edge"] > 0:
                bad.append("edge %s" % o["edge"])
        if abs(float(lab.text_line_height) - step) > 0.02 * step:
            bad.append("line height %s, twoway %.4g"
                       % (lab.text_line_height, step))
        if not list(lab.border_line_dash):
            bad.append("frame not dashed")
        Macro.setGlobal("q4306_" + sfx, "; ".join(bad) or "ok")
end

* ==== S06 LT-20: text() box options ====
local only : env WP43_ONLY
if inlist("`only'", "", "S06") & `: list posof "S06" in w43_run' {
    display as text "S06 start " c(current_date) " " c(current_time)
    local q6d "`w43_work'/s06b"
    capture mkdir "`q6d'"
    capture graph drop _all
    sysuse auto, clear

    // ------------------------------------------------------------
    // Q4306-2: box width(20) linegap(3) lpattern(dash) lwidth(thick)
    // lalign(outside) typed through dash: the fixed box in em of the
    // text (x_w), the line step (x_lg), a dashed frame (x_lp) and the
    // outside edge, saved and served, with no note.
    // ------------------------------------------------------------
    dash clear
    capture log close q4306
    log using "`q6d'/box.log", text replace name(q4306)
    capture noisily dash scatter mpg weight, text(30 3000 "Peak" "two", box width(20) linegap(3) blpattern(dash) lwidth(thick) lalign(outside)) name(q4306b)
    local rc = _rc
    log close q4306
    _w43_expect Q4306-2 "(`rc' == 0)" "rc `rc'"
    cert_log_has "`q6d'/box.log", needle("draws no")
    _w43_expect Q4306-2 "(r(found) == 0)" "a note names a drawn sub-option"
    if `rc' == 0 {
        capture erase "`q6d'/a.py"
        _dash_serve_spec, specpath("`q6d'/s.json") datapath("`q6d'/d.json")
        python: _q4306_box("`q6d'/s.json", "`q6d'/d.json", "`q6d'/a.py", "fixtures/added_text_box_truth.json")
        foreach m in s v {
            _w43_expect Q4306-2 `"("${q4306_`m'}" == "ok")"' "`m': ${q4306_`m'}"
        }
    }
    _w43_done Q4306-2 "width(), linegap(), blpattern() and lalign() drawn as twoway draws them, saved and served"

    // ------------------------------------------------------------
    // Q4306-3: bexpand and bmargin() are taken in silence (x_bexpand and
    // x_bmargin draw x_box); what is still noted is named once.
    // ------------------------------------------------------------
    dash clear
    capture log close q4306
    log using "`q6d'/silent.log", text replace name(q4306)
    capture noisily dash scatter mpg weight, text(30 3000 "Peak", box bexpand bmargin(large) angle(45)) name(q4306c)
    local rc = _rc
    log close q4306
    _w43_expect Q4306-3 "(`rc' == 0)" "rc `rc'"
    cert_log_has "`q6d'/silent.log", needle("text() draws no angle(); see help dash##added_text")
    // The note names angle() alone: had bexpand or bmargin() been named,
    // they would stand in it beside angle().
    _w43_expect Q4306-3 "(r(found) == 1)" "no note naming angle() alone"
    _w43_done Q4306-3 "bexpand and bmargin() taken in silence; angle() named once"

    local q6f : dir "`q6d'" files "*"
    foreach f of local q6f {
        capture erase "`q6d'/`f'"
    }
    capture rmdir "`q6d'"
    capture graph drop _all
    dash clear
    macro drop q4306_*
    display as text "S06 end " c(current_date) " " c(current_time)
}
* ==== end S06 ====

// S06 LT-20 evaluator helpers.  _q4306_ev: the at_lines dash registered
// for graph <name> against the fixture's probe <pid> (x_eval_*: the text
// twoway drew; x_eval_out_*: the global's value as written), a miss
// appended to global q4306_bad; _q4306_notes: how many times a log holds
// the =exp note, into global q4306_n; _q4306_gt: Q4306-5's graph text.
python:
def _q4306_lines(js):
    import json
    stack = [json.loads(js)]
    while stack:
        o = stack.pop()
        if isinstance(o, dict):
            if "at_lines" in o:
                return o["at_lines"]
            stack.extend(o.values())
        elif isinstance(o, list):
            stack.extend(o)
    return None


def _q4306_ev(name, pid, rc):
    import json
    from sfi import Macro
    with open("fixtures/added_text_box_truth.json", encoding="utf-8") as fh:
        pr = json.load(fh)["probes"][pid]
    if pid.startswith("x_eval_out_"):
        want = "\x60" + pr["expr"] + "'"
    else:
        want = pr["drawn"]
    got = None
    if int(rc) == 0:
        got = _q4306_lines(Macro.getGlobal("dash_json_" + name) or "null")
    got = " ".join(got) if got is not None else "rc %s" % rc
    if got != want:
        bad = Macro.getGlobal("q4306_bad") or ""
        Macro.setGlobal("q4306_bad", (bad + " [%s: %r, twoway %r]"
                                      % (pid, got, want))[:1500])


def _q4306_notes(log):
    from sfi import Macro
    with open(log, encoding="utf-8", errors="replace") as fh:
        n = fh.read().count("=exp or macro reference in a graph's text")
    Macro.setGlobal("q4306_n", str(n))


def _q4306_gt(name):
    import json
    from sfi import Macro
    with open("fixtures/global_text_truth.json", encoding="utf-8") as fh:
        cases = json.load(fh)["cases"]
    row = [c for c in cases if c["kind"] == "eval" and c["option"] == "ytitle"]
    want = row[0]["drawn"][0] if row else "?"
    # Titles are registered as typed, in their quotes.
    titles, axn = [], []
    stack = [json.loads(Macro.getGlobal("dash_json_" + name) or "null")]
    while stack:
        o = stack.pop()
        if isinstance(o, dict):
            if isinstance(o.get("title"), str):
                titles.append(o["title"].strip('"'))
            if isinstance(o.get("axisn"), dict):
                axn.append(str((o["axisn"].get("y3") or {}).get("title", ""))
                           .strip('"'))
            stack.extend(o.values())
        elif isinstance(o, list):
            stack.extend(o)
    bad = []
    if axn != [want]:
        bad.append("axis 3 title %r, twoway %r" % (axn, want))
    if "a \x60=_N' b" not in titles:
        bad.append("title not drawn as written: %r" % titles)
    Macro.setGlobal("q4306_g", "; ".join(bad) or "ok")
end

capture mata: mata drop _q4306_hostile()
mata:
// _q4306_hostile() -- the number of hostile =exp texts _dash_at_exp does
// not refuse as written (ok 0, the text returned), the first of them in
// the local q4306_h1.
real scalar _q4306_hostile()
{
    string colvector hs
    string scalar    q, r
    real scalar      i, ok, n

    q = char(34)
    hs = ("filewrite(" + q + "q4306" + q + "," + q + "y" + q + ")") \
         ("fileread(" + q + "q4306" + q + ")") \ "_N" \ "_n" \ "mpg" \
         "mpg[1]" \ "c(N)" \ "r(N)" \ "e(N)" \ "scalar(x)" \ "exec(1)" \
         "stata(1)" \ ("st_global(" + q + "a" + q + ")") \
         ("findfile(" + q + "a" + q + ")") \ "1+" \ "(1" \ "1)" \ "" \
         " " \ (q + "abc") \ "1,2" \ (100 * "(" + "1" + 100 * ")") \
         (100 * "-" + "1") \ (4001 * "1") \
         ("max(" + 16 * "1," + "1)") \ "upper(1)" \ ("1+" + q + "a" + q) \
         (q + "a" + q + "*2") \ ("substr(" + q + "a" + q + ",1)") \
         ("string(1," + q + "%999.0f" + q + ")") \
         ("string(1," + q + "%s" + q + ")") \ "abs()" \ "ABS(1)" \ "1;2" \
         "1 2" \ "1==" \ ("!" + q + "a" + q) \
         (char(96) + "x" + char(39)) \ (char(36) + "x") \ "1+.a" \
         "strlen(1)" \ "min()" \ "abs(1,2)" \ "x(1)"
    n = 0
    st_local("q4306_h1", "")
    for (i = 1; i <= rows(hs); i++) {
        ok = 1
        r = _dash_at_exp(hs[i], ok)
        if (ok != 0 | r != hs[i]) {
            n++
            if (st_local("q4306_h1") == "") st_local("q4306_h1", substr(hs[i], 1, 60))
        }
    }
    return(n)
}
end

* ==== S06 LT-20: a global's =exp, the safe evaluator ====
local only : env WP43_ONLY
