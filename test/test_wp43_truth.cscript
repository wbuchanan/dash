*! test_wp43_truth.cscript
*! WP-43's ONE certification script (.ultraplan/sections/index.md PD-6):
*! every comparison with twoway's drawing or with Stata's own values that
*! WP-43's sections need lives here, one block per GAPS4 row (or per
*! harness tool), appended above the "append new blocks above this line"
*! marker in section order.  Refusal, message and return-code checks join
*! the EXISTING script for their area (merge rule R1).
*!
*! Made from test/templates/wp_truth_template.cscript (43 -> the WP's
*! number).  S00 is the scaffold smoke (Q4300-1).  A section appends
*! `* ==== S<MM> <lead id>: <what> ====` ... `* ==== end S<MM> ====` (or
*! `S<MM> tool: <what>` for a section with no item), its helper programs
*! directly above its first header, and writes only inside its own
*! blocks.  Case ids are Q43<MM>-<k> (PD-5).
*!
*! Usage: via run_all_cscripts.do.  One block alone: WP43_ONLY=S<MM> in
*! the driver's environment.  Each block prints "S<MM> start" and "S<MM>
*! end" with the date and time.  The suite runs it in every session;
*! DASH_CERT_SHARD=k/N runs part k of N of the blocks; a part with no
*! block ends 0.

cscript "WP-43 truth: twoway comparisons" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off


do "cert_helpers.do"
quietly do "cert_svg.do"
qui do "../dash_parse.mata"
qui do "../dash.ado"
global dash_nobrowser 1

// ----------------------------------------------------------------
// Tally helpers -- test_wp29_truth.cscript's _w29_expect/_w29_done,
// renamed _w43_ for this script.  A case is any number of
// _w43_expect lines closed by one _w43_done.
// ----------------------------------------------------------------
global w43_nfail    = 0
global w43_faillist ""
global w43_bad      = 0
global w43_ncase    = 0

capture program drop _w43_expect
program define _w43_expect
    version 19
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global w43_bad = 1
    }
end

capture program drop _w43_done
program define _w43_done
    version 19
    args id msg
    if ${w43_bad} {
        global w43_nfail    = ${w43_nfail} + 1
        global w43_faillist "${w43_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global w43_bad   = 0
    global w43_ncase = ${w43_ncase} + 1
end

// A fresh directory for this run's files, never one that already exists:
// a fixed name in a shared temp directory could be planted by another
// account (rule 1), so a name Stata has not handed out before is made and
// the run fails if it cannot be.  Every block writes only under it.
tempfile w43_base
local w43_work "`w43_base'_w43"
capture mkdir "`w43_work'"
if _rc {
    display as error "test_wp43_truth: cannot create the work directory `w43_work' (rc `=_rc')"
    exit 9
}

// ---- parts: begin (WP-43 test performance) ----
// The certification suite runs this script in every one of its sessions
// (its row in run_all_cscripts.do's shard table is "* * *"); with
// DASH_CERT_SHARD=k/N set, the session runs part k of N of the blocks.
// The parts are balanced longest first onto the least loaded part (the
// lowest numbered of equals), by the seconds below -- a block not listed
// counts 1 s (section-01 D-01.f) -- the rule scripts/cert_shards.py uses
// for the scripts.  Unset, or with WP43_ONLY set
// (which keeps its precedence), every block runs.  A block runs when its
// gate finds its id in w43_run.
// Seconds: each block's start/end lines in the WP's last measured
// certification run, rounded up, at least 1; a block not listed
// counts 1 s.
local w43_secs S00 1
local w43_sh : environment DASH_CERT_SHARD
mata: st_local("w43_ok", strofreal(st_local("w43_sh") == "" | ustrregexm(st_local("w43_sh"), "^[1-4]/[1-4]$")))
if !`w43_ok' {
    display as error "test_wp43_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 4"
    exit 198
}
local w43_k 1
local w43_N 1
if "`w43_sh'" != "" {
    local w43_k = real(substr("`w43_sh'", 1, 1))
    local w43_N = real(substr("`w43_sh'", 3, 1))
}
local w43_only : env WP43_ONLY
if `"`macval(w43_only)'"' != "" | `w43_N' == 1 {
    local w43_k 1
    local w43_N 1
}
if `w43_k' > `w43_N' {
    display as error "test_wp43_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 4"
    exit 198
}
capture confirm file "test_wp43_truth.cscript"
if _rc {
    display as error "test_wp43_truth: run it from test/, where it reads its own blocks"
    exit 601
}
capture mata: mata drop _w43_part()
mata:
// The ids of the blocks (their header lines, in file order), and those of
// part k of n: longest first onto the least loaded part.
void _w43_part(string scalar file, string scalar table, real scalar k,
               real scalar n)
{
    string colvector lines, ids
    string rowvector tok
    real colvector sec, o, at
    real rowvector load
    real scalar i, j, p, best
    string scalar run

    lines = cat(file)
    ids = J(0, 1, "")
    for (i = 1; i <= rows(lines); i++) {
        if (ustrregexm(lines[i], "^\* ==== (S[0-9]+) ")) {
            if (!anyof(ids, ustrregexs(1))) ids = ids \ ustrregexs(1)
        }
    }
    sec = J(rows(ids), 1, 1)
    tok = tokens(table)
    for (j = 1; j + 1 <= cols(tok); j = j + 2) {
        for (i = 1; i <= rows(ids); i++) {
            if (ids[i] == tok[j]) sec[i] = strtoreal(tok[j + 1])
        }
    }
    o = order((-sec, (1::rows(ids))), (1, 2))
    load = J(1, n, 0)
    at = J(rows(ids), 1, 0)
    for (i = 1; i <= rows(o); i++) {
        best = 1
        for (p = 2; p <= n; p++) if (load[p] < load[best]) best = p
        load[best] = load[best] + sec[o[i]]
        at[o[i]] = best
    }
    run = ""
    for (i = 1; i <= rows(ids); i++) if (at[i] == k) run = run + " " + ids[i]
    st_local("w43_run", strtrim(run))
}
end
mata: _w43_part("test_wp43_truth.cscript", st_local("w43_secs"), `w43_k', `w43_N')
display as text "test_wp43_truth: part `w43_k'/`w43_N' runs `: word count `w43_run'' blocks: `w43_run'"
// ---- parts: end ----

* ==== S00 scaffold: the helpers load and a twoway SVG is read ====
local only : env WP43_ONLY
if inlist("`only'", "", "S00") & `: list posof "S00" in w43_run' {
    display as text "S00 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4300-1: cert_svg_export and cert_svg_texts on one twoway scatter,
    // and dash's own programs are loaded from this tree.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(w43s01, replace)
    cert_svg_export, name(w43s01) file("`w43_work'/w43s01.svg")
    local s01_rc   = r(rc)
    local s01_file "`r(file)'"
    _w43_expect Q4300-1 "(`s01_rc' == 0)" "cert_svg_export rc `s01_rc'"
    capture confirm file "`s01_file'"
    _w43_expect Q4300-1 "(_rc == 0)" "r(file) `s01_file' does not exist"
    cert_svg_texts, file("`s01_file'")
    local s01_n    = r(n)
    local s01_list "`r(list)'"
    _w43_expect Q4300-1 "(`s01_n' > 0)" "cert_svg_texts found no text elements"
    capture program list _dash_serve
    _w43_expect Q4300-1 "(_rc == 0)" "dash.ado's _dash_serve is not loaded"
    _w43_done Q4300-1 "a twoway SVG was written and read (`s01_n' texts); dash is loaded"

    capture erase "`s01_file'"
    capture erase "`s01_list'"
    capture graph drop w43s01
    display as text "S00 end " c(current_date) " " c(current_time)
}
* ==== end S00 ====

// S01 helpers (WP-43 43-01).  _q4301_reg <dir> <dash command...>:
// register one graph and read the series legend both modes draw -- its
// title, the title's size over the key text's (3 decimals) and colour,
// into q4301_<s|v>, and the count of notes naming legend()'s title or
// subtitle into q4301_n<s|v>; _q4301_svg: twoway's T and S size over the
// key text's and their fills from an SVG, into q4301_tw (T) and
// q4301_sw (S).
python:
import os as _q4301_os, sys as _q4301_sys
for _q4301_p in (_q4301_os.path.abspath(".."),
                 _q4301_os.path.abspath(_q4301_os.path.join("..", "scripts"))):
    if _q4301_p not in _q4301_sys.path:
        _q4301_sys.path.insert(0, _q4301_p)


def _q4301_models(sp, dp, app):
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings(record=True) as w1:
        warnings.simplefilter("always")
        r = dr.DashRenderer(sp, dp)
        r.render()
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        dr.ServerAppBuilder(sp, dp).build(app)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_q4301_app")
    with warnings.catch_warnings(record=True) as w2:
        warnings.simplefilter("always")
        exec(compile(src.replace(attach, "pass"), "dash_q4301_app.py",
                     "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    return ((list(r._last_layout_root.references()), [str(x.message) for x in w1]),
            (list(doc.models), [str(x.message) for x in w2]))


def _q4301_pt(v):
    s = str(v).strip()
    f = float(s[:-2])
    return f if s.endswith("pt") else f * 0.75


def _q4301_read(sp, dp, app):
    from sfi import Macro
    from bokeh.models import Legend
    for (models, msgs), sfx in zip(_q4301_models(sp, dp, app), ("s", "v")):
        lgs = [m for m in models if isinstance(m, Legend) and m.items]
        out = "none"
        if lgs:
            lg = lgs[0]
            out = "%s %.3f %s" % (
                str(lg.title or "").replace("\n", "|"),
                _q4301_pt(lg.title_text_font_size)
                / _q4301_pt(lg.label_text_font_size),
                str(lg.title_text_color).lower())
        Macro.setGlobal("q4301_" + sfx, out)
        Macro.setGlobal("q4301_n" + sfx, str(sum(
            1 for m in msgs if "title" in m and "legend" in m)))


def _q4301_svg(path):
    from sfi import Macro
    from svg_truth import svg_document
    d = svg_document(path)
    keys = [t for t in d["texts"] if not t["anchor"]]
    ks = keys[0]["size"]
    for name, g in (("T", "q4301_tw"), ("S", "q4301_sw")):
        t = [x for x in d["texts"] if x["text"] == name]
        Macro.setGlobal(g, "%s %.3f %s" % (name, t[0]["size"] / ks, t[0]["fill"])
                        if t else "none")
end

capture program drop _q4301_reg
program define _q4301_reg
    version 19
    gettoken dir 0 : 0
    dash clear
    quietly dash `0'
    _dash_serve_spec, specpath("`dir'/s.json") datapath("`dir'/d.json")
    python: import __main__ as _q4301_m; _q4301_m._q4301_read("`dir'/s.json", "`dir'/d.json", "`dir'/a.py")
end

* ==== S01 LT-1: legend title and subtitle styles ====
local only : env WP43_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w43_run' {
    display as text "S01 start " c(current_date) " " c(current_time)
    local q01d "`w43_work'/s01a"
    capture mkdir "`q01d'"
    capture graph drop _all
    sysuse auto, clear

    // ------------------------------------------------------------
    // Q4301-1: legend(title("T")) and legend(subtitle("S")) alone are
    // drawn in the scheme's leg_title / leg_subtitle text boxes: the
    // text's size over the key text's (within 2%) and its colour are
    // twoway's, under stcolor and s2color, saved and served.
    // ------------------------------------------------------------
    foreach sch in stcolor s2color {
        foreach box in title subtitle {
            local w = cond("`box'" == "title", "T", "S")
            quietly twoway (scatter mpg weight) (scatter price weight), scheme(`sch') legend(title("T") subtitle("S")) name(q01t, replace)
            capture erase "`q01d'/q01t.svg"
            cert_svg_export, name(q01t) file("`q01d'/q01t.svg")
            python: import __main__ as _q4301_m; _q4301_m._q4301_svg("`q01d'/q01t.svg")
            local tw = cond("`box'" == "title", "${q4301_tw}", "${q4301_sw}")
            _q4301_reg "`q01d'" (scatter mpg weight) (scatter price weight), scheme(`sch') legend(`box'("`w'")) name(q01d)
            foreach m in s v {
                local got "${q4301_`m'}"
                gettoken gt rest : got
                gettoken gr gc : rest
                gettoken tt rest : tw
                gettoken tr tc : rest
                local gc = strtrim("`gc'")
                local tc = strtrim("`tc'")
                _w43_expect Q4301-1 `"("`gt'" == "`w'" & abs(`gr' / `tr' - 1) < 0.02 & "`gc'" == "`tc'")"' `"`sch' `box' `m': dash `got'; twoway `tw'"'
            }
        }
    }
    _w43_done Q4301-1 "legend(title()) and legend(subtitle()) in the scheme's leg_title and leg_subtitle text boxes, saved and served"

    // ------------------------------------------------------------
    // Q4301-2: nothing is printed for legend(title("T") subtitle("S")):
    // twoway draws both, saved and served.
    // ------------------------------------------------------------
    _q4301_reg "`q01d'" (scatter mpg weight) (scatter price weight), legend(title("T") subtitle("S")) name(q01d)
    _w43_expect Q4301-2 "(${q4301_ns} == 0 & ${q4301_nv} == 0)" "notes naming the title: saved ${q4301_ns}, served ${q4301_nv}"
    _w43_done Q4301-2 "no note for legend(title() subtitle()), saved and served"

    foreach f in q01t.svg s.json d.json a.py {
        capture erase "`q01d'/`f'"
    }
    capture rmdir "`q01d'"
    macro drop q4301_s q4301_v q4301_ns q4301_nv q4301_tw q4301_sw
    capture graph drop _all
    dash clear
    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====

// S01 LT-15 helpers (WP-43 43-01).  _q4301_block: the series legend's
// title block both modes draw for a registered graph -- its side, the
// block's side margins, its text-align and whether it is framed (the
// legend's dash_legend_title stylesheet, D69) -- into q4301_b<s|v>, and the
// notes naming legend(title) into q4301_n<s|v>; _q4301_tsvg: twoway's T
// against the keys from an SVG -- above or below, its text-anchor and
// whether a text box frame is drawn -- into q4301_tb.
python:
def _q4301_css(lg, sel, prop):
    import re
    css = "".join(ss.css for ss in lg.stylesheets
                  if "dash_legend_title" in (ss.tags or []))
    m = re.search(re.escape(sel) + r"\{([^}]*)\}", css)
    for part in (m.group(1).split(";") if m else []):
        k, _, v = part.partition(":")
        if k.strip() == prop:
            return v.strip()
    return "-"


def _q4301_block(sp, dp, app):
    from sfi import Macro
    from bokeh.models import Legend
    for (models, msgs), sfx in zip(_q4301_models(sp, dp, app), ("s", "v")):
        lgs = [m for m in models if isinstance(m, Legend) and m.items]
        out = "none"
        if lgs:
            lg = lgs[0]
            side = {("auto", "auto"): "center", ("auto", "0"): "right",
                    ("0", "auto"): "left"}.get(
                (_q4301_css(lg, ".bk-title", "margin-left"),
                 _q4301_css(lg, ".bk-title", "margin-right")), "-")
            out = "%s %s %s %s" % (
                lg.title_location, side,
                _q4301_css(lg, ".bk-title", "text-align"),
                "framed" if _q4301_css(lg, ".bk-title", "border") != "-"
                else "plain")
        Macro.setGlobal("q4301_b" + sfx, out)
        Macro.setGlobal("q4301_n" + sfx, str(sum(
            1 for m in msgs if "legend(title)" in m)))


def _q4301_tsvg(path):
    from sfi import Macro
    from svg_truth import svg_document, svg_rects
    d = svg_document(path)
    keys = [t for t in d["texts"] if not t["anchor"]]
    t = [x for x in d["texts"] if x["text"] == "T"][0]
    framed = any(r["w"] is not None and r["h"] is not None
                 and r["w"] < 400 and r["h"] < 400
                 and r["x"] <= t["x"] <= r["x"] + r["w"]
                 and r["y"] <= t["y"] <= r["y"] + r["h"]
                 for r in svg_rects(path))
    Macro.setGlobal("q4301_tb", "%s %s %s" % (
        "above" if t["y"] < keys[0]["y"] else "below",
        "right" if t["anchor"] == "end" else "center",
        "framed" if framed else "plain"))
end

capture program drop _q4301_breg
program define _q4301_breg
    version 19
    gettoken dir 0 : 0
    dash clear
    quietly dash `0'
    _dash_serve_spec, specpath("`dir'/s.json") datapath("`dir'/d.json")
    python: import __main__ as _q4301_m; _q4301_m._q4301_block("`dir'/s.json", "`dir'/d.json", "`dir'/a.py")
end

* ==== S01 LT-15: legend title sub-options ====
local only : env WP43_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w43_run' {
    display as text "S01 start " c(current_date) " " c(current_time)
    local q01d "`w43_work'/s01b"
    capture mkdir "`q01d'"
    capture graph drop _all
    sysuse auto, clear

    // ------------------------------------------------------------
    // Q4301-3: legend(title("T", position(5))) below the keys at the
    // right, title("T", box) framed in the text box, title("T") above and
    // centred -- live twoway beside dash's legend, saved and served;
    // justification(right) aligns the text in its own box, the block
    // staying centred (text-align right).
    // ------------------------------------------------------------
    local k 0
    foreach o in `"title("T", position(5))"' `"title("T", box)"' `"title("T")"' {
        local ++k
        quietly twoway (scatter mpg weight) (scatter price weight), legend(`o') name(q01b`k', replace)
        capture erase "`q01d'/q01b`k'.svg"
        cert_svg_export, name(q01b`k') file("`q01d'/q01b`k'.svg")
        python: import __main__ as _q4301_m; _q4301_m._q4301_tsvg("`q01d'/q01b`k'.svg")
        local tw "${q4301_tb}"
        _q4301_breg "`q01d'" (scatter mpg weight) (scatter price weight), legend(`o') name(q01e)
        foreach m in s v {
            local got "${q4301_b`m'}"
            gettoken gl rest : got
            gettoken gs rest : rest
            gettoken ga gf : rest
            local gf = strtrim("`gf'")
            _w43_expect Q4301-3 `"("`gl' `gs' `gf'" == "`tw'")"' `"`o' `m': dash `got'; twoway `tw'"'
        }
    }
    _q4301_breg "`q01d'" (scatter mpg weight) (scatter price weight), legend(title("T", justification(right))) name(q01e)
    _w43_expect Q4301-3 `"("${q4301_bs}" == "above center right plain" & "${q4301_bv}" == "above center right plain")"' "justification(right): saved ${q4301_bs}, served ${q4301_bv}"
    _w43_done Q4301-3 "legend(title()) position(5), box and justification() drawn as twoway draws them, saved and served"

    // ------------------------------------------------------------
    // Q4301-4: a sub-option whose twoway SVG differs from title("T")'s
    // and dash does not draw is named once (orientation(vertical)); one
    // whose SVG is twoway's control is taken in silence (width(40), live
    // twoway SVG compared with the control's).
    // ------------------------------------------------------------
    quietly twoway (scatter mpg weight) (scatter price weight), legend(title("T")) name(q01c, replace)
    capture erase "`q01d'/q01c.svg"
    cert_svg_export, name(q01c) file("`q01d'/q01c.svg")
    foreach sub in "orientation(vertical)" "width(40)" {
        quietly twoway (scatter mpg weight) (scatter price weight), legend(title("T", `sub')) name(q01x, replace)
        capture erase "`q01d'/q01x.svg"
        cert_svg_export, name(q01x) file("`q01d'/q01x.svg")
        python: from svg_truth import svg_document as _q4301_d; from sfi import Macro as _q4301_M; _q4301_M.setGlobal("q4301_same", str(int([(t["text"], t["x"], t["y"], t["rotate"]) for t in _q4301_d("`q01d'/q01x.svg")["texts"]] == [(t["text"], t["x"], t["y"], t["rotate"]) for t in _q4301_d("`q01d'/q01c.svg")["texts"]])))
        local want = cond(${q4301_same}, 0, 1)
        _q4301_breg "`q01d'" (scatter mpg weight) (scatter price weight), legend(title("T", `sub')) name(q01e)
        _w43_expect Q4301-4 "(${q4301_ns} == `want' & ${q4301_nv} == `want')" "`sub': twoway same as control ${q4301_same}; notes saved ${q4301_ns}, served ${q4301_nv}"
    }
    _w43_done Q4301-4 "a legend(title()) sub-option twoway draws is named once when dash does not draw it, taken in silence when twoway draws nothing different"

    foreach f in q01b1.svg q01b2.svg q01b3.svg q01c.svg q01x.svg s.json d.json a.py {
        capture erase "`q01d'/`f'"
    }
    capture rmdir "`q01d'"
    macro drop q4301_bs q4301_bv q4301_ns q4301_nv q4301_tb q4301_s q4301_v q4301_same
    capture graph drop _all
    dash clear
    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====

// S02 helpers (WP-43 43-02).  _q4302_reg <dir> <dash command...>:
// register one graph and read the series legend both modes draw -- its
// panel and location, its key count, whether it is visible, and the
// notes naming legend()'s bplacement -- into q4302_<s|v> ("<panel>
// <location> <keys> <visible>") and q4302_n<s|v>; _q4302_tw <svg>:
// twoway's legend box against its plot region from an SVG, as the
// inside location it is ("top_left" .. "center"), into q4302_tw.
python:
import os as _q4302_os, sys as _q4302_sys
for _q4302_p in (_q4302_os.path.abspath(".."),
                 _q4302_os.path.abspath(_q4302_os.path.join("..", "scripts"))):
    if _q4302_p not in _q4302_sys.path:
        _q4302_sys.path.insert(0, _q4302_p)


def _q4302_models(sp, dp, app):
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings(record=True) as w1:
        warnings.simplefilter("always")
        r = dr.DashRenderer(sp, dp)
        r.render()
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        dr.ServerAppBuilder(sp, dp).build(app)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_q4302_app")
    with warnings.catch_warnings(record=True) as w2:
        warnings.simplefilter("always")
        exec(compile(src.replace(attach, "pass"), "dash_q4302_app.py",
                     "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    return ((list(r._last_layout_root.references()), [str(x.message) for x in w1]),
            (list(doc.models), [str(x.message) for x in w2]))


def _q4302_read(sp, dp, app, word):
    import dash_render as dr
    from sfi import Macro
    from bokeh.models import Legend, Plot
    for (models, msgs), sfx in zip(_q4302_models(sp, dp, app), ("s", "v")):
        out = "none"
        for p in models:
            if not isinstance(p, Plot):
                continue
            for side in ("center", "above", "below", "left", "right"):
                for lg in getattr(p, side):
                    if (isinstance(lg, Legend) and str(lg.name or "")
                            != dr._COLORVAR_LEGEND_NAME and out == "none"):
                        out = "%s %s %d %d" % (side, lg.location,
                                               len(lg.items), int(lg.visible))
        Macro.setGlobal("q4302_" + sfx, out)
        Macro.setGlobal("q4302_n" + sfx, str(sum(1 for m in msgs
                                                 if word in m)))


def _q4302_tw(path):
    from sfi import Macro
    from svg_truth import svg_document, svg_rects
    d = svg_document(path)
    pr = d["plotregion"]
    keys = [t for t in d["texts"] if not t["anchor"]]
    box = None
    for r in svg_rects(path):
        if r.get("fill") in (None, "none") or r["w"] is None or r["w"] > 3900:
            continue
        x0, y0 = r["x"], r["y"]
        if abs(x0 - pr["left"]) < 1 and abs(y0 - pr["top"]) < 1:
            continue
        if keys and all(x0 <= k["x"] <= x0 + r["w"] and y0 <= k["y"] <= y0 + r["h"]
                        for k in keys):
            if box is None or r["w"] * r["h"] < box["w"] * box["h"]:
                box = r
    if box is None:
        Macro.setGlobal("q4302_tw", "none")
        return
    pw, ph = pr["right"] - pr["left"], pr["bottom"] - pr["top"]
    left, right = (box["x"] - pr["left"]) / pw, (box["x"] + box["w"] - pr["left"]) / pw
    top, bottom = (box["y"] - pr["top"]) / ph, (box["y"] + box["h"] - pr["top"]) / ph
    v = "top" if top < 0.05 else "bottom" if bottom > 0.95 else "center"
    h = "left" if left < 0.05 else "right" if right > 0.95 else "center"
    Macro.setGlobal("q4302_tw", "center" if (v, h) == ("center", "center")
                    else v + "_" + h)
end

