// S02 LT-17 helpers (WP-43 43-02).  _q4302_hreg <dir> <dash command...>:
// the series legend's hole stylesheet both modes draw (its CSS, "none"
// without one) and its key count, into q4302_h<s|v>; _q4302_htw <svg>
// <base svg> <axis>: the CSS of twoway's tracks -- a key the hole moved
// against the same graph without holes sits after it -- into q4302_htw.
python:
def _q4302_hread(sp, dp, app):
    import dash_render as dr
    from sfi import Macro
    from bokeh.models import Legend, Plot
    for (models, _m), sfx in zip(_q4302_models(sp, dp, app), ("s", "v")):
        out = "none 0"
        for p in models:
            if not isinstance(p, Plot):
                continue
            for lg in p.legend:
                if str(lg.name or "") == dr._COLORVAR_LEGEND_NAME:
                    continue
                css = "".join(ss.css for ss in lg.stylesheets
                              if "dash_legend_holes" in (ss.tags or []))
                out = "%s %d" % (css or "none", len(lg.items))
        Macro.setGlobal("q4302_h" + sfx, out)


def _q4302_htw(path, base, axis):
    from sfi import Macro
    from svg_truth import svg_document
    k = [t for t in svg_document(path)["texts"] if not t["anchor"]]
    k0 = [t for t in svg_document(base)["texts"] if not t["anchor"]]
    a = "y" if axis == "row" else "x"
    if a == "y":
        before = sum(1 for p, q in zip(k, k0) if abs(p[a] - q[a]) > 10)
    else:
        before = sum(1 for p, q in zip(k, k0) if p[a] - q[a] < -10)
    tracks = [i + 1 if i < before else i + 2 for i in range(len(k))]
    css = ".bk-grid{grid-template-%ss:repeat(%d,max-content);}" % (
        axis, len(k) + 1) + "".join(
        ".bk-item:nth-child(%d){grid-%s:%d;}" % (i + 1, axis, t)
        for i, t in enumerate(tracks))
    Macro.setGlobal("q4302_htw", "%s %d" % (css, len(k)))
end

