    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306e23)
    python: _q4306_ev("q4306e23", "x_eval_23", "`=_rc'")
    global G = char(96) + "=min(3,.,1)" + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306e24)
    python: _q4306_ev("q4306e24", "x_eval_24", "`=_rc'")
    global G = char(96) + "=max(1,2)" + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306e25)
    python: _q4306_ev("q4306e25", "x_eval_25", "`=_rc'")
    global G = char(96) + "=sqrt(2)" + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306e26)
    python: _q4306_ev("q4306e26", "x_eval_26", "`=_rc'")
    global G = char(96) + "=ln(1)" + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306e27)
    python: _q4306_ev("q4306e27", "x_eval_27", "`=_rc'")
    global G = char(96) + "=log10(1000)" + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306e28)
    python: _q4306_ev("q4306e28", "x_eval_28", "`=_rc'")
    global G = char(96) + "=int(-2.5)" + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306e29)
    python: _q4306_ev("q4306e29", "x_eval_29", "`=_rc'")
    global G = char(96) + "=ceil(1.2)" + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306e30)
    python: _q4306_ev("q4306e30", "x_eval_30", "`=_rc'")
    global G = char(96) + "=floor(-1.2)" + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306e31)
    python: _q4306_ev("q4306e31", "x_eval_31", "`=_rc'")
    global G = char(96) + "=exp(1)" + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306e32)
    python: _q4306_ev("q4306e32", "x_eval_32", "`=_rc'")
    global G = char(96) + "=sign(-4)" + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306e33)
    python: _q4306_ev("q4306e33", "x_eval_33", "`=_rc'")
    global G = char(96) + "=string(1/3)" + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306e34)
    python: _q4306_ev("q4306e34", "x_eval_34", "`=_rc'")
    global G = char(96) + `"=string(1/3,"%5.2f")"' + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306e35)
    python: _q4306_ev("q4306e35", "x_eval_35", "`=_rc'")
    global G = char(96) + "=strofreal(2)" + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306e36)
    python: _q4306_ev("q4306e36", "x_eval_36", "`=_rc'")
    global G = char(96) + `"=real("3")+1"' + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306e37)
    python: _q4306_ev("q4306e37", "x_eval_37", "`=_rc'")
    global G = char(96) + `"=strlen("abc")"' + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306e38)
    python: _q4306_ev("q4306e38", "x_eval_38", "`=_rc'")
    global G = char(96) + `"=ustrlen("ab")"' + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306e39)
    python: _q4306_ev("q4306e39", "x_eval_39", "`=_rc'")
    global G = char(96) + `"=substr("abcdef",2,3)"' + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306e40)
    python: _q4306_ev("q4306e40", "x_eval_40", "`=_rc'")
    global G = char(96) + `"=usubstr("abc",1,1)"' + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306e41)
    python: _q4306_ev("q4306e41", "x_eval_41", "`=_rc'")
    global G = char(96) + `"=upper("ab")"' + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306e42)
    python: _q4306_ev("q4306e42", "x_eval_42", "`=_rc'")
    global G = char(96) + `"=strupper("ab")"' + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306e43)
    python: _q4306_ev("q4306e43", "x_eval_43", "`=_rc'")
    global G = char(96) + `"=lower("AB")"' + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306e44)
    python: _q4306_ev("q4306e44", "x_eval_44", "`=_rc'")
    global G = char(96) + `"=strlower("AB")"' + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306e45)
    python: _q4306_ev("q4306e45", "x_eval_45", "`=_rc'")
    global G = char(96) + `"=trim("  a ")"' + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306e46)
    python: _q4306_ev("q4306e46", "x_eval_46", "`=_rc'")
    global G = char(96) + `"=strtrim(" a ")"' + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306e47)
    python: _q4306_ev("q4306e47", "x_eval_47", "`=_rc'")
    global G = char(96) + `"="a"+"b""' + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306e48)
    python: _q4306_ev("q4306e48", "x_eval_48", "`=_rc'")
    log close q4306
    python: _q4306_notes("`q6d'/eval.log")
    _w43_expect Q4306-4 "(${q4306_n} == 0)" "the evaluated globals printed the note ${q4306_n} times"
    dash clear
    log using "`q6d'/out.log", text replace name(q4306)
    global G = char(96) + "=_N" + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306o1)
    python: _q4306_ev("q4306o1", "x_eval_out_1", "`=_rc'")
    global G = char(96) + "=mpg[1]" + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306o2)
    python: _q4306_ev("q4306o2", "x_eval_out_2", "`=_rc'")
    global G = char(96) + "=c(N)" + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306o3)
    python: _q4306_ev("q4306o3", "x_eval_out_3", "`=_rc'")
    global G = char(96) + "c(N)" + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306o4)
    python: _q4306_ev("q4306o4", "x_eval_out_4", "`=_rc'")
    log close q4306
    python: _q4306_notes("`q6d'/out.log")
    _w43_expect Q4306-4 "(${q4306_n} == 4)" "the kept globals printed the note ${q4306_n} times, not once a graph"
    _w43_expect Q4306-4 `"("${q4306_bad}" == "")"' "${q4306_bad}"
    // Nothing from a text runs: filewrite() is not listed, so its global
    // is kept as written and no file is written.  Kept as written, its
    // quotes split the line, which dash refuses as twoway's quote rule
    // does (WP-31 D13b: "invalid point", r(198)).
    local sent "`q6d'/q4306_ran"
    capture erase "`sent'"
    global G = char(96) + "=filewrite(" + char(34) + "`sent'" + char(34) + "," + char(34) + "x" + char(34) + ")" + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306w)
    _w43_expect Q4306-4 "(_rc == 198)" "the filewrite() global: rc `=_rc', not the quote refusal"
    capture confirm file "`sent'"
    _w43_expect Q4306-4 "(_rc == 601)" "a filewrite() global wrote `sent'"
    // The one-argument call is the as-text route (ev left unset).
    global G = char(96) + "=1+1" + char(39)
    mata: st_local("q1", strofreal(_dash_at_globals("a \$G b") == "a " + char(96) + "=1+1" + char(39) + " b"))
    _w43_expect Q4306-4 "(`q1' == 1)" "the one-argument _dash_at_globals() did not keep the text"
    mata: st_local("q4306_h", strofreal(_q4306_hostile()))
    _w43_expect Q4306-4 "(`q4306_h' == 0)" "`q4306_h' hostile texts not refused as written, first: `macval(q4306_h1)'"
    _w43_done Q4306-4 "a global's =exp evaluated as twoway draws it (48 probes), the rest drawn as written with one note a graph; nothing run"
    macro drop G

    // ------------------------------------------------------------
    // Q4306-5 (P4-7): the graph text options read globals through the
    // same evaluator: axis 3's title (the _dash_axisn_json route) is
    // global_text_truth.json's eval ytitle drawn text, a title holding
    // `=_N' is drawn as written, and the note is printed once for the
    // graph.
    // ------------------------------------------------------------
    dash clear
    global ZTG_eval = char(96) + "=1+1" + char(39)
    global ZTG_out = char(96) + "=_N" + char(39)
    log using "`q6d'/gt.log", text replace name(q4306)
    capture noisily dash (scatter mpg weight) (scatter price weight, yaxis(3)), ytitle("a \$ZTG_eval b", axis(3)) title("a \$ZTG_out b") name(q4306g)
    local rc = _rc
    log close q4306
    _w43_expect Q4306-5 "(`rc' == 0)" "rc `rc'"
    if `rc' == 0 {
        python: _q4306_gt("q4306g")
        _w43_expect Q4306-5 `"("${q4306_g}" == "ok")"' "${q4306_g}"
    }
    python: _q4306_notes("`q6d'/gt.log")
    _w43_expect Q4306-5 "(${q4306_n} == 1)" "the note printed ${q4306_n} times for the graph"
    _w43_done Q4306-5 "the graph text options' globals evaluated by the same evaluator; the note once a graph"
    macro drop ZTG_eval ZTG_out

    local q6f : dir "`q6d'" files "*"
    foreach f of local q6f {
        capture erase "`q6d'/`f'"
    }
    capture rmdir "`q6d'"
    capture graph drop _all
    dash clear
    macro drop q4306_*
    display as text "S06 end " c(current_date) " " c(current_time)
}
* ==== end S06 ====

* ==== append new blocks above this line ====

// ----------------------------------------------------------------
// Summary (test_wp29_truth.cscript's shape)
// ----------------------------------------------------------------
capture graph drop _all
capture dash clear
capture rmdir "`w43_work'"
local nfail    = ${w43_nfail}
local faillist "${w43_faillist}"
local ncase    = ${w43_ncase}
local only : env WP43_ONLY
macro drop w43_nfail w43_faillist w43_bad w43_ncase
display as text ""
display as text "============================================================"
if `ncase' == 0 {
    if `w43_N' > 1 & `"`macval(only)'"' == "" & "`w43_run'" == "" {
        display as text "test_wp43_truth: part `w43_k'/`w43_N' has no block to run"
        display as text "============================================================"
        exit 0
    }
    // A WP43_ONLY that names no block, or only a stub, ran nothing:
    // that is not a pass.
    display as error "  test_wp43_truth: no case ran (WP43_ONLY=`only')"
    display as text "============================================================"
    exit 9
}
else if `nfail' == 0 {
    display as text "  test_wp43_truth: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_wp43_truth: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
