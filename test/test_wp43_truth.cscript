            _w43_expect Q4302-3 `"("`gv' `gk'" == "`tdv' `tnk'")"' `"legend(`lo') `m': dash visible/keys `gv' `gk'; twoway drawn/keys `tdv' `tnk'"'
            _w43_expect Q4302-3 "(${q4302_n`m'} == 0)" `"legend(`lo') `m': ${q4302_n`m'} notes name a sub-option dash does not implement"'
        }
