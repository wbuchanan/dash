// S03 helpers (WP-43 43-03).  _q4303_reg <dir> <dash command...>: register
// one graph and read the series legend both modes draw -- its region
// box's line and fill colours and padding, and the CSS of its key-text
// stylesheet (tag dash_legend_keytext, "none" without one) -- into
// q4303_<s|v> ("<line> <fill> <padding> <css>"), and the count of notes
// naming a legend() sub-option or a legend style into q4303_n<s|v>; _q4303_same <svg>
// <svg>: 1 when two twoway SVGs draw the same rects and texts, into
// q4303_same.  Built on S02's _q4302_models.
python:
def _q4303_read(sp, dp, app):
    import dash_render as dr
    from sfi import Macro
    from bokeh.models import Legend, Plot
    for (models, msgs), sfx in zip(_q4302_models(sp, dp, app), ("s", "v")):
        out = "none"
        for p in models:
            if not isinstance(p, Plot):
                continue
            for side in ("center", "above", "below", "left", "right"):
                for lg in getattr(p, side):
                    if (isinstance(lg, Legend) and str(lg.name or "")
                            != dr._COLORVAR_LEGEND_NAME and out == "none"):
                        css = "".join(ss.css for ss in lg.stylesheets
                                      if "dash_legend_keytext"
                                      in (ss.tags or []))
                        pad = lg.padding
                        if isinstance(pad, (tuple, list)):
                            pad = ",".join(str(v) for v in pad)
                        out = "%s %s %s %s" % (
                            lg.border_line_color, lg.background_fill_color,
                            pad, css or "none")
        Macro.setGlobal("q4303_" + sfx, out)
        Macro.setGlobal("q4303_n" + sfx, str(sum(
            1 for m in msgs if "legend" in m)))


def _q4303_same(a, b):
    from sfi import Macro
    from svg_truth import svg_document, svg_rects
    same = (svg_rects(a) == svg_rects(b)
            and svg_document(a)["texts"] == svg_document(b)["texts"])
    Macro.setGlobal("q4303_same", "1" if same else "0")
end

