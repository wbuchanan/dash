            _w43_expect Q4302-1 "((${q4302_n`m'} > 0) == ${q4302_twn})" `"`o' `m': dash notes ${q4302_n`m'}; twoway noted ${q4302_twn}"'
        }
    }
    _w43_done Q4302-1 "an inside legend sits at the compass point bplacement() names, every twoway spelling read, saved and served"

    forvalues j = 1/`k' {
