        gettoken g lo : o, parse("|")
        local lo = substr("`lo'", 2, .)
        quietly twoway ``g'', scheme(s2color) legend(`lo') name(q02l, replace)
        local tdv "`.q02l.legend.draw_view.istrue'"
        local tnk "`.q02l.legend.keys.arrnels'"
        _q4302_reg "`q02d'" implemented ``g'', scheme(s2color) legend(`lo') name(q02e)
        foreach m in s v {
