    python: import __main__ as _q4302_m; _q4302_m._q4302_hread("`dir'/s.json", "`dir'/d.json", "`dir'/a.py")
end

* ==== S02 LT-17: legend holes in one column or one row ====
local only : env WP43_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w43_run' {
    display as text "S02 start " c(current_date) " " c(current_time)
