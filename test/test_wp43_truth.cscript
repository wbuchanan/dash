// S03 LT-3 helper.  _q4303_kt <svg> <base svg> <dir>: twoway's key-text
// frame, margin and move from an SVG of legend(<options>) against the
// same graph's default -- the frame's fill and line (the rects round the
// first key text), its left margin and the text's move down, both in
// text sizes -- beside the key-text stylesheet of the graph registered
// last in <dir> (s.json, d.json), saved and served: "ok" or what differs,
// into q4303_k<s|v>.
python:
def _q4303_kt(svg, base, d):
    import re
    import dash_render as dr
    from sfi import Macro
    from bokeh.models import Legend, Plot
    from svg_truth import svg_document, svg_rects
    keys = [t for t in svg_document(svg)["texts"] if not t["anchor"]]
    k0 = [t for t in svg_document(base)["texts"] if not t["anchor"]]
    t, t0 = keys[0], k0[0]
    size = float(t["size"])
    hold = [r for r in svg_rects(svg) if r["w"] and r["w"] < 3000
            and r["x"] - 30 <= t["x"] <= r["x"] + r["w"]
            and r["y"] <= t["y"] <= r["y"] + r["h"] + 1
            and not any(r["x"] <= k["x"] <= r["x"] + r["w"]
                        and r["y"] <= k["y"] <= r["y"] + r["h"]
                        for k in keys[1:])]
    fill = [r for r in hold if r["fill"] not in (None, "none")]
    line = [r for r in hold if r["fill"] in (None, "none")]
    tw = {"fill": fill[0]["fill"] if fill else None,
          "line": (line[0]["stroke"] if line and (line[0]["stroke_opacity"]
                                                  is None or line[0]
                                                  ["stroke_opacity"] > 0)
                   else None) if fill else None,
          "margin": round((t["x"] - fill[0]["x"]) / size, 3) if fill
          else 0.0}
    # The move: against the frame (its top is 0.85 of a size and the
    # margin above the baseline), else against the default's baseline.
    tw["move"] = round((t["y"] - fill[0]["y"]) / size - tw["margin"]
                       - 0.85, 3) if fill else round((t["y"] - t0["y"])
                                                     / size, 3)
    for (models, _m), sfx in zip(_q4302_models(d + "/s.json", d + "/d.json",
                                               d + "/a.py"), ("s", "v")):
        css = ""
        for p in models:
            if isinstance(p, Plot):
                for lg in p.select({"type": Legend}):
                    if str(lg.name or "") != dr._COLORVAR_LEGEND_NAME:
                        css = "".join(ss.css for ss in lg.stylesheets
                                      if "dash_legend_keytext"
                                      in (ss.tags or []))

        def decl(rule, prop):
            i = css.find(rule + "{")
            if i < 0:
                return None
            body = css[i + len(rule) + 1:css.index("}", i)]
            for x in body.split(";"):
                if x.startswith(prop + ":"):
                    return x.split(":", 1)[1]
            return None
        b = ".bk-label::before"
        pad = decl(".bk-label", "padding")
        top = decl(".bk-label", "top")
        ol = decl(b, "outline")
        got = {"fill": decl(b, "background-color"),
               "line": ol.split()[-1] if ol else None,
               "margin": round(float(pad.split()[3][:-2]), 3) if pad else 0.0,
               "move": round(float(top[:-2]), 3) if top else 0.0}
        bad = [k for k in tw if (abs(tw[k] - got[k]) > 0.01
                                 if k in ("margin", "move")
                                 else tw[k] != got[k])]
        Macro.setGlobal("q4303_k" + sfx, "ok" if not bad else
                        "dash %s, twoway %s" % (got, tw))
end

* ==== S03 LT-3: the key texts' textbox options ====
local only : env WP43_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w43_run' {
    display as text "S03 start " c(current_date) " " c(current_time)
    local q03d "`w43_work'/s03b"
    capture mkdir "`q03d'"
    capture graph drop _all
    sysuse auto, clear
    local three (scatter mpg weight) (scatter price weight) (scatter turn weight)
    quietly twoway `three', scheme(s2color) name(q03c, replace)
    capture erase "`q03d'/q03c.svg"
    cert_svg_export, name(q03c) file("`q03d'/q03c.svg")

    // ------------------------------------------------------------
    // Q4303-2: box, bcolor(), fcolor(), lcolor() and lpattern() -- live
    // twoway's frame round the first key text (fill and line, none for
    // a dashed line) beside the frame dash's key-text stylesheet draws,
    // saved and served.
    // Q4303-3: margin() and alignment() -- live twoway's left margin
    // and the text's move in text sizes (in its frame, or against the
    // default's baseline without box) beside dash's padding and move.
    // ------------------------------------------------------------
    local k 0
    foreach id in Q4303-2 Q4303-3 {
        if "`id'" == "Q4303-2" local opts `""box" "box bcolor(gs14)" "box fcolor(red)" "box lcolor(red) lpattern(dash)""'
        else local opts `""box margin(large)" "box margin(small)" "box alignment(top)" "alignment(baseline)""'
        foreach lo of local opts {
            local ++k
            quietly twoway `three', scheme(s2color) legend(`lo') name(q03k, replace)
            capture erase "`q03d'/q03k`k'.svg"
            cert_svg_export, name(q03k) file("`q03d'/q03k`k'.svg")
            dash clear
            quietly dash `three', scheme(s2color) legend(`lo') name(q03e)
            _dash_serve_spec, specpath("`q03d'/s.json") datapath("`q03d'/d.json")
            python: import __main__ as _q4303_m; _q4303_m._q4303_kt("`q03d'/q03k`k'.svg", "`q03d'/q03c.svg", "`q03d'")
            foreach m in s v {
                _w43_expect `id' `"("${q4303_k`m'}" == "ok")"' `"legend(`lo') `m': ${q4303_k`m'}"'
            }
        }
        if "`id'" == "Q4303-2" _w43_done Q4303-2 "legend(box) and its colours frame the key texts as twoway's, saved and served"
        else _w43_done Q4303-3 "legend(margin()) and alignment() pad and move the key texts as twoway's, saved and served"
    }

    forvalues j = 1/`k' {
        capture erase "`q03d'/q03k`j'.svg"
    }
    foreach f in q03c.svg s.json d.json a.py {
        capture erase "`q03d'/`f'"
    }
    capture rmdir "`q03d'"
    macro drop q4303_ks q4303_kv
    capture graph drop _all
    dash clear
    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

// S03 LT-6 helper.  _q4303_lay <svg> <base svg> <what> <dir>: one fact of
// twoway's legend from an SVG of legend(<options>) against the same
// graph's default -- "cols" its key columns, "index" its key texts,
// "width"/"height" its box less 2.4 units in units, "dx"/"dy" its box's
// move right and up in units, "line" its frame colour (none for no box)
// beside the same fact of the series legend of the graph registered
// last in <dir>, saved and served: "ok" or what differs, into
// q4303_l<s|v>.
python:
def _q4303_lay(svg, base, what, d):
    import re
    import dash_render as dr
    from sfi import Macro
    from bokeh.models import Legend, Plot
    from svg_truth import svg_document, svg_rects
    U = 28.8
    T = dr.OptionTranslator
    pxu = T.PT_PER_RS * T.PX_PER_PT

    def keys(p):
        return [t for t in svg_document(p)["texts"] if not t["anchor"]]

    def box(p):
        ks = keys(p)
        rs = [r for r in svg_rects(p) if r["w"] and r["w"] < 3900
              and all(r["x"] <= k["x"] <= r["x"] + r["w"]
                      and r["y"] <= k["y"] <= r["y"] + r["h"] for k in ks)]
        f = [r for r in rs if r["fill"] not in (None, "none")]
        ln = [r for r in rs if r["fill"] in (None, "none")]
        return (min(f, key=lambda r: r["w"]) if f else None,
                min(ln, key=lambda r: r["w"])["stroke"] if ln else "none")
    k = keys(svg)
    b, line = box(svg)
    b0, _l = box(base)
    tw = {"cols": len({round(t["x"]) for t in k}),
          "index": "|".join(t["text"] for t in k),
          "width": round(b["w"] / U - 2.4, 2) if b else None,
          "height": round(b["h"] / U - 2.4, 2) if b else None,
          "dx": round((b["x"] - b0["x"]) / U, 2) if b else None,
          "dy": round((b0["y"] - b["y"]) / U, 2) if b else None,
          "line": line}[what]
    for (models, _m), sfx in zip(_q4302_models(d + "/s.json", d + "/d.json",
                                               d + "/a.py"), ("s", "v")):
        lg = None
        for p in models:
            if isinstance(p, Plot):
                for m in p.select({"type": Legend}):
                    if str(m.name or "") != dr._COLORVAR_LEGEND_NAME:
                        lg = m
        css = "".join(ss.css for ss in lg.stylesheets
                      if "dash_legend_layout" in (ss.tags or []))
        nums = [float(x) for x in re.findall(r"calc\(([-0-9.e]+)px", css)]
        pad = lg.padding if isinstance(lg.padding, int) else 0
        if what == "cols":
            got = lg.ncols
        elif what == "index":
            got = "|".join(str(dr._dash_legend_item_text(i)
                               if hasattr(dr, "_dash_legend_item_text")
                               else (i.label.get("value")
                                     if isinstance(i.label, dict)
                                     else getattr(i.label, "value", "")))
                           for i in lg.items)
        elif what in ("width", "height"):
            got = round((nums[0] - 2 * pad) / pxu, 2) if nums else None
        elif what == "dx":
            got = round(nums[0] / pxu, 2) if nums else None
        elif what == "dy":
            got = round(-nums[1] / pxu, 2) if len(nums) > 1 else None
        else:
            got = str(lg.border_line_color or "none").lower()
        if what in ("width", "height", "dx", "dy"):
            ok = got is not None and abs(got - tw) <= 0.05
        else:
            ok = got == tw
        Macro.setGlobal("q4303_l" + sfx, "ok" if ok else
                        "dash %s, twoway %s" % (got, tw))
end

* ==== S03 LT-6: legend layout and region style sub-options ====
local only : env WP43_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w43_run' {
    display as text "S03 start " c(current_date) " " c(current_time)
    local q03d "`w43_work'/s03c"
    capture mkdir "`q03d'"
    capture graph drop _all
    sysuse auto, clear
    local three (scatter mpg weight) (scatter price weight) (scatter turn weight)
    quietly twoway `three', scheme(s2color) name(q03c, replace)
    capture erase "`q03d'/q03c.svg"
    cert_svg_export, name(q03c) file("`q03d'/q03c.svg")

    // ------------------------------------------------------------
    // Q4303-4: style(column), showindex and region(style(none))/
    // region(lstyle(p1)) -- live twoway's key columns, key texts and
    // frame colour beside dash's, saved and served; style(bogus) noted.
    // Q4303-5: width(), height(), xoffset() and yoffset() -- live
    // twoway's box size (less its margins) and move in units beside
    // dash's least size and move, saved and served.
    // ------------------------------------------------------------
    local k 0
    foreach id in Q4303-4 Q4303-5 {
        if "`id'" == "Q4303-4" local opts `""style(column)|cols" "showindex|index" "region(style(none))|line" "region(lstyle(p1))|line""'
        else local opts `""cols(1) width(60)|width" "height(30)|height" "xoffset(5)|dx" "yoffset(5)|dy""'
        foreach o of local opts {
            local ++k
            gettoken lo what : o, parse("|")
            local what = substr("`what'", 2, .)
            quietly twoway `three', scheme(s2color) legend(`lo') name(q03l, replace)
            capture erase "`q03d'/q03l`k'.svg"
            cert_svg_export, name(q03l) file("`q03d'/q03l`k'.svg")
            local bsv "`q03d'/q03c.svg"
            if "`what'" == "width" {
                quietly twoway `three', scheme(s2color) legend(cols(1)) name(q03m, replace)
                capture erase "`q03d'/q03m.svg"
                cert_svg_export, name(q03m) file("`q03d'/q03m.svg")
                local bsv "`q03d'/q03m.svg"
            }
            dash clear
            quietly dash `three', scheme(s2color) legend(`lo') name(q03e)
            _dash_serve_spec, specpath("`q03d'/s.json") datapath("`q03d'/d.json")
            python: import __main__ as _q4303_m; _q4303_m._q4303_lay("`q03d'/q03l`k'.svg", "`bsv'", "`what'", "`q03d'")
            foreach m in s v {
                _w43_expect `id' `"("${q4303_l`m'}" == "ok")"' `"legend(`lo') `m': ${q4303_l`m'}"'
            }
        }
        if "`id'" == "Q4303-4" {
            _q4303_reg "`q03d'" `three', scheme(s2color) legend(style(bogus)) name(q03e)
            _w43_expect Q4303-4 "(${q4303_ns} >= 1 & ${q4303_nv} >= 1)" "legend(style(bogus)) printed no note"
            _w43_done Q4303-4 "legend(style()), showindex and the region styles drawn as twoway's, saved and served"
        }
        else _w43_done Q4303-5 "legend(width() height() xoffset() yoffset()) size and move the box as twoway's, saved and served"
    }

    forvalues j = 1/`k' {
        capture erase "`q03d'/q03l`j'.svg"
    }
    foreach f in q03c.svg q03m.svg s.json d.json a.py {
        capture erase "`q03d'/`f'"
    }
    capture rmdir "`q03d'"
    macro drop q4303_ls q4303_lv q4303_s q4303_v q4303_ns q4303_nv
    capture graph drop _all
    dash clear
    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

// S03 LT-10 helper.  _q4303_mar <svg> <base svg> <what> <dir>: live
// twoway's box growth from an SVG against the same graph without the
// margin -- "title": the title box's width less the default's, "legend":
// the legend box's width and height less the default's, in units --
// beside dash's padding of the graph registered last in <dir> against
// the default sides (the Title's text box margin, the legend's padding),
// saved and served: "ok" or what differs, into q4303_m<s|v>.
python:
def _q4303_mar(svg, base, what, d, dflt):
    import dash_render as dr
    from sfi import Macro
    from bokeh.models import Legend, Plot
    from svg_truth import svg_document, svg_rects
    U = 28.8
    T = dr.OptionTranslator
    pxu = T.PT_PER_RS * T.PX_PER_PT

    def tbox(p):
        rs = [r for r in svg_rects(p) if r["fill"] == "#d9e6eb"]
        return rs[0] if rs else None

    def lbox(p):
        ks = [t for t in svg_document(p)["texts"] if not t["anchor"]]
        rs = [r for r in svg_rects(p) if r["w"] and r["w"] < 3900
              and r["fill"] not in (None, "none")
              and all(r["x"] <= k["x"] <= r["x"] + r["w"]
                      and r["y"] <= k["y"] <= r["y"] + r["h"] for k in ks)]
        return min(rs, key=lambda r: r["w"])
    if what == "title":
        tw = (round((tbox(svg)["w"] - tbox(base)["w"]) / U, 1),)
    else:
        a, b = lbox(svg), lbox(base)
        tw = (round((a["w"] - b["w"]) / U, 1), round((a["h"] - b["h"]) / U, 1))
    for (models, _m), sfx in zip(_q4302_models(d + "/s.json", d + "/d.json",
                                               d + "/a.py"), ("s", "v")):
        got = None
        for p in models:
            if not isinstance(p, Plot):
                continue
            if what == "title" and p.title is not None and p.title.text:
                pd = p.title.padding
                got = (round((pd["left"] + pd["right"]) / pxu - dflt, 1),)
            elif what == "legend":
                for lg in p.select({"type": Legend}):
                    if str(lg.name or "") != dr._COLORVAR_LEGEND_NAME:
                        q = lg.padding
                        q = (q,) * 4 if isinstance(q, int) else q
                        got = (round((q[0] + q[1]) / pxu - dflt, 1),
                               round((q[2] + q[3]) / pxu - dflt, 1))
        ok = got is not None and all(abs(x - y) <= 0.15
                                     for x, y in zip(got, tw))
        Macro.setGlobal("q4303_m" + sfx, "ok" if ok else
                        "dash %s, twoway %s" % (got, tw))
end

* ==== S03 LT-10: every marginstyle form; the legend's margin per side ====
local only : env WP43_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w43_run' {
    display as text "S03 start " c(current_date) " " c(current_time)
    local q03d "`w43_work'/s03d"
    capture mkdir "`q03d'"
    capture graph drop _all
    sysuse auto, clear
    local three (scatter mpg weight) (scatter price weight) (scatter turn weight)

    // ------------------------------------------------------------
    // Q4303-7: title("T", box margin(l=20 | 1 2 3 4 | l+5)) and
    // legend(region(margin(l=20 | 1 20 1 1))) -- live twoway's box
    // growth in units against its default beside the growth of dash's
    // padding (each side kept), saved and served, with no note.
    // ------------------------------------------------------------
    quietly twoway `three', scheme(s2color) title("T", box) name(q03t, replace)
    capture erase "`q03d'/q03t.svg"
    cert_svg_export, name(q03t) file("`q03d'/q03t.svg")
    quietly twoway `three', scheme(s2color) name(q03c, replace)
    capture erase "`q03d'/q03c.svg"
    cert_svg_export, name(q03c) file("`q03d'/q03c.svg")
    local k 0
    foreach o in "title|l=20" "title|1 2 3 4" "title|l+5" "legend|l=20" "legend|1 20 1 1" {
        local ++k
        gettoken what m : o, parse("|")
        local m = substr("`m'", 2, .)
        if "`what'" == "title" {
            local opt title("T", box margin(`m'))
            local bsv "`q03d'/q03t.svg"
            local dflt 1.2
        }
        else {
            local opt legend(region(margin(`m')))
            local bsv "`q03d'/q03c.svg"
            local dflt = 2 * 5 / (2.88 * 4 / 3)
        }
        quietly twoway `three', scheme(s2color) `opt' name(q03n, replace)
        capture erase "`q03d'/q03n`k'.svg"
        cert_svg_export, name(q03n) file("`q03d'/q03n`k'.svg")
        _q4303_reg "`q03d'" `three', scheme(s2color) `opt' name(q03e)
        local ns ${q4303_ns}
        local nv ${q4303_nv}
        python: import __main__ as _q4303_m; _q4303_m._q4303_mar("`q03d'/q03n`k'.svg", "`bsv'", "`what'", "`q03d'", `dflt')
        foreach mm in s v {
            _w43_expect Q4303-7 `"("${q4303_m`mm'}" == "ok")"' `"`opt' `mm': ${q4303_m`mm'}"'
        }
        _w43_expect Q4303-7 "(`ns' == 0 & `nv' == 0)" `"`opt' printed a note"'
    }
    _w43_done Q4303-7 "every marginstyle form and the legend's four sides drawn as twoway's, saved and served"

    forvalues j = 1/`k' {
        capture erase "`q03d'/q03n`j'.svg"
    }
    foreach f in q03t.svg q03c.svg s.json d.json a.py {
        capture erase "`q03d'/`f'"
    }
    capture rmdir "`q03d'"
    macro drop q4303_ms q4303_mv q4303_s q4303_v q4303_ns q4303_nv
    capture graph drop _all
    dash clear
    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

// S04 helpers (WP-43 43-04).  _q4304_read <dir>: the series legend a
// registered graph draws, saved and served (_q4302_models): its
// dash_legend_keyorder stylesheet ("none" without one) into q4304_cs and
// q4304_cv, its key texts joined by "|" into q4304_ks and q4304_kv, and
// the count of notes naming legend() into q4304_ns and q4304_nv.
// _q4304_tw <svg>: twoway's key texts from its SVG (the texts inside the
// framed box holding the most texts, the legend's, in reading order) into
// q4304_tw, and "end" when every one ends at its x (textfirst) into
// q4304_anchor.
python:
def _q4304_read(sp, dp, app):
    import dash_render as dr
    from sfi import Macro
    from bokeh.models import Legend, Plot
    for (models, msgs), sfx in zip(_q4302_models(sp, dp, app), ("s", "v")):
        css, keys = "none", None
        for p in models:
            if not isinstance(p, Plot):
                continue
            for side in ("center", "above", "below", "left", "right"):
                for lg in getattr(p, side):
                    if (not isinstance(lg, Legend) or keys is not None
                            or str(lg.name or "")
                            == dr._COLORVAR_LEGEND_NAME):
                        continue
                    css = "".join(ss.css for ss in lg.stylesheets
                                  if "dash_legend_keyorder"
                                  in (ss.tags or [])) or "none"
                    keys = []
                    for it in lg.items:
                        lab = it.label
                        t = (lab.get("value") if isinstance(lab, dict)
                             else getattr(lab, "value", lab))
                        keys.append(str(t))
        Macro.setGlobal("q4304_c" + sfx, css)
        Macro.setGlobal("q4304_k" + sfx, "|".join(keys or []))
        Macro.setGlobal("q4304_n" + sfx, str(sum(
            1 for m in msgs if "legend()" in m)))


def _q4304_tw(path):
    import re
    from sfi import Macro
    with open(path, encoding="utf-8") as fh:
        src = fh.read()
    att = lambda s: dict(re.findall(r'([a-zA-Z0-9_:-]+)="([^"]*)"', s))
    vb = [float(v) for v in re.search(r'viewBox="([-0-9. ]+)"',
                                      src).group(1).split()]
    frames = [att(a) for a in re.findall(r"<rect\b([^>]*)/?>", src)]
    frames = [a for a in frames if "stroke:" in a.get("style", "")
              and float(a.get("width", 0)) * float(a.get("height", 0))
              < vb[2] * vb[3] / 4]
    every = []
    for a, body in re.findall(r"<text\b([^>]*)>([^<]*)</text>", src):
        a = att(a)
        every.append((round(float(a["y"]), 1), float(a["x"]),
                      body.replace("&amp;", "&"),
                      a.get("text-anchor", "start")))
    texts = []
    for f in frames:
        fx, fy = float(f["x"]), float(f["y"])
        inside = [t for t in every
                  if fx <= t[1] <= fx + float(f["width"])
                  and fy <= t[0] <= fy + float(f["height"])]
        if len(inside) > len(texts):
            texts = inside
    texts.sort()
    Macro.setGlobal("q4304_tw", "|".join(t[2] for t in texts))
    Macro.setGlobal("q4304_anchor", "end" if texts and all(
        t[3] == "end" for t in texts) else "start")
end

capture program drop _q4304_reg
program define _q4304_reg
    version 19
    gettoken dir 0 : 0
    dash clear
    quietly dash `0'
    _dash_serve_spec, specpath("`dir'/s.json") datapath("`dir'/d.json")
    python: import __main__ as _q4304_m; _q4304_m._q4304_read("`dir'/s.json", "`dir'/d.json", "`dir'/a.py")
end

// _q4304_mk <dir>: the first key of the series legend a registered
// graph draws, saved and served (_q4302_models): 1 in q4304_ps and
// q4304_pv when it is a painted key proxy (__dash_keyproxy), and its
// marker's width (size plus line width) over the key text's px size in
// q4304_ws and q4304_wv.  _q4304_twmk <svg>: twoway's first legend key's
// filled circle's width over its key text's size, into q4304_tww.
python:
def _q4304_mk(sp, dp, app):
    import dash_render as dr
    from sfi import Macro
    from bokeh.models import Legend, Plot
    for (models, _msgs), sfx in zip(_q4302_models(sp, dp, app), ("s", "v")):
        painted, width = "0", "."
        for p in models:
            if not isinstance(p, Plot) or width != ".":
                continue
            for side in ("center", "above", "below", "left", "right"):
                for lg in getattr(p, side):
                    if (not isinstance(lg, Legend) or width != "."
                            or str(lg.name or "")
                            == dr._COLORVAR_LEGEND_NAME or not lg.items):
                        continue
                    r = lg.items[0].renderers[0]
                    T = dr.OptionTranslator
                    fs = T.css_to_pt(lg.label_text_font_size) * T.PX_PER_PT
                    painted = "1" if str(r.name) == "__dash_keyproxy" else "0"
                    g = r.glyph
                    try:
                        width = repr((float(g.size) + float(g.line_width))
                                     / fs)
                    except (TypeError, ValueError):
                        width = "."
        Macro.setGlobal("q4304_p" + sfx, painted)
        Macro.setGlobal("q4304_w" + sfx, width)


def _q4304_twmk(path):
    import re
    from sfi import Macro
    with open(path, encoding="utf-8") as fh:
        src = fh.read()
    att = lambda s: dict(re.findall(r'([a-zA-Z0-9_:-]+)="([^"]*)"', s))
    vb = [float(v) for v in re.search(r'viewBox="([-0-9. ]+)"',
                                      src).group(1).split()]
    frames = [att(a) for a in re.findall(r"<rect\b([^>]*)/?>", src)]
    frames = [a for a in frames if "stroke:" in a.get("style", "")
              and float(a.get("width", 0)) * float(a.get("height", 0))
              < vb[2] * vb[3] / 4]
    every = [att(a) for a, _b in re.findall(
        r"<text\b([^>]*)>([^<]*)</text>", src)]
    best, texts = None, []
    for f in frames:
        fx, fy = float(f["x"]), float(f["y"])
        fw, fhh = float(f["width"]), float(f["height"])
        inside = [a for a in every if fx <= float(a["x"]) <= fx + fw
                  and fy <= float(a["y"]) <= fy + fhh]
        if len(inside) > len(texts):
            best, texts = f, inside
    out = "."
    if best is not None and texts:
        fs = float(texts[0]["style"].split("font-size:")[1].split("px")[0])
        fx, fy = float(best["x"]), float(best["y"])
        dots = [att(a) for a in re.findall(r"<circle\b([^>]*)/?>", src)]
        dots = [a for a in dots if "fill:none" not in a.get("style", "")
                and fx <= float(a["cx"]) <= fx + float(best["width"])
                and fy <= float(a["cy"]) <= fy + float(best["height"])]
        dots.sort(key=lambda a: float(a["cx"]))
        if dots:
            out = repr(2 * float(dots[0]["r"]) / fs)
    Macro.setGlobal("q4304_tww", out)
end

capture program drop _q4304_regmk
