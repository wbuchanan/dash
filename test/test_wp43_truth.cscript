    // ------------------------------------------------------------
    // Q4302-2: legend(holes(k) cols(1)) and holes(2) rows(1) -- live
    // twoway's key places against the same graph without holes (a hole
    // is one row or column gap at its place) beside the tracks of dash's
    // legend grid, saved and served: the keys, no hole item, each in
    // twoway's place.
    // ------------------------------------------------------------
    local k 0
    foreach o in "holes(1) cols(1)|cols(1)|row" "holes(2) cols(1)|cols(1)|row" "holes(4) cols(1)|cols(1)|row" "holes(2) rows(1)|rows(1)|column" {
        local ++k
        gettoken ho rest : o, parse("|")
        gettoken bar rest : rest, parse("|")
        gettoken bo rest : rest, parse("|")
