        python: from sfi import Macro as _q4302_M; _q4302_M.setGlobal("q4302_twn", str(int("not found in class compass2dir" in open("`q02d'/tw`k'.log", encoding="utf-8", errors="replace").read())))
        capture erase "`q02d'/q02t`k'.svg"
