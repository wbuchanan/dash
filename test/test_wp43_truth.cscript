// S05 helpers (WP-43 43-05).  _q4305_docs: the figures a registered
// graph draws, saved and served (spec and data from _dash_serve_spec);
// _q4305_model: the model drawing a title-family key's text;
// _q4305_box: the box fill and line of that model against
// title_box_truth.json's probe <case> (the smallest filled and stroked
// rects holding the text), into globals q4305_s and q4305_v.
python:
import os as _q4305_os, sys as _q4305_sys, json as _q4305_json
for _q4305_p in (_q4305_os.path.abspath(".."),
                 _q4305_os.path.abspath(_q4305_os.path.join("..", "scripts"))):
    if _q4305_p not in _q4305_sys.path:
        _q4305_sys.path.insert(0, _q4305_p)
with open(_q4305_os.path.join("fixtures", "title_box_truth.json"),
          encoding="utf-8") as _q4305_fh:
    _q4305_T = _q4305_json.load(_q4305_fh)


def _q4305_docs(sp, dp, app):
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_q4305_app")
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_q4305_app.py",
                     "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    sv = [m for m in doc.models if type(m).__name__ == "figure"]
    return list(r.figures.values()), sv


def _q4305_model(fig, key):
    if key == "title" and fig.title is not None:
        return fig.title
    for side in ("center", "above", "below", "left", "right"):
        for m in getattr(fig, side):
            if key in list(getattr(m, "tags", None) or []):
                return m
    return None


def _q4305_svg_box(case, text):
    row = _q4305_T[case]
    t = [x for x in row["texts"] if x["text"] == text][0]
    holds = [r for r in row["rects"]
             if r["x"] <= t["x"] <= r["x"] + r["w"]
             and r["y"] - 1 <= t["y"] <= r["y"] + r["h"] + 1
             and r["w"] < row["viewbox"][2] / 2]
    f = min([r for r in holds if "fill:none" not in r["style"]],
            key=lambda r: r["w"])
    s = min([r for r in holds if "stroke:#" in r["style"]],
            key=lambda r: r["w"])

    def part(style, name):
        for kv in style.split(";"):
            if kv.startswith(name + ":"):
                return kv.split(":", 1)[1].lower()
        return None
    return part(f["style"], "fill"), part(s["style"], "stroke")


def _q4305_box(sp, dp, app, key, text, case):
    from sfi import Macro
    fill, stroke = _q4305_svg_box(case, text)
    a, b = _q4305_docs(sp, dp, app)
    for figs, sfx in ((a, "s"), (b, "v")):
        m = _q4305_model(figs[0], key) if len(figs) == 1 else None
        if m is None:
            Macro.setGlobal("q4305_" + sfx, "no model")
            continue
        got = (str(m.background_fill_color).lower(),
               str(m.border_line_color).lower())
        Macro.setGlobal("q4305_" + sfx, "ok" if got == (fill, stroke) else
                        "drawn %s, twoway %s" % (got, (fill, stroke)))
end

* ==== S05 LT-8: title boxes in the scheme's textbox fill and line ====
local only : env WP43_ONLY
if inlist("`only'", "", "S05") & `: list posof "S05" in w43_run' {
    display as text "S05 start " c(current_date) " " c(current_time)
    local q5d "`w43_work'/s05"
    capture mkdir "`q5d'"
    capture graph drop _all
    sysuse auto, clear

    // ------------------------------------------------------------
    // Q4305-1: title(), subtitle(), note() and caption() with box, under
    // stcolor and s2color, are filled and lined as twoway draws them
    // (title_box_truth.json box_<key>_<scheme>), saved and served.
    // ------------------------------------------------------------
    foreach s in stcolor s2color {
        foreach k in title subtitle note caption {
            local t = upper(substr("`k'", 1, 1))
            dash clear
            capture noisily dash scatter mpg weight, `k'("`t'", box) scheme(`s') name(q4305a)
            local rc = _rc
            _w43_expect Q4305-1 "(`rc' == 0)" "`k' `s': rc `rc'"
            if `rc' == 0 {
                capture erase "`q5d'/a.py"
                _dash_serve_spec, specpath("`q5d'/s.json") datapath("`q5d'/d.json")
                python: _q4305_box("`q5d'/s.json", "`q5d'/d.json", "`q5d'/a.py", "`k'", "`t'", "box_`k'_`s'")
                foreach m in s v {
                    _w43_expect Q4305-1 `"("${q4305_`m'}" == "ok")"' "`k' `s' `m': ${q4305_`m'}"
                }
            }
        }
    }
    _w43_done Q4305-1 "title-family boxes take their text box style's fill and line, saved and served"

    local q5f : dir "`q5d'" files "*"
    foreach f of local q5f {
        capture erase "`q5d'/`f'"
    }
    capture rmdir "`q5d'"
    capture graph drop _all
    dash clear
    macro drop q4305_*
    display as text "S05 end " c(current_date) " " c(current_time)
}
* ==== end S05 ====

// S05 LT-9 helper: _q4305_order -- in both modes, the model tagged
// <outer> (or the Legend, "legend") lies further out on panel <side>
// than the one tagged <inner>, as the probe <case> of title_box_truth.json
// measured; "center" for <outer> asks that the Legend be inside the plot.
python:
def _q4305_order(sp, dp, app, side, outer, inner):
    from sfi import Macro
    a, b = _q4305_docs(sp, dp, app)

    def at(panel, key):
        for i, m in enumerate(panel):
            if key == "legend" and type(m).__name__ == "Legend":
                return i
            if key in list(getattr(m, "tags", None) or []):
                return i
        return None
    for figs, sfx in ((a, "s"), (b, "v")):
        f = figs[0]
        if outer == "center":
            ok = any(type(m).__name__ == "Legend" for m in f.center)
            Macro.setGlobal("q4305_" + sfx, "ok" if ok else "legend not inside")
            continue
        panel = list(getattr(f, side))
        i, j = at(panel, outer), at(panel, inner)
        ok = i is not None and j is not None and i > j
        Macro.setGlobal("q4305_" + sfx, "ok" if ok else
                        "%s at %s, %s at %s" % (outer, i, inner, j))
end

* ==== S05 LT-9: real-valued rings ====
local only : env WP43_ONLY
if inlist("`only'", "", "S05") & `: list posof "S05" in w43_run' {
    display as text "S05 start " c(current_date) " " c(current_time)
    local q5d "`w43_work'/s05"
    capture mkdir "`q5d'"
    capture graph drop _all
    sysuse auto, clear

    // ------------------------------------------------------------
    // Q4305-2: subtitle("S", ring(7.5)), ring(100) and ring(101) draw S
    // outside T, as twoway draws them (title_box_truth.json ring_75,
    // ring_100, ring_101), saved and served; t1title("E", ring(7.5)) is
    // outside the title too.
    // ------------------------------------------------------------
    foreach r in 7.5 100 101 {
        dash clear
        capture noisily dash scatter mpg weight, title("T") subtitle("S", ring(`r')) name(q4305b)
        local rc = _rc
        _w43_expect Q4305-2 "(`rc' == 0)" "ring(`r'): rc `rc'"
        if `rc' == 0 {
            capture erase "`q5d'/a.py"
            _dash_serve_spec, specpath("`q5d'/s.json") datapath("`q5d'/d.json")
            python: _q4305_order("`q5d'/s.json", "`q5d'/d.json", "`q5d'/a.py", "above", "subtitle", "title")
            foreach m in s v {
                _w43_expect Q4305-2 `"("${q4305_`m'}" == "ok")"' "ring(`r') `m': ${q4305_`m'}"
            }
        }
    }
    dash clear
    capture noisily dash scatter mpg weight, title("T") t1title("E", ring(7.5)) name(q4305b)
    _dash_serve_spec, specpath("`q5d'/s.json") datapath("`q5d'/d.json")
    capture erase "`q5d'/a.py"
    python: _q4305_order("`q5d'/s.json", "`q5d'/d.json", "`q5d'/a.py", "above", "t1title", "title")
    foreach m in s v {
        _w43_expect Q4305-2 `"("${q4305_`m'}" == "ok")"' "t1title ring(7.5) `m': ${q4305_`m'}"
    }
    _w43_done Q4305-2 "fractional and large title rings are ordered by value, saved and served"

    // ------------------------------------------------------------
    // Q4305-3: legend(position(6) ring(4.5)) is outside note() (leg_45);
    // legend(ring(<w>)) for an abbreviation of inside draws the legend
    // inside the plot region, and dash prints what twoway prints (nothing).
    // ------------------------------------------------------------
    dash clear
    capture noisily dash (scatter mpg weight) (scatter trunk weight), note("N") legend(position(6) ring(4.5)) name(q4305c)
    _w43_expect Q4305-3 "(_rc == 0)" "ring(4.5): rc `=_rc'"
    capture erase "`q5d'/a.py"
    _dash_serve_spec, specpath("`q5d'/s.json") datapath("`q5d'/d.json")
    python: _q4305_order("`q5d'/s.json", "`q5d'/d.json", "`q5d'/a.py", "below", "legend", "note")
    foreach m in s v {
        _w43_expect Q4305-3 `"("${q4305_`m'}" == "ok")"' "legend ring(4.5) `m': ${q4305_`m'}"
    }
    foreach w in in i insid -1 {
        dash clear
        capture log close q4305l
        log using "`q5d'/lw.log", text replace name(q4305l)
        capture noisily twoway (scatter mpg weight) (scatter trunk weight), legend(ring(`w')) name(q4305t, replace)
        local trc = _rc
        capture noisily dash (scatter mpg weight) (scatter trunk weight), legend(ring(`w')) name(q4305c)
        local drc = _rc
        log close q4305l
        local q5n = strpos(fileread("`q5d'/lw.log"), "gridringstyle") > 0
        _w43_expect Q4305-3 "(`trc' == 0 & `drc' == 0 & `q5n' == 0)" "legend(ring(`w')): rc `trc' `drc', noted `q5n'"
        if `drc' == 0 {
            capture erase "`q5d'/a.py"
            _dash_serve_spec, specpath("`q5d'/s.json") datapath("`q5d'/d.json")
            python: _q4305_order("`q5d'/s.json", "`q5d'/d.json", "`q5d'/a.py", "center", "center", "")
            foreach m in s v {
                _w43_expect Q4305-3 `"("${q4305_`m'}" == "ok")"' "legend ring(`w') `m': ${q4305_`m'}"
            }
        }
    }
    _w43_done Q4305-3 "legend rings take reals and inside's abbreviations, drawn as twoway draws them"

    local q5f : dir "`q5d'" files "*"
    foreach f of local q5f {
        capture erase "`q5d'/`f'"
    }
    capture rmdir "`q5d'"
    capture graph drop _all
    dash clear
    macro drop q4305_*
    display as text "S05 end " c(current_date) " " c(current_time)
}
* ==== end S05 ====

// S05 LT-16 helper: _q4305_place -- in both modes the title's box is
// where title_box_truth.json's probe <case> draws TT: inside, the frame
// symbols of the third of the plot region its text lies in; outside, the
// Title's align from the side of the band it lies at.
python:
def _q4305_place(sp, dp, app, case):
    from sfi import Macro
    row = _q4305_T[case]
    p = [r for r in row["rects"] if r["style"] == "fill:#FFFFFF"
         and r["w"] < row["viewbox"][2] * 0.95][0]
    t = [x for x in row["texts"] if x["text"] == "TT"][0]

    def third(v, lo, size):
        f = (v - lo) / size
        return 0 if f < 1 / 3 else 2 if f > 2 / 3 else 1
    sx = ("left", "center", "right")[third(t["x"], p["x"], p["w"])]
    sy = ("top", "center", "bottom")[third(t["y"], p["y"], p["h"])]
    a, b = _q4305_docs(sp, dp, app)
    for figs, sfx in ((a, "s"), (b, "v")):
        m = _q4305_model(figs[0], "title")
        if m is None:
            got = None
        elif type(m).__name__ == "Label":
            got = (m.x.symbol, m.y.symbol)
            want = (sx, sy)
        else:
            got = m.align
            want = sx
        Macro.setGlobal("q4305_" + sfx, "ok" if got is not None
                        and got == want else "drawn %s, twoway %s"
                        % (got, (sx, sy)))
end

* ==== S05 LT-16: placement() at ring(0) ====
local only : env WP43_ONLY
if inlist("`only'", "", "S05") & `: list posof "S05" in w43_run' {
    display as text "S05 start " c(current_date) " " c(current_time)
    local q5d "`w43_work'/s05"
    capture mkdir "`q5d'"
    capture graph drop _all
    sysuse auto, clear

    // ------------------------------------------------------------
    // Q4305-5: title("TT", ring(0) placement(<x>)) for every spelling
    // probed is drawn at the plot region's compass point twoway draws it
    // at (pl_<x>), and ring(0) position(1) placement(sw) at the bottom
    // left (pl_pos1_sw), saved and served.
    // ------------------------------------------------------------
    foreach x in n north 12 top t nor N ne neast 1 sw c center s se w e nw {
        dash clear
        capture noisily dash scatter mpg weight, title("TT", ring(0) placement(`x')) name(q4305p)
        local rc = _rc
        _w43_expect Q4305-5 "(`rc' == 0)" "placement(`x'): rc `rc'"
        if `rc' == 0 {
            capture erase "`q5d'/a.py"
            _dash_serve_spec, specpath("`q5d'/s.json") datapath("`q5d'/d.json")
            python: _q4305_place("`q5d'/s.json", "`q5d'/d.json", "`q5d'/a.py", "pl_`x'")
            foreach m in s v {
                _w43_expect Q4305-5 `"("${q4305_`m'}" == "ok")"' "placement(`x') `m': ${q4305_`m'}"
            }
        }
    }
    dash clear
    capture noisily dash scatter mpg weight, title("TT", ring(0) position(1) placement(sw)) name(q4305p)
    capture erase "`q5d'/a.py"
    _dash_serve_spec, specpath("`q5d'/s.json") datapath("`q5d'/d.json")
    python: _q4305_place("`q5d'/s.json", "`q5d'/d.json", "`q5d'/a.py", "pl_pos1_sw")
    foreach m in s v {
        _w43_expect Q4305-5 `"("${q4305_`m'}" == "ok")"' "position(1) placement(sw) `m': ${q4305_`m'}"
    }
    _w43_done Q4305-5 "placement() at ring(0) is the plot region's compass point, saved and served"

    // ------------------------------------------------------------
    // Q4305-6: outside the plot region placement(w) and placement(e) move
    // the title to the left and right of its band (pl_side_w, pl_side_e),
    // and the default stays centred (pl_side_ctrl).
    // ------------------------------------------------------------
    foreach x in w e {
        dash clear
        capture noisily dash scatter mpg weight, title("TT", placement(`x')) name(q4305p)
        capture erase "`q5d'/a.py"
        _dash_serve_spec, specpath("`q5d'/s.json") datapath("`q5d'/d.json")
        python: _q4305_place("`q5d'/s.json", "`q5d'/d.json", "`q5d'/a.py", "pl_side_`x'")
        foreach m in s v {
            _w43_expect Q4305-6 `"("${q4305_`m'}" == "ok")"' "outside placement(`x') `m': ${q4305_`m'}"
        }
    }
    _w43_done Q4305-6 "placement() outside the plot region moves the box along its band, saved and served"

    local q5f : dir "`q5d'" files "*"
    foreach f of local q5f {
        capture erase "`q5d'/`f'"
    }
    capture rmdir "`q5d'"
    capture graph drop _all
    dash clear
    macro drop q4305_*
    display as text "S05 end " c(current_date) " " c(current_time)
}
* ==== end S05 ====

// S05 LT-18 helper: _q4305_sub -- in both modes the title's model
// against title_box_truth.json's probe <case>: "turn" its Label's angle
// (the SVG rotation, counter-clockwise) in the panel above; "line" the
// frame's colour and whether it is stroked; "clock" the side panel and
// the frame symbol the box is level with.
python:
def _q4305_sub(sp, dp, app, check, case):
    import math
    from sfi import Macro
    row = _q4305_T[case]
    a, b = _q4305_docs(sp, dp, app)

    def side_of(fig, m):
        for sd in ("above", "below", "left", "right", "center"):
            if any(x is m for x in getattr(fig, sd)):
                return sd
        return None
    if check == "turn":
        rot = [t for t in row["texts"] if t["text"] == "T"][0]["rotate"]
        want = ("above", round(math.radians(-rot) % (2 * math.pi), 6))
    elif check == "line":
        st = [r["style"] for r in row["rects"] if "fill:none" in r["style"]
              and r["w"] < 1000][0]
        kv = dict(x.split(":", 1) for x in st.split(";") if x)
        alpha = float(kv.get("stroke-opacity", 1))
        want = (kv["stroke"].lower() if alpha else None, alpha)
    else:
        p = [r for r in row["rects"] if r["style"] == "fill:#FFFFFF"
             and r["w"] < row["viewbox"][2] * 0.95][0]
        bx = [r for r in row["rects"] if r["style"].startswith("fill:#D9E6EB")][0]
        sd = "right" if bx["x"] >= p["x"] + p["w"] - 0.5 else "left"
        mid = bx["y"] + bx["h"] / 2
        sym = ("top" if abs(bx["y"] - p["y"]) < 0.5 else "bottom"
               if abs(bx["y"] + bx["h"] - p["y"] - p["h"]) < 0.5
               else "center" if abs(mid - p["y"] - p["h"] / 2) < 0.5
               else None)
        want = (sd, sym)
    for figs, sfx in ((a, "s"), (b, "v")):
        m = _q4305_model(figs[0], "title") if len(figs) == 1 else None
        if m is None:
            Macro.setGlobal("q4305_" + sfx, "no model")
            continue
        if check == "turn":
            got = (side_of(figs[0], m),
                   round(float(getattr(m, "angle", 0.0) or 0.0)
                         % (2 * math.pi), 6))
        elif check == "line":
            al = float(m.border_line_alpha)
            got = (str(m.border_line_color).lower() if al else None, al)
        else:
            y = getattr(m, "y", None)
            got = (side_of(figs[0], m), getattr(y, "symbol", None))
        Macro.setGlobal("q4305_" + sfx, "ok" if got == want else
                        "drawn %s, twoway %s" % (got, want))
end

* ==== S05 LT-18: title sub-options and side clocks ====
local only : env WP43_ONLY
if inlist("`only'", "", "S05") & `: list posof "S05" in w43_run' {
    display as text "S05 start " c(current_date) " " c(current_time)
    local q5d "`w43_work'/s05"
    capture mkdir "`q5d'"
    capture graph drop _all
    sysuse auto, clear

    // ------------------------------------------------------------
    // Q4305-7: orientation(vertical), rvertical and rhorizontal turn the
    // title and its box in the band above the plot by the angle twoway's
    // SVG shows (t_or_<o>), saved and served, with nothing printed.
    // ------------------------------------------------------------
    foreach o in vertical rvertical rhorizontal {
        dash clear
        capture noisily dash scatter mpg weight, title("T", orientation(`o') box) scheme(s2color) name(q4305o)
        local rc = _rc
        _w43_expect Q4305-7 "(`rc' == 0)" "orientation(`o'): rc `rc'"
        if `rc' == 0 {
            capture erase "`q5d'/a.py"
            _dash_serve_spec, specpath("`q5d'/s.json") datapath("`q5d'/d.json")
            python: _q4305_sub("`q5d'/s.json", "`q5d'/d.json", "`q5d'/a.py", "turn", "t_or_`o'")
            foreach m in s v {
                _w43_expect Q4305-7 `"("${q4305_`m'}" == "ok")"' "orientation(`o') `m': ${q4305_`m'}"
            }
        }
    }
    _w43_done Q4305-7 "orientation() turns the title and its box as twoway does, saved and served"

    // ------------------------------------------------------------
    // Q4305-8: the frame's line: lstyle(p1), blstyle(p1), blcolor(red),
    // lstyle(p1) lcolor(red) and blpattern(solid) stroke it in twoway's
    // colour; blpattern(dash), blpattern(dot) and lpattern(dash) draw no
    // stroke (t_<case>: stroke-opacity 0), saved and served.
    // ------------------------------------------------------------
    local q5c1 "lstyle blstyle blcolor lstyle_lcolor blpattern_solid blpattern blpattern_dot lpattern"
    local q5c2 `""lstyle(p1)" "blstyle(p1)" "blcolor(red)" "lstyle(p1) lcolor(red)" "blpattern(solid)" "blpattern(dash)" "blpattern(dot)" "lpattern(dash)""'
    local n : word count `q5c1'
    forvalues i = 1/`n' {
        local c : word `i' of `q5c1'
        local sub : word `i' of `q5c2'
        dash clear
        capture noisily dash scatter mpg weight, title("T", `sub' box) scheme(s2color) name(q4305l)
        local rc = _rc
        _w43_expect Q4305-8 "(`rc' == 0)" "`sub': rc `rc'"
        if `rc' == 0 {
            capture erase "`q5d'/a.py"
            _dash_serve_spec, specpath("`q5d'/s.json") datapath("`q5d'/d.json")
            python: _q4305_sub("`q5d'/s.json", "`q5d'/d.json", "`q5d'/a.py", "line", "t_`c'")
            foreach m in s v {
                _w43_expect Q4305-8 `"("${q4305_`m'}" == "ok")"' "`sub' `m': ${q4305_`m'}"
            }
        }
    }
    _w43_done Q4305-8 "the title frame's line styles and patterns as twoway draws them, saved and served"

    // ------------------------------------------------------------
    // Q4305-9: position(2/3/4) puts the box right of the plot region and
    // position(8/9/10) left of it, level with the plot region's top,
    // centre or bottom (t_pos<k>), saved and served.
    // ------------------------------------------------------------
    foreach k in 2 3 4 8 9 10 {
        dash clear
        capture noisily dash scatter mpg weight, title("T", position(`k') box) scheme(s2color) name(q4305k)
        local rc = _rc
        _w43_expect Q4305-9 "(`rc' == 0)" "position(`k'): rc `rc'"
        if `rc' == 0 {
            capture erase "`q5d'/a.py"
            _dash_serve_spec, specpath("`q5d'/s.json") datapath("`q5d'/d.json")
            python: _q4305_sub("`q5d'/s.json", "`q5d'/d.json", "`q5d'/a.py", "clock", "t_pos`k'")
            foreach m in s v {
                _w43_expect Q4305-9 `"("${q4305_`m'}" == "ok")"' "position(`k') `m': ${q4305_`m'}"
            }
        }
    }
    _w43_done Q4305-9 "side clocks beside the plot region, level, saved and served"

    local q5f : dir "`q5d'" files "*"
    foreach f of local q5f {
        capture erase "`q5d'/`f'"
    }
    capture rmdir "`q5d'"
    capture graph drop _all
    dash clear
    macro drop q4305_*
    display as text "S05 end " c(current_date) " " c(current_time)
}
* ==== end S05 ====

// S05 LT-19 helper: _q4305_up -- in both modes the edge title <key> is
// drawn in the right panel turned by the angle twoway's SVG shows for
// probe <case> (rotate(-90): a quarter turn counter-clockwise, reading
// upward).
python:
def _q4305_up(sp, dp, app, key, case):
    import math
    from sfi import Macro
    t = [x for x in _q4305_T[case]["texts"] if x["text"] == "Edge"][0]
    want = ("right", round(math.radians(-t["rotate"]) % (2 * math.pi), 6))
    a, b = _q4305_docs(sp, dp, app)
    for figs, sfx in ((a, "s"), (b, "v")):
        m = _q4305_model(figs[0], key) if len(figs) == 1 else None
        side = next((sd for sd in ("above", "below", "left", "right")
                     if m is not None and any(x is m for x in
                                              getattr(figs[0], sd))), None)
        got = (side, round(float(getattr(m, "angle", 0.0) or 0.0)
                           % (2 * math.pi), 6)) if m is not None else None
        Macro.setGlobal("q4305_" + sfx, "ok" if got == want else
                        "drawn %s, twoway %s" % (got, want))
end

