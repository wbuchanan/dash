// S06 helpers (WP-43 43-06).  _q4306_docs: the figures a registered
// graph draws, saved and served (spec and data from _dash_serve_spec);
// _q4306_al: the one added-text Label's y_offset against the shift
// alignment(<a>) gives (_DASH_ADDED_TEXT_VSHIFT), and no "draws no
// alignment()" note in the log, into globals q4306_s and q4306_v.
python:
import os as _q4306_os, sys as _q4306_sys
for _q4306_p in (_q4306_os.path.abspath(".."),
                 _q4306_os.path.abspath(_q4306_os.path.join("..", "scripts"))):
    if _q4306_p not in _q4306_sys.path:
        _q4306_sys.path.insert(0, _q4306_p)


def _q4306_docs(sp, dp, app):
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_q4306_app")
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_q4306_app.py",
                     "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    sv = [m for m in doc.models if type(m).__name__ == "figure"]
    return list(r.figures.values()), sv


def _q4306_labels(figs):
    from bokeh.models import Label
    return [m for f in figs for m in f.center if isinstance(m, Label)
            and "dash_added_text" in list(m.tags or [])]


def _q4306_al(sp, dp, app, word, log):
    import dash_render as dr
    from sfi import Macro
    with open(log, encoding="utf-8", errors="replace") as fh:
        noted = "draws no alignment()" in fh.read()
    a, b = _q4306_docs(sp, dp, app)
    for figs, sfx in ((a, "s"), (b, "v")):
        labs = _q4306_labels(figs)
        if len(labs) != 1:
            Macro.setGlobal("q4306_" + sfx, "%d labels" % len(labs))
            continue
        lab = labs[0]
        want = (dr._DASH_ADDED_TEXT_VSHIFT[word]
                * float(dr.OptionTranslator.css_to_pt(lab.text_font_size))
                * dr.OptionTranslator.PX_PER_PT)
        ok = abs(float(lab.y_offset) - want) < 0.01 and not noted
        Macro.setGlobal("q4306_" + sfx, "ok" if ok else
                        "y_offset %s, want %.4g, noted %s"
                        % (lab.y_offset, want, noted))
end

* ==== S06 LT-11: text() alignment() through dash ====
local only : env WP43_ONLY
if inlist("`only'", "", "S06") & `: list posof "S06" in w43_run' {
    display as text "S06 start " c(current_date) " " c(current_time)
    local q6d "`w43_work'/s06"
    capture mkdir "`q6d'"
    capture graph drop _all
    sysuse auto, clear

    // ------------------------------------------------------------
    // Q4306-1: text(30 3000 "hi", alignment(<a>)) typed through dash is
    // drawn at twoway's shift for <a> (added_text_box_truth.json al_<a>:
    // only the four full words are drawn as themselves), saved and
    // served, and nothing names alignment().
    // ------------------------------------------------------------
    foreach a in top bottom baseline middle {
        dash clear
        capture log close q4306
        log using "`q6d'/al_`a'.log", text replace name(q4306)
        capture noisily dash scatter mpg weight, text(30 3000 "hi", alignment(`a')) name(q4306a)
        local rc = _rc
        log close q4306
        _w43_expect Q4306-1 "(`rc' == 0)" "alignment(`a'): rc `rc'"
        if `rc' == 0 {
            capture erase "`q6d'/a.py"
            _dash_serve_spec, specpath("`q6d'/s.json") datapath("`q6d'/d.json")
            python: _q4306_al("`q6d'/s.json", "`q6d'/d.json", "`q6d'/a.py", "`a'", "`q6d'/al_`a'.log")
            foreach m in s v {
                _w43_expect Q4306-1 `"("${q4306_`m'}" == "ok")"' "alignment(`a') `m': ${q4306_`m'}"
            }
        }
    }
    _w43_done Q4306-1 "alignment() typed through dash is drawn, saved and served, with no note"

    local q6f : dir "`q6d'" files "*"
    foreach f of local q6f {
        capture erase "`q6d'/`f'"
    }
    capture rmdir "`q6d'"
    capture graph drop _all
    dash clear
    macro drop q4306_*
    display as text "S06 end " c(current_date) " " c(current_time)
}
* ==== end S06 ====

// S06 LT-20 helper.  _q4306_box: the one added-text Label of a
// registered graph, saved and served, against the fixture's box
// (added_text_box_truth.json x_w: its width in em of the text; x_lg: the
// line step; x_lp: a dashed frame) -- into globals q4306_s and q4306_v.
python:
def _q4306_box(sp, dp, app, fx):
    import json
    import dash_render as dr
    from sfi import Macro
    with open(fx, encoding="utf-8") as fh:
        pr = json.load(fh)["probes"]
    b = pr["x_w"]["boxes"][0]
    size = pr["x_w"]["texts"][0]["size"]
    em_w = (b["right"] - b["left"]) / size
    t = pr["x_lg"]["texts"]
    step = (t[1]["y_px"] - t[0]["y_px"]) / t[0]["size"]
    a, v = _q4306_docs(sp, dp, app)
    for figs, sfx in ((a, "s"), (v, "v")):
        labs = _q4306_labels(figs)
        if len(labs) != 1:
            Macro.setGlobal("q4306_" + sfx, "%d labels" % len(labs))
            continue
        lab = labs[0]
        f = (float(dr.OptionTranslator.css_to_pt(lab.text_font_size))
             * dr.OptionTranslator.PX_PER_PT)
        its = []
        for fg in figs:
            for cbs in fg.js_property_callbacks.values():
                for c in cbs:
                    if getattr(c, "code", None) == dr._DASH_TEXT_BOX_JS:
                        its.extend(i for i in c.args["items"] if i[0] is lab)
        bad = []
        if not its:
            bad.append("no box hook")
        else:
            o = its[0][1]
            if abs(o["w"] - em_w) > 1.0 / f:
                bad.append("w %s em, twoway %.4g" % (o["w"], em_w))
            if not o["edge"] > 0:
                bad.append("edge %s" % o["edge"])
        if abs(float(lab.text_line_height) - step) > 0.02 * step:
            bad.append("line height %s, twoway %.4g"
                       % (lab.text_line_height, step))
        if not list(lab.border_line_dash):
            bad.append("frame not dashed")
        Macro.setGlobal("q4306_" + sfx, "; ".join(bad) or "ok")
end

* ==== S06 LT-20: text() box options ====
local only : env WP43_ONLY
if inlist("`only'", "", "S06") & `: list posof "S06" in w43_run' {
    display as text "S06 start " c(current_date) " " c(current_time)
    local q6d "`w43_work'/s06b"
    capture mkdir "`q6d'"
    capture graph drop _all
    sysuse auto, clear

    // ------------------------------------------------------------
    // Q4306-2: box width(20) linegap(3) lpattern(dash) lwidth(thick)
    // lalign(outside) typed through dash: the fixed box in em of the
    // text (x_w), the line step (x_lg), a dashed frame (x_lp) and the
    // outside edge, saved and served, with no note.
    // ------------------------------------------------------------
    dash clear
    capture log close q4306
    log using "`q6d'/box.log", text replace name(q4306)
    capture noisily dash scatter mpg weight, text(30 3000 "Peak" "two", box width(20) linegap(3) blpattern(dash) lwidth(thick) lalign(outside)) name(q4306b)
    local rc = _rc
    log close q4306
    _w43_expect Q4306-2 "(`rc' == 0)" "rc `rc'"
    cert_log_has "`q6d'/box.log", needle("draws no")
    _w43_expect Q4306-2 "(r(found) == 0)" "a note names a drawn sub-option"
    if `rc' == 0 {
        capture erase "`q6d'/a.py"
        _dash_serve_spec, specpath("`q6d'/s.json") datapath("`q6d'/d.json")
        python: _q4306_box("`q6d'/s.json", "`q6d'/d.json", "`q6d'/a.py", "fixtures/added_text_box_truth.json")
        foreach m in s v {
            _w43_expect Q4306-2 `"("${q4306_`m'}" == "ok")"' "`m': ${q4306_`m'}"
        }
    }
    _w43_done Q4306-2 "width(), linegap(), blpattern() and lalign() drawn as twoway draws them, saved and served"

    // ------------------------------------------------------------
    // Q4306-3: bexpand and bmargin() are taken in silence (x_bexpand and
    // x_bmargin draw x_box); what is still noted is named once.
    // ------------------------------------------------------------
    dash clear
    capture log close q4306
    log using "`q6d'/silent.log", text replace name(q4306)
    // Flipped (WP-49 basic:PT-12): angle() is taken in silence too --
    // twoway draws the same picture with it and prints nothing (noted_option_truth.json sub_probes text(30 3000 "x", angle(45))) -- so drawview() is the
    // word still noted.
    capture noisily dash scatter mpg weight, text(30 3000 "Peak", box bexpand bmargin(large) drawview(yes)) name(q4306c)
    local rc = _rc
    log close q4306
    _w43_expect Q4306-3 "(`rc' == 0)" "rc `rc'"
    cert_log_has "`q6d'/silent.log", needle("text() draws no drawview(); see help dash##added_text")
    // The note names drawview() alone: had bexpand or bmargin() been named,
    // they would stand in it beside drawview().
    _w43_expect Q4306-3 "(r(found) == 1)" "no note naming drawview() alone"
    _w43_done Q4306-3 "bexpand and bmargin() taken in silence; drawview() named once"

    local q6f : dir "`q6d'" files "*"
    foreach f of local q6f {
        capture erase "`q6d'/`f'"
    }
    capture rmdir "`q6d'"
    capture graph drop _all
    dash clear
    macro drop q4306_*
    display as text "S06 end " c(current_date) " " c(current_time)
}
* ==== end S06 ====

// S06 LT-20 evaluator helpers.  _q4306_ev: the at_lines dash registered
// for graph <name> against the fixture's probe <pid> (x_eval_*: the text
// twoway drew; x_eval_out_*: the global's value as written), a miss
// appended to global q4306_bad; _q4306_notes: how many times a log holds
// the =exp note, into global q4306_n; _q4306_gt: Q4306-5's graph text.
python:
def _q4306_lines(js):
    import json
    stack = [json.loads(js)]
    while stack:
        o = stack.pop()
        if isinstance(o, dict):
            if "at_lines" in o:
                return o["at_lines"]
            stack.extend(o.values())
        elif isinstance(o, list):
            stack.extend(o)
    return None


def _q4306_ev(name, pid, rc):
    import json
    from sfi import Macro
    with open("fixtures/added_text_box_truth.json", encoding="utf-8") as fh:
        pr = json.load(fh)["probes"][pid]
    if pid.startswith("x_eval_out_"):
        want = "\x60" + pr["expr"] + "'"
    else:
        want = pr["drawn"]
    got = None
    if int(rc) == 0:
        got = _q4306_lines(Macro.getGlobal("dash_json_" + name) or "null")
    got = " ".join(got) if got is not None else "rc %s" % rc
    if got != want:
        bad = Macro.getGlobal("q4306_bad") or ""
        Macro.setGlobal("q4306_bad", (bad + " [%s: %r, twoway %r]"
                                      % (pid, got, want))[:1500])


def _q4306_notes(log):
    from sfi import Macro
    with open(log, encoding="utf-8", errors="replace") as fh:
        n = fh.read().count("=exp or macro reference in a graph's text")
    Macro.setGlobal("q4306_n", str(n))


def _q4306_gt(name):
    import json
    from sfi import Macro
    with open("fixtures/global_text_truth.json", encoding="utf-8") as fh:
        cases = json.load(fh)["cases"]
    row = [c for c in cases if c["kind"] == "eval" and c["option"] == "ytitle"]
    want = row[0]["drawn"][0] if row else "?"
    # Titles are registered as typed, in their quotes.
    titles, axn = [], []
    stack = [json.loads(Macro.getGlobal("dash_json_" + name) or "null")]
    while stack:
        o = stack.pop()
        if isinstance(o, dict):
            if isinstance(o.get("title"), str):
                titles.append(o["title"].strip('"'))
            if isinstance(o.get("axisn"), dict):
                axn.append(str((o["axisn"].get("y3") or {}).get("title", ""))
                           .strip('"'))
            stack.extend(o.values())
        elif isinstance(o, list):
            stack.extend(o)
    bad = []
    if axn != [want]:
        bad.append("axis 3 title %r, twoway %r" % (axn, want))
    if "a \x60=_N' b" not in titles:
        bad.append("title not drawn as written: %r" % titles)
    Macro.setGlobal("q4306_g", "; ".join(bad) or "ok")
end

capture mata: mata drop _q4306_hostile()
mata:
// _q4306_hostile() -- the number of hostile =exp texts _dash_at_exp does
// not refuse as written (ok 0, the text returned), the first of them in
// the local q4306_h1.
real scalar _q4306_hostile()
{
    string colvector hs
    string scalar    q, r
    real scalar      i, ok, n

    q = char(34)
    hs = ("filewrite(" + q + "q4306" + q + "," + q + "y" + q + ")") \
         ("fileread(" + q + "q4306" + q + ")") \ "_N" \ "_n" \ "mpg" \
         "mpg[1]" \ "c(N)" \ "r(N)" \ "e(N)" \ "scalar(x)" \ "exec(1)" \
         "stata(1)" \ ("st_global(" + q + "a" + q + ")") \
         ("findfile(" + q + "a" + q + ")") \ "1+" \ "(1" \ "1)" \ "" \
         " " \ (q + "abc") \ "1,2" \ (100 * "(" + "1" + 100 * ")") \
         (100 * "-" + "1") \ (4001 * "1") \
         ("max(" + 16 * "1," + "1)") \ "upper(1)" \ ("1+" + q + "a" + q) \
         (q + "a" + q + "*2") \ ("substr(" + q + "a" + q + ",1)") \
         ("string(1," + q + "%999.0f" + q + ")") \
         ("string(1," + q + "%s" + q + ")") \ "abs()" \ "ABS(1)" \ "1;2" \
         "1 2" \ "1==" \ ("!" + q + "a" + q) \
         (char(96) + "x" + char(39)) \ (char(36) + "x") \ "1+.a" \
         "strlen(1)" \ "min()" \ "abs(1,2)" \ "x(1)"
    n = 0
    st_local("q4306_h1", "")
    for (i = 1; i <= rows(hs); i++) {
        ok = 1
        r = _dash_at_exp(hs[i], ok)
        if (ok != 0 | r != hs[i]) {
            n++
            if (st_local("q4306_h1") == "") st_local("q4306_h1", substr(hs[i], 1, 60))
        }
    }
    return(n)
}
end

