        quietly twoway `three', scheme(s2color) legend(`ho') name(q02h`k', replace)
        capture erase "`q02d'/q02h`k'.svg"
        cert_svg_export, name(q02h`k') file("`q02d'/q02h`k'.svg")
        quietly twoway `three', scheme(s2color) legend(`bo') name(q02b`k', replace)
        capture erase "`q02d'/q02b`k'.svg"
        cert_svg_export, name(q02b`k') file("`q02d'/q02b`k'.svg")
        python: import __main__ as _q4302_m; _q4302_m._q4302_htw("`q02d'/q02h`k'.svg", "`q02d'/q02b`k'.svg", "`ax'")
        local tw "${q4302_htw}"
        _q4302_hreg "`q02d'" `three', scheme(s2color) legend(`ho') name(q02e)
        foreach m in s v {
            _w43_expect Q4302-2 `"("${q4302_h`m'}" == "`tw'")"' `"`ho' `m': dash ${q4302_h`m'}; twoway `tw'"'
        }
    }
    _w43_done Q4302-2 "a hole in a one-column or one-row legend is one gap at twoway's place, saved and served"

    forvalues j = 1/`k' {
        capture erase "`q02d'/q02h`j'.svg"
        capture erase "`q02d'/q02b`j'.svg"
    }
    foreach f in s.json d.json a.py {
        capture erase "`q02d'/`f'"
    }
    capture rmdir "`q02d'"
