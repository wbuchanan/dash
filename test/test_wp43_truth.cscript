    sysuse auto, clear
    global q4306_bad ""

    // ------------------------------------------------------------
    // Q4306-4: each global of the fixture's x_eval_* probes, set without
    // expansion and named \$G in a text() line (two straight lines each,
    // never in a loop: section 43-06 D-43-06.f), registers the text
    // twoway drew, with no note; each x_eval_out_* is registered as
    // written with the note once a graph; a filewrite() global writes no
    // file; the one-argument _dash_at_globals() keeps the text; hostile
    // texts are refused as written.
    // ------------------------------------------------------------
    dash clear
    capture log close q4306
    log using "`q6d'/eval.log", text replace name(q4306)
    global G = char(96) + "=1+1" + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306e1)
