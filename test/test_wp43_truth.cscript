    global G = char(96) + `"=strlen("abc")"' + char(39)
    capture noisily dash scatter mpg weight, text(30 3000 "\$G") name(q4306e38)
    python: _q4306_ev("q4306e38", "x_eval_38", "`=_rc'")
    global G = char(96) + `"=ustrlen("ab")"' + char(39)
