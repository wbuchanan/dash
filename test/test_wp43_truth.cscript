    local k 0
    foreach c in "(scatter mpg weight) (kdensity mpg, horizontal xaxis(2))," "(scatter mpg weight) (kdensity mpg, horizontal xaxis(2) recast(area))," "(scatter mpg weight) (function y=x^2, range(0 2) horizontal xaxis(2))," "(scatter mpg weight) (kdensity mpg, xaxis(2))," {
        local ++k
