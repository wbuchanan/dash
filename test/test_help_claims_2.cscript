_hc2_tail "HC2-14j" jitterseed "" -1
// Flipped (WP-31 C10a): twoway's rc (test/fixtures/value_bounds_truth.json).
_hc2_dash "HC2-14k" 0 `"dash kdensity mpg, bwidth(0) name(hc)"'
_hc2_dash "HC2-14l" 198 `"dash kdensity mpg, bwidth(-1) name(hc)"'
