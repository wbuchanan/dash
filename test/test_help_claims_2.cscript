_hc2_expect "HC2-14y" 198 `"twoway scatter mpg weight, colorvar(rep78) colornlevels(5)"' "option colornlevels() not allowed"
_hc2_expect "HC2-14z" 198 `"twoway scatter mpg weight, jitter(5) jseed(3)"' "option jseed() not allowed"
_hc2_expect "HC2-14A" 198 `"twoway scatter mpg weight, malpha(50)"' "option malpha() not allowed"
_hc2_expect "HC2-14B" 198 `"twoway scatter mpg weight, colorvar(rep78) colpalette(magma)"' "option colpalette() not allowed"
_hc2_expect "HC2-14C" 198 `"twoway scatter mpg weight, hover(price)"' "option hover() not allowed"
_hc2_expect "HC2-14D" 198 `"twoway lpoly mpg weight, bwidth(0)"' "bwidth() must be a positive number"

// HC2-15 -- bands() is twoway's bound, in twoway's words.
_hc2_expect "HC2-15a" 198 `"twoway mband mpg weight, bands(201)"' "bands must be between 1 and 200"
_hc2_expect "HC2-15b" 198 `"twoway mband mpg weight, bands(0)"' "bands must be between 1 and 200"
_hc2_dash   "HC2-15c" 198 `"dash mband mpg weight, bands(201) name(hc)"'
_hc2_tail   "HC2-15d" bands "" 201

// HC2-16 -- values twoway refuses and dash accepts (HC2-16a-n), and a
// colour written with commas, which dash refuses, as twoway (HC2-16o-q).
_hc2_expect "HC2-16a" 198 `"twoway kdensity mpg, kernel(GAUSSIAN)"' "invalid kernel function"
_hc2_dash   "HC2-16b" 0   `"dash kdensity mpg, kernel(GAUSSIAN) name(hc)"'
_hc2_reg    "HC2-16c" hc `""kernel":"gaussian""'
_hc2_expect "HC2-16d" 198 `"twoway line mpg weight, lwidth(())"' "option(s) ( ) not allowed"
_hc2_dash   "HC2-16e" 0   `"dash line mpg weight, lwidth(()) name(hc)"'
_hc2_reg    "HC2-16f" hc `""lwidth":"()""'
_hc2_expect "HC2-16g" 198 `"twoway scatter mpg weight, msize(())"' "option(s) ( ) not allowed"
_hc2_dash   "HC2-16h" 0   `"dash scatter mpg weight, msize(()) name(hc)"'
_hc2_expect "HC2-16i" 198 `"twoway scatter mpg weight, xsize(())"' "option(s) ( ) not allowed"
_hc2_dash   "HC2-16j" 0   `"dash scatter mpg weight, xsize(()) name(hc)"'
_hc2_reg    "HC2-16k" hc `""xsize":"()""'
_hc2_expect "HC2-16l" 7   `"twoway scatter mpg weight, colorvar(make)"' "found where numeric variable expected"
_hc2_dash   "HC2-16m" 0   `"dash scatter mpg weight, colorvar(make) name(hc)"'
_hc2_reg    "HC2-16n" hc `""colorvar":"make""'
_hc2_expect "HC2-16o" 198 `"twoway scatter mpg weight, mcolor(255,0,0)"'
// WP-30 P1.13a: a colour written with commas is refused, as twoway
// refuses it (invalid '0', r(198)), and no graph hc is registered.
_hc2_dash   "HC2-16p" 198 `"dash scatter mpg weight, mcolor(255,0,0) name(hc)"' "invalid '0'"
mata: st_local("_hc2q", strofreal(st_global("dash_json_hc") == ""))
_hc2_ok     "HC2-16q" `_hc2q' "no graph hc is registered"

// HC2-17 -- an unknown scheme: twoway notes and draws s2color, dash
// refuses; theme() is not a twoway option at all.
_hc2_expect "HC2-17a" 0   `"twoway scatter mpg weight, scheme(nonsense)"' "(note: scheme nonsense not found, using s2color)"
_hc2_dash   "HC2-17b" 198 `"dash scatter mpg weight, scheme(nonsense) name(hc)"' "dash: scheme() must be"
_hc2_expect "HC2-17c" 198 `"twoway scatter mpg weight, theme(dark)"' "option theme() not allowed"

// HC2-18 -- forms twoway reads and dash refuses.
_hc2_expect "HC2-18a" 0   `"twoway scatter mpg weight, mlabel(make foreign)"'
_hc2_dash   "HC2-18b" 0   `"dash scatter mpg weight, mlabel(make foreign) name(hc)"'  // P1.1b: twoway labels with the first variable (HC2-18a)
_hc2_expect "HC2-18c" 0   `"twoway function y=x, range(mpg)"'
// Flipped (WP-31 C10a): twoway's rc (test/fixtures/value_bounds_truth.json).
_hc2_dash   "HC2-18d" 0   `"dash function y=x, range(mpg) name(hc)"'
_hc2_expect "HC2-18e" 0   `"twoway kdensity mpg, range(weight)"'
_hc2_dash   "HC2-18f" 0   `"dash kdensity mpg, range(weight) name(hc)"'
_hc2_expect "HC2-18g" 0   `"twoway lfit mpg weight, range(. 5000)"'
_hc2_dash   "HC2-18h" 0   `"dash lfit mpg weight, range(. 5000) name(hc)"'
_hc2_expect "HC2-18i" 0   `"twoway qfitci mpg weight, range(2000 .)"'
_hc2_dash   "HC2-18j" 0   `"dash qfitci mpg weight, range(2000 .) name(hc)"'
_hc2_expect "HC2-18s" 0   `"twoway qfit mpg weight, range(. 5000)"'
_hc2_dash   "HC2-18t" 0   `"dash qfit mpg weight, range(. 5000) name(hc)"'
_hc2_expect "HC2-18u" 0   `"twoway lfitci mpg weight, range(. 5000)"'
_hc2_dash   "HC2-18v" 0   `"dash lfitci mpg weight, range(. 5000) name(hc)"'
_hc2_expect "HC2-18w" 127 `"twoway kdensity mpg, range(. 50)"' "option range() requires two numbers"
_hc2_expect "HC2-18x" 198 `"twoway bar mpg weight, lwidth(-1)"' "gm_linewidth must be between"
_hc2_expect "HC2-18y" 198 `"twoway connected mpg weight, mlwidth(-1)"' "gm_linewidth must be between"
_hc2_expect "HC2-18k" 0   `"twoway scatter mpg weight, lwidth(-1)"'
_hc2_dash   "HC2-18l" 198 `"dash scatter mpg weight, lwidth(-1) name(hc)"' "lwidth()"
_hc2_expect "HC2-18m" 198 `"twoway scatter mpg weight, connect(l) lwidth(-1)"' "gm_linewidth must be between"
_hc2_expect "HC2-18n" 0   `"twoway line mpg weight, mlwidth(-1)"'
_hc2_dash   "HC2-18o" 198 `"dash line mpg weight, mlwidth(-1) name(hc)"' "mlwidth()"
_hc2_expect "HC2-18p" 0   `"twoway line mpg weight, msangle(400)"'
_hc2_dash   "HC2-18q" 198 `"dash line mpg weight, msangle(400) name(hc)"' "msangle()"
_hc2_expect "HC2-18r" 198 `"twoway connected mpg weight, msangle(400)"' "symbolangle must be between"

// HC2-19 -- a switch belongs to its plot type, as in twoway.
local hc2_19 = 0
foreach c in "scatter mpg weight, discrete|option discrete not allowed" ///
             "kdensity mpg, discrete|option discrete not allowed" ///
             "lfit mpg weight, stdp|option stdp not allowed" ///
             "lpolyci mpg weight, stdf|option stdf not allowed" ///
             "scatter mpg weight, mean|option mean not allowed" ///
             "lpoly mpg weight, noweight|option noweight not allowed" ///
             "scatter mpg weight, adjust|option adjust not allowed" ///
             "scatter mpg weight, logit|option logit not allowed" ///
             "lfitci mpg weight, stdf stdr|may not combine stdf stdr" ///
             "qfitci mpg weight, stdp stdf|may not combine stdp stdf" ///
             "histogram rep78, discrete bin(3)|options discrete and bins() may not be combined" {
    local at = strpos("`c'", "|")
    local cmd = substr("`c'", 1, `at' - 1)
    local msg = substr("`c'", `at' + 1, .)
    local ++hc2_19
    _hc2_expect "HC2-19a`hc2_19'" 198 `"twoway `cmd'"' "`msg'"
    _hc2_dash   "HC2-19b`hc2_19'" 198 `"dash `cmd' name(hc)"' "`msg'"
}
_hc2_expect "HC2-19c" 0 `"twoway lowess mpg weight, mean noweight adjust logit"'
_hc2_dash   "HC2-19d" 0 `"dash lowess mpg weight, mean noweight adjust logit name(hc)"'
_hc2_expect "HC2-19e" 0 `"twoway qfitci mpg weight, stdr"'
_hc2_dash   "HC2-19f" 0 `"dash qfitci mpg weight, stdr name(hc)"'
_hc2_expect "HC2-19g" 0 `"twoway histogram rep78, discrete"'
_hc2_dash   "HC2-19h" 0 `"dash histogram rep78, discrete name(hc)"'

// HC2-20 -- a weight the plot type does not take.
_hc2_expect "HC2-20a" 101 `"twoway histogram mpg [aw=weight]"' "aweights not allowed"
_hc2_dash   "HC2-20b" 101 `"dash histogram mpg [aw=weight], name(hc)"' "aweights not allowed"

// HC2-21 -- what Stata does not check.  twoway notes an unknown style name
// and refuses an unknown sub-option word; dash registers all of them, and
// the renderer's notes are test_help_claims_2.py's.
_hc2_dash   "HC2-21a" 0 `"dash scatter mpg weight, mcolor(bogus) msymbol(bogus) name(hc)"'
_hc2_reg    "HC2-21b" hc `""msymbol":"bogus""'
_hc2_dash   "HC2-21c" 0 `"dash line mpg weight, lpattern(bogus) name(hc)"'
_hc2_reg    "HC2-21d" hc `""lpattern":"bogus""'
_hc2_expect "HC2-21e" 0 `"twoway scatter mpg weight, msymbol(bogus)"' "named style bogus not found in class symbol"
_hc2_expect "HC2-21f" 0 `"twoway scatter mpg weight, title(T, size(bogus))"' "named style bogus not found in class gsize"
_hc2_dash   "HC2-21g" 0 `"dash scatter mpg weight, title(T, size(bogus)) name(hc)"'
_hc2_expect "HC2-21h" 198 `"twoway scatter mpg weight, legend(garbage)"' "option garbage not allowed"
_hc2_dash   "HC2-21i" 198 `"dash scatter mpg weight, legend(garbage) name(hc)"' "option garbage not allowed"
// Refused as twoway refuses it (WP-30 P1.19): no graph hc is registered.
mata: st_local("_hit", strofreal(st_global("dash_json_hc") == ""))
_hc2_ok     "HC2-21j" `_hit' "no graph hc is registered"
_hc2_expect "HC2-21k" 198 `"twoway scatter mpg weight, xscale(bogus)"' "option bogus not allowed"
// Flipped (WP-30 P1.18a): refused as twoway refuses it.
_hc2_dash   "HC2-21l" 198 `"dash scatter mpg weight, xscale(bogus) name(hc)"' "option bogus not allowed"
graph drop _all

// ================================================================
// Subcommands and Dashboard Options
// ================================================================

// HC2-22 -- the plot definition.
quietly dash clear
_hc2_run `"dash scatter mpg weight, name(p1)"'
_hc2_ok "HC2-22a" `=r(rc) == 0' "name() registers the graph"
local reg "${dash_graph_registry}"
_hc2_ok "HC2-22b" `: list posof "p1" in reg' "p1 is in the registry"
_hc2_said "dashboard saved"
_hc2_ok "HC2-22c" `=r(n) == 0' "name() renders nothing"
local hc2out "`hc2f'_22.html"
capture erase "`hc2out'"
_hc2_run `"dash scatter mpg weight, saving("`hc2out'")"'
capture confirm file "`hc2out'"
_hc2_ok "HC2-22d" `=_rc == 0' "without name() the graph is written at once"

// HC2-23 -- dash build's own requirements.
quietly dash clear
_hc2_expect "HC2-23a" 198 `"dash build, saving("`hc2f'_23.html") replace"' "no graphs registered"
quietly dash scatter mpg weight, name(b1)
_hc2_expect "HC2-23b" 198 `"dash build, replace"' "saving() is required"
// WP-30 P1.27: .py is appended to a server saving() name that does not end
// in it, as .html is on the HTML route (it was refused, r(198)).
capture erase "`hc2f'_23.html.py"
_hc2_expect "HC2-23c" 0 `"dash build, saving("`hc2f'_23.html") server replace"' "server app written to"
capture erase "`hc2f'_23.html.py"
local hc2py "`hc2f'_23.py"
capture erase "`hc2py'"
_hc2_expect "HC2-23d" 0 `"dash build, saving("`hc2py'") server"' "server app written to"
capture confirm file "`hc2py'"
_hc2_ok "HC2-23e" `=_rc == 0' "dash build, server writes the .py app and returns"

// HC2-24 -- replace.
local hc2out "`hc2f'_24.html"
capture erase "`hc2out'"
_hc2_expect "HC2-24a" 0   `"dash build, saving("`hc2out'")"'
_hc2_expect "HC2-24b" 198 `"dash build, saving("`hc2out'")"' "already exists"
_hc2_expect "HC2-24c" 0   `"dash build, saving("`hc2out'") replace"'

// HC2-25 -- dash serve's defaults and the options it shares with build.
quietly dash clear
quietly dash scatter mpg weight, name(s1)
capture noisily _dash_serve_spec, specpath("`hc2mj'") datapath("`hc2dj'")
_hc2_ok "HC2-25a" `=_rc == 0 & "`r(port)'" == "5006" & "`r(timeout)'" == "0"' "port 5006 and timeout 0 by default"
cert_file_has "`hc2mj'", needle(`""filter_position":"top""')
_hc2_ok "HC2-25f" `=r(found) == 1' "filterposition() is top by default"
_hc2_run `"_dash_serve_spec, specpath("`hc2mj'") datapath("`hc2dj'") csv title("Live") filterposition(left)"'
cert_file_has "`hc2mj'", needle(`""csv":"1""')
_hc2_ok "HC2-25b" `=r(found) == 1' "csv reaches the served spec"
_hc2_expect "HC2-25c" 0 `"_dash_serve_spec, specpath("`hc2mj'") datapath("`hc2dj'") saving("`hc2f'_25.html") replace server"' "ignoring option(s) that only apply to dash build: saving() replace server"
capture confirm file "`hc2f'_25.html"
_hc2_ok "HC2-25d" `=_rc != 0' "dash serve writes no file for saving()"
_hc2_expect "HC2-25e" 198 `"_dash_serve_spec, specpath("`hc2mj'") datapath("`hc2dj'") filterposition(sideways)"'

// HC2-26 -- csv is inherited.
local hc2out "`hc2f'_26.html"
_hc2_expect "HC2-26a" 0 `"dash build, saving("`hc2out'") replace csv title("Built")"'
_hc2_run `"_dash_serve_spec, specpath("`hc2mj'") datapath("`hc2dj'")"'
cert_file_has "`hc2mj'", needle(`""csv":"1""')
_hc2_ok "HC2-26b" `=r(found) == 1' "dash serve inherits csv from the preceding dash build"
cert_file_has "`hc2mj'", needle(`""title":"Built""')
_hc2_ok "HC2-26c" `=r(found) == 1' "and its title"

// HC2-27, HC2-28 -- dash clear.
// The build gives filter() too: HC2-28a holds dash clear to dropping
// dash_opts_filter, and until 24sep2026 no build before it gave one, so
// that global was empty whether or not dash clear dropped it.
global dash_max_cells 6000000
quietly dash kpi mean(price), name(k1) title("K")
local hc2out "`hc2f'_27.html"
_hc2_expect "HC2-27a" 0 `"dash build, saving("`hc2out'") replace csv title("Before") filter(foreign)"'
_hc2_ok "HC2-27b" `="${dash_opts_title}" == "Before" & "${dash_opts_csv}" == "csv" & "${dash_opts_filter}" == "foreign"' "dash build remembers its options"
quietly dash clear
quietly dash scatter mpg weight, name(s2)
_hc2_run `"_dash_serve_spec, specpath("`hc2mj'") datapath("`hc2dj'")"'
cert_file_has "`hc2mj'", needle(`""title":"Before""')
local t_found = r(found)
cert_file_has "`hc2mj'", needle(`""csv":"1""')
_hc2_ok "HC2-27c" `=`t_found' == 0 & r(found) == 0' "after dash clear, dash serve inherits nothing"
quietly dash clear
local left ""
foreach g in dash_graph_registry dash_json_s1 dash_spec_s1 dash_json_s2 dash_kpi_k1 dash_kpi_k1__sta dash_opts_title dash_opts_csv dash_opts_filter {
    local len : strlen global `g'
    if `len' > 0 local left "`left' `g'"
}
_hc2_ok "HC2-28a" `="`left'" == ""' "dash clear drops the registry's globals and the remembered options`left'"
_hc2_ok "HC2-28b" `="${dash_nobrowser}" == "1"' "dash clear keeps \$dash_nobrowser"
_hc2_ok "HC2-28c" `="${dash_max_cells}" == "6000000"' "dash clear keeps \$dash_max_cells"
macro drop dash_max_cells

// ================================================================
// The browser
// ================================================================
//
// dash opens a window with `shell open <file>' (MacOSX) or `shell
// xdg-open <file>' (Unix) -- and the console binary on a Mac reports c(os)
// as Unix (c(machine_type) "Mac (Apple Silicon)", measured 23sep2026), so
// there it calls xdg-open.  Here both are a stub that appends its
// arguments to open.log in its own directory; the stub's directory is put
// at the front of PATH through Python's os.environ, which the shell Stata
// starts inherits.  HC2-29 then asks the shell which `open' it runs, and
// nothing below it that could open a window runs unless the answer is the
// stub.  The builds that measure the rule are in programs defined here,
// while $dash_nobrowser is still set; they run with it dropped only after
// the guard has passed, and the global and PATH are put back on every
// path.  Windows opens with `start', a cmd builtin that cannot be stubbed,
// so there the section is skipped -- and says so.

capture program drop _hc2_b_build
program define _hc2_b_build, rclass
    version 16.0
    args path opts
    capture noisily dash build, saving("`path'") replace `opts'
    return scalar rc = _rc
end
capture program drop _hc2_b_plot
program define _hc2_b_plot, rclass
    version 16.0
    args opts
    capture noisily dash scatter mpg weight `opts'
    return scalar rc = _rc
end
// How many times the stub was run since the log was last erased; r(n),
// and r(first), the first argument line.
capture program drop _hc2_b_opened
program define _hc2_b_opened, rclass
    version 16.0
    args stubdir
    local n = 0
    local first ""
    capture confirm file "`stubdir'/open.log"
    if !_rc {
        tempname fh
        file open `fh' using "`stubdir'/open.log", read text
        file read `fh' ln
        while r(eof) == 0 {
            local ++n
            if `n' == 1 mata: st_local("first", st_local("ln"))
            file read `fh' ln
        }
        file close `fh'
    }
    return scalar n = `n'
    return local first `"`macval(first)'"'
end

if "`c(os)'" == "Windows" {
    display as text "HC2-29..36 SKIP: dash opens a window with start, a cmd builtin that cannot be stubbed"
}
else {
    local stubdir "`c(tmpdir)'hc2_opener_stub"
    capture mkdir "`stubdir'"
    // Each stub records its own name and its arguments: "open <file>".
    foreach f in open xdg-open {
        tempname sh
        file open `sh' using "`stubdir'/`f'", write text replace
        file write `sh' "#!/bin/sh" _n
        file write `sh' "printf '%s\n' " (char(34)) "`f' " (char(36)) "*" (char(34)) " >> '`stubdir'/open.log'" _n
        file write `sh' "exit 0" _n
        file close `sh'
        shell chmod 755 "`stubdir'/`f'"
    }
    // The first python call of a runner session can fail whatever it is;
    // spend it here, then set PATH, reading the directory with sfi rather
    // than writing it into the Python source.
    capture python: pass
    python: import os, sfi
    python: _hc2_path0 = os.environ.get("PATH", "")
    python: os.environ["PATH"] = sfi.Macro.getLocal("stubdir") + os.pathsep + _hc2_path0

    // HC2-29 -- the guard: BOTH openers must be the stubs, whichever one
    // dash picks.
    local hc2_guard = 1
    foreach f in open xdg-open {
        capture erase "`stubdir'/which.txt"
        shell command -v `f' > "`stubdir'/which.txt" 2>&1
        mata: st_local("hc2_which", _hc2_firstline(st_local("stubdir") + "/which.txt"))
        if `"`hc2_which'"' != "`stubdir'/`f'" local hc2_guard = 0
    }
    _hc2_ok "HC2-29" `hc2_guard' `"the shell runs the stub open and the stub xdg-open"'

    if `hc2_guard' {
        macro drop dash_nobrowser
        // WP-30 P1.27: this script runs in batch, where dash opens no
        // window now; the undocumented test seam lets these controls reach
        // the stub opener, which is first on PATH.  Dropped after the block.
        global dash__display on
        capture noisily {
            quietly dash clear
            quietly dash scatter mpg weight, name(w1)
            local bo "`hc2f'_browser.html"

            // HC2-30 -- the control.
            capture erase "`stubdir'/open.log"
            _hc2_b_build "`bo'" ""
            _hc2_b_opened "`stubdir'"
            _hc2_ok "HC2-30" `=r(n) == 1 & strpos(`"`r(first)'"', "_browser.html") > 0' "with nothing said, the build opens its file (the stub saw: `r(first)')"
            // HC2-30b -- with the opener the platform has.  A Mac is a Mac
            // whichever binary runs; the console one reports c(os) Unix, and
            // xdg-open, which dash used to run there, is not on a Mac.
            local want = cond("`c(os)'" == "MacOSX" | substr("`c(machine_type)'", 1, 3) == "Mac", "open", "xdg-open")
            _hc2_ok "HC2-30b" `=word(`"`r(first)'"', 1) == "`want'"' "the file is opened with `want' (`c(os)', `c(machine_type)'; the stub saw: `r(first)')"

            // HC2-31
            capture erase "`stubdir'/open.log"
            _hc2_b_build "`bo'" "nobrowser"
            _hc2_b_opened "`stubdir'"
            _hc2_ok "HC2-31" `=r(n) == 0' "with the nobrowser option the build opens nothing"

            // HC2-32 -- any non-empty value.
            foreach v in 1 0 {
                global dash_nobrowser `v'
                capture erase "`stubdir'/open.log"
                _hc2_b_build "`bo'" ""
                _hc2_b_opened "`stubdir'"
                local lt = cond(`v' == 1, "a", "b")
                _hc2_ok "HC2-32`lt'" `=r(n) == 0' "global dash_nobrowser `v' keeps dash build shut"
            }
            macro drop dash_nobrowser

            // HC2-33 -- a registered graph's nodraw.
            quietly dash scatter mpg weight, name(w2) nodraw
            capture erase "`stubdir'/open.log"
            _hc2_b_build "`bo'" ""
            _hc2_b_opened "`stubdir'"
            _hc2_ok "HC2-33" `=r(n) == 0' "a registered graph's nodraw keeps dash build shut"
            quietly dash clear
            quietly dash scatter mpg weight, name(w1)

            // HC2-34 -- the one-line form.
            capture erase "`stubdir'/open.log"
            _hc2_b_plot ""
            _hc2_b_opened "`stubdir'"
            _hc2_ok "HC2-34a" `=r(n) == 1 & strpos(`"`r(first)'"', ".html") > 0' "the one-line form with nothing said opens its file"
            _hc2_ok "HC2-34f" `=word(`"`r(first)'"', 1) == "`want'"' "the one-line form opens it with `want' too (the stub saw: `r(first)')"
            capture erase "`stubdir'/open.log"
            _hc2_b_plot ", nodraw"
            _hc2_b_opened "`stubdir'"
            _hc2_ok "HC2-34b" `=r(n) == 0' "the one-line form with nodraw opens nothing"
            global dash_nobrowser 1
            capture erase "`stubdir'/open.log"
            _hc2_run `"_hc2_b_plot"'
            _hc2_b_opened "`stubdir'"
            local n34 = r(n)
            _hc2_said "dash: dashboard saved to "
            _hc2_ok "HC2-34c" `=`n34' == 0 & r(n) == 1' "under the global the one-line form writes its file, says where, and opens nothing"
            macro drop dash_nobrowser
            capture erase "`stubdir'/open.log"
            _hc2_b_plot `", saving("`hc2f'_34.html")"'
            _hc2_b_opened "`stubdir'"
            _hc2_ok "HC2-34d" `=r(n) == 0' "the one-line form with saving() opens nothing"
            capture erase "`stubdir'/open.log"
            _hc2_run `"_hc2_b_plot ", nobrowser""'
            _hc2_b_opened "`stubdir'"
            local n34 = r(n)
            _hc2_said "ignoring unsupported option(s): nobrowser()"
            _hc2_ok "HC2-34e" `=`n34' == 1 & r(n) == 1' "the one-line form has no nobrowser option: it is named in the note and the window opens"

            // HC2-35 -- dash clear leaves the global in force.
            global dash_nobrowser 1
            quietly dash clear
            quietly dash scatter mpg weight, name(w3)
            capture erase "`stubdir'/open.log"
            _hc2_b_build "`bo'" ""
            _hc2_b_opened "`stubdir'"
            _hc2_ok "HC2-35" `=r(n) == 0 & "${dash_nobrowser}" == "1"' "after dash clear the global still keeps dash build shut"
            macro drop dash_nobrowser

            // HC2-36 -- dash build, server.
            capture erase "`stubdir'/open.log"
            _hc2_b_build "`hc2f'_36.py" "server"
            local rc36 = r(rc)
            _hc2_b_opened "`stubdir'"
            _hc2_ok "HC2-36" `=`rc36' == 0 & r(n) == 0' "with server the build writes its app and opens nothing"

            // CF-21 -- WP-30 P1.27: the seam dropped, real batch: neither
            // dash build nor the one-line preview opens a window.
            macro drop dash__display
            quietly dash clear
            quietly dash scatter mpg weight, name(cf21)
            capture erase "`stubdir'/open.log"
            _hc2_b_build "`bo'" ""
            local rc21a = r(rc)
            _hc2_b_plot ""
            local rc21b = r(rc)
            _hc2_b_opened "`stubdir'"
            _hc2_ok "CF-21" `=`rc21a' == 0 & `rc21b' == 0 & r(n) == 0' "in batch dash build and the one-line preview open no window"
            global dash__display on

            // CF-22 (G9) -- the seam on: a path holding ; reaches the stub
            // opener as one argument, and nothing it names runs.
            mata: st_local("cf22p", st_local("stubdir") + "/a;touch PWNED;b.html")
            capture erase "`stubdir'/open.log"
            _hc2_b_build "`cf22p'" ""
            local rc22 = r(rc)
            _hc2_b_opened "`stubdir'"
            local cf22first `"`r(first)'"'
            mata: st_local("cf22ok", strofreal(anyof(("open " + st_local("cf22p"), "xdg-open " + st_local("cf22p")), st_local("cf22first"))))
            capture confirm file "PWNED"
            local cf22a = _rc
            capture confirm file "`stubdir'/PWNED"
            local cf22b = _rc
            _hc2_ok "CF-22" `=`rc22' == 0 & `cf22ok' == 1 & `cf22a' != 0 & `cf22b' != 0' "a path holding ; reaches the opener whole and runs nothing"
            capture erase "`cf22p'"
            quietly dash clear
        }
        local rc_b = _rc
        global dash_nobrowser 1
        capture macro drop dash__display
        if `rc_b' {
            _hc2_ok "HC2-3x" 0 "the browser section stopped with rc `rc_b'"
        }
    }
    python: os.environ["PATH"] = _hc2_path0
    capture erase "`stubdir'/open.log"
    capture erase "`stubdir'/which.txt"
    capture erase "`stubdir'/open"
    capture erase "`stubdir'/xdg-open"
    capture rmdir "`stubdir'"
}
global dash_nobrowser 1
quietly dash clear

// ================================================================
// Exporting
// ================================================================

// HC2-37 -- what export delimited writes.
preserve
clear
input double x str20 s byte f double d
0.5 "a,b" 0 21930
-3 `"say "hi""' 1 21931
1234567.891 "=cmd()" 0 .
. "" 1 21933
.a "-5 degrees" . 21934
1e-7 "plain" 0 21935
end
label define hc2_origin 0 "Domestic" 1 "Foreign, imported"
label values f hc2_origin
format d %td
format x %9.2f
local ed "`hc2f'_37.csv"
quietly export delimited using "`ed'", replace
restore
local hc2_37 = 0
foreach c in "x,s,f,d|the header row is the variable names" ///
             ".5,|a number has no leading zero" ///
             "1234567.891,|a number is written in full, not in its format" ///
             "1.00000000000e-07,|a small number is written in e-notation" ///
             ".a,|an extended missing value is written as .a" ///
             "16jan2020|a date is written in its display format" ///
             "Domestic|a labelled value is written as its label" ///
             `""a,b"|a text value with a comma is quoted"' ///
             `""Foreign, imported"|so is a label with one"' ///
             "=cmd()|a text value is written as it is" {
    local at = strpos(`"`c'"', "|")
    local nd = substr(`"`c'"', 1, `at' - 1)
    local wh = substr(`"`c'"', `at' + 1, .)
    local ++hc2_37
    local lt : word `hc2_37' of a b c d e f g h i j
    mata: st_local("_hit", strofreal(_hc2_rawhas(st_local("ed"), st_local("nd"))))
    _hc2_ok "HC2-37`lt'" `_hit' "export delimited: `wh'"
}
mata: st_local("_cr", strofreal(_hc2_rawhas(st_local("ed"), char(13))))
if "`c(os)'" != "Windows" {
    _hc2_ok "HC2-37k" `=`_cr' == 0' "export delimited ends a line in a line feed alone (`c(os)')"
}
else display as text "HC2-37k SKIP: the help's line-feed claim is Stata for Mac's"
mata: st_local("_bom", strofreal(_hc2_rawhas(st_local("ed"), char(239) + char(187) + char(191))))
_hc2_ok "HC2-37l" `=`_bom' == 0' "export delimited writes no byte-order mark"

// HC2-38 -- dash's writer writes every missing value as null.  This ran
// `jsonio out' itself until 24sep2026, after dash stopped using jsonio: it
// certified a package dash does not call.
preserve
clear
input double x double y
1 .
.a 2
.z 3
end
local jj "`hc2f'_38.json"
quietly _dash_write_data "`jj'" x y
restore
cert_file_has "`jj'", needle(`""x":"null""')
local n_null = r(found)
cert_file_has "`jj'", needle(".a")
_hc2_ok "HC2-38" `=`n_null' == 1 & r(found) == 0' "dash writes an extended missing value as null, never as .a"

// HC2-39 -- the columns: every variable the dashboard uses, a KPI card's
// included, in the order the dashboard names them.
sysuse auto, clear
quietly dash clear
quietly dash scatter weight mpg, name(e1)
quietly dash kpi mean(price), name(e2) title("P")
_hc2_run `"_dash_serve_spec, specpath("`hc2mj'") datapath("`hc2dj'") filter(foreign, type(dropdown)) csv"'
// In dash's writer's layout, which has no blanks (jsonio's, until
// 24sep2026, had them around each colon, bracket and comma).
cert_file_has "`hc2dj'", needle(`""variableNames":["weight","mpg","price","foreign"]"')
_hc2_ok "HC2-39" `=r(found) == 1' "the data dash exports is weight mpg price foreign: the graph's, the card's, the filter's -- not the dataset's order (price mpg weight foreign)"
quietly dash clear

// HC2-40 -- import delimited reads a file written as dash writes one: a
// byte-order mark and CR LF line ends.
local bomf "`hc2f'_40.csv"
mata: _hc2_fh = fopen(st_local("bomf"), "w")
mata: fwrite(_hc2_fh, char(239) + char(187) + char(191) + "x,s" + char(13) + char(10) + "1,a" + char(13) + char(10) + "2,b" + char(13) + char(10))
mata: fclose(_hc2_fh)
mata: mata drop _hc2_fh
preserve
quietly import delimited using "`bomf'", clear
capture confirm variable x s
local ok40 = (_rc == 0)
if `ok40' local ok40 = (_N == 2 & x[1] == 1 & s[2] == "b")
restore
_hc2_ok "HC2-40" `ok40' "import delimited reads through the byte-order mark and the CR LF line ends"

// HC2-41 -- twoway labels an axis with numbers, not value labels, unless
// told otherwise (xlabel(, valuelabel)).
twoway scatter mpg foreign
local svg "`hc2f'_41.svg"
cert_svg_export, file("`svg'")
cert_svg_has_text, file("`svg'") text("Domestic")
local _dom = r(found)
cert_svg_has_text, file("`svg'") text("1")
local _one = r(found)
_hc2_ok "HC2-41a" `=`_dom' == 0 & `_one' == 1' "twoway's axis for a value-labelled foreign reads 0 to 1, not Domestic"
twoway scatter mpg foreign, xlabel(0 1, valuelabel)
cert_svg_export, file("`svg'")
cert_svg_has_text, file("`svg'") text("Domestic")
local _dom = r(found)
_hc2_ok "HC2-41b" `_dom' "with valuelabel twoway draws the labels (the control)"
graph drop _all

// ----------------------------------------------------------------
// Summary
// ----------------------------------------------------------------
local nfail = ${hc2_nfail}
local flist "${hc2_faillist}"
macro drop hc2_nfail hc2_faillist
capture erase "`c(tmpdir)'hc2.log"
if `nfail' > 0 {
    display as error "test_help_claims_2: `nfail' check(s) FAILED:`flist'"
    exit 9
}
display as text ""
display as text "test_help_claims_2: ALL CHECKS PASSED"
