*! test_help_claims_2.cscript
*! Certification script: the claims dash.sthlp makes in its Option values
*! section, Subcommands, Dashboard Options and Exporting (lines 317-585 at
*! 4ede074) are true of the shipped code -- and where a claim is about
*! twoway, true of twoway, measured here in the same session.
*!
*! ROADMAP WP-23 (AC-23.1, TR-23.3) / GAPS.md F4.  Each case below pins one
*! claim of the help, or the corrected form of one the help got wrong.  A
*! twoway measurement is drawn, not only parsed: with `nodraw' twoway skips
*! the checks it makes while drawing (lwidth(10001) on a line, xsize(0.5),
*! msangle(-361) are rc 0 under nodraw and r(198) drawn; measured 23sep2026),
*! so every probe here draws, with graphics off.
*!
*! Option values (dash.sthlp, {marker validation}):
*!   HC2-01  the refusal the help shows, word for word, as ONE line; twoway
*!           accepts yaxis(3) and yaxis(9), refuses yaxis(10) ("twoway
*!           allows nine")
*!   HC2-02  a refusal comes before any Python: the one-line form refused
*!           writes no file
*!   HC2-03  yaxis(02), yaxis(+2), yaxis(2.0) and n(1E3) reach the spec as
*!           2, 2, 2 and 1000
*!   HC2-04  the bounds the help lists, at and past each edge
*!   HC2-05  a word where twoway swallows it (jitter(abc), jitterseed(abc):
*!           twoway rc 0) is refused
*!   HC2-06  msize(1e308): twoway refuses it and so does dash;
*!           msize(1e400): twoway accepts it, dash refuses it
*!   HC2-07  start(): refused above the variable's minimum on histogram, with
*!           twoway's own message; any number at or below it
*!   HC2-08  kernel(), colpalette() and theme() are matched without regard to
*!           case and normalised to lower case
*!   HC2-09  scheme() takes a theme name, and an unknown scheme is refused
*!           wherever it is written: on a graph, inside a segment, on
*!           dash build and dash serve
*!   HC2-10  variables: by(for) is by(foreign), as in twoway; a time-series
*!           expression in mlabel(), colorvar() or by() is refused -- and
*!           twoway refuses it too (r(111), r(101), r(101))
*!   HC2-11  aspectratio(), hover(), ysize() are checked inside a segment
*!   HC2-12  the dash-own bounds that say so in a second sentence, and
*!           twoway accepting each value
*!   HC2-13  mspline n() 1 to 300 is twoway's own bound: no second sentence
*!   HC2-14  the dash-own bounds with no second sentence, and twoway
*!           accepting each value; the options twoway does not have
*!   HC2-15  bands() 1 to 200 is twoway's own bound, twoway's message
*!   HC2-16  values twoway refuses and dash accepts: kernel(GAUSSIAN),
*!           a style option given (()), a string colorvar(); and a colour
*!           written with commas, which dash refuses, as twoway
*!   HC2-17  an unknown scheme(): twoway draws s2color with a note, dash
*!           refuses; twoway has no theme() at all
*!   HC2-18  forms twoway reads and dash refuses: an mlabel() element that
*!           names several variables (range(varname) and a . in range()
*!           taken since WP-31 C10a), and a width or angle
*!           bound on a plot type that does not draw what it styles
*!   HC2-19  the statistical switches: refused on every other plot type, as
*!           twoway refuses them, with twoway's messages
*!   HC2-20  a weight the plot type does not take is r(101), as in twoway
*!   HC2-21  colours, msymbol(), lpattern() and the sub-options are not
*!           checked in Stata; twoway notes an unknown style and refuses an
*!           unknown sub-option word, as dash refuses legend(garbage) and
*!           (HC2-21l, flipped WP-30 P1.18a) xscale(bogus)
*! Subcommands and Dashboard Options:
*!   HC2-22  the plot definition: name() registers and renders nothing;
*!           without it the graph is written at once
*!   HC2-23  dash build: saving() required, a registry required, server needs
*!           .py, and server writes the app and returns
*!   HC2-24  replace: an existing file is refused without it
*!   HC2-25  dash serve: port 5006, timeout 0 and filterposition(top) by
*!           default; the dashboard options reach the spec with dash
*!           build's meaning; saving(), replace and server are named in a
*!           note and ignored
*!   HC2-26  dash serve inherits csv from the preceding dash build
*!   HC2-27  dash clear discards the remembered options
*!   HC2-28  dash clear empties the registry and keeps the settings
*!           ($dash_nobrowser and $dash_max_*)
*! The browser (dash.sthlp's nobrowser rows and the $dash_nobrowser
*! definition).  `open' is replaced by a stub that records its arguments;
*! HC2-29 proves the stub is what the shell runs before any case below it
*! may open a window, and aborts otherwise:
*!   HC2-29  the guard: open and xdg-open are both the stub
*!   HC2-30  dash build with nothing said opens the file (the control: the
*!           stub sees it); HC2-30b with the platform's opener -- open on a
*!           Mac, whichever binary runs (the console binary reports c(os)
*!           Unix, and dash ran xdg-open there, which a Mac has not got)
*!   HC2-31  dash build, nobrowser opens nothing
*!   HC2-32  $dash_nobrowser, set to 1 or even to 0, keeps dash build shut
*!   HC2-33  a registered graph's nodraw keeps dash build shut
*!   HC2-34  the one-line form: opens with nothing said, with the platform's
*!           opener (34f); nodraw, the global and saving() each keep it
*!           shut; it has no nobrowser option
*!   HC2-35  dash clear leaves $dash_nobrowser in force
*!   HC2-36  dash build, server opens nothing
*!   CF-21   in batch, with the test seam dropped, no route opens a window
*!   CF-22   a hostile path reaches the stub opener as one argument
*!   (dash serve's routes are test_serve_browser.cscript SB-07..SB-10.)
*! Exporting:
*!   HC2-37  what export delimited writes, which the help compares the CSV
*!           with: line feeds, .5, 1.00000000000e-07, .a, display-format
*!           dates, labels, RFC 4180 quoting, no byte-order mark
*!   HC2-38  dash's writer (_dash_write_data; jsonio until 24sep2026)
*!           writes every missing value, extended ones included, as null --
*!           so the CSV's field for .a is empty
*!   HC2-39  the columns dash exports: every variable the dashboard uses,
*!           a KPI card's included, in the order the dashboard names them
*!   HC2-40  import delimited reads through a byte-order mark and CR LF
*! Labels (item 6 of Differences from twoway):
*!   HC2-41  twoway labels a value-labelled axis with numbers unless told
*!           valuelabel (dash's own axes are test_help_claims_2.py's)
*!
*! Usage:  cd test, then do test_help_claims_2.cscript (the dash directory
*!         on the ado-path).

cscript "dash help claims: option values, subcommands, dashboard options, exporting" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off

if `"`c(python_exec)'"' == "" {
    display as text "SKIP: no Python is linked to this Stata."
    exit 222
}

do "cert_helpers.do"
quietly do "cert_svg.do"
qui do "../dash_parse.mata"
qui do "../dash.ado"

global dash_nobrowser 1
set graphics off
sysuse auto, clear
quietly generate int t = _n
quietly tsset t

global hc2_nfail    = 0
global hc2_faillist ""

// ----------------------------------------------------------------
// Helpers
// ----------------------------------------------------------------
capture mata: mata drop _hc2_scan()
capture mata: mata drop _hc2_exact()
capture mata: mata drop _hc2_rawhas()
capture mata: mata drop _hc2_firstline()
mata:
// Count the logical lines of a log (continuations "> " re-joined) that
// carry `needle'; hand back the first.
void _hc2_scan(string scalar fn, string scalar needle)
{
    real scalar   fh, n
    string scalar line, full, first
    fh = fopen(fn, "r")
    n = 0
    full = ""
    first = ""
    while ((line = fget(fh)) != J(0, 0, "")) {
        if (substr(line, 1, 2) == "> ") {
            full = full + substr(line, 3, .)
            continue
        }
        if (strpos(full, needle)) {
            n = n + 1
            if (first == "") first = full
        }
        full = line
    }
    if (strpos(full, needle)) {
        n = n + 1
        if (first == "") first = full
    }
    fclose(fh)
    st_local("_hc2_n", strofreal(n))
    st_local("_hc2_line", first)
}

// 1 if some logical line of the log is exactly `want' (trailing blanks
// ignored).
real scalar _hc2_exact(string scalar fn, string scalar want)
{
    real scalar   fh, hit
    string scalar line, full
    fh = fopen(fn, "r")
    hit = 0
    full = ""
    while ((line = fget(fh)) != J(0, 0, "")) {
        if (substr(line, 1, 2) == "> ") {
            full = full + substr(line, 3, .)
            continue
        }
        if (strrtrim(full) == want) hit = 1
        full = line
    }
    if (strrtrim(full) == want) hit = 1
    fclose(fh)
    return(hit)
}

// 1 if the file's raw bytes carry `needle' (a byte search, so a CR or a
// byte-order mark is seen as written).
real scalar _hc2_rawhas(string scalar fn, string scalar needle)
{
    real scalar   fh
    string scalar s, chunk
    fh = fopen(fn, "r")
    s = ""
    while ((chunk = fread(fh, 65536)) != J(0, 0, "")) s = s + chunk
    fclose(fh)
    return(strpos(s, needle) > 0)
}

// The first line of a file, or "" when it cannot be read.
string scalar _hc2_firstline(string scalar fn)
{
    real scalar   fh
    string scalar line
    fh = _fopen(fn, "r")
    if (fh < 0) return("")
    line = fget(fh)
    fclose(fh)
    if (line == J(0, 0, "")) return("")
    return(line)
}
end

// Run one command with its output logged; r(rc).  The log is wide, so a
// message is one line in it.
capture program drop _hc2_run
program define _hc2_run, rclass
    version 16.0
    args cmdtext
    local logfile "`c(tmpdir)'hc2.log"
    local ls = c(linesize)
    set linesize 255
    capture log close _hc2log
    capture erase "`logfile'"
    log using "`logfile'", name(_hc2log) text replace
    capture noisily `cmdtext'
    local rc = _rc
    log close _hc2log
    set linesize `ls'
    return scalar rc = `rc'
end

// How many logical lines of the last log carry `needle'; r(n), r(line).
capture program drop _hc2_said
program define _hc2_said, rclass
    version 16.0
    args needle
    mata: _hc2_scan(c("tmpdir") + "hc2.log", st_local("needle"))
    return scalar n = `_hc2_n'
    return local line `"`macval(_hc2_line)'"'
end

// Tally one verdict.
capture program drop _hc2_ok
program define _hc2_ok
    version 16.0
    args id ok what
    if `ok' {
        display as text `"`id' PASS: `macval(what)'"'
    }
    else {
        display as error `"`id' FAIL: `macval(what)'"'
        global hc2_nfail    = ${hc2_nfail} + 1
        global hc2_faillist "${hc2_faillist} `id'"
    }
end

// Run a command and judge its rc and, when given, a line its log must
// carry.  One verdict.
capture program drop _hc2_expect
program define _hc2_expect
    version 16.0
    args id want cmdtext needle
    _hc2_run `"`macval(cmdtext)'"'
    local rc = r(rc)
    local ok = (`rc' == `want')
    local why ""
    if !`ok' local why " [got rc `rc']"
    if `ok' & `"`macval(needle)'"' != "" {
        _hc2_said `"`macval(needle)'"'
        if r(n) == 0 {
            local ok = 0
            local why " [the log does not say: `macval(needle)']"
        }
    }
    _hc2_ok "`id'" `ok' `"rc `want': `macval(cmdtext)'`macval(why)'"'
end

// The same, from an empty registry (a dash probe).
capture program drop _hc2_dash
program define _hc2_dash
    version 16.0
    args id want cmdtext needle
    quietly dash clear
    _hc2_expect "`id'" `want' `"`macval(cmdtext)'"' `"`macval(needle)'"'
end

// The last log holds a line exactly `want'.  One verdict.
capture program drop _hc2_line_is
program define _hc2_line_is
    version 16.0
    args id want
    mata: st_local("_hit", strofreal(_hc2_exact(c("tmpdir") + "hc2.log", st_local("want"))))
    _hc2_ok "`id'" `_hit' `"the log carries the line: `macval(want)'"'
end

// The registered spec of graph `g' carries `needle'.  One verdict.
capture program drop _hc2_reg
program define _hc2_reg
    version 16.0
    args id g needle
    mata: st_local("_hit", strofreal(strpos(st_global("dash_json_" + st_local("g")), st_local("needle")) > 0))
    _hc2_ok "`id'" `_hit' `"the spec of `g' carries `macval(needle)'"'
end

// A refusal from the value rules ends in "(got: <value>)" and nothing
// after it -- no second sentence -- or in exactly `tail'.  `value' is the
// value the command gave, which the refusal echoes.
capture program drop _hc2_tail
program define _hc2_tail
    version 16.0
    args id opt tail value
    _hc2_said "dash: `opt'() must be"
    local line `"`r(line)'"'
    local line = strrtrim(`"`macval(line)'"')
    if `"`macval(tail)'"' == "" {
        // The line ends in exactly "(got: <value>)".  Until 24sep2026 any
        // line ending in ")" and holding "(got: " passed, so a second
        // sentence that closed a parenthesis -- ". dash draws up to 300
        // (twoway's bound)" -- read as no second sentence at all.
        local want `"(got: `macval(value)')"'
        local n = strlen(`"`macval(want)'"')
        local ok = (`"`macval(value)'"' != "" & substr(`"`macval(line)'"', -`n', .) == `"`macval(want)'"')
        _hc2_ok "`id'" `ok' `"`opt'(): the refusal has no second sentence: `macval(line)'"'
    }
    else {
        local n = strlen(`"`macval(tail)'"')
        local ok = (substr(`"`macval(line)'"', -`n', .) == `"`macval(tail)'"')
        _hc2_ok "`id'" `ok' `"`opt'(): the refusal ends `macval(tail)': `macval(line)'"'
    }
end

// ================================================================
// Option values
// ================================================================

// HC2-01 -- the example the help prints, and twoway's nine axes.
_hc2_dash "HC2-01a" 198 `"dash (scatter mpg weight, yaxis(3))"'
_hc2_line_is "HC2-01b" "dash: yaxis() must be an integer between 1 and 2 (got: 3). dash draws two axes."
_hc2_said "yaxis()"
_hc2_ok "HC2-01c" `=r(n) == 1' "the refusal is one line"
_hc2_expect "HC2-01d" 0   `"twoway scatter mpg weight, yaxis(3)"'
_hc2_expect "HC2-01e" 0   `"twoway scatter mpg weight, yaxis(9)"'
_hc2_expect "HC2-01f" 125 `"twoway scatter mpg weight, yaxis(10)"'

// HC2-02 -- refused before any Python: nothing is written.
tempfile hc2f
local hc2out "`hc2f'_02.html"
capture erase "`hc2out'"
_hc2_dash "HC2-02a" 198 `"dash scatter mpg weight, yaxis(3) saving("`hc2out'")"'
capture confirm file "`hc2out'"
_hc2_ok "HC2-02b" `=_rc != 0' "the refused one-line form wrote no file"

// HC2-03 -- one canonical spelling for an integer.
_hc2_dash "HC2-03a" 0 `"dash scatter mpg weight, yaxis(02) name(hc)"'
_hc2_reg  "HC2-03b" hc `""yaxis":"2""'
_hc2_dash "HC2-03c" 0 `"dash scatter mpg weight, yaxis(+2) name(hc)"'
_hc2_reg  "HC2-03d" hc `""yaxis":"2""'
_hc2_dash "HC2-03e" 0 `"dash scatter mpg weight, yaxis(2.0) name(hc)"'
_hc2_reg  "HC2-03f" hc `""yaxis":"2""'
_hc2_dash "HC2-03g" 0 `"dash kdensity mpg, n(1E3) name(hc)"'
_hc2_reg  "HC2-03h" hc `""n":"1000""'

// HC2-04 -- the listed bounds, at and just past each edge.
_hc2_dash "HC2-04a" 0   `"dash scatter mpg weight, jitter(0) name(hc)"'
_hc2_dash "HC2-04b" 0   `"dash scatter mpg weight, jitter(100) name(hc)"'
_hc2_dash "HC2-04c" 198 `"dash scatter mpg weight, jitter(100.5) name(hc)"'
_hc2_dash "HC2-04d" 0   `"dash scatter mpg weight, malpha(100) lalpha(0) falpha(100) name(hc)"'
_hc2_dash "HC2-04e" 198 `"dash scatter mpg weight, lalpha(101) name(hc)"'
_hc2_dash "HC2-04f" 198 `"dash scatter mpg weight, falpha(-1) name(hc)"'
_hc2_dash "HC2-04g" 198 `"dash scatter mpg weight, malpha(101) name(hc)"'
_hc2_dash "HC2-04h" 0   `"dash lfitci mpg weight, level(0.5) name(hc)"'
// Flipped (WP-31 C10a): twoway's rc (test/fixtures/value_bounds_truth.json).
_hc2_dash "HC2-04i" 0   `"dash lfitci mpg weight, level(0) name(hc)"'
_hc2_dash "HC2-04j" 0   `"dash scatter mpg weight, aspectratio(0) name(hc)"'
_hc2_dash "HC2-04k" 0   `"dash bar mpg weight, base(-1e10) name(hc)"'
_hc2_dash "HC2-04l" 0   `"dash bar mpg weight, barwidth(0.001) name(hc)"'
_hc2_dash "HC2-04m" 198 `"dash histogram mpg, width(-1) name(hc)"'
_hc2_dash "HC2-04n" 0   `"dash lowess mpg weight, bwidth(1) name(hc)"'
// Flipped (WP-31 C10a): twoway's rc (test/fixtures/value_bounds_truth.json).
_hc2_dash "HC2-04o" 0   `"dash lowess mpg weight, bwidth(1.01) name(hc)"'
_hc2_dash "HC2-04p" 0   `"dash lpoly mpg weight, degree(0) name(hc)"'
_hc2_dash "HC2-04q" 0   `"dash lpoly mpg weight, degree(3) name(hc)"'
_hc2_dash "HC2-04r" 0   `"dash kdensity mpg, n(2) name(hc)"'
_hc2_dash "HC2-04s" 0   `"dash kdensity mpg, n(10000) name(hc)"'
_hc2_dash "HC2-04t" 198 `"dash kdensity mpg, n(10001) name(hc)"'
_hc2_dash "HC2-04u" 0   `"dash mspline mpg weight, n(1) name(hc)"'
_hc2_dash "HC2-04v" 0   `"dash mspline mpg weight, n(300) name(hc)"'
_hc2_dash "HC2-04w" 0   `"dash histogram mpg, bin(1) name(hc)"'
_hc2_dash "HC2-04x" 0   `"dash histogram mpg, bin(1000) name(hc)"'
_hc2_dash "HC2-04y" 198 `"dash histogram mpg, bin(1001) name(hc)"'
_hc2_dash "HC2-04z" 0   `"dash mband mpg weight, bands(1) name(hc)"'
_hc2_dash "HC2-04A" 0   `"dash mband mpg weight, bands(200) name(hc)"'
_hc2_dash "HC2-04B" 0   `"dash scatter mpg weight, colorvar(rep78) colornlevels(2) name(hc)"'
_hc2_dash "HC2-04C" 0   `"dash scatter mpg weight, colorvar(rep78) colornlevels(256) name(hc)"'
_hc2_dash "HC2-04D" 198 `"dash scatter mpg weight, colorvar(rep78) colornlevels(257) name(hc)"'
_hc2_dash "HC2-04E" 0   `"dash scatter mpg weight, jitter(1) jitterseed(0) jseed(0) name(hc)"'
_hc2_dash "HC2-04F" 0   `"dash scatter mpg weight, msize(-5) mlabel(make) mlabsize(-5) mlabgap(-5) mlabposition(-5) name(hc)"'
_hc2_dash "HC2-04G" 0   `"dash bar mpg weight, fintensity(-5) name(hc)"'
_hc2_dash "HC2-04H" 0   `"dash line mpg weight, lwidth(10000) name(hc)"'
_hc2_dash "HC2-04I" 198 `"dash line mpg weight, lwidth(10001) name(hc)"'
_hc2_dash "HC2-04J" 198 `"dash scatter mpg weight, mlwidth(-0.5) name(hc)"'
_hc2_dash "HC2-04K" 0   `"dash scatter mpg weight, msangle(-360) name(hc)"'
_hc2_dash "HC2-04L" 198 `"dash scatter mpg weight, msangle(360.5) name(hc)"'
_hc2_dash "HC2-04M" 0   `"dash scatter mpg weight, xsize(1) ysize(100) name(hc)"'
_hc2_dash "HC2-04N" 198 `"dash scatter mpg weight, xsize(0.5) name(hc)"'
_hc2_dash "HC2-04O" 198 `"dash scatter mpg weight, ysize(100.5) name(hc)"'
// Flipped (WP-31 C10a): twoway's rc (test/fixtures/value_bounds_truth.json).
_hc2_dash "HC2-04P" 122 `"dash function y=x, range(1) name(hc)"' "option range() requires two numbers"
_hc2_dash "HC2-04Q" 0   `"dash scatter mpg weight, colorvar(rep78) colorcuts(3) name(hc)"'

// HC2-05 -- a word twoway would have swallowed.
_hc2_expect "HC2-05a" 0   `"twoway scatter mpg weight, jitter(abc)"'
_hc2_expect "HC2-05b" 0   `"twoway scatter mpg weight, jitter(5) jitterseed(abc)"'
_hc2_dash   "HC2-05c" 198 `"dash scatter mpg weight, jitter(abc) name(hc)"' "jitter()"
_hc2_dash   "HC2-05d" 198 `"dash scatter mpg weight, jitter(5) jitterseed(abc) name(hc)"' "jitterseed()"

// HC2-06 -- a word that only looks like a number.
_hc2_expect "HC2-06a" 198 `"twoway scatter mpg weight, msize(1e308)"' "invalid syntax"
_hc2_dash   "HC2-06b" 198 `"dash scatter mpg weight, msize(1e308) name(hc)"' "msize()"
_hc2_expect "HC2-06c" 0   `"twoway scatter mpg weight, msize(1e400)"'
_hc2_dash   "HC2-06d" 198 `"dash scatter mpg weight, msize(1e400) name(hc)"' "msize()"

// HC2-07 -- start() on histogram, as twoway checks it.
_hc2_expect "HC2-07a" 198 `"twoway histogram mpg, start(12.5)"' "option start() may not be larger than minimum of mpg"
_hc2_dash   "HC2-07b" 198 `"dash histogram mpg, start(12.5) name(hc)"' "option start() may not be larger than minimum of mpg"
_hc2_expect "HC2-07c" 0   `"twoway histogram mpg, start(12)"'
_hc2_dash   "HC2-07d" 0   `"dash histogram mpg, start(12) name(hc)"'
_hc2_dash   "HC2-07e" 0   `"dash histogram mpg, start(-1000) name(hc)"'

// HC2-08 -- a word from a list, in any case.
_hc2_dash "HC2-08a" 0 `"dash kdensity mpg, kernel(Epan2) name(hc)"'
_hc2_reg  "HC2-08b" hc `""kernel":"epan2""'
_hc2_dash "HC2-08c" 0 `"dash scatter mpg weight, colorvar(rep78) colpalette(MAGMA) name(hc)"'
_hc2_reg  "HC2-08d" hc `""colpalette":"magma""'
quietly dash clear
quietly dash scatter mpg weight, name(hc)
tempfile hc2mj hc2dj
_hc2_run `"_dash_serve_spec, specpath("`hc2mj'") datapath("`hc2dj'") theme(DARK)"'
_hc2_ok "HC2-08e" `=r(rc) == 0' "dash serve takes theme(DARK)"
cert_file_has "`hc2mj'", needle(`""theme":"dark""')
_hc2_ok "HC2-08f" `=r(found) == 1' "theme(DARK) reaches the spec as dark"
_hc2_expect "HC2-08g" 198 `"_dash_serve_spec, specpath("`hc2mj'") datapath("`hc2dj'") theme(nonsense)"' "theme()"

// HC2-09 -- scheme(): a theme name is a scheme name; an unknown one is
// refused wherever it is written.
_hc2_dash "HC2-09a" 0   `"dash scatter mpg weight, scheme(DARK) name(hc)"'
_hc2_dash "HC2-09b" 198 `"dash (scatter mpg weight, scheme(nonsense)) (line mpg weight), name(hc)"' "scheme()"
_hc2_dash "HC2-09c" 198 `"dash scatter mpg weight, scheme(nonsense) name(hc)"' "scheme()"
quietly dash clear
quietly dash scatter mpg weight, name(hc)
_hc2_expect "HC2-09d" 198 `"_dash_serve_spec, specpath("`hc2mj'") datapath("`hc2dj'") scheme(nonsense)"' "scheme()"

// HC2-10 -- variables, expanded as twoway expands them; a time-series
// expression refused, as twoway refuses it, with its code and words
// (Flipped, WP-31 A6: HC2-10e/g/i were r(198) "not a time-series
// expression").
_hc2_expect "HC2-10a" 0 `"twoway scatter mpg weight, by(for)"'
_hc2_dash   "HC2-10b" 0 `"dash scatter mpg weight, by(for) name(hc)"'
_hc2_reg    "HC2-10c" hc `""by":"foreign""'
_hc2_expect "HC2-10d" 111 `"twoway scatter mpg weight, mlabel(L.mpg)"' "variable L not found"
_hc2_dash   "HC2-10e" 111 `"dash scatter mpg weight, mlabel(L.mpg) name(hc)"' "variable L not found"
_hc2_expect "HC2-10f" 101 `"twoway scatter mpg weight, colorvar(L.mpg)"' "time-series operators not allowed"
_hc2_dash   "HC2-10g" 101 `"dash scatter mpg weight, colorvar(L.mpg) name(hc)"' "time-series operators not allowed"
_hc2_expect "HC2-10h" 101 `"twoway scatter mpg weight, by(L.foreign)"' "time-series operators not allowed"
_hc2_dash   "HC2-10i" 101 `"dash scatter mpg weight, by(L.foreign) name(hc)"' "time-series operators not allowed"
_hc2_dash   "HC2-10j" 111 `"dash scatter mpg weight, mlabel(nosuchvar) name(hc)"' "not found"

// HC2-11 -- checked inside a segment as well as after the comma.
_hc2_dash "HC2-11a" 198 `"dash (scatter mpg weight, aspectratio(-1)) (line mpg weight), name(hc)"' "aspectratio()"
_hc2_dash "HC2-11b" 111 `"dash (scatter mpg weight, hover(nosuch)) (line mpg weight), name(hc)"' "hover()"
_hc2_dash "HC2-11c" 198 `"dash (scatter mpg weight, ysize(101)) (line mpg weight), name(hc)"' "ysize()"

// HC2-12 -- dash's own bounds that say so; twoway takes every value.
_hc2_dash "HC2-12a" 198 `"dash lpoly mpg weight, degree(5) name(hc)"'
_hc2_tail "HC2-12b" degree ". dash fits local polynomials up to degree 3."
_hc2_dash "HC2-12c" 198 `"dash histogram mpg, bin(5000) name(hc)"'
_hc2_tail "HC2-12d" bin ". dash draws up to 1000 bins."
_hc2_dash "HC2-12e" 198 `"dash kdensity mpg, n(20000) name(hc)"'
_hc2_tail "HC2-12f" n ". dash evaluates up to 10000 points."
// Flipped (WP-31 C10a): twoway's rc (test/fixtures/value_bounds_truth.json).
_hc2_dash "HC2-12g" 0 `"dash lowess mpg weight, bwidth(5) name(hc)"'
_hc2_dash "HC2-12h" 0 `"dash lowess mpg weight, bwidth(-1) name(hc)"'
_hc2_dash "HC2-12i" 198 `"dash scatter mpg weight, xaxis(3) name(hc)"'
_hc2_tail "HC2-12j" xaxis ". dash draws two axes."
// Flipped (WP-31 C10a): n(1) is twoway's; n(0) is refused with no
// second sentence, its lower bound being twoway's.
_hc2_dash "HC2-12k" 198 `"dash lfit mpg weight, n(0) name(hc)"'
_hc2_tail "HC2-12l" n "" 0
_hc2_expect "HC2-12m" 0 `"twoway lpoly mpg weight, degree(5)"'
_hc2_expect "HC2-12n" 0 `"twoway histogram mpg, bin(5000)"'
_hc2_expect "HC2-12o" 0 `"twoway kdensity mpg, n(20000)"'
_hc2_expect "HC2-12p" 0 `"twoway kdensity mpg, n(1)"'
_hc2_expect "HC2-12q" 0 `"twoway lowess mpg weight, bwidth(5)"'
_hc2_expect "HC2-12r" 0 `"twoway scatter mpg weight, xaxis(9)"'
_hc2_expect "HC2-12s" 125 `"twoway scatter mpg weight, xaxis(10)"'

// HC2-13 -- mspline's n() bound is twoway's own.
_hc2_expect "HC2-13a" 198 `"twoway mspline mpg weight, n(301)"' "n must be between 1 and 300"
_hc2_expect "HC2-13b" 0   `"twoway mspline mpg weight, n(1)"'
_hc2_dash   "HC2-13c" 198 `"dash mspline mpg weight, n(301) name(hc)"'
_hc2_tail   "HC2-13d" n "" 301

// HC2-14 -- dash's own bounds with no second sentence; twoway takes each
// value, and has no such option at all for the rest.
_hc2_dash "HC2-14a" 198 `"dash scatter mpg weight, jitter(101) name(hc)"'
_hc2_tail "HC2-14b" jitter "" 101
// Flipped (WP-31 C10a): twoway's rc (test/fixtures/value_bounds_truth.json).
_hc2_dash "HC2-14c" 0 `"dash lfitci mpg weight, level(100) name(hc)"'
_hc2_dash "HC2-14d" 0 `"dash lfitci mpg weight, level(-1) name(hc)"'
_hc2_dash "HC2-14e" 198 `"dash bar mpg weight, barwidth(0) name(hc)"'
_hc2_tail "HC2-14f" barwidth "" 0
