_hc2_dash "HC2-14o" 198 `"dash scatter mpg weight, jitter(5) jseed(-1) name(hc)"'
_hc2_tail "HC2-14p" jseed "" -1
_hc2_expect "HC2-14q" 0 `"twoway scatter mpg weight, jitter(101)"'
_hc2_expect "HC2-14r" 0 `"twoway lfitci mpg weight, level(100)"'
_hc2_expect "HC2-14s" 0 `"twoway lfitci mpg weight, level(0)"'
