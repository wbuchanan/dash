    "marker_size_rule": "drawn outer diameter = symbolsize%*height + marker outline width",
    "diamond_rule": "Stata's diamond is the square marker rotated 45 degrees: same side length, so its bounding box is sqrt(2) x wider than the square's.",
    "line_plot_vs_connected": "twoway line takes its colour from 'color p#' and its pattern from 'linepattern p#lineplot'. twoway connected takes them from 'color p#line'/'color pline' and 'linepattern p#line'. The p#line keys do NOT drive a plain line chart."
  },
  "repo_scheme_disagreements": [
    {
      "scheme": "s1mono",
      "keys": [
        "color p1line",
        "color p2line",
        "color p3line"
      ],
      "repo_says": "#000000 (all three)",
      "stata_drew_twoway_line": [
        "#606060",
        "#A0A0A0",
        "#808080"
      ],
      "stata_drew_twoway_connected": [
        "#000000",
        "#000000",
        "#000000"
      ],
      "explanation": "Stata's s1mono declares 'color pline black', which the repo correctly expanded to p1line..p15line. But a plain 'twoway line' does NOT read p#line - it reads 'color p#' (gs6/gs10/gs8). p#line only governs the connecting line of a 'twoway connected' plot. Applying p#line to a line chart paints all three black.",
      "severity": "high"
    },
    {
      "scheme": "s1mono",
      "keys": [
        "linepattern p2line",
        "linepattern p3line"
      ],
      "repo_says": [
        "dash",
        "vshortdash"
      ],
      "stata_drew_twoway_line": [
        "solid",
        "solid"
      ],
      "stata_drew_twoway_connected": [
        "dashed",
        "dashed"
      ],
      "explanation": "Same key-routing issue. A line chart's pattern comes from 'linepattern p#lineplot', which s1mono never declares, so every series is solid. s2mono/sj DO declare p#lineplot and do render dashed - so the key, not the scheme family, is what decides.",
      "severity": "high"
    },
