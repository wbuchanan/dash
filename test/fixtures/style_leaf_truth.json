  "files": {
    "ORDER/scheme-economist.scheme": "#include s2color\ncolor p1 red\n",
    "anglestyle-zqa.style": "set val 30\n",
    "color-zqc.style": "set rgb \"200 30 40\"\n",
    "gsize-zqg.style": "set val     10\nset sztype  relative\n",
    "gsize-zqp.style": "set val     18\nset sztype  points\n",
    "intensity-zqi.style": "set val 30\n",
    "linepattern-zqpat.style": "set pattern \"4 1 1 1\"\n",
    "linepattern-zqpb.style": "set pattern \"4 1 .1 1\"\n",
    "linewidth-zqw.style": "set val 2\n",
    "margin-zqm.style": "set gleft   5\nset gright  5\nset gtop    5\nset gbottom 5\n",
    "margin-zqn.style": "set gleft   2\nset gright  4\nset gtop    6\nset gbottom 8\n",
    "scheme-w45b.scheme": "#include s2color\nyesno plabelboxed yes\n",
    "scheme-w45c.scheme": "#include s2color\nclockdir title_position 3\n",
    "scheme-w45c3.scheme": "#include s2color\nclockdir caption_position 3\n",
    "scheme-w45c9.scheme": "#include s2color\nclockdir caption_position 9\n",
    "scheme-w45g.scheme": "#include s2color\ngsize legend_col_gap huge\n",
    "scheme-w45n3.scheme": "#include s2color\nclockdir note_position 3\n",
    "scheme-w45n9.scheme": "#include s2color\nclockdir note_position 9\n",
    "scheme-w45p.scheme": "#include s2color\nclockdir p 9\n",
    "scheme-w45q.scheme": "#include s2color\nclockdir p2 9\n",
    "scheme-w45s3.scheme": "#include s2color\nclockdir subtitle_position 3\n",
    "scheme-w45s9.scheme": "#include s2color\nclockdir subtitle_position 9\n",
    "scheme-w45t.scheme": "#include s2color\ntextboxstyle title subheading\n",
    "symbolsize-zqs.style": "set val     5\nset sztype  relative\n",
    "textboxstyle-zqt.style": "set angle      default\nset size       huge\nset color      red\nset horizontal scheme heading\nset vertical   scheme heading\nset margin     scheme heading\nset drawbox    scheme textbox\nset fillcolor  scheme textbox\nset linestyle  scheme textbox\nset boxmargin  scheme textbox\n"
