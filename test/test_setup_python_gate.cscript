*! test_setup_python_gate.cscript
*! Certification script for dash_setup's Python version gate.
*!
*! Usage:  do test/test_setup_python_gate.cscript
*! Version: 1.0.0  20sep2026
*!
*! WHY THIS EXISTS
*!
*! dash_setup.sthlp says, of dash_setup's first step:
*!
*!     1.  Verifies that Python 3.8+ is available to Stata via `python query'.
*!
*! It did not.  dash_setup.ado ran `capture python query' -- which succeeds
*! for ANY linked Python, 3.6 included -- then read sys.version into a macro
*! and printed it.  Nothing anywhere compared it to 3.8.  A user on Python
*! 3.7 was told "Python ............. OK (version 3.7.9)" and sent on to
*! fail later, inside bokeh, with a message about neither Python nor dash.
*!
*! The comparison cannot be tested by running it, because testing "3.7 is
*! rejected" would need a Python 3.7 to hand.  So the comparison lives in
*! _dash_pyver_ok, which takes the two version strings as arguments and can
*! be driven through every case from any interpreter.

cscript "dash_setup python version gate" adodir ".."
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}

adopath ++ ".."
qui do "../dash_setup.ado"

local fail 0

program define _chk
    args label got want
    if "`got'" != "`want'" {
        display as error "FAIL: `label' -- got `got', want `want'"
        c_local fail = 1
    }
    else display as text "  ok: `label'"
end

// ---- at or above the minimum ----
_dash_pyver_ok "3.8.0"  "3.8"
_chk "3.8.0 >= 3.8"   "`r(ok)'" "1"
_dash_pyver_ok "3.8"    "3.8"
_chk "3.8 >= 3.8"     "`r(ok)'" "1"
_dash_pyver_ok "3.9.6"  "3.8"
_chk "3.9.6 >= 3.8"   "`r(ok)'" "1"
_dash_pyver_ok "3.14.5" "3.8"
_chk "3.14.5 >= 3.8"  "`r(ok)'" "1"
_dash_pyver_ok "4.0.0"  "3.8"
_chk "4.0.0 >= 3.8"   "`r(ok)'" "1"

// 3.10 is NOT less than 3.9: a string comparison says it is, which is the
// classic way this check is got wrong.
_dash_pyver_ok "3.10.0" "3.9"
_chk "3.10.0 >= 3.9 (not a string compare)" "`r(ok)'" "1"

// ---- below the minimum ----
_dash_pyver_ok "3.7.9"  "3.8"
_chk "3.7.9 < 3.8"    "`r(ok)'" "0"
_dash_pyver_ok "3.6.15" "3.8"
_chk "3.6.15 < 3.8"   "`r(ok)'" "0"
_dash_pyver_ok "2.7.18" "3.8"
_chk "2.7.18 < 3.8"   "`r(ok)'" "0"

// ---- input that is not a version ----
// A version string dash cannot read must not abort setup; it reports and
// lets the run continue, because a wrong guess here is worse than none.
_dash_pyver_ok ""       "3.8"
_chk "empty is unknown"      "`r(ok)'" "-1"
_dash_pyver_ok "abc"    "3.8"
_chk "non-numeric is unknown" "`r(ok)'" "-1"
_dash_pyver_ok "3.8.0rc1" "3.8"
_chk "3.8.0rc1 >= 3.8"   "`r(ok)'" "1"

// ---- the help's claim is the contract ----
// Read the repo's own files by path, not through findfile: inside the full
// runner the adopath also carries an installed copy of dash, and findfile
// returned THAT one -- so this check passed or failed depending on which
// dash happened to be installed, which is no check at all.
tempname fh
_dash_pymin
local pymin "`r(pymin)'"
_chk "dash_setup names a minimum" "`=cond("`pymin'"=="", "0", "1")'" "1"

local found 0
file open `fh' using "../dash_setup.sthlp", read text
file read `fh' line
while r(eof) == 0 {
    if strpos(`"`line'"', "`pymin'") > 0 local found 1
    file read `fh' line
}
file close `fh'
_chk "dash_setup.sthlp states the same minimum (`pymin')" "`found'" "1"

// ---- the version the CALLER declares must not change the answer ----
//
// Every case above calls _dash_pyver_ok from this script's own scope, where
// `version' is the session's.  dash_setup calls it from a program that
// declares `version 16.0', and under that setting the comparator answered
// "at or above" for EVERYTHING:
//
//     3.7.9 >= 3.8   ->  1        0.9 >= 1.5  ->  1
//
// `return scalar' followed by `exit' inside the forvalues loop took effect
// under neither, so every input fell through to the final `ok = 1'.  The
// Python minimum this script exists to protect therefore never fired in
// production, while all of the cases above passed.  The comparator now
// decides once and returns after the loop.
//
// These cases call it the way dash_setup does: at version 19, which
// dash_setup declares since WP-30 (P1.35; it was 16.0).
capture program drop _gate19
program define _gate19, rclass
    version 19
    args got want
    _dash_pyver_ok "`got'" "`want'"
    return scalar ok = r(ok)
end

_gate19 "3.8.0"  "3.8"
_chk "v19: 3.8.0 >= 3.8"   "`r(ok)'" "1"
_gate19 "3.7.9"  "3.8"
_chk "v19: 3.7.9 < 3.8"    "`r(ok)'" "0"
_gate19 "2.7.18" "3.8"
_chk "v19: 2.7.18 < 3.8"   "`r(ok)'" "0"
_gate19 "3.10.0" "3.9"
_chk "v19: 3.10.0 >= 3.9"  "`r(ok)'" "1"
_gate19 "3.9"    "3.10"
_chk "v19: 3.9 < 3.10"     "`r(ok)'" "0"
_gate19 ""       "3.8"
_chk "v19: empty is unknown"  "`r(ok)'" "-1"
_gate19 "abc"    "3.8"
_chk "v19: non-numeric is unknown" "`r(ok)'" "-1"

capture program drop _gate19

// ---- comparator inputs with a 3.13 want (WP-28 K2) ----
// These cases pin the comparator's SHAPE around a 3.13 want, the way the
// block above pins it around 3.8 -- comparator inputs, not the declared
// minimum, which is read below, and which "dash_setup names a minimum"
// and "dash_setup.sthlp states the same minimum" read from
// _dash_pymin/dash_setup.sthlp directly.
_dash_pyver_ok "3.13.9" "3.13"
_chk "3.13.9 >= 3.13" "`r(ok)'" "1"
_dash_pyver_ok "3.13"   "3.13"
_chk "3.13 >= 3.13"   "`r(ok)'" "1"
_dash_pyver_ok "3.12.11" "3.13"
_chk "3.12.11 < 3.13" "`r(ok)'" "0"
_dash_pyver_ok "3.10.10" "3.13"
_chk "3.10.10 < 3.13" "`r(ok)'" "0"

// A caller at version 16 is still supported on Stata 19 (WP-30 P1.35).
capture program drop _gate16
program define _gate16, rclass
    version 16.0
    args got want
    _dash_pyver_ok "`got'" "`want'"
    return scalar ok = r(ok)
end
_gate16 "3.13.9" "3.13"
_chk "v16: 3.13.9 >= 3.13" "`r(ok)'" "1"
_gate16 "3.12.11" "3.13"
_chk "v16: 3.12.11 < 3.13" "`r(ok)'" "0"
capture program drop _gate16

// ---- the upgrade line names the linked interpreter (Q27) ----
// _dash_pip_command builds the `To upgrade:' line dash_setup prints when
// a package is below its minimum: the interpreter Stata is linked to,
// never a bare `python'.  WP-29 P0.19: the line is built by
// dash_setup_lib.py and quoted for the shell (shlex.join on POSIX), so the
// expected line is that oracle (with no Python set, the one Stata found).
_dash_pip_command "bokeh" "3.8"
local _pipcmd `"`r(cmd)'"'
python: import shlex, sfi, sys; sfi.Macro.setLocal("_want_cmd", shlex.join([(sfi.SFIToolkit.macroExpand(chr(96) + "c(python_exec)'") or sys.executable), "-m", "pip", "install", "bokeh>=3.8"]))
_chk "the pip command is c(python_exec) + pip install, quoted" `"`_pipcmd'"' `"`_want_cmd'"'
mata: st_local("_haspx", strofreal(strpos(st_local("_pipcmd"), " -m pip install 'bokeh>=3.8'") > 1))
_chk "the upgrade command names c(python_exec)" "`_haspx'" "1"

// ---- the floor dash_setup declares admits 3.11 and 3.12 (WP-30 P1.33) ----
// The declared floor is measured: both test suites pass under it.
_dash_pymin
local _fl "`r(pymin)'"
_dash_pyver_ok "3.12.12" "`_fl'"
_chk "3.12.12 >= the floor `_fl'" "`r(ok)'" "1"
_dash_pyver_ok "3.11.0" "`_fl'"
_chk "3.11.0 against the floor `_fl'" "`r(ok)'" "1"
_dash_pyver_ok "3.10.10" "`_fl'"
_chk "3.10.10 < the floor `_fl'" "`r(ok)'" "0"

if `fail' {
    display as error "SOME TESTS FAILED"
    exit 9
}
display as text "ALL TESTS PASSED"
