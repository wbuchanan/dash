*! test_serve_options.cscript
*! Certification script for `dash serve' option pass-through.
*!
*! Usage:  do test/test_serve_options.cscript
*!
*! Requires: dash_setup completed.
*! Version: 1.0.0  20sep2026
*!
*! WHY THIS EXISTS
*!
*! `dash serve' accepted three options -- port(), nobrowser(), timeout() --
*! and wrote a master JSON whose build_options were literal constants:
*!
*!     "layout":"auto","link":"","filter":"","theme":"","title":"","subtitle":""
*!
*! with no scheme, tabs or filter_position key at all.  So no build option
*! could be supplied and none was inherited.  `dash serve' could therefore
*! never create a filter widget -- the one capability the live server is sold
*! on, since it is what recomputes aggregates -- and dash.sthlp's own example
*!
*!     . dash build, saving(dashboard.html) filter(foreign, type(dropdown)) replace
*!     . * -- or launch live server (filter recomputes aggregates) --
*!     . dash serve, port(5006)
*!
*! documented the bug: the served dashboard had no filter in it.
*!
*! The launch itself is not exercised here (a cscript must not start a server
*! or block).  _dash_serve_spec is everything `dash serve' does except the
*! launch: parse, validate, collect variables, assemble and write the master
*! JSON.  Asserting on the JSON it writes tests the whole path that was
*! broken.

cscript "dash serve options" adodir ".."
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}


// _dash_serve_spec is internal to dash.ado; loading the file defines it.
qui run "../dash.ado"

do "cert_helpers.do"

// ---------------------------------------------------------------
// 1. Options given on dash serve reach build_options
// ---------------------------------------------------------------
sysuse auto, clear
dash clear
dash scatter mpg weight, name(s1)

tempfile mj1 dj1
_dash_serve_spec, specpath("`mj1'") datapath("`dj1'") port(5006) timeout(0) ///
    title("Live") subtitle("Sub") layout(1 1) scheme(economist) ///
    tabs("Main: s1") filterposition(left) ///
    filter(foreign, type(dropdown) label("Origin"))

local mj "`r(master_json_path)'"
local dj "`r(data_json_path)'"
capture confirm file "`mj'"
assert _rc == 0

cert_file_has "`mj'", needle(`""filter":"foreign"')
assert r(found) == 1
cert_file_has "`mj'", needle(`""title":"Live""')
assert r(found) == 1
cert_file_has "`mj'", needle(`""subtitle":"Sub""')
assert r(found) == 1
cert_file_has "`mj'", needle(`""scheme":"economist""')
assert r(found) == 1
cert_file_has "`mj'", needle(`""layout":"1 1""')
assert r(found) == 1
cert_file_has "`mj'", needle(`""filter_position":"left""')
assert r(found) == 1
cert_file_has "`mj'", needle("Main: s1")
assert r(found) == 1
// The label() the user wrote must survive into the filter spec.
cert_file_has "`mj'", needle("Origin")
assert r(found) == 1

display as result "  [1/5] dash serve options reach build_options: PASS"

// ---------------------------------------------------------------
// 2. A filter variable named only in filter() is serialized
//    (without this the widget renders and then filters nothing)
// ---------------------------------------------------------------
cert_file_has "`dj'", needle("foreign")
assert r(found) == 1

display as result "  [2/5] filter-only variable is serialized: PASS"

// ---------------------------------------------------------------
// 3. dash serve inherits the preceding dash build's options
//    -- this is exactly the sequence dash.sthlp documents
// ---------------------------------------------------------------
sysuse auto, clear
dash clear
dash scatter mpg weight, name(s1)
tempfile built
dash build, saving("`built'.html") replace nobrowser ///
    title("Inherited") filter(foreign, type(dropdown))

tempfile mj2f dj2f
_dash_serve_spec, specpath("`mj2f'") datapath("`dj2f'") port(5006) timeout(0)

local mj2 "`r(master_json_path)'"
cert_file_has "`mj2'", needle(`""filter":"foreign"')
assert r(found) == 1
cert_file_has "`mj2'", needle(`""title":"Inherited""')
assert r(found) == 1

display as result "  [3/5] dash serve inherits the prior build's options: PASS"

// ---------------------------------------------------------------
// 4. An explicit option on dash serve overrides the inherited one
// ---------------------------------------------------------------
tempfile mj3f dj3f
_dash_serve_spec, specpath("`mj3f'") datapath("`dj3f'") port(5006) timeout(0) title("Override")

local mj3 "`r(master_json_path)'"
cert_file_has "`mj3'", needle(`""title":"Override""')
assert r(found) == 1
cert_file_has "`mj3'", needle(`""title":"Inherited""')
assert r(found) == 0
// ...while an option NOT given is still inherited.
cert_file_has "`mj3'", needle(`""filter":"foreign"')
assert r(found) == 1

display as result "  [4/5] explicit option overrides inherited: PASS"

// ---------------------------------------------------------------
// 5. dash serve validates what dash build validates
// ---------------------------------------------------------------
sysuse auto, clear
dash clear
dash scatter mpg weight, name(s1)

tempfile mj4 dj4
capture _dash_serve_spec, specpath("`mj4'") datapath("`dj4'") layout(0 0)
assert _rc == 198
capture _dash_serve_spec, specpath("`mj4'") datapath("`dj4'") filterposition(sideways)
assert _rc == 198
capture _dash_serve_spec, specpath("`mj4'") datapath("`dj4'") link(no_such_graph)
assert _rc == 198
capture _dash_serve_spec, specpath("`mj4'") datapath("`dj4'") filter(no_such_var, type(dropdown))
assert _rc == 111

display as result "  [5/5] dash serve validates like dash build: PASS"

// ---------------------------------------------------------------
// 6. link() and theme() given on dash serve reach build_options
//    -- the two of test_serve_options.py's eight "could not reach the
//    server" options that [1/5] does not give.  That pytest file only
//    finds them in _dash_prepare_spec's syntax block; this runs them.
// ---------------------------------------------------------------
sysuse auto, clear
dash clear
dash scatter mpg weight, name(s1)
dash scatter price weight, name(s2)
tempfile mj6 dj6
_dash_serve_spec, specpath("`mj6'") datapath("`dj6'") port(5006) timeout(0) ///
    link(s1 s2) theme(dark)
local mj "`r(master_json_path)'"
cert_file_has "`mj'", needle(`""link":"s1 s2""')
assert r(found) == 1
cert_file_has "`mj'", needle(`""theme":"dark""')
assert r(found) == 1

display as result "  [6/7] link() and theme() on dash serve reach build_options: PASS"

// ---------------------------------------------------------------
// 7. Every option dash build takes, given to dash serve at once, is
//    accepted, and each dashboard option reaches the served spec.  And
//    dash build takes the same list.  test_serve_options.py holds the two
//    option lists equal by reading them out of dash.ado; this is the
//    behaviour that equality is for -- an option one command took and the
//    other did not was r(198) "option ... not allowed" on the other.  (The
//    note naming saving(), replace and server as build-only on dash serve
//    is test_help_claims_2.cscript HC2-25c.)
// ---------------------------------------------------------------
tempfile mj7 dj7 h7
local _tl `"Main: s1 s2"'
capture noisily _dash_serve_spec, specpath("`mj7'") datapath("`dj7'") ///
    port(5006) timeout(0) saving("`h7'.html") replace server ///
    title("T7") subtitle("S7") layout(1 2) link(s1 s2) theme(dark) ///
    scheme(economist) tabs(`"`_tl'"') filterposition(left) csv ///
    filter(foreign, type(dropdown))
assert _rc == 0
local mj "`r(master_json_path)'"
foreach nd in `""title":"T7""' `""subtitle":"S7""' `""layout":"1 2""' ///
        `""link":"s1 s2""' `""theme":"dark""' `""scheme":"economist""' ///
        `""filter_position":"left""' `""csv":"1""' `""filter":"foreign"' {
    cert_file_has "`mj'", needle(`"`nd'"')
    if r(found) != 1 display as error `"  not in the served spec: `nd'"'
    assert r(found) == 1
}
cert_file_has "`mj'", needle("Main: s1 s2")
assert r(found) == 1
capture erase "`h7'.html"
capture noisily dash build, saving("`h7'.html") replace nobrowser ///
    title("T7") subtitle("S7") layout(1 2) link(s1 s2) theme(dark) ///
    scheme(economist) tabs(`"`_tl'"') filterposition(left) csv ///
    filter(foreign, type(dropdown))
assert _rc == 0
confirm file "`h7'.html"
capture erase "`h7'.html"

display as result "  [7/7] dash serve and dash build take every build option: PASS"

// MS: maxsessions() and idletimeout() (WP-30 P1.31a)
// ---------------------------------------------------------------
// dash serve's open-session cap and idle close: digits only, bounded,
// refused r(198) in the words of TR-46.14 and echoed as typed; the
// returns are plain integers, empty when not given.
// ---------------------------------------------------------------
sysuse auto, clear
dash clear
dash scatter mpg weight, name(s1)
tempfile mjm djm
local _msfail 0
// MS-01
capture _dash_serve_spec, specpath("`mjm'") datapath("`djm'") maxsessions(3) idletimeout(5)
local _ok = _rc == 0
if `_ok' local _ok = "`r(maxsessions)'" == "3" & "`r(idletimeout)'" == "5"
display as result "MS-01 " cond(`_ok', "PASS", "FAIL") ": maxsessions(3) idletimeout(5) return 3 and 5"
if !`_ok' local ++_msfail
// MS-02
local _ok 1
foreach v in 0 -1 1e3 3.5 1000001 12345678901 {
    capture noisily _dash_serve_spec, specpath("`mjm'") datapath("`djm'") maxsessions(`v')
    if _rc != 198 local _ok 0
}
display as result "MS-02 " cond(`_ok', "PASS", "FAIL") ": a cap out of 1..1,000,000 or not digits is r(198)"
if !`_ok' local ++_msfail
// MS-03
local _ok 1
local _nl = "3" + char(10)
capture _dash_serve_spec, specpath("`mjm'") datapath("`djm'") maxsessions(`_nl')
if _rc != 198 local _ok 0
local _long = "9" * 400
capture _dash_serve_spec, specpath("`mjm'") datapath("`djm'") maxsessions(`_long')
if _rc != 198 local _ok 0
display as result "MS-03 " cond(`_ok', "PASS", "FAIL") ": a newline or 400 digits is r(198)"
if !`_ok' local ++_msfail
// MS-04
capture _dash_serve_spec, specpath("`mjm'") datapath("`djm'") idletimeout(0)
local _ok = _rc == 0
if `_ok' local _ok = "`r(idletimeout)'" == "0"
foreach v in 525601 -1 5m {
    capture _dash_serve_spec, specpath("`mjm'") datapath("`djm'") idletimeout(`v')
    if _rc != 198 local _ok 0
}
display as result "MS-04 " cond(`_ok', "PASS", "FAIL") ": idletimeout(0) is never; 525601, -1 and 5m are r(198)"
if !`_ok' local ++_msfail
// MS-05
capture _dash_serve_spec, specpath("`mjm'") datapath("`djm'") maxsessions(007)
local _ok = _rc == 0
if `_ok' local _ok = "`r(maxsessions)'" == "7"
display as result "MS-05 " cond(`_ok', "PASS", "FAIL") ": maxsessions(007) returns 7"
if !`_ok' local ++_msfail
// MS-06
capture _dash_serve_spec, specpath("`mjm'") datapath("`djm'") port(5006)
local _ok = _rc == 0 & "`r(maxsessions)'" == "" & "`r(idletimeout)'" == ""
display as result "MS-06 " cond(`_ok', "PASS", "FAIL") ": neither given, both returns are empty"
if !`_ok' local ++_msfail
// MS-07 (guard): not an abbreviation dash serve owns
capture _dash_serve_spec, specpath("`mjm'") datapath("`djm'") maxs(3)
local _ok = _rc == 198
display as result "MS-07 " cond(`_ok', "PASS", "FAIL") ": maxs(3) is refused as an unknown option"
if !`_ok' local ++_msfail
// MS-08
tempfile msapp mslog
quietly graph drop _all
log using "`mslog'.log", text replace name(_ms08)
capture noisily dash build, server saving("`msapp'.py") replace
log close _ms08
cert_file_has "`mslog'.log", needle("--max-sessions N  --idle-timeout MINUTES")
local _ok = r(found) == 1
display as result "MS-08 " cond(`_ok', "PASS", "FAIL") ": dash build, server lists --max-sessions and --idle-timeout"
if !`_ok' local ++_msfail
capture erase "`msapp'.py"
capture erase "`mslog'.log"
assert `_msfail' == 0

dash clear
display as result "test_serve_options.cscript: ALL PASS"
