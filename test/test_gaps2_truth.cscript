*! test_gaps2_truth.cscript
*! WP-28's ONE new certification script (review D11): every comparison
*! with twoway's drawing or with Stata's own values that WP-28 needs lives
*! here, one block per section, so the certification suite grows by one
*! script and about five minutes (DISCOVERY Q28), not by nine.  Refusal,
*! message and return-code checks join the EXISTING script for their area
*! instead (sections/index.md rule R1); this script never gains one of
*! those.
*!
*! Blocks, in section order (extended by each later section that lands one):
*!   S02  helper smoke: the cert_svg programs (SH-01..SH-08)
*!   S05  GAPS2 C2, histogram edge rule: dash's bars against
*!        twoway__histogram_gen live (HE-05..HE-06)
*!   S13  textbox grammar: B3, B6, B7 (TBG-01..TBG-06)
*!
*! Usage: via run_all_cscripts.do (registered as its last block).  One
*! block alone: set GAPS2_ONLY=S<NN> in the environment of the driver run
*! ("sections/BRIEF.md" "Running one cscript").

cscript "GAPS2 truth: twoway comparisons" adodir ".."

clear all
set more off

if `"`c(python_exec)'"' == "" {
    display as error "SKIP: Python not available."
    exit 222
}

do "cert_helpers.do"
quietly do "cert_svg.do"
qui do "../dash_parse.mata"
qui do "../dash.ado"
global dash_nobrowser 1

// ----------------------------------------------------------------
// Tally helpers -- the _cs_expect/_cs_done pattern of
// test_custom_scheme.cscript:218-247, renamed _gt_ for this script.
// ----------------------------------------------------------------
global gt_nfail    = 0
global gt_faillist ""
global gt_bad      = 0

capture program drop _gt_expect
program define _gt_expect
    version 16.0
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global gt_bad = 1
    }
end

capture program drop _gt_done
program define _gt_done
    version 16.0
    args id msg
    if ${gt_bad} {
        global gt_nfail    = ${gt_nfail} + 1
        global gt_faillist "${gt_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global gt_bad = 0
end

local gt_work "`c(tmpdir)'dash_gt_work"
capture mkdir "`gt_work'"

* ==== S02 helper smoke: the cert_svg programs ====
local only : env GAPS2_ONLY
if inlist("`only'", "", "S02") {
    display as text "S02 start `c(current_time)'"

    // ------------------------------------------------------------
    // SH-01: cert_svg_export
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(sh1, replace)
    cert_svg_export, name(sh1) file("`gt_work'/sh1.svg")
    local sh1_rc   = r(rc)
    local sh1_file "`r(file)'"
    _gt_expect SH-01 "(`sh1_rc' == 0)" "cert_svg_export rc `sh1_rc'"
    capture confirm file "`sh1_file'"
    _gt_expect SH-01 "(_rc == 0)" "r(file) `sh1_file' does not exist"
    // cert_file_has/cert_log_has/cert_file_count take their path through
    // `anything(name=fpath)', not an option -- TRAP (measured 25sep2026,
    // scratchpad probe_cfh.do): passed the compound-quote form `` `"`x'"' ``
    // as this positional argument, `fpath' comes back EMPTY inside the
    // program and it fails "cannot open " with no name at all, even though
    // the caller's own macro was never empty.  cert_helpers.do's own usage
    // comment shows the plain form (`cert_file_has "`outpath'", needle(...)'`
    // ), which is the only form used below.
    cert_file_has "`sh1_file'", needle("<svg")
    _gt_expect SH-01 "(r(found) == 1)" "`sh1_file' does not open with <svg"
    _gt_done SH-01 "cert_svg_export wrote a readable SVG and returned rc 0"

    // ------------------------------------------------------------
    // SH-02: cert_svg_texts
    // ------------------------------------------------------------
    cert_svg_texts, file("`sh1_file'")
    local sh2_n    = r(n)
    local sh2_list "`r(list)'"
    local sh2_max  = r(maxsize)
    local sh2_min  = r(minsize)
    _gt_expect SH-02 "(`sh2_n' > 0)" "cert_svg_texts found no <text> elements"
    capture confirm file "`sh2_list'"
    _gt_expect SH-02 "(_rc == 0)" "r(list) `sh2_list' does not exist"
    // One JSON `"text":' key per line (sort_keys puts it in every record):
    // a needle built from char(34) avoids embedding a literal quote in the
    // source.  TRAP (measured 25sep2026, scratchpad probe_cfc*.do): pass
    // it through the COMPOUND quote `` needle(`"`sh2_needle'"') '' -- a
    // plain `needle("`sh2_needle'")' lets the needle's OWN embedded quote
    // close the option's string early (`needle(""text":")' parses as an
    // empty value followed by garbage), so the search silently runs
    // against the wrong text and finds nothing, with no error at all (an
    // empty needle() is refused outright as "option needle() required" --
    // this is not that; it is a different, silent failure).
    local sh2_needle = char(34) + "text" + char(34) + ":"
    cert_file_count "`sh2_list'", needle(`"`sh2_needle'"')
    local sh2_lines = r(count)
    _gt_expect SH-02 "(`sh2_lines' == `sh2_n')" "the list has `sh2_lines' lines but r(n) is `sh2_n'"
    _gt_expect SH-02 "(`sh2_max' >= `sh2_min')" "maxsize `sh2_max' < minsize `sh2_min'"
    _gt_expect SH-02 "(`sh2_min' > 0)" "minsize `sh2_min' is not positive"
    _gt_done SH-02 "cert_svg_texts read `sh2_n' text elements, sizes `sh2_min' to `sh2_max'"

    // ------------------------------------------------------------
    // SH-03: cert_svg_has_text (the nbsp case)
    // ------------------------------------------------------------
    quietly twoway scatter mpg weight, title("a  b") name(sh3, replace)
    cert_svg_export, name(sh3) file("`gt_work'/sh3.svg")
    local sh3_file "`r(file)'"
    cert_svg_has_text, file("`sh3_file'") text("a  b")
    local sh3_found2sp = r(found)
    local sh3_count2sp = r(count)
    cert_svg_has_text, file("`sh3_file'") text("a b")
    local sh3_found1sp = r(found)
    cert_svg_has_text, file("`sh3_file'") text("A  B") lower
    local sh3_foundlow = r(found)
    _gt_expect SH-03 "(`sh3_found2sp' == 1)" "the two-space title was not found"
    _gt_expect SH-03 "(`sh3_count2sp' == 1)" "r(count) `sh3_count2sp' != 1"
    _gt_expect SH-03 "(`sh3_found1sp' == 0)" "a one-space title matched the two-space one"
    _gt_expect SH-03 "(`sh3_foundlow' == 1)" "the case-insensitive match failed"
    _gt_done SH-03 "cert_svg_has_text told a real space from Stata's nbsp"

    // ------------------------------------------------------------
    // SH-04: cert_svg_fills, markers
    // ------------------------------------------------------------
    quietly twoway scatter mpg weight, mcolor(red) name(sh4, replace)
    cert_svg_export, name(sh4) file("`gt_work'/sh4.svg")
    local sh4_file "`r(file)'"
    cert_svg_fills, file("`sh4_file'") markers
    local sh4_colours `"`r(colours)'"'
    local sh4_list     "`r(list)'"
    _gt_expect SH-04 `"(strpos(`"`sh4_colours'"', "#ff0000") > 0)"' "r(colours) [`sh4_colours'] does not hold #ff0000"
    // A literal tab typed in the source does not survive as a tab through
    // a plain-quoted option value (measured 25sep2026): build it with
    // char(9) and pass it through the same compound-quote form as SH-02.
    local sh4_needle = "#ff0000" + char(9) + "74"
    cert_file_has "`sh4_list'", needle(`"`sh4_needle'"')
    _gt_expect SH-04 "(r(found) == 1)" "#ff0000 does not have n=74 in r(list)"
    _gt_done SH-04 "cert_svg_fills, markers counted every one of the 74 cars"

    // ------------------------------------------------------------
    // SH-05: cert_svg_extent, axis(y) on the smoke command
    // ------------------------------------------------------------
    quietly twoway (scatter mpg weight if foreign == 0) ///
                   (scatter mpg weight if foreign == 1), ///
        title("Smoke  title") ytitle("Miles per gallon") ///
        legend(order(1 "Domestic cars" 2 "Foreign cars")) ///
        yscale(range(0 60)) name(sh5, replace)
    cert_svg_export, name(sh5) file("`gt_work'/sh5.svg")
    local sh5_file "`r(file)'"
    cert_svg_extent, file("`sh5_file'") axis(y)
    local sh5_low  = r(low)
    local sh5_high = r(high)
    _gt_expect SH-05 "(`sh5_low' <= 0)" "y_extent low `sh5_low' is above 0"
    _gt_expect SH-05 "(`sh5_high' >= 60)" "y_extent high `sh5_high' is below 60"
    _gt_done SH-05 "cert_svg_extent, axis(y) covered the drawn range 0 60 (the same command extract_svg_truth_smoke.do measures)"

    // ------------------------------------------------------------
    // SH-06: cert_svg_extent, axis(x) values()
    // ------------------------------------------------------------
    quietly twoway scatter mpg weight, xlabel(2000 "low" 4000 "high") name(sh6, replace)
    cert_svg_export, name(sh6) file("`gt_work'/sh6.svg")
    local sh6_file "`r(file)'"
    cert_svg_extent, file("`sh6_file'") axis(x) values(1 2)
    local sh6_low_v = r(low)
    _gt_expect SH-06 "(!missing(`sh6_low_v'))" "cert_svg_extent with values() returned missing"
    cert_svg_extent, file("`sh6_file'") axis(x)
    local sh6_low_nov = r(low)
    local sh6_reason  "`r(reason)'"
    _gt_expect SH-06 "(missing(`sh6_low_nov'))" "cert_svg_extent without values() fitted text labels it should not have"
    _gt_expect SH-06 `"(`"`sh6_reason'"' != "")"' "no r(reason) was set for the unfitted case"
    _gt_done SH-06 "values() fits text tick labels; without it the fit is refused with a reason"

    // ------------------------------------------------------------
    // SH-07: cert_graph_scale
    // ------------------------------------------------------------
    cert_graph_scale, axis(y) name(sh5)
    local sh7_curmin = r(curmin)
    local sh7_curmax = r(curmax)
    _gt_expect SH-07 "(!missing(`sh7_curmin') | !missing(`sh7_curmax'))" "cert_graph_scale returned every member missing on a drawn graph"
    _gt_done SH-07 "cert_graph_scale read .sh5's scale members"

    // ------------------------------------------------------------
    // SH-08: r() is clobbered; a missing file is r(603)
    // ------------------------------------------------------------
    quietly summarize mpg
    local sh8_mean_before = r(mean)
    cert_svg_texts, file("`sh1_file'")
    _gt_expect SH-08 "(missing(r(mean)))" "r(mean) survived a call to cert_svg_texts"
    capture cert_svg_texts, file("`gt_work'/no_such_file.svg")
    _gt_expect SH-08 "(_rc == 603)" "a missing file did not return 603"
    capture cert_svg_has_text, file("`gt_work'/no_such_file.svg") text("x")
    _gt_expect SH-08 "(_rc == 603)" "a missing file did not return 603 (has_text)"
    capture cert_svg_fills, file("`gt_work'/no_such_file.svg")
    _gt_expect SH-08 "(_rc == 603)" "a missing file did not return 603 (fills)"
    capture cert_svg_extent, file("`gt_work'/no_such_file.svg") axis(y)
    _gt_expect SH-08 "(_rc == 603)" "a missing file did not return 603 (extent)"
    _gt_done SH-08 "cert_svg_* clobber r() like cert_file_has and refuse a missing file with 603"

    graph drop _all
    display as text "S02 end `c(current_time)'"
}
* ==== end S02 ====

* ==== S05 C2: histogram bars against twoway__histogram_gen ====
local only : env GAPS2_ONLY
if inlist("`only'", "", "S05") {
    display as text "S05 start `c(current_time)'"

    // Reads the page's one histogram ColumnDataSource (Document.from_json,
    // as test_e2e_kpi.cscript and test_adversarial.cscript P2-78 already
    // read a saved page's document back), and sets, as GLOBALS for the
    // caller (read into locals immediately, then dropped):
    //   `p'_sum   the sum of every bar (dash's own count)
    //   `p'_right the last right edge dash drew
    //   `p'_tops  every bar height, in left-to-right order, space-separated
    python:
import json, re
from sfi import Macro
from bokeh.document import Document
from bokeh.models import ColumnDataSource


def _he5_unescape(text):
    ents = {"amp": "&", "lt": "<", "gt": ">", "quot": chr(34),
            "#x27": chr(39), "#x60": chr(96)}
    return re.sub(r"&(amp|lt|gt|quot|#x27|#x60);",
                  lambda m: ents[m.group(1)], text)


def _he5_read(path, p):
    with open(path, encoding="utf-8") as fh:
        page = fh.read()
    blocks = re.findall(
        r'<script type="application/json" id="[^"]+">\s*(.*?)\s*</script>',
        page, re.S)
    docs = [d for b in blocks
            for d in json.loads(_he5_unescape(b)).values()]
    if len(docs) != 1:
        raise RuntimeError("%s holds %d Bokeh documents" % (path, len(docs)))
    doc = Document.from_json(docs[0])
    for m in doc.models:
        if isinstance(m, ColumnDataSource) and "left" in m.data:
            tops = [float(v) for v in m.data["top"]]
            right = [float(v) for v in m.data["right"]]
            Macro.setGlobal(p + "_sum", str(int(round(sum(tops)))))
            Macro.setGlobal(p + "_right", repr(right[-1]))
            Macro.setGlobal(p + "_tops", " ".join(repr(v) for v in tops))
            return
    raise RuntimeError("%s: no histogram source found" % path)

end

    // ------------------------------------------------------------
    // HE-05: nlsw88 ttl_exp bin(27) -- the case GAPS2 measured at 2245 of
    // 2246 -- against twoway__histogram_gen run live, bar for bar.
    // ------------------------------------------------------------
    capture dash clear
    sysuse nlsw88, clear
    twoway__histogram_gen ttl_exp, generate(zqh zqx) return frequency bin(27)
    local he5_bin = r(bin)
    local he5_max = r(max)
    quietly summarize zqh, meanonly
    local he5_gensum = r(sum)
    _gt_expect HE-05 "(`he5_gensum' == 2246)" "twoway__histogram_gen's own bars sum to `he5_gensum', not 2246"

    tempfile he5file
    local he5path = "`he5file'.html"
    capture erase "`he5path'"
    capture noisily dash histogram ttl_exp, bin(27) frequency saving("`he5path'", replace)
    local he5rc = _rc
    _gt_expect HE-05 "(`he5rc' == 0)" "dash histogram ttl_exp, bin(27) frequency refused: rc `he5rc'"

    python: _he5_read(Macro.getLocal("he5path"), "he5")
    local he5_pagesum   = ${he5_sum}
    local he5_pageright = ${he5_right}
    local he5_tops_str  "${he5_tops}"
    macro drop he5_sum he5_right he5_tops
    _gt_expect HE-05 "(`he5_pagesum' == 2246)" "dash's page sums to `he5_pagesum', not 2246"
    _gt_expect HE-05 "(reldif(`he5_pageright', `he5_max') < 1e-9)" "dash's last right edge `he5_pageright' != twoway's r(max) `he5_max'"

    // generate() writes a row only for a POPULATED bin (twoway's own
    // convention, the same one test_statistical_truth.py's
    // TestHistogramAgainstStata compares against: "Stata reports only
    // the non-empty bins").  dash's page draws all `bin' bars, zero
    // height included, so both sides are reduced to their non-empty
    // bins, in ascending order, before the bar-for-bar comparison.  A
    // Mata one-liner per statement; values handed back to Stata through
    // st_local (test_adversarial.cscript's own idiom).
    mata: _he5_zh    = st_data(., "zqh")
    mata: _he5_zx    = st_data(., "zqx")
    mata: _he5_keep  = selectindex(_he5_zx :< .)
    mata: _he5_ord   = order(_he5_zx[_he5_keep], 1)
    mata: _he5_gen   = _he5_zh[_he5_keep][_he5_ord]
    mata: _he5_pageall = strtoreal(tokens(st_local("he5_tops_str")))'
    mata: _he5_page  = select(_he5_pageall, _he5_pageall :> 0)
    mata: st_local("he5_n_bars", strofreal(rows(_he5_pageall)))
    mata: st_local("he5_n_gen", strofreal(rows(_he5_gen)))
    mata: st_local("he5_n_page", strofreal(rows(_he5_page)))
    mata: st_local("he5_same", strofreal((rows(_he5_gen) == rows(_he5_page) & rows(_he5_gen) > 0) * (max(abs(_he5_gen - _he5_page)) < 1e-6)))
    mata: mata drop _he5_zh _he5_zx _he5_keep _he5_ord _he5_gen _he5_pageall _he5_page
    _gt_expect HE-05 "(`he5_n_bars' == `he5_bin')" "dash drew `he5_n_bars' bars, not the `he5_bin' bin(27) asked for"
    _gt_expect HE-05 "(`he5_n_gen' == `he5_n_page')" "dash drew `he5_n_page' non-empty bars, twoway__histogram_gen `he5_n_gen'"
    _gt_expect HE-05 "(`he5_same' == 1)" "dash's bars do not equal twoway__histogram_gen's, bar for bar"
    _gt_done HE-05 "nlsw88 ttl_exp bin(27): dash's 27 bars sum to 2246 and equal twoway__histogram_gen's, bar for bar"

    // ------------------------------------------------------------
    // HE-06: census pop bin(75) -- 49 of 50 before the fix.
    // ------------------------------------------------------------
    dash clear
    sysuse census, clear
    twoway__histogram_gen pop, generate(zqh zqx) return frequency bin(75)
    local he6_bin = r(bin)
    local he6_max = r(max)
    quietly summarize zqh, meanonly
    local he6_gensum = r(sum)
    _gt_expect HE-06 "(`he6_gensum' == 50)" "twoway__histogram_gen's own bars sum to `he6_gensum', not 50"

    tempfile he6file
    local he6path = "`he6file'.html"
    capture erase "`he6path'"
    capture noisily dash histogram pop, bin(75) frequency saving("`he6path'", replace)
    local he6rc = _rc
    _gt_expect HE-06 "(`he6rc' == 0)" "dash histogram pop, bin(75) frequency refused: rc `he6rc'"

    python: _he5_read(Macro.getLocal("he6path"), "he6")
    local he6_pagesum   = ${he6_sum}
    local he6_pageright = ${he6_right}
    local he6_tops_str  "${he6_tops}"
    macro drop he6_sum he6_right he6_tops
    _gt_expect HE-06 "(`he6_pagesum' == 50)" "dash's page sums to `he6_pagesum', not 50"
    _gt_expect HE-06 "(reldif(`he6_pageright', `he6_max') < 1e-9)" "dash's last right edge `he6_pageright' != twoway's r(max) `he6_max'"

    // generate() writes a row only for a populated bin -- see HE-05's
    // comment; census pop bin(75) over 50 observations leaves most bins
    // empty, so both sides are reduced to their non-empty bins first.
    mata: _he6_zh    = st_data(., "zqh")
    mata: _he6_zx    = st_data(., "zqx")
    mata: _he6_keep  = selectindex(_he6_zx :< .)
    mata: _he6_ord   = order(_he6_zx[_he6_keep], 1)
    mata: _he6_gen   = _he6_zh[_he6_keep][_he6_ord]
    mata: _he6_pageall = strtoreal(tokens(st_local("he6_tops_str")))'
    mata: _he6_page  = select(_he6_pageall, _he6_pageall :> 0)
    mata: st_local("he6_n_bars", strofreal(rows(_he6_pageall)))
    mata: st_local("he6_n_gen", strofreal(rows(_he6_gen)))
    mata: st_local("he6_n_page", strofreal(rows(_he6_page)))
    mata: st_local("he6_same", strofreal((rows(_he6_gen) == rows(_he6_page) & rows(_he6_gen) > 0) * (max(abs(_he6_gen - _he6_page)) < 1e-6)))
    mata: mata drop _he6_zh _he6_zx _he6_keep _he6_ord _he6_gen _he6_pageall _he6_page
    _gt_expect HE-06 "(`he6_n_bars' == `he6_bin')" "dash drew `he6_n_bars' bars, not the `he6_bin' bin(75) asked for"
    _gt_expect HE-06 "(`he6_n_gen' == `he6_n_page')" "dash drew `he6_n_page' non-empty bars, twoway__histogram_gen `he6_n_gen'"
    _gt_expect HE-06 "(`he6_same' == 1)" "dash's bars do not equal twoway__histogram_gen's, bar for bar"
    _gt_done HE-06 "census pop bin(75): dash's 75 bars sum to 50 and equal twoway__histogram_gen's, bar for bar"

    capture drop zqh zqx
    graph drop _all
    dash clear
    display as text "S05 end `c(current_time)'"
}
* ==== end S05 ====

* ==== S13 B3 B6 B7: textbox grammar ====
// Helpers, reached through __main__ (cert_svg.do's TRAP note):
//   _tbg_spec()   TBG_OUT: the stored graph_options key TBG_KEY of the
//                 graph whose spec is in global dash_json_<TBG_G>,
//                 "<absent>" when there is no such key
//   _tbg_axes()   TBG_OUT: "range_name=label|..." for every axis model
//                 of the saved page TBG_PAGE, sorted
//   _tbg_title()  TBG_OUT: "text|colour" of the page's Title models
//   _tbg_textfill() TBG_OUT: the fill of <text> TBG_TXT in SVG TBG_SVG
python:
import json as _tbg_json, re as _tbg_re, html as _tbg_html
import __main__ as _tbg_main
from sfi import Macro as _tbg_M

def _tbg_models():
    try:
        with open(_tbg_M.getGlobal("TBG_PAGE"), encoding="utf-8") as fh:
            page = fh.read()
    except OSError:
        return {}
    m = _tbg_re.search('<script type="application/json"[^>]*>(.*?)</script>', page, _tbg_re.S)
    objs, stack = {}, ([_tbg_json.loads(_tbg_html.unescape(m.group(1)))] if m else [])
    while stack:
        v = stack.pop()
        if isinstance(v, dict):
            if v.get("type") == "object" and "id" in v and "name" in v:
                objs[v["id"]] = v
            stack.extend(v.values())
        elif isinstance(v, list):
            stack.extend(v)
    return objs

def _tbg_val(v):
    return v.get("value") if isinstance(v, dict) else v

def _tbg_spec():
    try:
        d = _tbg_json.loads(_tbg_M.getGlobal("dash_json_" + _tbg_M.getGlobal("TBG_G")))
        go = d.get("graph_options", d)
        v = go.get(_tbg_M.getGlobal("TBG_KEY"), "<absent>")
        v = "<absent>" if v in ("", None) else v
    except (ValueError, AttributeError, TypeError):
        v = "<unreadable>"
    _tbg_M.setGlobal("TBG_OUT", str(v))

def _tbg_axes():
    out = []
    for o in _tbg_models().values():
        if o["name"] in ("LinearAxis", "LogAxis"):
            a = o.get("attributes", {})
            rn = a.get("y_range_name", a.get("x_range_name", "default"))
            out.append("%s=%s" % (rn, _tbg_val(a.get("axis_label")) or ""))
    _tbg_M.setGlobal("TBG_OUT", "|".join(sorted(out)))

def _tbg_title():
    out = []
    for o in _tbg_models().values():
        if o["name"] == "Title":
            a = o.get("attributes", {})
            out.append("%s|%s" % (_tbg_val(a.get("text")) or "", _tbg_val(a.get("text_color")) or ""))
    _tbg_M.setGlobal("TBG_OUT", ";".join(sorted(out)))

_tbg_main._tbg_spec = _tbg_spec
_tbg_main._tbg_axes = _tbg_axes
def _tbg_textfill():
    # The fill of the <text> TBG_TXT in SVG TBG_SVG (a text's colour is a
    # style on the <text>, not a shape fill cert_svg_fills reads).
    import svg_truth
    fills = [t["fill"] for t in svg_truth.svg_texts(_tbg_M.getGlobal("TBG_SVG"))
             if t["text"] == _tbg_M.getGlobal("TBG_TXT")]
    _tbg_M.setGlobal("TBG_OUT", " ".join(str(f) for f in fills))

_tbg_main._tbg_title = _tbg_title
_tbg_main._tbg_textfill = _tbg_textfill
end

local only : env GAPS2_ONLY
if inlist("`only'", "", "S13") {
    display as text "S13 start `c(current_time)'"
    sysuse auto, clear
    capture dash clear
    tempfile tbg_page


    // ---- TBG-01: title("T", c(red)) ----
    quietly twoway scatter mpg weight, title("T", c(red)) name(tbg1, replace)
    cert_svg_export, name(tbg1) file("`gt_work'/tbg1.svg")
    local tbg_f "`r(file)'"
    cert_svg_has_text, file("`tbg_f'") text("T")
    local tbg_t = r(found)
    cert_svg_has_text, file("`tbg_f'") text("c(red)")
    local tbg_c = r(found)
    global TBG_SVG "`tbg_f'"
    global TBG_TXT "T"
    python: __import__("__main__")._tbg_textfill()
    local tbg_col "$TBG_OUT"
    capture noisily dash scatter mpg weight, title("T", c(red)) name(tbg1)
    local tbg_rc = _rc
    capture noisily dash build, saving("`tbg_page'.html") replace nobrowser
    global TBG_PAGE "`tbg_page'.html"
    python: __import__("__main__")._tbg_title()
    local tbg_dt "$TBG_OUT"
    display as text "  TBG-01 twoway T:`tbg_t' c(red):`tbg_c' fills:`tbg_col'  dash rc `tbg_rc' title `tbg_dt'"
    _gt_expect TBG-01 "(`tbg_t' == 1 & `tbg_c' == 0)" "twoway drew c(red) as text"
    _gt_expect TBG-01 `"(strpos("`tbg_col'", "#ff0000") > 0)"' "twoway drew no red"
    _gt_expect TBG-01 `"("`tbg_dt'" == "T|#ff0000" | "`tbg_dt'" == "T|red")"' "dash title `tbg_dt'"
    _gt_done TBG-01 "title(T, c(red)) is a red T in twoway and dash"
    capture dash clear

    // ---- TBG-02: ytitle("Volume", axis(2)) ----
    quietly twoway (scatter mpg weight) (line price weight, yaxis(2)), ytitle("Volume", axis(2)) name(tbg2, replace)
    cert_svg_export, name(tbg2) file("`gt_work'/tbg2.svg")
    cert_svg_has_text, file("`r(file)'") text("Volume")
    local tbg_v = r(found)
    capture noisily dash (scatter mpg weight) (line price weight, yaxis(2)), ytitle("Volume", axis(2)) name(tbg2)
    local tbg_rc = _rc
    global TBG_G "tbg2"
    global TBG_KEY "ytitle2"
    python: __import__("__main__")._tbg_spec()
    local tbg_s2 `"$TBG_OUT"'
    global TBG_KEY "ytitle"
    python: __import__("__main__")._tbg_spec()
    local tbg_s1 `"$TBG_OUT"'
    capture noisily dash build, saving("`tbg_page'.html") replace nobrowser
    python: __import__("__main__")._tbg_axes()
    local tbg_ax `"$TBG_OUT"'
    display as text `"  TBG-02 twoway Volume:`tbg_v'  rc `tbg_rc'  ytitle2 [`tbg_s2'] ytitle [`tbg_s1']  axes `tbg_ax'"'
    _gt_expect TBG-02 "(`tbg_v' == 1 & `tbg_rc' == 0)" "twoway or dash failed"
    _gt_expect TBG-02 `"(`"`tbg_s2'"' == `""Volume""' & "`tbg_s1'" == "<absent>")"' "spec not routed"
    _gt_expect TBG-02 `"(strpos(`"`tbg_ax'"', "y2=Volume") > 0 & strpos(`"`tbg_ax'"', "default=Mileage (mpg)") > 0)"' "axes `tbg_ax'"
    _gt_done TBG-02 "ytitle(Volume, axis(2)) titles the second axis"
    capture dash clear

    // ---- TBG-03: two copies, one on each axis (Mata route) ----
    capture noisily dash (scatter mpg weight) (line price weight, yaxis(2)), ytitle("Left") ytitle("Right", axis(2)) name(tbg3)
    local tbg_rc = _rc
    global TBG_G "tbg3"
    global TBG_KEY "ytitle"
    python: __import__("__main__")._tbg_spec()
    local tbg_s1 `"$TBG_OUT"'
    global TBG_KEY "ytitle2"
    python: __import__("__main__")._tbg_spec()
    local tbg_s2 `"$TBG_OUT"'
    display as text `"  TBG-03 rc `tbg_rc'  ytitle [`tbg_s1'] ytitle2 [`tbg_s2']"'
    _gt_expect TBG-03 `"(`tbg_rc' == 0 & `"`tbg_s1'"' == `""Left""' & `"`tbg_s2'"' == `""Right""')"' "copies folded"
    _gt_done TBG-03 "ytitle(Left) ytitle(Right, axis(2)) stores both titles"
    capture dash clear

    // ---- TBG-05: ytitle("extra", suffix) ----
    quietly twoway scatter mpg weight, ytitle("extra", suffix) name(tbg5, replace)
    cert_svg_export, name(tbg5) file("`gt_work'/tbg5.svg")
    local tbg_f "`r(file)'"
    cert_svg_has_text, file("`tbg_f'") text("Mileage (mpg)")
    local tbg_m = r(found)
    cert_svg_has_text, file("`tbg_f'") text("extra")
    local tbg_e = r(found)
    capture noisily dash scatter mpg weight, ytitle("extra", suffix) name(tbg5)
    capture noisily dash build, saving("`tbg_page'.html") replace nobrowser
    python: __import__("__main__")._tbg_axes()
    local tbg_ax `"$TBG_OUT"'
    display as text `"  TBG-05 twoway mpg:`tbg_m' extra:`tbg_e'  axes `tbg_ax'"'
    _gt_expect TBG-05 "(`tbg_m' == 1 & `tbg_e' == 1)" "twoway texts"
    _gt_expect TBG-05 `"(strpos(`"`tbg_ax'"', "default=Mileage (mpg)" + char(10) + "extra") > 0)"' "dash axes `tbg_ax'"
    _gt_done TBG-05 "a lone suffix adds its line after the default"
    capture dash clear

    // ---- TBG-06: hostile titles pass _dash_route_axis2 unchanged ----
    local tbg_ok 1
    capture noisily dash scatter mpg weight, title(`"'90s"') name(tbg6a)
    if _rc local tbg_ok 0
    capture noisily dash scatter mpg weight, title("cost $ x") name(tbg6b)
    if _rc local tbg_ok 0
    capture noisily dash scatter mpg weight, title("say axis(2) here") ytitle("say axis(2)") name(tbg6c)
    if _rc local tbg_ok 0
    global TBG_KEY "title"
    global TBG_G "tbg6a"
    python: __import__("__main__")._tbg_spec()
    local tbg_a `"$TBG_OUT"'
    global TBG_G "tbg6b"
    python: __import__("__main__")._tbg_spec()
    local tbg_b `"$TBG_OUT"'
    global TBG_G "tbg6c"
    python: __import__("__main__")._tbg_spec()
    local tbg_c `"$TBG_OUT"'
    global TBG_KEY "ytitle2"
    python: __import__("__main__")._tbg_spec()
    local tbg_d `"$TBG_OUT"'
    mata: st_local("tbg_ok", strofreal(`tbg_ok' & st_local("tbg_a") == char(96) + char(34) + char(39) + "90s" + char(34) + char(39) & st_local("tbg_b") == char(34) + "cost " + char(36) + " x" + char(34) & st_local("tbg_c") == char(34) + "say axis(2) here" + char(34) & st_local("tbg_d") == "<absent>"))
    _gt_expect TBG-06 "(`tbg_ok' == 1)" "a hostile title changed"
    _gt_done TBG-06 "hostile titles are stored as typed and never routed"
    capture dash clear
    capture erase "`tbg_page'.html"
    graph drop _all
    display as text "S13 end `c(current_time)'"
}
* ==== end S13 ====

* ==== append new blocks above this line ====

// ----------------------------------------------------------------
// Summary (the test_custom_scheme.cscript:553-572 shape)
// ----------------------------------------------------------------
capture graph drop _all
capture dash clear
local nfail    = ${gt_nfail}
local faillist "${gt_faillist}"
macro drop gt_nfail gt_faillist gt_bad
display as text ""
display as text "============================================================"
if `nfail' == 0 {
    display as text "  test_gaps2_truth: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_gaps2_truth: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
