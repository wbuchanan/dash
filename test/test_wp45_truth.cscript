*! test_wp45_truth.cscript
*! WP-45's ONE certification script (.ultraplan/sections/index.md PD-6):
*! every comparison with twoway's drawing or with Stata's own values that
*! WP-45's sections need lives here, one block per GAPS4 row (or per
*! harness tool), appended above the "append new blocks above this line"
*! marker in section order.  Refusal, message and return-code checks join
*! the EXISTING script for their area (merge rule R1).
*!
*! Made from test/templates/wp_truth_template.cscript (45 -> the WP's
*! number).  S00 is the scaffold smoke (Q4500-1).  A section appends
*! `* ==== S<MM> <lead id>: <what> ====` ... `* ==== end S<MM> ====` (or
*! `S<MM> tool: <what>` for a section with no item), its helper programs
*! directly above its first header, and writes only inside its own
*! blocks.  Case ids are Q45<MM>-<k> (PD-5).
*!
*! Usage: via run_all_cscripts.do.  One block alone: WP45_ONLY=S<MM> in
*! the driver's environment.  Each block prints "S<MM> start" and "S<MM>
*! end" with the date and time.  The suite runs it in every session;
*! DASH_CERT_SHARD=k/N runs part k of N of the blocks; a part with no
*! block ends 0.

cscript "WP-45 truth: twoway comparisons" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off


do "cert_helpers.do"
quietly do "cert_svg.do"
qui do "../dash_parse.mata"
qui do "../dash.ado"
global dash_nobrowser 1

// ----------------------------------------------------------------
// Tally helpers -- test_wp29_truth.cscript's _w29_expect/_w29_done,
// renamed _w45_ for this script.  A case is any number of
// _w45_expect lines closed by one _w45_done.
// ----------------------------------------------------------------
global w45_nfail    = 0
global w45_faillist ""
global w45_bad      = 0
global w45_ncase    = 0

capture program drop _w45_expect
program define _w45_expect
    version 19
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global w45_bad = 1
    }
end

capture program drop _w45_done
program define _w45_done
    version 19
    args id msg
    if ${w45_bad} {
        global w45_nfail    = ${w45_nfail} + 1
        global w45_faillist "${w45_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global w45_bad   = 0
    global w45_ncase = ${w45_ncase} + 1
end

// A fresh directory for this run's files, never one that already exists:
// a fixed name in a shared temp directory could be planted by another
// account (rule 1), so a name Stata has not handed out before is made and
// the run fails if it cannot be.  Every block writes only under it.
tempfile w45_base
local w45_work "`w45_base'_w45"
capture mkdir "`w45_work'"
if _rc {
    display as error "test_wp45_truth: cannot create the work directory `w45_work' (rc `=_rc')"
    exit 9
}

// ---- parts: begin (WP-45 test performance) ----
// The certification suite runs this script in every one of its sessions
// (its row in run_all_cscripts.do's shard table is "* * *"); with
// DASH_CERT_SHARD=k/N set, the session runs part k of N of the blocks.
// The parts are balanced longest first onto the least loaded part (the
// lowest numbered of equals), by the seconds below -- a block not listed
// counts 1 s (section-01 D-01.f) -- the rule scripts/cert_shards.py uses
// for the scripts.  Unset, or with WP45_ONLY set
// (which keeps its precedence), every block runs.  A block runs when its
// gate finds its id in w45_run.
// Seconds: each block's start/end lines in the WP's last measured
// certification run, rounded up, at least 1; a block not listed
// counts 1 s.
local w45_secs S00 1
local w45_sh : environment DASH_CERT_SHARD
mata: st_local("w45_ok", strofreal(st_local("w45_sh") == "" | ustrregexm(st_local("w45_sh"), "^[1-4]/[1-4]$")))
if !`w45_ok' {
    display as error "test_wp45_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 4"
    exit 198
}
local w45_k 1
local w45_N 1
if "`w45_sh'" != "" {
    local w45_k = real(substr("`w45_sh'", 1, 1))
    local w45_N = real(substr("`w45_sh'", 3, 1))
}
local w45_only : env WP45_ONLY
if `"`macval(w45_only)'"' != "" | `w45_N' == 1 {
    local w45_k 1
    local w45_N 1
}
if `w45_k' > `w45_N' {
    display as error "test_wp45_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 4"
    exit 198
}
capture confirm file "test_wp45_truth.cscript"
if _rc {
    display as error "test_wp45_truth: run it from test/, where it reads its own blocks"
    exit 601
}
capture mata: mata drop _w45_part()
mata:
// The ids of the blocks (their header lines, in file order), and those of
// part k of n: longest first onto the least loaded part.
void _w45_part(string scalar file, string scalar table, real scalar k,
               real scalar n)
{
    string colvector lines, ids
    string rowvector tok
    real colvector sec, o, at
    real rowvector load
    real scalar i, j, p, best
    string scalar run

    lines = cat(file)
    ids = J(0, 1, "")
    for (i = 1; i <= rows(lines); i++) {
        if (ustrregexm(lines[i], "^\* ==== (S[0-9]+) ")) {
            if (!anyof(ids, ustrregexs(1))) ids = ids \ ustrregexs(1)
        }
    }
    sec = J(rows(ids), 1, 1)
    tok = tokens(table)
    for (j = 1; j + 1 <= cols(tok); j = j + 2) {
        for (i = 1; i <= rows(ids); i++) {
            if (ids[i] == tok[j]) sec[i] = strtoreal(tok[j + 1])
        }
    }
    o = order((-sec, (1::rows(ids))), (1, 2))
    load = J(1, n, 0)
    at = J(rows(ids), 1, 0)
    for (i = 1; i <= rows(o); i++) {
        best = 1
        for (p = 2; p <= n; p++) if (load[p] < load[best]) best = p
        load[best] = load[best] + sec[o[i]]
        at[o[i]] = best
    }
    run = ""
    for (i = 1; i <= rows(ids); i++) if (at[i] == k) run = run + " " + ids[i]
    st_local("w45_run", strtrim(run))
}
end
mata: _w45_part("test_wp45_truth.cscript", st_local("w45_secs"), `w45_k', `w45_N')
display as text "test_wp45_truth: part `w45_k'/`w45_N' runs `: word count `w45_run'' blocks: `w45_run'"
// ---- parts: end ----

* ==== S00 scaffold: the helpers load and a twoway SVG is read ====
local only : env WP45_ONLY
if inlist("`only'", "", "S00") & `: list posof "S00" in w45_run' {
    display as text "S00 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4500-1: cert_svg_export and cert_svg_texts on one twoway scatter,
    // and dash's own programs are loaded from this tree.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(w45s01, replace)
    cert_svg_export, name(w45s01) file("`w45_work'/w45s01.svg")
    local s01_rc   = r(rc)
    local s01_file "`r(file)'"
    _w45_expect Q4500-1 "(`s01_rc' == 0)" "cert_svg_export rc `s01_rc'"
    capture confirm file "`s01_file'"
    _w45_expect Q4500-1 "(_rc == 0)" "r(file) `s01_file' does not exist"
    cert_svg_texts, file("`s01_file'")
    local s01_n    = r(n)
    local s01_list "`r(list)'"
    _w45_expect Q4500-1 "(`s01_n' > 0)" "cert_svg_texts found no text elements"
    capture program list _dash_serve
    _w45_expect Q4500-1 "(_rc == 0)" "dash.ado's _dash_serve is not loaded"
    _w45_done Q4500-1 "a twoway SVG was written and read (`s01_n' texts); dash is loaded"

    capture erase "`s01_file'"
    capture erase "`s01_list'"
    capture graph drop w45s01
    display as text "S00 end " c(current_date) " " c(current_time)
}
* ==== end S00 ====

// S02 ST-1 helpers: _q4502_rows writes style_words_truth.json's rows as a
// tab-separated file (class, site, word, canonical, twoway's rc, 1 when
// twoway printed a note) for the block to import; _q4502_saved reads one
// saved (DashRenderer) figure of a registered graph for Q4502-2's checks
// into the global q4502_got ("ok" or what was found).
python:
import os as _q4502_os, sys as _q4502_sys
if _q4502_os.path.abspath("..") not in _q4502_sys.path:
    _q4502_sys.path.insert(0, _q4502_os.path.abspath(".."))


def _q4502_rows(out):
    import json
    with open(_q4502_os.path.join("fixtures", "style_words_truth.json"),
              encoding="utf-8") as fh:
        rows = json.load(fh)["rows"]
    with open(out, "w", encoding="utf-8") as fh:
        fh.write("cls\tsite\tword\tcanon\ttwrc\ttwnote\n")
        for r in rows:
            fh.write("%s\t%s\t%s\t%s\t%d\t%d\n" % (
                r["class"], r["site"], r["word"], r["canonical"], r["rc"],
                1 if r["note"] else 0))


def _q4502_saved(sp, dp, what):
    import json
    import warnings
    from sfi import Macro
    import dash_render as dr
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
    f = list(r.figures.values())[0]
    got = "ok"
    if what == "title_below":
        on = [s for s in ("center", "above", "below", "left", "right")
              if any("title" in list(getattr(m, "tags", None) or [])
                     for m in getattr(f, s))]
        got = "ok" if on == ["below"] else "title on %s" % on
    elif what == "legend_in":
        on = [s for s in ("center", "above", "below", "left", "right")
              if any(type(m).__name__ == "Legend" for m in getattr(f, s))]
        got = "ok" if on == ["center"] else "legend on %s" % on
    elif what == "mlab_9":
        t = [m for m in f.center if type(m).__name__ == "LabelSet"]
        got = ("ok" if t and all(float(g.x_offset) < 0 and
                                 float(g.y_offset) == 0 for g in t)
               else "offsets %s" % [(g.x_offset, g.y_offset) for g in t])
    elif what == "stairstep":
        with open(sp, encoding="utf-8") as fh:
            spec = json.load(fh)
        cs = [(p.get("options") or {}).get("connect")
              for g in spec.get("graphs") or []
              for p in (g.get("plots") or [])]
        got = "ok" if cs == ["stairstep"] else "connect %s" % cs
    Macro.setGlobal("q4502_got", got)
end

// S02 ST-1 helper: _q4502_mata -- over the current frame's rows (cls,
// site, word, canon, twnote), the first rows where dash_parse.mata's
// _dash_style_word differs from the fixture, "" when none does.
capture mata: mata drop _q4502_mata()
mata:
string scalar _q4502_mata()
{
    string matrix D
    string scalar out, got, want
    real scalar   i, n

    D = st_sdata(., ("cls", "site", "word", "canon", "twnote"))
    out = ""
    n = 0
    for (i = 1; i <= rows(D); i++) {
        if (D[i, 1] == "horizontal") continue
        if (D[i, 1] == "gridringstyle" & D[i, 2] == "title") continue
        want = (D[i, 5] == "1" ? "" : D[i, 4])
        if (D[i, 5] == "0" & want == "") {
            out = out + " " + D[i, 1] + "/" + D[i, 3] + ": no canonical"
            n++
            continue
        }
        got = _dash_style_word(D[i, 1], D[i, 3])
        if (got != want) {
            n++
            if (n <= 20) out = out + " " + D[i, 1] + "/" + D[i, 3] + ": " +
                               got + " (want " + want + ")"
        }
    }
    return(strtrim(out))
}
end

* ==== S01 PIC-4: economist note painted ====
local only : env WP45_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w45_run' {
    display as text "S01 start " c(current_date) " " c(current_time)
    local q01 "`w45_work'/s01"
    capture mkdir "`q01'"
    global q4501_repo : env DASH_REPO
    if `"${q4501_repo}"' == "" global q4501_repo ".."

    // Q4501-1: twoway draws economist's note in a #7b92a8 box with white
    // text at the top right of the title's band; dash's saved and served
    // Label is a row of the above panel (BokehJS clips fig.center to the
    // frame, so a centre Label is never painted there), anchored top
    // right on the frame's right edge and the canvas's top, in twoway's
    // fill and text colour.  Chrome's pixels: test_economist_scheme.py
    // TestTheNoteIsPainted::test_pixels (release tier).
    _q4501_reg "`q01'" 1 "note" scatter mpg weight, title("T") note("The note") scheme(economist)
    _w45_expect Q4501-1 `"("${q4501_tw}" != "none")"' "twoway drew no #7b92a8 note box"
    _w45_expect Q4501-1 `"("${q4501_s}" == "${q4501_tw}")"' "saved: ${q4501_s}; twoway ${q4501_tw}"
    _w45_expect Q4501-1 `"("${q4501_v}" == "${q4501_tw}")"' "served: ${q4501_v}; twoway ${q4501_tw}"
    _w45_done Q4501-1 "the economist note: twoway ${q4501_tw}; saved and served the same"

    capture graph drop _all
    dash clear
    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====

* ==== S02 ST-1: style words read per class ====
local only : env WP45_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w45_run' {
    display as text "S02 start " c(current_date) " " c(current_time)
    local q2d "`w45_work'/s02"
    capture mkdir "`q2d'"
    capture graph drop _all
    capture frame drop q4502r
    python: _q4502_rows("`q2d'/rows.tsv")
    frame create q4502r
    frame q4502r: import delimited using "`q2d'/rows.tsv", delimiter(tab) varnames(1) stringcols(_all) clear
    frame q4502r: local q2n = _N
    sysuse auto, clear

    // The sites, as scripts/extract_style_words_truth.do draws them (@ the
    // word); a site dash.ado reads ("mata") or one the renderer reads.
    local t_compass2dir_text   `"scatter mpg weight, text(30 3000 "QQ", placement(@))"'
    local t_compass2dir_aspect `"scatter mpg weight, aspectratio(1, placement(@)) xsize(5) ysize(5)"'
    local t_tb_orientstyle_text   `"scatter mpg weight, text(30 3000 "QQ", orientation(@))"'
    local t_tb_orientstyle_title  `"scatter mpg weight, title("TT", orientation(@))"'
    local t_tb_orientstyle_ytitle `"scatter mpg weight, ytitle("YY", orientation(@))"'
    local t_clockdir_title   `"scatter mpg weight, title("TT", position(@))"'
    local t_clockdir_legend  `"scatter mpg price weight, legend(position(@))"'
    local t_clockdir_mlabpos `"scatter mpg weight in 1/5, mlabel(make) mlabposition(@)"'
    local t_gridringstyle_legend `"scatter mpg price weight, legend(ring(@) position(1))"'
    local t_gridringstyle_title  `"scatter mpg weight, title("TT", ring(@))"'
    local t_anglestyle_mlabangle `"scatter mpg weight in 1/5, mlabel(make) mlabangle(@)"'
    local t_anglestyle_msangle   `"scatter mpg weight in 1/5, msymbol(T) msize(huge) msangle(@)"'
    local t_connectstyle_connect `"scatter mpg weight in 1/20, connect(@)"'
    local t_horizontal_title `"scatter mpg weight, title("T", justification(@))"'
    local q2mata compass2dir_text compass2dir_aspect tb_orientstyle_text tb_orientstyle_title clockdir_title clockdir_legend gridringstyle_legend gridringstyle_title connectstyle_connect

    // ------------------------------------------------------------
    // Q4502-1: every fixture row registered with dash: dash's rc is
    // twoway's (a title ring() abbreviation stays refused, r(198), as
    // WP-43 refuses it), and at a site dash.ado reads dash prints a
    // "not found in class" note exactly when twoway does; at a site the
    // renderer reads (its notes are pinned by test_style_words.py's
    // TestTheNotes), dash.ado prints none twoway does not.
    // ------------------------------------------------------------
    local q2bad 0
    forvalues i = 1/`q2n' {
        frame q4502r: local cls = cls[`i']
        frame q4502r: local site = site[`i']
        frame q4502r: local w = word[`i']
        frame q4502r: local twrc = real(twrc[`i'])
        frame q4502r: local twnote = real(twnote[`i'])
        local cmd : subinstr local t_`cls'_`site' "@" "`w'"
        dash clear
        capture log close q4502l
        quietly log using "`q2d'/n.log", text replace name(q4502l)
        capture noisily dash `cmd' name(q4502)
        local drc = _rc
        quietly log close q4502l
        cert_log_has "`q2d'/n.log", needle("not found in class `cls'")
        local dnote = r(found)
        local ismata : list posof "`cls'_`site'" in q2mata
        if `drc' != `twrc' | (`ismata' & `dnote' != `twnote') | (!`ismata' & `dnote' & !`twnote') {
            local ++q2bad
            if `q2bad' <= 25 {
                _w45_expect Q4502-1 "(0)" "`cls' `site' `w': rc `drc' (twoway `twrc'), noted `dnote' (twoway `twnote')"
            }
        }
    }
    _w45_expect Q4502-1 "(`q2bad' == 0)" "`q2bad' of `q2n' rows differ from twoway"
    _w45_done Q4502-1 "`q2n' style words: dash's rc and notes are twoway's"

    // ------------------------------------------------------------
    // Q4502-2: five drawn cases, saved: title position(bottom) below the
    // plot, legend(position(top) ring(inside)) and legend(ring(in)) in the
    // plot region, mlabposition(left) at 9 o'clock, connect(st) written
    // as stairstep.
    // ------------------------------------------------------------
    local q2c1 `"scatter mpg weight, title("TT", position(bottom))"'
    local q2w1 title_below
    local q2c2 `"scatter mpg price weight, legend(position(top) ring(inside))"'
    local q2w2 legend_in
    local q2c3 `"scatter mpg price weight, legend(ring(in) position(1))"'
    local q2w3 legend_in
    local q2c4 `"scatter mpg weight in 1/5, mlabel(make) mlabposition(left)"'
    local q2w4 mlab_9
    local q2c5 `"scatter mpg weight in 1/20, connect(st)"'
    local q2w5 stairstep
    forvalues k = 1/5 {
        dash clear
        capture noisily dash `q2c`k'' name(q4502b)
        _w45_expect Q4502-2 "(_rc == 0)" "case `k': rc `=_rc'"
        if _rc == 0 {
            capture erase "`q2d'/s.json"
            capture erase "`q2d'/d.json"
            _dash_serve_spec, specpath("`q2d'/s.json") datapath("`q2d'/d.json")
            global q4502_got ""
            python: _q4502_saved("`q2d'/s.json", "`q2d'/d.json", "`q2w`k''")
            _w45_expect Q4502-2 `"("${q4502_got}" == "ok")"' "case `k' (`q2w`k''): ${q4502_got}"
        }
    }
    _w45_done Q4502-2 "position(bottom), ring(inside), ring(in), mlabposition(left) and connect(st) are drawn as twoway draws them"

    // ------------------------------------------------------------
    // Q4502-3: the Mata twin -- _dash_style_word(cls, w) is each fixture
    // row's canonical, "" for a word twoway noted (the title ring rows,
    // twoway's refusals, are read by Q4502-1).
    // ------------------------------------------------------------
    local q2m "dash_parse.mata's _dash_style_word did not run"
    frame q4502r {
        capture mata: st_local("q2m", _q4502_mata())
    }
    _w45_expect Q4502-3 `"("`q2m'" == "")"' "`q2m'"
    _w45_done Q4502-3 "dash_parse.mata's _dash_style_word reads every fixture row as twoway does"

    capture frame drop q4502r
    local q2f : dir "`q2d'" files "*"
    foreach f of local q2f {
        capture erase "`q2d'/`f'"
    }
    capture rmdir "`q2d'"
    capture graph drop _all
    dash clear
    macro drop q4502_*
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

// ----------------------------------------------------------------
// S01 helpers (WP-45 45-01, economist).  _q4501_reg draws one command
// with twoway (SVG) and registers it with dash; the python helper
// _q4501_check builds both modes from the spec and puts twoway's answer
// in $q4501_tw and the saved and served answers in $q4501_s and
// $q4501_v.  Cases: "note" (the note box's fill and text colour and
// where dash's Label is anchored), "width:<type>" (the drawn line width
// of the plot's shaft, its heads and its markers, relative units).
// ----------------------------------------------------------------
python:
def _q4501_docs(sp, dp, app):
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_q4501_app")
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_q4501_app.py",
                     "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    sv = [m for m in doc.models if type(m).__name__ == "figure"]
    return list(r.figures.values()), sv


def _q4501_note_dash(figs):
    f = [g for g in figs if getattr(g, "above", None) is not None][0]
    labs = [m for s in ("above", "center") for m in getattr(f, s)
            if type(m).__name__ == "Label" and "note" in (m.tags or [])]
    if len(labs) != 1:
        return "labels %d" % len(labs)
    m = labs[0]
    side = "above" if any(x is m for x in f.above) else "center"

    def node(n):
        if type(n).__name__ != "Node":
            return "number"
        return "%s.%s" % (n.target if isinstance(n.target, str)
                          else type(n.target).__name__, n.symbol)
    return "%s %s %s %s %s %s" % (side, node(m.x), node(m.y), m.anchor,
                                  str(m.background_fill_color).lower(),
                                  str(m.text_color).lower())


def _q4501_note_tw(svg):
    import svg_truth
    doc = svg_truth.svg_document(svg)
    t = [x for x in doc["texts"] if x["text"] == "The note"]
    pr = [r for r in doc["rects"] if str(r["fill"]).lower() == "#7b92a8"]
    if not t or not pr:
        return "none"
    # dash's anchors for twoway's box: the right edge at the plot
    # region's (the frame), the top at the graph margin below the top.
    return "above frame.right canvas.top top_right %s %s" % (
        str(pr[0]["fill"]).lower(), str(t[0]["fill"]).lower())


def _q4501_widths_dash(figs):
    """'shaft heads markers' line widths in relative units (px / 3.84)
    of the plot's glyphs; '.' where it draws none."""
    f = [g for g in figs if getattr(g, "renderers", None)][0]
    shaft, heads, marks = set(), set(), set()
    for r in f.renderers:
        g = getattr(r, "glyph", None)
        if g is None or not getattr(r, "visible", True):
            continue
        tags = [str(t) for t in (r.tags or [])]
        if any(t.startswith("dash_legend") for t in tags):
            continue
        w = getattr(g, "line_width", None)
        if isinstance(w, bool) or not isinstance(w, (int, float)):
            continue
        rs = round(float(w) / 3.84, 2)
        kind = type(g).__name__
        if "dash-arrowhead" in tags:
            heads.add(rs)
        elif kind in ("Line", "Segment", "MultiLine"):
            shaft.add(rs)
        elif kind == "Scatter":
            marks.add(rs)
    return " ".join(",".join("%g" % v for v in sorted(s)) or "."
                    for s in (shaft, heads, marks))


def _q4501_widths_tw(ptype):
    """The fixture's economist strokes of *ptype* in the same form: the
    shaft is the line, path or area outline drawn fewest times (an
    inside-aligned clipped outline draws half its width), the heads the
    other lines, the markers the circles."""
    import json
    import os
    from sfi import Macro
    repo = os.path.abspath(Macro.getGlobal("q4501_repo"))
    with open(os.path.join(repo, "test", "fixtures", "economist_truth.json"),
              encoding="utf-8") as fh:
        st = json.load(fh)["widths"]["economist"][ptype]["strokes"]
    shaft, heads, marks = set(), set(), set()
    n_min = min(s[2] for s in st if s[0] in ("line", "path", "use"))
    for tag, rs, n, clipped in st:
        rs = round(rs / 2.0 if clipped else rs, 2)
        if tag == "circle":
            marks.add(rs)
        elif n == n_min:
            shaft.add(rs)
        else:
            heads.add(rs)
    return " ".join(",".join("%g" % v for v in sorted(s)) or "."
                    for s in (shaft, heads, marks))


def _q4501_check(sp, dp, app, svg, case):
    import os
    import sys
    from sfi import Macro
    repo = os.path.abspath(Macro.getGlobal("q4501_repo"))
    for d in (repo, os.path.join(repo, "scripts")):
        if d not in sys.path:
            sys.path.insert(0, d)
    a, b = _q4501_docs(sp, dp, app)
    kind, _, arg = case.partition(":")
    if kind == "note":
        Macro.setGlobal("q4501_tw", _q4501_note_tw(svg))
        Macro.setGlobal("q4501_s", _q4501_note_dash(a))
        Macro.setGlobal("q4501_v", _q4501_note_dash(b))
    else:
        Macro.setGlobal("q4501_tw", _q4501_widths_tw(arg))
        Macro.setGlobal("q4501_s", _q4501_widths_dash(a))
        Macro.setGlobal("q4501_v", _q4501_widths_dash(b))
end

capture program drop _q4501_reg
program define _q4501_reg
    // _q4501_reg <dir> <k> <case> <command with options...>
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    gettoken case 0 : 0
    sysuse auto, clear
    quietly generate lo = price - 1000
    quietly generate hi = price + 1000
    quietly generate w2 = weight + 100
    capture graph drop q4501t
    capture noisily twoway `0' name(q4501t, replace)
    capture erase "`dir'/t`k'.svg"
    quietly graph export "`dir'/t`k'.svg", replace
    graph drop q4501t
    dash clear
    capture noisily dash `0' name(zq4501`k')
    local drc = _rc
    if `drc' {
        global q4501_tw "(twoway drawn)"
        global q4501_s "rc `drc'"
        global q4501_v "rc `drc'"
        exit
    }
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _q4501_m; _q4501_m._q4501_check("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py", "`dir'/t`k'.svg", "`case'")
end

