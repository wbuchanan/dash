*! test_wp45_truth.cscript
*! WP-45's ONE certification script (.ultraplan/sections/index.md PD-6):
*! every comparison with twoway's drawing or with Stata's own values that
*! WP-45's sections need lives here, one block per GAPS4 row (or per
*! harness tool), appended above the "append new blocks above this line"
*! marker in section order.  Refusal, message and return-code checks join
*! the EXISTING script for their area (merge rule R1).
*!
*! Made from test/templates/wp_truth_template.cscript (45 -> the WP's
*! number).  S00 is the scaffold smoke (Q4500-1).  A section appends
*! `* ==== S<MM> <lead id>: <what> ====` ... `* ==== end S<MM> ====` (or
*! `S<MM> tool: <what>` for a section with no item), its helper programs
*! directly above its first header, and writes only inside its own
*! blocks.  Case ids are Q45<MM>-<k> (PD-5).
*!
*! Usage: via run_all_cscripts.do.  One block alone: WP45_ONLY=S<MM> in
*! the driver's environment.  Each block prints "S<MM> start" and "S<MM>
*! end" with the date and time.  The suite runs it in every session;
*! DASH_CERT_SHARD=k/N runs part k of N of the blocks; a part with no
*! block ends 0.

cscript "WP-45 truth: twoway comparisons" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off


do "cert_helpers.do"
quietly do "cert_svg.do"
qui do "../dash_parse.mata"
qui do "../dash.ado"
global dash_nobrowser 1

// ----------------------------------------------------------------
// Tally helpers -- test_wp29_truth.cscript's _w29_expect/_w29_done,
// renamed _w45_ for this script.  A case is any number of
// _w45_expect lines closed by one _w45_done.
// ----------------------------------------------------------------
global w45_nfail    = 0
global w45_faillist ""
global w45_bad      = 0
global w45_ncase    = 0

capture program drop _w45_expect
program define _w45_expect
    version 19
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global w45_bad = 1
    }
end

capture program drop _w45_done
program define _w45_done
    version 19
    args id msg
    if ${w45_bad} {
        global w45_nfail    = ${w45_nfail} + 1
        global w45_faillist "${w45_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global w45_bad   = 0
    global w45_ncase = ${w45_ncase} + 1
end

// A fresh directory for this run's files, never one that already exists:
// a fixed name in a shared temp directory could be planted by another
// account (rule 1), so a name Stata has not handed out before is made and
// the run fails if it cannot be.  Every block writes only under it.
tempfile w45_base
local w45_work "`w45_base'_w45"
capture mkdir "`w45_work'"
if _rc {
    display as error "test_wp45_truth: cannot create the work directory `w45_work' (rc `=_rc')"
    exit 9
}

// ---- parts: begin (WP-45 test performance) ----
// The certification suite runs this script in every one of its sessions
// (its row in run_all_cscripts.do's shard table is "* * *"); with
// DASH_CERT_SHARD=k/N set, the session runs part k of N of the blocks.
// The parts are balanced longest first onto the least loaded part (the
// lowest numbered of equals), by the seconds below -- a block not listed
// counts 1 s (section-01 D-01.f) -- the rule scripts/cert_shards.py uses
// for the scripts.  Unset, or with WP45_ONLY set
// (which keeps its precedence), every block runs.  A block runs when its
// gate finds its id in w45_run.
// Seconds: each block's start/end lines in the WP's last measured
// certification run, rounded up, at least 1; a block not listed
// counts 1 s.
local w45_secs S00 1 S01 12 S02 31 S03 30 S04 7 S05 6
local w45_sh : environment DASH_CERT_SHARD
mata: st_local("w45_ok", strofreal(st_local("w45_sh") == "" | ustrregexm(st_local("w45_sh"), "^[1-8]/[1-8]$")))
if !`w45_ok' {
    display as error "test_wp45_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 8"
    exit 198
}
local w45_k 1
local w45_N 1
if "`w45_sh'" != "" {
    local w45_k = real(substr("`w45_sh'", 1, 1))
    local w45_N = real(substr("`w45_sh'", 3, 1))
}
local w45_only : env WP45_ONLY
if `"`macval(w45_only)'"' != "" | `w45_N' == 1 {
    local w45_k 1
    local w45_N 1
}
if `w45_k' > `w45_N' {
    display as error "test_wp45_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 8"
    exit 198
}
capture confirm file "test_wp45_truth.cscript"
if _rc {
    display as error "test_wp45_truth: run it from test/, where it reads its own blocks"
    exit 601
}
capture mata: mata drop _w45_part()
mata:
// The ids of the blocks (their header lines, in file order), and those of
// part k of n: longest first onto the least loaded part.
void _w45_part(string scalar file, string scalar table, real scalar k,
               real scalar n)
{
    string colvector lines, ids
    string rowvector tok
    real colvector sec, o, at
    real rowvector load
    real scalar i, j, p, best
    string scalar run

    lines = cat(file)
    ids = J(0, 1, "")
    for (i = 1; i <= rows(lines); i++) {
        if (ustrregexm(lines[i], "^\* ==== (S[0-9]+) ")) {
            if (!anyof(ids, ustrregexs(1))) ids = ids \ ustrregexs(1)
        }
    }
    sec = J(rows(ids), 1, 1)
    tok = tokens(table)
    for (j = 1; j + 1 <= cols(tok); j = j + 2) {
        for (i = 1; i <= rows(ids); i++) {
            if (ids[i] == tok[j]) sec[i] = strtoreal(tok[j + 1])
        }
    }
    o = order((-sec, (1::rows(ids))), (1, 2))
    load = J(1, n, 0)
    at = J(rows(ids), 1, 0)
    for (i = 1; i <= rows(o); i++) {
        best = 1
        for (p = 2; p <= n; p++) if (load[p] < load[best]) best = p
        load[best] = load[best] + sec[o[i]]
        at[o[i]] = best
    }
    run = ""
    for (i = 1; i <= rows(ids); i++) if (at[i] == k) run = run + " " + ids[i]
    st_local("w45_run", strtrim(run))
}
end
// The part this session runs: the runner's shard table may turn the
// parts (cert_helpers.do's cert_split_part, 11nov2026), so that
// each script's longest part lands on a different session.
cert_split_part "test_wp45_truth.cscript" `w45_k' `w45_N'
local w45_p = r(part)
mata: _w45_part("test_wp45_truth.cscript", st_local("w45_secs"), `w45_p', `w45_N')
display as text "test_wp45_truth: session `w45_k'/`w45_N' runs part `w45_p', `: word count `w45_run'' blocks: `w45_run'"
// ---- parts: end ----

* ==== S00 scaffold: the helpers load and a twoway SVG is read ====
local only : env WP45_ONLY
if inlist("`only'", "", "S00") & `: list posof "S00" in w45_run' {
    display as text "S00 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4500-1: cert_svg_export and cert_svg_texts on one twoway scatter,
    // and dash's own programs are loaded from this tree.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(w45s01, replace)
    cert_svg_export, name(w45s01) file("`w45_work'/w45s01.svg")
    local s01_rc   = r(rc)
    local s01_file "`r(file)'"
    _w45_expect Q4500-1 "(`s01_rc' == 0)" "cert_svg_export rc `s01_rc'"
    capture confirm file "`s01_file'"
    _w45_expect Q4500-1 "(_rc == 0)" "r(file) `s01_file' does not exist"
    cert_svg_texts, file("`s01_file'")
    local s01_n    = r(n)
    local s01_list "`r(list)'"
    _w45_expect Q4500-1 "(`s01_n' > 0)" "cert_svg_texts found no text elements"
    capture program list _dash_serve
    _w45_expect Q4500-1 "(_rc == 0)" "dash.ado's _dash_serve is not loaded"
    _w45_done Q4500-1 "a twoway SVG was written and read (`s01_n' texts); dash is loaded"

    capture erase "`s01_file'"
    capture erase "`s01_list'"
    capture graph drop w45s01
    display as text "S00 end " c(current_date) " " c(current_time)
}
* ==== end S00 ====

// ----------------------------------------------------------------
// S01 helpers (WP-45 45-01, economist).  _q4501_reg draws one command
// with twoway (SVG) and registers it with dash; the python helper
// _q4501_check builds both modes from the spec and puts twoway's answer
// in $q4501_tw and the saved and served answers in $q4501_s and
// $q4501_v.  Cases: "note" (the note box's fill and text colour and
// where dash's Label is anchored), "width:<type>" (the drawn line width
// of the plot's shaft, its heads and its markers, relative units).
// ----------------------------------------------------------------
python:
def _q4501_docs(sp, dp, app):
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_q4501_app")
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_q4501_app.py",
                     "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    sv = [m for m in doc.models if type(m).__name__ == "figure"]
    return list(r.figures.values()), sv


def _q4501_note_dash(figs):
    f = [g for g in figs if getattr(g, "above", None) is not None][0]
    labs = [m for s in ("above", "center") for m in getattr(f, s)
            if type(m).__name__ == "Label" and "note" in (m.tags or [])]
    if len(labs) != 1:
        return "labels %d" % len(labs)
    m = labs[0]
    side = "above" if any(x is m for x in f.above) else "center"

    def node(n):
        if type(n).__name__ != "Node":
            return "number"
        return "%s.%s" % (n.target if isinstance(n.target, str)
                          else type(n.target).__name__, n.symbol)
    return "%s %s %s %s %s %s" % (side, node(m.x), node(m.y), m.anchor,
                                  str(m.background_fill_color).lower(),
                                  str(m.text_color).lower())


def _q4501_note_tw(svg):
    import svg_truth
    doc = svg_truth.svg_document(svg)
    t = [x for x in doc["texts"] if x["text"] == "The note"]
    pr = [r for r in doc["rects"] if str(r["fill"]).lower() == "#7b92a8"]
    if not t or not pr:
        return "none"
    # dash's anchors for twoway's box: the right edge at the plot
    # region's (the frame), the top at the graph margin below the top.
    return "above frame.right canvas.top top_right %s %s" % (
        str(pr[0]["fill"]).lower(), str(t[0]["fill"]).lower())


def _q4501_widths_dash(figs):
    """'shaft heads markers' line widths in relative units (px / 3.84)
    of the plot's glyphs; '.' where it draws none."""
    f = [g for g in figs if getattr(g, "renderers", None)][0]
    shaft, heads, marks = set(), set(), set()
    for r in f.renderers:
        g = getattr(r, "glyph", None)
        if g is None or not getattr(r, "visible", True):
            continue
        tags = [str(t) for t in (r.tags or [])]
        if any(t.startswith("dash_legend") for t in tags):
            continue
        w = getattr(g, "line_width", None)
        if isinstance(w, bool) or not isinstance(w, (int, float)):
            continue
        rs = round(float(w) / 3.84, 2)
        kind = type(g).__name__
        if "dash-arrowhead" in tags:
            heads.add(rs)
        elif kind in ("Line", "Segment", "MultiLine") or "dash_cap" in tags:
            # rcap's caps are dash markers (tag dash_cap) of its line.
            shaft.add(rs)
        elif kind == "Scatter":
            marks.add(rs)
    return " ".join(",".join("%g" % v for v in sorted(s)) or "."
                    for s in (shaft, heads, marks))


def _q4501_widths_tw(ptype):
    """The fixture's economist strokes of *ptype* in the same form: the
    shaft is the line, path or area outline drawn fewest times (an
    inside-aligned clipped outline draws half its width), the heads the
    other lines, the markers the circles."""
    import json
    import os
    from sfi import Macro
    repo = os.path.abspath(Macro.getGlobal("q4501_repo"))
    with open(os.path.join(repo, "test", "fixtures", "economist_truth.json"),
              encoding="utf-8") as fh:
        st = json.load(fh)["widths"]["economist"][ptype]["strokes"]
    shaft, heads, marks = set(), set(), set()
    n_min = min(s[2] for s in st if s[0] in ("line", "path", "use"))
    for tag, rs, n, clipped in st:
        rs = round(rs / 2.0 if clipped else rs, 2)
        if tag == "circle":
            marks.add(rs)
        elif n == n_min:
            shaft.add(rs)
        else:
            heads.add(rs)
    return " ".join(",".join("%g" % v for v in sorted(s)) or "."
                    for s in (shaft, heads, marks))


def _q4501_check(sp, dp, app, svg, case):
    import os
    import sys
    from sfi import Macro
    repo = os.path.abspath(Macro.getGlobal("q4501_repo"))
    for d in (repo, os.path.join(repo, "scripts")):
        if d not in sys.path:
            sys.path.insert(0, d)
    a, b = _q4501_docs(sp, dp, app)
    kind, _, arg = case.partition(":")
    if kind == "note":
        Macro.setGlobal("q4501_tw", _q4501_note_tw(svg))
        Macro.setGlobal("q4501_s", _q4501_note_dash(a))
        Macro.setGlobal("q4501_v", _q4501_note_dash(b))
    else:
        Macro.setGlobal("q4501_tw", _q4501_widths_tw(arg))
        Macro.setGlobal("q4501_s", _q4501_widths_dash(a))
        Macro.setGlobal("q4501_v", _q4501_widths_dash(b))
end

capture program drop _q4501_reg
program define _q4501_reg
    // _q4501_reg <dir> <k> <case> <command with options...>
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    gettoken case 0 : 0
    sysuse auto, clear
    quietly generate lo = price - 1000
    quietly generate hi = price + 1000
    quietly generate w2 = weight + 100
    capture graph drop q4501t
    capture noisily twoway `0' name(q4501t, replace)
    capture erase "`dir'/t`k'.svg"
    quietly graph export "`dir'/t`k'.svg", replace
    graph drop q4501t
    dash clear
    capture noisily dash `0' name(zq4501`k')
    local drc = _rc
    if `drc' {
        global q4501_tw "(twoway drawn)"
        global q4501_s "rc `drc'"
        global q4501_v "rc `drc'"
        exit
    }
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _q4501_m; _q4501_m._q4501_check("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py", "`dir'/t`k'.svg", "`case'")
end

* ==== S01 PIC-4: economist note painted ====
local only : env WP45_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w45_run' {
    display as text "S01 start " c(current_date) " " c(current_time)
    local q01 "`w45_work'/s01"
    capture mkdir "`q01'"
    global q4501_repo : env DASH_REPO
    if `"${q4501_repo}"' == "" global q4501_repo ".."

    // Q4501-1: twoway draws economist's note in a #7b92a8 box with white
    // text at the top right of the title's band; dash's saved and served
    // Label is a row of the above panel (BokehJS clips fig.center to the
    // frame, so a centre Label is never painted there), anchored top
    // right on the frame's right edge and the canvas's top, in twoway's
    // fill and text colour.  Chrome's pixels: test_economist_scheme.py
    // TestTheNoteIsPainted::test_pixels (release tier).
    _q4501_reg "`q01'" 1 "note" scatter mpg weight, title("T") note("The note") scheme(economist)
    _w45_expect Q4501-1 `"("${q4501_tw}" != "none")"' "twoway drew no #7b92a8 note box"
    _w45_expect Q4501-1 `"("${q4501_s}" == "${q4501_tw}")"' "saved: ${q4501_s}; twoway ${q4501_tw}"
    _w45_expect Q4501-1 `"("${q4501_v}" == "${q4501_tw}")"' "served: ${q4501_v}; twoway ${q4501_tw}"
    _w45_done Q4501-1 "the economist note: twoway ${q4501_tw}; saved and served the same"

    capture graph drop _all
    dash clear
    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====

* ==== S01 PIC-7: economist p#other and p#area widths ====
local only : env WP45_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w45_run' {
    display as text "S01 start " c(current_date) " " c(current_time)
    local q01 "`w45_work'/s01"
    capture mkdir "`q01'"
    global q4501_repo : env DASH_REPO
    if `"${q4501_repo}"' == "" global q4501_repo ".."

    // Q4501-2: under economist each type's shaft (rarea's outline) is
    // drawn at twoway's width -- pother 0.8, parea 0.2 -- and its heads
    // and markers at p's 1.2, saved and served, as "shaft heads markers"
    // in relative units (test/fixtures/economist_truth.json widths).
    local k 10
    foreach t in rspike rcap rcapsym rline rconnected rarea pcspike pccapsym pcarrow pcbarrow spike dropline {
        if inlist("`t'", "pcspike", "pccapsym", "pcarrow", "pcbarrow") local args "lo weight hi w2"
        else if inlist("`t'", "spike", "dropline") local args "price weight"
        else local args "lo hi weight"
        local ++k
        _q4501_reg "`q01'" `k' "width:`t'" `t' `args', scheme(economist)
        _w45_expect Q4501-2 `"("${q4501_s}" == "${q4501_tw}")"' "`t' saved: ${q4501_s}; twoway ${q4501_tw}"
        _w45_expect Q4501-2 `"("${q4501_v}" == "${q4501_tw}")"' "`t' served: ${q4501_v}; twoway ${q4501_tw}"
    }
    _w45_done Q4501-2 "economist's range, spike, drop-line, pc and rarea widths are twoway's, saved and served"

    capture graph drop _all
    dash clear
    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====

// S02 ST-1 helpers: _q4502_rows writes style_words_truth.json's rows as a
// tab-separated file (class, site, word, canonical, twoway's rc, 1 when
// twoway printed a note) for the block to import; _q4502_saved reads one
// saved (DashRenderer) figure of a registered graph for Q4502-2's checks
// into the global q4502_got ("ok" or what was found).
python:
import os as _q4502_os, sys as _q4502_sys
if _q4502_os.path.abspath("..") not in _q4502_sys.path:
    _q4502_sys.path.insert(0, _q4502_os.path.abspath(".."))


def _q4502_rows(out):
    import json
    with open(_q4502_os.path.join("fixtures", "style_words_truth.json"),
              encoding="utf-8") as fh:
        rows = json.load(fh)["rows"]
    with open(out, "w", encoding="utf-8") as fh:
        fh.write("cls\tsite\tword\tcanon\ttwrc\ttwnote\n")
        for r in rows:
            fh.write("%s\t%s\t%s\t%s\t%d\t%d\n" % (
                r["class"], r["site"], r["word"], r["canonical"], r["rc"],
                1 if r["note"] else 0))


def _q4502_saved(sp, dp, what):
    import json
    import warnings
    from sfi import Macro
    import dash_render as dr
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
    f = list(r.figures.values())[0]
    got = "ok"
    if what == "title_below":
        on = [s for s in ("center", "above", "below", "left", "right")
              if any("title" in list(getattr(m, "tags", None) or [])
                     for m in getattr(f, s))]
        got = "ok" if on == ["below"] else "title on %s" % on
    elif what == "legend_in":
        on = [s for s in ("center", "above", "below", "left", "right")
              if any(type(m).__name__ == "Legend" for m in getattr(f, s))]
        got = "ok" if on == ["center"] else "legend on %s" % on
    elif what == "mlab_9":
        # Flipped (WP-47 MS-15): the marker labels are a Text glyph
        # (tagged dash_mlabel), where they were a LabelSet in the centre.
        t = [r.glyph for r in f.renderers
             if "dash_mlabel" in (getattr(r, "tags", None) or [])]
        got = ("ok" if t and all(float(g.x_offset) < 0 and
                                 float(g.y_offset) == 0 for g in t)
               else "offsets %s" % [(g.x_offset, g.y_offset) for g in t])
    elif what == "stairstep":
        with open(sp, encoding="utf-8") as fh:
            spec = json.load(fh)
        cs = [(p.get("options") or {}).get("connect")
              for g in spec.get("graphs") or []
              for p in (g.get("plots") or [])]
        got = "ok" if cs == ["stairstep"] else "connect %s" % cs
    Macro.setGlobal("q4502_got", got)
end

// S02 ST-1 helper: _q4502_mata -- over the current frame's rows (cls,
// site, word, canon, twnote), the first rows where dash_parse.mata's
// _dash_style_word differs from the fixture, "" when none does.
capture mata: mata drop _q4502_mata()
mata:
string scalar _q4502_mata()
{
    string matrix D
    string scalar out, got, want
    real scalar   i, n

    D = st_sdata(., ("cls", "site", "word", "canon", "twnote"))
    out = ""
    n = 0
    for (i = 1; i <= rows(D); i++) {
        if (D[i, 1] == "horizontal") continue
        if (D[i, 1] == "gridringstyle" & D[i, 2] == "title") continue
        want = (D[i, 5] == "1" ? "" : D[i, 4])
        if (D[i, 5] == "0" & want == "") {
            out = out + " " + D[i, 1] + "/" + D[i, 3] + ": no canonical"
            n++
            continue
        }
        got = _dash_style_word(D[i, 1], D[i, 3])
        if (got != want) {
            n++
            if (n <= 20) out = out + " " + D[i, 1] + "/" + D[i, 3] + ": " +
                               got + " (want " + want + ")"
        }
    }
    return(strtrim(out))
}
end

* ==== S02 ST-1: style words read per class ====
local only : env WP45_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w45_run' {
    display as text "S02 start " c(current_date) " " c(current_time)
    local q2d "`w45_work'/s02"
    capture mkdir "`q2d'"
    capture graph drop _all
    capture frame drop q4502r
    python: _q4502_rows("`q2d'/rows.tsv")
    frame create q4502r
    frame q4502r: import delimited using "`q2d'/rows.tsv", delimiter(tab) varnames(1) stringcols(_all) clear
    frame q4502r: local q2n = _N
    sysuse auto, clear

    // The sites, as scripts/extract_style_words_truth.do draws them (@ the
    // word); a site dash.ado reads ("mata") or one the renderer reads.
    local t_compass2dir_text   `"scatter mpg weight, text(30 3000 "QQ", placement(@))"'
    local t_compass2dir_aspect `"scatter mpg weight, aspectratio(1, placement(@)) xsize(5) ysize(5)"'
    local t_tb_orientstyle_text   `"scatter mpg weight, text(30 3000 "QQ", orientation(@))"'
    local t_tb_orientstyle_title  `"scatter mpg weight, title("TT", orientation(@))"'
    local t_tb_orientstyle_ytitle `"scatter mpg weight, ytitle("YY", orientation(@))"'
    local t_clockdir_title   `"scatter mpg weight, title("TT", position(@))"'
    local t_clockdir_legend  `"scatter mpg price weight, legend(position(@))"'
    local t_clockdir_mlabpos `"scatter mpg weight in 1/5, mlabel(make) mlabposition(@)"'
    local t_gridringstyle_legend `"scatter mpg price weight, legend(ring(@) position(1))"'
    local t_gridringstyle_title  `"scatter mpg weight, title("TT", ring(@))"'
    local t_anglestyle_mlabangle `"scatter mpg weight in 1/5, mlabel(make) mlabangle(@)"'
    local t_anglestyle_msangle   `"scatter mpg weight in 1/5, msymbol(T) msize(huge) msangle(@)"'
    local t_connectstyle_connect `"scatter mpg weight in 1/20, connect(@)"'
    local t_horizontal_title `"scatter mpg weight, title("T", justification(@))"'
    local q2mata compass2dir_text compass2dir_aspect tb_orientstyle_text tb_orientstyle_title clockdir_title clockdir_legend gridringstyle_legend gridringstyle_title connectstyle_connect

    // ------------------------------------------------------------
    // Q4502-1: every fixture row registered with dash: dash's rc is
    // twoway's (a title ring() abbreviation stays refused, r(198), as
    // WP-43 refuses it), and at a site dash.ado reads dash prints a
    // "not found in class" note exactly when twoway does; at a site the
    // renderer reads (its notes are pinned by test_style_words.py's
    // TestTheNotes), dash.ado prints none twoway does not.
    // ------------------------------------------------------------
    local q2bad 0
    forvalues i = 1/`q2n' {
        frame q4502r: local cls = cls[`i']
        frame q4502r: local site = site[`i']
        frame q4502r: local w = word[`i']
        frame q4502r: local twrc = real(twrc[`i'])
        frame q4502r: local twnote = real(twnote[`i'])
        local cmd : subinstr local t_`cls'_`site' "@" "`w'"
        dash clear
        capture log close q4502l
        quietly log using "`q2d'/n.log", text replace name(q4502l)
        capture noisily dash `cmd' name(q4502)
        local drc = _rc
        quietly log close q4502l
        cert_log_has "`q2d'/n.log", needle("not found in class `cls'")
        local dnote = r(found)
        local ismata : list posof "`cls'_`site'" in q2mata
        if `drc' != `twrc' | (`ismata' & `dnote' != `twnote') | (!`ismata' & `dnote' & !`twnote') {
            local ++q2bad
            if `q2bad' <= 25 {
                _w45_expect Q4502-1 "(0)" "`cls' `site' `w': rc `drc' (twoway `twrc'), noted `dnote' (twoway `twnote')"
            }
        }
    }
    _w45_expect Q4502-1 "(`q2bad' == 0)" "`q2bad' of `q2n' rows differ from twoway"
    _w45_done Q4502-1 "`q2n' style words: dash's rc and notes are twoway's"

    // ------------------------------------------------------------
    // Q4502-2: five drawn cases, saved: title position(bottom) below the
    // plot, legend(position(top) ring(inside)) and legend(ring(in)) in the
    // plot region, mlabposition(left) at 9 o'clock, connect(st) written
    // as stairstep.
    // ------------------------------------------------------------
    local q2c1 `"scatter mpg weight, title("TT", position(bottom))"'
    local q2w1 title_below
    local q2c2 `"scatter mpg price weight, legend(position(top) ring(inside))"'
    local q2w2 legend_in
    local q2c3 `"scatter mpg price weight, legend(ring(in) position(1))"'
    local q2w3 legend_in
    local q2c4 `"scatter mpg weight in 1/5, mlabel(make) mlabposition(left)"'
    local q2w4 mlab_9
    local q2c5 `"scatter mpg weight in 1/20, connect(st)"'
    local q2w5 stairstep
    forvalues k = 1/5 {
        dash clear
        capture noisily dash `q2c`k'' name(q4502b)
        _w45_expect Q4502-2 "(_rc == 0)" "case `k': rc `=_rc'"
        if _rc == 0 {
            capture erase "`q2d'/s.json"
            capture erase "`q2d'/d.json"
            _dash_serve_spec, specpath("`q2d'/s.json") datapath("`q2d'/d.json")
            global q4502_got ""
            python: _q4502_saved("`q2d'/s.json", "`q2d'/d.json", "`q2w`k''")
            _w45_expect Q4502-2 `"("${q4502_got}" == "ok")"' "case `k' (`q2w`k''): ${q4502_got}"
        }
    }
    _w45_done Q4502-2 "position(bottom), ring(inside), ring(in), mlabposition(left) and connect(st) are drawn as twoway draws them"

    // ------------------------------------------------------------
    // Q4502-3: the Mata twin -- _dash_style_word(cls, w) is each fixture
    // row's canonical, "" for a word twoway noted (the title ring rows,
    // twoway's refusals, are read by Q4502-1).
    // ------------------------------------------------------------
    local q2m "dash_parse.mata's _dash_style_word did not run"
    frame q4502r {
        capture mata: st_local("q2m", _q4502_mata())
    }
    _w45_expect Q4502-3 `"("`q2m'" == "")"' "`q2m'"
    _w45_done Q4502-3 "dash_parse.mata's _dash_style_word reads every fixture row as twoway does"

    capture frame drop q4502r
    local q2f : dir "`q2d'" files "*"
    foreach f of local q2f {
        capture erase "`q2d'/`f'"
    }
    capture rmdir "`q2d'"
    capture graph drop _all
    dash clear
    macro drop q4502_*
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

// ---- S03 helpers (WP-45 section 45-03) ----
// _w45s03_files(dir): test/fixtures/style_leaf_truth.json's style and
// scheme files, written into dir (a block puts it on the ado-path with
// adopath ++ and takes it off with adopath - at its end).
// _w45s03_pair(sp, dp, rsp, rdp, app): the saved page's and the served
// app's models of a probe spec and of its reference spec, compared on
// their visual attributes; dash notes the probe printed and the
// differences in globals w45s03_notes and w45s03_diff.
// _w45s03_svgsame(a, b): whether two exported SVGs are the same bytes, in
// global w45s03_same.
python:
import os as _w45s03_os, sys as _w45s03_sys
for _w45s03_p in (_w45s03_os.path.abspath(".."),
                  _w45s03_os.path.abspath(_w45s03_os.path.join("..", "scripts"))):
    if _w45s03_p not in _w45s03_sys.path:
        _w45s03_sys.path.insert(0, _w45s03_p)

_W45S03_ATTRS = ("line_dash", "line_width", "line_color", "line_alpha",
                 "fill_color", "fill_alpha", "size", "angle",
                 "text_font_size", "text_color", "text_alpha", "text_align",
                 "text_baseline", "x_offset", "y_offset", "min_border_left",
                 "min_border_right", "min_border_top", "min_border_bottom",
                 "align", "location", "start", "end", "ticks")


def _w45s03_files(d):
    import json
    with open(_w45s03_os.path.join("fixtures", "style_leaf_truth.json"),
              encoding="utf-8") as fh:
        files = json.load(fh)["files"]
    for name, text in files.items():
        if "/" not in name:
            with open(_w45s03_os.path.join(d, name), "w",
                      encoding="utf-8") as fh:
                fh.write(text)


def _w45s03_models(sp, dp, app):
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings(record=True) as caught:
        warnings.simplefilter("always")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
        with open(app, encoding="utf-8") as fh:
            src = fh.read()
        attach = "if __name__ != '__main__':\n    make_document(curdoc())"
        ns = dict(__name__="dash_w45s03_app")
        exec(compile(src.replace(attach, "pass"), "dash_w45s03_app.py",
                     "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    notes = sorted({str(w.message) for w in caught
                    if str(w.message).startswith("dash")})
    return (list(r._last_layout_root.references()), list(doc.models)), notes


def _w45s03_sig(models):
    out = []
    for m in models:
        row = tuple((a, repr(getattr(m, a, None))) for a in _W45S03_ATTRS
                    if a in m.properties())
        if row:
            out.append((type(m).__name__, row))
    return sorted(out)


def _w45s03_pair(sp, dp, rsp, rdp, app):
    from sfi import Macro
    (ps, pv), notes = _w45s03_models(sp, dp, app)
    (rs, rv), _n = _w45s03_models(rsp, rdp, app)
    diff = []
    for mode, a, b in (("saved", ps, rs), ("served", pv, rv)):
        sa, sb = _w45s03_sig(a), _w45s03_sig(b)
        if sa != sb:
            extra = [x for x in sa if x not in sb][:2]
            diff.append("%s: %s" % (mode, extra))
    Macro.setGlobal("w45s03_notes", " | ".join(notes)[:400])
    Macro.setGlobal("w45s03_diff", "; ".join(diff)[:600])


def _w45s03_svgsame(a, b):
    import hashlib
    from sfi import Macro
    def h(p):
        with open(p, "rb") as fh:
            return hashlib.sha256(fh.read()).hexdigest()
    Macro.setGlobal("w45s03_same", "1" if h(a) == h(b) else "0")

def _w45s03_colgap(sp, dp, app):
    """The series legend's column gap (its dash_legend_colgap
    stylesheet's px) and row gap (its spacing) in the saved page and the
    served app: globals w45s03_cg1/2 and w45s03_rg1/2 (-1 for none)."""
    import re
    from sfi import Macro
    from bokeh.models import Legend
    (saved, served), _n = _w45s03_models(sp, dp, app)
    for i, models in ((1, saved), (2, served)):
        cg, rg = -1.0, -1
        for m in models:
            if isinstance(m, Legend) and m.items:
                rg = m.spacing
                for ss in m.stylesheets or []:
                    if "dash_legend_colgap" in (getattr(ss, "tags", None)
                                                or []):
                        g = re.search(r"column-gap:calc\(([0-9.]+)px",
                                      ss.css)
                        cg = float(g.group(1)) if g else -1.0
        Macro.setGlobal("w45s03_cg%d" % i, "%g" % cg)
        Macro.setGlobal("w45s03_rg%d" % i, str(rg))
end

// _w45s03_tw id cmd_a | cmd_b: twoway draws cmd_a and cmd_b (data sorted
// weight mpg make, so a line's ties keep one order) and exports both;
// w45s03_same says whether the SVGs are the same and w45s03_twrc the
// return codes.
capture program drop _w45s03_tw
program define _w45s03_tw
    version 19
    gettoken dir 0 : 0
    local bar = strpos(`"`macval(0)'"', "|")
    local a = strtrim(substr(`"`macval(0)'"', 1, `bar' - 1))
    local b = strtrim(substr(`"`macval(0)'"', `bar' + 1, .))
    local rc ""
    local k 0
    foreach c in a b {
        local ++k
        quietly sysuse auto, clear
        quietly sort weight mpg make
        capture graph drop _all
        capture noisily twoway `macval(`c')' name(w45s03tw, replace)
        local one = _rc
        local rc "`rc' `one'"
        capture erase "`dir'/tw`k'.svg"
        if !`one' quietly graph export "`dir'/tw`k'.svg", as(svg) name(w45s03tw) replace
    }
    global w45s03_twrc = strtrim("`rc'")
    capture graph drop w45s03tw
    python: import __main__ as _w45m; _w45m._w45s03_svgsame("`dir'/tw1.svg", "`dir'/tw2.svg")
end

// _w45s03_dash dir name cmd: dash clear, register cmd as graph name, and
// write its spec and data to dir/<name>.json and dir/<name>_d.json.
capture program drop _w45s03_dash
program define _w45s03_dash
    version 19
    gettoken dir 0 : 0
    gettoken nm 0 : 0
    quietly sysuse auto, clear
    quietly sort weight mpg make
    capture dash clear
    capture noisily dash `macval(0)' name(`nm')
    global w45s03_drc = _rc
    if !_rc {
        capture erase "`dir'/`nm'.json"
        capture erase "`dir'/`nm'_d.json"
        _dash_serve_spec, specpath("`dir'/`nm'.json") datapath("`dir'/`nm'_d.json")
    }
end

* ==== S03 ST-7: leaf style files ====
local only : env WP45_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w45_run' {
    display as text "S03 start " c(current_date) " " c(current_time)
    local s03d "`w45_work'/s03"
    local s03u "`w45_work'/s03u"
    capture mkdir "`s03d'"
    capture mkdir "`s03u'"
    python: import __main__ as _w45m; _w45m._w45s03_files("`s03u'")
    quietly adopath ++ "`s03u'"
    // twoway reads its style lists once a session has drawn a graph and
    // sees a style file added after that only past -discard- (measured
    // 09nov2026: lwidth(<new name>) noted "not found" after a graph,
    // drawn after discard); the certification session has drawn many.
    discard

    // ------------------------------------------------------------
    // Q4503-1: a linewidth-, linepattern-, symbolsize-, gsize- and
    // margin-<name>.style file on the ado-path: twoway draws each name as
    // its value (live, SVG equality), and dash draws the names as the
    // values typed, saved and served, with no note.
    // ------------------------------------------------------------
    _w45s03_tw "`s03d'" line mpg weight, lwidth(zqw) | line mpg weight, lwidth(2)
    local s03_ok = ("${w45s03_twrc}" == "0 0" & ${w45s03_same} == 1)
    _w45_expect Q4503-1 "(`s03_ok')" "twoway lwidth(zqw) vs lwidth(2): rc ${w45s03_twrc}, same ${w45s03_same}"
    _w45s03_tw "`s03d'" scatter mpg weight, plotregion(margin(zqn)) | scatter mpg weight, plotregion(margin(2 4 8 6))
    local s03_ok = ("${w45s03_twrc}" == "0 0" & ${w45s03_same} == 1)
    _w45_expect Q4503-1 "(`s03_ok')" "twoway margin(zqn) vs margin(2 4 8 6): rc ${w45s03_twrc}, same ${w45s03_same}"
    foreach pair in "line mpg weight, lwidth(zqw) lpattern(zqpb)|line mpg weight, lwidth(2) lpattern(longdash_dot)" ///
        `"scatter mpg weight, msize(zqs) title("T", size(zqg)) plotregion(margin(zqn))|scatter mpg weight, msize(5) title("T", size(10)) plotregion(margin(2 4 8 6))"' {
        local bar = strpos(`"`pair'"', "|")
        local pa = substr(`"`pair'"', 1, `bar' - 1)
        local pb = substr(`"`pair'"', `bar' + 1, .)
        _w45s03_dash "`s03d'" w45s03p `macval(pa)'
        local s03_rc1 = ${w45s03_drc}
        _w45s03_dash "`s03d'" w45s03r `macval(pb)'
        local s03_rc2 = ${w45s03_drc}
        _w45_expect Q4503-1 "(`s03_rc1' == 0 & `s03_rc2' == 0)" "dash rc `s03_rc1' `s03_rc2'"
        if !`s03_rc1' & !`s03_rc2' {
            python: import __main__ as _w45m; _w45m._w45s03_pair("`s03d'/w45s03p.json", "`s03d'/w45s03p_d.json", "`s03d'/w45s03r.json", "`s03d'/w45s03r_d.json", "`s03d'/a.py")
            mata: st_local("s03_nn", strofreal(st_global("w45s03_notes") == ""))
            mata: st_local("s03_nd", strofreal(st_global("w45s03_diff") == ""))
            _w45_expect Q4503-1 "(`s03_nn')" `"notes: ${w45s03_notes}"'
            _w45_expect Q4503-1 "(`s03_nd')" `"differs: ${w45s03_diff}"'
        }
    }
    _w45_done Q4503-1 "leaf style files draw as their values in twoway and in dash, saved and served, with no note"

    quietly adopath - "`s03u'"
    capture dash clear
    macro drop w45s03_*
    foreach f in tw1.svg tw2.svg w45s03p.json w45s03p_d.json w45s03r.json w45s03r_d.json a.py {
        capture erase "`s03d'/`f'"
    }
    local s03_left : dir "`s03u'" files "*"
    foreach f of local s03_left {
        capture erase "`s03u'/`f'"
    }
    capture rmdir "`s03d'"
    capture rmdir "`s03u'"
    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

* ==== S03 ST-15: color and textboxstyle style files ====
local only : env WP45_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w45_run' {
    display as text "S03 start " c(current_date) " " c(current_time)
    local s03d "`w45_work'/s03c"
    local s03u "`w45_work'/s03cu"
    capture mkdir "`s03d'"
    capture mkdir "`s03u'"
    python: import __main__ as _w45m; _w45m._w45s03_files("`s03u'")
    quietly adopath ++ "`s03u'"
    discard    // twoway's style lists see the new files (see S03 ST-7)

    // ------------------------------------------------------------
    // Q4503-2: a color-zqc.style (set rgb "200 30 40") and a
    // textboxstyle-zqt.style (heading's rows with set size huge, set
    // color red) on the ado-path: twoway draws mcolor(zqc) and
    // tstyle(zqt) as the values (live, SVG equality), and dash draws
    // mcolor(zqc), title tstyle(zqt) and mlabtextstyle(zqt) as the values
    // typed, saved and served, with no note.
    // ------------------------------------------------------------
    _w45s03_tw "`s03d'" scatter mpg weight, mcolor(zqc) | scatter mpg weight, mcolor("200 30 40")
    local s03_ok = ("${w45s03_twrc}" == "0 0" & ${w45s03_same} == 1)
    _w45_expect Q4503-2 "(`s03_ok')" "twoway mcolor(zqc): rc ${w45s03_twrc}, same ${w45s03_same}"
    _w45s03_tw "`s03d'" scatter mpg weight, title("T", tstyle(zqt)) | scatter mpg weight, title("T", size(huge) color(red))
    local s03_ok = ("${w45s03_twrc}" == "0 0" & ${w45s03_same} == 1)
    _w45_expect Q4503-2 "(`s03_ok')" "twoway tstyle(zqt): rc ${w45s03_twrc}, same ${w45s03_same}"
    _w45s03_dash "`s03d'" w45s03p scatter mpg weight in 1/10, mcolor(zqc) mlabel(make) mlabtextstyle(zqt) title("T", tstyle(zqt))
    local s03_rc1 = ${w45s03_drc}
    _w45s03_dash "`s03d'" w45s03r scatter mpg weight in 1/10, mcolor("200 30 40") mlabel(make) mlabsize(huge) mlabcolor(red) title("T", size(huge) color(red))
    local s03_rc2 = ${w45s03_drc}
    _w45_expect Q4503-2 "(`s03_rc1' == 0 & `s03_rc2' == 0)" "dash rc `s03_rc1' `s03_rc2'"
    if !`s03_rc1' & !`s03_rc2' {
        python: import __main__ as _w45m; _w45m._w45s03_pair("`s03d'/w45s03p.json", "`s03d'/w45s03p_d.json", "`s03d'/w45s03r.json", "`s03d'/w45s03r_d.json", "`s03d'/a.py")
        mata: st_local("s03_nn", strofreal(st_global("w45s03_notes") == ""))
        mata: st_local("s03_nd", strofreal(st_global("w45s03_diff") == ""))
        _w45_expect Q4503-2 "(`s03_nn')" `"notes: ${w45s03_notes}"'
        _w45_expect Q4503-2 "(`s03_nd')" `"differs: ${w45s03_diff}"'
    }
    _w45_done Q4503-2 "color and textboxstyle files draw as their values in twoway and in dash, saved and served, with no note"

    quietly adopath - "`s03u'"
    capture dash clear
    macro drop w45s03_*
    foreach f in tw1.svg tw2.svg w45s03p.json w45s03p_d.json w45s03r.json w45s03r_d.json a.py {
        capture erase "`s03d'/`f'"
    }
    local s03_left : dir "`s03u'" files "*"
    foreach f of local s03_left {
        capture erase "`s03u'/`f'"
    }
    capture rmdir "`s03d'"
    capture rmdir "`s03u'"
    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

* ==== S03 ST-10: a shipped-name scheme before BASE ====
local only : env WP45_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w45_run' {
    display as text "S03 start " c(current_date) " " c(current_time)
    local s03d "`w45_work'/s03o"
    local s03u "`w45_work'/s03ou"
    capture mkdir "`s03d'"
    capture mkdir "`s03u'"
    tempname s03fh
    file open `s03fh' using "`s03u'/scheme-economist.scheme", write text replace
    file write `s03fh' "#include s2color" _n "color p1 red" _n
    file close `s03fh'
    quietly adopath ++ "`s03u'"
    discard    // twoway's style lists see the new files (see S03 ST-7)

    // ------------------------------------------------------------
    // Q4503-3: scheme-economist.scheme (#include s2color, color p1 red) in
    // a directory put before BASE: findfile returns it, twoway draws
    // s2color with red markers (live, SVG equality), and dash draws the
    // same as scheme(s2color) mcolor(red), saved and served.
    // ------------------------------------------------------------
    capture findfile scheme-economist.scheme
    local s03_fn "`r(fn)'"
    local s03_ok = (strpos(`"`s03_fn'"', "s03ou") > 0)
    _w45_expect Q4503-3 "(`s03_ok')" "findfile scheme-economist.scheme: `s03_fn'"
    _w45s03_tw "`s03d'" scatter mpg weight, scheme(economist) | scatter mpg weight, mcolor(red) scheme(s2color)
    local s03_ok = ("${w45s03_twrc}" == "0 0" & ${w45s03_same} == 1)
    _w45_expect Q4503-3 "(`s03_ok')" "twoway scheme(economist) before BASE: rc ${w45s03_twrc}, same ${w45s03_same}"
    _w45s03_dash "`s03d'" w45s03p scatter mpg weight, scheme(economist)
    local s03_rc1 = ${w45s03_drc}
    _w45s03_dash "`s03d'" w45s03r scatter mpg weight, mcolor(red) scheme(s2color)
    local s03_rc2 = ${w45s03_drc}
    _w45_expect Q4503-3 "(`s03_rc1' == 0 & `s03_rc2' == 0)" "dash rc `s03_rc1' `s03_rc2'"
    if !`s03_rc1' & !`s03_rc2' {
        python: import __main__ as _w45m; _w45m._w45s03_pair("`s03d'/w45s03p.json", "`s03d'/w45s03p_d.json", "`s03d'/w45s03r.json", "`s03d'/w45s03r_d.json", "`s03d'/a.py")
        mata: st_local("s03_nd", strofreal(st_global("w45s03_diff") == ""))
        _w45_expect Q4503-3 "(`s03_nd')" `"differs: ${w45s03_diff}"'
    }
    _w45_done Q4503-3 "a scheme-economist.scheme before BASE is used by twoway and by dash, saved and served"

    quietly adopath - "`s03u'"
    capture dash clear
    macro drop w45s03_*
    foreach f in tw1.svg tw2.svg w45s03p.json w45s03p_d.json w45s03r.json w45s03r_d.json a.py {
        capture erase "`s03d'/`f'"
    }
    capture erase "`s03u'/scheme-economist.scheme"
    capture rmdir "`s03d'"
    capture rmdir "`s03u'"
    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

* ==== S03 ST-17: scheme directives drawn ====
local only : env WP45_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w45_run' {
    display as text "S03 start " c(current_date) " " c(current_time)
    local s03d "`w45_work'/s03d"
    local s03u "`w45_work'/s03du"
    capture mkdir "`s03d'"
    capture mkdir "`s03u'"
    python: import __main__ as _w45m; _w45m._w45s03_files("`s03u'")
    quietly adopath ++ "`s03u'"
    discard    // twoway's style lists see the new files (see S03 ST-7)

    // ------------------------------------------------------------
    // Q4503-4: user schemes (#include s2color) with clockdir p 9,
    // textboxstyle title subheading or clockdir title_position 3: twoway
    // draws each as the option it stands for (live, SVG equality), and
    // dash draws each the same, saved and served, with no note.
    // ------------------------------------------------------------
    foreach pair in "scatter mpg weight in 1/10, mlabel(make) scheme(w45p)|scatter mpg weight in 1/10, mlabel(make) mlabposition(9) scheme(s2color)" ///
        `"scatter mpg weight, title("T") scheme(w45t)|scatter mpg weight, title("T", size(medium) color(black)) scheme(s2color)"' ///
        `"scatter mpg weight, title("T") scheme(w45c)|scatter mpg weight, title("T", position(3)) scheme(s2color)"' {
        local bar = strpos(`"`pair'"', "|")
        local pa = substr(`"`pair'"', 1, `bar' - 1)
        local pb = substr(`"`pair'"', `bar' + 1, .)
        _w45s03_tw "`s03d'" `macval(pa)' | `macval(pb)'
        local s03_ok = ("${w45s03_twrc}" == "0 0" & ${w45s03_same} == 1)
        _w45_expect Q4503-4 "(`s03_ok')" "twoway: rc ${w45s03_twrc}, same ${w45s03_same}"
        _w45s03_dash "`s03d'" w45s03p `macval(pa)'
        local s03_rc1 = ${w45s03_drc}
        _w45s03_dash "`s03d'" w45s03r `macval(pb)'
        local s03_rc2 = ${w45s03_drc}
        _w45_expect Q4503-4 "(`s03_rc1' == 0 & `s03_rc2' == 0)" "dash rc `s03_rc1' `s03_rc2'"
        if !`s03_rc1' & !`s03_rc2' {
            python: import __main__ as _w45m; _w45m._w45s03_pair("`s03d'/w45s03p.json", "`s03d'/w45s03p_d.json", "`s03d'/w45s03r.json", "`s03d'/w45s03r_d.json", "`s03d'/a.py")
            mata: st_local("s03_nn", strofreal(st_global("w45s03_notes") == ""))
            mata: st_local("s03_nd", strofreal(st_global("w45s03_diff") == ""))
            _w45_expect Q4503-4 "(`s03_nn')" `"notes: ${w45s03_notes}"'
            _w45_expect Q4503-4 "(`s03_nd')" `"differs: ${w45s03_diff}"'
        }
    }
    _w45_done Q4503-4 "clockdir p, textboxstyle title and clockdir title_position draw as twoway draws them, saved and served"

    quietly adopath - "`s03u'"
    capture dash clear
    macro drop w45s03_*
    foreach f in tw1.svg tw2.svg w45s03p.json w45s03p_d.json w45s03r.json w45s03r_d.json a.py {
        capture erase "`s03d'/`f'"
    }
    local s03_left : dir "`s03u'" files "*"
    foreach f of local s03_left {
        capture erase "`s03u'/`f'"
    }
    capture rmdir "`s03d'"
    capture rmdir "`s03u'"
    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

* ==== S03 ST-16: an unknown scheme() draws s2color with twoway's note ====
local only : env WP45_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w45_run' {
    display as text "S03 start " c(current_date) " " c(current_time)
    local s03d "`w45_work'/s03n"
    capture mkdir "`s03d'"

    // ------------------------------------------------------------
    // Q4503-5: scheme(nosuchscheme) and scheme(../nosuch) on a graph:
    // twoway draws s2color (live, SVG equality); dash prints twoway's
    // note alone, rc 0, and draws the page as scheme(s2color), saved and
    // served (the refusal and message cases are
    // test_option_validation.cscript's Q4503-5).
    // ------------------------------------------------------------
    foreach s03s in nosuchscheme ../nosuch {
        _w45s03_tw "`s03d'" scatter mpg weight, scheme(`s03s') | scatter mpg weight, scheme(s2color)
        local s03_ok = ("${w45s03_twrc}" == "0 0" & ${w45s03_same} == 1)
        _w45_expect Q4503-5 "(`s03_ok')" "twoway scheme(`s03s'): rc ${w45s03_twrc}, same ${w45s03_same}"
        capture log close _s03log
        quietly log using "`s03d'/dash.log", name(_s03log) text replace
        _w45s03_dash "`s03d'" w45s03p scatter mpg weight, scheme(`s03s')
        local s03_rc1 = ${w45s03_drc}
        quietly log close _s03log
        cert_file_count "`s03d'/dash.log", needle("(note: scheme `s03s' not found, using s2color)")
        local s03_nn = r(count)
        cert_file_count "`s03d'/dash.log", needle("(note:")
        local s03_na = r(count)
        _w45_expect Q4503-5 "(`s03_nn' == 1 & `s03_na' == 1)" "scheme(`s03s'): `s03_nn' twoway note(s), `s03_na' note(s) in all"
        _w45s03_dash "`s03d'" w45s03r scatter mpg weight, scheme(s2color)
        local s03_rc2 = ${w45s03_drc}
        _w45_expect Q4503-5 "(`s03_rc1' == 0 & `s03_rc2' == 0)" "dash rc `s03_rc1' `s03_rc2'"
        if !`s03_rc1' & !`s03_rc2' {
            python: import __main__ as _w45m; _w45m._w45s03_pair("`s03d'/w45s03p.json", "`s03d'/w45s03p_d.json", "`s03d'/w45s03r.json", "`s03d'/w45s03r_d.json", "`s03d'/a.py")
            mata: st_local("s03_nn", strofreal(st_global("w45s03_notes") == ""))
            mata: st_local("s03_nd", strofreal(st_global("w45s03_diff") == ""))
            _w45_expect Q4503-5 "(`s03_nn')" `"renderer notes: ${w45s03_notes}"'
            _w45_expect Q4503-5 "(`s03_nd')" `"differs: ${w45s03_diff}"'
        }
    }
    _w45_done Q4503-5 "an unknown or path-like scheme() draws s2color with twoway's note, saved and served"

    capture dash clear
    macro drop w45s03_*
    foreach f in tw1.svg tw2.svg dash.log w45s03p.json w45s03p_d.json w45s03r.json w45s03r_d.json a.py {
        capture erase "`s03d'/`f'"
    }
    capture rmdir "`s03d'"
    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

* ==== S03 ST-17: the boxes at a scheme's side clocks ====
local only : env WP45_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w45_run' {
    display as text "S03 start " c(current_date) " " c(current_time)
    local s03d "`w45_work'/s03b"
    local s03u "`w45_work'/s03bu"
    capture mkdir "`s03d'"
    capture mkdir "`s03u'"
    python: import __main__ as _w45m; _w45m._w45s03_files("`s03u'")
    quietly adopath ++ "`s03u'"
    discard    // twoway's style lists see the new files (see S03 ST-7)

    // ------------------------------------------------------------
    // Q4503-6: a user scheme's clockdir subtitle_position, note_position
    // and caption_position 3 and 9: twoway draws each box as its
    // position() form (live, SVG equality) and dash draws it the same,
    // beside the plot, saved and served, with no note.
    // ------------------------------------------------------------
    foreach b in subtitle note caption {
        local t = upper(substr("`b'", 1, 1))
        local k = substr("`b'", 1, 1)
        foreach c in 3 9 {
            _w45s03_tw "`s03d'" scatter mpg weight, `b'("`t'") scheme(w45`k'`c') | scatter mpg weight, `b'("`t'", position(`c')) scheme(s2color)
            local s03_ok = ("${w45s03_twrc}" == "0 0" & ${w45s03_same} == 1)
            _w45_expect Q4503-6 "(`s03_ok')" "twoway `b' at `c': rc ${w45s03_twrc}, same ${w45s03_same}"
            _w45s03_dash "`s03d'" w45s03p scatter mpg weight, `b'("`t'") scheme(w45`k'`c')
            local s03_rc1 = ${w45s03_drc}
            _w45s03_dash "`s03d'" w45s03r scatter mpg weight, `b'("`t'", position(`c')) scheme(s2color)
            local s03_rc2 = ${w45s03_drc}
            _w45_expect Q4503-6 "(`s03_rc1' == 0 & `s03_rc2' == 0)" "dash rc `s03_rc1' `s03_rc2': `b' at `c'"
            if !`s03_rc1' & !`s03_rc2' {
                python: import __main__ as _w45m; _w45m._w45s03_pair("`s03d'/w45s03p.json", "`s03d'/w45s03p_d.json", "`s03d'/w45s03r.json", "`s03d'/w45s03r_d.json", "`s03d'/a.py")
                mata: st_local("s03_nn", strofreal(st_global("w45s03_notes") == ""))
                mata: st_local("s03_nd", strofreal(st_global("w45s03_diff") == ""))
                _w45_expect Q4503-6 "(`s03_nn')" `"`b' at `c' notes: ${w45s03_notes}"'
                _w45_expect Q4503-6 "(`s03_nd')" `"`b' at `c' differs: ${w45s03_diff}"'
            }
        }
    }
    _w45_done Q4503-6 "a scheme's subtitle, note and caption at 3 and 9 o'clock draw beside the plot as twoway draws them, saved and served"

    quietly adopath - "`s03u'"
    capture dash clear
    macro drop w45s03_*
    foreach f in tw1.svg tw2.svg w45s03p.json w45s03p_d.json w45s03r.json w45s03r_d.json a.py {
        capture erase "`s03d'/`f'"
    }
    local s03_left : dir "`s03u'" files "*"
    foreach f of local s03_left {
        capture erase "`s03u'/`f'"
    }
    capture rmdir "`s03d'"
    capture rmdir "`s03u'"
    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

* ==== S03 ST-17: a grid legend's column gap ====
local only : env WP45_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w45_run' {
    display as text "S03 start " c(current_date) " " c(current_time)
    local s03d "`w45_work'/s03g"
    local s03u "`w45_work'/s03gu"
    capture mkdir "`s03d'"
    capture mkdir "`s03u'"
    python: import __main__ as _w45m; _w45m._w45s03_files("`s03u'")
    quietly adopath ++ "`s03u'"
    discard    // twoway's style lists see the new files (see S03 ST-7)

    // ------------------------------------------------------------
    // Q4503-7: a 2 x 2 legend.  twoway draws a scheme's legend_col_gap
    // huge as colgap(huge) (live, SVG equality); dash gives the legend's
    // grid twoway's column gap -- 18.67 px under s2color, 26.67 px under
    // colgap(huge) or legend_col_gap huge, from D_grid_gap's key x at 96
    // px an inch -- within 1 px, saved and served, the row gap unchanged.
    // ------------------------------------------------------------
    local s03l "(scatter mpg weight) (scatter price weight) (scatter turn weight) (scatter trunk weight)"
    _w45s03_tw "`s03d'" `s03l', legend(cols(2)) scheme(w45g) | `s03l', legend(cols(2) colgap(huge)) scheme(s2color)
    local s03_ok = ("${w45s03_twrc}" == "0 0" & ${w45s03_same} == 1)
    _w45_expect Q4503-7 "(`s03_ok')" "twoway legend_col_gap huge vs colgap(huge): rc ${w45s03_twrc}, same ${w45s03_same}"
    local s03_rows ""
    foreach pair in "s2color|cols(2)|18.67" "s2color|cols(2) colgap(huge)|26.67" "w45g|cols(2)|26.67" {
        gettoken s03s rest : pair, parse("|")
        local rest = substr("`rest'", 2, .)
        gettoken s03g s03w : rest, parse("|")
        local s03w = substr("`s03w'", 2, .)
        _w45s03_dash "`s03d'" w45s03p scatter mpg price turn trunk weight, legend(`s03g') scheme(`s03s')
        _w45_expect Q4503-7 "(${w45s03_drc} == 0)" "dash rc ${w45s03_drc}: `s03s' `s03g'"
        if !${w45s03_drc} {
            python: import __main__ as _w45m; _w45m._w45s03_colgap("`s03d'/w45s03p.json", "`s03d'/w45s03p_d.json", "`s03d'/a.py")
            local s03_ok = (abs(${w45s03_cg1} - `s03w') <= 1 & abs(${w45s03_cg2} - `s03w') <= 1)
            _w45_expect Q4503-7 "(`s03_ok')" "`s03s' `s03g': column gap saved ${w45s03_cg1}, served ${w45s03_cg2}, twoway `s03w'"
            local s03_rows "`s03_rows' ${w45s03_rg1} ${w45s03_rg2}"
        }
    }
    local s03_rows : list uniq s03_rows
    _w45_expect Q4503-7 "(`: word count `s03_rows'' == 1)" "row gaps: `s03_rows'"
    _w45_done Q4503-7 "a grid legend's column gap is twoway's, saved and served, the row gap unchanged"

    quietly adopath - "`s03u'"
    capture dash clear
    macro drop w45s03_*
    foreach f in tw1.svg tw2.svg w45s03p.json w45s03p_d.json a.py {
        capture erase "`s03d'/`f'"
    }
    local s03_left : dir "`s03u'" files "*"
    foreach f of local s03_left {
        capture erase "`s03u'/`f'"
    }
    capture rmdir "`s03d'"
    capture rmdir "`s03u'"
    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

// ---- S04 helpers (WP-45 section 45-04) ----
// _w45s04_dash dir name cmd: `dash <cmd> name(<name>)' on auto, its spec
// and data written to dir (rc in w45s04_drc).  _w45s04_models(sp, dp,
// app): the saved page's models and the served app's, each built from
// one spec.  _w45s04_fxy(...): Q4504-1's readings (globals w45s04_*).
capture program drop _w45s04_dash
program define _w45s04_dash
    version 19
    gettoken dir 0 : 0
    gettoken nm 0 : 0
    quietly sysuse auto, clear
    quietly sort weight mpg make
    capture dash clear
    capture noisily dash `macval(0)' name(`nm')
    global w45s04_drc = _rc
    if !_rc {
        capture erase "`dir'/`nm'.json"
        capture erase "`dir'/`nm'_d.json"
        _dash_serve_spec, specpath("`dir'/`nm'.json") datapath("`dir'/`nm'_d.json")
    }
end

python:
import os as _w45s04_os, sys as _w45s04_sys
for _w45s04_p in (_w45s04_os.path.abspath(".."),
                  _w45s04_os.path.abspath(_w45s04_os.path.join("..", "scripts"))):
    if _w45s04_p not in _w45s04_sys.path:
        _w45s04_sys.path.insert(0, _w45s04_p)


def _w45s04_models(sp, dp, app):
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_w45s04_app")
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_w45s04_app.py",
                     "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    return list(r._last_layout_root.references()), list(doc.models)


def _w45s04_fxy(sp, dp, app, probe):
    """Q4504-1: twoway's box for *probe* (figure_geometry_truth.json: the
    plot and its axes, or the by() array, in nominal px of the 7.5-inch
    graph's 720) and each mode's: a lone figure's fxy follow box, a by()
    graph's fit hook box; and whether a by() graph's region keeps the
    graph's shape (aspect-ratio 7.5 / 4.5, centred).  Globals w45s04_tw,
    w45s04_got (saved served), w45s04_shape."""
    import json
    from sfi import Macro
    import dash_render as dr
    with open(_w45s04_os.path.join("fixtures", "figure_geometry_truth.json"),
              encoding="utf-8") as fh:
        t = json.load(fh)["probes"]
    base = {"G_fx50": ("G_stcolor", "x", 0), "G_fy50": ("G_stcolor", "y", 0),
            "G_fx50_by": ("G_by_stcolor", "x", 3),
            "G_fy50_by": ("G_by_stcolor", "y", 7)}[probe]
    def plots(pid):
        if base[2]:
            return [t[pid]["rects"][base[2]]]
        return [r for r in t[pid]["rects"] if r["fill"] == "#ffffff"
                and r["stroke"] is None and r["w"] < 5400]
    rects, brects = plots(probe), plots(base[0])
    k = base[1]
    # The box's start: the plot region (strip) less what the default graph
    # draws between the margin and it; centred, the box is the canvas less
    # twice that start.
    start = rects[0][k] - (brects[0][k] - 113.4)
    side = 5400.0 if k == "x" else 3240.0
    Macro.setGlobal("w45s04_tw", "%.1f" % ((side - 2 * start) / 5400.0 * 720))
    got, shape = [], []
    for models in _w45s04_models(sp, dp, app):
        figs = [m for m in models if type(m).__name__ == "figure"]
        if probe.endswith("_by"):
            cbs = [cb for f in figs for cbl in f.js_property_callbacks.values()
                   for cb in cbl if cb.code == dr._DASH_BY_FIT_JS]
            a = cbs[0].args if cbs else {}
            got.append("%s" % (a.get("fx_px") if k == "x" else
                               round(float(a.get("fy_px") or 0) + 5.0625)))
            reg = [m for m in models if "dash_graph_region"
                   in (getattr(m, "tags", None) or [])]
            st = dict(reg[0].styles or {}) if reg else {}
            shape.append(str(st.get("aspect-ratio") == "7.5 / 4.5"
                             and st.get("justify-content") == "center"))
        else:
            it = getattr(figs[0], "_dash_gm_item", None) or {}
            x = it.get("fxy") or {}
            v = x.get("fx") if k == "x" else x.get("fy")
            got.append("%.1f" % (float(v) / 100 * float(x.get("ref", 4)) * 96)
                       if v is not None else "none")
            shape.append("True")
    Macro.setGlobal("w45s04_got", " ".join(got))
    Macro.setGlobal("w45s04_shape", " ".join(shape))


def _w45s04_region(sp, dp, app, probe):
    """Q4504-3: twoway's graph-region line (its colour, and that it lies
    half its width in from the edge) and, for G_xs44, its margin in px of
    the 384 px box; each mode's graph region box: its outline colour and
    whether it is drawn inside (offset minus its width), and its padding.
    Globals w45s04_tw, w45s04_got (one per mode, | between)."""
    import json, re
    from sfi import Macro
    with open(_w45s04_os.path.join("fixtures", "figure_geometry_truth.json"),
              encoding="utf-8") as fh:
        t = json.load(fh)["probes"][probe]
    line = [r for r in t["rects"] if r["fill"] == "none"][0]
    inside = abs(line["x"] - line["sw"] / 2) < 0.01
    tw = "%s inside=%s" % (line["stroke"], inside)
    if probe == "G_xs44":
        plot = [r for r in t["rects"] if r["fill"] == "#ffffff"
                and r["stroke"] is None and r["w"] < 2880][0]
        tw += " margin=%.2f" % (plot["y"] / 2880.0 * 384.0)
    Macro.setGlobal("w45s04_tw", tw)
    got = []
    for models in _w45s04_models(sp, dp, app):
        box = [m for m in models if "dash_graph_region"
               in (getattr(m, "tags", None) or [])]
        st = dict(box[0].styles or {}) if box else {}
        m = re.match(r"calc\(var\(--dash-k, [0-9.]+\) \* ([0-9.]+)px\) "
                     r"solid (#[0-9a-f]{6})$", str(st.get("outline", "")))
        o = re.match(r"calc\(var\(--dash-k, [0-9.]+\) \* (-?[0-9.]+)px\)$",
                     str(st.get("outline-offset", "")))
        g = "%s inside=%s" % (m.group(2) if m else "none",
                              bool(m and o and abs(float(o.group(1))
                                                   + float(m.group(1)))
                                   < 1e-9))
        if probe == "G_xs44":
            pad = str(st.get("padding", "")).split()
            g += " margin=%s" % (pad[0][:-2] if pad else "none")
        got.append(g)
    Macro.setGlobal("w45s04_got", "|".join(got))
end

* ==== S04 VF-4: fxsize() and fysize() at the scheme's reference side ====
local only : env WP45_ONLY
if inlist("`only'", "", "S04") & `: list posof "S04" in w45_run' {
    display as text "S04 start " c(current_date) " " c(current_time)
    local s04d "`w45_work'/s04"
    capture mkdir "`s04d'"

    // ------------------------------------------------------------
    // Q4504-1: twoway's fxsize(50) and fysize(50) under stcolor draw the
    // plot and its axes (a by() graph's array) in 2.25 of the 4.5-inch
    // reference side, centred (figure_geometry_truth.json G_fx50, G_fy50,
    // G_fx50_by, G_fy50_by: 216 nominal px of 720); dash's box is the
    // same in each mode, and a by() graph's region keeps the 7.5 x 4.5
    // shape round the centred array.  (The by() fysize() box less the
    // first row's 5.06 nominal px by_indiv top margin, which the region's
    // padding holds, is read back with it added.)
    // ------------------------------------------------------------
    foreach pr in "G_fx50|fxsize(50)" "G_fy50|fysize(50)" "G_fx50_by|by(foreign) fxsize(50)" "G_fy50_by|by(foreign) fysize(50)" {
        gettoken s04p s04o : pr, parse("|")
        local s04o = substr("`s04o'", 2, .)
        _w45s04_dash "`s04d'" w45s04p scatter mpg weight, `s04o' scheme(stcolor)
        _w45_expect Q4504-1 "(${w45s04_drc} == 0)" "dash rc ${w45s04_drc}: `s04o'"
        if !${w45s04_drc} {
            python: import __main__ as _w45m; _w45m._w45s04_fxy("`s04d'/w45s04p.json", "`s04d'/w45s04p_d.json", "`s04d'/a.py", "`s04p'")
            local s04_ok 1
            foreach g of global w45s04_got {
                if abs(real("`g'") - ${w45s04_tw}) > 1 local s04_ok 0
            }
            _w45_expect Q4504-1 "(`s04_ok' & `: word count ${w45s04_got}' == 2)" "`s04o': box saved/served ${w45s04_got}, twoway ${w45s04_tw}"
            _w45_expect Q4504-1 `"("${w45s04_shape}" == "True True")"' "`s04o': the graph region keeps the graph's shape: ${w45s04_shape}"
        }
    }
    _w45_done Q4504-1 "fxsize()/fysize() draw twoway's box at the scheme's reference side, a by() array centred, saved and served"

    capture dash clear
    macro drop w45s04_*
    foreach f in w45s04p.json w45s04p_d.json a.py {
        capture erase "`s04d'/`f'"
    }
    capture rmdir "`s04d'"
    display as text "S04 end " c(current_date) " " c(current_time)
}
* ==== end S04 ====

* ==== S04 GW-6: the graph region's outline and a box's margin ====
local only : env WP45_ONLY
if inlist("`only'", "", "S04") & `: list posof "S04" in w45_run' {
    display as text "S04 start " c(current_date) " " c(current_time)
    local s04d "`w45_work'/s04g"
    capture mkdir "`s04d'"

    // ------------------------------------------------------------
    // Q4504-3: twoway strokes the graph region's outline unasked, half
    // its width in from the edge, in the scheme's line (M_stcolor), kept
    // under graphregion(fcolor(red)) (M_stcolor_red), red under
    // lcolor(red) (I_gla), round a by() array (M_by_stcolor) and a box
    // (G_xs44), whose 13.44 px margin it draws inside the box; dash's
    // graph region box is the same in each mode.
    // ------------------------------------------------------------
    foreach pr in "M_stcolor|" "M_stcolor_red|graphregion(fcolor(red))" "I_gla|graphregion(lalign(inside) lcolor(red) lwidth(thick))" "M_by_stcolor|by(foreign)" "G_xs44|xsize(4) ysize(4)" {
        gettoken s04p s04o : pr, parse("|")
        local s04o = substr("`s04o'", 2, .)
        _w45s04_dash "`s04d'" w45s04q scatter mpg weight, `s04o' scheme(stcolor)
        _w45_expect Q4504-3 "(${w45s04_drc} == 0)" "dash rc ${w45s04_drc}: `s04o'"
        if !${w45s04_drc} {
            python: import __main__ as _w45m; _w45m._w45s04_region("`s04d'/w45s04q.json", "`s04d'/w45s04q_d.json", "`s04d'/a.py", "`s04p'")
            local s04_ok = (`"${w45s04_got}"' == `"${w45s04_tw}|${w45s04_tw}"')
            _w45_expect Q4504-3 "(`s04_ok')" "`s04p': saved|served ${w45s04_got}, twoway ${w45s04_tw}"
        }
    }
    _w45_done Q4504-3 "the graph region's outline and a box's margin are twoway's, saved and served"

    // ------------------------------------------------------------
    // Q4504-5: twoway takes plotregion(lalign()) at inside, center and
    // outside, rc 0, and draws it (figure_geometry_truth.json I_pli,
    // I_plc, I_pla); dash takes each, rc 0, and names it in no note
    // (WP-45 ST-21 residual: inside drawn inside the plot region's edge,
    // center on it, outside on it, a documented difference).
    // ------------------------------------------------------------
    sysuse auto, clear
    foreach al in inside center outside {
        capture quietly twoway scatter mpg weight, plotregion(lalign(`al') lcolor(red) lwidth(thick)) name(w45s04l, replace)
        local s04_trc = _rc
        dash clear
        capture log close q4504l
        quietly log using "`s04d'/l.log", text replace name(q4504l)
        capture noisily dash scatter mpg weight, plotregion(lalign(`al') lcolor(red) lwidth(thick)) name(w45s04l)
        local s04_drc = _rc
        quietly log close q4504l
        cert_log_has "`s04d'/l.log", needle("plotregion() sub-option")
        local s04_n = r(found)
        _w45_expect Q4504-5 "(`s04_trc' == 0 & `s04_drc' == 0 & !`s04_n')" "lalign(`al'): twoway rc `s04_trc', dash rc `s04_drc', named `s04_n'"
    }
    _w45_done Q4504-5 "plotregion(lalign()) is rc 0 in both and named in no note"
    capture graph drop w45s04l
    capture erase "`s04d'/l.log"

    capture dash clear
    macro drop w45s04_*
    foreach f in w45s04q.json w45s04q_d.json a.py {
        capture erase "`s04d'/`f'"
    }
    capture rmdir "`s04d'"
    display as text "S04 end " c(current_date) " " c(current_time)
}
* ==== end S04 ====

// ---- S05 helpers (WP-45 section 45-05) ----
// _w45s05_models(sp, dp, app): the saved page's models and the served
// app's, each built from one spec (test_wp43_truth.cscript's
// _q4301_models).
python:
import os as _w45s05_os, sys as _w45s05_sys
for _w45s05_p in (_w45s05_os.path.abspath(".."),
                  _w45s05_os.path.abspath(_w45s05_os.path.join("..", "scripts"))):
    if _w45s05_p not in _w45s05_sys.path:
        _w45s05_sys.path.insert(0, _w45s05_p)


def _w45s05_models(sp, dp, app):
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_w45s05_app")
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_w45s05_app.py",
                     "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    return list(r._last_layout_root.references()), list(doc.models)


def _w45s05_rows(part, size):
    """The I_ rows of the fixture, in order, part *part* (1-based) of
    *size* rows (a graph draws at most 100 plots): their keys and an
    mcolor() list of their values (a quoted element for an RGB colour);
    w45s05_all is the number of rows."""
    import json
    from sfi import Macro
    with open(_w45s05_os.path.join("fixtures", "colour_edges_truth.json"),
              encoding="utf-8") as fh:
        rows = json.load(fh)["rows"]
    keys = [k for k in sorted(rows) if k.startswith("I_")]
    Macro.setGlobal("w45s05_all", str(len(keys)))
    keys = keys[(part - 1) * size:part * size]
    Macro.setGlobal("w45s05_n", str(len(keys)))
    Macro.setGlobal("w45s05_keys", " ".join(keys))
    Macro.setGlobal("w45s05_list", " ".join(rows[k]["value"] for k in keys))


def _w45s05_fills(sp, dp, app):
    """Each mode's marker fill per series (its legend label v<i>) against
    the fixture: the mismatches in global w45s05_bad."""
    import json
    from sfi import Macro
    from bokeh.models import Legend
    with open(_w45s05_os.path.join("fixtures", "colour_edges_truth.json"),
              encoding="utf-8") as fh:
        rows = json.load(fh)["rows"]
    keys = Macro.getGlobal("w45s05_keys").split()
    bad = []
    for models, mode in zip(_w45s05_models(sp, dp, app), ("saved", "served")):
        got = {}
        for lg in (m for m in models if isinstance(m, Legend)):
            for it in lg.items:
                lab = it.label.get("value") if isinstance(it.label, dict) else it.label
                lab = str(getattr(lab, "value", lab))
                if it.renderers:
                    got[lab] = str(it.renderers[0].glyph.fill_color).lower()
        for i, k in enumerate(keys, 1):
            g = got.get("v%d" % i)
            if g != rows[k]["fill"]:
                bad.append("%s %s: %s %s, twoway %s" % (
                    mode, k, rows[k]["value"], g, rows[k]["fill"]))
    Macro.setGlobal("w45s05_bad", "; ".join(bad[:8]))
    Macro.setGlobal("w45s05_nbad", str(len(bad)))
def _w45s05_face(sp, dp, app, svg, face):
    """Q4505-3: the spec's build option fontface, twoway's SVG title face,
    and the page's title face in each mode, under the faces in force; then
    the same spec with fontface injected as Courier (no graph set): the
    title is Courier in each mode.  Results in globals w45s05_f*."""
    import json
    from sfi import Macro
    from bokeh.models import Title
    from svg_truth import svg_document
    with open(sp, encoding="utf-8") as fh:
        spec = json.load(fh)
    bo = spec.get("build_options", {})
    Macro.setGlobal("w45s05_fbo", str(bo.get("fontface", "<none>")))
    t = [x for x in svg_document(svg)["texts"] if x["text"] == "T"]
    fam = (t[0].get("font_family") or "") if t else "<none>"
    Macro.setGlobal("w45s05_fsvg", fam.strip().strip("'\""))

    def title_fonts(path):
        out = []
        for models in _w45s05_models(path, dp, app):
            out.append(";".join(sorted({
                str(getattr(m.text_font, "value", m.text_font))
                for m in models if isinstance(m, Title)
                and str(m.text or "") == "T"})))
        return out

    Macro.setGlobal("w45s05_fpage", "|".join(title_fonts(sp)))
    bo["fontface"] = "Courier"
    spec["build_options"] = bo
    sp2 = sp[:-5] + "_courier.json"
    with open(sp2, "w", encoding="utf-8") as fh:
        json.dump(spec, fh)
    Macro.setGlobal("w45s05_finj", "|".join(title_fonts(sp2)))
end

* ==== S05 ST-22: colour intensity and blank elements ====
local only : env WP45_ONLY
if inlist("`only'", "", "S05") & `: list posof "S05" in w45_run' {
    display as text "S05 start " c(current_date) " " c(current_time)
    local s05d "`w45_work'/s05"
    capture mkdir "`s05d'"

    // ------------------------------------------------------------
    // Q4505-1: dash draws each I_ row's colour (seven colours at
    // seventeen intensities, navy*52 among them) in twoway's hex, saved
    // and served: one graph, a series per row, mcolor() a style list of
    // the rows' values (test/fixtures/colour_edges_truth.json).
    // ------------------------------------------------------------
    local s05_seen 0
    forvalues part = 1/2 {
        python: import __main__ as _w45m; _w45m._w45s05_rows(`part', 60)
        sysuse auto, clear
        local s05_y ""
        forvalues i = 1/$w45s05_n {
            quietly generate v`i' = mpg
            local s05_y "`s05_y' v`i'"
        }
        dash clear
        capture noisily dash scatter `s05_y' weight, mcolor($w45s05_list) name(w45s05)
        local s05_rc = _rc
        _w45_expect Q4505-1 "(`s05_rc' == 0)" "part `part': dash rc `s05_rc'"
        if !`s05_rc' {
            _dash_serve_spec, specpath("`s05d'/s.json") datapath("`s05d'/d.json")
            python: import __main__ as _w45m; _w45m._w45s05_fills("`s05d'/s.json", "`s05d'/d.json", "`s05d'/a.py")
            _w45_expect Q4505-1 "(${w45s05_nbad} == 0)" "part `part': ${w45s05_nbad} fill(s) differ: ${w45s05_bad}"
            local s05_seen = `s05_seen' + ${w45s05_n}
        }
    }
    _w45_expect Q4505-1 "(`s05_seen' == ${w45s05_all})" "`s05_seen' of ${w45s05_all} rows compared"
    _w45_done Q4505-1 "dash's fills equal twoway's on `s05_seen' colours with an intensity, saved and served"
    macro drop w45s05_n w45s05_all w45s05_keys w45s05_list w45s05_bad w45s05_nbad
    capture dash clear
    foreach f in s.json d.json a.py {
        capture erase "`s05d'/`f'"
    }
    capture rmdir "`s05d'"
    display as text "S05 end " c(current_date) " " c(current_time)
}
* ==== end S05 ====

* ==== S05 GW-10: plain-text font face ====
local only : env WP45_ONLY
if inlist("`only'", "", "S05") & `: list posof "S05" in w45_run' {
    display as text "S05 start " c(current_date) " " c(current_time)
    local s05d "`w45_work'/s05f"
    capture mkdir "`s05d'"

    // ------------------------------------------------------------
    // Q4505-3: dash's build options carry translator query gph2svg's
    // fontface, the face twoway's SVG draws an untagged title in under the
    // faces in force, and the page's untagged title begins with it, saved
    // and served; an injected fontface Courier (no graph set is run)
    // draws that title in Courier in both modes.
    // ------------------------------------------------------------
    quietly translator query gph2svg
    local s05_face `"`r(fontface)'"'
    sysuse auto, clear
    quietly twoway scatter mpg weight, title("T") name(w45s05f, replace)
    cert_svg_export, name(w45s05f) file("`s05d'/t.svg")
    dash clear
    capture noisily dash scatter mpg weight, title("T") name(w45s05f)
    local s05_rc = _rc
    _w45_expect Q4505-3 "(`s05_rc' == 0)" "dash rc `s05_rc'"
    if !`s05_rc' {
        _dash_serve_spec, specpath("`s05d'/s.json") datapath("`s05d'/d.json")
        python: import __main__ as _w45m; _w45m._w45s05_face("`s05d'/s.json", "`s05d'/d.json", "`s05d'/a.py", "`s05d'/t.svg", __import__("sfi").Macro.getLocal("s05_face"))
        _w45_expect Q4505-3 `"("${w45s05_fbo}" == `"`s05_face'"')"' "build option fontface ${w45s05_fbo}, translator query `s05_face'"
        _w45_expect Q4505-3 `"(lower("${w45s05_fsvg}") == lower(`"`s05_face'"'))"' "twoway's SVG title face ${w45s05_fsvg}, translator query `s05_face'"
        mata: _w45s05_t = tokens(st_global("w45s05_fpage"), "|"); _w45s05_t = select(_w45s05_t, _w45s05_t :!= "|")
        mata: st_local("s05_ok", strofreal(cols(_w45s05_t) == 2 && all(strpos(strlower(_w45s05_t), strlower(st_local("s05_face"))) :== 1)))
        _w45_expect Q4505-3 "(`s05_ok')" "the page's title faces ${w45s05_fpage} do not begin with `s05_face'"
        mata: _w45s05_t = tokens(st_global("w45s05_finj"), "|"); _w45s05_t = select(_w45s05_t, _w45s05_t :!= "|")
        mata: st_local("s05_ok", strofreal(cols(_w45s05_t) == 2 && all(strpos(_w45s05_t, "Courier") :== 1)))
        _w45_expect Q4505-3 "(`s05_ok')" "with fontface Courier injected the title faces are ${w45s05_finj}"
    }
    _w45_done Q4505-3 "the svg plain-text face (`s05_face') is read and leads the page's untagged text, saved and served"
    macro drop w45s05_fbo w45s05_fsvg w45s05_fpage w45s05_finj
    capture mata: mata drop _w45s05_t
    capture dash clear
    capture graph drop w45s05f
    foreach f in s.json s_courier.json d.json a.py t.svg {
        capture erase "`s05d'/`f'"
    }
    capture rmdir "`s05d'"
    display as text "S05 end " c(current_date) " " c(current_time)
}
* ==== end S05 ====

* ==== append new blocks above this line ====

// ----------------------------------------------------------------
// Summary (test_wp29_truth.cscript's shape)
// ----------------------------------------------------------------
capture graph drop _all
capture dash clear
capture rmdir "`w45_work'"
local nfail    = ${w45_nfail}
local faillist "${w45_faillist}"
local ncase    = ${w45_ncase}
local only : env WP45_ONLY
macro drop w45_nfail w45_faillist w45_bad w45_ncase
display as text ""
display as text "============================================================"
if `ncase' == 0 {
    if `w45_N' > 1 & `"`macval(only)'"' == "" & "`w45_run'" == "" {
        display as text "test_wp45_truth: part `w45_k'/`w45_N' has no block to run"
        display as text "============================================================"
        exit 0
    }
    // A WP45_ONLY that names no block, or only a stub, ran nothing:
    // that is not a pass.
    display as error "  test_wp45_truth: no case ran (WP45_ONLY=`only')"
    display as text "============================================================"
    exit 9
}
else if `nfail' == 0 {
    display as text "  test_wp45_truth: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_wp45_truth: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
