*! test_parser_integrity.cscript  v1.0
*! Certification script for the dash_parse.mata scanners' quote handling.
*!
*! Every scanner in dash_parse.mata walks the raw command text with its own
*! copy of a quote state machine.  Three of those copies were wrong, and each
*! one silently changed what the user asked for:
*!
*!   A6  _dash_split_segs flat mode and _dash_first_comma_pos gated their
*!       quote-ENTRY branches on `depth == 0'.  Paren mode did not.  So a '('
*!       inside a quoted option value permanently unbalanced `depth' and every
*!       later '||' stopped being a separator:
*!           dash scatter mpg weight, title("a ( b") || line mpg weight
*!       registered ONE plot, reported four options that do not exist, and
*!       returned rc 0.  Real twoway draws both plots.
*!
*!   A7  _dash_extract_filters had no quote tracking at all, so the word
*!       `filter(' inside a quoted title was harvested as a real filter widget
*!       AND cut out of the user's text:
*!           dash build, title("Q1 filter(foreign) report")
*!       rendered the title as "Q1 report", with rc 0 and no warning.
*!
*!   A8  Neither mode checked its state at end of scan, so an unclosed '(' or
*!       an unterminated '"' yielded one segment and no message.
*!
*! Tests: P1B-01 through P1B-47
*!
*! P1B-31 to P1B-38 were added by ROADMAP WP-24, which reverted each part of
*! 9c7dbf7 in a scratch copy of the tree and ran this script against it
*! (24sep2026).  Three parts of the fix had no case that failed when they were
*! taken out, because every earlier case put its quote where the old code
*! handled it anyway: _dash_first_comma_pos meets a quote only BEFORE the option
*! comma (P1B-31, P1B-32, P1B-38), _dash_extract_filters needs its quote
*! tracking only when a ')' inside a quote would close the option around it
*! (P1B-33), and its inner matcher only for an unbalanced '(' inside the
*! filter's own quoted label (P1B-34).  P1B-35 to P1B-37 hold AC-01.1, AC-01.3
*! and AC-01.4 as ROADMAP writes them, through dash itself: the cases above
*! call the scanners, and P1B-13 asks only for a non-zero return code
*! where the criteria ask for r(198) and a message (P1B-16, flipped by
*! WP-35 syn:SD-1, reads the text after a group as one more plot).
*!
*! P1B-39 to P1B-47 (24sep2026) hold every scanner that shares
*! _dash_quote_step to Stata's nesting of compound quotes -- `"a `"b"' c"'
*! is one string -- and dash to twoway's acceptance of a nested title and
*! qualifier literal; P1B-46 and P1B-47 are CLAUDE.md rule 18's injection
*! and exhaustion cases for it (a nested string holding || and filter(,
*! an unbalanced one, and 10,000 levels).
*!
*! Usage:  do test/test_parser_integrity.cscript
*! Version: 1.1  24sep2026

cscript "dash_parse.mata scanner quote handling" adodir ".."
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}

// ----------------------------------------------------------------
// Setup
// ----------------------------------------------------------------
qui sysuse auto, clear
do "../dash_parse.mata"


// ================================================================
// A6 — quotes are tracked at ANY paren depth
// ================================================================

// ----------------------------------------------------------------
// P1B-01 — control: no paren in the quoted value, two segments
// ----------------------------------------------------------------
mata:
{
    _dash_split_segs(`"scatter mpg weight, title("a b") || line mpg weight"')
}
end
assert "`_n_segs'" == "2"
assert `"`_seg_2'"' == "line mpg weight"
display "P1B-01 PASS: control — quoted value without a paren splits on ||"

// ----------------------------------------------------------------
// P1B-02 — an opening paren inside a quoted value must not eat the ||
// ----------------------------------------------------------------
mata:
{
    _dash_split_segs(`"scatter mpg weight, title("a ( b") || line mpg weight"')
}
end
assert "`_n_segs'" == "2"
assert `"`_seg_2'"' == "line mpg weight"
display "P1B-02 PASS: '(' inside a quoted value does not swallow the next segment"

// ----------------------------------------------------------------
// P1B-03 — a closing paren inside a quoted value is equally inert
// ----------------------------------------------------------------
mata:
{
    _dash_split_segs(`"scatter mpg weight, title("a ) b") || line mpg weight"')
}
end
assert "`_n_segs'" == "2"
assert `"`_seg_2'"' == "line mpg weight"
display "P1B-03 PASS: ')' inside a quoted value does not unbalance the scan"

// ----------------------------------------------------------------
// P1B-04 — the quoted value is nested one paren deep (the legend idiom)
// ----------------------------------------------------------------
mata:
{
    _dash_split_segs(`"scatter mpg weight, legend(label(1 "a ( b")) || line mpg weight"')
}
end
assert "`_n_segs'" == "2"
assert `"`_seg_2'"' == "line mpg weight"
display "P1B-04 PASS: '(' inside a quote nested in parens is inert"

// ----------------------------------------------------------------
// P1B-05 — a balanced pair inside a quoted value leaves depth alone
// ----------------------------------------------------------------
mata:
{
    _dash_split_segs(`"scatter mpg weight, note("x (y) z") || line mpg weight"')
}
end
assert "`_n_segs'" == "2"
display "P1B-05 PASS: a balanced paren pair inside a quote is inert"

// ----------------------------------------------------------------
// P1B-06 — '||' inside a quoted value is NOT a separator, at any depth
// ----------------------------------------------------------------
mata:
{
    _dash_split_segs(`"scatter mpg weight, title("a || b")"')
}
end
assert "`_n_segs'" == "1"
display "P1B-06 PASS: '||' inside a quoted value is not a separator"

mata:
{
    _dash_split_segs(`"scatter mpg weight, legend(label(1 "a || b"))"')
}
end
assert "`_n_segs'" == "1"
display "P1B-06b PASS: '||' inside a quote nested in parens is not a separator"

// ----------------------------------------------------------------
// P1B-07 — paren mode already worked; it must keep working
// ----------------------------------------------------------------
mata:
{
    _dash_split_segs(`"(scatter mpg weight, title("a ( b")) (line mpg weight)"')
}
end
assert "`_n_segs'" == "2"
assert `"`_seg_2'"' == "line mpg weight"
display "P1B-07 PASS: paren mode unchanged by the flat-mode fix"

// ----------------------------------------------------------------
// P1B-08 — compound quotes carrying a paren
// ----------------------------------------------------------------
mata:
{
    _dash_split_segs(`"scatter mpg weight, title(`"a ( b"') || line mpg weight"')
}
end
assert "`_n_segs'" == "2"
assert `"`_seg_2'"' == "line mpg weight"
display "P1B-08 PASS: '(' inside a compound-quoted value is inert"


// ================================================================
// A6 — _dash_first_comma_pos carries the identical defect
// ================================================================

// ----------------------------------------------------------------
// P1B-09 — control: a comma inside a plain quoted value is not top-level
// ----------------------------------------------------------------
local cp1 = 0
mata: _dash_comma_pos(`"scatter mpg weight, title("a, b")"', "cp1")
assert `cp1' == 19
display "P1B-09 PASS: control — comma inside a quote is not the top-level comma"

// ----------------------------------------------------------------
// P1B-10 — a comma inside a quote that also holds a paren
// ----------------------------------------------------------------
local cp2 = 0
mata: _dash_comma_pos(`"scatter mpg weight, title("a, ( b")"', "cp2")
assert `cp2' == 19
display "P1B-10 PASS: comma inside a quote containing '(' is not top-level"

// ----------------------------------------------------------------
// P1B-11 — the whole quoted value looks like a paren group
// ----------------------------------------------------------------
local cp3 = 0
mata: _dash_comma_pos(`"scatter mpg weight, title("(a, b)")"', "cp3")
assert `cp3' == 19
display "P1B-11 PASS: a quoted value shaped like a paren group is still opaque"

// ----------------------------------------------------------------
// P1B-12 — a comma genuinely inside parens is still not top-level
// ----------------------------------------------------------------
local cp4 = 0
mata: _dash_comma_pos("scatter mpg weight, mc(red,blue)", "cp4")
assert `cp4' == 19
display "P1B-12 PASS: regression — comma inside real parens still not top-level"


// ================================================================
// A8 — unbalanced input is an error, not a silent single segment
// ================================================================
// Each refusal below is dash's own: a message naming the fault and r(198),
// twoway's code (measured 24sep2026, all six).  They were held to _rc != 0,
// which a Mata crash in the scanner -- r(3301), a subscript out of range --
// passes as readily as the refusal.

// ----------------------------------------------------------------
// P1B-13 — an unclosed '(' must not silently swallow the rest
// ----------------------------------------------------------------
capture mata: _dash_split_segs(`"scatter mpg weight, legend(off || line mpg weight"')
assert _rc == 198
display "P1B-13 PASS: an unclosed '(' is an error, not one silent segment"

// ----------------------------------------------------------------
// P1B-14 — an unterminated '"' must not silently swallow the rest
// ----------------------------------------------------------------
capture mata: _dash_split_segs(`"scatter mpg weight, title("oops || line mpg weight"')
assert _rc == 198
display "P1B-14 PASS: an unterminated quote is an error, not one silent segment"

// ----------------------------------------------------------------
// P1B-15 — an unmatched ')' in paren mode is an error
// ----------------------------------------------------------------
capture mata: _dash_split_segs("(scatter mpg weight)) (line mpg weight)")
assert _rc == 198
display "P1B-15 PASS: an unmatched ')' in paren mode is an error"

// ----------------------------------------------------------------
// P1B-15b — an unmatched ')' in FLAT mode is an error too
// ----------------------------------------------------------------
// An extra ')' never leaves depth non-zero, so the end-of-scan balance
// check cannot catch it.  twoway returns r(198); dash used to return 0.
capture mata: _dash_split_segs(`"scatter mpg weight, title("ok"))"')
assert _rc == 198
display "P1B-15b PASS: an unmatched ')' in flat mode is an error"

// ----------------------------------------------------------------
// P1B-16 — text after a paren group is one more (bare) plot
// ----------------------------------------------------------------
// Flipped (WP-35 syn:SD-1): the splitter refusing the text was wrong
// because twoway's _parse expand reads it, to the end of the piece, as
// one more plot; the word is refused later, as any word that is no plot
// type is (P1B-37, test_parser.cscript Q3509-7).
capture mata: _dash_split_segs("(scatter mpg weight) junk (line mpg weight)")
assert _rc == 0
assert "`_n_segs'" == "2"
assert "`_seg_1'" == "scatter mpg weight"
assert "`_seg_2'" == "junk (line mpg weight)"
display "P1B-16 PASS: text after a paren group is read as one more plot, as twoway reads it"

// ----------------------------------------------------------------
// P1B-17 — a plot group after the top-level comma is an error
// ----------------------------------------------------------------
capture mata: _dash_split_segs("(scatter mpg weight), (line mpg weight)")
assert _rc == 198
display "P1B-17 PASS: a paren group after the graph-option comma is an error"

// ----------------------------------------------------------------
// P1B-18 — regression guards: legal forms must NOT newly error
// ----------------------------------------------------------------
capture mata: _dash_split_segs(`"(scatter mpg weight) (line mpg weight), title("T") legend(off)"')
assert _rc == 0
assert "`_n_segs'" == "2"
assert strpos(`"`_graph_opts_raw'"', "title") > 0
display "P1B-18 PASS: paren mode with trailing graph options still accepted"

capture mata: _dash_split_segs("scatter mpg weight || line mpg weight || qfit mpg weight")
assert _rc == 0
assert "`_n_segs'" == "3"
display "P1B-18b PASS: three flat segments still accepted"

capture mata: _dash_split_segs("(scatter mpg weight if foreign==1) (line mpg weight if foreign==0)")
assert _rc == 0
assert "`_n_segs'" == "2"
display "P1B-18c PASS: per-plot if qualifiers still accepted"

capture mata: _dash_split_segs("scatter mpg weight, note(a||b)")
assert _rc == 0
assert "`_n_segs'" == "1"
display "P1B-18d PASS: '||' inside real parens still not a separator"

// ----------------------------------------------------------------
// P1B-18e — paren groups joined by '||' (measured legal in twoway)
// ----------------------------------------------------------------
// The stray-text check added for P1B-16 must not reject this: real twoway
// accepts `(scatter y x) || (line y x)' with rc 0, and dash.sthlp claims
// drop-in parity.
capture mata: _dash_split_segs("(scatter mpg weight) || (line mpg weight)")
assert _rc == 0
assert "`_n_segs'" == "2"
assert `"`_seg_2'"' == "line mpg weight"
display "P1B-18e PASS: paren groups joined by '||' still accepted"

// ----------------------------------------------------------------
// P1B-18f — a top-level if/in qualifier in paren mode
// ----------------------------------------------------------------
// twoway accepts all four of these with rc 0 and dash.sthlp documents the
// form.  The scanner used to walk past the qualifier and drop it -- every
// observation drawn, in silence; it hands the qualifier on now, in
// _graph_qual_raw, and _dash_plot makes it the graph's own
// (test_help_claims_1.cscript HC1-01 to HC1-05).
capture mata: _dash_split_segs("(scatter mpg weight) if foreign==1")
assert _rc == 0
assert "`_n_segs'" == "1"
assert `"`_graph_qual_raw'"' == "if foreign==1"
display "P1B-18f PASS: a top-level if qualifier is accepted in paren mode"

capture mata: _dash_split_segs("(scatter mpg weight) in 1/10")
assert _rc == 0
assert "`_n_segs'" == "1"
assert `"`_graph_qual_raw'"' == "in 1/10"
display "P1B-18g PASS: a top-level in qualifier is accepted in paren mode"

// The qualifier must not hide the graph-option comma that follows it.
capture mata: _dash_split_segs(`"(scatter mpg weight) if foreign==1, title("T")"')
assert _rc == 0
assert "`_n_segs'" == "1"
assert strpos(`"`_graph_opts_raw'"', "title") > 0
assert `"`_graph_qual_raw'"' == "if foreign==1"
display "P1B-18h PASS: graph options after an if qualifier are still found"


// ================================================================
// A7 — _dash_extract_filters must not read inside quotes
// ================================================================

// ----------------------------------------------------------------
// P1B-19 — control: a real filter() is still harvested
// ----------------------------------------------------------------
local 0 `", filter(foreign, type(dropdown)) saving(x.html)"'
mata: _dash_extract_filters("_fp", "_cmd")
assert `"`_fp'"' == "foreign, type(dropdown)"
assert strpos(`"`_cmd'"', "filter") == 0
// And only the filter: the option after it is still there (_cmd is
// ", saving(x.html)", measured 24sep2026).  The check above alone passed a
// harvest that cut from filter( to the end of the command.
assert strpos(`"`_cmd'"', "saving(x.html)") > 0
display "P1B-19 PASS: control — a real filter() is harvested and removed"

// ----------------------------------------------------------------
// P1B-20 — filter( inside a quoted title is left alone
// ----------------------------------------------------------------
local 0 `", title("Q1 filter(foreign) report") saving(x.html)"'
mata: _dash_extract_filters("_fp2", "_cmd2")
assert `"`_fp2'"' == ""
assert strpos(`"`_cmd2'"', "filter(foreign)") > 0
display "P1B-20 PASS: 'filter(' inside a quoted title is neither harvested nor cut"

// ----------------------------------------------------------------
// P1B-21 — the scan is case-insensitive, so the quoted form must be too
// ----------------------------------------------------------------
local 0 `", note("see FILTER(abc) here") saving(x.html)"'
mata: _dash_extract_filters("_fp3", "_cmd3")
assert `"`_fp3'"' == ""
assert strpos(`"`_cmd3'"', "FILTER(abc)") > 0
display "P1B-21 PASS: an upper-case 'FILTER(' inside a quote is left alone"

// ----------------------------------------------------------------
// P1B-22 — a real filter() alongside a quoted one: harvest exactly one
// ----------------------------------------------------------------
local 0 `", title("Q1 filter(foreign) report") filter(price, type(range))"'
mata: _dash_extract_filters("_fp4", "_cmd4")
assert `"`_fp4'"' == "price, type(range)"
assert strpos(`"`_cmd4'"', "filter(foreign)") > 0
display "P1B-22 PASS: the real filter() is harvested, the quoted one is not"

// ----------------------------------------------------------------
// P1B-22d — a filter() nested inside another option is not top level
// ----------------------------------------------------------------
// filter() is a top-level option of dash build / dash serve.  The scan
// reached inside any option that happened to contain the word, so
// `tabs(a, filter(x))' harvested `x' as a real filter and left the user
// holding `tabs(a, )'.
local 0 `", tabs(a, filter(x)) saving(y.html)"'
mata: _dash_extract_filters("_fp6", "_cmd6")
assert `"`_fp6'"' == ""
assert strpos(`"`_cmd6'"', "filter(x)") > 0
display "P1B-22d PASS: a nested filter() is not harvested out of its option"

// ----------------------------------------------------------------
// P1B-22e — a real filter() whose label carries a parenthesised quote
// ----------------------------------------------------------------
local 0 `", filter(foreign, label("a (b)")) saving(y.html)"'
mata: _dash_extract_filters("_fp7", "_cmd7")
assert `"`_fp7'"' == `"foreign, label("a (b)")"'
display "P1B-22e PASS: a quoted, parenthesised filter label survives extraction"

// ----------------------------------------------------------------
// P1B-22b — two real filters still join with ' || '
// ----------------------------------------------------------------
local 0 `", filter(foreign, type(dropdown)) filter(price, type(range))"'
mata: _dash_extract_filters("_fp5", "_cmd5")
assert `"`_fp5'"' == "foreign, type(dropdown) || price, type(range)"
display "P1B-22c PASS: regression — two real filters still join with ' || '"


// ================================================================
// A8 — _dash_option_names must not lose options to an odd quote
// ================================================================

// ----------------------------------------------------------------
// P1B-23 — an unbalanced quote must not drop the trailing options
// ----------------------------------------------------------------
local raw `"title("unbalanced quote) xlabel(1)"'
mata: _dash_option_names("raw", "_on1")
assert strpos(`"`_on1'"', "title") > 0
assert strpos(`"`_on1'"', "xlabel") > 0
display "P1B-23 PASS: an unbalanced quote does not drop trailing option names"

// ----------------------------------------------------------------
// P1B-24 — regression: a well-formed list is unchanged
// ----------------------------------------------------------------
local raw2 `"title("My Title") xlabel(1 2 3) legend(off)"'
mata: _dash_option_names("raw2", "_on2")
assert strpos(`"`_on2'"', "title") > 0
assert strpos(`"`_on2'"', "xlabel") > 0
assert strpos(`"`_on2'"', "legend") > 0
display "P1B-24 PASS: regression — a well-formed option list is unchanged"

// ----------------------------------------------------------------
// P1B-25 — a compound-quoted value carrying quotes
// ----------------------------------------------------------------
local raw3 `"title(`"a "b" c"') xlabel(1)"'
mata: _dash_option_names("raw3", "_on3")
assert strpos(`"`_on3'"', "title") > 0
assert strpos(`"`_on3'"', "xlabel") > 0
display "P1B-25 PASS: a compound-quoted value does not drop trailing options"


// ================================================================
// _dash_json_get_str must actually decode JSON escapes
// ================================================================
// This function exists to read a JSON string value that contains \" -- its
// own docstring names `"if_expr": "make == \"AMC Concord\""' as the case it
// was written for.  It never worked.  Every escape branch compared a
// one-character string against the Mata literal "\\", which is TWO
// characters -- measured, strlen("\\") is 2 and "\\" == char(92) is false --
// so no comparison was ever true.  The first backslash fell through to the
// plain-character branch and the '"' after it ended the value, returning a
// lone backslash.
//
// The whole of its previous coverage was `assert "_dash_json_get_str" in
// src' in test_server.py: a check that the name exists, not that it works.
// These run it.

// ----------------------------------------------------------------
// P1B-27 — an escaped quote decodes to a quote
// ----------------------------------------------------------------
mata:
{
    _dash_json_get_str("{" + char(34) + "if_expr" + char(34) + ":" + char(34) +
                       "make == " + char(92) + char(34) + "AMC Concord" +
                       char(92) + char(34) + char(34) + "}",
                       "if_expr", "_jv1")
}
end
assert `"`_jv1'"' == `"make == "AMC Concord""'
display "P1B-27 PASS: an escaped quote decodes back to a quote"

// ----------------------------------------------------------------
// P1B-28 — a value with no escapes is unchanged
// ----------------------------------------------------------------
mata:
{
    _dash_json_get_str("{" + char(34) + "k" + char(34) + ":" + char(34) +
                       "plain value" + char(34) + "}", "k", "_jv2")
}
end
assert "`_jv2'" == "plain value"
display "P1B-28 PASS: a value with no escapes is returned verbatim"

// ----------------------------------------------------------------
// P1B-29 — an escaped backslash decodes to one backslash
// ----------------------------------------------------------------
mata:
{
    _dash_json_get_str("{" + char(34) + "k" + char(34) + ":" + char(34) +
                       "C:" + char(92) + char(92) + "dir" + char(34) + "}",
                       "k", "_jv3")
}
end
mata: st_local("_jlen3", strofreal(strlen(st_local("_jv3"))))
assert `_jlen3' == 6
display "P1B-29 PASS: an escaped backslash decodes to a single backslash"

// ----------------------------------------------------------------
// P1B-30 — a missing key returns empty rather than erroring
// ----------------------------------------------------------------
mata:
{
    _dash_json_get_str("{" + char(34) + "a" + char(34) + ":" + char(34) +
                       "1" + char(34) + "}", "nosuchkey", "_jv4")
}
end
assert "`_jv4'" == ""
display "P1B-30 PASS: a missing key returns empty"


// ================================================================
// A6 -- _dash_first_comma_pos, with the quote INSIDE parentheses
// ================================================================
// P1B-09 to P1B-12 all find the option comma before they reach any quote,
// so they pass whether or not a quote is tracked at depth > 0 -- measured:
// with 9c7dbf7's depth gate put back into _dash_first_comma_pos they stay green.
// The gate bites when a quoted value holding a parenthesis sits inside a
// function call in the qualifier, before the option comma: the parenthesis
// in the quote moves the depth, the closing quote is then read as opening
// one, and the comma is never found.

// ----------------------------------------------------------------
// P1B-31 -- a ')' inside a quote inside inlist()
// ----------------------------------------------------------------
local cp5 = -1
mata: _dash_comma_pos(`"scatter mpg weight if inlist(make, "a ) b"), title(x)"', "cp5")
assert `cp5' == 44
display "P1B-31 PASS: a ')' quoted inside a function call does not hide the option comma"

// ----------------------------------------------------------------
// P1B-32 -- a '(' inside a quote inside strpos()
// ----------------------------------------------------------------
local cp6 = -1
mata: _dash_comma_pos(`"scatter mpg weight if strpos(make, "(") > 0, title(x)"', "cp6")
assert `cp6' == 44
display "P1B-32 PASS: a '(' quoted inside a function call does not hide the option comma"


// ================================================================
// A7 -- the two parts of the extractor fix no case above needs
// ================================================================

// ----------------------------------------------------------------
// P1B-33 -- a ')' inside the quote must not close the option around it
// ----------------------------------------------------------------
// P1B-20 and P1B-21 pass on the depth test alone: their filter( sits
// inside title( and note(, so it is never at depth 0.  A quoted ')' before
// it takes the depth back to 0 unless the quote is tracked -- measured, with
// the quote tracking taken out of _dash_extract_filters, `foreign' was
// harvested as a filter and cut out of this title.
local 0 `", title("Q1 ) filter(foreign) report") saving(x.html)"'
mata: _dash_extract_filters("_fp8", "_cmd8")
assert `"`_fp8'"' == ""
assert strpos(`"`_cmd8'"', "Q1 ) filter(foreign) report") > 0
local 0 `", title(`"Q1 ) filter(foreign) "report""') saving(x.html)"'
mata: _dash_extract_filters("_fp9", "_cmd9")
assert `"`_fp9'"' == ""
assert strpos(`"`_cmd9'"', "filter(foreign)") > 0
display "P1B-33 PASS: a quoted ')' before filter( does not make it a filter, in plain or compound quotes"

// ----------------------------------------------------------------
// P1B-34 -- a filter whose own quoted label holds an unbalanced '('
// ----------------------------------------------------------------
// P1B-22e's label, "a (b)", is balanced, so the inner matcher closes the
// group whether or not it tracks the quote.  "a (b" is not: an untracked
// '(' leaves the group open to the end of the command, nothing is
// extracted, and the filter() reaches -syntax- unextracted.
local 0 `", filter(foreign, label("a (b")) saving(y.html)"'
mata: _dash_extract_filters("_fp10", "_cmd10")
assert `"`_fp10'"' == `"foreign, label("a (b")"'
assert strpos(`"`_cmd10'"', "filter") == 0
assert strpos(`"`_cmd10'"', "saving(y.html)") > 0
display "P1B-34 PASS: a filter whose quoted label holds an unbalanced '(' is extracted whole"


// ================================================================
// AC-01.1, AC-01.3 and AC-01.4 through dash itself
// ================================================================
// Registration and the refusals run in Stata alone: no Python, no jsonio.
// Each command's output goes to a log that Mata reads by value, so nothing
// dash prints can end a Stata string.
do "../dash.ado"
global dash_nobrowser 1

capture mata: mata drop _p1b_log_has()
mata:
real scalar _p1b_log_has(string scalar fn, string scalar needle)
{
    // A log's logical lines: Stata wraps a line at the column, anywhere --
    // mid-word included -- and goes on with "> "; a physical line comes
    // back from fget() in 32,768-character pieces.  Each is searched
    // re-joined, as cert_helpers.do's _cert_log_count does (WP-24: read
    // line by line, a needle the wrap split was not found).
    real scalar   fh, found, piece
    string scalar line, full
    found = 0
    full  = ""
    piece = 0
    fh = fopen(fn, "r")
    while ((line = fget(fh)) != J(0, 0, "")) {
        if (piece | substr(line, 1, 2) == "> ") {
            full = full + (piece ? line : substr(line, 3, .))
        }
        else {
            if (strpos(full, needle)) found = 1
            full = line
        }
        piece = (strlen(line) == 32768)
    }
    if (strpos(full, needle)) found = 1
    fclose(fh)
    return(found)
}
end

capture program drop _p1b_run
program define _p1b_run, rclass
    args cmdtext
    // A tempfile's name comes round again on the next call, and the log
    // beside it is not erased with it; the caller has read the last one.
    tempfile lg
    capture erase "`lg'.log"
    local ls = c(linesize)
    set linesize 255
    capture log close _p1blog
    quietly log using "`lg'.log", text name(_p1blog)
    capture noisily `cmdtext'
    local rc = _rc
    quietly log close _p1blog
    set linesize `ls'
    return scalar rc = `rc'
    return local log "`lg'.log"
end

// ----------------------------------------------------------------
// P1B-35 -- AC-01.1: two plot layers and no note about options
// ----------------------------------------------------------------
dash clear
_p1b_run `"dash scatter mpg weight, title("a ( b") name(g) || line mpg weight"'
local rc35 = r(rc)
local lg35 "`r(log)'"
assert `rc35' == 0
assert "${dash_graph_registry}" == "g"
mata: st_local("p35s", strofreal(strpos(st_global("dash_json_g"), char(34) + "type" + char(34) + ":" + char(34) + "scatter" + char(34)) > 0))
mata: st_local("p35l", strofreal(strpos(st_global("dash_json_g"), char(34) + "type" + char(34) + ":" + char(34) + "line" + char(34)) > 0))
mata: st_local("p35t", strofreal(strpos(st_global("dash_json_g"), "a ( b") > 0))
assert `p35s' == 1 & `p35l' == 1 & `p35t' == 1
mata: st_local("p35n", strofreal(_p1b_log_has(st_local("lg35"), "ignoring unsupported")))
assert `p35n' == 0
display "P1B-35 PASS: AC-01.1 -- a title() holding a ( b before || registers the scatter and the line, and names no option"

// ----------------------------------------------------------------
// P1B-36 -- AC-01.3: an unclosed '(' is r(198), naming the parenthesis
// ----------------------------------------------------------------
dash clear
_p1b_run `"dash scatter mpg weight, legend(off || line price weight"'
local rc36 = r(rc)
local lg36 "`r(log)'"
assert `rc36' == 198
mata: st_local("p36m", strofreal(_p1b_log_has(st_local("lg36"), "unbalanced parentheses")))
assert `p36m' == 1
assert "${dash_graph_registry}" == ""
display "P1B-36 PASS: AC-01.3 -- legend(off || line ... exits 198 naming the unbalanced parentheses, and registers nothing"

// ----------------------------------------------------------------
// P1B-37 -- AC-01.4: stray text between groups is r(198), as in twoway
// ----------------------------------------------------------------
dash clear
capture twoway (scatter mpg weight) junk (line price weight), nodraw
local tw37 = _rc
_p1b_run `"dash (scatter mpg weight) junk (line price weight)"'
local rc37 = r(rc)
local lg37 "`r(log)'"
assert `tw37' == 198
assert `rc37' == 198
// Flipped (WP-35 syn:SD-1): dash's own words were wrong because twoway
// reads the text after a group as one more plot and refuses the word as
// any word that is no plot type (command_grammar_truth.json group.junk).
mata: st_local("p37m", strofreal(_p1b_log_has(st_local("lg37"), "junk is not a twoway plot type")))
assert `p37m' == 1
assert "${dash_graph_registry}" == ""
display "P1B-37 PASS: AC-01.4 -- (a) junk (b) exits 198, as twoway does, in its words"

// ----------------------------------------------------------------
// P1B-38 -- the qualifier of P1B-31's shape, through dash
// ----------------------------------------------------------------
// twoway draws it (rc 0), and so must dash, with the qualifier whole.
dash clear
capture twoway scatter mpg weight if inlist(make, "x (y", "AMC Pacer"), nodraw
local tw38 = _rc
_p1b_run `"dash scatter mpg weight if inlist(make, "x (y", "AMC Pacer"), name(pq1)"'
local rc38 = r(rc)
assert `tw38' == 0
assert `rc38' == 0
assert "${dash_graph_registry}" == "pq1"
mata: st_local("p38q", strofreal(strpos(st_global("dash_json_pq1"), "inlist(make, ") > 0 & strpos(st_global("dash_json_pq1"), "AMC Pacer") > 0))
assert `p38q' == 1
display "P1B-38 PASS: a quoted '(' inside the qualifier's function call leaves the option comma where it is"


// ================================================================
// P1B-39..47 -- a compound quote nests
// ================================================================
// Stata's compound quotes nest: each `" opens a level and each "' closes
// one, so `"a `"b"' c"' is one string.  _dash_quote_step tracked a compound
// quote with an on/off flag, so the first "' ended the outer quote, the
// rest of the string was read as syntax, and its closing "' opened a plain
// quote that never closed.  Measured 24sep2026 with the console binary:
// dash scatter mpg weight if make == `"say `"hi"' now"' and dash scatter
// mpg weight, title(`"a `"b"' c"') each stopped with "dash: unterminated
// quotation in the plot specification.", r(198); twoway draws both, rc 0,
// and its SVG export draws the title a `"b"' c.  Every scanner that shares
// the helper is held to the nested reading here, one case each.

// _p1b_cq(s): s in compound quotes, made from char() so no expected value
// is typed inside the quotes it is about.
capture mata: mata drop _p1b_cq()
mata:
string scalar _p1b_cq(string scalar s)
{
    return(char(96) + char(34) + s + char(34) + char(39))
}
end

// P1B-39 -- the flat splitter: a || inside a nested string is text.
mata:
{
    _dash_split_segs(`"scatter mpg weight, title(`"a `"b"' c || d"') || line mpg weight"')
}
end
assert "`_n_segs'" == "2"
assert `"`_seg_2'"' == "line mpg weight"
display "P1B-39 PASS: a || inside a nested compound quote is not a separator"

// P1B-40 -- the paren splitter: a ')' inside a nested string closes nothing.
mata:
{
    _dash_split_segs(`"(scatter mpg weight, title(`"a `"b"' ) c"')) (line mpg weight)"')
}
end
assert "`_n_segs'" == "2"
assert `"`_seg_2'"' == "line mpg weight"
display "P1B-40 PASS: a ')' inside a nested compound quote does not close its group"

// P1B-41 -- _dash_first_comma_pos: a comma inside a nested literal is not the
// option comma.
local p41 `"mpg weight if make == `"say `"hi"' , now"', title(x)"'
mata: st_local("p41c", strofreal(_dash_first_comma_pos(st_local("p41"))))
mata: st_local("p41w", strofreal(strpos(st_local("p41"), char(39) + ", title")))
assert `p41c' == `p41w' + 1
display "P1B-41 PASS: a comma inside a nested compound quote is not the option comma"

// P1B-42 -- _dash_extract_filters: filter( inside a nested string is text.
local 0 `", title(`"a `"b"' filter(foreign) c"') filter(price, type(range))"'
mata: _dash_extract_filters("_fp42", "_cmd42")
assert `"`_fp42'"' == "price, type(range)"
assert strpos(`"`_cmd42'"', "filter(foreign)") > 0
display "P1B-42 PASS: a filter( inside a nested compound quote is not harvested"

// P1B-43 -- _dash_option_names: an option-like word inside a nested
// string is not an option, and the options after it are all named.
local raw43 `"title(`"a `"b"' ) xlabel(1) c"') ylabel(2)"'
mata: _dash_option_names("raw43", "_on43")
assert `"`_on43'"' == "title ylabel"
display "P1B-43 PASS: a nested compound quote hides no option and invents none"

// P1B-44 -- _dash_filter_split: a || and a ; inside a nested label are text.
mata: st_local("p44", strofreal(cols(_dash_filter_split(`"foreign, label(`"a `"b"' || c ; d"') || price"', 1))))
assert `p44' == 2
display "P1B-44 PASS: a filter group's nested compound quote holds its separators"

// P1B-45 -- through dash, as the entry measured them: the nested literal
// and the nested title are accepted, as twoway accepts them, and stored
// as typed.
dash clear
capture twoway scatter mpg weight if make == `"say `"hi"' now"', nodraw
local tw45a = _rc
capture twoway scatter mpg weight, title(`"a `"b"' c"') nodraw
local tw45b = _rc
_p1b_run `"dash scatter mpg weight if make == `"say `"hi"' now"', name(pn1)"'
local rc45a = r(rc)
_p1b_run `"dash scatter mpg weight, title(`"a `"b"' c"') name(pn2)"'
local rc45b = r(rc)
mata: st_local("p45q", strofreal(strpos(st_global("dash_json_pn1"), _dash_json_escape("make == " + _p1b_cq("say " + _p1b_cq("hi") + " now"))) > 0))
mata: st_local("p45t", strofreal(strpos(st_global("dash_json_pn2"), _dash_json_escape(_p1b_cq("a " + _p1b_cq("b") + " c"))) > 0))
display as text "  twoway rc `tw45a' `tw45b'  dash rc `rc45a' `rc45b'  stored `p45q' `p45t'  registry [${dash_graph_registry}]"
assert `tw45a' == 0 & `tw45b' == 0
assert `rc45a' == 0 & `rc45b' == 0
assert "${dash_graph_registry}" == "pn1 pn2"
assert `p45q' == 1 & `p45t' == 1
display "P1B-45 PASS: a nested compound literal and a nested compound title are accepted and stored as typed"

// P1B-46 -- CLAUDE.md rule 18, injection: a nested string that holds ||,
// a plot command and filter( smuggles in neither a plot nor a filter; and
// one left unbalanced is refused, as twoway refuses it (r(132) there).
dash clear
capture twoway scatter mpg weight, title(`"x || line mpg weight `"y"' filter(z)"') nodraw
local tw46a = _rc
_p1b_run `"dash scatter mpg weight, title(`"x || line mpg weight `"y"' filter(foreign) name(evil)"') name(pn3)"'
local rc46a = r(rc)
mata: st_local("p46n", strofreal(strpos(st_global("dash_json_pn3"), char(34) + "type" + char(34) + ":" + char(34) + "line" + char(34)) == 0))
mata: st_local("p46t", strofreal(strpos(st_global("dash_json_pn3"), "filter(foreign) name(evil)") > 0))
local 0 `", title(`"x || `"y"' filter(foreign)"') filter(price)"'
mata: _dash_extract_filters("_fp46", "_cmd46")
assert `tw46a' == 0 & `rc46a' == 0
assert "${dash_graph_registry}" == "pn3"
assert `p46n' == 1 & `p46t' == 1
assert `"`_fp46'"' == "price"
capture twoway scatter mpg weight, title(`"a `"b c"') nodraw
local tw46b = _rc
// Typed at the top level, not handed to _p1b_run: an unbalanced string
// cannot be quoted as an argument.
dash clear
mata: st_local("p46u", "title(" + char(96) + char(34) + "a " + char(96) + char(34) + "b c" + char(34) + char(39) + ")")
tempfile lg46
local lg46b "`lg46'.log"
capture log close _p1blog
quietly log using "`lg46b'", text name(_p1blog) replace
capture noisily dash scatter mpg weight, `macval(p46u)' name(pn4)
local rc46b = _rc
quietly log close _p1blog
mata: st_local("p46m", strofreal(_p1b_log_has(st_local("lg46b"), "unterminated quotation")))
display as text "  unbalanced: twoway rc `tw46b', dash rc `rc46b', named `p46m', registry [${dash_graph_registry}]"
assert `tw46b' != 0
assert `rc46b' == 198 & `p46m' == 1
assert "${dash_graph_registry}" == ""
display "P1B-46 PASS: a nested string smuggles in no plot and no filter, and an unbalanced one is refused"

// P1B-47 -- CLAUDE.md rule 18, exhaustion: 10,000 nested levels, balanced
// and one short, through every scanner and through dash, in bounded time
// and without a crash.  The balanced title is stored as typed; the
// unbalanced one is refused r(198).
mata: st_local("p47d", "title(" + (char(96) + char(34)) * 10000 + "x" + (char(34) + char(39)) * 10000 + ")")
mata: st_local("p47u", "title(" + (char(96) + char(34)) * 10000 + "x" + (char(34) + char(39)) * 9999 + ")")
timer clear 47
timer on 47
mata: _dash_split_segs("scatter mpg weight, " + st_local("p47d") + " || line mpg weight")
assert "`_n_segs'" == "2"
mata: st_local("p47c", strofreal(_dash_first_comma_pos("mpg weight, " + st_local("p47d"))))
assert `p47c' == 11
local 0 `", `macval(p47d)' filter(price)"'
mata: _dash_extract_filters("_fp47", "_cmd47")
assert `"`_fp47'"' == "price"
mata: _dash_option_names("p47d", "_on47")
assert `"`_on47'"' == "title"
dash clear
capture noisily dash scatter mpg weight, `macval(p47d)' name(pn5)
local rc47a = _rc
mata: st_local("p47s", strofreal(strpos(st_global("dash_json_pn5"), _dash_json_escape(substr(st_local("p47d"), 7, strlen(st_local("p47d")) - 7))) > 0))
capture noisily dash scatter mpg weight, `macval(p47u)' name(pn6)
local rc47b = _rc
timer off 47
quietly timer list 47
local p47t = r(t47)
display as text "  10,000 levels: balanced rc `rc47a' stored `p47s', unbalanced rc `rc47b', registry [${dash_graph_registry}], `p47t's"
assert `rc47a' == 0 & `p47s' == 1
assert `rc47b' == 198
assert "${dash_graph_registry}" == "pn5"
assert `p47t' < 60
display "P1B-47 PASS: 10,000 nested levels are read in bounded time, stored when balanced and refused when not"

dash clear
capture program drop _p1b_run


display ""
display "All parser-integrity tests PASSED."
