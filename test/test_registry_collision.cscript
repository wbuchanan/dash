*! test_registry_collision.cscript  v1.3
*! Certification script for the graph/KPI registry namespace.
*!
*! Graphs and KPIs share one registry and one namespace.  `dash' checked for
*! a collision on one side of it and not the other:
*!
*!   dash scatter mpg weight, name(g1)      -> registered
*!   dash line    mpg weight, name(g1)      -> r(198), use name(g1, replace)
*!   dash kpi     mean(mpg),  name(g1)      -> rc 0, in SILENCE
*!
*! _dash_register_graph refuses a duplicate unless `replace' is given.
*! _dash_kpi had no check at all, so a KPI could take a name a graph already
*! held -- and then win it.  At build time _dash_prepare_spec skips any
*! registry entry carrying a KPI marker, so the graph was dropped from the
*! dashboard: measured, the built file held the KPI's text and ZERO graph
*! models.  rc 0 throughout, and no message.
*!
*! A second KPI of the same name overwrote the first as quietly -- measured,
*! `dash kpi mean(mpg), name(k2)' then `dash kpi max(mpg), name(k2)' left
*! ${dash_kpi_k2_stat} == "max" with nothing said.
*!
*! The reverse direction was already safe: a graph cannot take a KPI's name,
*! because _dash_register_graph looks at the registry and the KPI is in it.
*!
*! One item's globals were also another name's.  A KPI kept its fields in
*! globals named by appending to its own -- dash_kpi_<name>_stat, _var,
*! _val, ... -- which are the globals of the legal name <name>_stat.
*! Measured 23sep2026 at 9f48cf7: KPI a beside a graph a_stat drew card A,
*! a blank card and no figure; KPI a beside KPI a_stat set KPI a's statistic
*! to "1"; replacing KPI a deleted KPI a_b's globals, and the next build
*! dropped the AB card or died with r(7102) and a JSONDecodeError.  REG-18
*! through REG-28.
*!
*! And text anywhere in the command could grant a replace.  The graph
*! registrar searched the WHOLE command for name(...,replace) whenever
*! name()'s own text held no replace, so a re-used name whose title, note,
*! caption, text() or if qualifier held those characters overwrote the
*! registered graph -- measured 23sep2026 at ad13a0f, rc 0 in silence where
*! twoway refuses with r(110).  Only name()'s own text decides a replace
*! now, for a graph and a KPI card alike.  REG-29 through REG-36.
*!
*! And a command could give name() twice.  twoway refuses any command with
*! a second name() -- in another plot group, after the comma, in another
*! || segment or in the same option list, spelled name() or nam(), even
*! naming the same graph -- with "option name() not allowed", r(198).  dash
*! took one of them (the last group's, the one after the comma, the first
*! of one list), called the other an unsupported option, and so replaced a
*! registered graph twoway leaves alone, or registered a name twoway never
*! would (measured 24sep2026 at 68327a8).  REG-37 through REG-41.
*!
*! And two of ROADMAP WP-04's acceptance criteria were held only in part:
*! AC-04.2 in the globals, never in a build, and AC-04.3 by the word "both"
*! in a log, whatever the warning named (WP-24's mutation check,
*! 24sep2026).  REG-42 and REG-43.
*!
*! Tests: REG-01 through REG-43
*!
*! Usage:  do test/test_registry_collision.cscript
*! Version: 1.4  24sep2026

cscript "graph and KPI share one namespace" adodir ".."
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}

// `cscript' drops every global macro, the runner's $dash_nobrowser with them;
// set it again before this script builds a dashboard (test_cscript_hygiene.py).
global dash_nobrowser 1

// ----------------------------------------------------------------
// Setup
// ----------------------------------------------------------------

qui sysuse auto, clear
do "../dash_parse.mata"
do "../dash.ado"

// cert_file_has: asks whether a file holds a string, from Mata, where the
// file's text is a value and never macro text.  cert_log_has asks the same
// of a Stata log with the log's wrapping undone: every log below is
// searched with it, since Stata breaks a log line at c(linesize), anywhere,
// and where a message breaks depends on what precedes it on its line (a
// path, a name) and on the linesize the log was written at.  Loaded from
// this directory, as the runner runs every script from it.
do "cert_helpers.do"

// How many globals does the registry still hold for `name'?  Counted in
// Mata against the exact names, because `macro drop dash_kpi_g1*' would also
// take g10's -- the name grammar allows both to exist at once.  A KPI's
// fields are dash_kpi_<name>__<field>, a field being letters: a prefix
// alone would count KPI a_'s dash_kpi_a___sta as KPI a's.  Written apart
// from dash's own _dash_item_globals, so the two can disagree.
capture program drop _reg_count
program define _reg_count, rclass
    args nm
    mata: st_local("_rc_n", strofreal(_reg_item_globals("`nm'")))
    return scalar n = `_rc_n'
end

// dash build to a page of its own under c(tmpdir), keeping what it
// printed: r(rc), r(page) and r(log).  The page is erased first, so a page
// an earlier run left cannot answer a check of this one.  cert_file_has and
// cert_log_has are rclass, so a caller copies these into locals before its
// first check.
capture program drop _reg_build
program define _reg_build, rclass
    syntax name(name=tag) [, *]
    local page "`c(tmpdir)'dash_reg_`tag'.html"
    local lg   "`c(tmpdir)'dash_reg_`tag'.log"
    capture erase "`page'"
    local ls = c(linesize)
    set linesize 255
    quietly log using "`lg'", replace text name(_reglog)
    capture noisily dash build, saving("`page'") replace nobrowser `options'
    local rc = _rc
    quietly log close _reglog
    set linesize `ls'
    return scalar rc = `rc'
    return local page "`page'"
    return local log  "`lg'"
end

// The spec `dash build' would hand the renderer, from the program that
// assembles it for both dash build and dash serve: r(rc) and r(spec).  No
// Python runs.
capture program drop _reg_spec
program define _reg_spec, rclass
    syntax name(name=tag)
    local sp "`c(tmpdir)'dash_reg_`tag'_spec.json"
    local dp "`c(tmpdir)'dash_reg_`tag'_data.json"
    capture erase "`sp'"
    capture erase "`dp'"
    capture noisily _dash_prepare_spec, cmdname("dash build") ///
        specpath("`sp'") datapath("`dp'")
    return scalar rc = _rc
    return local spec "`sp'"
end

mata:
real scalar _reg_item_globals(string scalar nm)
{
    string colvector all
    string scalar    p
    real scalar      i, n
    n   = 0
    p   = "dash_kpi_" + nm + "__"
    all = st_dir("global", "macro", "dash_*")
    for (i = 1; i <= length(all); i++) {
        if (all[i] == "dash_json_" + nm |
            all[i] == "dash_spec_" + nm |
            all[i] == "dash_kpi_"  + nm) n = n + 1
        else if (substr(all[i], 1, strlen(p)) == p) {
            if (regexm(substr(all[i], strlen(p) + 1, .), "^[a-z]+$")) n = n + 1
        }
    }
    return(n)
}
end


// ================================================================
// REG-01..03 — a KPI may not silently take a graph's name
// ================================================================
dash clear
dash scatter mpg weight, name(g1)
capture noisily dash kpi mean(mpg), name(g1) title("Avg")
assert _rc == 198
display "REG-01 PASS: a KPI cannot take a graph's name without replace"

// The refusal must leave the graph exactly as it was.
assert `"${dash_json_g1}"' != ""
assert "${dash_kpi_g1}" == ""
assert "${dash_graph_registry}" == "g1"
display "REG-02 PASS: the refused KPI left the graph untouched"

// And the build still contains the graph.
tempfile out1
capture noisily dash build, saving("`out1'.html") replace nobrowser
assert _rc == 0
display "REG-03 PASS: the graph still builds after a refused KPI"

// ================================================================
// REG-04..06 — with replace, the KPI takes the name cleanly
// ================================================================
dash clear
dash scatter mpg weight, name(g1)
// The two globals REG-05 requires gone are there to begin with: were the
// graph never to write dash_spec_g1, that check could not fail.
assert `"${dash_json_g1}"' != "" & `"${dash_spec_g1}"' != ""
capture noisily dash kpi mean(mpg), name(g1, replace) title("Avg")
assert _rc == 0
display "REG-04 PASS: name(g1, replace) lets a KPI take a graph's name"

// No orphan: the graph's JSON must be gone, or the build would carry a
// registry entry that is both a graph and a KPI.
assert `"${dash_json_g1}"' == ""
assert `"${dash_spec_g1}"' == ""
assert "${dash_kpi_g1}" == "1"
display "REG-05 PASS: the superseded graph's globals are dropped"

assert "${dash_graph_registry}" == "g1"
display "REG-06 PASS: the name appears once in the registry, not twice"

// ================================================================
// REG-07..09 — a KPI may not silently take another KPI's name
// ================================================================
dash clear
dash kpi mean(mpg), name(k2) title("A")
capture noisily dash kpi max(mpg), name(k2) title("B")
assert _rc == 198
assert "${dash_kpi_k2__sta}" == "mean"
display "REG-07 PASS: a duplicate KPI name is refused, and the first survives"

capture noisily dash kpi max(mpg), name(k2, replace) title("B")
assert _rc == 0
assert "${dash_kpi_k2__sta}" == "max"
display "REG-08 PASS: with replace the second KPI wins"

assert "${dash_graph_registry}" == "k2"
display "REG-09 PASS: replacing a KPI does not duplicate the registry entry"

// ================================================================
// REG-10..11 — the reverse direction, which was already safe
// ================================================================
dash clear
dash kpi mean(mpg), name(k1) title("Avg")
capture noisily dash scatter mpg weight, name(k1)
assert _rc == 198
display "REG-10 PASS: a graph cannot take a KPI's name without replace"

capture noisily dash scatter mpg weight, name(k1, replace)
assert _rc == 0
// The KPI's globals must go, or the build skips the graph it just accepted.
assert "${dash_kpi_k1}" == ""
assert "${dash_kpi_k1__sta}" == ""
local reg11 : all globals "dash_kpi_k1*"
assert "`reg11'" == ""
assert `"${dash_json_k1}"' != ""
display "REG-11 PASS: replacing a KPI with a graph drops the KPI's globals"

// ================================================================
// REG-12 — no item leaves globals behind after a replace
// ================================================================
// Counted exactly, so a stray dash_kpi_<name>_* cannot hide.
dash clear
dash scatter mpg weight, name(g2)
_reg_count g2
local before = r(n)
// A graph owns two, dash_json_g2 and dash_spec_g2 (_dash_register_graph):
// so the absences below are of globals that were there.
assert `before' == 2
assert `"${dash_json_g2}"' != "" & `"${dash_spec_g2}"' != ""
capture noisily dash kpi mean(mpg), name(g2, replace) title("K")
assert _rc == 0
_reg_count g2
local after = r(n)
display as text "  globals g2 owns -- the graph: `before'  the KPI replacing it: `after'"
// The count after the replace used to be taken and never read.  A KPI
// given a title and nothing else owns seven -- its marker and __sta,
// __var, __val, __dsp, __tit and __upd, as REG-20 counts for KPI a -- so
// an eighth the replace leaves behind is seen here (24sep2026).
assert `after' == 7
// Only the KPI's own globals remain: no dash_json_g2, no dash_spec_g2.
assert `"${dash_json_g2}"' == ""
assert `"${dash_spec_g2}"' == ""
display "REG-12 PASS: a replace leaves no globals from the superseded item"

// ================================================================
// REG-13 — a similarly-named item is not collateral damage
// ================================================================
// `macro drop dash_kpi_g1*' would take g10's globals too.  Both names are
// legal and may be registered at once.
dash clear
dash kpi mean(mpg),  name(k1) title("one")
dash kpi max(mpg),   name(k10) title("ten")
capture noisily dash kpi min(mpg), name(k1, replace) title("one again")
assert _rc == 0
assert "${dash_kpi_k10}" == "1"
assert "${dash_kpi_k10__sta}" == "max"
assert `"${dash_kpi_k10__tit}"' == "ten"
display "REG-13 PASS: replacing k1 does not disturb k10"

// ================================================================
// REG-14 — regression: ordinary registration still works
// ================================================================
dash clear
dash scatter mpg weight, name(a1)
dash line mpg weight, name(a2)
dash kpi mean(mpg), name(a3) title("M")
assert "${dash_graph_registry}" == "a1 a2 a3"
tempfile out2
capture noisily dash build, saving("`out2'.html") replace nobrowser
assert _rc == 0
display "REG-14 PASS: two graphs and a KPI register and build as before"

// ================================================================
// REG-15 — a name holding both is reported, not silently dropped
// ================================================================
// Neither registrar can produce this state any more.  The registry is kept
// in ordinary Stata globals, though, so a do-file that sets dash_* by hand
// still can -- and the build used to pass over such an entry without a word.
dash clear
dash scatter mpg weight, name(b1)
global dash_kpi_b1      "1"
global dash_kpi_b1__sta "mean"
global dash_kpi_b1__var "mpg"
global dash_kpi_b1__val "21"
global dash_kpi_b1__dsp "21"
global dash_kpi_b1__tit "forced"
global dash_kpi_b1__upd "filter"
tempname blf
tempfile blg
quietly log using "`blg'", replace text name(`blf')
tempfile out3
capture noisily dash build, saving("`out3'.html") replace nobrowser
local brc = _rc
quietly log close `blf'
// The words and the entry's name, as the PASS line claims, searched with
// the log's wrapping undone.  The needle was "both", anywhere, in any case:
// a message that named no entry, or any other line holding the word,
// passed.
cert_log_has "`blg'", needle("dash build: 'b1' is registered as both a graph and a KPI")
local _reg_warned = r(found)
assert `brc' == 0
assert `_reg_warned' == 1
display "REG-15 PASS: an entry registered as both is named in the output"

// ================================================================
// REG-16 — _all is link()'s word, never a name
// ================================================================
// Measured 23sep2026: a graph named _all registered, and link(_all g2)
// then built -- every graph linked when saved, _all and g2 when served --
// while link(_all g2) over graphs of other names was refused as naming a
// graph the registry lacked.  _all is refused as a name now, for a graph
// and a KPI card, and link(_all) beside names is refused for what it is.
dash clear
local r16ls = c(linesize)
set linesize 255
tempname r16f
tempfile r16g
quietly log using "`r16g'", replace text name(`r16f')
capture noisily dash scatter mpg weight, name(_all)
local r16a = _rc
capture noisily dash kpi mean(mpg), name(_all) title("A")
local r16b = _rc
quietly log close `r16f'
assert `r16a' == 198
assert `r16b' == 198
// Each refusal once, in its own words, on its logical line: cert_log_has
// rejoins what Stata's log wraps at c(linesize), and lower keeps the
// case-insensitive match of the line-by-line reader this used, which did
// not see a refusal the log had broken, though dash printed it -- at
// linesize 50 the graph's breaks inside "uses", the KPI card's before "for
// every graph", and link(_all g2)'s before "alone" (measured 24sep2026).
cert_log_has "`r16g'", needle("dash: graph name '_all' is the word link(_all) uses for every graph") lower
local _reg_g = r(count)
cert_log_has "`r16g'", needle("dash kpi: name '_all' is the word link(_all) uses for every graph") lower
local _reg_k = r(count)
assert `_reg_g' == 1
assert `_reg_k' == 1
assert "${dash_graph_registry}" == ""
dash scatter mpg weight, name(g1)
dash scatter price weight, name(g2)
tempfile out4
quietly log using "`r16g'", replace text name(`r16f')
capture noisily dash build, saving("`out4'.html") replace nobrowser link(_all g2)
local r16c = _rc
quietly log close `r16f'
set linesize `r16ls'
assert `r16c' == 198
cert_log_has "`r16g'", needle("link(_all) links every graph; give it alone") lower
assert r(count) == 1
capture noisily dash build, saving("`out4'.html") replace nobrowser link(_all)
assert _rc == 0
display "REG-16 PASS: _all is refused as a graph or KPI name, and link(_all) beside names is refused for what it is"

// ================================================================
// REG-17 -- the one rule that reads name()'s ", replace"
// ================================================================
// _dash_name_split turns name()'s text into the name and a replace flag.
// _dash_plot writes that name into the stored graph and
// _dash_register_graph registers it; they read name() separately before,
// and the stored graph kept "g1, replace" as its name while the registry
// said g1 (test_adversarial.cscript P20-33).  Spaces around the comma are
// allowed, as twoway allows them; anything else after the comma stays in
// the name for the name check to refuse, as twoway refuses rep, REPLACE,
// replace x and a missing comma (measured 23sep2026).
capture program list _dash_name_split
if _rc != 0 {
    display as error "REG-17 FAIL: _dash_name_split is not defined"
    exit 9
}
capture program drop _reg_split
program define _reg_split
    args raw want_name want_flag
    _dash_name_split `"`raw'"' _r17n _r17f
    if `"`_r17n'"' != `"`want_name'"' | "`_r17f'" != "`want_flag'" {
        mata: printf("{err}REG-17 FAIL: [%s] split as [%s] flag %s, not [%s] flag %s\n", ///
            st_local("raw"), st_local("_r17n"), st_local("_r17f"), ///
            st_local("want_name"), st_local("want_flag"))
        exit 9
    }
end
_reg_split "g1, replace"        "g1" 1
_reg_split "g1,replace"         "g1" 1
_reg_split "g1 ,replace"        "g1" 1
_reg_split "g1 , replace"       "g1" 1
_reg_split " g1 ,  replace "    "g1" 1
_reg_split "a_stat, replace"    "a_stat" 1
_reg_split "g1"                 "g1" 0
_reg_split " g1 "               "g1" 0
_reg_split ""                   "" 0
_reg_split "g1, rep"            "g1, rep" 0
_reg_split "g1, REPLACE"        "g1, REPLACE" 0
_reg_split "g1, replace x"      "g1, replace x" 0
_reg_split "g1 replace"         "g1 replace" 0
_reg_split ", replace"          ", replace" 0
_reg_split "a, b, replace"      "a, b, replace" 0
// Hostile text is split, never run: the name check refuses it afterwards.
_reg_split `"a"b, replace"'     `"a"b"' 1
_reg_split "{bf:x}, replace"    "{bf:x}" 1
capture program drop _reg_split
display "REG-17 PASS: name()'s text splits into the name and a replace flag by one rule"
// REG-18..27 -- one item's globals are never another name's
// ================================================================
// A KPI kept its fields in globals named by appending to its name --
// dash_kpi_<name>_stat, _var, _val, _disp, _fmt, _tit, _sub, _col, _bg,
// _upd, _if, _in -- and those are the globals of another legal name that
// holds one underscore.  Measured 23sep2026 at 9f48cf7, rc 0 unless said:
//   KPI a, graph a_stat (either order): dash build printed "'a_stat' is
//     registered as both a graph and a KPI; drawing the KPI" and drew card
//     A, a BLANK card and no figure.  The advice it printed,
//     name(a_stat, replace), drew the graph and deleted KPI a's statistic:
//     card A read 21.2972972972973 where KPI a alone reads 21.2973.
//   KPI a, KPI a_stat: $dash_kpi_a_stat went from "mean" to "1" in
//     silence; card A read 21.2972972972973, and 0 under a Foreign filter
//     where summarize mpg if foreign==1 gives 24.7727.
//   KPI a, KPI a_b, then name(a, replace): all seven of a_b's globals were
//     deleted while the registry still read "a a_b"; the build drew no AB
//     card and said nothing -- and died with r(7102) and a Python
//     JSONDecodeError once a graph was registered after a_b, or when a
//     graph replaced KPI a.
// A KPI's fields are dash_kpi_<name>__<field> now.  No name may hold two
// underscores in a row, so no name reaches them.
//
// The card KPI a draws, mean(mpg) with no fmt(), reads 21.2973 (the %9.0g
// general format); its raw value, 21.2972972972973, is what the card fell
// back to when its statistic was lost.  In the page the card's markup is
// HTML-escaped inside Bokeh's document, so its value is "&gt;21.2973&lt;".

// ---- REG-18 -- a graph named like a KPI's field is a graph ----
// The build log is searched with cert_log_has (see cert_helpers.do above).
// The control first, through the same build and the same search, or the
// absence below proves nothing: an entry that does hold both -- set by
// hand, as REG-15 sets it, on a_stat -- is reported in those words, on one
// line of the log (measured 24sep2026: rc 0, one line).
dash clear
dash scatter price weight, name(a_stat) title("Graph a_stat")
global dash_kpi_a_stat      "1"
global dash_kpi_a_stat__sta "mean"
global dash_kpi_a_stat__var "mpg"
global dash_kpi_a_stat__val "21"
global dash_kpi_a_stat__dsp "21"
global dash_kpi_a_stat__tit "forced"
global dash_kpi_a_stat__upd "filter"
_reg_build r17ctl
local rc17c = r(rc)
local lg "`r(log)'"
assert `rc17c' == 0
cert_log_has "`lg'", needle("registered as both")
assert r(count) == 1
foreach r17o in kpi_first graph_first {
    dash clear
    if "`r17o'" == "kpi_first" {
        dash kpi mean(mpg), title(A) name(a)
        dash scatter price weight, name(a_stat) title("Graph a_stat")
    }
    else {
        dash scatter price weight, name(a_stat) title("Graph a_stat")
        dash kpi mean(mpg), title(A) name(a)
    }
    _reg_spec r17`r17o'
    assert r(rc) == 0
    local sp "`r(spec)'"
    // One graph and one KPI, each whole: no graphs:[] and no KPI a_stat.
    cert_file_has "`sp'", needle(`""graphs":[]"')
    assert r(found) == 0
    cert_file_has "`sp'", needle(`"{"name":"a_stat","stat""')
    assert r(found) == 0
    cert_file_has "`sp'", needle(`"{"name":"a","stat":"mean","var":"mpg""')
    assert r(found) == 1
    _reg_build r17`r17o'
    assert r(rc) == 0
    local pg "`r(page)'"
    local lg "`r(log)'"
    cert_log_has "`lg'", needle("registered as both")
    assert r(found) == 0
    cert_file_has "`pg'", needle("Graph a_stat")
    assert r(found) == 1
    cert_file_has "`pg'", needle("kpi_val_a_stat")
    assert r(found) == 0
    cert_file_has "`pg'", needle("&gt;21.2973&lt;")
    assert r(found) == 1
}
display "REG-18 PASS: graph a_stat beside KPI a is drawn as a graph and KPI a as one card, in either order"

// ---- REG-19 -- the replace the old message advised keeps KPI a whole ----
dash clear
dash kpi mean(mpg), title(A) name(a)
dash scatter price weight, name(a_stat) title("Graph a_stat")
capture noisily dash scatter price weight, name(a_stat, replace) title("Graph a_stat")
assert _rc == 0
_reg_spec r18
assert r(rc) == 0
local sp "`r(spec)'"
cert_file_has "`sp'", needle(`"{"name":"a","stat":"mean","var":"mpg""')
assert r(found) == 1
_reg_build r18
assert r(rc) == 0
local pg "`r(page)'"
cert_file_has "`pg'", needle("Graph a_stat")
assert r(found) == 1
cert_file_has "`pg'", needle("&gt;21.2973&lt;")
assert r(found) == 1
cert_file_has "`pg'", needle("21.2972972972973")
assert r(found) == 0
display "REG-19 PASS: replacing graph a_stat leaves KPI a's statistic in place"

// ---- REG-20 -- a KPI named like another KPI's field changes nothing of it
dash clear
dash kpi mean(mpg), title(A) name(a)
mata: _dash_item_globals("a", "_r19own")
local r19n : word count `_r19own'
assert `r19n' == 7
foreach g of local _r19own {
    local r19v_`g' `"${`g'}"'
}
capture noisily dash kpi mean(price), title(B) name(a_stat)
assert _rc == 0
// Every global KPI a held still holds what it held.
foreach g of local _r19own {
    assert `"${`g'}"' == `"`r19v_`g''"'
}
_reg_spec r19
assert r(rc) == 0
local sp "`r(spec)'"
cert_file_has "`sp'", needle(`"{"name":"a","stat":"mean","var":"mpg""')
assert r(found) == 1
cert_file_has "`sp'", needle(`"{"name":"a_stat","stat":"mean","var":"price""')
assert r(found) == 1
// Under a filter: the payload the filter callback recomputes card A from
// (dash_render.py's _kpi_callback_config) carries mean, not "1".
dash scatter mpg weight, name(g) title("Graph g")
_reg_build r19, filter(foreign, type(dropdown))
assert r(rc) == 0
local pg "`r(page)'"
cert_file_has "`pg'", needle("&gt;21.2973&lt;")
assert r(found) == 1
cert_file_has "`pg'", needle("21.2972972972973")
assert r(found) == 0
cert_file_has "`pg'", needle(`"\"name_html\": \"a\", \"stat\": \"mean\""')
assert r(found) == 1
display "REG-20 PASS: KPI a_stat leaves every global of KPI a as it was, and card A its statistic"

// ---- REG-21 -- replacing KPI a leaves KPI a_b whole ----
dash clear
dash kpi mean(mpg), title(A) name(a)
dash kpi mean(price), title(AB) name(a_b)
local r20b : all globals "dash_kpi_a_b*"
local r20n : word count `r20b'
assert `r20n' == 7
foreach g of local r20b {
    local r20v_`g' `"${`g'}"'
}
capture noisily dash kpi mean(price), title(A2) name(a, replace)
assert _rc == 0
local r20a : all globals "dash_kpi_a_b*"
assert `: list r20a == r20b'
foreach g of local r20b {
    assert `"${`g'}"' == `"`r20v_`g''"'
}
assert "${dash_graph_registry}" == "a a_b"
_reg_build r20
assert r(rc) == 0
local pg "`r(page)'"
cert_file_has "`pg'", needle("kpi_val_a_b")
assert r(found) == 1
cert_file_has "`pg'", needle("&gt;AB&lt;")
assert r(found) == 1
cert_file_has "`pg'", needle("&gt;A2&lt;")
assert r(found) == 1
display "REG-21 PASS: replacing KPI a leaves KPI a_b's globals and card in place"

// ---- REG-22 -- ... and a graph registered after a_b builds ----
// "Traceback" is searched for with cert_log_has too, and needs a control
// of its own, through the same build and the same search: a graph whose
// JSON is cut short dies in the renderer with a JSONDecodeError, and its
// traceback is in the log (measured 24sep2026: rc 7102, the word on one
// line).  REG-23 and REG-27 search their logs for the same word the same
// way.
dash clear
dash scatter price weight, name(g2) title("Graph g2")
mata: st_global("dash_json_g2", substr(st_global("dash_json_g2"), 1, 40))
_reg_build r21ctl
local rc21c = r(rc)
local lg "`r(log)'"
assert `rc21c' == 7102
cert_log_has "`lg'", needle("Traceback")
assert r(count) == 1
dash clear
dash kpi mean(mpg), title(A) name(a)
dash kpi mean(price), title(AB) name(a_b)
dash kpi mean(price), title(A2) name(a, replace)
dash scatter price weight, name(g2) title("Graph g2")
_reg_build r21
assert r(rc) == 0
local pg "`r(page)'"
local lg "`r(log)'"
cert_log_has "`lg'", needle("Traceback")
assert r(found) == 0
cert_file_has "`pg'", needle("Graph g2")
assert r(found) == 1
cert_file_has "`pg'", needle("kpi_val_a_b")
assert r(found) == 1
display "REG-22 PASS: a graph registered after KPI a_b builds beside it"

// ---- REG-23 -- a graph replacing KPI a leaves KPI a_b, and builds ----
dash clear
dash kpi mean(mpg), title(A) name(a)
dash kpi mean(price), title(AB) name(a_b)
local r22b : all globals "dash_kpi_a_b*"
capture noisily dash scatter price weight, name(a, replace) title("Graph a")
assert _rc == 0
local r22a : all globals "dash_kpi_a_b*"
assert `: list r22a == r22b'
assert "${dash_kpi_a}" == ""
_reg_build r22
assert r(rc) == 0
local pg "`r(page)'"
local lg "`r(log)'"
// Searched as REG-22 searches it, whose control sees a traceback.
cert_log_has "`lg'", needle("Traceback")
assert r(found) == 0
cert_file_has "`pg'", needle("Graph a")
assert r(found) == 1
cert_file_has "`pg'", needle("kpi_val_a_b")
assert r(found) == 1
cert_file_has "`pg'", needle(`"kpi_val_a\""')
assert r(found) == 0
display "REG-23 PASS: a graph replacing KPI a leaves KPI a_b, and the dashboard builds"

// ---- REG-24 -- a name ending in an underscore: the separator's edge ----
// KPI a_'s fields are dash_kpi_a___sta, ...: they begin dash_kpi_a__, so a
// prefix on the separator would take them for KPI a's.  A graph and a KPI
// replacing KPI a each leave KPI a_ as it was.
foreach r23k in kpi graph {
    dash clear
    dash kpi mean(mpg), title(A) name(a)
    dash kpi mean(price), title(Aus) name(a_)
    mata: _dash_item_globals("a_", "_r23own")
    local r23n : word count `_r23own'
    assert `r23n' == 7
    foreach g of local _r23own {
        local r23v_`g' `"${`g'}"'
    }
    if "`r23k'" == "kpi" {
        capture noisily dash kpi min(mpg), title(A2) name(a, replace)
    }
    else {
        capture noisily dash scatter price weight, name(a, replace) title("Graph a")
    }
    assert _rc == 0
    foreach g of local _r23own {
        assert `"${`g'}"' == `"`r23v_`g''"'
    }
    _reg_count a_
    assert r(n) == 7
    _reg_build r23`r23k'
    assert r(rc) == 0
    local pg "`r(page)'"
    cert_file_has "`pg'", needle(`"kpi_val_a_\""')
    assert r(found) == 1
    cert_file_has "`pg'", needle("&gt;Aus&lt;")
    assert r(found) == 1
}
display "REG-24 PASS: replacing KPI a, by a KPI or a graph, leaves KPI a_ whole"

// ---- REG-25 -- no name of the form a_<field> reaches KPI a ----
// Every field word, old and new, as a name beside KPI a: KPIs, and one
// graph.  KPI a's globals keep their values and its spec entry is whole.
dash clear
dash kpi mean(mpg), title(A) name(a)
mata: _dash_item_globals("a", "_r24own")
foreach g of local _r24own {
    local r24v_`g' `"${`g'}"'
}
dash scatter price weight, name(a_tit) title("Graph a_tit")
foreach f in stat disp sta dsp var val fmt sub col bg upd if in wgt wex {
    capture noisily dash kpi mean(price), title("T`f'") name(a_`f')
    assert _rc == 0
}
foreach g of local _r24own {
    assert `"${`g'}"' == `"`r24v_`g''"'
}
_reg_spec r24
assert r(rc) == 0
local sp "`r(spec)'"
cert_file_has "`sp'", needle(`"{"name":"a","stat":"mean","var":"mpg","value":"21.2972972972973","display":"21.2972972972973","fmt":"","title":"A","subtitle":"","color":"","bgcolor":"","update":"filter","weight":"","wexp":"","if_expr":"","in_expr":"","qual_col":""}"')
assert r(found) == 1
foreach f in stat disp sta dsp var val fmt sub col bg upd if in wgt wex {
    cert_file_has "`sp'", needle(`"{"name":"a_`f'","stat":"mean","var":"price""')
    assert r(found) == 1
}
cert_file_has "`sp'", needle(`"{"name":"a_tit","stat""')
assert r(found) == 0
display "REG-25 PASS: no KPI or graph named a_<field> changes KPI a"

// ---- REG-26 -- every global a KPI holds is one _dash_item_globals names -
// A KPI given every field, under the longest name a KPI may have: the
// marker and one dash_kpi_<name>__<field> per field, each at most 32
// characters, exactly the globals _dash_item_globals names -- so a field
// the registrar writes cannot be left behind by a replace.
dash clear
local k18 "k23456789012345678"
capture noisily dash kpi mean(mpg) if foreign == 1 in 1/70 [aw=weight], name(`k18') ///
    title("T") subtitle("S") fmt(%9.2f) color(red) bgcolor(white) update(both)
assert _rc == 0
local held : all globals "dash_kpi_`k18'*"
mata: _dash_item_globals("`k18'", "_r25own")
local r25n : word count `held'
// 13 -> 15: the weight's class and variable (WP-31 H2k).
assert `r25n' == 15
assert `: list held == _r25own'
local r25p "dash_kpi_`k18'__"
foreach g of local held {
    assert strlen("`g'") <= 32
    if "`g'" != "dash_kpi_`k18'" {
        assert substr("`g'", 1, strlen("`r25p'")) == "`r25p'"
        local r25f = substr("`g'", strlen("`r25p'") + 1, .)
        assert inrange(strlen("`r25f'"), 1, 3)
        assert strpos("`r25f'", "_") == 0
    }
}
// _dash_kpi_fields(): fourteen words of one to three lower-case letters.
// 12 -> 14: the weight's class and variable, wgt and wex (WP-31 H2k).
mata: st_local("_r25fl", invtokens(_dash_kpi_fields()))
local r25fn : word count `_r25fl'
assert `r25fn' == 14
local r25fu : list uniq _r25fl
assert `: list r25fu == _r25fl'
foreach f of local _r25fl {
    assert inrange(strlen("`f'"), 1, 3)
    assert lower("`f'") == "`f'" & strpos("`f'", "_") == 0
}
// A replace leaves none of them behind.
capture noisily dash scatter mpg weight, name(`k18', replace)
assert _rc == 0
local left : all globals "dash_kpi_`k18'*"
assert "`left'" == ""
display "REG-26 PASS: a KPI's globals are its marker and __-fields, at most 32 characters, all retired by a replace"

// ---- REG-27 -- a registry entry holding nothing is refused aloud ----
// No registrar leaves one now, but the registry is ordinary globals.  It
// was appended to the spec as an empty graph: r(7102) and a Python
// JSONDecodeError, "[, {" when it came first and a trailing comma when it
// came last.
foreach r26r in "g1 ghost" "ghost g1" {
    dash clear
    dash scatter mpg weight, name(g1)
    global dash_graph_registry "`r26r'"
    _reg_build r26
    local rc26 = r(rc)
    local pg "`r(page)'"
    local lg "`r(log)'"
    assert `rc26' == 198
    // One report, and it is this -- on its logical line, whatever Stata's
    // wrapping did to it; and no traceback, searched as REG-22 searches.
    cert_log_has "`lg'", needle("dash build: registry entry 'ghost' holds neither a graph nor a KPI")
    assert r(count) == 1
    cert_log_has "`lg'", needle("Traceback")
    assert r(found) == 0
    capture confirm file "`pg'"
    assert _rc != 0
}
dash clear
display "REG-27 PASS: a registry entry that holds neither a graph nor a KPI is refused with a message, not a traceback"

// ---- REG-28 -- a KPI with no statistic or variable is refused aloud ----
// _dash_kpi always stores both.  A KPI without them was not registered by
// this dash: its marker set by hand, or a KPI an older dash left in the
// session under the one-underscore names, which this one no longer reads.
// It was drawn as a blank card, the one (a) above drew, with nothing said.
foreach r27v in legacy marker {
    dash clear
    dash scatter mpg weight, name(g1)
    global dash_kpi_k1 "1"
    if "`r27v'" == "legacy" {
        global dash_kpi_k1_stat "mean"
        global dash_kpi_k1_var  "mpg"
        global dash_kpi_k1_tit  "Old"
    }
    global dash_graph_registry "g1 k1"
    _reg_build r27
    local rc27 = r(rc)
    local pg "`r(page)'"
    local lg "`r(log)'"
    assert `rc27' == 198
    cert_log_has "`lg'", needle("dash build: registry entry 'k1' holds a KPI with no statistic or variable")
    assert r(count) == 1
    capture confirm file "`pg'"
    assert _rc != 0
}
dash clear
local left : all globals "dash_kpi_*"
assert "`left'" == ""
display "REG-28 PASS: a KPI entry with no statistic or variable is refused with a message, not drawn blank"

// ================================================================
// REG-29..36 -- only name()'s own text decides a replace
// ================================================================
// _dash_register_graph read a replace from name()'s own text and, when
// that held none, from a search of the WHOLE command for name(...,replace)
// -- lower-cased, anywhere, rename( included.  So any text holding those
// characters overwrote a registered graph.  Measured 23sep2026 at ad13a0f,
// after `dash scatter mpg weight, name(g1)', each of these returned rc 0
// and stored price over g1 without a word:
//     dash scatter price weight, name(g1) title("see name(x, replace)")
//     ... note("rename(v, replace)"), subtitle("name(x,replace)"),
//     caption("NAME(x, replace)"), text(20 3000 "name(a, replace)"),
//     if make != "name(a, replace)", and an uppercase NAME(x, replace)
//     option that dash itself reported as unsupported
// as did both paren forms and several || segments.  twoway refuses every
// one of them with r(110) "graph g1 already exists", and replaces through
// name()'s own replace on every route (measured the same day).  A graph
// given KPI k1's name with "name(k1, replace)" in its title deleted the
// KPI card.  The search was the registrar's first way of reading replace
// (25mar2026, the first commit): meant to read name()'s value, it read the
// whole command, and the name check before it refused any name() text
// holding a replace, so it only ever acted on text outside name().  Stata's
// name(string) has captured name()'s whole text on every route since
// 27mar2026 and the split that reads it came on 18sep2026; after that the
// search decided only commands name()'s own text said no to.  A command
// with two name() options was one of those: the name() dash reads said no
// and the other said replace.  twoway refuses all three such forms below
// (r(198) twice, r(110) once).
//
// Each refusal is judged by what it printed and by every global the item
// owns and the registry, before and after; every failed check is collected
// and named before the case fails.

capture mata: mata drop _reg_item_values()
capture mata: mata drop _reg_snap()
capture mata: mata drop _reg_same()
capture mata: mata drop _reg_is_new()
capture mata: mata drop _reg_is_old()
capture mata: mata drop _reg_copy_program()
mata:
// Every global item <nm> owns, sorted, as (name, value) rows: dash_json_,
// dash_spec_, a KPI's marker and a KPI's __-fields.
string matrix _reg_item_values(string scalar nm)
{
    string colvector all
    string matrix    out
    string scalar    p
    real scalar      i
    out = J(0, 2, "")
    p   = "dash_kpi_" + nm + "__"
    all = st_dir("global", "macro", "dash_*")
    if (length(all) == 0) return(out)
    all = sort(all, 1)
    for (i = 1; i <= length(all); i++) {
        if (all[i] == "dash_json_" + nm | all[i] == "dash_spec_" + nm |
            all[i] == "dash_kpi_" + nm | substr(all[i], 1, strlen(p)) == p) {
            out = out \ (all[i], st_global(all[i]))
        }
    }
    return(out)
}

void _reg_snap(string scalar nm)
{
    external string matrix _reg_snapshot
    _reg_snapshot = _reg_item_values(nm)
}

// 1 when item <nm> holds exactly the globals, with exactly the values, it
// held at the last _reg_snap().
real scalar _reg_same(string scalar nm)
{
    external string matrix _reg_snapshot
    string matrix now
    now = _reg_item_values(nm)
    if (rows(now) != rows(_reg_snapshot)) return(0)
    if (rows(now) == 0) return(1)
    return(now == _reg_snapshot)
}

// 1 when graph <nm> is a replacing command's graph: stored under <nm>, it
// draws price, where the graph it replaces drew mpg.
real scalar _reg_is_new(string scalar nm)
{
    string scalar js, q
    q  = char(34)
    js = st_global("dash_json_" + nm)
    return(strpos(js, q + "yvar" + q + ":" + q + "price" + q) > 0 &
           strpos(js, q + "yvar" + q + ":" + q + "mpg" + q) == 0 &
           strpos(js, q + "name" + q + ":" + q + nm + q) > 0)
}

// 1 when graph <nm> is still the one _reg_fresh registered.
real scalar _reg_is_old(string scalar nm)
{
    string scalar js, q
    q  = char(34)
    js = st_global("dash_json_" + nm)
    return(strpos(js, q + "yvar" + q + ":" + q + "mpg" + q) > 0 &
           strpos(js, q + "yvar" + q + ":" + q + "price" + q) == 0 &
           strpos(js, "Old G1") > 0)
}

// Copy program <prog>'s definition from <src> into <dst>, verbatim: from
// its `program define' line to the first `end' after it.
void _reg_copy_program(string scalar src, string scalar prog, string scalar dst)
{
    real scalar   fh, oh, on
    string scalar line
    if (fileexists(dst)) unlink(dst)
    fh = fopen(src, "r")
    oh = fopen(dst, "w")
    on = 0
    while ((line = fget(fh)) != J(0, 0, "")) {
        if (!on & strtrim(line) == "program define " + prog) on = 1
        if (on) fput(oh, line)
        if (on & strtrim(line) == "end") break
    }
    fclose(fh)
    fclose(oh)
}
end

// A fresh registry holding graph g1 -- y mpg, titled "Old G1" -- the graph
// every refusal below must leave exactly as it is.
capture program drop _reg_fresh
program define _reg_fresh
    quietly dash clear
    quietly dash scatter mpg weight, name(g1) title("Old G1")
end

// Run <cmd>, which re-uses registered name <nm> with no replace in the
// name() dash reads, logging what it prints.  Anything wrong is appended to
// the global REG_BAD: a return code other than 198, no refusal naming <nm>
// -- a graph's refusal, or for <kind> kpi a KPI card's -- or any change to
// a global <nm> owns or to the registry.
capture program drop _reg_refused
program define _reg_refused
    args kind nm cmd
    local lg "`c(tmpdir)'dash_reg_refused.log"
    // kind twice: a command giving name() more than once, refused with
    // twoway's own words -- "option name() not allowed", or "option nam()
    // not allowed" where Stata's syntax names the abbreviation it was given
    // (a KPI's second name() is refused by -syntax- itself).
    local msg2 ""
    if "`kind'" == "kpi" {
        local msg "dash kpi: name '`nm'' already exists. Use name(`nm', replace) to overwrite."
    }
    else if "`kind'" == "twice" {
        local msg  "option name() not allowed"
        local msg2 "option nam() not allowed"
    }
    // kind upper: an option written in upper case, NAME(), is no option
    // twoway takes, "option NAME() not allowed", r(198) (measured
    // 24sep2026; test_twoway_option_parity.cscript TP-15).
    else if "`kind'" == "upper" {
        local msg "option NAME() not allowed"
    }
    else {
        local msg "dash: graph name '`nm'' already exists. Use name(`nm', replace) to overwrite."
    }
    mata: _reg_snap("`nm'")
    local reg0 "${dash_graph_registry}"
    local ls = c(linesize)
    set linesize 255
    capture log close _regref
    capture erase "`lg'"
    quietly log using "`lg'", replace text name(_regref)
    capture noisily `cmd'
    local rc = _rc
    quietly log close _regref
    set linesize `ls'
    // The refusal, once, on its logical line: cert_log_has rejoins what
    // Stata's log wraps at c(linesize), and lower keeps the case-insensitive
    // match of the line-by-line reader this used.  That reader called a
    // refusal the log had broken no refusal, though dash printed it -- at
    // linesize 60 a graph's and a KPI card's break at "to overwrite", at 20
    // "option name() not allowed" and "option nam() not allowed" break too
    // -- and did not see a note printed after a long line's worth of text
    // (measured 24sep2026).
    // (kind upper matches case exactly: NAME() is the word it names.)
    if "`kind'" == "upper" cert_log_has "`lg'", needle(`"`msg'"')
    else cert_log_has "`lg'", needle(`"`msg'"') lower
    local said = (r(count) == 1)
    if `said' != 1 & `"`msg2'"' != "" {
        cert_log_has "`lg'", needle(`"`msg2'"') lower
        local said = (r(count) == 1)
    }
    // A refused second name() is refused before the note that names the
    // options dash does not honour, which used to call it "name()".  The
    // note's count is kept in REG_NOTED for the control in REG-32, whose
    // NAME() option is noted, through this same log and search, before its
    // refusal.
    cert_log_has "`lg'", needle("ignoring unsupported option") lower
    global REG_NOTED = r(count)
    if inlist("`kind'", "twice", "upper") & ${REG_NOTED} != 0 local said 0
    mata: st_local("same", strofreal(_reg_same("`nm'")))
    local why ""
    if `rc' != 198 local why "`why' rc=`rc'"
    if `said' != 1 local why "`why' no-refusal"
    if `same' != 1 local why "`why' `nm'-changed"
    if "${dash_graph_registry}" != "`reg0'" local why "`why' registry=[${dash_graph_registry}]"
    if "`why'" != "" {
        mata: st_global("REG_BAD", st_global("REG_BAD") + " | " + st_local("cmd") + " ->" + st_local("why"))
    }
end

// Run <cmd>, which replaces registered graph <nm> through a replace in the
// name() dash reads.  Anything wrong is appended to REG_BAD: a return code
// other than 0, a stored graph that is not the new one, or a registry that
// changed.
capture program drop _reg_replaced
program define _reg_replaced
    args nm cmd
    local reg0 "${dash_graph_registry}"
    capture noisily `cmd'
    local rc = _rc
    mata: st_local("new", strofreal(_reg_is_new("`nm'")))
    local why ""
    if `rc' != 0 local why "`why' rc=`rc'"
    if `new' != 1 local why "`why' not-replaced"
    if "${dash_graph_registry}" != "`reg0'" local why "`why' registry=[${dash_graph_registry}]"
    if "`why'" != "" {
        mata: st_global("REG_BAD", st_global("REG_BAD") + " | " + st_local("cmd") + " ->" + st_local("why"))
    }
end

// Appends to REG_BAD unless g1 is still the graph _reg_fresh registered.
capture program drop _reg_still_g1
program define _reg_still_g1
    mata: st_local("old", strofreal(_reg_is_old("g1")))
    if `old' != 1 {
        mata: st_global("REG_BAD", st_global("REG_BAD") + " | g1 is no longer the graph first registered")
    }
end

// Fails case <id>, naming everything REG_BAD collected, or returns.
capture program drop _reg_verdict
program define _reg_verdict
    args id
    mata: st_local("nbad", strofreal(strlen(st_global("REG_BAD"))))
    if `nbad' > 0 {
        mata: errprintf("%s FAIL:%s\n", st_local("id"), st_global("REG_BAD"))
        exit 9
    }
end

// ---- REG-29 -- title(), subtitle(), note() and caption() text ----
// The spellings the search matched: spaced, unspaced, inside rename(),
// upper case, and the graph's own name as a note would give it.
_reg_fresh
global REG_BAD ""
_reg_refused graph g1 `"dash scatter price weight, name(g1) title("see name(x, replace)")"'
_reg_refused graph g1 `"dash scatter price weight, name(g1) subtitle("name(x,replace)")"'
_reg_refused graph g1 `"dash scatter price weight, name(g1) note("rename(v, replace)")"'
_reg_refused graph g1 `"dash scatter price weight, name(g1) caption("NAME(x, replace)")"'
_reg_refused graph g1 `"dash scatter price weight, name(g1) note("Run it again with name(g1, replace) to update it.")"'
_reg_refused graph g1 `"dash scatter price weight, title("name(g1, replace)") name(g1)"'
_reg_still_g1
_reg_verdict REG-29
display "REG-29 PASS: name(x, replace) in title(), subtitle(), note() or caption() text grants no replace"

// ---- REG-30 -- both paren forms ----
// name() and the text in one group; both after the comma; the text in a
// group with name() after the comma; name() in a group with the text after
// the comma; and || between the groups.
_reg_fresh
global REG_BAD ""
_reg_refused graph g1 `"dash (scatter price weight, name(g1) title("name(x, replace)"))"'
_reg_refused graph g1 `"dash (scatter price weight) (line price weight), name(g1) note("name(x, replace)")"'
_reg_refused graph g1 `"dash (scatter price weight, title("name(x, replace)")) (line price weight), name(g1)"'
_reg_refused graph g1 `"dash (scatter price weight, name(g1)) (line price weight), caption("rename(v, replace)")"'
_reg_refused graph g1 `"dash (scatter price weight, name(g1)) || (line price weight, subtitle("name(x, replace)"))"'
_reg_still_g1
_reg_verdict REG-30
display "REG-30 PASS: in either paren form, text holding name(x, replace) grants no replace"

// ---- REG-31 -- several || segments ----
_reg_fresh
global REG_BAD ""
_reg_refused graph g1 `"dash scatter price weight, name(g1) || line price weight, title("name(x, replace)")"'
_reg_refused graph g1 `"dash scatter price weight, note("name(x, replace)") || line price weight, name(g1)"'
_reg_refused graph g1 `"dash scatter price weight || line price weight || lfit price weight, name(g1) subtitle("name(x,replace)")"'
_reg_still_g1
_reg_verdict REG-31
display "REG-31 PASS: across || segments, text holding name(x, replace) grants no replace"

// ---- REG-32 -- text that is no title, and a KPI's name ----
// text(), an axis title and a legend label, an if qualifier's string, an
// uppercase NAME() option (reported as unsupported), and a graph given a
// KPI card's name: the card must survive whole.
_reg_fresh
quietly dash kpi mean(mpg), name(k1) title("A")
global REG_BAD ""
_reg_refused graph g1 `"dash scatter price weight, name(g1) text(20 3000 "name(a, replace)")"'
_reg_refused graph g1 `"dash scatter price weight, name(g1) ytitle("name(a, replace)") legend(label(1 "name(b, replace)"))"'
_reg_refused graph g1 `"dash scatter price weight if make != "name(a, replace)", name(g1)"'
// NAME() in upper case is no option twoway takes: refused as twoway
// refuses it, "option NAME() not allowed", and g1 left whole (it was
// named in the note until TP-15, 24sep2026).
_reg_refused upper g1 `"dash scatter price weight, name(g1) NAME(x, replace)"'
// Flipped: WP-32 -- the control was zqname(x, replace), an option twoway
// refuses, which dash now refuses as twoway does (BUGS.md "In a few mixed
// lists dash names another word than twoway names first, and an unknown
// lower-case word is noted where twoway refuses it"); afcolor(), which
// twoway takes and dash names in its note, carries the same text.
_reg_refused graph g1 `"dash scatter price weight, name(g1) afcolor(x, replace)"'
// The control for the note a second name() must not print (REG-33 and
// REG-37..41 look for it through this same log and search): this afcolor()
// is noted, once, before g1 is refused.
if "${REG_NOTED}" != "1" {
    mata: st_global("REG_BAD", st_global("REG_BAD") + " | afcolor() was not noted, or the note not seen: [" + st_global("REG_NOTED") + "]")
}
_reg_refused graph k1 `"dash scatter price weight, name(k1) title("name(k1, replace)")"'
_reg_still_g1
if "${dash_kpi_k1}" != "1" | "${dash_kpi_k1__var}" != "mpg" {
    mata: st_global("REG_BAD", st_global("REG_BAD") + " | KPI k1 is no longer the card first registered")
}
_reg_verdict REG-32
display "REG-32 PASS: name(x, replace) in text(), an axis title, a legend, an if qualifier or a NAME() option grants no replace, and a KPI keeps its name"

// ---- REG-33 -- two name() options: a replace in either grants none ----
// Written when dash read one of the two -- the last group's name(), the one
// after the comma over a group's, the first of one option list -- and these
// three were refused only because the one it read held no replace.  A
// second name() is refused as such now (REG-37), before either is read.
_reg_fresh
global REG_BAD ""
_reg_refused twice g1 `"dash (scatter price weight, name(g1, replace)) (line price weight, name(g1))"'
_reg_refused twice g1 `"dash (scatter price weight, name(g1, replace)), name(g1)"'
_reg_refused twice g1 `"dash scatter price weight, name(g1) name(g1, replace)"'
_reg_still_g1
_reg_verdict REG-33
display "REG-33 PASS: of two name() options, a replace in either grants none"

// ---- REG-34 -- name()'s own replace replaces, on every route ----
// Comma form, spaced, first and last paren group, after a paren command's
// comma, first and last || segment, and beside text that holds the words:
// each draws price over g1, under g1, with the registry unchanged.  A new
// name whose text names g1 registers beside it and leaves g1 alone.
global REG_BAD ""
_reg_fresh
_reg_replaced g1 `"dash scatter price weight, name(g1, replace)"'
_reg_fresh
_reg_replaced g1 `"dash scatter price weight, name( g1 ,replace )"'
_reg_fresh
_reg_replaced g1 `"dash (scatter price weight, name(g1, replace)) (line price weight)"'
_reg_fresh
_reg_replaced g1 `"dash (scatter price weight) (line price weight, name(g1, replace))"'
_reg_fresh
_reg_replaced g1 `"dash (scatter price weight) (line price weight), name(g1, replace)"'
_reg_fresh
_reg_replaced g1 `"dash scatter price weight, name(g1, replace) || line price weight"'
_reg_fresh
_reg_replaced g1 `"dash scatter price weight || line price weight, name(g1, replace)"'
_reg_fresh
_reg_replaced g1 `"dash scatter price weight, name(g1, replace) title("name(x, replace)")"'
_reg_fresh
capture noisily dash scatter price weight, name(g2) title("name(g1, replace)")
if _rc != 0 | "${dash_graph_registry}" != "g1 g2" {
    mata: st_global("REG_BAD", st_global("REG_BAD") + " | a new name g2 did not register beside g1")
}
_reg_still_g1
_reg_verdict REG-34
display "REG-34 PASS: a replace in name() itself replaces on every route, and a new name registers"

// ---- REG-35 -- a KPI card reads name() by the same rule ----
// dash kpi never searched the command, and must not start: text holding
// name(x, replace) grants no replace over a card or a graph, and name()'s
// own replace, spaced as a graph's may be, replaces the card.
_reg_fresh
quietly dash kpi mean(mpg), name(k1) title("A")
global REG_BAD ""
_reg_refused kpi k1 `"dash kpi mean(price), name(k1) title("see name(x, replace)")"'
_reg_refused kpi k1 `"dash kpi mean(price), name(k1) title("B") subtitle("rename(v, replace)")"'
_reg_refused kpi g1 `"dash kpi mean(price), name(g1) title("NAME(g1, replace)")"'
capture noisily dash kpi mean(price), name( k1 ,replace ) title("B")
if _rc != 0 | "${dash_kpi_k1__var}" != "price" | "${dash_graph_registry}" != "g1 k1" {
    mata: st_global("REG_BAD", st_global("REG_BAD") + " | name( k1 ,replace ) did not replace KPI k1")
}
_reg_still_g1
_reg_verdict REG-35
display "REG-35 PASS: a KPI card takes a replace from name() alone"

// ---- REG-36 -- _dash_name_split alone decides a replace ----
// A stand-in that never grants one: it hands back the text before the
// comma, flag 0, and notes each text it was asked about.  Every registrar
// must refuse name(g1, replace) and name(k1, replace) then, having asked
// it: the whole-command search granted the graph a replace behind the
// rule's back, and _dash_kpi kept a copy of the rule of its own.  The real
// program is put back from dash.ado before the verdict.
dash clear
quietly dash scatter mpg weight, name(g1) title("Old G1")
quietly dash kpi mean(mpg), name(k1) title("A")
capture program drop _dash_name_split
program define _dash_name_split
    args raw name_macro flag_macro
    mata: st_global("REG_SEEN", st_global("REG_SEEN") + "[" + st_local("raw") + "]")
    local nm = strtrim(`"`raw'"')
    local cp = strpos(`"`nm'"', ",")
    if `cp' > 0 local nm = strtrim(substr(`"`nm'"', 1, `cp' - 1))
    c_local `name_macro' `"`nm'"'
    c_local `flag_macro' 0
end
global REG_BAD ""
global REG_SEEN ""
_reg_refused graph g1 `"dash scatter price weight, name(g1, replace)"'
_reg_refused kpi   k1 `"dash kpi mean(price), name(k1, replace) title("B")"'
mata: st_local("r36g", strofreal(strpos(st_global("REG_SEEN"), "[g1, replace]") > 0))
mata: st_local("r36k", strofreal(strpos(st_global("REG_SEEN"), "[k1, replace]") > 0))
if `r36g' != 1 {
    mata: st_global("REG_BAD", st_global("REG_BAD") + " | the graph's name() never reached _dash_name_split")
}
if `r36k' != 1 {
    mata: st_global("REG_BAD", st_global("REG_BAD") + " | the KPI's name() never reached _dash_name_split")
}
local r36src "`c(tmpdir)'dash_reg_name_split.do"
mata: _reg_copy_program("../dash.ado", "_dash_name_split", st_local("r36src"))
capture program drop _dash_name_split
run "`r36src'"
capture erase "`r36src'"
_dash_name_split " a , replace " _r36n _r36f
if "`_r36n'" != "a" | "`_r36f'" != "1" {
    mata: st_global("REG_BAD", st_global("REG_BAD") + " | the real _dash_name_split was not restored")
}
_reg_verdict REG-36
display "REG-36 PASS: every registrar takes its name and its replace from _dash_name_split alone"

// ================================================================
// REG-37..41 -- a second name() is refused, as twoway refuses it
// ================================================================
// Measured 24sep2026 at 68327a8 with the console binary.  twoway refuses a
// command that gives name() twice -- in another plot group, after a paren
// command's comma, in another || segment, or twice in one option list,
// spelled name() or nam(), naming the same graph or two -- with "option
// name() not allowed", r(198); only when the first name() names a graph it
// already holds without replace does it say "graph g1 already exists",
// r(110), first, and when the first says replace it drops the old graph
// before it refuses.  dash took one of the two -- the last group's, the one
// after the comma over a group's, the first of one list -- called the other
// "ignoring unsupported option(s): name()", and went on: so
//     dash (scatter price weight, name(g1)) (line price weight, name(g1, replace))
// replaced a registered g1 (rc 0), as did the after-comma, || and
// replace-first forms, and with no g1 registered every such command
// registered a graph, the second of two different names among them.  A
// second name() is refused now in every form, with twoway's words, before
// anything is registered or dropped: the registry and every global the
// item owns are left exactly as they were.

// ---- REG-37 -- every form of a second name(), with g1 registered ----
// The four forms that replaced g1, and the abbreviation, in one list and
// across ||, and both name()s saying replace.
_reg_fresh
global REG_BAD ""
_reg_refused twice g1 `"dash (scatter price weight, name(g1)) (line price weight, name(g1, replace))"'
_reg_refused twice g1 `"dash (scatter price weight, name(g1)), name(g1, replace)"'
_reg_refused twice g1 `"dash scatter price weight, name(g1, replace) name(g1)"'
_reg_refused twice g1 `"dash scatter price weight, name(g1) || line price weight, name(g1, replace)"'
_reg_refused twice g1 `"dash scatter price weight, name(g1) nam(g1, replace)"'
_reg_refused twice g1 `"dash scatter price weight, nam(g1, replace) || line price weight, name(g1)"'
_reg_refused twice g1 `"dash (scatter price weight, name(g1, replace)) (line price weight), nam(g1, replace)"'
_reg_still_g1
_reg_verdict REG-37
display "REG-37 PASS: a second name() is refused in every form, and the registered graph is left as it was"

// ---- REG-38 -- a second name() with nothing registered under either ----
// twoway refuses these too, r(198).  dash registered one of them -- a2,
// the last group's, from the first command -- and so a name no other
// command gave it.
_reg_fresh
global REG_BAD ""
_reg_refused twice a1 `"dash (scatter price weight, name(a1)) (line price weight, name(a2))"'
_reg_refused twice a1 `"dash scatter price weight, name(a1) name(a2)"'
_reg_refused twice a1 `"dash scatter price weight, name(a1) name(a1)"'
_reg_refused twice a1 `"dash (scatter price weight, name(a1)) (line price weight), name(a1)"'
_reg_refused twice a1 `"dash scatter price weight, name(a1) || line price weight, name(a1)"'
_reg_refused twice a1 `"dash scatter price weight, name(a1, replace) name(a1, replace)"'
if `"${dash_json_a1}${dash_json_a2}${dash_spec_a1}${dash_spec_a2}"' != "" {
    mata: st_global("REG_BAD", st_global("REG_BAD") + " | a1 or a2 left globals behind")
}
_reg_still_g1
_reg_verdict REG-38
display "REG-38 PASS: two name()s naming nothing registered are refused, and neither is registered"

// ---- REG-39 -- one name() still names the graph, wherever it is written ----
// The positive control: a single name() in the first group, in the last,
// after a paren command's comma or after an || command's last comma
// registers the graph under that name (nam() is refused, as twoway refuses
// it: WP-31 A3b); and text that only
// looks like name() is not a second one -- a title or a note holding
// "name(x)" is text.  An option spelled NAME() is not name() either
// (Stata's options are case-sensitive): twoway refuses it, "option NAME()
// not allowed", r(198), and so does dash (TP-15), registering nothing.
dash clear
global REG_BAD ""
foreach c in ///
    `"dash (scatter price weight, name(b1)) (line price weight)"' ///
    `"dash (scatter price weight) (line price weight, name(b2))"' ///
    `"dash (scatter price weight) (line price weight), name(b3)"' ///
    `"dash scatter price weight || line price weight, name(b4)"' ///
    `"dash scatter price weight, name(b6) title("name(x) and nam(y)") note("name(z, replace)")"' {
    capture noisily `c'
    local rc39 = _rc
    if `rc39' != 0 {
        mata: st_global("REG_BAD", st_global("REG_BAD") + " | " + st_local("c") + " -> rc " + st_local("rc39"))
    }
}
capture noisily dash scatter price weight, name(b7) NAME(zz)
local rc39 = _rc
if `rc39' != 198 {
    mata: st_global("REG_BAD", st_global("REG_BAD") + " | name(b7) NAME(zz) -> rc " + st_local("rc39"))
}
// Flipped (WP-31 A3b): nam(b5) registering b5 was wrong because twoway
// refuses nam(), "option nam() not allowed", r(198), and dash now does.
capture noisily dash scatter price weight, nam(b5)
local rc39 = _rc
if `rc39' != 198 {
    mata: st_global("REG_BAD", st_global("REG_BAD") + " | nam(b5) -> rc " + st_local("rc39"))
}
if "${dash_graph_registry}" != "b1 b2 b3 b4 b6" {
    mata: st_global("REG_BAD", st_global("REG_BAD") + " | registry [" + st_global("dash_graph_registry") + "]")
}
_reg_verdict REG-39
display "REG-39 PASS: one name() names the graph wherever it is written; text is not a second, and NAME() is refused as twoway refuses it"

// ---- REG-40 -- a KPI card takes one name() too ----
// dash kpi declares no catch-all, so Stata's own -syntax- refuses a second
// name() there, in the same words (measured: "option name() not allowed",
// or "option nam() not allowed" when the abbreviation is given).
_reg_fresh
quietly dash kpi mean(mpg), name(k1) title("A")
global REG_BAD ""
_reg_refused twice k9 `"dash kpi mean(price), name(k9) name(k8) title("K")"'
_reg_refused twice k1 `"dash kpi mean(price), name(k1) nam(k1, replace) title("K")"'
if "${dash_kpi_k1__var}" != "mpg" {
    mata: st_global("REG_BAD", st_global("REG_BAD") + " | KPI k1 is no longer the card first registered")
}
_reg_still_g1
_reg_verdict REG-40
display "REG-40 PASS: a KPI card refuses a second name() as a graph does"

// ---- REG-41 -- a flood of name()s is refused at once ----
// Resource exhaustion: a hundred name() options in one list, and sixty plot
// groups each with its own, are refused as the second is seen, registering
// nothing, in bounded time.  Four hundred in one list are past what Stata's
// -syntax- reads in one option list: twoway and dash alike refuse them with
// Stata's own r(1003), "too many options", before either looks at a name()
// (measured 24sep2026; a hundred are refused r(198) by both).
_reg_fresh
global REG_BAD ""
local r41many ""
forvalues i = 1/100 {
    local r41many "`r41many' name(g1, replace)"
}
local r41groups ""
forvalues i = 1/60 {
    local r41groups "`r41groups' (scatter price weight, name(c`i'))"
}
local r41flood ""
forvalues i = 1/400 {
    local r41flood "`r41flood' name(g1, replace)"
}
timer clear 41
timer on 41
_reg_refused twice g1 `"dash scatter price weight, `r41many'"'
_reg_refused twice c1 `"dash `r41groups'"'
local r41reg "${dash_graph_registry}"
capture dash scatter price weight, `r41flood'
local r41rc = _rc
timer off 41
if `r41rc' != 1003 | "${dash_graph_registry}" != "`r41reg'" {
    mata: st_global("REG_BAD", st_global("REG_BAD") + " | four hundred name()s: rc " + st_local("r41rc") + ", registry [" + st_global("dash_graph_registry") + "]")
}
quietly timer list 41
if r(t41) > 30 {
    mata: st_global("REG_BAD", st_global("REG_BAD") + " | took " + strofreal(st_numscalar("r(t41)")) + " s")
}
_reg_still_g1
_reg_verdict REG-41
display "REG-41 PASS: a hundred name()s in one list, sixty groups each with one, and four hundred are refused at once"

// ================================================================
// REG-42..43 -- ROADMAP WP-04's AC-04.2 and AC-04.3 as written
// ================================================================
// Added by WP-24's mutation check of WP-04.  REG-04 to REG-06 hold AC-04.2
// in the globals but never build: no case built a dashboard after a KPI
// took a graph's name.  REG-15 holds AC-04.3 by the word "both" in the log,
// which passes whatever the warning names -- measured, with the entry's
// name taken out of the warning, REG-15 still passed.

// ---- REG-42 -- AC-04.2: with replace, the build holds the KPI card and
// no trace of the graph it replaced ----
dash clear
dash scatter mpg weight, name(g1) title("Graph g1")
capture noisily dash kpi mean(mpg), name(g1, replace) title("Avg")
assert _rc == 0
assert `"${dash_json_g1}"' == ""
assert "${dash_graph_registry}" == "g1"
_reg_spec r42
assert r(rc) == 0
local sp "`r(spec)'"
cert_file_has "`sp'", needle(`""graphs":[]"')
assert r(found) == 1
cert_file_has "`sp'", needle(`"{"name":"g1","stat":"mean","var":"mpg""')
assert r(found) == 1
_reg_build r42
assert r(rc) == 0
local pg "`r(page)'"
local lg "`r(log)'"
// Searched as REG-18 searches it, whose control sees the warning.
cert_log_has "`lg'", needle("registered as both")
assert r(found) == 0
cert_file_has "`pg'", needle(`"kpi_val_g1\""')
assert r(found) == 1
cert_file_has "`pg'", needle("&gt;Avg&lt;")
assert r(found) == 1
cert_file_has "`pg'", needle("Graph g1")
assert r(found) == 0
display "REG-42 PASS: AC-04.2 -- after name(g1, replace) the build draws the KPI card, holds no graph g1 and warns of no entry held twice"

// ---- REG-43 -- AC-04.3: an entry the build draws only half of is named
// in the warning ----
// The state no registrar can reach, set by hand as REG-15 sets it.
dash clear
dash scatter mpg weight, name(b1) title("Graph b1")
global dash_kpi_b1      "1"
global dash_kpi_b1__sta "mean"
global dash_kpi_b1__var "mpg"
global dash_kpi_b1__val "21"
global dash_kpi_b1__dsp "21"
global dash_kpi_b1__tit "forced"
global dash_kpi_b1__upd "filter"
_reg_build r43
assert r(rc) == 0
local pg "`r(page)'"
local lg "`r(log)'"
cert_log_has "`lg'", needle("dash build: 'b1' is registered as both a graph and a KPI; drawing the KPI.")
assert r(count) == 1
cert_file_has "`pg'", needle("&gt;forced&lt;")
assert r(found) == 1
cert_file_has "`pg'", needle("Graph b1")
assert r(found) == 0
display "REG-43 PASS: AC-04.3 -- the build names b1, the entry it skips the graph of, and draws its KPI card"

// ================================================================
// Q3306-1..3, Q3306-10 (WP-33 33-06) -- dash image shares the registry
// ================================================================
dash clear
qui sysuse auto, clear
local q6svg "fixtures/svg_truth_smoke.svg"

// Q3306-1: an image registers, and name(, replace) replaces it in place.
capture noisily dash image using "`q6svg'", name(im1) caption("First")
local q1a = _rc
capture noisily dash image using "`q6svg'", name(im1, replace) caption("Second")
local q1b = _rc
local q1n : word count ${dash_graph_registry}
mata: st_local("q1ok", strofreal(st_global("dash_img_im1") == "1" & ///
    st_global("dash_img_im1__cap") == "Second" & ///
    st_global("dash_img_im1__alt") == "Second" & ///
    st_global("dash_img_im1__lnk") == "" & ///
    pathisabs(st_global("dash_img_im1__pth"))))
if `q1a' != 0 | `q1b' != 0 | `q1n' != 1 | `q1ok' != 1 {
    display as error "Q3306-1 FAIL: rc `q1a' `q1b', registry `q1n', fields `q1ok'"
}
else display "Q3306-1 PASS: an image registers and name(, replace) replaces it"
assert `q1a' == 0 & `q1b' == 0 & `q1n' == 1 & `q1ok' == 1

// Q3306-2: a taken name is refused without replace, by an image, a KPI
// and a graph alike, and the image is kept.
capture noisily dash image using "`q6svg'", name(im1)
local q2a = _rc
capture noisily dash kpi mean(mpg), name(im1) title("K")
local q2b = _rc
capture noisily dash scatter mpg weight, name(im1)
local q2c = _rc
if `q2a' != 198 | `q2b' != 198 | `q2c' != 198 | "${dash_img_im1}" != "1" {
    display as error "Q3306-2 FAIL: rc `q2a' `q2b' `q2c'"
}
else display "Q3306-2 PASS: a taken image name is refused without replace"
assert `q2a' == 198 & `q2b' == 198 & `q2c' == 198 & "${dash_img_im1}" == "1"

// Q3306-3: a graph registered under the image's name with replace
// retires every global the image owned.
capture noisily dash scatter mpg weight, name(im1, replace)
local q3a = _rc
mata: st_local("q3left", invtokens(st_dir("global", "macro", "dash_img_*")'))
local q3n : word count ${dash_graph_registry}
local q3j : strlen global dash_json_im1
if `q3a' != 0 | "`q3left'" != "" | `q3n' != 1 | `q3j' == 0 {
    display as error "Q3306-3 FAIL: rc `q3a', left `q3left', registry `q3n'"
}
else display "Q3306-3 PASS: a graph under an image's name retires the image"
assert `q3a' == 0 & "`q3left'" == "" & `q3n' == 1 & `q3j' > 0

// Q3306-10: an 18-character name registers, a 19-character one is refused
// in dash kpi's words and leaves no global.
dash clear
local n18 "abcdefghijklmnopqr"
local n19 "abcdefghijklmnopqrs"
capture noisily dash image using "`q6svg'", name(`n18')
local q10a = _rc
local q10l = strlen("dash_img_`n18'__lnk")
local q10lg "`c(tmpdir)'dash_reg_q3306_10.log"
capture erase "`q10lg'"
quietly log using "`q10lg'", replace text name(_q10log)
capture noisily dash image using "`q6svg'", name(`n19')
local q10b = _rc
quietly log close _q10log
cert_log_has "`q10lg'", needle("dash image: invalid name 'abcdefghijklmnopqrs'. Names must start with a letter or underscore, contain only letters, digits, and underscores, and be at most 18 characters.")
local q10w = r(count)
mata: _dash_item_globals(st_local("n19"), "_left")
capture erase "`q10lg'"
if `q10a' != 0 | `q10l' != 32 | "${dash_img_`n18'}" != "1" | `q10b' != 198 | `q10w' != 1 | "`_left'" != "" {
    display as error "Q3306-10 FAIL: rc `q10a' `q10b', len `q10l', said `q10w', left `_left'"
}
else display "Q3306-10 PASS: an image name is at most 18 characters"
assert `q10a' == 0 & `q10l' == 32 & `q10b' == 198 & `q10w' == 1 & "`_left'" == ""

// ================================================================
// Q3307-1 (WP-33 33-07) -- a named registration records its frame
// ================================================================
// frame cars: dash ..., name(g1) stores the frame in dash_frm_g1, as
// twoway draws from the frame its command runs in; a registration in the
// default frame stores that frame; dash clear leaves no dash_frm_* global.
dash clear
capture frame drop cars
frame create cars
frame cars: quietly sysuse auto, clear
quietly sysuse auto, clear
frame cars: dash scatter mpg weight, name(g1)
local q1a "${dash_frm_g1}"
dash scatter mpg weight, name(g1, replace)
local q1b "${dash_frm_g1}"
local q1cur = c(frame)
dash clear
mata: st_local("q1left", invtokens(st_dir("global", "macro", "dash_frm_*")'))
frame drop cars
if "`q1a'" != "cars" | "`q1b'" != "`q1cur'" | "`q1left'" != "" {
    display as error "Q3307-1 FAIL: frame '`q1a'' then '`q1b'' (current `q1cur'), left `q1left'"
}
else display "Q3307-1 PASS: a named registration records the frame it ran in, and dash clear removes it"
assert "`q1a'" == "cars" & "`q1b'" == "`q1cur'" & "`q1left'" == ""

// ================================================================
// Q3802-1 (WP-38 GW-13) -- name()'s limits and a name already held,
// beside twoway
// ================================================================
// dash.sthlp, The registry: return codes and messages, Names.  twoway
// takes a name of up to 32 characters (33 is "<name> invalid name",
// r(198)) and a__b, and refuses a name it holds, "graph q1 already
// exists", r(110); dash takes at most 22 characters and no __, and
// refuses a name it holds in its own words, r(198).  Measured 30oct2026.
capture graph drop _all
dash clear
tempname q1f
tempfile q1lg
local q1ls = c(linesize)
set linesize 255
quietly log using "`q1lg'", replace text name(`q1f')
capture noisily twoway scatter mpg weight, name(q1) nodraw
local q1t1 = _rc
capture noisily twoway scatter mpg weight, name(q1) nodraw
local q1t2 = _rc
capture noisily dash scatter mpg weight, name(q1)
local q1d1 = _rc
capture noisily dash scatter mpg weight, name(q1)
local q1d2 = _rc
local q1n32 "abcdefghijklmnopqrstuvwxyzabcdef"
local q1n33 "`q1n32'g"
local q1n22 = substr("`q1n32'", 1, 22)
local q1n23 = substr("`q1n32'", 1, 23)
capture noisily twoway scatter mpg weight, name(`q1n32') nodraw
local q1t32 = _rc
capture noisily twoway scatter mpg weight, name(`q1n33') nodraw
local q1t33 = _rc
capture noisily twoway scatter mpg weight, name(a__b) nodraw
local q1tab = _rc
capture noisily dash scatter mpg weight, name(`q1n22')
local q1d22 = _rc
capture noisily dash scatter mpg weight, name(`q1n23')
local q1d23 = _rc
capture noisily dash scatter mpg weight, name(a__b)
local q1dab = _rc
quietly log close `q1f'
set linesize `q1ls'
cert_log_has "`q1lg'", needle("graph q1 already exists")
local q1h1 = r(found)
cert_log_has "`q1lg'", needle("dash: graph name 'q1' already exists. Use name(q1, replace) to overwrite.")
local q1h2 = r(found)
cert_log_has "`q1lg'", needle("`q1n33' invalid name")
local q1h3 = r(found)
capture graph drop _all
dash clear
local q1rc "`q1t1' `q1t2' `q1d1' `q1d2' `q1t32' `q1t33' `q1tab' `q1d22' `q1d23' `q1dab'"
if "`q1rc'" != "0 110 0 198 0 198 0 0 198 198" | !`q1h1' | !`q1h2' | !`q1h3' {
    display as error "Q3802-1 FAIL: rcs `q1rc', words `q1h1' `q1h2' `q1h3'"
}
else display "Q3802-1 PASS: twoway takes 32 characters and a__b and says r(110) for a name it holds; dash takes 22, no __, and says r(198)"
assert "`q1rc'" == "0 110 0 198 0 198 0 0 198 198" & `q1h1' & `q1h2' & `q1h3'

dash clear
macro drop REG_BAD REG_SEEN REG_NOTED
capture program drop _reg_fresh
capture program drop _reg_refused
capture program drop _reg_replaced
capture program drop _reg_still_g1
capture program drop _reg_verdict
capture program drop _reg_count
capture program drop _reg_build
capture program drop _reg_spec

display ""
display "All registry collision tests PASSED."
