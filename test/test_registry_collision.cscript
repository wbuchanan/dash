*! test_registry_collision.cscript  v1.1
*! Certification script for the graph/KPI registry namespace.
*!
*! Graphs and KPIs share one registry and one namespace.  `dash' checked for
*! a collision on one side of it and not the other:
*!
*!   dash scatter mpg weight, name(g1)      -> registered
*!   dash line    mpg weight, name(g1)      -> r(198), use name(g1, replace)
*!   dash kpi     mean(mpg),  name(g1)      -> rc 0, in SILENCE
*!
*! _dash_register_graph refuses a duplicate unless `replace' is given.
*! _dash_kpi had no check at all, so a KPI could take a name a graph already
*! held -- and then win it.  At build time _dash_prepare_spec skips any
*! registry entry carrying a KPI marker, so the graph was dropped from the
*! dashboard: measured, the built file held the KPI's text and ZERO graph
*! models.  rc 0 throughout, and no message.
*!
*! A second KPI of the same name overwrote the first as quietly -- measured,
*! `dash kpi mean(mpg), name(k2)' then `dash kpi max(mpg), name(k2)' left
*! ${dash_kpi_k2_stat} == "max" with nothing said.
*!
*! The reverse direction was already safe: a graph cannot take a KPI's name,
*! because _dash_register_graph looks at the registry and the KPI is in it.
*!
*! One item's globals were also another name's.  A KPI kept its fields in
*! globals named by appending to its own -- dash_kpi_<name>_stat, _var,
*! _val, ... -- which are the globals of the legal name <name>_stat.
*! Measured 23sep2026 at 9f48cf7: KPI a beside a graph a_stat drew card A,
*! a blank card and no figure; KPI a beside KPI a_stat set KPI a's statistic
*! to "1"; replacing KPI a deleted KPI a_b's globals, and the next build
*! dropped the AB card or died with r(7102) and a JSONDecodeError.  REG-18
*! through REG-28.
*!
*! Tests: REG-01 through REG-28
*!
*! Usage:  do test/test_registry_collision.cscript
*! Version: 1.1  23sep2026

cscript "graph and KPI share one namespace" adodir ".."

// `cscript' drops every global macro, the runner's $dash_nobrowser with them;
// set it again before this script builds a dashboard (test_cscript_hygiene.py).
global dash_nobrowser 1

// ----------------------------------------------------------------
// Setup
// ----------------------------------------------------------------
capture which jsonio
if _rc != 0 {
    display as error "SKIP: jsonio not installed. Run dash_setup first."
    exit 222
}
if "`c(python_exec)'" == "" {
    display as error "SKIP: Python not available."
    exit 222
}

qui sysuse auto, clear
do "../dash_parse.mata"
do "../dash.ado"

// cert_file_has: asks whether a file holds a string, from Mata, where the
// file's text is a value and never macro text.  Loaded from this directory,
// as the runner runs every script from it.
do "cert_helpers.do"

// How many globals does the registry still hold for `name'?  Counted in
// Mata against the exact names, because `macro drop dash_kpi_g1*' would also
// take g10's -- the name grammar allows both to exist at once.  A KPI's
// fields are dash_kpi_<name>__<field>, a field being letters: a prefix
// alone would count KPI a_'s dash_kpi_a___sta as KPI a's.  Written apart
// from dash's own _dash_item_globals, so the two can disagree.
capture program drop _reg_count
program define _reg_count, rclass
    args nm
    mata: st_local("_rc_n", strofreal(_reg_item_globals("`nm'")))
    return scalar n = `_rc_n'
end

// dash build to a page of its own under c(tmpdir), keeping what it
// printed: r(rc), r(page) and r(log).  The page is erased first, so a page
// an earlier run left cannot answer a check of this one.  cert_file_has is
// rclass, so a caller copies these into locals before its first check.
capture program drop _reg_build
program define _reg_build, rclass
    syntax name(name=tag) [, *]
    local page "`c(tmpdir)'dash_reg_`tag'.html"
    local lg   "`c(tmpdir)'dash_reg_`tag'.log"
    capture erase "`page'"
    local ls = c(linesize)
    set linesize 255
    quietly log using "`lg'", replace text name(_reglog)
    capture noisily dash build, saving("`page'") replace nobrowser `options'
    local rc = _rc
    quietly log close _reglog
    set linesize `ls'
    return scalar rc = `rc'
    return local page "`page'"
    return local log  "`lg'"
end

// The spec `dash build' would hand the renderer, from the program that
// assembles it for both dash build and dash serve: r(rc) and r(spec).  No
// Python runs.
capture program drop _reg_spec
program define _reg_spec, rclass
    syntax name(name=tag)
    local sp "`c(tmpdir)'dash_reg_`tag'_spec.json"
    local dp "`c(tmpdir)'dash_reg_`tag'_data.json"
    capture erase "`sp'"
    capture erase "`dp'"
    capture noisily _dash_prepare_spec, cmdname("dash build") ///
        specpath("`sp'") datapath("`dp'")
    return scalar rc = _rc
    return local spec "`sp'"
end

mata:
real scalar _reg_item_globals(string scalar nm)
{
    string colvector all
    string scalar    p
    real scalar      i, n
    n   = 0
    p   = "dash_kpi_" + nm + "__"
    all = st_dir("global", "macro", "dash_*")
    for (i = 1; i <= length(all); i++) {
        if (all[i] == "dash_json_" + nm |
            all[i] == "dash_spec_" + nm |
            all[i] == "dash_kpi_"  + nm) n = n + 1
        else if (substr(all[i], 1, strlen(p)) == p) {
            if (regexm(substr(all[i], strlen(p) + 1, .), "^[a-z]+$")) n = n + 1
        }
    }
    return(n)
}

real scalar _reg_log_has(string scalar fn, string scalar needle)
{
    real scalar   fh, found
    string scalar line
    found = 0
    fh = fopen(fn, "r")
    while ((line = fget(fh)) != J(0,0,"")) {
        if (strpos(strlower(line), strlower(needle))) found = 1
    }
    fclose(fh)
    return(found)
}
end


// ================================================================
// REG-01..03 — a KPI may not silently take a graph's name
// ================================================================
dash clear
dash scatter mpg weight, name(g1)
capture noisily dash kpi mean(mpg), name(g1) title("Avg")
assert _rc == 198
display "REG-01 PASS: a KPI cannot take a graph's name without replace"

// The refusal must leave the graph exactly as it was.
assert `"${dash_json_g1}"' != ""
assert "${dash_kpi_g1}" == ""
assert "${dash_graph_registry}" == "g1"
display "REG-02 PASS: the refused KPI left the graph untouched"

// And the build still contains the graph.
tempfile out1
capture noisily dash build, saving("`out1'.html") replace nobrowser
assert _rc == 0
display "REG-03 PASS: the graph still builds after a refused KPI"

// ================================================================
// REG-04..06 — with replace, the KPI takes the name cleanly
// ================================================================
dash clear
dash scatter mpg weight, name(g1)
capture noisily dash kpi mean(mpg), name(g1, replace) title("Avg")
assert _rc == 0
display "REG-04 PASS: name(g1, replace) lets a KPI take a graph's name"

// No orphan: the graph's JSON must be gone, or the build would carry a
// registry entry that is both a graph and a KPI.
assert `"${dash_json_g1}"' == ""
assert `"${dash_spec_g1}"' == ""
assert "${dash_kpi_g1}" == "1"
display "REG-05 PASS: the superseded graph's globals are dropped"

assert "${dash_graph_registry}" == "g1"
display "REG-06 PASS: the name appears once in the registry, not twice"

// ================================================================
// REG-07..09 — a KPI may not silently take another KPI's name
// ================================================================
dash clear
dash kpi mean(mpg), name(k2) title("A")
capture noisily dash kpi max(mpg), name(k2) title("B")
assert _rc == 198
assert "${dash_kpi_k2__sta}" == "mean"
display "REG-07 PASS: a duplicate KPI name is refused, and the first survives"

capture noisily dash kpi max(mpg), name(k2, replace) title("B")
assert _rc == 0
assert "${dash_kpi_k2__sta}" == "max"
display "REG-08 PASS: with replace the second KPI wins"

assert "${dash_graph_registry}" == "k2"
display "REG-09 PASS: replacing a KPI does not duplicate the registry entry"

// ================================================================
// REG-10..11 — the reverse direction, which was already safe
// ================================================================
dash clear
dash kpi mean(mpg), name(k1) title("Avg")
capture noisily dash scatter mpg weight, name(k1)
assert _rc == 198
display "REG-10 PASS: a graph cannot take a KPI's name without replace"

capture noisily dash scatter mpg weight, name(k1, replace)
assert _rc == 0
// The KPI's globals must go, or the build skips the graph it just accepted.
assert "${dash_kpi_k1}" == ""
assert "${dash_kpi_k1__sta}" == ""
local reg11 : all globals "dash_kpi_k1*"
assert "`reg11'" == ""
assert `"${dash_json_k1}"' != ""
display "REG-11 PASS: replacing a KPI with a graph drops the KPI's globals"

// ================================================================
// REG-12 — no item leaves globals behind after a replace
// ================================================================
// Counted exactly, so a stray dash_kpi_<name>_* cannot hide.
dash clear
dash scatter mpg weight, name(g2)
_reg_count g2
local before = r(n)
assert `before' > 0
capture noisily dash kpi mean(mpg), name(g2, replace) title("K")
assert _rc == 0
_reg_count g2
// Only the KPI's own globals remain: no dash_json_g2, no dash_spec_g2.
assert `"${dash_json_g2}"' == ""
assert `"${dash_spec_g2}"' == ""
display "REG-12 PASS: a replace leaves no globals from the superseded item"

// ================================================================
// REG-13 — a similarly-named item is not collateral damage
// ================================================================
// `macro drop dash_kpi_g1*' would take g10's globals too.  Both names are
// legal and may be registered at once.
dash clear
dash kpi mean(mpg),  name(k1) title("one")
dash kpi max(mpg),   name(k10) title("ten")
capture noisily dash kpi min(mpg), name(k1, replace) title("one again")
assert _rc == 0
assert "${dash_kpi_k10}" == "1"
assert "${dash_kpi_k10__sta}" == "max"
assert `"${dash_kpi_k10__tit}"' == "ten"
display "REG-13 PASS: replacing k1 does not disturb k10"

// ================================================================
// REG-14 — regression: ordinary registration still works
// ================================================================
dash clear
dash scatter mpg weight, name(a1)
dash line mpg weight, name(a2)
dash kpi mean(mpg), name(a3) title("M")
assert "${dash_graph_registry}" == "a1 a2 a3"
tempfile out2
capture noisily dash build, saving("`out2'.html") replace nobrowser
assert _rc == 0
display "REG-14 PASS: two graphs and a KPI register and build as before"

// ================================================================
// REG-15 — a name holding both is reported, not silently dropped
// ================================================================
// Neither registrar can produce this state any more.  The registry is kept
// in ordinary Stata globals, though, so a do-file that sets dash_* by hand
// still can -- and the build used to pass over such an entry without a word.
dash clear
dash scatter mpg weight, name(b1)
global dash_kpi_b1      "1"
global dash_kpi_b1__sta "mean"
global dash_kpi_b1__var "mpg"
global dash_kpi_b1__val "21"
global dash_kpi_b1__dsp "21"
global dash_kpi_b1__tit "forced"
global dash_kpi_b1__upd "filter"
tempname blf
tempfile blg
quietly log using "`blg'", replace text name(`blf')
tempfile out3
capture noisily dash build, saving("`out3'.html") replace nobrowser
local brc = _rc
quietly log close `blf'
mata: st_local("_reg_warned", strofreal(_reg_log_has("`blg'", "both")))
assert `brc' == 0
assert `_reg_warned' == 1
display "REG-15 PASS: an entry registered as both is named in the output"

// ================================================================
// REG-16 — _all is link()'s word, never a name
// ================================================================
// Measured 23sep2026: a graph named _all registered, and link(_all g2)
// then built -- every graph linked when saved, _all and g2 when served --
// while link(_all g2) over graphs of other names was refused as naming a
// graph the registry lacked.  _all is refused as a name now, for a graph
// and a KPI card, and link(_all) beside names is refused for what it is.
dash clear
local r16ls = c(linesize)
set linesize 255
tempname r16f
tempfile r16g
quietly log using "`r16g'", replace text name(`r16f')
capture noisily dash scatter mpg weight, name(_all)
local r16a = _rc
capture noisily dash kpi mean(mpg), name(_all) title("A")
local r16b = _rc
quietly log close `r16f'
assert `r16a' == 198
assert `r16b' == 198
mata: st_local("_reg_g", strofreal(_reg_log_has("`r16g'", "dash: graph name '_all' is the word link(_all) uses for every graph")))
mata: st_local("_reg_k", strofreal(_reg_log_has("`r16g'", "dash kpi: name '_all' is the word link(_all) uses for every graph")))
assert `_reg_g' == 1
assert `_reg_k' == 1
assert "${dash_graph_registry}" == ""
dash scatter mpg weight, name(g1)
dash scatter price weight, name(g2)
tempfile out4
quietly log using "`r16g'", replace text name(`r16f')
capture noisily dash build, saving("`out4'.html") replace nobrowser link(_all g2)
local r16c = _rc
quietly log close `r16f'
set linesize `r16ls'
assert `r16c' == 198
mata: st_local("_reg_l", strofreal(_reg_log_has("`r16g'", "link(_all) links every graph; give it alone")))
assert `_reg_l' == 1
capture noisily dash build, saving("`out4'.html") replace nobrowser link(_all)
assert _rc == 0
display "REG-16 PASS: _all is refused as a graph or KPI name, and link(_all) beside names is refused for what it is"

// ================================================================
// REG-17 -- the one rule that reads name()'s ", replace"
// ================================================================
// _dash_name_split turns name()'s text into the name and a replace flag.
// _dash_plot writes that name into the stored graph and
// _dash_register_graph registers it; they read name() separately before,
// and the stored graph kept "g1, replace" as its name while the registry
// said g1 (test_adversarial.cscript P20-33).  Spaces around the comma are
// allowed, as twoway allows them; anything else after the comma stays in
// the name for the name check to refuse, as twoway refuses rep, REPLACE,
// replace x and a missing comma (measured 23sep2026).
capture program list _dash_name_split
if _rc != 0 {
    display as error "REG-17 FAIL: _dash_name_split is not defined"
    exit 9
}
capture program drop _reg_split
program define _reg_split
    args raw want_name want_flag
    _dash_name_split `"`raw'"' _r17n _r17f
    if `"`_r17n'"' != `"`want_name'"' | "`_r17f'" != "`want_flag'" {
        mata: printf("{err}REG-17 FAIL: [%s] split as [%s] flag %s, not [%s] flag %s\n", ///
            st_local("raw"), st_local("_r17n"), st_local("_r17f"), ///
            st_local("want_name"), st_local("want_flag"))
        exit 9
    }
end
_reg_split "g1, replace"        "g1" 1
_reg_split "g1,replace"         "g1" 1
_reg_split "g1 ,replace"        "g1" 1
_reg_split "g1 , replace"       "g1" 1
_reg_split " g1 ,  replace "    "g1" 1
_reg_split "a_stat, replace"    "a_stat" 1
_reg_split "g1"                 "g1" 0
_reg_split " g1 "               "g1" 0
_reg_split ""                   "" 0
_reg_split "g1, rep"            "g1, rep" 0
_reg_split "g1, REPLACE"        "g1, REPLACE" 0
_reg_split "g1, replace x"      "g1, replace x" 0
_reg_split "g1 replace"         "g1 replace" 0
_reg_split ", replace"          ", replace" 0
_reg_split "a, b, replace"      "a, b, replace" 0
// Hostile text is split, never run: the name check refuses it afterwards.
_reg_split `"a"b, replace"'     `"a"b"' 1
_reg_split "{bf:x}, replace"    "{bf:x}" 1
capture program drop _reg_split
display "REG-17 PASS: name()'s text splits into the name and a replace flag by one rule"
// REG-18..27 -- one item's globals are never another name's
// ================================================================
// A KPI kept its fields in globals named by appending to its name --
// dash_kpi_<name>_stat, _var, _val, _disp, _fmt, _tit, _sub, _col, _bg,
// _upd, _if, _in -- and those are the globals of another legal name that
// holds one underscore.  Measured 23sep2026 at 9f48cf7, rc 0 unless said:
//   KPI a, graph a_stat (either order): dash build printed "'a_stat' is
//     registered as both a graph and a KPI; drawing the KPI" and drew card
//     A, a BLANK card and no figure.  The advice it printed,
//     name(a_stat, replace), drew the graph and deleted KPI a's statistic:
//     card A read 21.2972972972973 where KPI a alone reads 21.2973.
//   KPI a, KPI a_stat: $dash_kpi_a_stat went from "mean" to "1" in
//     silence; card A read 21.2972972972973, and 0 under a Foreign filter
//     where summarize mpg if foreign==1 gives 24.7727.
//   KPI a, KPI a_b, then name(a, replace): all seven of a_b's globals were
//     deleted while the registry still read "a a_b"; the build drew no AB
//     card and said nothing -- and died with r(7102) and a Python
//     JSONDecodeError once a graph was registered after a_b, or when a
//     graph replaced KPI a.
// A KPI's fields are dash_kpi_<name>__<field> now.  No name may hold two
// underscores in a row, so no name reaches them.
//
// The card KPI a draws, mean(mpg) with no fmt(), reads 21.2973 (the %9.0g
// general format); its raw value, 21.2972972972973, is what the card fell
// back to when its statistic was lost.  In the page the card's markup is
// HTML-escaped inside Bokeh's document, so its value is "&gt;21.2973&lt;".

// ---- REG-18 -- a graph named like a KPI's field is a graph ----
foreach r17o in kpi_first graph_first {
    dash clear
    if "`r17o'" == "kpi_first" {
        dash kpi mean(mpg), title(A) name(a)
        dash scatter price weight, name(a_stat) title("Graph a_stat")
    }
    else {
        dash scatter price weight, name(a_stat) title("Graph a_stat")
        dash kpi mean(mpg), title(A) name(a)
    }
    _reg_spec r17`r17o'
    assert r(rc) == 0
    local sp "`r(spec)'"
    // One graph and one KPI, each whole: no graphs:[] and no KPI a_stat.
    cert_file_has "`sp'", needle(`""graphs":[]"')
    assert r(found) == 0
    cert_file_has "`sp'", needle(`"{"name":"a_stat","stat""')
    assert r(found) == 0
    cert_file_has "`sp'", needle(`"{"name":"a","stat":"mean","var":"mpg""')
    assert r(found) == 1
    _reg_build r17`r17o'
    assert r(rc) == 0
    local pg "`r(page)'"
    local lg "`r(log)'"
    cert_file_has "`lg'", needle("registered as both")
    assert r(found) == 0
    cert_file_has "`pg'", needle("Graph a_stat")
    assert r(found) == 1
    cert_file_has "`pg'", needle("kpi_val_a_stat")
    assert r(found) == 0
    cert_file_has "`pg'", needle("&gt;21.2973&lt;")
    assert r(found) == 1
}
display "REG-18 PASS: graph a_stat beside KPI a is drawn as a graph and KPI a as one card, in either order"

// ---- REG-19 -- the replace the old message advised keeps KPI a whole ----
dash clear
dash kpi mean(mpg), title(A) name(a)
dash scatter price weight, name(a_stat) title("Graph a_stat")
capture noisily dash scatter price weight, name(a_stat, replace) title("Graph a_stat")
assert _rc == 0
_reg_spec r18
assert r(rc) == 0
local sp "`r(spec)'"
cert_file_has "`sp'", needle(`"{"name":"a","stat":"mean","var":"mpg""')
assert r(found) == 1
_reg_build r18
assert r(rc) == 0
local pg "`r(page)'"
cert_file_has "`pg'", needle("Graph a_stat")
assert r(found) == 1
cert_file_has "`pg'", needle("&gt;21.2973&lt;")
assert r(found) == 1
cert_file_has "`pg'", needle("21.2972972972973")
assert r(found) == 0
display "REG-19 PASS: replacing graph a_stat leaves KPI a's statistic in place"

// ---- REG-20 -- a KPI named like another KPI's field changes nothing of it
dash clear
dash kpi mean(mpg), title(A) name(a)
mata: _dash_item_globals("a", "_r19own")
local r19n : word count `_r19own'
assert `r19n' == 7
foreach g of local _r19own {
    local r19v_`g' `"${`g'}"'
}
capture noisily dash kpi mean(price), title(B) name(a_stat)
assert _rc == 0
// Every global KPI a held still holds what it held.
foreach g of local _r19own {
    assert `"${`g'}"' == `"`r19v_`g''"'
}
_reg_spec r19
assert r(rc) == 0
local sp "`r(spec)'"
cert_file_has "`sp'", needle(`"{"name":"a","stat":"mean","var":"mpg""')
assert r(found) == 1
cert_file_has "`sp'", needle(`"{"name":"a_stat","stat":"mean","var":"price""')
assert r(found) == 1
// Under a filter: the payload the filter callback recomputes card A from
// (dash_render.py's _kpi_callback_config) carries mean, not "1".
dash scatter mpg weight, name(g) title("Graph g")
_reg_build r19, filter(foreign, type(dropdown))
assert r(rc) == 0
local pg "`r(page)'"
cert_file_has "`pg'", needle("&gt;21.2973&lt;")
assert r(found) == 1
cert_file_has "`pg'", needle("21.2972972972973")
assert r(found) == 0
cert_file_has "`pg'", needle(`"\"name_html\": \"a\", \"stat\": \"mean\""')
assert r(found) == 1
display "REG-20 PASS: KPI a_stat leaves every global of KPI a as it was, and card A its statistic"

// ---- REG-21 -- replacing KPI a leaves KPI a_b whole ----
dash clear
dash kpi mean(mpg), title(A) name(a)
dash kpi mean(price), title(AB) name(a_b)
local r20b : all globals "dash_kpi_a_b*"
local r20n : word count `r20b'
assert `r20n' == 7
foreach g of local r20b {
    local r20v_`g' `"${`g'}"'
}
capture noisily dash kpi mean(price), title(A2) name(a, replace)
assert _rc == 0
local r20a : all globals "dash_kpi_a_b*"
assert `: list r20a == r20b'
foreach g of local r20b {
    assert `"${`g'}"' == `"`r20v_`g''"'
}
assert "${dash_graph_registry}" == "a a_b"
_reg_build r20
assert r(rc) == 0
local pg "`r(page)'"
cert_file_has "`pg'", needle("kpi_val_a_b")
assert r(found) == 1
cert_file_has "`pg'", needle("&gt;AB&lt;")
assert r(found) == 1
cert_file_has "`pg'", needle("&gt;A2&lt;")
assert r(found) == 1
display "REG-21 PASS: replacing KPI a leaves KPI a_b's globals and card in place"

// ---- REG-22 -- ... and a graph registered after a_b builds ----
dash clear
dash kpi mean(mpg), title(A) name(a)
dash kpi mean(price), title(AB) name(a_b)
dash kpi mean(price), title(A2) name(a, replace)
dash scatter price weight, name(g2) title("Graph g2")
_reg_build r21
assert r(rc) == 0
local pg "`r(page)'"
local lg "`r(log)'"
cert_file_has "`lg'", needle("Traceback")
assert r(found) == 0
cert_file_has "`pg'", needle("Graph g2")
assert r(found) == 1
cert_file_has "`pg'", needle("kpi_val_a_b")
assert r(found) == 1
display "REG-22 PASS: a graph registered after KPI a_b builds beside it"

// ---- REG-23 -- a graph replacing KPI a leaves KPI a_b, and builds ----
dash clear
dash kpi mean(mpg), title(A) name(a)
dash kpi mean(price), title(AB) name(a_b)
local r22b : all globals "dash_kpi_a_b*"
capture noisily dash scatter price weight, name(a, replace) title("Graph a")
assert _rc == 0
local r22a : all globals "dash_kpi_a_b*"
assert `: list r22a == r22b'
assert "${dash_kpi_a}" == ""
_reg_build r22
assert r(rc) == 0
local pg "`r(page)'"
local lg "`r(log)'"
cert_file_has "`lg'", needle("Traceback")
assert r(found) == 0
cert_file_has "`pg'", needle("Graph a")
assert r(found) == 1
cert_file_has "`pg'", needle("kpi_val_a_b")
assert r(found) == 1
cert_file_has "`pg'", needle(`"kpi_val_a\""')
assert r(found) == 0
display "REG-23 PASS: a graph replacing KPI a leaves KPI a_b, and the dashboard builds"

// ---- REG-24 -- a name ending in an underscore: the separator's edge ----
// KPI a_'s fields are dash_kpi_a___sta, ...: they begin dash_kpi_a__, so a
// prefix on the separator would take them for KPI a's.  A graph and a KPI
// replacing KPI a each leave KPI a_ as it was.
foreach r23k in kpi graph {
    dash clear
    dash kpi mean(mpg), title(A) name(a)
    dash kpi mean(price), title(Aus) name(a_)
    mata: _dash_item_globals("a_", "_r23own")
    local r23n : word count `_r23own'
    assert `r23n' == 7
    foreach g of local _r23own {
        local r23v_`g' `"${`g'}"'
    }
    if "`r23k'" == "kpi" {
        capture noisily dash kpi min(mpg), title(A2) name(a, replace)
    }
    else {
        capture noisily dash scatter price weight, name(a, replace) title("Graph a")
    }
    assert _rc == 0
    foreach g of local _r23own {
        assert `"${`g'}"' == `"`r23v_`g''"'
    }
    _reg_count a_
    assert r(n) == 7
    _reg_build r23`r23k'
    assert r(rc) == 0
    local pg "`r(page)'"
    cert_file_has "`pg'", needle(`"kpi_val_a_\""')
    assert r(found) == 1
    cert_file_has "`pg'", needle("&gt;Aus&lt;")
    assert r(found) == 1
}
display "REG-24 PASS: replacing KPI a, by a KPI or a graph, leaves KPI a_ whole"

// ---- REG-25 -- no name of the form a_<field> reaches KPI a ----
// Every field word, old and new, as a name beside KPI a: KPIs, and one
// graph.  KPI a's globals keep their values and its spec entry is whole.
dash clear
dash kpi mean(mpg), title(A) name(a)
mata: _dash_item_globals("a", "_r24own")
foreach g of local _r24own {
    local r24v_`g' `"${`g'}"'
}
dash scatter price weight, name(a_tit) title("Graph a_tit")
foreach f in stat disp sta dsp var val fmt sub col bg upd if in {
    capture noisily dash kpi mean(price), title("T`f'") name(a_`f')
    assert _rc == 0
}
foreach g of local _r24own {
    assert `"${`g'}"' == `"`r24v_`g''"'
}
_reg_spec r24
assert r(rc) == 0
local sp "`r(spec)'"
cert_file_has "`sp'", needle(`"{"name":"a","stat":"mean","var":"mpg","value":"21.2972972972973","display":"21.2972972972973","fmt":"","title":"A","subtitle":"","color":"","bgcolor":"","update":"filter","if_expr":"","in_expr":""}"')
assert r(found) == 1
foreach f in stat disp sta dsp var val fmt sub col bg upd if in {
    cert_file_has "`sp'", needle(`"{"name":"a_`f'","stat":"mean","var":"price""')
    assert r(found) == 1
}
cert_file_has "`sp'", needle(`"{"name":"a_tit","stat""')
assert r(found) == 0
display "REG-25 PASS: no KPI or graph named a_<field> changes KPI a"

// ---- REG-26 -- every global a KPI holds is one _dash_item_globals names -
// A KPI given every field, under the longest name a KPI may have: the
// marker and one dash_kpi_<name>__<field> per field, each at most 32
// characters, exactly the globals _dash_item_globals names -- so a field
// the registrar writes cannot be left behind by a replace.
dash clear
local k18 "k23456789012345678"
capture noisily dash kpi mean(mpg) if foreign == 1 in 1/70, name(`k18') ///
    title("T") subtitle("S") fmt(%9.2f) color(red) bgcolor(white) update(both)
assert _rc == 0
local held : all globals "dash_kpi_`k18'*"
mata: _dash_item_globals("`k18'", "_r25own")
local r25n : word count `held'
assert `r25n' == 13
assert `: list held == _r25own'
local r25p "dash_kpi_`k18'__"
foreach g of local held {
    assert strlen("`g'") <= 32
    if "`g'" != "dash_kpi_`k18'" {
        assert substr("`g'", 1, strlen("`r25p'")) == "`r25p'"
        local r25f = substr("`g'", strlen("`r25p'") + 1, .)
        assert inrange(strlen("`r25f'"), 1, 3)
        assert strpos("`r25f'", "_") == 0
    }
}
// _dash_kpi_fields(): twelve words of one to three lower-case letters.
mata: st_local("_r25fl", invtokens(_dash_kpi_fields()))
local r25fn : word count `_r25fl'
assert `r25fn' == 12
local r25fu : list uniq _r25fl
assert `: list r25fu == _r25fl'
foreach f of local _r25fl {
    assert inrange(strlen("`f'"), 1, 3)
    assert lower("`f'") == "`f'" & strpos("`f'", "_") == 0
}
// A replace leaves none of them behind.
capture noisily dash scatter mpg weight, name(`k18', replace)
assert _rc == 0
local left : all globals "dash_kpi_`k18'*"
assert "`left'" == ""
display "REG-26 PASS: a KPI's globals are its marker and __-fields, at most 32 characters, all retired by a replace"

// ---- REG-27 -- a registry entry holding nothing is refused aloud ----
// No registrar leaves one now, but the registry is ordinary globals.  It
// was appended to the spec as an empty graph: r(7102) and a Python
// JSONDecodeError, "[, {" when it came first and a trailing comma when it
// came last.
foreach r26r in "g1 ghost" "ghost g1" {
    dash clear
    dash scatter mpg weight, name(g1)
    global dash_graph_registry "`r26r'"
    _reg_build r26
    local rc26 = r(rc)
    local pg "`r(page)'"
    local lg "`r(log)'"
    assert `rc26' == 198
    cert_file_has "`lg'", needle("dash build: registry entry 'ghost' holds neither a graph nor a KPI")
    assert r(found) == 1
    cert_file_has "`lg'", needle("Traceback")
    assert r(found) == 0
    capture confirm file "`pg'"
    assert _rc != 0
}
dash clear
display "REG-27 PASS: a registry entry that holds neither a graph nor a KPI is refused with a message, not a traceback"

// ---- REG-28 -- a KPI with no statistic or variable is refused aloud ----
// _dash_kpi always stores both.  A KPI without them was not registered by
// this dash: its marker set by hand, or a KPI an older dash left in the
// session under the one-underscore names, which this one no longer reads.
// It was drawn as a blank card, the one (a) above drew, with nothing said.
foreach r27v in legacy marker {
    dash clear
    dash scatter mpg weight, name(g1)
    global dash_kpi_k1 "1"
    if "`r27v'" == "legacy" {
        global dash_kpi_k1_stat "mean"
        global dash_kpi_k1_var  "mpg"
        global dash_kpi_k1_tit  "Old"
    }
    global dash_graph_registry "g1 k1"
    _reg_build r27
    local rc27 = r(rc)
    local pg "`r(page)'"
    local lg "`r(log)'"
    assert `rc27' == 198
    cert_file_has "`lg'", needle("dash build: registry entry 'k1' holds a KPI with no statistic or variable")
    assert r(found) == 1
    capture confirm file "`pg'"
    assert _rc != 0
}
dash clear
local left : all globals "dash_kpi_*"
assert "`left'" == ""
display "REG-28 PASS: a KPI entry with no statistic or variable is refused with a message, not drawn blank"

capture program drop _reg_count
capture program drop _reg_build
capture program drop _reg_spec

display ""
display "All registry collision tests PASSED."
