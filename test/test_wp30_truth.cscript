*! test_wp30_truth.cscript
*! WP-30's ONE new certification script (.ultraplan/wp30/index.md A142):
*! every comparison with twoway's drawing or with Stata's own values that
*! WP-30's sections need lives here, one block per section, in section
*! order, so the certification suite grows by one script.  Refusal,
*! message and return-code checks join the EXISTING script for their area
*! instead (index.md merge rule R1); this script never gains one of those.
*!
*! S01 is the scaffold smoke (TF-01).  S02-S57 each own the block their
*! header names, a stub until that section fills it with its own cases
*! (its case-id prefix: index.md "Section manifest").  A section writes
*! only inside its own block, its helper programs directly above its own
*! header, and a second block of its own directly below its own end line.
*!
*! Usage: via run_all_cscripts.do (registered as its block 69).  One
*! block alone: set WP30_ONLY=S<NN> in the environment of the driver run
*! (index.md "The cscript driver"); a block with no case yet then ends
*! "no case ran" and r(9).  Each block prints "S<NN> start" and
*! "S<NN> end" with the date and time, so the closeout can time it.
*! The suite runs it in every session; DASH_CERT_SHARD=k/N runs part k of
*! N of the blocks (the "parts" section below).
*!
*! Blocks filled so far (case ids):
*!   S07  P1.25a the six StataCorp schemes against twoway (SX-01..SX-08)
*!   S15  P1.2a scheme chrome against twoway (LK-01..LK-07)
*!   S17  P1.23b colour-key text and computed tooltips against twoway (DK-01..DK-09)
*!   S20  P1.1b per-series value lists against twoway (PS-30..PS-34)
*!   S34  P1.25b scheme lookup along the ado-path, each graph's own scheme (SP-10..SP-18)

cscript "WP-30 truth: twoway comparisons" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off

if `"`c(python_exec)'"' == "" {
    display as error "SKIP: Python not available."
    exit 222
}

do "cert_helpers.do"
quietly do "cert_svg.do"
qui do "../dash_parse.mata"
qui do "../dash.ado"
global dash_nobrowser 1

// ----------------------------------------------------------------
// Tally helpers -- test_wp29_truth.cscript's _w29_expect/_w29_done,
// renamed _w30_ for this script.  A case is any number of
// _w30_expect lines closed by one _w30_done.
// ----------------------------------------------------------------
global w30_nfail    = 0
global w30_faillist ""
global w30_bad      = 0
global w30_ncase    = 0

capture program drop _w30_expect
program define _w30_expect
    version 19
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global w30_bad = 1
    }
end

capture program drop _w30_done
program define _w30_done
    version 19
    args id msg
    if ${w30_bad} {
        global w30_nfail    = ${w30_nfail} + 1
        global w30_faillist "${w30_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global w30_bad   = 0
    global w30_ncase = ${w30_ncase} + 1
end

// A fresh directory for this run's files, never one that already exists:
// a fixed name in a shared temp directory could be planted by another
// account (rule 1), so a name Stata has not handed out before is made and
// the run fails if it cannot be.  Every block writes only under it.
tempfile w30_base
local w30_work "`w30_base'_w30"
capture mkdir "`w30_work'"
if _rc {
    display as error "test_wp30_truth: cannot create the work directory `w30_work' (rc `=_rc')"
    exit 9
}

// ---- parts: begin (WP-30 test performance) ----
// The certification suite runs this script in every one of its sessions
// (its row in run_all_cscripts.do's shard table is "* * *"); with
// DASH_CERT_SHARD=k/N set, the session runs part k of N of the blocks.
// The parts are balanced longest first onto the least loaded part (the
// lowest numbered of equals), by the seconds below -- a block not listed
// counts 0 s -- the rule scripts/cert_shards.py uses for the scripts and
// mirrors for these blocks (wp30_parts).  Unset, or with WP30_ONLY set
// (which keeps its precedence), every block runs.  A block runs when its
// gate finds its id in w30_run.
// Seconds: the start/end lines of the three parts of 08oct2026, run side
// by side as the suite runs them (a block and its second block together;
// a block not listed took under a second).
local w30_secs ///
    S01 1 S04 4 S06 4 S07 19 S08 11 S09 1 S10 10 S11 24 S12 2 S13 15 ///
    S14 13 S15 11 S16 14 S17 4 S18 7 S19 21 S20 15 S21 57 S22 2 S23 11 ///
    S24 17 S26 4 S27 12 S28 6 S29 1 S30 22 S31 7 S32 9 S33 5 S34 7 ///
    S35 14 S36 6 S37 6 S38 3 S39 3 S40 16 S41 4 S42 3 S43 7 S44 11 S45 3 S47 4 ///
    S48 11 S49 4
local w30_sh : environment DASH_CERT_SHARD
mata: st_local("w30_ok", strofreal(st_local("w30_sh") == "" | ustrregexm(st_local("w30_sh"), "^[1-4]/[1-4]$")))
if !`w30_ok' {
    display as error "test_wp30_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 4"
    exit 198
}
local w30_k 1
local w30_N 1
if "`w30_sh'" != "" {
    local w30_k = real(substr("`w30_sh'", 1, 1))
    local w30_N = real(substr("`w30_sh'", 3, 1))
}
local w30_only : env WP30_ONLY
if `"`macval(w30_only)'"' != "" | `w30_N' == 1 {
    local w30_k 1
    local w30_N 1
}
if `w30_k' > `w30_N' {
    display as error "test_wp30_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 4"
    exit 198
}
capture confirm file "test_wp30_truth.cscript"
if _rc {
    display as error "test_wp30_truth: run it from test/, where it reads its own blocks"
    exit 601
}
capture mata: mata drop _w30_part()
mata:
// The ids of the blocks (their header lines, in file order), and those of
// part k of n: longest first onto the least loaded part.
void _w30_part(string scalar file, string scalar table, real scalar k,
               real scalar n)
{
    string colvector lines, ids
    string rowvector tok
    real colvector sec, o, at
    real rowvector load
    real scalar i, j, p, best
    string scalar run

    lines = cat(file)
    ids = J(0, 1, "")
    for (i = 1; i <= rows(lines); i++) {
        if (ustrregexm(lines[i], "^\* ==== (S[0-9]+) ")) {
            if (!anyof(ids, ustrregexs(1))) ids = ids \ ustrregexs(1)
        }
    }
    sec = J(rows(ids), 1, 0)
    tok = tokens(table)
    for (j = 1; j + 1 <= cols(tok); j = j + 2) {
        for (i = 1; i <= rows(ids); i++) {
            if (ids[i] == tok[j]) sec[i] = strtoreal(tok[j + 1])
        }
    }
    o = order((-sec, (1::rows(ids))), (1, 2))
    load = J(1, n, 0)
    at = J(rows(ids), 1, 0)
    for (i = 1; i <= rows(o); i++) {
        best = 1
        for (p = 2; p <= n; p++) if (load[p] < load[best]) best = p
        load[best] = load[best] + sec[o[i]]
        at[o[i]] = best
    }
    run = ""
    for (i = 1; i <= rows(ids); i++) if (at[i] == k) run = run + " " + ids[i]
    st_local("w30_run", strtrim(run))
}
end
mata: _w30_part("test_wp30_truth.cscript", st_local("w30_secs"), `w30_k', `w30_N')
display as text "test_wp30_truth: part `w30_k'/`w30_N' runs `: word count `w30_run'' blocks: `w30_run'"
// ---- parts: end ----

* ==== S01 scaffold: the helpers load and a twoway SVG is read ====
local only : env WP30_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w30_run' {
    display as text "S01 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // TF-01: cert_svg_export and cert_svg_texts on one twoway scatter,
    // and dash's own programs are loaded from this tree.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(w30s01, replace)
    cert_svg_export, name(w30s01) file("`w30_work'/w30s01.svg")
    local s01_rc   = r(rc)
    local s01_file "`r(file)'"
    _w30_expect TF-01 "(`s01_rc' == 0)" "cert_svg_export rc `s01_rc'"
    capture confirm file "`s01_file'"
    _w30_expect TF-01 "(_rc == 0)" "r(file) `s01_file' does not exist"
    cert_svg_texts, file("`s01_file'")
    local s01_n    = r(n)
    local s01_list "`r(list)'"
    _w30_expect TF-01 "(`s01_n' > 0)" "cert_svg_texts found no text elements"
    capture program list _dash_serve
    _w30_expect TF-01 "(_rc == 0)" "dash.ado's _dash_serve is not loaded"
    _w30_done TF-01 "a twoway SVG was written and read (`s01_n' texts); dash is loaded"

    capture erase "`s01_file'"
    capture erase "`s01_list'"
    capture graph drop w30s01
    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====

// ----------------------------------------------------------------
// S02 helpers (WP-30 P1.34): the runner's root block, read from
// run_all_cscripts.do between its markers and run as a do-file.
// ----------------------------------------------------------------
capture mata: mata drop _s02_root_lines()
capture mata: mata drop _s02_trim()
mata:
// Copies the lines strictly between "// ---- root: begin" and
// "// ---- root: end" of src to dst; returns their count (0 when either
// marker is missing, and then nothing is written).
real scalar _s02_root_lines(string scalar src, string scalar dst)
{
    string colvector L
    real scalar i, b, e, fh
    L = cat(src)
    b = 0
    e = 0
    for (i = 1; i <= rows(L); i++) {
        if (b == 0 & strpos(L[i], "// ---- root: begin") == 1) b = i
        else if (b > 0 & e == 0 & strpos(L[i], "// ---- root: end") == 1) e = i
    }
    if (b == 0 | e <= b + 1) return(0)
    fh = fopen(dst, "w")
    for (i = b + 1; i < e; i++) fput(fh, L[i])
    fclose(fh)
    return(e - b - 1)
}
// s without its trailing slashes (one character kept).
string scalar _s02_trim(string scalar s)
{
    while (strlen(s) > 1 & substr(s, -1, 1) == "/") s = substr(s, 1, strlen(s) - 1)
    return(s)
}
end

capture program drop _s02_realdir
program define _s02_realdir, rclass
    version 19
    args dir
    local here `"`c(pwd)'"'
    quietly cd `"`dir'"'
    return local dir `"`c(pwd)'"'
    quietly cd `"`here'"'
end

capture program drop _s02_run_root
program define _s02_run_root, rclass
    version 19
    args block cwd
    local ado0 `"$S_ADO"'
    local pwd0 `"`c(pwd)'"'
    if `"`cwd'"' != "" quietly cd `"`cwd'"'
    // quietly: a refused root's error and r() lines stay out of the log;
    // the rc is what each case checks.
    capture quietly do `"`block'"'
    local rc = _rc
    local pwd `"`c(pwd)'"'
    local fn ""
    if `rc' == 0 {
        capture quietly findfile dash.ado
        if _rc == 0 local fn `"`r(fn)'"'
    }
    global S_ADO `"`macval(ado0)'"'
    quietly cd `"`pwd0'"'
    return scalar rc = `rc'
    return local pwd `"`pwd'"'
    return local fn `"`fn'"'
end

// One RR case: the root block run with DASH_REPO as the caller set it,
// from cwd; rc must be wrc and, when want is given, the run must have
// cd'd to want and found want/dash.ado.  ok is RR-01's flag: without the
// block, the case fails without running.
capture program drop _s02_case
program define _s02_case
    version 19
    args id ok blk cwd wrc want msg
    _w30_expect `id' "`ok'" "RR-01 failed, so the root block was not run"
    if `ok' {
        _s02_run_root `"`blk'"' `"`cwd'"'
        local rc = r(rc)
        local pwd `"`r(pwd)'"'
        local fn `"`r(fn)'"'
        _w30_expect `id' "`rc' == `wrc'" "rc `rc', expected `wrc'"
        if `"`want'"' != "" {
            local same = (`"`pwd'"' == `"`want'"')
            _w30_expect `id' "`same'" "r(pwd) is `pwd', expected `want'"
            local same = (`"`fn'"' == `"`want'/dash.ado"')
            _w30_expect `id' "`same'" "dash.ado resolves to `fn', expected `want'/dash.ado"
        }
    }
    _w30_done `id' `"`msg'"'
end

* ==== S02 P1.34: Portable runners ====
local only : env WP30_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w30_run' {
    display as text "S02 start " c(current_date) " " c(current_time)
    local s02_env0 : environment DASH_REPO

    // tree: the directory the driver cd'd to, less its /test.
    local s02_here `"`c(pwd)'"'
    local s02_intest = (substr(`"`s02_here'"', -5, 5) == "/test")
    local s02_tree = substr(`"`s02_here'"', 1, strlen(`"`s02_here'"') - 5)

    // scr: two trees of the RR cases, under this run's own directory.
    local s02_scr "`w30_work'/s02_rr"
    capture mkdir "`s02_scr'"
    capture mkdir "`s02_scr'/notree"
    capture mkdir "`s02_scr'/my tree"
    capture mkdir "`s02_scr'/my tree/test"
    tempname s02_fh
    file open `s02_fh' using "`s02_scr'/my tree/dash.ado", write text replace
    file close `s02_fh'
    file open `s02_fh' using "`s02_scr'/my tree/test/run_all_cscripts.do", write text replace
    file close `s02_fh'
    _s02_realdir "`s02_scr'"
    local s02_scr `"`r(dir)'"'

    // ------------------------------------------------------------
    // RR-01: the runner's root block is there, reads DASH_REPO and
    // names no home directory; the paths this block hands it are clean.
    // ------------------------------------------------------------
    local s02_blk "`w30_work'/s02_root.do"
    mata: st_local("s02_n", strofreal(_s02_root_lines("run_all_cscripts.do", st_local("s02_blk"))))
    local s02_hasenv 0
    local s02_home 0
    if `s02_n' > 0 {
        mata: st_local("s02_hasenv", strofreal(strpos(invtokens(cat(st_local("s02_blk"))', char(10)), ": environment DASH_REPO") > 0))
        mata: st_local("s02_home", strofreal(strpos(invtokens(cat(st_local("s02_blk"))', char(10)), "/" + "Users/") + strpos(invtokens(cat(st_local("s02_blk"))', char(10)), "/" + "home/") > 0))
    }
    mata: st_local("s02_badpath", strofreal(any(strpos(st_local("s02_tree") + c("tmpdir") + st_local("s02_scr"), (char(34), char(36), char(39), char(96), char(10), char(13))))))
    _w30_expect RR-01 "`s02_n' >= 10" "the root block between run_all_cscripts.do's markers has `s02_n' lines"
    _w30_expect RR-01 "`s02_hasenv'" "the root block does not read : environment DASH_REPO"
    _w30_expect RR-01 "!`s02_home'" "the root block names a home directory"
    _w30_expect RR-01 "!`s02_badpath'" "the tree, c(tmpdir) or the scratch directory holds a quote, dollar sign, backtick or line break"
    _w30_done RR-01 "the runner's root block was read (`s02_n' lines)"
    local s02_ok = (`s02_n' >= 10) & `s02_hasenv' & !`s02_home' & !`s02_badpath'

    // ------------------------------------------------------------
    // RR-02: the run tests the tree it was handed.
    // ------------------------------------------------------------
    mata: st_local("s02_named", strofreal(_s02_trim(st_local("s02_env0")) == "" | _s02_trim(st_local("s02_env0")) == st_local("s02_tree")))
    _w30_expect RR-02 "`s02_intest'" "the driver did not cd to <tree>/test (c(pwd) is `s02_here')"
    _w30_expect RR-02 "`s02_named'" "DASH_REPO does not name the tree under test, `s02_tree'"
    _w30_done RR-02 "the run tests the tree it was handed, `s02_tree'"

    // ------------------------------------------------------------
    // RR-03..RR-14: the root block under each DASH_REPO and directory.
    // ------------------------------------------------------------
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_tree")
    _s02_case RR-03 `s02_ok' "`s02_blk'" "" 0 "`s02_tree'" "DASH_REPO=<tree> from test/: the tree is tested"
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_tree") + "/"
    _s02_case RR-04 `s02_ok' "`s02_blk'" "" 0 "`s02_tree'" "DASH_REPO=<tree>/ from test/: the trailing slash is dropped"
    python: import os; os.environ.pop("DASH_REPO", None)
    _s02_case RR-05 `s02_ok' "`s02_blk'" "`s02_tree'" 0 "`s02_tree'" "DASH_REPO unset from <tree>: the current directory is tested"
    _s02_case RR-06 `s02_ok' "`s02_blk'" "`s02_scr'/notree" 601 "" "DASH_REPO unset from a directory that is no dash tree: r(601)"
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_scr") + "/co" + chr(36) + "py"
    _s02_case RR-07 `s02_ok' "`s02_blk'" "" 198 "" "a dollar sign in DASH_REPO: r(198)"
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_scr") + "/co" + chr(96) + "py"
    _s02_case RR-08 `s02_ok' "`s02_blk'" "" 198 "" "a backtick in DASH_REPO: r(198)"
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_scr") + "/co" + chr(34) + "py"
    _s02_case RR-09 `s02_ok' "`s02_blk'" "" 198 "" "a double quote in DASH_REPO: r(198)"
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_scr") + "/co" + chr(39) + "py"
    _s02_case RR-10 `s02_ok' "`s02_blk'" "" 198 "" "a single quote in DASH_REPO: r(198)"
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_scr") + "/co" + chr(10) + "py"
    _s02_case RR-11 `s02_ok' "`s02_blk'" "" 198 "" "a line feed in DASH_REPO: r(198)"
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_scr") + "/co" + chr(13) + "py"
    _s02_case RR-12 `s02_ok' "`s02_blk'" "" 198 "" "a carriage return in DASH_REPO: r(198)"
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_scr") + "/notree"
    _s02_case RR-13 `s02_ok' "`s02_blk'" "" 601 "" "DASH_REPO naming a directory that is no dash tree: r(601)"
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_scr") + "/my tree"
    _s02_case RR-14 `s02_ok' "`s02_blk'" "" 0 "`s02_scr'/my tree" "DASH_REPO naming a tree with a space: that tree is tested"

    capture erase "`s02_scr'/my tree/test/run_all_cscripts.do"
    capture erase "`s02_scr'/my tree/dash.ado"
    capture rmdir "`s02_scr'/my tree/test"
    capture rmdir "`s02_scr'/my tree"
    capture rmdir "`s02_scr'/notree"
    capture rmdir "`s02_scr'"
    capture erase "`s02_blk'"
    python: import os; from sfi import Macro; v = Macro.getLocal("s02_env0"); os.environ.pop("DASH_REPO", None) if v == "" else os.environ.__setitem__("DASH_REPO", v)
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

// S03 helper: a program at a version no Stata runs.  It is stored and never
// runs: SF-01 measures the code Stata gives when it is called.  Its
// `version 99' is the measurement, so it is the one helper of this script
// that does not declare version 19.
capture program drop _s03_future
program define _s03_future
    version 99
end

* ==== S03 P1.35: Stata 19 floor declared and enforced ====
local only : env WP30_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w30_run' {
    display as text "S03 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // SF-01: Stata's own return code for a version it cannot run.
    // dash's refusal uses the same code (test_env_guards.cscript
    // ENV-25, ENV-28, ENV-29).
    // ------------------------------------------------------------
    capture _s03_future
    local sf01 = _rc
    _w30_expect SF-01 "(`sf01' == 9)" "a program at version 99 gave rc `sf01', not 9"
    _w30_done SF-01 "Stata refuses a version it cannot run with rc `sf01', the code dash's floor uses"

    // ------------------------------------------------------------
    // SF-02: with no caller version recorded, _dash_fn_points falls back
    // to dash's own level, now 19; the points are those of a caller at 16.
    // ------------------------------------------------------------
    sysuse auto, clear
    capture program list _dash_fn_points
    local sf02ld = _rc
    _w30_expect SF-02 "(`sf02ld' == 0)" "dash.ado is not loaded by do"
    if `sf02ld' == 0 {
        tempname sf02r sf02a sf02b
        foreach e in "y = runiform()" "y = normalden(x)" {
            mata: st_strscalar(st_local("sf02r"), st_local("e"))
            mata: st_strscalar(st_local("sf02a"), "")
            mata: st_strscalar(st_local("sf02b"), "")
            set seed 20261003
            global dash__uv 16
            capture noisily _dash_fn_points `sf02r' -2 2 5 1 `sf02a'
            local sf02rca = _rc
            set seed 20261003
            macro drop dash__uv
            capture noisily _dash_fn_points `sf02r' -2 2 5 1 `sf02b'
            local sf02rcb = _rc
            local sf02cv "`._Gr_Global.callerver'"
            local sf02cvok = ("`sf02cv'" == "19")
            mata: st_local("sf02same", strofreal(st_strscalar(st_local("sf02a")) == st_strscalar(st_local("sf02b"))))
            _w30_expect SF-02 "(`sf02rca' == 0 & `sf02rcb' == 0)" "`e': rc `sf02rca' at 16, rc `sf02rcb' at the fallback"
            _w30_expect SF-02 "(`sf02same' == 1)" "`e': the points at 16 and at the fallback differ"
            _w30_expect SF-02 "(`sf02cvok' == 1)" "`e': the fallback's callerver is `sf02cv', not 19"
        }
    }
    _w30_done SF-02 "the callerver fallback reads 19 and the points equal a version 16 caller's, seeded runiform() and normalden(x)"

    // ------------------------------------------------------------
    // SF-03: a caller at version 16 keeps its own version (guard).
    // ------------------------------------------------------------
    capture dash clear
    capture noisily version 16: dash function y = normalden(x), range(-2 2) n(5) name(sf03)
    local sf03rc = _rc
    local sf03cv "`._Gr_Global.callerver'"
    local sf03cvok = ("`sf03cv'" == "16")
    mata: st_local("sf03pts", strofreal(strpos(st_global("dash_fpts_sf03"), "0.053990966513188049,0.24197072451914334,0.39894228040143265") > 0))
    _w30_expect SF-03 "(`sf03rc' == 0)" "version 16: dash function gave rc `sf03rc'"
    _w30_expect SF-03 "(`sf03cvok' == 1)" "the function layer ran at callerver `sf03cv', not 16"
    _w30_expect SF-03 "(`sf03pts' == 1)" "the normalden points were not the measured ones"
    _w30_done SF-03 "a version 16 caller's function layer is evaluated at 16, with the measured points"
    capture dash clear

    // ------------------------------------------------------------
    // SF-04: the certifying Stata is at or above the floor, and dash's
    // guard and comparator say so.
    // ------------------------------------------------------------
    local sf04v = (c(stata_version) >= 19)
    capture noisily _dash_require_stata
    local sf04g = _rc
    capture _dash_stata_ok "`c(stata_version)'" "19"
    local sf04c = _rc
    local sf04ok = r(ok)
    if `sf04c' != 0 local sf04ok = .
    _w30_expect SF-04 "(`sf04v' == 1)" "this Stata, `c(stata_version)', is below the floor"
    _w30_expect SF-04 "(`sf04g' == 0)" "_dash_require_stata gave rc `sf04g'"
    _w30_expect SF-04 "(`sf04c' == 0)" "_dash_stata_ok gave rc `sf04c'"
    _w30_expect SF-04 "(`sf04ok' == 1)" "_dash_stata_ok answered `sf04ok' for this Stata"
    display as text "SF-04: certified on Stata `c(stata_version)' `c(edition_real)'"
    _w30_done SF-04 "the certifying Stata is at or above the floor and dash's guard passes it"

    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

// S04's helper: twoway's recorded saving() result for one character, from
// test/fixtures/saving_chars_truth.json (scripts/extract_saving_chars_truth.do),
// into the globals CSP_RC, CSP_W and CSP_STEM.  Read relative to the
// working directory, test/.  S12 reads the same fixture.
python:
import json as _csp_json
def _csp_truth(key):
    from sfi import Macro
    with open("fixtures/saving_chars_truth.json", encoding="utf-8") as fh:
        rec = _csp_json.load(fh)["probes"][key]
    f = rec["file"]
    Macro.setGlobal("CSP_RC", str(int(rec["rc"])))
    Macro.setGlobal("CSP_W", "1" if rec["written"] else "0")
    Macro.setGlobal("CSP_STEM", f[len("tw_"):-len(".gph")])
end
* ==== S04 P1.29: CSP without 'unsafe-inline'; safe Windows opener ====
local only : env WP30_ONLY
if inlist("`only'", "", "S04") & `: list posof "S04" in w30_run' {
    display as text "S04 start " c(current_date) " " c(current_time)
    // CSP-01..04: dash's saving() writes a name holding %, !, %% or ^ as
    // typed, as twoway's does (P1.29; only dash's Windows opener declines
    // such a path).
    quietly sysuse auto, clear
    local s04_chars `" "%" "!" "%%" "^" "'
    local s04_i 0
    foreach key in pct_path bang pct_pct caret {
        local ++s04_i
        local id "CSP-0`s04_i'"
        local s04_c : word `s04_i' of `s04_chars'
        python: __import__("__main__")._csp_truth("`key'")
        local s04_page "`w30_work'/d_${CSP_STEM}.html"
        capture erase "`s04_page'"
        capture noisily dash scatter mpg weight, saving("`s04_page'", replace)
        local s04_rc = _rc
        capture confirm file "`s04_page'"
        local s04_w = (_rc == 0)
        _w30_expect `id' "(`s04_rc' == ${CSP_RC})" "dash gave rc `s04_rc', twoway ${CSP_RC}"
        _w30_expect `id' "(`s04_w' == ${CSP_W})" "dash wrote the page: `s04_w'; twoway wrote its file: ${CSP_W}"
        _w30_done `id' "saving() with `s04_c' is written as typed, as twoway writes it"
        capture erase "`s04_page'"
    }
    macro drop CSP_RC CSP_W CSP_STEM
    capture dash clear
    display as text "S04 end " c(current_date) " " c(current_time)
}
* ==== end S04 ====

* ==== S05 P1.33: Measured Python floor ====
local only : env WP30_ONLY
if inlist("`only'", "", "S05") & `: list posof "S05" in w30_run' {
    display as text "S05 start " c(current_date) " " c(current_time)
    // PYF-03: the linked interpreter is at or above the declared floor.
    capture program list _dash_pyver_ok
    if _rc quietly do "../dash_setup.ado"
    _dash_pymin
    local s05_min "`r(pymin)'"
    python: import sys, sfi; sfi.Macro.setLocal("s05_ver", "%d.%d.%d" % tuple(sys.version_info[:3]))
    _dash_pyver_ok "`s05_ver'" "`s05_min'"
    local s05_ok = r(ok)
    _w30_expect PYF-03 "(`s05_ok' == 1)" "Python `s05_ver' is below the declared floor `s05_min'"
    _w30_done PYF-03 "Python `s05_ver' is at or above the declared floor `s05_min'"
    // PYF-04: the served app's child starts as dash serve starts it,
    // sys.executable -P, in safe-path mode.
    python: import subprocess, sys, sfi; _s05_r = subprocess.run([sys.executable, "-P", "-c", "import sys; print(int(sys.flags.safe_path))"], capture_output=True, text=True, timeout=60); sfi.Macro.setLocal("s05_child", "%d %s" % (_s05_r.returncode, _s05_r.stdout.strip()))
    local s05_c = ("`s05_child'" == "0 1")
    _w30_expect PYF-04 "(`s05_c' == 1)" "sys.executable -P gave `s05_child', wanted 0 1"
    _w30_done PYF-04 "sys.executable -P starts a child in safe-path mode (rc 0, safe_path 1)"
    display as text "S05 end " c(current_date) " " c(current_time)
}
* ==== end S05 ====

* ==== S06 P1.26a: One note channel ====
local only : env WP30_ONLY
if inlist("`only'", "", "S06") & `: list posof "S06" in w30_run' {
    display as text "S06 start " c(current_date) " " c(current_time)

    // twoway's measured channels (section 06, Stata truth p1-p4): a
    // named-style note shows under quietly and capture hides it; the
    // estimator note "(note:  regress could not fit model)" is plain
    // text, which quietly hides.  dash's notes take the same channels.
    // Each command runs under a named text log of its own, counted with
    // cert_log_has (wrapped lines re-joined), r(count) copied at once.
    sysuse auto, clear
    capture dash clear
    local s06_page "`w30_work'/wp30_s06.html"
    capture log close s06nc

    // ------------------------------------------------------------
    // NC-01: the named-style class.  twoway's note and dash's note both
    // show under quietly, and capture hides both.
    // ------------------------------------------------------------
    log using "`w30_work'/wp30_s06_1.log", text replace name(s06nc)
    quietly twoway scatter mpg weight, mcolor(notacolor) nodraw
    log close s06nc
    cert_log_has "`w30_work'/wp30_s06_1.log", needle("(note:")
    local s06_n1 = r(count)
    log using "`w30_work'/wp30_s06_2.log", text replace name(s06nc)
    capture twoway scatter mpg weight, mcolor(notacolor) nodraw
    log close s06nc
    cert_log_has "`w30_work'/wp30_s06_2.log", needle("(note:")
    local s06_n2 = r(count)
    log using "`w30_work'/wp30_s06_3.log", text replace name(s06nc)
    quietly dash scatter mpg weight, mcolor(notacolor) saving("`s06_page'", replace)
    log close s06nc
    cert_log_has "`w30_work'/wp30_s06_3.log", needle("(note:  dash: ")
    local s06_n3 = r(count)
    log using "`w30_work'/wp30_s06_4.log", text replace name(s06nc)
    capture dash scatter mpg weight, mcolor(notacolor) saving("`s06_page'", replace)
    local s06_rc4 = _rc
    log close s06nc
    cert_log_has "`w30_work'/wp30_s06_4.log", needle("(note:")
    local s06_n4 = r(count)
    cert_log_has "`w30_work'/wp30_s06_4.log", needle("Warning:")
    local s06_w4 = r(count)
    _w30_expect NC-01 "(`s06_n1' >= 1)" "quietly twoway logged `s06_n1' (note: lines"
    _w30_expect NC-01 "(`s06_n2' == 0)" "capture twoway logged `s06_n2' (note: lines"
    _w30_expect NC-01 "(`s06_n3' >= 1)" "quietly dash logged `s06_n3' (note:  dash: lines"
    _w30_expect NC-01 "(`s06_rc4' == 0 & `s06_n4' == 0 & `s06_w4' == 0)" "capture dash (rc `s06_rc4') logged `s06_n4' (note: and `s06_w4' Warning: lines"
    _w30_done NC-01 "a named-style note shows under quietly and capture hides it, for twoway and for dash"

    // ------------------------------------------------------------
    // NC-02: the estimator class.  twoway prints its could-not-fit note
    // once, as plain text that quietly hides; dash's copy does the same.
    // ------------------------------------------------------------
    log using "`w30_work'/wp30_s06_5.log", text replace name(s06nc)
    twoway (scatter mpg weight) (lfit mpg weight if price > 20000), nodraw
    log close s06nc
    cert_log_has "`w30_work'/wp30_s06_5.log", needle("could not fit model")
    local s06_n5 = r(count)
    log using "`w30_work'/wp30_s06_6.log", text replace name(s06nc)
    quietly twoway (scatter mpg weight) (lfit mpg weight if price > 20000), nodraw
    log close s06nc
    cert_log_has "`w30_work'/wp30_s06_6.log", needle("could not fit model")
    local s06_n6 = r(count)
    log using "`w30_work'/wp30_s06_7.log", text replace name(s06nc)
    capture noisily dash (scatter mpg weight) (lfit mpg weight if price > 20000), saving("`s06_page'", replace)
    local s06_rc7 = _rc
    log close s06nc
    cert_log_has "`w30_work'/wp30_s06_7.log", needle("could not fit model")
    local s06_n7 = r(count)
    log using "`w30_work'/wp30_s06_8.log", text replace name(s06nc)
    quietly dash (scatter mpg weight) (lfit mpg weight if price > 20000), saving("`s06_page'", replace)
    log close s06nc
    cert_log_has "`w30_work'/wp30_s06_8.log", needle("could not fit model")
    local s06_n8 = r(count)
    _w30_expect NC-02 "(`s06_n5' == 1)" "twoway logged `s06_n5' could-not-fit lines"
    _w30_expect NC-02 "(`s06_n6' == 0)" "quietly twoway logged `s06_n6' could-not-fit lines"
    _w30_expect NC-02 "(`s06_rc7' == 0 & `s06_n7' == 1)" "dash (rc `s06_rc7') logged `s06_n7' could-not-fit lines"
    _w30_expect NC-02 "(`s06_n8' == 0)" "quietly dash logged `s06_n8' could-not-fit lines"
    _w30_done NC-02 "the could-not-fit note prints once as plain text that quietly hides, for twoway and for dash"

    forvalues k = 1/8 {
        capture erase "`w30_work'/wp30_s06_`k'.log"
    }
    capture erase "`s06_page'"
    capture dash clear
    display as text "S06 end " c(current_date) " " c(current_time)
}
* ==== end S06 ====

// ----------------------------------------------------------------
// S07 helpers (python at the top level, where braces are safe).  Every
// argument crosses through sfi.Macro.getGlobal and every answer goes
// back through Macro.setGlobal; no macro text is pasted into Python.
//   _s07_svg()   S07_SVG (with yline(20)) and S07_SVG0 (without) ->
//                S07_TW = bg;marker;ylc;segs;w;h;tick
//   _s07_page()  S07_PAGE, a saved page -> S07_D =
//                border;plot;fill;span;dash;aspect;tick, and S07_PAL, the
//                first colour mapper's palette;low;high
//   _s07_app()   S07_APP, a served app.py, and S07_MOVE -> S07_S (the
//                same summary), S07_FIRED, S07_SAME_AFTER
//   _s07_child() S07_CHILD and S07_KIND (red, sp or zp) -> S07_DC, S07_DOK
//                and S07_DCW (count of "not found, using s2color")
//   _s07_ci()    S07_SCH -> S07_DCI = fill;outline;fit, or "error"
//   _s07_rgb()   S07_GOB ("r g b [%a]") -> S07_HEX = #rrggbb
// ----------------------------------------------------------------
python:
import collections as _s07_col
import html as _s07_html
import json as _s07_json
import os as _s07_os
import re as _s07_re
import sys as _s07_sys
import warnings as _s07_w
from sfi import Macro as _s07_M

_s07_repo = _s07_os.path.abspath("..")
for _s07_p in (_s07_os.path.join(_s07_repo, "scripts"), _s07_repo):
    if _s07_p not in _s07_sys.path:
        _s07_sys.path.insert(0, _s07_p)
import svg_truth as _s07_st

_S07_PLOTS = ("Figure", "figure", "Plot")


def _s07_set(name, val):
    _s07_M.setGlobal(name, str(val))


def _s07_svg():
    path = _s07_M.getGlobal("S07_SVG")
    path0 = _s07_M.getGlobal("S07_SVG0")
    doc = _s07_st.svg_document(path)
    bg = doc["rects"][0]["fill"] if doc["rects"] else ""
    fills = _s07_st.svg_marker_fills(path)
    marker = max(fills, key=lambda c: fills[c]["n"]) if fills else ""
    seen = set()
    if path0:
        d0 = _s07_st.svg_document(path0)
        for g in _s07_st.line_groups(d0["hlines"], "y1"):
            seen.add((g["px"], g["stroke"], g["width"]))
    new = [g for g in _s07_st.line_groups(doc["hlines"], "y1")
           if (g["px"], g["stroke"], g["width"]) not in seen]
    ylc = new[0]["stroke"] if len(new) == 1 else "n%d" % len(new)
    segs = new[0]["n_segments"] if len(new) == 1 else 0
    with open(path, encoding="utf-8", errors="replace") as fh:
        txt = fh.read()
    tag = _s07_re.search(r"<svg [^>]*>", txt)
    tag = tag.group(0) if tag else ""
    mw = _s07_re.search(r'width="([0-9.]+)in"', tag)
    mh = _s07_re.search(r'height="([0-9.]+)in"', tag)
    w = mw.group(1) if mw else "0"
    h = mh.group(1) if mh else "0"
    sizes = _s07_col.Counter(t["size"] for t in doc["texts"] if t["size"])
    tick = sizes.most_common(1)[0][0] if sizes else 0
    _s07_set("S07_TW", ";".join(str(x) for x in
                                (bg or "none", marker or "none", ylc, segs,
                                 w, h, tick)))
    _s07_set("S07_FILLS", " ".join(sorted(fills)) or "none")


def _s07_models(path):
    try:
        with open(path, encoding="utf-8") as fh:
            page = fh.read()
    except OSError:
        return []
    objs, stack = {}, []
    for blob in _s07_re.findall('<script type="application/json"[^>]*>(.*?)</script>', page, _s07_re.S):
        try:
            stack.append(_s07_json.loads(_s07_html.unescape(blob)))
        except ValueError:
            pass
    out = []
    while stack:
        v = stack.pop(0)
        if isinstance(v, dict):
            if v.get("type") == "object" and "id" in v and "name" in v:
                if v["id"] not in objs:
                    objs[v["id"]] = v
                    out.append(v)
            stack.extend(v.values())
        elif isinstance(v, list):
            stack.extend(v)
    return out


_S07_DEF = {}


def _s07_val(v):
    if isinstance(v, dict):
        if v.get("type") == "value" or "value" in v:
            return v.get("value")
        if "field" in v:
            return "field:" + str(v["field"])
    inner = getattr(v, "value", None)
    if inner is not None and not isinstance(v, (str, list, tuple)):
        return inner
    return v


def _s07_saved_first(objs):
    def first(kinds, attr):
        for o in objs:
            if o.get("name") not in kinds:
                continue
            a = o.get("attributes", {}) or {}
            if attr in a:
                return _s07_val(a[attr])
            k = o["name"]
            if k not in _S07_DEF:
                import bokeh.models as _bm
                try:
                    if k in ("Figure", "figure"):
                        from bokeh.plotting import figure as _s07_fig
                        _S07_DEF[k] = _s07_fig()
                    else:
                        _S07_DEF[k] = getattr(_bm, k)()
                except Exception:
                    _S07_DEF[k] = None
            d = _S07_DEF[k]
            return _s07_val(getattr(d, attr, None)) if d is not None else None
        return None
    return first


def _s07_served_first(doc):
    from bokeh.model import Model
    models = list(doc.select(dict(type=Model)))
    def first(kinds, attr):
        for m in models:
            if type(m).__name__ in kinds:
                return _s07_val(getattr(m, attr, None))
        return None
    return first


def _s07_fmt(first):
    def col(v):
        return str(v).lower() if v is not None else "none"
    dash = first(("Span",), "line_dash")
    if dash in (None, "solid") or (isinstance(dash, (list, tuple)) and not dash):
        dash = "solid"
    elif isinstance(dash, (list, tuple)):
        dash = " ".join(str(int(x)) for x in dash)
    asp = first(_S07_PLOTS, "aspect_ratio")
    asp = "%.4f" % float(asp) if asp is not None else "none"
    return ";".join([
        col(first(_S07_PLOTS, "border_fill_color")),
        col(first(_S07_PLOTS, "background_fill_color")),
        col(first(("Scatter",), "fill_color")),
        col(first(("Span",), "line_color")),
        str(dash), asp,
        str(first(("LinearAxis",), "major_label_text_font_size"))])


def _s07_page():
    objs = _s07_models(_s07_M.getGlobal("S07_PAGE"))
    _s07_set("S07_D", _s07_fmt(_s07_saved_first(objs)) if objs else "none")
    pal = "none"
    for o in objs:
        if str(o.get("name", "")).endswith("ColorMapper"):
            a = o.get("attributes", {}) or {}
            p = a.get("palette")
            if isinstance(p, dict):
                p = p.get("value") or p.get("entries")
            pal = "%s;%s;%s" % (" ".join(str(x).lower() for x in (p or [])),
                                a.get("low"), a.get("high"))
            break
    _s07_set("S07_PAL", pal)


def _s07_app():
    from bokeh.document import Document
    from bokeh.models import Select
    with open(_s07_M.getGlobal("S07_APP"), encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_s07_app")
    with _s07_w.catch_warnings():
        _s07_w.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_s07_app.py", "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    before = _s07_fmt(_s07_served_first(doc))
    _s07_set("S07_S", before)
    var = _s07_M.getGlobal("S07_MOVE")
    sel = [s for s in doc.select(dict(type=Select))
           if getattr(s, "_dash_var", None) == var]
    fired = 0
    if len(sel) == 1 and len(sel[0].options) > 1:
        old = sel[0].value
        opt = sel[0].options[1]
        new = opt[0] if isinstance(opt, (list, tuple)) else opt
        sel[0].value = new
        with _s07_w.catch_warnings():
            _s07_w.simplefilter("ignore")
            for cb in sel[0]._callbacks.get("value", []):
                cb("value", old, new)
                fired += 1
    _s07_set("S07_FIRED", fired)
    _s07_set("S07_SAME_AFTER", int(_s07_fmt(_s07_served_first(doc)) == before))


def _s07_child():
    import dash_render as _dr
    name = _s07_M.getGlobal("S07_CHILD")
    kind = _s07_M.getGlobal("S07_KIND")
    with _s07_w.catch_warnings(record=True) as caught:
        _s07_w.simplefilter("always")
        try:
            s = _dr.SchemeParser(name)
        except Exception as e:
            _s07_set("S07_DC", "error " + type(e).__name__)
            _s07_set("S07_DOK", 0)
            _s07_set("S07_DCW", -1)
            return
    _s07_set("S07_DCW", sum(1 for w in caught
                            if "not found, using s2color" in str(w.message)))
    T = _dr.OptionTranslator
    if kind == "red":
        cols = [str(s.default_color(0, k)).lower()
                for k in ("scatter", "bar", "connected", "line")]
        pats = [list(s.default_connect_pattern(0)), list(s.default_line_pattern(0))]
        want = list(T.translate_lpattern("dash"))
        ok = all(c == "#ff0000" for c in cols) and all(p == want for p in pats)
        desc = "%s %s" % (cols, pats)
    elif kind == "sp":
        syms = list(s.p_symbols[0:2])
        ok = syms == [T.translate_msymbol("diamond")] * 2
        desc = str(syms)
    else:
        sizes = [s.default_marker_size(0), s.default_marker_size(1)]
        want = s._markersize_px("huge")
        ok = all(abs(x - want) < 1e-9 for x in sizes)
        desc = "%s want %s" % (sizes, want)
    _s07_set("S07_DC", desc.replace('"', "'"))
    _s07_set("S07_DOK", int(ok))


def _s07_ci():
    import numpy as _np
    import pandas as _pd
    import dash_render as _dr
    from bokeh.models import ColumnDataSource
    from bokeh.plotting import figure
    name = _s07_M.getGlobal("S07_SCH")
    try:
        with _s07_w.catch_warnings():
            _s07_w.simplefilter("ignore")
            gm = _dr.GlyphMapper(scheme=_dr.SchemeParser(name))
            n = 40
            df = _pd.DataFrame(dict(
                x=_np.linspace(1.0, 40.0, n),
                y=_np.sin(_np.linspace(0, 3, n)) * 10 + 20 + _np.linspace(0, 5, n)))
            fig = figure()
            gm.map_lfitci(fig, ColumnDataSource(df), "y", "x", dict(), color_idx=0)
    except Exception:
        _s07_set("S07_DCI", "error")
        return
    kinds = _s07_col.defaultdict(list)
    for r in fig.renderers:
        g = getattr(r, "glyph", None)
        if g is not None:
            kinds[type(g).__name__].append(g)
    try:
        out = (str(kinds["VArea"][0].fill_color).lower(),
               str(kinds["Patch"][0].line_color).lower(),
               str(kinds["Line"][0].line_color).lower())
    except IndexError:
        _s07_set("S07_DCI", "error")
        return
    _s07_set("S07_DCI", ";".join(out))


def _s07_rgb():
    parts = _s07_M.getGlobal("S07_GOB").split()
    try:
        _s07_set("S07_HEX", "#%02x%02x%02x" % tuple(int(float(p)) for p in parts[:3]))
    except (ValueError, TypeError):
        _s07_set("S07_HEX", "none")
end

capture program drop _s07_gob
program define _s07_gob
    version 19
    args path
    local v "`.Graph.`path''"
    global S07_GOB `"`v'"'
end

capture program drop _s07_hex
program define _s07_hex
    version 19
    args path
    _s07_gob `path'
    python: __import__("__main__")._s07_rgb()
end

* ==== S07 P1.25a: Ship the six StataCorp schemes ====
local only : env WP30_ONLY
if inlist("`only'", "", "S07") & `: list posof "S07" in w30_run' {
    display as text "S07 start " c(current_date) " " c(current_time)
    // The six StataCorp schemes dash did not ship, against twoway's own
    // drawing in the same run.  Every page, app, SVG and log goes under
    // `w30_work'; only SX-05's and SX-08's child scheme files sit in the
    // working directory (twoway's findfile and dash's lookup read there),
    // each checked absent before it is written and erased in its case.
    local s07_six "meta stcolor_meta stcolor_mv stcoloralias stgcolor_meta stgcolor_mv"
    local s07_entry "`c(scheme)'"
    local s07_nk1 "is not a known theme or scheme"
    local s07_nk2 "not found, using s2color"
    capture log close sxk
    capture dash clear
    sysuse auto, clear

    // ------------------------------------------------------------
    // SX-01: the refusal is gone on every entry point.
    // ------------------------------------------------------------
    foreach S of local s07_six {
        capture twoway scatter mpg weight, scheme(`S') nodraw
        local s07_rc = _rc
        _w30_expect SX-01 "(`s07_rc' == 0)" "twoway scheme(`S') rc `s07_rc'"
    }
    log using "`w30_work'/sx1.log", text replace name(sxk)
    foreach S in `s07_six' META meta.scheme {
        capture dash clear
        capture noisily dash scatter mpg weight, scheme(`S') name(sx1)
        local s07_r1 = _rc
        capture noisily dash build, scheme(`S') saving("`w30_work'/sx1.html") replace nobrowser
        local s07_r2 = _rc
        tempfile s07_mj s07_dj
        capture noisily _dash_serve_spec, specpath("`s07_mj'") datapath("`s07_dj'") scheme(`S')
        local s07_r3 = _rc
        _w30_expect SX-01 "(`s07_r1' == 0 & `s07_r2' == 0 & `s07_r3' == 0)" "scheme(`S'): dash rc `s07_r1', build rc `s07_r2', serve spec rc `s07_r3'"
    }
    capture dash clear
    log close sxk
    cert_log_has "`w30_work'/sx1.log", needle("`s07_nk1'")
    local s07_n1 = r(count)
    cert_log_has "`w30_work'/sx1.log", needle("`s07_nk2'")
    local s07_n2 = r(count)
    _w30_expect SX-01 "(`s07_n1' == 0 & `s07_n2' == 0)" "the log holds `s07_n1' unknown-scheme and `s07_n2' not-found notes"
    _w30_done SX-01 "the six are accepted by twoway, dash, dash build and the serve spec, rc 0 and no note"

    // ------------------------------------------------------------
    // SX-02: drawn as twoway, saved page; SX-03: served, and after a
    // dropdown move.  Controls s2color (first, for meta's tick ratio)
    // and stcolor run the same way.
    // ------------------------------------------------------------
    log using "`w30_work'/sx2.log", text replace name(sxk)
    local s07_all3 = 1
    foreach S in s2color stcolor `s07_six' {
        sysuse auto, clear
        capture dash clear
        local s07_svg  "`w30_work'/sx2_`S'.svg"
        local s07_svg0 "`w30_work'/sx2_`S'_0.svg"
        twoway scatter mpg weight, yline(20) scheme(`S') name(sx2tw, replace)
        graph export "`s07_svg'", name(sx2tw) replace
        twoway scatter mpg weight, scheme(`S') name(sx2tw, replace)
        graph export "`s07_svg0'", name(sx2tw) replace
        global S07_SVG  "`s07_svg'"
        global S07_SVG0 "`s07_svg0'"
        python: __import__("__main__")._s07_svg()
        tokenize "${S07_TW}", parse(";")
        local tw_bg "`1'"
        local tw_mk "`3'"
        local tw_yl "`5'"
        local tw_sg "`7'"
        local tw_w  "`9'"
        local tw_h  "`11'"
        local tw_tk "`13'"
        local s07_page "`w30_work'/sx2_`S'.html"
        capture noisily dash scatter mpg weight, yline(20) scheme(`S') saving("`s07_page'", replace)
        local s07_rc = _rc
        global S07_PAGE "`s07_page'"
        python: __import__("__main__")._s07_page()
        local s07_d2 "${S07_D}"
        tokenize "${S07_D}", parse(";")
        local d_bd "`1'"
        local d_fl "`5'"
        local d_sp "`7'"
        local d_ds "`9'"
        local d_as "`11'"
        local d_tk = real(subinstr("`13'", "pt", "", .))
        local s07_twtick_`S' = `tw_tk'
        local s07_dtick_`S'  = `d_tk'
        local s07_ok = (`s07_rc' == 0 & "`tw_bg'" == "`d_bd'" & "`tw_mk'" == "`d_fl'" & "`tw_yl'" == "`d_sp'")
        local s07_ok = `s07_ok' & ((`tw_sg' == 1) == ("`d_ds'" == "solid"))
        capture local s07_ok = `s07_ok' & (abs(`tw_w'/`tw_h' - `d_as') < 0.0005)
        if _rc local s07_ok = 0
        _w30_expect SX-02 "`s07_ok'" "`S': rc `s07_rc', twoway ${S07_TW}; dash `s07_d2'"
        if "`S'" == "meta" {
            local s07_rt = `s07_twtick_meta'/`s07_twtick_s2color'
            local s07_rd = `s07_dtick_meta'/`s07_dtick_s2color'
            _w30_expect SX-02 "(abs(`s07_rt' - `s07_rd') < 0.01)" "meta's tick ratio: twoway `s07_rt', dash `s07_rd'"
        }

        // SX-03 on the same graph, served.
        capture dash clear
        capture quietly dash scatter mpg weight, yline(20) scheme(`S') name(g1)
        local s07_app "`w30_work'/sx3_`S'.py"
        capture noisily dash build, server saving("`s07_app'") replace nobrowser filter(foreign, type(dropdown))
        local s07_rc3 = _rc
        global S07_S ""
        global S07_FIRED 0
        global S07_SAME_AFTER 0
        global S07_APP "`s07_app'"
        global S07_MOVE "foreign"
        if `s07_rc3' == 0 capture noisily python: __import__("__main__")._s07_app()
        local s07_ok3 = (`s07_rc3' == 0 & "${S07_S}" == "`s07_d2'" & ${S07_FIRED} == 1 & ${S07_SAME_AFTER} == 1)
        if !`s07_ok3' {
            display as error "SX-03 FAIL: `S': build rc `s07_rc3', served ${S07_S} vs saved `s07_d2', fired ${S07_FIRED}, same after ${S07_SAME_AFTER}"
            local s07_all3 = 0
        }
        capture dash clear
        capture erase "`s07_svg'"
        capture erase "`s07_svg0'"
        capture erase "`s07_page'"
        capture erase "`s07_app'"
    }
    log close sxk
    cert_log_has "`w30_work'/sx2.log", needle("`s07_nk1'")
    local s07_n1 = r(count)
    _w30_expect SX-02 "(`s07_n1' == 0)" "the log holds `s07_n1' unknown-scheme notes"
    _w30_done SX-02 "background, first series, yline colour and solidity, proportions and meta's tick ratio are twoway's"
    _w30_expect SX-03 "`s07_all3'" "a served summary differed (the SX-03 FAIL lines above)"
    _w30_done SX-03 "the served app draws the saved page's summary, and a dropdown move leaves it unchanged"

    // ------------------------------------------------------------
    // SX-04: the inherited c(scheme).
    // ------------------------------------------------------------
    log using "`w30_work'/sx4.log", text replace name(sxk)
    foreach S of local s07_six {
        sysuse auto, clear
        capture dash clear
        set scheme `S'
        local s07_svg "`w30_work'/sx4_`S'.svg"
        twoway scatter mpg weight, yline(20) name(sx4tw, replace)
        graph export "`s07_svg'", name(sx4tw) replace
        twoway scatter mpg weight, name(sx4tw, replace)
        graph export "`w30_work'/sx4_`S'_0.svg", name(sx4tw) replace
        global S07_SVG  "`s07_svg'"
        global S07_SVG0 "`w30_work'/sx4_`S'_0.svg"
        python: __import__("__main__")._s07_svg()
        tokenize "${S07_TW}", parse(";")
        local tw_bg "`1'"
        local tw_mk "`3'"
        local tw_yl "`5'"
        local tw_sg "`7'"
        local tw_w  "`9'"
        local tw_h  "`11'"
        local s07_page "`w30_work'/sx4_`S'.html"
        capture noisily dash scatter mpg weight, yline(20) saving("`s07_page'", replace)
        local s07_rc = _rc
        set scheme `s07_entry'
        global S07_PAGE "`s07_page'"
        python: __import__("__main__")._s07_page()
        tokenize "${S07_D}", parse(";")
        local s07_ok = (`s07_rc' == 0 & "`tw_bg'" == "`1'" & "`tw_mk'" == "`5'" & "`tw_yl'" == "`7'")
        local s07_ok = `s07_ok' & ((`tw_sg' == 1) == ("`9'" == "solid"))
        capture local s07_ok = `s07_ok' & (abs(`tw_w'/`tw_h' - `11') < 0.0005)
        if _rc local s07_ok = 0
        _w30_expect SX-04 "`s07_ok'" "set scheme `S': rc `s07_rc', twoway ${S07_TW}; dash ${S07_D}"
        capture erase "`s07_svg'"
        capture erase "`w30_work'/sx4_`S'_0.svg"
        capture erase "`s07_page'"
    }
    set scheme `s07_entry'
    log close sxk
    cert_log_has "`w30_work'/sx4.log", needle("`s07_nk1'")
    local s07_n1 = r(count)
    _w30_expect SX-04 "(`s07_n1' == 0)" "the log holds `s07_n1' unknown-scheme notes"
    _w30_done SX-04 "an inherited c(scheme) that is one of the six is drawn as twoway draws it, with no note"

    // ------------------------------------------------------------
    // SX-05: the S3 batch's child-scheme tables over the six.
    // ------------------------------------------------------------
    foreach S of local s07_six {
        foreach k in red sp zp {
            local f1 "scheme-sx5`k'_`S'.scheme"
            local f2 "sx5`k'_`S'.scheme"
            capture confirm new file "`f1'"
            local s07_c1 = _rc
            capture confirm new file "`f2'"
            local s07_c2 = _rc
            _w30_expect SX-05 "(`s07_c1' == 0 & `s07_c2' == 0)" "`f1' or `f2' already exists in the working directory; not overwritten"
            if `s07_c1' | `s07_c2' continue
            foreach f in "`f1'" "`f2'" {
                tempname s07_fh
                file open `s07_fh' using "`f'", write text
                file write `s07_fh' "#include `S'" _n
                if "`k'" == "red" file write `s07_fh' "color p1 red" _n "linepattern p1 dash" _n
                if "`k'" == "sp"  file write `s07_fh' "symbol p diamond" _n
                if "`k'" == "zp"  file write `s07_fh' "symbolsize p huge" _n
                file close `s07_fh'
            }
            clear
            quietly set obs 11
            quietly generate x = _n
            quietly generate y1 = x
            quietly generate y2 = x + 1
            local s07_sch "sx5`k'_`S'"
            if "`k'" == "red" {
                twoway scatter y1 x, scheme(`s07_sch') nodraw
                _s07_gob plotregion1.plot1.style.marker.fillcolor.rgb
                local g1 "${S07_GOB}"
                twoway bar y1 x, scheme(`s07_sch') nodraw
                _s07_gob plotregion1.plot1.style.area.shadestyle.color.rgb
                local g2 "${S07_GOB}"
                twoway connected y1 x, scheme(`s07_sch') nodraw
                _s07_gob plotregion1.plot1.style.line.color.rgb
                local g3 "${S07_GOB}"
                _s07_gob plotregion1.plot1.style.line.pattern.setting
                local g4 "${S07_GOB}"
                twoway line y1 x, scheme(`s07_sch') nodraw
                _s07_gob plotregion1.plot1.style.line.color.rgb
                local g5 "${S07_GOB}"
                _s07_gob plotregion1.plot1.style.line.pattern.setting
                local g6 "${S07_GOB}"
                local s07_tw = ("`g1'" == "255 0 0" & "`g2'" == "255 0 0" & "`g3'" == "255 0 0" & "`g4'" == "dash" & "`g5'" == "255 0 0" & "`g6'" == "dash")
                local s07_twd "`g1'|`g2'|`g3'|`g4'|`g5'|`g6'"
            }
            else {
                twoway scatter y1 y2 x, scheme(`s07_sch') nodraw
                local s07_m = cond("`k'" == "sp", "symbol", "size")
                _s07_gob plotregion1.plot1.style.marker.`s07_m'.setting
                local g1 "${S07_GOB}"
                _s07_gob plotregion1.plot2.style.marker.`s07_m'.setting
                local g2 "${S07_GOB}"
                local s07_want = cond("`k'" == "sp", "diamond", "4.8611")
                local s07_tw = ("`g1'" == "`s07_want'" & "`g2'" == "`s07_want'")
                local s07_twd "`g1'|`g2'"
            }
            global S07_CHILD "`s07_sch'"
            global S07_KIND "`k'"
            global S07_DC ""
            global S07_DOK 0
            global S07_DCW -1
            capture noisily python: __import__("__main__")._s07_child()
            _w30_expect SX-05 "(`s07_tw' == 1)" "`s07_sch': twoway drew `s07_twd'"
            _w30_expect SX-05 "(${S07_DOK} == 1 & ${S07_DCW} == 0)" "`s07_sch': dash ${S07_DC}, ${S07_DCW} not-found notes"
            capture erase "`f1'"
            capture erase "`f2'"
        }
    }
    _w30_done SX-05 "color p1, linepattern p1, symbol p and symbolsize p in a child of each of the six reach what twoway's chain reaches"

    // ------------------------------------------------------------
    // SX-06: the ci band.
    // ------------------------------------------------------------
    foreach S of local s07_six {
        sysuse auto, clear
        twoway lfitci mpg weight, scheme(`S') nodraw
        _s07_hex plotregion1.plot1.style.area.shadestyle.color.rgb
        local h1 "${S07_HEX}"
        _s07_hex plotregion1.plot1.style.area.linestyle.color.rgb
        local h2 "${S07_HEX}"
        _s07_hex plotregion1.plot2.style.line.color.rgb
        local h3 "${S07_HEX}"
        global S07_SCH "`S'"
        global S07_DCI "error"
        capture noisily python: __import__("__main__")._s07_ci()
        _w30_expect SX-06 `""`h1';`h2';`h3'" == "${S07_DCI}""' "`S': twoway `h1';`h2';`h3', dash ${S07_DCI}"
    }
    _w30_done SX-06 "lfitci's band fill, band outline and fit line are twoway's under each of the six"

    // ------------------------------------------------------------
    // SX-07: stcoloralias is stcolor.
    // ------------------------------------------------------------
    sysuse auto, clear
    foreach S in stcolor stcoloralias {
        twoway scatter mpg weight, colorvar(price) scheme(`S') name(sx7tw, replace)
        graph export "`w30_work'/sx7_`S'.svg", name(sx7tw) replace
        global S07_SVG "`w30_work'/sx7_`S'.svg"
        global S07_SVG0 ""
        python: __import__("__main__")._s07_svg()
        local s07_fills_`S' "${S07_FILLS}"
        capture dash clear
        capture noisily dash scatter mpg weight, colorvar(price) scheme(`S') saving("`w30_work'/sx7_`S'.html", replace)
        local s07_rc7_`S' = _rc
        global S07_PAGE "`w30_work'/sx7_`S'.html"
        python: __import__("__main__")._s07_page()
        local s07_d7_`S' "${S07_D}|${S07_PAL}"
        capture erase "`w30_work'/sx7_`S'.svg"
        capture erase "`w30_work'/sx7_`S'.html"
    }
    _w30_expect SX-07 `""`s07_fills_stcolor'" == "`s07_fills_stcoloralias'""' "twoway's colorvar fills differ: `s07_fills_stcolor' / `s07_fills_stcoloralias'"
    _w30_expect SX-07 "(`s07_rc7_stcolor' == 0 & `s07_rc7_stcoloralias' == 0)" "dash rc `s07_rc7_stcolor' / `s07_rc7_stcoloralias'"
    _w30_expect SX-07 `""`s07_d7_stcolor'" == "`s07_d7_stcoloralias'""' "dash differs: `s07_d7_stcolor' / `s07_d7_stcoloralias'"
    _w30_done SX-07 "stcoloralias draws what stcolor draws, in twoway's colorvar() scatter and in dash's page"

    // ------------------------------------------------------------
    // SX-08: an #include of one of the six in a scheme file of yours.
    // ------------------------------------------------------------
    sysuse auto, clear
    capture confirm new file "sx8.scheme"
    local s07_c8 = _rc
    _w30_expect SX-08 "(`s07_c8' == 0)" "sx8.scheme already exists in the working directory; not overwritten"
    if `s07_c8' == 0 {
        tempname s07_fh
        file open `s07_fh' using "sx8.scheme", write text
        file write `s07_fh' "#include stcolor_meta" _n "color background red" _n
        file close `s07_fh'
        twoway scatter mpg weight, yline(20) scheme(sx8) name(sx8tw, replace)
        graph export "`w30_work'/sx8.svg", name(sx8tw) replace
        twoway scatter mpg weight, scheme(sx8) name(sx8tw, replace)
        graph export "`w30_work'/sx8_0.svg", name(sx8tw) replace
        global S07_SVG "`w30_work'/sx8.svg"
        global S07_SVG0 "`w30_work'/sx8_0.svg"
        python: __import__("__main__")._s07_svg()
        tokenize "${S07_TW}", parse(";")
        local s07_tw8 = ("`1'" == "#ff0000" & "`3'" == "#1a85ff" & "`5'" == "#c10534" & "`7'" == "1")
        log using "`w30_work'/sx8.log", text replace name(sxk)
        capture dash clear
        capture noisily dash scatter mpg weight, yline(20) scheme(sx8) saving("`w30_work'/sx8.html", replace)
        local s07_rc8 = _rc
        log close sxk
        global S07_PAGE "`w30_work'/sx8.html"
        python: __import__("__main__")._s07_page()
        tokenize "${S07_D}", parse(";")
        local s07_d8 = (`s07_rc8' == 0 & "`1'" == "#ff0000" & "`5'" == "#1a85ff" & "`7'" == "#c10534" & "`9'" == "solid")
        cert_log_has "`w30_work'/sx8.log", needle("`s07_nk2'")
        local s07_n8 = r(count)
        _w30_expect SX-08 "(`s07_tw8' == 1)" "twoway drew ${S07_TW}"
        _w30_expect SX-08 "(`s07_d8' == 1 & `s07_n8' == 0)" "dash rc `s07_rc8' drew ${S07_D}, `s07_n8' not-found notes"
        capture erase "sx8.scheme"
        capture erase "`w30_work'/sx8.svg"
        capture erase "`w30_work'/sx8_0.svg"
        capture erase "`w30_work'/sx8.html"
    }
    _w30_done SX-08 "#include stcolor_meta in a scheme file of yours resolves as twoway resolves it, with no note"

    foreach k in 1 2 4 8 {
        capture erase "`w30_work'/sx`k'.log"
    }
    capture erase "`w30_work'/sx1.html"
    capture graph drop sx2tw sx4tw sx7tw sx8tw
    capture dash clear
    sysuse auto, clear
    display as text "S07 end " c(current_date) " " c(current_time)
}
* ==== end S07 ====

// S08's helpers, outside every gate, where a python block may hold braces
// (copies of WP-29 S03's readers, renamed _s08_*).  Reached through
// __main__:
//   _s08_page()  S08_MSZ (the first Scatter's size), S08_TTL (the title's
//                font size), S08_LBL (the first LabelSet's
//                x_offset|y_offset|text_font_size), S08_LEG (each legend's
//                label font size) and S08_CBL (the ColorBar's label font
//                size) of the saved page S08_PAGE
//   _s08_app()   the same, prefixed S08_S, of the served app S08_APP; then
//                a RangeSlider move on weight sets S08_SAME_AFTER
//   _s08_tw()    S08_TWSIZE: the size of the last <text> equal to S08_TXT in
//                S08_SVG; S08_TWDX: its x minus the inner circle's centre;
//                S08_TWUPR: units per Stata unit
python:
import json as _s08_json, re as _s08_re, html as _s08_html
import warnings as _s08_w
import __main__ as _s08_main
from sfi import Macro as _s08_M


def _s08_val(v):
    if isinstance(v, dict):
        return v.get("value")
    return v


def _s08_saved_models(path):
    try:
        with open(path, encoding="utf-8") as fh:
            page = fh.read()
    except OSError:
        return []
    objs, stack = {}, []
    for blob in _s08_re.findall('<script type="application/json"[^>]*>(.*?)</script>', page, _s08_re.S):
        try:
            stack.append(_s08_json.loads(_s08_html.unescape(blob)))
        except ValueError:
            pass
    while stack:
        v = stack.pop()
        if isinstance(v, dict):
            if v.get("type") == "object" and "id" in v and "name" in v:
                objs.setdefault(v["id"], v)
            stack.extend(v.values())
        elif isinstance(v, list):
            stack.extend(v)
    out = []
    for o in objs.values():
        out.append((o["name"], o.get("attributes", {}) or {}))
    return out


def _s08_get(kind, attrs, attr):
    if attr in attrs:
        return _s08_val(attrs[attr])
    import bokeh.models as _bm
    try:
        return _s08_val(getattr(getattr(_bm, kind)(), attr, None))
    except Exception:
        return None


def _s08_summary(models):
    msz, ttl, lbl, leg, cbl = [], [], [], [], []
    for kind, get in models:
        if kind == "Scatter":
            msz.append("%g" % float(get("size")))
        elif kind == "Title" and get("text"):
            ttl.append(str(get("text_font_size")))
        elif kind == "LabelSet":
            lbl.append("%.3f|%.3f|%s" % (float(get("x_offset")), float(get("y_offset")),
                                         get("text_font_size")))
        elif kind == "Legend":
            leg.append(str(get("label_text_font_size")))
        elif kind == "ColorBar":
            cbl.append(str(get("major_label_text_font_size")))
    return dict(MSZ=(msz[0] if msz else ""), TTL="|".join(sorted(ttl)),
                LBL=(sorted(lbl)[0] if lbl else ""), LEG="|".join(sorted(leg)),
                CBL="|".join(sorted(cbl)))


def _s08_set(prefix, summ):
    for k, v in summ.items():
        _s08_M.setGlobal(prefix + k, v)


def _s08_page():
    models = [(k, (lambda a, k=k: (lambda attr: _s08_get(k, a, attr)))(a))
              for k, a in _s08_saved_models(_s08_M.getGlobal("S08_PAGE"))]
    _s08_set("S08_", _s08_summary(models))


def _s08_doc_summary(doc):
    seen = dict()
    for root in doc.roots:
        for m in root.references():
            seen[m.id] = m
    models = [(type(m).__name__, (lambda m=m: (lambda attr: _s08_val(getattr(m, attr, None))))())
              for m in seen.values()]
    return _s08_summary(models)


def _s08_app():
    from bokeh.document import Document
    from bokeh.models import RangeSlider
    with open(_s08_M.getGlobal("S08_APP"), encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_s08_app")
    with _s08_w.catch_warnings():
        _s08_w.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_s08_app.py", "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    before = _s08_doc_summary(doc)
    _s08_set("S08_S", before)
    sl = [s for s in doc.select(dict(type=RangeSlider)) if getattr(s, "_dash_var", None) == "weight"]
    fired = 0
    if len(sl) == 1:
        old = sl[0].value
        lo, hi = old
        new = (lo + (hi - lo) / 4.0, hi)
        sl[0].value = new
        with _s08_w.catch_warnings():
            _s08_w.simplefilter("ignore")
            for attr in ("value", "value_throttled"):
                for cb in sl[0]._callbacks.get(attr, []):
                    cb(attr, old, new)
                    fired += 1
    _s08_M.setGlobal("S08_SAME_AFTER", str(int(fired > 0 and _s08_doc_summary(doc) == before)))


def _s08_tw():
    import svg_truth as _s08_svg
    doc = _s08_svg.svg_document(_s08_M.getGlobal("S08_SVG"))
    want = _s08_M.getGlobal("S08_TXT")
    cv = doc["canvas"]
    _s08_M.setGlobal("S08_TWUPR", repr(min(cv["w"], cv["h"]) / 100.0))
    t = [e for e in doc["texts"] if e["text"] == want]
    # The last match: a legend key or colour-key label is written after
    # the axes, whose title or tick may hold the same text.
    _s08_M.setGlobal("S08_TWSIZE", repr(float(t[-1]["size"])) if t else ".")
    cs = [c for c in doc["circles"] if c.get("r") is not None and c.get("cx") is not None]
    if t and cs:
        c = min(cs, key=lambda c: c["r"])
        _s08_M.setGlobal("S08_TWDX", repr(float(t[0]["x"]) - float(c["cx"])))
    else:
        _s08_M.setGlobal("S08_TWDX", ".")


_s08_main._s08_page = _s08_page
_s08_main._s08_app = _s08_app
_s08_main._s08_tw = _s08_tw
end

// _s08_build: run one dash command, build the saved page (with a range
// filter on weight, as the served app) and the served app, and read both.
capture program drop _s08_build
program define _s08_build
    version 19
    args stem work
    global S08_PAGE "`work'/`stem'.html"
    global S08_APP "`work'/`stem'_app.py"
    capture erase "${S08_PAGE}"
    capture erase "${S08_APP}"
    capture noisily dash build, saving("${S08_PAGE}") replace nobrowser filter(weight, type(range))
    capture noisily dash build, saving("${S08_APP}") server replace filter(weight, type(range))
    python: __import__("__main__")._s08_page()
    python: __import__("__main__")._s08_app()
    capture erase "${S08_PAGE}"
    capture erase "${S08_APP}"
end

// _s08_twsvg: export the current twoway graph and read S08_TXT from it.
capture program drop _s08_twsvg
program define _s08_twsvg
    version 19
    args stem work txt
    global S08_SVG "`work'/`stem'.svg"
    global S08_TXT `"`txt'"'
    quietly graph export "${S08_SVG}", replace as(svg)
    python: __import__("__main__")._s08_tw()
    capture erase "${S08_SVG}"
end

* ==== S08 P1.12a: Stata size units for markers, text and gaps ====
local only : env WP30_ONLY
if inlist("`only'", "", "S08") & `: list posof "S08" in w30_run' {
    display as text "S08 start " c(current_date) " " c(current_time)
    local s08_scheme "`c(scheme)'"
    set scheme s2color
    quietly sysuse auto, clear
    capture dash clear

    // SU-10: msize(medium) and msize(1.52778) are the default marker.
    twoway scatter mpg weight
    local s08_twd "`.Graph.plotregion1.plot1.style.marker.size.setting'"
    twoway scatter mpg weight, msize(medium)
    local s08_twm "`.Graph.plotregion1.plot1.style.marker.size.setting'"
    twoway scatter mpg weight, msize(1.52778)
    local s08_twn "`.Graph.plotregion1.plot1.style.marker.size.setting'"
    capture dash clear
    dash scatter mpg weight, name(s08g)
    _s08_build su10d "`w30_work'"
    local s08_d "${S08_MSZ}"
    local s08_ds "${S08_SMSZ}"
    capture dash clear
    dash scatter mpg weight, msize(medium) name(s08g)
    _s08_build su10m "`w30_work'"
    local s08_m "${S08_MSZ}|${S08_SMSZ}"
    local s08_a10 "${S08_SAME_AFTER}"
    capture dash clear
    dash scatter mpg weight, msize(1.52778) name(s08g)
    _s08_build su10n "`w30_work'"
    local s08_n "${S08_MSZ}|${S08_SMSZ}"
    _w30_expect SU-10 "(`s08_twm' == `s08_twd' & `s08_twn' == `s08_twd')" "twoway settings `s08_twd' `s08_twm' `s08_twn'"
    _w30_expect SU-10 "(abs(`s08_d' - 5.8667) < 0.001 & `s08_ds' == `s08_d')" "dash default `s08_d' / `s08_ds'"
    _w30_expect SU-10 `"("`s08_m'" == "`s08_d'|`s08_d'" & "`s08_n'" == "`s08_d'|`s08_d'")"' "dash medium `s08_m', number `s08_n'"
    _w30_done SU-10 "msize(medium) and msize(1.52778) draw the default marker, as in twoway"

    // SU-11: title size(large) is the s2color heading.
    twoway scatter mpg weight, title("T")
    _s08_twsvg su11a "`w30_work'" "T"
    local s08_t0 "${S08_TWSIZE}"
    twoway scatter mpg weight, title("T", size(large))
    _s08_twsvg su11b "`w30_work'" "T"
    local s08_t1 "${S08_TWSIZE}"
    capture dash clear
    dash scatter mpg weight, title("T") name(s08g)
    _s08_build su11a "`w30_work'"
    local s08_d0 "${S08_TTL}|${S08_STTL}"
    capture dash clear
    dash scatter mpg weight, title("T", size(large)) name(s08g)
    _s08_build su11b "`w30_work'"
    local s08_d1 "${S08_TTL}|${S08_STTL}"
    local s08_a11 "${S08_SAME_AFTER}"
    _w30_expect SU-11 "(abs(`s08_t1' - `s08_t0') < 0.5)" "twoway title `s08_t0' / `s08_t1'"
    _w30_expect SU-11 `"("`s08_d1'" == "14pt|14pt" & "`s08_d0'" == "`s08_d1'")"' "dash title `s08_d0' / `s08_d1'"
    _w30_done SU-11 "title size(large) is 14pt, the scheme's heading, in both modes"

    // SU-12: stcolor, title size(14pt) against the default heading.
    set scheme stcolor
    twoway scatter mpg weight, title("T")
    _s08_twsvg su12a "`w30_work'" "T"
    local s08_t0 "${S08_TWSIZE}"
    twoway scatter mpg weight, title("T", size(14pt))
    _s08_twsvg su12b "`w30_work'" "T"
    local s08_t1 "${S08_TWSIZE}"
    capture dash clear
    dash scatter mpg weight, title("T") name(s08g)
    _s08_build su12a "`w30_work'"
    local s08_d0 = real(subinstr("${S08_TTL}", "pt", "", .))
    local s08_s0 = real(subinstr("${S08_STTL}", "pt", "", .))
    capture dash clear
    dash scatter mpg weight, title("T", size(14pt)) name(s08g)
    _s08_build su12b "`w30_work'"
    local s08_d1 = real(subinstr("${S08_TTL}", "pt", "", .))
    local s08_s1 = real(subinstr("${S08_STTL}", "pt", "", .))
    set scheme s2color
    local s08_rt = `s08_t1' / `s08_t0'
    _w30_expect SU-12 "(abs(`s08_d1' / `s08_d0' - `s08_rt') < 0.005 * `s08_rt')" "saved ratio `s08_d1'/`s08_d0', twoway `s08_rt'"
    _w30_expect SU-12 "(abs(`s08_s1' / `s08_s0' - `s08_rt') < 0.005 * `s08_rt')" "served ratio `s08_s1'/`s08_s0', twoway `s08_rt'"
    _w30_done SU-12 "under stcolor size(14pt) keeps twoway's proportion to the heading"

    // SU-13: the 3 o'clock label offset, by default and at mlabgap(0).
    foreach g in dflt 0 {
        local s08_go = cond("`g'" == "dflt", "", "mlabgap(`g')")
        twoway scatter mpg weight in 1, mlabel(make) `s08_go'
        _s08_twsvg su13`g' "`w30_work'" "AMC Concord"
        local s08_tw = ${S08_TWDX} / ${S08_TWUPR} * 3.84
        capture dash clear
        dash scatter mpg weight in 1, mlabel(make) `s08_go' name(s08g)
        _s08_build su13`g' "`w30_work'"
        local s08_dx : word 1 of `=subinstr("${S08_LBL}", "|", " ", .)'
        local s08_sx : word 1 of `=subinstr("${S08_SLBL}", "|", " ", .)'
        local s08_a13 "${S08_SAME_AFTER}"
        _w30_expect SU-13 "(abs(`s08_dx' - `s08_tw') < 0.05 & abs(`s08_sx' - `s08_tw') < 0.05)" "mlabgap `g': twoway `s08_tw', dash `s08_dx' / `s08_sx'"
    }
    _w30_done SU-13 "the label sits the marker radius plus the gap from its point, as twoway places it"

    // SU-14: legend(size(*2)) doubles the key text.
    twoway (scatter mpg weight) (scatter price weight, yaxis(2))
    _s08_twsvg su14a "`w30_work'" "Price"
    local s08_t0 "${S08_TWSIZE}"
    twoway (scatter mpg weight) (scatter price weight, yaxis(2)), legend(size(*2))
    _s08_twsvg su14b "`w30_work'" "Price"
    local s08_t1 "${S08_TWSIZE}"
    capture dash clear
    dash (scatter mpg weight) (scatter price weight, yaxis(2)), name(s08g)
    _s08_build su14a "`w30_work'"
    local s08_d0 = real(subinstr("${S08_LEG}", "pt", "", .))
    local s08_s0 = real(subinstr("${S08_SLEG}", "pt", "", .))
    capture dash clear
    dash (scatter mpg weight) (scatter price weight, yaxis(2)), legend(size(*2)) name(s08g)
    _s08_build su14b "`w30_work'"
    local s08_d1 = real(subinstr("${S08_LEG}", "pt", "", .))
    local s08_s1 = real(subinstr("${S08_SLEG}", "pt", "", .))
    _w30_expect SU-14 "(abs(`s08_t1' / `s08_t0' - 2) < 0.02)" "twoway key `s08_t0' / `s08_t1'"
    _w30_expect SU-14 "(abs(`s08_d1' / `s08_d0' - 2) < 0.02 & abs(`s08_s1' / `s08_s0' - 2) < 0.02)" "dash key `s08_d0' / `s08_d1', served `s08_s0' / `s08_s1'"
    _w30_done SU-14 "legend(size(*2)) doubles the key text, as in twoway"

    // SU-15: zlabel(, labsize(large)) on the colour bar.
    twoway scatter mpg weight, colorvar(price) zlabel(, labsize(large))
    _s08_twsvg su15 "`w30_work'" "5,000"
    local s08_t1 "${S08_TWSIZE}"
    capture dash clear
    dash scatter mpg weight, colorvar(price) zlabel(, labsize(large)) name(s08g)
    _s08_build su15 "`w30_work'"
    local s08_c "${S08_CBL}|${S08_SCBL}"
    local s08_a15 "${S08_SAME_AFTER}"
    _w30_expect SU-15 "(abs(`s08_t1' - 140) < 0.5)" "twoway key label `s08_t1'"
    _w30_expect SU-15 `"("`s08_c'" == "14pt|14pt")"' "dash colour-bar labels `s08_c'"
    _w30_done SU-15 "zlabel(, labsize(large)) draws 14pt on the colour bar, as in twoway"

    // SU-16: msize(HUGE) is noted and drawn at the scheme's default (s2color:
    // medium, as twoway); msize(-1) is silent.
    capture log close su1k
    log using "`w30_work'/su16a.log", text replace name(su1k)
    twoway scatter mpg weight, msize(HUGE)
    log close su1k
    cert_log_has "`w30_work'/su16a.log", needle("named style HUGE not found")
    local s08_n1 = r(count)
    capture dash clear
    log using "`w30_work'/su16b.log", text replace name(su1k)
    dash scatter mpg weight, msize(HUGE) name(s08g)
    _s08_build su16a "`w30_work'"
    log close su1k
    cert_log_has "`w30_work'/su16b.log", needle("msize(HUGE) is not a recognised size; using the scheme")
    local s08_n2 = r(count)
    local s08_h "${S08_MSZ}|${S08_SMSZ}"
    log using "`w30_work'/su16c.log", text replace name(su1k)
    twoway scatter mpg weight, msize(-1)
    log close su1k
    cert_log_has "`w30_work'/su16c.log", needle("(note:")
    local s08_n3 = r(count)
    // WP-30 P1.28a: no Stata graph in memory, so dash's graph export note
    // is not among the notes counted (setup only; the counts are unchanged).
    quietly graph drop _all
    capture dash clear
    log using "`w30_work'/su16d.log", text replace name(su1k)
    dash scatter mpg weight, msize(-1) name(s08g)
    _s08_build su16b "`w30_work'"
    log close su1k
    cert_log_has "`w30_work'/su16d.log", needle("(note:")
    local s08_n4 = r(count)
    local s08_z "${S08_MSZ}|${S08_SMSZ}"
    // Once per build: dash build and (WP-30 P1.26b) dash build, server.
    _w30_expect SU-16 "(`s08_n1' >= 1 & `s08_n2' == 2)" "notes: twoway `s08_n1', dash `s08_n2'"
    _w30_expect SU-16 `"(abs(real(word(subinstr("`s08_h'", "|", " ", .), 1)) - 5.8667) < 0.001 & word(subinstr("`s08_h'", "|", " ", .), 1) == word(subinstr("`s08_h'", "|", " ", .), 2))"' "dash HUGE `s08_h'"
    _w30_expect SU-16 `"(`s08_n3' == 0 & `s08_n4' == 0 & "`s08_z'" == "0|0")"' "msize(-1): notes `s08_n3' / `s08_n4', size `s08_z'"
    _w30_done SU-16 "an unknown name draws medium with one note; a negative size draws nothing in silence"
    forvalues k = 1/4 {
        local s08_l : word `k' of a b c d
        capture erase "`w30_work'/su16`s08_l'.log"
    }

    // SU-17: the served app is unchanged by a filter move.
    _w30_expect SU-17 "(`s08_a10' == 1 & `s08_a11' == 1 & `s08_a13' == 1 & `s08_a15' == 1)" "same after the move: `s08_a10' `s08_a11' `s08_a13' `s08_a15'"
    _w30_done SU-17 "every size of the served app is unchanged by a filter move"

    capture dash clear
    graph drop _all
    set scheme `s08_scheme'
    macro drop S08_*
    display as text "S08 end " c(current_date) " " c(current_time)
}
* ==== end S08 ====

* ==== S09 P1.11a: TeX delimiters inert on every canvas sink ====
local only : env WP30_ONLY
if inlist("`only'", "", "S09") & `: list posof "S09" in w30_run' {
    display as text "S09 start " c(current_date) " " c(current_time)

    // TX-01 (guard, the truth): twoway draws each TeX pair as typed.
    sysuse auto, clear
    quietly twoway scatter mpg weight, title("\(y\)") subtitle("\[z\]") ///
        note("\$\$ x \$\$") xtitle("\(a\) w") xlabel(2000 "\(t\)" 3000) ///
        legend(on label(1 "\(k\)")) name(s09tx, replace)
    cert_svg_export, name(s09tx) file("`w30_work'/s09tx.svg")
    local s09_rc = r(rc)
    local s09_svg "`r(file)'"
    _w30_expect TX-01 "(`s09_rc' == 0)" "graph export rc `s09_rc'"
    foreach t in "\(y\)" "\[z\]" "\$\$ x \$\$" "\(a\) w" "\(t\)" "\(k\)" {
        cert_svg_has_text, file("`s09_svg'") text(`"`t'"')
        local s09_f = r(found)
        _w30_expect TX-01 "(`s09_f' == 1)" `"twoway did not draw `t' as typed"'
    }
    _w30_done TX-01 "twoway draws each TeX pair as typed"

    // TX-02: the same options in dash: the saved page ships no MathJax.
    quietly dash scatter mpg weight, title("\(y\)") subtitle("\[z\]") ///
        note("\$\$ x \$\$") xtitle("\(a\) w") xlabel(2000 "\(t\)" 3000) ///
        legend(on label(1 "\(k\)")) saving("`w30_work'/s09tx.html", replace)
    cert_file_has "`w30_work'/s09tx.html", needle("bokeh-mathjax")
    local s09_mj = r(found)
    _w30_expect TX-02 "(`s09_mj' == 0)" "the saved page ships bokeh-mathjax"
    _w30_done TX-02 "a saved page with TeX pairs ships no MathJax"

    // TX-03: the title is the typed text with its delimiters broken (the
    // page JSON writes U+2060 as \u2060 and a backslash as \\).
    cert_file_has "`w30_work'/s09tx.html", needle("\\\u2060(y\\\u2060)")
    local s09_in = r(found)
    cert_file_has "`w30_work'/s09tx.html", needle(`""text":"\\(y\\)""')
    local s09_raw = r(found)
    _w30_expect TX-03 "(`s09_in' == 1 & `s09_raw' == 0)" ///
        "title keeps a live pair (inert `s09_in', raw `s09_raw')"
    _w30_done TX-03 "the title is the typed text with its delimiters broken"

    // TX-04: the TeX page is the size of the same page in plain words.
    quietly dash scatter mpg weight, title("y") subtitle("z") note("x") ///
        xtitle("a w") xlabel(2000 "t" 3000) legend(on label(1 "k")) ///
        saving("`w30_work'/s09plain.html", replace)
    checksum "`w30_work'/s09tx.html"
    local s09_n1 = r(filelen)
    checksum "`w30_work'/s09plain.html"
    local s09_n0 = r(filelen)
    display as text "S09 sizes: TeX page `s09_n1' bytes, plain page `s09_n0' bytes"
    _w30_expect TX-04 "(abs(`s09_n1' - `s09_n0') < 2000)" ///
        "TeX page `s09_n1' bytes against plain `s09_n0'"
    _w30_done TX-04 "the TeX page is the plain page's size"

    // TX-05: labels reach the canvas as typed (variable labels as axis
    // titles, a value label as a by() panel title).  No $name form: twoway
    // macro-expands those inside labels (E6), which is not TeX.
    sysuse auto, clear
    label variable mpg "\$\$ m \$\$"
    label variable weight "\(w\) lbs"
    label define s09o 0 "\(d\)" 1 "Foreign", replace
    label values foreign s09o
    quietly twoway scatter mpg weight, by(foreign) name(s09lb, replace)
    cert_svg_export, name(s09lb) file("`w30_work'/s09lb.svg")
    local s09_svg "`r(file)'"
    foreach t in "\$\$ m \$\$" "\(w\) lbs" "\(d\)" {
        cert_svg_has_text, file("`s09_svg'") text(`"`t'"')
        local s09_f = r(found)
        _w30_expect TX-05 "(`s09_f' == 1)" `"twoway did not draw the label `t' as typed"'
    }
    quietly dash scatter mpg weight, by(foreign) saving("`w30_work'/s09lb.html", replace)
    cert_file_has "`w30_work'/s09lb.html", needle("bokeh-mathjax")
    local s09_mj = r(found)
    cert_file_has "`w30_work'/s09lb.html", needle("\\\u2060(d\\\u2060)")
    local s09_in = r(found)
    _w30_expect TX-05 "(`s09_mj' == 0 & `s09_in' == 1)" ///
        "labels: bokeh-mathjax `s09_mj', inert panel title `s09_in'"
    _w30_done TX-05 "labels are drawn as typed and ship no MathJax"

    foreach f in s09tx.svg s09tx.html s09plain.html s09lb.svg s09lb.html {
        capture erase "`w30_work'/`f'"
    }
    capture graph drop s09tx s09lb

    display as text "S09 end " c(current_date) " " c(current_time)
}
* ==== end S09 ====

// S10's helpers (WP-30 P1.19): Mata writes its tables and its resolver's
// answers to files under the work directory; Python compares them with
// dash_render's tables and _dash_subopt_resolve.  Tokens never pass
// through a macro.
mata:
void _s10_dump(string scalar fam, string scalar path)
{
    string matrix t
    string scalar line
    real scalar   fh, i, j

    t = _dash_so_rows(fam)
    if (fileexists(path)) unlink(path)
    fh = fopen(path, "w")
    for (i = 1; i <= rows(t); i++) {
        line = t[i, 1]
        for (j = 2; j <= 6; j++) line = line + char(9) + t[i, j]
        fput(fh, line)
    }
    fclose(fh)
}

// Input lines: "C<tab>fam" starts a case, "T<tab>cid<tab>token" adds a
// token, "E" ends it.  Output, one line per case:
// rc<tab>at<tab>msg<tab>name<US>name...
void _s10_resolve(string scalar inp, string scalar outp)
{
    string rowvector toks, names
    string scalar    line, fam, msg, rest, out
    real rowvector   cid
    real scalar      fi, fo, rc, at, p, i

    if (fileexists(outp)) unlink(outp)
    fi = fopen(inp, "r")
    fo = fopen(outp, "w")
    while ((line = fget(fi)) != J(0, 0, "")) {
        if (substr(line, 1, 2) == "C" + char(9)) {
            fam  = substr(line, 3, .)
            toks = J(1, 0, "")
            cid  = J(1, 0, .)
        }
        else if (substr(line, 1, 2) == "T" + char(9)) {
            rest = substr(line, 3, .)
            p    = strpos(rest, char(9))
            cid  = cid, strtoreal(substr(rest, 1, p - 1))
            toks = toks, substr(rest, p + 1, .)
        }
        else if (line == "E") {
            rc  = _dash_so_resolve(toks, cid, fam, names, msg, at)
            out = strofreal(rc) + char(9) + strofreal(at) + char(9) + msg + char(9)
            for (i = 1; i <= cols(names); i++) {
                out = out + (i > 1 ? char(31) : "") + names[i]
            }
            fput(fo, out)
        }
    }
    fclose(fi)
    fclose(fo)
}
end

// SA-13's loop, a program so each line is expanded as it runs.
capture program drop _s10_sa13
program define _s10_sa13
    version 19
    args work
    preserve
    sysuse auto, clear
    python: __import__("__main__")._s10_sa13_list()
    local n = ${S10_N}
    forvalues k = 1/`n' {
        quietly log using "`work'/s10_tw.log", text replace name(_s10l)
        capture noisily ${S10_CMD_`k'} name(s10g, replace) nodraw
        global S10_TRC = _rc
        quietly log close _s10l
        capture graph drop s10g
        quietly dash clear
        quietly log using "`work'/s10_da.log", text replace name(_s10l)
        capture noisily ${S10_DCMD_`k'} name(s10d)
        global S10_DRC = _rc
        quietly log close _s10l
        quietly dash clear
        global S10_WORKDIR "`work'"
        python: __import__("__main__")._s10_sa13_one(`k')
    }
    restore
end

python:
def _s10_tabs():
    import os, sys
    repo = os.path.abspath("..")
    if repo not in sys.path:
        sys.path.insert(0, repo)
    import dash_render as dr
    return dr, {
        "legend": dr._DASH_LEGEND_SUBOPT_TABLE,
        "axlabel": dr._DASH_AXLABEL_SUBOPT_TABLE,
        "axscale": dr._DASH_AXSCALE_SUBOPT_TABLE,
        "refline": dr._DASH_REFLINE_SUBOPT_TABLE,
        "title": dr._DASH_TITLE_SUBOPT_TABLE,
        "axtitle": dr._DASH_AXTITLE_SUBOPT_TABLE,
        "textbox": tuple((f, m, 1, "a", True, "")
                         for f, m in dr._TEXTBOX_SUBOPTS)}


def _s10_tables():
    import os
    from sfi import Macro
    dr, tabs = _s10_tabs()
    work = Macro.getGlobal("S10_WORK")
    diff, first = 0, ""
    for fam, t in tabs.items():
        want = ["\t".join((r[0], r[1], str(r[2]), r[3], "1" if r[4] else "0",
                           r[5])) for r in t]
        with open(os.path.join(work, "s10_rows_%s.txt" % fam),
                  encoding="utf-8") as fh:
            got = fh.read().splitlines()
        if got != want:
            diff += 1
            first = first or fam
    Macro.setGlobal("S10_TDIFF", str(diff))
    Macro.setGlobal("S10_TFIRST", first)


def _s10_lists():
    import random
    dr, tabs = _s10_tabs()
    rng = random.Random(30019)
    out = []
    fixed = {
        "legend": ["po(9)", "rin(0) pos(5)", "OFF", "c(2) cols(1)",
                   "size(large) s(small)", "on on", "on(1)", "cols",
                   "c(1) c(red)", "c(1) c(2) c(3)", 't("TT")',
                   "rows(1) r(2)", "xoffset(x)", "xoffset(1.5e3)",
                   'lab(1 "A") label(2 "B")', "garbage", "on off"],
        "axlabel": ["lab(large)", "labs", "labs labs(large)",
                    "labs(large) labs", "nog(1)", "angle(45) ang(0)",
                    "labs(large) bogus", "nogr nogrid", "labelminlen(x)",
                    "labelminlen(-3)", "labs(large) LABSIZE(small)",
                    "grid nogrid", "val novaluelabel", "a(45)"],
        "refline": ["lc(red) lp(dash) lw(thick)", "LCOLOR(red)", "l(red)",
                    "st(x) la(y)"],
        "title": ["SIZE(small)", "ls(x)", "size(small) s(large)", "s(small)",
                  "nob", "b a(top)"],
        "axtitle": ["prefix suffix", "ax(2) s(small)", "ls(x)"],
    }
    for fam, lists in fixed.items():
        for text in lists:
            out.append((fam, [dr._dash_by_tokens(text)]))
    bogus = ["zz", "garbage", "x", "no", "a", "c", "t", "l"]
    for k in range(500):
        fam = rng.choice(list(tabs))
        t = tabs[fam]
        copies = []
        for c in range(rng.randint(1, 3)):
            toks = []
            for _ in range(rng.randint(0, 6)):
                row = rng.choice(t)
                pick = rng.random()
                if pick < 0.4:
                    nm = row[1]
                elif pick < 0.7:
                    nm = row[0]
                elif pick < 0.8:
                    nm = row[1].upper()
                else:
                    nm = rng.choice(bogus)
                arg = rng.choice(["", "(1)", "(x)", "(1.5)", "()", "(-2)"])
                toks.append(nm + arg)
            copies.append(toks)
        out.append((fam, copies))
    return dr, tabs, out


def _s10_cases():
    import os
    from sfi import Macro
    dr, tabs, cases = _s10_lists()
    work = Macro.getGlobal("S10_WORK")
    with open(os.path.join(work, "s10_cases.txt"), "w",
              encoding="utf-8") as fh:
        for fam, copies in cases:
            fh.write("C\t%s\n" % fam)
            for c, toks in enumerate(copies, 1):
                for tok in toks:
                    fh.write("T\t%d\t%s\n" % (c, tok))
            fh.write("E\n")


def _s10_compare():
    import os
    from sfi import Macro
    dr, tabs, cases = _s10_lists()
    work = Macro.getGlobal("S10_WORK")
    with open(os.path.join(work, "s10_mata.txt"), encoding="utf-8") as fh:
        got = fh.read().split("\n")
    diff, first = 0, ""
    for k, (fam, copies) in enumerate(cases):
        names, prob = dr._dash_subopt_resolve(copies, tabs[fam])
        flat = [n or "" for c in names for n in c]
        if prob is None:
            want_rc, want_at, want_msg = 0, 0, ""
        else:
            idx = sum(len(c) for c in copies[:prob[0]]) + prob[1] + 1
            want_rc, want_at, want_msg = 198, idx, prob[3]
        want = "%d\t%d\t%s\t%s" % (want_rc, want_at, want_msg,
                                   "\x1f".join(flat))
        line = got[k] if k < len(got) else "<missing>"
        # On a problem, Mata stops naming at the problem's stage, as
        # Python does; the names are compared whole either way.
        if line != want:
            diff += 1
            first = first or ("%s %r: mata %r python %r"
                              % (fam, copies, line, want))[:200]
    Macro.setGlobal("S10_RDIFF", str(diff))
    Macro.setGlobal("S10_RFIRST", first.replace('"', "'").replace(chr(96), "'").replace("$", "S"))
    Macro.setGlobal("S10_NCASE", str(len(cases)))


_S10_KEEP = None


def _s10_keep():
    import re
    return re.compile(r"^(option |options |\(note:)|\(\) invalid --| not an integer"
                      r"| invalid name|does not exist")


def _s10_first(path):
    keep = _s10_keep()
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in fh.read().splitlines():
            t = line.strip()
            if t and not t.startswith((".", ">")) and keep.search(t):
                return t
    return ""


def _s10_sa13_list():
    import json
    from sfi import Macro
    with open("fixtures/subopt_abbrev_truth.json", encoding="utf-8") as fh:
        probes = json.load(fh)["probes"]
    ids = sorted(k for k, v in probes.items()
                 if v["rc"] != 0 and not k.startswith("x_")
                 and k != "o_z_line")
    global _S10_PROBES
    _S10_PROBES = [(k, probes[k]) for k in ids]
    for i, (k, v) in enumerate(_S10_PROBES, 1):
        Macro.setGlobal("S10_CMD_%d" % i, v["cmd"])
        Macro.setGlobal("S10_DCMD_%d" % i, "dash " + v["cmd"][len("twoway "):])
    Macro.setGlobal("S10_N", str(len(_S10_PROBES)))
    Macro.setGlobal("S10_BAD", "")
    Macro.setGlobal("S10_NBAD", "0")


def _s10_sa13_one(k):
    import os
    from sfi import Macro
    pid, v = _S10_PROBES[k - 1]
    work = Macro.getGlobal("S10_WORKDIR")
    want = (v["rc"], v["messages"][0] if v["messages"] else "")
    tw = (int(Macro.getGlobal("S10_TRC")),
          _s10_first(os.path.join(work, "s10_tw.log")))
    da = (int(Macro.getGlobal("S10_DRC")),
          _s10_first(os.path.join(work, "s10_da.log")))
    if tw != want or da != want:
        Macro.setGlobal("S10_BAD", (Macro.getGlobal("S10_BAD") + " " + pid).strip())
        Macro.setGlobal("S10_NBAD", str(int(Macro.getGlobal("S10_NBAD")) + 1))
        print("SA-13 differs: %s want %r twoway %r dash %r" % (pid, want, tw, da))


def _s10_sa14():
    import re
    from sfi import Macro

    def page(g):
        try:
            with open(Macro.getGlobal(g), encoding="utf-8", errors="replace") as fh:
                return fh.read()
        except OSError:
            return ""
    p1, p2, p3, p4 = (page(g) for g in ("S10_P1", "S10_P2", "S10_P3", "S10_P4"))
    cols = re.findall(r'"ncols"\s*:\s*("?[A-Za-z0-9]+"?)', p1)
    Macro.setGlobal("S10_NCOLS", "1" if cols and set(cols) == {"1"} else "0")
    Macro.setGlobal("S10_NCOLS_SEEN", " ".join(cols)[:80])
    f2 = sorted(set(re.findall(r'"major_label_text_font_size"\s*:\s*"([^"]+)"', p2)))
    f3 = sorted(set(re.findall(r'"major_label_text_font_size"\s*:\s*"([^"]+)"', p3)))
    Macro.setGlobal("S10_LABS", "1" if f2 and f2 == f3 else "0")
    Macro.setGlobal("S10_LABS_SEEN", (" ".join(f2) + " / " + " ".join(f3))[:80])
    spans = re.findall(r'"type"\s*:\s*"object"\s*,\s*"name"\s*:\s*"Span".{0,400}?"line_color"\s*:\s*"([^"]+)"', p4, re.S)
    Macro.setGlobal("S10_SPAN", "1" if any(c.lower() in ("red", "#ff0000") for c in spans) else "0")
end

* ==== S10 P1.19: Sub-option abbreviations ====
local only : env WP30_ONLY
if inlist("`only'", "", "S10") & `: list posof "S10" in w30_run' {
    display as text "S10 start " c(current_date) " " c(current_time)

    // SA-11: every Mata table equals dash_render's, row for row.
    foreach fam in legend axlabel axscale refline title axtitle textbox {
        mata: _s10_dump("`fam'", st_local("w30_work") + "/s10_rows_`fam'.txt")
    }
    global S10_WORK "`w30_work'"
    python: _s10_tables()
    local s10ok = ("${S10_TDIFF}" == "0")
    _w30_expect SA-11 `s10ok' "Mata and Python tables differ: ${S10_TFIRST}"
    _w30_done SA-11 "the seven Mata sub-option tables equal dash_render's"

    // SA-12: both resolvers give the same names and problem on the probe
    // lists and 500 random ones (seed 30019).
    python: _s10_cases()
    mata: _s10_resolve(st_local("w30_work") + "/s10_cases.txt", st_local("w30_work") + "/s10_mata.txt")
    python: _s10_compare()
    local s10ok = ("${S10_RDIFF}" == "0" & ${S10_NCASE} >= 500)
    _w30_expect SA-12 `s10ok' `"${S10_RDIFF} of ${S10_NCASE} resolutions differ: ${S10_RFIRST}"'
    _w30_done SA-12 "_dash_so_resolve and _dash_subopt_resolve agree on ${S10_NCASE} token lists"

    // SA-13: every refusal probe of subopt_abbrev_truth.json: twoway still
    // gives the fixture's rc and first line, and dash gives the same.  The
    // xline() refusals are S39's and are left out.
    _s10_sa13 "`w30_work'"
    local s10ok = ("${S10_BAD}" == "")
    _w30_expect SA-13 `s10ok' `"${S10_NBAD} of ${S10_N} probes differ: ${S10_BAD}"'
    _w30_done SA-13 "twoway and dash give the fixture's rc and first line on ${S10_N} refusal probes"

    // SA-14: three saved pages built by dash.
    preserve
    sysuse auto, clear
    local s10p1 "`w30_work'/s10_c1.html"
    local s10p2 "`w30_work'/s10_labs.html"
    local s10p3 "`w30_work'/s10_labsize.html"
    local s10p4 "`w30_work'/s10_xline.html"
    quietly dash clear
    capture noisily dash (scatter mpg weight) (lfit mpg weight), legend(c(1)) saving("`s10p1'")
    local s10r1 = _rc
    quietly dash clear
    capture noisily dash scatter mpg weight, ylabel(, labs(large)) saving("`s10p2'")
    local s10r2 = _rc
    quietly dash clear
    capture noisily dash scatter mpg weight, ylabel(, labsize(large)) saving("`s10p3'")
    local s10r3 = _rc
    quietly dash clear
    capture noisily dash scatter mpg weight, xline(3000, lc(red)) saving("`s10p4'")
    local s10r4 = _rc
    quietly dash clear
    restore
    global S10_P1 "`s10p1'"
    global S10_P2 "`s10p2'"
    global S10_P3 "`s10p3'"
    global S10_P4 "`s10p4'"
    python: _s10_sa14()
    local s10ok = (`s10r1' == 0 & `s10r2' == 0 & `s10r3' == 0 & `s10r4' == 0)
    _w30_expect SA-14 `s10ok' "a dash build failed: `s10r1' `s10r2' `s10r3' `s10r4'"
    _w30_expect SA-14 ${S10_NCOLS} "legend(c(1)) is not one column in the page: ${S10_NCOLS_SEEN}"
    _w30_expect SA-14 ${S10_LABS} "ylabel(, labs(large)) does not size as labsize(large): ${S10_LABS_SEEN}"
    _w30_expect SA-14 ${S10_SPAN} "xline(3000, lc(red)) is not a red Span in the page"
    _w30_done SA-14 "legend(c(1)), ylabel(, labs(large)) and xline(, lc(red)) draw as their full names on a saved page"

    foreach f in s10_tw.log s10_da.log s10_c1.html s10_labs.html s10_labsize.html s10_xline.html {
        capture erase "`w30_work'/`f'"
    }
    foreach f in s10_cases.txt s10_mata.txt s10_rows_legend.txt s10_rows_axlabel.txt s10_rows_axscale.txt s10_rows_refline.txt s10_rows_title.txt s10_rows_axtitle.txt s10_rows_textbox.txt {
        capture erase "`w30_work'/`f'"
    }
    display as text "S10 end " c(current_date) " " c(current_time)
}
* ==== end S10 ====

// S11 (WP-30 P1.1a) helpers.  Each sets a global to the per-series list
// "colour/kind" of one drawing, figures joined by " ; ":
//   _s11_svg()   S11_TW  from the live twoway SVG S11_SVG: marker fills
//                in document order (74 auto rows a series), or line
//                strokes (kind solid/dashed: more <line> than <path>)
//   _s11_page()  S11_PG  from the saved page S11_PAGE's Bokeh document
//   _s11_app()   S11_AP  from the served app S11_APP, executed unserved
// S11_LINES is 1 for a line case.
python:
import json as _s11_json, re as _s11_re, html as _s11_html, os as _s11_os, sys as _s11_sys
import warnings as _s11_w
from sfi import Macro as _s11_M

_S11_CHROME = ("#000000", "#ffffff", "#eaf2f3")
_S11_KIND = {"circle": "circle", "polygon": "triangle"}


def _s11_lines():
    return _s11_M.getGlobal("S11_LINES") == "1"


def _s11_svg():
    _s11_sys.path.insert(0, _s11_os.path.join(_s11_M.getGlobal("S11_REPO"), "scripts"))
    import svg_truth
    with open(_s11_M.getGlobal("S11_SVG"), encoding="utf-8", errors="replace") as fh:
        txt = fh.read()
    marks, strokes = [], []
    for m in _s11_re.finditer(r"<(circle|path|polygon|line)\b([^>]*)>", txt):
        kind = m.group(1)
        a = svg_truth._attrs(m.group(2))
        st = svg_truth._style_of(a)
        fill = (st.get("fill", a.get("fill")) or "").lower()
        stroke = (st.get("stroke", a.get("stroke")) or "").lower()
        if kind != "line" and fill and fill != "none":
            if marks and marks[-1][0] == fill and marks[-1][2] == kind:
                marks[-1][1] += 1
            else:
                marks.append([fill, 1, kind])
        elif kind in ("line", "path") and stroke and stroke != "none":
            nl, npth = (1, 0) if kind == "line" else (0, 1)
            if strokes and strokes[-1][0] == stroke:
                strokes[-1][1] += nl
                strokes[-1][2] += npth
            else:
                strokes.append([stroke, nl, npth])
    out = []
    if _s11_lines():
        out = ["%s/%s" % (c, "dashed" if nl > npth else "solid")
               for c, nl, npth in strokes if npth >= 1 and c not in _S11_CHROME]
    else:
        per = int(_s11_M.getGlobal("S11_PER") or "74")
        for c, n, k in marks:
            if n < 2 and per > 1:
                continue
            out.extend(["%s/%s" % (c, _S11_KIND.get(k, k))] * max(1, n // per))
    _s11_M.setGlobal("S11_TW", " ".join(out[:int(_s11_M.getGlobal("S11_N"))]))


def _s11_fmt(items):
    out = []
    for name, get in items:
        if name == "Scatter" and not _s11_lines():
            out.append("%s/%s" % (str(get("fill_color")).lower(), get("marker") or "circle"))
        elif name == "Line" and _s11_lines():
            out.append("%s/%s" % (str(get("line_color")).lower(), "dashed" if get("line_dash") else "solid"))
    return " ".join(out)


def _s11_val(v):
    if isinstance(v, dict) and v.get("type") == "value":
        return v.get("value")
    return v


def _s11_page():
    with open(_s11_M.getGlobal("S11_PAGE"), encoding="utf-8") as fh:
        page = fh.read()
    objs, stack = {}, []
    for blob in _s11_re.findall('<script type="application/json"[^>]*>(.*?)</script>', page, _s11_re.S):
        try:
            stack.append(_s11_json.loads(_s11_html.unescape(blob)))
        except ValueError:
            pass
    while stack:
        v = stack.pop()
        if isinstance(v, dict):
            if v.get("type") == "object" and "id" in v and "name" in v:
                if "attributes" in v or v["id"] not in objs:
                    objs[v["id"]] = v
            stack.extend(v.values())
        elif isinstance(v, list):
            stack.extend(v)

    def ref(v):
        return objs.get(v.get("id")) if isinstance(v, dict) else None
    figs = []
    for o in objs.values():
        rs = (o.get("attributes") or {}).get("renderers")
        if o["name"] != "Figure" or not isinstance(rs, list):
            continue
        items = []
        for r in rs:
            r = ref(r)
            if not r or r["name"] != "GlyphRenderer":
                continue
            g = ref((r.get("attributes") or {}).get("glyph"))
            if not g:
                continue
            at = g.get("attributes") or {}
            items.append((g["name"], lambda k, at=at: _s11_val(at.get(k))))
        s = _s11_fmt(items)
        if s:
            figs.append(s)
    _s11_M.setGlobal("S11_PG", " ; ".join(sorted(figs)))


def _s11_app():
    from bokeh.document import Document
    from bokeh.models import GlyphRenderer, Plot
    with open(_s11_M.getGlobal("S11_APP"), encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_s11_app")
    with _s11_w.catch_warnings():
        _s11_w.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_s11_app.py", "exec"), ns)
    doc = Document()
    ns["make_document"](doc)
    figs = []
    for root in doc.roots:
        for p in root.references():
            if not isinstance(p, Plot):
                continue
            items = [(type(r.glyph).__name__, lambda k, g=r.glyph: getattr(g, k, None))
                     for r in p.renderers if isinstance(r, GlyphRenderer)]
            s = _s11_fmt(items)
            if s:
                figs.append(s)
    _s11_M.setGlobal("S11_AP", " ; ".join(sorted(figs)))
end

// _s11_case id data n lines cmd: twoway <cmd> against dash's saved page
// and served app.  Sets $S11_OK (1 when both modes draw twoway's list),
// $S11_WHY and $S11_NOTE (1 when a dash build printed "not a recognised").
capture program drop _s11_case
program define _s11_case
    version 19
    args id data n lines work cmd
    if "`data'" == "sp500" {
        quietly sysuse sp500, clear
        quietly tsset date
    }
    else quietly sysuse auto, clear
    global S11_N "`n'"
    global S11_LINES "`lines'"
    global S11_PER = cond("`id'" == "T32", "1", "74")
    local svg "`work'/s11_`id'.svg"
    local page "`work'/s11_`id'.html"
    local app "`work'/s11_`id'.py"
    local sep = cond(strpos(`"`macval(cmd)'"', ","), " ", ", ")
    capture graph drop g
    capture noisily twoway `macval(cmd)'`sep'name(g, replace)
    local trc = _rc
    if !`trc' quietly graph export "`svg'", replace name(g)
    capture dash clear
    capture log close s11n
    quietly log using "`work'/s11_`id'.log", text replace name(s11n)
    capture noisily dash `macval(cmd)'`sep'saving("`page'", replace)
    local drc = _rc
    capture dash clear
    capture noisily dash `macval(cmd)'`sep'name(g1)
    local drc = `drc' + _rc
    capture noisily dash build, server saving("`app'") replace nobrowser
    local drc = `drc' + _rc
    quietly log close s11n
    global S11_TW ""
    global S11_PG ""
    global S11_AP ""
    global S11_SVG "`svg'"
    global S11_PAGE "`page'"
    global S11_APP "`app'"
    if !`trc' capture noisily python: __import__("__main__")._s11_svg()
    if !`drc' capture noisily python: __import__("__main__")._s11_page()
    if !`drc' capture noisily python: __import__("__main__")._s11_app()
    cert_log_has "`work'/s11_`id'.log", needle("not a recognised")
    global S11_NOTE = (r(count) > 0)
    global S11_OK = (`trc' == 0 & `drc' == 0 & `"${S11_TW}"' != "" & `"${S11_PG}"' == `"${S11_TW}"' & `"${S11_AP}"' == `"${S11_TW}"')
    global S11_WHY `"`id': twoway rc `trc' [${S11_TW}]; dash rc `drc' saved [${S11_PG}] served [${S11_AP}]"'
    capture dash clear
    capture erase "`svg'"
    capture erase "`page'"
    capture erase "`app'"
    capture erase "`work'/s11_`id'.log"
    capture graph drop g
end

// _s11_refuse id cmd: twoway's and dash's rc and first error line.
capture program drop _s11_refuse
program define _s11_refuse
    version 19
    args id work cmd
    quietly sysuse auto, clear
    foreach who in twoway dash {
        capture log close s11r
        quietly log using "`work'/s11r_`who'.log", text replace name(s11r)
        capture noisily `who' `macval(cmd)'
        global S11_RC_`who' = _rc
        quietly log close s11r
        mata: st_global("S11_ERR_`who'", _s11_err(st_local("work") + "/s11r_`who'.log"))
        capture erase "`work'/s11r_`who'.log"
    }
    capture dash clear
end
mata:
string scalar _s11_err(string scalar path)
{
    real scalar   fh
    string scalar ln
    fh = fopen(path, "r")
    while ((ln = fget(fh)) != J(0, 0, "")) {
        ln = strtrim(ln)
        if (ln == "" | substr(ln, 1, 6) == "(note:" | substr(ln, 1, 5) == "name:" | substr(ln, 1, 4) == "log:" | substr(ln, 1, 9) == "log type:" | substr(ln, 1, 10) == "opened on:" | substr(ln, 1, 10) == "closed on:" | substr(ln, 1, 3) == "---") continue
        fclose(fh)
        return(ln)
    }
    fclose(fh)
    return("")
}
end

* ==== S11 P1.1a: Stylelists of style options across an expanded varlist ====
local only : env WP30_ONLY
if inlist("`only'", "", "S11") & `: list posof "S11" in w30_run' {
    display as text "S11 start " c(current_date) " " c(current_time)
    local s11_scheme "`c(scheme)'"
    set scheme s2color
    local s11_repo : environment DASH_REPO
    if `"`s11_repo'"' == "" local s11_repo ".."
    global S11_REPO `"`s11_repo'"'
    local two "scatter mpg turn weight"
    local three "scatter mpg turn trunk weight"
    local s11_anynote 0

    // SL-30..SL-35: id data n lines command, both modes against twoway.
    local c30_1 `"T01 auto 2 0 `two', mcolor(red blue) msymbol(O T)"'
    local c31_1 `"T02 auto 2 0 `two', mcolor(red)"'
    local c31_2 `"T03 auto 3 0 `three', mcolor(red blue)"'
    local c31_3 `"T04 auto 2 0 `two', mcolor(red blue green)"'
    local c32_1 `"T05 auto 2 0 `two', mcolor(. blue)"'
    local c32_2 `"T06 auto 3 0 `three', mcolor(red = blue)"'
    local c32_3 `"T07 auto 3 0 `three', mcolor(red ..)"'
    local c32_4 `"T08 auto 3 0 `three', mcolor(red ...)"'
    local c32_5 `"T12 auto 2 0 `two', mcolor(= blue)"'
    local c32_6 `"T13 auto 3 0 `three', mcolor(red..)"'
    local c32_7 `"T15 auto 3 0 `three', mcolor(. ..)"'
    local c32_8 `"T16 auto 3 0 `three', mcolor(red . =)"'
    local c32_9 `"T17 auto 3 0 `three', mcolor(red = = blue)"'
    local c32_10 `"T18 auto 3 0 `three', mcolor(..)"'
    local c33_1 `"T11 auto 2 0 `two', mcolor("255 0 0" "0 0 255")"'
    local c33_2 `"T20 auto 2 0 `two', mcolor(`"red"' blue)"'
    local c33_3 `"T21 auto 2 0 `two', mcolor("" blue)"'
    local c33_4 `"T22 auto 2 0 `two', mcolor(red `""')"'
    local c34_1 `"T10 auto 2 1 line mpg turn weight, sort lpattern(solid dash) lcolor(red blue)"'
    local c34_2 `"W30 auto 2 1 connected mpg turn weight, sort lcolor(red) clcolor(. blue)"'
    local c34_3 `"W36 auto 3 1 line mpg turn trunk weight, sort lcolor(red) lpattern(. dash)"'
    local c34_4 `"U40 sp500 2 1 tsline open close, lcolor(red blue) lpattern(solid dash)"'
    local c35_1 `"T09 auto 1 0 scatter mpg weight, mcolor(red blue)"'
    local c35_2 `"T19 auto 1 0 scatter mpg weight, msymbol(T O)"'
    local c35_3 `"T26 auto 1 1 lfit mpg weight, lcolor(red blue)"'
    local c35_4 `"T32 auto 1 0 scatteri 20 3000 25 4000, mcolor(red blue)"'
    local c35_5 `"T33 auto 1 1 function y=x, range(0 1) lcolor(red blue)"'
    local s11_what30 "T01: each y's colour and marker equal twoway's in both modes"
    local s11_what31 "T02-T04: padding with . and extras ignored, as twoway draws them"
    local s11_what32 "the . = .. ... shorthands draw twoway's colours in both modes"
    local s11_what33 "quoted, compound-quoted and empty elements draw twoway's colours"
    local s11_what34 "line colours and dashes per series equal twoway's (line, connected, tsline)"
    local s11_what35 "a single-y type draws twoway's first element"
    forvalues k = 30/35 {
        local j 1
        while `"`macval(c`k'_`j')'"' != "" {
            gettoken id rest : c`k'_`j'
            gettoken data rest : rest
            gettoken n rest : rest
            gettoken lines rest : rest
            local rest = strtrim(`"`macval(rest)'"')
            _s11_case `id' `data' `n' `lines' "`w30_work'" `"`macval(rest)'"'
            _w30_expect SL-`k' "${S11_OK}" `"${S11_WHY}"'
            if ${S11_NOTE} local s11_anynote 1
            local ++j
        }
        _w30_done SL-`k' "`s11_what`k''"
    }

    // SL-36: by() panels, each drawn red then blue in both modes.
    _s11_case BY auto 2 0 "`w30_work'" `"`two', mcolor(red blue) by(foreign)"'
    local s11_want "#ff0000/circle #0000ff/circle ; #ff0000/circle #0000ff/circle"
    _w30_expect SL-36 `"("${S11_PG}" == "`s11_want'" & "${S11_AP}" == "`s11_want'")"' `"${S11_WHY}"'
    _w30_expect SL-36 `"(strpos("${S11_TW}", "#ff0000/circle #0000ff/circle") == 1)"' `"${S11_WHY}"'
    if ${S11_NOTE} local s11_anynote 1
    _w30_done SL-36 "every by() panel draws each series' element, saved and served"

    // SL-37: none of the builds above printed a not-recognised note.
    _w30_expect SL-37 "(`s11_anynote' == 0)" "a build printed a not a recognised note"
    _w30_done SL-37 "no build of SL-30..SL-36 printed a not-recognised note"

    // SL-38: the refusals' rc and first error line equal twoway's.
    local r_1 `"`two', mcolor(red .. blue)"'
    local r_2 `"`two', mc(red .. blue)"'
    local r_3 `"scatter mpg weight, mcolor(red .. blue)"'
    local r_4 `"`two', msymbol(O .. T)"'
    local r_5 `"`two', mcolor(red .. ..)"'
    local r_6 `"`two', mcolor(red.. ..)"'
    local r_7 `"`two', mcolor(.. red)"'
    local r_8 `"`two', mcolor("red" .. "blue")"'
    local r_9 `"`two', mcolor(red ..) mcolor(blue .. green)"'
    forvalues i = 1/9 {
        _s11_refuse R0`i' "`w30_work'" `"`macval(r_`i')' nodraw"'
        _w30_expect SL-38 `"(${S11_RC_twoway} == 198 & ${S11_RC_dash} == 198)"' `"R0`i': rc twoway ${S11_RC_twoway}, dash ${S11_RC_dash}"'
        mata: st_local("s11_same", strofreal(st_global("S11_ERR_twoway") == st_global("S11_ERR_dash")))
        _w30_expect SL-38 "`s11_same'" `"R0`i': twoway [${S11_ERR_twoway}] dash [${S11_ERR_dash}]"'
    }
    _s11_refuse R16 "`w30_work'" `"`two', mcolor(  red   ..   blue  ) nodraw"'
    mata: st_local("s11_same", strofreal(substr(st_global("S11_ERR_twoway"), strpos(st_global("S11_ERR_twoway"), "):"), .) == substr(st_global("S11_ERR_dash"), strpos(st_global("S11_ERR_dash"), "):"), .)))
    _w30_expect SL-38 `"(${S11_RC_twoway} == 198 & ${S11_RC_dash} == 198 & `s11_same')"' `"R16: twoway ${S11_RC_twoway} [${S11_ERR_twoway}] dash ${S11_RC_dash} [${S11_ERR_dash}]"'
    _w30_done SL-38 "a misplaced .. is refused with twoway's rc and words"

    set scheme `s11_scheme'
    capture graph drop g
    display as text "S11 end " c(current_date) " " c(current_time)
}
* ==== end S11 ====

// S12 helpers (WP-30 P1.27).  _s12_load: twoway's measured answers,
// read from test/fixtures/twoway_command_form_truth.json (and S04's
// saving_chars_truth.json) into the caller's locals through sfi; nothing
// is inlined into Python source.  _s12_said: the error dash's grammar
// prints for a saving() text, by value.
capture program drop _s12_said
program define _s12_said
    version 19
    args text
    mata: st_local("_e", _dash_saving_split(st_local("text"))[5])
    c_local s12_said `"`macval(_e)'"'
end
python:
def _s12_load():
    import json, os
    from sfi import Macro
    def put(k, v):
        Macro.setLocal(k, str(v).replace("\\x60", "\x60"))
    with open(os.path.join("fixtures", "twoway_command_form_truth.json"),
              encoding="utf-8") as fh:
        d = json.load(fh)
    m = d["_meta"]
    put("s12_meta_ok", int(all(k in m for k in ("stata_version", "born_date",
                                                  "dash_commit", "extracted"))))
    put("s12_mode", m.get("mode", ""))
    put("s12_np", len(d["prefix"]))
    for i, r in enumerate(d["prefix"], 1):
        put("s12_ph%d" % i, r["head"])
        put("s12_prc%d" % i, r["rc"])
        put("s12_plast%d" % i, r["last"])
    put("s12_ns", len(d["saving"]))
    for i, r in enumerate(d["saving"], 1):
        put("s12_st%d" % i, r["text"])
        put("s12_src%d" % i, r["rc"])
        put("s12_slast%d" % i, r["last"])
        fl = [f[:-4] + ".html" if f.lower().endswith(".gph") else f
              for f in r["files"]]
        put("s12_snf%d" % i, len(fl))
        for k, f in enumerate(fl, 1):
            put("s12_sf%d_%d" % (i, k), f)
    with open(os.path.join("fixtures", "saving_chars_truth.json"),
              encoding="utf-8") as fh:
        c = json.load(fh)["probes"]
    keys = [k for k in ("semi", "amp", "pipe", "lt", "gt", "dotdot")
            if k in c and c[k]["rc"] == 0 and c[k]["written"]]
    put("s12_nc", len(keys))
    for i, k in enumerate(keys, 1):
        f = c[k]["file"]
        put("s12_cf%d" % i, f[:-4] + ".html" if f.endswith(".gph") else f)

_s12_ready = True
end

* ==== S12 P1.27: Drop-in command form and saving() grammar ====
local only : env WP30_ONLY
if inlist("`only'", "", "S12") & `: list posof "S12" in w30_run' {
    display as text "S12 start " c(current_date) " " c(current_time)
    // twoway's answers come from the fixture (scripts/
    // extract_twoway_command_form_truth.do), measured in batch.
    python: import __main__; __main__._s12_load()
    qui sysuse auto, clear
    quietly dash clear

    // CF-08 (guard) -- the fixture is stamped and was measured in batch.
    _w30_expect "CF-08" `s12_meta_ok' "the fixture's _meta lacks a stamp key"
    local _ok = ("`s12_mode'" == "batch")
    _w30_expect "CF-08" `_ok' "the fixture was not measured in batch"
    _w30_done "CF-08" "the fixture's _meta is whole and was measured in batch"

    // CF-01 -- every head twoway takes (rc 0) draws the unprefixed graph.
    // "Graph twoway" is skipped: rc 0 only because macOS's file system
    // finds graph.ado under Graph; dash refuses a capitalised prefix r(199),
    // as Stata does on a case-sensitive file system.
    quietly dash scatter mpg weight, name(cf0)
    local cfn = 0
    forvalues i = 1/`s12_np' {
        local h `"`s12_ph`i''"'
        if `"`h'"' == "" | `"`h'"' == "Graph twoway" | `s12_prc`i'' != 0 continue
        local ++cfn
        capture noisily dash `h' scatter mpg weight, name(cf`cfn')
        _w30_expect "CF-01" `=_rc == 0' `"dash `h' scatter mpg weight: rc `=_rc'"'
        mata: st_local("_cfa", subinstr(st_global("dash_json_cf0"), char(34) + "cf0" + char(34), char(34) + "cf`cfn'" + char(34)))
        mata: st_local("_cfe", strofreal(st_local("_cfa") == st_global("dash_json_cf`cfn'")))
        _w30_expect "CF-01" `_cfe' `"dash `h' draws another graph than the unprefixed command"'
    }
    _w30_expect "CF-01" `=`cfn' >= 10' "fewer than ten prefix heads in the fixture"
    local 0 "tw scatter mpg weight"
    mata: _dash_strip_prefix()
    local _ok = ("`_pf_kind'" == "strip")
    _w30_expect "CF-01" `_ok' "_dash_strip_prefix did not strip tw"
    quietly dash twoway (scatter mpg weight) (lfit mpg weight), name(cfpa)
    quietly dash twoway(scatter mpg weight), name(cfpc)
    quietly dash gr tw scatter mpg weight || lfit mpg weight, name(cfpd)
    _w30_done "CF-01" "every prefix twoway takes is read off once and draws the unprefixed graph"

    // CF-02 -- every head twoway refuses r(199): dash r(199), in Stata's
    // words (for TWOWAY, Twoway and GR, the words of a case-sensitive file
    // system: "command TWOWAY is unrecognized").
    forvalues i = 1/`s12_np' {
        if `s12_prc`i'' != 199 continue
        local h `"`s12_ph`i''"'
        capture dash `h' scatter mpg weight
        _w30_expect "CF-02" `=_rc == 199' `"dash `h': rc `=_rc', want 199"'
        local 0 `"`h' scatter mpg weight"'
        mata: _dash_strip_prefix()
        local _w : word 1 of `h'
        local _want `"`s12_plast`i''"'
        if strlower("`_w'") != "`_w'" local _want "command `_w' is unrecognized"
        mata: st_local("_ok", strofreal("command " + st_local("_pf_word") + " is unrecognized" == st_local("_want")))
        _w30_expect "CF-02" `_ok' `"dash `h' says another message than `_want'"'
    }
    _w30_done "CF-02" "every prefix Stata refuses is refused r(199) in its words"

    // CF-03 -- every doubled prefix: r(198), twoway's words.
    forvalues i = 1/`s12_np' {
        if `s12_prc`i'' != 198 continue
        local h `"`s12_ph`i''"'
        capture dash `h' scatter mpg weight
        _w30_expect "CF-03" `=_rc == 198' `"dash `h': rc `=_rc', want 198"'
        local 0 `"`h' scatter mpg weight"'
        mata: _dash_strip_prefix()
        mata: st_local("_ok", strofreal(st_local("_pf_word") + " is not a twoway plot type" == st_local("s12_plast`i'")))
        _w30_expect "CF-03" `_ok' `"dash `h' says another message than twoway"'
    }
    _w30_done "CF-03" "a second prefix word is refused r(198) in twoway's words"

    // CF-04 (guard) -- a prefix never makes a subcommand.
    local _cfreg "${dash_graph_registry}"
    capture dash twoway build, saving(x.html)
    _w30_expect "CF-04" `=_rc == 198' "dash twoway build was not refused"
    capture dash tw kpi mean(mpg), name(k)
    _w30_expect "CF-04" `=_rc == 198' "dash tw kpi was not refused"
    capture dash two clear
    _w30_expect "CF-04" `=_rc == 198' "dash two clear was not refused"
    mata: st_local("_ok", strofreal(st_global("dash_graph_registry") == st_local("_cfreg")))
    _w30_expect "CF-04" `_ok' "a prefixed subcommand changed the registry"
    capture dash graph scatter mpg weight
    _w30_expect "CF-04" `=_rc == 198' "dash graph scatter was not refused"
    _w30_done "CF-04" "a prefix never routes to a subcommand"
    quietly dash clear

    // CF-05 -- every saving() text: dash's one-line form, in an empty
    // folder, as twoway: rc, words, and the files (.gph as .html).
    local pwd5 "`c(pwd)'"
    forvalues i = 1/`s12_ns' {
        local d5 "`w30_work'/cf5_`i'"
        mkdir "`d5'"
        quietly cd "`d5'"
        capture dash scatter mpg weight, saving(`s12_st`i'')
        local rc5 = _rc
        quietly cd "`pwd5'"
        local t `"`s12_st`i''"'
        local tw5 = `s12_src`i''
        _w30_expect "CF-05" `=(`rc5' == 0) == (`tw5' == 0)' `"saving(`macval(t)'): dash rc `rc5', twoway rc `tw5'"'
        if `tw5' != 0 {
            _s12_said `"`macval(t)'"'
            local _l5 `"`s12_slast`i''"'
            mata: st_local("_ok", strofreal(st_local("s12_said") == st_local("_l5")))
            _w30_expect "CF-05" `_ok' `"saving(`macval(t)'): dash says another message"'
        }
        local fl : dir "`d5'" files "*"
        local nfl : word count `fl'
        local nf5 = `s12_snf`i''
        _w30_expect "CF-05" `=`nfl' == `nf5'' `"saving(`macval(t)'): dash wrote `nfl' files, twoway `nf5'"'
        forvalues k = 1/`nf5' {
            local f5 `"`s12_sf`i'_`k''"'
            capture confirm file `"`d5'/`f5'"'
            _w30_expect "CF-05" `=_rc == 0' `"saving(`macval(t)'): no `f5'"'
        }
        foreach f of local fl {
            capture erase `"`d5'/`f'"'
        }
        capture rmdir "`d5'"
    }
    _w30_done "CF-05" "every saving() text of the fixture behaves as twoway's"

    // CF-06 -- S04's path characters and .. segment twoway wrote.
    local d6 "`w30_work'/cf6"
    mkdir "`d6'"
    mkdir "`d6'/sub"
    forvalues i = 1/`s12_nc' {
        local f6 `"`d6'/`s12_cf`i''"'
        capture dash scatter mpg weight, saving(`"`f6'"')
        _w30_expect "CF-06" `=_rc == 0' `"saving(`f6'): rc `=_rc'"'
        capture confirm file `"`f6'"'
        _w30_expect "CF-06" `=_rc == 0' `"`f6' not written"'
        capture erase `"`f6'"'
    }
    _w30_expect "CF-06" `=`s12_nc' == 6' "the S04 fixture lacks one of ; & | < > .."
    capture rmdir "`d6'/sub"
    capture rmdir "`d6'"
    _w30_done "CF-06" "dash writes every path character and .. segment twoway wrote"

    // CF-07 -- the saved one-line page of a prefixed command.
    local cf7 "`w30_work'/cf7.html"
    capture erase "`cf7'"
    capture noisily dash twoway scatter mpg weight, saving("`cf7'")
    _w30_expect "CF-07" `=_rc == 0' "dash twoway ..., saving() failed"
    capture confirm file "`cf7'"
    _w30_expect "CF-07" `=_rc == 0' "the page was not written"
    capture erase "`cf7'"
    _w30_done "CF-07" "dash twoway ..., saving() writes and announces the page"
    quietly dash clear
    display as text "S12 end " c(current_date) " " c(current_time)
}
* ==== end S12 ====

python:
import json as _s13_json, re as _s13_re, html as _s13_html
import warnings as _s13_w
import __main__ as _s13_main
from sfi import Macro as _s13_M

# S13 (WP-30 P1.12b): each helper reads one line width -- the glyph,
# annotation or figure attribute named by S13_KIND -- from the saved page,
# the served document (before and after a filter move), or the magenta
# stroke of a twoway SVG, and hands it back through an S13_* global.
_S13_ATTR = {"Line": "line_width", "Scatter": "line_width",
             "VBar": "line_width", "Patch": "line_width",
             "Span": "line_width", "Figure": "outline_line_width"}


def _s13_val(v):
    if isinstance(v, dict):
        return v.get("value")
    return v


def _s13_pick(pairs):
    kind = _s13_M.getGlobal("S13_KIND")
    attr = _S13_ATTR[kind]
    import bokeh.models as _bm
    import bokeh.plotting as _bp
    for name, get in pairs:
        if name == kind:
            v = get(attr)
            if v is None:
                cls = getattr(_bm, kind, None) or getattr(_bp, kind, None)
                v = _s13_val(getattr(cls(), attr, None)) if cls else None
            try:
                return "%.6f" % float(v)
            except (TypeError, ValueError):
                return "."
    return "."


def _s13_page():
    try:
        with open(_s13_M.getGlobal("S13_PAGE"), encoding="utf-8") as fh:
            page = fh.read()
    except OSError:
        _s13_M.setGlobal("S13_D", ".")
        return
    objs, stack = {}, []
    for blob in _s13_re.findall('<script type="application/json"[^>]*>(.*?)</script>', page, _s13_re.S):
        try:
            stack.append(_s13_json.loads(_s13_html.unescape(blob)))
        except ValueError:
            pass
    while stack:
        v = stack.pop()
        if isinstance(v, dict):
            if v.get("type") == "object" and "id" in v and "name" in v:
                objs.setdefault(v["id"], v)
            stack.extend(v.values())
        elif isinstance(v, list):
            stack.extend(v)
    pairs = []
    for o in sorted(objs.values(), key=lambda o: str(o["id"])):
        a = o.get("attributes", {}) or {}
        pairs.append((o["name"], (lambda a=a: (lambda attr: _s13_val(a.get(attr))))()))
    _s13_M.setGlobal("S13_D", _s13_pick(pairs))


def _s13_doc_pick(doc):
    seen = dict()
    for root in doc.roots:
        for m in root.references():
            seen[m.id] = m
    pairs = [(type(m).__name__, (lambda m=m: (lambda attr: _s13_val(getattr(m, attr, None))))())
             for m in sorted(seen.values(), key=lambda m: str(m.id))]
    return _s13_pick(pairs)


def _s13_app():
    from bokeh.document import Document
    from bokeh.models import RangeSlider
    with open(_s13_M.getGlobal("S13_APP"), encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_s13_app")
    with _s13_w.catch_warnings():
        _s13_w.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_s13_app.py", "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    before = _s13_doc_pick(doc)
    _s13_M.setGlobal("S13_S", before)
    sl = [s for s in doc.select(dict(type=RangeSlider)) if getattr(s, "_dash_var", None) == "weight"]
    fired = 0
    if len(sl) == 1:
        old = sl[0].value
        lo, hi = old
        new = (lo + (hi - lo) / 4.0, hi)
        sl[0].value = new
        with _s13_w.catch_warnings():
            _s13_w.simplefilter("ignore")
            for attr in ("value", "value_throttled"):
                for cb in sl[0]._callbacks.get(attr, []):
                    cb(attr, old, new)
                    fired += 1
    _s13_M.setGlobal("S13_SAME_AFTER", str(int(fired > 0 and _s13_doc_pick(doc) == before)))


def _s13_svg():
    import svg_truth as _s13_svgt
    try:
        with open(_s13_M.getGlobal("S13_SVG"), encoding="utf-8") as fh:
            txt = fh.read()
    except OSError:
        _s13_M.setGlobal("S13_TW", ".")
        return
    ws = []
    for m in _s13_re.finditer(r'style="([^"]*)"|\{([^{}]*)\}', txt):
        st = _s13_svgt._style_of({"style": m.group(1) or m.group(2) or ""})
        if (st.get("stroke") or "").strip().lower() != "#ff00ff":
            continue
        w = _s13_svgt._fnum(st.get("stroke-width", ""))
        if w is not None:
            ws.append(w)
    # SVG units: 10 per point; no magenta stroke is no line drawn.
    _s13_M.setGlobal("S13_TW", "%.6f" % (max(ws) / 10.0 if ws else 0.0))


_s13_main._s13_page = _s13_page
_s13_main._s13_app = _s13_app
_s13_main._s13_svg = _s13_svg
end

// _s13_pair: twoway's magenta stroke (pt) for `twcmd', then dash's saved
// and served width (px) of the S13_KIND element for `dcmd', with a range
// filter on weight; S13_SAME_AFTER says the served width survived a move.
capture program drop _s13_pair
program define _s13_pair
    version 19
    args stem work kind twcmd dcmd
    global S13_KIND "`kind'"
    global S13_SVG "`work'/`stem'.svg"
    global S13_PAGE "`work'/`stem'.html"
    global S13_APP "`work'/`stem'_app.py"
    graph drop _all
    capture noisily `twcmd'
    quietly graph export "${S13_SVG}", replace as(svg)
    python: __import__("__main__")._s13_svg()
    capture dash clear
    capture noisily `dcmd' name(s13g)
    capture erase "${S13_PAGE}"
    capture erase "${S13_APP}"
    capture noisily dash build, saving("${S13_PAGE}") replace nobrowser filter(weight, type(range))
    capture noisily dash build, saving("${S13_APP}") server replace filter(weight, type(range))
    python: __import__("__main__")._s13_page()
    python: __import__("__main__")._s13_app()
    capture erase "${S13_SVG}"
    capture erase "${S13_PAGE}"
    capture erase "${S13_APP}"
end

* ==== S13 P1.12b: Stata line-width ladder ====
local only : env WP30_ONLY
if inlist("`only'", "", "S13") & `: list posof "S13" in w30_run' {
    display as text "S13 start " c(current_date) " " c(current_time)
    local s13_scheme "`c(scheme)'"
    set scheme s2color
    quietly sysuse auto, clear
    local M `""255 0 255""'
    local s13_same 1

    // LN-20: lwidth(thick) / the default line = .8/.3, twoway and dash.
    _s13_pair ln20a "`w30_work'" Line `"twoway line mpg weight, lcolor(`M') legend(off)"' "dash line mpg weight,"
    local t0 ${S13_TW}
    local d0 ${S13_D}
    local s0 ${S13_S}
    local s13_same = `s13_same' & ${S13_SAME_AFTER}
    _s13_pair ln20b "`w30_work'" Line `"twoway line mpg weight, lwidth(thick) lcolor(`M') legend(off)"' "dash line mpg weight, lwidth(thick)"
    local s13_same = `s13_same' & ${S13_SAME_AFTER}
    _w30_expect LN-20 "(abs(${S13_TW} / `t0' - 0.8 / 0.3) < 0.01 * 0.8 / 0.3)" "twoway `t0' -> ${S13_TW} pt"
    _w30_expect LN-20 "(abs(${S13_D} / `d0' - ${S13_TW} / `t0') < 0.01 * ${S13_TW} / `t0' & abs(${S13_S} / `s0' - ${S13_TW} / `t0') < 0.01 * ${S13_TW} / `t0')" "dash saved `d0' -> ${S13_D}, served `s0' -> ${S13_S}"
    _w30_expect LN-20 "(abs(`d0' - 1.152) < 0.001)" "the default line is 1.152 px (`d0')"
    _w30_done LN-20 "lwidth(thick) draws 8/3 of the default line, as in twoway"

    // LN-21: economist lwidth(1pt) / its default = 10.00/19.01.
    _s13_pair ln21a "`w30_work'" Line `"twoway line mpg weight, lcolor(`M') legend(off) scheme(economist)"' "dash line mpg weight, scheme(economist)"
    local t0 ${S13_TW}
    local d0 ${S13_D}
    local s0 ${S13_S}
    local s13_same = `s13_same' & ${S13_SAME_AFTER}
    _s13_pair ln21b "`w30_work'" Line `"twoway line mpg weight, lwidth(1pt) lcolor(`M') legend(off) scheme(economist)"' "dash line mpg weight, lwidth(1pt) scheme(economist)"
    local s13_same = `s13_same' & ${S13_SAME_AFTER}
    local r = ${S13_TW} / `t0'
    _w30_expect LN-21 "(abs(`r' - 10.00 / 19.01) < 0.01)" "twoway ratio `r'"
    _w30_expect LN-21 "(abs(${S13_D} / `d0' - `r') < 0.01 * `r' & abs(${S13_S} / `s0' - `r') < 0.01 * `r')" "dash saved `d0' -> ${S13_D}, served `s0' -> ${S13_S}"
    _w30_done LN-21 "economist lwidth(1pt) keeps twoway's ratio to the scheme's line"

    // LN-22: *2 is twice the site's own default at four sites.
    foreach s in line mlwidth xline bar {
        if "`s'" == "line" {
            local k Line
            local tw0 `"twoway line mpg weight, lcolor(`M') legend(off)"'
            local tw2 `"twoway line mpg weight, lwidth(*2) lcolor(`M') legend(off)"'
            local d0c "dash line mpg weight,"
            local d2c "dash line mpg weight, lwidth(*2)"
        }
        else if "`s'" == "mlwidth" {
            local k Scatter
            local tw0 `"twoway scatter mpg weight, mlcolor(`M') legend(off)"'
            local tw2 `"twoway scatter mpg weight, mlcolor(`M') mlwidth(*2) legend(off)"'
            local d0c "dash scatter mpg weight,"
            local d2c "dash scatter mpg weight, mlwidth(*2)"
        }
        else if "`s'" == "xline" {
            local k Span
            local tw0 `"twoway line mpg weight, xline(3000, lcolor(`M')) legend(off)"'
            local tw2 `"twoway line mpg weight, xline(3000, lwidth(*2) lcolor(`M')) legend(off)"'
            local d0c "dash line mpg weight, xline(3000)"
            local d2c "dash line mpg weight, xline(3000, lwidth(*2))"
        }
        else {
            local k VBar
            local tw0 `"twoway bar mpg weight, lcolor(`M') legend(off)"'
            local tw2 `"twoway bar mpg weight, lcolor(`M') lwidth(*2) legend(off)"'
            local d0c "dash bar mpg weight,"
            local d2c "dash bar mpg weight, lwidth(*2)"
        }
        _s13_pair ln22`s'0 "`w30_work'" `k' `"`tw0'"' "`d0c'"
        local t0 ${S13_TW}
        local d0 ${S13_D}
        local s0 ${S13_S}
        local s13_same = `s13_same' & ${S13_SAME_AFTER}
        _s13_pair ln22`s'2 "`w30_work'" `k' `"`tw2'"' "`d2c'"
        local s13_same = `s13_same' & ${S13_SAME_AFTER}
        _w30_expect LN-22 "(abs(${S13_TW} / `t0' - 2) < 0.02 & abs(${S13_D} / `d0' - 2) < 0.02 & abs(${S13_S} / `s0' - 2) < 0.02)" "`s': twoway `t0' -> ${S13_TW}, dash `d0' -> ${S13_D}, served `s0' -> ${S13_S}"
    }
    _w30_done LN-22 "lwidth(*2), mlwidth(*2), xline's lwidth(*2) and bar lwidth(*2) double their own default"

    // LN-23: vvvthin is the 0.3 pt hairline; none draws nothing.
    _s13_pair ln23a "`w30_work'" Line `"twoway line mpg weight, lwidth(vvvthin) lcolor(`M') legend(off)"' "dash line mpg weight, lwidth(vvvthin)"
    local s13_same = `s13_same' & ${S13_SAME_AFTER}
    _w30_expect LN-23 "(abs(${S13_TW} - 0.3) < 0.001 & abs(${S13_D} - 0.4) < 0.001 & abs(${S13_S} - 0.4) < 0.001)" "vvvthin: twoway ${S13_TW} pt, dash ${S13_D} / ${S13_S} px"
    _s13_pair ln23b "`w30_work'" Line `"twoway line mpg weight, lwidth(none) lcolor(`M') legend(off)"' "dash line mpg weight, lwidth(none)"
    local s13_same = `s13_same' & ${S13_SAME_AFTER}
    _w30_expect LN-23 "(${S13_TW} == 0 & ${S13_D} == 0 & ${S13_S} == 0)" "none: twoway ${S13_TW}, dash ${S13_D} / ${S13_S}"
    _w30_done LN-23 "vvvthin is 0.3 pt and none draws nothing, as in twoway"

    // LN-24: THICK is noted by both and both draw the default.
    capture log close s13k
    log using "`w30_work'/ln24.log", text replace name(s13k)
    _s13_pair ln24 "`w30_work'" Line `"twoway line mpg weight, lwidth(THICK) lcolor(`M') legend(off)"' "dash line mpg weight, lwidth(THICK)"
    log close s13k
    local s13_same = `s13_same' & ${S13_SAME_AFTER}
    cert_log_has "`w30_work'/ln24.log", needle("named style THICK not found in class linewidth")
    local n1 = r(count)
    cert_log_has "`w30_work'/ln24.log", needle("lwidth(THICK) is not a recognised line width")
    local n2 = r(count)
    capture erase "`w30_work'/ln24.log"
    _w30_expect LN-24 "(`n1' >= 1 & `n2' >= 1)" "notes: twoway `n1', dash `n2'"
    _w30_expect LN-24 "(abs(${S13_TW} - 0.864) < 0.001 & abs(${S13_D} - 1.152) < 0.001 & abs(${S13_S} - 1.152) < 0.001)" "THICK: twoway ${S13_TW} pt, dash ${S13_D} / ${S13_S} px"
    _w30_done LN-24 "lwidth(THICK) is noted and drawn at the default, as in twoway"

    // LN-25: economist's bar outline (pbar vvthin) is floored.
    _s13_pair ln25 "`w30_work'" VBar `"twoway bar mpg weight, lcolor(`M') legend(off) scheme(economist)"' "dash bar mpg weight, scheme(economist)"
    local s13_same = `s13_same' & ${S13_SAME_AFTER}
    _w30_expect LN-25 "(abs(${S13_TW} - 0.3) < 0.001 & abs(${S13_D} - 0.4) < 0.001 & abs(${S13_S} - 0.4) < 0.001)" "twoway ${S13_TW} pt, dash ${S13_D} / ${S13_S} px"
    _w30_done LN-25 "economist's bar outline is drawn at the 0.3 pt floor, as in twoway"

    // LN-26: every served width above survived a filter move.
    _w30_expect LN-26 "(`s13_same' == 1)" "same after the move: `s13_same'"
    _w30_done LN-26 "the served widths of LN-20 to LN-25 are unchanged by a filter move"

    // LN-27: the refusal corpus, dash's rc against twoway's.
    local s13_n 0
    foreach c in "line lwidth *-1 198 198" "line lwidth -1pt 198 198" ///
        "line lwidth -0.5in 198 198" "line lwidth 1e5rs 198 198" ///
        "line lwidth -1 198 198" "line lwidth 10001 198 198" ///
        "line lwidth *-0.0001 198 198" "line lwidth -0.0001rs 198 198" ///
        "scatter mlwidth *-1 198 198" "scatter mlwidth -1pt 198 198" ///
        "line clwidth *-1 198 198" "lfitci alwidth *-1 198 198" ///
        "lfitci alwidth -1pt 198 198" "bar lwidth *-1 198 198" ///
        "scatter lwidth *-1 0 198" "line alwidth *-1 0 0" ///
        "line lwidth *40000 198 0" "line lwidth 20000pt 198 0 economist" {
        local ty : word 1 of `c'
        local op : word 2 of `c'
        local va : word 3 of `c'
        local tw : word 4 of `c'
        local dw : word 5 of `c'
        local sc : word 6 of `c'
        local so ""
        if "`sc'" != "" local so "scheme(`sc')"
        capture twoway `ty' mpg weight, `op'(`va') `so'
        local trc = _rc
        capture dash clear
        capture dash `ty' mpg weight, `op'(`va') `so' name(s13r)
        local drc = _rc
        _w30_expect LN-27 "(`trc' == `tw' & `drc' == `dw')" "`ty' `op'(`va') `so': twoway `trc' (want `tw'), dash `drc' (want `dw')"
        local ++s13_n
    }
    _w30_done LN-27 "dash refuses what twoway refuses, `s13_n' probes, except the D-13b controls and scatter lwidth(*-1) (D-13c)"

    capture dash clear
    graph drop _all
    set scheme `s13_scheme'
    macro drop S13_*
    display as text "S13 end " c(current_date) " " c(current_time)
}
* ==== end S13 ====

// S14 helpers (WP-30 P1.17a).  _bg_widths: the bar widths a registered
// dash graph draws, saved and served, in the x variable's own units;
// _bg_caps: the sizes of its dash_cap markers, or of its Scatters;
// _bg_move: the served bar width after a Select move to Foreign.  Each
// answers through globals bg_s, bg_v (saved, served) and bg_n.
python:
import os as _bg_os, sys as _bg_sys
for _bg_p in (_bg_os.path.abspath(".."),
              _bg_os.path.abspath(_bg_os.path.join("..", "scripts"))):
    if _bg_p not in _bg_sys.path:
        _bg_sys.path.insert(0, _bg_p)


def _bg_docs(sp, dp, app):
    import os, warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_bg_app")
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_bg_app.py", "exec"),
             ns)
        doc = Document()
        ns["make_document"](doc)
    sv = [m for m in doc.models if type(m).__name__ == "figure"]
    return list(r.figures.values()), sv, doc


def _bg_unitw(rend, kind):
    import numpy as np
    import dash_render as dr
    g = rend.glyph
    w = g.width
    if isinstance(w, (int, float)):
        return [float(w) / (86400000.0 if kind == "td" else 1.0)]
    d = rend.data_source.data
    xc = np.asarray(d["__dash_bar_xc"], dtype=float)
    bw = np.asarray(d["__dash_bar_w"], dtype=float)
    return [float(v) for v in _bg_frac(xc + bw / 2.0, kind)
            - _bg_frac(xc - bw / 2.0, kind)]


def _bg_frac(ms, kind):
    # Epoch ms in fractional period units: the period it falls in, plus
    # its share of that period (the inverse of _dash_units_to_axis).
    import numpy as np
    import dash_render as dr
    p = np.asarray(dr._dash_date_units(ms, kind), dtype=float)
    a = dr._dash_units_to_axis(p, kind)
    b = dr._dash_units_to_axis(p + 1.0, kind)
    return p + (np.asarray(ms, dtype=float) - a) / (b - a)


def _bg_svg_caps(path):
    # Twoway's capped spines: horizontal lines centred on a spine's x at
    # one of its ends; the median cap length and how many spines have two.
    from sfi import Macro
    from svg_truth import svg_document
    doc = svg_document(path)
    caps, capped = [], 0
    for v in doc["vlines"]:
        found = []
        for e in (v["y1"], v["y2"]):
            for h in doc["hlines"]:
                if abs((h["x1"] + h["x2"]) / 2.0 - v["x1"]) < 0.5 \
                        and abs(h["y1"] - e) < 0.5 and h["x2"] != h["x1"]:
                    found.append(abs(h["x2"] - h["x1"]))
                    break
        if len(found) == 2:
            capped += 1
            caps += found
    caps.sort()
    m = min(doc["canvas"]["w"], doc["canvas"]["h"])
    ratio = 100.0 * caps[int(len(caps) / 2)] / m if caps else -1.0
    Macro.setGlobal("bg_ratio", "%.6g" % ratio)
    Macro.setGlobal("bg_ncap", str(capped))


def _bg_widths(sp, dp, app, kind=""):
    from sfi import Macro
    a, b, _ = _bg_docs(sp, dp, app)
    def ws(figs):
        out = []
        for f in figs:
            for r in f.renderers:
                if type(getattr(r, "glyph", None)).__name__ == "VBar":
                    out += _bg_unitw(r, kind)
        return out
    s, v = ws(a), ws(b)
    Macro.setGlobal("bg_s", " ".join("%.12g" % x for x in s))
    Macro.setGlobal("bg_v", " ".join("%.12g" % x for x in v))
    Macro.setGlobal("bg_n", str(min(len(s), len(v))))


def _bg_caps(sp, dp, app, tag=""):
    from sfi import Macro
    a, b, _ = _bg_docs(sp, dp, app)
    def sz(figs):
        out, kinds = [], []
        for f in figs:
            for r in f.renderers:
                g = getattr(r, "glyph", None)
                if g is None:
                    continue
                kinds.append(type(g).__name__)
                if type(g).__name__ != "Scatter":
                    continue
                if tag and tag not in (r.tags or []):
                    continue
                out.append(float(g.size))
        return out, kinds
    (s, ks), (v, kv) = sz(a), sz(b)
    Macro.setGlobal("bg_s", " ".join("%.12g" % x for x in s))
    Macro.setGlobal("bg_v", " ".join("%.12g" % x for x in v))
    Macro.setGlobal("bg_n", str(min(len(s), len(v))))
    Macro.setGlobal("bg_ks", " ".join(ks))
    Macro.setGlobal("bg_kv", " ".join(kv))


def _bg_move(sp, dp, app):
    from sfi import Macro
    from bokeh.models import Select
    _, _, doc = _bg_docs(sp, dp, app)
    def width():
        return [float(getattr(m.width, "value", m.width)) for m in doc.models
                if type(m).__name__ == "VBar"]
    before = width()
    [w] = [m for m in doc.models if isinstance(m, Select)]
    raw = [v for v, lab in w.options if lab == "Foreign"]
    w.value = raw[0]
    for key in ("value", "value_throttled"):
        for cb in list(w._callbacks.get(key, [])):
            cb("value", None, raw[0])
    Macro.setGlobal("bg_s", " ".join("%.12g" % x for x in before))
    Macro.setGlobal("bg_v", " ".join("%.12g" % x for x in width()))

end

capture program drop _bg_data
program define _bg_data
    // The extractor's five rows (scripts/extract_bar_geometry_truth.do).
    version 19
    clear
    quietly set obs 5
    quietly generate double x1 = real(word("1 2 3 4 5", _n))
    quietly generate double xp1 = real(word(".1 .2 .3 .4 .5", _n))
    quietly generate double x5 = real(word("5 10 15 20 25", _n))
    quietly generate double xu = real(word("1 1.5 4 10 11", _n))
    quietly generate double y = real(word("3 4 2 5 1", _n))
    quietly generate double lo = real(word("1 2 1 3 0", _n))
    quietly generate double hi = real(word("4 5 3 6 2", _n))
    quietly generate d = 14975 + 7 * (_n - 1)
    format d %td
    quietly generate m = 720 + (_n - 1)
    format m %tm
end
capture program drop _bg_eq
program define _bg_eq
    // _bg_eq <id> <want> <what>: every saved and served value in bg_s and
    // bg_v equals <want> to 1e-6 (relative), and one exists.
    version 19
    args id want what
    local ok = (${bg_n} > 0)
    foreach v in ${bg_s} ${bg_v} {
        if abs(`v' - (`want')) > 1e-6 * max(1, abs(`want')) local ok = 0
    }
    _w30_expect "`id'" `ok' `"`what': saved ${bg_s} served ${bg_v}, twoway `want'"'
end

* ==== S14 P1.17a: Bar widths and range caps ====
local only : env WP30_ONLY
if inlist("`only'", "", "S14") & `: list posof "S14" in w30_run' {
    display as text "S14 start " c(current_date) " " c(current_time)
    local bgd "`w30_work'/s14"
    capture mkdir "`bgd'"
    capture graph drop _all
    set scheme s2color
    local k = 0

    // BG-01 -- bar at x spacing 1, .1, 5 and uneven is twoway's bar_size.
    foreach xv in x1 xp1 x5 xu {
        _bg_data
        quietly twoway bar y `xv', name(bgt, replace)
        local bs = `.bgt.plotregion1.plot1.bar_size'
        local ++k
        dash clear
        quietly dash bar y `xv', name(zbg`k')
        _dash_serve_spec, specpath("`bgd'/s`k'.json") datapath("`bgd'/d`k'.json")
        python: _bg_widths("`bgd'/s`k'.json", "`bgd'/d`k'.json", "`bgd'/a`k'.py")
        _bg_eq BG-01 `bs' "bar y `xv'"
    }
    _w30_done BG-01 "bar is twoway's bar_size wide at x spacing 1, .1, 5 and uneven, saved and served"

    // BG-02 -- rbar default, barwidth(.3) and bw(.3), with no note.
    foreach o in "" "barwidth(.3)" "bw(.3)" {
        _bg_data
        local to = subinstr(`"`o'"', "bw(", "barwidth(", 1)
        quietly twoway rbar lo hi x1, `to' name(bgt, replace)
        local bs = `.bgt.plotregion1.plot1.bar_size'
        local ++k
        dash clear
        local lf "`bgd'/n`k'.log"
        quietly log using "`lf'", text replace name(bgn)
        dash rbar lo hi x1, `o' name(zbg`k')
        quietly log close bgn
        _dash_serve_spec, specpath("`bgd'/s`k'.json") datapath("`bgd'/d`k'.json")
        python: _bg_widths("`bgd'/s`k'.json", "`bgd'/d`k'.json", "`bgd'/a`k'.py")
        _bg_eq BG-02 `bs' "rbar lo hi x1, `o'"
        cert_file_has "`lf'", needle("(note:")
        local _nn = (r(found) == 0)
        _w30_expect BG-02 `_nn' "rbar lo hi x1, `o' printed a note"
        capture erase "`lf'"
    }
    _w30_done BG-02 "rbar takes barwidth() and bw() as twoway does, both modes, with no note"

    // BG-03 -- %td weekly and %tm, default and barwidth(), in the
    // variable's own units.
    foreach case in "d|td|" "d|td|barwidth(3)" "m|tm|" "m|tm|barwidth(.5)" {
        gettoken xv rest : case, parse("|")
        gettoken bar rest : rest, parse("|")
        gettoken kind rest : rest, parse("|")
        gettoken bar o : rest, parse("|")
        _bg_data
        quietly twoway bar y `xv', `o' name(bgt, replace)
        local bs = `.bgt.plotregion1.plot1.bar_size'
        local ++k
        dash clear
        quietly dash bar y `xv', `o' name(zbg`k')
        _dash_serve_spec, specpath("`bgd'/s`k'.json") datapath("`bgd'/d`k'.json")
        python: _bg_widths("`bgd'/s`k'.json", "`bgd'/d`k'.json", "`bgd'/a`k'.py", "`kind'")
        _bg_eq BG-03 `bs' "bar y `xv' (%`kind') `o'"
    }
    _w30_done BG-03 "a %td and a %tm bar are bar_size wide in the variable's own units, both modes"

    // BG-04 -- rcap's cap is a marker of its msize(): twoway's cap ratio is
    // its marker size; dash's dash_cap markers are the size dash gives a
    // scatter marker of the same msize(), at x spacing 1 and 5.
    foreach o in "" "msize(small)" "msize(large)" "msize(*2)" "x5" {
        _bg_data
        local xv = cond("`o'" == "x5", "x5", "x1")
        local mo = cond("`o'" == "x5", "", "`o'")
        quietly twoway rcap lo hi `xv', `mo' name(bgt, replace)
        local tms = `.bgt.plotregion1.plot1.style.marker.size.val'
        cert_svg_export, name(bgt) file("`bgd'/c.svg")
        python: _bg_svg_caps("`bgd'/c.svg")
        local _ok = (abs(${bg_ratio} - `tms') <= .01 * `tms')
        _w30_expect BG-04 `_ok' "twoway rcap `o': cap ratio ${bg_ratio}, marker size `tms'"
        local ++k
        dash clear
        quietly dash scatter hi `xv', `mo' name(zbg`k')
        _dash_serve_spec, specpath("`bgd'/s`k'.json") datapath("`bgd'/d`k'.json")
        python: _bg_caps("`bgd'/s`k'.json", "`bgd'/d`k'.json", "`bgd'/a`k'.py")
        local want : word 1 of ${bg_s}
        local ++k
        dash clear
        quietly dash rcap lo hi `xv', `mo' name(zbg`k')
        _dash_serve_spec, specpath("`bgd'/s`k'.json") datapath("`bgd'/d`k'.json")
        python: _bg_caps("`bgd'/s`k'.json", "`bgd'/d`k'.json", "`bgd'/a`k'.py", "dash_cap")
        local _ok = (${bg_n} == 2)
        _w30_expect BG-04 `_ok' "rcap `o': ${bg_n} dash_cap markers in each mode"
        _bg_eq BG-04 `want' "rcap `o' cap"
    }
    _w30_done BG-04 "rcap's caps are markers of its msize(), as twoway's are, at x spacing 1 and 5, both modes"

    // BG-05 -- rcapsym: twoway draws no cap line; dash draws a spine and
    // two markers at dash's default scatter size.
    _bg_data
    quietly twoway rcapsym lo hi x1, name(bgt, replace)
    cert_svg_export, name(bgt) file("`bgd'/c.svg")
    python: _bg_svg_caps("`bgd'/c.svg")
    _w30_expect BG-05 "(${bg_ncap} == 0)" "twoway rcapsym drew ${bg_ncap} capped spines"
    local ++k
    dash clear
    quietly dash scatter hi x1, name(zbg`k')
    _dash_serve_spec, specpath("`bgd'/s`k'.json") datapath("`bgd'/d`k'.json")
    python: _bg_caps("`bgd'/s`k'.json", "`bgd'/d`k'.json", "`bgd'/a`k'.py")
    local want : word 1 of ${bg_s}
    local ++k
    dash clear
    quietly dash rcapsym lo hi x1, name(zbg`k')
    _dash_serve_spec, specpath("`bgd'/s`k'.json") datapath("`bgd'/d`k'.json")
    python: _bg_caps("`bgd'/s`k'.json", "`bgd'/d`k'.json", "`bgd'/a`k'.py")
    local _ok = ("${bg_ks}" == "Segment Scatter Scatter" & "${bg_kv}" == "Segment Scatter Scatter")
    _w30_expect BG-05 `_ok' "dash rcapsym drew saved ${bg_ks}, served ${bg_kv}"
    _bg_eq BG-05 `want' "rcapsym markers"
    _w30_done BG-05 "rcapsym draws no caps, its markers at dash's default scatter size, both modes"

    // BG-06 -- a served move: the bar stays one x unit wide.
    clear
    quietly set obs 10
    quietly generate mpg = real(word("22 17 25 30 21 19 14 28 16 23", _n))
    quietly generate weight = real(word("2930 3350 2200 1800 3000 3100 4080 2010 3600 2650", _n))
    quietly generate foreign = mod(_n + 1, 2)
    label define bg_origin 0 "Domestic" 1 "Foreign"
    label values foreign bg_origin
    quietly twoway bar mpg weight, name(bgt, replace)
    local bs = `.bgt.plotregion1.plot1.bar_size'
    local ++k
    dash clear
    quietly dash bar mpg weight, name(zbg`k')
    _dash_serve_spec, specpath("`bgd'/s`k'.json") datapath("`bgd'/d`k'.json") filter(foreign)
    python: _bg_move("`bgd'/s`k'.json", "`bgd'/d`k'.json", "`bgd'/a`k'.py")
    global bg_n = 1
    _bg_eq BG-06 `bs' "served bar before and after the Foreign move"
    label drop bg_origin
    _w30_done BG-06 "the served bar is twoway's bar_size wide before and after a filter move"

    capture graph drop _all
    capture dash clear
    set scheme s2color
    local bgfiles : dir "`bgd'" files "*"
    foreach f of local bgfiles {
        capture erase "`bgd'/`f'"
    }
    capture rmdir "`bgd'"
    macro drop bg_*
    display as text "S14 end " c(current_date) " " c(current_time)
}
* ==== end S14 ====

// S15 helpers: each figure's chrome as one summary string,
// ttl;sub;nte;cap;axst;yrot;yside;xtick;ytick;yline;ygrid;y2side;y2tick;
// y2line;xgrid, from twoway's SVG (scripts/svg_chrome.py), dash's saved page
// (its embedded document) and dash's served app (make_document), the last
// also after a filter move.  Every argument crosses through sfi.Macro.
python:
import json as _s15_json
import html as _s15_html
import math as _s15_math
import os as _s15_os
import re as _s15_re
import sys as _s15_sys
import warnings as _s15_w
from sfi import Macro as _s15_M

_S15_FIELDS = ("ttl", "sub", "nte", "cap", "axst", "yrot", "yside", "xtick",
               "ytick", "yline", "ygrid", "y2side", "y2tick", "y2line",
               "xgrid")


def _s15_join(d):
    return ";".join(str(d.get(k, "-")) for k in _S15_FIELDS)


def _s15_tick_tw(t):
    if not t or not t.get("n"):
        return "none"
    return "%s/%d/%s" % (t["position"], int(round(t["length_rs"] * 3.84)),
                         t["color"])


def _s15_tw():
    _s15_sys.path.insert(0, _s15_os.path.join(_s15_M.getGlobal("S15_REPO"),
                                              "scripts"))
    import svg_chrome as sc
    path = _s15_M.getGlobal("S15_SVG")
    reg = sc.svg_region(path)
    d = {}
    for k, t in (("ttl", "TTL"), ("sub", "SUB"), ("nte", "NTE"),
                 ("cap", "CAP")):
        p = sc.svg_text_place(path, t, reg)
        if p:
            d[k] = "%s/%s/%s" % (p["side"], p["align"],
                                 "normal" if p["weight"] == "normal"
                                 and p["style"] == "normal" else "styled")
    p = sc.svg_text_place(path, "XTL", reg)
    if p:
        d["axst"] = ("normal" if p["style"] == "normal"
                     and p["weight"] == "normal" else "styled")
    sides = sc.svg_label_side(path, "y", reg)
    roles = {}
    if len(sides) == 2:
        for side in sides:
            labs = [t for t in sc._labels(path, "y", reg)
                    if sc._label_side_of(t, "y", reg) == side]
            big = max(abs(float(t["text"].replace(",", ""))) for t in labs)
            roles["y2" if big >= 1000 else "y"] = side
    elif sides:
        roles["y"] = sides[0]
    for role, side in roles.items():
        d[role + "side"] = side
        d[role + "tick"] = _s15_tick_tw(sc.svg_ticks(path, side, reg))
        d[role + "line"] = int(sc.svg_axis_line(path, side, reg))
        if role == "y":
            d["yrot"] = sc.svg_label_rotation(path, "y", reg, side)
    d["xtick"] = _s15_tick_tw(sc.svg_ticks(path, "bottom", reg))
    for ax in ("x", "y"):
        g = sc.svg_grid(path, ax, reg)
        d[ax + "grid"] = ("%d/%d" % (g["drawn"], g["dashed"]) if g["drawn"]
                          else "0/-")
    _s15_M.setGlobal("S15_TW", _s15_join(d))


def _s15_fig(fig):
    from bokeh.models import Axis, Label, Title
    d = {}
    if fig.title is not None and str(fig.title.text or "").strip():
        d["ttl"] = "%s/%s/%s" % (fig.title_location or "above",
                                 fig.title.align, fig.title.text_font_style)
    for side in ("above", "below"):
        for r in getattr(fig, side):
            if (isinstance(r, Title) and r is not fig.title
                    and r.text in ("SUB", "NTE", "CAP")):
                d[r.text.lower()] = "%s/%s/%s" % (
                    side, r.align, r.text_font_style)
    for r in fig.center:
        if isinstance(r, Label) and r.text in ("SUB", "NTE", "CAP"):
            d[r.text.lower()] = "above/%s/normal" % str(r.anchor).split("_")[-1]
    xs = [a for a in fig.below if isinstance(a, Axis)]
    if xs:
        d["axst"] = xs[0].axis_label_text_font_style
    def tick(a):
        if (a.major_tick_line_color is None
                or (a.major_tick_in, a.major_tick_out) == (0, 0)):
            return "none"
        if a.major_tick_in and a.major_tick_out:
            pos, n = "crossing", a.major_tick_in + a.major_tick_out
        elif a.major_tick_in:
            pos, n = "inside", a.major_tick_in
        else:
            pos, n = "outside", a.major_tick_out
        return "%s/%d/%s" % (pos, n, str(a.major_tick_line_color).lower())
    for side in ("left", "right"):
        for a in getattr(fig, side):
            if not isinstance(a, Axis):
                continue
            role = "y" if a.y_range_name == "default" else "y2"
            d[role + "side"] = side
            d[role + "tick"] = tick(a)
            d[role + "line"] = int(a.axis_line_color is not None)
            if role == "y":
                o = a.major_label_orientation
                d["yrot"] = (0 if o in ("horizontal", 0)
                             else int(round(_s15_math.degrees(o))) % 360)
    if xs:
        d["xtick"] = tick(xs[0])
    for ax, grids in (("x", fig.xgrid), ("y", fig.ygrid)):
        g = grids[0]
        d[ax + "grid"] = ("1/%d" % bool(list(g.grid_line_dash))
                          if g.grid_line_color is not None else "0/-")
    return _s15_join(d)


def _s15_figs(doc):
    from bokeh.plotting import figure
    return [f for root in doc.roots for f in root.select({"type": figure})]


def _s15_page():
    from bokeh.document import Document
    with open(_s15_M.getGlobal("S15_PAGE"), encoding="utf-8") as fh:
        page = fh.read()
    out = ""
    for blob in _s15_re.findall('<script type="application/json"[^>]*>(.*?)</script>', page, _s15_re.S):
        try:
            docs = _s15_json.loads(_s15_html.unescape(blob))
        except ValueError:
            continue
        for dj in (docs.values() if isinstance(docs, dict) else []):
            if not isinstance(dj, dict) or "roots" not in dj:
                continue
            with _s15_w.catch_warnings():
                _s15_w.simplefilter("ignore")
                doc = Document.from_json(dj)
            figs = _s15_figs(doc)
            if figs:
                out = _s15_fig(figs[0])
                break
        if out:
            break
    _s15_M.setGlobal("S15_D", out)


def _s15_app():
    from bokeh.document import Document
    from bokeh.models import Select
    with open(_s15_M.getGlobal("S15_APP"), encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_s15_app")
    with _s15_w.catch_warnings():
        _s15_w.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_s15_app.py", "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    figs = _s15_figs(doc)
    before = _s15_fig(figs[0]) if figs else ""
    _s15_M.setGlobal("S15_S", before)
    want = _s15_M.getGlobal("S15_MOVE")
    same = "0"
    sels = [m for root in doc.roots for m in root.select({"type": Select})
            if getattr(m, "_dash_var", None) == want]
    if sels and figs:
        w = sels[0]
        opts = [o[0] if isinstance(o, (list, tuple)) else o for o in w.options]
        if len(opts) > 1:
            w.value = opts[1]
            for key in ("value", "value_throttled"):
                for cb in list(w._callbacks.get(key, [])):
                    cb("value", None, opts[1])
            same = "1" if _s15_fig(_s15_figs(doc)[0]) == before else "0"
    _s15_M.setGlobal("S15_SAME_AFTER", same)


def _s15_pick(which, idx):
    vals = _s15_M.getGlobal(which).split(";")
    names = _s15_M.getGlobal("S15_PICK").split()
    out = []
    for n in names:
        i = _S15_FIELDS.index(n)
        out.append(vals[i] if i < len(vals) else "?")
    _s15_M.setGlobal("S15_P" + idx, ";".join(out))
end

// _s15_case tag scheme dashopts twopts [y2]: twoway, dash saved and dash
// served (filter foreign, dropdown) for one probe; sets S15_TW, S15_D,
// S15_S, S15_SAME_AFTER and S15_RC.
capture program drop _s15_case
program define _s15_case
    version 19
    args tag scheme y2 work
    local opts `"${S15_OPTS}"'
    local sent `"plotregion(lcolor("1 2 3") lstyle(foreground))"'
    quietly sysuse auto, clear
    local svg "`work'/lk_`tag'.svg"
    local page "`work'/lk_`tag'.html"
    local app "`work'/lk_`tag'.py"
    if "`y2'" == "y2" {
        local tw `"(scatter mpg weight) (scatter price weight, yaxis(2))"'
    }
    else local tw `"scatter mpg weight"'
    capture graph drop g
    capture noisily twoway `tw', `opts' `sent' scheme(`scheme') name(g, replace)
    local trc = _rc
    if !`trc' quietly graph export "`svg'", replace name(g)
    capture dash clear
    if "`y2'" == "y2" {
        capture noisily dash (scatter mpg weight) (scatter price weight, yaxis(2)), `opts' scheme(`scheme') saving("`page'", replace)
    }
    else capture noisily dash scatter mpg weight, `opts' scheme(`scheme') saving("`page'", replace)
    local drc = _rc
    capture dash clear
    if "`y2'" == "y2" {
        capture noisily dash (scatter mpg weight) (scatter price weight, yaxis(2)), `opts' scheme(`scheme') name(g1)
    }
    else capture noisily dash scatter mpg weight, `opts' scheme(`scheme') name(g1)
    local drc = `drc' + _rc
    capture noisily dash build, server saving("`app'") replace nobrowser filter(foreign, type(dropdown))
    local drc = `drc' + _rc
    global S15_TW ""
    global S15_D ""
    global S15_S ""
    global S15_SAME_AFTER "0"
    global S15_SVG "`svg'"
    global S15_PAGE "`page'"
    global S15_APP "`app'"
    global S15_MOVE "foreign"
    if !`trc' capture noisily python: __import__("__main__")._s15_tw()
    if !`drc' capture noisily python: __import__("__main__")._s15_page()
    if !`drc' capture noisily python: __import__("__main__")._s15_app()
    global S15_RC = `trc' + `drc'
    capture dash clear
    capture erase "`svg'"
    capture erase "`page'"
    capture erase "`app'"
    capture graph drop g
end

// _s15_same id fields: the named fields equal in twoway, saved and served.
capture program drop _s15_same
program define _s15_same
    version 19
    args id fields
    global S15_PICK "`fields'"
    python: __import__("__main__")._s15_pick("S15_TW", "T")
    python: __import__("__main__")._s15_pick("S15_D", "D")
    python: __import__("__main__")._s15_pick("S15_S", "S")
    _w30_expect `id' "(${S15_RC} == 0)" "rc ${S15_RC}"
    _w30_expect `id' `"("${S15_PT}" == "${S15_PD}" & "${S15_PT}" == "${S15_PS}")"' `"[`fields'] twoway ${S15_PT} saved ${S15_PD} served ${S15_PS}"'
end

* ==== S15 P1.2a: Scheme chrome: titles, ticks, grid, economist axes ====
local only : env WP30_ONLY
if inlist("`only'", "", "S15") & `: list posof "S15" in w30_run' {
    display as text "S15 start " c(current_date) " " c(current_time)
    global S15_REPO "`c(pwd)'/.."
    local s15_full `"title("TTL") subtitle("SUB") note("NTE") caption("CAP") xtitle("XTL") ytitle("YTL")"'

    // LK-01/LK-02/LK-04/LK-07: the full scatter under each scheme.
    local s15_after ""
    foreach s in s2color stcolor economist s1rcolor sj {
        global S15_OPTS `"`s15_full'"'
        _s15_case f_`s' `s' "" "`w30_work'"
        if inlist("`s'", "s2color", "stcolor", "economist") {
            _s15_same LK-01 "ttl sub nte cap axst"
            _w30_expect LK-01 "(${S15_SAME_AFTER} == 1)" "`s': the served chrome changed after a move"
        }
        _s15_same LK-02 "yrot"
        if inlist("`s'", "s2color", "s1rcolor", "stcolor", "economist") {
            _s15_same LK-04 "xtick ytick"
        }
        if inlist("`s'", "s2color", "economist") local s15_after "`s15_after'${S15_SAME_AFTER}"
    }
    _w30_done LK-01 "title, subtitle, note, caption and axis-title style as twoway draws them under s2color, stcolor and economist, saved and served"
    _w30_done LK-02 "the y labels' angle as twoway draws it under s2color, s1rcolor, sj, stcolor and economist"

    // LK-03: an explicit horizontal angle wins.
    global S15_OPTS `"ylabel(, angle(horizontal))"'
    _s15_case yh s2color "" "`w30_work'"
    _s15_same LK-03 "yrot"
    _w30_expect LK-03 `"("${S15_PT}" == "0")"' "twoway's y labels are level: ${S15_PT}"
    _w30_done LK-03 "ylabel(, angle(horizontal)) keeps s2color's y labels level in both modes"
    _w30_done LK-04 "tick side, length and colour as twoway draws them under s2color, s1rcolor, stcolor and economist"

    // LK-05: the grid pattern, with and without xlabel(, grid).
    foreach s in stcolor s2color {
        global S15_OPTS `"xlabel(, grid)"'
        _s15_case xg_`s' `s' "" "`w30_work'"
        _s15_same LK-05 "xgrid ygrid"
    }
    global S15_OPTS ""
    _s15_case pl_stcolor stcolor "" "`w30_work'"
    _s15_same LK-05 "ygrid"
    _w30_done LK-05 "the grid's pattern (stcolor dashed, s2color solid), xlabel(, grid) included, in both modes"

    // LK-06: the axis sides with a yaxis(2) layer.
    foreach s in economist s2color {
        global S15_OPTS `"title("TTL")"'
        _s15_case y2_`s' `s' y2 "`w30_work'"
        _s15_same LK-06 "yside yline ytick y2side y2tick y2line"
    }
    _w30_done LK-06 "economist's y axis right with no line or ticks and its axis 2 left with both; s2color's axis 2 right"

    // LK-07: the served chrome after the move, economist and s2color.
    _w30_expect LK-07 `"("`s15_after'" == "11")"' "after the move: `s15_after'"
    _w30_done LK-07 "the served chrome of economist and s2color is unchanged after a filter move"
    display as text "S15 end " c(current_date) " " c(current_time)
}
* ==== end S15 ====

// S16 (P1.2b) helpers: twoway's dominant fill of a probe's kind, read from
// its SVG through scripts/svg_truth.py, and every glyph renderer's
// Type:fill_color:line_color:fill_alpha:line_alpha of dash's saved page
// (its embedded document) and served app (make_document), the last also
// after a filter move.  Every argument crosses through sfi.Macro.
python:
import collections as _s16_col
import json as _s16_json
import html as _s16_html
import os as _s16_os
import re as _s16_re
import sys as _s16_sys
import warnings as _s16_w
from sfi import Macro as _s16_M

_S16_ATTR = _s16_re.compile(r'([\w:-]+)="([^"]*)"')


def _s16_style(a):
    out = {}
    for part in a.get("style", "").split(";"):
        k, _, v = part.partition(":")
        if k.strip():
            out[k.strip().lower()] = v.strip()
    return out


def _s16_svg():
    """S16_TW: `#RRGGBB|opacity|stroke' of the dominant fill of S16_KIND."""
    _s16_sys.path.insert(0, _s16_os.path.join(_s16_M.getGlobal("S16_REPO"), "scripts"))
    from svg_truth import svg_document
    path = _s16_M.getGlobal("S16_SVG")
    kind = _s16_M.getGlobal("S16_KIND")
    doc = svg_document(path)
    with open(path, encoding="utf-8") as fh:
        txt = fh.read()
    items, strokes = [], []
    if kind == "marker":
        circ = [c for c in doc["circles"]
                if c.get("fill") and c["fill"] != "none" and c.get("r")]
        rmax = max(c["r"] for c in circ) if circ else 0
        items = [(c["fill"], c.get("fill_opacity")) for c in circ
                 if c["r"] == rmax]
    elif kind == "rect":
        cw = doc["canvas"]["w"]
        for m in _s16_re.finditer(r"<rect\b([^>]*)>", txt):
            a = dict(_S16_ATTR.findall(m.group(1)))
            st = _s16_style(a)
            try:
                w = float(a.get("width", "0"))
            except ValueError:
                w = 0.0
            if not 0 < w < cw / 3.0:
                continue
            fill = (st.get("fill") or "").lower()
            stroke = (st.get("stroke") or "").lower()
            if stroke and stroke != "none":
                strokes.append(stroke)
            if fill and fill != "none":
                op = st.get("fill-opacity")
                items.append((fill, float(op) if op else None))
    else:
        items = [(p["fill"], p.get("fill_opacity")) for p in doc["paths"]
                 if p.get("fill") and p["fill"] != "none"]
        for m in _s16_re.finditer(r"<use\b([^>]*)>", txt):
            st = _s16_style(dict(_S16_ATTR.findall(m.group(1))))
            fill = (st.get("fill") or "").lower()
            if fill and fill != "none":
                op = st.get("fill-opacity")
                items.append((fill, float(op) if op else None))
    c = _s16_col.Counter(items)
    if not c:
        _s16_M.setGlobal("S16_TW", "")
        return
    (f, o), _n = c.most_common(1)[0]
    s = _s16_col.Counter(strokes).most_common(1)[0][0] if strokes else ""
    _s16_M.setGlobal("S16_TW", "%s|%s|%s" % (f, 1.0 if o is None else o, s))


def _s16_v(g, attr):
    """A glyph property's plain value (a page read back from JSON holds
    value(...) specs)."""
    v = getattr(g, attr, "")
    v = getattr(v, "value", v)
    return str(v).lower()


def _s16_fills(doc):
    from bokeh.models import GlyphRenderer
    out = []
    for r in doc.select({"type": GlyphRenderer}):
        g = r.glyph
        out.append("%s:%s:%s:%s:%s" % (
            type(g).__name__, _s16_v(g, "fill_color"),
            _s16_v(g, "line_color"), _s16_v(g, "fill_alpha"),
            _s16_v(g, "line_alpha")))
    return ";".join(out)


def _s16_page():
    from bokeh.document import Document
    with open(_s16_M.getGlobal("S16_PAGE"), encoding="utf-8") as fh:
        page = fh.read()
    out = ""
    for blob in _s16_re.findall('<script type="application/json"[^>]*>(.*?)</script>', page, _s16_re.S):
        try:
            docs = _s16_json.loads(_s16_html.unescape(blob))
        except ValueError:
            continue
        for dj in (docs.values() if isinstance(docs, dict) else []):
            if not isinstance(dj, dict) or "roots" not in dj:
                continue
            with _s16_w.catch_warnings():
                _s16_w.simplefilter("ignore")
                doc = Document.from_json(dj)
            out = _s16_fills(doc)
            break
        if out:
            break
    _s16_M.setGlobal("S16_FILLS_D", out)


def _s16_app():
    from bokeh.document import Document
    from bokeh.models import Select
    with open(_s16_M.getGlobal("S16_APP"), encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_s16_app")
    with _s16_w.catch_warnings():
        _s16_w.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_s16_app.py", "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    before = _s16_fills(doc)
    _s16_M.setGlobal("S16_FILLS_S", before)
    same = "0"
    sels = [m for root in doc.roots for m in root.select({"type": Select})
            if getattr(m, "_dash_var", None) == "foreign"]
    if sels:
        w = sels[0]
        opts = [o[0] if isinstance(o, (list, tuple)) else o for o in w.options]
        if len(opts) > 1:
            w.value = opts[1]
            for key in ("value", "value_throttled"):
                for cb in list(w._callbacks.get(key, [])):
                    cb("value", None, opts[1])
            same = "1" if _s16_fills(doc) == before else "0"
    _s16_M.setGlobal("S16_SAME_AFTER", same)


def _s16_cmp():
    """S16_OK = 1 when twoway's fill (and opacity, and the stroke when
    S16_STROKE is 1) equals the first S16_GLYPH of both modes; for
    markers every Scatter is opaque.  S16_MSG says what was compared."""
    tw = _s16_M.getGlobal("S16_TW").split("|")
    glyph = _s16_M.getGlobal("S16_GLYPH")
    ok, msg = True, ["twoway " + "|".join(tw)]
    for mode in ("D", "S"):
        ents = [e.split(":") for e in _s16_M.getGlobal("S16_FILLS_" + mode).split(";") if e]
        mine = [e for e in ents if e[0] == glyph]
        msg.append(mode + " " + (":".join(mine[0]) if mine else "none"))
        if not mine or len(tw) < 3:
            ok = False
            continue
        if glyph == "Scatter":
            ok = ok and all(float(e[3]) == float(tw[1]) and
                            float(e[4]) == float(tw[1]) for e in mine)
            ok = ok and mine[0][1] == tw[0]
            continue
        ok = ok and mine[0][1] == tw[0]
        if _s16_M.getGlobal("S16_ALPHA") == "1":
            ok = ok and abs(float(mine[0][3]) - float(tw[1])) < 1e-9
        if _s16_M.getGlobal("S16_STROKE") == "1":
            ok = ok and mine[0][2] == tw[2]
    _s16_M.setGlobal("S16_OK", "1" if ok else "0")
    _s16_M.setGlobal("S16_MSG", "; ".join(msg)[:240])
end

// _s16_case tag scheme kind glyph "twoway command" "dash options": twoway
// and dash (saved, served with a foreign dropdown filter) on one command;
// sets S16_OK, S16_MSG, S16_SAME_AFTER, S16_RC and S16_NOTE (1 when
// twoway's log holds "not found in class intensity" and dash's log names
// fintensity()).
capture program drop _s16_case
program define _s16_case
    version 19
    args tag scheme kind glyph cmd dopts work
    quietly sysuse auto, clear
    quietly generate lo = mpg - 3
    quietly generate hi = mpg + 3
    sort weight
    local svg "`work'/ob_`tag'.svg"
    local page "`work'/ob_`tag'.html"
    local app "`work'/ob_`tag'.py"
    local tlog "`work'/ob_`tag'_t.log"
    local dlog "`work'/ob_`tag'_d.log"
    local c = cond(strpos(`"`cmd'"', ","), " ", ", ")
    capture graph drop g
    quietly log using "`tlog'", text replace name(s16t)
    capture noisily twoway `cmd' `c' lcolor(none) scheme(`scheme') name(g, replace)
    local trc = _rc
    quietly log close s16t
    if "`tag'" == "rbr" {
        capture noisily twoway `cmd' `c' scheme(`scheme') name(g, replace)
        local trc = _rc
    }
    if !`trc' quietly graph export "`svg'", replace name(g)
    local dc = cond(strpos(`"`cmd'"', ","), " ", ", ")
    capture dash clear
    quietly log using "`dlog'", text replace name(s16d)
    capture noisily dash `cmd' `dc' scheme(`scheme') saving("`page'", replace)
    local drc = _rc
    quietly log close s16d
    capture dash clear
    capture noisily dash `cmd' `dc' scheme(`scheme') name(g1)
    local drc = `drc' + _rc
    capture noisily dash build, server saving("`app'") replace nobrowser filter(foreign, type(dropdown))
    local drc = `drc' + _rc
    foreach g in S16_TW S16_FILLS_D S16_FILLS_S S16_MSG {
        global `g' ""
    }
    global S16_SAME_AFTER "0"
    global S16_OK "0"
    global S16_SVG "`svg'"
    global S16_PAGE "`page'"
    global S16_APP "`app'"
    global S16_KIND "`kind'"
    global S16_GLYPH "`glyph'"
    if !`trc' capture noisily python: __import__("__main__")._s16_svg()
    if !`drc' capture noisily python: __import__("__main__")._s16_page()
    if !`drc' capture noisily python: __import__("__main__")._s16_app()
    if !`trc' & !`drc' capture noisily python: __import__("__main__")._s16_cmp()
    global S16_RC = `trc' + `drc'
    global S16_NOTE 0
    capture cert_log_has "`tlog'", needle("not found in class intensity")
    local tn = cond(_rc, 0, r(found))
    capture cert_log_has "`dlog'", needle("fintensity(abc)")
    local dn = cond(_rc, 0, r(found))
    global S16_NOTE = `tn' & `dn'
    capture dash clear
    foreach f in svg page app tlog dlog {
        capture erase "``f''"
    }
    capture graph drop g
end

* ==== S16 P1.2b: Intensity as an opaque blend ====
local only : env WP30_ONLY
if inlist("`only'", "", "S16") & `: list posof "S16" in w30_run' {
    display as text "S16 start " c(current_date) " " c(current_time)
    global S16_REPO "`c(pwd)'/.."
    global S16_ALPHA "1"
    global S16_STROKE "0"
    local s16_after ""

    // OB-10: markers opaque, both modes.
    foreach c in "scatter mpg weight" "connected mpg weight" "rconnected lo hi weight" {
        _s16_case mk s2color marker Scatter "`c'" "" "`w30_work'"
        _w30_expect OB-10 "(${S16_RC} == 0 & ${S16_OK} == 1)" `"`c': ${S16_MSG}"'
        if "`c'" == "scatter mpg weight" local s16_after "`s16_after'${S16_SAME_AFTER}"
    }
    _w30_done OB-10 "scatter, connected and rconnected markers are opaque, as twoway draws them, saved and served"

    // OB-11: the default bar under s2color and s1rcolor.
    foreach s in s2color s1rcolor {
        _s16_case br `s' rect VBar "bar mpg rep78 if rep78<." "" "`w30_work'"
        _w30_expect OB-11 "(${S16_RC} == 0 & ${S16_OK} == 1)" `"`s': ${S16_MSG}"'
        if "`s'" == "s2color" local s16_after "`s16_after'${S16_SAME_AFTER}"
    }
    _w30_done OB-11 "the default bar is filled as twoway fills it under s2color (#486C8C) and s1rcolor (#CCCC00), opaque"

    // OB-12: fintensity() as twoway draws it.
    foreach v in 50 150 0 {
        _s16_case fi s2color rect VBar "bar mpg rep78 if rep78<., fcolor(navy) fintensity(`v')" "" "`w30_work'"
        _w30_expect OB-12 "(${S16_RC} == 0 & ${S16_OK} == 1)" `"fintensity(`v'): ${S16_MSG}"'
        if "`v'" == "50" local s16_after "`s16_after'${S16_SAME_AFTER}"
    }
    _s16_case fi s1rcolor rect VBar "bar mpg rep78 if rep78<., fcolor(navy) fintensity(50)" "" "`w30_work'"
    _w30_expect OB-12 "(${S16_RC} == 0 & ${S16_OK} == 1)" `"s1rcolor fintensity(50): ${S16_MSG}"'
    _w30_done OB-12 "fcolor(navy) fintensity(50, 150, 0) under s2color and fintensity(50) under s1rcolor are twoway's colours"

    // OB-13: area, rarea (fill colour only) and rbar color(red).
    _s16_case ar s2color path VArea "area mpg weight" "" "`w30_work'"
    _w30_expect OB-13 "(${S16_RC} == 0 & ${S16_OK} == 1)" `"area: ${S16_MSG}"'
    global S16_ALPHA "0"
    _s16_case ra s2color path VArea "rarea lo hi weight" "" "`w30_work'"
    _w30_expect OB-13 "(${S16_RC} == 0 & ${S16_OK} == 1)" `"rarea: ${S16_MSG}"'
    global S16_ALPHA "1"
    global S16_STROKE "1"
    _s16_case rbr s2color rect VBar "rbar lo hi rep78 if rep78<., color(red)" "" "`w30_work'"
    _w30_expect OB-13 "(${S16_RC} == 0 & ${S16_OK} == 1)" `"rbar color(red): ${S16_MSG}"'
    global S16_STROKE "0"
    _w30_done OB-13 "area and rarea fill #486C8C, rbar color(red) fills #FF3333 and strokes #FF0000, in both modes"

    // OB-14: the band's intensity.
    _s16_case bd s2color path VArea "lfitci mpg weight, fintensity(150)" "" "`w30_work'"
    _w30_expect OB-14 "(${S16_RC} == 0 & ${S16_OK} == 1)" `"${S16_MSG}"'
    _w30_done OB-14 "lfitci, fintensity(150) draws its band #808080, as twoway does"

    // OB-15: sttrans's declared opacity beside the blend.
    _s16_case tr sttrans rect VBar "bar mpg rep78 if rep78<." "" "`w30_work'"
    _w30_expect OB-15 "(${S16_RC} == 0 & ${S16_OK} == 1)" `"${S16_MSG}"'
    _w30_done OB-15 "a sttrans bar is #486C8C at 0.20 in twoway and both modes"

    // OB-16: an unknown intensity name: twoway's note, dash's note, full.
    _s16_case ab s2color rect VBar "bar mpg rep78 if rep78<., fcolor(navy) fintensity(abc)" "" "`w30_work'"
    _w30_expect OB-16 "(${S16_RC} == 0 & ${S16_OK} == 1)" `"${S16_MSG}"'
    _w30_expect OB-16 "(${S16_NOTE} == 1)" "the two notes"
    _w30_done OB-16 "fintensity(abc) is noted by twoway and dash and drawn at full intensity, #1A476F"

    // OB-17: the served app after a filter move.
    _w30_expect OB-17 `"("`s16_after'" == "111")"' "after the move: `s16_after'"
    _w30_done OB-17 "the served scatter, bar and fintensity(50) bar redraw the same colours after a filter move"
    display as text "S16 end " c(current_date) " " c(current_time)
}
* ==== end S16 ====

// ----------------------------------------------------------------
// S17 helpers (python at the top level, where braces are safe).  Every
// argument crosses through sfi.Macro.getGlobal and every answer goes
// back through Macro.setGlobal; no macro text is pasted into Python.
//   _s17_svg()   S17_SVG -> S17_TW, twoway's key texts joined by "|"
//                (the texts right of the plot region less the last, the
//                key's title), and S17_YT, a histogram's y title word
//   _s17_page()  S17_PAGE, a saved page -> S17_D, the ColorBar's
//                override texts in tick order, else the colorvar
//                Legend's inner bounds, else a discrete key's labels;
//                S17_H, the HoverTool's second row label; S17_HF, its
//                first formatter's fmt,kind; S17_L0, the quad's left[0]
//   _s17_app()   S17_APP, a served app.py, and S17_MOVE -> S17_S and
//                S17_SH (the same summaries), S17_FIRED, S17_SAME_AFTER
//   _s17_twin()  S17_L0 -> S17_TWIN, dash's own text of that %td bin
// ----------------------------------------------------------------
python:
import html as _s17_html
import json as _s17_json
import os as _s17_os
import re as _s17_re
import sys as _s17_sys
import warnings as _s17_w
from sfi import Macro as _s17_M

_s17_repo = _s17_os.path.abspath("..")
for _s17_p in (_s17_os.path.join(_s17_repo, "scripts"), _s17_repo):
    if _s17_p not in _s17_sys.path:
        _s17_sys.path.insert(0, _s17_p)
import svg_truth as _s17_st

_S17_YT = ("Density", "Frequency", "Fraction", "Percent")


def _s17_set(name, val):
    _s17_M.setGlobal(name, str(val))


def _s17_svg():
    path = _s17_M.getGlobal("S17_SVG")
    pr = _s17_st.svg_plotregion(path) or {}
    texts = _s17_st.svg_texts(path)
    right = [t["text"] for t in texts
             if pr and t.get("x") is not None and t["x"] > pr["right"]]
    _s17_set("S17_TW", "|".join(right[:-1]))
    yt = [t["text"] for t in texts if t["text"] in _S17_YT]
    _s17_set("S17_YT", yt[0] if yt else "")


def _s17_bounds(labels):
    out = []
    for f in labels:
        for part in str(f).lstrip("≤>").split("–"):
            if part not in out:
                out.append(part)
    if labels and not str(labels[0]).startswith("≤"):
        out = out[1:-1]
    return out


def _s17_summary(bars, legends, tools, quads):
    """bars: [(ticks, {tick: text})]; legends: [labels]; tools:
    [(tooltips, [(fmt, kind)])]; quads: [left list]."""
    if bars and bars[0][0] is not None:
        ticks, ov = bars[0]
        d = "|".join(str(ov.get(float(t), "?")) for t in ticks)
    elif legends:
        labs = legends[0]
        b = _s17_bounds(labs)
        d = "|".join(b) if any("–" in str(x) or str(x)[:1] in ("≤", ">")
                               for x in labs) else "|".join(map(str, labs))
    else:
        d = "none"
    h, hf = "none", "none"
    if tools:
        tips, fmts = tools[0]
        if len(tips) > 1:
            h = str(tips[1][0])
        if fmts:
            hf = "%s,%s" % fmts[0]
    l0 = quads[0][0] if quads and len(quads[0]) else ""
    return d, h, hf, l0


def _s17_dec(v):
    if isinstance(v, dict):
        if v.get("type") == "ndarray":
            arr = v.get("array")
            if isinstance(arr, dict) and arr.get("type") == "bytes":
                import base64
                import numpy as _np
                import gzip
                raw = base64.b64decode(arr["data"])
                if raw[:2] == b"\x1f\x8b":
                    raw = gzip.decompress(raw)
                return _np.frombuffer(raw, dtype=v["dtype"]).tolist()
            return list(arr or [])
        if v.get("type") == "value":
            return v.get("value")
        if v.get("type") == "map":
            return {(_s17_dec(k) if not isinstance(k, str) else k): _s17_dec(x)
                    for k, x in v.get("entries", [])}
    return v


def _s17_page():
    try:
        with open(_s17_M.getGlobal("S17_PAGE"), encoding="utf-8") as fh:
            page = fh.read()
    except OSError:
        page = ""
    objs, stack = {}, []
    for blob in _s17_re.findall('<script type="application/json"[^>]*>(.*?)</script>', page, _s17_re.S):
        try:
            stack.append(_s17_json.loads(_s17_html.unescape(blob)))
        except ValueError:
            pass
    while stack:
        v = stack.pop(0)
        if isinstance(v, dict):
            if v.get("type") == "object" and "id" in v and "name" in v:
                objs.setdefault(v["id"], v)
            stack.extend(v.values())
        elif isinstance(v, list):
            stack.extend(v)

    def att(o):
        return o.get("attributes", {}) or {}

    def ref(v):
        if isinstance(v, dict) and "id" in v:
            return objs.get(v["id"], v)
        return v

    bars, legends, tools, quads = [], [], [], []
    for o in objs.values():
        a = att(o)
        if o["name"] == "ColorBar":
            t = ref(a.get("ticker"))
            ticks = None
            if isinstance(t, dict) and t.get("name") == "FixedTicker":
                ticks = _s17_dec(att(t).get("ticks", []))
            ov = _s17_dec(a.get("major_label_overrides", {})) or {}
            ov = {float(k): x for k, x in ov.items()}
            bars.append((ticks, ov))
        elif o["name"] == "Legend" and a.get("name") == "_dash_clegend":
            labs = []
            for it in a.get("items", []):
                it = ref(it)
                lab = _s17_dec(att(it).get("label"))
                labs.append(lab.get("value") if isinstance(lab, dict) else lab)
            legends.append(labs)
        elif o["name"] == "HoverTool":
            tips = _s17_dec(a.get("tooltips", []))
            fm = _s17_dec(a.get("formatters", {})) or {}
            fl = []
            for _k, m in fm.items():
                ma = att(ref(m))
                args = _s17_dec(ma.get("args", {})) or {}
                fl.append((args.get("fmt"), args.get("kind")))
            tools.append((tips, fl))
        elif o["name"] == "ColumnDataSource":
            data = _s17_dec(a.get("data", {})) or {}
            if "left" in data and "top" in data:
                quads.append([float(x) for x in _s17_dec(data["left"])])
    d, h, hf, l0 = _s17_summary(bars, legends, tools, quads)
    _s17_set("S17_D", d)
    _s17_set("S17_H", h)
    _s17_set("S17_HF", hf)
    _s17_set("S17_L0", l0)


def _s17_doc_summary(doc):
    from bokeh.models import (ColorBar, ColumnDataSource, FixedTicker,
                              HoverTool, Legend)
    import dash_render as _dr
    bars = [(list(c.ticker.ticks) if isinstance(c.ticker, FixedTicker)
             else None, {float(k): v for k, v in
                         dict(c.major_label_overrides).items()})
            for c in doc.select(dict(type=ColorBar))]
    legends = []
    for lg in doc.select(dict(type=Legend)):
        if str(lg.name or "") == _dr._COLORVAR_LEGEND_NAME:
            legends.append([getattr(it.label, "value", it.label)
                            if not isinstance(it.label, dict)
                            else it.label.get("value") for it in lg.items])
    tools = [(list(t.tooltips), [(m.args.get("fmt"), m.args.get("kind"))
                                 for m in dict(t.formatters or {}).values()
                                 if hasattr(m, "args")])
             for t in doc.select(dict(type=HoverTool))]
    quads = [list(map(float, s.data["left"]))
             for s in doc.select(dict(type=ColumnDataSource))
             if "left" in s.data and "top" in s.data]
    d, h, _hf, _l0 = _s17_summary(bars, legends, tools, quads)
    return d, h


def _s17_app():
    from bokeh.document import Document
    from bokeh.models import Select
    with open(_s17_M.getGlobal("S17_APP"), encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_s17_app")
    with _s17_w.catch_warnings():
        _s17_w.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_s17_app.py", "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    import bokeh.models as _bm
    figs = list(doc.select(dict(type=_bm.Plot)))
    before = sorted(_s17_fig_summary(fig) for fig in figs)
    _s17_set("S17_S", ";".join(b[0] for b in before))
    _s17_set("S17_SH", ";".join(b[1] for b in before))
    var = _s17_M.getGlobal("S17_MOVE")
    sel = [s for s in doc.select(dict(type=Select))
           if getattr(s, "_dash_var", None) == var]
    fired = 0
    if len(sel) == 1 and len(sel[0].options) > 1:
        old = sel[0].value
        opt = sel[0].options[1]
        new = opt[0] if isinstance(opt, (list, tuple)) else opt
        sel[0].value = new
        with _s17_w.catch_warnings():
            _s17_w.simplefilter("ignore")
            for cb in sel[0]._callbacks.get("value", []):
                cb("value", old, new)
                fired += 1
    _s17_set("S17_FIRED", fired)
    after = sorted(_s17_fig_summary(fig) for fig in figs)
    _s17_set("S17_SAME_AFTER", int(after == before))


def _s17_fig_summary(fig):
    class _One:
        def __init__(self, f):
            self.f = f

        def select(self, sel):
            return list(self.f.select(sel))
    return _s17_doc_summary(_One(fig))


def _s17_twin():
    import dash_render as _dr
    l0 = float(_s17_M.getGlobal("S17_L0") or "nan")
    _s17_set("S17_TWIN", _dr._dash_fmt_text(
        _dr._dash_stata_value_of(l0, "td"), "%td"))
end

capture program drop _s17_key
program define _s17_key
    // Twoway's command in S17_TWC, dash's in S17_DC (no saving()); the
    // page at `work'/`id'.html.  Leaves S17_TW and S17_D.
    version 19
    args id work
    capture graph drop s17tw
    quietly ${S17_TWC} name(s17tw, replace)
    quietly graph export "`work'/`id'.svg", name(s17tw) replace
    capture graph drop s17tw
    global S17_SVG "`work'/`id'.svg"
    python: __import__("__main__")._s17_svg()
    capture erase "`work'/`id'.html"
    quietly ${S17_DC} saving("`work'/`id'.html", replace)
    global S17_PAGE "`work'/`id'.html"
    python: __import__("__main__")._s17_page()
    capture erase "`work'/`id'.svg"
    capture erase "`work'/`id'.html"
    capture dash clear
end

* ==== S17 P1.23b: Date and format text in keys and tooltips ====
local only : env WP30_ONLY
if inlist("`only'", "", "S17") & `: list posof "S17" in w30_run' {
    display as text "S17 start " c(current_date) " " c(current_time)
    // DK-01..DK-03: a date colour key, its levels and its cuts.
    sysuse sp500, clear
    local i = 0
    foreach o in "" "colorlevels(3)" "colorcuts(15100 15200)" {
        local ++i
        global S17_TWC "twoway scatter close open, colorvar(date) `o'"
        global S17_DC  "dash scatter close open, colorvar(date) `o'"
        _s17_key dk0`i' "`w30_work'"
        local s17_d`i' "${S17_D}"
        if `i' == 1 local s17_w "15,000|15,100|15,200|15,300|15,400"
        if `i' == 2 local s17_w "15,098|15,219"
        if `i' == 3 local s17_w "15,100|15,200"
        _w30_expect DK-0`i' `"("${S17_TW}" == "`s17_w'")"' "twoway keys ${S17_TW}"
        _w30_expect DK-0`i' `"("${S17_D}" == "`s17_w'")"' "dash keys ${S17_D}"
        _w30_done DK-0`i' "colorvar(date) `o' keys `s17_w' in both"
    }

    // DK-04: zlabel(, format(%td)), zlabel(#3), zlabel(minmax).
    local j = 0
    foreach z in "zlabel(, format(%td))" "zlabel(#3)" "zlabel(minmax)" {
        local ++j
        global S17_TWC "twoway scatter close open, colorvar(date) `z'"
        global S17_DC  "dash scatter close open, colorvar(date) `z'"
        _s17_key dk04_`j' "`w30_work'"
        if `j' == 1 local s17_w "25jan2001|05may2001|13aug2001|21nov2001|01mar2002"
        if `j' == 2 local s17_w "15,000|15,200|15,400"
        if `j' == 3 local s17_w "14,977|15,340"
        _w30_expect DK-04 `"("${S17_TW}" == "`s17_w'")"' "twoway `z' keys ${S17_TW}"
        _w30_expect DK-04 `"("${S17_D}" == "`s17_w'")"' "dash `z' keys ${S17_D}"
    }
    _w30_done DK-04 "zlabel() format(%td), #3 and minmax key as twoway's"

    // DK-05: a %tm colour variable keys in months.
    quietly gen m = mofd(date)
    format m %tm
    global S17_TWC "twoway scatter close open, colorvar(m)"
    global S17_DC  "dash scatter close open, colorvar(m)"
    _s17_key dk05 "`w30_work'"
    _w30_expect DK-05 `"("${S17_TW}" == "490|495|500|505")"' "twoway keys ${S17_TW}"
    _w30_expect DK-05 `"("${S17_D}" == "490|495|500|505")"' "dash keys ${S17_D}"
    _w30_done DK-05 "colorvar(m) keys 490|495|500|505 in both"

    // DK-06: a %9.0g price keys %8.0gc, its bar and its cuts.
    sysuse auto, clear
    format price %9.0g
    local k = 0
    foreach o in "" "colorcuts(5000 9000)" {
        local ++k
        global S17_TWC "twoway scatter mpg weight, colorvar(price) `o'"
        global S17_DC  "dash scatter mpg weight, colorvar(price) `o'"
        _s17_key dk06_`k' "`w30_work'"
        if `k' == 1 local s17_w "0|5,000|10,000|15,000"
        if `k' == 2 local s17_w "5,000|9,000"
        _w30_expect DK-06 `"("${S17_TW}" == "`s17_w'")"' "twoway keys ${S17_TW}"
        _w30_expect DK-06 `"("${S17_D}" == "`s17_w'")"' "dash keys ${S17_D}"
    }
    _w30_done DK-06 "a %9.0g price keys 0|5,000|10,000|15,000 and 5,000|9,000 in both"

    // DK-07: the served app keys as the saved page, before and after a move.
    sysuse sp500, clear
    quietly gen byte up = close > open
    capture dash clear
    quietly dash scatter close open, colorvar(date) name(dk07a)
    quietly dash scatter close open, colorvar(date) colorlevels(3) name(dk07b)
    capture erase "`w30_work'/dk07.py"
    quietly dash build, server saving("`w30_work'/dk07.py", replace) nobrowser filter(up, type(dropdown))
    global S17_APP "`w30_work'/dk07.py"
    global S17_MOVE "up"
    python: __import__("__main__")._s17_app()
    local s17_both = cond("`s17_d1'" < "`s17_d2'", "`s17_d1';`s17_d2'", "`s17_d2';`s17_d1'")
    _w30_expect DK-07 `"("${S17_S}" == "`s17_both'")"' "served keys ${S17_S}"
    _w30_expect DK-07 `"(${S17_FIRED} >= 1)"' "no callback fired"
    _w30_expect DK-07 `"(${S17_SAME_AFTER} == 1)"' "the served keys changed after the move"
    _w30_done DK-07 "the served keys equal the saved ones, before and after a move"
    capture erase "`w30_work'/dk07.py"
    capture dash clear

    // DK-08: the histogram's height row is named as twoway titles its axis.
    local s17_l0 ""
    foreach h in "" "frequency" "fraction" "percent" {
        local c = cond("`h'" == "", ",", ", `h'")
        capture graph drop s17tw
        quietly twoway histogram date `c' name(s17tw, replace)
        quietly graph export "`w30_work'/dk08.svg", name(s17tw) replace
        capture graph drop s17tw
        global S17_SVG "`w30_work'/dk08.svg"
        python: __import__("__main__")._s17_svg()
        local c2 = cond("`h'" == "", ",", ", `h'")
        quietly dash histogram date `c2' saving("`w30_work'/dk08.html", replace)
        global S17_PAGE "`w30_work'/dk08.html"
        python: __import__("__main__")._s17_page()
        _w30_expect DK-08 `"("${S17_H}" == "${S17_YT}" & "${S17_YT}" != "")"' "histogram `h': dash ${S17_H}, twoway ${S17_YT}"
        if "`h'" == "" {
            local s17_hf "${S17_HF}"
            local s17_l0 "${S17_L0}"
        }
        if "`h'" == "frequency" {
            capture dash clear
            quietly dash histogram date, frequency name(dk08f)
            quietly dash build, server saving("`w30_work'/dk08.py", replace) nobrowser
            global S17_APP "`w30_work'/dk08.py"
            global S17_MOVE "none"
            python: __import__("__main__")._s17_app()
            _w30_expect DK-08 `"("${S17_SH}" == "Frequency")"' "served frequency row ${S17_SH}"
            capture erase "`w30_work'/dk08.py"
        }
        capture erase "`w30_work'/dk08.svg"
        capture erase "`w30_work'/dk08.html"
        capture dash clear
    }
    _w30_done DK-08 "Density, Frequency, Fraction and Percent name the height row as twoway titles the axis"

    // DK-09: the bins are written as the %td dates twoway shows.
    local s = string(14977, "%td")
    global S17_L0 "`s17_l0'"
    python: __import__("__main__")._s17_twin()
    _w30_expect DK-09 `"("`s17_hf'" == "%td,td")"' "formatter `s17_hf'"
    _w30_expect DK-09 `"("${S17_TWIN}" == "`s'")"' "first bin ${S17_TWIN}, Stata `s'"
    _w30_done DK-09 "a date histogram's bins are written %td (02jan2001) as Stata displays them"
    display as text "S17 end " c(current_date) " " c(current_time)
}
* ==== end S17 ====

// S18's helpers (WP-30 P1.5), outside every gate, where a python block
// may hold braces.  Readers in the form of WP-29 S03's _s03_models /
// _S03Saved / _S03Served:
//   _s18_page()  S18_X S18_Y S18_Y2: "<fmt>|<kind>" of the first figure's
//                axis writer on the saved page S18_PAGE, or "-"
//   _s18_app()   the same of the served app S18_APP; with S18_MOVE set,
//                first fires the RangeSlider over it to its upper quarter
//   _s18_twoway() S18_TX S18_TY S18_TY2: twoway's labels in S18_SVG ("|")
//   _s18_text()  S18_SAME: 1 when dash's writer S18_FK ("<fmt>|<kind>")
//                writes every label S18_TW at the values S18_TV hold
python:
import json as _s18_json, re as _s18_re, html as _s18_html, sys as _s18_sys
import warnings as _s18_w
from sfi import Macro as _s18_M


def _s18_objs(path):
    with open(path, encoding="utf-8") as fh:
        page = fh.read()
    objs, stack = {}, []
    for blob in _s18_re.findall('<script type="application/json"[^>]*>(.*?)</script>', page, _s18_re.S):
        try:
            stack.append(_s18_json.loads(_s18_html.unescape(blob)))
        except ValueError:
            pass
    while stack:
        v = stack.pop()
        if isinstance(v, dict):
            if v.get("type") == "object" and "id" in v and "name" in v:
                objs.setdefault(v["id"], v)
            stack.extend(v.values())
        elif isinstance(v, list):
            stack.extend(v)
    return objs


def _s18_map(v):
    if isinstance(v, dict) and v.get("type") == "map":
        return {k: x for k, x in v.get("entries", [])}
    return v if isinstance(v, dict) else {}


def _s18_side(axes, rattr, second):
    for a in axes:
        rn = a("rn")
        if (rn == second) if second else (rn in (None, "default")):
            return a("fk")
    return "-"


def _s18_set(prefix, sides):
    for k, v in sides.items():
        _s18_M.setGlobal(prefix + k, v)


def _s18_saved_sides(path):
    objs = _s18_objs(path)

    def obj(v):
        if isinstance(v, dict) and "attributes" not in v and "id" in v:
            return objs.get(v["id"], {})
        return v or {}

    figs = [o for o in objs.values() if o["name"] == "Figure"]
    figs.sort(key=lambda o: o["id"])
    if not figs:
        return {"X": "-", "Y": "-", "Y2": "-"}
    at = figs[0].get("attributes", {})

    def wrap(ax, rattr):
        ax = obj(ax)
        aa = ax.get("attributes", {}) or {}
        fm = obj(aa.get("formatter"))
        args = _s18_map((fm.get("attributes", {}) or {}).get("args"))
        fk = ("%s|%s" % (args["fmt"], args.get("kind", ""))) if "fmt" in args else "-"
        return lambda what: aa.get(rattr) if what == "rn" else fk

    def axes(lst):
        return [a for a in lst if obj(a).get("name", "").endswith("Axis")]

    xs = [wrap(a, "x_range_name") for a in axes(at.get("below", []) + at.get("above", []))]
    ys = [wrap(a, "y_range_name") for a in axes(at.get("left", []) + at.get("right", []))]
    return {"X": _s18_side(xs, "x", ""), "Y": _s18_side(ys, "y", ""),
            "Y2": _s18_side(ys, "y", "y2")}


def _s18_doc_sides(doc):
    from bokeh.plotting import figure as _fig
    figs = [m for r in doc.roots for m in r.references() if isinstance(m, _fig)]
    figs.sort(key=lambda f: f.id)
    if not figs:
        return {"X": "-", "Y": "-", "Y2": "-"}
    f = figs[0]

    def wrap(ax, rattr):
        args = getattr(ax.formatter, "args", None) or {}
        fk = ("%s|%s" % (args["fmt"], args.get("kind", ""))) if "fmt" in args else "-"
        return lambda what: getattr(ax, rattr, None) if what == "rn" else fk

    from bokeh.models import Axis as _ax
    xs = [wrap(a, "x_range_name") for a in list(f.below) + list(f.above)
          if isinstance(a, _ax)]
    ys = [wrap(a, "y_range_name") for a in list(f.left) + list(f.right)
          if isinstance(a, _ax)]
    return {"X": _s18_side(xs, "x", ""), "Y": _s18_side(ys, "y", ""),
            "Y2": _s18_side(ys, "y", "y2")}


def _s18_page():
    _s18_set("S18_", _s18_saved_sides(_s18_M.getGlobal("S18_PAGE")))


def _s18_app():
    from bokeh.document import Document
    from bokeh.models import RangeSlider
    with open(_s18_M.getGlobal("S18_APP"), encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_s18_app")
    exec(compile(src.replace(attach, "pass"), "dash_s18_app.py", "exec"), ns)
    with _s18_w.catch_warnings():
        _s18_w.simplefilter("ignore")
        doc = Document()
        ns["make_document"](doc)
    var = _s18_M.getGlobal("S18_MOVE")
    fired = 0
    if var:
        sl = [s for s in doc.select(dict(type=RangeSlider))
              if getattr(s, "_dash_var", None) == var]
        if len(sl) == 1:
            old = sl[0].value
            lo, hi = old
            new = (lo + (hi - lo) / 4.0, hi)
            sl[0].value = new
            with _s18_w.catch_warnings():
                _s18_w.simplefilter("ignore")
                for attr in ("value", "value_throttled"):
                    for cb in sl[0]._callbacks.get(attr, []):
                        cb(attr, old, new)
                        fired += 1
    _s18_M.setGlobal("S18_FIRED", str(fired))
    _s18_set("S18_S", _s18_doc_sides(doc))


def _s18_twoway():
    _s18_sys.path.insert(0, _s18_M.getGlobal("cert_svg_scripts"))
    import svg_truth
    path = _s18_M.getGlobal("S18_SVG")
    doc = svg_truth.svg_document(path)
    for ax, g in (("x", "S18_TX"), ("y", "S18_TY")):
        r = svg_truth.svg_axis_reading(path, ax, doc=doc)
        _s18_M.setGlobal(g, "|".join(str(t) for t in (r.get("labels") or [])))
    pr = doc["plotregion"]
    cand = [t for t in doc["texts"] if pr and t["x"] is not None
            and t["x"] > pr["right"]]
    if cand:
        near = min(c["x"] for c in cand)
        row = sorted([c for c in cand if abs(c["x"] - near) < 2.5],
                     key=lambda t: -t["y"])
        _s18_M.setGlobal("S18_TY2", "|".join(c["text"] for c in row))
    else:
        _s18_M.setGlobal("S18_TY2", "")


def _s18_text():
    import os as _s18_os
    _s18_sys.path.insert(0, _s18_os.path.dirname(_s18_M.getGlobal("cert_svg_scripts")))
    import dash_render as _dr
    fmt, _, kind = _s18_M.getGlobal("S18_FK").partition("|")
    want = [t for t in _s18_M.getGlobal("S18_TW").split("|") if t]
    vals = [t for t in _s18_M.getGlobal("S18_TV").split("|") if t]
    same = int(bool(want) and len(want) == len(vals))
    for w, v in zip(want, vals):
        try:
            num = float(v.replace(",", ""))
        except ValueError:
            same = 0
            break
        if _dr._dash_fmt_text(num, fmt) != w:
            same = 0
    _s18_M.setGlobal("S18_SAME", str(same))
end

* ==== S18 P1.5: Axis format fallbacks ====
local only : env WP30_ONLY
if inlist("`only'", "", "S18") & `: list posof "S18" in w30_run' {
    display as text "S18 start " c(current_date) " " c(current_time)
    local d "`w30_work'"
    // AF-20..AF-26 and AF-29: twoway's labels, then dash's writer on the
    // same axis, saved and served (WP-30 P1.5; measured 03oct2026).
    foreach c in 20 21 22 23 24 25 26 29 {
        local data auto
        local filt ""
        local move ""
        if `c' == 20 local cmd "scatter mpg weight"
        if `c' == 29 {
            local cmd "scatter mpg weight"
            local filt "filter(weight, type(range))"
            local move "weight"
        }
        if `c' == 21 local cmd "histogram price"
        if `c' == 22 local cmd "(lfit price weight) (scatter price weight)"
        if `c' == 23 {
            local data sp500
            local cmd "line close date, xlabel(, format(%9.0fc))"
        }
        if `c' == 24 {
            local data sp500
            local cmd "line close date, xlabel(, format(%tdDD/NN/CCYY))"
        }
        if `c' == 25 local cmd "(scatter mpg weight) (scatter price weight, yaxis(2)),"
        if `c' == 26 local cmd "scatter mpg weight, xvarformat(%9.2f) yvarformat(%9.1f)"
        sysuse `data', clear
        capture dash clear
        capture graph drop _all
        capture noisily twoway `cmd'
        _w30_expect AF-`c' "(_rc == 0)" "twoway rc `_rc'"
        cert_svg_export, file("`d'/af`c'.svg")
        global S18_SVG "`d'/af`c'.svg"
        python: _s18_twoway()
        if `c' == 24 {
            // The day numbers twoway labels at, from the numeric twin.
            capture noisily twoway line close date, xlabel(, format(%9.0f))
            cert_svg_export, file("`d'/af24v.svg")
            global S18_SVG "`d'/af24v.svg"
            local s18_tx "$S18_TX"
            python: _s18_twoway()
            global S18_TV "$S18_TX"
            global S18_TX "`s18_tx'"
        }
        local tw_x "$S18_TX"
        local tw_y "$S18_TY"
        local tw_y2 "$S18_TY2"
        if strpos("`cmd'", ",") capture noisily dash `cmd' name(af`c')
        else capture noisily dash `cmd', name(af`c')
        _w30_expect AF-`c' "(_rc == 0)" "dash rc `_rc'"
        capture erase "`d'/af`c'.html"
        capture erase "`d'/af`c'_app.py"
        capture noisily dash build, saving("`d'/af`c'.html") replace nobrowser `filt'
        _w30_expect AF-`c' "(_rc == 0)" "saved build rc `_rc'"
        capture noisily dash build, saving("`d'/af`c'_app.py") server replace `filt'
        _w30_expect AF-`c' "(_rc == 0)" "served build rc `_rc'"
        global S18_PAGE "`d'/af`c'.html"
        global S18_APP "`d'/af`c'_app.py"
        global S18_MOVE "`move'"
        python: _s18_page()
        python: _s18_app()
        display as text `"  AF-`c' twoway x [`tw_x'] y [`tw_y'] y2 [`tw_y2']"'
        display as text `"  AF-`c' saved [$S18_X][$S18_Y][$S18_Y2] served [$S18_SX][$S18_SY][$S18_SY2] fired $S18_FIRED"'
        _w30_expect AF-`c' `"("$S18_X" == "$S18_SX" & "$S18_Y" == "$S18_SY" & "$S18_Y2" == "$S18_SY2")"' "saved and served differ"
        local side ""
        local want ""
        if inlist(`c', 20, 29) {
            local side X
            local want "%8.0gc|"
            local tw "`tw_x'"
            _w30_expect AF-`c' `"("`tw_x'" == "2,000|3,000|4,000|5,000")"' "twoway x `tw_x'"
        }
        if `c' == 21 {
            local side Y
            local want "%6.4g|"
            local tw "`tw_y'"
            _w30_expect AF-`c' `"(strpos("|`tw_y'|", "|1.0e-04|") > 0)"' "twoway y `tw_y'"
        }
        if `c' == 22 {
            local side X
            local want "%9.0g|"
            local tw "`tw_x'"
            _w30_expect AF-`c' `"("$S18_Y" == "%9.0g|")"' "dash y $S18_Y"
        }
        if `c' == 23 {
            local side X
            local want "%9.0fc|td"
            local tw "`tw_x'"
            _w30_expect AF-`c' `"(substr("`tw_x'", 1, 6) == "14,976")"' "twoway x `tw_x'"
        }
        if `c' == 24 {
            local side X
            local want "%tdDD/NN/CCYY|td"
            local tw "`tw_x'"
            _w30_expect AF-`c' `"(substr("`tw_x'", 1, 10) == "01/01/2001")"' "twoway x `tw_x'"
        }
        if `c' == 25 {
            local side Y2
            local want "%8.0gc|"
            local tw "`tw_y2'"
            _w30_expect AF-`c' `"(strpos("|`tw_y2'|", "|5,000|") > 0)"' "twoway y2 `tw_y2'"
        }
        if `c' == 26 {
            local side X
            local want "%9.2f|"
            local tw "`tw_x'"
            _w30_expect AF-`c' `"("$S18_Y" == "%9.1f|")"' "dash y $S18_Y"
        }
        _w30_expect AF-`c' `"("${S18_`side'}" == "`want'" & "${S18_S`side'}" == "`want'")"' "dash `side' ${S18_`side'} / ${S18_S`side'}, want `want'"
        global S18_FK "`want'"
        global S18_TW "`tw'"
        if `c' != 24 global S18_TV "`tw'"
        python: _s18_text()
        _w30_expect AF-`c' "($S18_SAME == 1)" "dash's writer does not write twoway's `tw'"
        if `c' == 29 {
            _w30_expect AF-`c' "($S18_FIRED >= 1)" "the slider callback did not fire"
        }
        _w30_done AF-`c' "`cmd': `side' `want' writes `tw'"
        capture dash clear
    }
    // AF-27, AF-28: twoway's refusal and dash's, rc and words.
    sysuse auto, clear
    foreach c in 27 28 {
        if `c' == 27 {
            local tcmd "twoway scatter mpg weight, xlabel(, format(bogus))"
            local dcmd "dash scatter mpg weight, xlabel(, format(bogus)) name(af27)"
            local needle "invalid format, bogus"
        }
        else {
            local tcmd "twoway (scatter mpg weight) (scatter mpg length), xvarformat(%9.2f)"
            local dcmd "dash (scatter mpg weight) (scatter mpg length), xvarformat(%9.2f) name(af28)"
            local needle "option xvarformat() not allowed"
        }
        capture log close s18l
        log using "`d'/af`c't.log", text replace name(s18l)
        capture noisily `tcmd'
        local trc = _rc
        log close s18l
        capture dash clear
        log using "`d'/af`c'd.log", text replace name(s18l)
        capture noisily `dcmd'
        local drc = _rc
        log close s18l
        _w30_expect AF-`c' "(`trc' == 198 & `drc' == 198)" "rc twoway `trc' dash `drc'"
        cert_log_has "`d'/af`c't.log", needle("`needle'")
        _w30_expect AF-`c' "(r(found) == 1)" "twoway's log lacks `needle'"
        cert_log_has "`d'/af`c'd.log", needle("`needle'")
        _w30_expect AF-`c' "(r(found) == 1)" "dash's log lacks `needle'"
        _w30_done AF-`c' "twoway and dash both refuse, r(198) `needle'"
    }
    display as text "S18 end " c(current_date) " " c(current_time)
}
* ==== end S18 ====

// S19's helpers (WP-30 P1.16), outside every gate, where a python block
// may hold braces: a copy of WP-29 S03's readers (test_wp29_truth.cscript)
// re-prefixed _s19_, with one summary of keys and titles:
//   _s19_page()        S19_K (each visible series legend's labels sorted and
//                      joined by "|", legends joined by ";") and S19_T
//                      ("y1=..|y2=..|x1=..|x2=..", the distinct non-empty
//                      axis titles per side) of the saved page S19_PAGE
//   _s19_app()         the same, S19_SK and S19_ST, of the served app
//                      S19_APP; with S19_MOVE set, fires its RangeSlider and
//                      sets S19_FIRED and S19_SAME
//   _s19_twoway_keys() S19_TK: twoway's keys, S19_BARE minus S19_OFF, numbers
//                      dropped, sorted and joined by "|"
//   _s19_case          one probe: twoway, the saved page and the served app
//                      against twoway's measured value
python:
import collections as _s19_col, json as _s19_json, re as _s19_re, html as _s19_html
import warnings as _s19_w
import __main__ as _s19_main
from sfi import Macro as _s19_M

_S19_AXES = ("LinearAxis", "LogAxis", "DatetimeAxis", "CategoricalAxis")
_S19_WIDGETS = ("Select", "RangeSlider", "Slider", "DateRangeSlider", "DateSlider")


def _s19_val(v):
    if isinstance(v, dict):
        return v.get("value")
    inner = getattr(v, "value", None)
    return v if inner is None else inner


def _s19_models(path):
    try:
        with open(path, encoding="utf-8") as fh:
            page = fh.read()
    except OSError:
        return []
    objs, stack = {}, []
    for blob in _s19_re.findall('<script type="application/json"[^>]*>(.*?)</script>', page, _s19_re.S):
        try:
            stack.append(_s19_json.loads(_s19_html.unescape(blob)))
        except ValueError:
            pass
    while stack:
        v = stack.pop()
        if isinstance(v, dict):
            if v.get("type") == "object" and "id" in v and "name" in v:
                objs.setdefault(v["id"], v)
            stack.extend(v.values())
        elif isinstance(v, list):
            stack.extend(v)
    return list(objs.values())


class _S19Saved:
    """A saved page's model, read as the served one is."""

    def __init__(self, obj):
        self.kind = obj["name"]
        self.attrs = obj.get("attributes", {}) or {}
        self._defaults = None

    def get(self, attr):
        if attr in self.attrs:
            return _s19_val(self.attrs[attr])
        if self._defaults is None:
            import bokeh.models as _bm
            try:
                self._defaults = getattr(_bm, self.kind)()
            except Exception:
                self._defaults = False
        return _s19_val(getattr(self._defaults, attr, None)) if self._defaults else None


class _S19Served:
    def __init__(self, model):
        self.kind = type(model).__name__
        self.model = model

    def get(self, attr):
        return _s19_val(getattr(self.model, attr, None))


_S19_SIDES = (("left", "y1"), ("right", "y2"), ("below", "x1"), ("above", "x2"))


def _s19_summary(models, by_id):
    sides = dict((k, set()) for _a, k in _S19_SIDES)
    keys = set()
    for m in models:
        # A served figure's class is bokeh.plotting's lower-case "figure".
        if m.kind in ("Figure", "figure", "Plot"):
            for attr, k in _S19_SIDES:
                for ref in (m.get(attr) or []):
                    a = by_id(ref)
                    if a is not None and a.kind in _S19_AXES:
                        lab = a.get("axis_label")
                        if lab not in (None, ""):
                            sides[k].add(str(lab))
        elif (m.kind == "Legend" and m.get("name") != "_dash_clegend"
              and m.get("visible") is not False):
            one = []
            for it in (m.get("items") or []):
                item = by_id(it)
                if item is not None:
                    lab = item.get("label")
                    one.append("" if lab is None else str(lab))
            keys.add("|".join(sorted(one)))
    return dict(K=";".join(sorted(keys)),
                T="|".join("%s=%s" % (k, ";".join(sorted(sides[k])))
                           for _a, k in _S19_SIDES))


def _s19_set(prefix, summ):
    for k, v in summ.items():
        _s19_M.setGlobal(prefix + k, v)


def _s19_page():
    objs = _s19_models(_s19_M.getGlobal("S19_PAGE"))
    by = dict((o["id"], _S19Saved(o)) for o in objs)
    models = [by[o["id"]] for o in objs]

    def by_id(ref):
        rid = ref.get("id") if isinstance(ref, dict) else getattr(ref, "id", None)
        return by.get(rid)
    _s19_set("S19_", _s19_summary(models, by_id))


def _s19_doc_summary(doc):
    from bokeh.model import Model
    seen = dict()
    for root in doc.roots:
        for m in root.references():
            seen[m.id] = m
    wrapped = [_S19Served(m) for m in seen.values()]

    def by_id(ref):
        return _S19Served(ref) if ref is not None else None
    return _s19_summary(wrapped, by_id)


def _s19_app():
    from bokeh.document import Document
    from bokeh.models import RangeSlider
    with open(_s19_M.getGlobal("S19_APP"), encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_s19_app")
    with _s19_w.catch_warnings():
        _s19_w.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_s19_app.py", "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    before = _s19_doc_summary(doc)
    _s19_set("S19_S", before)
    var = _s19_M.getGlobal("S19_MOVE")
    sl = [s for s in doc.select(dict(type=RangeSlider)) if getattr(s, "_dash_var", None) == var]
    fired = 0
    if len(sl) == 1:
        old = sl[0].value
        lo, hi = old
        new = (lo + (hi - lo) / 4.0, hi)
        sl[0].value = new
        with _s19_w.catch_warnings():
            _s19_w.simplefilter("ignore")
            for attr in ("value", "value_throttled"):
                for cb in sl[0]._callbacks.get(attr, []):
                    cb(attr, old, new)
                    fired += 1
    _s19_M.setGlobal("S19_FIRED", str(fired))
    _s19_M.setGlobal("S19_SAME", str(int(_s19_doc_summary(doc) == before)))


def _s19_lines(path):
    with open(path, encoding="utf-8") as fh:
        return [_s19_json.loads(s) for s in fh if s.strip()]


def _s19_twoway_keys():
    bare = _s19_lines(_s19_M.getGlobal("S19_BARE"))
    off = _s19_lines(_s19_M.getGlobal("S19_OFF"))
    left = _s19_col.Counter(e["text"] for e in bare) - _s19_col.Counter(e["text"] for e in off)
    seen, out = _s19_col.Counter(), []
    for e in bare:
        if seen[e["text"]] < left.get(e["text"], 0):
            seen[e["text"]] += 1
            try:
                float(e["text"].replace(",", "").replace("\u2212", "-"))
                continue
            except ValueError:
                pass
            out.append(e["text"])
    _s19_M.setGlobal("S19_TK", "|".join(sorted(out)))


_s19_main._s19_page = _s19_page
_s19_main._s19_app = _s19_app
_s19_main._s19_twoway_keys = _s19_twoway_keys
end

capture program drop _s19_case
program define _s19_case
    version 19
    // id; what = keys | titles | keys-move | titles-move; body; options
    // ("" for none); want = twoway's measured value, keys sorted and joined
    // by "|", titles "y1=..|y2=..|x1=..|x2=..".
    args id what body opts want
    local d "${S19_WORK}"
    quietly twoway `body', `opts' name(Graph, replace)
    local t1 ""
    local t2 ""
    local t3 ""
    local t4 ""
    capture local t1 `"`.Graph.yaxis1.title.text[1]'"'
    capture local t3 `"`.Graph.xaxis1.title.text[1]'"'
    capture local t2 `"`.Graph.yaxis2.title.text[1]'"'
    capture local t4 `"`.Graph.xaxis2.title.text[1]'"'
    // A by() graph draws its shared titles as its l1title and b1title.
    if strpos(`"`opts'"', "by(") {
        capture local t1 `"`.Graph.l1title.text[1]'"'
        capture local t3 `"`.Graph.b1title.text[1]'"'
    }
    global S19_TWT `"y1=`t1'|y2=`t2'|x1=`t3'|x2=`t4'"'
    global S19_TK ""
    if strpos("`what'", "keys") {
        cert_svg_export, name(Graph) file("`d'/`id'_bare.svg")
        cert_svg_texts, file("`d'/`id'_bare.svg")
        global S19_BARE "`r(list)'"
        quietly twoway `body', `opts' legend(off) name(s19o, replace)
        cert_svg_export, name(s19o) file("`d'/`id'_off.svg")
        cert_svg_texts, file("`d'/`id'_off.svg")
        global S19_OFF "`r(list)'"
        python: __import__("__main__")._s19_twoway_keys()
    }
    local f ""
    if strpos("`what'", "move") local f "filter(weight, type(range))"
    capture dash clear
    capture noisily dash `body', `opts' name(s19g)
    _w30_expect `id' "(_rc == 0)" "dash rc `_rc'"
    capture noisily dash build, saving("`d'/s19g.html") replace nobrowser `f'
    _w30_expect `id' "(_rc == 0)" "dash build rc `_rc'"
    capture noisily dash build, server saving("`d'/s19g_app.py") replace nobrowser `f'
    _w30_expect `id' "(_rc == 0)" "dash build, server rc `_rc'"
    global S19_PAGE "`d'/s19g.html"
    global S19_APP "`d'/s19g_app.py"
    global S19_MOVE = cond("`f'" == "", "", "weight")
    python: __import__("__main__")._s19_page()
    python: __import__("__main__")._s19_app()
    if strpos("`what'", "keys") {
        local a : copy global S19_TK
        local b : copy global S19_K
        local c : copy global S19_SK
    }
    else {
        local a : copy global S19_TWT
        local b : copy global S19_T
        local c : copy global S19_ST
    }
    local ok = (`"`a'"' == `"`want'"') & (`"`b'"' == `"`want'"') & (`"`c'"' == `"`want'"')
    display as text `"  `id' twoway [`a'] saved [`b'] served [`c']"'
    _w30_expect `id' "(`ok' == 1)" `"twoway `a', saved `b', served `c', want `want'"'
    if "`f'" != "" {
        _w30_expect `id' "(${S19_FIRED} > 0 & ${S19_SAME} == 1)" "served move fired ${S19_FIRED}, same ${S19_SAME}"
    }
    foreach x in `id'_bare.svg `id'_off.svg s19g.html s19g_app.py {
        capture erase "`d'/`x'"
    }
    capture erase "${S19_BARE}"
    capture erase "${S19_OFF}"
    capture graph drop Graph s19o
end

* ==== S19 P1.16: Legend keys and default axis titles ====
local only : env WP30_ONLY
if inlist("`only'", "", "S19") & `: list posof "S19" in w30_run' {
    display as text "S19 start " c(current_date) " " c(current_time)
    global S19_WORK "`w30_work'"
    sysuse auto, clear

    // KT-01: the fits are keyed in twoway's text (F01, F03, F30, F15).
    _s19_case KT-01 keys "(scatter mpg weight) (lowess mpg weight)" "" "Mileage (mpg)|lowess mpg weight"
    _s19_case KT-01 keys "(scatter mpg weight) (lpoly mpg weight)" "" "Mileage (mpg)|lpoly smooth: Mileage (mpg)"
    _s19_case KT-01 keys "(mband mpg weight) (mspline mpg weight)" "" "Median bands|Median spline"
    _s19_case KT-01 keys "(scatter mpg weight) (fpfit mpg weight)" "" "Mileage (mpg)|Predicted mpg"
    _w30_done KT-01 "lowess, lpoly, mband, mspline and fpfit keyed in twoway's text in both modes"

    // KT-02: a function is keyed by its own name (N01, N02, F28), and the
    // spec dash.ado registers carries it.
    _s19_case KT-02 keys "(function _y = x, range(0 1))" "legend(on)" "_y"
    _s19_case KT-02 keys "(function ü = x, range(0 1))" "legend(on)" "ü"
    _s19_case KT-02 keys "(scatter mpg weight) (function z=x/100, range(2000 5000))" "" "Mileage (mpg)|z"
    mata: st_local("s19_yn", strofreal(strpos(st_global("dash_json_s19g"), char(34) + "expr" + char(34) + ":" + char(34) + "x/100" + char(34) + "," + char(34) + "yname" + char(34) + ":" + char(34) + "z" + char(34)) > 0))
    _w30_expect KT-02 "(`s19_yn' == 1)" "the registered spec does not carry expr x/100 and yname z"
    _w30_done KT-02 "a function layer is keyed by the name before its =, in both modes"

    // KT-03: range and pc layers join both variables (R04, P01).
    _s19_case KT-03 keys "(rcap mpg turn weight)" "legend(on)" "Mileage (mpg)/Turn circle (ft.)"
    _s19_case KT-03 keys "(pcspike mpg weight turn length)" "legend(on)" "Mileage (mpg)/Turn circle (ft.)"
    _w30_done KT-03 "rcap and pcspike keyed L(y1)/L(y2) in both modes"

    // KT-04: scatteri and pci (I01, I05).
    _s19_case KT-04 keys "(scatteri 20 3000 25 3500)" "legend(on)" "y"
    _s19_case KT-04 keys "(scatter mpg weight) (pci 20 3000 25 3500)" "" "Mileage (mpg)|y/yb"
    _w30_done KT-04 "scatteri keyed y and pci y/yb in both modes"

    // KT-05: the served keys survive a filter move.
    _s19_case KT-05 keys-move "(scatter mpg weight) (lowess mpg weight)" "" "Mileage (mpg)|lowess mpg weight"
    _w30_done KT-05 "the served app keeps twoway's keys after a filter move"

    // KT-06..KT-11: default titles by the first-equals-last rule.
    _s19_case KT-06 titles "(scatter mpg weight) (scatter mpg length) (scatter mpg weight)" "" "y1=Mileage (mpg)|y2=|x1=Weight (lbs.)|x2="
    _s19_case KT-06 titles "(scatter mpg weight) (scatter mpg length) (scatter mpg length)" "" "y1=Mileage (mpg)|y2=|x1=|x2="
    _w30_done KT-06 "an axis is titled when its first and last series agree (K01, K02)"
    _s19_case KT-07 titles "(scatter mpg weight) (scatter price weight)" "" "y1=|y2=|x1=Weight (lbs.)|x2="
    _s19_case KT-07 titles "(lpoly mpg weight)" "legend(on)" "y1=lpoly smooth: Mileage (mpg)|y2=|x1=lpoly smoothing grid|x2="
    _w30_done KT-07 "differing layers leave the axis untitled; a fit titles it in its own text (M01, F04)"
    _s19_case KT-08 titles "(rcap mpg turn weight)" "" "y1=Mileage (mpg)/Turn circle (ft.)|y2=|x1=Weight (lbs.)|x2="
    _s19_case KT-08 titles "(pcspike mpg weight turn length)" "" "y1=Mileage (mpg)/Turn circle (ft.)|y2=|x1=Weight (lbs.)/Length (in.)|x2="
    _s19_case KT-08 titles "(function y=x^2, range(0 2))" "" "y1=y|y2=|x1=x|x2="
    _w30_done KT-08 "range, pc and function layers are titled as twoway titles them (R04, P01, F10)"
    _s19_case KT-09 titles "(scatter mpg weight) (lfit price weight, yaxis(2))" "" "y1=Mileage (mpg)|y2=Fitted values|x1=Weight (lbs.)|x2="
    _s19_case KT-09 titles "(scatter mpg weight) (scatter mpg weight, yaxis(2)) (scatter price weight, yaxis(2))" "" "y1=Mileage (mpg)|y2=|x1=Weight (lbs.)|x2="
    _s19_case KT-09 titles "(scatter mpg weight) (rcap mpg turn weight, yaxis(2))" "" "y1=Mileage (mpg)|y2=Mileage (mpg)/Turn circle (ft.)|x1=Weight (lbs.)|x2="
    _w30_done KT-09 "axis 2 is titled by its own series (M07, M12, G23)"
    _s19_case KT-10 titles "(scatter mpg weight) (scatter price weight)" "by(foreign)" "y1=|y2=|x1=Weight (lbs.)|x2="
    _s19_case KT-10 titles "(rcap mpg turn weight)" "by(foreign)" "y1=Mileage (mpg)/Turn circle (ft.)|y2=|x1=Weight (lbs.)|x2="
    _w30_done KT-10 "every by() panel follows the rule (G05, G20)"
    _s19_case KT-11 titles-move "(scatter mpg weight) (scatter price weight)" "" "y1=|y2=|x1=Weight (lbs.)|x2="
    _w30_done KT-11 "the served app keeps the default titles after a filter move"

    capture dash clear
    macro drop S19_*
    display as text "S19 end " c(current_date) " " c(current_time)
}
* ==== end S19 ====

// S20 (WP-30 P1.1b) helpers.  Each sets a global to a JSON reading of
// one drawing, series in order: labels [count, first text] per label
// group, bars [bottom, width] per bar series, x the field or the jittered
// state of each marker series.
//   _s20_svg()   S20_TW  from the live twoway SVG S20_SVG
//   _s20_page()  S20_PG  from the saved page S20_PAGE's Bokeh document
//   _s20_app()   S20_AP  from the served app S20_APP, executed unserved
python:
import json as _s20_json, re as _s20_re, html as _s20_html, os as _s20_os, sys as _s20_sys
import warnings as _s20_w
from sfi import Macro as _s20_M


def _s20_svg():
    _s20_sys.path.insert(0, _s20_os.path.join(_s20_M.getGlobal("S11_REPO"), "scripts"))
    import svg_truth
    path = _s20_M.getGlobal("S20_SVG")
    doc = svg_truth.svg_document(path)
    labels = []
    for t in doc["texts"]:
        f = t.get("fill") or ""
        if not f or f == "#000000":
            continue
        if labels and labels[-1][0] == f:
            labels[-1][1] += 1
        else:
            labels.append([f, 1, t["text"]])
    pr = doc["plotregion"]
    bars, jit = {}, {}
    if _s20_M.getGlobal("S20_KIND") == "G":
        fy = svg_truth.svg_axis_reading(path, "y", doc=doc)["fit"]
        fx = svg_truth.svg_axis_reading(path, "x", doc=doc)["fit"]
        for r in doc["rects"]:
            if None in (r["x"], r["y"], r["w"], r["h"]) or r["fill"] in (None, "none", "#ffffff", "#eaf2f3", pr.get("fill")):
                continue
            if (r["x"] < pr["left"] - 0.5 or r["x"] + r["w"] > pr["right"] + 0.5
                    or r["y"] < pr["top"] - 0.5 or r["y"] + r["h"] > pr["bottom"] + 0.5):
                continue
            lo = fy["low"] + (pr["bottom"] - (r["y"] + r["h"])) * abs(fy["units_per_px"])
            bars.setdefault(r["fill"], set()).add((round(lo, 2), round(r["w"] * abs(fx["units_per_px"]), 2)))
    for c in doc["circles"]:
        if c["fill"] and c["fill"] not in ("none", "#ffffff"):
            jit.setdefault(c["fill"], set()).add((round(c["cx"], 1), round(c["cy"], 1)))
    out = {"labels": [[n, t] for _f, n, t in labels],
           "bars": [sorted(v) for v in bars.values()],
           "jit": [len(v) for v in jit.values()]}
    _s20_M.setGlobal("S20_TW", _s20_json.dumps(out))


def _s20_read(doc):
    from bokeh.models import GlyphRenderer, LabelSet, Plot
    def field(v):
        return v if isinstance(v, str) else (v.get("field") if isinstance(v, dict) else getattr(v, "field", None))
    def resolved(r, prop):
        v = getattr(r.glyph, prop)
        f = field(v)
        if f:
            vals = sorted({round(float(x), 2) for x in r.data_source.data[f]})
            return vals[0] if len(vals) == 1 else vals
        v = v.get("value") if isinstance(v, dict) else getattr(v, "value", v)
        return round(float(v), 2)
    plots = [m for m in doc.models if isinstance(m, Plot) and any(isinstance(r, GlyphRenderer) for r in m.renderers)]
    p = plots[0]
    labels = []
    for ls in [x for x in list(p.center) + list(p.above) + list(p.below) + list(p.left) + list(p.right) if isinstance(x, LabelSet)]:
        texts = [str(t) for t in ls.source.data[field(ls.text)]]
        labels.append([len(texts), texts[0] if texts else ""])
    gl = [r for r in p.renderers if isinstance(r, GlyphRenderer)]
    bars = [[resolved(r, "bottom"), resolved(r, "width")] for r in gl if type(r.glyph).__name__ == "VBar"]
    xs = [field(r.glyph.x) for r in gl if type(r.glyph).__name__ == "Scatter"]
    return _s20_json.dumps({"labels": labels, "bars": bars, "x": xs})


def _s20_page():
    from bokeh.document import Document
    with open(_s20_M.getGlobal("S20_PAGE"), encoding="utf-8") as fh:
        page = fh.read()
    blocks = _s20_re.findall(r'<script type="application/json" id="[^"]+">\s*(.*?)\s*</script>', page, _s20_re.S)
    docs = [d for b in blocks for d in _s20_json.loads(_s20_html.unescape(b)).values()]
    _s20_M.setGlobal("S20_PG", _s20_read(Document.from_json(docs[0])))


def _s20_app():
    from bokeh.document import Document
    with open(_s20_M.getGlobal("S20_APP"), encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_s20_app")
    with _s20_w.catch_warnings():
        _s20_w.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_s20_app.py", "exec"), ns)
    doc = Document()
    ns["make_document"](doc)
    _s20_M.setGlobal("S20_AP", _s20_read(doc))
end

// _s20_case id kind work cmd: twoway <cmd> against dash's saved page and
// served app; sets $S20_TRC, $S20_DRC, $S20_TW, $S20_PG and $S20_AP.
capture program drop _s20_case
program define _s20_case
    version 19
    args id kind work cmd
    if "`kind'" == "G" {
        quietly {
            clear
            set obs 5
            gen x = _n
            gen y1 = 30 + _n
            gen y2 = 40 + _n
        }
    }
    else if "`kind'" == "J" {
        quietly {
            clear
            set obs 30
            gen x = mod(_n, 3)
            gen y1 = mod(_n, 2)
            gen y2 = 2 + mod(_n, 2)
        }
    }
    else quietly sysuse auto, clear
    global S20_KIND "`kind'"
    local svg "`work'/s20_`id'.svg"
    local page "`work'/s20.html"
    local app "`work'/s20.py"
    capture graph drop g
    capture noisily twoway `macval(cmd)' name(g, replace)
    global S20_TRC = _rc
    if !${S20_TRC} quietly graph export "`svg'", replace name(g)
    capture dash clear
    capture noisily dash `macval(cmd)' saving("`page'", replace)
    local drc = _rc
    capture dash clear
    capture noisily dash `macval(cmd)' name(g1)
    local drc = `drc' + _rc
    capture noisily dash build, server saving("`app'") replace nobrowser
    global S20_DRC = `drc' + _rc
    foreach g in TW PG AP {
        global S20_`g' ""
    }
    global S20_SVG "`svg'"
    global S20_PAGE "`page'"
    global S20_APP "`app'"
    if !${S20_TRC} capture noisily python: __import__("__main__")._s20_svg()
    if !${S20_DRC} capture noisily python: __import__("__main__")._s20_page()
    if !${S20_DRC} capture noisily python: __import__("__main__")._s20_app()
    capture dash clear
    capture erase "`svg'"
    capture erase "`page'"
    capture erase "`app'"
    capture graph drop g
end

// _s20_refuse cmd: twoway's and dash's rc and first error line, in
// $S20_RC_<who> and $S20_ERR_<who>, each from its own fresh log.
capture program drop _s20_refuse
program define _s20_refuse
    version 19
    local ls = c(linesize)
    set linesize 255
    quietly sysuse auto, clear
    foreach who in twoway dash {
        tempfile lg
        capture log close s20r
        quietly log using "`lg'", text replace name(s20r)
        capture noisily `who' `macval(0)'
        global S20_RC_`who' = _rc
        quietly log close s20r
        mata: st_global("S20_ERR_`who'", _s11_err(st_local("lg")))
        mata: st_global("S20_ALL_`who'", invtokens(cat(st_local("lg"))'))
        capture dash clear
    }
    set linesize `ls'
end

* ==== S20 P1.1b: Per-series value lists ====
local only : env WP30_ONLY
if inlist("`only'", "", "S20") & `: list posof "S20" in w30_run' {
    display as text "S20 start " c(current_date) " " c(current_time)
    local s20_scheme "`c(scheme)'"
    set scheme s2color
    local s20_repo : environment DASH_REPO
    if `"`s20_repo'"' == "" local s20_repo ".."
    global S11_REPO `"`s20_repo'"'
    local two "scatter mpg turn weight,"

    // PS-30: refusals -- dash's rc equals twoway's, and its first error
    // line twoway's (for r(111), both name the variable; r(103), B18 and
    // B22 compare the rc alone).
    local r1 `"M12|`two' mlabel(make ..)"'
    local r2 `"M13|`two' mlabel(make ...)"'
    local r3 `"M14|`two' mlabel(make .. rep78)"'
    local r4 `"M15|`two' mlabel(make =)"'
    local r5 `"M16|`two' mlabel(= make)"'
    local r6 `"M17|`two' mlabel(.)"'
    local r7 `"M18|`two' mlabel(. ..)"'
    local r8 `"M19|`two' mlabel(make rep78 nosuch)"'
    local r9 `"M20|scatter mpg weight, mlabel(rep78 nosuch)"'
    local r10 `"M21|`two' mlabel(nosuch ..)"'
    local r11 `"M22|`two' mlabel(make .. nosuch)"'
    local r12 `"M23|`two' mlabel(nosuch =)"'
    local r13 `"M24|`two' mlabel(= nosuch)"'
    local r14 `"M25|histogram mpg, mlabel(nosuch ..)"'
    local r15 `"M26|histogram mpg, mlabel(= make)"'
    local r16 `"M28|function y=x, mlabel(make ..)"'
    local r17 `"M30|mspline mpg weight, mlabel(make rep78)"'
    local r18 `"M31|mspline mpg weight, mlabel(make ..)"'
    local r19 `"M32|mband mpg weight, mlabel(nosuch rep78)"'
    local r20 `"B14|rbar mpg turn weight, barwidth(50 100)"'
    local r21 `"B15|rbar mpg turn weight, barwidth(50 ..)"'
    local r22 `"B16|rbar mpg turn weight, barwidth(50) barwidth(10 20)"'
    local r23 `"B17|histogram mpg, barwidth(1 2)"'
    local r24 `"B18|rcap mpg turn weight, barwidth(1 2)"'
    local r25 `"B19|rspike mpg turn weight, barwidth(1 2)"'
    local r26 `"B20|rbar mpg turn weight, base(10 20)"'
    local r27 `"B21|histogram mpg, base(10 20)"'
    local r28 `"B22|lowess mpg weight, bwidth(.5 .8)"'
    forvalues i = 1/28 {
        mata: st_local("id", substr(st_local("r`i'"), 1, 3)); st_local("cmd", substr(st_local("r`i'"), 5, .))
        _s20_refuse `macval(cmd)' name(g, replace)
        local rconly = (${S20_RC_twoway} == 103 | "`id'" == "B18" | "`id'" == "B22")
        if ${S20_RC_twoway} == 111 {
            // twoway's log can hold earlier parse text before its line
            // (mband after mspline); both name the variable.
            mata: st_local("same", strofreal(strpos(st_global("S20_ALL_twoway"), "variable nosuch not found") > 0 & substr(st_global("S20_ERR_dash"), -25, .) == "variable nosuch not found"))
        }
        else mata: st_local("same", strofreal(`rconly' | st_global("S20_ERR_dash") == st_global("S20_ERR_twoway")))
        local ok = (${S20_RC_twoway} == ${S20_RC_dash} & ${S20_RC_twoway} != 0 & `same')
        if !`ok' {
            display as error "PS-30 `id': twoway ${S20_RC_twoway}, dash ${S20_RC_dash}"
            mata: printf("{err}  twoway: %s\n  dash:   %s\n", st_global("S20_ERR_twoway"), st_global("S20_ERR_dash"))
        }
        _w30_expect PS-30 "(`ok' == 1)" "`id': rc or first line differs"
    }
    _w30_done PS-30 "28 refusals: dash's rc and first line are twoway's"

    // PS-31: acceptances -- rc 0 in both, except V06 and M10 (recorded
    // differences: dash refuses r(198)).
    local a1 `"`two' mlabel(make rep78)"'
    local a2 `"scatter mpg weight, mlabel(make foreign)"'
    local a3 `"`two' mlabel(. rep78)"'
    local a4 `"`two' mlabel(make .)"'
    local a5 `"`two' mlabel(make)"'
    local a6 `"`two' mlabel(make rep78 foreign)"'
    local a7 `"`two' mlabel(mak rep7)"'
    local a8 `"`two' mlabel(make "")"'
    local a9 `"`two' mlabel(rep*)"'
    local a10 `"`two' mlabel(make) mlabel(rep78 foreign)"'
    local a11 `"histogram mpg, mlabel(nosuch)"'
    local a12 `"function y=x, mlabel(nosuch =)"'
    local a13 `"connected mpg turn weight, mlabel(make rep78) mlabposition(3 9)"'
    local a14 `"`two' jitter(2 3)"'
    local a15 `"`two' jitter(2 ..)"'
    local a16 `"`two' jitter(. 3)"'
    local a17 `"`two' jitter(2 =)"'
    local a18 `"scatter mpg weight, jitter(2 200)"'
    local a19 `"`two' jitter(.)"'
    local a20 `"scatter mpg weight, jitter(2 abc)"'
    local a21 `"bar mpg turn weight, base(10 20)"'
    local a22 `"bar mpg turn weight, base(10 ..)"'
    local a23 `"bar mpg turn weight, base(10 =)"'
    local a24 `"bar mpg turn weight, barwidth(1 2)"'
    local a25 `"bar mpg turn weight, barwidth(. 200)"'
    local a26 `"bar mpg turn weight, barwidth(1 ..)"'
    local a27 `"bar mpg turn weight, barwidth(.)"'
    local a28 `"dropline mpg turn weight, base(10 20)"'
    local a29 `"spike mpg turn weight, base(10 20)"'
    local a30 `"area mpg turn weight, sort base(10 20)"'
    local a31 `"bar mpg weight, barwidth(1 2)"'
    local a32 `"bar mpg weight, base(10 20)"'
    local a33 `"`two' jitter(2 200)"'
    local a34 `"`two' mlabel(t*)"'
    quietly sysuse auto, clear
    forvalues i = 1/34 {
        capture noisily twoway `macval(a`i')' name(g, replace)
        local trc = _rc
        capture dash clear
        capture noisily dash `macval(a`i')' name(g1)
        local drc = _rc
        local dwant = cond(`i' >= 33, 198, 0)
        _w30_expect PS-31 "(`trc' == 0 & `drc' == `dwant')" `"twoway `trc', dash `drc' (want `dwant'): `macval(a`i')'"'
    }
    capture dash clear
    _w30_done PS-31 "32 lists twoway draws, dash draws; V06 and M10 refused as recorded"

    // PS-32: labels per series, both modes: twoway's label groups in
    // series order, first text and count, are dash's LabelSets.
    foreach c in `"M01|`two' mlabel(make rep78)"' `"M02|scatter mpg weight, mlabel(make foreign)"' ///
        `"M03|`two' mlabel(. rep78)"' `"M05|`two' mlabel(make)"' `"M06|`two' mlabel(make rep78 foreign)"' ///
        `"M11|`two' mlabel(make) mlabel(rep78 foreign)"' {
        mata: st_local("id", substr(st_local("c"), 1, 3)); st_local("cmd", substr(st_local("c"), 5, .))
        _s20_case `id' A "`w30_work'" `"`macval(cmd)'"'
        python: _s20_t = _s20_json.loads(_s20_M.getGlobal("S20_TW") or "{}").get("labels")
        foreach m in PG AP {
            python: _s20_M.setLocal("ok", str(int(_s20_t is not None and _s20_json.loads(_s20_M.getGlobal("S20_`m'") or "{}").get("labels") == _s20_t)))
            _w30_expect PS-32 "(`ok' == 1)" `"`id' `m': twoway ${S20_TW} dash ${S20_`m'}"'
        }
    }
    _w30_done PS-32 "each series' labels equal twoway's in the saved page and the served app"

    // PS-33: bars per series, both modes.
    foreach c in "G01|bar y1 y2 x, barwidth(0.4 0.8) base(10 20)" "G02|bar y1 y2 x, barwidth(0.4 ..) base(10 =)" ///
        "G03|bar y1 y2 x, base(50)" "G04|bar y1 y2 x, base(. 50)" {
        mata: st_local("id", substr(st_local("c"), 1, 3)); st_local("cmd", substr(st_local("c"), 5, .))
        _s20_case `id' G "`w30_work'" `"`cmd'"'
        foreach m in PG AP {
            if inlist("`id'", "G01", "G02") {
                python: _s20_tb = [[min(lo for lo, w in s), s[0][1]] for s in _s20_json.loads(_s20_M.getGlobal("S20_TW") or '{"bars": []}')["bars"]]
                python: _s20_M.setLocal("ok", str(int(_s20_json.loads(_s20_M.getGlobal("S20_`m'") or "{}").get("bars") == _s20_tb and len(_s20_tb) == 2)))
            }
            else {
                local k = cond("`id'" == "G03", 0, 1)
                python: _s20_db = _s20_json.loads(_s20_M.getGlobal("S20_`m'") or '{"bars": [[0,0],[0,0]]}')["bars"]
                python: _s20_M.setLocal("ok", str(int(len(_s20_db) == 2 and _s20_db[`k'][0] == 50 and _s20_db[1 - `k'][0] != 50)))
            }
            _w30_expect PS-33 "(`ok' == 1)" `"`id' `m': twoway ${S20_TW} dash ${S20_`m'}"'
        }
    }
    _w30_done PS-33 "each series' base and width are twoway's in both modes"

    // PS-34: a series is jittered in dash exactly when twoway jitters it
    // (more than the 7 distinct positions of the data).
    foreach c in "J01|scatter y1 y2 x, jitter(5) jitterseed(1)" "J02|scatter y1 y2 x, jitter(. 5) jitterseed(1)" ///
        "J03|scatter y1 y2 x, jitter(5 ..) jitterseed(1)" {
        mata: st_local("id", substr(st_local("c"), 1, 3)); st_local("cmd", substr(st_local("c"), 5, .))
        _s20_case `id' J "`w30_work'" `"`cmd'"'
        python: _s20_tj = [n > 7 for n in _s20_json.loads(_s20_M.getGlobal("S20_TW") or '{"jit": []}')["jit"]]
        foreach m in PG AP {
            python: _s20_M.setLocal("ok", str(int(len(_s20_tj) == 2 and [x != "x" for x in _s20_json.loads(_s20_M.getGlobal("S20_`m'") or '{"x": []}')["x"]] == _s20_tj)))
            _w30_expect PS-34 "(`ok' == 1)" `"`id' `m': twoway ${S20_TW} dash ${S20_`m'}"'
        }
    }
    _w30_done PS-34 "dash jitters exactly the series twoway jitters, in both modes"
    capture erase "`w30_work'/s20.html"
    capture erase "`w30_work'/s20.py"
    set scheme `s20_scheme'
    display as text "S20 end " c(current_date) " " c(current_time)
}
* ==== end S20 ====

// WP-30 S21 (P1.3a) helpers.  _s21_tw (Stata) records twoway's ticks and
// scale for the graph in memory; the python readers compare dash's saved
// page (S21_PAGE, its document read from the JSON script block, moved
// under node through test/js_runner.py) and served app (S21_APP) with
// them.  S21_OK is 1 when every axis agrees; S21_MSG names the first
// difference.  A backtick here is spelled \x60.
capture program drop _s21_tw
program define _s21_tw
    // _s21_tw: S21_TW_<axis> "majmin majdelta majmax curmin curmax"
    local p ".Graph"
    local n "`.Graph.graphs.arrnels'"
    if "`n'" != "" & "`n'" != "." & "`n'" != "0" local p ".Graph.graphs[1]"
    foreach d in y x {
        global S21_TW_`d' "``p'.`d'axis1.major.min' ``p'.`d'axis1.major.delta' ``p'.`d'axis1.major.max' ``p'.plotregion1.`d'scale.curmin' ``p'.plotregion1.`d'scale.curmax'"
        global S21_TW_`d'2 "``p'.`d'axis2.major.min' ``p'.`d'axis2.major.delta' ``p'.`d'axis2.major.max'"
    }
    global S21_GM "`.Graph.plotregion1.gmetric_mult'"
end
python:
import json as _s21_json, re as _s21_re, html as _s21_html, os as _s21_os
import sys as _s21_sys, warnings as _s21_w
from sfi import Macro as _s21_M
_s21_sys.path.insert(0, _s21_os.getcwd())
_s21_sys.path.insert(0, _s21_os.path.dirname(_s21_os.getcwd()))


def _s21_doc_of_page(path):
    from bokeh.document import Document
    with open(path, encoding="utf-8") as fh:
        page = fh.read()
    for blob in _s21_re.findall('<script type="application/json"[^>]*>(.*?)</script>', page, _s21_re.S):
        try:
            d = _s21_json.loads(_s21_html.unescape(blob))
        except ValueError:
            continue
        if isinstance(d, dict) and d:
            with _s21_w.catch_warnings():
                _s21_w.simplefilter("ignore")
                return Document.from_json(list(d.values())[0])
    return None


def _s21_doc_of_app(path):
    from bokeh.document import Document
    with open(path, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_s21_app")
    exec(compile(src.replace(attach, "pass"), "dash_s21_app.py", "exec"), ns)
    with _s21_w.catch_warnings():
        _s21_w.simplefilter("ignore")
        doc = Document()
        ns["make_document"](doc)
    return doc


def _s21_key(f):
    # WP-30 P1.15a: a by() panel is named by its label row (a Title named
    # dash_by_label), no longer by its title.
    for m in list(f.above) + list(f.below):
        if type(m).__name__ == "Title" and m.name == "dash_by_label":
            return str(m.text or "")
    return str(getattr(f.title, "text", "") or "")


def _s21_figs(doc):
    from bokeh.models import Plot
    # WP-30 P1.15a: the by() grid's head and foot cells are bare Plots
    # holding the overall text, not panels.
    return sorted([m for m in doc.select(dict(type=Plot))
                   if m.name not in ("dash_by_head", "dash_by_foot")],
                  key=_s21_key)


def _s21_axes(fig):
    """{axis: (ticks, inner hull)} with the page's margin."""
    import dash_render as dr
    from bokeh.models import CustomJSTicker, FixedTicker, LogAxis, Range1d
    from bokeh.models.axes import ContinuousAxis
    sch = dr.SchemeParser(_s21_M.getGlobal("S21_SCHEME") or "stcolor")
    go = {}
    for k in ("xsize", "ysize"):
        if _s21_M.getGlobal("S21_" + k.upper()):
            go[k] = _s21_M.getGlobal("S21_" + k.upper())
    g = int(_s21_M.getGlobal("S21_G") or "1")
    m = dr._dash_plot_margin(sch, go, panels=g)
    out = {}
    for side, letter in (("left", "y"), ("right", "y"), ("below", "x"), ("above", "x")):
        for ax in getattr(fig, side):
            if not isinstance(ax, ContinuousAxis):
                continue
            name = getattr(ax, letter + "_range_name", "default")
            key = letter if name == "default" else name
            t = ax.ticker
            if isinstance(t, CustomJSTicker):
                t = (t.args or {}).get("base")
            ticks = [float(v) for v in t.ticks] if isinstance(t, FixedTicker) else None
            rng = (getattr(fig, letter + "_range") if name == "default"
                   else getattr(fig, "extra_%s_ranges" % letter).get(name))
            hull = None
            if isinstance(rng, Range1d):
                hull = dr._dash_range_hull(rng, "log" if isinstance(ax, LogAxis) else None,
                                           margin=m[letter])
            out[key] = (ticks, hull, rng)
    return out


def _s21_steps(lo, d, hi):
    if d is None or d == 0:
        return [lo, hi]
    n = int(round((hi - lo) / d))
    return [float("%.12g" % (lo + i * d)) for i in range(n + 1)]


def _s21_num(s):
    try:
        v = float(s)
    except (TypeError, ValueError):
        return None
    return None if v != v or abs(v) > 8.9e307 else v


def _s21_compare(figs, shift):
    """The first difference between dash's figures and twoway's globals."""
    for k, f in enumerate(figs):
        axes = _s21_axes(f)
        for axis in ("y", "x", "y2", "x2"):
            tw = [_s21_num(v) for v in (_s21_M.getGlobal("S21_TW_" + axis) or "").split()]
            if not tw or tw[0] is None:
                continue
            if axis not in axes:
                return "panel %d has no %s axis" % (k, axis)
            ticks, hull, _rng = axes[axis]
            sh = shift if axis == "x" else 0.0
            want = _s21_steps(tw[0], tw[1], tw[2])
            got = [float("%.12g" % (v - sh)) for v in (ticks or [])]
            if got != want:
                return "panel %d %s ticks %s, twoway %s" % (k, axis, got, want)
            if len(tw) == 5 and tw[3] is not None and hull is not None:
                span = tw[4] - tw[3]
                if abs(hull[0] - sh - tw[3]) > 1e-6 * span or abs(hull[1] - sh - tw[4]) > 1e-6 * span:
                    return "panel %d %s inner [%r, %r], twoway [%r, %r]" % (
                        k, axis, hull[0] - sh, hull[1] - sh, tw[3], tw[4])
    return ""


def _s21_move(doc, mode):
    """Fire the filter S21_MOVE (\x60range lo hi' or \x60drop label') on *doc*."""
    from bokeh.models import RangeSlider, Select
    spec = (_s21_M.getGlobal("S21_MOVE") or "").split()
    if not spec:
        return 0
    kind = RangeSlider if spec[0] == "range" else Select
    ws = [w for w in doc.select(dict(type=kind))]
    if len(ws) != 1:
        return 0
    w = ws[0]
    if kind is RangeSlider:
        new = (float(spec[1]), float(spec[2]))
    else:
        new = [v for v, lab in w.options if lab == " ".join(spec[1:])][0]
    old = w.value
    w.value = new
    if mode == "served":
        n = 0
        with _s21_w.catch_warnings():
            _s21_w.simplefilter("ignore")
            for attr in ("value", "value_throttled"):
                for cb in list(w._callbacks.get(attr, [])):
                    cb(attr, old, new)
                    n += 1
        return n
    import js_runner
    cbs = list((w.js_property_callbacks or {}).get("change:value", []))
    for cb in cbs:
        js_runner.JsSession([cb]).run(cb)
    return len(cbs)


def _s21_check():
    shift = 0.0
    if _s21_M.getGlobal("S21_TC") == "1":
        import dash_render as dr
        shift = float(dr._STATA_EPOCH_UNIX_MS)
    msgs = []
    for mode, reader, path in (("saved", _s21_doc_of_page, _s21_M.getGlobal("S21_PAGE")),
                               ("served", _s21_doc_of_app, _s21_M.getGlobal("S21_APP"))):
        if mode not in (_s21_M.getGlobal("S21_MODES") or "saved served").split():
            continue
        doc = reader(path)
        if doc is None:
            msgs.append(mode + ": no document")
            continue
        fired = _s21_move(doc, mode)
        if _s21_M.getGlobal("S21_MOVE") and not fired:
            msgs.append(mode + ": the move did not fire")
            continue
        figs = _s21_figs(doc)
        if _s21_M.getGlobal("S21_SHARED") == "1" and len(figs) > 1:
            if len({id(f.y_range) for f in figs}) != 1:
                msgs.append(mode + ": the panels do not share one y range")
        d = _s21_compare(figs, shift)
        if d:
            msgs.append(mode + ": " + d)
    _s21_M.setGlobal("S21_OK", "0" if msgs else "1")
    _s21_M.setGlobal("S21_MSG", "; ".join(msgs)[:240].replace('"', "'"))


def _s21_margin():
    """S21_MR S21_MF: twoway's margin_rel and frame fraction on y, from
    the SVG S21_SVG and twoway's curmin S21_TW_y."""
    _s21_sys.path.insert(0, _s21_M.getGlobal("cert_svg_scripts"))
    import svg_truth
    path = _s21_M.getGlobal("S21_SVG")
    doc = svg_truth.svg_document(path)
    short = min(doc["canvas"]["w"], doc["canvas"]["h"])
    ext = svg_truth.svg_axis_extent(path, "y")
    tw = [_s21_num(v) for v in _s21_M.getGlobal("S21_TW_y").split()]
    if ext is None or tw[3] is None:
        _s21_M.setGlobal("S21_MR", "."); _s21_M.setGlobal("S21_MF", ".")
        return
    pr = ext["plotregion"]
    span_px = pr["bottom"] - pr["top"]
    dist = (tw[3] - ext["low"]) / (ext["high"] - ext["low"]) * span_px
    _s21_M.setGlobal("S21_MR", repr(dist / short))
    _s21_M.setGlobal("S21_MF", repr(dist / span_px))


def _s21_dash_margin():
    import dash_render as dr
    sch = dr.SchemeParser(_s21_M.getGlobal("S21_SCHEME") or "stcolor")
    go = {}
    for k in ("xsize", "ysize"):
        if _s21_M.getGlobal("S21_" + k.upper()):
            go[k] = _s21_M.getGlobal("S21_" + k.upper())
    g = int(_s21_M.getGlobal("S21_G") or "1")
    # WP-30 P1.20b: "y" is the (bottom, top) pair; S21_MF is the bottom
    # side (curmin to the frame's low edge), so the bottom element.
    _s21_M.setGlobal("S21_DM", repr(dr._dash_plot_margin(sch, go, panels=g)["y"][0]))
    _s21_M.setGlobal("S21_R", repr(sch.plot_margin_rs / 100.0))
    k1, b1, b2 = dr._DASH_BY_GMETRIC
    import math
    n = math.ceil(math.sqrt(g))
    f = 1.0 - (n - 1.0) / n * b1 - ((b2 - b1) * (n - k1) / n if n > k1 else 0.0)
    _s21_M.setGlobal("S21_FG", repr(f))
end

capture program drop _s21_case
program define _s21_case
    // _s21_case <id> <data> <scheme> `"<twoway cmd>"' [move] [modes]
    args id data scheme cmd move modes
    global S21_SCHEME "`scheme'"
    if "`scheme'" == "" global S21_SCHEME "`c(scheme)'"
    global S21_MOVE "`move'"
    global S21_MODES "`modes'"
    global S21_XSIZE ""
    global S21_YSIZE ""
    global S21_G "1"
    global S21_TC "0"
    local d "${S21_WORK}"
    if "`data'" == "tc" {
        sysuse auto, clear
        quietly generate double t = clock("2001-01-01 00:00:00", "YMDhms") + _n * 7 * 3600000
        format t %tc
        global S21_TC "1"
    }
    else if substr("`data'", 1, 1) == "g" {
        sysuse auto, clear
        quietly generate g = mod(_n, `=substr("`data'", 2, .)')
    }
    else sysuse auto, clear
    capture dash clear
    capture graph drop _all
    local sc ""
    if "`scheme'" != "" local sc "scheme(`scheme')"
    local tcmd `"`cmd'"'
    if "`move'" != "" {
        // twoway draws the rows the move keeps
        local tcmd `"${S21_TWIF}"'
    }
    // a top-level comma: after a closing parenthesis, or anywhere in a
    // command with no parenthesised layers
    local comma ","
    if (substr(`"`tcmd'"', 1, 1) != "(" & strpos(`"`tcmd'"', ",")) | ustrregexm(`"`tcmd'"', "\)\s*,") local comma ""
    capture noisily twoway `tcmd' `comma' `sc'
    _w30_expect `id' "(_rc == 0)" "twoway rc `=_rc'"
    _s21_tw
    if strpos(`"`cmd'"', "by(") {
        global S21_G "`.Graph.graphs.arrnels'"
        global S21_SHARED "1"
    }
    else global S21_SHARED "0"
    if strpos(`"`cmd'"', "xsize(") global S21_XSIZE "4"
    if strpos(`"`cmd'"', "ysize(") global S21_YSIZE "4"
    local filt ""
    if "`move'" != "" {
        if word("`move'", 1) == "range" local filt "filter(price, type(range))"
        else local filt "filter(foreign, type(dropdown))"
    }
    global S21_SEQ = ${S21_SEQ} + 1
    local comma ","
    if (substr(`"`cmd'"', 1, 1) != "(" & strpos(`"`cmd'"', ",")) | ustrregexm(`"`cmd'"', "\)\s*,") local comma ""
    capture noisily dash `cmd' `comma' `sc' name(ns${S21_SEQ})
    _w30_expect `id' "(_rc == 0)" "dash rc `=_rc'"
    local f "`d'/ns${S21_SEQ}"
    capture erase "`f'.html"
    capture erase "`f'_app.py"
    capture noisily dash build, saving("`f'.html") replace nobrowser `filt'
    _w30_expect `id' "(_rc == 0)" "saved build rc `=_rc'"
    capture noisily dash build, saving("`f'_app.py") server replace `filt'
    _w30_expect `id' "(_rc == 0)" "served build rc `=_rc'"
    global S21_PAGE "`f'.html"
    global S21_APP "`f'_app.py"
    python: import __main__; __main__._s21_check()
    _w30_expect `id' "($S21_OK == 1)" `"`cmd' `move': $S21_MSG"'
    capture dash clear
    capture graph drop _all
end

* ==== S21 P1.3a: natscale ticker and twoway margin on non-date axes ====
local only : env WP30_ONLY
if inlist("`only'", "", "S21") & `: list posof "S21" in w30_run' {
    display as text "S21 start " c(current_date) " " c(current_time)
    global S21_WORK "`w30_work'/s21"
    capture mkdir "${S21_WORK}"
    global S21_SEQ 0
    global S21_TWIF ""
    // NS-01..NS-07, NS-10..NS-12: live twoway against dash's saved page and
    // served app (ticks exactly, inner hull within 1e-6 of the span).
    _s21_case NS-01 auto "" "scatter mpg weight"
    _w30_done NS-01 "scatter mpg weight: y 10(10)40 over 10-41, x 2000(1000)5000 over 1760-5000"
    _s21_case NS-02 auto "" "scatter price weight, yscale(log)"
    _s21_case NS-02 auto "" "scatter mpg weight, yscale(log) xscale(log)"
    _w30_done NS-02 "log axes: natscale less the ticks a log axis cannot draw"
    _s21_case NS-03 auto "" "(scatter price mpg) (lfit price mpg)"
    _s21_case NS-03 auto "" "(scatter mpg weight) (lfit mpg weight)"
    _w30_done NS-03 "a fit is inside the scale"
    _s21_case NS-04 auto "" "(scatter price mpg) (lfit price mpg), by(foreign)"
    _w30_done NS-04 "by(): one Range1d per shared axis over every panel's fit"
    _s21_case NS-05 auto "" "(scatter mpg weight) (scatter price weight, yaxis(2))"
    _s21_case NS-05 auto "" "(scatter mpg weight) (scatter mpg price, xaxis(2))"
    _w30_done NS-05 "a second axis with no label rule: 0(5000)15000"
    foreach c in "bar mpg weight" "spike mpg weight" "dropline mpg weight" "area mpg weight" "bar mpg weight, base(5)" {
        _s21_case NS-06 auto "" "`c'"
    }
    _w30_done NS-06 "default bases stay out of the scale, an explicit base() widens it"
    foreach c in `"scatter mpg weight, yline(50)"' `"scatter mpg weight, xline(6000)"' `"scatter mpg weight, text(50 6000 "hi")"' `"scatter mpg weight, mlabel(make)"' `"(scatter mpg weight) (scatteri 50 6000, msymbol(none))"' `"(scatter mpg weight) (pcarrowi 50 6000 45 5500)"' {
        _s21_case NS-07 auto "" `"`c'"'
    }
    _w30_done NS-07 "reference lines, text and labels leave the scale; scatteri and pcarrowi widen it"
    // NS-08, NS-09: the margin, read from twoway's SVG.
    foreach s in stcolor s2color economist {
        foreach z in "" "xsize(4) ysize(4)" {
            sysuse auto, clear
            capture graph drop _all
            quietly twoway scatter mpg weight, scheme(`s') `z'
            _s21_tw
            cert_svg_export, file("${S21_WORK}/m`s'.svg")
            global S21_SVG "${S21_WORK}/m`s'.svg"
            global S21_SCHEME "`s'"
            global S21_XSIZE ""
            global S21_YSIZE ""
            if "`z'" != "" {
                global S21_XSIZE "4"
                global S21_YSIZE "4"
            }
            global S21_G "1"
            python: _s21_margin()
            python: _s21_dash_margin()
            if "$S21_MR" != "." {
                _w30_expect NS-08 "(abs($S21_MR - $S21_R) <= 0.0005)" "`s' `z': margin_rel $S21_MR, r $S21_R"
                _w30_expect NS-08 "(abs($S21_MF - $S21_DM) <= 0.008)" "`s' `z': frame $S21_MF, dash $S21_DM"
            }
        }
    }
    _w30_done NS-08 "twoway's margin is r x min(W,H); dash's frame fraction is within 0.008"
    foreach G in 2 3 6 10 {
        sysuse auto, clear
        quietly generate g = mod(_n, `G')
        capture graph drop _all
        quietly twoway scatter mpg weight, by(g)
        global S21_GM "`.Graph.plotregion1.gmetric_mult'"
        global S21_SCHEME "stcolor"
        global S21_G "`G'"
        python: _s21_dash_margin()
        _w30_expect NS-09 "(abs($S21_GM - $S21_FG) <= 1e-9)" "G `G': gmetric $S21_GM, f(G) $S21_FG"
    }
    _w30_done NS-09 "by()'s size multiplier is f(G)"
    // NS-10: after a filter move, twoway's same `if'.
    global S21_TWIF "scatter mpg weight if price <= 7075.5"
    _s21_case NS-10 auto "" "scatter mpg weight" "range 3291 7075.5"
    global S21_TWIF "(scatter mpg weight) (lfit mpg weight) if price <= 7075.5"
    _s21_case NS-10 auto "" "(scatter mpg weight) (lfit mpg weight)" "range 3291 7075.5" "served"
    global S21_TWIF "(scatter mpg weight) (scatter price weight, yaxis(2)) if foreign"
    _s21_case NS-10 auto "" "(scatter mpg weight) (scatter price weight, yaxis(2))" "drop Foreign"
    global S21_TWIF ""
    _w30_done NS-10 "after a move the axes are twoway's under the same if, saved and served (the saved lfit stays unfiltered)"
    foreach s in s2color stgcolor_mv stcolor s1rcolor economist s2manual stmono1 stgcolor stcolor_alt s2gmanual stgcolor_alt stcolor_meta s1manual stsj stcolor_mv sj meta s2color8 s1mono stmono2 stcoloralias s2mono sttrans stgcolor_meta s1color s2gcolor {
        _s21_case NS-11 auto "`s'" "scatter mpg weight"
    }
    _w30_done NS-11 "every shipped scheme's default ticks are twoway's"
    _s21_case NS-12 tc "" "scatter mpg t"
    _w30_done NS-12 "%tc default ticks are twoway's milliseconds"
    capture dash clear
    forvalues i = 1/$S21_SEQ {
        capture erase "${S21_WORK}/ns`i'.html"
        capture erase "${S21_WORK}/ns`i'_app.py"
    }
    foreach s in stcolor s2color economist {
        capture erase "${S21_WORK}/m`s'.svg"
    }
    capture rmdir "${S21_WORK}"
    display as text "S21 end " c(current_date) " " c(current_time)
}
* ==== end S21 ====

// S22 helper: _s22_fx(key, local) puts the value at a dotted key of
// fixtures/graph_export_truth.json (the driver runs in test/) in a local.
python:
import json as _s22_json
from sfi import Macro as _s22_M


def _s22_fx(key, local):
    with open("fixtures/graph_export_truth.json", encoding="utf-8") as fh:
        v = _s22_json.load(fh)
    for k in key.split("."):
        v = v[k]
    _s22_M.setLocal(local, " ".join(sorted(v)) if isinstance(v, dict) else str(v))
end

* ==== S22 P1.28a: r(filename) and the stale-graph note ====
local only : env WP30_ONLY
if inlist("`only'", "", "S22") & `: list posof "S22" in w30_run' {
    display as text "S22 start " c(current_date) " " c(current_time)
    quietly sysuse auto, clear
    set linesize 255
    local s22n "graph export writes the graph in Stata's Graph window, not this dashboard; graphs in memory: "
    dash clear

    // GE-21 (guard) -- dash makes no Stata graph: the one-line form, with
    // and without saving(), leaves graph memory empty and graph export
    // answering as it did before dash ran.  In batch a graph drawn by an
    // earlier block can still be the one graph export writes after graph
    // drop (the fixture's dropped case), so the fixture's no_graph answer
    // is required only when graph export gave it before dash ran.
    graph drop _all
    capture graph export "`w30_work'/ge21a.png", replace
    local rc21a = _rc
    dash scatter mpg weight
    dash scatter mpg weight, saving("`w30_work'/ge21.html", replace)
    quietly graph dir, memory
    local mem21 = strtrim("`r(list)'")
    capture log close s22
    quietly log using "`w30_work'/ge21.log", text replace name(s22)
    capture noisily graph export "`w30_work'/ge21.png", replace
    local rc21 = _rc
    quietly log close s22
    python: _s22_fx("cases.no_graph.rc", "fx_rc")
    python: _s22_fx("cases.no_graph.first", "fx_first")
    _w30_expect GE-21 `"("`mem21'" == "")"' "dash left graphs in memory: `mem21'"
    _w30_expect GE-21 "`rc21' == `rc21a'" "graph export rc `rc21' after dash, `rc21a' before"
    if `rc21a' == `fx_rc' {
        cert_log_has "`w30_work'/ge21.log", needle("`fx_first'")
        _w30_expect GE-21 "r(count) == 1" "graph export did not say: `fx_first'"
    }
    _w30_done GE-21 "dash makes no Stata graph: graph export answers as before dash (rc `rc21')"

    // GE-22 -- the suffixes replaced are exactly those graph export writes.
    python: _s22_fx("suffixes", "fx_sfx")
    local bad ""
    foreach s of local fx_sfx {
        if "`s'" != lower("`s'") continue
        python: _s22_fx("suffixes.`s'.first", "fx_first")
        local want = cond(strpos("`fx_first'", "not recognized"), "", "`s'")
        mata: _dash_saving_parse("a.`s'", "html")
        if "`_sv_img'" != "`want'" local bad "`bad' `s'"
    }
    _w30_expect GE-22 `"("`bad'" == "")"' "suffixes misread:`bad'"
    _w30_done GE-22 "saving() replaces exactly the suffixes graph export writes"

    // GE-23 -- as after twoway, which leaves r() empty, dash leaves only
    // r(filename).
    python: _s22_fx("return_after_twoway.macros", "fx_m")
    python: _s22_fx("return_after_twoway.scalars", "fx_s")
    quietly summarize price
    dash scatter mpg weight, saving("`w30_work'/ge23.html", replace)
    mata: st_local("m23", invtokens(st_dir("r()", "macro", "*")'))
    mata: st_local("s23", strofreal(rows(st_dir("r()", "numscalar", "*"))))
    _w30_expect GE-23 "`fx_m' == 0 & `fx_s' == 0" "twoway left `fx_m' macros, `fx_s' scalars"
    _w30_expect GE-23 `"("`m23'" == "filename" & `s23' == 0)"' "dash left macros [`m23'], `s23' scalars"
    _w30_done GE-23 "twoway leaves r() empty; dash leaves only r(filename)"

    // GE-24 -- with a twoway graph in memory, the one-line form notes once
    // that graph export writes it, and graph export does write it.
    quietly twoway scatter price weight
    capture log close s22
    quietly log using "`w30_work'/ge24.log", text replace name(s22)
    dash scatter mpg weight, saving("`w30_work'/ge24.html", replace)
    quietly log close s22
    cert_log_has "`w30_work'/ge24.log", needle("(note:  dash: `s22n'Graph)")
    _w30_expect GE-24 "r(count) == 1" "the note was printed `r(count)' times"
    capture graph export "`w30_work'/ge24.svg", replace
    _w30_expect GE-24 "_rc == 0" "graph export rc `=_rc'"
    cert_file_has "`w30_work'/ge24.svg", needle(">Price<")
    _w30_expect GE-24 "r(found) == 1" "the SVG is not the twoway graph"
    cert_file_has "`w30_work'/ge24.svg", needle(">Mileage (mpg)<")
    _w30_expect GE-24 "r(found) == 0" "the SVG holds the dashboard's title"
    _w30_done GE-24 "the stale export is announced: graph export writes the twoway graph"

    foreach f in ge21a.png ge21.html ge21.log ge21.png ge23.html ge24.log ge24.html ge24.svg {
        capture erase "`w30_work'/`f'"
    }
    graph drop _all
    dash clear
    display as text "S22 end " c(current_date) " " c(current_time)
}
* ==== end S22 ====

// S23: the lines of text log `1' holding `2', in r(n).
capture program drop _s23_count
program define _s23_count, rclass
    version 19
    args log needle
    tempname fh
    local n 0
    file open `fh' using `"`log'"', read text
    file read `fh' line
    while r(eof) == 0 {
        if strpos(`"`macval(line)'"', `"`needle'"') local ++n
        file read `fh' line
    }
    file close `fh'
    return scalar n = `n'
end

* ==== S23 P1.26b: Served notes reach Stata ====
local only : env WP30_ONLY
if inlist("`only'", "", "S23") & `: list posof "S23" in w30_run' {
    display as text "S23 start " c(current_date) " " c(current_time)
    local s23ls = c(linesize)
    set linesize 255
    local s23log "`w30_work'/s23.log"
    sysuse auto, clear
    // NC-09: a layer whose own if keeps no row is drawn in silence, as
    // twoway draws it, in the saved build and the server build.  graph
    // drop _all before dash: a nodraw graph is in memory, and S22 notes
    // graph export on every file-writing dash command while one is.
    foreach t in line connected area spike dropline bar scatter lowess rbar rarea rcap rline rscatter rconnected rspike pcspike histogram kdensity {
        local v "mpg weight"
        if inlist("`t'", "rbar", "rarea", "rcap", "rline", "rscatter", "rconnected", "rspike") local v "mpg price weight"
        if "`t'" == "pcspike" local v "mpg weight price length"
        if inlist("`t'", "histogram", "kdensity") local v "mpg"
        quietly log using "`s23log'", replace text name(_s23)
        capture noisily twoway (scatter mpg weight) (`t' `v' if price > 20000), nodraw
        local rc = _rc
        quietly log close _s23
        _s23_count "`s23log'" "(note:"
        _w30_expect NC-09 "(`rc' == 0 & r(n) == 0)" "twoway `t': rc `rc', `=r(n)' note line(s)"
        quietly graph drop _all
        quietly log using "`s23log'", replace text name(_s23)
        capture noisily dash (scatter mpg weight) (`t' `v' if price > 20000), saving("`w30_work'/s23_`t'.html", replace)
        local rc = _rc
        quietly log close _s23
        _s23_count "`s23log'" "(note:"
        local n1 = r(n)
        _s23_count "`s23log'" "drew nothing"
        _w30_expect NC-09 "(`rc' == 0 & `n1' == 0 & r(n) == 0)" "dash saved `t': rc `rc', `n1' note line(s), `=r(n)' drew nothing"
        dash clear
        quietly dash (scatter mpg weight) (`t' `v' if price > 20000), name(nc09)
        quietly log using "`s23log'", replace text name(_s23)
        capture noisily dash build, saving("`w30_work'/s23_`t'.py") replace server
        local rc = _rc
        quietly log close _s23
        _s23_count "`s23log'" "(note:"
        local n1 = r(n)
        _s23_count "`s23log'" "drew nothing"
        _w30_expect NC-09 "(`rc' == 0 & `n1' == 0 & r(n) == 0)" "dash server `t': rc `rc', `n1' note line(s), `=r(n)' drew nothing"
        dash clear
        capture erase "`w30_work'/s23_`t'.html"
        capture erase "`w30_work'/s23_`t'.py"
    }
    _w30_done NC-09 "a layer whose own if keeps no row is silent in twoway, the saved build and the server build, for 18 types"
    // NC-10: twoway's estimator note stays, once, in both builds.
    quietly log using "`s23log'", replace text name(_s23)
    capture noisily twoway (scatter mpg weight) (lfit mpg weight if price > 20000), nodraw
    quietly log close _s23
    _s23_count "`s23log'" "could not fit model"
    _w30_expect NC-10 "(r(n) == 1)" "twoway lfit: `=r(n)' estimator note(s)"
    quietly graph drop _all
    dash clear
    quietly dash (scatter mpg weight) (lfit mpg weight if price > 20000), name(nc10)
    foreach m in html py {
        local opt = cond("`m'" == "py", "server", "")
        quietly log using "`s23log'", replace text name(_s23)
        capture noisily dash build, saving("`w30_work'/s23_nc10.`m'") replace `opt'
        local rc = _rc
        quietly log close _s23
        _s23_count "`s23log'" "could not fit model"
        _w30_expect NC-10 "(`rc' == 0 & r(n) == 1)" "dash build `opt' (`m'): rc `rc', `=r(n)' estimator note(s)"
        capture erase "`w30_work'/s23_nc10.`m'"
    }
    dash clear
    _w30_done NC-10 "twoway's estimator note for an own-if lfit is printed once by twoway, the saved build and the server build"
    capture erase "`s23log'"
    set linesize `s23ls'
    display as text "S23 end " c(current_date) " " c(current_time)
}
* ==== end S23 ====

// S24's helpers (WP-30 P1.4a), outside every gate:
//   _s24_dash()  reads the saved page S24_PAGE and the served app S24_APP
//                (built on a fresh Document, its attach line replaced by
//                pass, as _s19_app does) and sets, per mode (S24_SAVED_*,
//                S24_SERVED_*): A, the distinct alphas of the first
//                figure's lines, fills, markers and arrow heads (the band's
//                #c0c0c0 aside, an outline drawn at 0 aside), sorted and
//                joined by "|"; Q, the distinct Quad "fill/line" styles;
//                M, each Scatter "marker:size:fill_alpha:fill:line" in the
//                figure's renderer order, joined by ";".  It fires the
//                served app's Select on `foreign' to Foreign and sets
//                S24_SAME_AFTER (1 when A, Q and M are unchanged).
//   _s24_tw()    reads twoway's SVG S24_SVG through scripts/svg_layer.py
//                and sets S24_TW_A (as A, the grid's #eaf2f3 aside), S24_TW_Q
//                (the rect "fill/stroke" styles) and S24_TW_M (each marker
//                "shape:hollow:extent:fill:stroke" in drawn order).
//   _s24_run     one command: twoway's SVG, then dash's page and app.
python:
import os as _s24_os, sys as _s24_sys, warnings as _s24_w
import __main__ as _s24_main
from sfi import Macro as _s24_M


def _s24_lower(v):
    v = _s24_main._s19_val(v)
    return str(v).lower() if v is not None else ""


def _s24_f(v):
    v = _s24_main._s19_val(v)
    try:
        return round(float(v), 4)
    except (TypeError, ValueError):
        return None


def _s24_ref(m, attr):
    """A reference attribute, raw: _s19_val reads a saved {"id": ..}
    reference as a value and loses it."""
    if hasattr(m, "attrs"):
        return m.attrs.get(attr)
    return getattr(m.model, attr, None)


def _s24_summ(fig, by_id):
    alphas, quads, marks = set(), set(), []
    for ref in (_s24_ref(fig, "renderers") or []):
        r = by_id(ref)
        if r is None or r.kind != "GlyphRenderer":
            continue
        g = by_id(_s24_ref(r, "glyph"))
        if g is None:
            continue
        la, fa = _s24_f(g.get("line_alpha")), _s24_f(g.get("fill_alpha"))
        lc, fc = _s24_lower(g.get("line_color")), _s24_lower(g.get("fill_color"))
        if g.kind != "VArea" and la not in (None, 0.0) and lc != "#c0c0c0":
            alphas.add(la)
        if g.kind in ("Scatter", "VBar", "VArea", "Quad") and fa not in (None, 0.0) and fc != "#c0c0c0":
            alphas.add(fa)
        if g.kind == "Quad":
            quads.add("%s/%s" % (fc, lc))
        if g.kind == "Scatter":
            marks.append("%s:%s:%s:%s:%s" % (_s24_lower(g.get("marker")), _s24_f(g.get("size")), fa, fc, lc))
    for ref in (_s24_ref(fig, "center") or []):
        a = by_id(ref)
        if a is None or a.kind != "Arrow":
            continue
        alphas.add(_s24_f(a.get("line_alpha")))
        for h in ("end", "start"):
            hd = by_id(_s24_ref(a, h))
            if hd is not None:
                alphas.add(_s24_f(hd.get("line_alpha")))
    return dict(A="|".join("%g" % x for x in sorted(alphas)), Q="|".join(sorted(quads)), M=";".join(marks))


def _s24_saved():
    objs = _s24_main._s19_models(_s24_M.getGlobal("S24_PAGE"))
    by = dict((o["id"], _s24_main._S19Saved(o)) for o in objs)

    def by_id(ref):
        rid = ref.get("id") if isinstance(ref, dict) else getattr(ref, "id", None)
        return by.get(rid)
    figs = [m for m in by.values() if m.kind in ("Figure", "figure", "Plot")]
    return _s24_summ(figs[0], by_id) if figs else dict(A="", Q="", M="")


def _s24_served_doc():
    from bokeh.document import Document
    with open(_s24_M.getGlobal("S24_APP"), encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_s24_app")
    with _s24_w.catch_warnings():
        _s24_w.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_s24_app.py", "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    return doc


def _s24_doc_summ(doc):
    seen = dict()
    for root in doc.roots:
        for m in root.references():
            seen[m.id] = m
    figs = [m for m in seen.values() if type(m).__name__ in ("figure", "Figure")]

    def by_id(ref):
        return _s24_main._S19Served(ref) if ref is not None and not isinstance(ref, (str, int, float)) else None
    return _s24_summ(_s24_main._S19Served(figs[0]), by_id) if figs else dict(A="", Q="", M="")


def _s24_dash():
    from bokeh.models import Select
    for k, v in _s24_saved().items():
        _s24_M.setGlobal("S24_SAVED_" + k, v)
    doc = _s24_served_doc()
    before = _s24_doc_summ(doc)
    for k, v in before.items():
        _s24_M.setGlobal("S24_SERVED_" + k, v)
    same = 0
    sel = [w for w in doc.select(dict(type=Select))]
    if sel:
        w = sel[0]
        pick = [v for v, lab in w.options if lab == "Foreign"]
        if pick:
            old = w.value
            w.value = pick[0]
            with _s24_w.catch_warnings():
                _s24_w.simplefilter("ignore")
                for attr in ("value", "value_throttled"):
                    for cb in list(w._callbacks.get(attr, [])):
                        cb(attr, old, pick[0])
            same = int(_s24_doc_summ(doc) == before)
    _s24_M.setGlobal("S24_SAME_AFTER", str(same))


def _s24_tw():
    root = _s24_M.getGlobal("S24_REPO")
    if _s24_os.path.join(root, "scripts") not in _s24_sys.path:
        _s24_sys.path.insert(0, _s24_os.path.join(root, "scripts"))
    import svg_layer as sl
    els = [e for e in sl.svg_elements(_s24_M.getGlobal("S24_SVG")) if e["stroke"] != "#eaf2f3"]
    alphas, quads = set(), set()
    for e in els:
        if "#c0c0c0" in (e["fill"], e["stroke"]):
            continue
        if e["fill"] not in (None, "none"):
            alphas.add(e["fill_opacity"] if e["fill_opacity"] is not None else 1.0)
        if e["stroke"] not in (None, "none"):
            alphas.add(e["stroke_opacity"] if e["stroke_opacity"] is not None else 1.0)
    fills = [e["fill"] for e in els if e["kind"] == "rect" and e["fill"] not in (None, "none")]
    strokes = [e["stroke"] for e in els if e["kind"] == "rect" and e["fill"] == "none"]
    for f, st in zip(fills, strokes):
        quads.add("%s/%s" % (f, st))
    ms = [m for m in sl.markers(els) if sl.marker_shape(m)]
    _s24_M.setGlobal("S24_TW_A", "|".join("%g" % x for x in sorted(alphas)))
    _s24_M.setGlobal("S24_TW_Q", "|".join(sorted(quads)))
    def col(m, k):
        return next((e[k] for e in m if e[k] not in (None, "none")), "none")
    _s24_M.setGlobal("S24_TW_M", ";".join("%s:%d:%s:%s:%s" % (sl.marker_shape(m), int(sl.hollow(m)), sl.stroke_extent(m), col(m, "fill"), col(m, "stroke")) for m in ms))


_s24_main._s24_dash = _s24_dash
_s24_main._s24_tw = _s24_tw
end

capture program drop _s24_run
program define _s24_run
    version 19
    // id; scheme; the twoway command (with any of its own options after a
    // comma); twoway's options and dash's are appended after one more.
    args id scheme cmd
    local d "${S24_WORK}"
    local sep = cond(strpos(`"`cmd'"', ",") & substr(`"`cmd'"', 1, 1) != "(", " ", ", ")
    quietly twoway `cmd' `sep' scheme(`scheme') legend(off) xscale(off) yscale(off) plotregion(style(none)) name(s24tw, replace)
    quietly graph export "`d'/s24.svg", name(s24tw) replace
    global S24_SVG "`d'/s24.svg"
    python: __import__("__main__")._s24_tw()
    capture graph drop s24tw
    capture dash clear
    capture noisily dash `cmd' `sep' scheme(`scheme') name(s24g)
    _w30_expect `id' "(_rc == 0)" "dash `cmd' rc `_rc'"
    capture noisily dash build, saving("`d'/s24.html") replace nobrowser filter(foreign, type(dropdown))
    _w30_expect `id' "(_rc == 0)" "dash build rc `_rc'"
    capture noisily dash build, server saving("`d'/s24_app.py") replace nobrowser filter(foreign, type(dropdown))
    _w30_expect `id' "(_rc == 0)" "dash build, server rc `_rc'"
    global S24_PAGE "`d'/s24.html"
    global S24_APP "`d'/s24_app.py"
    python: __import__("__main__")._s24_dash()
    display as text `"  `id' `scheme' `cmd': twoway A[${S24_TW_A}] Q[${S24_TW_Q}]"'
    display as text `"     saved A[${S24_SAVED_A}] Q[${S24_SAVED_Q}] served A[${S24_SERVED_A}] Q[${S24_SERVED_Q}] same after ${S24_SAME_AFTER}"'
    foreach x in s24.svg s24.html s24_app.py {
        capture erase "`d'/`x'"
    }
    capture dash clear
end

* ==== S24 P1.4a: Scheme opacity, histogram style and symbols reach every layer ====
local only : env WP30_ONLY
if inlist("`only'", "", "S24") & `: list posof "S24" in w30_run' {
    display as text "S24 start " c(current_date) " " c(current_time)
    global S24_WORK "`w30_work'"
    local s24_repo : environment DASH_REPO
    if `"`s24_repo'"' == "" local s24_repo ".."
    global S24_REPO "`s24_repo'"
    sysuse auto, clear
    generate lo = mpg - 3
    generate hi = mpg + 3
    forvalues i = 1/15 {
        generate y`i' = mpg + `i'
    }
    sort weight

    // SK-01 and SK-09: sttrans' %20 on fits, spikes, arrows and immediates.
    foreach c in "lfit mpg weight" "rspike lo hi weight" "pcarrow mpg weight price length in 1/5" "scatteri 20 3000" {
        _s24_run SK-01 sttrans "`c'"
        local ok = ("${S24_TW_A}" == "0.2" & "${S24_SAVED_A}" == "0.2" & "${S24_SERVED_A}" == "0.2")
        _w30_expect SK-01 "(`ok' == 1)" "`c': twoway ${S24_TW_A}, saved ${S24_SAVED_A}, served ${S24_SERVED_A}"
        if "`c'" == "lfit mpg weight" {
            _w30_expect SK-09 "(${S24_SAME_AFTER} == 1)" "`c': the served glyphs changed after a dropdown move"
        }
    }
    _w30_done SK-01 "every line, segment, arrow head and immediate marker at sttrans' 0.20, as twoway, in both modes"

    // SK-02: rarea follows area's rule.
    foreach S in s2color sttrans {
        local want = cond("`S'" == "sttrans", "0.2", "1")
        _s24_run SK-02 `S' "rarea lo hi weight"
        local ok = ("${S24_TW_A}" == "`want'" & "${S24_SAVED_A}" == "`want'" & "${S24_SERVED_A}" == "`want'")
        _w30_expect SK-02 "(`ok' == 1)" "`S': twoway ${S24_TW_A}, saved ${S24_SAVED_A}, served ${S24_SERVED_A}"
    }
    _w30_done SK-02 "rarea opaque under s2color and 0.20 under sttrans, as twoway, in both modes"

    // SK-03 and SK-04: the histogram style, one for every layer.
    foreach S in s2color stcolor s1mono {
        _s24_run SK-03 `S' "histogram mpg"
        local ok = ("${S24_TW_Q}" != "" & "${S24_SAVED_Q}" == "${S24_TW_Q}" & "${S24_SERVED_Q}" == "${S24_TW_Q}")
        _w30_expect SK-03 "(`ok' == 1)" "`S': twoway ${S24_TW_Q}, saved ${S24_SAVED_Q}, served ${S24_SERVED_Q}"
    }
    _w30_done SK-03 "histogram fill and outline are twoway's under s2color, stcolor and s1mono in both modes"
    _s24_run SK-04 s2color "(histogram mpg) (histogram trunk)"
    local ok = ("${S24_TW_Q}" == "#cac27e/#d7d29e" & "${S24_SAVED_Q}" == "${S24_TW_Q}" & "${S24_SERVED_Q}" == "${S24_TW_Q}")
    _w30_expect SK-04 "(`ok' == 1)" "twoway ${S24_TW_Q}, saved ${S24_SAVED_Q}, served ${S24_SERVED_Q}"
    _w30_done SK-04 "two histogram layers share twoway's one style in both modes"

    // SK-05 and SK-09: s1mono's hollow and small symbols.
    _s24_run SK-05 s1mono "scatter y1-y15 weight in 1/3"
    local s24_ok = 1
    local s24_tw : copy global S24_TW_M
    foreach mode in SAVED SERVED {
        local s24_d : copy global S24_`mode'_M
        forvalues L = 1/15 {
            local k = 3 * (`L' - 1) + 1
            local tw : word `k' of `=subinstr("`s24_tw'", ";", " ", .)'
            local dm : word `L' of `=subinstr("`s24_d'", ";", " ", .)'
            tokenize "`tw'", parse(":")
            local twh "`3'"
            local twshape "`1'"
            tokenize "`dm'", parse(":")
            local dfa "`5'"
            if inlist("`twshape'", "circle", "diamond", "square", "triangle") {
                if (`twh' == 1) != (`dfa' == 0) local s24_ok = 0
            }
        }
        // p11 (smcircle) over p1 (circle): twoway's extent ratio against
        // dash's size ratio, within 1%.
        local t1 : word 1 of `=subinstr("`s24_tw'", ";", " ", .)'
        local t11 : word 31 of `=subinstr("`s24_tw'", ";", " ", .)'
        local d1 : word 1 of `=subinstr("`s24_d'", ";", " ", .)'
        local d11 : word 11 of `=subinstr("`s24_d'", ";", " ", .)'
        tokenize "`t1'", parse(":")
        local e1 = `5'
        tokenize "`t11'", parse(":")
        local e11 = `5'
        tokenize "`d1'", parse(":")
        local s1 = `3'
        tokenize "`d11'", parse(":")
        local s11 = `3'
        if abs((`e11' / `e1') - (`s11' / `s1')) > 0.01 * (`e11' / `e1') local s24_ok = 0
    }
    _w30_expect SK-05 "(`s24_ok' == 1)" "hollow or size differs: twoway ${S24_TW_M}; saved ${S24_SAVED_M}; served ${S24_SERVED_M}"
    _w30_expect SK-09 "(${S24_SAME_AFTER} == 1)" "s1mono scatter: the served glyphs changed after a dropdown move"
    _w30_done SK-05 "s1mono's hollow p7-p10 and small p11 are twoway's in both modes"
    _w30_done SK-09 "the served glyph styles survive a dropdown move"

    // SK-06: msymbol(smcircle) under msize(large).
    _s24_run SK-06 s2color "scatter mpg weight in 1, msymbol(smcircle) msize(large)"
    local s24_ts : copy global S24_TW_M
    local s24_ds : copy global S24_SAVED_M
    local s24_vs : copy global S24_SERVED_M
    _s24_run SK-06 s2color "scatter mpg weight in 1, msymbol(circle) msize(large)"
    tokenize "`s24_ts'", parse(":")
    local a = `5'
    tokenize "${S24_TW_M}", parse(":")
    local b = `5'
    tokenize "`s24_ds'", parse(":")
    local c = `3'
    tokenize "${S24_SAVED_M}", parse(":")
    local dd = `3'
    tokenize "`s24_vs'", parse(":")
    local e = `3'
    tokenize "${S24_SERVED_M}", parse(":")
    local f = `3'
    local ok = (abs(`a'/`b' - `c'/`dd') <= 0.01 * `a'/`b' & abs(`a'/`b' - `e'/`f') <= 0.01 * `a'/`b')
    _w30_expect SK-06 "(`ok' == 1)" "twoway `a'/`b', saved `c'/`dd', served `e'/`f'"
    _w30_done SK-06 "msymbol(smcircle) msize(large) is twoway's fraction of the circle in both modes"

    // SK-07: the cycle reaches dropline's and rcapsym's markers.
    foreach t in "dropline mpg weight in 1/3" "rcapsym lo hi weight in 1/3" {
        _s24_run SK-07 s1mono "(scatter mpg weight in 1/3) (`t')"
        local tw : copy global S24_TW_M
        local tw = substr("`tw'", strrpos("`tw'", ";") + 1, .)
        local sv : copy global S24_SAVED_M
        local sv = substr("`sv'", strrpos("`sv'", ";") + 1, .)
        local se : copy global S24_SERVED_M
        local se = substr("`se'", strrpos("`se'", ";") + 1, .)
        local ok = (substr("`tw'", 1, 8) == "diamond:" & substr("`sv'", 1, 8) == "diamond:" & substr("`se'", 1, 8) == "diamond:")
        _w30_expect SK-07 "(`ok' == 1)" "`t': twoway `tw', saved `sv', served `se'"
    }
    _w30_done SK-07 "s1mono's second dropline and rcapsym layers draw p2's diamond in both modes"

    // SK-08: the marker colour keys, through two schemes of yours in the
    // working directory (twoway's findfile and dash's lookup read there).
    foreach S in w24g w24m {
        capture confirm new file "`S'.scheme"
        local s24_new = _rc
        _w30_expect SK-08 "(`s24_new' == 0)" "`S'.scheme already exists in the working directory; not overwritten"
        if `s24_new' == 0 {
            tempname s24_fh
            file open `s24_fh' using "`S'.scheme", write text
            if "`S'" == "w24g" file write `s24_fh' "#include s2color" _n "color pmarkfill green" _n "color pmarkline blue" _n
            else file write `s24_fh' "#include s2color" _n "color p1mark green" _n "color pmark red" _n
            file close `s24_fh'
            local want = cond("`S'" == "w24g", "#008000:#0000ff", "#1a476f:#1a476f")
            _s24_run SK-08 `S' "scatter mpg weight in 1/3"
            local tw : copy global S24_TW_M
            if strpos("`tw'", ";") local tw = substr("`tw'", 1, strpos("`tw'", ";") - 1)
            local sv : copy global S24_SAVED_M
            if strpos("`sv'", ";") local sv = substr("`sv'", 1, strpos("`sv'", ";") - 1)
            local se : copy global S24_SERVED_M
            if strpos("`se'", ";") local se = substr("`se'", 1, strpos("`se'", ";") - 1)
            tokenize "`tw'", parse(":")
            local twc "`7':`9'"
            tokenize "`sv'", parse(":")
            local svc "`7':`9'"
            tokenize "`se'", parse(":")
            local sec "`7':`9'"
            local ok = ("`twc'" == "`want'" & "`svc'" == "`want'" & "`sec'" == "`want'")
            _w30_expect SK-08 "(`ok' == 1)" "`S': twoway `twc', saved `svc', served `sec', want `want'"
            capture erase "`S'.scheme"
        }
    }
    _w30_done SK-08 "markers take color p#markfill and p#markline, never p#mark, in both modes"
    display as text "S24 end " c(current_date) " " c(current_time)
}
* ==== end S24 ====

// S25's probes.  The truth script holds no captured python: line
// (test_cscript_hygiene.py), so each python: line runs uncaptured inside a
// program of its own and the program's return code is read.
capture program drop _s25_scope
program define _s25_scope
    version 19
    args path
    local _dd_err ""
    python: import importlib.util as _s25u
    python: from sfi import Macro as _s25M
    python: _s25s = _s25u.spec_from_file_location("_s25_probe", _s25M.getLocal("path"))
    python: _s25m = _s25u.module_from_spec(_s25s)
    python: _s25r = _s25s.loader.exec_module(_s25m)
    c_local s25err `"`_dd_err'"'
end
capture program drop _s25_exit
program define _s25_exit
    version 19
    python: raise SystemExit("dash: s25 probe")
end
capture program drop _s25_imperr
program define _s25_imperr
    version 19
    python: raise ImportError("dash: s25 probe")
end

* ==== S25 P1.32: Render-time dependency guards ====
local only : env WP30_ONLY
if inlist("`only'", "", "S25") & `: list posof "S25" in w30_run' {
    display as text "S25 start " c(current_date) " " c(current_time)
    capture _s25_exit
    local rg01 = _rc
    _w30_expect RG-01 "(`rg01' == 0)" "rc `rg01'"
    _w30_done RG-01 "a SystemExit ends a python: line with rc 0, so the guard raises ImportError under Stata"

    capture _s25_imperr
    local rg02 = _rc
    _w30_expect RG-02 "(`rg02' == 7102)" "rc `rg02'"
    _w30_done RG-02 "an ImportError ends a python: line with r(7102)"

    tempname s25fh
    file open `s25fh' using "`w30_work'/s25_probe.py", write text replace
    file write `s25fh' "import sfi" _n `"sfi.Macro.setLocal("_dd_err", "dash: s25 probe")"' _n
    file close `s25fh'
    _s25_scope "`w30_work'/s25_probe.py"
    local rg03 = (`"`s25err'"' == "dash: s25 probe")
    _w30_expect RG-03 "(`rg03' == 1)" "_dd_err `s25err'"
    _w30_done RG-03 "a module run by exec_module sets the local of the program running the python: line, so the load decides by value"
    capture erase "`w30_work'/s25_probe.py"

    quietly log using "`w30_work'/s25.log", text replace name(s25l)
    mata: display(char(123) + "bf:s25" + char(125), 1)
    quietly log close s25l
    cert_file_has "`w30_work'/s25.log", needle("{bf:s25}")
    local rg04 = r(found)
    _w30_expect RG-04 "(`rg04' == 1)" "found `rg04'"
    _w30_done RG-04 "Mata display(s, 1) prints SMCL as typed: dash_setup shows the path so"
    capture erase "`w30_work'/s25.log"
    display as text "S25 end " c(current_date) " " c(current_time)
}
* ==== end S25 ====

// S26's helpers (WP-30 P1.22), outside every gate: copies of
// test_wp29_truth.cscript's _fx_serset and _fx_stored, renamed.
//   _s26_serset  twoway's last graph's first plot's y, from its serset,
//                into the row matrix s26_sy.
//   _s26_stored <name>  the stored y of graph <name>'s layer 1, as the
//                row matrix s26_dy.
capture program drop _s26_serset
program define _s26_serset
    version 19
    preserve
    serset set `.Graph.plotregion1.plot1.serset.id'
    serset use, clear
    mata: st_matrix("s26_sy", st_data(., 1)')
    restore
end
capture program drop _s26_stored
program define _s26_stored
    version 19
    args name
    mata: _s = st_global("dash_fpts_" + st_local("name")); _a = strpos(_s, `""y":["') + 5; _t = substr(_s, _a, strpos(substr(_s, _a, .), "]") - 1); _v = tokens(_t, ","); _v = select(_v, _v :!= ","); st_matrix("s26_dy", strtoreal(_v))
end

* ==== S26 P1.22: function: closed by disposition ====
local only : env WP30_ONLY
if inlist("`only'", "", "S26") & `: list posof "S26" in w30_run' {
    display as text "S26 start " c(current_date) " " c(current_time)
    // FN-01: the thirteen expressions DROPIN P1.22 names are drawn from
    // Stata's points: stored == twoway's serset, and the saved page and the
    // served app draw them (the premise of the disposition, M12).
    quietly graph drop _all
    sysuse auto, clear
    quietly regress mpg weight
    scalar s26s = 2
    dash clear
    local s26_list `" "normalden(x)" "normal(x)" "ln(x)" "_pi*x" "c(pi)*x" "(x>1)*x" "cond(x>1,x,0)" "min(x,1)" "max(x,1)" "round(x)" "int(x-1)" "scalar(s26s)*x" "_b[_cons]+_b[weight]*x" "'
    local k 0
    local s26_names ""
    foreach e of local s26_list {
        local ++k
        quietly twoway function y = `e', range(0.1 2) n(5) nodraw
        _s26_serset
        matrix s26_want_`k' = s26_sy
        quietly graph drop _all
        capture noisily dash function y = `e', range(0.1 2) n(5) name(fn01_`k') title("fn01_`k'")
        _w30_expect FN-01 "(_rc == 0)" `"dash function y = `e' r(`=_rc')"'
        _s26_stored fn01_`k'
        mata: st_local("s26_eq", strofreal(st_matrix("s26_dy") == st_matrix("s26_sy")))
        _w30_expect FN-01 "(`s26_eq' == 1)" `"`e': stored y differs from twoway's serset"'
        local s26_names `s26_names' fn01_`k'
    }
    local s26_html "`w30_work'/s26.html"
    local s26_app  "`w30_work'/s26_app.py"
    quietly dash build, saving("`s26_html'") replace nobrowser
    quietly dash build, saving("`s26_app'") server replace
    global s26_names "`s26_names'"
    global s26_html "`s26_html'"
    global s26_app "`s26_app'"
    python:
import json as _json
import math as _math
import re as _re
import warnings as _w
from sfi import Macro as _M, Matrix as _X, Missing as _Miss
from bokeh.document import Document as _Doc
from bokeh.models import Plot as _Plot


def _s26_plots_saved(path):
    with open(path, encoding="utf-8") as fh:
        page = fh.read()
    out = dict()
    for blob in _re.findall(r'<script type="application/json" id="[^"]*">\s*(.*?)\s*</script>', page, _re.S):
        dj = _json.loads(blob)
        for dd in dj.values():
            doc = _Doc.from_json(dd)
            for p in doc.select(dict(type=_Plot)):
                out[p.title.text if p.title is not None else ""] = p
    return out


def _s26_plots_served(path):
    with open(path, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_s04_app")
    with _w.catch_warnings():
        _w.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_s04_app.py", "exec"), ns)
        doc = _Doc()
        ns["make_document"](doc)
    out = dict()
    for p in doc.select(dict(type=_Plot)):
        out[p.title.text if p.title is not None else ""] = p
    return out


def _s26_check():
    bad = []
    names = _M.getGlobal("s26_names").split()
    for mode, plots in (("saved", _s26_plots_saved(_M.getGlobal("s26_html"))),
                        ("served", _s26_plots_served(_M.getGlobal("s26_app")))):
        for nm in names:
            k = nm.split("_")[-1]
            want = [float("nan") if _Miss.isMissing(v) else float(v)
                    for v in _X.get("s26_want_" + k)[0]]
            got = None
            for g in (plots[nm].renderers if nm in plots else []):
                src = getattr(g, "data_source", None)
                if src is not None and "x_fn" in src.data:
                    got = [float(v) for _x, v in sorted(zip(src.data["x_fn"], src.data["y_fn"]), key=lambda t: t[0])]
            same = got is not None and len(got) == len(want) and all(
                u == v or (_math.isnan(u) and _math.isnan(v)) for u, v in zip(got, want))
            if not same:
                bad.append(mode + ":" + nm + ":" + repr(None if got is None else got[:4]))
    _M.setGlobal("s26_bad", " ".join(bad))


_s26_check()
end
    _w30_expect FN-01 `"("${s26_bad}" == "")"' `"drawn points differ: ${s26_bad}"'
    _w30_done FN-01 "thirteen expressions: stored, saved and served points are twoway's serset"
    dash clear
    capture erase "`s26_html'"
    capture erase "`s26_app'"
    macro drop s26_names s26_html s26_app s26_bad
    capture scalar drop s26s
    capture matrix drop s26_sy s26_dy
    forvalues k = 1/13 {
        capture matrix drop s26_want_`k'
    }
    display as text "S26 end " c(current_date) " " c(current_time)
}
* ==== end S26 ====

// S27 helpers (WP-30 P1.17b).  _db_bases(sp, dp, app): every tagged
// base of a registered dash graph, saved and served, as "base@lo,hi" per
// renderer (panels by label; lo,hi the unpadded scale of its axis) into
// globals DB_S and DB_V; _db_move: the served base after a RangeSlider move
// of x1 to (1, 3) and back, into DB_M; _db_tw: twoway's drawn_base and
// curmin,curmax of graph g's probes, into DB_T.
python:
import os as _db_os, sys as _db_sys
for _db_p in (_db_os.path.abspath(".."), _db_os.path.abspath(".")):
    if _db_p not in _db_sys.path:
        _db_sys.path.insert(0, _db_p)


def _db_fmt(b, sc):
    if sc is None:
        return "%.6g@none" % b
    return "%.6g@%.6g,%.6g" % (b, sc[0], sc[1])


def _db_read(figs):
    import dash_render as dr
    out = []
    # WP-30 P1.15a: panels by their label row (a Title named
    # dash_by_label); their titles are now all the graph's title.
    def key(f):
        lab = [m for m in list(f.above) + list(f.below)
               if type(m).__name__ == "Title" and m.name == "dash_by_label"]
        return str(getattr(lab[0] if lab else f.title, "text", "") or "")
    figs = sorted(figs, key=key)
    for f in figs:
        for r in f.renderers:
            bs = dr._dash_base_spec(r)
            if not bs:
                continue
            v = getattr(r.glyph, bs["prop"])
            fld = v if isinstance(v, str) else getattr(v, "field", None)
            vals = ({float(x) for x in r.data_source.data[fld]} if fld
                    else {float(getattr(v, "value", v))})
            name = getattr(r, "y_range_name", "default") or "default"
            out.append(_db_fmt(min(vals), dr._dash_axis_scale(f, "y", name)))
    return " ".join(out)


def _db_bases(sp, dp, app):
    from sfi import Macro
    from bokeh.plotting import figure as _Fig
    figs, sv, doc = _bg_docs(sp, dp, app)
    sv = [m for m in doc.models if isinstance(m, _Fig)]
    Macro.setGlobal("DB_S", _db_read(figs))
    Macro.setGlobal("DB_V", _db_read(sv))


def _db_move(sp, dp, app):
    from sfi import Macro
    from bokeh.models import RangeSlider
    from bokeh.plotting import figure as _Fig
    _, _, doc = _bg_docs(sp, dp, app)
    [w] = [m for m in doc.models if isinstance(m, RangeSlider)]
    got = []
    for v in ((1.0, 3.0), (1.0, 5.0)):
        old, w.value = w.value, v
        for key in ("value", "value_throttled"):
            for cb in list(w._callbacks.get(key, [])):
                cb("value", old, v)
        got.append(_db_read([m for m in doc.models if isinstance(m, _Fig)]))
    Macro.setGlobal("DB_M", " | ".join(got))


_db_main = __import__("__main__")
_db_main._db_bases = _db_bases
_db_main._db_move = _db_move
end

capture program drop _db_frame
program define _db_frame
    // The extractor's frame (scripts/extract_default_base_truth.do).
    version 19
    clear
    quietly set obs 5
    foreach v in x1 ypos y12 yneg ys g d ymix ydown {
        local w : copy global DB_COL_`v'
        quietly generate double `v' = real(word("`w'", _n))
    }
    format d %td
end

capture program drop _db_case
program define _db_case
    // id; the twoway command; its probes, each "prefix|region|plot" with
    // prefix "-" for the graph itself or ".graphs[i]" under by().  twoway's
    // drawn base and curmin,curmax are compared with dash's saved and
    // served bases and unpadded scales (_dash_axis_scale).
    version 19
    args id cmd probes
    _db_frame
    local sep = cond(strpos(`"`cmd'"', ",") & (substr(`"`cmd'"', 1, 1) != "(" | strpos(`"`cmd'"', "),")), " ", ", ")
    capture graph drop _all
    quietly twoway `cmd' `sep' name(g, replace)
    local tw ""
    foreach p of local probes {
        gettoken pre rest : p, parse("|")
        gettoken bar rest : rest, parse("|")
        gettoken reg rest : rest, parse("|")
        gettoken bar k : rest, parse("|")
        if "`pre'" == "-" local pre ""
        local b "`.g`pre'.`reg'.plot`k'.drawn_base'"
        local lo "`.g`pre'.`reg'.yscale.curmin'"
        local hi "`.g`pre'.`reg'.yscale.curmax'"
        local b = strtrim(strofreal(`b', "%12.6g"))
        local lo = strtrim(strofreal(`lo', "%12.6g"))
        local hi = strtrim(strofreal(`hi', "%12.6g"))
        local tw "`tw' `b'@`lo',`hi'"
    }
    local tw = strtrim("`tw'")
    capture graph drop _all
    capture dash clear
    global DB_K = $DB_K + 1
    local k = $DB_K
    quietly dash `cmd' `sep' name(zdb`k')
    quietly _dash_serve_spec, specpath("${DB_WORK}/s`k'.json") datapath("${DB_WORK}/d`k'.json")
    python: __import__("__main__")._db_bases(r"${DB_WORK}/s`k'.json", r"${DB_WORK}/d`k'.json", r"${DB_WORK}/a`k'.py")
    display as text `"  `id' `cmd': twoway [`tw'] saved [${DB_S}] served [${DB_V}]"'
    _w30_expect `id' `"("${DB_S}" == "`tw'" & "${DB_V}" == "`tw'")"' `"`cmd': twoway `tw', saved ${DB_S}, served ${DB_V}"'
    foreach x in s`k'.json d`k'.json a`k'.py {
        capture erase "${DB_WORK}/`x'"
    }
    capture dash clear
end

* ==== S27 P1.17b: twoway's default base and axis extent ====
local only : env WP30_ONLY
if inlist("`only'", "", "S27") & `: list posof "S27" in w30_run' {
    display as text "S27 start " c(current_date) " " c(current_time)
    global DB_WORK "`w30_work'"
    global DB_K 0
    global DB_COL_x1 "1 2 3 4 5"
    global DB_COL_ypos "10 11 12 13 14"
    global DB_COL_y12 "12 25 33 41 18"
    global DB_COL_yneg "-10 -11 -12 -13 -14"
    global DB_COL_ys "1 2 3 4 5"
    global DB_COL_g "1 1 2 2 2"
    global DB_COL_d "15000 15007 15014 15021 15028"
    global DB_COL_ymix "-3 5 8 2 -1"
    global DB_COL_ydown "14 13 12 11 10"
    local one "-|plotregion1|1"
    foreach t in bar spike dropline area {
        _db_case DB-01 "`t' y12 x1" "`one'"
    }
    _w30_done DB-01 "bar, spike, dropline and area stand on twoway's drawn_base (10) on its scale [10, 41], saved and served"
    foreach c in "bar ypos x1" "bar yneg x1" "bar ymix x1" {
        _db_case DB-02 "`c'" "`one'"
    }
    _db_case DB-02 "(bar y12 x1) (scatter ys x1)" "`one'"
    _w30_done DB-02 "bases 10, -10 and 0 by the sign of the data; 0 when a scatter takes the scale to 0"
    foreach c in "bar ypos x1, base(5)" "bar ypos x1, base(20)" "spike ypos x1, base(5)" {
        _db_case DB-03 "`c'" "`one'"
    }
    _db_case DB-03 "(bar ypos x1) (bar y12 x1, base(0))" "-|plotregion1|1 -|plotregion1|2"
    _w30_done DB-03 "an explicit base() is drawn where given and widens the scale as twoway's does"
    foreach t in bar area {
        _db_case DB-04 "`t' ypos x1, yscale(log)" "`one'"
    }
    _w30_done DB-04 "on a log axis the default base is the scale's lower end (10), never 0"
    _db_case DB-05 "(scatter y12 x1) (bar ypos x1, yaxis(2))" "-|plotregion2|2"
    _w30_done DB-05 "a yaxis(2) bar stands on its own axis's base (10)"
    _db_case DB-06 "bar y12 x1, by(g)" ".graphs[1]|plotregion1|1 .graphs[2]|plotregion1|1"
    _db_case DB-06 "bar y12 x1, by(g, yrescale)" ".graphs[1]|plotregion1|1 .graphs[2]|plotregion1|1"
    _db_case DB-06 "(scatter y12 x1) (bar ypos x1, yaxis(2)), by(g)" ".graphs[1]|plotregion2|2 .graphs[2]|plotregion2|2"
    _w30_done DB-06 "by() panels share the common scale's base (10, 10); yrescale gives each its own (10, 18); a shared y2 too"
    // DB-07: a served move of x1 to 1-3 and back; twoway's `if x1<=3'.
    _db_frame
    capture graph drop _all
    quietly twoway bar ydown x1 if x1<=3, name(g, replace)
    local w1 "`.g.plotregion1.plot1.drawn_base'"
    quietly twoway bar ydown x1, name(g, replace)
    local w0 "`.g.plotregion1.plot1.drawn_base'"
    capture graph drop _all
    capture dash clear
    quietly dash bar ydown x1, name(zdbm)
    quietly _dash_serve_spec, specpath("${DB_WORK}/sm.json") datapath("${DB_WORK}/dm.json") filter(x1, type(range))
    python: __import__("__main__")._db_move(r"${DB_WORK}/sm.json", r"${DB_WORK}/dm.json", r"${DB_WORK}/am.py")
    display as text `"  DB-07: twoway `w1' then `w0'; served ${DB_M}"'
    _w30_expect DB-07 `"(word("${DB_M}", 1) == "`w1'@`w1',14" & word("${DB_M}", 3) == "`w0'@`w0',14")"' `"served after the move ${DB_M}, twoway `w1' then `w0'"'
    foreach x in sm.json dm.json am.py {
        capture erase "${DB_WORK}/`x'"
    }
    capture dash clear
    _w30_done DB-07 "after a served move to x1<=3 the base is twoway's if (12); moved back, 10"
    // DB-08: %td -- the base is dash's own scale's low end (S44 gives the
    // scale twoway's 14997), never 0 ms; twoway's value is shown.
    _db_frame
    capture graph drop _all
    quietly twoway bar d x1, name(g, replace)
    local tb "`.g.plotregion1.plot1.drawn_base'"
    capture graph drop _all
    capture dash clear
    quietly dash bar d x1, name(zdbd)
    quietly _dash_serve_spec, specpath("${DB_WORK}/sd.json") datapath("${DB_WORK}/dd.json")
    python: __import__("__main__")._db_bases(r"${DB_WORK}/sd.json", r"${DB_WORK}/dd.json", r"${DB_WORK}/ad.py")
    display as text `"  DB-08: twoway `tb' (days); saved ${DB_S}, served ${DB_V} (ms)"'
    foreach m in S V {
        local v "${DB_`m'}"
        gettoken b rest : v, parse("@")
        gettoken at rest : rest, parse("@")
        gettoken lo hi : rest, parse(",")
        _w30_expect DB-08 "(`b' == `lo' & `b' != 0 & `b' > -315619200000)" "`m': base `b', scale from `lo'"
    }
    foreach x in sd.json dd.json ad.py {
        capture erase "${DB_WORK}/`x'"
    }
    capture dash clear
    _w30_done DB-08 "on a %td axis the base is the scale's low end, not 01jan1970 (twoway's 14997 waits for S44)"
    macro drop DB_*
    display as text "S27 end " c(current_date) " " c(current_time)
}
* ==== end S27 ====

* _s28_count using <file>, needle(<text>): how many times the text occurs
* in the file, in r(n); -1 when it cannot be read.  The needle reaches
* Mata through st_local, never expanded inside Mata source.
capture program drop _s28_count
program define _s28_count, rclass
    version 19
    syntax using/, needle(string)
    local _s28f `"`using'"'
    local _s28n `"`needle'"'
    mata: st_local("_s28c", strofreal(_s28_count_of(st_local("_s28f"), st_local("_s28n"))))
    return scalar n = `_s28c'
end
capture mata: mata drop _s28_count_of()
mata:
real scalar _s28_count_of(string scalar path, string scalar n)
{
    real scalar   fh, len
    string scalar s
    fh = _fopen(path, "r")
    if (fh < 0) return(-1)
    fseek(fh, 0, 1)
    len = ftell(fh)
    fseek(fh, 0, -1)
    s = (len > 0 ? fread(fh, len) : "")
    fclose(fh)
    return((strlen(s) - strlen(subinstr(s, n, "", .))) / strlen(n))
}
end

* ==== S28 P1.15a: by() panel labels and overall text ====
local only : env WP30_ONLY
if inlist("`only'", "", "S28") & `: list posof "S28" in w30_run' {
    display as text "S28 start " c(current_date) " " c(current_time)
    local q = char(34)

    // BP-01 (guard, the truth): twoway's labels, repeated title and note.
    sysuse auto, clear
    quietly twoway scatter mpg weight, title("T") by(foreign rep78, missing) name(Graph, replace)
    local s28l1 `"`.Graph.graphs[1].subtitle.text[1]'"'
    local s28l6 `"`.Graph.graphs[6].subtitle.text[1]'"'
    local s28t1 `"`.Graph.graphs[1].title.text[1]'"'
    local s28nt `"`.Graph.note.text[1]'"'
    _w30_expect BP-01 `"(`"`s28l1'"' == "Domestic, 1")"' `"panel 1 label `s28l1'"'
    _w30_expect BP-01 `"(`"`s28l6'"' == "Domestic, (missing)")"' `"panel 6 label `s28l6'"'
    _w30_expect BP-01 `"(`"`s28t1'"' == "T")"' `"panel title `s28t1'"'
    _w30_expect BP-01 `"(`"`s28nt'"' == "Graphs by Car origin and Repair record 1978")"' `"note `s28nt'"'
    _w30_done BP-01 "twoway labels Domestic, 1 under T and notes Graphs by"
    quietly graph drop _all

    // BP-02: dash draws the same texts; no em-dash join, no slash join.
    quietly dash scatter mpg weight, title("T") by(foreign rep78, missing) saving("`w30_work'/s28a.html", replace)
    foreach t in "Domestic, 1" "Domestic, (missing)" "Foreign, (missing)" "Graphs by Car origin and Repair record 1978" {
        cert_file_has "`w30_work'/s28a.html", needle(`"`q'text`q':`q'`t'`q'"')
        _w30_expect BP-02 "(r(found) == 1)" `"the page lacks `t'"'
    }
    foreach t in "Domestic / 1" "/ Missing" {
        cert_file_has "`w30_work'/s28a.html", needle(`"`t'"')
        _w30_expect BP-02 "(r(found) == 0)" `"the page still holds `t'"'
    }
    _s28_count using "`w30_work'/s28a.html", needle("dash_by_label")
    _w30_expect BP-02 "(r(n) == 10)" "panel labels: `r(n)'"
    _w30_done BP-02 "dash labels every panel and draws the note as twoway does"

    // BP-03: a string "" is missing in the panels and in Total.
    sysuse auto, clear
    generate str4 s = cond(foreign, "F", "")
    replace s = "D" in 1/40
    quietly dash scatter mpg weight, by(s, total) saving("`w30_work'/s28b.html", replace)
    _s28_count using "`w30_work'/s28b.html", needle("dash_by_label")
    _w30_expect BP-03 "(r(n) == 3)" "panels: `r(n)' (twoway: D, F, Total)"
    cert_file_has "`w30_work'/s28b.html", needle(`"`q'text`q':`q'Graphs by s`q'"')
    _w30_expect BP-03 "(r(found) == 1)" "no Graphs by s note"
    _w30_done BP-03 "by(s, total) draws D, F and Total, as twoway does"

    // BP-04: every value "" and missing: one (missing) panel.
    generate str1 e = ""
    quietly dash scatter mpg weight, by(e, missing) saving("`w30_work'/s28c.html", replace)
    cert_file_has "`w30_work'/s28c.html", needle(`"`q'text`q':`q'(missing)`q'"')
    _w30_expect BP-04 "(r(found) == 1)" "no (missing) panel"
    capture dash scatter mpg weight, by(e) saving("`w30_work'/s28d.html", replace)
    _w30_expect BP-04 "(_rc == 198)" "by(e) rc `_rc' (twoway: nothing to graph, 198)"
    _w30_done BP-04 "a string by() variable of empty values is one (missing) panel, or nothing to graph"

    // BP-05: by(, title subtitle note caption) once, and not named.
    sysuse auto, clear
    quietly graph drop _all
    local s28log "`w30_work'/s28e.log"
    quietly log using "`s28log'", text replace name(s28e)
    dash scatter mpg weight, by(foreign, title("X") subtitle("S") note("N") caption("C")) saving("`w30_work'/s28e.html", replace)
    quietly log close s28e
    foreach t in X S N C {
        _s28_count using "`w30_work'/s28e.html", needle(`"`q'text`q':`q'`t'`q'"')
        _w30_expect BP-05 "(r(n) == 1)" `"`t' drawn `r(n)' times"'
    }
    cert_log_has "`s28log'", needle("by() sub-option")
    _w30_expect BP-05 "(r(count) == 0)" "a by() text sub-option was named"
    _w30_done BP-05 "by()'s title, subtitle, note and caption are drawn once"

    // BP-06: note("") removes the note; subtitle("S", prefix) merges.
    quietly dash scatter mpg weight, subtitle("S", prefix) by(foreign, note("")) saving("`w30_work'/s28f.html", replace)
    cert_file_has "`w30_work'/s28f.html", needle("Graphs by")
    _w30_expect BP-06 "(r(found) == 0)" "note() did not remove the note"
    cert_file_has "`w30_work'/s28f.html", needle(`"`q'text`q':`q'S\nDomestic`q'"')
    _w30_expect BP-06 "(r(found) == 1)" "subtitle(S, prefix) did not lead the label"
    _w30_done BP-06 "note() removes the note and subtitle() merges with the label"

    // BP-07: three variables: twoway's note names the first by its name.
    quietly twoway scatter mpg weight, by(foreign rep78 headroom) name(Graph, replace)
    local s28n `"`.Graph.note.text[1]'"'
    quietly graph drop _all
    quietly dash scatter mpg weight, by(foreign rep78 headroom) saving("`w30_work'/s28g.html", replace)
    cert_file_has "`w30_work'/s28g.html", needle(`"`q'text`q':`q'`s28n'`q'"')
    _w30_expect BP-07 "(r(found) == 1)" `"dash's note is not twoway's `s28n'"'
    _w30_done BP-07 "the three-variable note is twoway's text"

    // BP-08 (guard, until S48): TITLE() is refused by twoway and never drawn.
    capture twoway scatter mpg weight, by(foreign, TITLE("Xq"))
    _w30_expect BP-08 "(_rc == 198)" "twoway rc `_rc'"
    capture dash scatter mpg weight, by(foreign, TITLE("Xq")) saving("`w30_work'/s28h.html", replace)
    if _rc == 0 {
        cert_file_has "`w30_work'/s28h.html", needle(`"`q'text`q':`q'Xq`q'"')
        _w30_expect BP-08 "(r(found) == 0)" "TITLE() was drawn"
    }
    _w30_done BP-08 "a capitalised by() title is never drawn"

    capture graph drop _all
    foreach f in s28a s28b s28c s28d s28e s28f s28g s28h {
        capture erase "`w30_work'/`f'.html"
    }
    capture erase "`s28log'"
    display as text "S28 end " c(current_date) " " c(current_time)
}
* ==== end S28 ====

* ==== S29 P1.11b: SMCL in graph text ====
local only : env WP30_ONLY
if inlist("`only'", "", "S29") & `: list posof "S29" in w30_run' {
    display as text "S29 start " c(current_date) " " c(current_time)
    local W "`w30_work'"

    // GT-01 (guard, the truth): a symbol, a character, a whole-bold text,
    // value labels as panel titles, string and immediate marker labels.
    sysuse auto, clear
    quietly twoway scatter mpg weight, title("{&alpha} R{c 233}") ///
        subtitle("{bf:Whole bold}") name(s29a, replace)
    cert_svg_export, name(s29a) file("`W'/s29a.svg")
    local s29_svg "`r(file)'"
    foreach t in "α Ré" "Whole bold" {
        cert_svg_has_text, file("`s29_svg'") text(`"`t'"')
        local s29_f = r(found)
        _w30_expect GT-01 "(`s29_f' == 1)" `"twoway did not draw `t'"'
    }
    label define s29o 0 "{it:Dom}" 1 "{&alpha}For", replace
    label values foreign s29o
    generate str12 s29ml = cond(foreign, "{&beta}b", "{bf:Bx}")
    quietly twoway scatter mpg weight, by(foreign) mlabel(s29ml) name(s29b, replace)
    cert_svg_export, name(s29b) file("`W'/s29b.svg")
    local s29_svg "`r(file)'"
    foreach t in "Dom" "αFor" "βb" "Bx" {
        cert_svg_has_text, file("`s29_svg'") text(`"`t'"')
        local s29_f = r(found)
        _w30_expect GT-01 "(`s29_f' >= 1)" `"twoway did not draw `t'"'
    }
    quietly twoway scatteri 2 2 "{&beta}imm" 4 3 "{bf:Bimm}", name(s29c, replace)
    cert_svg_export, name(s29c) file("`W'/s29c.svg")
    cert_svg_has_text, file("`r(file)'") text("βimm")
    local s29_f = r(found)
    _w30_expect GT-01 "(`s29_f' == 1)" "twoway did not draw the scatteri label"
    // twoway cuts a label off at {c 0}, keeping the text before it
    // (measured 08oct2026; register A34 "Mirror twoway"): the label is
    // exactly s29qzq, and the anchor proves the graph was drawn and read.
    quietly twoway scatteri 2 2 "s29qzq{c 0}x" 4 3 "s29anchor", name(s29z, replace)
    cert_svg_export, name(s29z) file("`W'/s29z.svg")
    local s29_svg "`r(file)'"
    cert_svg_has_text, file("`s29_svg'") text("s29qzq")
    local s29_f = r(found)
    cert_svg_has_text, file("`s29_svg'") text("s29anchor")
    local s29_a = r(found)
    _w30_expect GT-01 "(`s29_f' == 1 & `s29_a' == 1)" ///
        "twoway c-0 label cut `s29_f', anchor `s29_a'"
    _w30_done GT-01 "twoway draws graph-text markup"
    quietly graph drop _all

    // GT-02: the same titles in dash.  The page JSON writes every non-ASCII
    // character as a lower-case \uXXXX escape (bokeh 3.9 measured: "α Ré" is
    // written \u03b1 R\u00e9), so every needle holding one is written so.
    // Stata 19 decodes a \uXXXX in a string literal itself (measured
    // 08oct2026), so each needle spells its backslash `s29b' = char(92).
    local s29b = char(92)
    quietly dash scatter mpg weight, title("{&alpha} R{c 233}") ///
        subtitle("{bf:Whole bold}") saving("`W'/s29a.html", replace)
    cert_file_has "`W'/s29a.html", needle("`s29b'u03b1 R`s29b'u00e9")
    local s29_t = r(found)
    cert_file_has "`W'/s29a.html", needle("{&amp;alpha}")
    local s29_r1 = r(found)
    cert_file_has "`W'/s29a.html", needle("{bf:Whole bold}")
    local s29_r2 = r(found)
    _w30_expect GT-02 "(`s29_t' == 1 & `s29_r1' == 0 & `s29_r2' == 0)" ///
        "titles: translated `s29_t', raw symbol `s29_r1', raw bold `s29_r2'"
    _w30_done GT-02 "titles carry the translated text"

    // GT-03: labels -- a variable label as the y title, value labels as panels.
    label variable mpg "{&mu} mpg{sup:2}"
    quietly dash scatter mpg weight, by(foreign) saving("`W'/s29b.html", replace)
    cert_file_has "`W'/s29b.html", needle("`s29b'u03bc mpg`s29b'u00b2")
    local s29_y = r(found)
    cert_file_has "`W'/s29b.html", needle("`s29b'u03b1For")
    local s29_p = r(found)
    _w30_expect GT-03 "(`s29_y' == 1 & `s29_p' == 1)" ///
        "labels: y title `s29_y', panel title `s29_p'"
    _w30_done GT-03 "variable and value labels are translated"

    // GT-04: string marker labels: a translated column and a style column.
    quietly dash scatter mpg weight, mlabel(s29ml) saving("`W'/s29m.html", replace)
    cert_file_has "`W'/s29m.html", needle("`s29b'u03b2b")
    local s29_m = r(found)
    cert_file_has "`W'/s29m.html", needle("__dash_mlabstyle_s29ml")
    local s29_s = r(found)
    _w30_expect GT-04 "(`s29_m' == 1 & `s29_s' == 1)" ///
        "mlabel: translated `s29_m', style column `s29_s'"
    _w30_done GT-04 "string marker labels are translated, whole bold kept"

    // GT-05: immediate labels.
    quietly dash scatteri 2 2 "{&beta}imm" 4 3 "{bf:Bimm}", saving("`W'/s29i.html", replace)
    cert_file_has "`W'/s29i.html", needle("`s29b'u03b2imm")
    local s29_i = r(found)
    quietly dash pcarrowi 1 1 2 2 "{&gamma}arr", saving("`W'/s29j.html", replace)
    cert_file_has "`W'/s29j.html", needle("`s29b'u03b3arr")
    local s29_j = r(found)
    _w30_expect GT-05 "(`s29_i' == 1 & `s29_j' == 1)" ///
        "immediates: scatteri `s29_i', pcarrowi `s29_j'"
    _w30_done GT-05 "immediate labels are translated"

    // GT-06: one note per graph and kind, never echoing the text.  The
    // text is built with char() so the command echo cannot hold it.
    local s29t = char(123) + "bf:a" + char(125) + "b"
    capture log close s29l
    quietly log using "`W'/s29n.log", text replace name(s29l)
    quietly dash scatter mpg weight, title("`s29t'") by(foreign) ///
        saving("`W'/s29n.html", replace)
    quietly log close s29l
    cert_log_has "`W'/s29n.log", needle("own style")
    local s29_n = r(count)
    cert_log_has "`W'/s29n.log", needle("{bf:a}b")
    local s29_e = r(count)
    _w30_expect GT-06 "(`s29_n' == 1 & `s29_e' == 0)" ///
        "note lines `s29_n', user text echoed `s29_e'"
    _w30_done GT-06 "one note, no user text"

    // GT-07: as twoway draws them (A34, "Mirror twoway"): control codes
    // are kept, and the page JSON carries them as lower-case \u escapes,
    // never raw; {c 0} cuts the text off, as twoway does (measured
    // 08oct2026), so the subtitle is exactly s29qzq.
    sysuse auto, clear
    quietly dash scatter mpg weight, title("a{c 1}b{c 27}c{c 129}d") ///
        subtitle("s29qzq{c 0}x") saving("`W'/s29k.html", replace)
    cert_file_has "`W'/s29k.html", needle(`""text":"a\u0001b\u001bc\u0081d""')
    local s29_k = r(found)
    cert_file_has "`W'/s29k.html", needle(`""text":"s29qzq""')
    local s29_z = r(found)
    cert_file_has "`W'/s29k.html", needle("s29qzq{c 0}x")
    local s29_r = r(found)
    _w30_expect GT-07 "(`s29_k' == 1 & `s29_z' == 1 & `s29_r' == 0)" ///
        "escaped control title `s29_k', cut subtitle `s29_z', raw `s29_r'"
    _w30_done GT-07 "control codes kept and escaped, c-0 cuts the text"

    // GT-08 (guard): a title of 5,000 open braces builds.
    local s29h = 5000*"{"
    capture quietly dash scatter mpg weight, title("`s29h'x") ///
        saving("`W'/s29h.html", replace)
    local s29_rc = _rc
    _w30_expect GT-08 "(`s29_rc' == 0)" "hostile title rc `s29_rc'"
    _w30_done GT-08 "hostile markup builds"

    display as text "S29 end " c(current_date) " " c(current_time)
}
* ==== end S29 ====

// ----------------------------------------------------------------
// S30 helpers (WP-30 P1.13a), outside every gate: _s30_svg reads
// twoway's SVG (marker fills of the largest circles, the dominant narrow
// rect fill, the dominant stroke of the series paths, the fill of the text
// "T", the vertical line strokes, the graph region's rect); _s30_page and
// _s30_app read dash's saved page and served app (every glyph renderer's
// Type:fill_color:fill_alpha:line_color, the figure's border_fill_color,
// the title's text_color and the Span colours), the app also after a
// Select move on foreign; _s30_cmp compares one property of the three.
// Every argument crosses through sfi.Macro.
python:
import collections as _s30_col
import json as _s30_json
import html as _s30_html
import os as _s30_os
import re as _s30_re
import sys as _s30_sys
import warnings as _s30_w
from sfi import Macro as _s30_M


def _s30_svg():
    _s30_sys.path.insert(0, _s30_os.path.join(_s30_M.getGlobal("S30_REPO"), "scripts"))
    from svg_truth import svg_document
    doc = svg_document(_s30_M.getGlobal("S30_SVG"))
    kind = _s30_M.getGlobal("S30_KIND")
    items = []
    if kind == "marker":
        circ = [c for c in doc["circles"]
                if c.get("fill") and c["fill"] != "none" and c.get("r")]
        rmax = max(c["r"] for c in circ) if circ else 0
        items = [(c["fill"], c.get("fill_opacity")) for c in circ
                 if c["r"] == rmax]
    elif kind == "bar":
        cw = doc["canvas"]["w"]
        items = [(r["fill"], None) for r in doc["rects"]
                 if r.get("w") and 0 < r["w"] < cw / 3.0
                 and r.get("fill") not in (None, "none")]
    elif kind == "line":
        items = [(p["stroke"], None) for p in doc["paths"]
                 if p.get("fill") in (None, "none") and p.get("stroke")
                 and p["stroke"] != "none"]
    elif kind == "title":
        items = [(t["fill"], None) for t in doc["texts"] if t["text"] == "T"]
    elif kind == "refline":
        items = [(d["stroke"], None) for d in doc["vlines"] if d.get("stroke")]
    c = _s30_col.Counter(items)
    f, o = c.most_common(1)[0][0] if c else ("", None)
    if kind == "marker":
        # every marker colour, in order of first appearance (two layers)
        seen = []
        for x in items:
            if x[0] not in seen:
                seen.append(x[0])
        f = ",".join(seen)
    rects = doc["rects"]
    region = rects[1]["fill"] if len(rects) > 1 else ""
    _s30_M.setGlobal("S30_TW", "%s|%s|%s" % (f, 1.0 if o is None else o, region))


def _s30_v(x):
    x = getattr(x, "value", x)
    return str(x).lower()


def _s30_read(doc):
    from bokeh.models import GlyphRenderer, Span, Plot
    g = []
    for r in doc.select({"type": GlyphRenderer}):
        gl = r.glyph
        g.append("%s:%s:%s:%s" % (type(gl).__name__, _s30_v(getattr(gl, "fill_color", "")),
                                  _s30_v(getattr(gl, "fill_alpha", "")),
                                  _s30_v(getattr(gl, "line_color", ""))))
    plots = list(doc.select({"type": Plot}))
    p = plots[0] if plots else None
    border = _s30_v(p.border_fill_color) if p is not None else ""
    title = _s30_v(p.title.text_color) if p is not None and p.title is not None else ""
    spans = ",".join(_s30_v(s.line_color) for s in doc.select({"type": Span}))
    return "%s|%s|%s|%s" % (";".join(g), border, title, spans)


def _s30_page():
    from bokeh.document import Document
    with open(_s30_M.getGlobal("S30_PAGE"), encoding="utf-8") as fh:
        page = fh.read()
    out = ""
    for blob in _s30_re.findall('<script type="application/json"[^>]*>(.*?)</script>', page, _s30_re.S):
        try:
            docs = _s30_json.loads(_s30_html.unescape(blob))
        except ValueError:
            continue
        for dj in (docs.values() if isinstance(docs, dict) else []):
            if not isinstance(dj, dict) or "roots" not in dj:
                continue
            with _s30_w.catch_warnings():
                _s30_w.simplefilter("ignore")
                doc = Document.from_json(dj)
            out = _s30_read(doc)
            break
        if out:
            break
    _s30_M.setGlobal("S30_D", out)


def _s30_app():
    from bokeh.document import Document
    from bokeh.models import Select
    with open(_s30_M.getGlobal("S30_APP"), encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_s30_app")
    with _s30_w.catch_warnings():
        _s30_w.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_s30_app.py", "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    before = _s30_read(doc)
    _s30_M.setGlobal("S30_S", before)
    same = "0"
    sels = [m for root in doc.roots for m in root.select({"type": Select})
            if getattr(m, "_dash_var", None) == "foreign"]
    if sels:
        w = sels[0]
        opts = [o[0] if isinstance(o, (list, tuple)) else o for o in w.options]
        if len(opts) > 1:
            w.value = opts[1]
            for key in ("value", "value_throttled"):
                for cb in list(w._callbacks.get(key, [])):
                    cb("value", None, opts[1])
            same = "1" if _s30_read(doc) == before else "0"
    _s30_M.setGlobal("S30_SAME_AFTER", same)


def _s30_cmp():
    """S30_OK = 1 when twoway's colour (S30_KIND) equals both modes':
    marker -> every Scatter's fill (and opacity), as a set; bar ->
    the VBar fill; line -> the Line colour; title -> the title colour;
    refline -> a Span colour; and the graph region when S30_REGION is 1."""
    tw = _s30_M.getGlobal("S30_TW").split("|")
    kind = _s30_M.getGlobal("S30_KIND")
    ok, msg = len(tw) == 3, ["twoway " + "|".join(tw)]
    for mode in ("D", "S"):
        got = _s30_M.getGlobal("S30_" + mode).split("|")
        if len(got) != 4:
            ok = False
            msg.append(mode + " none")
            continue
        ents = [e.split(":") for e in got[0].split(";") if e]
        if kind == "marker":
            mine = [e for e in ents if e[0] == "Scatter"]
            # sorted: the served document's select order is not the
            # layer order
            fills = ",".join(sorted(e[1] for e in mine))
            ok = ok and fills == ",".join(sorted(tw[0].split(","))) and all(
                abs(float(e[2]) - float(tw[1])) < 1e-9 for e in mine)
            d = fills
        elif kind == "bar":
            d = ",".join(e[1] for e in ents if e[0] == "VBar")
            ok = ok and d.split(",")[0] == tw[0]
        elif kind == "line":
            d = ",".join(e[3] for e in ents if e[0] == "Line")
            ok = ok and d.split(",")[0] == tw[0]
        elif kind == "title":
            d = got[2]
            ok = ok and d == tw[0]
        else:
            d = got[3]
            ok = ok and tw[0] in d.split(",")
        if _s30_M.getGlobal("S30_REGION") == "1":
            ok = ok and got[1] == tw[2]
            d += " region " + got[1]
        msg.append(mode + " " + d)
    _s30_M.setGlobal("S30_OK", "1" if ok else "0")
    _s30_M.setGlobal("S30_MSG", "; ".join(msg)[:240])
end

// _s30_case tag scheme kind "twoway command" work: twoway and dash (saved,
// served with a foreign dropdown filter) on one command; sets S30_OK,
// S30_MSG, S30_SAME_AFTER, S30_RC, S30_TNOTE (twoway's log says "named
// style"), S30_DNOTES (the (note: lines of dash's saved build) and
// S30_DCOL (those naming "mcolor(").
capture program drop _s30_case
program define _s30_case
    version 19
    args tag scheme kind cmd work
    quietly sysuse auto, clear
    local svg "`work'/cg_`tag'.svg"
    local page "`work'/cg_`tag'.html"
    local app "`work'/cg_`tag'.py"
    local tlog "`work'/cg_`tag'_t.log"
    local dlog "`work'/cg_`tag'_d.log"
    local c = cond(strpos(`"`cmd'"', ","), " ", ", ")
    if substr(`"`cmd'"', 1, 1) == "(" local c ", "
    quietly graph drop _all
    quietly log using "`tlog'", text replace name(s30t)
    capture noisily twoway `cmd' `c' scheme(`scheme') name(g, replace)
    local trc = _rc
    quietly log close s30t
    if !`trc' quietly graph export "`svg'", replace name(g)
    quietly graph drop _all
    capture dash clear
    quietly log using "`dlog'", text replace name(s30d)
    capture noisily dash `cmd' `c' scheme(`scheme') saving("`page'", replace)
    local drc = _rc
    quietly log close s30d
    capture dash clear
    capture noisily dash `cmd' `c' scheme(`scheme') name(g1)
    local drc = `drc' + _rc
    capture noisily dash build, server saving("`app'") replace nobrowser filter(foreign, type(dropdown))
    local drc = `drc' + _rc
    foreach g in S30_TW S30_D S30_S S30_MSG {
        global `g' ""
    }
    global S30_SAME_AFTER "0"
    global S30_OK "0"
    global S30_SVG "`svg'"
    global S30_PAGE "`page'"
    global S30_APP "`app'"
    global S30_KIND "`kind'"
    if !`trc' capture noisily python: __import__("__main__")._s30_svg()
    if !`drc' capture noisily python: __import__("__main__")._s30_page()
    if !`drc' capture noisily python: __import__("__main__")._s30_app()
    if !`trc' & !`drc' capture noisily python: __import__("__main__")._s30_cmp()
    global S30_RC = `trc' + `drc'
    capture cert_log_has "`tlog'", needle("named style")
    global S30_TNOTE = cond(_rc, 0, r(found))
    mata: st_global("S30_DNOTES", strofreal(_s30_count(st_local("dlog"), "(note:", "")))
    mata: st_global("S30_DCOL", strofreal(_s30_count(st_local("dlog"), "(note:", "mcolor(")))
    capture dash clear
    foreach f in svg page app tlog dlog {
        capture erase "``f''"
    }
    capture graph drop g
end

// The number of lines of a log that start with `head' and hold `has'.
capture mata: mata drop _s30_count()
mata:
real scalar _s30_count(string scalar path, string scalar head, string scalar has)
{
    real scalar fh, n
    string scalar ln
    n = 0
    fh = fopen(path, "r")
    while ((ln = fget(fh)) != J(0, 0, "")) {
        ln = strtrim(ln)
        if (substr(ln, 1, strlen(head)) == head & (has == "" | strpos(ln, has) > 0)) n++
    }
    fclose(fh)
    return(n)
}
end

* ==== S30 P1.13a: Stata colour grammar ====
local only : env WP30_ONLY
if inlist("`only'", "", "S30") & `: list posof "S30" in w30_run' {
    display as text "S30 start " c(current_date) " " c(current_time)
    global S30_REPO "`c(pwd)'/.."
    global S30_REGION "0"
    local s30_after ""

    // CG-10: the grammar's forms, s2color, both modes.
    foreach v in "navy*.5" "navy*100" `""85 40 0 144""' `""hsv 209 .766 .435""' "bg" "fg" "navy*.5%50" {
        _s30_case m10 s2color marker `"scatter mpg weight, mcolor(`v')"' "`w30_work'"
        _w30_expect CG-10 "(${S30_RC} == 0 & ${S30_OK} == 1)" `"mcolor(`v'): ${S30_MSG}"'
        if `"`v'"' == "navy*.5" local s30_after "`s30_after'${S30_SAME_AFTER}"
    }
    _w30_done CG-10 "colour*#, CMYK, HSV, bg, fg and %# beside *# are twoway's colours, saved and served"

    // CG-11: unknown and wrong-case colours: black, a note in each.
    foreach v in "bogus" "Navy" "grey" `""300 0 0""' {
        _s30_case m11 s2color marker `"scatter mpg weight, mcolor(`v')"' "`w30_work'"
        _w30_expect CG-11 "(${S30_RC} == 0 & ${S30_OK} == 1)" `"mcolor(`v'): ${S30_MSG}"'
        _w30_expect CG-11 "(${S30_TNOTE} == 1 & ${S30_DCOL} == 1)" `"mcolor(`v'): twoway note ${S30_TNOTE}, dash mcolor notes ${S30_DCOL}"'
    }
    _w30_done CG-11 "bogus, Navy, grey and 300 0 0 are drawn black with one note, as twoway draws them"

    // CG-12: malformed: the default, silently.
    foreach v in "red*abc" `""#F00""' {
        _s30_case m12 s2color marker `"scatter mpg weight, mcolor(`v')"' "`w30_work'"
        _w30_expect CG-12 "(${S30_RC} == 0 & ${S30_OK} == 1)" `"mcolor(`v'): ${S30_MSG}"'
        _w30_expect CG-12 "(${S30_TNOTE} == 0 & ${S30_DNOTES} == 0)" `"mcolor(`v'): notes ${S30_TNOTE} ${S30_DNOTES}"'
    }
    _w30_done CG-12 "red*abc and #F00 keep the scheme's #1A476F in silence, as in twoway"

    // CG-13: s1rcolor multiplies, and fg is its white.
    foreach v in "navy*.5" "fg" {
        _s30_case m13 s1rcolor marker `"scatter mpg weight, mcolor(`v')"' "`w30_work'"
        _w30_expect CG-13 "(${S30_RC} == 0 & ${S30_OK} == 1)" `"mcolor(`v'): ${S30_MSG}"'
    }
    _w30_done CG-13 "under s1rcolor navy*.5 multiplies and fg is white, as twoway draws them"

    // CG-14: a user scheme's colours, read with the grammar.
    tempname s30fh
    foreach f in "`w30_work'/scheme-cg14.scheme" "`w30_work'/cg14.scheme" {
        file open `s30fh' using "`f'", write text replace
        file write `s30fh' "#include s2color" _n "color p1 navy*.5" _n `"color p2 "hsv 240 1 1""' _n "color background bogus" _n
        file close `s30fh'
    }
    local s30_home `"`c(pwd)'"'
    adopath ++ "`w30_work'"
    quietly cd "`w30_work'"
    global S30_REGION "1"
    _s30_case m14 cg14 marker "(scatter mpg weight) (scatter price weight, yaxis(2))" "`w30_work'"
    global S30_REGION "0"
    quietly cd `"`s30_home'"'
    adopath - "`w30_work'"
    _w30_expect CG-14 "(${S30_RC} == 0 & ${S30_OK} == 1)" `"${S30_MSG}"'
    local s30_after "`s30_after'${S30_SAME_AFTER}"
    capture erase "`w30_work'/scheme-cg14.scheme"
    capture erase "`w30_work'/cg14.scheme"
    _w30_done CG-14 "a user scheme's navy*.5, hsv 240 1 1 and unknown background are drawn as twoway draws them"

    // CG-15: bars, lines, titles and reference lines.
    _s30_case b15 s2color bar "bar mpg rep78 if rep78<., lcolor(none) fcolor(bogus)" "`w30_work'"
    _w30_expect CG-15 "(${S30_RC} == 0 & ${S30_OK} == 1)" `"fcolor(bogus): ${S30_MSG}"'
    _s30_case l15 s2color line "line mpg weight, sort lcolor(navy*.5)" "`w30_work'"
    _w30_expect CG-15 "(${S30_RC} == 0 & ${S30_OK} == 1)" `"lcolor(navy*.5): ${S30_MSG}"'
    _s30_case t15 s2color title `"scatter mpg weight, title("T", color(bogus))"' "`w30_work'"
    _w30_expect CG-15 "(${S30_RC} == 0 & ${S30_OK} == 1)" `"title color(bogus): ${S30_MSG}"'
    _s30_case x15 s2color refline "scatter mpg weight, xline(3000, lcolor(bogus))" "`w30_work'"
    _w30_expect CG-15 "(${S30_RC} == 0 & ${S30_OK} == 1)" `"xline lcolor(bogus): ${S30_MSG}"'
    _w30_done CG-15 "a bar's unknown fill is #333333, a line's navy*.5 #8DA3B7, and an unknown title and xline colour black, in both modes"

    // CG-16: the served app after a filter move.
    _w30_expect CG-16 `"("`s30_after'" == "11")"' "after the move: `s30_after'"
    _w30_done CG-16 "the served app redraws CG-10's navy*.5 and CG-14's scheme colours after a filter move"
    macro drop S30_*
    display as text "S30 end " c(current_date) " " c(current_time)
}
* ==== end S30 ====

// S31 helpers (WP-30 P1.18a): the saved page's axes, read back from the
// page, against the same command's twoway members.  _axl_saved is
// test_bug_regressions.cscript's _br_saved, its helpers renamed _axl_, and
// returns the page's plots that carry axes.
python:
import html, json, math, re, warnings
from bokeh.document import Document
from bokeh.models import Plot
from sfi import Macro

def _axl_plots(roots):
    seen, out = set(), []
    for root in roots:
        for m in root.references():
            if isinstance(m, Plot) and m.id not in seen:
                seen.add(m.id)
                out.append(m)
    return out

def _axl_saved(page_path):
    page = open(page_path, encoding="utf-8").read()
    m = re.search(r'<script type="application/json" id="[^"]*">(.*?)</script>',
                  page, re.S)
    if m is not None:
        docs = json.loads(html.unescape(m.group(1)))
    else:
        m = re.search(r"const docs_json = '(.*?)';", page, re.S)
        if m is None:
            return []
        bs = chr(92)
        docs = json.loads(html.unescape(m.group(1).replace(bs + bs, bs)))
    figs = []
    for dj in docs.values():
        with warnings.catch_warnings():
            warnings.simplefilter("ignore")
            figs += _axl_plots(Document.from_json(dj).roots)
    sides = ("left", "right", "below", "above")
    return [f for f in figs
            if any(type(a).__name__.endswith("Axis")
                   for s in sides for a in getattr(f, s))]

def _axl_profile(fig):
    out = {}
    for s in ("left", "right", "below", "above"):
        for a in getattr(fig, s):
            if not type(a).__name__.endswith("Axis"):
                continue
            letter = "y" if s in ("left", "right") else "x"
            rn = getattr(a, letter + "_range_name", "default")
            key = letter + ("1" if rn == "default" else "2")
            o = a.major_label_orientation
            out[key] = {
                "orientation": 0.0 if o == "horizontal" else float(o),
                "font": a.major_label_text_font_size,
                "tick": [a.major_tick_in, a.major_tick_out],
                "label_color": a.major_label_text_color,
                "label_alpha": a.major_label_text_alpha,
                "visible": a.visible, "line_color": a.axis_line_color,
                "line_width": a.axis_line_width,
                "title_gap": a.axis_label_standoff, "side": s,
                "index": [x for x in getattr(fig, s)
                          if type(x).__name__.endswith("Axis")].index(a)}
    return out

def _axl_geom(rs, pos):
    n = int(round(min(abs(rs * 3.84), 100.0)))
    if pos == "inside":
        return [n, 0]
    if pos == "crossing":
        h = int(round(min(abs(rs * 3.84), 100.0) / 2.0))
        return [h, h]
    return [0, n]

def _axl_hex(rgb):
    return "#%02x%02x%02x" % tuple(int(float(v)) for v in rgb.split())

def _axl_case():
    # AXL_WANT: {"<axis>.<check>": value} for every panel's axis.
    want = json.loads(Macro.getGlobal("AXL_WANT"))
    figs = _axl_saved(Macro.getGlobal("AXL_PAGE"))
    bad = [] if figs else ["no figure on the page"]
    for f in figs:
        prof = _axl_profile(f)
        for k, v in want.items():
            ax, check = k.split(".", 1)
            p = prof.get(ax)
            if p is None:
                bad.append(ax + " missing")
                continue
            if check == "orientation_deg":
                ok = math.isclose(p["orientation"], math.radians(float(v)),
                                  abs_tol=1e-6)
                got = p["orientation"]
            elif check == "tick_rs":
                got, ok = p["tick"], p["tick"] == _axl_geom(float(v[0]), v[1])
            elif check == "label_rgb":
                got, ok = p["label_color"], p["label_color"] == _axl_hex(v)
            elif check == "line_rgb":
                got, ok = p["line_color"], p["line_color"] == _axl_hex(v)
            elif check == "line_su":
                got = p["line_width"]
                ok = math.isclose(got, float(v) * 3.84, rel_tol=1e-6)
            elif check == "title_gap_rs":
                got = p["title_gap"]
                ok = got == int(round(float(v) * 3.84))
            else:
                got, ok = p.get(check), p.get(check) == v
            if not ok:
                bad.append("%s %s: %r, want %r" % (ax, check, got, v))
    Macro.setGlobal("AXL_OK", "0" if bad else "1")
    Macro.setGlobal("AXL_MSG", "; ".join(bad)[:240] or "ok")
    Macro.setGlobal("AXL_NFIG", str(len(figs)))
    Macro.setGlobal("AXL_PROF", json.dumps([_axl_profile(f) for f in figs],
                                           sort_keys=True))
end

// _axl_dash <page> <log> `"<dash command>"': runs it with its log; r(rc).
capture program drop _axl_dash
program define _axl_dash, rclass
    version 19
    args page lg cmd
    quietly graph drop _all
    capture dash clear
    capture erase "`page'"
    capture log close _axl
    quietly log using "`lg'", text replace name(_axl)
    capture noisily `cmd' saving("`page'")
    local rc = _rc
    quietly log close _axl
    global AXL_PAGE "`page'"
    return scalar rc = `rc'
end

* ==== S31 P1.18a: Axis look sub-options ====
local only : env WP30_ONLY
if inlist("`only'", "", "S31") & `: list posof "S31" in w30_run' {
    display as text "S31 start " c(current_date) " " c(current_time)
    sysuse auto, clear
    local pg "`w30_work'/axl.html"
    local lg "`w30_work'/axl.log"
    local Y "yaxis1"
    local mt ".style.majorstyle.tickstyle"

    // AXL-20: anglestyle names and twoway's abbreviations.
    foreach v in rvertical forty_five ninety two_seventy stdarrow v rh rv Vertical stacked {
        quietly twoway scatter mpg weight, ylabel(, angle(`v'))
        local deg "`.Graph.`Y'.style.majorstyle.tickangle.val'"
        _axl_dash "`pg'" "`lg'" `"dash scatter mpg weight, ylabel(, angle(`v'))"'
        _w30_expect AXL-20 "(r(rc) == 0)" `"angle(`v'): rc `=r(rc)'"'
        global AXL_WANT `"{"y1.orientation_deg": "`deg'"}"'
        python: __import__("__main__")._axl_case()
        _w30_expect AXL-20 "(${AXL_OK} == 1)" `"angle(`v') (twoway `deg'): ${AXL_MSG}"'
    }
    _w30_done AXL-20 "every anglestyle name, v, rh and rv, and Vertical and stacked at 0, as twoway draws them"

    // AXL-21: the label look.
    foreach o in "nolabels" "noticks" "labcolor(red%50)" "tlength(3)" "tposition(inside)" {
        quietly twoway scatter mpg weight, ylabel(, `o')
        local sl "`.Graph.`Y'`mt'.show_labels.istrue'"
        local st "`.Graph.`Y'`mt'.show_ticks.istrue'"
        local tl "`.Graph.`Y'`mt'.length.val'"
        local ps "`.Graph.`Y'`mt'.position.stylename'"
        local lc "`.Graph.`Y'`mt'.textstyle.color.rgb'"
        _axl_dash "`pg'" "`lg'" `"dash scatter mpg weight, ylabel(, `o')"'
        _w30_expect AXL-21 "(r(rc) == 0)" `"`o': rc `=r(rc)'"'
        if "`sl'" == "0" global AXL_WANT `"{"y1.font": "0px"}"'
        else if "`st'" == "0" global AXL_WANT `"{"y1.tick": [0, 0]}"'
        else if "`o'" == "labcolor(red%50)" global AXL_WANT `"{"y1.label_rgb": "`lc'", "y1.label_alpha": 0.5}"'
        else global AXL_WANT `"{"y1.tick_rs": ["`tl'", "`ps'"]}"'
        python: __import__("__main__")._axl_case()
        _w30_expect AXL-21 "(${AXL_OK} == 1)" `"`o': ${AXL_MSG}"'
    }
    _w30_done AXL-21 "nolabels, noticks, labcolor(red%50), tlength(3) and tposition(inside) are twoway's"

    // AXL-22: the scale look.
    foreach o in "off" "noline" "noli lc(red)" "lwidth(thick)" "alt" "titlegap(5)" {
        quietly twoway scatter mpg weight, yscale(`o')
        local dv "`.Graph.`Y'.draw_view.istrue'"
        local lc "`.Graph.`Y'.style.linestyle.color.rgb'"
        local lw "`.Graph.`Y'.style.linestyle.width.val'"
        local ap "`.Graph.`Y'.position.stylename'"
        local tg "`.Graph.`Y'.style.title_gap.val'"
        _axl_dash "`pg'" "`lg'" `"dash scatter mpg weight, yscale(`o')"'
        _w30_expect AXL-22 "(r(rc) == 0)" `"yscale(`o'): rc `=r(rc)'"'
        if "`o'" == "off" global AXL_WANT `"{"y1.visible": false}"'
        else if "`o'" == "noline" global AXL_WANT `"{"y1.line_color": null}"'
        else if "`o'" == "noli lc(red)" global AXL_WANT `"{"y1.line_rgb": "`lc'"}"'
        else if "`o'" == "lwidth(thick)" global AXL_WANT `"{"y1.line_su": "`lw'"}"'
        else if "`o'" == "alt" global AXL_WANT `"{"y1.side": "`ap'"}"'
        else global AXL_WANT `"{"y1.title_gap_rs": "`tg'"}"'
        if "`o'" == "off" _w30_expect AXL-22 "(`dv' == 0)" "twoway draws yscale(off)"
        python: __import__("__main__")._axl_case()
        _w30_expect AXL-22 "(${AXL_OK} == 1)" `"yscale(`o'): ${AXL_MSG}"'
    }
    _w30_done AXL-22 "off, noline, noli lc(red), lwidth(thick), alt and titlegap(5) are twoway's"

    // AXL-23: by(): the four forms twoway ignores, ignored and unnamed.
    quietly twoway scatter mpg weight, by(foreign)
    local dv0 "`.Graph.graphs[1].`Y'.draw_view.istrue'"
    quietly twoway scatter mpg weight, by(foreign) yscale(off) ylabel(, nolabels noticks) yscale(titlegap(10))
    local dv1 "`.Graph.graphs[1].`Y'.draw_view.istrue'"
    _w30_expect AXL-23 `"("`dv0'" == "`dv1'")"' "twoway's by() panel draw_view `dv0' `dv1'"
    _axl_dash "`pg'" "`lg'" `"dash scatter mpg weight, by(foreign)"'
    global AXL_WANT "{}"
    python: __import__("__main__")._axl_case()
    python: Macro.setGlobal("AXL_BASE", Macro.getGlobal("AXL_PROF"))
    _axl_dash "`pg'" "`lg'" `"dash scatter mpg weight, by(foreign) yscale(off) ylabel(, nolabels noticks) yscale(titlegap(10))"'
    _w30_expect AXL-23 "(r(rc) == 0)" "by() with the ignored forms: rc `=r(rc)'"
    python: __import__("__main__")._axl_case()
    python: Macro.setGlobal("AXL_OK", "1" if Macro.getGlobal("AXL_PROF") == Macro.getGlobal("AXL_BASE") else "0")
    _w30_expect AXL-23 "(${AXL_OK} == 1 & ${AXL_NFIG} == 2)" "the panels' axes differ from by(foreign) alone"
    capture cert_log_has "`lg'", needle("sub-option")
    local hrc = _rc
    local hn = cond(`hrc', -1, r(found))
    _w30_expect AXL-23 "(`hn' == 0)" "a sub-option was named under by() (`hn')"
    _axl_dash "`pg'" "`lg'" `"dash scatter mpg weight, by(foreign) yscale(noline alt)"'
    global AXL_WANT `"{"y1.line_color": null, "y1.side": "right"}"'
    python: __import__("__main__")._axl_case()
    _w30_expect AXL-23 "(${AXL_OK} == 1 & ${AXL_NFIG} == 2)" `"yscale(noline alt) under by(): ${AXL_MSG}"'
    _w30_done AXL-23 "under by() off, nolabels, noticks and titlegap() draw as absent, unnamed; noline and alt are drawn"

    // AXL-24: the second axis.
    local Y2 "(scatter mpg weight) (scatter price weight, yaxis(2))"
    quietly twoway `Y2', yscale(alt axis(2))
    local p2 "`.Graph.yaxis2.position.stylename'"
    _axl_dash "`pg'" "`lg'" `"dash `Y2', yscale(alt axis(2))"'
    global AXL_WANT `"{"y2.side": "`p2'", "y2.index": 1, "y1.side": "left"}"'
    python: __import__("__main__")._axl_case()
    _w30_expect AXL-24 "(${AXL_OK} == 1)" `"yscale(alt axis(2)) (twoway `p2'): ${AXL_MSG}"'
    quietly twoway `Y2', yscale(off axis(2))
    local d2 "`.Graph.yaxis2.draw_view.istrue'"
    _axl_dash "`pg'" "`lg'" `"dash `Y2', yscale(off axis(2))"'
    global AXL_WANT `"{"y2.visible": false}"'
    python: __import__("__main__")._axl_case()
    _w30_expect AXL-24 "(${AXL_OK} == 1 & `d2' == 0)" `"yscale(off axis(2)): ${AXL_MSG}"'
    _w30_done AXL-24 "yscale(alt axis(2)) puts y2 left, outside y1, and yscale(off axis(2)) hides it, as twoway draws them"

    capture graph drop _all
    capture dash clear
    capture erase "`pg'"
    capture erase "`lg'"
    macro drop AXL_*
    display as text "S31 end " c(current_date) " " c(current_time)
}
* ==== end S31 ====

// S32 (WP-30 P1.14a): the named styles p1-p15 in twoway and both modes.
// _s32_svg reads twoway's SVG colours, _s32_page the saved page's glyphs,
// _s32_app the served document's before and after a price range move, and
// _s32_cmp holds each against the case's expected tokens: a #hex colour
// drawn, sym:<name> a marker symbol and pat:<name> a line pattern (twoway's
// graph object for those two).  Sets S32_OK, S32_MSG and S32_SAME_AFTER.
python:
import json as _s32_json
import html as _s32_html
import os as _s32_os
import re as _s32_re
import sys as _s32_sys
import warnings as _s32_w
from sfi import Macro as _s32_M


def _s32_svg():
    path = _s32_M.getGlobal("S32_SVG")
    with open(path, encoding="utf-8", errors="replace") as fh:
        txt = fh.read()
    cols = set(c.lower() for c in _s32_re.findall(
        r"(?:fill|stroke)[:=]\"?(#[0-9A-Fa-f]{6})", txt))
    _s32_M.setGlobal("S32_TW", " ".join(sorted(cols)))


def _s32_v(x):
    return str(getattr(x, "value", x)).lower()


def _s32_read(doc):
    from bokeh.models import GlyphRenderer
    cols, syms, pats = set(), set(), set()
    for r in doc.select({"type": GlyphRenderer}):
        g = r.glyph
        for c, a in (("line_color", "line_alpha"), ("fill_color", "fill_alpha")):
            v = getattr(g, c, None)
            v = getattr(v, "value", v)
            al = getattr(g, a, 1)
            al = getattr(al, "value", al)
            if isinstance(v, dict):
                v = v.get("value")
            if isinstance(v, str) and al not in (0, 0.0):
                cols.add(v.lower())
        if type(g).__name__ == "Scatter":
            syms.add(_s32_v(g.marker))
        if type(g).__name__ in ("Line", "Segment"):
            pats.add(",".join(str(int(d)) for d in (g.line_dash or [])))
    return "%s|%s|%s" % (" ".join(sorted(cols)), " ".join(sorted(syms)),
                         " ".join(sorted(pats)))


def _s32_page():
    from bokeh.document import Document
    with open(_s32_M.getGlobal("S32_PAGE"), encoding="utf-8") as fh:
        page = fh.read()
    out = ""
    for blob in _s32_re.findall('<script type="application/json"[^>]*>(.*?)</script>', page, _s32_re.S):
        try:
            docs = _s32_json.loads(_s32_html.unescape(blob))
        except ValueError:
            continue
        for dj in (docs.values() if isinstance(docs, dict) else []):
            if isinstance(dj, dict) and "roots" in dj:
                with _s32_w.catch_warnings():
                    _s32_w.simplefilter("ignore")
                    out = _s32_read(Document.from_json(dj))
                break
        if out:
            break
    _s32_M.setGlobal("S32_D", out)


def _s32_app():
    from bokeh.document import Document
    from bokeh.models import RangeSlider
    with open(_s32_M.getGlobal("S32_APP"), encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_s32_app")
    with _s32_w.catch_warnings():
        _s32_w.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_s32_app.py", "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    _s32_M.setGlobal("S32_S", _s32_read(doc))
    after = ""
    sl = [s for s in doc.select(dict(type=RangeSlider))
          if getattr(s, "_dash_var", None) == "price"]
    if sl:
        w = sl[0]
        new = (w.start, (w.start + w.end) / 2.0)
        old = w.value
        w.value = new
        with _s32_w.catch_warnings():
            _s32_w.simplefilter("ignore")
            for attr in ("value", "value_throttled"):
                for cb in list(w._callbacks.get(attr, [])):
                    cb(attr, old, new)
        after = _s32_read(doc)
    _s32_M.setGlobal("S32_A", after)


def _s32_cmp():
    _s32_sys.path.insert(0, _s32_M.getGlobal("S32_REPO"))
    from dash_render import OptionTranslator as T
    exp = _s32_M.getGlobal("S32_EXP").split()
    tw = set(_s32_M.getGlobal("S32_TW").split())
    ok, msg = True, []
    for e in exp:
        if e.startswith("#") and e not in tw:
            ok = False
            msg.append("twoway lacks " + e)
        if e.startswith("sym:") and _s32_M.getGlobal("S32_TSYM") != e[4:]:
            ok = False
            msg.append("twoway symbol " + _s32_M.getGlobal("S32_TSYM"))
        if e.startswith("pat:") and _s32_M.getGlobal("S32_TPAT") != e[4:]:
            ok = False
            msg.append("twoway pattern " + _s32_M.getGlobal("S32_TPAT"))
    for mode in ("D", "S", "A"):
        got = _s32_M.getGlobal("S32_" + mode).split("|")
        if len(got) != 3:
            ok = False
            msg.append(mode + " unread")
            continue
        cols, syms, pats = (set(x.split()) for x in got)
        for e in exp:
            if e.startswith("#") and e not in cols:
                ok = False
                msg.append(mode + " lacks " + e)
            if e.startswith("sym:") and T.translate_msymbol(e[4:]) not in syms:
                ok = False
                msg.append(mode + " symbol " + " ".join(syms))
            if e.startswith("pat:"):
                want = ",".join(str(int(d)) for d in T.translate_lpattern(e[4:]))
                if want not in pats:
                    ok = False
                    msg.append(mode + " pattern " + " ".join(pats))
    same = _s32_M.getGlobal("S32_S").split("|")[:2] == _s32_M.getGlobal("S32_A").split("|")[:2]
    _s32_M.setGlobal("S32_SAME_AFTER", "1" if same else "0")
    _s32_M.setGlobal("S32_OK", "1" if ok else "0")
    _s32_M.setGlobal("S32_MSG", "; ".join(msg)[:240])
end

// _s32_case scheme "twoway command" "expected tokens" work: twoway, then
// dash saved, then dash served with filter(price, type(range)), on one
// command (WP-30 P1.14a); sets S32_RC, S32_OK, S32_MSG, S32_SAME_AFTER.
capture program drop _s32_case
program define _s32_case
    version 19
    args scheme cmd exp work
    quietly sysuse auto, clear
    local svg "`work'/np_s32.svg"
    local page "`work'/np_s32.html"
    local app "`work'/np_s32.py"
    local c = cond(strpos(`"`cmd'"', ","), " ", ", ")
    if substr(`"`cmd'"', 1, 1) == "(" local c ", "
    quietly graph drop _all
    capture noisily twoway `cmd' `c' scheme(`scheme') name(g, replace)
    local trc = _rc
    global S32_TSYM ""
    global S32_TPAT ""
    if !`trc' {
        quietly graph export "`svg'", replace name(g)
        global S32_TSYM "`.g.plotregion1.plot1.style.marker.symbol.stylename'"
        global S32_TPAT "`.g.plotregion1.plot1.style.line.pattern.stylename'"
    }
    quietly graph drop _all
    capture dash clear
    capture noisily dash `cmd' `c' scheme(`scheme') saving("`page'", replace)
    local drc = _rc
    capture dash clear
    capture noisily dash `cmd' `c' scheme(`scheme') name(g1)
    local drc = `drc' + _rc
    capture noisily dash build, server saving("`app'") replace nobrowser filter(price, type(range))
    local drc = `drc' + _rc
    foreach g in S32_TW S32_D S32_S S32_A S32_MSG {
        global `g' ""
    }
    global S32_OK "0"
    global S32_SAME_AFTER "0"
    global S32_SVG "`svg'"
    global S32_PAGE "`page'"
    global S32_APP "`app'"
    global S32_EXP `"`exp'"'
    if !`trc' capture noisily python: __import__("__main__")._s32_svg()
    if !`drc' capture noisily python: __import__("__main__")._s32_page()
    if !`drc' capture noisily python: __import__("__main__")._s32_app()
    if !`trc' & !`drc' capture noisily python: __import__("__main__")._s32_cmp()
    global S32_RC = `trc' + `drc'
    capture dash clear
    foreach f in svg page app {
        capture erase "``f''"
    }
    capture graph drop g
end

* ==== S32 P1.14a: Named styles p1-p15 ====
local only : env WP30_ONLY
if inlist("`only'", "", "S32") & `: list posof "S32" in w30_run' {
    display as text "S32 start " c(current_date) " " c(current_time)
    global S32_REPO "`c(pwd)'/.."
    local s32_n = 0
    foreach row in ///
        `"NP-01|s2color|scatter mpg weight, pstyle(p3)|#55752f|pstyle(p3) is p3's #55752F under s2color"' ///
        `"NP-02|s1mono|line mpg weight, sort lstyle(p3)|pat:vshortdash|s1mono's lstyle(p3) is linestyle p3: vshortdash"' ///
        `"NP-03|s1mono|scatter mpg weight, mstyle(p3)|#808080 sym:square|s1mono's mstyle(p3) is a grey square"' ///
        `"NP-04|stcolor|area mpg weight, sort astyle(p3)|#33cc99|astyle(p3) fills in p3 at intensity 80"' ///
        `"NP-05|stcolor|bar mpg weight, bstyle(p3) blcolor(red)|#33cc99 #ff0000|bstyle(p3) fills in p3, blcolor(red) after it outlines red"' ///
        `"NP-06|stcolor|scatter mpg weight, mcolor(red) p(p3)|#00bf7f|p(p3) wins over mcolor(red)"' ///
        `"NP-07|stcolor|spike mpg weight, alstyle(p3)|#00bf7f|alstyle(p3) draws the spikes in p3"' ///
        `"NP-08|stcolor|scatter mpg turn weight, pstyle(p3 p4)|#00bf7f #ffd400|pstyle(p3 p4) styles each y"' ///
        `"NP-09|stcolor|(scatteri 20 3000, pstyle(p3)) (function y=20, range(2000 4000) pstyle(p4))|#00bf7f #ffd400|scatteri and function take pstyle()'s plot index"' {
        gettoken id rest : row, parse("|")
        gettoken bar rest : rest, parse("|")
        gettoken sch rest : rest, parse("|")
        gettoken bar rest : rest, parse("|")
        gettoken cmd rest : rest, parse("|")
        gettoken bar rest : rest, parse("|")
        gettoken exp rest : rest, parse("|")
        gettoken bar rest : rest, parse("|")
        local what `"`rest'"'
        _s32_case `sch' `"`cmd'"' `"`exp'"' "`w30_work'"
        _w30_expect `id' "(${S32_RC} == 0 & ${S32_OK} == 1 & ${S32_SAME_AFTER} == 1)" `"${S32_MSG} after-move ${S32_SAME_AFTER}"'
        _w30_done `id' `"`what', in twoway, the saved page and the served app before and after a move"'
    }
    macro drop S32_*
    display as text "S32 end " c(current_date) " " c(current_time)
}
* ==== end S32 ====

// S33 helpers.  _s33_tw reads twoway's SVG: the marker labels (the texts
// named in S33_MAKES) as their distinct fill:size:opacity styles, sizes in
// Stata's relative units (font-size over a hundredth of the canvas's
// smaller side); or, for a colour key, the first upright text right of the
// plot region (a tick label) and the turned one (the title).  _s33_both
// reads dash's saved page and served app the same way (LabelSet text
// colour, css_to_pt(size) / 2.88 and text alpha; ColorBar label and title
// colour and size, tick colour), the app also after a Select move on
// foreign, and sets S33_OK, S33_MSG and S33_SAME_AFTER.  Every argument
// crosses through sfi.Macro.
python:
import html as _s33_html
import json as _s33_json
import os as _s33_os
import re as _s33_re
import sys as _s33_sys
import warnings as _s33_w
from sfi import Macro as _s33_M


def _s33_tw():
    _s33_sys.path.insert(0, _s33_os.path.join(_s33_M.getGlobal("S33_REPO"), "scripts"))
    import svg_truth as st
    path = _s33_M.getGlobal("S33_SVG")
    doc = st.svg_document(path)
    with open(path, encoding="utf-8", errors="replace") as fh:
        raw = fh.read()
    ops = []
    for m in st._RE_TEXT.finditer(raw):
        o = _s33_re.search(r"(?:^|;)\s*opacity:([0-9.]{1,8})",
                           st._attrs(m.group(1)).get("style", ""))
        ops.append(float(o.group(1)) if o else 1.0)
    rs = min(doc["canvas"]["w"], doc["canvas"]["h"]) / 100.0
    out = []
    if _s33_M.getGlobal("S33_KIND") == "key":
        right = doc["plotregion"]["right"] if doc["plotregion"] else 0.0
        ts = [t for t in doc["texts"] if t["x"] is not None and t["x"] > right]
        lab = next((t for t in ts if t["rotate"] is None), None)
        tit = next((t for t in ts if t["rotate"] is not None), None)
        for t in (lab, tit):
            out.append("" if t is None else "%s:%.3f" % (t["fill"], t["size"] / rs))
    else:
        makes = set(_s33_M.getGlobal("S33_MAKES").split("|"))
        for t, o in zip(doc["texts"], ops):
            if t["text"] in makes and t["rotate"] is None:
                e = "%s:%.3f:%.2f" % (t["fill"], t["size"] / rs, o)
                if e not in out:
                    out.append(e)
    _s33_M.setGlobal("S33_TW", ";".join(out))


def _s33_read(doc):
    _s33_sys.path.insert(0, _s33_M.getGlobal("S33_REPO"))
    import dash_render as dr
    from bokeh.models import ColorBar, LabelSet

    def rs(css):
        # A size read back from a saved page may be a value spec.
        css = getattr(css, "value", css)
        if isinstance(css, dict):
            css = css.get("value")
        pt = dr.OptionTranslator.css_to_pt(css)
        return -1.0 if pt is None else pt / dr.OptionTranslator.PT_PER_RS
    if _s33_M.getGlobal("S33_KIND") == "key":
        bars = list(doc.select({"type": ColorBar}))
        if not bars:
            return ""
        b = bars[0]
        return ";".join(["%s:%.3f" % (str(b.major_label_text_color).lower(),
                                      rs(b.major_label_text_font_size)),
                         "%s:%.3f" % (str(b.title_text_color).lower(),
                                      rs(b.title_text_font_size))])
    out = []
    for ls in doc.select({"type": LabelSet}):
        # A saved page's LabelSet holds value specs.
        e = "%s:%.3f:%.2f" % (str(getattr(ls.text_color, "value", ls.text_color)).lower(),
                              rs(ls.text_font_size),
                              float(getattr(ls.text_alpha, "value", ls.text_alpha)))
        if e not in out:
            out.append(e)
    return ";".join(sorted(out))


def _s33_same(tw, got):
    """Each twoway style has a dash style of the same colour and opacity,
    its size within 1%."""
    a = sorted(tw.split(";"))
    b = sorted(got.split(";"))
    if len(a) != len(b) or not tw:
        return False
    for x, y in zip(a, b):
        x, y = x.split(":"), y.split(":")
        if x[0] != y[0] or abs(float(x[1]) - float(y[1])) > 0.01 * float(x[1]):
            return False
        if len(x) > 2 and abs(float(x[2]) - float(y[2])) > 1e-6:
            return False
    return True


def _s33_both():
    from bokeh.document import Document
    from bokeh.models import Select
    tw = _s33_M.getGlobal("S33_TW")
    saved = ""
    with open(_s33_M.getGlobal("S33_PAGE"), encoding="utf-8") as fh:
        page = fh.read()
    for blob in _s33_re.findall('<script type="application/json"[^>]*>(.*?)</script>', page, _s33_re.S):
        try:
            docs = _s33_json.loads(_s33_html.unescape(blob))
        except ValueError:
            continue
        for dj in (docs.values() if isinstance(docs, dict) else []):
            if isinstance(dj, dict) and "roots" in dj:
                with _s33_w.catch_warnings():
                    _s33_w.simplefilter("ignore")
                    saved = _s33_read(Document.from_json(dj))
                break
        if saved:
            break
    with open(_s33_M.getGlobal("S33_APP"), encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_s33_app")
    with _s33_w.catch_warnings():
        _s33_w.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_s33_app.py", "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    served = _s33_read(doc)
    same = "0"
    sels = [m for root in doc.roots for m in root.select({"type": Select})
            if getattr(m, "_dash_var", None) == "foreign"]
    if sels:
        w = sels[0]
        opts = [o[0] if isinstance(o, (list, tuple)) else o for o in w.options]
        if len(opts) > 1:
            w.value = opts[1]
            with _s33_w.catch_warnings():
                _s33_w.simplefilter("ignore")
                for key in ("value", "value_throttled"):
                    for cb in list(w._callbacks.get(key, [])):
                        cb("value", None, opts[1])
            same = "1" if _s33_read(doc) == served else "0"
    ok = _s33_same(tw, saved) and _s33_same(tw, served)
    _s33_M.setGlobal("S33_OK", "1" if ok else "0")
    _s33_M.setGlobal("S33_SAME_AFTER", same)
    _s33_M.setGlobal("S33_MSG", ("twoway %s | saved %s | served %s" % (tw, saved, served))[:240])
end

// _s33_case tag scheme kind "command" work: twoway's SVG and dash's saved
// page and served app (foreign dropdown) for one command.
capture program drop _s33_case
program define _s33_case
    version 19
    args tag scheme kind cmd work
    quietly sysuse auto, clear
    local svg "`work'/mk_`tag'.svg"
    local page "`work'/mk_`tag'.html"
    local app "`work'/mk_`tag'.py"
    local c = cond(strpos(`"`cmd'"', ","), " ", ", ")
    if substr(`"`cmd'"', 1, 1) == "(" local c ", "
    quietly levelsof make in 1/3, local(mk) clean separate(|)
    global S33_MAKES `"`mk'"'
    quietly graph drop _all
    capture noisily twoway `cmd' `c' scheme(`scheme') name(g, replace)
    local trc = _rc
    if !`trc' quietly graph export "`svg'", replace name(g)
    quietly graph drop _all
    capture dash clear
    capture noisily dash `cmd' `c' scheme(`scheme') saving("`page'", replace)
    local drc = _rc
    capture dash clear
    capture noisily dash `cmd' `c' scheme(`scheme') name(g1)
    local drc = `drc' + _rc
    capture noisily dash build, server saving("`app'") replace nobrowser filter(foreign, type(dropdown))
    local drc = `drc' + _rc
    global S33_OK "0"
    global S33_SAME_AFTER "0"
    global S33_MSG ""
    global S33_SVG "`svg'"
    global S33_PAGE "`page'"
    global S33_APP "`app'"
    global S33_KIND "`kind'"
    if !`trc' capture noisily python: __import__("__main__")._s33_tw()
    if !`trc' & !`drc' capture noisily python: __import__("__main__")._s33_both()
    global S33_RC = `trc' + `drc'
    capture dash clear
    foreach f in svg page app {
        capture erase "``f''"
    }
    capture graph drop g
end

* ==== S33 P1.4b: Marker-label and colour-key chrome; unread directives retained ====
local only : env WP30_ONLY
if inlist("`only'", "", "S33") & `: list posof "S33" in w30_run' {
    display as text "S33 start " c(current_date) " " c(current_time)
    global S33_REPO "`c(pwd)'/.."
    local s33_home `"`c(pwd)'"'
    tempname s33fh
    foreach f in "`w30_work'/scheme-w33b.scheme" "`w30_work'/w33b.scheme" {
        file open `s33fh' using "`f'", write text replace
        file write `s33fh' "#include s2color" _n "color p1label blue" _n "gsize p1label vlarge" _n "color plabel green" _n
        file close `s33fh'
    }
    foreach f in "`w30_work'/scheme-w33k.scheme" "`w30_work'/w33k.scheme" {
        file open `s33fh' using "`f'", write text replace
        file write `s33fh' "#include s2color" _n "gsize axis_title vlarge" _n "color axis_title red" _n "gsize tick_label small" _n "color tick_label blue" _n
        file close `s33fh'
    }
    adopath ++ "`w30_work'"
    quietly cd "`w30_work'"
    local s33_after ""

    // MK-01: s1rcolor's labels are its p1 yellow at small.
    _s33_case m01 s1rcolor label "scatter mpg weight in 1/3, mlabel(make)" "`w30_work'"
    _w30_expect MK-01 "(${S33_RC} == 0 & ${S33_OK} == 1)" `"${S33_MSG}"'
    local s33_after "`s33_after'${S33_SAME_AFTER}"
    _w30_done MK-01 "s1rcolor's marker labels are #ffff00 at small, saved and served, as twoway draws them"

    // MK-02: p1label reaches layer 1 only, plabel layer 2.
    _s33_case m02 w33b label "(scatter mpg weight in 1/3, mlabel(make)) (scatter price weight in 1/3, mlabel(make) yaxis(2))" "`w30_work'"
    _w30_expect MK-02 "(${S33_RC} == 0 & ${S33_OK} == 1)" `"${S33_MSG}"'
    _w30_done MK-02 "w33b's layer 1 labels are #0000ff at vlarge and layer 2's #008000 at small, as twoway draws them"

    // MK-03: sttrans's label opacity.
    _s33_case m03 sttrans label "scatter mpg weight in 1/3, mlabel(make)" "`w30_work'"
    _w30_expect MK-03 "(${S33_RC} == 0 & ${S33_OK} == 1)" `"${S33_MSG}"'
    _w30_done MK-03 "sttrans's marker labels are drawn at its 0.20 opacity, as twoway draws them"

    // MK-04: the colour key's text from the scheme.
    _s33_case m04 w33k key "scatter mpg weight, colorvar(price)" "`w30_work'"
    _w30_expect MK-04 "(${S33_RC} == 0 & ${S33_OK} == 1)" `"${S33_MSG}"'
    local s33_after "`s33_after'${S33_SAME_AFTER}"
    _w30_done MK-04 "w33k's colour key labels are #0000ff at small and its title #ff0000 at vlarge, as twoway draws them"

    // MK-05: the served app after a filter move.
    _w30_expect MK-05 `"("`s33_after'" == "11")"' "after the move: `s33_after'"
    _w30_done MK-05 "the served app keeps MK-01's labels and MK-04's key style after a filter move"

    quietly cd `"`s33_home'"'
    adopath - "`w30_work'"
    foreach n in w33b w33k {
        capture erase "`w30_work'/scheme-`n'.scheme"
        capture erase "`w30_work'/`n'.scheme"
    }
    macro drop S33_*
    display as text "S33 end " c(current_date) " " c(current_time)
}
* ==== end S33 ====

// ----------------------------------------------------------------
// S34 helpers (python at the top level, where braces are safe).  Values
// cross only through sfi.Macro globals.
//   _s34_svg()   S34_SVG, a twoway SVG -> S34_TW = bg;marker (lower case)
//   _s34_figs()  S34_PAGE (a saved page) or S34_APP (a served app.py) ->
//                S34_BG, each Plot's border_fill_color in document order
//                joined by ";", and S34_MK, the first Scatter fill; for
//                the app, the Select whose _dash_var is S34_MOVE is moved
//                to its second option -> S34_BG_AFTER, S34_FIRED
//   _s34_same()  S34_NAME, S34_FN (findfile's r(fn)) and S34_DIRS (the
//                ado-path _dash_scheme_dirs wrote) -> S34_SAME, 1 when
//                dash_render's walk resolves the file findfile found
//   _s34_make()  S34_KEY, a scheme_lookup_truth.json record, recreated
//                under S34_CASE -> S34_NAME, S34_SETUP (| separated)
// _s34_where name: findfile as the gate runs it, then _s34_same.
// ----------------------------------------------------------------
python:
import json as _s34_json
import os as _s34_os
import sys as _s34_sys
from sfi import Macro as _s34_M


def _s34_set(name, val):
    _s34_M.setGlobal(name, str(val))


def _s34_svg():
    import svg_truth as _st
    path = _s34_M.getGlobal("S34_SVG")
    doc = _st.svg_document(path)
    bg = doc["rects"][0]["fill"] if doc["rects"] else "none"
    fills = _st.svg_marker_fills(path)
    mk = max(fills, key=lambda c: fills[c]["n"]) if fills else "none"
    _s34_set("S34_TW", "%s;%s" % (str(bg).lower(), str(mk).lower()))


def _s34_plots(roots):
    from bokeh.models import Plot
    out, seen = [], set()
    stack = list(roots)
    def visit(m):
        if isinstance(m, (list, tuple)):
            for x in m:
                visit(x)
            return
        if not hasattr(m, "properties") or id(m) in seen:
            return
        seen.add(id(m))
        if isinstance(m, Plot):
            out.append(m)
            return
        for a in ("children", "tabs", "child"):
            k = getattr(m, a, None)
            if k is not None:
                visit(k)
    visit(stack)
    return out


def _s34_doc_bg(doc):
    from bokeh.models import Scatter
    plots = _s34_plots(doc.roots)
    mk = [s.fill_color for s in doc.select(dict(type=Scatter))]
    return ";".join(str(p.border_fill_color).lower() for p in plots), \
        (str(mk[0]).lower() if mk else "none")


def _s34_figs():
    page = _s34_M.getGlobal("S34_PAGE")
    if page:
        objs = _s07_models(page)
        bgs = []
        mk = "none"
        for o in objs:
            a = o.get("attributes", {}) or {}
            if o.get("name") in _S07_PLOTS:
                bgs.append(str(_s07_val(a.get("border_fill_color", "#ffffff"))).lower())
            if o.get("name") == "Scatter" and mk == "none" and "fill_color" in a:
                mk = str(_s07_val(a["fill_color"])).lower()
        _s34_set("S34_BG", ";".join(bgs) or "none")
        _s34_set("S34_MK", mk)
        return
    from bokeh.document import Document
    from bokeh.models import Select
    import warnings as _w
    if not _s34_os.path.isfile(_s34_M.getGlobal("S34_APP")):
        for g in ("S34_BG", "S34_MK", "S34_BG_AFTER"):
            _s34_set(g, "none")
        _s34_set("S34_FIRED", 0)
        return
    with open(_s34_M.getGlobal("S34_APP"), encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_s34_app")
    with _w.catch_warnings():
        _w.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_s34_app.py", "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    bg, mk = _s34_doc_bg(doc)
    _s34_set("S34_BG", bg or "none")
    _s34_set("S34_MK", mk)
    var = _s34_M.getGlobal("S34_MOVE")
    sel = [s for s in doc.select(dict(type=Select))
           if getattr(s, "_dash_var", None) == var]
    fired = 0
    if var and len(sel) == 1 and len(sel[0].options) > 1:
        old = sel[0].value
        opt = sel[0].options[1]
        new = opt[0] if isinstance(opt, (list, tuple)) else opt
        sel[0].value = new
        with _w.catch_warnings():
            _w.simplefilter("ignore")
            for cb in sel[0]._callbacks.get("value", []):
                cb("value", old, new)
                fired += 1
    _s34_set("S34_FIRED", fired)
    _s34_set("S34_BG_AFTER", _s34_doc_bg(doc)[0] or "none")


def _s34_dr():
    repo = _s34_M.getGlobal("S34_REPO")
    if repo not in _s34_sys.path:
        _s34_sys.path.insert(0, repo)
    import dash_render
    return dash_render


def _s34_same():
    dr = _s34_dr()
    if getattr(dr, "_dash_scheme_dirs_of", None) is None:
        _s34_set("S34_SAME", 0)
        _s34_set("S34_WHY", "the renderer reads no ado-path")
        return
    probe = dr.SchemeParser.__new__(dr.SchemeParser)
    probe._ado_dirs = dr._dash_scheme_dirs_of(
        {"scheme_dirs": _s34_json.loads(_s34_M.getGlobal("S34_DIRS"))})
    fn = _s34_M.getGlobal("S34_FN")
    try:
        got = probe._resolve_path(_s34_M.getGlobal("S34_NAME"))
    except ValueError as exc:
        _s34_set("S34_SAME", 0)
        _s34_set("S34_WHY", str(exc)[:120])
        return
    same = int(bool(fn) and _s34_os.path.realpath(got)
               == _s34_os.path.realpath(fn))
    _s34_set("S34_SAME", same)
    _s34_set("S34_WHY", "dash %s, findfile %s" % (_s34_os.path.basename(got),
                                                 _s34_os.path.basename(fn)))


def _s34_make():
    repo = _s34_M.getGlobal("S34_REPO")
    with open(_s34_os.path.join(repo, "test", "fixtures",
                                "scheme_lookup_truth.json"),
              encoding="utf-8") as fh:
        rec = _s34_json.load(fh)[_s34_M.getGlobal("S34_KEY")]
    root = _s34_M.getGlobal("S34_CASE")
    body = {"R": "#include s2color\ncolor background red\ncolor p1 green\n",
            "B": "#include s2color\ncolor background blue\ncolor p1 green\n"}
    _s34_os.makedirs(_s34_os.path.join(root, "cwd"), exist_ok=True)
    for rel, kind in rec["files"].items():
        p = _s34_os.path.join(root, rel)
        _s34_os.makedirs(_s34_os.path.dirname(p), exist_ok=True)
        if kind.startswith("->"):
            _s34_os.symlink(_s34_os.path.join(root, kind[2:]), p)
        else:
            with open(p, "w", encoding="utf-8") as fh:
                fh.write(body.get(kind, kind))
    for s in rec["setup"]:
        w = s.split()
        if w[0] == "adopath":
            _s34_os.makedirs(_s34_os.path.join(root, w[-1]) if w[-1] != "rel"
                             else _s34_os.path.join(root, "cwd", "rel"),
                             exist_ok=True)
    _s34_set("S34_NAME", rec["name"])
    _s34_set("S34_SETUP", "|".join(rec["setup"]))
end

capture program drop _s34_where
program define _s34_where
    version 19
    args name
    global S34_NAME "`name'"
    global S34_FN ""
    capture findfile "scheme-`name'.scheme"
    if _rc {
        capture findfile "`name'.scheme"
    }
    if !_rc global S34_FN `"`r(fn)'"'
    local _dash_sdirs "[]"
    capture noisily _dash_scheme_dirs
    global S34_DIRS `"`macval(_dash_sdirs)'"'
    python: __import__("__main__")._s34_same()
end

capture program drop _s34_file
program define _s34_file
    version 19
    // _s34_file path text...: write the lines (#include s2color first).
    gettoken path 0 : 0
    tempname fh
    file open `fh' using `"`path'"', write text replace
    file write `fh' "#include s2color" _n
    foreach ln of local 0 {
        file write `fh' `"`ln'"' _n
    }
    file close `fh'
end

capture program drop _s34_tw
program define _s34_tw
    version 19
    // _s34_tw svg [scheme]: twoway's scatter, as an SVG; S34_TW = bg;marker.
    args svg sch
    local opt = cond("`sch'" != "", "scheme(`sch')", "")
    quietly twoway scatter mpg weight, `opt' name(s34tw, replace)
    quietly graph export "`svg'", name(s34tw) replace
    quietly graph drop _all
    global S34_SVG "`svg'"
    python: __import__("__main__")._s34_svg()
end

capture program drop _s34_read
program define _s34_read
    version 19
    // _s34_read page|app path [move]: S34_BG, S34_MK (and after a move).
    args kind path move
    global S34_PAGE ""
    global S34_APP ""
    global S34_MOVE "`move'"
    if "`kind'" == "page" global S34_PAGE "`path'"
    else global S34_APP "`path'"
    python: __import__("__main__")._s34_figs()
end

* ==== S34 P1.25b: Stata's scheme lookup along the ado-path ====
local only : env WP30_ONLY
if inlist("`only'", "", "S34") & `: list posof "S34" in w30_run' {
    display as text "S34 start " c(current_date) " " c(current_time)
    // WP-30 P1.25b: a scheme dash does not ship is found as twoway finds
    // it (scheme-NAME.scheme, then NAME.scheme, along the ado-path), and
    // each graph is drawn in its own scheme in both modes (P1.25.6).
    global S34_REPO "`c(pwd)'/.."
    local s34_home `"`c(pwd)'"'
    local s34_sch0 "`c(scheme)'"
    local s34_site "`c(sysdir_site)'"
    local s34_plus "`c(sysdir_plus)'"
    local s34_ado0 `"$S_ADO"'
    local s34_d "`w30_work'/s34"
    capture mkdir "`s34_d'"
    sysuse auto, clear
    local R `""color background red" "color p1 green""'
    local B `""color background blue" "color p1 green""'

    // SP-10: scheme-sp10.scheme in the working directory, every route.
    capture mkdir "`s34_d'/c10"
    quietly cd "`s34_d'/c10"
    _s34_file "scheme-sp10.scheme" `R'
    _s34_tw "`s34_d'/c10/tw.svg" sp10
    local tw "${S34_TW}"
    capture log close s34lg
    log using "`s34_d'/c10.log", text replace name(s34lg)
    capture noisily dash scatter mpg weight, scheme(sp10) saving("`s34_d'/c10/p1.html", replace)
    local rc1 = _rc
    quietly dash scatter mpg weight, name(g1)
    capture noisily dash build, scheme(sp10) saving("`s34_d'/c10/p2.html") replace
    local rc2 = _rc
    capture noisily dash build, scheme(sp10) server saving("`s34_d'/c10/app.py") replace nobrowser filter(foreign, type(dropdown))
    local rc3 = _rc
    log close s34lg
    capture dash clear
    cert_log_has "`s34_d'/c10.log", needle("(note:")
    local nn = r(count)
    _w30_expect SP-10 `"("`tw'" == "#ff0000;#008000")"' "twoway drew `tw'"
    _w30_expect SP-10 "(`rc1' == 0 & `rc2' == 0 & `rc3' == 0 & `nn' == 0)" "rc `rc1' `rc2' `rc3', `nn' note(s)"
    _s34_read page "`s34_d'/c10/p1.html"
    _w30_expect SP-10 `"("${S34_BG};${S34_MK}" == "#ff0000;#008000")"' "dash scatter page: ${S34_BG};${S34_MK}"
    _s34_read page "`s34_d'/c10/p2.html"
    _w30_expect SP-10 `"("${S34_BG};${S34_MK}" == "#ff0000;#008000")"' "dash build page: ${S34_BG};${S34_MK}"
    _s34_read app "`s34_d'/c10/app.py" foreign
    _w30_expect SP-10 `"("${S34_BG};${S34_MK};${S34_BG_AFTER}" == "#ff0000;#008000;#ff0000" & ${S34_FIRED} > 0)"' "served: ${S34_BG};${S34_MK}, after the move ${S34_BG_AFTER} (fired ${S34_FIRED})"
    _w30_done SP-10 "scheme-sp10.scheme in the working directory: twoway, dash scatter, dash build and the served app all draw it, no note"

    // SP-11: form-major -- an added directory's scheme-sp11.scheme beats
    // the working directory's sp11.scheme.
    capture mkdir "`s34_d'/c11"
    capture mkdir "`s34_d'/c11/add"
    quietly cd "`s34_d'/c11"
    _s34_file "sp11.scheme" `B'
    _s34_file "`s34_d'/c11/add/scheme-sp11.scheme" `R'
    adopath + "`s34_d'/c11/add"
    _s34_tw "`s34_d'/c11/tw.svg" sp11
    local tw "${S34_TW}"
    capture noisily dash scatter mpg weight, scheme(sp11) saving("`s34_d'/c11/p.html", replace)
    local rc = _rc
    _s34_read page "`s34_d'/c11/p.html"
    global S_ADO `"`s34_ado0'"'
    _w30_expect SP-11 `"("`tw'" == "#ff0000;#008000" & `rc' == 0 & "${S34_BG}" == "#ff0000")"' "twoway `tw', dash rc `rc' ${S34_BG}"
    _w30_done SP-11 "scheme-NAME.scheme on a later directory beats NAME.scheme in the working directory, in twoway and dash"

    // SP-12: SITE's letter subdirectory beats the working directory.
    capture mkdir "`s34_d'/c12"
    capture mkdir "`s34_d'/c12/site"
    capture mkdir "`s34_d'/c12/site/s"
    quietly cd "`s34_d'/c12"
    _s34_file "scheme-sp12.scheme" `B'
    _s34_file "`s34_d'/c12/site/s/scheme-sp12.scheme" `R'
    quietly sysdir set SITE "`s34_d'/c12/site/"
    _s34_tw "`s34_d'/c12/tw.svg" sp12
    local tw "${S34_TW}"
    capture noisily dash scatter mpg weight, scheme(sp12) saving("`s34_d'/c12/p.html", replace)
    local rc = _rc
    _s34_read page "`s34_d'/c12/p.html"
    quietly sysdir set SITE "`s34_site'"
    _w30_expect SP-12 `"("`tw'" == "#ff0000;#008000" & `rc' == 0 & "${S34_BG}" == "#ff0000")"' "twoway `tw', dash rc `rc' ${S34_BG}"
    _w30_done SP-12 "SITE's s/ subdirectory beats the working directory, in twoway and dash"

    // SP-13: a shipped name: BASE (dash's translation) comes first.
    capture mkdir "`s34_d'/c13"
    quietly cd "`s34_d'/c13"
    _s34_file "scheme-s1mono.scheme" `R'
    _s34_file "s1mono.scheme" `R'
    _s34_tw "`s34_d'/c13/tw.svg" s1mono
    local tw "${S34_TW}"
    capture noisily dash scatter mpg weight, scheme(s1mono) saving("`s34_d'/c13/p.html", replace)
    local rc = _rc
    _s34_read page "`s34_d'/c13/p.html"
    _w30_expect SP-13 `"(substr("`tw'", 1, 7) == "#ffffff" & `rc' == 0 & "${S34_BG}" == "#ffffff")"' "twoway `tw', dash rc `rc' ${S34_BG}"
    _w30_done SP-13 "a working-directory s1mono.scheme or scheme-s1mono.scheme replaces nothing, in twoway and dash"

    // SP-14: set scheme of a PLUS/s scheme; unschemed builds draw it.
    capture mkdir "`s34_d'/c14"
    capture mkdir "`s34_d'/c14/plus"
    capture mkdir "`s34_d'/c14/plus/s"
    quietly cd "`s34_d'/c14"
    _s34_file "`s34_d'/c14/plus/s/scheme-sp14.scheme" `R'
    quietly sysdir set PLUS "`s34_d'/c14/plus/"
    set scheme sp14
    _s34_tw "`s34_d'/c14/tw.svg"
    local tw "${S34_TW}"
    capture log close s34lg
    log using "`s34_d'/c14.log", text replace name(s34lg)
    quietly dash scatter mpg weight, name(g1)
    capture noisily dash build, saving("`s34_d'/c14/p.html") replace
    local rc1 = _rc
    capture noisily dash build, server saving("`s34_d'/c14/app.py") replace nobrowser
    local rc2 = _rc
    log close s34lg
    capture dash clear
    set scheme `s34_sch0'
    quietly sysdir set PLUS "`s34_plus'"
    cert_log_has "`s34_d'/c14.log", needle("(note:")
    local nn = r(count)
    _s34_read page "`s34_d'/c14/p.html"
    local pg "${S34_BG}"
    _s34_read app "`s34_d'/c14/app.py"
    _w30_expect SP-14 `"("`tw'" == "#ff0000;#008000" & "`pg'" == "#ff0000" & "${S34_BG}" == "#ff0000")"' "twoway `tw', page `pg', app ${S34_BG}"
    _w30_expect SP-14 "(`rc1' == 0 & `rc2' == 0 & `nn' == 0)" "rc `rc1' `rc2', `nn' note(s)"
    _w30_done SP-14 "set scheme of a PLUS scheme: twoway, the saved and the served build draw it, no note"

    // SP-15: an #include resolved along the ado-path.
    capture mkdir "`s34_d'/c15"
    capture mkdir "`s34_d'/c15/add"
    quietly cd "`s34_d'/c15"
    tempname s34fh
    file open `s34fh' using "sp15.scheme", write text replace
    file write `s34fh' "#include sp15p" _n "color p1 green" _n
    file close `s34fh'
    _s34_file "`s34_d'/c15/add/scheme-sp15p.scheme" "color background red"
    adopath + "`s34_d'/c15/add"
    _s34_tw "`s34_d'/c15/tw.svg" sp15
    local tw "${S34_TW}"
    capture log close s34lg
    log using "`s34_d'/c15.log", text replace name(s34lg)
    capture noisily dash scatter mpg weight, scheme(sp15) saving("`s34_d'/c15/p.html", replace)
    local rc = _rc
    log close s34lg
    global S_ADO `"`s34_ado0'"'
    cert_log_has "`s34_d'/c15.log", needle("not found")
    local nn = r(count)
    _s34_read page "`s34_d'/c15/p.html"
    _w30_expect SP-15 `"("`tw'" == "#ff0000;#008000" & "${S34_BG};${S34_MK}" == "#ff0000;#008000")"' "twoway `tw', dash ${S34_BG};${S34_MK}"
    _w30_expect SP-15 "(`rc' == 0 & `nn' == 0)" "rc `rc', `nn' not-found note(s)"
    _w30_done SP-15 "#include sp15p finds Stata's scheme-sp15p.scheme on an added directory, in twoway and dash"

    // SP-16: a theme name that is a file Stata finds, inherited and named;
    // off the path, scheme(mono) is the s1mono alias again.
    capture mkdir "`s34_d'/c16"
    capture mkdir "`s34_d'/c16/add"
    quietly cd "`s34_d'/c16"
    _s34_file "`s34_d'/c16/add/scheme-mono.scheme" `R'
    adopath + "`s34_d'/c16/add"
    set scheme mono
    _s34_tw "`s34_d'/c16/tw.svg"
    local tw "${S34_TW}"
    capture noisily dash scatter mpg weight, saving("`s34_d'/c16/p1.html", replace)
    _s34_read page "`s34_d'/c16/p1.html"
    local b1 "${S34_BG}"
    capture noisily dash scatter mpg weight, scheme(mono) saving("`s34_d'/c16/p2.html", replace)
    _s34_read page "`s34_d'/c16/p2.html"
    local b2 "${S34_BG}"
    global S_ADO `"`s34_ado0'"'
    set scheme `s34_sch0'
    capture noisily dash scatter mpg weight, scheme(mono) saving("`s34_d'/c16/p3.html", replace)
    _s34_read page "`s34_d'/c16/p3.html"
    local b3 "${S34_BG}"
    _w30_expect SP-16 `"(substr("`tw'", 1, 7) == "#ff0000" & "`b1'" == "#ff0000" & "`b2'" == "#ff0000" & "`b3'" == "#ffffff")"' "twoway `tw', inherited `b1', named `b2', off the path `b3'"
    _w30_done SP-16 "scheme-mono.scheme on the path is drawn inherited and named; off it, scheme(mono) is s1mono"

    // SP-17: two graphs, two schemes, saved and served, before and after
    // a move.
    capture mkdir "`s34_d'/c17"
    quietly cd "`s34_d'/c17"
    _s34_tw "`s34_d'/c17/tw1.svg" s1mono
    local t1 = substr("${S34_TW}", 1, 7)
    _s34_tw "`s34_d'/c17/tw2.svg" s1rcolor
    local t2 = substr("${S34_TW}", 1, 7)
    capture log close s34lg
    log using "`s34_d'/c17.log", text replace name(s34lg)
    quietly dash scatter mpg weight, scheme(s1mono) name(g1)
    quietly dash scatter mpg weight, scheme(s1rcolor) name(g2)
    capture noisily dash build, saving("`s34_d'/c17/p.html") replace
    local rc1 = _rc
    capture noisily dash build, server saving("`s34_d'/c17/app.py") replace nobrowser filter(foreign, type(dropdown))
    local rc2 = _rc
    log close s34lg
    capture dash clear
    cert_log_has "`s34_d'/c17.log", needle("draws one scheme")
    local nn = r(count)
    _s34_read page "`s34_d'/c17/p.html"
    local sv "${S34_BG}"
    _s34_read app "`s34_d'/c17/app.py" foreign
    _w30_expect SP-17 `"("`sv'" == "`t1';`t2'" & "${S34_BG}" == "`sv'" & "${S34_BG_AFTER}" == "`sv'")"' "twoway `t1';`t2', saved `sv', served ${S34_BG}, after ${S34_BG_AFTER}"
    _w30_expect SP-17 "(`rc1' == 0 & `rc2' == 0 & `nn' == 0)" "rc `rc1' `rc2', `nn' one-scheme warning(s)"
    _w30_done SP-17 "g1 scheme(s1mono) and g2 scheme(s1rcolor): each graph in its own scheme, saved and served, after a move, as twoway draws them"

    // SP-18: the fixture's placements, live: dash's walk resolves the file
    // Stata's findfile returns.
    local bad18 ""
    foreach k in lk01 lk02 lk03 lk04 lk05 lk06 lk07 lk08 lk09 lk10 lk11 lk12 lk13 lk14 lk15 lk17 lk21 lk22 {
        global S34_KEY "`k'"
        global S34_CASE "`s34_d'/c18_`k'"
        python: __import__("__main__")._s34_make()
        quietly cd "${S34_CASE}/cwd"
        local setup "${S34_SETUP}"
        while `"`setup'"' != "" {
            gettoken one setup : setup, parse("|")
            if "`one'" == "|" continue
            local w : word 1 of `one'
            local last : word `: word count `one'' of `one'
            if "`w'" == "adopath" {
                if "`last'" == "rel" adopath + rel
                else adopath + "${S34_CASE}/`last'"
            }
            else {
                local which : word 3 of `one'
                quietly sysdir set `which' "${S34_CASE}/`last'/"
            }
        }
        _s34_where ${S34_NAME}
        if "${S34_SAME}" != "1" local bad18 "`bad18' `k'(${S34_WHY})"
        global S_ADO `"`s34_ado0'"'
        quietly sysdir set SITE "`s34_site'"
        quietly sysdir set PLUS "`s34_plus'"
    }
    _w30_expect SP-18 `"("`bad18'" == "")"' "not the file findfile returned:`bad18'"
    _w30_done SP-18 "for 18 measured placements dash's walk resolves the file Stata's findfile returns"

    quietly cd `"`s34_home'"'
    global S_ADO `"`s34_ado0'"'
    quietly sysdir set SITE "`s34_site'"
    quietly sysdir set PLUS "`s34_plus'"
    set scheme `s34_sch0'
    capture dash clear
    shell rm -rf "`s34_d'"
    macro drop S34_*
    display as text "S34 end " c(current_date) " " c(current_time)
}
* ==== end S34 ====

* _da_check: S35's reader of dash's saved page and served app (WP-30
* P1.23a).  _da_docs builds both from one spec; _da_axes, _da_units,
* _da_hull and _da_move read dash's values; _da_check sets DA_OK (1 or 0)
* and DA_MSG for one case, twoway's scales coming in DA_TW (x0 x1 y0 y1)
* and DA_TW2 (the plotregion2 y scale).
python:
import os as _da_os, sys as _da_sys
for _da_p in (_da_os.path.abspath(".."), _da_os.path.abspath(".")):
    if _da_p not in _da_sys.path:
        _da_sys.path.insert(0, _da_p)


def _da_read(sp, dp):
    import warnings
    import dash_render as dr
    with warnings.catch_warnings(record=True) as w:
        warnings.simplefilter("always")
        r = dr.DashRenderer(sp, dp)
        r.render()
    return r, [str(x.message) for x in w]


def _da_app(sp, dp, app):
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings(record=True) as w:
        warnings.simplefilter("always")
        dr.ServerAppBuilder(sp, dp).build(app)
        with open(app, encoding="utf-8") as fh:
            src = fh.read()
        attach = "if __name__ != '__main__':\n    make_document(curdoc())"
        ns = dict(__name__="dash_da_app")
        exec(compile(src.replace(attach, "pass"), "dash_da_app.py", "exec"),
             ns)
        doc = Document()
        ns["make_document"](doc)
    return doc, [str(x.message) for x in w]


def _da_figs(models):
    from bokeh.plotting import figure as _Fig
    out, seen = [], set()
    for root in models:
        for m in root.references():
            if isinstance(m, _Fig) and id(m) not in seen:
                seen.add(id(m))
                out.append(m)
    return out


def _da_axes(fig, side, name="default"):
    attr = ("x" if side in ("below", "above") else "y") + "_range_name"
    return [a for a in getattr(fig, side) if hasattr(a, "formatter")
            and getattr(a, attr, "default") == name]


def _da_units(r, prop):
    import dash_render as dr
    spec = getattr(r.glyph, prop)
    fld = dr._dash_spec_field(spec)
    col = dr._dash_float_values(r.data_source.data[fld], coerce=True)
    k = dr._dash_spec_units(spec)
    return dr._dash_date_units(col, k) if k else col


def _da_hull(fig, letter, name="default"):
    import dash_render as dr
    rng = (getattr(fig, letter + "_range") if name == "default"
           else getattr(fig, "extra_%s_ranges" % letter)[name])
    return dr._dash_range_hull(rng)


def _da_move(doc, value):
    from bokeh.models import RangeSlider
    [w] = [m for m in doc.models if isinstance(m, RangeSlider)]
    old, w.value = w.value, value
    for key in ("value", "value_throttled"):
        for cb in list(w._callbacks.get(key, [])):
            cb("value", old, value)


def _da_rend(fig, gt, k=0):
    import dash_render as dr
    return [r for r in fig.renderers if type(r.glyph).__name__ == gt
            and not dr._dash_is_swatch(r)][k]


def _da_check(case, key, sp, dp, app):
    import math
    import dash_render as dr
    from sfi import Macro
    from bokeh.models import DatetimeAxis, DatetimeTicker, FixedTicker, Span
    tw = [float(v) if v not in ("", ".") else float("nan")
          for v in (Macro.getGlobal("DA_TW") or "").split()]
    tw2 = [float(v) for v in (Macro.getGlobal("DA_TW2") or "").split()]
    r, ws = _da_read(sp, dp)
    doc, wv = _da_app(sp, dp, app)
    modes = (("saved", list(r.figures.values())[0], ws),
             ("served", _da_figs(doc.roots)[0], wv))
    bad = []
    E = dr._STATA_EPOCH_UNIX_MS

    def day(ms):
        return dr._dash_stata_value_of(ms, "td")
    for mode, f, w in modes:
        try:
            if case == "DA-01":
                gt = {"scatteri_td": "Scatter", "pci_td": "Segment",
                      "pcarrowi_td": "Segment",
                      "function_range_td": "Line"}[key]
                rr = _da_rend(f, gt, 1 if gt == "Line" else 0)
                props = ("x",) if gt != "Segment" else ("x0", "x1")
                xs = [v for p in props for v in _da_units(rr, p).tolist()]
                got = sorted({day(v) for v in xs})
                want = [15400.0] if key == "scatteri_td" else [15400.0,
                                                                15450.0]
                if key == "function_range_td":
                    got = [got[0], got[-1]]
                if got != want or not _da_axes(f, "below") or not \
                        isinstance(_da_axes(f, "below")[0], DatetimeAxis):
                    bad.append("%s x %r" % (mode, got))
            elif case == "DA-02":
                x = _da_units(_da_rend(f, "Scatter"), "x").tolist()
                if [dr._dash_stata_value_of(v, "tm") for v in x] != [504.0] \
                        or not isinstance(_da_axes(f, "below")[0],
                                          DatetimeAxis):
                    bad.append("%s x %r" % (mode, x))
            elif case == "DA-03":
                side = "below" if key == "datex" else "left"
                ax = _da_axes(f, side)[0]
                lo, hi = dr._dash_layer_extent(
                    f.renderers, ("x" if side == "below" else "y")
                    + "_range_name", "default", "td")
                u = (day(lo), day(hi))
                ext = tw[0:2] if side == "below" else tw[2:4]
                if not isinstance(ax, DatetimeAxis) \
                        or dict(ax.formatter.args).get("fmt") != "%td" \
                        or u != (14977.0, 15370.0) \
                        or not (ext[0] <= u[0] and u[1] <= ext[1]):
                    bad.append("%s %s hull %r twoway %r" % (
                        mode, type(ax).__name__, u, ext))
            elif case == "DA-04":
                if key == "datey_y2num":
                    first, second, ext = (_da_axes(f, "left")[0],
                                          _da_axes(f, "right", "y2")[0],
                                          tw[2:4])
                    lo, hi = dr._dash_layer_extent(
                        f.renderers, "y_range_name", "default", "td")
                else:
                    first, second, ext = (_da_axes(f, "below")[0],
                                          _da_axes(f, "above", "x2")[0],
                                          tw[0:2])
                    lo, hi = dr._dash_layer_extent(
                        f.renderers, "x_range_name", "default", "td")
                if not isinstance(first, DatetimeAxis) \
                        or isinstance(second, DatetimeAxis) \
                        or not (ext[0] <= day(lo) and day(hi) <= ext[1]):
                    bad.append("%s %s/%s %r" % (mode, type(first).__name__,
                                                type(second).__name__,
                                                (day(lo), day(hi))))
            elif case == "DA-05":
                ax = _da_axes(f, "right", "y2")[0]
                if not isinstance(ax, DatetimeAxis):
                    bad.append("%s y2 %s" % (mode, type(ax).__name__))
                if key == "y2date_range":
                    lo, hi = _da_hull(f, "y", "y2")
                    span = [s.location for s in f.center
                            if isinstance(s, Span) and s.y_range_name == "y2"]
                    if abs(day(lo) - tw2[0]) > 1e-6 \
                            or abs(day(hi) - tw2[1]) > 1e-6 \
                            or span != [float(dr._dash_units_to_axis(
                                [15200], "td")[0])]:
                        bad.append("%s y2 [%r, %r] span %r twoway %r" % (
                            mode, day(lo), day(hi), span, tw2))
                if key == "y2date_n5":
                    ticks = list(getattr(ax.ticker, "ticks", []) or [])
                    lo, hi = dr._dash_layer_extent(
                        f.renderers, "y_range_name", "y2", "td")
                    if not ticks or any((t - E) % 86400000 for t in ticks) \
                            or ticks != dr._dash_axis_count_ticks(
                                lo, hi, 5, "td"):
                        bad.append("%s ticks %r" % (mode, [day(t) for t in
                                                           ticks]))
            elif case == "DA-06":
                fit = [x for x in f.renderers
                       if type(x.glyph).__name__ == "Line"
                       and x.y_range_name == "y2"][-1]
                y = [day(v) for v in _da_units(fit, "y").tolist()
                     if math.isfinite(v)]
                if not y or min(y) < 15007 - 1e-6 or max(y) > 15370 + 1e-6:
                    bad.append("%s lfit y %r..%r" % (mode, min(y or [0]),
                                                     max(y or [0])))
            elif case in ("DA-07", "DA-11"):
                ax = _da_axes(f, "below")[0]
                dl = _da_rend(f, "Scatter", 0 if key == "date_first" else 1)
                lo, hi = _da_hull(f, "x")
                if isinstance(ax, DatetimeAxis) \
                        or dr._dash_spec_units(dl.glyph.x) != "td":
                    bad.append("%s %s transform %r" % (
                        mode, type(ax).__name__,
                        dr._dash_spec_units(dl.glyph.x)))
                if case == "DA-07":
                    vals = _da_units(dl, "x").tolist()
                    raw = dr._dash_date_units(dr._dash_float_values(
                        dl.data_source.data[dr._dash_spec_field(
                            dl.glyph.x)], coerce=True), "td").tolist()
                    from test_display_format_sites import js_texts
                    first = js_texts(ax.formatter, [0.0], "tick")[0] \
                        if hasattr(ax.formatter, "args") else "0"
                    want = "01jan1960" if key == "date_first" else "0"
                    if abs(lo - tw[0]) > 1e-6 or abs(hi - tw[1]) > 1e-6 \
                            or vals != raw or first != want:
                        bad.append("%s hull [%r, %r] twoway %r first %r" % (
                            mode, lo, hi, tw[0:2], first))
                elif not hi < 1e6:
                    bad.append("%s hull after the move [%r, %r]" % (
                        mode, lo, hi))
            elif case == "DA-08":
                ticks = sorted(float(v) for v in
                               _da_axes(f, "below")[0].ticker.ticks)
                want = [float(v) for v in
                        (Macro.getGlobal("DA_MINMAX") or "").split()]
                if ticks != want:
                    bad.append("%s ticks %r want %r" % (mode, ticks, want))
            elif case == "DA-09":
                rr = _da_rend(f, "VBar")
                lo, hi = _da_hull(f, "y")
                spec = rr.glyph.bottom
                fld = dr._dash_spec_field(spec)
                base = (sorted(set(dr._dash_float_values(
                    rr.data_source.data[fld], coerce=True).tolist()))
                    if fld else [float(getattr(spec, "value", spec)
                                       if not isinstance(spec, dict)
                                       else spec["value"])])
                if key == "bar_date_y":
                    ok = (base == [0.0] and abs(lo - tw[2]) < 1e-6
                          and abs(hi - tw[3]) < 1e-6)
                else:
                    ok = ([day(b) for b in base] == [14970.0]
                          and abs(day(lo) - tw[2]) < 1e-6
                          and abs(day(hi) - tw[3]) < 1e-6)
                if not ok:
                    bad.append("%s base %r hull [%r, %r] twoway %r" % (
                        mode, base, lo, hi, tw[2:4]))
            elif case in ("DA-10", "DA-12"):
                kind, lit, num = (("td", 8639684294400000.0, 99999999.0)
                                  if case == "DA-10" else
                                  ("ty", -77945673600000.0, -500.0))
                x = _da_units(_da_rend(f, "Scatter"), "x").tolist()
                ax = _da_axes(f, "below")[0]
                lo, hi = _da_hull(f, "x")
                ticks = list(getattr(ax.ticker, "ticks", []) or [])
                _c, vals = dr._dash_secondary_values(f, "x_range_name",
                                                     "default")
                want_t = dr._dash_off_date_ticks(min(vals), max(vals), 5,
                                                 kind)
                fmt = "%td" if kind == "td" else "%ty"
                from test_display_format_sites import js_texts
                texts = js_texts(ax.formatter, ticks, "tick")
                want_x = [dr._dash_fmt_text(dr._dash_stata_number_of(
                    t, kind), fmt) for t in ticks]
                notes = [n for n in w if "scatteri" in n]
                if x != [lit] or dr._dash_stata_number_of(x[0], kind) != num \
                        or not (lo <= lit <= hi) \
                        or not isinstance(ax, DatetimeAxis) \
                        or isinstance(ax.ticker, DatetimeTicker) \
                        or ticks != want_t or texts != want_x or notes:
                    bad.append("%s x %r ticks %r texts %r notes %r" % (
                        mode, x, ticks, texts, notes))
                if case == "DA-12" and (-2208988800000.0 in ticks
                                        or -62167219200000.0 not in ticks):
                    bad.append("%s ty ticks %r" % (mode, ticks))
        except Exception as exc:  # reported as the case's failure
            bad.append("%s %s: %s" % (mode, type(exc).__name__, exc))
    if case == "DA-11":
        # The served app after a move of close to its lower 60%.
        try:
            _da_move(doc, (1100.0, 1290.0))
            f = _da_figs(doc.roots)[0]
            dl = _da_rend(f, "Scatter", 0)
            lo, hi = _da_hull(f, "x")
            if dr._dash_spec_units(dl.glyph.x) != "td" or not hi < 1e6:
                bad.append("served after the move [%r, %r]" % (lo, hi))
        except Exception as exc:  # reported as the case's failure
            bad.append("served move %s: %s" % (type(exc).__name__, exc))
    Macro.setGlobal("DA_OK", "0" if bad else "1")
    Macro.setGlobal("DA_MSG", ("; ".join(bad) or "ok")[:900].replace(
        "`", "'").replace("$", "S"))


_da_main = __import__("__main__")
_da_main._da_check = _da_check
end

capture program drop _da_data
program define _da_data
    // The extractor's data (scripts/extract_date_axis_truth.do).
    version 19
    quietly sysuse sp500, clear
    quietly generate obs = _n
    quietly generate d2 = date + 30
    format d2 %td
    quietly generate int m = mofd(date)
    format m %tm
    quietly generate int yr = year(date)
    format yr %ty
end

capture program drop _da_case
program define _da_case
    // id; fixture key; the twoway command; its options; a filter.
    version 19
    args id key cmd opts filt
    _da_data
    capture graph drop _all
    quietly twoway `cmd', `opts' name(g, replace)
    global DA_TW "`.g.plotregion1.xscale.curmin' `.g.plotregion1.xscale.curmax' `.g.plotregion1.yscale.curmin' `.g.plotregion1.yscale.curmax'"
    global DA_TW2 ""
    if strpos(`"`cmd'"', "yaxis(2)") {
        global DA_TW2 "`.g.plotregion2.yscale.curmin' `.g.plotregion2.yscale.curmax'"
    }
    capture graph drop _all
    capture dash clear
    global DA_K = $DA_K + 1
    local k = $DA_K
    quietly dash `cmd', `opts' name(zda`k')
    if `"`filt'"' != "" {
        quietly _dash_serve_spec, specpath("${DA_WORK}/s`k'.json") datapath("${DA_WORK}/d`k'.json") filter(`filt')
    }
    else {
        quietly _dash_serve_spec, specpath("${DA_WORK}/s`k'.json") datapath("${DA_WORK}/d`k'.json")
    }
    python: __import__("__main__")._da_check("`id'", "`key'", r"${DA_WORK}/s`k'.json", r"${DA_WORK}/d`k'.json", r"${DA_WORK}/a`k'.py")
    display as text `"  `id' `key': twoway [${DA_TW}] [${DA_TW2}]: ${DA_MSG}"'
    _w30_expect `id' "${DA_OK} == 1" `"`key': ${DA_MSG}"'
    foreach x in s`k'.json d`k'.json a`k'.py {
        capture erase "${DA_WORK}/`x'"
    }
    capture dash clear
end

* ==== S35 P1.23a: Date positions on every axis ====
local only : env WP30_ONLY
if inlist("`only'", "", "S35") & `: list posof "S35" in w30_run' {
    display as text "S35 start " c(current_date) " " c(current_time)
    global DA_WORK "`w30_work'"
    global DA_K 0
    _da_case DA-01 scatteri_td "(line close date) (scatteri 1300 15400)"
    _da_case DA-01 pci_td "(line close date) (pci 1200 15400 1400 15450)"
    _da_case DA-01 pcarrowi_td "(line close date) (pcarrowi 1200 15400 1400 15450)"
    _da_case DA-01 function_range_td "(line close date) (function y=1300, range(15400 15450))"
    _w30_done DA-01 "scatteri, pci, pcarrowi and function on a %td axis are at the dates they denote, saved and served"
    _da_case DA-02 scatteri_tm "(line close m) (scatteri 1300 504)"
    _w30_done DA-02 "scatteri 1300 504 on a %tm axis is at 2002m1, saved and served"
    _da_case DA-03 rarea_datey "rarea date d2 close"
    _da_case DA-03 rcap_datey "rcap date d2 close"
    _da_case DA-03 datey "pcspike date open d2 close"
    _da_case DA-03 datex "pcspike open date close d2"
    _w30_done DA-03 "range and pc layers of a date get a %td date axis whose hull lies in twoway's"
    _da_case DA-04 datey_y2num "(scatter date close) (scatter volume close, yaxis(2))"
    _da_case DA-04 datex_x2num "(scatter close date) (scatter close obs, xaxis(2))"
    _w30_done DA-04 "a numeric second axis leaves the first axis's dates"
    _da_case DA-05 y2date "(line close date) (line d2 date, yaxis(2))"
    _da_case DA-05 y2date_range "(line close date) (line d2 date, yaxis(2))" "yline(15200, axis(2)) yscale(range(14900 15500) axis(2))"
    _da_case DA-05 y2date_n5 "(line close date) (line d2 date, yaxis(2))" "ylabel(#5, axis(2))"
    _w30_done DA-05 "a second axis of dates is a date axis whose range(), yline() and #5 read days"
    _da_case DA-06 y2_lfit "(line close date) (line d2 date, yaxis(2)) (lfit d2 date, yaxis(2))"
    _w30_done DA-06 "an lfit on a date y2 is drawn in its dates"
    _da_case DA-07 date_first "(scatter close date) (scatter close obs)"
    _da_case DA-07 obs_first "(scatter close obs) (scatter close date)"
    _w30_done DA-07 "a date beside a number is drawn in Stata units over twoway's [0, 15340], labelled as twoway labels it"
    _da_data
    quietly summarize date
    global DA_MINMAX "`r(min)' `r(max)'"
    _da_case DA-08 minmax_date_first "(scatter close date) (scatter close obs)" "xlabel(minmax)"
    display as text "  DA-08: twoway's minmax reads every layer (1 15340, P2.20); dash reads the first: ${DA_MINMAX}"
    _w30_done DA-08 "xlabel(minmax) on a mixed axis ticks the date's Stata values"
    _da_case DA-09 bar_date_y "(bar date obs in 1/20) (scatter close obs in 1/20)"
    _da_case DA-09 bar_date_base "(bar date obs in 1/20, base(14970))"
    _w30_done DA-09 "a date bar beside a number stands on 0; base(14970) on a date axis stands on 26dec2000"
    _da_case DA-10 scatteri_offrange "(line close date) (scatteri 1300 99999999)"
    // No note in either build (S23's trial relays the served one).
    _da_data
    capture graph drop _all
    capture dash clear
    quietly dash (line close date) (scatteri 1300 99999999), name(zda10)
    capture log close _da10
    quietly log using "${DA_WORK}/da10.log", text replace name(_da10)
    noisily dash build, saving("${DA_WORK}/da10.html")
    noisily dash build, saving("${DA_WORK}/da10.py") server
    quietly log close _da10
    _s28_count using "${DA_WORK}/da10.log", needle("(note:  dash: scatteri")
    _w30_expect DA-10 "r(n) == 0" "a dash build named the drawn scatteri (`r(n)' notes)"
    foreach x in da10.log da10.html da10.py {
        capture erase "${DA_WORK}/`x'"
    }
    capture dash clear
    _w30_done DA-10 "scatteri 1300 99999999 is drawn at its number, ticked and labelled in Stata numbers, with no note"
    _da_case DA-11 date_first "(scatter close date) (scatter close obs)" "" "close, type(range)"
    _w30_done DA-11 "after a filter move the date layer keeps its transform and the axis its Stata units"
    _da_case DA-12 scatteri_ty_negative "(line close yr) (scatteri 1300 -500)"
    _w30_done DA-12 "scatteri 1300 -500 on a %ty axis is at year -500, ticked at year 0 where Date.UTC would put 1900"
    macro drop DA_*
    display as text "S35 end " c(current_date) " " c(current_time)
}
* ==== end S35 ====

// S36 (WP-30 P1.14b): Stata's other style names.  OS-01, OS-02 and OS-05
// reuse S32's _s32_case (twoway, the saved page, the served app before and
// after a price range move); _s36_run runs one dash command under a text
// log and _s36_count counts a needle's lines in it (r(n)).
capture program drop _s36_run
program define _s36_run, rclass
    version 19
    args cmd log
    capture log close _s36
    capture dash clear
    quietly graph drop _all
    quietly log using "`log'", text replace name(_s36)
    capture noisily `cmd'
    local rc = _rc
    quietly log close _s36
    return scalar rc = `rc'
end

capture program drop _s36_count
program define _s36_count, rclass
    version 19
    args log needle
    mata: _s36_fh = fopen(st_local("log"), "r"); _s36_n = 0
    mata: while ((_s36_ln = fget(_s36_fh)) != J(0, 0, "")) _s36_n = _s36_n + (strpos(_s36_ln, st_local("needle")) > 0)
    mata: fclose(_s36_fh); st_local("n", strofreal(_s36_n))
    return scalar n = `n'
end

* ==== S36 P1.14b: Other style names ====
local only : env WP30_ONLY
if inlist("`only'", "", "S36") & `: list posof "S36" in w30_run' {
    display as text "S36 start " c(current_date) " " c(current_time)
    global S32_REPO "`c(pwd)'/.."
    local s36log "`w30_work'/s36.log"
    foreach row in ///
        `"OS-01|s2color|line mpg weight, sort lstyle(refline)|#2d6d66|lstyle(refline) is s2color's refline, #2D6D66"' ///
        `"OS-02|stcolor|scatter mpg weight, pstyle(ci)|#a0a0a0|pstyle(ci) on scatter is stcolor's ci, #A0A0A0"' ///
        `"OS-05|stcolor|lfitci mpg weight, pstyle(histogram)|#3191ff #5faaff|lfitci's band and line under pstyle(histogram)"' {
        gettoken id rest : row, parse("|")
        gettoken bar rest : rest, parse("|")
        gettoken sch rest : rest, parse("|")
        gettoken bar rest : rest, parse("|")
        gettoken cmd rest : rest, parse("|")
        gettoken bar rest : rest, parse("|")
        gettoken exp rest : rest, parse("|")
        gettoken bar rest : rest, parse("|")
        local what `"`rest'"'
        _s32_case `sch' `"`cmd'"' `"`exp'"' "`w30_work'"
        _w30_expect `id' "(${S32_RC} == 0 & ${S32_OK} == 1 & ${S32_SAME_AFTER} == 1)" `"${S32_MSG} after-move ${S32_SAME_AFTER}"'
        _w30_done `id' `"`what', in twoway, the saved page and the served app before and after a move"'
    }
    macro drop S32_*

    // OS-03: a name twoway does not know: its note, once in dash.
    quietly sysuse auto, clear
    quietly graph drop _all
    capture log close _s36
    quietly log using "`s36log'", text replace name(_s36)
    capture noisily twoway area mpg weight, sort astyle(bogus) scheme(s2color) nodraw
    local trc = _rc
    quietly log close _s36
    _s36_count "`s36log'" "named style bogus not found in class areastyle"
    local tw_n = r(n)
    _s36_run `"dash area mpg weight, sort astyle(bogus) scheme(s2color) saving("`w30_work'/zos3.html", replace)"' "`s36log'"
    local drc = r(rc)
    _s36_count "`s36log'" "dash: named style bogus not found in class areastyle"
    _w30_expect OS-03 "(`trc' == 0 & `tw_n' >= 1 & `drc' == 0 & r(n) == 1)" "twoway rc `trc' notes `tw_n'; dash rc `drc' notes `r(n)'"
    _w30_done OS-03 "astyle(bogus): twoway's note, once in dash"

    // OS-04: a Stata name outside dash's table: no note in twoway, D-36c's
    // in dash, rc 0 in both.
    quietly graph drop _all
    quietly log using "`s36log'", text replace name(_s36)
    capture noisily twoway scatter mpg weight, pstyle(fpall) scheme(stcolor) nodraw
    local trc = _rc
    quietly log close _s36
    _s36_count "`s36log'" "named style"
    local tw_n = r(n)
    _s36_run `"dash scatter mpg weight, pstyle(fpall) scheme(stcolor) saving("`w30_work'/zos4.html", replace)"' "`s36log'"
    local drc = r(rc)
    _s36_count "`s36log'" "dash: named style fpall of class seriesstyle is not drawn by dash"
    _w30_expect OS-04 "(`trc' == 0 & `tw_n' == 0 & `drc' == 0 & r(n) == 1)" "twoway rc `trc' notes `tw_n'; dash rc `drc' notes `r(n)'"
    _w30_done OS-04 "pstyle(fpall) is named as not drawn by dash, rc 0 as in twoway"

    // OS-06: dstyle(), dlstyle() and bmlinestyle() are kept by value and
    // named.
    _s36_run `"dash dot mpg weight, dstyle(p3) dlstyle(p3) name(zos6a)"' "`s36log'"
    local drc = r(rc)
    _s36_count "`s36log'" "dstyle() dlstyle()"
    local n1 = r(n)
    mata: st_local("k1", strofreal(strpos(st_global("dash_json_zos6a"), char(34) + "dstyle" + char(34) + ":" + char(34) + "p3" + char(34)) > 0 & strpos(st_global("dash_json_zos6a"), char(34) + "dlstyle" + char(34) + ":" + char(34) + "p3" + char(34)) > 0))
    _s36_run `"dash pcbarrow mpg weight price length in 1/5, bmlinestyle(p3) name(zos6b)"' "`s36log'"
    local drc = `drc' + r(rc)
    _s36_count "`s36log'" "bmlinestyle()"
    local n2 = r(n)
    mata: st_local("k2", strofreal(strpos(st_global("dash_json_zos6b"), char(34) + "bmlinestyle" + char(34) + ":" + char(34) + "p3" + char(34)) > 0))
    _w30_expect OS-06 "(`drc' == 0 & `n1' == 1 & `n2' == 1 & `k1' & `k2')" "rc `drc', named `n1' `n2', kept `k1' `k2'"
    _w30_done OS-06 "dstyle() dlstyle() bmlinestyle() are kept by value and named"
    capture dash clear
    capture erase "`s36log'"
    capture erase "`w30_work'/zos3.html"
    capture erase "`w30_work'/zos4.html"
    display as text "S36 end " c(current_date) " " c(current_time)
}
* ==== end S36 ====

// S37 (WP-30 P1.24): mlabvposition().  _s37_cmp compares, label by label,
// the text-anchor twoway's SVG (S37_SVG) gives each label with the
// text_align dash's saved page (S37_PAGE) draws it at, as multisets of
// (text, anchor): left is start, center middle, right end.  It sets
// S37_OK and S37_MSG.  Every argument crosses through sfi.Macro.
python:
import html as _s37_html
import json as _s37_json
import os as _s37_os
import re as _s37_re
import sys as _s37_sys
import warnings as _s37_w
from sfi import Macro as _s37_M


def _s37_page():
    from bokeh.document import Document
    from bokeh.models import LabelSet
    with open(_s37_M.getGlobal("S37_PAGE"), encoding="utf-8") as fh:
        page = fh.read()
    out = []
    for blob in _s37_re.findall('<script type="application/json"[^>]*>(.*?)</script>', page, _s37_re.S):
        try:
            docs = _s37_json.loads(_s37_html.unescape(blob))
        except ValueError:
            continue
        for dj in (docs.values() if isinstance(docs, dict) else []):
            if not (isinstance(dj, dict) and "roots" in dj):
                continue
            with _s37_w.catch_warnings():
                _s37_w.simplefilter("ignore")
                doc = Document.from_json(dj)
            for ls in doc.select({"type": LabelSet}):
                data = ls.source.data

                def col(v, n):
                    f = getattr(v, "field", None)
                    if isinstance(v, dict):
                        f = v.get("field")
                    if f is None and isinstance(v, str) and v in data:
                        f = v
                    if f is not None:
                        return list(data[f])
                    return [getattr(v, "value", v)] * n
                tx = col(ls.text, 0)
                n = len(tx)
                xs, al = col(ls.x, n), col(ls.text_align, n)
                for t, x, a in zip(tx, xs, al):
                    if x is None or (isinstance(x, float) and x != x):
                        continue
                    out.append((str(t), {"left": "start", "center": "middle", "right": "end"}.get(str(a), str(a))))
    return sorted(out)


def _s37_cmp():
    _s37_sys.path.insert(0, _s37_os.path.join(_s37_M.getGlobal("S37_REPO"), "scripts"))
    import svg_truth as st
    pat = _s37_re.compile(r"^R[0-9]+$")
    tw = sorted((t["text"], t["anchor"] or "start")
                for t in st.svg_texts(_s37_M.getGlobal("S37_SVG"))
                if pat.match(t["text"]))
    got = [x for x in _s37_page() if pat.match(x[0])]
    bad = [x for x in tw if x not in got] + [x for x in got if x not in tw]
    _s37_M.setGlobal("S37_OK", "1" if (tw and tw == got) else "0")
    _s37_M.setGlobal("S37_MSG", "twoway %d labels, dash %d, differing %s" % (len(tw), len(got), bad[:6]))
end

capture program drop _s37_case
program define _s37_case
    version 19
    args id cmd work what
    quietly graph drop _all
    capture twoway `cmd' name(_s37g, replace)
    local trc = _rc
    capture graph export "`work'/s37_`id'.svg", name(_s37g) replace
    quietly graph drop _all
    capture dash clear
    capture noisily dash `cmd' saving("`work'/s37_`id'.html", replace)
    local drc = _rc
    global S37_SVG "`work'/s37_`id'.svg"
    global S37_PAGE "`work'/s37_`id'.html"
    global S37_OK 0
    global S37_MSG "not compared"
    if !`trc' & !`drc' capture noisily python: __import__("__main__")._s37_cmp()
    _w30_expect `id' "(`trc' == 0 & `drc' == 0 & ${S37_OK} == 1)" `"twoway rc `trc', dash rc `drc': ${S37_MSG}"'
    _w30_done `id' `"`what'"'
    capture erase "`work'/s37_`id'.svg"
    capture erase "`work'/s37_`id'.html"
end

// S37 part 2 (WP-30 P1.24): mlabtextstyle().  _s37_style compares each
// series' label size, as a ratio to the default label's, and its colour,
// twoway's SVGs (S37_TWD default, S37_TW probe) against dash's saved pages
// (S37_PGD, S37_PG); sets S37_OK and S37_MSG.
python:
def _s37_sizes_tw(path):
    _s37_sys.path.insert(0, _s37_os.path.join(_s37_M.getGlobal("S37_REPO"), "scripts"))
    import svg_truth as st
    out = {}
    for t in st.svg_texts(path):
        m = _s37_re.match(r"^([QS])[0-9]$", t["text"].strip())
        if m and m.group(1) not in out:
            out[m.group(1)] = (t["size"], (t["fill"] or "").lower())
    return out


def _s37_sizes_pg(path):
    _s37_sys.path.insert(0, _s37_M.getGlobal("S37_REPO"))
    import dash_render as dr
    from bokeh.document import Document
    from bokeh.models import LabelSet
    with open(path, encoding="utf-8") as fh:
        page = fh.read()
    out = {}
    for blob in _s37_re.findall('<script type="application/json"[^>]*>(.*?)</script>', page, _s37_re.S):
        try:
            docs = _s37_json.loads(_s37_html.unescape(blob))
        except ValueError:
            continue
        for dj in (docs.values() if isinstance(docs, dict) else []):
            if not (isinstance(dj, dict) and "roots" in dj):
                continue
            with _s37_w.catch_warnings():
                _s37_w.simplefilter("ignore")
                doc = Document.from_json(dj)
            for ls in doc.select({"type": LabelSet}):
                f = getattr(ls.text, "field", ls.text)
                first = str(list(ls.source.data[f])[0])
                sz = getattr(ls.text_font_size, "value", ls.text_font_size)
                col = getattr(ls.text_color, "value", ls.text_color)
                out[first[0]] = (dr.OptionTranslator.css_to_pt(sz), str(col).lower())
    return out


def _s37_style():
    twd = _s37_sizes_tw(_s37_M.getGlobal("S37_TWD"))
    tw = _s37_sizes_tw(_s37_M.getGlobal("S37_TW"))
    pgd = _s37_sizes_pg(_s37_M.getGlobal("S37_PGD"))
    pg = _s37_sizes_pg(_s37_M.getGlobal("S37_PG"))
    bad = []
    for ser in sorted(tw):
        want = tw[ser][0] / twd["Q"][0]
        got = (pg.get(ser, (0, ""))[0] or 0) / pgd["Q"][0]
        if abs(got - want) > 0.01 * want or pg.get(ser, (0, ""))[1] != tw[ser][1]:
            bad.append((ser, round(got, 3), round(want, 3), pg.get(ser), tw[ser][1]))
    _s37_M.setGlobal("S37_OK", "1" if (tw and not bad) else "0")
    _s37_M.setGlobal("S37_MSG", "series %s, differing %s" % (sorted(tw), bad))
end

capture program drop _s37_tstyle
program define _s37_tstyle
    version 19
    args id cmd work what note
    foreach k in d p {
        local c "scatter y x, mlabel(lab) scheme(stcolor)"
        if "`k'" == "p" local c "`cmd'"
        quietly graph drop _all
        capture log close _s37
        quietly log using "`work'/s37_`id'`k'.log", text replace name(_s37)
        capture noisily twoway `c' name(_s37g, replace)
        local trc`k' = _rc
        quietly log close _s37
        capture graph export "`work'/s37_`id'`k'.svg", name(_s37g) replace
        quietly graph drop _all
        capture dash clear
        quietly log using "`work'/s37_`id'`k'_d.log", text replace name(_s37)
        capture noisily dash `c' saving("`work'/s37_`id'`k'.html", replace)
        local drc`k' = _rc
        quietly log close _s37
    }
    global S37_TWD "`work'/s37_`id'd.svg"
    global S37_TW "`work'/s37_`id'p.svg"
    global S37_PGD "`work'/s37_`id'd.html"
    global S37_PG "`work'/s37_`id'p.html"
    global S37_OK 0
    global S37_MSG "not compared"
    if !`trcp' & !`drcp' capture noisily python: __import__("__main__")._s37_style()
    local nt 1
    local nd 1
    if `"`note'"' != "" {
        _s36_count "`work'/s37_`id'p.log" "named style"
        local nt = r(n)
        _s36_count "`work'/s37_`id'p_d.log" `"`note'"'
        local nd = r(n)
    }
    _w30_expect `id' "(`trcp' == 0 & `drcp' == 0 & ${S37_OK} == 1 & `nt' >= 1 & `nd' == 1)" `"twoway rc `trcp', dash rc `drcp', notes `nt' `nd': ${S37_MSG}"'
    _w30_done `id' `"`what'"'
    foreach k in d p {
        capture erase "`work'/s37_`id'`k'.svg"
        capture erase "`work'/s37_`id'`k'.html"
        capture erase "`work'/s37_`id'`k'.log"
        capture erase "`work'/s37_`id'`k'_d.log"
    }
end

* ==== S37 P1.24: mlabvposition() and mlabtextstyle() ====
local only : env WP30_ONLY
if inlist("`only'", "", "S37") & `: list posof "S37" in w30_run' {
    display as text "S37 start " c(current_date) " " c(current_time)
    global S37_REPO "`c(pwd)'/.."
    // The data of test/fixtures/mlabvpos_truth.json: 18 points on a
    // diagonal, positions 0..12 then ., 3.5, 13, -1, .a.
    quietly {
        clear
        set obs 18
        gen double x = _n
        gen double y = _n
        gen str3 lab = "R" + string(_n)
        gen double pos = _n - 1 in 1/13
        replace pos = 3.5 in 15
        replace pos = 13 in 16
        replace pos = -1 in 17
        replace pos = .a in 18
        gen double p9 = 9
        gen byte g = mod(_n, 2)
        gen double y2 = y + 20
    }
    // MV-20: the abbreviations reach the spec as the full name.
    capture dash clear
    capture noisily dash scatter y x, mlabel(lab) mlabv(po) name(zmv20)
    local drc = _rc
    capture twoway scatter y x, mlabel(lab) mlabv(po) nodraw
    local trc = _rc
    mata: st_local("k", strofreal(strpos(st_global("dash_json_zmv20"), char(34) + "mlabvposition" + char(34) + ":" + char(34) + "pos" + char(34)) > 0))
    _w30_expect MV-20 "(`drc' == 0 & `trc' == 0 & `k' == 1)" "dash rc `drc', twoway rc `trc', key `k'"
    _w30_done MV-20 "mlabv(po) is written as mlabvposition pos, rc 0 as in twoway"
    capture dash clear
    _s37_case MV-21 "scatter y x, mlabel(lab) mlabvposition(pos) scheme(stcolor)" "`w30_work'" "each row's label at its own clock, as twoway draws it"
    _s37_case MV-22 "scatter y x, mlabel(lab) mlabvposition(pos) mlabposition(9) scheme(stcolor)" "`w30_work'" "a missing position takes mlabposition()"
    _s37_case MV-23 "scatter y y2 x, mlabel(lab lab) mlabvposition(p9) scheme(stcolor)" "`w30_work'" "one variable places every y's labels"
    _s37_case MV-24 "scatter y x, mlabel(lab) mlabvposition(pos) by(g) scheme(stcolor)" "`w30_work'" "each by() panel's rows at their own clocks"
    macro drop S37_*
    capture dash clear
    display as text "S37 end " c(current_date) " " c(current_time)
}
* ==== end S37 ====

* ==== S37 P1.24: mlabtextstyle() ====
local only : env WP30_ONLY
if inlist("`only'", "", "S37") & `: list posof "S37" in w30_run' {
    display as text "S37 start " c(current_date) " " c(current_time)
    global S37_REPO "`c(pwd)'/.."
    quietly {
        clear
        set obs 3
        gen double x = _n
        gen double y = 2 * x
        gen double y2 = y + 1
        gen str2 lab = "Q" + string(_n)
        gen str2 lab2 = "S" + string(_n)
    }
    _s37_tstyle MV-25 "scatter y x, mlabel(lab) mlabtextstyle(heading) scheme(stcolor)" "`w30_work'" "mlabtextstyle(heading) is the scheme's heading, size and colour, as twoway draws it"
    _s37_tstyle MV-26 "scatter y y2 x, mlabel(lab lab2) mlabtextstyle(heading body) scheme(stcolor)" "`w30_work'" "a style list: heading for the first y, body for the second"
    _s37_tstyle MV-27 "scatter y x, mlabel(lab) mlabtextstyle(nosuch) scheme(stcolor)" "`w30_work'" "an unknown name is noted, as twoway notes it, and drawn in body" "mlabtextstyle(nosuch) is not a recognised text style"
    macro drop S37_*
    capture dash clear
    display as text "S37 end " c(current_date) " " c(current_time)
}
* ==== end S37 ====

// _s38_page html -- the first figure of a saved page, read from its
// document JSON (WP-30 P1.20a): globals S38_BG, S38_BORDER, S38_OL,
// S38_OLW, S38_OLD (1 when dashed), S38_BL; a property the page leaves at
// Bokeh's default reads as its default ("" for no colour).
capture program drop _s38_page
program define _s38_page
    version 19
    args html
    global S38_HTML `"`html'"'
    python: __import__("sys").modules["_dash_s38"].page()
end
python:
def _s38_page():
    import json, re
    from sfi import Macro
    with open(Macro.getGlobal("S38_HTML"), encoding="utf-8") as fh:
        txt = fh.read()
    fig = {}
    for m in re.finditer(r'<script type="application/json"[^>]*>(.*?)</script>', txt, re.S):
        stack = [json.loads(m.group(1))]
        while stack and not fig:
            o = stack.pop()
            if isinstance(o, dict):
                if o.get("name") == "Figure" and isinstance(o.get("attributes"), dict):
                    fig = o["attributes"]
                    break
                stack.extend(o.values())
            elif isinstance(o, list):
                stack.extend(o)
        if fig:
            break
    def g(k, d=""):
        v = fig.get(k, d)
        return "" if v is None else str(v)
    Macro.setGlobal("S38_BG", g("background_fill_color", "#ffffff"))
    Macro.setGlobal("S38_BORDER", g("border_fill_color", "#ffffff"))
    Macro.setGlobal("S38_OL", g("outline_line_color", "#e5e5e5"))
    Macro.setGlobal("S38_OLW", g("outline_line_width", "1"))
    d = fig.get("outline_line_dash", [])
    Macro.setGlobal("S38_OLD", "1" if isinstance(d, list) and d else "0")
    Macro.setGlobal("S38_BL", g("border_line_color", ""))
# A Stata program's python: line sees only modules, not these names.
import sys as _s38_sys
_s38_sys.modules["_dash_s38"] = type(_s38_sys)("_dash_s38")
_s38_sys.modules["_dash_s38"].page = _s38_page
end

* ==== S38 P1.20a: plotregion()/graphregion() styling ====
local only : env WP30_ONLY
if inlist("`only'", "", "S38") & `: list posof "S38" in w30_run' {
    display as text "S38 start " c(current_date) " " c(current_time)
    local s38log "`w30_work'/s38.log"
    local s38pg "`w30_work'/zrs.html"
    local s38ls = c(linesize)
    set linesize 255
    quietly sysuse auto, clear

    // RS-20: every abbreviation drawn: fill red, outline navy, dashed,
    // thick over the scheme's thin (twoway: 23.04 / 5.76 SVG units).
    _s36_run `"dash scatter mpg weight, plotregion(fc(red) lc(navy) lw(thick) lp(dash)) scheme(s2color) saving("`s38pg'", replace)"' "`s38log'"
    local drc = r(rc)
    capture _s38_page "`s38pg'"
    local prc = _rc
    local ratio = real("${S38_OLW}") / 0.768
    local ok = (`drc' == 0 & `prc' == 0 & "${S38_BG}" == "#ff0000" & "${S38_OL}" == "#1a476f" & "${S38_OLD}" == "1" & abs(`ratio' - 23.04 / 5.76) < 0.08)
    _w30_expect RS-20 "(`ok')" "rc `drc'/`prc', fill ${S38_BG}, outline ${S38_OL} dashed ${S38_OLD} width ratio `ratio'"
    _w30_done RS-20 "plotregion(fc() lc() lw() lp()) draws twoway's fill, outline, width and dash"

    // RS-21: bgcolor() is the canvas; it shows through regions that are none.
    _s36_run `"dash scatter mpg weight, bgcolor(red) graphregion(color(none)) plotregion(fcolor(none)) scheme(s2color) saving("`s38pg'", replace)"' "`s38log'"
    local drc = r(rc)
    capture _s38_page "`s38pg'"
    local ok = (`drc' == 0 & "${S38_BORDER}" == "#ff0000" & "${S38_BG}" == "#ff0000")
    _w30_expect RS-21 "(`ok')" "rc `drc', border ${S38_BORDER}, background ${S38_BG}"
    _w30_done RS-21 "bgcolor(red) under graphregion(color(none)) plotregion(fcolor(none)) shows red, as twoway's canvas"

    // RS-22: style(none) leaves the plot region unpainted.
    _s36_run `"dash scatter mpg weight, plotregion(style(none)) scheme(s2color) saving("`s38pg'", replace)"' "`s38log'"
    local drc = r(rc)
    capture _s38_page "`s38pg'"
    local ok = (`drc' == 0 & "${S38_BG}" == "${S38_BORDER}" & "${S38_OL}" == "")
    _w30_expect RS-22 "(`ok')" "rc `drc', background ${S38_BG}, border ${S38_BORDER}, outline ${S38_OL}"
    _w30_done RS-22 "plotregion(style(none)) draws no fill and no outline"

    // RS-23: what twoway accepts and dash does not draw is named, once.
    _s36_run `"dash scatter mpg weight, plotregion(lalign(inside) ifcolor(red)) scheme(s2color) saving("`s38pg'", replace)"' "`s38log'"
    local drc = r(rc)
    // Flipped (WP-30 P1.20b): ifcolor() is drawn now (the inner box).
    _s36_count "`s38log'" "plotregion() sub-option(s) not implemented and ignored: lalign(inside)"
    local nn = r(n)
    _w30_expect RS-23 "(`drc' == 0 & `nn' == 1)" "rc `drc', notes `nn'"
    _w30_done RS-23 "plotregion(lalign() ifcolor()) is rc 0 and lalign() named in one note"
    capture dash clear
    capture erase "`s38log'"
    capture erase "`s38pg'"
    macro drop S38_*
    set linesize `s38ls'
    display as text "S38 end " c(current_date) " " c(current_time)
}
* ==== end S38 ====

// _s39_spans html [probe] -- the Spans of a saved page, read from its
// document JSON (WP-30 P1.21a): globals S39_N (count), S39_LEV (the
// distinct levels), S39_W (the first Span's width) and, with probe given,
// S39_MATCH (1 when the Spans' (axis, position, colour) multiset is the
// refline_truth.json probe's lines).
capture program drop _s39_spans
program define _s39_spans
    version 19
    args html probe
    global S39_HTML `"`html'"'
    global S39_PROBE `"`probe'"'
    python: __import__("sys").modules["_dash_s39"].spans()
end
python:
def _s39_spans():
    import json, re
    from sfi import Macro
    with open(Macro.getGlobal("S39_HTML"), encoding="utf-8") as fh:
        txt = fh.read()
    spans = []
    for m in re.finditer(r'<script type="application/json"[^>]*>(.*?)</script>', txt, re.S):
        stack = [json.loads(m.group(1))]
        while stack:
            o = stack.pop()
            if isinstance(o, dict):
                if o.get("name") == "Span" and isinstance(o.get("attributes"), dict):
                    spans.append(o["attributes"])
                stack.extend(o.values())
            elif isinstance(o, list):
                stack.extend(o)
    Macro.setGlobal("S39_N", str(len(spans)))
    Macro.setGlobal("S39_LEV", " ".join(sorted({str(a.get("level", "annotation")) for a in spans})))
    Macro.setGlobal("S39_W", str(spans[0].get("line_width", 1)) if spans else "")
    probe = Macro.getGlobal("S39_PROBE")
    if probe:
        with open("fixtures/refline_truth.json", encoding="utf-8") as fh:
            rec = json.load(fh)["probes"][probe]
        got = sorted(("x" if a.get("dimension") == "height" else "y",
                      round(float(a.get("location"))),
                      str(a.get("line_color", "black")).lower()) for a in spans)
        want = sorted((ln["axis"], round(ln["pos"]), ln["stroke"]) for ln in rec["lines"])
        Macro.setGlobal("S39_MATCH", "1" if got == want else "0")
        Macro.setGlobal("S39_GOT", str(got)[:200])
# A Stata program's python: line sees only modules, not these names.
import sys as _s39_sys
_s39_sys.modules["_dash_s39"] = type(_s39_sys)("_dash_s39")
_s39_sys.modules["_dash_s39"].spans = _s39_spans
end

* ==== S39 P1.21a: xline/yline positions, refusals and lstyle ====
local only : env WP30_ONLY
if inlist("`only'", "", "S39") & `: list posof "S39" in w30_run' {
    display as text "S39 start " c(current_date) " " c(current_time)
    local s39log "`w30_work'/s39.log"
    local s39pg "`w30_work'/zxp.html"
    quietly sysuse auto, clear

    // XP-20 / XP-23: positions and colours equal twoway's
    // (refline_truth.json P01, P05, P12, P13), every Span under the data.
    local lev ""
    foreach row in "P01|xline(2000(500)3000)" "P05|xline(2000 2500 to 3500)" ///
            "P12|yline(20, lcolor(red)) yline(10(5)40, lcolor(blue))" ///
            "P13|xline(2000(500)3000, lcolor(red)) xline(4000)" {
        gettoken pid opt : row, parse("|")
        local opt = substr(`"`opt'"', 2, .)
        _s36_run `"dash scatter mpg weight, `opt' scheme(s2color) saving("`s39pg'", replace)"' "`s39log'"
        local drc = r(rc)
        capture _s39_spans "`s39pg'" `pid'
        _w30_expect XP-20 "(`drc' == 0 & _rc == 0 & ${S39_MATCH} == 1)" "`pid' rc `drc': ${S39_GOT}"
        local lev "`lev' ${S39_LEV}"
    }
    _w30_done XP-20 "numlist positions and each copy's colour equal twoway's"
    local lev : list uniq lev
    _w30_expect XP-23 `"("`lev'" == "underlay")"' "levels `lev'"
    _w30_done XP-23 "every reference line is drawn under the data"

    // XP-21: lstyle(foreground) lcolor(red): red, at foreground's width
    // (twoway: 5.76 against xyline's 8.64).
    _s36_run `"dash scatter mpg weight, xline(3000) scheme(s2color) saving("`s39pg'", replace)"' "`s39log'"
    capture _s39_spans "`s39pg'"
    local w0 = real("${S39_W}")
    _s36_run `"dash scatter mpg weight, xline(3000, lstyle(foreground) lcolor(red)) scheme(s2color) saving("`s39pg'", replace)"' "`s39log'"
    local drc = r(rc)
    capture _s39_spans "`s39pg'" S13_s2color
    local ratio = real("${S39_W}") / `w0'
    _w30_expect XP-21 "(`drc' == 0 & ${S39_MATCH} == 1 & abs(`ratio' - 5.76 / 8.64) < 0.02 * 5.76 / 8.64)" "rc `drc', ${S39_GOT}, width ratio `ratio'"
    _w30_done XP-21 "lstyle(foreground) lcolor(red) draws red at foreground's width"

    // XP-22: lstyle(none) draws no line; lalign(inside) one, no note.
    _s36_run `"dash scatter mpg weight, xline(3000, lstyle(none)) saving("`s39pg'", replace)"' "`s39log'"
    local drc = r(rc)
    capture _s39_spans "`s39pg'"
    _w30_expect XP-22 "(`drc' == 0 & ${S39_N} == 0)" "lstyle(none): rc `drc', ${S39_N} Spans"
    _s36_run `"dash scatter mpg weight, xline(3000, lalign(inside)) saving("`s39pg'", replace)"' "`s39log'"
    local drc = r(rc)
    capture _s39_spans "`s39pg'"
    _s36_count "`s39log'" "xline() sub-option"
    _w30_expect XP-22 "(`drc' == 0 & ${S39_N} == 1 & r(n) == 0)" "lalign(inside): rc `drc', ${S39_N} Spans, notes `r(n)'"
    _w30_done XP-22 "lstyle(none) draws nothing; lalign(inside) draws with no note"
    capture dash clear
    capture erase "`s39log'"
    capture erase "`s39pg'"
    macro drop S39_*
    display as text "S39 end " c(current_date) " " c(current_time)
}
* ==== end S39 ====

// _s40_paths html svg -- the visible Line runs of a saved page's first
// figure, read from its document JSON, against the subpaths of twoway's
// SVG of the same command in data units (WP-30 P1.8a): S40_OK is 1 when
// they agree within 0.2% of each axis's span, S40_WHY says how they
// differ.  A run is split at a non-finite vertex, as the browser splits
// it.  With svg "", S40_COLOR holds the first visible Line's colour.
capture program drop _s40_paths
program define _s40_paths
    version 19
    args html svg
    global S40_HTML `"`html'"'
    global S40_SVG `"`svg'"'
    python: __import__("sys").modules["_dash_s40"].paths()
end
python:
def _s40_paths():
    import base64, json, math, os, re, sys
    from sfi import Macro
    with open(Macro.getGlobal("S40_HTML"), encoding="utf-8") as fh:
        txt = fh.read()
    objs, fig = {}, None
    for m in re.finditer(r'<script type="application/json"[^>]*>(.*?)</script>', txt, re.S):
        stack = [json.loads(m.group(1))]
        while stack:
            o = stack.pop()
            if isinstance(o, dict):
                if "id" in o and "name" in o:
                    objs[o["id"]] = o
                    if fig is None and o["name"] == "Figure":
                        fig = o
                stack.extend(o.values())
            elif isinstance(o, list):
                stack.extend(o)
    def res(o):
        return objs.get(o.get("id"), o) if isinstance(o, dict) else o
    def arr(v):
        if isinstance(v, dict) and v.get("type") == "ndarray":
            import numpy as np
            a = v["array"]
            raw = base64.b64decode(a["data"]) if isinstance(a, dict) else None
            if raw is not None and raw[:2] == b"\x1f\x8b":
                import gzip
                raw = gzip.decompress(raw)
            if raw is None:
                return [float("nan") if x is None else float(x) for x in a]
            return [float(x) for x in np.frombuffer(raw, dtype=v["dtype"])]
        out = []
        for x in v or []:
            if isinstance(x, dict):
                x = float(x.get("value", "nan"))
            out.append(float("nan") if x is None else float(x))
        return out
    runs, color = [], ""
    for rr in (fig or {}).get("attributes", {}).get("renderers", []):
        r = res(rr).get("attributes", {})
        g = res(r.get("glyph", {}))
        if g.get("name") != "Line":
            continue
        ga = g.get("attributes", {})
        if ga.get("line_alpha", 1) == 0:
            continue
        data = res(r.get("data_source", {})).get("attributes", {}).get("data", {})
        cols = dict(data.get("entries", [])) if isinstance(data, dict) else {}
        xs = arr(cols.get(ga.get("x", {}).get("field")))
        ys = arr(cols.get(ga.get("y", {}).get("field")))
        if not color:
            color = str(ga.get("line_color", ""))
        cur = []
        for a, b in zip(xs, ys):
            if math.isfinite(a) and math.isfinite(b):
                cur.append((a, b))
            elif cur:
                runs.append(cur)
                cur = []
        if cur:
            runs.append(cur)
    Macro.setGlobal("S40_COLOR", color)
    svg = Macro.getGlobal("S40_SVG")
    if not svg:
        Macro.setGlobal("S40_OK", "1" if runs else "0")
        Macro.setGlobal("S40_WHY", "%d runs" % len(runs))
        return
    sys.path.insert(0, os.path.join(Macro.getGlobal("S40_REPO"), "scripts"))
    import svg_truth
    def fit(axis):
        pairs = svg_truth.svg_axis_reading(svg, axis).get("pairs") or []
        n = float(len(pairs))
        mx = sum(p for p, _ in pairs) / n
        mv = sum(v for _, v in pairs) / n
        b = (sum((p - mx) * (v - mv) for p, v in pairs)
             / sum((p - mx) ** 2 for p, _ in pairs))
        return mv - b * mx, b
    fx, fy = fit("x"), fit("y")
    with open(svg, encoding="utf-8") as fh:
        stxt = fh.read()
    want = []
    for el in re.findall(r"<path[^>]*>", stxt):
        m = re.search(r'\sd="([^"]*)"', el)
        if not m or "Z" in m.group(1):
            continue
        for sub in re.split(r"(?=M)", m.group(1)):
            nums = re.findall(r"[ML]\s*(-?[0-9.]+)\s+(-?[0-9.]+)", sub)
            if nums:
                want.append([(fx[0] + fx[1] * float(a), fy[0] + fy[1] * float(b))
                             for a, b in nums])
    pts = [p for r in want for p in r] or [(0.0, 0.0)]
    tx = 2e-3 * max(1.0, max(p[0] for p in pts) - min(p[0] for p in pts))
    ty = 2e-3 * max(1.0, max(p[1] for p in pts) - min(p[1] for p in pts))
    ok = len(runs) == len(want) and all(
        len(a) == len(b) and all(abs(p[0] - q[0]) <= tx and abs(p[1] - q[1]) <= ty
                                 for p, q in zip(a, b))
        for a, b in zip(runs, want))
    Macro.setGlobal("S40_OK", "1" if ok else "0")
    Macro.setGlobal("S40_WHY", "dash %s, twoway %s" % (
        [len(r) for r in runs], [len(r) for r in want]))
# A Stata program's python: line sees only modules, not these names.
import sys as _s40_sys
_s40_sys.modules["_dash_s40"] = type(_s40_sys)("_dash_s40")
_s40_sys.modules["_dash_s40"].paths = _s40_paths
end

capture program drop _s40_dataT
program define _s40_dataT
    version 19
    clear
    quietly set obs 8
    quietly generate double x = .
    quietly generate double y = .
    quietly generate double y2 = .
    local xs  2 5 3 6 1 . 7 4
    local ys  10 20 . 40 50 45 60 70
    local y2s 12 22 32 42 . 47 62 72
    forvalues i = 1/8 {
        quietly replace x  = `: word `i' of `xs''  in `i'
        quietly replace y  = `: word `i' of `ys''  in `i'
        quietly replace y2 = `: word `i' of `y2s'' in `i'
    }
    quietly generate double y3 = y + 1
end

* ==== S40 P1.8a: connect() and cmissing() ====
local only : env WP30_ONLY
if inlist("`only'", "", "S40") & `: list posof "S40" in w30_run' {
    display as text "S40 start " c(current_date) " " c(current_time)
    local s40log "`w30_work'/s40.log"
    local s40pg "`w30_work'/zcm.html"
    local s40svg "`w30_work'/zcm.svg"
    global S40_REPO "`c(pwd)'/.."
    // CM-20 P02 P03 P04 P08 P09 P12 P16 P17; CM-21 P18 P19; CM-22 P20 P23
    // P24: dash's saved runs against twoway's SVG of the same command,
    // drawn live (connect_truth.json records the same paths).
    local c20 `""line y x, c(J)" "line y x, c(stepstair) sort" "line y x, c(L)" "line y x, cmissing(n)" "scatter y x, c(l) cmissing(n)" "line y y2 x, cmissing(n)" "line y x, cmissing(n) c(J)" "line y x, cmissing(n) c(L)""'
    local c21 `""function y=sqrt(x^2-1), range(-2 2)" "function y=sqrt(x^2-1), range(-2 2) cmissing(n)""'
    local c22 `""scatter y y2 x, c(l)" "scatter y y2 y3 x, c(J =)" "scatter y y2 y3 x, c(l . J)""'
    local d20 "c(J), c(stepstair), c(L) and cmissing(n) draw twoway's paths"
    local d21 "function bridges its missing middle and breaks under cmissing(n)"
    local d22 "connect() per y draws each y's path, a scatter y given none none"
    foreach id in 20 21 22 {
        foreach c of local c`id' {
            _s40_dataT
            quietly graph drop _all
            capture noisily twoway `c'
            local trc = _rc
            if !`trc' quietly graph export "`s40svg'", replace
            _s40_dataT
            _s36_run `"dash `c' saving("`s40pg'", replace)"' "`s40log'"
            local drc = r(rc)
            global S40_OK 0
            global S40_WHY ""
            if !`trc' & !`drc' capture _s40_paths "`s40pg'" "`s40svg'"
            _w30_expect CM-`id' "(`trc' == 0 & `drc' == 0 & ${S40_OK} == 1)" `"`c': rc `trc'/`drc', ${S40_WHY}"'
        }
        _w30_done CM-`id' "`d`id''"
    }

    // CM-23: lfit and kdensity c(J) on auto draw stairs as twoway does.
    foreach c in "lfit mpg weight, c(J)" "kdensity mpg, c(J)" {
        quietly sysuse auto, clear
        quietly graph drop _all
        capture noisily twoway `c'
        local trc = _rc
        if !`trc' quietly graph export "`s40svg'", replace
        _s36_run `"dash `c' saving("`s40pg'", replace)"' "`s40log'"
        local drc = r(rc)
        global S40_OK 0
        if !`trc' & !`drc' capture _s40_paths "`s40pg'" "`s40svg'"
        _w30_expect CM-23 "(`trc' == 0 & `drc' == 0 & ${S40_OK} == 1)" `"`c': rc `trc'/`drc', ${S40_WHY}"'
    }
    _w30_done CM-23 "lfit and kdensity c(J) draw twoway's stairs"

    // CM-24: P28's connecting line is clcolor()'s red (twoway #FF0000).
    _s40_dataT
    _s36_run `"dash scatter y x, c(l) clcolor(red) saving("`s40pg'", replace)"' "`s40log'"
    local drc = r(rc)
    global S40_COLOR ""
    if !`drc' capture _s40_paths "`s40pg'" ""
    mata: st_local("col", strlower(st_global("S40_COLOR")))
    _w30_expect CM-24 `"(`drc' == 0 & inlist("`col'", "red", "#ff0000", "#ff0000ff"))"' "rc `drc', colour `col'"
    _w30_done CM-24 "scatter, c(l) clcolor(red) draws its line red, as twoway does"
    capture dash clear
    capture erase "`s40log'"
    capture erase "`s40pg'"
    capture erase "`s40svg'"
    macro drop S40_*
    display as text "S40 end " c(current_date) " " c(current_time)
}
* ==== end S40 ====

* ==== S41 P1.30: Verified bokeh window; internals fail closed ====
local only : env WP30_ONLY
if inlist("`only'", "", "S41") & `: list posof "S41" in w30_run' {
    display as text "S41 start " c(current_date) " " c(current_time)
    // The bokeh version dash reads at run time (WP-30 P1.30, M9).  bokeh's
    // modules are imported before its version is set, as Bokeh reads it on
    // first import; the real one is put back at the end.
    local s41log "`w30_work'/s41.log"
    local s41pg "`w30_work'/s41a.html"
    local s41app "`w30_work'/s41a.py"
    local s41ls = c(linesize)
    set linesize 255
    quietly sysuse auto, clear
    python: import bokeh, bokeh.embed, bokeh.resources, bokeh.plotting, bokeh.models, bokeh.server.server
    python: import sfi; sfi.Macro.setGlobal("S41_V", bokeh.__version__)
    python: bokeh.__version__ = "3.10.0"

    // BK-20: a saved page under a bokeh above the window: drawn, one note.
    _s36_run `"dash scatter mpg weight, saving("`s41pg'", replace)"' "`s41log'"
    local drc = r(rc)
    _s36_count "`s41log'" "(note:  dash: bokeh 3.10.0 is newer"
    local nn = r(n)
    _s36_count "`s41log'" "dash_setup installs bokeh>=3.8,<3.10"
    local ns = r(n)
    capture confirm file "`s41pg'"
    local frc = _rc
    _w30_expect BK-20 "(`drc' == 0 & `frc' == 0 & `nn' == 1 & `ns' == 1)" "rc `drc', file `frc', notes `nn', dash_setup `ns'"
    _w30_done BK-20 "a saved page under bokeh 3.10.0 is written with one note naming dash_setup"

    // BK-21: dash build, server under the same bokeh: one note.
    capture dash clear
    quietly graph drop _all
    quietly dash scatter mpg weight, name(g1)
    capture log close _s41
    quietly log using "`s41log'", text replace name(_s41)
    capture noisily dash build, server saving("`s41app'") replace nobrowser
    local drc = _rc
    quietly log close _s41
    _s36_count "`s41log'" "(note:  dash: bokeh 3.10.0 is newer"
    local nn = r(n)
    capture confirm file "`s41app'"
    local frc = _rc
    _w30_expect BK-21 "(`drc' == 0 & `frc' == 0 & `nn' == 1)" "rc `drc', file `frc', notes `nn'"
    _w30_done BK-21 "dash build, server under bokeh 3.10.0 writes the app with one note"

    // BK-22: below the floor: refused r(198) naming dash_setup, no page.
    python: bokeh.__version__ = "3.7.3"
    capture erase "`w30_work'/s41b.html"
    _s36_run `"dash scatter mpg weight, saving("`w30_work'/s41b.html", replace)"' "`s41log'"
    local drc = r(rc)
    _s36_count "`s41log'" "bokeh 3.7.3"
    local n1 = r(n)
    _s36_count "`s41log'" "older than 3.8"
    local n2 = r(n)
    _s36_count "`s41log'" "dash_setup"
    local n3 = r(n)
    capture confirm file "`w30_work'/s41b.html"
    local frc = _rc
    _w30_expect BK-22 "(`drc' == 198 & `n1' >= 1 & `n2' >= 1 & `n3' >= 1 & `frc' != 0)" "rc `drc', said `n1' `n2' `n3', file `frc'"
    _w30_done BK-22 "bokeh 3.7.3 is refused r(198) naming 3.8 and dash_setup, and nothing is written"

    // BK-23: the real bokeh: no note.
    python: bokeh.__version__ = sfi.Macro.getGlobal("S41_V")
    _s36_run `"dash scatter mpg weight, saving("`s41pg'", replace)"' "`s41log'"
    local drc = r(rc)
    _s36_count "`s41log'" "(note:  dash: bokeh"
    local nn = r(n)
    _w30_expect BK-23 "(`drc' == 0 & `nn' == 0)" "rc `drc', notes `nn'"
    _w30_done BK-23 "under the installed bokeh dash prints no bokeh note"
    capture dash clear
    capture erase "`s41log'"
    capture erase "`s41pg'"
    capture erase "`s41app'"
    macro drop S41_*
    set linesize `s41ls'
    display as text "S41 end " c(current_date) " " c(current_time)
}
* ==== end S41 ====

// S42 (P1.7) helpers: a saved page's titles, legend items, tooltip labels
// and the time-series columns its sources draw, read from its document
// JSON; twoway's titles, keys and serset beside them.
python:
def _s42_page():
    import base64, gzip, json, re
    import numpy as np
    from sfi import Macro
    with open(Macro.getGlobal("S42_HTML"), encoding="utf-8") as fh:
        txt = fh.read()
    objs = {}
    for m in re.finditer(r'<script type="application/json"[^>]*>(.*?)</script>', txt, re.S):
        stack = [json.loads(m.group(1))]
        while stack:
            o = stack.pop()
            if isinstance(o, dict):
                if "id" in o and "name" in o:
                    objs.setdefault(o["id"], o)
                stack.extend(o.values())
            elif isinstance(o, list):
                stack.extend(o)
    def arr(v):
        if isinstance(v, dict) and v.get("type") == "ndarray":
            a = v["array"]
            raw = base64.b64decode(a["data"]) if isinstance(a, dict) else None
            if raw is not None and raw[:2] == b"\x1f\x8b":
                raw = gzip.decompress(raw)
            if raw is None:
                return [None if x is None else float(x) for x in a]
            return [float(x) for x in np.frombuffer(raw, dtype=v["dtype"])]
        return [None if x is None else float(x) if not isinstance(x, dict)
                else float(x.get("value", "nan")) for x in (v or [])]
    out = {"axes": [], "legend": [], "tips": [], "cols": {}}
    for o in objs.values():
        at = o.get("attributes", {}) or {}
        if o["name"].endswith("Axis") and at.get("axis_label"):
            out["axes"].append([o["name"], at["axis_label"]])
        elif o["name"] == "LegendItem":
            lab = at.get("label")
            out["legend"].append(lab.get("value") if isinstance(lab, dict) else lab)
        elif o["name"] == "HoverTool":
            for t in at.get("tooltips") or []:
                out["tips"].append(list(t))
        elif o["name"] == "ColumnDataSource":
            d = at.get("data", {})
            cols = dict(d.get("entries", [])) if isinstance(d, dict) else {}
            for k, v in cols.items():
                if k.startswith("__dasht") or k in ("t", "tt", "date"):
                    out["cols"].setdefault(k, []).append(arr(v))
    return out


def _s42_serset():
    import csv
    from sfi import Macro
    with open(Macro.getGlobal("S42_SER"), encoding="utf-8") as fh:
        rows = list(csv.reader(fh))
    head = rows[0]
    return {h: [None if r[i] in ("", ".") else float(r[i]) for r in rows[1:]]
            for i, h in enumerate(head)}


def _s42_check():
    """Sets S42_OK (1/0) and S42_WHY for the case in S42_CASE."""
    import math
    from sfi import Macro
    case = Macro.getGlobal("S42_CASE")
    page = _s42_page()
    ser = _s42_serset()
    ok, why = True, ""
    def vals(col):
        return [v for run in page["cols"].get(col, []) for v in run
                if v is not None and math.isfinite(v)]
    if case == "TSO-20":
        ty = Macro.getGlobal("S42_TY")
        labels = [a[1] for a in page["axes"]]
        want = sorted(v for v in ser["D_close"] if v is not None)
        got = sorted(set(vals("__dasht1")))
        ok = ty in labels and got == sorted(set(want))
        why = "twoway %r, dash %r; %d values, %d of twoway's" % (
            ty, labels, len(got), len(set(want)))
    elif case == "TSO-21":
        texts = set(Macro.getGlobal("S42_TEXTS").split("|"))
        leg = sorted(page["legend"])
        ok = (leg == ["Closing price, L", "Closing price, L2"]
              and set(leg) <= texts)
        why = "dash %r" % leg
    elif case == "TSO-22":
        pairs = {}
        for xs, ys in zip(page["cols"].get("t", []), page["cols"].get("__dasht1", [])):
            pairs.update(zip(xs, ys))
        tw = dict(zip(ser["t"], ser["D_close"]))
        ok = (abs(pairs.get(6.0, 0) - 4.940063) < 5e-6
              and pairs.get(6.0) == tw.get(6.0))
        why = "dash %r, twoway %r" % (pairs.get(6.0), tw.get(6.0))
    elif case == "TSO-23":
        miss = [t for t, v in zip(ser["tt"], ser["L_y"]) if v is None]
        got = len(vals("__dasht1"))
        ok = miss == [1.0, 1.0] and got == sum(v is not None for v in ser["L_y"])
        why = "twoway missing at %r, dash draws %d" % (miss, got)
    elif case == "TSO-24":
        names = [a[0] for a in page["axes"] if a[1] == "Date, D"]
        ok = names == ["DatetimeAxis"] and Macro.getGlobal("S42_FMT") == "%td"
        why = "dash axes %r, twoway's serset format %s" % (
            names, Macro.getGlobal("S42_FMT"))
    tips = [t for t in page["tips"] if "__dasht" in str(t[0])]
    if tips:
        ok, why = False, why + "; a tooltip shows %r" % tips
    Macro.setGlobal("S42_OK", "1" if ok else "0")
    Macro.setGlobal("S42_WHY", why)
import sys as _s42_sys
_s42_sys.modules["_dash_s42"] = type(_s42_sys)("_dash_s42")
_s42_sys.modules["_dash_s42"].check = _s42_check
end

// The data in memory (a serset) to a CSV, every value at full precision.
mata:
void _s42_csv(string scalar file)
{
    real scalar   fh, i, j
    string scalar line
    if (fileexists(file)) unlink(file)
    fh = fopen(file, "w")
    line = st_varname(1)
    for (j = 2; j <= st_nvar(); j++) line = line + "," + st_varname(j)
    fput(fh, line)
    for (i = 1; i <= st_nobs(); i++) {
        line = ""
        for (j = 1; j <= st_nvar(); j++) {
            line = line + (j > 1 ? "," : "") +
                (_st_data(i, j) >= . ? "." : strtrim(strofreal(_st_data(i, j), "%21.17g")))
        }
        fput(fh, line)
    }
    fclose(fh)
}
end

capture program drop _s42_data
program define _s42_data
    version 19
    args ds
    if "`ds'" == "xt" {
        clear
        quietly {
            set obs 20
            gen id = ceil(_n / 10)
            gen tt = mod(_n - 1, 10) + 1
            gen y = _n * _n
            label variable y "Y value"
            xtset id tt
        }
        exit
    }
    quietly sysuse sp500, clear
    quietly gen t = _n
    if "`ds'" == "spd" quietly tsset date
    else quietly tsset t
end

// _s42_case <id> <twoway body> <work stem>: twoway's y title, serset (its
// first) and SVG texts; then dash's saved page of the same body; then
// the comparison of _s42_check.
capture program drop _s42_case
program define _s42_case
    version 19
    args id body stem
    capture graph drop s42g
    serset clear
    quietly twoway `body', name(s42g, replace)
    global S42_TY `"`.s42g.yaxis1.title.text[1]'"'
    quietly graph export "`stem'.svg", name(s42g) replace
    global S42_STEM "`stem'"
    python: import sys, sfi; sys.path.insert(0, sfi.Macro.getGlobal("S42_REPO") + "/scripts"); import svg_truth; sfi.Macro.setGlobal("S42_TEXTS", "|".join(e["text"] for e in svg_truth.svg_document(sfi.Macro.getGlobal("S42_STEM") + ".svg")["texts"]))
    quietly serset set 0
    preserve
    quietly serset use, clear
    global S42_FMT ""
    capture confirm variable D_date
    if !_rc global S42_FMT : format D_date
    mata: _s42_csv(st_local("stem") + ".csv")
    restore
    capture graph drop s42g
    global S42_HTML "`stem'.html"
    global S42_SER "`stem'.csv"
    global S42_CASE "`id'"
    capture dash clear
    quietly graph drop _all
    capture noisily dash `body', saving("`stem'.html", replace)
    if _rc {
        global S42_OK 0
        global S42_WHY "dash r(`=_rc')"
        exit
    }
    python: __import__("sys").modules["_dash_s42"].check()
end

* ==== S42 P1.7: Time-series operators in plot varlists ====
local only : env WP30_ONLY
if inlist("`only'", "", "S42") & `: list posof "S42" in w30_run' {
    display as text "S42 start " c(current_date) " " c(current_time)
    global S42_REPO "`c(pwd)'/.."
    local k 0
    foreach row in ///
        "TSO-20|spd|line D.close date|line D.close date: the y title and the drawn values are twoway's" ///
        "TSO-21|sp|scatter L(1/2).close t|scatter L(1/2).close t: both keys are twoway's" ///
        "TSO-22|sp|scatter D.close t if t>5 & t<9|D.close at t = 6 is 4.940063, computed over every row" ///
        "TSO-23|xt|scatter L.y tt|under xtset each panel's first L.y is missing, as twoway draws it" ///
        "TSO-24|sp|scatter close D.date|D.date is drawn on a date axis, as twoway draws it in %td" {
        local ++k
        tokenize `"`row'"', parse("|")
        _s42_data `3'
        _s42_case `1' `"`5'"' "`w30_work'/s42_`k'"
        _w30_expect `1' "${S42_OK} == 1" `"${S42_WHY}"'
        _w30_done `1' `"`7'"'
        foreach ext in svg csv html {
            capture erase "`w30_work'/s42_`k'.`ext'"
        }
    }
    capture dash clear
    macro drop S42_*
    display as text "S42 end " c(current_date) " " c(current_time)
}
* ==== end S42 ====

// _s43_cmp tw0 tw1 page -- 1 in S43_OK when every (colour, opacity) the
// option introduced in twoway's SVG (tw1 against tw0, a multiset
// difference over fills, strokes and text) is a (colour, alpha) pair of
// dash's saved page at page, read from its document JSON (WP-30 P1.13b).
capture program drop _s43_cmp
program define _s43_cmp
    version 19
    args tw0 tw1 page
    global S43_TW0 `"`tw0'"'
    global S43_TW1 `"`tw1'"'
    global S43_PAGE `"`page'"'
    python: __import__("sys").modules["_dash_s43"].cmp()
end
python:
def _s43_cmp():
    import collections, json, re
    from sfi import Macro
    el = re.compile(r'<(circle|path|polygon|polyline|rect|line|text|use)\b([^>]*?)/?>', re.S)
    at = re.compile(r'([\w:-]+)="([^"]*)"')
    def num(x, d=1.0):
        try:
            return float(x)
        except (TypeError, ValueError):
            return d
    def svg(path):
        out = collections.Counter()
        with open(path, encoding="utf-8", errors="replace") as fh:
            txt = fh.read()
        for m in el.finditer(txt):
            a = dict(at.findall(m.group(2)))
            st = dict(p.split(":", 1) for p in a.get("style", "").split(";") if ":" in p)
            g = lambda k: (st.get(k) or a.get(k) or "").strip()
            op = num(g("opacity"))
            f, s_ = g("fill").lower(), g("stroke").lower()
            if f.startswith("#"):
                out[(f, round(num(g("fill-opacity")) * op, 2))] += 1
            if s_.startswith("#"):
                out[(s_, round(num(g("stroke-opacity")) * op, 2))] += 1
        return out
    new = svg(Macro.getGlobal("S43_TW1")) - svg(Macro.getGlobal("S43_TW0"))
    want = set(new)
    with open(Macro.getGlobal("S43_PAGE"), encoding="utf-8") as fh:
        txt = fh.read()
    got = set()
    def val(v):
        if isinstance(v, dict) and "value" in v:
            v = v["value"]
        return v
    for m in re.finditer(r'<script type="application/json"[^>]*>(.*?)</script>', txt, re.S):
        stack = [json.loads(m.group(1))]
        while stack:
            o = stack.pop()
            if isinstance(o, dict):
                for k, v in o.items():
                    v = val(v)
                    if k.endswith("_color") and isinstance(v, str) and re.fullmatch(r"#[0-9a-fA-F]{6}", v):
                        a = val(o.get(k[:-len("color")] + "alpha", 1.0))
                        got.add((v.lower(), round(num(a), 2)))
                stack.extend(o.values())
            elif isinstance(o, list):
                stack.extend(o)
    miss = sorted(w for w in want if w not in got)
    Macro.setGlobal("S43_OK", "1" if want and not miss else "0")
    Macro.setGlobal("S43_GOT", ("twoway " + str(sorted(want)) + " missing " + str(miss))[:240])
import sys as _s43_sys
_s43_sys.modules["_dash_s43"] = type(_s43_sys)("_dash_s43")
_s43_sys.modules["_dash_s43"].cmp = _s43_cmp
end

// _s43_case id scheme twoway-command dash-command option -- runs twoway
// without and with option, exports both SVGs, saves dash's page with it,
// and compares (_s43_cmp); the result is in S43_OK, dash's rc in S43_RC.
capture program drop _s43_case
program define _s43_case
    version 19
    args id sch tw dc opt work
    quietly graph drop _all
    quietly `tw' scheme(`sch') name(s43tw, replace)
    quietly graph export "`work'/s43_0.svg", name(s43tw) replace
    quietly `tw' `opt' scheme(`sch') name(s43tw, replace)
    quietly graph export "`work'/s43_1.svg", name(s43tw) replace
    quietly graph drop _all
    _s36_run `"`dc' `opt' scheme(`sch') saving("`work'/s43.html", replace)"' "`work'/s43.log"
    global S43_RC = r(rc)
    capture _s43_cmp "`work'/s43_0.svg" "`work'/s43_1.svg" "`work'/s43.html"
    if _rc global S43_OK 0
end

* ==== S43 P1.13b: Default colour and opacity at every colour site ====
local only : env WP30_ONLY
if inlist("`only'", "", "S43") & `: list posof "S43" in w30_run' {
    display as text "S43 start " c(current_date) " " c(current_time)
    quietly sysuse auto, clear
    local w "`w30_work'"

    // BI-01: mcolor(*.5) under four schemes equals twoway's fill.
    foreach sch in s2color stcolor sttrans s1rcolor {
        _s43_case BI-01 `sch' "twoway scatter mpg weight," "dash scatter mpg weight," "mcolor(*.5)" "`w'"
        _w30_expect BI-01 "(${S43_RC} == 0 & ${S43_OK} == 1)" "`sch' rc ${S43_RC}: ${S43_GOT}"
    }
    _w30_done BI-01 "mcolor(*.5) adjusts the marker's own colour under four schemes"

    // BI-02: bar fcolor(*.7) is #7f98ae, navy*.7 at the bar's intensity.
    _s43_case BI-02 s2color "twoway bar mpg rep78 if rep78<.," "dash bar mpg rep78 if rep78<.," "fcolor(*.7)" "`w'"
    _w30_expect BI-02 "(${S43_RC} == 0 & ${S43_OK} == 1)" "rc ${S43_RC}: ${S43_GOT}"
    _w30_done BI-02 "fcolor(*.7) on a bar is blended after the adjustment"

    // BI-03: title color(*.5) and graphregion(color(*.5)).
    _s43_case BI-03 s2color "twoway scatter mpg weight, title(T)" "dash scatter mpg weight, title(T)" "title(T, color(*.5))" "`w'"
    _w30_expect BI-03 "(${S43_RC} == 0 & ${S43_OK} == 1)" "title: rc ${S43_RC}: ${S43_GOT}"
    _s43_case BI-03 s2color "twoway scatter mpg weight," "dash scatter mpg weight," "graphregion(color(*.5))" "`w'"
    _w30_expect BI-03 "(${S43_RC} == 0 & ${S43_OK} == 1)" "graphregion: rc ${S43_RC}: ${S43_GOT}"
    _w30_done BI-03 "title and graph-region colours adjust the scheme's own"

    // BI-04: xline(3000, lcolor(%50)): the xyline colour at 0.50.
    _s43_case BI-04 s2color "twoway scatter mpg weight," "dash scatter mpg weight," "xline(3000, lcolor(%50))" "`w'"
    _w30_expect BI-04 "(${S43_RC} == 0 & ${S43_OK} == 1)" "rc ${S43_RC}: ${S43_GOT}"
    _w30_done BI-04 "xline(, lcolor(%50)) draws the reference-line colour at half opacity"

    // BI-05: mlabcolor(red%50): opacity 0.50.
    _s43_case BI-05 s2color "twoway scatter mpg weight, mlabel(make)" "dash scatter mpg weight, mlabel(make)" "mlabcolor(red%50)" "`w'"
    _w30_expect BI-05 "(${S43_RC} == 0 & ${S43_OK} == 1)" "rc ${S43_RC}: ${S43_GOT}"
    _w30_done BI-05 "mlabcolor(red%50) keeps its opacity"

    // BI-06: bar color(bogus) is black at the bar's intensity, noted.
    _s43_case BI-06 s2color "twoway bar mpg rep78 if rep78<.," "dash bar mpg rep78 if rep78<.," "color(bogus)" "`w'"
    _s36_count "`w'/s43.log" "color(bogus)"
    _w30_expect BI-06 "(${S43_RC} == 0 & ${S43_OK} == 1 & r(n) >= 1)" "rc ${S43_RC}, notes `r(n)': ${S43_GOT}"
    _w30_done BI-06 "an unknown colour at a bar draws black, with the note"

    capture dash clear
    quietly graph drop _all
    foreach f in s43_0.svg s43_1.svg s43.html s43.log {
        capture erase "`w'/`f'"
    }
    macro drop S43_*
    display as text "S43 end " c(current_date) " " c(current_time)
}
* ==== end S43 ====

// WP-30 S44 (P1.3b) helpers.  _s44_case draws a twoway command, reads its
// date axis's ticks (.major.dlg_tickpos, Stata units) into S44_TW, builds
// dash's saved page and served app of the same command (moving the one
// range filter S44_MOVE first, through S21's readers) and compares each
// mode's ticks, in Stata units, with S44_WANT: twoway's list ("tw") or
// dash's model over the axis variable's range ("model").  A backtick here
// is spelled \x60.
python:
def _s44_units(ticks, kind):
    import dash_render as dr
    if kind.startswith("su:"):
        return [float(t) for t in ticks]
    u = dr._DASH_TS_UNITS[kind]
    return [round(dr._dash_unix_ms_to_unit(t, u), 6) for t in ticks]


def _s44_check():
    import dash_render as dr
    from bokeh.models import CustomJSTicker, FixedTicker
    M = _s21_M
    kind, axis = M.getGlobal("S44_KIND"), M.getGlobal("S44_AXIS")
    tw = [float(v) for v in (M.getGlobal("S44_TW") or "").split()]
    if M.getGlobal("S44_RULE") == "model":
        lo, hi = float(M.getGlobal("S44_LO")), float(M.getGlobal("S44_HI"))
        u = dr._DASH_TS_UNITS[kind[3:] if kind.startswith("su:") else kind]
        want = dr._dash_tsnatscale_ticks(lo, hi, 5, u) or []
    else:
        want = tw
    msgs, got_all = [], {}
    for mode, reader, path in (("saved", _s21_doc_of_page, M.getGlobal("S44_PAGE")),
                               ("served", _s21_doc_of_app, M.getGlobal("S44_APP"))):
        doc = reader(path)
        if doc is None:
            msgs.append(mode + ": no document")
            continue
        _s21_M.setGlobal("S21_MOVE", M.getGlobal("S44_MOVE") or "")
        if M.getGlobal("S44_MOVE") and not _s21_move(doc, mode):
            msgs.append(mode + ": the move did not fire")
            continue
        for k, f in enumerate([f for f in _s21_figs(doc) if f.renderers]):
            side = "above" if axis == "x2" else "below"
            name = "x2" if axis == "x2" else "default"
            axs = [a for a in getattr(f, side) if hasattr(a, "ticker")
                   and getattr(a, "x_range_name", "default") == name]
            t = axs[0].ticker if axs else None
            if isinstance(t, CustomJSTicker):
                t = (t.args or {}).get("base")
            got = (_s44_units(t.ticks, kind) if isinstance(t, FixedTicker)
                   else None)
            got_all[mode] = got
            if got != want:
                msgs.append("%s panel %d: %s, want %s" % (mode, k, got, want))
    M.setGlobal("S44_OK", "0" if msgs else "1")
    M.setGlobal("S44_GOT", " ".join("%g" % v for v in (got_all.get("saved") or [])))
    M.setGlobal("S44_MSG", "; ".join(msgs)[:240].replace('"', "'"))
end

capture program drop _s44_data
program define _s44_data
    version 19
    args which
    if "`which'" == "yearly" {
        clear
        quietly set obs 40
        quietly generate y = 1960 + _n
        format y %ty
        quietly generate val = mod(_n * 7, 23)
        exit
    }
    sysuse sp500, clear
    quietly generate w = wofd(date)
    format w %tw
    quietly generate m = mofd(date)
    format m %tm
    quietly generate q = qofd(date)
    format q %tq
    quietly generate h = hofd(date)
    format h %th
    quietly generate obs = _n
    quietly generate v = date
end

capture program drop _s44_case
program define _s44_case
    // _s44_case <id> <data> <var> <kind> <axis> <rule> `"<cmd>"' `"<if>"' [move]
    version 19
    args id data var kind axis rule cmd cond move
    _s44_data `data'
    capture graph drop _all
    capture dash clear
    capture noisily twoway `cmd' `cond'
    _w30_expect `id' "(_rc == 0)" "twoway rc `=_rc'"
    local a = cond("`axis'" == "x2", "xaxis2", "xaxis1")
    capture graph export "${S44_WORK}/`id'.svg", replace
    local n "`.Graph.`a'.major.dlg_tickpos.arrnels'"
    if "`n'" == "" | "`n'" == "." local n 0
    local tw ""
    forvalues i = 1/`n' {
        local tw "`tw' `.Graph.`a'.major.dlg_tickpos[`i']'"
    }
    capture erase "${S44_WORK}/`id'.svg"
    quietly summarize `var' `cond'
    global S44_LO = r(min)
    global S44_HI = r(max)
    global S44_TW "`tw'"
    global S44_KIND "`kind'"
    global S44_AXIS "`axis'"
    global S44_RULE "`rule'"
    global S44_MOVE "`move'"
    capture graph drop _all
    global S44_SEQ = ${S44_SEQ} + 1
    capture noisily dash `cmd', name(tn${S44_SEQ})
    _w30_expect `id' "(_rc == 0)" "dash rc `=_rc'"
    local f "${S44_WORK}/tn${S44_SEQ}"
    local filt ""
    if "`move'" != "" local filt "filter(v, type(range))"
    capture noisily dash build, saving("`f'.html") replace nobrowser `filt'
    _w30_expect `id' "(_rc == 0)" "saved build rc `=_rc'"
    capture noisily dash build, saving("`f'_app.py") server replace `filt'
    _w30_expect `id' "(_rc == 0)" "served build rc `=_rc'"
    global S44_PAGE "`f'.html"
    global S44_APP "`f'_app.py"
    python: import __main__; __main__._s44_check()
    display as text "`id' `cmd' `cond': twoway`tw'; dash ${S44_GOT}"
    _w30_expect `id' "(${S44_OK} == 1)" `"`cmd' `cond': ${S44_MSG}"'
    capture erase "`f'.html"
    capture erase "`f'_app.py"
    capture dash clear
end

* ==== S44 P1.3b: tsnatscale on %td-%ty default axes ====
local only : env WP30_ONLY
if inlist("`only'", "", "S44") & `: list posof "S44" in w30_run' {
    display as text "S44 start " c(current_date) " " c(current_time)
    global S44_WORK "`w30_work'/s44"
    capture mkdir "${S44_WORK}"
    global S44_SEQ 0
    // TN-01: line close date (sp500): twoway's quarterly ticks, both modes.
    _s44_case TN-01 sp500 date td x tw "line close date" ""
    _w30_done TN-01 "line close date: dash's saved and served x ticks are twoway's 01jan2001(quarterly)01jan2002"
    // TN-02: %tw-%ty default axes: dash's model over the data (A8).
    _s44_case TN-02 sp500 w tw x model "scatter close w" ""
    _s44_case TN-02 sp500 m tm x model "scatter close m" ""
    _s44_case TN-02 sp500 q tq x model "scatter close q" ""
    _s44_case TN-02 sp500 h th x model "scatter close h" ""
    _s44_case TN-02 yearly y ty x model "line val y" ""
    _w30_done TN-02 "%tw, %tm, %tq, %th and %ty default axes take dash's model over the data"
    // TN-03: a date beside a number, in Stata units: 01jan1960 ... 01jan2000.
    _s44_case TN-03 sp500 date su:td x tw "(scatter close date) (scatter close obs)" ""
    _w30_done TN-03 "a date beside a number is ticked as twoway ticks it, in Stata units"
    // TN-04: a second date axis takes the model over its layer's dates.
    _s44_case TN-04 sp500 date td x2 model "(line close date) (line volume date, xaxis(2))" ""
    _w30_done TN-04 "a second date axis takes dash's model"
    // TN-05: after a move to date <= 15100 the axis re-ticks over the kept
    // rows by the model (twoway's IF1 list is printed beside it).
    _s44_case TN-05 sp500 date td x model "line close date" "if date <= 15100" "range 14977 15100"
    _w30_done TN-05 "after a filter move the date axis re-ticks over the kept rows in both modes"
    capture rmdir "${S44_WORK}"
    macro drop S44_*
    display as text "S44 end " c(current_date) " " c(current_time)
}
* ==== end S44 ====

// _s45_glyphs html -- the drawn glyphs of a saved page's first figure, read
// from its document JSON (WP-30 P1.8b): S45_GLYPHS lists each visible
// renderer as name:points (Line, Scatter, VArea, VBar, Segment, Quad) in
// drawing order, and S45_MONO is 1 when every Line's x runs in order.
capture program drop _s45_glyphs
program define _s45_glyphs
    version 19
    args html
    global S45_HTML `"`html'"'
    python: __import__("sys").modules["_dash_s45"].glyphs()
end
python:
def _s45_glyphs():
    import json, re
    from sfi import Macro
    with open(Macro.getGlobal("S45_HTML"), encoding="utf-8") as fh:
        txt = fh.read()
    objs, fig = {}, None
    for m in re.finditer(r'<script type="application/json"[^>]*>(.*?)</script>', txt, re.S):
        stack = [json.loads(m.group(1))]
        while stack:
            o = stack.pop()
            if isinstance(o, dict):
                if "id" in o and "name" in o:
                    objs[o["id"]] = o
                    if fig is None and o["name"] == "Figure":
                        fig = o
                stack.extend(o.values())
            elif isinstance(o, list):
                stack.extend(o)
    def res(o):
        return objs.get(o.get("id"), o) if isinstance(o, dict) else o
    def col(cols, spec):
        f = spec.get("field") if isinstance(spec, dict) else None
        v = cols.get(f)
        if isinstance(v, dict) and v.get("type") == "ndarray":
            return int(v.get("shape", [0])[0]), None
        return (len(v), v) if isinstance(v, list) else (0, None)
    out, mono = [], 1
    keep = ("Line", "Scatter", "VArea", "VBar", "Segment", "Quad")
    for rr in (fig or {}).get("attributes", {}).get("renderers", []):
        r = res(rr).get("attributes", {})
        g = res(r.get("glyph", {}))
        if g.get("name") not in keep:
            continue
        ga = g.get("attributes", {})
        data = res(r.get("data_source", {})).get("attributes", {}).get("data", {})
        cols = dict(data.get("entries", [])) if isinstance(data, dict) else {}
        xk = "x" if "x" in ga else ("x0" if "x0" in ga else "left")
        n, xs = col(cols, ga.get(xk, {}))
        if n == 0:
            continue
        if g["name"] == "Line" and xs is not None:
            vals = [float(v) for v in xs if isinstance(v, (int, float))]
            if vals != sorted(vals):
                mono = 0
        out.append("%s:%d" % (g["name"], n))
    Macro.setGlobal("S45_GLYPHS", " ".join(out))
    Macro.setGlobal("S45_MONO", str(mono))
import sys as _s45_sys
_s45_sys.modules["_dash_s45"] = type(_s45_sys)("_dash_s45")
_s45_sys.modules["_dash_s45"].glyphs = _s45_glyphs
end

capture program drop _s45_data
program define _s45_data
    version 19
    clear
    quietly set obs 8
    quietly generate double x = _n
    quietly generate double y = .
    local ys  3 5 2 6 4 7 1 8
    forvalues i = 1/8 {
        quietly replace y = `: word `i' of `ys'' in `i'
    }
    quietly generate double y2 = y + 3
    quietly generate double t  = 9 - _n
    quietly tsset t
end

* ==== S45 P1.8b: recast() ====
local only : env WP30_ONLY
if inlist("`only'", "", "S45") & `: list posof "S45" in w30_run' {
    display as text "S45 start " c(current_date) " " c(current_time)
    local s45log "`w30_work'/s45.log"
    local s45pg "`w30_work'/zrc.html"
    // RC-20: base recasts draw the target (recast_truth.json W-sc-line,
    // W-rl-line, W-ts-conn: equal to twoway's line y x, one path, and
    // connected y t, sort).
    foreach row in "scatter y x, recast(line)|Line:8" "rline y y2 x, recast(line)|Line:8" ///
                   "tsline y, recast(connected)|Line:8 Scatter:8" {
        gettoken c want : row, parse("|")
        local want = substr("`want'", 2, .)
        _s45_data
        _s36_run `"dash `c' saving("`s45pg'", replace)"' "`s45log'"
        local drc = r(rc)
        global S45_GLYPHS ""
        global S45_MONO 0
        if !`drc' capture _s45_glyphs "`s45pg'"
        _w30_expect RC-20 `"(`drc' == 0 & "${S45_GLYPHS}" == "`want'" & ${S45_MONO} == 1)"' `"`c': rc `drc', ${S45_GLYPHS} (want `want')"'
    }
    _w30_done RC-20 "scatter, rline and tsline recasts draw twoway's target"
    // RC-21: derived recasts keep their points, drawn as the target
    // (D-kdensity-area one filled path; D-lfit-scatter 3 markers;
    // D-histogram-line one path; D-function-scatter 300 markers).
    foreach row in "kdensity mpg, recast(area)|VArea" "lfit mpg weight, recast(scatter)|Scatter:3" ///
                   "histogram mpg, recast(line)|Line" "function y=x^2, range(0 3) recast(scatter)|Scatter:300" {
        gettoken c want : row, parse("|")
        local want = substr("`want'", 2, .)
        quietly sysuse auto, clear
        _s36_run `"dash `c' saving("`s45pg'", replace)"' "`s45log'"
        local drc = r(rc)
        global S45_GLYPHS ""
        if !`drc' capture _s45_glyphs "`s45pg'"
        local got "${S45_GLYPHS}"
        if !strpos("`want'", ":") local got = substr("`got'", 1, strpos("`got'", ":") - 1)
        _w30_expect RC-21 `"(`drc' == 0 & "`got'" == "`want'")"' `"`c': rc `drc', ${S45_GLYPHS} (want `want')"'
    }
    _w30_done RC-21 "kdensity, lfit, histogram and function recasts draw twoway's target"
    // RC-22: the fallbacks print twoway's notes and draw the fallback
    // (FB-line = scatter y x, FB-rline = rspike y y2 x, FB-func = its line).
    foreach row in "line y x, recast(rline)|Scatter:8|yxtype" "rline y y2 x, recast(pcspike)|Segment:8|y2xtype" ///
                   "function y=x, range(1 5) recast(rline)|Line|functiontype" {
        gettoken c row : row, parse("|")
        gettoken _p row : row, parse("|")
        gettoken want row : row, parse("|")
        local cls = substr("`row'", 2, .)
        _s45_data
        _s36_run `"dash `c' saving("`s45pg'", replace)"' "`s45log'"
        local drc = r(rc)
        _s36_count "`s45log'" "(note:  `cls' not found in scheme, default attributes used)"
        local nn = r(n)
        global S45_GLYPHS ""
        if !`drc' capture _s45_glyphs "`s45pg'"
        local got "${S45_GLYPHS}"
        if !strpos("`want'", ":") local got = substr("`got'", 1, strpos("`got'", ":") - 1)
        _w30_expect RC-22 `"(`drc' == 0 & `nn' == 1 & "`got'" == "`want'")"' `"`c': rc `drc', notes `nn', ${S45_GLYPHS} (want `want')"'
    }
    _w30_done RC-22 "out-of-class recasts print twoway's notes and draw the fallback"
    capture dash clear
    capture erase "`s45log'"
    capture erase "`s45pg'"
    macro drop S45_*
    display as text "S45 end " c(current_date) " " c(current_time)
}
* ==== end S45 ====

