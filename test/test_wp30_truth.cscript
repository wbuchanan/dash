// _s47_check probe html -- the saved page's first figure against
// test/fixtures/margin_truth.json's probe (WP-30 P1.20b): each side's
// margin, as a share of min(W, H) measured from twoway's own scale ends
// (curmin, curmax), within 0.0005 of twoway's margin_rel; for a probe
// with an inner rect, the page's dash_inner_box at its edges (0.2% of the
// span) with its fill and outline.  Globals S47_OK (1/0) and S47_MSG.
capture program drop _s47_check
program define _s47_check
    version 19
    args probe html
    global S47_PROBE `"`probe'"'
    global S47_HTML `"`html'"'
    python: __import__("sys").modules["_dash_s47"].check()
end
python:
def _s47_check():
    import json, math, os, re
    from sfi import Macro
    probe, html = Macro.getGlobal("S47_PROBE"), Macro.getGlobal("S47_HTML")
    fx = os.path.join(Macro.getGlobal("S47_REPO"), "test", "fixtures",
                      "margin_truth.json")
    with open(fx, encoding="utf-8") as fh:
        row = json.load(fh)["probes"][probe]
    with open(html, encoding="utf-8") as fh:
        txt = fh.read()
    objs, figs = {}, []
    def walk(o):
        if isinstance(o, dict):
            if "id" in o and "attributes" in o:
                objs[o["id"]] = o
                if o.get("name") == "Figure":
                    figs.append(o)
            for v in o.values():
                walk(v)
        elif isinstance(o, list):
            for v in o:
                walk(v)
    for m in re.finditer(r'<script type="application/json"[^>]*>(.*?)</script>', txt, re.S):
        walk(json.loads(m.group(1)))
    def ref(o):
        return objs.get(o.get("id"), o) if isinstance(o, dict) else o
    bad = []
    fig = figs[0]["attributes"] if figs else {}
    for letter, ext in (("x", 5.5), ("y", 4.0)):
        want = (row.get(letter) or {}).get("margin_rel")
        rng = ref(fig.get(letter + "_range")) or {}
        at = rng.get("attributes", {})
        if not want or "start" not in at:
            continue
        s, e = float(at["start"]), float(at["end"])
        lo, hi = row[letter]["cur"]
        tr = math.log10 if probe == "LOG" and letter == "y" else float
        s, e, lo, hi = tr(s), tr(e), tr(lo), tr(hi)
        span = abs(e - s)
        if s <= e:
            got = ((lo - s) / span, (e - hi) / span)
        else:
            got = ((s - hi) / span, (lo - e) / span)
        got = [g * ext / 4.0 for g in got]
        if abs(got[0] - want["lo"]) > 5e-4 or abs(got[1] - want["hi"]) > 5e-4:
            bad.append("%s %s %.4f/%.4f twoway %.4f/%.4f" % (
                probe, letter, got[0], got[1], want["lo"], want["hi"]))
    rects = row.get("inner")
    if rects is not None:
        boxes = [ref(o) for o in objs.values() if o.get("name") == "BoxAnnotation"
                 and "dash_inner_box" in (o["attributes"].get("tags") or [])]
        if len(boxes) != 1:
            bad.append("%s boxes %d" % (probe, len(boxes)))
        else:
            b = boxes[0]["attributes"]
            fill = [r for r in rects if r["fill"] not in (None, "none")]
            line = [r for r in rects if r["stroke"] not in (None, "none")]
            d = (fill or line)[0]["data"]
            for k, span in (("left", 3240.0), ("right", 3240.0),
                            ("bottom", 31.0), ("top", 31.0)):
                if abs(float(b.get(k, 0.0)) - d[k]) > 0.002 * span:
                    bad.append("%s %s %r twoway %.1f" % (probe, k, b.get(k), d[k]))
            if fill and str(b.get("fill_color", "")).lower() != fill[0]["fill"]:
                bad.append("%s fill %r" % (probe, b.get("fill_color")))
            if line and str(b.get("line_color", "")).lower() != line[0]["stroke"]:
                bad.append("%s line %r" % (probe, b.get("line_color")))
    Macro.setGlobal("S47_OK", "0" if bad else "1")
    Macro.setGlobal("S47_MSG", "; ".join(bad)[:400] or "ok")
# A Stata program's python: line sees only modules, not these names.
import sys as _s47_sys
_s47_sys.modules["_dash_s47"] = type(_s47_sys)("_dash_s47")
_s47_sys.modules["_dash_s47"].check = _s47_check
end

* ==== S47 P1.20b: Plot-region margin and inner box ====
local only : env WP30_ONLY
if inlist("`only'", "", "S47") & `: list posof "S47" in w30_run' {
    display as text "S47 start " c(current_date) " " c(current_time)
    global S47_REPO "`c(pwd)'/.."
    local s47log "`w30_work'/s47.log"
    local s47pg "`w30_work'/zrm.html"
    local s47ls = c(linesize)
    set linesize 255
    quietly sysuse auto, clear
    // RM-20..RM-23: each probe of margin_truth.json drawn by dash, saved.
    foreach row in ///
        `"RM-20|ZERO|scatter mpg weight, plotregion(margin(zero))"' ///
        `"RM-20|L10|scatter mpg weight, plotregion(margin(l+10))"' ///
        `"RM-20|COPY|scatter mpg weight, plotregion(margin(zero)) plotregion(margin(l+10))"' ///
        `"RM-20|Q4|scatter mpg weight, plotregion(margin(1 2 3 4))"' ///
        `"RM-21|REV|scatter mpg weight, xscale(reverse) plotregion(margin(l+10))"' ///
        `"RM-21|LOG|scatter mpg weight, yscale(log) plotregion(margin(b+10))"' ///
        `"RM-21|Y2|(scatter mpg weight) (scatter price weight, yaxis(2)), plotregion(margin(t+10))"' ///
        `"RM-23|I1|scatter mpg weight, plotregion(ifcolor(red))"' ///
        `"RM-23|I7|scatter mpg weight, plotregion(ifc(red) ilc(blue))"' {
        gettoken id rest : row, parse("|")
        gettoken bar rest : rest, parse("|")
        gettoken pid rest : rest, parse("|")
        gettoken bar cmd : rest, parse("|")
        _s36_run `"dash `cmd' scheme(s2color) saving("`s47pg'", replace)"' "`s47log'"
        local drc = r(rc)
        capture _s47_check "`pid'" "`s47pg'"
        local prc = _rc
        _w30_expect `id' "(`drc' == 0 & `prc' == 0 & ${S47_OK} == 1)" "`pid': rc `drc'/`prc', ${S47_MSG}"
        _w30_done `id' "`pid': margins per side (and the inner box) as twoway draws them"
    }
    // RM-22: by() scales a user margin as the default (H-47.1).
    _s36_run `"dash scatter mpg weight, by(foreign) plotregion(margin(b+10)) scheme(s2color) saving("`s47pg'", replace)"' "`s47log'"
    local drc = r(rc)
    python: from sfi import Macro; import dash_render as _d47; _m47 = _d47._dash_plot_margin(_d47.SchemeParser("s2color"), {"plotregion": "margin(b+10)"}, panels=2)["y"]; Macro.setGlobal("S47_B", "%.6f" % _m47[0])
    local ok = (`drc' == 0 & abs(${S47_B} - 0.1037) < 0.0005)
    _w30_expect RM-22 "(`ok')" "rc `drc', bottom ${S47_B} (twoway 0.1037)"
    _w30_done RM-22 "by(foreign) plotregion(margin(b+10)) is (2.2 + 10)% x .85, as twoway draws it"
    // RM-01 (notes): an unknown margin is twoway's note, once, drawn zero.
    _s36_run `"dash scatter mpg weight, by(foreign) plotregion(margin(bogus)) scheme(s2color) saving("`s47pg'", replace)"' "`s47log'"
    local drc = r(rc)
    _s36_count "`s47log'" "named style bogus not found in class margin, default attributes used"
    local nn = r(n)
    _w30_expect RM-25 "(`drc' == 0 & `nn' == 1)" "rc `drc', notes `nn'"
    _w30_done RM-25 "plotregion(margin(bogus)) prints twoway's note once"
    capture dash clear
    capture erase "`s47log'"
    capture erase "`s47pg'"
    macro drop S47_*
    set linesize `s47ls'
    display as text "S47 end " c(current_date) " " c(current_time)
}
* ==== end S47 ====

// _s48_check kind svg html [svg0 html0] -- a by() grid drawn by dash
// against twoway's in the same run (WP-30 P1.15b).  kind "cells": each
// panel's (row, col), counted over the rows and columns that hold a panel,
// from twoway's SVG label texts and from the page's panel grid; kind
// "size": the panel's marker-label font over the plain graph's (svg0,
// html0), within 1% of twoway's.  Globals S48_OK (1/0) and S48_MSG.
capture program drop _s48_check
program define _s48_check
    version 19
    args kind svg html svg0 html0
    global S48_ARGS `"`kind'|`svg'|`html'|`svg0'|`html0'"'
    python: __import__("sys").modules["_dash_s48"].check()
end
python:
def _s48_check():
    import json, html as _h, os, re, sys, warnings
    from sfi import Macro
    kind, svg, page, svg0, page0 = Macro.getGlobal("S48_ARGS").split("|")
    sys.path.insert(0, os.path.join(Macro.getGlobal("S48_REPO"), "scripts"))
    import svg_truth

    def doc_of(path):
        from bokeh.document import Document
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
        for blob in re.findall('<script type="application/json"[^>]*>(.*?)</script>', text, re.S):
            try:
                d = json.loads(_h.unescape(blob))
            except ValueError:
                continue
            if isinstance(d, dict) and d:
                with warnings.catch_warnings():
                    warnings.simplefilter("ignore")
                    return Document.from_json(list(d.values())[0])
        return None

    def label_of(fig):
        for m in list(fig.above) + list(fig.below):
            if type(m).__name__ == "Title" and m.name == "dash_by_label":
                return str(m.text)
        return None

    def dash_panels(path):
        from bokeh.models import GridPlot
        doc = doc_of(path)
        out = []
        for root in doc.roots:
            for g in root.references():
                if isinstance(g, GridPlot):
                    for ch in g.children:
                        lab = label_of(ch[0]) if type(ch[0]).__name__ == "figure" else None
                        if lab is not None:
                            out.append((lab, int(ch[1]), int(ch[2]), ch[0]))
        return out

    def rebased(cells):
        r0 = min(c[1] for c in cells)
        c0 = min(c[2] for c in cells)
        return sorted((c[0], c[1] - r0, c[2] - c0) for c in cells)

    bad = []
    if kind == "cells":
        panels = dash_panels(page)
        labels = [p[0] for p in panels]
        d = svg_truth.svg_document(svg)
        found = {}
        for lab in labels:
            hits = [t for t in d["texts"] if t["text"] == lab]
            if hits:
                h = max(hits, key=lambda t: (t["size"] or 0, -t["y"]))
                found[lab] = (h["x"], h["y"])

        def pitch(vals):
            vals = sorted(set(round(v, 1) for v in vals))
            diffs = [b - a for a, b in zip(vals, vals[1:])]
            return min(diffs) if diffs else 1e9
        px = pitch([v[0] for v in found.values()])
        py = pitch([v[1] for v in found.values()])
        tw = [(lab, int(round(y, 1) // py), int(round(x, 1) // px))
              for lab, (x, y) in found.items()]
        dc = rebased([(p[0], p[1], p[2]) for p in panels])
        if len(found) != len(labels) or not tw or rebased(tw) != dc:
            bad.append("twoway %s, dash %s" % (rebased(tw) if tw else [], dc))
    else:
        def mlab(path):
            from bokeh.models import LabelSet
            doc = doc_of(path)
            for root in doc.roots:
                for m in root.references():
                    if isinstance(m, LabelSet):
                        v = m.text_font_size
                        v = v.get("value") if isinstance(v, dict) else v
                        v = getattr(v, "value", v)
                        hit = re.search(r"[0-9]*\.?[0-9]+", str(v))
                        return float(hit.group(0)) if hit else None
            return None

        def tmin(path):
            d = svg_truth.svg_document(path)
            return min(t["size"] for t in d["texts"] if t["text"]
                       and re.match(r"^[0-9.,]+$", t["text"]) and t["size"])
        tw = tmin(svg) / tmin(svg0)
        a, b = mlab(page), mlab(page0)
        dr = (a / b) if a and b else None
        if dr is None or abs(dr - tw) > 0.01 * tw:
            bad.append("twoway %.4f, dash %s" % (tw, dr))
    Macro.setGlobal("S48_OK", "0" if bad else "1")
    Macro.setGlobal("S48_MSG", "; ".join(bad)[:400] or "ok")
# A Stata program's python: line sees only modules, not these names.
import sys as _s48_sys
_s48_sys.modules["_dash_s48"] = type(_s48_sys)("_dash_s48")
_s48_sys.modules["_dash_s48"].check = _s48_check
