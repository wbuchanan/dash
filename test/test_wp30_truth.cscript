*! test_wp30_truth.cscript
*! WP-30's ONE new certification script (.ultraplan/wp30/index.md A142):
*! every comparison with twoway's drawing or with Stata's own values that
*! WP-30's sections need lives here, one block per section, in section
*! order, so the certification suite grows by one script.  Refusal,
*! message and return-code checks join the EXISTING script for their area
*! instead (index.md merge rule R1); this script never gains one of those.
*!
*! S01 is the scaffold smoke (TF-01).  S02-S57 each own the block their
*! header names, a stub until that section fills it with its own cases
*! (its case-id prefix: index.md "Section manifest").  A section writes
*! only inside its own block, its helper programs directly above its own
*! header, and a second block of its own directly below its own end line.
*!
*! Usage: via run_all_cscripts.do (registered as its block 69).  One
*! block alone: set WP30_ONLY=S<NN> in the environment of the driver run
*! (index.md "The cscript driver"); a block with no case yet then ends
*! "no case ran" and r(9).  Each block prints "S<NN> start" and
*! "S<NN> end" with the date and time, so the closeout can time it.
*!
*! Blocks filled so far (case ids):
*!   S07  P1.25a the six StataCorp schemes against twoway (SX-01..SX-08)

cscript "WP-30 truth: twoway comparisons" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off

if `"`c(python_exec)'"' == "" {
    display as error "SKIP: Python not available."
    exit 222
}

do "cert_helpers.do"
quietly do "cert_svg.do"
qui do "../dash_parse.mata"
qui do "../dash.ado"
global dash_nobrowser 1

// ----------------------------------------------------------------
// Tally helpers -- test_wp29_truth.cscript's _w29_expect/_w29_done,
// renamed _w30_ for this script.  A case is any number of
// _w30_expect lines closed by one _w30_done.
// ----------------------------------------------------------------
global w30_nfail    = 0
global w30_faillist ""
global w30_bad      = 0
global w30_ncase    = 0

capture program drop _w30_expect
program define _w30_expect
    version 19
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global w30_bad = 1
    }
end

capture program drop _w30_done
program define _w30_done
    version 19
    args id msg
    if ${w30_bad} {
        global w30_nfail    = ${w30_nfail} + 1
        global w30_faillist "${w30_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global w30_bad   = 0
    global w30_ncase = ${w30_ncase} + 1
end

// A fresh directory for this run's files, never one that already exists:
// a fixed name in a shared temp directory could be planted by another
// account (rule 1), so a name Stata has not handed out before is made and
// the run fails if it cannot be.  Every block writes only under it.
tempfile w30_base
local w30_work "`w30_base'_w30"
capture mkdir "`w30_work'"
if _rc {
    display as error "test_wp30_truth: cannot create the work directory `w30_work' (rc `=_rc')"
    exit 9
}

* ==== S01 scaffold: the helpers load and a twoway SVG is read ====
local only : env WP30_ONLY
if inlist("`only'", "", "S01") {
    display as text "S01 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // TF-01: cert_svg_export and cert_svg_texts on one twoway scatter,
    // and dash's own programs are loaded from this tree.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(w30s01, replace)
    cert_svg_export, name(w30s01) file("`w30_work'/w30s01.svg")
    local s01_rc   = r(rc)
    local s01_file "`r(file)'"
    _w30_expect TF-01 "(`s01_rc' == 0)" "cert_svg_export rc `s01_rc'"
    capture confirm file "`s01_file'"
    _w30_expect TF-01 "(_rc == 0)" "r(file) `s01_file' does not exist"
    cert_svg_texts, file("`s01_file'")
    local s01_n    = r(n)
    local s01_list "`r(list)'"
    _w30_expect TF-01 "(`s01_n' > 0)" "cert_svg_texts found no text elements"
    capture program list _dash_serve
    _w30_expect TF-01 "(_rc == 0)" "dash.ado's _dash_serve is not loaded"
    _w30_done TF-01 "a twoway SVG was written and read (`s01_n' texts); dash is loaded"

    capture erase "`s01_file'"
    capture erase "`s01_list'"
    capture graph drop w30s01
    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====

// ----------------------------------------------------------------
// S02 helpers (WP-30 P1.34): the runner's root block, read from
// run_all_cscripts.do between its markers and run as a do-file.
// ----------------------------------------------------------------
capture mata: mata drop _s02_root_lines()
capture mata: mata drop _s02_trim()
mata:
// Copies the lines strictly between "// ---- root: begin" and
// "// ---- root: end" of src to dst; returns their count (0 when either
// marker is missing, and then nothing is written).
real scalar _s02_root_lines(string scalar src, string scalar dst)
{
    string colvector L
    real scalar i, b, e, fh
    L = cat(src)
    b = 0
    e = 0
    for (i = 1; i <= rows(L); i++) {
        if (b == 0 & strpos(L[i], "// ---- root: begin") == 1) b = i
        else if (b > 0 & e == 0 & strpos(L[i], "// ---- root: end") == 1) e = i
    }
    if (b == 0 | e <= b + 1) return(0)
    fh = fopen(dst, "w")
    for (i = b + 1; i < e; i++) fput(fh, L[i])
    fclose(fh)
    return(e - b - 1)
}
// s without its trailing slashes (one character kept).
string scalar _s02_trim(string scalar s)
{
    while (strlen(s) > 1 & substr(s, -1, 1) == "/") s = substr(s, 1, strlen(s) - 1)
    return(s)
}
end

capture program drop _s02_realdir
program define _s02_realdir, rclass
    version 19
    args dir
    local here `"`c(pwd)'"'
    quietly cd `"`dir'"'
    return local dir `"`c(pwd)'"'
    quietly cd `"`here'"'
end

capture program drop _s02_run_root
program define _s02_run_root, rclass
    version 19
    args block cwd
    local ado0 `"$S_ADO"'
    local pwd0 `"`c(pwd)'"'
    if `"`cwd'"' != "" quietly cd `"`cwd'"'
    // quietly: a refused root's error and r() lines stay out of the log;
    // the rc is what each case checks.
    capture quietly do `"`block'"'
    local rc = _rc
    local pwd `"`c(pwd)'"'
    local fn ""
    if `rc' == 0 {
        capture quietly findfile dash.ado
        if _rc == 0 local fn `"`r(fn)'"'
    }
    global S_ADO `"`macval(ado0)'"'
    quietly cd `"`pwd0'"'
    return scalar rc = `rc'
    return local pwd `"`pwd'"'
    return local fn `"`fn'"'
end

// One RR case: the root block run with DASH_REPO as the caller set it,
// from cwd; rc must be wrc and, when want is given, the run must have
// cd'd to want and found want/dash.ado.  ok is RR-01's flag: without the
// block, the case fails without running.
capture program drop _s02_case
program define _s02_case
    version 19
    args id ok blk cwd wrc want msg
    _w30_expect `id' "`ok'" "RR-01 failed, so the root block was not run"
    if `ok' {
        _s02_run_root `"`blk'"' `"`cwd'"'
        local rc = r(rc)
        local pwd `"`r(pwd)'"'
        local fn `"`r(fn)'"'
        _w30_expect `id' "`rc' == `wrc'" "rc `rc', expected `wrc'"
        if `"`want'"' != "" {
            local same = (`"`pwd'"' == `"`want'"')
            _w30_expect `id' "`same'" "r(pwd) is `pwd', expected `want'"
            local same = (`"`fn'"' == `"`want'/dash.ado"')
            _w30_expect `id' "`same'" "dash.ado resolves to `fn', expected `want'/dash.ado"
        }
    }
    _w30_done `id' `"`msg'"'
end

* ==== S02 P1.34: Portable runners ====
local only : env WP30_ONLY
if inlist("`only'", "", "S02") {
    display as text "S02 start " c(current_date) " " c(current_time)
    local s02_env0 : environment DASH_REPO

    // tree: the directory the driver cd'd to, less its /test.
    local s02_here `"`c(pwd)'"'
    local s02_intest = (substr(`"`s02_here'"', -5, 5) == "/test")
    local s02_tree = substr(`"`s02_here'"', 1, strlen(`"`s02_here'"') - 5)

    // scr: two trees of the RR cases, under this run's own directory.
    local s02_scr "`w30_work'/s02_rr"
    capture mkdir "`s02_scr'"
    capture mkdir "`s02_scr'/notree"
    capture mkdir "`s02_scr'/my tree"
    capture mkdir "`s02_scr'/my tree/test"
    tempname s02_fh
    file open `s02_fh' using "`s02_scr'/my tree/dash.ado", write text replace
    file close `s02_fh'
    file open `s02_fh' using "`s02_scr'/my tree/test/run_all_cscripts.do", write text replace
    file close `s02_fh'
    _s02_realdir "`s02_scr'"
    local s02_scr `"`r(dir)'"'

    // ------------------------------------------------------------
    // RR-01: the runner's root block is there, reads DASH_REPO and
    // names no home directory; the paths this block hands it are clean.
    // ------------------------------------------------------------
    local s02_blk "`w30_work'/s02_root.do"
    mata: st_local("s02_n", strofreal(_s02_root_lines("run_all_cscripts.do", st_local("s02_blk"))))
    local s02_hasenv 0
    local s02_home 0
    if `s02_n' > 0 {
        mata: st_local("s02_hasenv", strofreal(strpos(invtokens(cat(st_local("s02_blk"))', char(10)), ": environment DASH_REPO") > 0))
        mata: st_local("s02_home", strofreal(strpos(invtokens(cat(st_local("s02_blk"))', char(10)), "/" + "Users/") + strpos(invtokens(cat(st_local("s02_blk"))', char(10)), "/" + "home/") > 0))
    }
    mata: st_local("s02_badpath", strofreal(any(strpos(st_local("s02_tree") + c("tmpdir") + st_local("s02_scr"), (char(34), char(36), char(39), char(96), char(10), char(13))))))
    _w30_expect RR-01 "`s02_n' >= 10" "the root block between run_all_cscripts.do's markers has `s02_n' lines"
    _w30_expect RR-01 "`s02_hasenv'" "the root block does not read : environment DASH_REPO"
    _w30_expect RR-01 "!`s02_home'" "the root block names a home directory"
    _w30_expect RR-01 "!`s02_badpath'" "the tree, c(tmpdir) or the scratch directory holds a quote, dollar sign, backtick or line break"
    _w30_done RR-01 "the runner's root block was read (`s02_n' lines)"
    local s02_ok = (`s02_n' >= 10) & `s02_hasenv' & !`s02_home' & !`s02_badpath'

    // ------------------------------------------------------------
    // RR-02: the run tests the tree it was handed.
    // ------------------------------------------------------------
    mata: st_local("s02_named", strofreal(_s02_trim(st_local("s02_env0")) == "" | _s02_trim(st_local("s02_env0")) == st_local("s02_tree")))
    _w30_expect RR-02 "`s02_intest'" "the driver did not cd to <tree>/test (c(pwd) is `s02_here')"
    _w30_expect RR-02 "`s02_named'" "DASH_REPO does not name the tree under test, `s02_tree'"
    _w30_done RR-02 "the run tests the tree it was handed, `s02_tree'"

    // ------------------------------------------------------------
    // RR-03..RR-14: the root block under each DASH_REPO and directory.
    // ------------------------------------------------------------
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_tree")
    _s02_case RR-03 `s02_ok' "`s02_blk'" "" 0 "`s02_tree'" "DASH_REPO=<tree> from test/: the tree is tested"
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_tree") + "/"
    _s02_case RR-04 `s02_ok' "`s02_blk'" "" 0 "`s02_tree'" "DASH_REPO=<tree>/ from test/: the trailing slash is dropped"
    python: import os; os.environ.pop("DASH_REPO", None)
    _s02_case RR-05 `s02_ok' "`s02_blk'" "`s02_tree'" 0 "`s02_tree'" "DASH_REPO unset from <tree>: the current directory is tested"
    _s02_case RR-06 `s02_ok' "`s02_blk'" "`s02_scr'/notree" 601 "" "DASH_REPO unset from a directory that is no dash tree: r(601)"
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_scr") + "/co" + chr(36) + "py"
    _s02_case RR-07 `s02_ok' "`s02_blk'" "" 198 "" "a dollar sign in DASH_REPO: r(198)"
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_scr") + "/co" + chr(96) + "py"
    _s02_case RR-08 `s02_ok' "`s02_blk'" "" 198 "" "a backtick in DASH_REPO: r(198)"
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_scr") + "/co" + chr(34) + "py"
    _s02_case RR-09 `s02_ok' "`s02_blk'" "" 198 "" "a double quote in DASH_REPO: r(198)"
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_scr") + "/co" + chr(39) + "py"
    _s02_case RR-10 `s02_ok' "`s02_blk'" "" 198 "" "a single quote in DASH_REPO: r(198)"
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_scr") + "/co" + chr(10) + "py"
    _s02_case RR-11 `s02_ok' "`s02_blk'" "" 198 "" "a line feed in DASH_REPO: r(198)"
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_scr") + "/co" + chr(13) + "py"
    _s02_case RR-12 `s02_ok' "`s02_blk'" "" 198 "" "a carriage return in DASH_REPO: r(198)"
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_scr") + "/notree"
    _s02_case RR-13 `s02_ok' "`s02_blk'" "" 601 "" "DASH_REPO naming a directory that is no dash tree: r(601)"
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_scr") + "/my tree"
    _s02_case RR-14 `s02_ok' "`s02_blk'" "" 0 "`s02_scr'/my tree" "DASH_REPO naming a tree with a space: that tree is tested"

    capture erase "`s02_scr'/my tree/test/run_all_cscripts.do"
    capture erase "`s02_scr'/my tree/dash.ado"
    capture rmdir "`s02_scr'/my tree/test"
    capture rmdir "`s02_scr'/my tree"
    capture rmdir "`s02_scr'/notree"
    capture rmdir "`s02_scr'"
    capture erase "`s02_blk'"
    python: import os; from sfi import Macro; v = Macro.getLocal("s02_env0"); os.environ.pop("DASH_REPO", None) if v == "" else os.environ.__setitem__("DASH_REPO", v)
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

// S03 helper: a program at a version no Stata runs.  It is stored and never
// runs: SF-01 measures the code Stata gives when it is called.  Its
// `version 99' is the measurement, so it is the one helper of this script
// that does not declare version 19.
capture program drop _s03_future
program define _s03_future
    version 99
end

* ==== S03 P1.35: Stata 19 floor declared and enforced ====
local only : env WP30_ONLY
if inlist("`only'", "", "S03") {
    display as text "S03 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // SF-01: Stata's own return code for a version it cannot run.
    // dash's refusal uses the same code (test_env_guards.cscript
    // ENV-25, ENV-28, ENV-29).
    // ------------------------------------------------------------
    capture _s03_future
    local sf01 = _rc
    _w30_expect SF-01 "(`sf01' == 9)" "a program at version 99 gave rc `sf01', not 9"
    _w30_done SF-01 "Stata refuses a version it cannot run with rc `sf01', the code dash's floor uses"

    // ------------------------------------------------------------
    // SF-02: with no caller version recorded, _dash_fn_points falls back
    // to dash's own level, now 19; the points are those of a caller at 16.
    // ------------------------------------------------------------
    sysuse auto, clear
    capture program list _dash_fn_points
    local sf02ld = _rc
    _w30_expect SF-02 "(`sf02ld' == 0)" "dash.ado is not loaded by do"
    if `sf02ld' == 0 {
        tempname sf02r sf02a sf02b
        foreach e in "y = runiform()" "y = normalden(x)" {
            mata: st_strscalar(st_local("sf02r"), st_local("e"))
            mata: st_strscalar(st_local("sf02a"), "")
            mata: st_strscalar(st_local("sf02b"), "")
            set seed 20261003
            global dash__uv 16
            capture noisily _dash_fn_points `sf02r' -2 2 5 1 `sf02a'
            local sf02rca = _rc
            set seed 20261003
            macro drop dash__uv
            capture noisily _dash_fn_points `sf02r' -2 2 5 1 `sf02b'
            local sf02rcb = _rc
            local sf02cv "`._Gr_Global.callerver'"
            local sf02cvok = ("`sf02cv'" == "19")
            mata: st_local("sf02same", strofreal(st_strscalar(st_local("sf02a")) == st_strscalar(st_local("sf02b"))))
            _w30_expect SF-02 "(`sf02rca' == 0 & `sf02rcb' == 0)" "`e': rc `sf02rca' at 16, rc `sf02rcb' at the fallback"
            _w30_expect SF-02 "(`sf02same' == 1)" "`e': the points at 16 and at the fallback differ"
            _w30_expect SF-02 "(`sf02cvok' == 1)" "`e': the fallback's callerver is `sf02cv', not 19"
        }
    }
    _w30_done SF-02 "the callerver fallback reads 19 and the points equal a version 16 caller's, seeded runiform() and normalden(x)"

    // ------------------------------------------------------------
    // SF-03: a caller at version 16 keeps its own version (guard).
    // ------------------------------------------------------------
    capture dash clear
    capture noisily version 16: dash function y = normalden(x), range(-2 2) n(5) name(sf03)
    local sf03rc = _rc
    local sf03cv "`._Gr_Global.callerver'"
    local sf03cvok = ("`sf03cv'" == "16")
    mata: st_local("sf03pts", strofreal(strpos(st_global("dash_fpts_sf03"), "0.053990966513188049,0.24197072451914334,0.39894228040143265") > 0))
    _w30_expect SF-03 "(`sf03rc' == 0)" "version 16: dash function gave rc `sf03rc'"
    _w30_expect SF-03 "(`sf03cvok' == 1)" "the function layer ran at callerver `sf03cv', not 16"
    _w30_expect SF-03 "(`sf03pts' == 1)" "the normalden points were not the measured ones"
    _w30_done SF-03 "a version 16 caller's function layer is evaluated at 16, with the measured points"
    capture dash clear

    // ------------------------------------------------------------
    // SF-04: the certifying Stata is at or above the floor, and dash's
    // guard and comparator say so.
    // ------------------------------------------------------------
    local sf04v = (c(stata_version) >= 19)
    capture noisily _dash_require_stata
    local sf04g = _rc
    capture _dash_stata_ok "`c(stata_version)'" "19"
    local sf04c = _rc
    local sf04ok = r(ok)
    if `sf04c' != 0 local sf04ok = .
    _w30_expect SF-04 "(`sf04v' == 1)" "this Stata, `c(stata_version)', is below the floor"
    _w30_expect SF-04 "(`sf04g' == 0)" "_dash_require_stata gave rc `sf04g'"
    _w30_expect SF-04 "(`sf04c' == 0)" "_dash_stata_ok gave rc `sf04c'"
    _w30_expect SF-04 "(`sf04ok' == 1)" "_dash_stata_ok answered `sf04ok' for this Stata"
    display as text "SF-04: certified on Stata `c(stata_version)' `c(edition_real)'"
    _w30_done SF-04 "the certifying Stata is at or above the floor and dash's guard passes it"

    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

// S04's helper: twoway's recorded saving() result for one character, from
// test/fixtures/saving_chars_truth.json (scripts/extract_saving_chars_truth.do),
// into the globals CSP_RC, CSP_W and CSP_STEM.  Read relative to the
// working directory, test/.  S12 reads the same fixture.
python:
import json as _csp_json
def _csp_truth(key):
    from sfi import Macro
    with open("fixtures/saving_chars_truth.json", encoding="utf-8") as fh:
        rec = _csp_json.load(fh)["probes"][key]
    f = rec["file"]
    Macro.setGlobal("CSP_RC", str(int(rec["rc"])))
    Macro.setGlobal("CSP_W", "1" if rec["written"] else "0")
    Macro.setGlobal("CSP_STEM", f[len("tw_"):-len(".gph")])
end
* ==== S04 P1.29: CSP without 'unsafe-inline'; safe Windows opener ====
local only : env WP30_ONLY
if inlist("`only'", "", "S04") {
    display as text "S04 start " c(current_date) " " c(current_time)
    // CSP-01..04: dash's saving() writes a name holding %, !, %% or ^ as
    // typed, as twoway's does (P1.29; only dash's Windows opener declines
    // such a path).
    quietly sysuse auto, clear
    local s04_chars `" "%" "!" "%%" "^" "'
    local s04_i 0
    foreach key in pct_path bang pct_pct caret {
        local ++s04_i
        local id "CSP-0`s04_i'"
        local s04_c : word `s04_i' of `s04_chars'
        python: __import__("__main__")._csp_truth("`key'")
        local s04_page "`w30_work'/d_${CSP_STEM}.html"
        capture erase "`s04_page'"
        capture noisily dash scatter mpg weight, saving("`s04_page'", replace)
        local s04_rc = _rc
        capture confirm file "`s04_page'"
        local s04_w = (_rc == 0)
        _w30_expect `id' "(`s04_rc' == ${CSP_RC})" "dash gave rc `s04_rc', twoway ${CSP_RC}"
        _w30_expect `id' "(`s04_w' == ${CSP_W})" "dash wrote the page: `s04_w'; twoway wrote its file: ${CSP_W}"
        _w30_done `id' "saving() with `s04_c' is written as typed, as twoway writes it"
        capture erase "`s04_page'"
    }
    macro drop CSP_RC CSP_W CSP_STEM
    capture dash clear
    display as text "S04 end " c(current_date) " " c(current_time)
}
* ==== end S04 ====

* ==== S05 P1.33: Measured Python floor ====
local only : env WP30_ONLY
if inlist("`only'", "", "S05") {
    display as text "S05 start " c(current_date) " " c(current_time)
    // PYF-03: the linked interpreter is at or above the declared floor.
    capture program list _dash_pyver_ok
    if _rc quietly do "../dash_setup.ado"
    _dash_pymin
    local s05_min "`r(pymin)'"
    python: import sys, sfi; sfi.Macro.setLocal("s05_ver", "%d.%d.%d" % tuple(sys.version_info[:3]))
    _dash_pyver_ok "`s05_ver'" "`s05_min'"
    local s05_ok = r(ok)
    _w30_expect PYF-03 "(`s05_ok' == 1)" "Python `s05_ver' is below the declared floor `s05_min'"
    _w30_done PYF-03 "Python `s05_ver' is at or above the declared floor `s05_min'"
    // PYF-04: the served app's child starts as dash serve starts it,
    // sys.executable -P, in safe-path mode.
    python: import subprocess, sys, sfi; _s05_r = subprocess.run([sys.executable, "-P", "-c", "import sys; print(int(sys.flags.safe_path))"], capture_output=True, text=True, timeout=60); sfi.Macro.setLocal("s05_child", "%d %s" % (_s05_r.returncode, _s05_r.stdout.strip()))
    local s05_c = ("`s05_child'" == "0 1")
    _w30_expect PYF-04 "(`s05_c' == 1)" "sys.executable -P gave `s05_child', wanted 0 1"
    _w30_done PYF-04 "sys.executable -P starts a child in safe-path mode (rc 0, safe_path 1)"
    display as text "S05 end " c(current_date) " " c(current_time)
}
* ==== end S05 ====

* ==== S06 P1.26a: One note channel ====
local only : env WP30_ONLY
if inlist("`only'", "", "S06") {
    display as text "S06 start " c(current_date) " " c(current_time)

    // twoway's measured channels (section 06, Stata truth p1-p4): a
    // named-style note shows under quietly and capture hides it; the
    // estimator note "(note:  regress could not fit model)" is plain
    // text, which quietly hides.  dash's notes take the same channels.
    // Each command runs under a named text log of its own, counted with
    // cert_log_has (wrapped lines re-joined), r(count) copied at once.
    sysuse auto, clear
    capture dash clear
    local s06_page "`w30_work'/wp30_s06.html"
    capture log close s06nc

    // ------------------------------------------------------------
    // NC-01: the named-style class.  twoway's note and dash's note both
    // show under quietly, and capture hides both.
    // ------------------------------------------------------------
    log using "`w30_work'/wp30_s06_1.log", text replace name(s06nc)
    quietly twoway scatter mpg weight, mcolor(notacolor) nodraw
    log close s06nc
    cert_log_has "`w30_work'/wp30_s06_1.log", needle("(note:")
    local s06_n1 = r(count)
    log using "`w30_work'/wp30_s06_2.log", text replace name(s06nc)
    capture twoway scatter mpg weight, mcolor(notacolor) nodraw
    log close s06nc
    cert_log_has "`w30_work'/wp30_s06_2.log", needle("(note:")
    local s06_n2 = r(count)
    log using "`w30_work'/wp30_s06_3.log", text replace name(s06nc)
    quietly dash scatter mpg weight, mcolor(notacolor) saving("`s06_page'", replace)
    log close s06nc
    cert_log_has "`w30_work'/wp30_s06_3.log", needle("(note:  dash: ")
    local s06_n3 = r(count)
    log using "`w30_work'/wp30_s06_4.log", text replace name(s06nc)
    capture dash scatter mpg weight, mcolor(notacolor) saving("`s06_page'", replace)
    local s06_rc4 = _rc
    log close s06nc
    cert_log_has "`w30_work'/wp30_s06_4.log", needle("(note:")
    local s06_n4 = r(count)
    cert_log_has "`w30_work'/wp30_s06_4.log", needle("Warning:")
    local s06_w4 = r(count)
    _w30_expect NC-01 "(`s06_n1' >= 1)" "quietly twoway logged `s06_n1' (note: lines"
    _w30_expect NC-01 "(`s06_n2' == 0)" "capture twoway logged `s06_n2' (note: lines"
    _w30_expect NC-01 "(`s06_n3' >= 1)" "quietly dash logged `s06_n3' (note:  dash: lines"
    _w30_expect NC-01 "(`s06_rc4' == 0 & `s06_n4' == 0 & `s06_w4' == 0)" "capture dash (rc `s06_rc4') logged `s06_n4' (note: and `s06_w4' Warning: lines"
    _w30_done NC-01 "a named-style note shows under quietly and capture hides it, for twoway and for dash"

    // ------------------------------------------------------------
    // NC-02: the estimator class.  twoway prints its could-not-fit note
    // once, as plain text that quietly hides; dash's copy does the same.
    // ------------------------------------------------------------
    log using "`w30_work'/wp30_s06_5.log", text replace name(s06nc)
    twoway (scatter mpg weight) (lfit mpg weight if price > 20000), nodraw
    log close s06nc
    cert_log_has "`w30_work'/wp30_s06_5.log", needle("could not fit model")
    local s06_n5 = r(count)
    log using "`w30_work'/wp30_s06_6.log", text replace name(s06nc)
    quietly twoway (scatter mpg weight) (lfit mpg weight if price > 20000), nodraw
    log close s06nc
    cert_log_has "`w30_work'/wp30_s06_6.log", needle("could not fit model")
    local s06_n6 = r(count)
    log using "`w30_work'/wp30_s06_7.log", text replace name(s06nc)
    capture noisily dash (scatter mpg weight) (lfit mpg weight if price > 20000), saving("`s06_page'", replace)
    local s06_rc7 = _rc
    log close s06nc
    cert_log_has "`w30_work'/wp30_s06_7.log", needle("could not fit model")
    local s06_n7 = r(count)
    log using "`w30_work'/wp30_s06_8.log", text replace name(s06nc)
    quietly dash (scatter mpg weight) (lfit mpg weight if price > 20000), saving("`s06_page'", replace)
    log close s06nc
    cert_log_has "`w30_work'/wp30_s06_8.log", needle("could not fit model")
    local s06_n8 = r(count)
    _w30_expect NC-02 "(`s06_n5' == 1)" "twoway logged `s06_n5' could-not-fit lines"
    _w30_expect NC-02 "(`s06_n6' == 0)" "quietly twoway logged `s06_n6' could-not-fit lines"
    _w30_expect NC-02 "(`s06_rc7' == 0 & `s06_n7' == 1)" "dash (rc `s06_rc7') logged `s06_n7' could-not-fit lines"
    _w30_expect NC-02 "(`s06_n8' == 0)" "quietly dash logged `s06_n8' could-not-fit lines"
    _w30_done NC-02 "the could-not-fit note prints once as plain text that quietly hides, for twoway and for dash"

    forvalues k = 1/8 {
        capture erase "`w30_work'/wp30_s06_`k'.log"
    }
    capture erase "`s06_page'"
    capture dash clear
    display as text "S06 end " c(current_date) " " c(current_time)
}
* ==== end S06 ====

// ----------------------------------------------------------------
// S07 helpers (python at the top level, where braces are safe).  Every
// argument crosses through sfi.Macro.getGlobal and every answer goes
// back through Macro.setGlobal; no macro text is pasted into Python.
//   _s07_svg()   S07_SVG (with yline(20)) and S07_SVG0 (without) ->
//                S07_TW = bg;marker;ylc;segs;w;h;tick
//   _s07_page()  S07_PAGE, a saved page -> S07_D =
//                border;plot;fill;span;dash;aspect;tick, and S07_PAL, the
//                first colour mapper's palette;low;high
//   _s07_app()   S07_APP, a served app.py, and S07_MOVE -> S07_S (the
//                same summary), S07_FIRED, S07_SAME_AFTER
//   _s07_child() S07_CHILD and S07_KIND (red, sp or zp) -> S07_DC, S07_DOK
//                and S07_DCW (count of "not found, using s2color")
//   _s07_ci()    S07_SCH -> S07_DCI = fill;outline;fit, or "error"
//   _s07_rgb()   S07_GOB ("r g b [%a]") -> S07_HEX = #rrggbb
// ----------------------------------------------------------------
python:
import collections as _s07_col
import html as _s07_html
import json as _s07_json
import os as _s07_os
import re as _s07_re
import sys as _s07_sys
import warnings as _s07_w
from sfi import Macro as _s07_M

_s07_repo = _s07_os.path.abspath("..")
for _s07_p in (_s07_os.path.join(_s07_repo, "scripts"), _s07_repo):
    if _s07_p not in _s07_sys.path:
        _s07_sys.path.insert(0, _s07_p)
import svg_truth as _s07_st

_S07_PLOTS = ("Figure", "figure", "Plot")


def _s07_set(name, val):
    _s07_M.setGlobal(name, str(val))


def _s07_svg():
    path = _s07_M.getGlobal("S07_SVG")
    path0 = _s07_M.getGlobal("S07_SVG0")
    doc = _s07_st.svg_document(path)
    bg = doc["rects"][0]["fill"] if doc["rects"] else ""
    fills = _s07_st.svg_marker_fills(path)
    marker = max(fills, key=lambda c: fills[c]["n"]) if fills else ""
    seen = set()
    if path0:
        d0 = _s07_st.svg_document(path0)
        for g in _s07_st.line_groups(d0["hlines"], "y1"):
            seen.add((g["px"], g["stroke"], g["width"]))
    new = [g for g in _s07_st.line_groups(doc["hlines"], "y1")
           if (g["px"], g["stroke"], g["width"]) not in seen]
    ylc = new[0]["stroke"] if len(new) == 1 else "n%d" % len(new)
    segs = new[0]["n_segments"] if len(new) == 1 else 0
    with open(path, encoding="utf-8", errors="replace") as fh:
        txt = fh.read()
    tag = _s07_re.search(r"<svg [^>]*>", txt)
    tag = tag.group(0) if tag else ""
    mw = _s07_re.search(r'width="([0-9.]+)in"', tag)
    mh = _s07_re.search(r'height="([0-9.]+)in"', tag)
    w = mw.group(1) if mw else "0"
    h = mh.group(1) if mh else "0"
    sizes = _s07_col.Counter(t["size"] for t in doc["texts"] if t["size"])
    tick = sizes.most_common(1)[0][0] if sizes else 0
    _s07_set("S07_TW", ";".join(str(x) for x in
                                (bg or "none", marker or "none", ylc, segs,
                                 w, h, tick)))
    _s07_set("S07_FILLS", " ".join(sorted(fills)) or "none")


def _s07_models(path):
    try:
        with open(path, encoding="utf-8") as fh:
            page = fh.read()
    except OSError:
        return []
    objs, stack = {}, []
    for blob in _s07_re.findall('<script type="application/json"[^>]*>(.*?)</script>', page, _s07_re.S):
        try:
            stack.append(_s07_json.loads(_s07_html.unescape(blob)))
        except ValueError:
            pass
    out = []
    while stack:
        v = stack.pop(0)
        if isinstance(v, dict):
            if v.get("type") == "object" and "id" in v and "name" in v:
                if v["id"] not in objs:
                    objs[v["id"]] = v
                    out.append(v)
            stack.extend(v.values())
        elif isinstance(v, list):
            stack.extend(v)
    return out


_S07_DEF = {}


def _s07_val(v):
    if isinstance(v, dict):
        if v.get("type") == "value" or "value" in v:
            return v.get("value")
        if "field" in v:
            return "field:" + str(v["field"])
    inner = getattr(v, "value", None)
    if inner is not None and not isinstance(v, (str, list, tuple)):
        return inner
    return v


def _s07_saved_first(objs):
    def first(kinds, attr):
        for o in objs:
            if o.get("name") not in kinds:
                continue
            a = o.get("attributes", {}) or {}
            if attr in a:
                return _s07_val(a[attr])
            k = o["name"]
            if k not in _S07_DEF:
                import bokeh.models as _bm
                try:
                    if k in ("Figure", "figure"):
                        from bokeh.plotting import figure as _s07_fig
                        _S07_DEF[k] = _s07_fig()
                    else:
                        _S07_DEF[k] = getattr(_bm, k)()
                except Exception:
                    _S07_DEF[k] = None
            d = _S07_DEF[k]
            return _s07_val(getattr(d, attr, None)) if d is not None else None
        return None
    return first


def _s07_served_first(doc):
    from bokeh.model import Model
    models = list(doc.select(dict(type=Model)))
    def first(kinds, attr):
        for m in models:
            if type(m).__name__ in kinds:
                return _s07_val(getattr(m, attr, None))
        return None
    return first


def _s07_fmt(first):
    def col(v):
        return str(v).lower() if v is not None else "none"
    dash = first(("Span",), "line_dash")
    if dash in (None, "solid") or (isinstance(dash, (list, tuple)) and not dash):
        dash = "solid"
    elif isinstance(dash, (list, tuple)):
        dash = " ".join(str(int(x)) for x in dash)
    asp = first(_S07_PLOTS, "aspect_ratio")
    asp = "%.4f" % float(asp) if asp is not None else "none"
    return ";".join([
        col(first(_S07_PLOTS, "border_fill_color")),
        col(first(_S07_PLOTS, "background_fill_color")),
        col(first(("Scatter",), "fill_color")),
        col(first(("Span",), "line_color")),
        str(dash), asp,
        str(first(("LinearAxis",), "major_label_text_font_size"))])


def _s07_page():
    objs = _s07_models(_s07_M.getGlobal("S07_PAGE"))
    _s07_set("S07_D", _s07_fmt(_s07_saved_first(objs)) if objs else "none")
    pal = "none"
    for o in objs:
        if str(o.get("name", "")).endswith("ColorMapper"):
            a = o.get("attributes", {}) or {}
            p = a.get("palette")
            if isinstance(p, dict):
                p = p.get("value") or p.get("entries")
            pal = "%s;%s;%s" % (" ".join(str(x).lower() for x in (p or [])),
                                a.get("low"), a.get("high"))
            break
    _s07_set("S07_PAL", pal)


def _s07_app():
    from bokeh.document import Document
    from bokeh.models import Select
    with open(_s07_M.getGlobal("S07_APP"), encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_s07_app")
    with _s07_w.catch_warnings():
        _s07_w.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_s07_app.py", "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    before = _s07_fmt(_s07_served_first(doc))
    _s07_set("S07_S", before)
    var = _s07_M.getGlobal("S07_MOVE")
    sel = [s for s in doc.select(dict(type=Select))
           if getattr(s, "_dash_var", None) == var]
    fired = 0
    if len(sel) == 1 and len(sel[0].options) > 1:
        old = sel[0].value
        opt = sel[0].options[1]
        new = opt[0] if isinstance(opt, (list, tuple)) else opt
        sel[0].value = new
        with _s07_w.catch_warnings():
            _s07_w.simplefilter("ignore")
            for cb in sel[0]._callbacks.get("value", []):
                cb("value", old, new)
                fired += 1
    _s07_set("S07_FIRED", fired)
    _s07_set("S07_SAME_AFTER", int(_s07_fmt(_s07_served_first(doc)) == before))


def _s07_child():
    import dash_render as _dr
    name = _s07_M.getGlobal("S07_CHILD")
    kind = _s07_M.getGlobal("S07_KIND")
    with _s07_w.catch_warnings(record=True) as caught:
        _s07_w.simplefilter("always")
        try:
            s = _dr.SchemeParser(name)
        except Exception as e:
            _s07_set("S07_DC", "error " + type(e).__name__)
            _s07_set("S07_DOK", 0)
            _s07_set("S07_DCW", -1)
            return
    _s07_set("S07_DCW", sum(1 for w in caught
                            if "not found, using s2color" in str(w.message)))
    T = _dr.OptionTranslator
    if kind == "red":
        cols = [str(s.default_color(0, k)).lower()
                for k in ("scatter", "bar", "connected", "line")]
        pats = [list(s.default_connect_pattern(0)), list(s.default_line_pattern(0))]
        want = list(T.translate_lpattern("dash"))
        ok = all(c == "#ff0000" for c in cols) and all(p == want for p in pats)
        desc = "%s %s" % (cols, pats)
    elif kind == "sp":
        syms = list(s.p_symbols[0:2])
        ok = syms == [T.translate_msymbol("diamond")] * 2
        desc = str(syms)
    else:
        sizes = [s.default_marker_size(0), s.default_marker_size(1)]
        want = s._markersize_px("huge")
        ok = all(abs(x - want) < 1e-9 for x in sizes)
        desc = "%s want %s" % (sizes, want)
    _s07_set("S07_DC", desc.replace('"', "'"))
    _s07_set("S07_DOK", int(ok))


def _s07_ci():
    import numpy as _np
    import pandas as _pd
    import dash_render as _dr
    from bokeh.models import ColumnDataSource
    from bokeh.plotting import figure
    name = _s07_M.getGlobal("S07_SCH")
    try:
        with _s07_w.catch_warnings():
            _s07_w.simplefilter("ignore")
            gm = _dr.GlyphMapper(scheme=_dr.SchemeParser(name))
            n = 40
            df = _pd.DataFrame(dict(
                x=_np.linspace(1.0, 40.0, n),
                y=_np.sin(_np.linspace(0, 3, n)) * 10 + 20 + _np.linspace(0, 5, n)))
            fig = figure()
            gm.map_lfitci(fig, ColumnDataSource(df), "y", "x", dict(), color_idx=0)
    except Exception:
        _s07_set("S07_DCI", "error")
        return
    kinds = _s07_col.defaultdict(list)
    for r in fig.renderers:
        g = getattr(r, "glyph", None)
        if g is not None:
            kinds[type(g).__name__].append(g)
    try:
        out = (str(kinds["VArea"][0].fill_color).lower(),
               str(kinds["Patch"][0].line_color).lower(),
               str(kinds["Line"][0].line_color).lower())
    except IndexError:
        _s07_set("S07_DCI", "error")
        return
    _s07_set("S07_DCI", ";".join(out))


def _s07_rgb():
    parts = _s07_M.getGlobal("S07_GOB").split()
    try:
        _s07_set("S07_HEX", "#%02x%02x%02x" % tuple(int(float(p)) for p in parts[:3]))
    except (ValueError, TypeError):
        _s07_set("S07_HEX", "none")
end

capture program drop _s07_gob
program define _s07_gob
    version 19
    args path
    local v "`.Graph.`path''"
    global S07_GOB `"`v'"'
end

capture program drop _s07_hex
program define _s07_hex
    version 19
    args path
    _s07_gob `path'
    python: __import__("__main__")._s07_rgb()
end

* ==== S07 P1.25a: Ship the six StataCorp schemes ====
local only : env WP30_ONLY
if inlist("`only'", "", "S07") {
    display as text "S07 start " c(current_date) " " c(current_time)
    // The six StataCorp schemes dash did not ship, against twoway's own
    // drawing in the same run.  Every page, app, SVG and log goes under
    // `w30_work'; only SX-05's and SX-08's child scheme files sit in the
    // working directory (twoway's findfile and dash's lookup read there),
    // each checked absent before it is written and erased in its case.
    local s07_six "meta stcolor_meta stcolor_mv stcoloralias stgcolor_meta stgcolor_mv"
    local s07_entry "`c(scheme)'"
    local s07_nk1 "is not a known theme or scheme"
    local s07_nk2 "not found, using s2color"
    capture log close sxk
    capture dash clear
    sysuse auto, clear

    // ------------------------------------------------------------
    // SX-01: the refusal is gone on every entry point.
    // ------------------------------------------------------------
    foreach S of local s07_six {
        capture twoway scatter mpg weight, scheme(`S') nodraw
        local s07_rc = _rc
        _w30_expect SX-01 "(`s07_rc' == 0)" "twoway scheme(`S') rc `s07_rc'"
    }
    log using "`w30_work'/sx1.log", text replace name(sxk)
    foreach S in `s07_six' META meta.scheme {
        capture dash clear
        capture noisily dash scatter mpg weight, scheme(`S') name(sx1)
        local s07_r1 = _rc
        capture noisily dash build, scheme(`S') saving("`w30_work'/sx1.html") replace nobrowser
        local s07_r2 = _rc
        tempfile s07_mj s07_dj
        capture noisily _dash_serve_spec, specpath("`s07_mj'") datapath("`s07_dj'") scheme(`S')
        local s07_r3 = _rc
        _w30_expect SX-01 "(`s07_r1' == 0 & `s07_r2' == 0 & `s07_r3' == 0)" "scheme(`S'): dash rc `s07_r1', build rc `s07_r2', serve spec rc `s07_r3'"
    }
    capture dash clear
    log close sxk
    cert_log_has "`w30_work'/sx1.log", needle("`s07_nk1'")
    local s07_n1 = r(count)
    cert_log_has "`w30_work'/sx1.log", needle("`s07_nk2'")
    local s07_n2 = r(count)
    _w30_expect SX-01 "(`s07_n1' == 0 & `s07_n2' == 0)" "the log holds `s07_n1' unknown-scheme and `s07_n2' not-found notes"
    _w30_done SX-01 "the six are accepted by twoway, dash, dash build and the serve spec, rc 0 and no note"

    // ------------------------------------------------------------
    // SX-02: drawn as twoway, saved page; SX-03: served, and after a
    // dropdown move.  Controls s2color (first, for meta's tick ratio)
    // and stcolor run the same way.
    // ------------------------------------------------------------
    log using "`w30_work'/sx2.log", text replace name(sxk)
    local s07_all3 = 1
    foreach S in s2color stcolor `s07_six' {
        sysuse auto, clear
        capture dash clear
        local s07_svg  "`w30_work'/sx2_`S'.svg"
        local s07_svg0 "`w30_work'/sx2_`S'_0.svg"
        twoway scatter mpg weight, yline(20) scheme(`S') name(sx2tw, replace)
        graph export "`s07_svg'", name(sx2tw) replace
        twoway scatter mpg weight, scheme(`S') name(sx2tw, replace)
        graph export "`s07_svg0'", name(sx2tw) replace
        global S07_SVG  "`s07_svg'"
        global S07_SVG0 "`s07_svg0'"
        python: __import__("__main__")._s07_svg()
        tokenize "${S07_TW}", parse(";")
        local tw_bg "`1'"
        local tw_mk "`3'"
        local tw_yl "`5'"
        local tw_sg "`7'"
        local tw_w  "`9'"
        local tw_h  "`11'"
        local tw_tk "`13'"
        local s07_page "`w30_work'/sx2_`S'.html"
        capture noisily dash scatter mpg weight, yline(20) scheme(`S') saving("`s07_page'", replace)
        local s07_rc = _rc
        global S07_PAGE "`s07_page'"
        python: __import__("__main__")._s07_page()
        local s07_d2 "${S07_D}"
        tokenize "${S07_D}", parse(";")
        local d_bd "`1'"
        local d_fl "`5'"
        local d_sp "`7'"
        local d_ds "`9'"
        local d_as "`11'"
        local d_tk = real(subinstr("`13'", "pt", "", .))
        local s07_twtick_`S' = `tw_tk'
        local s07_dtick_`S'  = `d_tk'
        local s07_ok = (`s07_rc' == 0 & "`tw_bg'" == "`d_bd'" & "`tw_mk'" == "`d_fl'" & "`tw_yl'" == "`d_sp'")
        local s07_ok = `s07_ok' & ((`tw_sg' == 1) == ("`d_ds'" == "solid"))
        capture local s07_ok = `s07_ok' & (abs(`tw_w'/`tw_h' - `d_as') < 0.0005)
        if _rc local s07_ok = 0
        _w30_expect SX-02 "`s07_ok'" "`S': rc `s07_rc', twoway ${S07_TW}; dash `s07_d2'"
        if "`S'" == "meta" {
            local s07_rt = `s07_twtick_meta'/`s07_twtick_s2color'
            local s07_rd = `s07_dtick_meta'/`s07_dtick_s2color'
            _w30_expect SX-02 "(abs(`s07_rt' - `s07_rd') < 0.01)" "meta's tick ratio: twoway `s07_rt', dash `s07_rd'"
        }

        // SX-03 on the same graph, served.
        capture dash clear
        capture quietly dash scatter mpg weight, yline(20) scheme(`S') name(g1)
        local s07_app "`w30_work'/sx3_`S'.py"
        capture noisily dash build, server saving("`s07_app'") replace nobrowser filter(foreign, type(dropdown))
        local s07_rc3 = _rc
        global S07_S ""
        global S07_FIRED 0
        global S07_SAME_AFTER 0
        global S07_APP "`s07_app'"
        global S07_MOVE "foreign"
        if `s07_rc3' == 0 capture noisily python: __import__("__main__")._s07_app()
        local s07_ok3 = (`s07_rc3' == 0 & "${S07_S}" == "`s07_d2'" & ${S07_FIRED} == 1 & ${S07_SAME_AFTER} == 1)
        if !`s07_ok3' {
            display as error "SX-03 FAIL: `S': build rc `s07_rc3', served ${S07_S} vs saved `s07_d2', fired ${S07_FIRED}, same after ${S07_SAME_AFTER}"
            local s07_all3 = 0
        }
        capture dash clear
        capture erase "`s07_svg'"
        capture erase "`s07_svg0'"
        capture erase "`s07_page'"
        capture erase "`s07_app'"
    }
    log close sxk
    cert_log_has "`w30_work'/sx2.log", needle("`s07_nk1'")
    local s07_n1 = r(count)
    _w30_expect SX-02 "(`s07_n1' == 0)" "the log holds `s07_n1' unknown-scheme notes"
    _w30_done SX-02 "background, first series, yline colour and solidity, proportions and meta's tick ratio are twoway's"
    _w30_expect SX-03 "`s07_all3'" "a served summary differed (the SX-03 FAIL lines above)"
    _w30_done SX-03 "the served app draws the saved page's summary, and a dropdown move leaves it unchanged"

    // ------------------------------------------------------------
    // SX-04: the inherited c(scheme).
    // ------------------------------------------------------------
    log using "`w30_work'/sx4.log", text replace name(sxk)
    foreach S of local s07_six {
        sysuse auto, clear
        capture dash clear
        set scheme `S'
        local s07_svg "`w30_work'/sx4_`S'.svg"
        twoway scatter mpg weight, yline(20) name(sx4tw, replace)
        graph export "`s07_svg'", name(sx4tw) replace
        twoway scatter mpg weight, name(sx4tw, replace)
        graph export "`w30_work'/sx4_`S'_0.svg", name(sx4tw) replace
        global S07_SVG  "`s07_svg'"
        global S07_SVG0 "`w30_work'/sx4_`S'_0.svg"
        python: __import__("__main__")._s07_svg()
        tokenize "${S07_TW}", parse(";")
        local tw_bg "`1'"
        local tw_mk "`3'"
        local tw_yl "`5'"
        local tw_sg "`7'"
        local tw_w  "`9'"
        local tw_h  "`11'"
        local s07_page "`w30_work'/sx4_`S'.html"
        capture noisily dash scatter mpg weight, yline(20) saving("`s07_page'", replace)
        local s07_rc = _rc
        set scheme `s07_entry'
        global S07_PAGE "`s07_page'"
        python: __import__("__main__")._s07_page()
        tokenize "${S07_D}", parse(";")
        local s07_ok = (`s07_rc' == 0 & "`tw_bg'" == "`1'" & "`tw_mk'" == "`5'" & "`tw_yl'" == "`7'")
        local s07_ok = `s07_ok' & ((`tw_sg' == 1) == ("`9'" == "solid"))
        capture local s07_ok = `s07_ok' & (abs(`tw_w'/`tw_h' - `11') < 0.0005)
        if _rc local s07_ok = 0
        _w30_expect SX-04 "`s07_ok'" "set scheme `S': rc `s07_rc', twoway ${S07_TW}; dash ${S07_D}"
        capture erase "`s07_svg'"
        capture erase "`w30_work'/sx4_`S'_0.svg"
        capture erase "`s07_page'"
    }
    set scheme `s07_entry'
    log close sxk
    cert_log_has "`w30_work'/sx4.log", needle("`s07_nk1'")
    local s07_n1 = r(count)
    _w30_expect SX-04 "(`s07_n1' == 0)" "the log holds `s07_n1' unknown-scheme notes"
    _w30_done SX-04 "an inherited c(scheme) that is one of the six is drawn as twoway draws it, with no note"

    // ------------------------------------------------------------
    // SX-05: the S3 batch's child-scheme tables over the six.
    // ------------------------------------------------------------
    foreach S of local s07_six {
        foreach k in red sp zp {
            local f1 "scheme-sx5`k'_`S'.scheme"
            local f2 "sx5`k'_`S'.scheme"
            capture confirm new file "`f1'"
            local s07_c1 = _rc
            capture confirm new file "`f2'"
            local s07_c2 = _rc
            _w30_expect SX-05 "(`s07_c1' == 0 & `s07_c2' == 0)" "`f1' or `f2' already exists in the working directory; not overwritten"
            if `s07_c1' | `s07_c2' continue
            foreach f in "`f1'" "`f2'" {
                tempname s07_fh
                file open `s07_fh' using "`f'", write text
                file write `s07_fh' "#include `S'" _n
                if "`k'" == "red" file write `s07_fh' "color p1 red" _n "linepattern p1 dash" _n
                if "`k'" == "sp"  file write `s07_fh' "symbol p diamond" _n
                if "`k'" == "zp"  file write `s07_fh' "symbolsize p huge" _n
                file close `s07_fh'
            }
            clear
            quietly set obs 11
            quietly generate x = _n
            quietly generate y1 = x
            quietly generate y2 = x + 1
            local s07_sch "sx5`k'_`S'"
            if "`k'" == "red" {
                twoway scatter y1 x, scheme(`s07_sch') nodraw
                _s07_gob plotregion1.plot1.style.marker.fillcolor.rgb
                local g1 "${S07_GOB}"
                twoway bar y1 x, scheme(`s07_sch') nodraw
                _s07_gob plotregion1.plot1.style.area.shadestyle.color.rgb
                local g2 "${S07_GOB}"
                twoway connected y1 x, scheme(`s07_sch') nodraw
                _s07_gob plotregion1.plot1.style.line.color.rgb
                local g3 "${S07_GOB}"
                _s07_gob plotregion1.plot1.style.line.pattern.setting
                local g4 "${S07_GOB}"
                twoway line y1 x, scheme(`s07_sch') nodraw
                _s07_gob plotregion1.plot1.style.line.color.rgb
                local g5 "${S07_GOB}"
                _s07_gob plotregion1.plot1.style.line.pattern.setting
                local g6 "${S07_GOB}"
                local s07_tw = ("`g1'" == "255 0 0" & "`g2'" == "255 0 0" & "`g3'" == "255 0 0" & "`g4'" == "dash" & "`g5'" == "255 0 0" & "`g6'" == "dash")
                local s07_twd "`g1'|`g2'|`g3'|`g4'|`g5'|`g6'"
            }
            else {
                twoway scatter y1 y2 x, scheme(`s07_sch') nodraw
                local s07_m = cond("`k'" == "sp", "symbol", "size")
                _s07_gob plotregion1.plot1.style.marker.`s07_m'.setting
                local g1 "${S07_GOB}"
                _s07_gob plotregion1.plot2.style.marker.`s07_m'.setting
                local g2 "${S07_GOB}"
                local s07_want = cond("`k'" == "sp", "diamond", "4.8611")
                local s07_tw = ("`g1'" == "`s07_want'" & "`g2'" == "`s07_want'")
                local s07_twd "`g1'|`g2'"
            }
            global S07_CHILD "`s07_sch'"
            global S07_KIND "`k'"
            global S07_DC ""
            global S07_DOK 0
            global S07_DCW -1
            capture noisily python: __import__("__main__")._s07_child()
            _w30_expect SX-05 "(`s07_tw' == 1)" "`s07_sch': twoway drew `s07_twd'"
            _w30_expect SX-05 "(${S07_DOK} == 1 & ${S07_DCW} == 0)" "`s07_sch': dash ${S07_DC}, ${S07_DCW} not-found notes"
            capture erase "`f1'"
            capture erase "`f2'"
        }
    }
    _w30_done SX-05 "color p1, linepattern p1, symbol p and symbolsize p in a child of each of the six reach what twoway's chain reaches"

    // ------------------------------------------------------------
    // SX-06: the ci band.
    // ------------------------------------------------------------
    foreach S of local s07_six {
        sysuse auto, clear
        twoway lfitci mpg weight, scheme(`S') nodraw
        _s07_hex plotregion1.plot1.style.area.shadestyle.color.rgb
        local h1 "${S07_HEX}"
        _s07_hex plotregion1.plot1.style.area.linestyle.color.rgb
        local h2 "${S07_HEX}"
        _s07_hex plotregion1.plot2.style.line.color.rgb
        local h3 "${S07_HEX}"
        global S07_SCH "`S'"
        global S07_DCI "error"
        capture noisily python: __import__("__main__")._s07_ci()
        _w30_expect SX-06 `""`h1';`h2';`h3'" == "${S07_DCI}""' "`S': twoway `h1';`h2';`h3', dash ${S07_DCI}"
    }
    _w30_done SX-06 "lfitci's band fill, band outline and fit line are twoway's under each of the six"

    // ------------------------------------------------------------
    // SX-07: stcoloralias is stcolor.
    // ------------------------------------------------------------
    sysuse auto, clear
    foreach S in stcolor stcoloralias {
        twoway scatter mpg weight, colorvar(price) scheme(`S') name(sx7tw, replace)
        graph export "`w30_work'/sx7_`S'.svg", name(sx7tw) replace
        global S07_SVG "`w30_work'/sx7_`S'.svg"
        global S07_SVG0 ""
        python: __import__("__main__")._s07_svg()
        local s07_fills_`S' "${S07_FILLS}"
        capture dash clear
        capture noisily dash scatter mpg weight, colorvar(price) scheme(`S') saving("`w30_work'/sx7_`S'.html", replace)
        local s07_rc7_`S' = _rc
        global S07_PAGE "`w30_work'/sx7_`S'.html"
        python: __import__("__main__")._s07_page()
        local s07_d7_`S' "${S07_D}|${S07_PAL}"
        capture erase "`w30_work'/sx7_`S'.svg"
        capture erase "`w30_work'/sx7_`S'.html"
    }
    _w30_expect SX-07 `""`s07_fills_stcolor'" == "`s07_fills_stcoloralias'""' "twoway's colorvar fills differ: `s07_fills_stcolor' / `s07_fills_stcoloralias'"
    _w30_expect SX-07 "(`s07_rc7_stcolor' == 0 & `s07_rc7_stcoloralias' == 0)" "dash rc `s07_rc7_stcolor' / `s07_rc7_stcoloralias'"
    _w30_expect SX-07 `""`s07_d7_stcolor'" == "`s07_d7_stcoloralias'""' "dash differs: `s07_d7_stcolor' / `s07_d7_stcoloralias'"
    _w30_done SX-07 "stcoloralias draws what stcolor draws, in twoway's colorvar() scatter and in dash's page"

    // ------------------------------------------------------------
    // SX-08: an #include of one of the six in a scheme file of yours.
    // ------------------------------------------------------------
    sysuse auto, clear
    capture confirm new file "sx8.scheme"
    local s07_c8 = _rc
    _w30_expect SX-08 "(`s07_c8' == 0)" "sx8.scheme already exists in the working directory; not overwritten"
    if `s07_c8' == 0 {
        tempname s07_fh
        file open `s07_fh' using "sx8.scheme", write text
        file write `s07_fh' "#include stcolor_meta" _n "color background red" _n
        file close `s07_fh'
        twoway scatter mpg weight, yline(20) scheme(sx8) name(sx8tw, replace)
        graph export "`w30_work'/sx8.svg", name(sx8tw) replace
        twoway scatter mpg weight, scheme(sx8) name(sx8tw, replace)
        graph export "`w30_work'/sx8_0.svg", name(sx8tw) replace
        global S07_SVG "`w30_work'/sx8.svg"
        global S07_SVG0 "`w30_work'/sx8_0.svg"
        python: __import__("__main__")._s07_svg()
        tokenize "${S07_TW}", parse(";")
        local s07_tw8 = ("`1'" == "#ff0000" & "`3'" == "#1a85ff" & "`5'" == "#c10534" & "`7'" == "1")
        log using "`w30_work'/sx8.log", text replace name(sxk)
        capture dash clear
        capture noisily dash scatter mpg weight, yline(20) scheme(sx8) saving("`w30_work'/sx8.html", replace)
        local s07_rc8 = _rc
        log close sxk
        global S07_PAGE "`w30_work'/sx8.html"
        python: __import__("__main__")._s07_page()
        tokenize "${S07_D}", parse(";")
        local s07_d8 = (`s07_rc8' == 0 & "`1'" == "#ff0000" & "`5'" == "#1a85ff" & "`7'" == "#c10534" & "`9'" == "solid")
        cert_log_has "`w30_work'/sx8.log", needle("`s07_nk2'")
        local s07_n8 = r(count)
        _w30_expect SX-08 "(`s07_tw8' == 1)" "twoway drew ${S07_TW}"
        _w30_expect SX-08 "(`s07_d8' == 1 & `s07_n8' == 0)" "dash rc `s07_rc8' drew ${S07_D}, `s07_n8' not-found notes"
        capture erase "sx8.scheme"
        capture erase "`w30_work'/sx8.svg"
        capture erase "`w30_work'/sx8_0.svg"
        capture erase "`w30_work'/sx8.html"
    }
    _w30_done SX-08 "#include stcolor_meta in a scheme file of yours resolves as twoway resolves it, with no note"

    foreach k in 1 2 4 8 {
        capture erase "`w30_work'/sx`k'.log"
    }
    capture erase "`w30_work'/sx1.html"
    capture graph drop sx2tw sx4tw sx7tw sx8tw
    capture dash clear
    sysuse auto, clear
    display as text "S07 end " c(current_date) " " c(current_time)
}
* ==== end S07 ====

// S08's helpers, outside every gate, where a python block may hold braces
// (copies of WP-29 S03's readers, renamed _s08_*).  Reached through
// __main__:
//   _s08_page()  S08_MSZ (the first Scatter's size), S08_TTL (the title's
//                font size), S08_LBL (the first LabelSet's
//                x_offset|y_offset|text_font_size), S08_LEG (each legend's
//                label font size) and S08_CBL (the ColorBar's label font
//                size) of the saved page S08_PAGE
//   _s08_app()   the same, prefixed S08_S, of the served app S08_APP; then
//                a RangeSlider move on weight sets S08_SAME_AFTER
//   _s08_tw()    S08_TWSIZE: the size of the last <text> equal to S08_TXT in
//                S08_SVG; S08_TWDX: its x minus the inner circle's centre;
//                S08_TWUPR: units per Stata unit
python:
import json as _s08_json, re as _s08_re, html as _s08_html
import warnings as _s08_w
import __main__ as _s08_main
from sfi import Macro as _s08_M


def _s08_val(v):
    if isinstance(v, dict):
        return v.get("value")
    return v


def _s08_saved_models(path):
    try:
        with open(path, encoding="utf-8") as fh:
            page = fh.read()
    except OSError:
        return []
    objs, stack = {}, []
    for blob in _s08_re.findall('<script type="application/json"[^>]*>(.*?)</script>', page, _s08_re.S):
        try:
            stack.append(_s08_json.loads(_s08_html.unescape(blob)))
        except ValueError:
            pass
    while stack:
        v = stack.pop()
        if isinstance(v, dict):
            if v.get("type") == "object" and "id" in v and "name" in v:
                objs.setdefault(v["id"], v)
            stack.extend(v.values())
        elif isinstance(v, list):
            stack.extend(v)
    out = []
    for o in objs.values():
        out.append((o["name"], o.get("attributes", {}) or {}))
    return out


def _s08_get(kind, attrs, attr):
    if attr in attrs:
        return _s08_val(attrs[attr])
    import bokeh.models as _bm
    try:
        return _s08_val(getattr(getattr(_bm, kind)(), attr, None))
    except Exception:
        return None


def _s08_summary(models):
    msz, ttl, lbl, leg, cbl = [], [], [], [], []
    for kind, get in models:
        if kind == "Scatter":
            msz.append("%g" % float(get("size")))
        elif kind == "Title" and get("text"):
            ttl.append(str(get("text_font_size")))
        elif kind == "LabelSet":
            lbl.append("%.3f|%.3f|%s" % (float(get("x_offset")), float(get("y_offset")),
                                         get("text_font_size")))
        elif kind == "Legend":
            leg.append(str(get("label_text_font_size")))
        elif kind == "ColorBar":
            cbl.append(str(get("major_label_text_font_size")))
    return dict(MSZ=(msz[0] if msz else ""), TTL="|".join(sorted(ttl)),
                LBL=(sorted(lbl)[0] if lbl else ""), LEG="|".join(sorted(leg)),
                CBL="|".join(sorted(cbl)))


def _s08_set(prefix, summ):
    for k, v in summ.items():
        _s08_M.setGlobal(prefix + k, v)


def _s08_page():
    models = [(k, (lambda a, k=k: (lambda attr: _s08_get(k, a, attr)))(a))
              for k, a in _s08_saved_models(_s08_M.getGlobal("S08_PAGE"))]
    _s08_set("S08_", _s08_summary(models))


def _s08_doc_summary(doc):
    seen = dict()
    for root in doc.roots:
        for m in root.references():
            seen[m.id] = m
    models = [(type(m).__name__, (lambda m=m: (lambda attr: _s08_val(getattr(m, attr, None))))())
              for m in seen.values()]
    return _s08_summary(models)


def _s08_app():
    from bokeh.document import Document
    from bokeh.models import RangeSlider
    with open(_s08_M.getGlobal("S08_APP"), encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_s08_app")
    with _s08_w.catch_warnings():
        _s08_w.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_s08_app.py", "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    before = _s08_doc_summary(doc)
    _s08_set("S08_S", before)
    sl = [s for s in doc.select(dict(type=RangeSlider)) if getattr(s, "_dash_var", None) == "weight"]
    fired = 0
    if len(sl) == 1:
        old = sl[0].value
        lo, hi = old
        new = (lo + (hi - lo) / 4.0, hi)
        sl[0].value = new
        with _s08_w.catch_warnings():
            _s08_w.simplefilter("ignore")
            for attr in ("value", "value_throttled"):
                for cb in sl[0]._callbacks.get(attr, []):
                    cb(attr, old, new)
                    fired += 1
    _s08_M.setGlobal("S08_SAME_AFTER", str(int(fired > 0 and _s08_doc_summary(doc) == before)))


def _s08_tw():
    import svg_truth as _s08_svg
    doc = _s08_svg.svg_document(_s08_M.getGlobal("S08_SVG"))
    want = _s08_M.getGlobal("S08_TXT")
    cv = doc["canvas"]
    _s08_M.setGlobal("S08_TWUPR", repr(min(cv["w"], cv["h"]) / 100.0))
    t = [e for e in doc["texts"] if e["text"] == want]
    # The last match: a legend key or colour-key label is written after
    # the axes, whose title or tick may hold the same text.
    _s08_M.setGlobal("S08_TWSIZE", repr(float(t[-1]["size"])) if t else ".")
    cs = [c for c in doc["circles"] if c.get("r") is not None and c.get("cx") is not None]
    if t and cs:
        c = min(cs, key=lambda c: c["r"])
        _s08_M.setGlobal("S08_TWDX", repr(float(t[0]["x"]) - float(c["cx"])))
    else:
        _s08_M.setGlobal("S08_TWDX", ".")


_s08_main._s08_page = _s08_page
_s08_main._s08_app = _s08_app
_s08_main._s08_tw = _s08_tw
end

// _s08_build: run one dash command, build the saved page (with a range
// filter on weight, as the served app) and the served app, and read both.
capture program drop _s08_build
program define _s08_build
    version 19
    args stem work
    global S08_PAGE "`work'/`stem'.html"
    global S08_APP "`work'/`stem'_app.py"
    capture erase "${S08_PAGE}"
    capture erase "${S08_APP}"
    capture noisily dash build, saving("${S08_PAGE}") replace nobrowser filter(weight, type(range))
    capture noisily dash build, saving("${S08_APP}") server replace filter(weight, type(range))
    python: __import__("__main__")._s08_page()
    python: __import__("__main__")._s08_app()
    capture erase "${S08_PAGE}"
    capture erase "${S08_APP}"
end

// _s08_twsvg: export the current twoway graph and read S08_TXT from it.
capture program drop _s08_twsvg
program define _s08_twsvg
    version 19
    args stem work txt
    global S08_SVG "`work'/`stem'.svg"
    global S08_TXT `"`txt'"'
    quietly graph export "${S08_SVG}", replace as(svg)
    python: __import__("__main__")._s08_tw()
    capture erase "${S08_SVG}"
end

* ==== S08 P1.12a: Stata size units for markers, text and gaps ====
local only : env WP30_ONLY
if inlist("`only'", "", "S08") {
    display as text "S08 start " c(current_date) " " c(current_time)
    local s08_scheme "`c(scheme)'"
    set scheme s2color
    quietly sysuse auto, clear
    capture dash clear

    // SU-10: msize(medium) and msize(1.52778) are the default marker.
    twoway scatter mpg weight
    local s08_twd "`.Graph.plotregion1.plot1.style.marker.size.setting'"
    twoway scatter mpg weight, msize(medium)
    local s08_twm "`.Graph.plotregion1.plot1.style.marker.size.setting'"
    twoway scatter mpg weight, msize(1.52778)
    local s08_twn "`.Graph.plotregion1.plot1.style.marker.size.setting'"
    capture dash clear
    dash scatter mpg weight, name(s08g)
    _s08_build su10d "`w30_work'"
    local s08_d "${S08_MSZ}"
    local s08_ds "${S08_SMSZ}"
    capture dash clear
    dash scatter mpg weight, msize(medium) name(s08g)
    _s08_build su10m "`w30_work'"
    local s08_m "${S08_MSZ}|${S08_SMSZ}"
    local s08_a10 "${S08_SAME_AFTER}"
    capture dash clear
    dash scatter mpg weight, msize(1.52778) name(s08g)
    _s08_build su10n "`w30_work'"
    local s08_n "${S08_MSZ}|${S08_SMSZ}"
    _w30_expect SU-10 "(`s08_twm' == `s08_twd' & `s08_twn' == `s08_twd')" "twoway settings `s08_twd' `s08_twm' `s08_twn'"
    _w30_expect SU-10 "(abs(`s08_d' - 5.8667) < 0.001 & `s08_ds' == `s08_d')" "dash default `s08_d' / `s08_ds'"
    _w30_expect SU-10 `"("`s08_m'" == "`s08_d'|`s08_d'" & "`s08_n'" == "`s08_d'|`s08_d'")"' "dash medium `s08_m', number `s08_n'"
    _w30_done SU-10 "msize(medium) and msize(1.52778) draw the default marker, as in twoway"

    // SU-11: title size(large) is the s2color heading.
    twoway scatter mpg weight, title("T")
    _s08_twsvg su11a "`w30_work'" "T"
    local s08_t0 "${S08_TWSIZE}"
    twoway scatter mpg weight, title("T", size(large))
    _s08_twsvg su11b "`w30_work'" "T"
    local s08_t1 "${S08_TWSIZE}"
    capture dash clear
    dash scatter mpg weight, title("T") name(s08g)
    _s08_build su11a "`w30_work'"
    local s08_d0 "${S08_TTL}|${S08_STTL}"
    capture dash clear
    dash scatter mpg weight, title("T", size(large)) name(s08g)
    _s08_build su11b "`w30_work'"
    local s08_d1 "${S08_TTL}|${S08_STTL}"
    local s08_a11 "${S08_SAME_AFTER}"
    _w30_expect SU-11 "(abs(`s08_t1' - `s08_t0') < 0.5)" "twoway title `s08_t0' / `s08_t1'"
    _w30_expect SU-11 `"("`s08_d1'" == "14pt|14pt" & "`s08_d0'" == "`s08_d1'")"' "dash title `s08_d0' / `s08_d1'"
    _w30_done SU-11 "title size(large) is 14pt, the scheme's heading, in both modes"

    // SU-12: stcolor, title size(14pt) against the default heading.
    set scheme stcolor
    twoway scatter mpg weight, title("T")
    _s08_twsvg su12a "`w30_work'" "T"
    local s08_t0 "${S08_TWSIZE}"
    twoway scatter mpg weight, title("T", size(14pt))
    _s08_twsvg su12b "`w30_work'" "T"
    local s08_t1 "${S08_TWSIZE}"
    capture dash clear
    dash scatter mpg weight, title("T") name(s08g)
    _s08_build su12a "`w30_work'"
    local s08_d0 = real(subinstr("${S08_TTL}", "pt", "", .))
    local s08_s0 = real(subinstr("${S08_STTL}", "pt", "", .))
    capture dash clear
    dash scatter mpg weight, title("T", size(14pt)) name(s08g)
    _s08_build su12b "`w30_work'"
    local s08_d1 = real(subinstr("${S08_TTL}", "pt", "", .))
    local s08_s1 = real(subinstr("${S08_STTL}", "pt", "", .))
    set scheme s2color
    local s08_rt = `s08_t1' / `s08_t0'
    _w30_expect SU-12 "(abs(`s08_d1' / `s08_d0' - `s08_rt') < 0.005 * `s08_rt')" "saved ratio `s08_d1'/`s08_d0', twoway `s08_rt'"
    _w30_expect SU-12 "(abs(`s08_s1' / `s08_s0' - `s08_rt') < 0.005 * `s08_rt')" "served ratio `s08_s1'/`s08_s0', twoway `s08_rt'"
    _w30_done SU-12 "under stcolor size(14pt) keeps twoway's proportion to the heading"

    // SU-13: the 3 o'clock label offset, by default and at mlabgap(0).
    foreach g in dflt 0 {
        local s08_go = cond("`g'" == "dflt", "", "mlabgap(`g')")
        twoway scatter mpg weight in 1, mlabel(make) `s08_go'
        _s08_twsvg su13`g' "`w30_work'" "AMC Concord"
        local s08_tw = ${S08_TWDX} / ${S08_TWUPR} * 3.84
        capture dash clear
        dash scatter mpg weight in 1, mlabel(make) `s08_go' name(s08g)
        _s08_build su13`g' "`w30_work'"
        local s08_dx : word 1 of `=subinstr("${S08_LBL}", "|", " ", .)'
        local s08_sx : word 1 of `=subinstr("${S08_SLBL}", "|", " ", .)'
        local s08_a13 "${S08_SAME_AFTER}"
        _w30_expect SU-13 "(abs(`s08_dx' - `s08_tw') < 0.05 & abs(`s08_sx' - `s08_tw') < 0.05)" "mlabgap `g': twoway `s08_tw', dash `s08_dx' / `s08_sx'"
    }
    _w30_done SU-13 "the label sits the marker radius plus the gap from its point, as twoway places it"

    // SU-14: legend(size(*2)) doubles the key text.
    twoway (scatter mpg weight) (scatter price weight, yaxis(2))
    _s08_twsvg su14a "`w30_work'" "Price"
    local s08_t0 "${S08_TWSIZE}"
    twoway (scatter mpg weight) (scatter price weight, yaxis(2)), legend(size(*2))
    _s08_twsvg su14b "`w30_work'" "Price"
    local s08_t1 "${S08_TWSIZE}"
    capture dash clear
    dash (scatter mpg weight) (scatter price weight, yaxis(2)), name(s08g)
    _s08_build su14a "`w30_work'"
    local s08_d0 = real(subinstr("${S08_LEG}", "pt", "", .))
    local s08_s0 = real(subinstr("${S08_SLEG}", "pt", "", .))
    capture dash clear
    dash (scatter mpg weight) (scatter price weight, yaxis(2)), legend(size(*2)) name(s08g)
    _s08_build su14b "`w30_work'"
    local s08_d1 = real(subinstr("${S08_LEG}", "pt", "", .))
    local s08_s1 = real(subinstr("${S08_SLEG}", "pt", "", .))
    _w30_expect SU-14 "(abs(`s08_t1' / `s08_t0' - 2) < 0.02)" "twoway key `s08_t0' / `s08_t1'"
    _w30_expect SU-14 "(abs(`s08_d1' / `s08_d0' - 2) < 0.02 & abs(`s08_s1' / `s08_s0' - 2) < 0.02)" "dash key `s08_d0' / `s08_d1', served `s08_s0' / `s08_s1'"
    _w30_done SU-14 "legend(size(*2)) doubles the key text, as in twoway"

    // SU-15: zlabel(, labsize(large)) on the colour bar.
    twoway scatter mpg weight, colorvar(price) zlabel(, labsize(large))
    _s08_twsvg su15 "`w30_work'" "5,000"
    local s08_t1 "${S08_TWSIZE}"
    capture dash clear
    dash scatter mpg weight, colorvar(price) zlabel(, labsize(large)) name(s08g)
    _s08_build su15 "`w30_work'"
    local s08_c "${S08_CBL}|${S08_SCBL}"
    local s08_a15 "${S08_SAME_AFTER}"
    _w30_expect SU-15 "(abs(`s08_t1' - 140) < 0.5)" "twoway key label `s08_t1'"
    _w30_expect SU-15 `"("`s08_c'" == "14pt|14pt")"' "dash colour-bar labels `s08_c'"
    _w30_done SU-15 "zlabel(, labsize(large)) draws 14pt on the colour bar, as in twoway"

    // SU-16: msize(HUGE) is noted and drawn at the scheme's default (s2color:
    // medium, as twoway); msize(-1) is silent.
    capture log close su1k
    log using "`w30_work'/su16a.log", text replace name(su1k)
    twoway scatter mpg weight, msize(HUGE)
    log close su1k
    cert_log_has "`w30_work'/su16a.log", needle("named style HUGE not found")
    local s08_n1 = r(count)
    capture dash clear
    log using "`w30_work'/su16b.log", text replace name(su1k)
    dash scatter mpg weight, msize(HUGE) name(s08g)
    _s08_build su16a "`w30_work'"
    log close su1k
    cert_log_has "`w30_work'/su16b.log", needle("msize(HUGE) is not a recognised size; using the scheme")
    local s08_n2 = r(count)
    local s08_h "${S08_MSZ}|${S08_SMSZ}"
    log using "`w30_work'/su16c.log", text replace name(su1k)
    twoway scatter mpg weight, msize(-1)
    log close su1k
    cert_log_has "`w30_work'/su16c.log", needle("(note:")
    local s08_n3 = r(count)
    capture dash clear
    log using "`w30_work'/su16d.log", text replace name(su1k)
    dash scatter mpg weight, msize(-1) name(s08g)
    _s08_build su16b "`w30_work'"
    log close su1k
    cert_log_has "`w30_work'/su16d.log", needle("(note:")
    local s08_n4 = r(count)
    local s08_z "${S08_MSZ}|${S08_SMSZ}"
    _w30_expect SU-16 "(`s08_n1' >= 1 & `s08_n2' == 1)" "notes: twoway `s08_n1', dash `s08_n2'"
    _w30_expect SU-16 `"(abs(real(word(subinstr("`s08_h'", "|", " ", .), 1)) - 5.8667) < 0.001 & word(subinstr("`s08_h'", "|", " ", .), 1) == word(subinstr("`s08_h'", "|", " ", .), 2))"' "dash HUGE `s08_h'"
    _w30_expect SU-16 `"(`s08_n3' == 0 & `s08_n4' == 0 & "`s08_z'" == "0|0")"' "msize(-1): notes `s08_n3' / `s08_n4', size `s08_z'"
    _w30_done SU-16 "an unknown name draws medium with one note; a negative size draws nothing in silence"
    forvalues k = 1/4 {
        local s08_l : word `k' of a b c d
        capture erase "`w30_work'/su16`s08_l'.log"
    }

    // SU-17: the served app is unchanged by a filter move.
    _w30_expect SU-17 "(`s08_a10' == 1 & `s08_a11' == 1 & `s08_a13' == 1 & `s08_a15' == 1)" "same after the move: `s08_a10' `s08_a11' `s08_a13' `s08_a15'"
    _w30_done SU-17 "every size of the served app is unchanged by a filter move"

    capture dash clear
    graph drop _all
    set scheme `s08_scheme'
    macro drop S08_*
    display as text "S08 end " c(current_date) " " c(current_time)
}
* ==== end S08 ====

* ==== S09 P1.11a: TeX delimiters inert on every canvas sink ====
local only : env WP30_ONLY
if inlist("`only'", "", "S09") {
    display as text "S09 start " c(current_date) " " c(current_time)

    // TX-01 (guard, the truth): twoway draws each TeX pair as typed.
    sysuse auto, clear
    quietly twoway scatter mpg weight, title("\(y\)") subtitle("\[z\]") ///
        note("\$\$ x \$\$") xtitle("\(a\) w") xlabel(2000 "\(t\)" 3000) ///
        legend(on label(1 "\(k\)")) name(s09tx, replace)
    cert_svg_export, name(s09tx) file("`w30_work'/s09tx.svg")
    local s09_rc = r(rc)
    local s09_svg "`r(file)'"
    _w30_expect TX-01 "(`s09_rc' == 0)" "graph export rc `s09_rc'"
    foreach t in "\(y\)" "\[z\]" "\$\$ x \$\$" "\(a\) w" "\(t\)" "\(k\)" {
        cert_svg_has_text, file("`s09_svg'") text(`"`t'"')
        local s09_f = r(found)
        _w30_expect TX-01 "(`s09_f' == 1)" `"twoway did not draw `t' as typed"'
    }
    _w30_done TX-01 "twoway draws each TeX pair as typed"

    // TX-02: the same options in dash: the saved page ships no MathJax.
    quietly dash scatter mpg weight, title("\(y\)") subtitle("\[z\]") ///
        note("\$\$ x \$\$") xtitle("\(a\) w") xlabel(2000 "\(t\)" 3000) ///
        legend(on label(1 "\(k\)")) saving("`w30_work'/s09tx.html", replace)
    cert_file_has "`w30_work'/s09tx.html", needle("bokeh-mathjax")
    local s09_mj = r(found)
    _w30_expect TX-02 "(`s09_mj' == 0)" "the saved page ships bokeh-mathjax"
    _w30_done TX-02 "a saved page with TeX pairs ships no MathJax"

    // TX-03: the title is the typed text with its delimiters broken (the
    // page JSON writes U+2060 as \u2060 and a backslash as \\).
    cert_file_has "`w30_work'/s09tx.html", needle("\\\u2060(y\\\u2060)")
    local s09_in = r(found)
    cert_file_has "`w30_work'/s09tx.html", needle(`""text":"\\(y\\)""')
    local s09_raw = r(found)
    _w30_expect TX-03 "(`s09_in' == 1 & `s09_raw' == 0)" ///
        "title keeps a live pair (inert `s09_in', raw `s09_raw')"
    _w30_done TX-03 "the title is the typed text with its delimiters broken"

    // TX-04: the TeX page is the size of the same page in plain words.
    quietly dash scatter mpg weight, title("y") subtitle("z") note("x") ///
        xtitle("a w") xlabel(2000 "t" 3000) legend(on label(1 "k")) ///
        saving("`w30_work'/s09plain.html", replace)
    checksum "`w30_work'/s09tx.html"
    local s09_n1 = r(filelen)
    checksum "`w30_work'/s09plain.html"
    local s09_n0 = r(filelen)
    display as text "S09 sizes: TeX page `s09_n1' bytes, plain page `s09_n0' bytes"
    _w30_expect TX-04 "(abs(`s09_n1' - `s09_n0') < 2000)" ///
        "TeX page `s09_n1' bytes against plain `s09_n0'"
    _w30_done TX-04 "the TeX page is the plain page's size"

    // TX-05: labels reach the canvas as typed (variable labels as axis
    // titles, a value label as a by() panel title).  No $name form: twoway
    // macro-expands those inside labels (E6), which is not TeX.
    sysuse auto, clear
    label variable mpg "\$\$ m \$\$"
    label variable weight "\(w\) lbs"
    label define s09o 0 "\(d\)" 1 "Foreign", replace
    label values foreign s09o
    quietly twoway scatter mpg weight, by(foreign) name(s09lb, replace)
    cert_svg_export, name(s09lb) file("`w30_work'/s09lb.svg")
    local s09_svg "`r(file)'"
    foreach t in "\$\$ m \$\$" "\(w\) lbs" "\(d\)" {
        cert_svg_has_text, file("`s09_svg'") text(`"`t'"')
        local s09_f = r(found)
        _w30_expect TX-05 "(`s09_f' == 1)" `"twoway did not draw the label `t' as typed"'
    }
    quietly dash scatter mpg weight, by(foreign) saving("`w30_work'/s09lb.html", replace)
    cert_file_has "`w30_work'/s09lb.html", needle("bokeh-mathjax")
    local s09_mj = r(found)
    cert_file_has "`w30_work'/s09lb.html", needle("\\\u2060(d\\\u2060)")
    local s09_in = r(found)
    _w30_expect TX-05 "(`s09_mj' == 0 & `s09_in' == 1)" ///
        "labels: bokeh-mathjax `s09_mj', inert panel title `s09_in'"
    _w30_done TX-05 "labels are drawn as typed and ship no MathJax"

    foreach f in s09tx.svg s09tx.html s09plain.html s09lb.svg s09lb.html {
        capture erase "`w30_work'/`f'"
    }
    capture graph drop s09tx s09lb

    display as text "S09 end " c(current_date) " " c(current_time)
}
* ==== end S09 ====

// S10's helpers (WP-30 P1.19): Mata writes its tables and its resolver's
// answers to files under the work directory; Python compares them with
// dash_render's tables and _dash_subopt_resolve.  Tokens never pass
// through a macro.
mata:
void _s10_dump(string scalar fam, string scalar path)
{
    string matrix t
    string scalar line
    real scalar   fh, i, j

    t = _dash_so_rows(fam)
    if (fileexists(path)) unlink(path)
    fh = fopen(path, "w")
    for (i = 1; i <= rows(t); i++) {
        line = t[i, 1]
        for (j = 2; j <= 6; j++) line = line + char(9) + t[i, j]
        fput(fh, line)
    }
    fclose(fh)
}

// Input lines: "C<tab>fam" starts a case, "T<tab>cid<tab>token" adds a
// token, "E" ends it.  Output, one line per case:
// rc<tab>at<tab>msg<tab>name<US>name...
void _s10_resolve(string scalar inp, string scalar outp)
{
    string rowvector toks, names
    string scalar    line, fam, msg, rest, out
    real rowvector   cid
    real scalar      fi, fo, rc, at, p, i

    if (fileexists(outp)) unlink(outp)
    fi = fopen(inp, "r")
    fo = fopen(outp, "w")
    while ((line = fget(fi)) != J(0, 0, "")) {
        if (substr(line, 1, 2) == "C" + char(9)) {
            fam  = substr(line, 3, .)
            toks = J(1, 0, "")
            cid  = J(1, 0, .)
        }
        else if (substr(line, 1, 2) == "T" + char(9)) {
            rest = substr(line, 3, .)
            p    = strpos(rest, char(9))
            cid  = cid, strtoreal(substr(rest, 1, p - 1))
            toks = toks, substr(rest, p + 1, .)
        }
        else if (line == "E") {
            rc  = _dash_so_resolve(toks, cid, fam, names, msg, at)
            out = strofreal(rc) + char(9) + strofreal(at) + char(9) + msg + char(9)
            for (i = 1; i <= cols(names); i++) {
                out = out + (i > 1 ? char(31) : "") + names[i]
            }
            fput(fo, out)
        }
    }
    fclose(fi)
    fclose(fo)
}
end

python:
def _s10_tabs():
    import os, sys
    repo = os.path.abspath("..")
    if repo not in sys.path:
        sys.path.insert(0, repo)
    import dash_render as dr
    return dr, {
        "legend": dr._DASH_LEGEND_SUBOPT_TABLE,
        "axlabel": dr._DASH_AXLABEL_SUBOPT_TABLE,
        "axscale": dr._DASH_AXSCALE_SUBOPT_TABLE,
        "refline": dr._DASH_REFLINE_SUBOPT_TABLE,
        "title": dr._DASH_TITLE_SUBOPT_TABLE,
        "axtitle": dr._DASH_AXTITLE_SUBOPT_TABLE,
        "textbox": tuple((f, m, 1, "a", True, "")
                         for f, m in dr._TEXTBOX_SUBOPTS)}


def _s10_tables():
    import os
    from sfi import Macro
    dr, tabs = _s10_tabs()
    work = Macro.getGlobal("S10_WORK")
    diff, first = 0, ""
    for fam, t in tabs.items():
        want = ["\t".join((r[0], r[1], str(r[2]), r[3], "1" if r[4] else "0",
                           r[5])) for r in t]
        with open(os.path.join(work, "s10_rows_%s.txt" % fam),
                  encoding="utf-8") as fh:
            got = fh.read().splitlines()
        if got != want:
            diff += 1
            first = first or fam
    Macro.setGlobal("S10_TDIFF", str(diff))
    Macro.setGlobal("S10_TFIRST", first)


def _s10_lists():
    import random
    dr, tabs = _s10_tabs()
    rng = random.Random(30019)
    out = []
    fixed = {
        "legend": ["po(9)", "rin(0) pos(5)", "OFF", "c(2) cols(1)",
                   "size(large) s(small)", "on on", "on(1)", "cols",
                   "c(1) c(red)", "c(1) c(2) c(3)", 't("TT")',
                   "rows(1) r(2)", "xoffset(x)", "xoffset(1.5e3)",
                   'lab(1 "A") label(2 "B")', "garbage", "on off"],
        "axlabel": ["lab(large)", "labs", "labs labs(large)",
                    "labs(large) labs", "nog(1)", "angle(45) ang(0)",
                    "labs(large) bogus", "nogr nogrid", "labelminlen(x)",
                    "labelminlen(-3)", "labs(large) LABSIZE(small)",
                    "grid nogrid", "val novaluelabel", "a(45)"],
        "refline": ["lc(red) lp(dash) lw(thick)", "LCOLOR(red)", "l(red)",
                    "st(x) la(y)"],
        "title": ["SIZE(small)", "ls(x)", "size(small) s(large)", "s(small)",
                  "nob", "b a(top)"],
        "axtitle": ["prefix suffix", "ax(2) s(small)", "ls(x)"],
    }
    for fam, lists in fixed.items():
        for text in lists:
            out.append((fam, [dr._dash_by_tokens(text)]))
    bogus = ["zz", "garbage", "x", "no", "a", "c", "t", "l"]
    for k in range(500):
        fam = rng.choice(list(tabs))
        t = tabs[fam]
        copies = []
        for c in range(rng.randint(1, 3)):
            toks = []
            for _ in range(rng.randint(0, 6)):
                row = rng.choice(t)
                pick = rng.random()
                if pick < 0.4:
                    nm = row[1]
                elif pick < 0.7:
                    nm = row[0]
                elif pick < 0.8:
                    nm = row[1].upper()
                else:
                    nm = rng.choice(bogus)
                arg = rng.choice(["", "(1)", "(x)", "(1.5)", "()", "(-2)"])
                toks.append(nm + arg)
            copies.append(toks)
        out.append((fam, copies))
    return dr, tabs, out


def _s10_cases():
    import os
    from sfi import Macro
    dr, tabs, cases = _s10_lists()
    work = Macro.getGlobal("S10_WORK")
    with open(os.path.join(work, "s10_cases.txt"), "w",
              encoding="utf-8") as fh:
        for fam, copies in cases:
            fh.write("C\t%s\n" % fam)
            for c, toks in enumerate(copies, 1):
                for tok in toks:
                    fh.write("T\t%d\t%s\n" % (c, tok))
            fh.write("E\n")


def _s10_compare():
    import os
    from sfi import Macro
    dr, tabs, cases = _s10_lists()
    work = Macro.getGlobal("S10_WORK")
    with open(os.path.join(work, "s10_mata.txt"), encoding="utf-8") as fh:
        got = fh.read().split("\n")
    diff, first = 0, ""
    for k, (fam, copies) in enumerate(cases):
        names, prob = dr._dash_subopt_resolve(copies, tabs[fam])
        flat = [n or "" for c in names for n in c]
        if prob is None:
            want_rc, want_at, want_msg = 0, 0, ""
        else:
            idx = sum(len(c) for c in copies[:prob[0]]) + prob[1] + 1
            want_rc, want_at, want_msg = 198, idx, prob[3]
        want = "%d\t%d\t%s\t%s" % (want_rc, want_at, want_msg,
                                   "\x1f".join(flat))
        line = got[k] if k < len(got) else "<missing>"
        # On a problem, Mata stops naming at the problem's stage, as
        # Python does; the names are compared whole either way.
        if line != want:
            diff += 1
            first = first or ("%s %r: mata %r python %r"
                              % (fam, copies, line, want))[:200]
    Macro.setGlobal("S10_RDIFF", str(diff))
    Macro.setGlobal("S10_RFIRST", first.replace('"', "'").replace(chr(96), "'").replace("$", "S"))
    Macro.setGlobal("S10_NCASE", str(len(cases)))
end

* ==== S10 P1.19: Sub-option abbreviations ====
local only : env WP30_ONLY
if inlist("`only'", "", "S10") {
    display as text "S10 start " c(current_date) " " c(current_time)

    // SA-11: every Mata table equals dash_render's, row for row.
    foreach fam in legend axlabel axscale refline title axtitle textbox {
        mata: _s10_dump("`fam'", st_local("w30_work") + "/s10_rows_`fam'.txt")
    }
    global S10_WORK "`w30_work'"
    python: _s10_tables()
    local s10ok = ("${S10_TDIFF}" == "0")
    _w30_expect SA-11 `s10ok' "Mata and Python tables differ: ${S10_TFIRST}"
    _w30_done SA-11 "the seven Mata sub-option tables equal dash_render's"

    // SA-12: both resolvers give the same names and problem on the probe
    // lists and 500 random ones (seed 30019).
    python: _s10_cases()
    mata: _s10_resolve(st_local("w30_work") + "/s10_cases.txt", st_local("w30_work") + "/s10_mata.txt")
    python: _s10_compare()
    local s10ok = ("${S10_RDIFF}" == "0" & ${S10_NCASE} >= 500)
    _w30_expect SA-12 `s10ok' `"${S10_RDIFF} of ${S10_NCASE} resolutions differ: ${S10_RFIRST}"'
    _w30_done SA-12 "_dash_so_resolve and _dash_subopt_resolve agree on ${S10_NCASE} token lists"

    foreach f in s10_cases.txt s10_mata.txt s10_rows_legend.txt s10_rows_axlabel.txt s10_rows_axscale.txt s10_rows_refline.txt s10_rows_title.txt s10_rows_axtitle.txt s10_rows_textbox.txt {
        capture erase "`w30_work'/`f'"
    }
    display as text "S10 end " c(current_date) " " c(current_time)
}
* ==== end S10 ====

// S11 (WP-30 P1.1a) helpers.  Each sets a global to the per-series list
// "colour/kind" of one drawing, figures joined by " ; ":
//   _s11_svg()   S11_TW  from the live twoway SVG S11_SVG: marker fills
//                in document order (74 auto rows a series), or line
//                strokes (kind solid/dashed: more <line> than <path>)
//   _s11_page()  S11_PG  from the saved page S11_PAGE's Bokeh document
//   _s11_app()   S11_AP  from the served app S11_APP, executed unserved
// S11_LINES is 1 for a line case.
python:
import json as _s11_json, re as _s11_re, html as _s11_html, os as _s11_os, sys as _s11_sys
import warnings as _s11_w
from sfi import Macro as _s11_M

_S11_CHROME = ("#000000", "#ffffff", "#eaf2f3")
_S11_KIND = {"circle": "circle", "polygon": "triangle"}


def _s11_lines():
    return _s11_M.getGlobal("S11_LINES") == "1"


def _s11_svg():
    _s11_sys.path.insert(0, _s11_os.path.join(_s11_M.getGlobal("S11_REPO"), "scripts"))
    import svg_truth
    with open(_s11_M.getGlobal("S11_SVG"), encoding="utf-8", errors="replace") as fh:
        txt = fh.read()
    marks, strokes = [], []
    for m in _s11_re.finditer(r"<(circle|path|polygon|line)\b([^>]*)>", txt):
        kind = m.group(1)
        a = svg_truth._attrs(m.group(2))
        st = svg_truth._style_of(a)
        fill = (st.get("fill", a.get("fill")) or "").lower()
        stroke = (st.get("stroke", a.get("stroke")) or "").lower()
        if kind != "line" and fill and fill != "none":
            if marks and marks[-1][0] == fill and marks[-1][2] == kind:
                marks[-1][1] += 1
            else:
                marks.append([fill, 1, kind])
        elif kind in ("line", "path") and stroke and stroke != "none":
            nl, npth = (1, 0) if kind == "line" else (0, 1)
            if strokes and strokes[-1][0] == stroke:
                strokes[-1][1] += nl
                strokes[-1][2] += npth
            else:
                strokes.append([stroke, nl, npth])
    out = []
    if _s11_lines():
        out = ["%s/%s" % (c, "dashed" if nl > npth else "solid")
               for c, nl, npth in strokes if npth >= 1 and c not in _S11_CHROME]
    else:
        per = int(_s11_M.getGlobal("S11_PER") or "74")
        for c, n, k in marks:
            if n < 2 and per > 1:
                continue
            out.extend(["%s/%s" % (c, _S11_KIND.get(k, k))] * max(1, n // per))
    _s11_M.setGlobal("S11_TW", " ".join(out[:int(_s11_M.getGlobal("S11_N"))]))


def _s11_fmt(items):
    out = []
    for name, get in items:
        if name == "Scatter" and not _s11_lines():
            out.append("%s/%s" % (str(get("fill_color")).lower(), get("marker") or "circle"))
        elif name == "Line" and _s11_lines():
            out.append("%s/%s" % (str(get("line_color")).lower(), "dashed" if get("line_dash") else "solid"))
    return " ".join(out)


def _s11_val(v):
    if isinstance(v, dict) and v.get("type") == "value":
        return v.get("value")
    return v


def _s11_page():
    with open(_s11_M.getGlobal("S11_PAGE"), encoding="utf-8") as fh:
        page = fh.read()
    objs, stack = {}, []
    for blob in _s11_re.findall('<script type="application/json"[^>]*>(.*?)</script>', page, _s11_re.S):
        try:
            stack.append(_s11_json.loads(_s11_html.unescape(blob)))
        except ValueError:
            pass
    while stack:
        v = stack.pop()
        if isinstance(v, dict):
            if v.get("type") == "object" and "id" in v and "name" in v:
                if "attributes" in v or v["id"] not in objs:
                    objs[v["id"]] = v
            stack.extend(v.values())
        elif isinstance(v, list):
            stack.extend(v)

    def ref(v):
        return objs.get(v.get("id")) if isinstance(v, dict) else None
    figs = []
    for o in objs.values():
        rs = (o.get("attributes") or {}).get("renderers")
        if o["name"] != "Figure" or not isinstance(rs, list):
            continue
        items = []
        for r in rs:
            r = ref(r)
            if not r or r["name"] != "GlyphRenderer":
                continue
            g = ref((r.get("attributes") or {}).get("glyph"))
            if not g:
                continue
            at = g.get("attributes") or {}
            items.append((g["name"], lambda k, at=at: _s11_val(at.get(k))))
        s = _s11_fmt(items)
        if s:
            figs.append(s)
    _s11_M.setGlobal("S11_PG", " ; ".join(sorted(figs)))


def _s11_app():
    from bokeh.document import Document
    from bokeh.models import GlyphRenderer, Plot
    with open(_s11_M.getGlobal("S11_APP"), encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_s11_app")
    with _s11_w.catch_warnings():
        _s11_w.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_s11_app.py", "exec"), ns)
    doc = Document()
    ns["make_document"](doc)
    figs = []
    for root in doc.roots:
        for p in root.references():
            if not isinstance(p, Plot):
                continue
            items = [(type(r.glyph).__name__, lambda k, g=r.glyph: getattr(g, k, None))
                     for r in p.renderers if isinstance(r, GlyphRenderer)]
            s = _s11_fmt(items)
            if s:
                figs.append(s)
    _s11_M.setGlobal("S11_AP", " ; ".join(sorted(figs)))
end

// _s11_case id data n lines cmd: twoway <cmd> against dash's saved page
// and served app.  Sets $S11_OK (1 when both modes draw twoway's list),
// $S11_WHY and $S11_NOTE (1 when a dash build printed "not a recognised").
capture program drop _s11_case
program define _s11_case
    version 19
    args id data n lines work cmd
    if "`data'" == "sp500" {
        quietly sysuse sp500, clear
        quietly tsset date
    }
    else quietly sysuse auto, clear
    global S11_N "`n'"
    global S11_LINES "`lines'"
    global S11_PER = cond("`id'" == "T32", "1", "74")
    local svg "`work'/s11_`id'.svg"
    local page "`work'/s11_`id'.html"
    local app "`work'/s11_`id'.py"
    local sep = cond(strpos(`"`macval(cmd)'"', ","), " ", ", ")
    capture graph drop g
    capture noisily twoway `macval(cmd)'`sep'name(g, replace)
    local trc = _rc
    if !`trc' quietly graph export "`svg'", replace name(g)
    capture dash clear
    capture log close s11n
    quietly log using "`work'/s11_`id'.log", text replace name(s11n)
    capture noisily dash `macval(cmd)'`sep'saving("`page'", replace)
    local drc = _rc
    capture dash clear
    capture noisily dash `macval(cmd)'`sep'name(g1)
    local drc = `drc' + _rc
    capture noisily dash build, server saving("`app'") replace nobrowser
    local drc = `drc' + _rc
    quietly log close s11n
    global S11_TW ""
    global S11_PG ""
    global S11_AP ""
    global S11_SVG "`svg'"
    global S11_PAGE "`page'"
    global S11_APP "`app'"
    if !`trc' capture noisily python: __import__("__main__")._s11_svg()
    if !`drc' capture noisily python: __import__("__main__")._s11_page()
    if !`drc' capture noisily python: __import__("__main__")._s11_app()
    cert_log_has "`work'/s11_`id'.log", needle("not a recognised")
    global S11_NOTE = (r(count) > 0)
    global S11_OK = (`trc' == 0 & `drc' == 0 & `"${S11_TW}"' != "" & `"${S11_PG}"' == `"${S11_TW}"' & `"${S11_AP}"' == `"${S11_TW}"')
    global S11_WHY `"`id': twoway rc `trc' [${S11_TW}]; dash rc `drc' saved [${S11_PG}] served [${S11_AP}]"'
    capture dash clear
    capture erase "`svg'"
    capture erase "`page'"
    capture erase "`app'"
    capture erase "`work'/s11_`id'.log"
    capture graph drop g
end

// _s11_refuse id cmd: twoway's and dash's rc and first error line.
capture program drop _s11_refuse
program define _s11_refuse
    version 19
    args id work cmd
    quietly sysuse auto, clear
    foreach who in twoway dash {
        capture log close s11r
        quietly log using "`work'/s11r_`who'.log", text replace name(s11r)
        capture noisily `who' `macval(cmd)'
        global S11_RC_`who' = _rc
        quietly log close s11r
        mata: st_global("S11_ERR_`who'", _s11_err(st_local("work") + "/s11r_`who'.log"))
        capture erase "`work'/s11r_`who'.log"
    }
    capture dash clear
end
mata:
string scalar _s11_err(string scalar path)
{
    real scalar   fh
    string scalar ln
    fh = fopen(path, "r")
    while ((ln = fget(fh)) != J(0, 0, "")) {
        ln = strtrim(ln)
        if (ln == "" | substr(ln, 1, 6) == "(note:" | substr(ln, 1, 5) == "name:" | substr(ln, 1, 4) == "log:" | substr(ln, 1, 9) == "log type:" | substr(ln, 1, 10) == "opened on:" | substr(ln, 1, 10) == "closed on:" | substr(ln, 1, 3) == "---") continue
        fclose(fh)
        return(ln)
    }
    fclose(fh)
    return("")
}
end

* ==== S11 P1.1a: Stylelists of style options across an expanded varlist ====
local only : env WP30_ONLY
if inlist("`only'", "", "S11") {
    display as text "S11 start " c(current_date) " " c(current_time)
    local s11_scheme "`c(scheme)'"
    set scheme s2color
    local s11_repo : environment DASH_REPO
    if `"`s11_repo'"' == "" local s11_repo ".."
    global S11_REPO `"`s11_repo'"'
    local two "scatter mpg turn weight"
    local three "scatter mpg turn trunk weight"
    local s11_anynote 0

    // SL-30..SL-35: id data n lines command, both modes against twoway.
    local c30_1 `"T01 auto 2 0 `two', mcolor(red blue) msymbol(O T)"'
    local c31_1 `"T02 auto 2 0 `two', mcolor(red)"'
    local c31_2 `"T03 auto 3 0 `three', mcolor(red blue)"'
    local c31_3 `"T04 auto 2 0 `two', mcolor(red blue green)"'
    local c32_1 `"T05 auto 2 0 `two', mcolor(. blue)"'
    local c32_2 `"T06 auto 3 0 `three', mcolor(red = blue)"'
    local c32_3 `"T07 auto 3 0 `three', mcolor(red ..)"'
    local c32_4 `"T08 auto 3 0 `three', mcolor(red ...)"'
    local c32_5 `"T12 auto 2 0 `two', mcolor(= blue)"'
    local c32_6 `"T13 auto 3 0 `three', mcolor(red..)"'
    local c32_7 `"T15 auto 3 0 `three', mcolor(. ..)"'
    local c32_8 `"T16 auto 3 0 `three', mcolor(red . =)"'
    local c32_9 `"T17 auto 3 0 `three', mcolor(red = = blue)"'
    local c32_10 `"T18 auto 3 0 `three', mcolor(..)"'
    local c33_1 `"T11 auto 2 0 `two', mcolor("255 0 0" "0 0 255")"'
    local c33_2 `"T20 auto 2 0 `two', mcolor(`"red"' blue)"'
    local c33_3 `"T21 auto 2 0 `two', mcolor("" blue)"'
    local c33_4 `"T22 auto 2 0 `two', mcolor(red `""')"'
    local c34_1 `"T10 auto 2 1 line mpg turn weight, sort lpattern(solid dash) lcolor(red blue)"'
    local c34_2 `"W30 auto 2 1 connected mpg turn weight, sort lcolor(red) clcolor(. blue)"'
    local c34_3 `"W36 auto 3 1 line mpg turn trunk weight, sort lcolor(red) lpattern(. dash)"'
    local c34_4 `"U40 sp500 2 1 tsline open close, lcolor(red blue) lpattern(solid dash)"'
    local c35_1 `"T09 auto 1 0 scatter mpg weight, mcolor(red blue)"'
    local c35_2 `"T19 auto 1 0 scatter mpg weight, msymbol(T O)"'
    local c35_3 `"T26 auto 1 1 lfit mpg weight, lcolor(red blue)"'
    local c35_4 `"T32 auto 1 0 scatteri 20 3000 25 4000, mcolor(red blue)"'
    local c35_5 `"T33 auto 1 1 function y=x, range(0 1) lcolor(red blue)"'
    local s11_what30 "T01: each y's colour and marker equal twoway's in both modes"
    local s11_what31 "T02-T04: padding with . and extras ignored, as twoway draws them"
    local s11_what32 "the . = .. ... shorthands draw twoway's colours in both modes"
    local s11_what33 "quoted, compound-quoted and empty elements draw twoway's colours"
    local s11_what34 "line colours and dashes per series equal twoway's (line, connected, tsline)"
    local s11_what35 "a single-y type draws twoway's first element"
    forvalues k = 30/35 {
        local j 1
        while `"`macval(c`k'_`j')'"' != "" {
            gettoken id rest : c`k'_`j'
            gettoken data rest : rest
            gettoken n rest : rest
            gettoken lines rest : rest
            local rest = strtrim(`"`macval(rest)'"')
            _s11_case `id' `data' `n' `lines' "`w30_work'" `"`macval(rest)'"'
            _w30_expect SL-`k' "${S11_OK}" `"${S11_WHY}"'
            if ${S11_NOTE} local s11_anynote 1
            local ++j
        }
        _w30_done SL-`k' "`s11_what`k''"
    }

    // SL-36: by() panels, each drawn red then blue in both modes.
    _s11_case BY auto 2 0 "`w30_work'" `"`two', mcolor(red blue) by(foreign)"'
    local s11_want "#ff0000/circle #0000ff/circle ; #ff0000/circle #0000ff/circle"
    _w30_expect SL-36 `"("${S11_PG}" == "`s11_want'" & "${S11_AP}" == "`s11_want'")"' `"${S11_WHY}"'
    _w30_expect SL-36 `"(strpos("${S11_TW}", "#ff0000/circle #0000ff/circle") == 1)"' `"${S11_WHY}"'
    if ${S11_NOTE} local s11_anynote 1
    _w30_done SL-36 "every by() panel draws each series' element, saved and served"

    // SL-37: none of the builds above printed a not-recognised note.
    _w30_expect SL-37 "(`s11_anynote' == 0)" "a build printed a not a recognised note"
    _w30_done SL-37 "no build of SL-30..SL-36 printed a not-recognised note"

    // SL-38: the refusals' rc and first error line equal twoway's.
    local r_1 `"`two', mcolor(red .. blue)"'
    local r_2 `"`two', mc(red .. blue)"'
    local r_3 `"scatter mpg weight, mcolor(red .. blue)"'
    local r_4 `"`two', msymbol(O .. T)"'
    local r_5 `"`two', mcolor(red .. ..)"'
    local r_6 `"`two', mcolor(red.. ..)"'
    local r_7 `"`two', mcolor(.. red)"'
    local r_8 `"`two', mcolor("red" .. "blue")"'
    local r_9 `"`two', mcolor(red ..) mcolor(blue .. green)"'
    forvalues i = 1/9 {
        _s11_refuse R0`i' "`w30_work'" `"`macval(r_`i')' nodraw"'
        _w30_expect SL-38 `"(${S11_RC_twoway} == 198 & ${S11_RC_dash} == 198)"' `"R0`i': rc twoway ${S11_RC_twoway}, dash ${S11_RC_dash}"'
        mata: st_local("s11_same", strofreal(st_global("S11_ERR_twoway") == st_global("S11_ERR_dash")))
        _w30_expect SL-38 "`s11_same'" `"R0`i': twoway [${S11_ERR_twoway}] dash [${S11_ERR_dash}]"'
    }
    _s11_refuse R16 "`w30_work'" `"`two', mcolor(  red   ..   blue  ) nodraw"'
    mata: st_local("s11_same", strofreal(substr(st_global("S11_ERR_twoway"), strpos(st_global("S11_ERR_twoway"), "):"), .) == substr(st_global("S11_ERR_dash"), strpos(st_global("S11_ERR_dash"), "):"), .)))
    _w30_expect SL-38 `"(${S11_RC_twoway} == 198 & ${S11_RC_dash} == 198 & `s11_same')"' `"R16: twoway ${S11_RC_twoway} [${S11_ERR_twoway}] dash ${S11_RC_dash} [${S11_ERR_dash}]"'
    _w30_done SL-38 "a misplaced .. is refused with twoway's rc and words"

    set scheme `s11_scheme'
    capture graph drop g
    display as text "S11 end " c(current_date) " " c(current_time)
}
* ==== end S11 ====

// S12 helpers (WP-30 P1.27).  _s12_load: twoway's measured answers,
// read from test/fixtures/twoway_command_form_truth.json (and S04's
// saving_chars_truth.json) into the caller's locals through sfi; nothing
// is inlined into Python source.  _s12_said: the error dash's grammar
// prints for a saving() text, by value.
capture program drop _s12_said
program define _s12_said
    version 19
    args text
    mata: st_local("_e", _dash_saving_split(st_local("text"))[5])
    c_local s12_said `"`macval(_e)'"'
end
python:
def _s12_load():
    import json, os
    from sfi import Macro
    def put(k, v):
        Macro.setLocal(k, str(v).replace("\\x60", "\x60"))
    with open(os.path.join("fixtures", "twoway_command_form_truth.json"),
              encoding="utf-8") as fh:
        d = json.load(fh)
    m = d["_meta"]
    put("s12_meta_ok", int(all(k in m for k in ("stata_version", "born_date",
                                                  "dash_commit", "extracted"))))
    put("s12_mode", m.get("mode", ""))
    put("s12_np", len(d["prefix"]))
    for i, r in enumerate(d["prefix"], 1):
        put("s12_ph%d" % i, r["head"])
        put("s12_prc%d" % i, r["rc"])
        put("s12_plast%d" % i, r["last"])
    put("s12_ns", len(d["saving"]))
    for i, r in enumerate(d["saving"], 1):
        put("s12_st%d" % i, r["text"])
        put("s12_src%d" % i, r["rc"])
        put("s12_slast%d" % i, r["last"])
        fl = [f[:-4] + ".html" if f.lower().endswith(".gph") else f
              for f in r["files"]]
        put("s12_snf%d" % i, len(fl))
        for k, f in enumerate(fl, 1):
            put("s12_sf%d_%d" % (i, k), f)
    with open(os.path.join("fixtures", "saving_chars_truth.json"),
              encoding="utf-8") as fh:
        c = json.load(fh)["probes"]
    keys = [k for k in ("semi", "amp", "pipe", "lt", "gt", "dotdot")
            if k in c and c[k]["rc"] == 0 and c[k]["written"]]
    put("s12_nc", len(keys))
    for i, k in enumerate(keys, 1):
        f = c[k]["file"]
        put("s12_cf%d" % i, f[:-4] + ".html" if f.endswith(".gph") else f)

_s12_ready = True
end

* ==== S12 P1.27: Drop-in command form and saving() grammar ====
local only : env WP30_ONLY
if inlist("`only'", "", "S12") {
    display as text "S12 start " c(current_date) " " c(current_time)
    // twoway's answers come from the fixture (scripts/
    // extract_twoway_command_form_truth.do), measured in batch.
    python: import __main__; __main__._s12_load()
    qui sysuse auto, clear
    quietly dash clear

    // CF-08 (guard) -- the fixture is stamped and was measured in batch.
    _w30_expect "CF-08" `s12_meta_ok' "the fixture's _meta lacks a stamp key"
    local _ok = ("`s12_mode'" == "batch")
    _w30_expect "CF-08" `_ok' "the fixture was not measured in batch"
    _w30_done "CF-08" "the fixture's _meta is whole and was measured in batch"

    // CF-01 -- every head twoway takes (rc 0) draws the unprefixed graph.
    // "Graph twoway" is skipped: rc 0 only because macOS's file system
    // finds graph.ado under Graph; dash refuses a capitalised prefix r(199),
    // as Stata does on a case-sensitive file system.
    quietly dash scatter mpg weight, name(cf0)
    local cfn = 0
    forvalues i = 1/`s12_np' {
        local h `"`s12_ph`i''"'
        if `"`h'"' == "" | `"`h'"' == "Graph twoway" | `s12_prc`i'' != 0 continue
        local ++cfn
        capture noisily dash `h' scatter mpg weight, name(cf`cfn')
        _w30_expect "CF-01" `=_rc == 0' `"dash `h' scatter mpg weight: rc `=_rc'"'
        mata: st_local("_cfa", subinstr(st_global("dash_json_cf0"), char(34) + "cf0" + char(34), char(34) + "cf`cfn'" + char(34)))
        mata: st_local("_cfe", strofreal(st_local("_cfa") == st_global("dash_json_cf`cfn'")))
        _w30_expect "CF-01" `_cfe' `"dash `h' draws another graph than the unprefixed command"'
    }
    _w30_expect "CF-01" `=`cfn' >= 10' "fewer than ten prefix heads in the fixture"
    local 0 "tw scatter mpg weight"
    mata: _dash_strip_prefix()
    local _ok = ("`_pf_kind'" == "strip")
    _w30_expect "CF-01" `_ok' "_dash_strip_prefix did not strip tw"
    quietly dash twoway (scatter mpg weight) (lfit mpg weight), name(cfpa)
    quietly dash twoway(scatter mpg weight), name(cfpc)
    quietly dash gr tw scatter mpg weight || lfit mpg weight, name(cfpd)
    _w30_done "CF-01" "every prefix twoway takes is read off once and draws the unprefixed graph"

    // CF-02 -- every head twoway refuses r(199): dash r(199), in Stata's
    // words (for TWOWAY, Twoway and GR, the words of a case-sensitive file
    // system: "command TWOWAY is unrecognized").
    forvalues i = 1/`s12_np' {
        if `s12_prc`i'' != 199 continue
        local h `"`s12_ph`i''"'
        capture dash `h' scatter mpg weight
        _w30_expect "CF-02" `=_rc == 199' `"dash `h': rc `=_rc', want 199"'
        local 0 `"`h' scatter mpg weight"'
        mata: _dash_strip_prefix()
        local _w : word 1 of `h'
        local _want `"`s12_plast`i''"'
        if strlower("`_w'") != "`_w'" local _want "command `_w' is unrecognized"
        mata: st_local("_ok", strofreal("command " + st_local("_pf_word") + " is unrecognized" == st_local("_want")))
        _w30_expect "CF-02" `_ok' `"dash `h' says another message than `_want'"'
    }
    _w30_done "CF-02" "every prefix Stata refuses is refused r(199) in its words"

    // CF-03 -- every doubled prefix: r(198), twoway's words.
    forvalues i = 1/`s12_np' {
        if `s12_prc`i'' != 198 continue
        local h `"`s12_ph`i''"'
        capture dash `h' scatter mpg weight
        _w30_expect "CF-03" `=_rc == 198' `"dash `h': rc `=_rc', want 198"'
        local 0 `"`h' scatter mpg weight"'
        mata: _dash_strip_prefix()
        mata: st_local("_ok", strofreal(st_local("_pf_word") + " is not a twoway plot type" == st_local("s12_plast`i'")))
        _w30_expect "CF-03" `_ok' `"dash `h' says another message than twoway"'
    }
    _w30_done "CF-03" "a second prefix word is refused r(198) in twoway's words"

    // CF-04 (guard) -- a prefix never makes a subcommand.
    local _cfreg "${dash_graph_registry}"
    capture dash twoway build, saving(x.html)
    _w30_expect "CF-04" `=_rc == 198' "dash twoway build was not refused"
    capture dash tw kpi mean(mpg), name(k)
    _w30_expect "CF-04" `=_rc == 198' "dash tw kpi was not refused"
    capture dash two clear
    _w30_expect "CF-04" `=_rc == 198' "dash two clear was not refused"
    mata: st_local("_ok", strofreal(st_global("dash_graph_registry") == st_local("_cfreg")))
    _w30_expect "CF-04" `_ok' "a prefixed subcommand changed the registry"
    capture dash graph scatter mpg weight
    _w30_expect "CF-04" `=_rc == 198' "dash graph scatter was not refused"
    _w30_done "CF-04" "a prefix never routes to a subcommand"
    quietly dash clear

    // CF-05 -- every saving() text: dash's one-line form, in an empty
    // folder, as twoway: rc, words, and the files (.gph as .html).
    local pwd5 "`c(pwd)'"
    forvalues i = 1/`s12_ns' {
        local d5 "`w30_work'/cf5_`i'"
        mkdir "`d5'"
        quietly cd "`d5'"
        capture dash scatter mpg weight, saving(`s12_st`i'')
        local rc5 = _rc
        quietly cd "`pwd5'"
        local t `"`s12_st`i''"'
        local tw5 = `s12_src`i''
        _w30_expect "CF-05" `=(`rc5' == 0) == (`tw5' == 0)' `"saving(`macval(t)'): dash rc `rc5', twoway rc `tw5'"'
        if `tw5' != 0 {
            _s12_said `"`macval(t)'"'
            local _l5 `"`s12_slast`i''"'
            mata: st_local("_ok", strofreal(st_local("s12_said") == st_local("_l5")))
            _w30_expect "CF-05" `_ok' `"saving(`macval(t)'): dash says another message"'
        }
        local fl : dir "`d5'" files "*"
        local nfl : word count `fl'
        local nf5 = `s12_snf`i''
        _w30_expect "CF-05" `=`nfl' == `nf5'' `"saving(`macval(t)'): dash wrote `nfl' files, twoway `nf5'"'
        forvalues k = 1/`nf5' {
            local f5 `"`s12_sf`i'_`k''"'
            capture confirm file `"`d5'/`f5'"'
            _w30_expect "CF-05" `=_rc == 0' `"saving(`macval(t)'): no `f5'"'
        }
        foreach f of local fl {
            capture erase `"`d5'/`f'"'
        }
        capture rmdir "`d5'"
    }
    _w30_done "CF-05" "every saving() text of the fixture behaves as twoway's"

    // CF-06 -- S04's path characters and .. segment twoway wrote.
    local d6 "`w30_work'/cf6"
    mkdir "`d6'"
    mkdir "`d6'/sub"
    forvalues i = 1/`s12_nc' {
        local f6 `"`d6'/`s12_cf`i''"'
        capture dash scatter mpg weight, saving(`"`f6'"')
        _w30_expect "CF-06" `=_rc == 0' `"saving(`f6'): rc `=_rc'"'
        capture confirm file `"`f6'"'
        _w30_expect "CF-06" `=_rc == 0' `"`f6' not written"'
        capture erase `"`f6'"'
    }
    _w30_expect "CF-06" `=`s12_nc' == 6' "the S04 fixture lacks one of ; & | < > .."
    capture rmdir "`d6'/sub"
    capture rmdir "`d6'"
    _w30_done "CF-06" "dash writes every path character and .. segment twoway wrote"

    // CF-07 -- the saved one-line page of a prefixed command.
    local cf7 "`w30_work'/cf7.html"
    capture erase "`cf7'"
    capture noisily dash twoway scatter mpg weight, saving("`cf7'")
    _w30_expect "CF-07" `=_rc == 0' "dash twoway ..., saving() failed"
    capture confirm file "`cf7'"
    _w30_expect "CF-07" `=_rc == 0' "the page was not written"
    capture erase "`cf7'"
    _w30_done "CF-07" "dash twoway ..., saving() writes and announces the page"
    quietly dash clear
    display as text "S12 end " c(current_date) " " c(current_time)
}
* ==== end S12 ====

