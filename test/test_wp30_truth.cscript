*! test_wp30_truth.cscript
*! WP-30's ONE new certification script (.ultraplan/wp30/index.md A142):
*! every comparison with twoway's drawing or with Stata's own values that
*! WP-30's sections need lives here, one block per section, in section
*! order, so the certification suite grows by one script.  Refusal,
*! message and return-code checks join the EXISTING script for their area
*! instead (index.md merge rule R1); this script never gains one of those.
*!
*! S01 is the scaffold smoke (TF-01).  S02-S57 each own the block their
*! header names, a stub until that section fills it with its own cases
*! (its case-id prefix: index.md "Section manifest").  A section writes
*! only inside its own block, its helper programs directly above its own
*! header, and a second block of its own directly below its own end line.
*!
*! Usage: via run_all_cscripts.do (registered as its block 69).  One
*! block alone: set WP30_ONLY=S<NN> in the environment of the driver run
*! (index.md "The cscript driver"); a block with no case yet then ends
*! "no case ran" and r(9).  Each block prints "S<NN> start" and
*! "S<NN> end" with the date and time, so the closeout can time it.

cscript "WP-30 truth: twoway comparisons" adodir ".."

clear all
set more off

if `"`c(python_exec)'"' == "" {
    display as error "SKIP: Python not available."
    exit 222
}

do "cert_helpers.do"
quietly do "cert_svg.do"
qui do "../dash_parse.mata"
qui do "../dash.ado"
global dash_nobrowser 1

// ----------------------------------------------------------------
// Tally helpers -- test_wp29_truth.cscript's _w29_expect/_w29_done,
// renamed _w30_ for this script.  A case is any number of
// _w30_expect lines closed by one _w30_done.
// ----------------------------------------------------------------
global w30_nfail    = 0
global w30_faillist ""
global w30_bad      = 0
global w30_ncase    = 0

capture program drop _w30_expect
program define _w30_expect
    version 19
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global w30_bad = 1
    }
end

capture program drop _w30_done
program define _w30_done
    version 19
    args id msg
    if ${w30_bad} {
        global w30_nfail    = ${w30_nfail} + 1
        global w30_faillist "${w30_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global w30_bad   = 0
    global w30_ncase = ${w30_ncase} + 1
end

// A fresh directory for this run's files, never one that already exists:
// a fixed name in a shared temp directory could be planted by another
// account (rule 1), so a name Stata has not handed out before is made and
// the run fails if it cannot be.  Every block writes only under it.
tempfile w30_base
local w30_work "`w30_base'_w30"
capture mkdir "`w30_work'"
if _rc {
    display as error "test_wp30_truth: cannot create the work directory `w30_work' (rc `=_rc')"
    exit 9
}

* ==== S01 scaffold: the helpers load and a twoway SVG is read ====
local only : env WP30_ONLY
if inlist("`only'", "", "S01") {
    display as text "S01 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // TF-01: cert_svg_export and cert_svg_texts on one twoway scatter,
    // and dash's own programs are loaded from this tree.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(w30s01, replace)
    cert_svg_export, name(w30s01) file("`w30_work'/w30s01.svg")
    local s01_rc   = r(rc)
    local s01_file "`r(file)'"
    _w30_expect TF-01 "(`s01_rc' == 0)" "cert_svg_export rc `s01_rc'"
    capture confirm file "`s01_file'"
    _w30_expect TF-01 "(_rc == 0)" "r(file) `s01_file' does not exist"
    cert_svg_texts, file("`s01_file'")
    local s01_n    = r(n)
    local s01_list "`r(list)'"
    _w30_expect TF-01 "(`s01_n' > 0)" "cert_svg_texts found no text elements"
    capture program list _dash_serve
    _w30_expect TF-01 "(_rc == 0)" "dash.ado's _dash_serve is not loaded"
    _w30_done TF-01 "a twoway SVG was written and read (`s01_n' texts); dash is loaded"

    capture erase "`s01_file'"
    capture erase "`s01_list'"
    capture graph drop w30s01
    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====

// ----------------------------------------------------------------
// S02 helpers (WP-30 P1.34): the runner's root block, read from
// run_all_cscripts.do between its markers and run as a do-file.
// ----------------------------------------------------------------
capture mata: mata drop _s02_root_lines()
capture mata: mata drop _s02_trim()
mata:
// Copies the lines strictly between "// ---- root: begin" and
// "// ---- root: end" of src to dst; returns their count (0 when either
// marker is missing, and then nothing is written).
real scalar _s02_root_lines(string scalar src, string scalar dst)
{
    string colvector L
    real scalar i, b, e, fh
    L = cat(src)
    b = 0
    e = 0
    for (i = 1; i <= rows(L); i++) {
        if (b == 0 & strpos(L[i], "// ---- root: begin") == 1) b = i
        else if (b > 0 & e == 0 & strpos(L[i], "// ---- root: end") == 1) e = i
    }
    if (b == 0 | e <= b + 1) return(0)
    fh = fopen(dst, "w")
    for (i = b + 1; i < e; i++) fput(fh, L[i])
    fclose(fh)
    return(e - b - 1)
}
// s without its trailing slashes (one character kept).
string scalar _s02_trim(string scalar s)
{
    while (strlen(s) > 1 & substr(s, -1, 1) == "/") s = substr(s, 1, strlen(s) - 1)
    return(s)
}
end

capture program drop _s02_realdir
program define _s02_realdir, rclass
    version 19
    args dir
    local here `"`c(pwd)'"'
    quietly cd `"`dir'"'
    return local dir `"`c(pwd)'"'
    quietly cd `"`here'"'
end

capture program drop _s02_run_root
program define _s02_run_root, rclass
    version 19
    args block cwd
    local ado0 `"$S_ADO"'
    local pwd0 `"`c(pwd)'"'
    if `"`cwd'"' != "" quietly cd `"`cwd'"'
    // quietly: a refused root's error and r() lines stay out of the log;
    // the rc is what each case checks.
    capture quietly do `"`block'"'
    local rc = _rc
    local pwd `"`c(pwd)'"'
    local fn ""
    if `rc' == 0 {
        capture quietly findfile dash.ado
        if _rc == 0 local fn `"`r(fn)'"'
    }
    global S_ADO `"`macval(ado0)'"'
    quietly cd `"`pwd0'"'
    return scalar rc = `rc'
    return local pwd `"`pwd'"'
    return local fn `"`fn'"'
end

// One RR case: the root block run with DASH_REPO as the caller set it,
// from cwd; rc must be wrc and, when want is given, the run must have
// cd'd to want and found want/dash.ado.  ok is RR-01's flag: without the
// block, the case fails without running.
capture program drop _s02_case
program define _s02_case
    version 19
    args id ok blk cwd wrc want msg
    _w30_expect `id' "`ok'" "RR-01 failed, so the root block was not run"
    if `ok' {
        _s02_run_root `"`blk'"' `"`cwd'"'
        local rc = r(rc)
        local pwd `"`r(pwd)'"'
        local fn `"`r(fn)'"'
        _w30_expect `id' "`rc' == `wrc'" "rc `rc', expected `wrc'"
        if `"`want'"' != "" {
            local same = (`"`pwd'"' == `"`want'"')
            _w30_expect `id' "`same'" "r(pwd) is `pwd', expected `want'"
            local same = (`"`fn'"' == `"`want'/dash.ado"')
            _w30_expect `id' "`same'" "dash.ado resolves to `fn', expected `want'/dash.ado"
        }
    }
    _w30_done `id' `"`msg'"'
end

* ==== S02 P1.34: Portable runners ====
local only : env WP30_ONLY
if inlist("`only'", "", "S02") {
    display as text "S02 start " c(current_date) " " c(current_time)
    local s02_env0 : environment DASH_REPO

    // tree: the directory the driver cd'd to, less its /test.
    local s02_here `"`c(pwd)'"'
    local s02_intest = (substr(`"`s02_here'"', -5, 5) == "/test")
    local s02_tree = substr(`"`s02_here'"', 1, strlen(`"`s02_here'"') - 5)

    // scr: two trees of the RR cases, under this run's own directory.
    local s02_scr "`w30_work'/s02_rr"
    capture mkdir "`s02_scr'"
    capture mkdir "`s02_scr'/notree"
    capture mkdir "`s02_scr'/my tree"
    capture mkdir "`s02_scr'/my tree/test"
    tempname s02_fh
    file open `s02_fh' using "`s02_scr'/my tree/dash.ado", write text replace
    file close `s02_fh'
    file open `s02_fh' using "`s02_scr'/my tree/test/run_all_cscripts.do", write text replace
    file close `s02_fh'
    _s02_realdir "`s02_scr'"
    local s02_scr `"`r(dir)'"'

    // ------------------------------------------------------------
    // RR-01: the runner's root block is there, reads DASH_REPO and
    // names no home directory; the paths this block hands it are clean.
    // ------------------------------------------------------------
    local s02_blk "`w30_work'/s02_root.do"
    mata: st_local("s02_n", strofreal(_s02_root_lines("run_all_cscripts.do", st_local("s02_blk"))))
    local s02_hasenv 0
    local s02_home 0
    if `s02_n' > 0 {
        mata: st_local("s02_hasenv", strofreal(strpos(invtokens(cat(st_local("s02_blk"))', char(10)), ": environment DASH_REPO") > 0))
        mata: st_local("s02_home", strofreal(strpos(invtokens(cat(st_local("s02_blk"))', char(10)), "/" + "Users/") + strpos(invtokens(cat(st_local("s02_blk"))', char(10)), "/" + "home/") > 0))
    }
    mata: st_local("s02_badpath", strofreal(any(strpos(st_local("s02_tree") + c("tmpdir") + st_local("s02_scr"), (char(34), char(36), char(39), char(96), char(10), char(13))))))
    _w30_expect RR-01 "`s02_n' >= 10" "the root block between run_all_cscripts.do's markers has `s02_n' lines"
    _w30_expect RR-01 "`s02_hasenv'" "the root block does not read : environment DASH_REPO"
    _w30_expect RR-01 "!`s02_home'" "the root block names a home directory"
    _w30_expect RR-01 "!`s02_badpath'" "the tree, c(tmpdir) or the scratch directory holds a quote, dollar sign, backtick or line break"
    _w30_done RR-01 "the runner's root block was read (`s02_n' lines)"
    local s02_ok = (`s02_n' >= 10) & `s02_hasenv' & !`s02_home' & !`s02_badpath'

    // ------------------------------------------------------------
    // RR-02: the run tests the tree it was handed.
    // ------------------------------------------------------------
    mata: st_local("s02_named", strofreal(_s02_trim(st_local("s02_env0")) == "" | _s02_trim(st_local("s02_env0")) == st_local("s02_tree")))
    _w30_expect RR-02 "`s02_intest'" "the driver did not cd to <tree>/test (c(pwd) is `s02_here')"
    _w30_expect RR-02 "`s02_named'" "DASH_REPO does not name the tree under test, `s02_tree'"
    _w30_done RR-02 "the run tests the tree it was handed, `s02_tree'"

    // ------------------------------------------------------------
    // RR-03..RR-14: the root block under each DASH_REPO and directory.
    // ------------------------------------------------------------
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_tree")
    _s02_case RR-03 `s02_ok' "`s02_blk'" "" 0 "`s02_tree'" "DASH_REPO=<tree> from test/: the tree is tested"
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_tree") + "/"
    _s02_case RR-04 `s02_ok' "`s02_blk'" "" 0 "`s02_tree'" "DASH_REPO=<tree>/ from test/: the trailing slash is dropped"
    python: import os; os.environ.pop("DASH_REPO", None)
    _s02_case RR-05 `s02_ok' "`s02_blk'" "`s02_tree'" 0 "`s02_tree'" "DASH_REPO unset from <tree>: the current directory is tested"
    _s02_case RR-06 `s02_ok' "`s02_blk'" "`s02_scr'/notree" 601 "" "DASH_REPO unset from a directory that is no dash tree: r(601)"
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_scr") + "/co" + chr(36) + "py"
    _s02_case RR-07 `s02_ok' "`s02_blk'" "" 198 "" "a dollar sign in DASH_REPO: r(198)"
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_scr") + "/co" + chr(96) + "py"
    _s02_case RR-08 `s02_ok' "`s02_blk'" "" 198 "" "a backtick in DASH_REPO: r(198)"
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_scr") + "/co" + chr(34) + "py"
    _s02_case RR-09 `s02_ok' "`s02_blk'" "" 198 "" "a double quote in DASH_REPO: r(198)"
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_scr") + "/co" + chr(39) + "py"
    _s02_case RR-10 `s02_ok' "`s02_blk'" "" 198 "" "a single quote in DASH_REPO: r(198)"
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_scr") + "/co" + chr(10) + "py"
    _s02_case RR-11 `s02_ok' "`s02_blk'" "" 198 "" "a line feed in DASH_REPO: r(198)"
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_scr") + "/co" + chr(13) + "py"
    _s02_case RR-12 `s02_ok' "`s02_blk'" "" 198 "" "a carriage return in DASH_REPO: r(198)"
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_scr") + "/notree"
    _s02_case RR-13 `s02_ok' "`s02_blk'" "" 601 "" "DASH_REPO naming a directory that is no dash tree: r(601)"
    python: import os; from sfi import Macro; os.environ["DASH_REPO"] = Macro.getLocal("s02_scr") + "/my tree"
    _s02_case RR-14 `s02_ok' "`s02_blk'" "" 0 "`s02_scr'/my tree" "DASH_REPO naming a tree with a space: that tree is tested"

    capture erase "`s02_scr'/my tree/test/run_all_cscripts.do"
    capture erase "`s02_scr'/my tree/dash.ado"
    capture rmdir "`s02_scr'/my tree/test"
    capture rmdir "`s02_scr'/my tree"
    capture rmdir "`s02_scr'/notree"
    capture rmdir "`s02_scr'"
    capture erase "`s02_blk'"
    python: import os; from sfi import Macro; v = Macro.getLocal("s02_env0"); os.environ.pop("DASH_REPO", None) if v == "" else os.environ.__setitem__("DASH_REPO", v)
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

// S03 helper: a program at a version no Stata runs.  It is stored and never
// runs: SF-01 measures the code Stata gives when it is called.  Its
// `version 99' is the measurement, so it is the one helper of this script
// that does not declare version 19.
capture program drop _s03_future
program define _s03_future
    version 99
end

* ==== S03 P1.35: Stata 19 floor declared and enforced ====
local only : env WP30_ONLY
if inlist("`only'", "", "S03") {
    display as text "S03 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // SF-01: Stata's own return code for a version it cannot run.
    // dash's refusal uses the same code (test_env_guards.cscript
    // ENV-25, ENV-28, ENV-29).
    // ------------------------------------------------------------
    capture _s03_future
    local sf01 = _rc
    _w30_expect SF-01 "(`sf01' == 9)" "a program at version 99 gave rc `sf01', not 9"
    _w30_done SF-01 "Stata refuses a version it cannot run with rc `sf01', the code dash's floor uses"

    // ------------------------------------------------------------
    // SF-02: with no caller version recorded, _dash_fn_points falls back
    // to dash's own level, now 19; the points are those of a caller at 16.
    // ------------------------------------------------------------
    sysuse auto, clear
    capture program list _dash_fn_points
    local sf02ld = _rc
    _w30_expect SF-02 "(`sf02ld' == 0)" "dash.ado is not loaded by do"
    if `sf02ld' == 0 {
        tempname sf02r sf02a sf02b
        foreach e in "y = runiform()" "y = normalden(x)" {
            mata: st_strscalar(st_local("sf02r"), st_local("e"))
            mata: st_strscalar(st_local("sf02a"), "")
            mata: st_strscalar(st_local("sf02b"), "")
            set seed 20261003
            global dash__uv 16
            capture noisily _dash_fn_points `sf02r' -2 2 5 1 `sf02a'
            local sf02rca = _rc
            set seed 20261003
            macro drop dash__uv
            capture noisily _dash_fn_points `sf02r' -2 2 5 1 `sf02b'
            local sf02rcb = _rc
            local sf02cv "`._Gr_Global.callerver'"
            local sf02cvok = ("`sf02cv'" == "19")
            mata: st_local("sf02same", strofreal(st_strscalar(st_local("sf02a")) == st_strscalar(st_local("sf02b"))))
            _w30_expect SF-02 "(`sf02rca' == 0 & `sf02rcb' == 0)" "`e': rc `sf02rca' at 16, rc `sf02rcb' at the fallback"
            _w30_expect SF-02 "(`sf02same' == 1)" "`e': the points at 16 and at the fallback differ"
            _w30_expect SF-02 "(`sf02cvok' == 1)" "`e': the fallback's callerver is `sf02cv', not 19"
        }
    }
    _w30_done SF-02 "the callerver fallback reads 19 and the points equal a version 16 caller's, seeded runiform() and normalden(x)"

    // ------------------------------------------------------------
    // SF-03: a caller at version 16 keeps its own version (guard).
    // ------------------------------------------------------------
    capture dash clear
    capture noisily version 16: dash function y = normalden(x), range(-2 2) n(5) name(sf03)
    local sf03rc = _rc
    local sf03cv "`._Gr_Global.callerver'"
    local sf03cvok = ("`sf03cv'" == "16")
    mata: st_local("sf03pts", strofreal(strpos(st_global("dash_fpts_sf03"), "0.053990966513188049,0.24197072451914334,0.39894228040143265") > 0))
    _w30_expect SF-03 "(`sf03rc' == 0)" "version 16: dash function gave rc `sf03rc'"
    _w30_expect SF-03 "(`sf03cvok' == 1)" "the function layer ran at callerver `sf03cv', not 16"
    _w30_expect SF-03 "(`sf03pts' == 1)" "the normalden points were not the measured ones"
    _w30_done SF-03 "a version 16 caller's function layer is evaluated at 16, with the measured points"
    capture dash clear

    // ------------------------------------------------------------
    // SF-04: the certifying Stata is at or above the floor, and dash's
    // guard and comparator say so.
    // ------------------------------------------------------------
    local sf04v = (c(stata_version) >= 19)
    capture noisily _dash_require_stata
    local sf04g = _rc
    capture _dash_stata_ok "`c(stata_version)'" "19"
    local sf04c = _rc
    local sf04ok = r(ok)
    if `sf04c' != 0 local sf04ok = .
    _w30_expect SF-04 "(`sf04v' == 1)" "this Stata, `c(stata_version)', is below the floor"
    _w30_expect SF-04 "(`sf04g' == 0)" "_dash_require_stata gave rc `sf04g'"
    _w30_expect SF-04 "(`sf04c' == 0)" "_dash_stata_ok gave rc `sf04c'"
    _w30_expect SF-04 "(`sf04ok' == 1)" "_dash_stata_ok answered `sf04ok' for this Stata"
    display as text "SF-04: certified on Stata `c(stata_version)' `c(edition_real)'"
    _w30_done SF-04 "the certifying Stata is at or above the floor and dash's guard passes it"

    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

// S04's helper: twoway's recorded saving() result for one character, from
// test/fixtures/saving_chars_truth.json (scripts/extract_saving_chars_truth.do),
// into the globals CSP_RC, CSP_W and CSP_STEM.  Read relative to the
// working directory, test/.  S12 reads the same fixture.
python:
import json as _csp_json
def _csp_truth(key):
    from sfi import Macro
    with open("fixtures/saving_chars_truth.json", encoding="utf-8") as fh:
        rec = _csp_json.load(fh)["probes"][key]
    f = rec["file"]
    Macro.setGlobal("CSP_RC", str(int(rec["rc"])))
    Macro.setGlobal("CSP_W", "1" if rec["written"] else "0")
    Macro.setGlobal("CSP_STEM", f[len("tw_"):-len(".gph")])
end
* ==== S04 P1.29: CSP without 'unsafe-inline'; safe Windows opener ====
local only : env WP30_ONLY
if inlist("`only'", "", "S04") {
    display as text "S04 start " c(current_date) " " c(current_time)
    // CSP-01..04: dash's saving() writes a name holding %, !, %% or ^ as
    // typed, as twoway's does (P1.29; only dash's Windows opener declines
    // such a path).
    quietly sysuse auto, clear
    local s04_chars `" "%" "!" "%%" "^" "'
    local s04_i 0
    foreach key in pct_path bang pct_pct caret {
        local ++s04_i
        local id "CSP-0`s04_i'"
        local s04_c : word `s04_i' of `s04_chars'
        python: __import__("__main__")._csp_truth("`key'")
        local s04_page "`w30_work'/d_${CSP_STEM}.html"
        capture erase "`s04_page'"
        capture noisily dash scatter mpg weight, saving("`s04_page'", replace)
        local s04_rc = _rc
        capture confirm file "`s04_page'"
        local s04_w = (_rc == 0)
        _w30_expect `id' "(`s04_rc' == ${CSP_RC})" "dash gave rc `s04_rc', twoway ${CSP_RC}"
        _w30_expect `id' "(`s04_w' == ${CSP_W})" "dash wrote the page: `s04_w'; twoway wrote its file: ${CSP_W}"
        _w30_done `id' "saving() with `s04_c' is written as typed, as twoway writes it"
        capture erase "`s04_page'"
    }
    macro drop CSP_RC CSP_W CSP_STEM
    capture dash clear
    display as text "S04 end " c(current_date) " " c(current_time)
}
* ==== end S04 ====

* ==== S05 P1.33: Measured Python floor ====
local only : env WP30_ONLY
if inlist("`only'", "", "S05") {
    display as text "S05 start " c(current_date) " " c(current_time)
    // PYF-03: the linked interpreter is at or above the declared floor.
    capture program list _dash_pyver_ok
    if _rc quietly do "../dash_setup.ado"
    _dash_pymin
    local s05_min "`r(pymin)'"
    python: import sys, sfi; sfi.Macro.setLocal("s05_ver", "%d.%d.%d" % tuple(sys.version_info[:3]))
    _dash_pyver_ok "`s05_ver'" "`s05_min'"
    local s05_ok = r(ok)
    _w30_expect PYF-03 "(`s05_ok' == 1)" "Python `s05_ver' is below the declared floor `s05_min'"
    _w30_done PYF-03 "Python `s05_ver' is at or above the declared floor `s05_min'"
    // PYF-04: the served app's child starts as dash serve starts it,
    // sys.executable -P, in safe-path mode.
    python: import subprocess, sys, sfi; _s05_r = subprocess.run([sys.executable, "-P", "-c", "import sys; print(int(sys.flags.safe_path))"], capture_output=True, text=True, timeout=60); sfi.Macro.setLocal("s05_child", "%d %s" % (_s05_r.returncode, _s05_r.stdout.strip()))
    local s05_c = ("`s05_child'" == "0 1")
    _w30_expect PYF-04 "(`s05_c' == 1)" "sys.executable -P gave `s05_child', wanted 0 1"
    _w30_done PYF-04 "sys.executable -P starts a child in safe-path mode (rc 0, safe_path 1)"
    display as text "S05 end " c(current_date) " " c(current_time)
}
* ==== end S05 ====

* ==== S06 P1.26a: One note channel ====
local only : env WP30_ONLY
if inlist("`only'", "", "S06") {
    display as text "S06 start " c(current_date) " " c(current_time)

    // twoway's measured channels (section 06, Stata truth p1-p4): a
    // named-style note shows under quietly and capture hides it; the
    // estimator note "(note:  regress could not fit model)" is plain
    // text, which quietly hides.  dash's notes take the same channels.
    // Each command runs under a named text log of its own, counted with
    // cert_log_has (wrapped lines re-joined), r(count) copied at once.
    sysuse auto, clear
    capture dash clear
    local s06_page "`w30_work'/wp30_s06.html"
    capture log close s06nc

    // ------------------------------------------------------------
    // NC-01: the named-style class.  twoway's note and dash's note both
    // show under quietly, and capture hides both.
    // ------------------------------------------------------------
    log using "`w30_work'/wp30_s06_1.log", text replace name(s06nc)
    quietly twoway scatter mpg weight, mcolor(notacolor) nodraw
    log close s06nc
    cert_log_has "`w30_work'/wp30_s06_1.log", needle("(note:")
    local s06_n1 = r(count)
    log using "`w30_work'/wp30_s06_2.log", text replace name(s06nc)
    capture twoway scatter mpg weight, mcolor(notacolor) nodraw
    log close s06nc
    cert_log_has "`w30_work'/wp30_s06_2.log", needle("(note:")
    local s06_n2 = r(count)
    log using "`w30_work'/wp30_s06_3.log", text replace name(s06nc)
    quietly dash scatter mpg weight, mcolor(notacolor) saving("`s06_page'", replace)
    log close s06nc
    cert_log_has "`w30_work'/wp30_s06_3.log", needle("(note:  dash: ")
    local s06_n3 = r(count)
    log using "`w30_work'/wp30_s06_4.log", text replace name(s06nc)
    capture dash scatter mpg weight, mcolor(notacolor) saving("`s06_page'", replace)
    local s06_rc4 = _rc
    log close s06nc
    cert_log_has "`w30_work'/wp30_s06_4.log", needle("(note:")
    local s06_n4 = r(count)
    cert_log_has "`w30_work'/wp30_s06_4.log", needle("Warning:")
    local s06_w4 = r(count)
    _w30_expect NC-01 "(`s06_n1' >= 1)" "quietly twoway logged `s06_n1' (note: lines"
    _w30_expect NC-01 "(`s06_n2' == 0)" "capture twoway logged `s06_n2' (note: lines"
    _w30_expect NC-01 "(`s06_n3' >= 1)" "quietly dash logged `s06_n3' (note:  dash: lines"
    _w30_expect NC-01 "(`s06_rc4' == 0 & `s06_n4' == 0 & `s06_w4' == 0)" "capture dash (rc `s06_rc4') logged `s06_n4' (note: and `s06_w4' Warning: lines"
    _w30_done NC-01 "a named-style note shows under quietly and capture hides it, for twoway and for dash"

    // ------------------------------------------------------------
    // NC-02: the estimator class.  twoway prints its could-not-fit note
    // once, as plain text that quietly hides; dash's copy does the same.
    // ------------------------------------------------------------
    log using "`w30_work'/wp30_s06_5.log", text replace name(s06nc)
    twoway (scatter mpg weight) (lfit mpg weight if price > 20000), nodraw
    log close s06nc
    cert_log_has "`w30_work'/wp30_s06_5.log", needle("could not fit model")
    local s06_n5 = r(count)
    log using "`w30_work'/wp30_s06_6.log", text replace name(s06nc)
    quietly twoway (scatter mpg weight) (lfit mpg weight if price > 20000), nodraw
    log close s06nc
    cert_log_has "`w30_work'/wp30_s06_6.log", needle("could not fit model")
    local s06_n6 = r(count)
    log using "`w30_work'/wp30_s06_7.log", text replace name(s06nc)
    capture noisily dash (scatter mpg weight) (lfit mpg weight if price > 20000), saving("`s06_page'", replace)
    local s06_rc7 = _rc
    log close s06nc
    cert_log_has "`w30_work'/wp30_s06_7.log", needle("could not fit model")
    local s06_n7 = r(count)
    log using "`w30_work'/wp30_s06_8.log", text replace name(s06nc)
    quietly dash (scatter mpg weight) (lfit mpg weight if price > 20000), saving("`s06_page'", replace)
    log close s06nc
    cert_log_has "`w30_work'/wp30_s06_8.log", needle("could not fit model")
    local s06_n8 = r(count)
    _w30_expect NC-02 "(`s06_n5' == 1)" "twoway logged `s06_n5' could-not-fit lines"
    _w30_expect NC-02 "(`s06_n6' == 0)" "quietly twoway logged `s06_n6' could-not-fit lines"
    _w30_expect NC-02 "(`s06_rc7' == 0 & `s06_n7' == 1)" "dash (rc `s06_rc7') logged `s06_n7' could-not-fit lines"
    _w30_expect NC-02 "(`s06_n8' == 0)" "quietly dash logged `s06_n8' could-not-fit lines"
    _w30_done NC-02 "the could-not-fit note prints once as plain text that quietly hides, for twoway and for dash"

    forvalues k = 1/8 {
        capture erase "`w30_work'/wp30_s06_`k'.log"
    }
    capture erase "`s06_page'"
    capture dash clear
    display as text "S06 end " c(current_date) " " c(current_time)
}
* ==== end S06 ====

