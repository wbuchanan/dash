    _u03_reg "`u3d'" 7 dot mpg weight, base(50) name(zu7)
    _w31_expect U03-04 "(${u03_y1s} >= 50 & ${u03_y1v} >= 50)" "dot base(50) y range ends at ${u03_y1s} saved, ${u03_y1v} served"
    _w31_expect U03-04 `"("${u03_hs}" == "`h0'" & "${u03_hv}" == "`h0'")"' "the dots' y values ${u03_hs} / ${u03_hv}, without base() `h0'"
    _w31_done U03-04 "dot base(50) widens the y axis past 50 in both modes, as twoway's (curmax `cmax'), and moves no dot"

    foreach k in 6 7 {
