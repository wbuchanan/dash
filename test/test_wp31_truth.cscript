python:
def _u41_svg_fill(svg):
    """The fill of the first <use> twoway draws (a band's polygon)."""
    import re
    with open(svg, encoding="utf-8") as fh:
        m = re.search(r'<use [^>]*style="stroke:none;fill:(#[0-9A-Fa-f]{6})', fh.read())
    return m.group(1).lower() if m else ""


def _u41_band(sp, dp, app, svg):
    """U41-08: dash's band fill, saved and served, against twoway's."""
    from sfi import Macro
    import dash_render as dr
    want = _u41_svg_fill(svg)
    out = []
    a, b = __import__("__main__")._u03_docs(sp, dp, app)
    for figs in (a, b):
        gs = [r.glyph for r in figs[0].renderers
              if type(getattr(r, "glyph", None)).__name__ == "VArea"
              and not dr._dash_is_swatch(r)]
        out.append(str(gs[0].fill_color).lower() if gs else "")
    bad = [] if out == [want, want] else ["dash %s, twoway %s" % (out, want)]
    prev = Macro.getGlobal("u41_bad")
    Macro.setGlobal("u41_bad", "; ".join([prev] * bool(prev) + bad))
end

capture program drop _u41_bandcase
program define _u41_bandcase
    // _u41_bandcase <dir> <k> <scheme name> <scheme line>: twoway's and
    // dash's lfitci pstyle(p1) band under s2color plus the line.
    version 19
    args dir k name line
    tempname f
    file open `f' using "`dir'/scheme-`name'.scheme", write text replace
    file write `f' "#include s2color" _n `"`line'"' _n
    file close `f'
    capture graph drop u41t
    quietly twoway lfitci mpg weight, pstyle(p1) scheme(`name') name(u41t, replace)
    quietly graph export "`dir'/t`k'.svg", replace
    graph drop u41t
    _u41_spec "`dir'" `k' lfitci mpg weight, pstyle(p1) scheme(`name')
    python: import __main__ as _u41_m; _u41_m._u41_band("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py", "`dir'/t`k'.svg")
end

* ==== S41 E7: CI band intensity ====
local only : env WP31_ONLY
if inlist("`only'", "", "S41") & `: list posof "S41" in w31_run' {
    display as text "S41 start " c(current_date) " " c(current_time)
    local u41d "`w31_work'/s41b"
    capture mkdir "`u41d'"
    sysuse auto, clear
    adopath ++ "`u41d'"

    // U41-08: an lfitci pstyle(p1) band reads shadestyle p#'s chain:
    // p1bar's inten200 leaves it, p1shade's draws it at twice full, and
    // color p1shade colours it, saved and served, as twoway (live).
    global u41_bad ""
    _u41_bandcase "`u41d'" 81 u41b1 "intensity p1bar inten200"
    _u41_bandcase "`u41d'" 82 u41b2 "intensity p1shade inten200"
    _u41_bandcase "`u41d'" 83 u41b3 "color p1shade red"
    adopath - "`u41d'"
    _w31_expect U41-08 `"(`"${u41_bad}"' == "")"' `"${u41_bad}"'
    _w31_done U41-08 "an lfitci pstyle(p1) band draws shadestyle p#'s colour and intensity, above full kept, saved and served, as twoway"
    display as text "S41 end " c(current_date) " " c(current_time)
}
* ==== end S41 ====

python:
def _u41_outline(sp, dp, app, svg, kind):
    """U41-06: dash's rarea outline Lines or rbar VBar outline, saved and
    served, against twoway's live SVG stroke (colour; width as the
    visible part: a clipped stroke shows its inner half)."""
    import re
    import dash_render as dr
    from sfi import Macro
    with open(svg, encoding="utf-8") as fh:
        txt = fh.read()
    if kind == "rarea":
        m = re.search(r'<use [^>]*style="fill:none;stroke:(#[0-9A-Fa-f]{6});stroke-width:([0-9.]+)"[^>]*clip-path', txt)
        want_c, want_w = m.group(1).lower(), float(m.group(2)) / 2
    else:
        ms = [m for m in re.finditer(r'<rect [^>]*style="fill:none;stroke:(#[0-9A-Fa-f]{6});stroke-width:([0-9.]+)"', txt)
              if m.group(1).lower() not in ("#eaf2f3", "#ffffff")]
        want_c, want_w = ms[0].group(1).lower(), float(ms[0].group(2))
    px = 0.1 * dr.OptionTranslator.PX_PER_PT
    a, b = __import__("__main__")._u03_docs(sp, dp, app)
    bad = []
    for name, figs in (("saved", a), ("served", b)):
        rs = [r for r in figs[0].renderers
              if hasattr(r, "glyph") and not dr._dash_is_swatch(r)]
        if kind == "rarea":
            gs = [r.glyph for r in rs if "dash_rarea_outline" in r.tags]
            if len(gs) != 2:
                bad.append("%s %d outlines" % (name, len(gs)))
                continue
        else:
            gs = [r.glyph for r in rs if type(r.glyph).__name__ == "VBar"]
        for g in gs:
            if str(g.line_color).lower() != want_c or \
                    abs(float(g.line_width) - want_w * px) > 1e-6 or \
                    float(g.line_alpha) != 1.0:
                bad.append("%s %s %s/%s, twoway %s/%s" % (
                    name, kind, g.line_color, g.line_width, want_c,
                    want_w * px))
                break
    prev = Macro.getGlobal("u41_bad")
    Macro.setGlobal("u41_bad", "; ".join([prev] * bool(prev) + bad))
end

capture program drop _u41_olcase
program define _u41_olcase
    // _u41_olcase <dir> <k> <kind> <twoway command>
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    gettoken kind 0 : 0
    capture graph drop u41t
    quietly twoway `0' name(u41t, replace)
    quietly graph export "`dir'/t`k'.svg", replace
    graph drop u41t
    _u41_spec "`dir'" `k' `0'
    python: import __main__ as _u41_m; _u41_m._u41_outline("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py", "`dir'/t`k'.svg", "`kind'")
end

