        local ++k
        _u40_sym "`u40d'" `k' `sym'
    }
    python: import __main__ as _u40_m; _u40_m._u40_verdict("U40-07", r"`u40fx'")
    _w31_expect U40-07 `"(`"${u40_bad}"' == "")"' `"${u40_bad}"'
    _w31_done U40-07 "CIRCLE and Circle are noted and the scheme's symbol drawn, as twoway"
    display as text "S40 end " c(current_date) " " c(current_time)
}
