def _u39_keys(sp, dp, app):
    """The legend key texts, saved (u39_s) and served (u39_v), joined by
    "|"."""
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    from bokeh.models import Legend
    from sfi import Macro
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_u39k_app")
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_u39k_app.py", "exec"),
             ns)
        doc = Document()
        ns["make_document"](doc)

    def keys(figs):
        out = []
        for f in figs:
            for lg in f.select({"type": Legend}):
                for it in lg.items:
                    lab = it.label
                    out.append(lab.get("value") if isinstance(lab, dict)
                               else str(getattr(lab, "value", lab)))
        return "|".join(out)
    Macro.setGlobal("u39_s", keys(list(r.figures.values())))
    Macro.setGlobal("u39_v", keys(list(doc.roots)))
end
* ==== S39 D16: legend edges ====
local only : env WP31_ONLY
if inlist("`only'", "", "S39") & `: list posof "S39" in w31_run' {
    display as text "S39 start " c(current_date) " " c(current_time)
    local u39d "`w31_work'/s39b"
    capture mkdir "`u39d'"
    dash clear
    sysuse auto, clear
    // U39-06: legend(label(1)) on two layers draws key 1 with no text and
    // label(1 "A") draws A, as twoway draws them (label.one, label.one_text:
    // twoway's SVG holds Price and no Mileage (mpg)), saved and served.
    local bad ""
    local j 0
    foreach c in `"label(1)|"' `"label(1 "A")|A"' {
        local ++j
        gettoken lo want : c, parse("|")
        local want = substr(`"`want'"', 2, .)
        dash clear
        quietly dash scatter mpg weight || scatter price weight, legend(`lo') name(u39k)
        _dash_serve_spec, specpath("`u39d'/s`j'.json") datapath("`u39d'/d`j'.json")
        python: import __main__ as _u39_m; _u39_m._u39_keys("`u39d'/s`j'.json", "`u39d'/d`j'.json", "`u39d'/a`j'.py")
        foreach m in s v {
            if `"${u39_`m'}"' != `"`want'|Price"' local bad `"`bad' `lo' `m': ${u39_`m'};"'
        }
    }
    _w31_expect U39-06 `"(`"`bad'"' == "")"' `"`bad'"'
    _w31_done U39-06 "legend(label(1)) blanks key 1 and label(1 text) draws it, saved and served"
    macro drop u39_s u39_v
    dash clear
    display as text "S39 end " c(current_date) " " c(current_time)
}
* ==== end S39 ====

python:
def _u39_array(sp, dp, app, svg0, svg1, svg2):
    """twoway's marker ratio (svg2, by(foreign, shrink), against svg0,
    by(foreign)), array inset and outline (svg1, by(foreign,
    graphregion(margin(large)) plotregion(lcolor(red)))) and dash's,
    saved and served, into u39_bad."""
    import warnings
    import dash_render as dr
    import svg_truth
    from bokeh.document import Document
    from bokeh.models import GridPlot, Scatter
    from sfi import Macro
    def tw(path):
        d = svg_truth.svg_document(path)
        r = [c["r"] for c in d["circles"] if c.get("r")]
        x = min(rc["x"] for rc in svg_truth.svg_rects(path)
                if rc["fill"] == "#ffffff")
        red = [rc for rc in svg_truth.svg_rects(path)
               if rc.get("stroke") == "#ff0000"]
        return r[0], x, len(red)
    r0, x0, _ = tw(svg0)
    _r1, x1, nred = tw(svg1)
    r2, _x2, _n2 = tw(svg2)
    want_ratio = r2 / r0
    want_inset = (x1 - x0) / 28.8
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_u39a_app")
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_u39a_app.py", "exec"),
             ns)
        doc = Document()
        ns["make_document"](doc)
    bad = []
    for mode, roots in (("saved", [r._last_layout_root]),
                        ("served", list(doc.roots))):
        grids = {}
        for root in roots:
            for g in root.select({"type": GridPlot}):
                for c in g.children:
                    t = getattr(getattr(c[0], "title", None), "text", "")
                    if t in ("u39p", "u39s"):
                        grids.setdefault(t, g)
        sizes = {}
        for k, g in grids.items():
            for gl in g.select({"type": Scatter}):
                if isinstance(gl.size, (int, float)):
                    sizes[k] = float(gl.size)
                    break
        if set(sizes) != {"u39p", "u39s"}:
            bad.append("%s: panels %s" % (mode, sorted(grids)))
            continue
        ratio = sizes["u39s"] / sizes["u39p"]
        if abs(ratio - want_ratio) > 0.01:
            bad.append("%s ratio %.4f twoway %.4f" % (mode, ratio, want_ratio))
        st = dict(grids["u39s"].styles or {})
        # WP-32 D-37.a: a CSS percentage of the width, a unit being 1%
        # of the graph's smaller side, so the inset follows a resize.
        pct = want_inset * 100.0 * dr._dash_short_side_share(
            {}, dr.SchemeParser("s2color")) / 100.0
        def pads(g):
            return [float(v.rstrip("%")) if v.endswith("%") else None
                    for v in str(dict(g.styles or {}).get("padding") or "").split()]
        # Flipped (WP-45 GW-6, 999ec28; WP-41 41-05, d536b03): the padding
        # now holds the whole graph margin (and the first row's top
        # margin), so margin(large)'s inset is its padding less the
        # default by(foreign)'s, as twoway's is t1's region less t0's.
        got, base = pads(grids["u39s"]), pads(grids["u39p"])
        if len(got) != 4 or len(base) != 4 or None in got + base \
                or any(abs(g - b - pct) > 0.01 for g, b in zip(got, base)):
            bad.append("%s padding %s over %s, twoway %.2f units" % (
                mode, st.get("padding"),
                dict(grids["u39p"].styles or {}).get("padding"), want_inset))
        if nred != 1 or "#ff0000" not in str(st.get("border", "")):
            bad.append("%s border %s, twoway outlines %d" % (
                mode, st.get("border"), nred))
    Macro.setGlobal("u39_bad", "; ".join(bad))
end
* ==== S39 D10b: by()'s shrink, region margin() and outline ====
local only : env WP31_ONLY
if inlist("`only'", "", "S39") & `: list posof "S39" in w31_run' {
    display as text "S39 start " c(current_date) " " c(current_time)
    local u39d "`w31_work'/s39c"
    capture mkdir "`u39d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear
    // U39-08: by(foreign, shrink graphregion(margin(large))
    // plotregion(lcolor(red))) draws the panel contents at twoway's
    // shrink factor, insets the array by twoway's inset and outlines it
    // once, saved and served; nothing is named.
    quietly twoway scatter mpg weight, by(foreign) name(u39t0, replace)
    quietly graph export "`u39d'/t0.svg", name(u39t0) replace
    quietly twoway scatter mpg weight, by(foreign, graphregion(margin(large)) plotregion(lcolor(red))) name(u39t1, replace)
    quietly graph export "`u39d'/t1.svg", name(u39t1) replace
    quietly twoway scatter mpg weight, by(foreign, shrink) name(u39t2, replace)
    quietly graph export "`u39d'/t2.svg", name(u39t2) replace
    capture graph drop u39t0 u39t1 u39t2
    dash clear
    quietly dash scatter mpg weight, by(foreign) title(u39p) name(u39p)
    quietly dash scatter mpg weight, by(foreign, shrink graphregion(margin(large)) plotregion(lcolor(red))) title(u39s) name(u39s)
    _dash_serve_spec, specpath("`u39d'/s1.json") datapath("`u39d'/d1.json")
    python: import __main__ as _u39_m; _u39_m._u39_array("`u39d'/s1.json", "`u39d'/d1.json", "`u39d'/a1.py", "`u39d'/t0.svg", "`u39d'/t1.svg", "`u39d'/t2.svg")
    _w31_expect U39-08 `"(`"${u39_bad}"' == "")"' `"${u39_bad}"'
    _w31_done U39-08 "by()'s shrink, region margin() and plotregion() outline drawn as twoway draws them, saved and served"
    macro drop u39_bad
    dash clear
    display as text "S39 end " c(current_date) " " c(current_time)
}
* ==== end S39 ====

* ==== S39 D11b: a margin term past double precision ====
local only : env WP31_ONLY
if inlist("`only'", "", "S39") & `: list posof "S39" in w31_run' {
    display as text "S39 start " c(current_date) " " c(current_time)
    local u39d "`w31_work'/s39d"
    capture mkdir "`u39d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear
    capture graph drop u37t
    quietly twoway scatter mpg weight, name(u37t, replace)
    quietly graph export "`u39d'/t0.svg", replace
    graph drop u37t
    // U39-09: graphregion(margin(l+1e400)) and (r+1e400) draw that side
    // at gsize medium with twoway's note, the others kept; l=1e400 draws
    // it zero; l+3pt is the side's sum in points -- each border as
    // twoway's, saved and served (_u37_reg, S37's comparer).
    local bad ""
    local j 0
    foreach m in "l+1e400" "r+1e400" "l=1e400" "l+3pt" {
        local ++j
        _u37_reg "`u39d'" `j' scatter mpg weight, graphregion(margin(`m'))
        foreach s in s v {
            if `"${u37_`s'}"' != `"${u37_w`s'}"' local bad `"`bad' `m' `s': dash ${u37_`s'} twoway ${u37_w`s'};"'
        }
    }
    _w31_expect U39-09 `"(`"`bad'"' == "")"' `"`bad'"'
    _w31_done U39-09 "a margin term past double precision and a unit after the operator drawn as twoway draws them, saved and served"
    macro drop u37_s u37_v u37_ws u37_wv
    capture graph drop _all
    dash clear
    display as text "S39 end " c(current_date) " " c(current_time)
}
* ==== end S39 ====

python:
def _u40_glyph(sp, dp, app, key):
    """The first marker glyph's marker, angle, size, fill and outline
    width, saved and served, into __main__._u40_seen[key]; and the
    saved render's msymbol notes."""
    import __main__ as m
    import warnings
    import dash_render as dr
    a, b = m._u03_docs(sp, dp, app)
    out = []
    for figs in (a, b):
        gs = [r.glyph for r in figs[0].renderers
              if type(getattr(r, "glyph", None)).__name__ == "Scatter"
              and not dr._dash_is_swatch(r)]
        g = gs[0]
        out.append((g.marker, round(float(g.angle or 0.0), 4),
                    round(float(g.size), 3), float(g.fill_alpha),
                    float(g.line_width)))
    with warnings.catch_warnings(record=True) as w:
        warnings.simplefilter("always")
        dr.DashRenderer(sp, dp).render()
    notes = [str(x.message) for x in w if "marker symbol" in str(x.message)]
    seen = getattr(m, "_u40_seen", {})
    seen[key] = (out, notes)
    m._u40_seen = seen
end

python:
def _u40_verdict(case, fixture):
    """What differs from twoway's table (test/fixtures/
    symbol_pattern_truth.json) for the glyphs _u40_glyph saw, into u40_bad."""
    import __main__ as m
    import json, math
    from sfi import Macro
    with open(fixture, encoding="utf-8") as fh:
        t = json.load(fh)
    shape = {"O": ("circle", "O"), "o": ("circle", "O"),
             "oh": ("circle", "O"), "d": ("diamond", "D"),
             "dh": ("diamond", "D"), "s": ("square", "S"),
             "sh": ("square", "S"), "t": ("triangle", "T"),
             "th": ("triangle", "T"), "x": ("x", "X"), "smx": ("x", "X"),
             "lgx": ("x", "X"), "V": ("inverted_triangle", "V"),
             "v": ("inverted_triangle", "V"),
             "smv": ("inverted_triangle", "V"),
             "arrow": ("triangle", "T"), "a": ("triangle", "T"),
             "arrowf": ("triangle", "T"), "A": ("triangle", "T"),
             "pipe": ("dash", "O"), "|": ("dash", "O")}
    seen = m._u40_seen
    o_size = seen["O"][0][0][2]
    bad = []
    for key, (out, notes) in sorted(seen.items()):
        if out[0] != out[1]:
            bad.append("%s saved %s served %s" % (key, out[0], out[1]))
        mk, ang, size, fa, lw = out[0]
        if case == "U40-02":
            if key in ("point", "p"):
                want = ("circle", 0.0, 1.0, None, 0.0)
            elif key in shape:
                sh, ref = shape[key]
                # Its height over O's, over the Bokeh shape's at size 1
                # (WP-31 E1): a triangle is sqrt(3)/2 tall, an x sqrt(1/2).
                bh = {"triangle": math.sqrt(3) / 2,
                      "inverted_triangle": math.sqrt(3) / 2,
                      "x": math.sqrt(0.5)}.get(sh, 1.0)
                f = t["sym." + key]["bbox_h"] / t["sym.O"]["bbox_h"] / bh
                want = (sh, round(math.pi / 2, 4) if sh == "dash" else 0.0,
                        round(o_size * f, 3), None, None)
            else:
                continue
            if mk != want[0] or abs(ang - want[1]) > 1e-3 or \
                    abs(size - want[2]) > 0.02 * max(1.0, want[2]) or \
                    (want[4] is not None and lw != want[4]):
                bad.append("%s drew %s want %s" % (key, out[0], want))
            if mk not in ("dash", "x") and key not in ("point", "p") and \
                    (fa == 0.0) is t["sym." + key]["filled"]:
                bad.append("%s fill %s, twoway filled %s" % (
                    key, fa, t["sym." + key]["filled"]))
            if notes:
                bad.append("%s noted %s" % (key, notes))
        elif case in ("U40-05", "U40-07") and key != "O":
            if t["sym." + key]["note"] != \
                    "named style %s not found in class symbol" % key:
                bad.append("%s twoway note %r" % (key, t["sym." + key]["note"]))
            if out[0][:3] != seen["O"][0][0][:3] or len(notes) != 1 or \
                    "msymbol(%s)" % key not in notes[0]:
                bad.append("%s drew %s notes %s" % (key, out[0], notes))
    Macro.setGlobal("u40_bad", "; ".join(bad)[:2000])
end

capture program drop _u40_sym
program define _u40_sym
    // _u40_sym <dir> <k> <symbol>: dash's saved and served marker for
    // msymbol(<symbol>) (the s2color scheme) into _u40_seen.
    version 19
    args dir k sym
    dash clear
    quietly dash scatter mpg weight, msymbol(`sym') scheme(s2color) name(zu40`k')
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u40_m; _u40_m._u40_glyph("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py", "`sym'")
end

