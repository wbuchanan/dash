// S34 helpers (WP-31 D8 C17 E3 C14 C15).  _u34_reg: one command drawn by
// twoway and registered with dash, the y and x titles and legend keys of
// each (twoway's from its class values and SVG, dash's saved and served)
// into globals u34_tw, u34_s, u34_v.
python:
def _u34_tw_keys(svg):
    from svg_truth import svg_document
    return [t["text"] for t in svg_document(svg)["texts"]
            if not t["anchor"]]


def _u34_dash(figs):
    f = figs[0]
    keys = []
    for lg in f.legend:
        if not lg.visible:
            continue
        for it in lg.items:
            lab = it.label
            t = lab.get("value") if isinstance(lab, dict) else getattr(
                lab, "value", lab)
            if t:
                keys.append(str(t))
    return "%s|%s|%s" % (f.yaxis[0].axis_label or "",
                         f.xaxis[0].axis_label or "", " ~ ".join(keys))


def _u34_titles(sp, dp, app, svg, yt, xt):
    import __main__ as m
    from sfi import Macro
    a, b = m._u03_docs(sp, dp, app)
    Macro.setGlobal("u34_tw", "%s|%s|%s" % (yt, xt,
                                            " ~ ".join(_u34_tw_keys(svg))))
    Macro.setGlobal("u34_s", _u34_dash(a))
    Macro.setGlobal("u34_v", _u34_dash(b))
end

python:
def _u34_labels(sp, dp, app):
    """Every LabelSet's texts, saved and served, into u34_s and u34_v."""
    import __main__ as m
    from sfi import Macro
    from bokeh.models import LabelSet
    a, b = m._u03_docs(sp, dp, app)
    for figs, sfx in ((a, "s"), (b, "v")):
        out = []
        for f in figs:
            for ls in f.select({"type": LabelSet}):
                col = ls.text if isinstance(ls.text, str) else ls.text.field
                out.extend(str(v) for v in ls.source.data[col])
        Macro.setGlobal("u34_" + sfx, " ~ ".join(out))
end

python:
def _u34_style(sp, dp, app):
    """The first LabelSet's colour and anchors and the first marker angle,
    saved and served, into u34_s and u34_v."""
    import __main__ as m
    from sfi import Macro
    from bokeh.models import LabelSet
    a, b = m._u03_docs(sp, dp, app)
    for figs, sfx in ((a, "s"), (b, "v")):
        out = []
        for f in figs:
            for ls in f.select({"type": LabelSet}):
                out.append("%s %s %s" % (str(ls.text_color).lower(),
                                         ls.text_align, ls.text_baseline))
            for r in f.renderers:
                g = getattr(r, "glyph", None)
                if type(g).__name__ == "Scatter" and not out:
                    ang = g.angle
                    ang = ang if isinstance(ang, (int, float)) else getattr(
                        ang, "value", ang)
                    out.append("angle %.6f" % float(ang))
        Macro.setGlobal("u34_" + sfx, " ~ ".join(out[:1]))
end

capture program drop _u34_reg
program define _u34_reg
    // _u34_reg <dir> <k> <command with options...>
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    capture graph drop u34t
    quietly twoway `0' name(u34t, replace)
    quietly graph export "`dir'/t`k'.svg", replace
    local yt ""
    local xt ""
    if 0`.u34t.yaxis1.title.text.arrnels' > 0 local yt `"`.u34t.yaxis1.title.text[1]'"'
    if 0`.u34t.xaxis1.title.text.arrnels' > 0 local xt `"`.u34t.xaxis1.title.text[1]'"'
    graph drop u34t
    dash clear
    capture quietly dash `0' name(zu34`k')
    if _rc {
        global u34_s "rc `=_rc'"
        global u34_v "rc `=_rc'"
        global u34_tw "(twoway drawn)"
        exit
    }
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u34_m; _u34_m._u34_titles("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py", "`dir'/t`k'.svg", r"""`yt'""", r"""`xt'""")
end

* ==== S34 D8: yvarlabel() and xvarlabel() ====
local only : env WP31_ONLY
if inlist("`only'", "", "S34") & `: list posof "S34" in w31_run' {
    display as text "S34 start " c(current_date) " " c(current_time)
    local u34d "`w31_work'/s34a"
    capture mkdir "`u34d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear
    capture drop lo hi
    generate lo = mpg - 2
    generate hi = mpg + 2

    // U34-1: the axis titles and legend keys yvarlabel() and xvarlabel()
    // give, saved and served, as twoway draws them; no note.
    local bad ""
    local j 0
    foreach c in `"scatter mpg weight, yvarlabel("Miles") xvarlabel("Pounds")"' ///
        `"scatter mpg weight, xvarlabel("")"' ///
        `"scatter mpg price weight, yvarlabel("A" "B")"' ///
        `"rscatter lo hi weight, yvarlabel("Band" "Top")"' ///
        `"lfit mpg weight, yvarlabel("Q") xvarlabel("Pounds")"' ///
        `"lfitci mpg weight, yvarlabel("Q")"' {
        local ++j
        _u34_reg "`u34d'" 1`j' `c'
        foreach m in s v {
            if `"${u34_`m'}"' != `"${u34_tw}"' local bad `"`bad' case `j' `m': dash ${u34_`m'} twoway ${u34_tw};"'
        }
    }
    local lg "`u34d'/u341.log"
    capture log close _u34log
    quietly log using "`lg'", name(_u34log) text replace
    capture noisily dash scatter mpg weight, yvarlabel("Miles") xvarlabel("Pounds") name(u341)
    local rc = _rc
    quietly log close _u34log
    if `rc' local bad `"`bad' rc `rc';"'
    cert_file_has "`lg'", needle("ignoring unsupported option")
    if r(found) local bad `"`bad' the generic note named the option;"'
    _w31_expect U34-1 `"(`"`bad'"' == "")"' `"`bad'"'
    _w31_done U34-1 "yvarlabel() and xvarlabel() title the axes and key the legend as twoway does, saved and served, silently"

    macro drop u34_tw u34_s u34_v
    capture graph drop _all
    dash clear
    display as text "S34 end " c(current_date) " " c(current_time)
}
* ==== end S34 ====

* ==== S34 C17: mlabprefix(), mlabsuffix(), lalign() ====
local only : env WP31_ONLY
if inlist("`only'", "", "S34") & `: list posof "S34" in w31_run' {
    display as text "S34 start " c(current_date) " " c(current_time)
    local u34d "`w31_work'/s34b"
    capture mkdir "`u34d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear

    // U34-2: the labels' texts with mlabprefix() and mlabsuffix(), saved
    // and served, as twoway's SVG writes them.
    local bad ""
    capture graph drop u34t
    quietly twoway scatter mpg weight in 1/3, mlabel(make) mlabprefix("[") mlabsuffix("]") name(u34t, replace)
    quietly graph export "`u34d'/t2.svg", replace
    graph drop u34t
    python: import __main__ as _u34_m; from sfi import Macro as _u34_M; from svg_truth import svg_document as _u34_sd; _u34_M.setGlobal("u34_tw", " ~ ".join(t["text"] for t in _u34_sd("`u34d'/t2.svg")["texts"] if t["text"].startswith("[")))
    dash clear
    capture quietly dash scatter mpg weight in 1/3, mlabel(make) mlabprefix("[") mlabsuffix("]") name(u342)
    if _rc local bad `"`bad' dash rc `=_rc';"'
    else {
        _dash_serve_spec, specpath("`u34d'/s2.json") datapath("`u34d'/d2.json")
        python: import __main__ as _u34_m; _u34_m._u34_labels("`u34d'/s2.json", "`u34d'/d2.json", "`u34d'/a2.py")
        foreach m in s v {
            if `"${u34_`m'}"' != `"${u34_tw}"' local bad `"`bad' `m': dash ${u34_`m'} twoway ${u34_tw};"'
        }
    }
    _w31_expect U34-2 `"(`"`bad'"' == "")"' `"`bad'"'
    _w31_done U34-2 "mlabprefix() and mlabsuffix() wrap the labels as twoway does, saved and served"

    // U34-3: lalign() taken as twoway takes it: center, inside and
    // outside silent; a bogus word in twoway's words; rc 0 throughout.
    local bad ""
    foreach a in center inside outside bogus {
        local lg "`u34d'/u343`a'.log"
        capture log close _u34log
        quietly log using "`lg'", name(_u34log) text replace
        capture noisily twoway line mpg weight, lalign(`a') nodraw
        local trc = _rc
        dash clear
        capture noisily dash line mpg weight, lalign(`a') saving("`u34d'/l`a'.html", replace)
        local drc = _rc
        quietly log close _u34log
        if `trc' != `drc' local bad `"`bad' `a': twoway rc `trc', dash `drc';"'
        cert_file_has "`lg'", needle("dash: named style `a' not found in class alignstroke")
        if ("`a'" == "bogus") != r(found) local bad `"`bad' `a': dash's note found `r(found)';"'
        cert_file_has "`lg'", needle("ignoring unsupported option")
        if r(found) local bad `"`bad' `a': the generic note named it;"'
    }
    _w31_expect U34-3 `"(`"`bad'"' == "")"' `"`bad'"'
    _w31_done U34-3 "lalign() taken as twoway takes it: center, inside, outside silent, another word in twoway's words"

    macro drop u34_tw u34_s u34_v
    capture graph drop _all
    dash clear
    display as text "S34 end " c(current_date) " " c(current_time)
}
* ==== end S34 ====

* ==== S34 E3: msangle names, mlalign(), mwidth, mlabstyle() ====
local only : env WP31_ONLY
if inlist("`only'", "", "S34") & `: list posof "S34" in w31_run' {
    display as text "S34 start " c(current_date) " " c(current_time)
    local u34d "`w31_work'/s34c"
    capture mkdir "`u34d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear

    // U34-4: mlabstyle(p2) colours the labels as twoway's SVG does, at 3
    // o'clock; mlabstyle(bogus) is twoway's rc and drawn black at 12.
    local bad ""
    local j 0
    foreach c in "p2|left middle" "bogus|center bottom" {
        local ++j
        gettoken st anchor : c, parse("|")
        local anchor = substr("`anchor'", 2, .)
        capture graph drop u34t
        capture noisily twoway scatter mpg weight in 1/3, mlabel(make) mlabstyle(`st') name(u34t, replace)
        local trc = _rc
        quietly graph export "`u34d'/t4`j'.svg", replace
        graph drop u34t
        python: from sfi import Macro as _u34_M; from svg_truth import svg_document as _u34_sd; _u34_M.setGlobal("u34_tw", [t["fill"] for t in _u34_sd("`u34d'/t4`j'.svg")["texts"] if t["text"] == "AMC Concord"][0])
        local want "${u34_tw} `anchor'"
        dash clear
        capture quietly dash scatter mpg weight in 1/3, mlabel(make) mlabstyle(`st') name(u344)
        if _rc != `trc' local bad `"`bad' `st': twoway rc `trc', dash `=_rc';"'
        else {
            _dash_serve_spec, specpath("`u34d'/s4`j'.json") datapath("`u34d'/d4`j'.json")
            python: import __main__ as _u34_m; _u34_m._u34_style("`u34d'/s4`j'.json", "`u34d'/d4`j'.json", "`u34d'/a4`j'.py")
            foreach m in s v {
                if `"${u34_`m'}"' != `"`want'"' local bad `"`bad' `st' `m': dash ${u34_`m'} want `want';"'
            }
        }
    }
    _w31_expect U34-4 `"(`"`bad'"' == "")"' `"`bad'"'
    _w31_done U34-4 "mlabstyle() styles the labels from the scheme's labelstyle as twoway does, saved and served"

    // U34-5: msangle(forty_five) rotates the markers 45 degrees, as
    // msangle(45); msangle(bogus) is twoway's rc 0, drawn unrotated.
    local bad ""
    foreach a in forty_five 45 bogus {
        capture noisily twoway scatter mpg weight, msymbol(T) msangle(`a') nodraw
        local trc = _rc
        dash clear
        capture quietly dash scatter mpg weight, msymbol(T) msangle(`a') name(u345)
        if _rc != `trc' local bad `"`bad' `a': twoway rc `trc', dash `=_rc';"'
        else {
            _dash_serve_spec, specpath("`u34d'/s5.json") datapath("`u34d'/d5.json")
            python: import __main__ as _u34_m; _u34_m._u34_style("`u34d'/s5.json", "`u34d'/d5.json", "`u34d'/a5.py")
            local want = cond("`a'" == "bogus", "angle 0.000000", "angle 0.785398")
            foreach m in s v {
                if `"${u34_`m'}"' != `"`want'"' local bad `"`bad' `a' `m': dash ${u34_`m'} want `want';"'
            }
        }
    }
    _w31_expect U34-5 `"(`"`bad'"' == "")"' `"`bad'"'
    _w31_done U34-5 "msangle() rotates by anglestyle names as twoway does, saved and served"

    macro drop u34_tw u34_s u34_v
    capture graph drop _all
    dash clear
    display as text "S34 end " c(current_date) " " c(current_time)
}
* ==== end S34 ====

* ==== S34 C15: bar label default ====
local only : env WP31_ONLY
if inlist("`only'", "", "S34") & `: list posof "S34" in w31_run' {
    display as text "S34 start " c(current_date) " " c(current_time)
    local u34d "`w31_work'/s34d"
    capture mkdir "`u34d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear

    // U34-6: twoway's default label clock (the first plot's style) is 12
    // on bar and 3 on scatter; dash's LabelSet anchors are that clock's,
    // saved and served.
    local bad ""
    foreach t in bar scatter {
        capture graph drop u34t
        quietly twoway `t' mpg weight in 1/3, mlabel(make) name(u34t, replace)
        local clk "`.u34t.plotregion1.plot1.style.label.position.setting'"
        graph drop u34t
        local want = cond("`clk'" == "12", "center bottom", cond("`clk'" == "3", "left middle", "clock `clk'"))
        dash clear
        capture quietly dash `t' mpg weight in 1/3, mlabel(make) name(u346)
        if _rc local bad `"`bad' `t': dash rc `=_rc';"'
        else {
            _dash_serve_spec, specpath("`u34d'/s6.json") datapath("`u34d'/d6.json")
            python: import __main__ as _u34_m; _u34_m._u34_style("`u34d'/s6.json", "`u34d'/d6.json", "`u34d'/a6.py")
            foreach m in s v {
                if !strpos(`"${u34_`m'}"', "`want'") local bad `"`bad' `t' `m': dash ${u34_`m'} twoway clock `clk';"'
            }
        }
    }
    _w31_expect U34-6 `"(`"`bad'"' == "")"' `"`bad'"'
    _w31_done U34-6 "bar labels default to 12 o'clock and scatter's to 3, saved and served, as twoway"

    macro drop u34_s u34_v
    capture graph drop _all
    dash clear
    display as text "S34 end " c(current_date) " " c(current_time)
}
* ==== end S34 ====

* ==== S34 C14: range plots labelled by a plotted variable ====
local only : env WP31_ONLY
if inlist("`only'", "", "S34") & `: list posof "S34" in w31_run' {
    display as text "S34 start " c(current_date) " " c(current_time)
    local u34d "`w31_work'/s34e"
    capture mkdir "`u34d'"
    capture graph drop _all
    sysuse auto, clear
    capture drop lo hi
    generate lo = mpg - 2
    generate hi = mpg + 2

    // U34-7: twoway's rc and line, and dash's, for a range plot labelled
    // by one of its own variables, by another, and by both.
    local bad ""
    foreach c in "rscatter lo hi weight, mlabel(lo)" "rscatter lo hi weight, mlabel(hi)" ///
        "rscatter lo hi weight, mlabel(weight)" "rscatter lo hi weight, mlabel(make)" ///
        "rscatter lo hi weight, mlabel(lo make)" "rcapsym lo hi weight, mlabel(lo)" ///
        "rconnected lo hi weight, mlabel(lo)" "rbar lo hi weight, mlabel(lo)" ///
        "rarea lo hi weight, mlabel(hi)" "rpcap lo hi mpg weight, mlabel(lo)" ///
        "rscatter lo hi weight, mlabel(lo) mlabvposition(rep78)" {
        foreach w in twoway dash {
            local lg "`u34d'/`w'.log"
            capture log close _u34log
            quietly log using "`lg'", name(_u34log) text replace
            if "`w'" == "twoway" capture noisily twoway `c' nodraw
            else {
                dash clear
                capture noisily dash `c' name(u347)
            }
            local rc_`w' = _rc
            quietly log close _u34log
            python: from sfi import Macro as _u34_M; _u34_M.setGlobal("u34_`w'", next((l.rstrip() for l in open(r"`lg'", encoding="utf-8", errors="replace") if "requires 3 variables" in l or "must specify four" in l), ""))
        }
        if `rc_twoway' != `rc_dash' | `"${u34_twoway}"' != `"${u34_dash}"' {
            local bad `"`bad' [`c': twoway `rc_twoway' "${u34_twoway}", dash `rc_dash' "${u34_dash}"]"'
        }
    }
    _w31_expect U34-7 `"(`"`bad'"' == "")"' `"`bad'"'
    _w31_done U34-7 "a range plot labelled by a plotted variable is answered with twoway's rc and line"

    macro drop u34_twoway u34_dash
    capture graph drop _all
    dash clear
    display as text "S34 end " c(current_date) " " c(current_time)
}
* ==== end S34 ====

// S35 (WP-31 D9) helpers.  _u35_ranges: the extra ranges of a registered
// graph, built (u35_b), after one widget move on the saved page (its own
// callback run under node, test/js_runner.py; u35_s) and in the served app
// (its change callbacks fired; u35_v), each "name start end; ..." to 9
// significant digits.  _u35_axes: each mode's visible y and x axes as
// "side:title" (u35_s, u35_v).  _u35_tw: twoway's axes from its SVG, as
// "side:title" for the titled columns (u35_tw).
python:
def _u35_docs(sp, dp, app):
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
        with open(app, encoding="utf-8") as fh:
            src = fh.read()
        attach = "if __name__ != '__main__':\n    make_document(curdoc())"
        ns = dict(__name__="dash_u35_app")
        exec(compile(src.replace(attach, "pass"), "dash_u35_app.py", "exec"),
             ns)
        doc = Document()
        ns["make_document"](doc)
    sv = [m for m in doc.models if type(m).__name__ == "figure"]
    return r, doc, list(r.figures.values()), sv


def _u35_fmt(figs):
    out = []
    for f in figs:
        for k, v in sorted(list(f.extra_y_ranges.items())
                           + list(f.extra_x_ranges.items())):
            out.append("%s %.9g %.9g" % (k, v.start, v.end))
    return "; ".join(out)


def _u35_value(w, want):
    if type(w).__name__ == "Select":
        return [v for v, lab in w.options if lab == want][0]
    if type(w).__name__ == "RangeSlider":
        return tuple(float(x) for x in want.split())
    return float(want)


def _u35_ranges(sp, dp, app, kind, want):
    import warnings
    from sfi import Macro
    from js_runner import JsSession
    r, doc, a, b = _u35_docs(sp, dp, app)
    Macro.setGlobal("u35_b", _u35_fmt(a))
    w = [x for x in r.filter_widgets if type(x).__name__ == kind][0]
    w.value = _u35_value(w, want)
    cb = r.filter_callbacks[r.filter_widgets.index(w)]
    JsSession([]).run_code(cb.code, cb.args)
    Macro.setGlobal("u35_s", _u35_fmt(a))
    ws = [m for m in doc.models if type(m).__name__ == kind
          and hasattr(m, "_dash_var")]
    v = _u35_value(ws[0], want)
    ws[0].value = v
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        for key in ("value", "value_throttled"):
            for c in list(ws[0]._callbacks.get(key, [])):
                c("value", None, v)
    Macro.setGlobal("u35_v", _u35_fmt(b))


def _u35_oracle(sp, dp, app):
    from sfi import Macro
    _r, _d, a, _b = _u35_docs(sp, dp, app)
    Macro.setGlobal("u35_o", _u35_fmt(a))


def _u35_close(x, y, tol):
    from sfi import Macro
    def parse(t):
        return {p.split()[0]: [float(z) for z in p.split()[1:]]
                for p in t.split(";") if p.strip()}
    a, b = parse(Macro.getGlobal(x)), parse(Macro.getGlobal(y))
    ok = sorted(a) == sorted(b) and bool(a) and all(
        abs(u - v) <= float(tol) * max(1.0, abs(v))
        for k in a for u, v in zip(a[k], b[k]))
    Macro.setGlobal("u35_ok", "1" if ok else "0")


def _u35_axes(sp, dp, app):
    from sfi import Macro
    from bokeh.models import LinearAxis, LogAxis
    _r, _d, a, b = _u35_docs(sp, dp, app)
    for figs, sfx in ((a, "s"), (b, "v")):
        f = figs[0]
        Macro.setGlobal("u35_" + sfx, " ".join(
            "%s:%s" % (side, (ax.axis_label or "").replace(" ", "_"))
            for side in ("left", "right", "below", "above")
            for ax in getattr(f, side)
            if isinstance(ax, (LinearAxis, LogAxis)) and ax.visible))


def _u35_tw(svg, labels):
    """twoway's titled axes, "side:title" for each title in *labels*
    (space-separated, underscores for spaces), in side order."""
    import os, sys
    from sfi import Macro
    sys.path.insert(0, os.path.join(os.getcwd(), "..", "scripts"))
    import svg_truth
    d = svg_truth.svg_document(svg)
    pr = d["plotregion"]
    want = [w.replace("_", " ") for w in labels.split()]
    got = []
    for t in d["texts"]:
        if t["text"] not in want:
            continue
        if t.get("rotate") is not None:
            side = "left" if t["x"] < pr["left"] else "right"
        else:
            side = "below" if t["y"] > pr["bottom"] else "above"
        got.append((("left", "right", "below", "above").index(side),
                    "%s:%s" % (side, t["text"].replace(" ", "_"))))
    Macro.setGlobal("u35_tw", " ".join(g for _, g in sorted(got)))
end

capture program drop _u35_serve
program define _u35_serve
    // _u35_serve <dir> <k> [filter() text]: the registered graphs' spec
    // and data files, with the dashboard's filter when one is given.
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    if `"`0'"' != "" {
        _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json") filter(`0')
    }
    else _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
end

* ==== S35 D9: Second-axis ranges after a move, the first-used axis, horizontal titles ====
local only : env WP31_ONLY
if inlist("`only'", "", "S35") & `: list posof "S35" in w31_run' {
    display as text "S35 start " c(current_date) " " c(current_time)
    local u35d "`w31_work'/s35"
    capture mkdir "`u35d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear

    // U35-1: the dropdown at Foreign; twoway's yaxis2 under the same if.
    quietly twoway (scatter mpg weight) (line price weight, yaxis(2) sort) if foreign == 1, name(u35t, replace)
    local tlo `.u35t.yaxis2.plotregion.yscale.curmin'
    local thi `.u35t.yaxis2.plotregion.yscale.curmax'
    graph drop u35t
    dash clear
    capture noisily dash (scatter mpg weight) (line price weight, yaxis(2) sort) if foreign == 1, name(zu35o)
    _u35_serve "`u35d'" 1o
    python: import __main__ as _u35_m; _u35_m._u35_oracle("`u35d'/s1o.json", "`u35d'/d1o.json", "`u35d'/a1o.py")
    dash clear
    capture noisily dash (scatter mpg weight) (line price weight, yaxis(2) sort), name(zu351)
    _w31_expect U35-1 `"(_rc == 0)"' "yaxis(2) rc `=_rc'"
    _u35_serve "`u35d'" 1 foreign, type(dropdown)
    python: _u35_m._u35_ranges("`u35d'/s1.json", "`u35d'/d1.json", "`u35d'/a1.py", "Select", "Foreign")
    python: _u35_m._u35_close("u35_s", "u35_o", "1e-9")
    _w31_expect U35-1 `"(${u35_ok} == 1)"' "saved after the move ${u35_s}; oracle ${u35_o}"
    python: _u35_m._u35_close("u35_v", "u35_o", "1e-6")
    _w31_expect U35-1 `"(${u35_ok} == 1)"' "served after the move ${u35_v}; oracle ${u35_o}"
    local dlo : word 2 of ${u35_s}
    local dhi : word 3 of ${u35_s}
    _w31_expect U35-1 `"("${u35_b}" != "${u35_s}")"' "the move left y2 at ${u35_b}"
    _w31_expect U35-1 `"(`dlo' <= `tlo' & `dhi' >= `thi')"' "dash y2 `dlo'-`dhi' does not hold twoway's `tlo'-`thi'"
    _w31_done U35-1 "the second axis re-fits over the rows a dropdown move keeps, both modes"

    // U35-2: xaxis(2) and a range move to 2000-3000.
    quietly twoway (scatter mpg weight) (scatter mpg price, xaxis(2)) if weight >= 2000 & weight <= 3000, name(u35t, replace)
    local tlo `.u35t.xaxis2.plotregion.xscale.curmin'
    local thi `.u35t.xaxis2.plotregion.xscale.curmax'
    graph drop u35t
    dash clear
    capture noisily dash (scatter mpg weight) (scatter mpg price, xaxis(2)) if weight >= 2000 & weight <= 3000, name(zu35o)
    _u35_serve "`u35d'" 2o
    python: _u35_m._u35_oracle("`u35d'/s2o.json", "`u35d'/d2o.json", "`u35d'/a2o.py")
    dash clear
    capture noisily dash (scatter mpg weight) (scatter mpg price, xaxis(2)), name(zu352)
    _w31_expect U35-2 `"(_rc == 0)"' "xaxis(2) rc `=_rc'"
    _u35_serve "`u35d'" 2 weight, type(range)
    python: _u35_m._u35_ranges("`u35d'/s2.json", "`u35d'/d2.json", "`u35d'/a2.py", "RangeSlider", "2000 3000")
    python: _u35_m._u35_close("u35_s", "u35_o", "1e-9")
    _w31_expect U35-2 `"(${u35_ok} == 1)"' "saved after the move ${u35_s}; oracle ${u35_o}"
    python: _u35_m._u35_close("u35_v", "u35_o", "1e-6")
    _w31_expect U35-2 `"(${u35_ok} == 1)"' "served after the move ${u35_v}; oracle ${u35_o}"
    local dlo : word 2 of ${u35_s}
    local dhi : word 3 of ${u35_s}
    _w31_expect U35-2 `"(`dlo' <= `tlo' & `dhi' >= `thi')"' "dash x2 `dlo'-`dhi' does not hold twoway's `tlo'-`thi'"
    _w31_done U35-2 "the second x axis re-fits over the rows a range move keeps, both modes"

    // U35-3: a move that keeps every row leaves the extra range as built.
    dash clear
    capture noisily dash (scatter mpg weight) (line price weight, yaxis(2) sort), name(zu353)
    _u35_serve "`u35d'" 3 price, type(range)
    python: _u35_m._u35_ranges("`u35d'/s3.json", "`u35d'/d3.json", "`u35d'/a3.py", "RangeSlider", "3291 15906")
    python: _u35_m._u35_close("u35_s", "u35_b", "1e-12")
    _w31_expect U35-3 `"(${u35_ok} == 1)"' "saved ${u35_s}; built ${u35_b}"
    python: _u35_m._u35_close("u35_v", "u35_b", "1e-9")
    _w31_expect U35-3 `"(${u35_ok} == 1)"' "served ${u35_v}; built ${u35_b}"
    _w31_done U35-3 "a move keeping every row leaves the second axis as built, both modes"

    // U35-4: no layer on axis 1, and axis 1 used second: the first axis
    // used is drawn on the left, its options with it.
    local k 0
    foreach c in "(scatter mpg weight, yaxis(2)) (scatter price weight, yaxis(3)), ytitle(AX2, axis(2)) ytitle(AX3, axis(3))" "(scatter price weight, yaxis(3)) (scatter mpg weight, yaxis(2)), ytitle(AX3, axis(3)) ytitle(AX2, axis(2))" "(scatter price weight, yaxis(2)) (scatter mpg weight), ytitle(AX1) ytitle(AX2, axis(2))" {
        local ++k
        quietly twoway `c' xtitle(BX1) name(u35t, replace)
        quietly graph export "`u35d'/t4`k'.svg", replace
        graph drop u35t
        python: _u35_m._u35_tw("`u35d'/t4`k'.svg", "AX1 AX2 AX3 BX1")
        dash clear
        capture noisily dash `c' xtitle(BX1) name(zu354`k')
        _w31_expect U35-4 `"(_rc == 0)"' "case `k' rc `=_rc'"
        _u35_serve "`u35d'" 4`k'
        python: _u35_m._u35_axes("`u35d'/s4`k'.json", "`u35d'/d4`k'.json", "`u35d'/a4`k'.py")
        foreach m in s v {
            _w31_expect U35-4 `"("${u35_`m'}" == "${u35_tw}")"' "case `k' `m': dash ${u35_`m'}; twoway ${u35_tw}"
        }
    }
    _w31_done U35-4 "the first axis used is drawn on the left as twoway draws it, both modes"

    // U35-5: horizontal with yaxis(2), and its control.
    local k 0
    foreach c in "bar mpg weight, horizontal yaxis(2)" "bar mpg weight, horizontal" "(scatter weight mpg) (bar mpg weight, horizontal yaxis(2))," {
        local ++k
        quietly twoway `c' legend(off) name(u35t, replace)
        quietly graph export "`u35d'/t5`k'.svg", replace
        graph drop u35t
        python: _u35_m._u35_tw("`u35d'/t5`k'.svg", "Weight_(lbs.) Mileage_(mpg)")
        dash clear
        capture noisily dash `c' legend(off) name(zu355`k')
        _w31_expect U35-5 `"(_rc == 0)"' "case `k' rc `=_rc'"
        _u35_serve "`u35d'" 5`k'
        python: _u35_m._u35_axes("`u35d'/s5`k'.json", "`u35d'/d5`k'.json", "`u35d'/a5`k'.py")
        foreach m in s v {
            _w31_expect U35-5 `"("${u35_`m'}" == "${u35_tw}")"' "case `k' `m': dash ${u35_`m'}; twoway ${u35_tw}"
        }
    }
    _w31_done U35-5 "horizontal with yaxis(2) titles its axes as twoway does, both modes"

    macro drop u35_b u35_s u35_v u35_o u35_ok u35_tw
    capture graph drop _all
    dash clear
    display as text "S35 end " c(current_date) " " c(current_time)
}
* ==== end S35 ====

// S35 (WP-31 B5c) helpers.  _u35_dots: a registered dot graph's rows of
// dots after the dropdown move on the saved page (its callback under
// node; u35_s) and in the served app (u35_v), and the qualified build's
// (u35_o), each "<count> <first y> <last y>"; twoway's dot rows under the
// same if are what the qualified build draws (S18, dot_truth.json).
python:
def _u35_dot_rows(figs):
    out = []
    for f in figs:
        for r in f.renderers:
            if "dash_dots" in (r.tags or []):
                y = list(r.data_source.data.get("y", []))
                out.append("%d %.9g %.9g" % (len(y), min(y) if y else 0,
                                             max(y) if y else 0))
    return "; ".join(out)


def _u35_dots(sp, dp, app, osp, odp, oapp, kind, want):
    import warnings
    from sfi import Macro
    from js_runner import JsSession
    r, doc, a, b = _u35_docs(sp, dp, app)
    w = [x for x in r.filter_widgets if type(x).__name__ == kind][0]
    w.value = _u35_value(w, want)
    cb = r.filter_callbacks[r.filter_widgets.index(w)]
    JsSession([]).run_code(cb.code, cb.args)
    Macro.setGlobal("u35_s", _u35_dot_rows(a))
    ws = [m for m in doc.models if type(m).__name__ == kind
          and hasattr(m, "_dash_var")]
    v = _u35_value(ws[0], want)
    ws[0].value = v
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        for key in ("value", "value_throttled"):
            for c in list(ws[0]._callbacks.get(key, [])):
                c("value", None, v)
    Macro.setGlobal("u35_v", _u35_dot_rows(b))
    _r, _d, oa, _ob = _u35_docs(osp, odp, oapp)
    Macro.setGlobal("u35_o", _u35_dot_rows(oa))
end

* ==== S35 B5c: dot rows on the saved page after a move ====
local only : env WP31_ONLY
if inlist("`only'", "", "S35") & `: list posof "S35" in w31_run' {
    display as text "S35 start " c(current_date) " " c(current_time)
    local u35d "`w31_work'/s35b"
    capture mkdir "`u35d'"
    set scheme s2color
    sysuse auto, clear
    python: import __main__ as _u35_m

    // U35-6: the dropdown at Foreign rescales mpg (12..41 -> 14..41); the
    // rows are the kept rows' own, saved and served.
    local k 0
    foreach o in "" "dotextend(no)" "ndots(20)" "horizontal" {
        local ++k
        dash clear
        capture noisily dash dot mpg weight if foreign == 1, `o' name(zu356o)
        _u35_serve "`u35d'" 6o`k'
        dash clear
        capture noisily dash dot mpg weight, `o' name(zu356)
        _w31_expect U35-6 `"(_rc == 0)"' "case `k' rc `=_rc'"
        _u35_serve "`u35d'" 6`k' foreign, type(dropdown)
        python: _u35_m._u35_dots("`u35d'/s6`k'.json", "`u35d'/d6`k'.json", "`u35d'/a6`k'.py", "`u35d'/s6o`k'.json", "`u35d'/d6o`k'.json", "`u35d'/a6o`k'.py", "Select", "Foreign")
        _w31_expect U35-6 `"("${u35_s}" == "${u35_o}")"' "case `k' saved ${u35_s}; kept build ${u35_o}"
        _w31_expect U35-6 `"("${u35_v}" == "${u35_o}")"' "case `k' served ${u35_v}; kept build ${u35_o}"
    }
    _w31_done U35-6 "dot's rows follow the re-finished axis after a move, saved and served"

    macro drop u35_s u35_v u35_o
    dash clear
    display as text "S35 end " c(current_date) " " c(current_time)
}
* ==== end S35 ====

// S35 (WP-31 D6b) helpers.  _u35_alt: the label rows of one axis (a side
// and a range name), twoway's from its SVG (u35_tw) and each mode's
// (u35_s, u35_v), as "<rows> rows, first near|far" -- the lowest label on
// the row nearest the plot is "near" -- and whether a note named
// alternate (u35_noted).
python:
def _u35_alt_tw(svg, side):
    import os, sys
    from sfi import Macro
    sys.path.insert(0, os.path.join(os.getcwd(), "..", "scripts"))
    import svg_truth
    d = svg_truth.svg_document(svg)
    pr = d["plotregion"]
    cols = {}
    for t in d["texts"]:
        v = svg_truth.label_value(t["text"])
        if v is None:
            continue
        if side in ("left", "right"):
            if not (pr["top"] - 2 <= t["y"] <= pr["bottom"] + 2):
                continue
            if (side == "left") != (t["x"] < pr["left"]):
                continue
            at = t["x"]
        else:
            if not (pr["left"] - 40 <= t["x"] <= pr["right"] + 40):
                continue
            if not (t["y"] > pr["bottom"] if side == "below"
                    else t["y"] < pr["top"]):
                continue
            at = t["y"]
        cols.setdefault(round(at), []).append(v)
    edge = {"left": pr["left"], "right": pr["right"], "below": pr["bottom"],
            "above": pr["top"]}[side]
    order = sorted(cols, key=lambda c: abs(c - edge))
    # The two columns of the axis asked for: the outermost pair on the
    # side (axis 3 is outside axes 1 and 2 on the left).
    pair = order[-2:] if len(order) >= 2 else order
    near = pair[0]
    lo = min(v for c in pair for v in cols[c])
    Macro.setGlobal("u35_tw", "%d rows, first %s" % (
        len(pair), "near" if lo in cols[near] else "far"))


def _u35_alt_dash(sp, dp, app, side, name):
    import warnings
    from sfi import Macro
    from bokeh.models.axes import ContinuousAxis
    with warnings.catch_warnings(record=True) as caught:
        warnings.simplefilter("always")
        _r, _d, a, b = _u35_docs(sp, dp, app)
    kw = "y_range_name" if side in ("left", "right") else "x_range_name"
    for figs, sfx in ((a, "s"), (b, "v")):
        f = figs[0]
        on = [x for x in getattr(f, side) if isinstance(x, ContinuousAxis)
              and getattr(x, kw) == name]
        ax = [x for x in on if "dash_alt_axis" not in (x.tags or [])]
        tw = [x for x in on if "dash_alt_axis" in (x.tags or [])]
        ok = (len(ax) == 1 and len(tw) == 1
              and dict(ax[0].formatter.args).get("parity") == 0
              and dict(tw[0].formatter.args).get("parity") == 1)
        Macro.setGlobal("u35_" + sfx, "%d rows, first %s" % (
            1 + len(tw), "near" if ok else "far"))
    Macro.setGlobal("u35_noted", "1" if any(
        "alternate" in str(w.message) for w in caught) else "0")
end

* ==== S35 D6b: alternate on axes 2 to 9 ====
local only : env WP31_ONLY
if inlist("`only'", "", "S35") & `: list posof "S35" in w31_run' {
    display as text "S35 start " c(current_date) " " c(current_time)
    local u35d "`w31_work'/s35c"
    capture mkdir "`u35d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear
    python: import __main__ as _u35_m

    // U35-7: alternate on axis 2 (right), on axis 3 (outermost left) and
    // on a top x axis, as twoway staggers them, with no note.
    local k 0
    foreach c in "(scatter mpg weight) (scatter price weight, yaxis(2)), ylabel(, axis(2) alternate) legend(off)|right|y2" "(scatter mpg weight) (scatter price weight, yaxis(2)) (scatter length weight, yaxis(3)), ylabel(, axis(3) alternate) legend(off)|left|y3" "(scatter mpg weight) (scatter mpg price, xaxis(2)), xlabel(, axis(2) alternate) legend(off)|above|x2" {
        local ++k
        gettoken cmd rest : c, parse("|")
        gettoken bar rest : rest, parse("|")
        gettoken side rest : rest, parse("|")
        gettoken bar name : rest, parse("|")
        quietly twoway `cmd' name(u35t, replace)
        quietly graph export "`u35d'/t7`k'.svg", replace
        graph drop u35t
        python: _u35_m._u35_alt_tw("`u35d'/t7`k'.svg", "`side'")
        dash clear
        capture noisily dash `cmd' name(zu357`k')
        _w31_expect U35-7 `"(_rc == 0)"' "case `k' rc `=_rc'"
        _u35_serve "`u35d'" 7`k'
        python: _u35_m._u35_alt_dash("`u35d'/s7`k'.json", "`u35d'/d7`k'.json", "`u35d'/a7`k'.py", "`side'", "`name'")
        foreach m in s v {
            _w31_expect U35-7 `"("${u35_`m'}" == "${u35_tw}")"' "case `k' `m': dash ${u35_`m'}; twoway ${u35_tw}"
        }
        _w31_expect U35-7 `"(${u35_noted} == 0)"' "case `k': dash named alternate"
    }
    _w31_done U35-7 "alternate on axes 2 and 3 staggers the labels as twoway does, saved and served"

    macro drop u35_tw u35_s u35_v u35_noted
    capture graph drop _all
    dash clear
    display as text "S35 end " c(current_date) " " c(current_time)
}
* ==== end S35 ====

// S35 (WP-31 D1b) helpers.  _u35_minor: the visible minor-label positions
// of axis <letter><num> in each mode (u35_s, u35_v), after a dropdown move
// to <want> when <kind> is given, and twoway's from
// fixtures/axisn_minor_truth.json (u35_tw: group, key, side and first
// label name the column), each as sorted numbers joined by spaces.
python:
def _u35_minor_pos(fig, letter, num):
    from bokeh.models import Label, LabelSet
    pos = []
    for m in list(fig.center) + list(fig.left) + list(fig.right) \
            + list(fig.above) + list(fig.below):
        if getattr(m, "name", None) != "dash_minor_labels" \
                or list(m.tags or []) != [letter, str(num)]:
            continue
        if isinstance(m, LabelSet):
            pos += [float(v) for v in m.source.data["pos"]]
        elif isinstance(m, Label) and m.visible:
            pos.append(float(m.x if letter == "x" else m.y))
    return " ".join("%g" % v for v in sorted(pos))


def _u35_minor(sp, dp, app, letter, num, kind, want, group, key, side,
               first):
    import json, os, warnings
    from sfi import Macro
    from js_runner import JsSession
    r, doc, a, b = _u35_docs(sp, dp, app)
    if kind:
        w = [x for x in r.filter_widgets if type(x).__name__ == kind][0]
        w.value = _u35_value(w, want)
        cb = r.filter_callbacks[r.filter_widgets.index(w)]
        JsSession([]).run_code(cb.code, cb.args)
        ws = [m for m in doc.models if type(m).__name__ == kind
              and hasattr(m, "_dash_var")]
        v = _u35_value(ws[0], want)
        ws[0].value = v
        with warnings.catch_warnings():
            warnings.simplefilter("ignore")
            for k in ("value", "value_throttled"):
                for c in list(ws[0]._callbacks.get(k, [])):
                    c("value", None, v)
    Macro.setGlobal("u35_s", _u35_minor_pos(a[0], letter, num))
    Macro.setGlobal("u35_v", _u35_minor_pos(b[0], letter, num))
    with open(os.path.join("fixtures", "axisn_minor_truth.json"),
              encoding="utf-8") as fh:
        t = json.load(fh)[group][key]["columns"][side]
    col = [c[1] for c in t if c[1] and c[1][0] == first][0]
    Macro.setGlobal("u35_tw", " ".join("%g" % v for v in sorted(
        float(x.replace(",", "")) for x in col)))
end

capture program drop _u35_d1b
program define _u35_d1b
    // _u35_d1b <dir> <k> "<dash command>" <letter> <num> <move kind or "">
    //     <fixture group> <key> <side> <first label>: one U35-8 case.
    version 19
    args dir k cmd letter num kind group key side first
    dash clear
    capture noisily dash `cmd' name(zu358`k')
    _w31_expect U35-8 `"(_rc == 0)"' "case `k' rc `=_rc'"
    if "`kind'" != "" _u35_serve "`dir'" 8`k' foreign, type(dropdown)
    else _u35_serve "`dir'" 8`k'
    python: import __main__ as _u35_m; _u35_m._u35_minor("`dir'/s8`k'.json", "`dir'/d8`k'.json", "`dir'/a8`k'.py", "`letter'", `num', "`kind'", "Foreign", "`group'", "`key'", "`side'", "`first'")
    foreach m in s v {
        _w31_expect U35-8 `"("${u35_`m'}" == "${u35_tw}")"' "case `k' `m': dash ${u35_`m'}; twoway ${u35_tw}"
    }
end

