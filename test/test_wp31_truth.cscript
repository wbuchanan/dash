    gettoken k 0 : 0
    gettoken case 0 : 0
    global u36_bad ""
    capture noisily twoway `0' name(u36t, replace)
    if _rc {
        global u36_bad "twoway rc `=_rc'"
        exit
    }
    capture graph drop u36t
    dash clear
    capture noisily dash `0' name(zu36`k')
    if _rc {
        global u36_bad "dash rc `=_rc'"
        exit
    }
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u36_m; _u36_m._u36b_check("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py", "`case'")
end

