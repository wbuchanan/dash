    _w31_expect U08-2 "(${u08_wn} == 10)" "the fixture holds ${u08_wn} spellings, want 10"
    // A loop header holds no ${...}: its brace ends the block scan.
    local n8w = ${u08_wn}
    forvalues i = 1/`n8w' {
        local cmd "${u08_wc`i'}"
        dash clear
        capture noisily dash `cmd' name(u082)
        local rc = _rc
        _w31_expect U08-2 "(${u08_wr`i'} == 0)" "twoway ${u08_ww`i'} rc ${u08_wr`i'}"
        _w31_expect U08-2 "(`rc' == 0)" "dash `cmd' rc `rc'"
        mata: st_local("hit", strofreal(strpos(st_global("dash_json_u082"), char(34) + "type" + char(34) + ":" + char(34) + st_global("u08_wf`i'") + char(34)) > 0))
        _w31_expect U08-2 "(`hit' == 1)" "dash `cmd' did not register type ${u08_wf`i'}"
    }
    _w31_done U08-2 "twoway's own plot-type spellings register as the type twoway reads"

    set linesize `u8ls'
    capture erase "`lf'"
    capture rmdir "`u8d'"
    tsset, clear
    dash clear
    display as text "S08 end " c(current_date) " " c(current_time)
}
