python:
def _u43_dp(sp, dp, app, fixture):
    """u43_bad: under set dp comma, weight's tick writer is not the comma
    format in both modes, or the writers' text differs from twoway's
    ticks (data_locale_truth.json dp.axis)."""
    import __main__ as m
    import json
    import dash_render as dr
    from sfi import Macro
    with open(fixture, encoding="utf-8") as fh:
        want = json.load(fh)["dp.axis"]["ticks"][4:]
    with open(sp, encoding="utf-8") as fh:
        spec = json.load(fh)
    bo = spec["build_options"]
    bad = []
    if bo.get("dp") != "comma" or bo["formats"].get("weight") != "%8,0gc":
        bad.append("spec dp %s weight %s" % (bo.get("dp"),
                                              bo["formats"].get("weight")))
    for mode, models in zip(("saved", "served"), m._u43_models(sp, dp, app)):
        args = [dict(x.args) for x in models
                if type(x).__name__ == "CustomJSTickFormatter"]
        if not any(a.get("fmt") == "%8,0gc" for a in args):
            bad.append("%s: no %%8,0gc tick writer in %s" % (
                mode, sorted({a.get("fmt") for a in args})))
    got = [dr._dash_fmt_text(v, "%8,0gc") for v in (2000, 3000, 4000, 5000)]
    if got != want:
        bad.append("ticks %s, twoway %s" % (got, want))
    Macro.setGlobal("u43_bad", "; ".join(bad)[:2000])


def _u43_fonts(sp, dp, app):
    """u43_bad: the spec lacks the faces translator query gph2svg gives,
    or either mode's mapper does not put fontfacesans first for stSans."""
    import __main__ as m
    import json
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    from sfi import Macro
    with open(sp, encoding="utf-8") as fh:
        bo = json.load(fh)["build_options"]
    face = bo.get("fontfacesans", "")
    bad = [] if face == Macro.getGlobal("u43_sans") else [
        "spec fontfacesans %r, graph set %r" % (face,
                                                 Macro.getGlobal("u43_sans"))]
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
        with open(app, encoding="utf-8") as fh:
            src = fh.read()
        ns = dict(__name__="dash_u43f_app")
        exec(compile(src.replace(
            "if __name__ != '__main__':\n    make_document(curdoc())", "pass"),
            "dash_u43f_app.py", "exec"), ns)
        ns["make_document"](Document())
    for mode, mp in (("saved", r.mapper), ("served", ns["_DASH_MAPPER"])):
        fam = getattr(mp, "_dash_gt_fonts", {}).get("stSans", "")
        if not fam.startswith(face):
            bad.append("%s stSans %r" % (mode, fam))
    Macro.setGlobal("u43_bad", "; ".join(bad)[:2000])


def _u43_tC():
    """u43_bad: dash's %tC conversion of the u43tC column differs from
    Stata's cofC() of it (the u43tc column)."""
    import numpy as np
    import dash_render as dr
    from sfi import Data, Macro
    C = np.asarray(Data.get(var="u43tC"), dtype=float)
    c = np.asarray(Data.get(var="u43tc"), dtype=float)
    got = dr._dash_tc_from_tC(C)
    n = int(np.sum(got != c))
    Macro.setGlobal("u43_bad", "" if n == 0 else
                    "%d of %d differ, first %s" % (n, len(c), [
                        (C[i], got[i], c[i]) for i in
                        np.flatnonzero(got != c)[:3]]))
end

* ==== S43 G2: Locale, leap seconds and fonts ====
local only : env WP31_ONLY
if inlist("`only'", "", "S43") & `: list posof "S43" in w31_run' {
    display as text "S43 start " c(current_date) " " c(current_time)
    local u43d "`w31_work'/s43g2"
    capture mkdir "`u43d'"
    local u43fx "`c(pwd)'/fixtures/data_locale_truth.json"

    // U43-03: under set dp comma the page writes weight's ticks as
    // twoway labels them (2.000 3.000 ...), saved and served.
    sysuse auto, clear
    local u43dp = c(dp)
    set dp comma
    _u43_spec "`u43d'" 5 scatter mpg weight,
    set dp `u43dp'
    python: import __main__ as _u43_m; _u43_m._u43_dp("`u43d'/s5.json", "`u43d'/d5.json", "`u43d'/a5.py", r"`u43fx'")
    _w31_expect U43-03 `"("${u43_bad}" == "")"' `"${u43_bad}"'
    _w31_done U43-03 "set dp comma reaches every tick writer as twoway writes its ticks, saved and served"

    // U43-04: the {stSans} family starts with graph set svg's
    // fontfacesans, read with translator query (no setting is changed).
    quietly translator query gph2svg
    global u43_sans `"`r(fontfacesans)'"'
    _u43_spec "`u43d'" 6 scatter mpg weight,
    python: import __main__ as _u43_m; _u43_m._u43_fonts("`u43d'/s6.json", "`u43d'/d6.json", "`u43d'/a6.py")
    _w31_expect U43-04 `"("${u43_bad}" == "")"' `"${u43_bad}"'
    _w31_done U43-04 "the font tags draw in graph set's faces, saved and served"
    macro drop u43_sans

    // U43-05: %tC converts as Stata's cofC() does, over 1972-2026 and
    // inside and after each leap second.
    clear
    quietly set obs 2000
    set seed 4305
    quietly generate double u43tC = round(tC(01jan1972 00:00:00) + runiform() * (tC(01jan2026 00:00:00) - tC(01jan1972 00:00:00)))
    quietly replace u43tC = Cofc(tc(31dec2016 23:59:59.999) + 1) - 500 in 1
    quietly replace u43tC = Cofc(tc(31dec2016 23:59:59.999) + 1) + 500 in 2
    quietly replace u43tC = Cofc(tc(30jun1972 23:59:59.999) + 1) - 1 in 3
    quietly generate double u43tc = cofC(u43tC)
    python: import __main__ as _u43_m; _u43_m._u43_tC()
    _w31_expect U43-05 `"("${u43_bad}" == "")"' `"${u43_bad}"'
    _w31_done U43-05 "%tC converts as cofC() does, inside leap seconds too"
    display as text "S43 end " c(current_date) " " c(current_time)
}
* ==== end S43 ====

python:
def _u43_shadow(sp, dp, app):
    """u43_bad: dropline ..., hover(x) with a user variable x does not
    show the user's x (read from __dashu_x), saved or served."""
    import __main__ as m
    from sfi import Data, Macro
    want = sorted(float(v) for v in Data.get(var="x"))[:3]
    bad = []
    for mode, models in zip(("saved", "served"), m._u43_models(sp, dp, app)):
        fields = [f for x in models if type(x).__name__ == "HoverTool"
                  for _l, f in (x.tooltips or [])]
        if not any(f.startswith("@{__dashu_x}") for f in fields):
            bad.append("%s fields %s" % (mode, fields))
        got = [sorted(float(v) for v in x.data["__dashu_x"])[:3]
               for x in models if type(x).__name__ == "ColumnDataSource"
               and "__dashu_x" in x.data]
        if not got or got[0] != want:
            bad.append("%s values %s, data %s" % (mode, got[:1], want))
    Macro.setGlobal("u43_bad", "; ".join(bad)[:2000])
end

* ==== S43 G3: Shadowed names and the planned count ====
local only : env WP31_ONLY
if inlist("`only'", "", "S43") & `: list posof "S43" in w31_run' {
    display as text "S43 start " c(current_date) " " c(current_time)
    local u43d "`w31_work'/s43g3"
    capture mkdir "`u43d'"

    // U43-06: twoway accepts a variable named x; dash's hover(x) shows
    // the user's x on a dropline, whose own source names a column x.
    sysuse auto, clear
    generate x = price
    capture twoway dropline mpg weight
    local u43rc = _rc
    _u43_spec "`u43d'" 7 dropline mpg weight, hover(x)
    python: import __main__ as _u43_m; _u43_m._u43_shadow("`u43d'/s7.json", "`u43d'/d7.json", "`u43d'/a7.py")
    _w31_expect U43-06 "(`u43rc' == 0)" "twoway dropline rc `u43rc'"
    _w31_expect U43-06 `"("${u43_bad}" == "")"' `"${u43_bad}"'
    _w31_done U43-06 "hover(x) shows the user's x where a derived x shadows it, saved and served"

    // U43-07: a by()-faceted computed-only graph was counted by its real
    // panels in Stata (_dash_computed_cells) as the renderer counted it.
    // Flipped (WP-33 33-15): the maintainer removed the size caps (P4-3)
    // and the count with them; the three graphs build in both routes at
    // dash_max_cells 1, and the Mata counter is gone.
    sysuse auto, clear
    local seen 0
    forvalues i = 1/`=_N' {
        if missing(rep78[`i']) {
            local ++seen
            quietly replace rep78 = cond(`seen' <= 2, .a, .b) in `i'
        }
    }
    global dash_max_cells 1
    capture dash clear
    quietly dash histogram mpg, by(foreign) name(h1)
    quietly dash kdensity mpg, by(rep78, missing total) name(h2)
    quietly dash lowess mpg weight, by(rep78) name(h3)
    capture erase "`u43d'/u43_07.html"
    capture noisily dash build, saving("`u43d'/u43_07.html") replace nobrowser
    local u43rs = _rc
    capture erase "`u43d'/u43_07.py"
    capture noisily dash build, server saving("`u43d'/u43_07.py") replace nobrowser
    local u43rv = _rc
    capture confirm file "`u43d'/u43_07.html"
    local u43fs = _rc
    capture confirm file "`u43d'/u43_07.py"
    local u43fv = _rc
    capture mata: mata describe _dash_computed_cells()
    local u43mc = _rc
    macro drop dash_max_cells
    capture dash clear
    _w31_expect U43-07 "(`u43rs' == 0 & `u43fs' == 0)" "saved build rc `u43rs', file rc `u43fs'"
    _w31_expect U43-07 "(`u43rv' == 0 & `u43fv' == 0)" "served build rc `u43rv', file rc `u43fv'"
    _w31_expect U43-07 "(`u43mc' != 0)" "_dash_computed_cells() still defined"
    _w31_done U43-07 "by() computed-only graphs build in both routes at dash_max_cells 1; the Mata counter is gone"
    display as text "S43 end " c(current_date) " " c(current_time)
}
* ==== end S43 ====

python:
def _u44_look(sp, dp, app, kind, attrs, empty=None):
    """{mode: [attr values]} of the first *kind* glyph in both modes, and
    the saved render's notes; with *empty*, the served app is built from
    the spec rewritten to walk only that empty directory (A24)."""
    import __main__ as m
    import json, warnings
    import dash_render as dr
    if empty is not None:
        with open(sp, encoding="utf-8") as fh:
            spec = json.load(fh)
        spec["build_options"]["scheme_dirs"] = [empty]
        sp = sp + ".empty.json"
        with open(sp, "w", encoding="utf-8") as fh:
            json.dump(spec, fh)
    a, b = m._u03_docs(sp, dp, app)
    out = {}
    for name, figs in (("saved", a), ("served", b)):
        gs = [r.glyph for f in figs for r in f.renderers
              if type(getattr(r, "glyph", None)).__name__ == kind
              and not dr._dash_is_swatch(r)]
        out[name] = None
        if gs:
            out[name] = [str(getattr(gs[0], x)).lower() for x in attrs]
    with warnings.catch_warnings(record=True) as w:
        warnings.simplefilter("always")
        dr.DashRenderer(sp, dp).render()
    return out, [str(x.message) for x in w]


def _u44_hex(rgb):
    p = rgb.split()
    if len(p) != 3:
        return rgb
    return "#%02x%02x%02x" % tuple(int(float(x)) for x in p)


def _u44_cmp(sp, dp, app, kind, attr, want, note_bad="", empty=None):
    """u44_bad: where either mode's *attr* differs from twoway's *want*,
    or a note holds *note_bad*."""
    from sfi import Macro
    got, notes = _u44_look(sp, dp, app, kind, [attr], empty)
    bad = []
    for name, v in got.items():
        if v is None or v[0] != want.lower():
            bad.append("%s %s=%s, twoway %s" % (name, attr, v, want))
    if note_bad:
        bad += ["note: " + n for n in notes if note_bad in n]
    Macro.setGlobal("u44_bad", "; ".join(bad))


def _u44_notes(sp, dp, want):
    """u44_bad: unless the saved render's notes hold *want*."""
    import warnings
    import dash_render as dr
    from sfi import Macro
    dr._dash_reset_notes()
    with warnings.catch_warnings(record=True) as w:
        warnings.simplefilter("always")
        dr.DashRenderer(sp, dp).render()
    got = [str(x.message) for x in w]
    Macro.setGlobal("u44_bad", "" if want in got else
                    "no note %r in %s" % (want, got[:6]))


def _u44_find(dirs_json, names):
    """u44_bad: where dash's walk finds a different file than findfile."""
    import json
    import dash_render as dr
    from sfi import Macro
    sp = dr.SchemeParser("s2color", ado_dirs=dr._dash_scheme_dirs_of(
        {"scheme_dirs": json.loads(dirs_json)}))
    bad = []
    for pair in names.split(";"):
        if not pair:
            continue
        f, want = pair.split("=", 1)
        c, n = f.split("-", 1)
        got = sp._style_file_path(c, n) or ""
        import os
        if os.path.realpath(got or "/x0") != os.path.realpath(want or "/x0"):
            bad.append("%s dash %s findfile %s" % (f, got, want))
    Macro.setGlobal("u44_bad", "; ".join(bad))


def _u44_rows(sp, key):
    import json
    from sfi import Macro
    with open(sp, encoding="utf-8") as fh:
        spec = json.load(fh)
    rows = (spec.get("build_options") or {}).get("_style_rows") or {}
    Macro.setGlobal("u44_bad", "" if key in rows else
                    "build_options._style_rows lacks %r: %s" % (
                        key, sorted(rows)[:5]))
end

capture program drop _u44_spec
program define _u44_spec
    // _u44_spec <dir> <k> <dash command>: dash's spec for the command.
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    dash clear
    quietly dash `0' name(zu44`k')
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
end

capture program drop _u44_tw
program define _u44_tw, rclass
    // _u44_tw <path> <twoway command>: plot 1's style value at <path>.
    version 19
    gettoken path 0 : 0
    capture graph drop u44g
    quietly twoway `0' nodraw name(u44g, replace)
    return local v "`.u44g.plotregion1.plot1.style.`path''"
    capture graph drop u44g
end

* ==== S44 E10: Style file resolver ====
local only : env WP31_ONLY
if inlist("`only'", "", "S44") & `: list posof "S44" in w31_run' {
    display as text "S44 start " c(current_date) " " c(current_time)
    local u44d "`w31_work'/s44"
    capture mkdir "`u44d'"
    local u44u "`u44d'/ado"
    capture mkdir "`u44u'"
    capture mkdir "`u44u'/style"
    local u44fx "`c(pwd)'/fixtures/style_files_truth.json"
    tempname u44f
    file open `u44f' using "`u44u'/style/linestyle-u44b.style", write text replace
    file write `u44f' "set width thick" _n "set color red" _n "set pattern dash" _n
    file close `u44f'
    file open `u44f' using "`u44u'/scheme-u44h.scheme", write text replace
    file write `u44f' "#include s2color" _n "linestyle ci u44b" _n
    file close `u44f'
    file open `u44f' using "`u44u'/scheme-u44n.scheme", write text replace
    file write `u44f' "#include s2color" _n "linestyle ci nosuch" _n
    file close `u44f'
    adopath ++ "`u44u'"
    // twoway lists a style class's files once a session, at its first
    // graph: a session that drew before linestyle-u44b.style existed notes
    // "named style u44b not found" and draws black (measured 17oct2026,
    // the certification run's shared sessions).  discard drops that list
    // (and the auto-loaded programs, which load again); the programs this
    // script defines stay.
    discard
    sysuse auto, clear

    // U44-01: the fixture is stamped and lists the 161 files.
    python: import json; from sfi import Macro; _u44_d = json.load(open(Macro.getLocal("u44fx"))); Macro.setGlobal("u44_bad", "" if sum(len(_u44_d["all.files"][c]) for c in ("linestyle", "areastyle", "markerstyle", "seriesstyle")) == 161 and len(_u44_d["_meta"]) == 5 else "fixture")
    _w31_expect U44-01 `"("${u44_bad}" == "")"' "${u44_bad}"
    _w31_done U44-01 "style_files_truth.json is stamped and lists the 161 style files"

    // U44-02: dash's walk finds the file findfile finds.
    local pairs ""
    foreach f in linestyle-refline markerstyle-refmarker areastyle-plotregion seriesstyle-fpall shadestyle-foreground linestyle-u44b {
        capture findfile `f'.style
        local fn ""
        if !_rc local fn "`r(fn)'"
        local pairs "`pairs'`f'=`fn';"
    }
    _dash_scheme_dirs
    python: _u44_find(r"""`macval(_dash_sdirs)'""", r"`pairs'")
    _w31_expect U44-02 `"("${u44_bad}" == "")"' "${u44_bad}"
    _w31_done U44-02 "the style file dash reads is the one findfile finds"

    // U44-03: Stata names outside the table draw their file, both modes.
    local k 0
    local u3bad ""
    foreach c in "Scatter fill_color marker.fillcolor.rgb scatter mpg weight, mstyle(refmarker)" ///
        "Scatter fill_color marker.fillcolor.rgb scatter mpg weight, pstyle(fpall)" ///
        "VArea fill_color area.shadestyle.color.rgb area mpg weight, sort astyle(plotregion)" {
        local ++k
        gettoken kind c : c
        gettoken attr c : c
        gettoken path c : c
        _u44_tw `path' `c'
        python: from sfi import Macro; Macro.setLocal("want", _u44_hex(r"`r(v)'"))
        _u44_spec "`u44d'" `k' `c'
        python: _u44_cmp(r"`u44d'/s`k'.json", r"`u44d'/d`k'.json", r"`u44d'/a`k'.py", "`kind'", "`attr'", r"`want'", "not drawn by dash")
        if "${u44_bad}" != "" local u3bad "`u3bad' [`c': ${u44_bad}]"
    }
    _w31_expect U44-03 `"(`"`u3bad'"' == "")"' `"`u3bad'"'
    _w31_done U44-03 "mstyle(refmarker), pstyle(fpall), astyle(plotregion) draw their files as twoway, both modes"

    // U44-04: a scheme directive redefines a hop; one naming no style is
    // noted in twoway's words.
    _u44_tw line.color.rgb line mpg weight, sort pstyle(ci) scheme(u44h)
    local want = "`r(v)'"
    python: from sfi import Macro; Macro.setLocal("want", _u44_hex(r"`want'"))
    _u44_spec "`u44d'" 4 line mpg weight, sort pstyle(ci) scheme(u44h)
    python: _u44_cmp(r"`u44d'/s4.json", r"`u44d'/d4.json", r"`u44d'/a4.py", "Line", "line_color", r"`want'")
    local u4bad "${u44_bad}"
    _u44_spec "`u44d'" 5 line mpg weight, sort pstyle(ci) scheme(u44n)
    python: _u44_notes(r"`u44d'/s5.json", r"`u44d'/d5.json", "dash: named style nosuch not found in class linestyle, default attributes used")
    local u4bad "`u4bad'${u44_bad}"
    _w31_expect U44-04 `"(`"`u4bad'"' == "")"' `"`u4bad'"'
    _w31_done U44-04 "linestyle ci u44b redefines pstyle(ci)'s line; linestyle ci nosuch is noted as twoway notes it"

    // U44-05: c(adoarchive) is undefined here (r(133)); the spec carries "".
    capture local u44aa = c(adoarchive)
    local u5rc = _rc
    python: import json; from sfi import Macro; Macro.setGlobal("u44_bad", "" if json.load(open(Macro.getLocal("u44d") + "/s4.json"))["build_options"].get("adoarchive") == "" else "adoarchive key")
    _w31_expect U44-05 `"(`u5rc' == 133 & "${u44_bad}" == "")"' "c(adoarchive) rc `u5rc' ${u44_bad}"
    _w31_done U44-05 "c(adoarchive) is undefined (r(133)) and the spec writes it empty"

    // U44-06: a style file that is a link out of its directory, and one
    // over 1 MiB, are refused with one note, the default drawn, rc 0.
    shell ln -sf /etc/hosts "`u44u'/style/linestyle-u44x.style"
    python: open(r"`u44u'/style/linestyle-u44y.style", "w").write("set color red\n" + "*" * 2097152 + "\n")
    _u44_spec "`u44d'" 6 line mpg weight, sort lstyle(u44x)
    local u6rc = _rc
    python: _u44_notes(r"`u44d'/s6.json", r"`u44d'/d6.json", "dash: style file linestyle-u44x.style was not read ('linestyle-u44x.style' for scheme 'u44x' resolves via symlink outside allowed directories (the directory it was found in); it was not read.); default attributes used")
    local u6bad "${u44_bad}"
    _u44_spec "`u44d'" 7 line mpg weight, sort lstyle(u44y)
    python: _u44_cmp(r"`u44d'/s7.json", r"`u44d'/d7.json", r"`u44d'/a7.py", "Line", "line_color", "#000000")
    local u6bad "`u6bad'${u44_bad}"
    _w31_expect U44-06 `"(`u6rc' == 0 & `"`u6bad'"' == "")"' `"`u6bad'"'
    _w31_done U44-06 "a linked or oversized style file is refused with a note and the default drawn"

    // U44-07: the registered spec embeds the user file's rows, and the
    // served app over an empty walk draws them as the saved page does.
    _u44_spec "`u44d'" 8 line mpg weight, sort lstyle(u44b)
    python: _u44_rows(r"`u44d'/s8.json", "linestyle u44b")
    local u7bad "${u44_bad}"
    capture mkdir "`u44d'/empty"
    python: _u44_cmp(r"`u44d'/s8.json", r"`u44d'/d8.json", r"`u44d'/a8.py", "Line", "line_color", "#ff0000", empty=r"`u44d'/empty")
    local u7bad "`u7bad'${u44_bad}"
    _w31_expect U44-07 `"(`"`u7bad'"' == "")"' `"`u7bad'"'
    _w31_done U44-07 "the spec carries _style_rows and an empty walk draws them in both modes"

    // U44-08: a class directive on a plot's own default style: a line
    // plot's line under linestyle p1line, a connected plot's under
    // linestyle p1, both modes as twoway.
    file open `u44f' using "`u44u'/scheme-u44l.scheme", write text replace
    file write `u44f' "#include s2color" _n "linestyle p1line u44b" _n
    file close `u44f'
    file open `u44f' using "`u44u'/scheme-u44p.scheme", write text replace
    file write `u44f' "#include s2color" _n "linestyle p1 u44b" _n
    file close `u44f'
    local u8bad ""
    local k 20
    foreach c in "u44l line" "u44p connected" "u44p line" {
        local ++k
        gettoken sch c : c
        local c = strtrim("`c'")
        _u44_tw line.color.rgb `c' mpg weight, sort scheme(`sch')
        python: from sfi import Macro; Macro.setLocal("want", _u44_hex(r"`r(v)'"))
        _u44_spec "`u44d'" `k' `c' mpg weight, sort scheme(`sch')
        python: _u44_cmp(r"`u44d'/s`k'.json", r"`u44d'/d`k'.json", r"`u44d'/a`k'.py", "Line", "line_color", r"`want'")
        if "${u44_bad}" != "" local u8bad "`u8bad' [`sch' `c': ${u44_bad}]"
    }
    _w31_expect U44-08 `"(`"`u8bad'"' == "")"' `"`u8bad'"'
    _w31_done U44-08 "linestyle p1line and linestyle p1 redraw a plot's own line as twoway, both modes"

    // U44-12: on a host without Stata's BASE (the spec's ado-path cut to
    // the user directory) the keys embedded at registration
    // (build_options._stata_props: s2color's linestyle p1line) keep a line
    // plot's line under linestyle p1 u44b, both modes, as twoway.
    _u44_tw line.color.rgb line mpg weight, sort scheme(u44p)
    python: from sfi import Macro; Macro.setLocal("want", _u44_hex(r"`r(v)'"))
    _u44_spec "`u44d'" 30 line mpg weight, sort scheme(u44p)
    python: import json; from sfi import Macro; Macro.setGlobal("u44_bad", "" if "u44p" in json.load(open(Macro.getLocal("u44d") + "/s30.json"))["build_options"].get("_stata_props", {}) else "no _stata_props for u44p")
    local u12bad "${u44_bad}"
    python: _u44_cmp(r"`u44d'/s30.json", r"`u44d'/d30.json", r"`u44d'/a30.py", "Line", "line_color", r"`want'", empty=r"`u44u'")
    local u12bad "`u12bad'${u44_bad}"
    _w31_expect U44-12 `"(`"`u12bad'"' == "")"' `"`u12bad'"'
    _w31_done U44-12 "Stata's own scheme keys travel in the spec: a host without BASE draws linestyle p1 as twoway, both modes"

    adopath - "`u44u'"
    dash clear
    display as text "S44 end " c(current_date) " " c(current_time)
}
* ==== end S44 ====

python:
def _u44_palette(sp, dp, app, fixture, scheme):
    """u44_bad: where either mode's colorvar() palette differs from
    twoway's colordiscrete key under *scheme* (lowest level first)."""
    import __main__ as m
    import json
    from sfi import Macro
    with open(fixture, encoding="utf-8") as fh:
        want = list(reversed(json.load(fh)["schemes"][scheme]["S5"]["key"]["fills"]))
    a, b = m._u03_docs(sp, dp, app)
    bad = []
    for name, figs in (("saved", a), ("served", b)):
        pal = None
        for f in figs:
            for r in f.renderers:
                t = getattr(getattr(getattr(r, "glyph", None), "fill_color", None), "transform", None)
                if t is not None and getattr(t, "palette", None):
                    pal = [str(c).lower() for c in t.palette]
        ok = pal is not None and len(pal) == len(want)
        if ok:
            for g, w in zip(pal, want):
                if any(abs(int(g[i:i + 2], 16) - int(w[i:i + 2], 16)) > 1 for i in (1, 3, 5)):
                    ok = False
        if not ok:
            bad.append("%s %s, twoway %s" % (name, pal, want))
    Macro.setGlobal("u44_bad", "; ".join(bad))
end

* ==== S44 C8c: A user scheme's colorvar() default ====
local only : env WP31_ONLY
if inlist("`only'", "", "S44") & `: list posof "S44" in w31_run' {
    display as text "S44 start " c(current_date) " " c(current_time)
    local u44d "`w31_work'/s44c"
    capture mkdir "`u44d'"
    local u44fx "`c(pwd)'/fixtures/user_scheme_rule_truth.json"
    tempname u44f
    file open `u44f' using "`u44d'/scheme-uc2.scheme", write text replace
    file write `u44f' "#include s2color" _n "color contour_begin green" _n "color contour_end orange" _n
    file close `u44f'
    adopath ++ "`u44d'"
    sysuse auto, clear

    // U44-09: scheme(uc2)'s colordiscrete key, both modes, as twoway's
    // (the fixture's twoway SVG).
    _u44_spec "`u44d'" 9 scatter mpg weight, colorvar(rep78) colordiscrete scheme(uc2)
    python: _u44_palette(r"`u44d'/s9.json", r"`u44d'/d9.json", r"`u44d'/a9.py", r"`u44fx'", "uc2")
    _w31_expect U44-09 `"("${u44_bad}" == "")"' "${u44_bad}"
    _w31_done U44-09 "a user scheme's contour_begin and contour_end draw twoway's colorvar() colours, both modes"

    adopath - "`u44d'"
    dash clear
    display as text "S44 end " c(current_date) " " c(current_time)
}
* ==== end S44 ====

python:
def _u44_title(sp, dp, app, svg):
    """u44_bad: where either mode's title size differs from twoway's
    points on the graph (*svg*) at the scheme's reference, 4 / ref."""
    import __main__ as m
    import re
    from sfi import Macro
    with open(svg, encoding="utf-8") as fh:
        txt = fh.read()
    g = re.search(r'width="([\d.]+)in" height="([\d.]+)in" viewBox="0 0 ([\d.]+) ([\d.]+)"', txt)
    f = re.search(r"font-size:([\d.]+)px[^>]*>Tq</text>", txt)
    hin = float(g.group(2))
    pt = float(f.group(1)) / (float(g.group(4)) / hin) * 72.0
    want = pt * 4.0 / min(float(g.group(1)), hin)
    a, b = m._u03_docs(sp, dp, app)
    bad = []
    for name, figs in (("saved", a), ("served", b)):
        got = [str(x.title.text_font_size) for x in figs if getattr(x.title, "text", "")]
        if not got or abs(float(got[0].rstrip("pt")) - want) > 0.05:
            bad.append("%s %s, twoway %.3fpt" % (name, got, want))
    Macro.setGlobal("u44_bad", "; ".join(bad))
end

* ==== S44 E11b: A scheme's #-pt gsizes at its own reference ====
local only : env WP31_ONLY
if inlist("`only'", "", "S44") & `: list posof "S44" in w31_run' {
    display as text "S44 start " c(current_date) " " c(current_time)
    local u44d "`w31_work'/s44e"
    capture mkdir "`u44d'"
    tempname u44f
    file open `u44f' using "`u44d'/scheme-u11a.scheme", write text replace
    file write `u44f' "#include s2color" _n "graphsize x 3.12" _n "graphsize y 2.392" _n "gsize heading 12-pt" _n
    file close `u44f'
    adopath ++ "`u44d'"
    sysuse auto, clear

    // U44-10: gsize heading 12-pt under a 3.12 x 2.392 in scheme: the
    // title twoway draws (live SVG) and dash's, both modes.
    capture graph drop u44t
    quietly twoway scatter mpg weight, title("Tq") scheme(u11a) name(u44t, replace)
    quietly graph export "`u44d'/u11a.svg", replace name(u44t)
    capture graph drop u44t
    _u44_spec "`u44d'" 10 scatter mpg weight, title("Tq") scheme(u11a)
    python: _u44_title(r"`u44d'/s10.json", r"`u44d'/d10.json", r"`u44d'/a10.py", r"`u44d'/u11a.svg")
    _w31_expect U44-10 `"("${u44_bad}" == "")"' "${u44_bad}"
    _w31_done U44-10 "a scheme's 12-pt heading on a 2.392 in graph draws twoway's 12 points, both modes"

    adopath - "`u44d'"
    dash clear
    display as text "S44 end " c(current_date) " " c(current_time)
}
* ==== end S44 ====

python:
def _u44_absent(sp, dp, needle):
    """u44_bad: the saved render's notes that hold *needle*."""
    import warnings
    import dash_render as dr
    from sfi import Macro
    dr._dash_reset_notes()
    with warnings.catch_warnings(record=True) as w:
        warnings.simplefilter("always")
        dr.DashRenderer(sp, dp).render()
    Macro.setGlobal("u44_bad", "; ".join(str(x.message) for x in w if needle in str(x.message)))


def _u44_panel_fill(sp, dp, app, want):
    """u44_bad: where a mode's by() panels are not filled *want*."""
    import __main__ as m
    from sfi import Macro
    a, b = m._u03_docs(sp, dp, app)
    bad = []
    for name, figs in (("saved", a), ("served", b)):
        fills = sorted({str(getattr(f, "background_fill_color", "")).lower() for f in figs})
        if want.lower() not in fills:
            bad.append("%s %s, twoway %s" % (name, fills, want))
    Macro.setGlobal("u44_bad", "; ".join(bad))
end

