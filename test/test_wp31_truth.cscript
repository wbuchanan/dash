python:
def _u40_line(sp, dp, app, key):
    """The first Line glyph's dash list and the first marker's, saved and
    served, into __main__._u40_lines[key], with the saved render's
    pattern notes."""
    import __main__ as m
    import warnings
    import dash_render as dr
    a, b = m._u03_docs(sp, dp, app)
    out = []
    for figs in (a, b):
        rs = [r for r in figs[0].renderers
              if type(getattr(r, "glyph", None)).__name__ in ("Line", "Scatter")
              and not dr._dash_is_swatch(r)]
        out.append(tuple(list(r.glyph.line_dash) for r in rs[:1]))
    with warnings.catch_warnings(record=True) as w:
        warnings.simplefilter("always")
        dr.DashRenderer(sp, dp).render()
    notes = [str(x.message) for x in w if "pattern" in str(x.message)]
    seen = getattr(m, "_u40_lines", {})
    seen[key] = (out, notes)
    m._u40_lines = seen
end

python:
def _u40_pverdict(fixture):
    """What differs from twoway's runs (symbol_pattern_truth.json) for
    the dash lists _u40_line saw, into u40_bad: each fixture key's runs,
    to the whole pixel (Bokeh's dash lists are integers), saved and
    served alike; a noted key draws solid with one note."""
    import __main__ as m
    import json
    import dash_render as dr
    from sfi import Macro
    with open(fixture, encoding="utf-8") as fh:
        t = json.load(fh)
    unit = dr.OptionTranslator.PT_PER_RS * dr.OptionTranslator.PX_PER_PT
    bad = []
    for key, (out, notes) in sorted(m._u40_lines.items()):
        if out[0] != out[1]:
            bad.append("%s saved %s served %s" % (key, out[0], out[1]))
        px = out[0][0] if out[0] else []
        rec = t[key]
        if rec.get("note"):
            if px != [] or len(notes) != 1:
                bad.append("%s drew %s notes %s" % (key, px, notes))
            continue
        if notes:
            bad.append("%s noted %s" % (key, notes))
        runs = rec.get("runs_rs", [])
        if key.startswith("mlp."):
            if px != []:
                bad.append("%s outline %s, twoway solid" % (key, px))
            continue
        if not runs:
            if px and px[0] != 0:
                bad.append("%s drew %s, twoway solid or blank" % (key, px))
            continue
        for i, r in enumerate(runs):
            got = px[i % len(px)] if px else None
            want = r * unit
            if got is None or not (abs(got - want) <= 0.6
                                   or (want < 1 and got == 1)):
                bad.append("%s run %d: %s px, twoway %.3f" % (key, i, got, want))
                break
    Macro.setGlobal("u40_bad", "; ".join(bad)[:2000])
end

