    graph drop u33t

    // U33-05: noextend ends the line at the first and last tick and
    // outergap(5) widens the border by twoway's gap.
    _u33_reg "`u33d'" 5 scale scatter mpg weight, yscale(noextend outergap(5))
    foreach m in s v {
        _w31_expect U33-05 `"("${u33_`m'}" == "${u33_tw}")"' "`m': dash ${u33_`m'}; twoway ${u33_tw}"
    }
    _w31_done U33-05 "yscale(noextend outergap(5)) as twoway draws it, saved and served"

    // U33-06: two yscale(alt) copies leave the axis where twoway does.
    _u33_reg "`u33d'" 6 side scatter mpg weight, yscale(alt) yscale(alt)
    foreach m in s v {
        _w31_expect U33-06 `"("${u33_`m'}" == "${u33_tw}")"' "`m': dash ${u33_`m'}; twoway ${u33_tw}"
    }
    _w31_done U33-06 "yscale(alt) yscale(alt) toggles back, saved and served"

    macro drop u33_tw u33_s u33_v u33_noted
    capture graph drop _all
    dash clear
    display as text "S33 end " c(current_date) " " c(current_time)
}
