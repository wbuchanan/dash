python:
def _u41_svg_fills(svg):
    """The marker fills twoway's SVG draws, in order of first use."""
    import re
    with open(svg, encoding="utf-8") as fh:
        txt = fh.read()
    out = []
    for c in re.findall(r'<circle [^>]*style="fill:(#[0-9A-Fa-f]{6})"', txt):
        if c.lower() not in out:
            out.append(c.lower())
    return out


def _u41_marks(sp, dp, app, svg):
    """U41-02/U41-04: dash's series fills and symbols, saved and served,
    and its notes, against twoway's fills."""
    from sfi import Macro
    want = _u41_svg_fills(svg)
    (a, b), notes = _u41_glyphs(sp, dp, app, "Scatter")
    bad = []
    for name, gs in (("saved", a), ("served", b)):
        got = [str(g.fill_color).lower() for g in gs]
        if got != want:
            bad.append("%s fills %s, twoway %s" % (name, got, want))
    Macro.setGlobal("u41_sym", " ".join(str(g.marker) for g in a + b))
    Macro.setGlobal("u41_notes", " | ".join(notes)[:500])
    prev = Macro.getGlobal("u41_bad")
    Macro.setGlobal("u41_bad", "; ".join([prev] * bool(prev) + bad))
end

capture program drop _u41_markcase
program define _u41_markcase
    // _u41_markcase <dir> <k> <command>: twoway's and dash's markers.
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    capture graph drop u41t
    quietly twoway `0' scheme(s2color) name(u41t, replace)
    quietly graph export "`dir'/t`k'.svg", replace
    graph drop u41t
    _u41_spec "`dir'" `k' `0' scheme(s2color)
    python: import __main__ as _u41_m; _u41_m._u41_marks("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py", "`dir'/t`k'.svg")
end

