// S23 B4a helper.  _u23_check(case, arg): one comparison of dash's
// contour surface helpers with twoway's generator, read from
// fixtures/contour_truth.json (scripts/extract_contour_truth.do) or from
// a heatmap matrix measured live (u23_M, Mata); globals u23_ok (1 when
// it holds) and u23_msg (what was compared).
python:
def _u23_check(case, arg=""):
    import json
    import os
    import sys
    import numpy as np
    for p in (os.path.abspath(".."), os.path.abspath(".")):
        if p not in sys.path:
            sys.path.insert(0, p)
    import dash_render as dr
    from sfi import Macro, Mata
    with open(os.path.join("fixtures", "contour_truth.json"), encoding="utf-8") as fh:
        t = json.load(fh)
    ok, msg = True, ""

    def node_index(hm, gx, gy):
        return (np.searchsorted(gy, np.asarray(hm["y0"]), side="left"),
                np.searchsorted(gx, np.asarray(hm["x0"]), side="left"))

    if case == 1:
        for ds in ("auto", "synthetic", "manual5"):
            inp = t["cases"][ds]["thinplatespline"]["input"]
            g = dr._dash_contour_grid(inp["x"], inp["y"])
            for axis, a in zip(("x", "y"), g):
                e = np.concatenate([[a[0]], (a[1:] + a[:-1]) / 2, [a[-1]]])
                want = np.asarray(t["grid"][ds][axis])
                ok &= e.shape == want.shape and bool(np.allclose(e, want, rtol=1e-6))
            msg += "%s %dx%d; " % (ds, g[0].size, g[1].size)
    elif case == 2:
        m = Mata.get("u23_M")
        node = [r[2] for r in m if r[0] == 2 and r[1] == 2]
        px, py, pz = dr._dash_contour_points([1, 2, 1, 2, 2], [1, 1, 2, 2, 2],
                                             [1, 2, 3, 4, 5])
        ok = pz.size == 4 and pz[-1] == 4 and node == [4.0]
        hm = t["cases"]["manual5"]["none"]["heatmap"]
        lev = [lv for x0, x1, y0, y1, lv in zip(hm["x0"], hm["x1"], hm["y0"],
                                               hm["y1"], hm["lev"])
               if x0 <= 2 <= x1 and y0 <= 2 <= y1][0]
        ok &= int(np.searchsorted(t["cases"]["manual5"]["none"]["cuts"], 4.0,
                                  side="right")) + 1 == lev
        msg = "dash keeps z %g of 4 rows; twoway's interp(none) node %s, level %d" % (
            pz[-1], node, lev)
    elif case == 3:
        for ds in ("auto", "synthetic", "manual5"):
            for it in ("thinplatespline", "shepard"):
                c = t["cases"][ds][it]
                inp, hm, cuts = c["input"], c["heatmap"], np.asarray(c["cuts"])
                x, y = np.asarray(inp["x"]), np.asarray(inp["y"])
                gx, gy = dr._dash_contour_grid(x, y)
                iy, ix = node_index(hm, gx, gy)
                at = dict(zip(zip(iy, ix), hm["z"]))
                # twoway's own pick at a duplicate (y, x) under these two
                # methods follows the sort seed: fit to the z it shows.
                z = np.array([at[(np.searchsorted(gy, b), np.searchsorted(gx, a))]
                              for a, b in zip(x, y)])
                s = dr._dash_contour_surface(x, y, z, it)
                got, want = s["gz"][iy, ix], np.asarray(hm["z"])
                span = s["zmax"] - s["zmin"]
                tol = 1e-6 if s["note"] == "singular" else 1e-9
                far = (np.min(np.abs(got[:, None] - cuts[None, :]), axis=1)
                       > 1e-6 * span) | (got == want)
                lev = np.searchsorted(cuts, got[far], side="right") + 1
                same = bool(np.array_equal(lev, np.asarray(hm["lev"])[far]))
                close = bool(np.allclose(got, want, rtol=tol, atol=tol * span))
                ok &= same and close and want.size == gx.size * gy.size
                msg += "%s/%s %d nodes z %d level %d; " % (
                    ds, it[:4], want.size, close, same)
    elif case == 4:
        for ds in ("auto", "synthetic", "manual5"):
            c = t["cases"][ds]["none"]
            inp = c["input"]
            s = dr._dash_contour_surface(inp["x"], inp["y"], inp["z"], "none")
            n = int(np.isfinite(s["gz"]).sum())
            ok &= n == inp["n_unique"] == c["heatmap"]["n_rects"]
            msg += "%s %d/%d; " % (ds, n, c["heatmap"]["n_rects"])
    elif case == 5:
        rng = np.random.default_rng(5)
        a = rng.uniform(0, 10, 1001)
        b = rng.uniform(0, 5, 1001)
        c = rng.normal(size=1001)
        hi = dr._dash_contour_surface(a, b, c)
        lo = dr._dash_contour_surface(a[:1000], b[:1000], c[:1000], "none")
        ok = (hi["capped"] is True and hi["gz"].shape == (100, 100)
              and lo["capped"] is False and lo["gz"].shape == (1000, 1000))
        msg = "1001 points capped %s %s; 1000 capped %s %s" % (
            hi["capped"], hi["gz"].shape, lo["capped"], lo["gz"].shape)
    elif case == 6:
        word = "" if arg == "EMPTY" else arg
        got = dr._dash_contour_interp(word)
        want = t["interp_abbrev"][arg]["method"]
        ok = got == want
        msg = "interp(%s): dash %s, twoway %s" % (word, got, want)
    Macro.setGlobal("u23_ok", str(int(bool(ok))))
    Macro.setGlobal("u23_msg", msg[:240])
end

* ==== S23 B4a: contour interpolation ====
local only : env WP31_ONLY
if inlist("`only'", "", "S23") & `: list posof "S23" in w31_run' {
    display as text "S23 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // U23-1: dash's grid is twoway's -- the heatmap's rectangle edges are
    // the midpoints of consecutive distinct x (and y) and the min and max.
    // ------------------------------------------------------------
    python: _u23_check(1)
    _w31_expect U23-1 "(${u23_ok} == 1)" "grid edges: ${u23_msg}"
    _w31_done U23-1 "the grid is the distinct x by the distinct y: ${u23_msg}"

    // ------------------------------------------------------------
    // U23-2: a duplicate (y, x) keeps its smallest z, as twoway's help
    // says and its interp(none) does, measured live.
    // ------------------------------------------------------------
    clear
    mata: u23_D = (1,1,1 \ 1,2,2 \ 2,1,3 \ 2,2,4 \ 2,2,5)
    quietly set obs 5
    foreach v in y x z {
        quietly generate double `v' = .
    }
    mata: st_store(., ("y", "x", "z"), u23_D)
    mata: u23_M = _contour_heatmap("z", "y", "x", (2 \ 3 \ 4), "none")
    python: _u23_check(2)
    _w31_expect U23-2 "(${u23_ok} == 1)" "${u23_msg}"
    _w31_done U23-2 "the duplicate rule: ${u23_msg}"

    // ------------------------------------------------------------
    // U23-3: every node's z and level under thinplatespline and shepard
    // equal twoway's heatmap on auto, the synthetic set and manual5.
    // ------------------------------------------------------------
    python: _u23_check(3)
    _w31_expect U23-3 "(${u23_ok} == 1)" "${u23_msg}"
    _w31_done U23-3 "node values and levels match twoway's: ${u23_msg}"

    // ------------------------------------------------------------
    // U23-4: interp(none) draws the observed nodes only, as many as
    // twoway's heatmap rectangles.
    // ------------------------------------------------------------
    python: _u23_check(4)
    _w31_expect U23-4 "(${u23_ok} == 1)" "${u23_msg}"
    _w31_done U23-4 "interp(none) draws the observed nodes: ${u23_msg}"

    // ------------------------------------------------------------
    // U23-5: above _DASH_CONTOUR_EXACT_MAX distinct points the surface is
    // a flagged 100x100 grid; at the cap it is exact (DECISIONS D4).
    // ------------------------------------------------------------
    python: _u23_check(5)
    _w31_expect U23-5 "(${u23_ok} == 1)" "${u23_msg}"
    _w31_done U23-5 "the cap: ${u23_msg}"

    // ------------------------------------------------------------
    // U23-6: twoway never refuses an interp() word: its generator reads
    // a 4-letter-or-longer abbreviation of thinplatespline or shepard and
    // draws any other word as none.  Measured live on bogus: rc 0 and the
    // heatmap of interp(none).
    // ------------------------------------------------------------
    capture twoway contour z y x, interp(bogus) nodraw
    local u23rc = _rc
    mata: st_local("u23same", strofreal(_contour_heatmap("z", "y", "x", (2 \ 3 \ 4), "bogus") == _contour_heatmap("z", "y", "x", (2 \ 3 \ 4), "none")))
    _w31_expect U23-6 "(`u23rc' == 0 & `u23same' == 1)" "twoway contour, interp(bogus): rc `u23rc', drawn as none `u23same'"
    foreach w in thinplatespline thin shepard shep th sh none bogus EMPTY {
        python: _u23_check(6, "`w'")
        _w31_expect U23-6 "(${u23_ok} == 1)" "${u23_msg}"
    }
    _w31_done U23-6 "interp() words read as twoway's generator reads them; bogus draws as none, r(0)"

    capture mata: mata drop u23_D u23_M
    macro drop u23_ok u23_msg
    clear
    capture graph drop _all
    display as text "S23 end " c(current_date) " " c(current_time)
}
* ==== end S23 ====

// S24 (WP-31 D1) helpers: register one dash graph, write its spec and
// data, and read the minor ticks and labels both modes draw.
// _u24_draw sets u24_x<m> (the x axis's minor positions), u24_y<m> (the
// y axis's), u24_y2<m> (the second y axis's), u24_l<m> (the x axis's minor
// labels, "pos|text" each) and u24_lo<m> (the x range's start), m = s
// saved, v served; numbers written %.10g.
python:
def _u24_draw(sp, dp, app):
    import __main__ as m
    from sfi import Macro
    from bokeh.models import CustomJSTicker, LabelSet
    a, b = m._u03_docs(sp, dp, app)

    def _minor(f, letter, name):
        sides = (f.below + f.above) if letter == "x" else (f.left + f.right)
        attr = letter + "_range_name"
        out = []
        for ax in sides:
            t = getattr(ax, "ticker", None)
            if getattr(ax, attr, "default") != name \
                    or not isinstance(t, CustomJSTicker):
                continue
            ar = dict(t.args or {})
            out += list(ar.get("mextra") or []) + list(ar.get("extra") or [])
            if ar.get("mfixed") is not None:
                out += list(ar["mfixed"].ticks or [])
        return " ".join(format(float(v), ".10g") for v in sorted(set(out)))

    for figs, sfx in ((a, "s"), (b, "v")):
        f = figs[0]
        Macro.setGlobal("u24_x" + sfx, _minor(f, "x", "default"))
        Macro.setGlobal("u24_y" + sfx, _minor(f, "y", "default"))
        Macro.setGlobal("u24_y2" + sfx, _minor(f, "y", "y2"))
        rows = []
        for mdl in f.center:
            if isinstance(mdl, LabelSet) and mdl.name == "dash_minor_labels" \
                    and list(mdl.tags or [])[:1] == ["x"]:
                d = mdl.source.data
                rows += ["%s|%s" % (format(float(p), ".10g"), t)
                         for p, t in zip(d["pos"], d["text"])]
        Macro.setGlobal("u24_l" + sfx, " ".join(rows))
        Macro.setGlobal("u24_lo" + sfx, format(float(f.x_range.start), ".10g"))
end

capture program drop _u24_reg
program define _u24_reg
    // _u24_reg <dir> <k> <dash command...>
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    dash clear
    capture quietly dash `0'
    if _rc {
        foreach m in s v {
            foreach g in x y y2 l lo {
                global u24_`g'`m' "rc `=_rc'"
            }
        }
        exit
    }
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u24_m; _u24_m._u24_draw("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py")
end

capture program drop _u24_tw
program define _u24_tw
    // _u24_tw <axis> <set>: twoway's positions on u24t's tickset, its
    // rule walked as tickset_g.class draws it, else its listed ticks,
    // into global u24_tw ("%.10g" each).
    version 19
    args axis set
    local p ".u24t.`axis'.`set'"
    local out ""
    if 0``p'.use_rule.istrue' & "``p'.delta'" != "0" & "``p'.min'" != "." {
        local lo = ``p'.min'
        local hi = ``p'.max'
        local d = ``p'.delta'
        if abs(`lo') < 1e299 & abs(`hi') < 1e299 {
            local n = floor((`hi' + .48 * `d' - `lo') / `d')
            forvalues i = 0/`n' {
                local x = `lo' + `i' * `d'
                if abs(`x') < `d' * 1e-6 local x 0
                local out "`out' `=strtrim(string(`x', "%18.10g"))'"
            }
        }
    }
    else {
        forvalues i = 1/0``p'.ticks.arrnels' {
            local out "`out' `=strtrim(string(``p'.ticks[`i'][1]', "%18.10g"))'"
        }
    }
    global u24_tw = strtrim("`out'")
end

* ==== S24 D1: Minor ticks and labels ====
local only : env WP31_ONLY
if inlist("`only'", "", "S24") & `: list posof "S24" in w31_run' {
    display as text "S24 start " c(current_date) " " c(current_time)
    local u24d "`w31_work'/s24"
    capture mkdir "`u24d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear

    // U24-1: xmtick(##5) over xlabel(0(1000)5000): twoway's minornl rule
    // walked (0(200)5000), the positions dash's ticker carries, both modes.
    quietly twoway scatter mpg weight, xlabel(0(1000)5000) xmtick(##5) name(u24t, replace)
    _u24_tw xaxis1 minornl
    local tw1 "${u24_tw}"
    graph drop u24t
    _u24_reg "`u24d'" 1 scatter mpg weight, xlabel(0(1000)5000) xmtick(##5) name(zu241)
    foreach m in s v {
        _w31_expect U24-1 `"("${u24_x`m'}" == "`tw1'")"' "`m': dash ${u24_x`m'}; twoway `tw1'"
    }
    // The default axis: extended below the first major to the data (1800).
    quietly twoway scatter mpg weight, xmtick(##5) name(u24t, replace)
    _u24_tw xaxis1 minornl
    local tw1b "${u24_tw}"
    graph drop u24t
    _u24_reg "`u24d'" 11 scatter mpg weight, xmtick(##5) name(zu2411)
    foreach m in s v {
        _w31_expect U24-1 `"("${u24_x`m'}" == "`tw1b'")"' "`m' default axis: dash ${u24_x`m'}; twoway `tw1b'"
    }
    _w31_done U24-1 "xmtick(##5) draws twoway's between positions on a rule and on the default axis, saved and served"

    // U24-2: majors that are an uneven list: twoway's one tick at 0 and
    // the scale widened to it.
    quietly twoway scatter mpg weight, xlabel(1000 2000 4000) xmtick(##5) name(u24t, replace)
    _u24_tw xaxis1 minornl
    local tw2 "${u24_tw}"
    local cm2 = `.u24t.plotregion1.xscale.curmin'
    graph drop u24t
    _u24_reg "`u24d'" 2 scatter mpg weight, xlabel(1000 2000 4000) xmtick(##5) name(zu242)
    foreach m in s v {
        _w31_expect U24-2 `"("${u24_x`m'}" == "`tw2'") & (${u24_lo`m'} <= `cm2')"' "`m': dash ${u24_x`m'} from ${u24_lo`m'}; twoway `tw2' from `cm2'"
    }
    _w31_done U24-2 "##5 over uneven majors draws twoway's one tick at 0 and widens the scale to it, saved and served"

    // U24-3: explicit positions.
    quietly twoway scatter mpg weight, xmtick(1500 2500) name(u24t, replace)
    _u24_tw xaxis1 minornl
    local tw3 "${u24_tw}"
    graph drop u24t
    _u24_reg "`u24d'" 3 scatter mpg weight, xmtick(1500 2500) name(zu243)
    foreach m in s v {
        _w31_expect U24-3 `"("${u24_x`m'}" == "`tw3'")"' "`m': dash ${u24_x`m'}; twoway `tw3'"
    }
    _w31_done U24-3 "xmtick(1500 2500) draws twoway's positions, saved and served"

    // U24-4: xmlabel(1500 "a" 2500): the positions, the quoted text and
    // the axis format's text (weight %8.0gc: 2,500).
    quietly twoway scatter mpg weight, xmlabel(1500 "a" 2500) name(u24t, replace)
    local fmt4 "`.u24t.xaxis1.minor.label_format'"
    local tw4 ""
    forvalues i = 1/0`.u24t.xaxis1.minor.ticks.arrnels' {
        local v = `.u24t.xaxis1.minor.ticks[`i'][1]'
        local t `"`.u24t.xaxis1.minor.ticks[`i'][2]'"'
        if `"`t'"' == "" local t = strtrim(string(`v', "`fmt4'"))
        local tw4 `"`tw4' `=strtrim(string(`v', "%18.10g"))'|`t'"'
    }
    local tw4 = strtrim(`"`tw4'"')
    graph drop u24t
    _u24_reg "`u24d'" 4 scatter mpg weight, xmlabel(1500 "a" 2500) name(zu244)
    foreach m in s v {
        _w31_expect U24-4 `"("${u24_l`m'}" == "`tw4'") & ("${u24_x`m'}" == "1500 2500")"' "`m': labels ${u24_l`m'} at ${u24_x`m'}; twoway `tw4'"
    }
    _w31_done U24-4 `"xmlabel(1500 "a" 2500) writes twoway's texts (`tw4') at its positions, saved and served"'

    // U24-6: ymtick(5000 10000, axis(2)) reaches the second axis only.
    quietly twoway scatter mpg weight || scatter price weight, yaxis(2) ymtick(5000 10000, axis(2)) name(u24t, replace)
    _u24_tw yaxis2 minornl
    local tw6 "${u24_tw}"
    graph drop u24t
    _u24_reg "`u24d'" 6 scatter mpg weight || scatter price weight, yaxis(2) ymtick(5000 10000, axis(2)) name(zu246)
    foreach m in s v {
        _w31_expect U24-6 `"("${u24_y2`m'}" == "`tw6'") & ("${u24_y`m'}" == "")"' "`m': y2 ${u24_y2`m'}, y '${u24_y`m'}'; twoway `tw6'"
    }
    _w31_done U24-6 "ymtick(, axis(2)) draws twoway's positions on the second axis and none on the first, saved and served"
    capture dash clear
    display as text "S24 end " c(current_date) " " c(current_time)
}
* ==== end S24 ====

// S25 C6b helpers.  _u25_tw <twoway plot>: plot 1's serset of the drawn
// twoway graph written to <dir>/t.csv (y, then x); _u25_cmp: the first
// visible Line a registered dash graph draws, saved and served, against
// that serset -- the vertex count and every vertex to 1e-6 relative (a
// serset stores floats) -- as globals u25_s and u25_v (1 when equal) and
// u25_msg.
capture program drop _u25_tw
program define _u25_tw
    // _u25_tw <dir> <twoway plot ...>
    version 19
    gettoken dir 0 : 0
    serset clear
    capture graph drop u25t
    quietly twoway (`0'), nodraw name(u25t, replace)
    local id "`.u25t.plotregion1.plot1.serset.id'"
    preserve
    quietly serset set `id'
    quietly serset use, clear
    quietly export delimited using "`dir'/t.csv", replace novarnames
    restore
    capture graph drop u25t
end

python:
def _u25_cmp(sp, dp, app, csv):
    import math
    from sfi import Macro
    import __main__ as m
    with open(csv, encoding="utf-8") as fh:
        want = [tuple(float(v) for v in ln.split(",")[:2][::-1])
                for ln in fh if ln.strip()]
    a, b = m._u03_docs(sp, dp, app)
    msg = []
    for figs, sfx in ((a, "s"), (b, "v")):
        got = None
        for f in figs:
            for r in f.renderers:
                g = getattr(r, "glyph", None)
                if (type(g).__name__ != "Line" or got is not None
                        or g.line_alpha == 0):
                    continue
                d = r.data_source.data
                got = list(zip((float(v) for v in d[g.x]),
                               (float(v) for v in d[g.y])))
        got = got or []
        ok = len(got) == len(want) and all(
            math.isclose(p, q, rel_tol=1e-6, abs_tol=1e-9)
            for gp, wp in zip(got, want) for p, q in zip(gp, wp))
        Macro.setGlobal("u25_" + sfx, str(int(ok)))
        msg.append("%s %d vertices" % ("saved" if sfx == "s" else "served",
                                        len(got)))
    Macro.setGlobal("u25_msg", ", ".join(msg) + "; twoway %d" % len(want))
end

capture program drop _u25_case
program define _u25_case
    // _u25_case <id> <dir> <k> <plot ...>: dash's line against twoway's.
    version 19
    gettoken id 0 : 0
    gettoken dir 0 : 0
    gettoken k 0 : 0
    _u25_tw "`dir'" `0'
    dash clear
    capture noisily dash (`0'), name(zu25`k')
    _w31_expect `id' "(_rc == 0)" "dash `0' rc `=_rc'"
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u25_m; _u25_m._u25_cmp("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py", "`dir'/t.csv")
    _w31_expect `id' "(${u25_s} == 1 & ${u25_v} == 1)" "`0': ${u25_msg}"
    foreach p in s d {
        capture erase "`dir'/`p'`k'.json"
    }
    capture erase "`dir'/a`k'.py"
    capture erase "`dir'/t.csv"
    dash clear
end

* ==== S25 C6b: mband and mspline over data with missing y or x ====
local only : env WP31_ONLY
if inlist("`only'", "", "S25") & `: list posof "S25" in w31_run' {
    display as text "S25 start " c(current_date) " " c(current_time)
    local u25d "`w31_work'/s25"
    capture mkdir "`u25d'"
    capture graph drop _all

    // ------------------------------------------------------------
    // U25-06: auto with mpg missing in 10/12 (area_cmissing_truth.json
    // E04, E05): the default band count is on the serset's N, the rows
    // with y or x (74, nine bands), where dash counted the 71 complete
    // rows (eight bands; mband 8 vertices for 9, mspline 78 for 89).
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly replace mpg = . in 10/12
    _u25_case U25-06 "`u25d'" 1 mband mpg weight
    _u25_case U25-06 "`u25d'" 2 mspline mpg weight
    _w31_done U25-06 "mpg missing in 10/12: mband and mspline draw twoway's vertices in both modes"

    // ------------------------------------------------------------
    // U25-07: weight missing on the 30 lightest cars, mpg present: those
    // rows stay in N (nine bands over the rest's x range).
    // ------------------------------------------------------------
    sysuse auto, clear
    sort weight, stable
    quietly replace weight = . in 1/30
    _u25_case U25-07 "`u25d'" 3 mband mpg weight
    _u25_case U25-07 "`u25d'" 4 mspline mpg weight
    _w31_done U25-07 "weight missing on 30 rows: mband and mspline draw twoway's vertices in both modes"

    // ------------------------------------------------------------
    // U25-08: mpg missing at the lightest car (its weight still sets the
    // bands' x range) and both missing on five rows (out of N), with
    // bands(3) n(2) and the default.
    // ------------------------------------------------------------
    sysuse auto, clear
    sort weight, stable
    quietly replace mpg = . in 1
    quietly replace mpg = . in 40/44
    quietly replace weight = . in 40/44
    _u25_case U25-08 "`u25d'" 5 mband mpg weight
    _u25_case U25-08 "`u25d'" 6 mspline mpg weight, bands(3) n(2)
    _w31_done U25-08 "mpg missing at the x minimum and both missing on five rows: mband and mspline draw twoway's vertices in both modes"

    capture rmdir "`u25d'"
    macro drop u25_s u25_v u25_msg
    capture graph drop _all
    dash clear
    display as text "S25 end " c(current_date) " " c(current_time)
}
* ==== end S25 ====

// S25 F1f helpers.  _u25_move: the saved page's mband or mspline line
// after one filter move, the callback run under node, against twoway's
// serset of the same rows in <csv> (_u25_tw) -- the vertex count and every
// vertex to <rtol> relative; globals u25_ok (1 when equal), u25_n (the
// saved vertex count), u25_cue (1
// when the layer is dimmed or the graph's stale caption shows) and
// u25_msg.
python:
def _u25_move(sp, dp, kind, value, csv, rtol):
    import math
    import os
    import sys
    import warnings
    if os.getcwd() not in sys.path:
        sys.path.insert(0, os.getcwd())
    import dash_render as dr
    import js_runner
    from sfi import Macro
    with open(csv, encoding="utf-8") as fh:
        want = [tuple(float(v) for v in ln.split(",")[:2][::-1])
                for ln in fh if ln.strip()]
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
    lay = [x for f in r.figures.values() for x in f.renderers
           if (getattr(x, "_dash_agg_config", None) or {}).get("type")
           in ("mband", "mspline")]
    w = [m for m in r.filter_widgets if type(m).__name__ == kind][0]
    if kind == "Select":
        w.value = [v for v, lab in w.options if lab == value][0]
    elif kind == "RangeSlider":
        w.value = tuple(float(v) for v in value.split())
    else:
        w.value = float(value)
    cb = r.filter_callbacks[r.filter_widgets.index(w)]
    js_runner.JsSession(r.filter_callbacks).run(cb)
    d = lay[0].data_source.data
    cx, cy = lay[0]._dash_agg_config["cols"]
    got = list(zip((float(v) for v in d[cx]), (float(v) for v in d[cy])))
    ok = len(got) == len(want) and all(
        math.isclose(p, q, rel_tol=float(rtol), abs_tol=1e-9)
        for gp, wp in zip(got, want) for p, q in zip(gp, wp))
    cue = [t for f in r.figures.values() for t in f.above
           if "dash_stale_cue" in (getattr(t, "tags", None) or [])]
    Macro.setGlobal("u25_ok", str(int(ok)))
    Macro.setGlobal("u25_n", str(len(got)))
    Macro.setGlobal("u25_cue", str(int(any(x.muted for x in lay) or (
        bool(cue) and bool(cue[0].visible)))))
    Macro.setGlobal("u25_msg", "saved %d vertices, twoway %d" % (
        len(got), len(want)))
end

capture program drop _u25_saved
program define _u25_saved
    // _u25_saved <id> <dir> <k> <rtol> <filter> | <kind> | <value> | <twoway plot> | <dash command>
    version 19
    gettoken id 0 : 0
    gettoken dir 0 : 0
    gettoken k 0 : 0
    gettoken rtol 0 : 0
    gettoken filt 0 : 0, parse("|")
    gettoken bar 0 : 0, parse("|")
    gettoken kind 0 : 0, parse("|")
    gettoken bar 0 : 0, parse("|")
    gettoken value 0 : 0, parse("|")
    gettoken bar 0 : 0, parse("|")
    gettoken tw 0 : 0, parse("|")
    gettoken bar 0 : 0, parse("|")
    local kind = strtrim("`kind'")
    local value = strtrim("`value'")
    _u25_tw "`dir'" `tw'
    dash clear
    capture noisily dash `0', name(zu25f`k')
    _w31_expect `id' "(_rc == 0)" "dash `0' rc `=_rc'"
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json") filter(`filt')
    python: import __main__ as _u25_m; _u25_m._u25_move("`dir'/s`k'.json", "`dir'/d`k'.json", "`kind'", "`value'", "`dir'/t.csv", "`rtol'")
    _w31_expect `id' "(${u25_ok} == 1)" "`0', `kind' to `value': ${u25_msg}"
    _w31_expect `id' "(${u25_cue} == 0)" "`0', `kind' to `value': the layer is marked (unfiltered)"
    foreach p in s d {
        capture erase "`dir'/`p'`k'.json"
    }
    capture erase "`dir'/t.csv"
    dash clear
end

* ==== S25 F1f: mband and mspline recompute on the saved page ====
local only : env WP31_ONLY
if inlist("`only'", "", "S25") & `: list posof "S25" in w31_run' {
    display as text "S25 start " c(current_date) " " c(current_time)
    local u25d "`w31_work'/s25f"
    capture mkdir "`u25d'"
    capture graph drop _all
    sysuse auto, clear

    // ------------------------------------------------------------
    // U25-01: mband after the dropdown to Foreign is twoway's mband on
    // the 22 Foreign cars (the default band count on the kept rows:
    // round(min(sqrt 22, 10 log10 22)) = 5 knots), not the build's.
    // ------------------------------------------------------------
    quietly count if foreign == 1
    local nf = r(N)
    local bf = max(min(`nf', 2), round(min(sqrt(`nf'), 10 * log10(`nf'))))
    _u25_saved U25-01 "`u25d'" 1 1e-6 foreign, type(dropdown) | Select | Foreign | mband mpg weight if foreign == 1 | (scatter mpg weight) (mband mpg weight)
    _w31_expect U25-01 "(${u25_n} == `bf')" "mband after the dropdown to Foreign: ${u25_n} knots, the rule on `nf' rows gives `bf'"
    _w31_done U25-01 "mband after the dropdown to Foreign: twoway's `bf' knots on the `nf' kept rows"
    sysuse auto, clear

    // ------------------------------------------------------------
    // U25-02: mspline bands(5) n(4) after the price range to 4500-11385:
    // (K-1)*4 + K points, as twoway's serset (floats: 1e-5).
    // ------------------------------------------------------------
    _u25_saved U25-02 "`u25d'" 2 1e-5 price, type(range) | RangeSlider | 4500 11385 | mspline mpg weight if inrange(price, 4500, 11385), bands(5) n(4) | (mspline mpg weight, bands(5) n(4))
    _w31_done U25-02 "mspline bands(5) n(4) after the range to 4500-11385: twoway's points"

    // ------------------------------------------------------------
    // U25-03: mband bands(20) after the dropdown to Domestic.
    // ------------------------------------------------------------
    _u25_saved U25-03 "`u25d'" 3 1e-6 foreign, type(dropdown) | Select | Domestic | mband mpg weight if foreign == 0, bands(20) | (mband mpg weight, bands(20))
    _w31_done U25-03 "mband bands(20) after the dropdown to Domestic: twoway's knots"

    // ------------------------------------------------------------
    // U25-04: mspline bands(2) on the Foreign cars is its two knots alone,
    // as twoway's serset.
    // ------------------------------------------------------------
    _u25_saved U25-04 "`u25d'" 4 1e-6 foreign, type(dropdown) | Select | Foreign | mspline mpg weight if foreign == 1, bands(2) | (mspline mpg weight, bands(2))
    _w31_done U25-04 "mspline bands(2) after the dropdown to Foreign: the two knots"

    // ------------------------------------------------------------
    // U25-05: a move leaving one row: mband is that one knot; twoway plots
    // one point, rc 0.
    // ------------------------------------------------------------
    quietly summarize price
    local pmax = r(max)
    _u25_saved U25-05 "`u25d'" 5 1e-6 price, type(slider) | Slider | `pmax' | mband mpg weight if price >= `pmax' | (mband mpg weight)
    _w31_done U25-05 "mband after the slider to `pmax' (one row): the one knot, as twoway's"

    capture rmdir "`u25d'"
    macro drop u25_ok u25_n u25_cue u25_msg
    capture graph drop _all
    dash clear
    display as text "S25 end " c(current_date) " " c(current_time)
}
* ==== end S25 ====

// S26 (WP-31 B4b) helpers: register one dash contour graph, write its
// spec and data, and read what both modes draw.  _u26_draw sets, per
// mode m (s saved, v served): u26_n<m> (contour renderers), u26_cut<m>
// (the cuts, %.10g), u26_rgb<m> (each band's fill, lowest first, or each
// line's colour for contourline), u26_tick<m> (the colour key's ticks),
// u26_side<m> (the key's side, "none" without one), u26_fx<m> (the fill
// polygons' x extent "lo hi"), u26_lv<m> (the number of line levels),
// u26_kind<m> (the saved layer's frozen kind), u26_cap<m> (capped 0/1)
// and u26_notes (approximate-surface notes printed, both builds).
python:
def _u26_docs(sp, dp, app):
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings(record=True) as w:
        warnings.simplefilter("always")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
        with open(app, encoding="utf-8") as fh:
            src = fh.read()
        attach = "if __name__ != '__main__':\n    make_document(curdoc())"
        ns = dict(__name__="dash_u26_app")
        exec(compile(src.replace(attach, "pass"), "dash_u26_app.py", "exec"),
             ns)
        doc = Document()
        ns["make_document"](doc)
    sv = [m for m in doc.models if type(m).__name__ == "figure"]
    notes = [str(x.message) for x in w]
    return list(r.figures.values()), sv, notes


def _u26_draw(sp, dp, app):
    from sfi import Macro
    a, b, notes = _u26_docs(sp, dp, app)
    Macro.setGlobal("u26_notes", str(sum("approximate surface" in n
                                         for n in notes)))
    for figs, sfx in ((a, "s"), (b, "v")):
        f = figs[0]
        crs = [r for r in f.renderers
               if type(r).__name__ == "ContourRenderer"]
        Macro.setGlobal("u26_n" + sfx, str(len(crs)))
        for g in ("cut", "rgb", "tick", "fx", "lv", "kind", "cap"):
            Macro.setGlobal("u26_%s%s" % (g, sfx), "")
        Macro.setGlobal("u26_side" + sfx, "none")
        if len(crs) != 1:
            continue
        cr = crs[0]
        cfg = getattr(cr, "_dash_contour_config", {}) or {}
        Macro.setGlobal("u26_cut" + sfx, " ".join(
            format(float(c), ".10g") for c in cfg.get("cuts", [])))
        fd = cr.fill_renderer.data_source.data
        ld = cr.line_renderer.data_source.data
        if cfg.get("type") == "contourline":
            cols = cr.line_renderer.glyph.line_color
            fld = cols if isinstance(cols, str) else getattr(cols, "field", None)
            cols = list(ld[fld]) if fld in ld else [cols]
        else:
            levels = [float(v) for v in cr.levels]
            by = {}
            for lo, c in zip(fd["lower_levels"], fd["fill_color"]):
                by[levels.index(float(lo))] = c
            cols = [by[k] for k in sorted(by)]
        Macro.setGlobal("u26_rgb" + sfx, " ".join(str(c).lower() for c in cols))
        xs = [v for p in fd["xs"] for poly in p for ring in poly for v in ring]
        if xs:
            Macro.setGlobal("u26_fx" + sfx, "%s %s" % (
                format(min(xs), ".10g"), format(max(xs), ".10g")))
        Macro.setGlobal("u26_lv" + sfx, str(len(ld.get("levels", []))))
        tag = getattr(cr, "_dash_frozen", None)
        Macro.setGlobal("u26_kind" + sfx, str((tag or {}).get("kind", "")))
        Macro.setGlobal("u26_cap" + sfx,
                        str(int(bool(getattr(cr, "_dash_contour_capped", 0)))))
        for side in ("right", "left", "above", "below"):
            for m in getattr(f, side):
                if type(m).__name__ == "ContourColorBar":
                    Macro.setGlobal("u26_side" + sfx, side)
                    Macro.setGlobal("u26_tick" + sfx, " ".join(
                        format(float(t), ".10g") for t in m.ticker.ticks))


def _u26_raster(case, interp):
    """U26-2: the band of each cell of a 200 x 200 raster in twoway's
    filled rows (contour_truth.json) and in dash's polygons agree."""
    import os
    import sys
    from sfi import Macro
    sys.path.insert(0, os.getcwd())
    import test_contour_layers as t
    import numpy as np
    import pandas as pd
    import warnings
    import tempfile
    import pathlib
    c = t._T["cases"][case]
    rows = c["rows"]
    df = pd.DataFrame({"z": rows["z"], "y": rows["y"], "x": rows["x"]})
    cuts = " ".join(repr(float(v)) for v in c[interp]["cuts"])
    out = []
    for mode in ("saved", "served"):
        with warnings.catch_warnings():
            warnings.simplefilter("ignore")
            figs, _n = t._figs(mode, pathlib.Path(tempfile.mkdtemp()),
                               [t._plot(z="z", y="y", x="x",
                                        opts={"ccuts": cuts,
                                              "interp": interp})], df=df)
        [cr] = t._contours(figs[0])
        g = t._T["grid"][case]
        xs = np.linspace(min(g["x"]), max(g["x"]), 201)
        ys = np.linspace(min(g["y"]), max(g["y"]), 201)
        X, Y = np.meshgrid((xs[:-1] + xs[1:]) / 2, (ys[:-1] + ys[1:]) / 2)
        out.append(float((t._twoway_raster(c[interp]["filled"], X, Y)
                          == t._dash_raster(cr, X, Y)).mean()))
    Macro.setGlobal("u26_agree", " ".join("%.4f" % v for v in out))
end

capture mata: mata drop _u26_near() _u26_hex() _u26_h2()
mata:
// 1 when two lists of #rrggbb colours have the same length and every
// channel within 1/255.
real scalar _u26_near(string scalar a, string scalar b)
{
    string rowvector A, B
    real scalar i, j
    A = tokens(a)
    B = tokens(b)
    if (cols(A) != cols(B) | cols(A) == 0) return(0)
    for (i = 1; i <= cols(A); i++) {
        if (strlen(A[i]) != 7 | strlen(B[i]) != 7) return(0)
        for (j = 2; j <= 6; j = j + 2) {
            if (abs(_u26_hex(substr(A[i], j, 2)) - _u26_hex(substr(B[i], j, 2))) > 1) return(0)
        }
    }
    return(1)
}
string scalar _u26_h2(real scalar v)
{
    return(strlower(substr("0" + inbase(16, v), -2, 2)))
}
real scalar _u26_hex(string scalar h)
{
    string scalar d
    d = "0123456789abcdef"
    h = strlower(h)
    return(16 * (strpos(d, substr(h, 1, 1)) - 1) + strpos(d, substr(h, 2, 1)) - 1)
}
end

capture program drop _u26_reg
program define _u26_reg
    // _u26_reg <dir> <k> <dash command...>
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    dash clear
    capture quietly dash `0'
    global u26_rc = _rc
    if _rc {
        foreach m in s v {
            global u26_n`m' "rc `=_rc'"
        }
        exit
    }
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u26_m; _u26_m._u26_draw("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py")
end

capture program drop _u26_tw
program define _u26_tw
    // _u26_tw <twoway command>: twoway's cuts, band (or line) colours and
    // z-axis ticks, read from the drawn graph u26t, into u26_twcut,
    // u26_twrgb ("#rrggbb" each) and u26_twtick ("%.10g" each).
    version 19
    capture graph drop u26t
    twoway `0' name(u26t)
    local v ".u26t.`.u26t.contour_view'`.u26t.contourline_view'"
    local out ""
    foreach c in `.`v'.style.ccutsopt' {
        local out "`out' `=strtrim(string(`c', "%18.10g"))'"
    }
    global u26_twcut = strtrim("`out'")
    local L = 0`.`v'.style.levels.val'
    local n = cond("`.`v'.type.setting'" == "contourline", `L' - 1, `L')
    local out ""
    forvalues i = 1/`n' {
        tokenize `.`v'.style.cstyles[`i'].color.rgb'
        mata: st_local("out", st_local("out") + " #" + _u26_h2(`1') + _u26_h2(`2') + _u26_h2(`3'))
    }
    global u26_twrgb = strtrim("`out'")
    local za `.`v'.zaxis'
    local out ""
    foreach t in `.`za'.major.tick_values' {
        local out "`out' `=strtrim(string(`t', "%18.10g"))'"
    }
    global u26_twtick = strtrim("`out'")
    graph drop u26t
end

* ==== S26 B4b: contour and contourline ====
local only : env WP31_ONLY
if inlist("`only'", "", "S26") & `: list posof "S26" in w31_run' {
    display as text "S26 start " c(current_date) " " c(current_time)
    local u26dir "`w31_work'/u26"
    capture mkdir "`u26dir'"
    sysuse auto, clear

    // ------------------------------------------------------------
    // U26-1: dash contour mpg weight length registers z y x and both
    // modes draw one contour renderer with twoway's cuts and colours.
    // ------------------------------------------------------------
    _u26_tw contour mpg weight length,
    _u26_reg `u26dir' 1 contour mpg weight length, name(u261)
    foreach m in s v {
        _w31_expect U26-1 `"("${u26_n`m'}" == "1")"' "`m': ${u26_n`m'} contour renderers"
        _w31_expect U26-1 `"("${u26_cut`m'}" == "${u26_twcut}")"' "`m': cuts ${u26_cut`m'}; twoway's ${u26_twcut}"
        _w31_expect U26-1 `"("${u26_rgb`m'}" == "${u26_twrgb}")"' "`m': bands ${u26_rgb`m'}; twoway's ${u26_twrgb}"
    }
    _w31_done U26-1 "contour draws twoway's cuts ${u26_twcut} and bands ${u26_twrgb} in both modes"

    // ------------------------------------------------------------
    // U26-2: the level sets equal twoway's filled polygons
    // (contour_truth.json cases.*): a 200 x 200 raster agrees on 98% of
    // its cells (97% for auto's ill-conditioned thin-plate spline).
    // ------------------------------------------------------------
    foreach c in auto synthetic {
        foreach i in thinplatespline shepard {
            python: import __main__ as _u26_m; _u26_m._u26_raster("`c'", "`i'")
            local fl = cond("`c'`i'" == "autothinplatespline", .97, .98)
            foreach a of global u26_agree {
                _w31_expect U26-2 `"(`a' >= `fl')"' "`c' `i': `a' of the cells agree (at least `fl')"
            }
        }
    }
    _w31_done U26-2 "the bands' level sets equal twoway's filled polygons"

    // ------------------------------------------------------------
    // U26-3: ccuts(), levels(), levels() minmax: twoway's cuts.
    // ------------------------------------------------------------
    local k 3
    foreach o in "ccuts(30 15 25 20)" "levels(5)" "levels(5) minmax" "levels(1)" {
        _u26_tw contour mpg weight length, `o'
        _u26_reg `u26dir' `k' contour mpg weight length, `o' name(u263)
        foreach m in s v {
            _w31_expect U26-3 `"("${u26_cut`m'}" == "${u26_twcut}")"' "`o' `m': cuts ${u26_cut`m'}; twoway's ${u26_twcut}"
        }
        local ++k
    }
    _w31_done U26-3 "ccuts(), levels() and minmax cut where twoway cuts"

    // ------------------------------------------------------------
    // U26-4: the colour rules between scolor() and ecolor(), and
    // ccolors(): each band's colour twoway's (within 1/255 a channel).
    // ------------------------------------------------------------
    foreach o in "crule(linear) scolor(navy) ecolor(gold)" "crule(revlinear) scolor(navy) ecolor(gold)" "crule(intensity) scolor(navy) ecolor(gold)" "crule(hue) scolor(navy) ecolor(gold)" "crule(chue) scolor(navy) ecolor(gold)" "crule(phue)" "ccolors(red blue green)" "scheme(s1mono)" {
        _u26_tw contour mpg weight length, `o'
        _u26_reg `u26dir' `k' contour mpg weight length, `o' name(u264)
        foreach m in s v {
            mata: st_local("u26ok", strofreal(_u26_near(st_global("u26_rgb`m'"), st_global("u26_twrgb"))))
            _w31_expect U26-4 `"(`u26ok' == 1)"' "`o' `m': ${u26_rgb`m'}; twoway's ${u26_twrgb}"
        }
        local ++k
    }
    _w31_done U26-4 "every crule(), ccolors() and the scheme's own rule colour the bands as twoway does"

    // ------------------------------------------------------------
    // U26-5: the colour key: right of the plot, ticked at twoway's z-axis
    // ticks; none under clegend(off); on the left at position(9).
    // ------------------------------------------------------------
    _u26_tw contour mpg weight length,
    _u26_reg `u26dir' `k' contour mpg weight length, name(u265)
    foreach m in s v {
        _w31_expect U26-5 `"("${u26_side`m'}" == "right" & "${u26_tick`m'}" == "${u26_twtick}")"' "`m': key ${u26_side`m'} ticked ${u26_tick`m'}; twoway's ${u26_twtick}"
    }
    local ++k
    _u26_reg `u26dir' `k' contour mpg weight length, clegend(off) name(u265)
    foreach m in s v {
        _w31_expect U26-5 `"("${u26_side`m'}" == "none")"' "`m': clegend(off) key ${u26_side`m'}"
    }
    local ++k
    _u26_reg `u26dir' `k' contour mpg weight length, clegend(position(9)) name(u265)
    foreach m in s v {
        _w31_expect U26-5 `"("${u26_side`m'}" == "left")"' "`m': clegend(position(9)) key ${u26_side`m'}"
    }
    local ++k
    _w31_done U26-5 "the key is twoway's: right, ticked ${u26_twtick}; off and position(9) honoured"

    // ------------------------------------------------------------
    // U26-6: contourline: lines at the cuts and no fill; black unless
    // colorlines colours them in twoway's level colours.
    // ------------------------------------------------------------
    _u26_tw contourline mpg weight length,
    _u26_reg `u26dir' `k' contourline mpg weight length, name(u266)
    foreach m in s v {
        _w31_expect U26-6 `"("${u26_lv`m'}" == "`: word count ${u26_twcut}'" & "${u26_fx`m'}" == "" & "${u26_rgb`m'}" == "#000000 #000000")"' "`m': ${u26_lv`m'} line levels, colours ${u26_rgb`m'}, fill ${u26_fx`m'}"
    }
    local ++k
    _u26_tw contourline mpg weight length, colorlines
    _u26_reg `u26dir' `k' contourline mpg weight length, colorlines name(u266)
    foreach m in s v {
        _w31_expect U26-6 `"("${u26_rgb`m'}" == "${u26_twrgb}")"' "`m': colorlines ${u26_rgb`m'}; twoway's ${u26_twrgb}"
    }
    local ++k
    _w31_done U26-6 "contourline draws its lines at the cuts, black or in twoway's level colours"

    // ------------------------------------------------------------
    // U26-7: horizontal: the surface is turned, weight across.
    // ------------------------------------------------------------
    quietly summarize weight
    local wlo = r(min)
    local whi = r(max)
    _u26_reg `u26dir' `k' contour mpg weight length, horizontal name(u267)
    foreach m in s v {
        _w31_expect U26-7 `"("${u26_fx`m'}" == "`wlo' `whi'")"' "`m': fill x ${u26_fx`m'}; weight's range `wlo' `whi'"
    }
    local ++k
    _w31_done U26-7 "horizontal turns the surface: weight across"

    // ------------------------------------------------------------
    // U26-8: within the cap the saved page refits the layer (section
    // 29), so it is not frozen; the served app refits it too (its
    // redraw pairs the fill and line sources, test_contour_layers.py
    // TestMoves).  Flipped (WP-31 B4c): the saved layer was frozen with
    // the grid cue until the page's twin landed.
    // ------------------------------------------------------------
    _u26_reg `u26dir' `k' contour mpg weight length, name(u268)
    _w31_expect U26-8 `"("${u26_kinds}" == "")"' "saved: frozen kind ${u26_kinds}"
    local ++k
    _w31_done U26-8 "the saved page refits the contour: not frozen"

    // ------------------------------------------------------------
    // U26-10: above 1,000 distinct points: approximate, noted once a
    // build, flagged in both modes.
    // ------------------------------------------------------------
    clear
    quietly set obs 1001
    set seed 26
    quietly generate double x = runiform()
    quietly generate double y = runiform()
    quietly generate double z = rnormal()
    _u26_reg `u26dir' `k' contour z y x, name(u2610)
    _w31_expect U26-10 `"("${u26_caps}" == "1" & "${u26_capv}" == "1")"' "capped: saved ${u26_caps}, served ${u26_capv}"
    _w31_expect U26-10 `"("${u26_notes}" == "2")"' "approximate-surface notes: ${u26_notes} (one a build)"
    _w31_done U26-10 "a contour over 1,001 distinct points is approximate, noted once and flagged"

    dash clear
    clear
    macro drop u26_*
    capture graph drop _all
    display as text "S26 end " c(current_date) " " c(current_time)
}
* ==== end S26 ====

// S26 (WP-31 C8e) helpers: _u26_svgsame compares twoway's two exported
// SVGs with their generated ids taken out; _u26_bar reads dash's colour bar
// (palette ends, range, ticks) in both modes of a registered graph and the
// notes naming colorkeysreverse.
python:
def _u26_svgsame(a, b):
    import re
    from sfi import Macro
    def norm(p):
        with open(p, encoding="utf-8", errors="replace") as fh:
            t = fh.read()
        return re.sub(r'(id|href|clip-path)="[^"]*"', "", t)
    Macro.setGlobal("u26_same", "1" if norm(a) == norm(b) else "0")


def _u26_bar(sp, dp, app, sfx):
    import __main__ as m
    from sfi import Macro
    from bokeh.models import ColorBar
    a, b, notes = m._u26_docs(sp, dp, app)
    for figs, mode in ((a, "s"), (b, "v")):
        f = figs[0]
        bars = [k for side in (f.right, f.left, f.above, f.below)
                for k in side if isinstance(k, ColorBar)]
        view = ""
        if len(bars) == 1:
            cm = bars[0].color_mapper
            view = "%s %s %s %s %s" % (cm.palette[0], cm.palette[-1],
                                       format(float(cm.low), ".10g"),
                                       format(float(cm.high), ".10g"),
                                       " ".join(format(float(t), ".10g")
                                                for t in bars[0].ticker.ticks))
        Macro.setGlobal("u26_bar%s%s" % (sfx, mode), view)
    Macro.setGlobal("u26_rn" + sfx, str(sum("colorkeysreverse" in n
                                            for n in notes)))
end

* ==== S26 C8e: colorkeysreverse on a colour bar ====
local only : env WP31_ONLY
if inlist("`only'", "", "S26") & `: list posof "S26" in w31_run' {
    display as text "S26 start " c(current_date) " " c(current_time)
    local u26dir "`w31_work'/u26e"
    capture mkdir "`u26dir'"
    sysuse auto, clear

    // ------------------------------------------------------------
    // U26-11: twoway draws the unbinned colour key the same with
    // colorkeysreverse as without it, measured live; dash draws the same
    // bar for both, in both modes, and names nothing.
    // ------------------------------------------------------------
    capture graph drop u2611
    twoway scatter mpg weight, colorvar(price) name(u2611, replace)
    quietly graph export "`u26dir'/plain.svg", replace
    twoway scatter mpg weight, colorvar(price) colorkeysreverse name(u2611, replace)
    quietly graph export "`u26dir'/rev.svg", replace
    graph drop u2611
    python: import __main__ as _u26_m; _u26_m._u26_svgsame("`u26dir'/plain.svg", "`u26dir'/rev.svg")
    _w31_expect U26-11 `"("${u26_same}" == "1")"' "twoway's key with and without colorkeysreverse the same: ${u26_same}"
    foreach v in p r {
        local o = cond("`v'" == "r", "colorkeysreverse", "")
        dash clear
        quietly dash scatter mpg weight, colorvar(price) `o' name(u2611)
        _dash_serve_spec, specpath("`u26dir'/s`v'.json") datapath("`u26dir'/d`v'.json")
        python: import __main__ as _u26_m; _u26_m._u26_bar("`u26dir'/s`v'.json", "`u26dir'/d`v'.json", "`u26dir'/a`v'.py", "`v'")
    }
    foreach m in s v {
        _w31_expect U26-11 `"("${u26_barr`m'}" == "${u26_barp`m'}" & "${u26_barp`m'}" != "")"' "`m': bar ${u26_barr`m'}; without ${u26_barp`m'}"
    }
    _w31_expect U26-11 `"("${u26_rnr}" == "0")"' "notes naming colorkeysreverse: ${u26_rnr}"
    _w31_done U26-11 "colorkeysreverse leaves the colour bar as twoway leaves its key, in silence"

    dash clear
    clear
    macro drop u26_*
    capture graph drop _all
    display as text "S26 end " c(current_date) " " c(current_time)
}
* ==== end S26 ====

// S27 (WP-31 D2) helpers: draw one command in twoway (SVG export) and in
// dash (both modes), and describe the edge titles each draws for one case
// into globals u27_tw (twoway), u27_s (saved) and u27_v (served).
python:
def _u27_svg(path):
    import re
    with open(path, encoding="utf-8") as fh:
        src = fh.read()
    out = []
    for attrs, body in re.findall(r"<text\b([^>]*)>([^<]*)</text>", src):
        body = body.replace(" ", " ").strip()
        if not body or re.fullmatch(r"[-0-9.,]+", body):
            continue
        a = dict(re.findall(r'([a-z-]+)="([^"]*)"', attrs))
        fs = re.search(r"font-size:([0-9.]+)px", a.get("style", ""))
        rot = re.search(r"rotate\((-?[0-9.]+)", a.get("transform", ""))
        out.append((body, float(a["x"]), float(a["y"]),
                    float(fs.group(1)) if fs else 0.0,
                    int(float(rot.group(1))) if rot else 0))
    return out


_U27_LABS = ("T1", "T2", "B1", "B2", "L1", "L2", "R1", "R2")


def _u27_rel(sz):
    def rel(a, b):
        if a is None or b is None:
            return "?"
        return "=" if abs(a - b) <= 0.01 * max(a, b) else (">" if a > b else "<")
    return " ".join("%s%s%s" % (p, rel(sz.get(p), sz.get(q)), q)
                    for p, q in (("T1", "T2"), ("B1", "B2"), ("L1", "L2"),
                                 ("R1", "R2"), ("T1", "B2")))


def _u27_tw(path, case):
    t = _u27_svg(path)
    pos = {b: (x, y, s, r) for b, x, y, s, r in t}
    if case == "by":
        return " ".join("%s:%d" % (k, sum(1 for b, *_ in t if b == k))
                        for k in ("T1", "B1", "L1", "R1"))
    if case == "vert":
        return " ".join("%s:%d" % (k, pos[k][3]) for k in _U27_LABS)
    if case == "sizes":
        return _u27_rel({k: pos[k][2] for k in _U27_LABS})
    cx, cy = pos["T1"][0], pos["L1"][1]
    if case == "sides":
        side = {}
        for k in _U27_LABS:
            x, y = pos[k][0], pos[k][1]
            side[k] = (("above" if y < cy else "below") if abs(x - cx) < 1
                       else ("left" if x < cx else "right"))
        out = []
        for k in _U27_LABS:
            mates = [j for j in _U27_LABS if side[j] == side[k]]
            d = {j: abs(pos[j][0] - cx) + abs(pos[j][1] - cy) for j in mates}
            out.append("%s:%s:%d" % (k, side[k],
                                     sorted(mates, key=d.get).index(k) + 1))
        return " ".join(out)
    # order: above nearest the plot first (largest y), below smallest y first
    legend = {"Mileage (mpg)", "Trunk space (cu. ft.)"}
    skip = {"T", "Weight (lbs.)"} | set(k for k in _U27_LABS if k[0] in "LR")
    top = pos["L1"][1]
    above = sorted([e for e in t if e[2] < top and e[0] not in skip],
                   key=lambda e: -e[2])
    below = sorted([e for e in t if e[2] > top and e[0] not in skip],
                   key=lambda e: e[2])

    def names(es):
        out = []
        for e in es:
            n = "legend" if e[0] in legend else e[0]
            if not out or out[-1] != n:
                out.append(n)
        return " ".join(out)
    return "above: %s | below: %s" % (names(above), names(below))


def _u27_dash(figs, case):
    from bokeh.models import Axis, Legend, Title
    edges = []
    for f in figs:
        for side in ("above", "below", "left", "right"):
            k = 0
            for m in getattr(f, side):
                tags = list(getattr(m, "tags", None) or [])
                if isinstance(m, Title) and "dash_edge_title" in tags:
                    k += 1
                    edges.append((m.text, side, k,
                                  float(str(m.text_font_size).rstrip("ptx"))))
    if case == "by":
        return " ".join("%s:%d" % (k, sum(1 for e in edges if e[0] == k))
                        for k in ("T1", "B1", "L1", "R1"))
    e = {x[0]: x for x in edges}
    if case == "vert":
        return " ".join("%s:%d" % (k, -90 if e[k][1] in ("left", "right")
                                   else 0) for k in _U27_LABS if k in e)
    if case == "sizes":
        return _u27_rel({k: e[k][3] for k in e})
    if case == "sides":
        return " ".join("%s:%s:%d" % (k, e[k][1], e[k][2])
                        for k in _U27_LABS if k in e)
    f = figs[0]

    def names(side):
        out = []
        for m in getattr(f, side):
            if isinstance(m, Axis) or "dash_stale_cue" in list(
                    getattr(m, "tags", None) or []):
                continue
            n = ("legend" if isinstance(m, Legend) else
                 (m.text if isinstance(m, Title) else type(m).__name__))
            out.append(n)
        return " ".join(out)
    return "above: %s | below: %s" % (names("above"), names("below"))


def _u27_check(sp, dp, app, svg, case):
    import __main__ as m
    from sfi import Macro
    a, b = m._u03_docs(sp, dp, app)
    Macro.setGlobal("u27_tw", _u27_tw(svg, case))
    for figs, sfx in ((a, "s"), (b, "v")):
        Macro.setGlobal("u27_" + sfx, _u27_dash(figs, case))
end

capture program drop _u27_reg
program define _u27_reg
    // _u27_reg <dir> <k> <case> <command with options...>
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    gettoken case 0 : 0
    quietly twoway `0' name(u27t, replace)
    quietly graph export "`dir'/t`k'.svg", replace
    graph drop u27t
    dash clear
    capture quietly dash `0' name(zu27`k')
    if _rc {
        global u27_s "rc `=_rc'"
        global u27_v "rc `=_rc'"
        global u27_tw "(twoway drawn)"
        exit
    }
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u27_m; _u27_m._u27_check("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py", "`dir'/t`k'.svg", "`case'")
end

* ==== S27 D2: Edge titles ====
local only : env WP31_ONLY
if inlist("`only'", "", "S27") & `: list posof "S27" in w31_run' {
    display as text "S27 start " c(current_date) " " c(current_time)
    local u27d "`w31_work'/s27"
    capture mkdir "`u27d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear
    local u27all `"(scatter mpg weight) (scatter trunk weight), t1title("T1") t2title("T2") b1title("B1") b2title("B2") l1title("L1") l2title("L2") r1title("R1") r2title("R2")"'

    // U27-1: each of the eight on twoway's side, ring 1 nearest the plot.
    _u27_reg "`u27d'" 1 sides `u27all'
    foreach m in s v {
        _w31_expect U27-1 `"("${u27_`m'}" == "${u27_tw}")"' "`m': dash ${u27_`m'}; twoway ${u27_tw}"
    }
    _w31_done U27-1 "the eight edge titles on twoway's sides and rings, saved and served: ${u27_tw}"

    // U27-2: the rings outward from the plot, above and below: the edge
    // titles inside the legend, the note, the caption and the subtitle.
    _u27_reg "`u27d'" 2 order `u27all' note("N") caption("C") subtitle("S") title("T")
    foreach m in s v {
        _w31_expect U27-2 `"("${u27_`m'}" == "${u27_tw}")"' "`m': dash ${u27_`m'}; twoway ${u27_tw}"
    }
    _w31_done U27-2 "ring order ${u27_tw}, saved and served"

    // U27-3: l and r titles turned on their side, t and b level.
    _u27_reg "`u27d'" 3 vert `u27all'
    foreach m in s v {
        _w31_expect U27-3 `"("${u27_`m'}" == "${u27_tw}")"' "`m': dash ${u27_`m'}; twoway ${u27_tw}"
    }
    _w31_done U27-3 "l and r vertical, t and b level: ${u27_tw}"

    // U27-4: the 1 titles larger than the 2 titles, except b2title, which
    // twoway draws in b1title's box.
    _u27_reg "`u27d'" 4 sizes `u27all'
    foreach m in s v {
        _w31_expect U27-4 `"("${u27_`m'}" == "${u27_tw}")"' "`m': dash ${u27_`m'}; twoway ${u27_tw}"
    }
    _w31_done U27-4 "text sizes as twoway's: ${u27_tw}"

    // U27-5: by(): the edge titles on every panel.
    _u27_reg "`u27d'" 5 by scatter mpg weight, by(foreign) t1title("T1") b1title("B1") l1title("L1") r1title("R1")
    foreach m in s v {
        _w31_expect U27-5 `"("${u27_`m'}" == "${u27_tw}")"' "`m': dash ${u27_`m'}; twoway ${u27_tw}"
    }
    _w31_done U27-5 "by(): ${u27_tw}, saved and served"

    macro drop u27_tw u27_s u27_v
    capture graph drop _all
    dash clear
    display as text "S27 end " c(current_date) " " c(current_time)
}
* ==== end S27 ====

// S28 helpers (WP-31 F1g).  _u28_move: the saved page's fpfit or fpfitci
// after one filter move -- the page rendered, the widget set and its own
// callback run under node (test/js_runner.py) -- the line's columns (x_fp,
// y_fp and, for fpfitci, y_lower and y_upper; a missing value as null)
// written to a JSON file; globals u28_n (the point count), u28_band (the
// finite lower limits) and u28_cue (1 when a layer is dimmed or a stale
// caption shows).  _u28_close: each saved column against a column of
// twoway's serset (_u10_ss's JSON), a missing value equal to a missing
// value; globals u28_ok 1 or 0 and u28_msg.
python:
def _u28_move(sp, dp, kind, value, out):
    import json
    import math
    import os
    import sys
    import warnings
    if os.getcwd() not in sys.path:
        sys.path.insert(0, os.getcwd())
    import dash_render as dr
    import js_runner
    from sfi import Macro
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
    w = [m for m in r.filter_widgets if type(m).__name__ == kind][0]
    if kind == "Select":
        w.value = [v for v, lab in w.options if lab == value][0]
    elif kind == "RangeSlider":
        w.value = tuple(float(v) for v in value.split())
    else:
        w.value = float(value)
    cb = r.filter_callbacks[r.filter_widgets.index(w)]
    js_runner.JsSession(r.filter_callbacks).run(cb)
    fits = [x for f in r.figures.values() for x in f.renderers
            if (getattr(x, "_dash_agg_config", None) or {}).get("type")
            in ("fpfit", "fpfitci")
            and not x._dash_agg_config.get("split")]
    d = fits[0].data_source.data

    def col(c):
        o = []
        for v in d[c]:
            v = float("nan") if v is None else float(v)
            o.append(v if math.isfinite(v) else None)
        return o

    cols = {c: col(c) for c in fits[0]._dash_agg_config["cols"]}
    with open(out, "w", encoding="utf-8") as fh:
        json.dump(cols, fh)
    lay = [x for f in r.figures.values() for x in f.renderers]
    cue = [t for f in r.figures.values() for t in f.above
           if "dash_stale_cue" in (getattr(t, "tags", None) or [])]
    Macro.setGlobal("u28_n", str(len(cols["x_fp"])))
    Macro.setGlobal("u28_band", str(sum(v is not None
                                        for v in cols.get("y_lower", []))))
    Macro.setGlobal("u28_cue", str(int(any(x.muted for x in lay) or any(
        bool(t.visible) for t in cue))))


def _u28_close(tw, saved, rtol):
    import json
    import numpy as np
    from sfi import Macro
    t = json.load(open(tw, encoding="utf-8"))
    g = json.load(open(saved, encoding="utf-8"))
    arr = lambda c: np.asarray([np.nan if v is None else v for v in c],
                               float)
    tcols = {k: arr(c) for k, c in t.items()}
    ok, said = 1, []
    for c in g:
        gv = arr(g[c])
        hit = [k for k, tv in tcols.items() if len(tv) == len(gv)
               and len(gv) and np.allclose(gv, tv, rtol=rtol, atol=1e-9,
                                           equal_nan=True)]
        if hit:
            said.append("%s=%s" % (c, hit[0]))
        else:
            ok = 0
            said.append("%s matches no serset column (%s; %d saved rows, "
                        "twoway %s)" % (c, " ".join(tcols), len(gv),
                                        sorted({len(v) for v in
                                                tcols.values()})))
    Macro.setGlobal("u28_ok", str(ok))
    Macro.setGlobal("u28_msg", ", ".join(said))
end

* ==== S28 F1g: fpfit and fpfitci refit on the saved page ====
local only : env WP31_ONLY
if inlist("`only'", "", "S28") & `: list posof "S28" in w31_run' {
    display as text "S28 start " c(current_date) " " c(current_time)
    local u28d "`w31_work'/s28"
    capture mkdir "`u28d'"
    capture graph drop _all

    // ------------------------------------------------------------
    // U28-01..05: after a move the saved fpfit or fpfitci is twoway's on
    // the kept rows (the serset: the sample's distinct x, the fit and the
    // stdp limits): fpfit after the dropdown to Foreign; fpfitci,
    // level(90) after the price range to 4500-11385; fpfit
    // [aw=displacement] after the dropdown to Domestic; on nlsw88, fpfit
    // [aw=hours] after the dropdown to union, whose plot grid drops an x
    // whose lowest-wage row has no hours (the point count is twoway's);
    // and fpfitci after the slider to the third-highest price, which
    // keeps three rows: the line through them and no band (df 0).
    // ------------------------------------------------------------
    sysuse auto, clear
    gsort -price
    local p3 = price[3]
    sysuse nlsw88, clear
    local ulab : label (union) 1
    local k 0
    foreach c in "U28-01|auto|(scatter mpg weight) (fpfit mpg weight)|foreign, type(dropdown)|Select|Foreign|fpfit mpg weight if foreign == 1" "U28-02|auto|(fpfitci mpg weight, level(90))|price, type(range)|RangeSlider|4500 11385|fpfitci mpg weight if inrange(price, 4500, 11385), level(90)" "U28-03|auto|fpfit mpg weight [aw=displacement]|foreign, type(dropdown)|Select|Domestic|fpfit mpg weight [aw=displacement] if foreign == 0" "U28-04|nlsw88|fpfit wage ttl_exp [aw=hours]|union, type(dropdown)|Select|`ulab'|fpfit wage ttl_exp [aw=hours] if union == 1" "U28-05|auto|(scatter mpg weight) (fpfitci mpg weight)|price, type(slider)|Slider|`p3'|fpfitci mpg weight if price >= `p3'" {
        local ++k
        mata: u28_t = ustrsplit(st_local("c"), "[|]"); st_local("id", u28_t[1]); st_local("ds", u28_t[2]); st_local("cmd", u28_t[3]); st_local("filt", u28_t[4]); st_local("kind", u28_t[5]); st_local("val", u28_t[6]); st_local("tw", u28_t[7])
        sysuse `ds', clear
        dash clear
        capture noisily dash `cmd', name(zu28`k')
        _w31_expect `id' "(_rc == 0)" "dash `cmd' rc `=_rc'"
        _dash_serve_spec, specpath("`u28d'/s`k'.json") datapath("`u28d'/d`k'.json") filter(`filt')
        python: _u28_move("`u28d'/s`k'.json", "`u28d'/d`k'.json", "`kind'", "`val'", "`u28d'/g`k'.json")
        _u10_ss "`u28d'/t`k'.json" "`u28d'/t`k'.gph" `tw'
        // A serset stores floats: twoway's values are read to 1e-6.
        python: _u28_close("`u28d'/t`k'.json", "`u28d'/g`k'.json", 1e-6)
        _w31_expect `id' "(${u28_ok} == 1)" "dash `cmd', filter(`filt') moved to `val': ${u28_msg}"
        _w31_expect `id' "(${u28_cue} == 0)" "dash `cmd' moved to `val': the layer is marked (unfiltered)"
        if "`id'" == "U28-05" {
            quietly count if price >= `p3'
            _w31_expect `id' "(r(N) == 3)" "price >= `p3' keeps `r(N)' rows"
            _w31_expect `id' "(${u28_n} == 3 & ${u28_band} == 0)" "three kept rows: ${u28_n} line points, ${u28_band} finite limits"
        }
        _w31_done `id' "the saved `cmd' after the move to `val' is twoway `tw' (${u28_n} points, ${u28_band} finite limits; ${u28_msg})"
    }

    forvalues k = 1/5 {
        foreach p in s d g t {
            capture erase "`u28d'/`p'`k'.json"
        }
    }
    capture rmdir "`u28d'"
    macro drop u28_n u28_band u28_cue u28_ok u28_msg
    capture mata: mata drop u28_t
    dash clear
    display as text "S28 end " c(current_date) " " c(current_time)
}
* ==== end S28 ====

// S29 helpers (WP-31 B4c).  _u29_move: the saved page of spec sp/dp
// after one filter move (its own callback run under node,
// test/js_runner.py) beside the page of the qualified spec sq/dq, which
// the Python side draws (contourpy's cut): globals u29_agree (the share of
// a 300 x 300 raster over the kept rows' plane in the same band, or 1 and
// 0 for lines whose counts per level agree or not), u29_area (the largest
// relative band-area difference), u29_cue (1 when a layer is dimmed or a
// stale caption or status shows), u29_same (1 when the source is
// unchanged by the move) and u29_xr (the fill polygons' x range).
python:
def _u29_move(sp, dp, kind, value, sq, dq):
    import os
    import sys
    import warnings
    import numpy as np
    if os.getcwd() not in sys.path:
        sys.path.insert(0, os.getcwd())
    import dash_render as dr
    import js_runner
    import test_contour_js as tc
    from sfi import Macro

    def page(s, d):
        with warnings.catch_warnings():
            warnings.simplefilter("ignore")
            r = dr.DashRenderer(s, d)
            r.render()
        [cr] = [x for f in r.figures.values() for x in f.renderers
                if type(x).__name__ == "ContourRenderer"]
        return r, cr

    r, cr = page(sp, dp)
    lsrc = cr.line_renderer.data_source
    part = "line" if len(lsrc.data.get("xs", [])) else "fill"
    src = lsrc if part == "line" else cr.fill_renderer.data_source
    before = repr(dict(src.data))
    w = [m for m in r.filter_widgets if type(m).__name__ == kind][0]
    if kind == "Select":
        w.value = [v for v, lab in w.options if lab == value][0]
    else:
        w.value = float(value)
    cb = r.filter_callbacks[r.filter_widgets.index(w)]
    js_runner.JsSession(r.filter_callbacks).run(cb)
    a = dict(src.data)
    _q, qr = page(sq, dq)
    qrend = qr.line_renderer if part == "line" else qr.fill_renderer
    b = dict(qrend.data_source.data)
    agree, area, xr = 1.0, 0.0, ""
    if part == "fill":
        xs = [v for band in b["xs"] for poly in band for ring in poly
              for v in ring]
        ys = [v for band in b["ys"] for poly in band for ring in poly
              for v in ring]
        if len(a["xs"]) != len(b["xs"]):
            agree, area = 0.0, 1.0
        elif xs:
            X, Y = tc._grid(xs, ys)
            agree = float((tc._raster(a["xs"], a["ys"], X, Y)
                           == tc._raster(b["xs"], b["ys"], X, Y)).mean())
            aa = tc._band_areas(a["xs"], a["ys"])
            ab = tc._band_areas(b["xs"], b["ys"])
            area = float(np.max(np.abs(aa - ab)
                                / np.maximum(np.abs(ab), 1e-12 * np.abs(ab).sum())))
        ax = [v for band in a["xs"] for poly in band for ring in poly
              for v in ring]
        if ax:
            xr = "%.10g %.10g" % (min(ax), max(ax))
    else:
        ok = list(a["levels"]) == list(b["levels"])
        for k in range(len(b["xs"])):
            na = np.isfinite(tc._nan(a["xs"][k])).sum()
            nb = np.isfinite(np.asarray(b["xs"][k], float)).sum()
            ok = ok and na == nb
        agree = 1.0 if ok else 0.0
    lay = [x for f in r.figures.values() for x in f.renderers
           if "muted" in x.properties()]
    lay += [cr.fill_renderer, cr.line_renderer]
    cue = [t for f in r.figures.values() for t in f.above
           if "dash_stale_cue" in (getattr(t, "tags", None) or [])]
    st = r.filter_callbacks[0].args.get("stale_status")
    Macro.setGlobal("u29_agree", "%.6f" % agree)
    Macro.setGlobal("u29_area", "%.6g" % area)
    Macro.setGlobal("u29_cue", str(int(any(x.muted for x in lay)
                                       or any(bool(t.visible) for t in cue)
                                       or bool(st is not None and st.visible))))
    Macro.setGlobal("u29_same", str(int(repr(dict(src.data)) == before)))
    Macro.setGlobal("u29_xr", xr)
end

capture program drop _u29_pair
program define _u29_pair
    // _u29_pair <dir> <k> <filter> <if> <plot command>: the spec of the
    // plot under filter() (s<k>/d<k>) and of the plot `if <if>' (q<k>/e<k>).
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    gettoken filt 0 : 0
    gettoken cond 0 : 0
    gettoken cmd opts : 0, parse(",")
    dash clear
    quietly dash `cmd' if `cond' `opts' name(zq`k')
    _dash_serve_spec, specpath("`dir'/q`k'.json") datapath("`dir'/e`k'.json")
    dash clear
    quietly dash `cmd' `opts' name(zs`k')
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json") filter(`filt')
    dash clear
end

* ==== S29 B4c: contour and contourline refit on the saved page ====
local only : env WP31_ONLY
if inlist("`only'", "", "S29") & `: list posof "S29" in w31_run' {
    display as text "S29 start " c(current_date) " " c(current_time)
    local u29d "`w31_work'/s29"
    capture mkdir "`u29d'"
    capture graph drop _all

    // ------------------------------------------------------------
    // U29-1..3, 5: after the dropdown to Foreign the saved page cut at
    // ccuts() draws what the page of `if foreign == 1' draws (the Python side, contourpy's
    // cut of S23's surface, itself pinned to twoway by U26-2): the bands
    // on 99% of a raster and their areas within 1%, or the lines with
    // the same vertex count per level; and no stale mark.
    // ------------------------------------------------------------
    local k 0
    foreach c in "U29-1|contour mpg weight length, ccuts(20 30)" "U29-2|contourline mpg weight length, ccuts(20.5 30.5)" "U29-3|contour mpg weight length, interp(shepard) ccuts(18.5 24.5 30.5)" "U29-3|contour mpg weight length, interp(none) ccuts(18.5 24.5 30.5)" "U29-5|contour mpg weight length, horizontal ccuts(20 30)" {
        local ++k
        mata: u29_t = ustrsplit(st_local("c"), "[|]"); st_local("id", u29_t[1]); st_local("cmd", u29_t[2])
        sysuse auto, clear
        _u29_pair `u29d' `k' "foreign, type(dropdown)" "foreign == 1" `cmd'
        python: _u29_move("`u29d'/s`k'.json", "`u29d'/d`k'.json", "Select", "Foreign", "`u29d'/q`k'.json", "`u29d'/e`k'.json")
        _w31_expect `id' "(${u29_agree} >= .99)" "`cmd' moved to Foreign: ${u29_agree} of the raster (or the lines) agree"
        _w31_expect `id' "(${u29_area} <= .01)" "`cmd' moved to Foreign: band areas differ by ${u29_area}"
        _w31_expect `id' "(${u29_cue} == 0)" "`cmd' moved to Foreign: the layer is marked"
        if "`id'" == "U29-5" {
            quietly summarize weight if foreign == 1
            local wr = strtrim(string(r(min), "%18.10g")) + " " + strtrim(string(r(max), "%18.10g"))
            _w31_expect `id' `"("${u29_xr}" == "`wr'")"' "horizontal: the refit's x range ${u29_xr}; weight's `wr'"
        }
        _w31_done `id' "`cmd' refits on the saved page after the move (agree ${u29_agree}, area ${u29_area})"
    }

    // ------------------------------------------------------------
    // U29-4: 1,001 distinct points: the saved page keeps the build after
    // the move and marks it (decision D4).
    // ------------------------------------------------------------
    clear
    quietly set obs 1001
    set seed 29
    quietly generate double x = runiform()
    quietly generate double y = runiform()
    quietly generate double z = rnormal()
    quietly generate byte g = runiform() < .5
    label define u29g 0 "Off" 1 "On"
    label values g u29g
    local ++k
    _u29_pair `u29d' `k' "g, type(dropdown)" "g == 1" contour z y x,
    python: _u29_move("`u29d'/s`k'.json", "`u29d'/d`k'.json", "Select", "On", "`u29d'/q`k'.json", "`u29d'/e`k'.json")
    _w31_expect U29-4 "(${u29_same} == 1)" "1,001 points: the move rewrote the source"
    _w31_expect U29-4 "(${u29_cue} == 1)" "1,001 points: the layer is not marked after the move"
    _w31_done U29-4 "above the cap the saved page keeps the contour as built and marks it"

    // ------------------------------------------------------------
    // U29-8: a %td z is cut in days, as twoway cuts it (measured
    // live: the contour view's ccuts and its z axis's ticks), in both
    // modes; the key is written in %8.0gc, not %td.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly generate double zd = td(01jan2000) + 3*price
    format zd %td
    _u26_tw contour zd mpg weight,
    local ++k
    _u26_reg `u29d' `k' contour zd mpg weight, name(zu298)
    foreach m in s v {
        _w31_expect U29-8 `"("${u26_cut`m'}" == "${u26_twcut}")"' "`m': cuts ${u26_cut`m'}; twoway's ${u26_twcut}"
        _w31_expect U29-8 `"("${u26_tick`m'}" == "${u26_twtick}")"' "`m': key ticks ${u26_tick`m'}; twoway's ${u26_twtick}"
    }
    _w31_done U29-8 "a %td z is cut at twoway's ${u26_twcut} and keyed at ${u26_twtick}"

    forvalues i = 1/`k' {
        foreach p in s d q e a {
            capture erase "`u29d'/`p'`i'.json"
            capture erase "`u29d'/`p'`i'.py"
        }
    }
    capture rmdir "`u29d'"
    capture label drop u29g
    macro drop u29_agree u29_area u29_cue u29_same u29_xr
    capture macro drop u26_*
    capture mata: mata drop u29_t
    dash clear
    clear
    display as text "S29 end " c(current_date) " " c(current_time)
}
* ==== end S29 ====

// S29 B4d helper.  _u29_key: the saved page of spec sp/dp after one
// filter move (its own callback run under node): globals u29_kcut (the
// colour key's inner levels, "%.10g" each), u29_ktick (its ticks), u29_kn
// (its level count) and u29_kband (the drawn band count).
python:
def _u29_key(sp, dp, kind, value):
    import os
    import sys
    import warnings
    if os.getcwd() not in sys.path:
        sys.path.insert(0, os.getcwd())
    import dash_render as dr
    import js_runner
    from sfi import Macro
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
    w = [m for m in r.filter_widgets if type(m).__name__ == kind][0]
    w.value = [v for v, lab in w.options if lab == value][0]
    cb = r.filter_callbacks[r.filter_widgets.index(w)]
    js_runner.JsSession(r.filter_callbacks).run(cb)
    f = list(r.figures.values())[0]
    [bar] = [m for side in ("right", "left", "above", "below", "center")
             for m in getattr(f, side) if type(m).__name__ == "ContourColorBar"]
    Macro.setGlobal("u29_kcut", " ".join(format(float(v), ".10g")
                                         for v in bar.levels[1:-1]))
    Macro.setGlobal("u29_ktick", " ".join(format(float(v), ".10g")
                                          for v in bar.ticker.ticks))
    Macro.setGlobal("u29_kn", str(len(bar.levels)))
    Macro.setGlobal("u29_kband",
                    str(len(bar.fill_renderer.data_source.data["xs"])))
end

* ==== S29 B4d: the contour's cuts and colour key after a filter move ====
local only : env WP31_ONLY
if inlist("`only'", "", "S29") & `: list posof "S29" in w31_run' {
    display as text "S29 start " c(current_date) " " c(current_time)
    local u29d "`w31_work'/s29k"
    capture mkdir "`u29d'"
    capture graph drop _all

    // ------------------------------------------------------------
    // U29-6, U29-7: after the dropdown to Foreign the saved page's colour
    // key holds twoway's cuts for `if foreign == 1' (measured live: the
    // drawn contour view's ccuts) -- zlabel(#5)'s by default, levels(4)'s
    // -- as many levels as bands plus one, and twoway's z-axis ticks
    // inside the span it was built with.
    // ------------------------------------------------------------
    local k 0
    foreach c in "U29-6|contour price mpg weight," "U29-7|contour price mpg weight, levels(4)" {
        local ++k
        mata: u29_t = ustrsplit(st_local("c"), "[|]"); st_local("id", u29_t[1]); st_local("cmd", u29_t[2])
        sysuse auto, clear
        local u29v = subinstr("`cmd'", ",", " if foreign == 1,", 1)
        _u26_tw `u29v'
        dash clear
        quietly dash `cmd' name(zk`k')
        _dash_serve_spec, specpath("`u29d'/s`k'.json") datapath("`u29d'/d`k'.json") filter(foreign, type(dropdown))
        dash clear
        python: _u29_key("`u29d'/s`k'.json", "`u29d'/d`k'.json", "Select", "Foreign")
        _w31_expect `id' `"("${u29_kcut}" == "${u26_twcut}")"' "`cmd' moved to Foreign: key cuts ${u29_kcut}; twoway `u29v' cuts ${u26_twcut}"
        _w31_expect `id' "(${u29_kn} == ${u29_kband} + 1)" "`cmd' moved to Foreign: ${u29_kn} key levels for ${u29_kband} bands"
        local bad 0
        local twt ${u26_twtick}
        foreach t of global u29_ktick {
            if !`: list t in twt' local bad 1
        }
        _w31_expect `id' `"(`bad' == 0 & "${u29_ktick}" != "")"' "`cmd' moved to Foreign: key ticks ${u29_ktick}; twoway's ${u26_twtick}"
        _w31_done `id' "`cmd' moved to Foreign keys twoway's cuts ${u26_twcut} (ticks ${u29_ktick})"
    }

    forvalues i = 1/`k' {
        foreach p in s d {
            capture erase "`u29d'/`p'`i'.json"
        }
    }
    capture rmdir "`u29d'"
    macro drop u29_kcut u29_ktick u29_kn u29_kband u26_twcut u26_twrgb u26_twtick
    capture mata: mata drop u29_t
    dash clear
    clear
    display as text "S29 end " c(current_date) " " c(current_time)
}
* ==== end S29 ====

// S30 helpers (WP-31 D3).  _u30_check reads twoway's SVG and dash's saved
// and served figures of one case and writes one comparable line each:
// globals u30_tw, u30_s and u30_v.  Cases: "clock" (each box's side, a
// side twoway draws beside the plot read as dash's nearer horizontal side,
// _dash_textbox_place), "inside" (the third of the plot region a ring(0)
// box is in), "box" (fill and line colour), "size" (the note's size in
// points), "order" (the boxes above the plot from the plot out), "by" (how
// many N the graph draws).
python:
def _u30_svg(path):
    import re
    with open(path, encoding="utf-8") as fh:
        src = fh.read()
    texts = []
    for attrs, body in re.findall(r"<text\b([^>]*)>([^<]*)</text>", src):
        body = body.strip()
        if not body or re.fullmatch(r"[-0-9.,]+", body):
            continue
        a = dict(re.findall(r'([a-z-]+)="([^"]*)"', attrs))
        fs = re.search(r"font-size:([0-9.]+)px", a.get("style", ""))
        texts.append((body, float(a["x"]), float(a["y"]),
                      float(fs.group(1)) if fs else 0.0))
    rects = []
    for attrs in re.findall(r"<rect\b([^>]*)/?>", src):
        a = dict(re.findall(r'([a-z-]+)="([^"]*)"', attrs))
        rects.append((float(a.get("x", 0)), float(a.get("y", 0)),
                      float(a.get("width", 0)), float(a.get("height", 0)),
                      a.get("style", "")))
    plot = next(r for r in rects if r[4].startswith("fill:#FFFFFF"))
    return texts, rects, plot


def _u30_third(v, lo, hi):
    f = (v - lo) / (hi - lo)
    return 0 if f < 1 / 3 else (1 if f < 2 / 3 else 2)


def _u30_tw(path, case):
    import dash_render as dr
    texts, rects, (px, py, pw, ph, _s) = _u30_svg(path)
    if case == "clock":
        t = [e for e in texts if e[0] == "T"][0]
        clock = int(path.rsplit("_", 1)[1].split(".")[0])
        if t[2] < py:
            side = "above"
        elif t[2] > py + ph:
            side = "below"
        else:
            side = dr._dash_textbox_place(clock, "center")[0]
        return "%d:%s" % (clock, side)
    if case == "inside":
        t = [e for e in texts if e[0] == "N"][0]
        h = ("left", "center", "right")[_u30_third(t[1], px, px + pw)]
        v = ("top", "center", "bottom")[_u30_third(t[2], py, py + ph)]
        return "%s %s" % (h, v)
    if case == "box":
        fill = [r for r in rects if r[4].startswith("fill:#E0E0E0")]
        line = [r for r in rects if "stroke:#FF0000" in r[4]]
        return "fill %s line %s" % ("#e0e0e0" if fill else "-",
                                    "#ff0000" if line else "-")
    if case == "size":
        t = [e for e in texts if e[0] == "N"][0]
        return "%gpt" % round(t[3] / 10.0)
    if case == "order":
        above = sorted([e for e in texts if e[2] < py
                        and e[0] in ("T", "S", "N", "T1", "T2")],
                       key=lambda e: -e[2])
        return " ".join(e[0] for e in above)
    if case == "by":
        return "N:%d" % sum(1 for e in texts if e[0] == "N")
    if case == "at":
        t = [e for e in texts if e[0] not in ("Mileage (mpg)",
                                              "Weight (lbs.)")]
        return "%s %gpt" % (t[0][0], round(t[0][3] / 10.0)) if t else "-"
    return "?"


def _u30_dash(figs, case):
    from bokeh.models import Label, Title
    f = figs[0]

    def boxes(fig):
        out = []
        for side in ("center", "above", "below"):
            for m in getattr(fig, side):
                if "dash_textbox" in list(getattr(m, "tags", None) or []):
                    out.append((side, m))
        return out
    if case == "clock":
        side, m = [b for b in boxes(f) if b[1].text == "T"][0]
        return side
    if case == "inside":
        side, m = [b for b in boxes(f) if b[1].text == "N"][0]
        if not isinstance(m, Label):
            return "not a Label"
        return "%s %s" % (m.x.symbol, m.y.symbol)
    if case == "box":
        side, m = [b for b in boxes(f) if b[1].text == "C"][0]
        return "fill %s line %s" % (str(m.background_fill_color).lower(),
                                    str(m.border_line_color).lower())
    if case == "size":
        side, m = [b for b in boxes(f) if b[1].text == "N"][0]
        return str(m.text_font_size)
    if case == "order":
        out = []
        for m in f.above:
            if isinstance(m, Title) and m.text in ("T", "S", "N", "T1", "T2"):
                out.append(m.text)
        if f.title is not None and f.title.text == "T":
            out.append("T")
        return " ".join(out)
    if case == "by":
        return "N:%d" % sum(1 for g in figs for side, m in boxes(g)
                            if m.text == "N")
    if case == "at":
        labs = [m for m in f.center if isinstance(m, Label)
                and "dash_added_text" in list(m.tags or [])]
        # The canvas-text pass keeps "$$" from reading as TeX with a
        # word joiner (U+2060) between the two; the text drawn is "$$".
        return ("%s %s" % (labs[0].text.replace("\u2060", ""),
                           labs[0].text_font_size) if labs else "-")
    return "?"


def _u30_check(sp, dp, app, svg, case, clock=""):
    import __main__ as m
    from sfi import Macro
    a, b = m._u03_docs(sp, dp, app)
    tw = _u30_tw(svg, case)
    if case == "clock":
        Macro.setGlobal("u30_tw", tw)
        for figs, sfx in ((a, "s"), (b, "v")):
            Macro.setGlobal("u30_" + sfx, tw.split(":")[0] + ":"
                            + _u30_dash(figs, case))
        return
    Macro.setGlobal("u30_tw", tw)
    for figs, sfx in ((a, "s"), (b, "v")):
        Macro.setGlobal("u30_" + sfx, _u30_dash(figs, case))
end

capture program drop _u30_reg
program define _u30_reg
    // _u30_reg <dir> <k> <case> <command with options...>
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    gettoken case 0 : 0
    quietly twoway `macval(0)' name(u30t, replace)
    quietly graph export "`dir'/t_`k'.svg", replace
    graph drop u30t
    dash clear
    capture quietly dash `macval(0)' name(zu30`k')
    if _rc {
        global u30_s "rc `=_rc'"
        global u30_v "rc `=_rc'"
        global u30_tw "(twoway drawn)"
        exit
    }
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u30_m; _u30_m._u30_check("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py", "`dir'/t_`k'.svg", "`case'")
end

* ==== S30 D3: Textbox placement ====
local only : env WP31_ONLY
if inlist("`only'", "", "S30") & `: list posof "S30" in w31_run' {
    display as text "S30 start " c(current_date) " " c(current_time)
    local u30d "`w31_work'/s30"
    capture mkdir "`u30d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear

    // U30-1: title(, position(k)) on twoway's side; beside the plot is
    // dash's nearer horizontal side (the documented difference).
    foreach k in 3 6 9 12 {
        _u30_reg "`u30d'" `k' clock scatter mpg weight, title("T", position(`k'))
        foreach m in s v {
            _w31_expect U30-1 `"("${u30_`m'}" == "${u30_tw}")"' "`m' clock `k': dash ${u30_`m'}; twoway ${u30_tw}"
        }
    }
    _w31_done U30-1 "position(3 6 9 12) on twoway's sides, saved and served"

    // U30-2: ring(0) position(k): inside the plot region at the clock's
    // compass point.
    foreach k in 1 3 6 9 12 {
        _u30_reg "`u30d'" 2`k' inside scatter mpg weight, note("N", ring(0) position(`k'))
        foreach m in s v {
            _w31_expect U30-2 `"("${u30_`m'}" == "${u30_tw}")"' "`m' ring(0) position(`k'): dash ${u30_`m'}; twoway ${u30_tw}"
        }
    }
    _w31_done U30-2 "ring(0) boxes at their compass points, saved and served"

    // U30-3: box bcolor() lcolor(): the frame's fill and line.
    _u30_reg "`u30d'" 3 box scatter mpg weight, caption("C", box bcolor(gs14) lcolor(red) lwidth(thick) margin(medium))
    foreach m in s v {
        _w31_expect U30-3 `"("${u30_`m'}" == "${u30_tw}")"' "`m': dash ${u30_`m'}; twoway ${u30_tw}"
    }
    _w31_done U30-3 "the box ${u30_tw}, saved and served"

    // U30-4: tstyle(heading): the heading's size.
    _u30_reg "`u30d'" 4 size scatter mpg weight, note("N", tstyle(heading))
    foreach m in s v {
        _w31_expect U30-4 `"("${u30_`m'}" == "${u30_tw}")"' "`m': dash ${u30_`m'}; twoway ${u30_tw}"
    }
    _w31_done U30-4 "tstyle(heading) draws ${u30_tw}, saved and served"

    // U30-5: rings above the plot, from the plot out: the edge titles,
    // a ring(2) subtitle, the note at 12 (ring 4), the title (ring 7).
    _u30_reg "`u30d'" 5 order scatter mpg weight, title("T") subtitle("S", ring(2)) t1title("T1") note("N", position(12))
    foreach m in s v {
        _w31_expect U30-5 `"("${u30_`m'}" == "${u30_tw}")"' "`m': dash ${u30_`m'}; twoway ${u30_tw}"
    }
    _w31_done U30-5 "ring order ${u30_tw}, saved and served"

    // U30-6: by(): a ring(0) note on every panel, once each.
    _u30_reg "`u30d'" 6 by scatter mpg weight, by(foreign) note("N", ring(0) position(1))
    foreach m in s v {
        _w31_expect U30-6 `"("${u30_`m'}" == "${u30_tw}")"' "`m': dash ${u30_`m'}; twoway ${u30_tw}"
    }
    _w31_done U30-6 "by(): ${u30_tw}, saved and served"

    macro drop u30_tw u30_s u30_v
    capture graph drop _all
    dash clear
    display as text "S30 end " c(current_date) " " c(current_time)
}
* ==== end S30 ====

* ==== S30 D13: Added text style and globals ====
local only : env WP31_ONLY
if inlist("`only'", "", "S30") & `: list posof "S30" in w31_run' {
    display as text "S30 start " c(current_date) " " c(current_time)
    local u30d "`w31_work'/s30b"
    capture mkdir "`u30d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear

    // U30-9: text(, tstyle(heading)) in the heading's size.
    _u30_reg "`u30d'" 9 at scatter mpg weight, text(30 2000 "P", tstyle(heading))
    foreach m in s v {
        _w31_expect U30-9 `"("${u30_`m'}" == "${u30_tw}")"' "`m': dash ${u30_`m'}; twoway ${u30_tw}"
    }
    _w31_done U30-9 "tstyle(heading) on text(): ${u30_tw}, saved and served"

    // U30-10, U30-11: a line naming a global, the $ kept for the command
    // (macval), drawn as twoway draws it: $u30x, then $$u30f$$ and
    // ${u30x}!.  Each command is built by value.
    global u30x "hello"
    global u30f "F"
    local u30q = char(34)
    local u30s = char(36)
    foreach c in 10 11a 11b {
        if "`c'" == "10" local u30l "`u30s'u30x"
        if "`c'" == "11a" local u30l "`u30s'`u30s'u30f`u30s'`u30s'"
        if "`c'" == "11b" local u30l "`u30s'{u30x}!"
        mata: st_local("u30c", "scatter mpg weight, text(30 2000 " + st_local("u30q") + st_local("u30l") + st_local("u30q") + ")")
        _u30_reg "`u30d'" `c' at `macval(u30c)'
        local u30id = cond("`c'" == "10", "U30-10", "U30-11")
        foreach m in s v {
            _w31_expect `u30id' `"(`"${u30_`m'}"' == `"${u30_tw}"')"' "`m' `c': dash ${u30_`m'}; twoway ${u30_tw}"
        }
        if "`c'" == "10" {
            _w31_done U30-10 "a global in a text() line drawn as twoway draws it, saved and served"
        }
        if "`c'" == "11b" {
            _w31_done U30-11 "nested globals and braces in a text() line drawn as twoway draws them, saved and served"
        }
    }
    macro drop u30x u30f u30_tw u30_s u30_v
    capture graph drop _all
    dash clear
    display as text "S30 end " c(current_date) " " c(current_time)
}
* ==== end S30 ====

* ==== append new blocks above this line ====

// ----------------------------------------------------------------
// Summary (test_wp29_truth.cscript's shape)
// ----------------------------------------------------------------
capture graph drop _all
capture dash clear
capture rmdir "`w31_work'"
local nfail    = ${w31_nfail}
local faillist "${w31_faillist}"
local ncase    = ${w31_ncase}
local only : env WP31_ONLY
macro drop w31_nfail w31_faillist w31_bad w31_ncase
display as text ""
display as text "============================================================"
if `ncase' == 0 {
    if `w31_N' > 1 & `"`macval(only)'"' == "" & "`w31_run'" == "" {
        display as text "test_wp31_truth: part `w31_k'/`w31_N' has no block to run"
        display as text "============================================================"
        exit 0
    }
    // A WP31_ONLY that names no block, or only a stub, ran nothing:
    // that is not a pass.
    display as error "  test_wp31_truth: no case ran (WP31_ONLY=`only')"
    display as text "============================================================"
    exit 9
}
else if `nfail' == 0 {
    display as text "  test_wp31_truth: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_wp31_truth: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
