def _u47_points(sp, dp, app):
    """global u47_np: the finite (x, y) points a scatteri layer draws,
    saved then served, as "<saved> <served>"."""
    import numpy as np
    from bokeh.models import GlyphRenderer
    from sfi import Macro
    r, _page, doc = __import__("__main__")._u02_docs(sp, dp, app)
    out = []
    for roots in ([r._last_layout_root], list(doc.roots)):
        n = 0
        for root in roots:
            for m in root.references():
                if isinstance(m, GlyphRenderer) and type(m.glyph).__name__ == "Scatter":
                    d = m.data_source.data
                    gx, gy = m.glyph.x, m.glyph.y
                    if isinstance(gx, str) and isinstance(gy, str) and gx in d:
                        xs = np.asarray(list(d[gx]), float)
                        ys = np.asarray(list(d[gy]), float)
                        n += int((np.isfinite(xs) & np.isfinite(ys)).sum())
        out.append(str(n))
    Macro.setGlobal("u47_np", " ".join(out))
end

