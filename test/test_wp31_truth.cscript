            _w31_expect U08-4 "(`rc' == 0)" "dash scatter mpg weight, `opt' saving() rc `rc'"
            python: _u08_has("`lf'", "ignoring unsupported option(s): mlalign()")
            _w31_expect U08-4 "(${u08_found} == 1)" "dash `opt' did not name mlalign() in its note"
        }
    }
    _w31_done U08-4 "ml() mla() mlab() mlabe() are mlabel(), mla(center) is refused, and mlal() .. mlalign() are mlalign(), named until drawn, as twoway binds them"

