def _u45_left_titles(page):
    """u45_bad: "" when the saved page's first figure has left axes titled
    AX2, AX3, AX4 outward and its TXT label is on the default y range,
    else what it has (WP-31 D9b)."""
    import json
    import re
    from sfi import Macro
    with open(page, encoding="utf-8") as fh:
        html = fh.read()
    objs = {}
    def walk(o):
        if isinstance(o, dict):
            if o.get("type") == "object" and "id" in o:
                objs[o["id"]] = o
            for v in o.values():
                walk(v)
        elif isinstance(o, list):
            for v in o:
                walk(v)
    for m in re.finditer(r'<script type="application/json"[^>]*>(.*?)</script>', html, re.S):
        try:
            walk(json.loads(m.group(1)))
        except ValueError:
            pass
    bad = []
    figs = [o for o in objs.values() if o.get("name") == "Figure"]
    lefts = []
    for f in figs:
        ids = [a.get("id") for a in (f.get("attributes") or {}).get("left", [])]
        t = [(objs.get(i) or {}).get("attributes", {}).get("axis_label") for i in ids]
        t = [x for x in t if isinstance(x, str) and x.startswith("AX")]
        if t:
            lefts.append(t)
    if lefts != [["AX2", "AX3", "AX4"]]:
        bad.append("left %s" % lefts)
    labs = [o for o in objs.values() if o.get("name") == "Label"
            and (o.get("attributes") or {}).get("text") == "TXT"]
    if not labs or any((o["attributes"].get("y_range_name") or "default") != "default" for o in labs):
        bad.append("TXT %s" % [o.get("attributes", {}).get("y_range_name") for o in labs])
    Macro.setGlobal("u45_bad", "; ".join(bad)[:1500])
end

