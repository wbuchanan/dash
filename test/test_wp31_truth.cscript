// S36 (WP-31 D10) helpers: one dash graph drawn in both modes, and one
// by() fact of it checked into global u36_bad ("" when it holds).
python:
def _u36_docs(sp, dp, app):
    """(saved models, served models, served document, notes)."""
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings(record=True) as w1:
        warnings.simplefilter("always")
        r = dr.DashRenderer(sp, dp)
        r.render()
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        dr.ServerAppBuilder(sp, dp).build(app)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_u36_app")
    with warnings.catch_warnings(record=True) as w2:
        warnings.simplefilter("always")
        exec(compile(src.replace(attach, "pass"), "dash_u36_app.py", "exec"),
             ns)
        doc = Document()
        ns["make_document"](doc)
    saved = list(r._last_layout_root.references())
    return (saved, list(doc.models), doc,
            "\n".join(str(x.message) for x in list(w1) + list(w2)))


def _u36_panels(models):
    return sorted([m for m in models if getattr(m, "_dash_by_panel", False)],
                  key=lambda f: str(getattr(f, "id", "")))


def _u36_box(fig):
    for side in ("above", "below"):
        for m in getattr(fig, side):
            if type(m).__name__ == "ColorBar" and m.name == "dash_by_label_box":
                return m
    return None


def _u36_check(sp, dp, app, case, fixture):
    import json
    from sfi import Macro
    a, b, doc, notes = _u36_docs(sp, dp, app)
    bad = []
    for tag, models in (("saved", a), ("served", b)):
        panels = _u36_panels(models)
        if case == "regions":
            for f in panels:
                if str(f.border_fill_color).lower() != "#0000ff":
                    bad.append("%s border %s" % (tag, f.border_fill_color))
            feet = [m for m in models if getattr(m, "name", "") == "dash_by_foot"]
            if not feet or str(feet[0].border_fill_color).lower() != "#ff0000":
                bad.append("%s foot cell not red" % tag)
        elif case == "legend":
            legs = [m for m in models if type(m).__name__ == "Legend"
                    and getattr(m, "name", "") == "dash_by_legend_key"]
            if len(legs) != 1 or legs[0].click_policy != "hide":
                bad.append("%s legend %r" % (tag, legs))
            else:
                for it in legs[0].items:
                    n = sum(1 for f in panels
                            if any(r in f.renderers for r in it.renderers))
                    if n != len(panels) or len(panels) != 5:
                        bad.append("%s item spans %d of %d" % (tag, n, len(panels)))
        elif case == "margin":
            with open(fixture, encoding="utf-8") as fh:
                p = json.load(fh)["probes"]["margin_iscale_half"]
            reg = [r for r in p["rects"] if r["fill"] == "#ffffff"
                   and r["stroke"] is None][0]
            x5 = [t["x"] for t in p["texts"] if t["t"] == "5,000"
                  and reg["x"] < t["x"] < reg["x"] + reg["w"]][0]
            want = (reg["x"] + reg["w"] - x5) / min(
                p["canvas"]["w"], p["canvas"]["h"]) / 0.022
            for f in panels:
                got = f._dash_margin["x"][1] / (0.022 * 4.0 / 5.5)
                if abs(got - want) > 1e-3:
                    bad.append("%s margin %.4f twoway %.4f" % (tag, got, want))
        elif case == "box":
            for f in panels:
                bx = _u36_box(f)
                if bx is None or bx.color_mapper.palette[0].lower() != "#ffff00" \
                        or str(bx.bar_line_color).lower() != "#0000ff":
                    bad.append("%s box %r" % (tag, bx))
        elif case == "nobox":
            if any(_u36_box(f) is not None for f in panels):
                bad.append("%s a box is drawn" % tag)
        elif case == "outer":
            for f in panels:
                if str(f.border_fill_color).lower() != "#eaf2f3":
                    bad.append("%s border %s" % (tag, f.border_fill_color))
        elif case == "ring0rows":
            grids = [m for m in models if type(m).__name__ == "GridPlot"
                     and any(getattr(c[0], "name", "") == "dash_by_legend"
                             for c in m.children)]
            rows = {getattr(c[0], "name", ""): c[1]
                    for g in grids for c in g.children}
            if not ("dash_by_legend" in rows and "dash_by_xtitle" in rows
                    and rows["dash_by_legend"] < rows["dash_by_xtitle"]):
                bad.append("%s rows %r" % (tag, rows))
        elif case == "one":
            feet = [m for m in models if getattr(m, "name", "") == "dash_by_foot"]
            texts = [str(t.text) for c in feet for t in list(c.above) + list(c.below)
                     if type(t).__name__ == "Title"]
            if len(panels) != 1 or _u36_box(panels[0]) is not None \
                    or "Graphs by onee" not in texts:
                bad.append("%s panels %d texts %r" % (tag, len(panels), texts))
        elif case == "move" and tag == "served":
            sl = [m for m in models if type(m).__name__ == "Slider"]
            if len(sl) != 1:
                bad.append("served sliders %d" % len(sl))
            else:
                w = sl[0]
                lo = w.start

                def fire(v):
                    w.value = v
                    for key in ("value", "value_throttled"):
                        for cb in list(w._callbacks.get(key, [])):
                            cb("value", None, v)
                fire(13000.0)
                vis = [bool(f.visible) for f in panels]
                fire(lo)
                back = [bool(f.visible) for f in panels]
                if sorted(vis) != [False, True] or back != [True, True]:
                    bad.append("served visible %r then %r" % (vis, back))
    if case in ("regions", "box") and "not implemented" in notes:
        bad.append("a drawn sub-option was named")
    if case == "legend" and "drawn beside the panels" in notes:
        bad.append("the ring(0) note")
    Macro.setGlobal("u36_bad", "; ".join(bad))
end

python:
def _u36_svg_order(svg):
    """twoway's ring(0) legend key text above its x title (u36_bad)."""
    import os, sys
    from sfi import Macro
    sys.path.insert(0, os.path.abspath(os.path.join("..", "scripts")))
    import svg_truth
    t = {x["text"]: x["y"] for x in svg_truth.svg_document(svg)["texts"]}
    ok = t.get("Mileage (mpg)", 1e9) < t.get("Weight (lbs.)", -1)
    Macro.setGlobal("u36_bad", "" if ok else "twoway order %r" % (t,))
end

capture program drop _u36_reg
program define _u36_reg
    // _u36_reg <dir> <k> <case> <command with options...>
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    gettoken case 0 : 0
    global u36_bad ""
    capture noisily twoway `0' name(u36t, replace)
    if _rc {
        global u36_bad "twoway rc `=_rc'"
        exit
    }
    capture graph drop u36t
    dash clear
    capture noisily dash `0' name(zu36`k')
    if _rc {
        global u36_bad "dash rc `=_rc'"
        exit
    }
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u36_m; _u36_m._u36_check("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py", "`case'", r"`c(pwd)'/fixtures/by_remainder_truth.json")
end

* ==== S36 D10: The by() remainder ====
local only : env WP31_ONLY
if inlist("`only'", "", "S36") & `: list posof "S36" in w31_run' {
    display as text "S36 start " c(current_date) " " c(current_time)
    local u36d "`w31_work'/s36"
    capture mkdir "`u36d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear
    egen g4 = cut(price), group(4)
    generate byte onee = 1
    label define u36e 1 ""
    label values onee u36e

    // U36-01: by()'s regions on the array: the panels' borders blue (the
    // array's region), the chrome red (the graph's), no note.
    _u36_reg "`u36d'" 1 regions scatter mpg weight, by(foreign, graphregion(fcolor(red)) plotregion(fcolor(blue)))
    _w31_expect U36-01 `"(`"${u36_bad}"' == "")"' `"${u36_bad}"'
    _w31_done U36-01 "by()'s graphregion() and plotregion() drawn on the array, saved and served, silently"

    // U36-02: legend(ring(0)) with no note; the overall legend hides a
    // series in all five panels.
    _u36_reg "`u36d'" 2 legend (scatter mpg weight) (lfit mpg weight), by(rep78, legend(ring(0)))
    _w31_expect U36-02 `"(`"${u36_bad}"' == "")"' `"${u36_bad}"'
    _w31_done U36-02 "by(, legend(ring(0))) drawn silently; the overall legend spans every panel and hides on click"

    // U36-03: the panel margin is twoway's f(k) x iscale().
    _u36_reg "`u36d'" 3 margin scatter mpg weight, by(g4, iscale(.5))
    _w31_expect U36-03 `"(`"${u36_bad}"' == "")"' `"${u36_bad}"'
    _w31_done U36-03 "by(, iscale(.5)) panel margin equals twoway's, saved and served"

    // U36-04: the graph's subtitle(, fcolor() lcolor()) fills and outlines
    // every label box; nobox removes it.
    _u36_reg "`u36d'" 4 box scatter mpg weight, by(foreign) subtitle(, fcolor(yellow) lcolor(blue))
    _w31_expect U36-04 `"(`"${u36_bad}"' == "")"' `"${u36_bad}"'
    _u36_reg "`u36d'" 5 nobox scatter mpg weight, by(foreign) subtitle(, nobox)
    _w31_expect U36-04 `"(`"${u36_bad}"' == "")"' `"${u36_bad}"'
    _w31_done U36-04 "subtitle(, fcolor() lcolor() nobox) on the panel label boxes, saved and served"

    // U36-05: a one-panel by() with an empty value label: one panel, no
    // box, the Graphs-by note.
    _u36_reg "`u36d'" 6 one scatter mpg weight, by(onee)
    _w31_expect U36-05 `"(`"${u36_bad}"' == "")"' `"${u36_bad}"'
    _w31_done U36-05 "a one-panel by() with an empty label keeps the note and draws no box, saved and served"

    // U36-06: a served slider move to price 13000 empties the Foreign
    // panel (twoway: no foreign car costs that much); it is hidden, and
    // shown again at the slider's start.
    quietly count if foreign == 1 & price >= 13000
    _w31_expect U36-06 "r(N) == 0" "a foreign car costs 13000 or more"
    dash clear
    capture noisily dash scatter mpg weight, by(foreign) name(zu367)
    _dash_serve_spec, specpath("`u36d'/s7.json") datapath("`u36d'/d7.json") filter(price, type(slider))
    python: import __main__ as _u36_m; _u36_m._u36_check("`u36d'/s7.json", "`u36d'/d7.json", "`u36d'/a7.py", "move", "")
    _w31_expect U36-06 `"(`"${u36_bad}"' == "")"' `"${u36_bad}"'
    _w31_done U36-06 "a panel a served move empties is hidden and shown again"

    // U36-08: an outer graphregion() under by() colours no panel (twoway
    // keeps the scheme's region), and legend(ring(0)) below the panels
    // sits above the x title (twoway: inside the array, nearer the panels).
    _u36_reg "`u36d'" 8 outer scatter mpg weight, graphregion(fcolor(green)) by(foreign)
    _w31_expect U36-08 `"(`"${u36_bad}"' == "")"' `"${u36_bad}"'
    quietly twoway (scatter mpg weight) (lfit mpg weight), by(rep78, legend(ring(0))) name(u36g, replace)
    quietly graph export "`u36d'/g8.svg", replace
    graph drop u36g
    python: import __main__ as _u36_m; _u36_m._u36_svg_order(r"`u36d'/g8.svg")
    _w31_expect U36-08 `"(`"${u36_bad}"' == "")"' `"${u36_bad}"'
    _u36_reg "`u36d'" 9 ring0rows (scatter mpg weight) (lfit mpg weight), by(rep78, legend(ring(0)))
    _w31_expect U36-08 `"(`"${u36_bad}"' == "")"' `"${u36_bad}"'
    _w31_done U36-08 "an outer graphregion() colours no panel and a ring(0) legend sits above the x title, as twoway's"

    macro drop u36_bad
    capture graph drop _all
    dash clear
    set scheme s2color
    display as text "S36 end " c(current_date) " " c(current_time)
}
* ==== end S36 ====

// S36 (WP-31 D3b) helper: where each mode puts the panel labels.
python:
def _u36b_check(sp, dp, app, case):
    from sfi import Macro
    a, b, _doc, notes = _u36_docs(sp, dp, app)
    bad = []
    for tag, models in (("saved", a), ("served", b)):
        panels = _u36_panels(models)
        if len(panels) != 2:
            bad.append("%s %d panels" % (tag, len(panels)))
        for f in panels:
            t = [m for m in list(f.above) + list(f.below)
                 if getattr(m, "name", "") == "dash_by_label"]
            inside = [m for m in f.center
                      if "dash_by_label_inside" in (getattr(m, "tags", None) or [])]
            if case == "pos6":
                if not t or t[0] not in list(f.below) or t[0].align != "center":
                    bad.append("%s label not below, centred" % tag)
            elif case == "ring0":
                if len(inside) != 1 or inside[0].anchor != "bottom_right" \
                        or str(f.background_fill_color).lower() != "#d9e6eb":
                    bad.append("%s ring(0) label %r" % (tag, inside))
    if "position(" in notes or "ring(" in notes:
        bad.append("position() or ring() named")
    Macro.setGlobal("u36_bad", "; ".join(bad))
end

capture program drop _u36b_reg
