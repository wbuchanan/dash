local only : env WP31_ONLY
if inlist("`only'", "", "S41") & `: list posof "S41" in w31_run' {
    display as text "S41 start " c(current_date) " " c(current_time)
    local u41d "`w31_work'/s41s"
    capture mkdir "`u41d'"
    sysuse auto, clear

    // U41-02: an element with a glued = draws the default, silently,
    // saved and served, as twoway draws it (live).
    global u41_bad ""
    local k 20
    foreach v in "red=blue" "red=" "red=blue green" {
        local ++k
        _u41_markcase "`u41d'" `k' scatter mpg weight turn, mcolor(`v')
        if `"${u41_notes}"' != "" global u41_bad `"${u41_bad} [`v' noted: ${u41_notes}]"'
    }
    _w31_expect U41-02 `"(`"${u41_bad}"' == "")"' `"${u41_bad}"'
    _w31_done U41-02 "red=blue, red= and red=blue green draw the default for the glued element, silently, saved and served, as twoway"

    // U41-03: mcolor((red)) is refused by both, r(198).
    capture twoway scatter mpg weight turn, mcolor((red))
    local trc = _rc
    dash clear
    capture dash scatter mpg weight turn, mcolor((red))
    local drc = _rc
    _w31_expect U41-03 `"(`trc' == 198 & `drc' == 198)"' `"twoway rc `trc', dash rc `drc'"'
    _w31_done U41-03 "mcolor((red)) is refused, r(198), as twoway refuses it"

    // U41-04: an unknown msymbol() element is noted and the scheme's
    // circle drawn, as twoway draws it.
    global u41_bad ""
    _u41_markcase "`u41d'" 31 scatter mpg weight turn, msymbol(bogus circle)
    local ok = strpos(`"${u41_notes}"', "bogus") > 0 & `"${u41_sym}"' == "circle circle circle circle"
    _w31_expect U41-04 `"(`"${u41_bad}"' == "" & `ok')"' `"${u41_bad} notes: ${u41_notes} symbols: ${u41_sym}"'
    _w31_done U41-04 "msymbol(bogus circle) is noted and draws circles, saved and served, as twoway"
    display as text "S41 end " c(current_date) " " c(current_time)
}
