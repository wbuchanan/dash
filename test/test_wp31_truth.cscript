    local bad ""
    python: import json; from sfi import Macro; _d = json.load(open(r"`u40fx'", encoding="utf-8")); _miss = [k for k in ("sym.arrow", "sym.arrowf", "sym.A", "sym.a", "sym.pipe", "sym.|", "sym.point", "sym.p", "sym.V", "sym.v", "sym.star", "sym.dot", "sym.CIRCLE", "pat.dash", "pat.dash_w.thick", "pat.formula.f1", "mlp.dash") if k not in _d] + [k for k in ("stata_version", "born_date", "dash_commit", "extracted", "source") if not _d["_meta"].get(k)]; Macro.setLocal("bad", " ".join(_miss))
    _w31_expect U40-01 `"(`"`bad'"' == "")"' `"missing: `bad'"'
