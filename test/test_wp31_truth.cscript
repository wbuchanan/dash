// S27 (WP-31 D2) helpers: draw one command in twoway (SVG export) and in
// dash (both modes), and describe the edge titles each draws for one case
// into globals u27_tw (twoway), u27_s (saved) and u27_v (served).
python:
def _u27_svg(path):
    import re
    with open(path, encoding="utf-8") as fh:
        src = fh.read()
    out = []
    for attrs, body in re.findall(r"<text\b([^>]*)>([^<]*)</text>", src):
        body = body.replace(" ", " ").strip()
        if not body or re.fullmatch(r"[-0-9.,]+", body):
            continue
        a = dict(re.findall(r'([a-z-]+)="([^"]*)"', attrs))
        fs = re.search(r"font-size:([0-9.]+)px", a.get("style", ""))
        rot = re.search(r"rotate\((-?[0-9.]+)", a.get("transform", ""))
        out.append((body, float(a["x"]), float(a["y"]),
                    float(fs.group(1)) if fs else 0.0,
                    int(float(rot.group(1))) if rot else 0))
    return out


_U27_LABS = ("T1", "T2", "B1", "B2", "L1", "L2", "R1", "R2")


def _u27_rel(sz):
    def rel(a, b):
        if a is None or b is None:
            return "?"
        return "=" if abs(a - b) <= 0.01 * max(a, b) else (">" if a > b else "<")
    return " ".join("%s%s%s" % (p, rel(sz.get(p), sz.get(q)), q)
                    for p, q in (("T1", "T2"), ("B1", "B2"), ("L1", "L2"),
                                 ("R1", "R2"), ("T1", "B2")))


def _u27_tw(path, case):
    t = _u27_svg(path)
    pos = {b: (x, y, s, r) for b, x, y, s, r in t}
    if case == "by":
        return " ".join("%s:%d" % (k, sum(1 for b, *_ in t if b == k))
                        for k in ("T1", "B1", "L1", "R1"))
    if case == "vert":
        return " ".join("%s:%d" % (k, pos[k][3]) for k in _U27_LABS)
    if case == "sizes":
        return _u27_rel({k: pos[k][2] for k in _U27_LABS})
    cx, cy = pos["T1"][0], pos["L1"][1]
    if case == "sides":
        side = {}
        for k in _U27_LABS:
            x, y = pos[k][0], pos[k][1]
            side[k] = (("above" if y < cy else "below") if abs(x - cx) < 1
                       else ("left" if x < cx else "right"))
        out = []
        for k in _U27_LABS:
            mates = [j for j in _U27_LABS if side[j] == side[k]]
            d = {j: abs(pos[j][0] - cx) + abs(pos[j][1] - cy) for j in mates}
            out.append("%s:%s:%d" % (k, side[k],
                                     sorted(mates, key=d.get).index(k) + 1))
        return " ".join(out)
    # order: above nearest the plot first (largest y), below smallest y first
    legend = {"Mileage (mpg)", "Trunk space (cu. ft.)"}
    skip = {"T", "Weight (lbs.)"} | set(k for k in _U27_LABS if k[0] in "LR")
    top = pos["L1"][1]
    above = sorted([e for e in t if e[2] < top and e[0] not in skip],
                   key=lambda e: -e[2])
    below = sorted([e for e in t if e[2] > top and e[0] not in skip],
                   key=lambda e: e[2])

    def names(es):
        out = []
        for e in es:
            n = "legend" if e[0] in legend else e[0]
            if not out or out[-1] != n:
                out.append(n)
        return " ".join(out)
    return "above: %s | below: %s" % (names(above), names(below))


def _u27_dash(figs, case):
    from bokeh.models import Axis, Legend, Title
    edges = []
    for f in figs:
        for side in ("above", "below", "left", "right"):
            k = 0
            for m in getattr(f, side):
                tags = list(getattr(m, "tags", None) or [])
                if isinstance(m, Title) and "dash_edge_title" in tags:
                    k += 1
                    edges.append((m.text, side, k,
                                  float(str(m.text_font_size).rstrip("ptx"))))
    if case == "by":
        return " ".join("%s:%d" % (k, sum(1 for e in edges if e[0] == k))
                        for k in ("T1", "B1", "L1", "R1"))
    e = {x[0]: x for x in edges}
    if case == "vert":
        return " ".join("%s:%d" % (k, -90 if e[k][1] in ("left", "right")
                                   else 0) for k in _U27_LABS if k in e)
    if case == "sizes":
        return _u27_rel({k: e[k][3] for k in e})
    if case == "sides":
        return " ".join("%s:%s:%d" % (k, e[k][1], e[k][2])
                        for k in _U27_LABS if k in e)
    f = figs[0]

    def names(side):
        out = []
        for m in getattr(f, side):
            if isinstance(m, Axis) or "dash_stale_cue" in list(
                    getattr(m, "tags", None) or []):
                continue
            n = ("legend" if isinstance(m, Legend) else
                 (m.text if isinstance(m, Title) else type(m).__name__))
            out.append(n)
        return " ".join(out)
    return "above: %s | below: %s" % (names("above"), names("below"))


def _u27_check(sp, dp, app, svg, case):
    import __main__ as m
    from sfi import Macro
    a, b = m._u03_docs(sp, dp, app)
    Macro.setGlobal("u27_tw", _u27_tw(svg, case))
    for figs, sfx in ((a, "s"), (b, "v")):
        Macro.setGlobal("u27_" + sfx, _u27_dash(figs, case))
end

capture program drop _u27_reg
program define _u27_reg
    // _u27_reg <dir> <k> <case> <command with options...>
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    gettoken case 0 : 0
    quietly twoway `0' name(u27t, replace)
    quietly graph export "`dir'/t`k'.svg", replace
    graph drop u27t
    dash clear
    capture quietly dash `0' name(zu27`k')
    if _rc {
        global u27_s "rc `=_rc'"
        global u27_v "rc `=_rc'"
        global u27_tw "(twoway drawn)"
        exit
    }
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u27_m; _u27_m._u27_check("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py", "`dir'/t`k'.svg", "`case'")
end

* ==== S27 D2: Edge titles ====
local only : env WP31_ONLY
if inlist("`only'", "", "S27") & `: list posof "S27" in w31_run' {
    display as text "S27 start " c(current_date) " " c(current_time)
    local u27d "`w31_work'/s27"
    capture mkdir "`u27d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear
    local u27all `"(scatter mpg weight) (scatter trunk weight), t1title("T1") t2title("T2") b1title("B1") b2title("B2") l1title("L1") l2title("L2") r1title("R1") r2title("R2")"'

    // U27-1: each of the eight on twoway's side, ring 1 nearest the plot.
    _u27_reg "`u27d'" 1 sides `u27all'
    foreach m in s v {
        _w31_expect U27-1 `"("${u27_`m'}" == "${u27_tw}")"' "`m': dash ${u27_`m'}; twoway ${u27_tw}"
    }
    _w31_done U27-1 "the eight edge titles on twoway's sides and rings, saved and served: ${u27_tw}"

    // U27-2: the rings outward from the plot, above and below: the edge
    // titles inside the legend, the note, the caption and the subtitle.
    _u27_reg "`u27d'" 2 order `u27all' note("N") caption("C") subtitle("S") title("T")
    foreach m in s v {
        _w31_expect U27-2 `"("${u27_`m'}" == "${u27_tw}")"' "`m': dash ${u27_`m'}; twoway ${u27_tw}"
    }
    _w31_done U27-2 "ring order ${u27_tw}, saved and served"

    // U27-3: l and r titles turned on their side, t and b level.
    _u27_reg "`u27d'" 3 vert `u27all'
    foreach m in s v {
        _w31_expect U27-3 `"("${u27_`m'}" == "${u27_tw}")"' "`m': dash ${u27_`m'}; twoway ${u27_tw}"
    }
    _w31_done U27-3 "l and r vertical, t and b level: ${u27_tw}"

    // U27-4: the 1 titles larger than the 2 titles, except b2title, which
    // twoway draws in b1title's box.
    _u27_reg "`u27d'" 4 sizes `u27all'
    foreach m in s v {
        _w31_expect U27-4 `"("${u27_`m'}" == "${u27_tw}")"' "`m': dash ${u27_`m'}; twoway ${u27_tw}"
    }
    _w31_done U27-4 "text sizes as twoway's: ${u27_tw}"

    // U27-5: by(): the edge titles on every panel.
    _u27_reg "`u27d'" 5 by scatter mpg weight, by(foreign) t1title("T1") b1title("B1") l1title("L1") r1title("R1")
    foreach m in s v {
        _w31_expect U27-5 `"("${u27_`m'}" == "${u27_tw}")"' "`m': dash ${u27_`m'}; twoway ${u27_tw}"
    }
    _w31_done U27-5 "by(): ${u27_tw}, saved and served"

    macro drop u27_tw u27_s u27_v
    capture graph drop _all
    dash clear
    display as text "S27 end " c(current_date) " " c(current_time)
}
* ==== end S27 ====

// S28 helpers (WP-31 F1g).  _u28_move: the saved page's fpfit or fpfitci
// after one filter move -- the page rendered, the widget set and its own
// callback run under node (test/js_runner.py) -- the line's columns (x_fp,
// y_fp and, for fpfitci, y_lower and y_upper; a missing value as null)
// written to a JSON file; globals u28_n (the point count), u28_band (the
// finite lower limits) and u28_cue (1 when a layer is dimmed or a stale
// caption shows).  _u28_close: each saved column against a column of
// twoway's serset (_u10_ss's JSON), a missing value equal to a missing
// value; globals u28_ok 1 or 0 and u28_msg.
python:
def _u28_move(sp, dp, kind, value, out):
    import json
    import math
    import os
    import sys
    import warnings
    if os.getcwd() not in sys.path:
        sys.path.insert(0, os.getcwd())
    import dash_render as dr
    import js_runner
    from sfi import Macro
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
    w = [m for m in r.filter_widgets if type(m).__name__ == kind][0]
    if kind == "Select":
        w.value = [v for v, lab in w.options if lab == value][0]
    elif kind == "RangeSlider":
        w.value = tuple(float(v) for v in value.split())
    else:
        w.value = float(value)
    cb = r.filter_callbacks[r.filter_widgets.index(w)]
    js_runner.JsSession(r.filter_callbacks).run(cb)
    fits = [x for f in r.figures.values() for x in f.renderers
            if (getattr(x, "_dash_agg_config", None) or {}).get("type")
            in ("fpfit", "fpfitci")
            and not x._dash_agg_config.get("split")]
    d = fits[0].data_source.data

    def col(c):
        o = []
        for v in d[c]:
            v = float("nan") if v is None else float(v)
            o.append(v if math.isfinite(v) else None)
        return o

    cols = {c: col(c) for c in fits[0]._dash_agg_config["cols"]}
    with open(out, "w", encoding="utf-8") as fh:
        json.dump(cols, fh)
    lay = [x for f in r.figures.values() for x in f.renderers]
    cue = [t for f in r.figures.values() for t in f.above
           if "dash_stale_cue" in (getattr(t, "tags", None) or [])]
    Macro.setGlobal("u28_n", str(len(cols["x_fp"])))
    Macro.setGlobal("u28_band", str(sum(v is not None
                                        for v in cols.get("y_lower", []))))
    Macro.setGlobal("u28_cue", str(int(any(x.muted for x in lay) or any(
        bool(t.visible) for t in cue))))


def _u28_close(tw, saved, rtol):
    import json
    import numpy as np
    from sfi import Macro
    t = json.load(open(tw, encoding="utf-8"))
    g = json.load(open(saved, encoding="utf-8"))
    arr = lambda c: np.asarray([np.nan if v is None else v for v in c],
                               float)
    tcols = {k: arr(c) for k, c in t.items()}
    ok, said = 1, []
    for c in g:
        gv = arr(g[c])
        hit = [k for k, tv in tcols.items() if len(tv) == len(gv)
               and len(gv) and np.allclose(gv, tv, rtol=rtol, atol=1e-9,
                                           equal_nan=True)]
        if hit:
            said.append("%s=%s" % (c, hit[0]))
        else:
            ok = 0
            said.append("%s matches no serset column (%s; %d saved rows, "
                        "twoway %s)" % (c, " ".join(tcols), len(gv),
                                        sorted({len(v) for v in
                                                tcols.values()})))
    Macro.setGlobal("u28_ok", str(ok))
    Macro.setGlobal("u28_msg", ", ".join(said))
end

* ==== S28 F1g: fpfit and fpfitci refit on the saved page ====
local only : env WP31_ONLY
if inlist("`only'", "", "S28") & `: list posof "S28" in w31_run' {
    display as text "S28 start " c(current_date) " " c(current_time)
    local u28d "`w31_work'/s28"
    capture mkdir "`u28d'"
    capture graph drop _all

    // ------------------------------------------------------------
    // U28-01..05: after a move the saved fpfit or fpfitci is twoway's on
    // the kept rows (the serset: the sample's distinct x, the fit and the
    // stdp limits): fpfit after the dropdown to Foreign; fpfitci,
    // level(90) after the price range to 4500-11385; fpfit
    // [aw=displacement] after the dropdown to Domestic; on nlsw88, fpfit
    // [aw=hours] after the dropdown to union, whose plot grid drops an x
    // whose lowest-wage row has no hours (the point count is twoway's);
    // and fpfitci after the slider to the third-highest price, which
    // keeps three rows: the line through them and no band (df 0).
    // ------------------------------------------------------------
    sysuse auto, clear
    gsort -price
    local p3 = price[3]
    sysuse nlsw88, clear
    local ulab : label (union) 1
    local k 0
    foreach c in "U28-01|auto|(scatter mpg weight) (fpfit mpg weight)|foreign, type(dropdown)|Select|Foreign|fpfit mpg weight if foreign == 1" "U28-02|auto|(fpfitci mpg weight, level(90))|price, type(range)|RangeSlider|4500 11385|fpfitci mpg weight if inrange(price, 4500, 11385), level(90)" "U28-03|auto|fpfit mpg weight [aw=displacement]|foreign, type(dropdown)|Select|Domestic|fpfit mpg weight [aw=displacement] if foreign == 0" "U28-04|nlsw88|fpfit wage ttl_exp [aw=hours]|union, type(dropdown)|Select|`ulab'|fpfit wage ttl_exp [aw=hours] if union == 1" "U28-05|auto|(scatter mpg weight) (fpfitci mpg weight)|price, type(slider)|Slider|`p3'|fpfitci mpg weight if price >= `p3'" {
        local ++k
        mata: u28_t = ustrsplit(st_local("c"), "[|]"); st_local("id", u28_t[1]); st_local("ds", u28_t[2]); st_local("cmd", u28_t[3]); st_local("filt", u28_t[4]); st_local("kind", u28_t[5]); st_local("val", u28_t[6]); st_local("tw", u28_t[7])
        sysuse `ds', clear
        dash clear
        capture noisily dash `cmd', name(zu28`k')
        _w31_expect `id' "(_rc == 0)" "dash `cmd' rc `=_rc'"
        _dash_serve_spec, specpath("`u28d'/s`k'.json") datapath("`u28d'/d`k'.json") filter(`filt')
        python: _u28_move("`u28d'/s`k'.json", "`u28d'/d`k'.json", "`kind'", "`val'", "`u28d'/g`k'.json")
        _u10_ss "`u28d'/t`k'.json" "`u28d'/t`k'.gph" `tw'
        // A serset stores floats: twoway's values are read to 1e-6.
        python: _u28_close("`u28d'/t`k'.json", "`u28d'/g`k'.json", 1e-6)
        _w31_expect `id' "(${u28_ok} == 1)" "dash `cmd', filter(`filt') moved to `val': ${u28_msg}"
        _w31_expect `id' "(${u28_cue} == 0)" "dash `cmd' moved to `val': the layer is marked (unfiltered)"
        if "`id'" == "U28-05" {
            quietly count if price >= `p3'
            _w31_expect `id' "(r(N) == 3)" "price >= `p3' keeps `r(N)' rows"
            _w31_expect `id' "(${u28_n} == 3 & ${u28_band} == 0)" "three kept rows: ${u28_n} line points, ${u28_band} finite limits"
        }
        _w31_done `id' "the saved `cmd' after the move to `val' is twoway `tw' (${u28_n} points, ${u28_band} finite limits; ${u28_msg})"
    }

    forvalues k = 1/5 {
        foreach p in s d g t {
            capture erase "`u28d'/`p'`k'.json"
        }
    }
    capture rmdir "`u28d'"
    macro drop u28_n u28_band u28_cue u28_ok u28_msg
    capture mata: mata drop u28_t
    dash clear
    display as text "S28 end " c(current_date) " " c(current_time)
}
* ==== end S28 ====

// S29 helpers (WP-31 B4c).  _u29_move: the saved page of spec sp/dp
// after one filter move (its own callback run under node,
// test/js_runner.py) beside the page of the qualified spec sq/dq, which
// the Python side draws (contourpy's cut): globals u29_agree (the share of
// a 300 x 300 raster over the kept rows' plane in the same band, or 1 and
// 0 for lines whose counts per level agree or not), u29_area (the largest
// relative band-area difference), u29_cue (1 when a layer is dimmed or a
// stale caption or status shows), u29_same (1 when the source is
// unchanged by the move) and u29_xr (the fill polygons' x range).
python:
def _u29_move(sp, dp, kind, value, sq, dq):
    import json
    import os
    import sys
    import warnings
    import numpy as np
    if os.getcwd() not in sys.path:
        sys.path.insert(0, os.getcwd())
    import dash_render as dr
    import js_runner
    import test_contour_js as tc
    from sfi import Macro

    def page(s, d):
        with warnings.catch_warnings():
            warnings.simplefilter("ignore")
            r = dr.DashRenderer(s, d)
            r.render()
        [cr] = [x for f in r.figures.values() for x in f.renderers
                if type(x).__name__ == "ContourRenderer"]
        return r, cr

    r, cr = page(sp, dp)
    lsrc = cr.line_renderer.data_source
    part = "line" if len(lsrc.data.get("xs", [])) else "fill"
    src = lsrc if part == "line" else cr.fill_renderer.data_source
    # Compared as values: the node harness writes every source it was
    # handed back as plain lists (WP-32), which is no rewrite by the page.
    def _vals(d):
        def one(v):
            if hasattr(v, "tolist"):
                v = v.tolist()
            if isinstance(v, (list, tuple)):
                return [one(x) for x in v]
            if v is None or isinstance(v, (int, float)):
                f = float("nan") if v is None else float(v)
                return "nan" if f != f else repr(f)
            return str(v)
        return json.dumps({k: one(v) for k, v in dict(d).items()},
                          sort_keys=True)
    before = _vals(src.data)
    w = [m for m in r.filter_widgets if type(m).__name__ == kind][0]
    if kind == "Select":
        w.value = [v for v, lab in w.options if lab == value][0]
    else:
        w.value = float(value)
    cb = r.filter_callbacks[r.filter_widgets.index(w)]
    js_runner.JsSession(r.filter_callbacks).run(cb)
    a = dict(src.data)
    _q, qr = page(sq, dq)
    qrend = qr.line_renderer if part == "line" else qr.fill_renderer
    b = dict(qrend.data_source.data)
    agree, area, xr = 1.0, 0.0, ""
    if part == "fill":
        xs = [v for band in b["xs"] for poly in band for ring in poly
              for v in ring]
        ys = [v for band in b["ys"] for poly in band for ring in poly
              for v in ring]
        if len(a["xs"]) != len(b["xs"]):
            agree, area = 0.0, 1.0
        elif xs:
            X, Y = tc._grid(xs, ys)
            agree = float((tc._raster(a["xs"], a["ys"], X, Y)
                           == tc._raster(b["xs"], b["ys"], X, Y)).mean())
            aa = tc._band_areas(a["xs"], a["ys"])
            ab = tc._band_areas(b["xs"], b["ys"])
            area = float(np.max(np.abs(aa - ab)
                                / np.maximum(np.abs(ab), 1e-12 * np.abs(ab).sum())))
        ax = [v for band in a["xs"] for poly in band for ring in poly
              for v in ring]
        if ax:
            xr = "%.10g %.10g" % (min(ax), max(ax))
    else:
        ok = list(a["levels"]) == list(b["levels"])
        for k in range(len(b["xs"])):
            na = np.isfinite(tc._nan(a["xs"][k])).sum()
            nb = np.isfinite(np.asarray(b["xs"][k], float)).sum()
            ok = ok and na == nb
        agree = 1.0 if ok else 0.0
    lay = [x for f in r.figures.values() for x in f.renderers
           if "muted" in x.properties()]
    lay += [cr.fill_renderer, cr.line_renderer]
    cue = [t for f in r.figures.values() for t in f.above
           if "dash_stale_cue" in (getattr(t, "tags", None) or [])]
    st = r.filter_callbacks[0].args.get("stale_status")
    Macro.setGlobal("u29_agree", "%.6f" % agree)
    Macro.setGlobal("u29_area", "%.6g" % area)
    Macro.setGlobal("u29_cue", str(int(any(x.muted for x in lay)
                                       or any(bool(t.visible) for t in cue)
                                       or bool(st is not None and st.visible))))
    Macro.setGlobal("u29_same", str(int(_vals(src.data) == before)))
    Macro.setGlobal("u29_xr", xr)
end

capture program drop _u29_pair
program define _u29_pair
    // _u29_pair <dir> <k> <filter> <if> <plot command>: the spec of the
    // plot under filter() (s<k>/d<k>) and of the plot `if <if>' (q<k>/e<k>).
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    gettoken filt 0 : 0
    gettoken cond 0 : 0
    gettoken cmd opts : 0, parse(",")
    dash clear
    quietly dash `cmd' if `cond' `opts' name(zq`k')
    _dash_serve_spec, specpath("`dir'/q`k'.json") datapath("`dir'/e`k'.json")
    dash clear
    quietly dash `cmd' `opts' name(zs`k')
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json") filter(`filt')
    dash clear
end

* ==== S29 B4c: contour and contourline refit on the saved page ====
local only : env WP31_ONLY
if inlist("`only'", "", "S29") & `: list posof "S29" in w31_run' {
    display as text "S29 start " c(current_date) " " c(current_time)
    local u29d "`w31_work'/s29"
    capture mkdir "`u29d'"
    capture graph drop _all

    // ------------------------------------------------------------
    // U29-1..3, 5: after the dropdown to Foreign the saved page cut at
    // ccuts() draws what the page of `if foreign == 1' draws (the Python side, contourpy's
    // cut of S23's surface, itself pinned to twoway by U26-2): the bands
    // on 99% of a raster and their areas within 1%, or the lines with
    // the same vertex count per level; and no stale mark.
    // ------------------------------------------------------------
    local k 0
    foreach c in "U29-1|contour mpg weight length, ccuts(20 30)" "U29-2|contourline mpg weight length, ccuts(20.5 30.5)" "U29-3|contour mpg weight length, interp(shepard) ccuts(18.5 24.5 30.5)" "U29-3|contour mpg weight length, interp(none) ccuts(18.5 24.5 30.5)" "U29-5|contour mpg weight length, horizontal ccuts(20 30)" {
        local ++k
        mata: u29_t = ustrsplit(st_local("c"), "[|]"); st_local("id", u29_t[1]); st_local("cmd", u29_t[2])
        sysuse auto, clear
        _u29_pair `u29d' `k' "foreign, type(dropdown)" "foreign == 1" `cmd'
        python: _u29_move("`u29d'/s`k'.json", "`u29d'/d`k'.json", "Select", "Foreign", "`u29d'/q`k'.json", "`u29d'/e`k'.json")
        // Flipped (WP-37 TR-13): interp(none) draws twoway__contour_gen's
        // polygons, and after a move that leaves rows out the saved page
        // draws dash's own fit of the kept rows and marks the layer, as
        // the served app does (DECISIONS A-26).  The page of the kept
        // rows now draws Stata's polygons of them, not dash's fit, so the
        // two agree on most of the raster (measured 0.951) and not band
        // for band in area: only the raster is held, at .9.
        local u29_mark = (strpos("`cmd'", "interp(none)") > 0)
        _w31_expect `id' "(${u29_agree} >= cond(`u29_mark', .9, .99))" "`cmd' moved to Foreign: ${u29_agree} of the raster (or the lines) agree"
        if !`u29_mark' _w31_expect `id' "(${u29_area} <= .01)" "`cmd' moved to Foreign: band areas differ by ${u29_area}"
        _w31_expect `id' "(${u29_cue} == `u29_mark')" "`cmd' moved to Foreign: the layer's mark is ${u29_cue}, expected `u29_mark'"
        if "`id'" == "U29-5" {
            quietly summarize weight if foreign == 1
            local wr = strtrim(string(r(min), "%18.10g")) + " " + strtrim(string(r(max), "%18.10g"))
            _w31_expect `id' `"("${u29_xr}" == "`wr'")"' "horizontal: the refit's x range ${u29_xr}; weight's `wr'"
        }
        _w31_done `id' "`cmd' refits on the saved page after the move (agree ${u29_agree}, area ${u29_area})"
    }

    // ------------------------------------------------------------
    // U29-4: 1,001 distinct points: the saved page keeps the build after
    // the move and marks it (decision D4).
    // ------------------------------------------------------------
    clear
    quietly set obs 1001
    set seed 29
    quietly generate double x = runiform()
    quietly generate double y = runiform()
    quietly generate double z = rnormal()
    quietly generate byte g = runiform() < .5
    label define u29g 0 "Off" 1 "On"
    label values g u29g
    local ++k
    _u29_pair `u29d' `k' "g, type(dropdown)" "g == 1" contour z y x,
    python: _u29_move("`u29d'/s`k'.json", "`u29d'/d`k'.json", "Select", "On", "`u29d'/q`k'.json", "`u29d'/e`k'.json")
    _w31_expect U29-4 "(${u29_same} == 1)" "1,001 points: the move rewrote the source"
    _w31_expect U29-4 "(${u29_cue} == 1)" "1,001 points: the layer is not marked after the move"
    _w31_done U29-4 "above the cap the saved page keeps the contour as built and marks it"

    // ------------------------------------------------------------
    // U29-8: a %td z is cut in days, as twoway cuts it (measured
    // live: the contour view's ccuts and its z axis's ticks), in both
    // modes; the key is written in %8.0gc, not %td.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly generate double zd = td(01jan2000) + 3*price
    format zd %td
    _u26_tw contour zd mpg weight,
    local ++k
    _u26_reg `u29d' `k' contour zd mpg weight, name(zu298)
    foreach m in s v {
        _w31_expect U29-8 `"("${u26_cut`m'}" == "${u26_twcut}")"' "`m': cuts ${u26_cut`m'}; twoway's ${u26_twcut}"
        _w31_expect U29-8 `"("${u26_tick`m'}" == "${u26_twtick}")"' "`m': key ticks ${u26_tick`m'}; twoway's ${u26_twtick}"
    }
    _w31_done U29-8 "a %td z is cut at twoway's ${u26_twcut} and keyed at ${u26_twtick}"

    forvalues i = 1/`k' {
        foreach p in s d q e a {
            capture erase "`u29d'/`p'`i'.json"
            capture erase "`u29d'/`p'`i'.py"
        }
    }
    capture rmdir "`u29d'"
    capture label drop u29g
    macro drop u29_agree u29_area u29_cue u29_same u29_xr
    capture macro drop u26_*
    capture mata: mata drop u29_t
    dash clear
    clear
    display as text "S29 end " c(current_date) " " c(current_time)
}
* ==== end S29 ====

// S29 B4d helper.  _u29_key: the saved page of spec sp/dp after one
// filter move (its own callback run under node): globals u29_kcut (the
// colour key's inner levels, "%.10g" each), u29_ktick (its ticks), u29_kn
// (its level count) and u29_kband (the drawn band count).
python:
def _u29_key(sp, dp, kind, value):
    import os
    import sys
    import warnings
    if os.getcwd() not in sys.path:
        sys.path.insert(0, os.getcwd())
    import dash_render as dr
    import js_runner
    from sfi import Macro
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
    w = [m for m in r.filter_widgets if type(m).__name__ == kind][0]
    w.value = [v for v, lab in w.options if lab == value][0]
    cb = r.filter_callbacks[r.filter_widgets.index(w)]
    js_runner.JsSession(r.filter_callbacks).run(cb)
    f = list(r.figures.values())[0]
    # Flipped (WP-42 CV-3): the key was a ContourColorBar (its levels, its
    # ticker's ticks and its fill renderer's bands); it is the figure's key
    # cell, updated in place by the move: its levels are its swatches'
    # band edges along the z axis, its ticks its z axis's, its bands its
    # swatches (colour_bins.KeyView).
    import colour_bins
    cell = f._dash_key_cell
    kv = colour_bins.KeyView(cell)
    Macro.setGlobal("u29_kcut", " ".join(format(float(v), ".10g")
                                         for v in kv.levels[1:-1]))
    Macro.setGlobal("u29_ktick", " ".join(
        format(float(v), ".10g") for v in cell._dash_key_axis.ticker.ticks))
    Macro.setGlobal("u29_kn", str(len(kv.levels)))
    Macro.setGlobal("u29_kband", str(len(kv.colours)))
end

* ==== S29 B4d: the contour's cuts and colour key after a filter move ====
local only : env WP31_ONLY
if inlist("`only'", "", "S29") & `: list posof "S29" in w31_run' {
    display as text "S29 start " c(current_date) " " c(current_time)
    local u29d "`w31_work'/s29k"
    capture mkdir "`u29d'"
    capture graph drop _all

    // ------------------------------------------------------------
    // U29-6, U29-7: after the dropdown to Foreign the saved page's colour
    // key holds twoway's cuts for `if foreign == 1' (measured live: the
    // drawn contour view's ccuts) -- zlabel(#5)'s by default, levels(4)'s
    // -- as many levels as bands plus one, and twoway's z-axis ticks
    // inside the span it was built with.
    // ------------------------------------------------------------
    local k 0
    foreach c in "U29-6|contour price mpg weight," "U29-7|contour price mpg weight, levels(4)" {
        local ++k
        mata: u29_t = ustrsplit(st_local("c"), "[|]"); st_local("id", u29_t[1]); st_local("cmd", u29_t[2])
        sysuse auto, clear
        local u29v = subinstr("`cmd'", ",", " if foreign == 1,", 1)
        _u26_tw `u29v'
        dash clear
        quietly dash `cmd' name(zk`k')
        _dash_serve_spec, specpath("`u29d'/s`k'.json") datapath("`u29d'/d`k'.json") filter(foreign, type(dropdown))
        dash clear
        python: _u29_key("`u29d'/s`k'.json", "`u29d'/d`k'.json", "Select", "Foreign")
        _w31_expect `id' `"("${u29_kcut}" == "${u26_twcut}")"' "`cmd' moved to Foreign: key cuts ${u29_kcut}; twoway `u29v' cuts ${u26_twcut}"
        _w31_expect `id' "(${u29_kn} == ${u29_kband} + 1)" "`cmd' moved to Foreign: ${u29_kn} key levels for ${u29_kband} bands"
        local bad 0
        local twt ${u26_twtick}
        foreach t of global u29_ktick {
            if !`: list t in twt' local bad 1
        }
        _w31_expect `id' `"(`bad' == 0 & "${u29_ktick}" != "")"' "`cmd' moved to Foreign: key ticks ${u29_ktick}; twoway's ${u26_twtick}"
        _w31_done `id' "`cmd' moved to Foreign keys twoway's cuts ${u26_twcut} (ticks ${u29_ktick})"
    }

    forvalues i = 1/`k' {
        foreach p in s d {
            capture erase "`u29d'/`p'`i'.json"
        }
    }
    capture rmdir "`u29d'"
    macro drop u29_kcut u29_ktick u29_kn u29_kband u26_twcut u26_twrgb u26_twtick
    capture mata: mata drop u29_t
    dash clear
    clear
    display as text "S29 end " c(current_date) " " c(current_time)
}
* ==== end S29 ====

// S30 helpers (WP-31 D3).  _u30_check reads twoway's SVG and dash's saved
// and served figures of one case and writes one comparable line each:
// globals u30_tw, u30_s and u30_v.  Cases: "clock" (each box's side, a
// side twoway draws beside the plot read as dash's nearer horizontal side,
// _dash_textbox_place), "inside" (the third of the plot region a ring(0)
// box is in), "box" (fill and line colour), "size" (the note's size in
// points), "order" (the boxes above the plot from the plot out), "by" (how
// many N the graph draws).
python:
def _u30_svg(path):
    import re
    with open(path, encoding="utf-8") as fh:
        src = fh.read()
    texts = []
    for attrs, body in re.findall(r"<text\b([^>]*)>([^<]*)</text>", src):
        body = body.strip()
        if not body or re.fullmatch(r"[-0-9.,]+", body):
            continue
        a = dict(re.findall(r'([a-z-]+)="([^"]*)"', attrs))
        fs = re.search(r"font-size:([0-9.]+)px", a.get("style", ""))
        texts.append((body, float(a["x"]), float(a["y"]),
                      float(fs.group(1)) if fs else 0.0))
    rects = []
    for attrs in re.findall(r"<rect\b([^>]*)/?>", src):
        a = dict(re.findall(r'([a-z-]+)="([^"]*)"', attrs))
        rects.append((float(a.get("x", 0)), float(a.get("y", 0)),
                      float(a.get("width", 0)), float(a.get("height", 0)),
                      a.get("style", "")))
    plot = next(r for r in rects if r[4].startswith("fill:#FFFFFF"))
    return texts, rects, plot


def _u30_third(v, lo, hi):
    f = (v - lo) / (hi - lo)
    return 0 if f < 1 / 3 else (1 if f < 2 / 3 else 2)


def _u30_tw(path, case):
    import dash_render as dr
    texts, rects, (px, py, pw, ph, _s) = _u30_svg(path)
    if case == "clock":
        t = [e for e in texts if e[0] == "T"][0]
        clock = int(path.rsplit("_", 1)[1].split(".")[0])
        if t[2] < py:
            side = "above"
        elif t[2] > py + ph:
            side = "below"
        else:
            side = dr._dash_textbox_place(clock, "center")[0]
        return "%d:%s" % (clock, side)
    if case == "inside":
        t = [e for e in texts if e[0] == "N"][0]
        h = ("left", "center", "right")[_u30_third(t[1], px, px + pw)]
        v = ("top", "center", "bottom")[_u30_third(t[2], py, py + ph)]
        return "%s %s" % (h, v)
    if case == "box":
        fill = [r for r in rects if r[4].startswith("fill:#E0E0E0")]
        line = [r for r in rects if "stroke:#FF0000" in r[4]]
        return "fill %s line %s" % ("#e0e0e0" if fill else "-",
                                    "#ff0000" if line else "-")
    if case == "size":
        t = [e for e in texts if e[0] == "N"][0]
        return "%gpt" % round(t[3] / 10.0)
    if case == "order":
        above = sorted([e for e in texts if e[2] < py
                        and e[0] in ("T", "S", "N", "T1", "T2")],
                       key=lambda e: -e[2])
        return " ".join(e[0] for e in above)
    if case == "by":
        return "N:%d" % sum(1 for e in texts if e[0] == "N")
    if case == "at":
        t = [e for e in texts if e[0] not in ("Mileage (mpg)",
                                              "Weight (lbs.)")]
        return "%s %gpt" % (t[0][0], round(t[0][3] / 10.0)) if t else "-"
    if case == "edge":
        t = [e for e in texts if e[0] == "E"][0]
        clock = int(path.rsplit("_e", 1)[1].split(".")[0])
        if t[2] < py:
            return "above"
        if t[2] > py + ph:
            return "below"
        return dr._dash_textbox_place(clock, "center")[0]
    if case == "eorder":
        y = {e[0]: e[2] for e in texts}
        return "E outside T" if y["E"] < y["T"] else "E inside T"
    return "?"


def _u30_dash(figs, case):
    from bokeh.models import Label, Title
    f = figs[0]

    def boxes(fig):
        out = []
        for side in ("center", "above", "below"):
            for m in getattr(fig, side):
                if "dash_textbox" in list(getattr(m, "tags", None) or []):
                    out.append((side, m))
        return out
    if case == "clock":
        side, m = [b for b in boxes(f) if b[1].text == "T"][0]
        return side
    if case == "inside":
        side, m = [b for b in boxes(f) if b[1].text == "N"][0]
        if not isinstance(m, Label):
            return "not a Label"
        return "%s %s" % (m.x.symbol, m.y.symbol)
    if case == "box":
        side, m = [b for b in boxes(f) if b[1].text == "C"][0]
        return "fill %s line %s" % (str(m.background_fill_color).lower(),
                                    str(m.border_line_color).lower())
    if case == "size":
        side, m = [b for b in boxes(f) if b[1].text == "N"][0]
        return str(m.text_font_size)
    if case == "order":
        out = []
        for m in f.above:
            if isinstance(m, Title) and m.text in ("T", "S", "N", "T1", "T2"):
                out.append(m.text)
        if f.title is not None and f.title.text == "T":
            out.append("T")
        return " ".join(out)
    if case == "by":
        return "N:%d" % sum(1 for g in figs for side, m in boxes(g)
                            if m.text == "N")
    if case in ("edge", "eorder"):
        where = {}
        for side in ("center", "above", "below", "left", "right"):
            for i, m in enumerate(getattr(f, side)):
                tg = list(getattr(m, "tags", None) or [])
                if (getattr(m, "text", None) == "E"
                        and "dash_edge_title" in tg):
                    where["E"] = (side, i)
                if getattr(m, "text", None) == "T" and "title" in tg:
                    where["T"] = (side, i)
        if case == "edge":
            return where.get("E", ("-",))[0]
        if ("E" not in where or "T" not in where
                or where["E"][0] != where["T"][0]):
            return "not on one side: %s" % where
        return ("E outside T" if where["E"][1] > where["T"][1]
                else "E inside T")
    if case == "at":
        labs = [m for m in f.center if isinstance(m, Label)
                and "dash_added_text" in list(m.tags or [])]
        # The canvas-text pass keeps "$$" from reading as TeX with a
        # word joiner (U+2060) between the two; the text drawn is "$$".
        return ("%s %s" % (labs[0].text.replace("\u2060", ""),
                           labs[0].text_font_size) if labs else "-")
    return "?"


def _u30_check(sp, dp, app, svg, case, clock=""):
    import __main__ as m
    from sfi import Macro
    a, b = m._u03_docs(sp, dp, app)
    tw = _u30_tw(svg, case)
    if case == "clock":
        Macro.setGlobal("u30_tw", tw)
        for figs, sfx in ((a, "s"), (b, "v")):
            Macro.setGlobal("u30_" + sfx, tw.split(":")[0] + ":"
                            + _u30_dash(figs, case))
        return
    Macro.setGlobal("u30_tw", tw)
    for figs, sfx in ((a, "s"), (b, "v")):
        Macro.setGlobal("u30_" + sfx, _u30_dash(figs, case))
end

capture program drop _u30_reg
program define _u30_reg
    // _u30_reg <dir> <k> <case> <command with options...>
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    gettoken case 0 : 0
    quietly twoway `macval(0)' name(u30t, replace)
    quietly graph export "`dir'/t_`k'.svg", replace
    graph drop u30t
    dash clear
    capture quietly dash `macval(0)' name(zu30`k')
    if _rc {
        global u30_s "rc `=_rc'"
        global u30_v "rc `=_rc'"
        global u30_tw "(twoway drawn)"
        exit
    }
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u30_m; _u30_m._u30_check("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py", "`dir'/t_`k'.svg", "`case'")
end

* ==== S30 D3: Textbox placement ====
local only : env WP31_ONLY
if inlist("`only'", "", "S30") & `: list posof "S30" in w31_run' {
    display as text "S30 start " c(current_date) " " c(current_time)
    local u30d "`w31_work'/s30"
    capture mkdir "`u30d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear

    // U30-1: title(, position(k)) on twoway's side; beside the plot is
    // dash's nearer horizontal side (the documented difference).
    foreach k in 3 6 9 12 {
        _u30_reg "`u30d'" `k' clock scatter mpg weight, title("T", position(`k'))
        foreach m in s v {
            _w31_expect U30-1 `"("${u30_`m'}" == "${u30_tw}")"' "`m' clock `k': dash ${u30_`m'}; twoway ${u30_tw}"
        }
    }
    _w31_done U30-1 "position(3 6 9 12) on twoway's sides, saved and served"

    // U30-2: ring(0) position(k): inside the plot region at the clock's
    // compass point.
    foreach k in 1 3 6 9 12 {
        _u30_reg "`u30d'" 2`k' inside scatter mpg weight, note("N", ring(0) position(`k'))
        foreach m in s v {
            _w31_expect U30-2 `"("${u30_`m'}" == "${u30_tw}")"' "`m' ring(0) position(`k'): dash ${u30_`m'}; twoway ${u30_tw}"
        }
    }
    _w31_done U30-2 "ring(0) boxes at their compass points, saved and served"

    // U30-3: box bcolor() lcolor(): the frame's fill and line.
    _u30_reg "`u30d'" 3 box scatter mpg weight, caption("C", box bcolor(gs14) lcolor(red) lwidth(thick) margin(medium))
    foreach m in s v {
        _w31_expect U30-3 `"("${u30_`m'}" == "${u30_tw}")"' "`m': dash ${u30_`m'}; twoway ${u30_tw}"
    }
    _w31_done U30-3 "the box ${u30_tw}, saved and served"

    // U30-4: tstyle(heading): the heading's size.
    _u30_reg "`u30d'" 4 size scatter mpg weight, note("N", tstyle(heading))
    foreach m in s v {
        _w31_expect U30-4 `"("${u30_`m'}" == "${u30_tw}")"' "`m': dash ${u30_`m'}; twoway ${u30_tw}"
    }
    _w31_done U30-4 "tstyle(heading) draws ${u30_tw}, saved and served"

    // U30-5: rings above the plot, from the plot out: the edge titles,
    // a ring(2) subtitle, the note at 12 (ring 4), the title (ring 7).
    _u30_reg "`u30d'" 5 order scatter mpg weight, title("T") subtitle("S", ring(2)) t1title("T1") note("N", position(12))
    foreach m in s v {
        _w31_expect U30-5 `"("${u30_`m'}" == "${u30_tw}")"' "`m': dash ${u30_`m'}; twoway ${u30_tw}"
    }
    _w31_done U30-5 "ring order ${u30_tw}, saved and served"

    // U30-6: by(): a ring(0) note on every panel, once each.
    _u30_reg "`u30d'" 6 by scatter mpg weight, by(foreign) note("N", ring(0) position(1))
    foreach m in s v {
        _w31_expect U30-6 `"("${u30_`m'}" == "${u30_tw}")"' "`m': dash ${u30_`m'}; twoway ${u30_tw}"
    }
    _w31_done U30-6 "by(): ${u30_tw}, saved and served"

    macro drop u30_tw u30_s u30_v
    capture graph drop _all
    dash clear
    display as text "S30 end " c(current_date) " " c(current_time)
}
* ==== end S30 ====

* ==== S30 D13: Added text style and globals ====
local only : env WP31_ONLY
if inlist("`only'", "", "S30") & `: list posof "S30" in w31_run' {
    display as text "S30 start " c(current_date) " " c(current_time)
    local u30d "`w31_work'/s30b"
    capture mkdir "`u30d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear

    // U30-9: text(, tstyle(heading)) in the heading's size.
    _u30_reg "`u30d'" 9 at scatter mpg weight, text(30 2000 "P", tstyle(heading))
    foreach m in s v {
        _w31_expect U30-9 `"("${u30_`m'}" == "${u30_tw}")"' "`m': dash ${u30_`m'}; twoway ${u30_tw}"
    }
    _w31_done U30-9 "tstyle(heading) on text(): ${u30_tw}, saved and served"

    // U30-10, U30-11: a line naming a global, the $ kept for the command
    // (macval), drawn as twoway draws it: $u30x, then $$u30f$$ and
    // ${u30x}!.  Each command is built by value.
    global u30x "hello"
    global u30f "F"
    local u30q = char(34)
    local u30s = char(36)
    foreach c in 10 11a 11b {
        if "`c'" == "10" local u30l "`u30s'u30x"
        if "`c'" == "11a" local u30l "`u30s'`u30s'u30f`u30s'`u30s'"
        if "`c'" == "11b" local u30l "`u30s'{u30x}!"
        mata: st_local("u30c", "scatter mpg weight, text(30 2000 " + st_local("u30q") + st_local("u30l") + st_local("u30q") + ")")
        _u30_reg "`u30d'" `c' at `macval(u30c)'
        local u30id = cond("`c'" == "10", "U30-10", "U30-11")
        foreach m in s v {
            _w31_expect `u30id' `"(`"${u30_`m'}"' == `"${u30_tw}"')"' "`m' `c': dash ${u30_`m'}; twoway ${u30_tw}"
        }
        if "`c'" == "10" {
            _w31_done U30-10 "a global in a text() line drawn as twoway draws it, saved and served"
        }
        if "`c'" == "11b" {
            _w31_done U30-11 "nested globals and braces in a text() line drawn as twoway draws them, saved and served"
        }
    }
    macro drop u30x u30f u30_tw u30_s u30_v
    capture graph drop _all
    dash clear
    display as text "S30 end " c(current_date) " " c(current_time)
}
* ==== end S30 ====

* ==== S30 D2b: Edge titles' position() and ring() ====
local only : env WP31_ONLY
if inlist("`only'", "", "S30") & `: list posof "S30" in w31_run' {
    display as text "S30 start " c(current_date) " " c(current_time)
    local u30d "`w31_work'/s30c"
    capture mkdir "`u30d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear

    // U30-12: position() moves an edge title to the clock's side; beside
    // the plot is dash's nearer horizontal side, as for title().
    foreach c in "t1title 6" "t1title 3" "l1title 12" "b1title 11" {
        gettoken key k : c
        local k = strtrim("`k'")
        _u30_reg "`u30d'" e`k' edge scatter mpg weight, `key'("E", position(`k'))
        foreach m in s v {
            _w31_expect U30-12 `"("${u30_`m'}" == "${u30_tw}")"' "`m' `key' position(`k'): dash ${u30_`m'}; twoway ${u30_tw}"
        }
    }
    _w31_done U30-12 "edge titles at their position() on twoway's sides, saved and served"

    // U30-13: ring(8) puts t1title outside the title (ring 7).
    _u30_reg "`u30d'" r8 eorder scatter mpg weight, title("T") t1title("E", ring(8))
    foreach m in s v {
        _w31_expect U30-13 `"("${u30_`m'}" == "${u30_tw}")"' "`m': dash ${u30_`m'}; twoway ${u30_tw}"
    }
    _w31_done U30-13 "t1title ring(8): ${u30_tw}, saved and served"

    macro drop u30_tw u30_s u30_v
    capture graph drop _all
    dash clear
    display as text "S30 end " c(current_date) " " c(current_time)
}
* ==== end S30 ====

// S31 (WP-31 D4, C13) helpers: draw one command in twoway (class values
// and SVG export) and in dash (both modes), and describe one legend fact
// for one case into globals u31_tw (twoway), u31_s (saved) and u31_v
// (served).  Sizes are whole pixels at dash's 4-inch reference: one Stata
// relative unit is 2.88 pt, 3.84 px, and 28.8 SVG px in twoway's export.
python:
_U31_LOC = {
    ("above", "right"): "top_right", ("above", "left"): "top_left",
    ("above", "center"): "center", ("below", "right"): "bottom_right",
    ("below", "left"): "bottom_left", ("below", "center"): "center",
    ("right", "top"): "top_right", ("right", "bottom"): "bottom_right",
    ("right", "center"): "center", ("left", "top"): "top_left",
    ("left", "bottom"): "bottom_left", ("left", "center"): "center"}
_U31_INSIDE = {"north": "top_center", "neast": "top_right",
               "east": "center_right", "seast": "bottom_right",
               "south": "bottom_center", "swest": "bottom_left",
               "west": "center_left", "nwest": "top_left",
               "center": "center"}


def _u31_px(units):
    return str(int(round(float(units) * 2.88 * 4.0 / 3.0)))


def _u31_svg(path):
    """(plot region, legend box, [(text, x, y)], [(x1, x2)] key lines)."""
    from svg_truth import svg_document, svg_rects
    doc = svg_document(path)
    pr = doc["plotregion"]
    keys = [(t["text"], t["x"], t["y"]) for t in doc["texts"]
            if not t["anchor"]]
    box = None
    for r in svg_rects(path):
        if r["fill"] in (None, "none") or not r["w"] or r["w"] > 3900:
            continue
        if abs(r["x"] - pr["left"]) < 1 and abs(r["y"] - pr["top"]) < 1:
            continue
        if keys and all(r["x"] <= x <= r["x"] + r["w"]
                        and r["y"] <= y <= r["y"] + r["h"]
                        for _t, x, y in keys):
            if box is None or r["w"] * r["h"] < box["w"] * box["h"]:
                box = r
    outline = None
    if box is not None:
        for r in svg_rects(path):
            if (r["fill"] == "none" and r["x"] is not None
                    and box["x"] <= r["x"] <= box["x"] + 40
                    and box["y"] <= r["y"] <= box["y"] + 40):
                outline = r
                break
    lines = []
    if box is not None:
        lines = [(d["x1"], d["x2"]) for d in doc["hlines"]
                 if box["x"] <= d["x1"] <= box["x"] + box["w"]
                 and box["y"] <= d["y1"] <= box["y"] + box["h"]]
    return pr, box, outline, keys, lines


def _u31_place_tw(path, align):
    pr, box, _o, _k, _l = _u31_svg(path)
    cx = ((box["x"] + box["w"] / 2) - pr["left"]) / (pr["right"] - pr["left"])
    cy = ((box["y"] + box["h"] / 2) - pr["top"]) / (pr["bottom"] - pr["top"])
    if 0 < cx < 1 and 0 < cy < 1:
        return "center:" + _U31_INSIDE.get(align, align)
    side = ("above" if cy < 0 else "below" if cy > 1
            else "left" if cx < 0 else "right")
    if side in ("above", "below"):
        right = box["x"] + box["w"] > pr["right"] - 60
        left = box["x"] < pr["left"] + 60
        end = ("right" if right and not left else
               "left" if left and not right else "center")
    else:
        rel = (box["y"] + box["h"] / 2 - pr["top"]) / (pr["bottom"] - pr["top"])
        end = "top" if rel < 0.25 else "bottom" if rel > 0.75 else "center"
    return side + ":" + _U31_LOC[(side, end)]


def _u31_grid_tw(path):
    _pr, _b, _o, keys, _l = _u31_svg(path)
    xs = sorted({round(x) for _t, x, _y in keys})
    ys = sorted({round(y) for _t, _x, y in keys})
    return " ".join("%s:r%dc%d" % (t.replace(" ", "_"), ys.index(round(y)) + 1,
                                   xs.index(round(x)) + 1)
                    for t, x, y in sorted(keys, key=lambda k: (k[2], k[1])))


def _u31_legend(figs):
    from bokeh.models import Legend
    import dash_render as dr
    lgs = [m for f in figs for m in f.select({"type": Legend})
           if str(m.name or "") != dr._COLORVAR_LEGEND_NAME]
    return figs[0], lgs[0]


def _u31_text(it):
    lab = it.label
    return str(lab.get("value") if isinstance(lab, dict)
               else getattr(lab, "value", lab))


def _u31_dash(figs, case):
    f, lg = _u31_legend(figs)
    if case == "geom":
        return "%d %d %d %d" % (lg.glyph_width, lg.glyph_height,
                                lg.label_standoff, lg.spacing)
    if case == "sizes":
        return "%d %d %d" % (lg.glyph_width, lg.label_standoff, lg.spacing)
    if case in ("place", "hplace"):
        for side in ("above", "below", "left", "right", "center"):
            if lg in list(getattr(f, side)):
                loc = str(lg.location)
                if case == "hplace":
                    loc = ("left" if "left" in loc else
                           "right" if "right" in loc else "center")
                return side + ":" + loc
        return "none"
    if case == "grid":
        nc, nr = int(lg.ncols), int(lg.nrows)
        out = []
        for i, it in enumerate(lg.items):
            if lg.orientation == "vertical":
                r, c = i % nr, i // nr
            else:
                r, c = i // nc, i % nc
            if _u31_text(it):
                out.append((r, c, _u31_text(it)))
        rows = sorted({r for r, _c, _t in out})
        cols = sorted({c for _r, c, _t in out})
        return " ".join("%s:r%dc%d" % (t.replace(" ", "_"), rows.index(r) + 1,
                                       cols.index(c) + 1)
                        for r, c, t in sorted(out))
    if case == "texts":
        return "%s | keys %d" % (
            " ".join(_u31_text(i) for i in lg.items if _u31_text(i)),
            sum(1 for i in lg.items if i.renderers))
    if case == "box":
        return "%s %s" % (lg.border_line_color, lg.background_fill_color)
    if case == "title":
        return str(lg.title)
    if case == "drawn":
        return "drawn %d keys %d" % (int(bool(lg.visible)), len(lg.items))
    return "?"


def _u31_check(sp, dp, app, svg, case, tw):
    import __main__ as m
    from sfi import Macro
    a, b = m._u03_docs(sp, dp, app)
    if case == "place":
        tw = _u31_place_tw(svg, tw)
    elif case == "hplace":
        side, loc = _u31_place_tw(svg, tw).split(":")
        tw = side + ":" + ("left" if "left" in loc else
                           "right" if "right" in loc else "center")
    elif case == "grid":
        tw = _u31_grid_tw(svg)
    elif case == "texts":
        _pr, _b, _o, keys, _l = _u31_svg(svg)
        tw = "%s | keys %s" % (" ".join(t for t, _x, _y in keys), tw)
    elif case == "box":
        _pr, box, outline, _k, _l = _u31_svg(svg)
        tw = "%s %s" % (outline["stroke"], box["fill"])
    elif case == "sizes":
        _pr, _b, _o, keys, lines = _u31_svg(svg)
        x1, x2 = lines[0]
        gap = min(x for _t, x, _y in keys) - max(x1, x2)
        tw = "%s %s %s" % (_u31_px(abs(x2 - x1) / 28.8), _u31_px(gap / 28.8),
                           tw)
    Macro.setGlobal("u31_tw", tw)
    for figs, sfx in ((a, "s"), (b, "v")):
        Macro.setGlobal("u31_" + sfx, _u31_dash(figs, case))
end

capture program drop _u31_reg
program define _u31_reg
    // _u31_reg <dir> <k> <case> <command with options...>: twoway's
    // value for <case> goes to u31_tw (class values here, the SVG in
    // _u31_check), dash's saved and served values to u31_s and u31_v.
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    gettoken case 0 : 0
    capture graph drop u31t
    quietly twoway `0' name(u31t, replace)
    quietly graph export "`dir'/t`k'.svg", replace
    local tw ""
    if "`case'" == "geom" {
        foreach s in key_xsize key_ysize key_gap row_gap {
            mata: st_local("v", strofreal(round(`.u31t.legend.style.`s'.val' * 2.88 * 4 / 3)))
            local tw "`tw' `v'"
        }
        local tw = strtrim("`tw'")
    }
    if "`case'" == "sizes" {
        mata: st_local("tw", strofreal(round(`.u31t.legend.style.row_gap.val' * 2.88 * 4 / 3)))
    }
    if inlist("`case'", "place", "hplace") local tw "`.u31t.legend.style.box_alignment.snm'"
    if "`case'" == "texts" local tw "`.u31t.legend.keys.arrnels'"
    if "`case'" == "title" local tw "`.u31t.legend.title.text[1]'"
    if "`case'" == "drawn" local tw "drawn `.u31t.legend.draw_view.istrue' keys `.u31t.legend.keys.arrnels'"
    graph drop u31t
    dash clear
    capture quietly dash `0' name(zu31`k')
    if _rc {
        global u31_s "rc `=_rc'"
        global u31_v "rc `=_rc'"
        global u31_tw "(twoway drawn)"
        exit
    }
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u31_m; _u31_m._u31_check("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py", "`dir'/t`k'.svg", "`case'", "`tw'")
end

* ==== S31 D4: Legend geometry ====
local only : env WP31_ONLY
if inlist("`only'", "", "S31") & `: list posof "S31" in w31_run' {
    display as text "S31 start " c(current_date) " " c(current_time)
    local u31d "`w31_work'/s31"
    capture mkdir "`u31d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear
    sort weight
    generate double trunk100 = trunk * 100
    generate double turn100 = turn * 100
    local u31two "(scatter mpg weight) (scatter price weight),"
    local u31four "(scatter mpg weight) (scatter price weight) (scatter trunk100 weight) (scatter turn100 weight),"

    // U31-1: the scheme's key geometry -- key_xsize, key_ysize, key_gap
    // and row_gap -- as dash's glyph_width, glyph_height, label_standoff
    // and spacing.  Flipped (WP-31 D4b): one column, since a one-row
    // legend's keys are spaced by colgap(), not the row gap (measured,
    // legend_remainder_truth.json colgap_*).
    _u31_reg "`u31d'" 1 geom (line mpg weight) (line price weight), legend(cols(1))
    foreach m in s v {
        _w31_expect U31-1 `"("${u31_`m'}" == "${u31_tw}")"' "`m': dash ${u31_`m'}; twoway ${u31_tw}"
    }
    _w31_done U31-1 "key width, height, gap and row gap ${u31_tw} px, saved and served"

    // U31-2: every clock's side and place along it, pos(0) the centre,
    // ring(0) alone inside at the scheme's clock.
    local bad ""
    forvalues c = 0/12 {
        _u31_reg "`u31d'" 2`c' place `u31two' legend(pos(`c'))
        foreach m in s v {
            if "${u31_`m'}" != "${u31_tw}" local bad "`bad' pos(`c') `m': dash ${u31_`m'} twoway ${u31_tw};"
        }
    }
    _u31_reg "`u31d'" 2r place `u31two' legend(ring(0))
    foreach m in s v {
        if "${u31_`m'}" != "${u31_tw}" local bad "`bad' ring(0) `m': dash ${u31_`m'} twoway ${u31_tw};"
    }
    _w31_expect U31-2 `"(`"`bad'"' == "")"' "`bad'"
    _w31_done U31-2 "pos(0) to pos(12) and ring(0): twoway's side and place, saved and served"

    // U31-3: pos(3) keeps s2color's two columns.
    _u31_reg "`u31d'" 3 grid `u31two' legend(pos(3))
    foreach m in s v {
        _w31_expect U31-3 `"("${u31_`m'}" == "${u31_tw}")"' "`m': dash ${u31_`m'}; twoway ${u31_tw}"
    }
    _w31_done U31-3 "pos(3) keys at ${u31_tw}"

    // U31-4: holes(2) cols(2), colfirst cols(2), rows(3) and cols(3).
    local bad ""
    local j 0
    foreach o in "holes(2) cols(2)" "colfirst cols(2)" "rows(3)" "cols(3)" {
        local ++j
        local cmd `"`u31four'"'
        if `j' == 1 local cmd "(scatter mpg weight) (scatter price weight) (scatter trunk100 weight),"
        _u31_reg "`u31d'" 4`j' grid `cmd' legend(`o')
        foreach m in s v {
            if "${u31_`m'}" != "${u31_tw}" local bad "`bad' `o' `m': dash ${u31_`m'} twoway ${u31_tw};"
        }
    }
    _w31_expect U31-4 `"(`"`bad'"' == "")"' "`bad'"
    _w31_done U31-4 "holes(), colfirst, rows() and cols() lay the keys out as twoway's grid"

    // U31-5: label(1) with no text: rc 0 both, key 1's symbol kept with
    // no text.
    _u31_reg "`u31d'" 5 texts `u31two' legend(label(1))
    foreach m in s v {
        _w31_expect U31-5 `"("${u31_`m'}" == "${u31_tw}")"' "`m': dash ${u31_`m'}; twoway ${u31_tw}"
    }
    _w31_done U31-5 "label(1) blanks key 1: ${u31_tw}"

    // U31-7: region(lcolor() fcolor()) and the sizes.
    _u31_reg "`u31d'" 7 box `u31two' legend(region(lcolor(red) fcolor(gs14) lwidth(thick)))
    foreach m in s v {
        _w31_expect U31-7 `"("${u31_`m'}" == "${u31_tw}")"' "`m' region: dash ${u31_`m'}; twoway ${u31_tw}"
    }
    _u31_reg "`u31d'" 7s sizes (line mpg weight) (line price weight), legend(cols(1) symxsize(5) keygap(1) rowgap(3))
    foreach m in s v {
        _w31_expect U31-7 `"("${u31_`m'}" == "${u31_tw}")"' "`m' sizes: dash ${u31_`m'}; twoway ${u31_tw}"
    }
    _w31_done U31-7 "region() outline and fill, symxsize(), keygap() and rowgap() as twoway's"

    // U31-8: bplacement(w) at 6 o'clock, and title().
    _u31_reg "`u31d'" 8 hplace `u31two' legend(pos(6) bplacement(w))
    foreach m in s v {
        _w31_expect U31-8 `"("${u31_`m'}" == "${u31_tw}")"' "`m' bplacement: dash ${u31_`m'}; twoway ${u31_tw}"
    }
    _u31_reg "`u31d'" 8t title `u31two' legend(title("Keys"))
    foreach m in s v {
        _w31_expect U31-8 `"("${u31_`m'}" == "${u31_tw}")"' "`m' title: dash ${u31_`m'}; twoway ${u31_tw}"
    }
    _w31_done U31-8 "bplacement(w) at the left end below; title() above the keys"

    macro drop u31_tw u31_s u31_v
    capture graph drop _all
    dash clear
    display as text "S31 end " c(current_date) " " c(current_time)
}
* ==== end S31 ====

* ==== S31 C13: Histogram-only legend ====
local only : env WP31_ONLY
if inlist("`only'", "", "S31") & `: list posof "S31" in w31_run' {
    display as text "S31 start " c(current_date) " " c(current_time)
    local u31d "`w31_work'/s31c"
    capture mkdir "`u31d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear

    // U31-6: plots that look the same, none given a style option, are
    // one key (and one key draws no legend); a style option, even one
    // equal to the default, keeps two; CI bands of two fits are one key.
    local bad ""
    local j 0
    foreach c in "(scatter mpg weight, pstyle(p1)) (scatter mpg weight, pstyle(p1))," ///
        "(scatter mpg weight, pstyle(p1)) (scatter mpg weight, pstyle(p1) mcolor(red))," ///
        "(scatter mpg weight, pstyle(p1)) (scatter mpg weight, pstyle(p1)), legend(on order(2 1))" ///
        "(scatter mpg weight, pstyle(p1)) (scatter price weight, pstyle(p1))," ///
        "(scatter mpg weight, pstyle(p1) msize(medium)) (scatter mpg weight, pstyle(p1))," ///
        "(lfitci mpg weight) (qfitci mpg weight), legend(on)" {
        local ++j
        _u31_reg "`u31d'" 6`j' drawn `c'
        foreach m in s v {
            if "${u31_`m'}" != "${u31_tw}" local bad "`bad' case `j' `m': dash ${u31_`m'} twoway ${u31_tw};"
        }
    }
    _w31_expect U31-6 `"(`"`bad'"' == "")"' "`bad'"
    _w31_done U31-6 "plots that look the same merge into one key, saved and served, as twoway"

    // U31-9: histogram-only graphs: no legend, legend(on) one, two
    // colours two keys.
    local bad ""
    local j 0
    foreach c in "(histogram mpg) (histogram price)," "(histogram mpg) (histogram price), legend(on)" ///
        "(histogram mpg) (histogram price, color(red))," ///
        "(histogram mpg, freq) (histogram mpg, percent)," {
        local ++j
        _u31_reg "`u31d'" 9`j' drawn `c'
        foreach m in s v {
            if "${u31_`m'}" != "${u31_tw}" local bad "`bad' case `j' `m': dash ${u31_`m'} twoway ${u31_tw};"
        }
    }
    _w31_expect U31-9 `"(`"`bad'"' == "")"' "`bad'"
    _w31_done U31-9 "histogram-only graphs draw the legend twoway draws, saved and served"

    macro drop u31_tw u31_s u31_v
    capture graph drop _all
    dash clear
    display as text "S31 end " c(current_date) " " c(current_time)
}
* ==== end S31 ====

capture program drop _u32_tw
program define _u32_tw
    // _u32_tw <svg> <command...>: twoway's drawing of <command> exported
    // with the plot region outlined #010203, for _u32_check.
    version 19
    gettoken svg 0 : 0
    if !strpos(`"`0'"', ",") local 0 `"`0',"'
    capture graph drop u32t
    quietly twoway `0' plotregion(lcolor("1 2 3")) name(u32t, replace)
    quietly graph export "`svg'", replace
    graph drop u32t
end

capture program drop _u32_dash
program define _u32_dash
    // _u32_dash <dir> <k> <command...>: dash's spec and data for
    // <command>, read by _u32_check.
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    if !strpos(`"`0'"', ",") local 0 `"`0',"'
    dash clear
    quietly dash `0' name(zu32`k')
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
end

python:
def _u32_check(dr_dir, k, case):
    """dash's value for <case> in the saved and served figure of spec k,
    into u32_s and u32_v."""
    import __main__ as m
    from sfi import Macro
    import dash_render as dr
    sp, dp = "%s/s%s.json" % (dr_dir, k), "%s/d%s.json" % (dr_dir, k)
    a, b = m._u03_docs(sp, dp, "%s/a%s.py" % (dr_dir, k))
    for figs, sfx in ((a, "s"), (b, "v")):
        f = figs[0]
        if case == "title":
            v = "%.4f" % dr.OptionTranslator.css_to_pt(f.title.text_font_size)
        elif case == "fxy":
            # WP-45 VF-11/GW-20: the figure keeps the graph's box; the
            # plot and its axes are drawn in # percent of 384 px, centred,
            # the rest added to the borders: the aspect ratio, the top and
            # right borders (no axis on either), min_border, and the
            # graph's nominal box (the saved figure's, the served one's
            # alike).
            nw, nh = a[0]._dash_nominal_px
            v = "%.4f %s %s %s %s %s" % (
                float(f.aspect_ratio), f.min_border_top, f.min_border_right,
                f.min_border, nw, nh)
        elif case == "ratio":
            # WP-45 VF-4: the figure keeps the graph's shape; the frame's
            # aspectratio() is the size follow's "slack" part
            # (_DASH_GRAPH_MARGIN_JS), its ar the frame's height/width.
            sl = [c.args["item"].get("slack") for c in
                  f.js_property_callbacks.get("change:outer_width", [])
                  if c.code == dr._DASH_GRAPH_MARGIN_JS]
            sl = sl[0] if sl and sl[0] else {}
            # Flipped (BUGS.md "A graph's canvas ended before its own x
            # axis, x title and colour key labels"): the figure's
            # aspect_ratio was the graph's; the figure now keeps what its
            # graph region box's padding (the scheme's graph margin, % of
            # the width, CSS t r b l) leaves, so the graph's ratio is the
            # figure's with that margin added back.
            ar = float(f.aspect_ratio)
            bx = getattr(f, "_dash_region_cell", None)
            if bx is None and f.document is not None:
                bx = next((c for c in f.document.models
                           if "dash_graph_region" in (getattr(c, "tags", None) or [])
                           and f in (getattr(c, "children", None) or [])), None)
            if bx is not None:
                import re
                pd = [float(x) for x in re.findall(r"-?[0-9.]+(?=%)", str((bx.styles or {}).get("padding", "")))]
                if len(pd) == 4 and ar > 0:
                    ar = 1.0 / ((1.0 - (pd[1] + pd[3]) / 100.0) / ar + (pd[0] + pd[2]) / 100.0)
            v = "%.4f %s %s %s" % (ar, f.frame_width,
                                   f.frame_height, sl.get("ar"))
        elif case == "place":
            v = "%s %s %s %s" % (f.frame_width, f.frame_height,
                                 f.min_border_left, f.min_border_right)
        elif case == "ref":
            v = "%.4f %.4f" % (dr.OptionTranslator.size_ref_of(f),
                               dr.OptionTranslator.css_to_pt(f.title.text_font_size))
        elif case == "border":
            v = "%s %s" % (f.min_border_left, f.min_border_right)
        Macro.setGlobal("u32_" + sfx, v)


def _u32_plot(svg):
    """twoway's plot region in <svg>: left top right bottom."""
    import os, sys
    from sfi import Macro
    sys.path.insert(0, os.path.join(Macro.getGlobal("u32_repo"), "scripts"))
    import svg_chrome
    r = svg_chrome.svg_region(svg, "#010203")
    import svg_truth
    t = [d for d in svg_truth.svg_document(svg)["texts"] if d["text"] == "T"]
    c = svg_truth.svg_document(svg)["canvas"]
    Macro.setGlobal("u32_tw", "%.3f %.3f %.3f %.3f %s %.3f" % (
        r["left"], r["top"], r["right"], r["bottom"],
        t[0]["size"] if t else ".", min(c["w"], c["h"])))
end

* ==== S32 D5: Sizing ====
local only : env WP31_ONLY
if inlist("`only'", "", "S32") & `: list posof "S32" in w31_run' {
    display as text "S32 start " c(current_date) " " c(current_time)
    local u32d "`w31_work'/s32"
    capture mkdir "`u32d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear
    global u32_repo "`c(pwd)'/.."

    // U32-1: scale(1.5) draws the title 1.5 x, in twoway and in dash.
    _u32_tw "`u32d'/t1a.svg" scatter mpg weight, title("T")
    python: _u32_plot("`u32d'/t1a.svg")
    local tw0 : word 5 of ${u32_tw}
    _u32_tw "`u32d'/t1b.svg" scatter mpg weight, title("T") scale(1.5)
    python: _u32_plot("`u32d'/t1b.svg")
    local tw1 : word 5 of ${u32_tw}
    _u32_dash "`u32d'" 1a scatter mpg weight, title("T")
    python: _u32_check("`u32d'", "1a", "title")
    local s0 ${u32_s}
    local v0 ${u32_v}
    _u32_dash "`u32d'" 1b scatter mpg weight, title("T") scale(1.5)
    python: _u32_check("`u32d'", "1b", "title")
    _w31_expect U32-1 "abs(`tw1' / `tw0' - 1.5) < .01" "twoway's title `tw0' -> `tw1'"
    _w31_expect U32-1 "abs(${u32_s} / `s0' - `tw1' / `tw0') < .02" "saved: `s0' -> ${u32_s}"
    _w31_expect U32-1 "abs(${u32_v} / `v0' - `tw1' / `tw0') < .02" "served: `v0' -> ${u32_v}"
    _w31_done U32-1 "scale(1.5) draws the title `tw1'/`tw0' as large, as twoway, saved and served"

    // U32-2: fysize(50) halves the plot region's height in twoway; dash
    // keeps the graph's box and draws the plot and its axes in 50% of 384
    // px, centred (WP-45 VF-11/GW-20, measured sizing_truth.json
    // fysize_50/fxsize_50): the top border grows by the rest's half;
    // fxsize(50) alike across, the right border.
    _u32_tw "`u32d'/t2a.svg" scatter mpg weight
    python: _u32_plot("`u32d'/t2a.svg")
    local h0 = real(word("${u32_tw}", 4)) - real(word("${u32_tw}", 2))
    _u32_tw "`u32d'/t2b.svg" scatter mpg weight, fysize(50)
    python: _u32_plot("`u32d'/t2b.svg")
    local h1 = real(word("${u32_tw}", 4)) - real(word("${u32_tw}", 2))
    _w31_expect U32-2 "`h1' < .6 * `h0'" "twoway's plot height `h0' -> `h1'"
    _u32_dash "`u32d'" 2a scatter mpg weight
    python: _u32_check("`u32d'", "2a", "fxy")
    local s0 ${u32_s}
    local v0 ${u32_v}
    foreach f in y x {
        _u32_dash "`u32d'" 2`f' scatter mpg weight, f`f'size(50)
        python: _u32_check("`u32d'", "2`f'", "fxy")
        foreach m in s v {
            local a0 : word 1 of ``m'0'
            local a1 : word 1 of ${u32_`m'}
            local bt : word 2 of ${u32_`m'}
            local br : word 3 of ${u32_`m'}
            local mb : word 4 of ${u32_`m'}
            local nw : word 5 of ${u32_`m'}
            local nh : word 6 of ${u32_`m'}
            if "`f'" == "y" local got = `bt' - `mb'
            else local got = `br' - `mb'
            local side = cond("`f'" == "y", `nh', `nw')
            local want = (`side' - .5 * 384) / 2
            _w31_expect U32-2 "abs(`a1' - `a0') < 1e-6 & abs(`got' - `want') <= 1" "f`f'size(50) `m': ratio `a0' -> `a1', border added `got', want `want'"
        }
    }
    _w31_done U32-2 "fysize(50) and fxsize(50) draw the plot in half of 384 px, centred, saved and served"

    // U32-3: aspectratio(1) alone: twoway's plot region square in the
    // graph's 5.5 x 4 box; dash's figure keeps the box's shape and its
    // size follow draws the frame square (WP-45 VF-4).
    _u32_tw "`u32d'/t3.svg" scatter mpg weight, aspectratio(1)
    python: _u32_plot("`u32d'/t3.svg")
    local r = (real(word("${u32_tw}", 4)) - real(word("${u32_tw}", 2))) / (real(word("${u32_tw}", 3)) - real(word("${u32_tw}", 1)))
    _w31_expect U32-3 "abs(`r' - 1) < .01" "twoway's plot region h/w `r'"
    _u32_dash "`u32d'" 3 scatter mpg weight, aspectratio(1)
    python: _u32_check("`u32d'", "3", "ratio")
    foreach m in s v {
        _w31_expect U32-3 `"("${u32_`m'}" == "1.3750 None None 1.0")"' "`m': ${u32_`m'}"
    }
    _w31_done U32-3 "aspectratio(1) alone: twoway's plot region h/w `r', dash's frame 1:1 in the graph's box, saved and served"

    // U32-4: aspectratio(1) xsize(8) ysize(4): a square plot region,
    // pushed right by placement(e), in twoway and in dash.
    _u32_tw "`u32d'/t4.svg" scatter mpg weight, aspectratio(1, placement(e)) xsize(8) ysize(4)
    python: _u32_plot("`u32d'/t4.svg")
    local w = real(word("${u32_tw}", 3)) - real(word("${u32_tw}", 1))
    local h = real(word("${u32_tw}", 4)) - real(word("${u32_tw}", 2))
    local rgt = real(word("${u32_tw}", 3))
    _w31_expect U32-4 "abs(`h' / `w' - 1) < .01 & `rgt' > 5500" "twoway's plot region `w' x `h', right edge `rgt' of 5760"
    _u32_dash "`u32d'" 4 scatter mpg weight, aspectratio(1, placement(e)) xsize(8) ysize(4)
    python: _u32_check("`u32d'", "4", "place")
    foreach m in s v {
        local fw : word 1 of ${u32_`m'}
        local fh : word 2 of ${u32_`m'}
        local bl : word 3 of ${u32_`m'}
        local br : word 4 of ${u32_`m'}
        _w31_expect U32-4 "`fw' == `fh' & `bl' > `br'" "`m': frame `fw' x `fh', borders `bl' `br'"
    }
    _w31_done U32-4 "aspectratio(1, placement(e)) with xsize(8) ysize(4): a square plot region at the right, saved and served"

    // U32-5: _dash_aspect_split reads aspectratio()'s text as twoway does.
    _dash_aspect_split "1, placement(e)"
    _w31_expect U32-5 `"("`_asp_num'" == "1") & ("`_asp_place'" == "e")"' "1, placement(e): `_asp_num' `_asp_place'"
    _dash_aspect_split "0.5"
    _w31_expect U32-5 `"("`_asp_num'" == "0.5") & ("`_asp_place'" == "")"' "0.5: `_asp_num' `_asp_place'"
    _dash_aspect_split "2, place(3)"
    _w31_expect U32-5 `"("`_asp_num'" == "2") & ("`_asp_place'" == "e")"' "2, place(3): `_asp_num' `_asp_place'"
    _w31_done U32-5 "the number and placement() of aspectratio() split as twoway reads them"

    // U32-9: xoverhangs narrows twoway's plot region for a long end
    // label, and raises dash's borders for it.
    _u32_tw "`u32d'/t9a.svg" scatter mpg weight, xlabel(1760 "a very long first label" 4840)
    python: _u32_plot("`u32d'/t9a.svg")
    local l0 : word 1 of ${u32_tw}
    _u32_tw "`u32d'/t9b.svg" scatter mpg weight, xlabel(1760 "a very long first label" 4840) xoverhangs
    python: _u32_plot("`u32d'/t9b.svg")
    local l1 : word 1 of ${u32_tw}
    _w31_expect U32-9 "`l1' > `l0'" "twoway's plot region left edge `l0' -> `l1'"
    _u32_dash "`u32d'" 9a scatter mpg weight, xlabel(1760 "a very long first label" 4840)
    python: _u32_check("`u32d'", "9a", "border")
    local s0 ${u32_s}
    local v0 ${u32_v}
    _u32_dash "`u32d'" 9b scatter mpg weight, xlabel(1760 "a very long first label" 4840) xoverhangs
    python: _u32_check("`u32d'", "9b", "border")
    foreach m in s v {
        local b0 : word 1 of ``m'0'
        local b1 : word 1 of ${u32_`m'}
        if "`b0'" == "None" local b0 0
        _w31_expect U32-9 "`b1' > `b0'" "`m': left border `b0' -> `b1'"
    }
    _w31_done U32-9 "xoverhangs makes room for a long end label, as twoway, saved and served"
    dash clear
    display as text "S32 end " c(current_date) " " c(current_time)
}
* ==== end S32 ====

* ==== S32 E11: Size reference ====
local only : env WP31_ONLY
if inlist("`only'", "", "S32") & `: list posof "S32" in w31_run' {
    display as text "S32 start " c(current_date) " " c(current_time)
    local u32d "`w31_work'/s32e"
    capture mkdir "`u32d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear
    global u32_repo "`c(pwd)'/.."

    // U32-8: an absolute title size is half the share of an 8 x 8 graph
    // it is of a 4 x 4 one, in twoway and in dash (whose reference is
    // min(xsize, ysize)); a relative size the same share of both.
    foreach z in 4 8 {
        foreach t in 14pt 5 {
            _u32_tw "`u32d'/t8_`z'_`t'.svg" scatter mpg weight, title("T", size(`t')) xsize(`z') ysize(`z')
            python: _u32_plot("`u32d'/t8_`z'_`t'.svg")
            local tw`z'_`t' = real(word("${u32_tw}", 5)) / real(word("${u32_tw}", 6))
            _u32_dash "`u32d'" 8_`z'_`t' scatter mpg weight, title("T", size(`t')) xsize(`z') ysize(`z')
            python: _u32_check("`u32d'", "8_`z'_`t'", "ref")
            foreach m in s v {
                local r`m'`z'_`t' : word 1 of ${u32_`m'}
                local p`m'`z'_`t' : word 2 of ${u32_`m'}
            }
        }
    }
    local twa = `tw8_14pt' / `tw4_14pt'
    local twr = `tw8_5' / `tw4_5'
    _w31_expect U32-8 "abs(`twa' - .5) < .02 & abs(`twr' - 1) < .02" "twoway's share 8x8/4x4: 14pt `twa', size(5) `twr'"
    foreach m in s v {
        _w31_expect U32-8 "`r`m'4_14pt' == 4 & `r`m'8_14pt' == 8" "`m': reference `r`m'4_14pt' and `r`m'8_14pt'"
        _w31_expect U32-8 "abs(`p`m'8_14pt' / `p`m'4_14pt' - `twa') < .02" "`m': 14pt drawn `p`m'4_14pt' -> `p`m'8_14pt'"
        _w31_expect U32-8 "abs(`p`m'8_5' / `p`m'4_5' - `twr') < .02" "`m': size(5) drawn `p`m'4_5' -> `p`m'8_5'"
    }
    _w31_done U32-8 "the size reference is min(xsize, ysize), as twoway's, saved and served"
    dash clear
    display as text "S32 end " c(current_date) " " c(current_time)
}
* ==== end S32 ====

// S33 (WP-31 D6) helpers: draw one command in twoway (SVG export and
// log) and in dash (both modes, log), and describe one axis fact for one
// case into globals u33_tw (twoway), u33_s (saved) and u33_v (served).
// twoway's SVG is 10 units a point; dash's widths are px (4/3 a point).
python:
def _u33_svg(path):
    import os, sys
    sys.path.insert(0, os.path.join(os.getcwd(), "..", "scripts"))
    import svg_truth
    return svg_truth.svg_document(path)


def _u33_tw(case, svg, svg0, tlog):
    d = _u33_svg(svg)
    with open(tlog, encoding="utf-8") as fh:
        log = fh.read()
    if case == "look":
        d0 = _u33_svg(svg0)
        moved = d["plotregion"]["left"] - d0["plotregion"]["left"]
        tick = [h for h in d["hlines"] if h["stroke"] == "#000000"
                and abs(h["x2"] - h["x1"]) < 100][0]["width"]
        grid = [h for h in d["hlines"] if h["stroke"] == "#eaf2f3"]
        return "%d %.2f %.2f %s" % (
            5 + round(moved / 10 * 4 / 3), tick / 10 * 4 / 3,
            grid[0]["width"] / 10 * 4 / 3,
            "dashed" if len(grid) > 4 else "solid")
    if case == "alt":
        xs = sorted((t["x"], t["y"]) for t in d["texts"]
                    if t["text"].replace(",", "").isdigit()
                    and not t.get("rotate"))
        rows = sorted({round(y, 1) for _x, y in xs})
        return "%d rows, first %s" % (
            len(rows), "near" if round(xs[0][1], 1) == rows[0] else "far")
    if case == "minmax":
        return " ".join(t["text"] for t in d["texts"]
                        if t.get("rotate") and t["text"].isdigit())
    if case == "scale":
        d0 = _u33_svg(svg0)
        a = [v for v in d["vlines"] if v["stroke"] == "#000000"
             and abs(v["y2"] - v["y1"]) > 500][0]
        ticks = sorted(h["y1"] for h in d["hlines"]
                       if h["stroke"] == "#000000"
                       and abs(h["x2"] - h["x1"]) < 100)
        ends = (abs(min(a["y1"], a["y2"]) - ticks[0]) < 0.5
                and abs(max(a["y1"], a["y2"]) - ticks[-1]) < 0.5)
        moved = d["plotregion"]["left"] - d0["plotregion"]["left"]
        return "%s %d" % ("ticks" if ends else "frame",
                          round(moved / 10 * 4 / 3))
    if case == "side":
        d0 = _u33_svg(svg0)
        x = [t["x"] for t in d["texts"] if t.get("rotate")
             and t["text"].isdigit()][0]
        return "right" if x > d["plotregion"]["right"] else "left"
    if case == "minor":
        # twoway's minor ticks on x: half the major length, below the axis.
        short = [v for v in d["vlines"] if v["stroke"] == "#000000"
                 and 5 < abs(v["y2"] - v["y1"]) < 30]
        return "lone" if len(short) == 1 else "rule %d" % len(short)
    if case == "xline":
        w = [v["width"] for v in d["vlines"]
             if v["stroke"] not in ("#000000", "#eaf2f3")
             and abs(v["y2"] - v["y1"]) > 500][0]
        return "%.2f" % (w / 10 * 4 / 3)
    if case == "dh":
        n = len([t for t in d["texts"] if t.get("rotate")
                 and t["text"].isdigit()])
        return "%s labels %d" % (
            "noted" if "##5 ignored, only allowed for minor ticks" in log
            else "silent", n)


def _u33_dash(figs, case, log):
    f = figs[0]
    yax = [a for a in list(f.left) + list(f.right)
           if "dash_alt_axis" not in (a.tags or [])][0]
    if case == "look":
        g = [g for g in f.ygrid][0]
        return "%d %.2f %.2f %s" % (
            yax.major_label_standoff, yax.major_tick_line_width,
            g.grid_line_width, "dashed" if g.grid_line_dash else "solid")
    if case == "alt":
        tw = [a for a in f.below if "dash_alt_axis" in (a.tags or [])]
        ax = [a for a in f.below if "dash_alt_axis" not in (a.tags or [])]
        if len(tw) != 1:
            return "%d rows" % (1 + len(tw))
        ok = (dict(ax[0].formatter.args)["parity"] == 0
              and dict(tw[0].formatter.args)["parity"] == 1)
        return "2 rows, first %s" % ("near" if ok else "far")
    if case == "minmax":
        return " ".join("%g" % v for v in yax.ticker.ticks)
    if case == "scale":
        import dash_render as dr
        ticks = dr._dash_axis_major_ticks(yax) or []
        ends = bool(ticks) and tuple(yax.bounds) == (min(ticks), max(ticks))
        return "%s %d" % ("ticks" if ends else "frame",
                          (f.min_border_left if f.min_border_left is not None
                           else f.min_border) - (f.min_border or 0))
    if case == "side":
        return "right" if any("dash_alt_axis" not in (a.tags or [])
                              for a in f.right) else "left"
    if case == "minor":
        xax = [a for a in f.below if "dash_alt_axis" not in (a.tags or [])][0]
        a = dict(getattr(xax.ticker, "args", None) or {})
        pos = list(a.get("mextra") or [])
        if a.get("mfixed") is not None:
            pos += list(a["mfixed"].ticks or [])
        lo, hi = sorted((f.x_range.start, f.x_range.end))
        pos = sorted({float(v) for v in pos if lo <= v <= hi})
        maj = {float(v) for v in getattr(a.get("base"), "ticks", None) or []}
        pos = [v for v in pos if v not in maj]
        return "lone" if pos == [0.0] else "rule %d" % len(pos)
    if case == "xline":
        ws = [m.line_width for m in list(f.center) + list(f.renderers)
              if type(m).__name__ in ("Span", "Arrow")]
        return "%.2f" % ws[0] if ws else "none"
    if case == "dh":
        t = yax.ticker
        n = len(getattr(t, "ticks", None) or [])
        return "%s labels %d" % (
            "noted" if "##5 ignored, only allowed for minor ticks" in log
            else "silent", n)


def _u33_docs(sp, dp, app):
    """_u03_docs with each mode's notes: (saved figures, served figures,
    saved notes, served notes)."""
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings(record=True) as w1:
        warnings.simplefilter("always")
        r = dr.DashRenderer(sp, dp)
        r.render()
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        dr.ServerAppBuilder(sp, dp).build(app)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_u33_app")
    with warnings.catch_warnings(record=True) as w2:
        warnings.simplefilter("always")
        exec(compile(src.replace(attach, "pass"), "dash_u33_app.py", "exec"),
             ns)
        doc = Document()
        ns["make_document"](doc)
    sv = [m for m in doc.models if type(m).__name__ == "figure"]
    return (list(r.figures.values()), sv,
            "\n".join(str(x.message) for x in w1),
            "\n".join(str(x.message) for x in w2))


def _u33_vvthin(base, out):
    """scheme-u33vvthin.scheme in *out*: s2color with linewidth xyline
    vvthin and no #include."""
    import os
    with open(os.path.join(base, "s", "scheme-s2color.scheme"),
              encoding="latin-1") as fh:
        lines = fh.read().splitlines()
    keep = []
    for ln in lines:
        if ln.lstrip().startswith("#include"):
            continue
        if ln.split()[:2] == ["linewidth", "xyline"]:
            ln = "linewidth xyline       vvthin"
        keep.append(ln)
    with open(os.path.join(out, "scheme-u33vvthin.scheme"), "w",
              encoding="latin-1") as fh:
        fh.write("\n".join(keep) + "\n")


def _u33_check(sp, dp, app, svg, svg0, tlog, dlog, case):
    from sfi import Macro
    a, b, na, nb = _u33_docs(sp, dp, app)
    Macro.setGlobal("u33_tw", _u33_tw(case, svg, svg0, tlog))
    for figs, notes, sfx in ((a, na, "s"), (b, nb, "v")):
        Macro.setGlobal("u33_" + sfx, _u33_dash(figs, case, notes))
    Macro.setGlobal("u33_noted", "1" if "not implemented" in na + nb
                    else "0")
end

capture program drop _u33_reg
program define _u33_reg
    // _u33_reg <dir> <k> <case> <command with options...>
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    gettoken case 0 : 0
    capture graph drop u33t
    capture log close u33l
    quietly log using "`dir'/t`k'.log", text replace name(u33l)
    capture noisily twoway `0' name(u33t, replace)
    quietly log close u33l
    quietly graph export "`dir'/t`k'.svg", replace
    graph drop u33t
    dash clear
    quietly log using "`dir'/d`k'.log", text replace name(u33l)
    capture noisily dash `0' name(zu33`k')
    local drc = _rc
    quietly log close u33l
    if `drc' {
        global u33_s "rc `drc'"
        global u33_v "rc `drc'"
        global u33_tw "(twoway drawn)"
        exit
    }
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u33_m; _u33_m._u33_check("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py", "`dir'/t`k'.svg", "`dir'/t0.svg", "`dir'/t`k'.log", "`dir'/d`k'.log", "`case'")
end

* ==== S33 D6: Axis label, tick and grid sub-options ====
local only : env WP31_ONLY
if inlist("`only'", "", "S33") & `: list posof "S33" in w31_run' {
    display as text "S33 start " c(current_date) " " c(current_time)
    local u33d "`w31_work'/s33"
    capture mkdir "`u33d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(u33t, replace)
    quietly graph export "`u33d'/t0.svg", replace
    graph drop u33t

    // U33-01: labgap(), tlwidth(), glwidth() and glpattern() drawn as
    // twoway draws them, with no note.
    _u33_reg "`u33d'" 1 look scatter mpg weight, ylabel(, labgap(large) tlwidth(thick) glwidth(thick) glpattern(dash) grid)
    foreach m in s v {
        _w31_expect U33-01 `"("${u33_`m'}" == "${u33_tw}")"' "`m': dash ${u33_`m'}; twoway ${u33_tw}"
    }
    _w31_expect U33-01 `"(${u33_noted} == 0)"' "dash named a drawn sub-option"
    _w31_done U33-01 "labgap(), tlwidth(), glwidth() and glpattern() as twoway's, saved and served, no note"

    // U33-02: alternate staggers the labels on two rows, the first near.
    _u33_reg "`u33d'" 2 alt scatter mpg weight, xlabel(1500(500)5000, alternate)
    foreach m in s v {
        _w31_expect U33-02 `"("${u33_`m'}" == "${u33_tw}")"' "`m': dash ${u33_`m'}; twoway ${u33_tw}"
    }
    _w31_done U33-02 "xlabel(, alternate) on two rows as twoway, saved and served"

    // U33-03: minmax over every layer.
    _u33_reg "`u33d'" 3 minmax (scatter mpg weight) (scatter trunk weight), ylabel(minmax)
    foreach m in s v {
        _w31_expect U33-03 `"("${u33_`m'}" == "${u33_tw}")"' "`m': dash ${u33_`m'}; twoway ${u33_tw}"
    }
    _w31_done U33-03 "ylabel(minmax) labels every layer's extremes, saved and served"

    // U33-04: ##5 on ylabel() is noted and draws what none draws.
    _u33_reg "`u33d'" 4 dh scatter mpg weight, ylabel(##5)
    foreach m in s v {
        _w31_expect U33-04 `"("${u33_`m'}" == "${u33_tw}")"' "`m': dash ${u33_`m'}; twoway ${u33_tw}"
    }
    _w31_done U33-04 "ylabel(##5) noted and drawn as twoway draws it, saved and served"

    macro drop u33_tw u33_s u33_v u33_noted
    capture graph drop _all
    dash clear
    display as text "S33 end " c(current_date) " " c(current_time)
}
* ==== end S33 ====

* ==== S33 D7: Axis-scale look ====
local only : env WP31_ONLY
if inlist("`only'", "", "S33") & `: list posof "S33" in w31_run' {
