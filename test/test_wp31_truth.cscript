    _w31_expect U42-05 `"("`bad'" == "")"' "texts differ from twoway's:`bad'"
    _w31_done U42-05 "a global in every graph text option is drawn as twoway draws it, saved and served"

    // U42-06: a global holding an =exp is never evaluated (its file is
    // not written); a sub-option's global is read (color(\$ZC) red); an
    // axis 3 title's global is its value; a title whose globals pass 4,000
    // characters is refused, r(198).
    local sent "`u42d'/u42_ran"
    capture erase "`sent'"
    global ZTG_run `"\`=filewrite("`sent'", "x")'"'
    global ZC "red"
    dash clear
    capture noisily dash scatter mpg weight, title("a \$ZTG_run b", color(\$ZC)) name(u42r)
    local r1 = _rc
    _dash_serve_spec, specpath("`u42d'/sr.json") datapath("`u42d'/dr.json")
    python: import json; from sfi import Macro; _g = json.load(open(r"`u42d'/sr.json"))["graphs"][0]["graph_options"]["title"]; Macro.setGlobal("u42_st", str(("red" in _g) and ("filewrite" in _g)))
    capture confirm file "`sent'"
    local ran = (_rc == 0)
    dash clear
    capture noisily dash (scatter mpg weight) (scatter price weight, yaxis(3)), ytitle("g\$ZTG_plain", axis(3)) name(u42x)
    local r3 = _rc
    python: from sfi import Macro; Macro.setGlobal("u42_ax", str("ghello" in Macro.getGlobal("dash_json_u42x")))
    global ZTG_long = 300 * "abcdefghijklmn"
    dash clear
    capture noisily dash scatter mpg weight, title("\$ZTG_long") name(u42l)
    local r2 = _rc
    _w31_expect U42-06 `"(`r1' == 0) & ("${u42_st}" == "True") & (`ran' == 0) & (`r2' == 198) & (`r3' == 0) & ("${u42_ax}" == "True")"' "rc `r1' stored ${u42_st} ran `ran' long rc `r2' axis 3 rc `r3' expanded ${u42_ax}"
    _w31_done U42-06 "an =exp global is drawn as written and never run, a sub-option's global is read, an expansion past 4,000 characters is refused"

    // U42-08: a global holding a double quote splits the string, as
    // twoway reads the option again before its quotes: in text() and
    // ttext() twoway refuses the point the rest makes, and in a tick label
    // the label specifier, r(198), in its words (measured live beside).
    // Typed on straight lines: a loop body would expand the global
    // before either command reads it.
    global ZTG_quote `"say "hi""'
    local bad ""
    capture graph drop _all
    quietly log using "`u42d'/q1_1.log", text replace name(u42q)
    capture noisily twoway scatter mpg weight, text(30 3000 "a \$ZTG_quote b") nodraw
    local rc1 = _rc
    quietly log close u42q
    dash clear
    quietly log using "`u42d'/q1_2.log", text replace name(u42q)
    capture noisily dash scatter mpg weight, text(30 3000 "a \$ZTG_quote b") name(u42q)
    local rc2 = _rc
    quietly log close u42q
    local want `"invalid point,  hi" b""'
    cert_log_has "`u42d'/q1_1.log", needle(`"`macval(want)'"')
    local n1 = r(count)
    cert_log_has "`u42d'/q1_2.log", needle(`"`macval(want)'"')
    local n2 = r(count)
    if !(`rc1' == 198 & `rc2' == 198 & `n1' == 1 & `n2' == 1) local bad "`bad' t1(twoway `rc1'/`n1' dash `rc2'/`n2')"
    capture graph drop _all
    quietly log using "`u42d'/q2_1.log", text replace name(u42q)
    capture noisily twoway scatter mpg weight, ttext(30 3000 "a \$ZTG_quote b") nodraw
    local rc1 = _rc
    quietly log close u42q
    dash clear
    quietly log using "`u42d'/q2_2.log", text replace name(u42q)
    capture noisily dash scatter mpg weight, ttext(30 3000 "a \$ZTG_quote b") name(u42q)
    local rc2 = _rc
    quietly log close u42q
    local want `"invalid point,  hi" b""'
    cert_log_has "`u42d'/q2_1.log", needle(`"`macval(want)'"')
    local n1 = r(count)
    cert_log_has "`u42d'/q2_2.log", needle(`"`macval(want)'"')
    local n2 = r(count)
    if !(`rc1' == 198 & `rc2' == 198 & `n1' == 1 & `n2' == 1) local bad "`bad' t2(twoway `rc1'/`n1' dash `rc2'/`n2')"
    capture graph drop _all
    quietly log using "`u42d'/q3_1.log", text replace name(u42q)
    capture noisily twoway scatter mpg weight, text(30 3000 "a \$ZTG_quote b" 20 3000 "ok") nodraw
    local rc1 = _rc
    quietly log close u42q
    dash clear
    quietly log using "`u42d'/q3_2.log", text replace name(u42q)
    capture noisily dash scatter mpg weight, text(30 3000 "a \$ZTG_quote b" 20 3000 "ok") name(u42q)
    local rc2 = _rc
    quietly log close u42q
    local want `"invalid point, 20 hi" b""'
    cert_log_has "`u42d'/q3_1.log", needle(`"`macval(want)'"')
    local n1 = r(count)
    cert_log_has "`u42d'/q3_2.log", needle(`"`macval(want)'"')
    local n2 = r(count)
    if !(`rc1' == 198 & `rc2' == 198 & `n1' == 1 & `n2' == 1) local bad "`bad' t3(twoway `rc1'/`n1' dash `rc2'/`n2')"
    capture graph drop _all
    quietly log using "`u42d'/q4_1.log", text replace name(u42q)
    capture noisily twoway scatter mpg weight, xlabel(3000 "a \$ZTG_quote b") nodraw
    local rc1 = _rc
    quietly log close u42q
    dash clear
    quietly log using "`u42d'/q4_2.log", text replace name(u42q)
    capture noisily dash scatter mpg weight, xlabel(3000 "a \$ZTG_quote b") name(u42q)
    local rc2 = _rc
    quietly log close u42q
    local want `"invalid label specifier, :  3000 "a say "hi" b":"'
    cert_log_has "`u42d'/q4_1.log", needle(`"`macval(want)'"')
    local n1 = r(count)
    cert_log_has "`u42d'/q4_2.log", needle(`"`macval(want)'"')
    local n2 = r(count)
    if !(`rc1' == 198 & `rc2' == 198 & `n1' == 1 & `n2' == 1) local bad "`bad' l1(twoway `rc1'/`n1' dash `rc2'/`n2')"
    capture graph drop _all
    quietly log using "`u42d'/q5_1.log", text replace name(u42q)
    capture noisily twoway scatter mpg weight, xlabel(3000 "a \$ZTG_quote b", labsize(small)) nodraw
    local rc1 = _rc
    quietly log close u42q
    dash clear
    quietly log using "`u42d'/q5_2.log", text replace name(u42q)
    capture noisily dash scatter mpg weight, xlabel(3000 "a \$ZTG_quote b", labsize(small)) name(u42q)
    local rc2 = _rc
    quietly log close u42q
    local want `"invalid label specifier, :  3000 "a say "hi" b":"'
    cert_log_has "`u42d'/q5_1.log", needle(`"`macval(want)'"')
    local n1 = r(count)
    cert_log_has "`u42d'/q5_2.log", needle(`"`macval(want)'"')
    local n2 = r(count)
    if !(`rc1' == 198 & `rc2' == 198 & `n1' == 1 & `n2' == 1) local bad "`bad' l2(twoway `rc1'/`n1' dash `rc2'/`n2')"
    capture graph drop _all
    quietly log using "`u42d'/q6_1.log", text replace name(u42q)
    capture noisily twoway scatter mpg weight, ylabel(20 "a \$ZTG_quote b") nodraw
    local rc1 = _rc
    quietly log close u42q
    dash clear
    quietly log using "`u42d'/q6_2.log", text replace name(u42q)
    capture noisily dash scatter mpg weight, ylabel(20 "a \$ZTG_quote b") name(u42q)
    local rc2 = _rc
    quietly log close u42q
    local want `"invalid label specifier, :  20 "a say "hi" b":"'
    cert_log_has "`u42d'/q6_1.log", needle(`"`macval(want)'"')
    local n1 = r(count)
    cert_log_has "`u42d'/q6_2.log", needle(`"`macval(want)'"')
    local n2 = r(count)
    if !(`rc1' == 198 & `rc2' == 198 & `n1' == 1 & `n2' == 1) local bad "`bad' l3(twoway `rc1'/`n1' dash `rc2'/`n2')"
    _w31_expect U42-08 `"("`bad'" == "")"' "refusals differ from twoway's:`bad'"
    _w31_done U42-08 "a global holding a double quote in text(), ttext() or a tick label is refused as twoway refuses it"

    // U42-09: a text() or ttext() line whose globals expand past 4,000
    // characters is refused, "text(): expanded text is too long", r(198)
    // (S30's documented bound; the check compared the line with itself).
    global ZTG_long = 300 * "abcdefghijklmn"
    dash clear
    quietly log using "`u42d'/q9.log", text replace name(u42q)
    capture noisily dash scatter mpg weight, text(30 3000 "\$ZTG_long") name(u42t)
    local r1 = _rc
    capture noisily dash scatter mpg weight, ttext(30 3000 "\$ZTG_long") name(u42t2)
    local r2 = _rc
    quietly log close u42q
    cert_log_has "`u42d'/q9.log", needle("text(): expanded text is too long")
    local n1 = r(count)
    global ZTG_long = 20 * "abcdefghijklmn"
    dash clear
    capture noisily dash scatter mpg weight, text(30 3000 "\$ZTG_long") name(u42t)
    local r3 = _rc
    _w31_expect U42-09 "(`r1' == 198) & (`r2' == 198) & (`n1' == 2) & (`r3' == 0)" "rc `r1' `r2' notes `n1' short rc `r3'"
    _w31_done U42-09 "a text() or ttext() line whose globals expand past 4,000 characters is refused, a shorter one drawn"
    dash clear
    dash clear
    macro drop ZTG_* ZC
    display as text "S42 end " c(current_date) " " c(current_time)
}
* ==== end S42 ====

python:
def _u43_carried(sp, dp, app, col):
    """Every source holding the carried column *col*, saved and served:
    the column's Python type, into u43_bad when one is not a float array
    (WP-31 G4: a carried numeric column stays a float64 array)."""
    import __main__ as m
    import numpy as np
    from sfi import Macro
    a, b = m._u03_docs(sp, dp, app)
    bad, seen = [], 0
    for figs, mode in ((a, "saved"), (b, "served")):
        for f in figs:
            for r in f.renderers:
                ds = getattr(r, "data_source", None)
                d = getattr(ds, "data", {}) or {}
                if col not in d:
                    continue
                seen += 1
                v = d[col]
                if not (isinstance(v, np.ndarray) and v.dtype.kind == "f"):
                    bad.append("%s %s: %s" % (mode, type(r.glyph).__name__,
                                              type(v).__name__))
    if seen == 0:
        bad.append("no source carries %s" % col)
    Macro.setGlobal("u43_bad", "; ".join(bad)[:2000])
end

capture program drop _u43_spec
program define _u43_spec
    // _u43_spec <dir> <k> <dash command>: the saved and served files of
    // the command, into <dir>/s<k>.json, d<k>.json and a<k>.py; the
    // global u43_serve holds _dash_serve_spec's own options (filter()).
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    dash clear
    quietly dash `0' scheme(s2color) name(zu43`k')
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json") ${u43_serve}
end

* ==== S43 G4: Carried columns as arrays ====
local only : env WP31_ONLY
if inlist("`only'", "", "S43") & `: list posof "S43" in w31_run' {
    display as text "S43 start " c(current_date) " " c(current_time)
    local u43d "`w31_work'/s43"
    capture mkdir "`u43d'"
    sysuse auto, clear

    // U43-01: a hover() variable carried into a line's derived source is
    // a float64 array under Stata's own Python, saved and served.
    _u43_spec "`u43d'" 1 line mpg weight, sort hover(price)
    python: import __main__ as _u43_m; _u43_m._u43_carried("`u43d'/s1.json", "`u43d'/d1.json", "`u43d'/a1.py", "price")
    _w31_expect U43-01 `"("${u43_bad}" == "")"' `"${u43_bad}"'
    _w31_done U43-01 "line ..., hover(price) carries price as a float array, saved and served"
    display as text "S43 end " c(current_date) " " c(current_time)
}
* ==== end S43 ====

