python:
def _u37_tw(svg):
    """twoway's graph and plot fills from an SVG: the canvas shows where
    the graph region is unfilled, the graph region where the plot region
    is; and the plot box's four gaps to the canvas edge."""
    import svg_truth
    rs = svg_truth.svg_rects(svg)
    canvas = rs[0]["fill"]
    full = [r for r in rs[1:] if (r["x"] or 0) < 1
            and r["fill"] not in (None, "none")]
    graph = full[0]["fill"] if full else canvas
    plot = [r for r in rs[1:] if (r["x"] or 0) >= 200
            and r["fill"] not in (None, "none")]
    b = rs[-1]
    gaps = (b["x"] - rs[0]["x"], rs[0]["x"] + rs[0]["w"] - b["x"] - b["w"],
            rs[0]["y"] + rs[0]["h"] - b["y"] - b["h"], b["y"] - rs[0]["y"])
    return graph, (plot[0]["fill"] if plot else graph), gaps


def _u37_regions(sp, dp, app, svg, svg0):
    """dash's border fill, plot fill and four min_border_* (saved into
    u37_s, served into u37_v) and twoway's (u37_tw): the fills, and each
    border as dash's default 5 px plus the gap change from svg0, in % of
    min(W, H) at the figure's min(width, height)."""
    import __main__ as m
    from sfi import Macro
    a, b = m._u03_docs(sp, dp, app)
    g, p, gaps = _u37_tw(svg)
    g0 = _u37_tw(svg0)[2] if svg0 else gaps
    # Flipped (WP-45 VF-4): dash adds the margin's change in px of the
    # graph's own box at 96 px an inch (twoway's graph size, the SVG's
    # width and height in inches), not of the figure's unused Bokeh
    # width and height (600 x 600); the width scale (D66) draws it at
    # the drawn width.
    import re as _re
    with open(svg, encoding="utf-8") as fh:
        _hd = fh.read(4000)
    _wh = [float(_re.search(k + r'="([0-9.]+)in"', _hd).group(1))
           for k in ("width", "height")]
    short = min(_wh) * 96.0
    for figs, sfx in ((a, "s"), (b, "v")):
        f = figs[0]
        bord = []
        want = []
        for i, attr in enumerate(("min_border_left", "min_border_right",
                                  "min_border_bottom", "min_border_top")):
            d = (gaps[i] - g0[i]) / 28.8
            v = getattr(f, attr)
            bord.append("." if v is None else str(int(v)))
            want.append("." if abs(d) < 0.05 else
                        str(int(round(max(0.0, f.min_border + d / 100.0 * short)))))
        Macro.setGlobal("u37_" + sfx, "%s %s %s" % (
            str(f.border_fill_color).lower(),
            str(f.background_fill_color).lower(), " ".join(bord)))
        Macro.setGlobal("u37_w" + sfx, "%s %s %s" % (g, p, " ".join(want)))
end

python:
def _u37_notes(sp, dp):
    """The region notes a saved render of the spec raises, into u37_n."""
    import warnings
    import dash_render as dr
    from sfi import Macro
    with warnings.catch_warnings(record=True) as w:
        warnings.simplefilter("always")
        dr.DashRenderer(sp, dp).render()
    Macro.setGlobal("u37_n", " ~ ".join(str(x.message) for x in w
                                        if "region" in str(x.message)))
end

python:
def _u37_inner(sp, dp, app, svg):
    """"" when dash draws the plot region's inner box exactly where twoway
    draws its inner rect (a rect inside the plot region), saved and
    served; else what differs, into u37_n."""
    import __main__ as m
    import svg_truth
    from sfi import Macro
    tw = any((r["x"] or 0) > 400 for r in svg_truth.svg_rects(svg))
    a, b = m._u03_docs(sp, dp, app)
    out = []
    for figs, sfx in ((a, "saved"), (b, "served")):
        f = figs[0]
        has = any("dash_inner_box" in (getattr(r, "tags", None) or [])
                  for r in list(f.renderers) + list(f.center))
        if has != tw:
            out.append("%s box %s, twoway %s" % (sfx, has, tw))
    Macro.setGlobal("u37_n", "; ".join(out))
end

capture program drop _u37_reg
program define _u37_reg
    // _u37_reg <dir> <k> <command with options...>: twoway's SVG, then
    // dash's saved and served figures, compared in u37_s/u37_v against
    // u37_ws/u37_wv; the default graph's SVG is <dir>/t0.svg.
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    capture graph drop u37t
    quietly twoway `0' name(u37t, replace)
    quietly graph export "`dir'/t`k'.svg", replace
    graph drop u37t
    dash clear
    capture quietly dash `0' name(zu37`k')
    if _rc {
        global u37_s "rc `=_rc'"
        global u37_v "rc `=_rc'"
        global u37_ws "(twoway drawn)"
        global u37_wv "(twoway drawn)"
        exit
    }
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u37_m; _u37_m._u37_regions("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py", "`dir'/t`k'.svg", "`dir'/t0.svg")
end

* ==== S37 D11: The region remainder ====
local only : env WP31_ONLY
if inlist("`only'", "", "S37") & `: list posof "S37" in w31_run' {
    display as text "S37 start " c(current_date) " " c(current_time)
    local u37d "`w31_work'/s37"
    capture mkdir "`u37d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear
    capture graph drop u37t
    quietly twoway scatter mpg weight, name(u37t, replace)
    quietly graph export "`u37d'/t0.svg", replace
    graph drop u37t

    // U37-01: graphregion(margin(large)) grows each border by twoway's
    // gap change, saved and served; no "not implemented" note.
    local bad ""
    _u37_reg "`u37d'" 1 scatter mpg weight, graphregion(margin(large))
    foreach m in s v {
        if `"${u37_`m'}"' != `"${u37_w`m'}"' local bad `"`bad' `m': dash ${u37_`m'} twoway ${u37_w`m'};"'
    }
    python: import __main__ as _u37_m; _u37_m._u37_notes("`u37d'/s1.json", "`u37d'/d1.json")
    if `"${u37_n}"' != "" local bad `"`bad' notes: ${u37_n};"'
    _w31_expect U37-01 `"(`"`bad'"' == "")"' `"`bad'"'
    _w31_done U37-01 "graphregion(margin(large)) moves the borders by twoway's gaps, saved and served, silently"

    // U37-02: intensity() on both regions mixes their fills as twoway.
    local bad ""
    _u37_reg "`u37d'" 2 scatter mpg weight, plotregion(intensity(inten50)) graphregion(intensity(inten80))
    foreach m in s v {
        if `"${u37_`m'}"' != `"${u37_w`m'}"' local bad `"`bad' `m': dash ${u37_`m'} twoway ${u37_w`m'};"'
    }
    _u37_reg "`u37d'" 3 scatter mpg weight, plotregion(fcolor(navy) intensity(inten50)) graphregion(fcolor(navy) intensity(*.5))
    foreach m in s v {
        if `"${u37_`m'}"' != `"${u37_w`m'}"' local bad `"`bad' navy `m': dash ${u37_`m'} twoway ${u37_w`m'};"'
    }
    _w31_expect U37-02 `"(`"`bad'"' == "")"' `"`bad'"'
    _w31_done U37-02 "intensity() mixes the plot and graph region fills as twoway does, saved and served"

    // U37-03: shadestyle(none) and the s1 family leave the plot region
    // unfilled; plotregion(fcolor()) fills it; s2color keeps its colour.
    local bad ""
    local j 3
    foreach c in `"scatter mpg weight, plotregion(shadestyle(none))"' ///
        `"scatter mpg weight, scheme(s1color)"' ///
        `"scatter mpg weight, scheme(s1color) plotregion(fcolor(yellow))"' ///
        `"scatter mpg weight, scheme(s1color) graphregion(fcolor(red))"' ///
        `"scatter mpg weight, scheme(s1mono)"' ///
        `"scatter mpg weight, scheme(s2color)"' {
        local ++j
        _u37_reg "`u37d'" `j' `c'
        foreach m in s v {
            local _dg "${u37_`m'}"
            local _wg "${u37_w`m'}"
            gettoken d1 rest : _dg
            gettoken d2 rest : rest
            gettoken w1 rest : _wg
            gettoken w2 rest : rest
            if "`d1' `d2'" != "`w1' `w2'" local bad `"`bad' case `j' `m': dash `d1' `d2' twoway `w1' `w2';"'
        }
    }
    _w31_expect U37-03 `"(`"`bad'"' == "")"' `"`bad'"'
    _w31_done U37-03 "shadestyle(none) and the s1 family's shadestyle plotregion none leave the plot region unfilled, saved and served"

    // U37-05: ifcolor() fills the border; ilcolor() is named once, alone.
    local bad ""
    _u37_reg "`u37d'" 20 scatter mpg weight, graphregion(ifcolor(red) ilcolor(blue))
    foreach m in s v {
        local _dg "${u37_`m'}"
        gettoken d1 rest : _dg
        if "`d1'" != "#ff0000" local bad `"`bad' `m' border `d1';"'
    }
    python: import __main__ as _u37_m; _u37_m._u37_notes("`u37d'/s20.json", "`u37d'/d20.json")
    if `"${u37_n}"' != "dash: graphregion() sub-option(s) not implemented and ignored: ilcolor(blue)" {
        local bad `"`bad' notes: ${u37_n};"'
    }
    _w31_expect U37-05 `"(`"`bad'"' == "")"' `"`bad'"'
    _w31_done U37-05 "graphregion(ifcolor()) fills the border; ilcolor() alone is named"

    // U37-06: marginonly drops its own copy's plot-region inner box, and
    // only its own: twoway's inner rect, drawn or not, against dash's
    // inner box, saved and served.
    local bad ""
    local j 20
    foreach c in `"scatter mpg weight, plotregion(ifcolor(red) marginonly)"' ///
        `"scatter mpg weight, plotregion(ilcolor(blue) ilwidth(thick) marginonly)"' ///
        `"scatter mpg weight, plotregion(ifcolor(red))"' ///
        `"scatter mpg weight, plotregion(ifcolor(red)) plotregion(margin(l+5) marginonly)"' ///
        `"scatter mpg weight, plotregion(margin(l+5) marginonly) plotregion(ifcolor(red))"' ///
        `"scatter mpg weight, plotregion(fcolor(red)) plotregion(margin(l+5) marginonly)"' ///
        `"scatter mpg weight, plotregion(fcolor(red) marginonly) plotregion(lcolor(blue))"' {
        local ++j
        _u37_reg "`u37d'" `j' `c'
        foreach m in s v {
            local _dg "${u37_`m'}"
            local _wg "${u37_w`m'}"
            gettoken d1 rest : _dg
            gettoken d2 rest : rest
            gettoken w1 rest : _wg
            gettoken w2 rest : rest
            if "`d1' `d2'" != "`w1' `w2'" local bad `"`bad' case `j' `m': dash `d1' `d2' twoway `w1' `w2';"'
        }
        python: import __main__ as _u37_m; _u37_m._u37_inner("`u37d'/s`j'.json", "`u37d'/d`j'.json", "`u37d'/a`j'.py", "`u37d'/t`j'.svg")
        if `"${u37_n}"' != "" local bad `"`bad' case `j': ${u37_n};"'
    }
    _w31_expect U37-06 `"(`"`bad'"' == "")"' `"`bad'"'
    _w31_done U37-06 "plotregion(marginonly) drops its own copy's fill and inner box, as twoway does, saved and served"

    macro drop u37_s u37_v u37_ws u37_wv u37_n
    capture graph drop _all
    dash clear
    display as text "S37 end " c(current_date) " " c(current_time)
}
* ==== end S37 ====

python:
def _u38_tw(svg):
    """twoway's added xline in *svg* against its plot region and canvas:
    "beyond" (outside the plot region, on the canvas), "inside" or
    "off", into u38_tw."""
    import svg_truth
    from sfi import Macro
    doc = svg_truth.svg_document(svg)
    pr = doc["plotregion"]
    w = doc["canvas"]["w"]
    xs = [d["x1"] for d in doc["vlines"]
          if d["stroke"] == "#c10534" and abs(d["x1"] - d["x2"]) < 0.01]
    out = []
    for x in xs:
        if pr["left"] - 0.5 <= x <= pr["right"] + 0.5:
            out.append("inside")
        elif 0 <= x <= w:
            out.append("beyond")
        else:
            out.append("off")
    Macro.setGlobal("u38_tw", " ".join(out) or "none")


def _u38_lines(sp, dp, app, pos, base):
    """dash's reference lines of an xline(<pos>) build, saved and served:
    "" when each figure holds one Span per position at that location, no
    Arrow, and an x range equal to the no-line build *base*'s (sp/dp/app
    of the k=0 case); else what differs, into u38_n."""
    import __main__ as m
    from bokeh.models import Arrow, Span
    from sfi import Macro
    want = [float(v) for v in pos.split()]
    a, b = m._u03_docs(sp, dp, app)
    a0, b0 = m._u03_docs(*base)
    out = []
    for figs, figs0, sfx in ((a, a0, "saved"), (b, b0, "served")):
        f, f0 = figs[0], figs0[0]
        sp_ = sorted(float(s.location) for s in f.center
                     if isinstance(s, Span) and s.dimension == "height"
                     and s.visible)
        ar = [x for x in f.center if isinstance(x, Arrow)
              and x.start is None and x.end is None]
        if sp_ != sorted(want):
            out.append("%s spans %s" % (sfx, sp_))
        if ar:
            out.append("%s %d arrows" % (sfx, len(ar)))
        if (f.x_range.start, f.x_range.end) != (f0.x_range.start,
                                                f0.x_range.end):
            out.append("%s x range %s %s, without the line %s %s" % (
                sfx, f.x_range.start, f.x_range.end, f0.x_range.start,
                f0.x_range.end))
    Macro.setGlobal("u38_n", "; ".join(out))


def _u38_zoom(sp, dp, app, node):
    """The y range of an xline(3000, noextend) build carries one zoom
    CustomJS on change:start and change:end holding the reference-line
    statement after the finishing guard, saved and served; with *node*,
    the saved page's callback run under node with the range widened by 10
    on each side writes the arrow's ends _dash_refline_extents writes
    (1e-9).  "" or what differs, into u38_n."""
    import json
    import __main__ as m
    import dash_render as dr
    import js_runner
    from bokeh.models import Arrow, CustomJS, FixedTicker, Range1d
    from sfi import Macro
    stmt = ("for (const grp of plan) for (const p of grp.panels) "
            "if (p.lines && p.lines.some(l => l.range === ri)) "
            "dash_refline_extent(p, models);")
    a, b = m._u03_docs(sp, dp, app)
    out = []
    for figs, sfx in ((a, "saved"), (b, "served")):
        f = figs[0]
        cbs = f.y_range.js_property_callbacks or {}
        got = [[c for c in cbs.get("change:" + k, ())
                if isinstance(c, CustomJS) and stmt in (c.code or "")]
               for k in ("start", "end")]
        if [len(g) for g in got] != [1, 1] or got[0][0] is not got[1][0]:
            out.append("%s callbacks %s" % (sfx, [len(g) for g in got]))
            continue
        code = got[0][0].code
        if code.index("cb_obj._dash_finishing") > code.index(stmt):
            out.append("%s statement before the guard" % sfx)
        if not node or sfx != "saved":
            continue
        cb = got[0][0]
        models = cb.args["models"]
        stubs = []
        for md in models:
            if isinstance(md, Range1d):
                stubs.append({"start": md.start, "end": md.end})
            elif isinstance(md, Arrow):
                stubs.append({k: getattr(md, k) for k in
                              ("x_start", "x_end", "y_start", "y_end")})
            elif isinstance(md, FixedTicker):
                stubs.append({"ticks": list(md.ticks)})
            else:
                stubs.append({})
        ri = models.index(f.y_range)
        arrow = f._dash_refline_arrows[0][0]
        ai = models.index(arrow)
        js = ("const plan_json = " + json.dumps(cb.args["plan_json"]) + ";\n"
              + "const models = " + json.dumps(stubs) + ";\n"
              + "const cb_obj = models[%d];\n" % ri
              + "cb_obj.start -= 10; cb_obj.end += 10;\n" + code + "\n"
              + "process.stdout.write(JSON.stringify([models[%d].y_start, "
                "models[%d].y_end]));\n" % (ai, ai))
        js_ends = js_runner.run_js(js)
        s0, e0 = f.y_range.start, f.y_range.end
        f.y_range.start, f.y_range.end = s0 - 10, e0 + 10
        dr._dash_refline_extents(f)
        py = [arrow.y_start, arrow.y_end]
        f.y_range.start, f.y_range.end = s0, e0
        dr._dash_refline_extents(f)
        if any(abs(x - y) > 1e-9 * max(1.0, abs(y))
               for x, y in zip(js_ends, py)) or py == [arrow.y_start,
                                                       arrow.y_end]:
            out.append("node %s, python %s" % (js_ends, py))
    Macro.setGlobal("u38_n", "; ".join(out))
end

capture program drop _u38_build
program define _u38_build
    // _u38_build <dir> <k> <command with options...>: dash's saved and
    // served specs of the command in <dir>/s<k>.json, d<k>.json, a<k>.py;
    // u38_rc its rc and u38_note any dash: line the command printed (log)
    // other than the registration line.
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    dash clear
    capture log close u38log
    quietly log using "`dir'/l`k'.log", text replace name(u38log)
    capture noisily dash `0' name(zu38`k')
    global u38_rc = _rc
    quietly log close u38log
    global u38_note ""
    tempname fh
    file open `fh' using "`dir'/l`k'.log", read text
    file read `fh' line
    while r(eof) == 0 {
        if strpos(`"`macval(line)'"', "dash:") & !strpos(`"`macval(line)'"', "registered.") global u38_note `"`macval(line)'"'
        file read `fh' line
    }
    file close `fh'
    if !${u38_rc} {
        _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    }
end

* ==== S38 D12: Reference lines beyond the frame and through a zoom ====
local only : env WP31_ONLY
if inlist("`only'", "", "S38") & `: list posof "S38" in w31_run' {
    display as text "S38 start " c(current_date) " " c(current_time)
    local u38d "`w31_work'/s38"
    capture mkdir "`u38d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear
    _u38_build "`u38d'" 0 scatter mpg weight,

    // U38-01: twoway draws xline(5100) beyond the plot region, on the
    // canvas (the graph-region strip); dash keeps its one Span at 5100
    // (Bokeh clips every centre annotation to the frame, documented), the
    // x range unchanged, nothing printed.
    local bad ""
    capture graph drop u38t
    quietly twoway scatter mpg weight, xline(5100) name(u38t, replace)
    quietly graph export "`u38d'/t1.svg", replace
    graph drop u38t
    python: import __main__ as _u38_m; _u38_m._u38_tw("`u38d'/t1.svg")
    if "${u38_tw}" != "beyond" local bad `"`bad' twoway ${u38_tw};"'
    _u38_build "`u38d'" 1 scatter mpg weight, xline(5100)
    if ${u38_rc} local bad `"`bad' rc ${u38_rc};"'
    else {
        python: import __main__ as _u38_m; _u38_m._u38_lines("`u38d'/s1.json", "`u38d'/d1.json", "`u38d'/a1.py", "5100", ("`u38d'/s0.json", "`u38d'/d0.json", "`u38d'/a0.py"))
        if `"${u38_n}"' != "" local bad `"`bad' ${u38_n};"'
    }
    if `"${u38_note}"' != "" local bad `"`bad' note: ${u38_note};"'
    _w31_expect U38-01 `"(`"`bad'"' == "")"' `"`bad'"'
    _w31_done U38-01 "xline(5100): twoway draws it beyond the plot region; dash keeps one Span, the axis unchanged, silently"

    // U38-02: twoway writes xline(10000) at a wrapped coordinate inside
    // the plot region (its axis puts it off the canvas); dash keeps a
    // Span at 10000 and 3000 and does not widen the axis.
    local bad ""
    capture graph drop u38t
    quietly twoway scatter mpg weight, xline(10000) name(u38t, replace)
    quietly graph export "`u38d'/t2.svg", replace
    graph drop u38t
    python: import __main__ as _u38_m; _u38_m._u38_tw("`u38d'/t2.svg")
    if "${u38_tw}" != "inside" local bad `"`bad' twoway ${u38_tw};"'
    _u38_build "`u38d'" 2 scatter mpg weight, xline(3000 10000)
    if ${u38_rc} local bad `"`bad' rc ${u38_rc};"'
    else {
        python: import __main__ as _u38_m; _u38_m._u38_lines("`u38d'/s2.json", "`u38d'/d2.json", "`u38d'/a2.py", "3000 10000", ("`u38d'/s0.json", "`u38d'/d0.json", "`u38d'/a0.py"))
        if `"${u38_n}"' != "" local bad `"`bad' ${u38_n};"'
    }
    _w31_expect U38-02 `"(`"`bad'"' == "")"' `"`bad'"'
    _w31_done U38-02 "xline(3000 10000): two Spans, the axis unchanged; twoway's far line is a wrapped coordinate"

    // U38-03: the y range an unextended xline spans carries one zoom
    // callback with the reference-line statement after the finishing
    // guard, saved and served -- also on a fixed-tick axis.
    local bad ""
    local j 2
    foreach o in `"xline(3000, noextend)"' `"xline(3000, noextend) ylabel(10(5)40)"' {
        local ++j
        _u38_build "`u38d'" `j' scatter mpg weight, `o'
        if ${u38_rc} local bad `"`bad' `j' rc ${u38_rc};"'
        else {
            python: import __main__ as _u38_m; _u38_m._u38_zoom("`u38d'/s`j'.json", "`u38d'/d`j'.json", "`u38d'/a`j'.py", False)
            if `"${u38_n}"' != "" local bad `"`bad' `j': ${u38_n};"'
        }
    }
    _w31_expect U38-03 `"(`"`bad'"' == "")"' `"`bad'"'
    _w31_done U38-03 "one zoom callback on every range an unextended reference line spans, counted axis or not, saved and served"

    // U38-04: the saved page's callback under node, the y range widened
    // by 10 each side: the arrow's ends are _dash_refline_extents' (1e-9).
    local bad ""
    python: import __main__ as _u38_m; _u38_m._u38_zoom("`u38d'/s4.json", "`u38d'/d4.json", "`u38d'/a4.py", True)
    if `"${u38_n}"' != "" local bad `"`bad' ${u38_n};"'
    _w31_expect U38-04 `"(`"`bad'"' == "")"' `"`bad'"'
    _w31_done U38-04 "a zoom moves an unextended reference line's ends to the new margin, as the Python finisher writes them"
    dash clear
    display as text "S38 end " c(current_date) " " c(current_time)
}
* ==== end S38 ====

