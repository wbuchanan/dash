    // ------------------------------------------------------------
    // U08-4: the marker-label spellings bind as twoway binds them
    // (fixture mla.*, from each spelling's saved .gph): ml(), mla(),
    // mlab(), mlabe() and mlabel() are mlabel(), and dash records
    // mlabel "make"; mla(center) is refused with twoway's rc and line;
    // mlal(), mlali() and mlalign() are mlalign(), which dash takes;
    // Flipped: WP-31 E3 reads mlalign(), and inside is twoway's default
    // picture, so no note names it.
    // ------------------------------------------------------------
    python: _u08_mla()
    _w31_expect U08-4 "(${u08_mn} == 9)" "the fixture holds ${u08_mn} spellings, want 9"
    local n8m = ${u08_mn}
    forvalues i = 1/`n8m' {
        local opt "${u08_mo`i'}"
        dash clear
        quietly log using "`lf'", text replace name(u08m)
        capture noisily dash scatter mpg weight, `opt' name(u084)
        local rc = _rc
        quietly log close u08m
        _w31_expect U08-4 "(`rc' == ${u08_mr`i'})" "dash scatter mpg weight, `opt' rc `rc', twoway ${u08_mr`i'}"
        if `rc' {
            python: _u08_has("`lf'", "${u08_mt`i'}")
            _w31_expect U08-4 "(${u08_found} == 1)" "dash `opt' did not say twoway's [${u08_mt`i'}]"
            continue
        }
        if "${u08_mb`i'}" == "mlabel" {
            mata: st_local("hit", strofreal(strpos(st_global("dash_json_u084"), char(34) + "mlabel" + char(34) + ":" + char(34) + "make" + char(34)) > 0))
            _w31_expect U08-4 "(`hit' == 1)" "dash `opt' did not record mlabel make"
        }
        if "${u08_mb`i'}" == "mlalign" {
            dash clear
            quietly log using "`lf'", text replace name(u08m)
            capture noisily dash scatter mpg weight, `opt' saving("`u8d'/m.html", replace)
            local rc = _rc
            quietly log close u08m
            _w31_expect U08-4 "(`rc' == 0)" "dash scatter mpg weight, `opt' saving() rc `rc'"
            python: _u08_has("`lf'", "ignoring unsupported option(s): mlalign()")
            _w31_expect U08-4 "(${u08_found} == 0)" "dash `opt' still named mlalign() in its note"
        }
    }
    _w31_done U08-4 "ml() mla() mlab() mlabe() are mlabel(), mla(center) is refused, and mlal() .. mlalign() are mlalign(), read silently at inside, as twoway binds them"

    set linesize `u8ls'
    capture erase "`lf'"
    capture erase "`u8d'/m.html"
    capture rmdir "`u8d'"
