local only : env WP31_ONLY
if inlist("`only'", "", "S47") & `: list posof "S47" in w31_run' {
    display as text "S47 start " c(current_date) " " c(current_time)
    local u47d "`w31_work'/s47"
    capture mkdir "`u47d'"

    // U47-9: scatteri 1.0X+3ff 1 2 2: twoway holds the first point as
    // missing and draws the second only (its serset); dash draws the same
    // one point, saved and served.
    clear
    capture graph drop _all
    capture serset drop _all
    capture twoway scatteri 1.0X+3ff 1 2 2, nodraw
    local trc = _rc
    local tn = -1
    if `trc' == 0 {
        quietly serset set 0
        preserve
        quietly serset use, clear
        quietly ds
        local _s1 : word 1 of `r(varlist)'
        local _s2 : word 2 of `r(varlist)'
        quietly count if !missing(`_s1') & !missing(`_s2')
        local tn = r(N)
        restore
    }
    dash clear
    capture noisily dash scatteri 1.0X+3ff 1 2 2, name(u479)
    local drc = _rc
    _w31_expect U47-9 "(`trc' == 0) & (`drc' == 0) & (`tn' == 1)" "twoway r(`trc') with `tn' drawn point(s), dash r(`drc')"
    if `drc' == 0 {
        _dash_serve_spec, specpath("`u47d'/h.json") datapath("`u47d'/hd.json")
        python: __import__("__main__")._u47_points("`u47d'/h.json", "`u47d'/hd.json", "`u47d'/h_app.py")
        _w31_expect U47-9 `"("${u47_np}" == "1 1")"' `"dash draws ${u47_np} point(s) (saved served)"'
    }
    _w31_done U47-9 "a hexadecimal coordinate past c(maxdouble) is a missing point, as twoway holds it"
    dash clear
    display as text "S47 end " c(current_date) " " c(current_time)
}
* ==== end S47 ====

* ==== S48 H2t: data table ====
local only : env WP31_ONLY
if inlist("`only'", "", "S48") & `: list posof "S48" in w31_run' {
    display as text "S48 start " c(current_date) " " c(current_time)
    local u48d "`w31_work'/s48"
    capture mkdir "`u48d'"
    // table is dash's own option (twoway has no data table): no twoway
    // truth; the spec key and the refusals in dash's words.
    capture program drop _u48_key
    program define _u48_key
        version 19
        args spec
        python: import json as _u48j; from sfi import Macro as _u48M; _u48M.setGlobal("u48_tab", str(_u48j.load(open(r"`spec'", encoding="utf-8"))["graphs"][0]["graph_options"].get("table", "<none>")))
    end
    sysuse auto, clear

    // U48-1: bare table writes "table":"on", in the plot options and after
    // a plot group's comma alike.
    foreach t in table {
        dash clear
        capture noisily dash scatter mpg weight, `t' name(zu48a)
        local drc = _rc
        _dash_serve_spec, specpath("`u48d'/a.json") datapath("`u48d'/ad.json")
        _u48_key "`u48d'/a.json"
        _w31_expect U48-1 `"(`drc' == 0) & ("${u48_tab}" == "on")"' `"`t': rc `drc', table key "${u48_tab}""'
    }
    _w31_done U48-1 "bare table writes graph_options table = on"

    // U48-2: table(rows(50) open) writes the text typed, after the comma
    // of a plot group too.
    dash clear
    capture noisily dash scatter mpg weight, table(rows(50) open) name(zu48b)
    local drc = _rc
    _dash_serve_spec, specpath("`u48d'/b.json") datapath("`u48d'/bd.json")
    _u48_key "`u48d'/b.json"
    _w31_expect U48-2 `"(`drc' == 0) & ("${u48_tab}" == "rows(50) open")"' `"rc `drc', table key "${u48_tab}""'
    dash clear
    capture noisily dash (scatter mpg weight), table(rows(5)) name(zu48c)
    local drc = _rc
    _dash_serve_spec, specpath("`u48d'/c.json") datapath("`u48d'/cd.json")
    _u48_key "`u48d'/c.json"
    _w31_expect U48-2 `"(`drc' == 0) & ("${u48_tab}" == "rows(5)")"' `"graph options: rc `drc', table key "${u48_tab}""'
    _w31_done U48-2 "table(rows(#) open) writes the text typed"

    // U48-3: rows() outside 1..100,000 is refused, r(198), in dash's words.
    foreach v in 0 100001 x {
        dash clear
        capture log close _u48l
        quietly log using "`u48d'/r`v'.log", text replace name(_u48l)
        capture noisily dash scatter mpg weight, table(rows(`v')) name(zu48d)
        local drc = _rc
        quietly log close _u48l
        cert_log_has "`u48d'/r`v'.log", needle("dash: table(rows()) takes an integer from 1 to 100,000; got '`v''")
        _w31_expect U48-3 "(`drc' == 198) & r(found)" "rows(`v'): rc `drc'"
    }
    _w31_done U48-3 "table(rows()) out of range refused r(198)"

    // U48-4: a second table in one option list, or in another, is
    // refused as a second name() is -- a flag named without parentheses,
    // as twoway names one (option headlabel not allowed).
    foreach o in "table table|table" "table(rows(5)) table(rows(6))|table()" {
        gettoken o nm : o, parse("|")
        local nm = substr("`nm'", 2, .)
        dash clear
        capture log close _u48l
        quietly log using "`u48d'/twice.log", text replace name(_u48l)
        capture noisily dash scatter mpg weight, `o' name(zu48e)
        local drc = _rc
        quietly log close _u48l
        cert_log_has "`u48d'/twice.log", needle("option `nm' not allowed")
        _w31_expect U48-4 "(`drc' == 198) & r(found)" "`o': rc `drc'"
    }
    dash clear
    capture noisily dash (scatter mpg weight, table) (line mpg weight, table) , name(zu48f)
    local drc = _rc
    _w31_expect U48-4 "(`drc' == 198)" "table in two plot groups: rc `drc'"
    _w31_done U48-4 "a second table refused r(198)"
    dash clear
    display as text "S48 end " c(current_date) " " c(current_time)
}
* ==== end S48 ====
