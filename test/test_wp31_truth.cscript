* ==== S33 D1c: Minor-label edges ====
local only : env WP31_ONLY
if inlist("`only'", "", "S33") & `: list posof "S33" in w31_run' {
    display as text "S33 start " c(current_date) " " c(current_time)
    local u33d "`w31_work'/s33d"
    capture mkdir "`u33d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(u33t, replace)
    quietly graph export "`u33d'/t0.svg", replace
    graph drop u33t

    // U33-10: an evenly spaced list typed as a list is no rule for ##5
    // (a lone tick at 0); the same list typed as a(b)c is a rule.
    _u33_reg "`u33d'" 10 minor scatter mpg weight, xlabel(1000 2000 3000) xmtick(##5)
    foreach m in s v {
        _w31_expect U33-10 `"("${u33_`m'}" == "${u33_tw}")"' "`m' list: dash ${u33_`m'}; twoway ${u33_tw}"
    }
    _u33_reg "`u33d'" 11 minor scatter mpg weight, xlabel(1000(1000)3000) xmtick(##5)
    _w31_expect U33-10 `"("${u33_tw}" != "lone")"' "twoway drew the rule as a list: ${u33_tw}"
    foreach m in s v {
        _w31_expect U33-10 `"("${u33_`m'}" != "lone")"' "`m' rule: dash ${u33_`m'}"
    }
    _w31_done U33-10 "##5 over a typed list and over its rule as twoway, saved and served"

    macro drop u33_tw u33_s u33_v u33_noted
    capture graph drop _all
    dash clear
    display as text "S33 end " c(current_date) " " c(current_time)
}
