*! test_wp31_truth.cscript
*! WP-31's ONE new certification script (.ultraplan/sections/index.md A5):
*! every comparison with twoway's drawing or with Stata's own values that
*! WP-31's sections need lives here, one block per GAPS3 row, appended
*! above the "append new blocks above this line" marker in section order,
*! so the certification suite grows by one script.  Refusal, message and
*! return-code checks join the EXISTING script for their area (merge rule
*! R1); this script never gains one of those.
*!
*! S01 is the scaffold smoke (U01-1).  A section appends its blocks
*! `* ==== S<NN> <row>: <what> ====` ... `* ==== end S<NN> ====`, its
*! helper programs directly above its first header, and writes only inside
*! its own blocks.  Case ids are U<NN>-<k>.
*!
*! Usage: via run_all_cscripts.do (registered as its block 70).  One
*! block alone: WP31_ONLY=S<NN> in the driver's environment; a section with
*! no block then ends "no case ran" and r(9).  Each block prints "S<NN>
*! start" and "S<NN> end" with the date and time, so S61 can time it.  The
*! suite runs it in every session; DASH_CERT_SHARD=k/N runs part k of N of
*! the blocks (the "parts" section below); a part with no block ends 0.

cscript "WP-31 truth: twoway comparisons" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off

if `"`c(python_exec)'"' == "" {
    display as error "SKIP: Python not available."
    exit 222
}

do "cert_helpers.do"
quietly do "cert_svg.do"
qui do "../dash_parse.mata"
qui do "../dash.ado"
global dash_nobrowser 1

// ----------------------------------------------------------------
// Tally helpers -- test_wp29_truth.cscript's _w29_expect/_w29_done,
// renamed _w31_ for this script.  A case is any number of
// _w31_expect lines closed by one _w31_done.
// ----------------------------------------------------------------
global w31_nfail    = 0
global w31_faillist ""
global w31_bad      = 0
global w31_ncase    = 0

capture program drop _w31_expect
program define _w31_expect
    version 19
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global w31_bad = 1
    }
end

capture program drop _w31_done
program define _w31_done
    version 19
    args id msg
    if ${w31_bad} {
        global w31_nfail    = ${w31_nfail} + 1
        global w31_faillist "${w31_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global w31_bad   = 0
    global w31_ncase = ${w31_ncase} + 1
end

// A fresh directory for this run's files, never one that already exists:
// a fixed name in a shared temp directory could be planted by another
// account (rule 1), so a name Stata has not handed out before is made and
// the run fails if it cannot be.  Every block writes only under it.
tempfile w31_base
local w31_work "`w31_base'_w31"
capture mkdir "`w31_work'"
if _rc {
    display as error "test_wp31_truth: cannot create the work directory `w31_work' (rc `=_rc')"
    exit 9
}

// ---- parts: begin (WP-31 test performance) ----
// The certification suite runs this script in every one of its sessions
// (its row in run_all_cscripts.do's shard table is "* * *"); with
// DASH_CERT_SHARD=k/N set, the session runs part k of N of the blocks.
// The parts are balanced longest first onto the least loaded part (the
// lowest numbered of equals), by the seconds below -- a block not listed
// counts 1 s (section-01 D-01.f) -- the rule scripts/cert_shards.py uses
// for the scripts.  Unset, or with WP31_ONLY set
// (which keeps its precedence), every block runs.  A block runs when its
// gate finds its id in w31_run.
// Seconds: S61 writes each block's measured seconds from the closeout
// certification log's start/end lines; until then only S01 is listed.
local w31_secs ///
    S01 1
local w31_sh : environment DASH_CERT_SHARD
mata: st_local("w31_ok", strofreal(st_local("w31_sh") == "" | ustrregexm(st_local("w31_sh"), "^[1-4]/[1-4]$")))
if !`w31_ok' {
    display as error "test_wp31_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 4"
    exit 198
}
local w31_k 1
local w31_N 1
if "`w31_sh'" != "" {
    local w31_k = real(substr("`w31_sh'", 1, 1))
    local w31_N = real(substr("`w31_sh'", 3, 1))
}
local w31_only : env WP31_ONLY
if `"`macval(w31_only)'"' != "" | `w31_N' == 1 {
    local w31_k 1
    local w31_N 1
}
if `w31_k' > `w31_N' {
    display as error "test_wp31_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 4"
    exit 198
}
capture confirm file "test_wp31_truth.cscript"
if _rc {
    display as error "test_wp31_truth: run it from test/, where it reads its own blocks"
    exit 601
}
capture mata: mata drop _w31_part()
mata:
// The ids of the blocks (their header lines, in file order), and those of
// part k of n: longest first onto the least loaded part.
void _w31_part(string scalar file, string scalar table, real scalar k,
               real scalar n)
{
    string colvector lines, ids
    string rowvector tok
    real colvector sec, o, at
    real rowvector load
    real scalar i, j, p, best
    string scalar run

    lines = cat(file)
    ids = J(0, 1, "")
    for (i = 1; i <= rows(lines); i++) {
        if (ustrregexm(lines[i], "^\* ==== (S[0-9]+) ")) {
            if (!anyof(ids, ustrregexs(1))) ids = ids \ ustrregexs(1)
        }
    }
    sec = J(rows(ids), 1, 1)
    tok = tokens(table)
    for (j = 1; j + 1 <= cols(tok); j = j + 2) {
        for (i = 1; i <= rows(ids); i++) {
            if (ids[i] == tok[j]) sec[i] = strtoreal(tok[j + 1])
        }
    }
    o = order((-sec, (1::rows(ids))), (1, 2))
    load = J(1, n, 0)
    at = J(rows(ids), 1, 0)
    for (i = 1; i <= rows(o); i++) {
        best = 1
        for (p = 2; p <= n; p++) if (load[p] < load[best]) best = p
        load[best] = load[best] + sec[o[i]]
        at[o[i]] = best
    }
    run = ""
    for (i = 1; i <= rows(ids); i++) if (at[i] == k) run = run + " " + ids[i]
    st_local("w31_run", strtrim(run))
}
end
mata: _w31_part("test_wp31_truth.cscript", st_local("w31_secs"), `w31_k', `w31_N')
display as text "test_wp31_truth: part `w31_k'/`w31_N' runs `: word count `w31_run'' blocks: `w31_run'"
// ---- parts: end ----

* ==== S01 scaffold: the helpers load and a twoway SVG is read ====
local only : env WP31_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w31_run' {
    display as text "S01 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // U01-1: cert_svg_export and cert_svg_texts on one twoway scatter,
    // and dash's own programs are loaded from this tree.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(w31s01, replace)
    cert_svg_export, name(w31s01) file("`w31_work'/w31s01.svg")
    local s01_rc   = r(rc)
    local s01_file "`r(file)'"
    _w31_expect U01-1 "(`s01_rc' == 0)" "cert_svg_export rc `s01_rc'"
    capture confirm file "`s01_file'"
    _w31_expect U01-1 "(_rc == 0)" "r(file) `s01_file' does not exist"
    cert_svg_texts, file("`s01_file'")
    local s01_n    = r(n)
    local s01_list "`r(list)'"
    _w31_expect U01-1 "(`s01_n' > 0)" "cert_svg_texts found no text elements"
    capture program list _dash_serve
    _w31_expect U01-1 "(_rc == 0)" "dash.ado's _dash_serve is not loaded"
    _w31_done U01-1 "a twoway SVG was written and read (`s01_n' texts); dash is loaded"

    capture erase "`s01_file'"
    capture erase "`s01_list'"
    capture graph drop w31s01
    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====

// S02 helpers (WP-31 C1).  _u02_heads: what a registered dash arrow graph
// draws for its heads, saved (DashRenderer) and served (the generated
// app's make_document), into globals u02_<what>_<mode>: hpx (the head
// size column), glyph (MultiLine/Patches), line, fill, ends, barb, ang,
// lab (the label set's x field) and rows (the rows the head script reads),
// and same (1 when both modes' head scripts and args agree).
// _u02_chrome: the saved page drawn in headless Chrome, its head strokes'
// length / hpx (min, max) and half-angles (min, max) into u02_c_*.
// _u02_msize: the pixel size of a registered dash scatter's marker.
python:
import os as _u02_os, sys as _u02_sys
for _u02_p in (_u02_os.path.abspath(".."), _u02_os.path.abspath(".")):
    if _u02_p not in _u02_sys.path:
        _u02_sys.path.insert(0, _u02_p)


def _u02_docs(sp, dp, app):
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        page = r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_u02_app")
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_u02_app.py", "exec"),
             ns)
        doc = Document()
        ns["make_document"](doc)
    return r, page, doc


def _u02_rec(models):
    from bokeh.models import CustomJS, LabelSet
    cbs, labs = {}, []
    for root in models:
        for m in root.references():
            if isinstance(m, CustomJS) and m.name == "dash_arrow_head":
                cbs[m.id] = m
            elif isinstance(m, LabelSet):
                labs.append(m)
    [cb] = cbs.values()
    a, g = cb.args, cb.args["hr"].glyph
    hpx = sorted(set(float(v) for v in a["src"].data[a["hpx"]]))
    lab = ""
    if labs:
        x = labs[0].x
        lab = x if isinstance(x, str) else getattr(x, "field", "") or ""
    return {"hpx": " ".join("%.6f" % v for v in hpx),
            "glyph": type(g).__name__, "line": str(g.line_color),
            "fill": str(getattr(g, "fill_color", "")), "ends": a["ends"],
            "barb": "%.6f" % float(a["barb"]), "ang": "%.6f" % float(a["ang"]),
            "lab": lab, "rows": len(a["src"].data[a["x1"]]),
            "sig": (cb.code, a["ends"], float(a["barb"]), float(a["ang"]),
                    hpx, type(g).__name__, str(g.line_color),
                    str(getattr(g, "fill_color", "")), lab)}


def _u02_heads(sp, dp, app):
    from sfi import Macro
    r, page, doc = _u02_docs(sp, dp, app)
    sv = _u02_rec(list(r.figures.values()))
    vv = _u02_rec(list(doc.roots))
    for mode, rec in (("s", sv), ("v", vv)):
        for k, v in rec.items():
            if k != "sig":
                Macro.setGlobal("u02_%s_%s" % (k, mode), str(v))
    Macro.setGlobal("u02_same", "1" if sv["sig"] == vv["sig"] else "0")
    Macro.setGlobal("u02_page", "")
    with open(app + ".html", "w", encoding="utf-8") as fh:
        fh.write(page)


def _u02_chrome(app):
    from sfi import Macro
    import test_arrowheads as ta
    with open(app + ".html", encoding="utf-8") as fh:
        page = fh.read()
    got = ta.chrome_heads(page)
    Macro.setGlobal("u02_c_err", str(got.get("err", "")))
    ratios, halves = [], []
    for layer in got.get("heads", []):
        r_, h_ = ta.head_geometry(layer)
        ratios += r_
        halves += h_
    Macro.setGlobal("u02_c_n", str(len(ratios)))
    if ratios:
        Macro.setGlobal("u02_c_rmin", "%.6f" % min(ratios))
        Macro.setGlobal("u02_c_rmax", "%.6f" % max(ratios))
        Macro.setGlobal("u02_c_amin", "%.6f" % min(halves))
        Macro.setGlobal("u02_c_amax", "%.6f" % max(halves))


def _u02_msize(sp, dp):
    import warnings
    from sfi import Macro
    import dash_render as dr
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
    sizes = [rr.glyph.size for f in r.figures.values() for rr in f.renderers
             if type(rr.glyph).__name__ == "Scatter"]
    Macro.setGlobal("u02_msize", "%.6f" % float(sizes[0]))
end

capture program drop _u02_data
program define _u02_data
    version 19
    // The extract script's five rows, y1 x1 y2 x2: (1 1 2 2) (2 1 3 3)
    // (3 2 4 2) (4 3 5 4) (5 4 6 6).
    clear
    quietly set obs 5
    quietly generate y1 = _n
    quietly generate x1 = real(word("1 1 2 3 4", _n))
    quietly generate y2 = _n + 1
    quietly generate x2 = real(word("2 3 2 4 6", _n))
    quietly generate y2m = y2
    quietly replace y2m = . in 3
    quietly generate str1 lab = word("a b c d e", _n)
end

// _u02_run k "dash command" dir: register and measure one graph.
capture program drop _u02_run
program define _u02_run
    version 19
    args k cmd dir
    dash clear
    quietly dash `cmd' name(zu02`k')
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    // A program's python: line has a namespace of its own; the helpers
    // live in __main__.
    python: __import__("__main__")._u02_heads("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py")
end

* ==== S02 C1: Arrowheads ====
local only : env WP31_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w31_run' {
    display as text "S02 start " c(current_date) " " c(current_time)
    local u2d "`w31_work'/s02"
    capture mkdir "`u2d'"
    local u02_scheme "`c(scheme)'"
    set scheme s2color
    capture graph drop _all
    _u02_data

    // ------------------------------------------------------------
    // U02-01: the default head is twoway's: msize() medium long (the
    // marker dash draws for scatter, msize(medium)), at 28.64 degrees.
    // ------------------------------------------------------------
    quietly twoway pcarrow y1 x1 y2 x2, name(u02t, replace)
    local tsz "`.u02t.plotregion1.plot1.style.marker.size.val'"
    local tang "`.u02t.plotregion1.plot1.style.marker.angle.val'"
    _w31_expect U02-01 "(abs(`tsz' - 1.52778) < 1e-4) & (`tang' == 28.64)" "twoway's head size `tsz', angle `tang'"
    dash clear
    quietly dash scatter y1 x1, msize(medium) name(zu02m)
    _dash_serve_spec, specpath("`u2d'/sm.json") datapath("`u2d'/dm.json")
    python: _u02_msize("`u2d'/sm.json", "`u2d'/dm.json")
    _u02_run 1 "pcarrow y1 x1 y2 x2," "`u2d'"
    foreach m in s v {
        _w31_expect U02-01 "(abs(${u02_hpx_`m'} - ${u02_msize}) < 1e-9)" "`m': head ${u02_hpx_`m'} px, scatter msize(medium) ${u02_msize} px"
        _w31_expect U02-01 "(abs(${u02_ang_`m'} - 28.64 * c(pi) / 180) < 1e-6)" "`m': angle ${u02_ang_`m'}"
    }
    _w31_expect U02-01 "(${u02_same} == 1)" "the saved and served head scripts differ"
    python: _u02_chrome("`u2d'/a1.py")
    _w31_expect U02-01 `"("${u02_c_err}" == "") & (${u02_c_n} == 10)"' "Chrome drew ${u02_c_n} strokes (${u02_c_err})"
    _w31_expect U02-01 "(abs(${u02_c_rmin} - 1) < .02) & (abs(${u02_c_rmax} - 1) < .02)" "stroke / hpx ${u02_c_rmin}..${u02_c_rmax}"
    _w31_expect U02-01 "(abs(${u02_c_amin} - 28.64) < .5) & (abs(${u02_c_amax} - 28.64) < .5)" "half-angle ${u02_c_amin}..${u02_c_amax}"
    _w31_done U02-01 "the head is msize(medium) long at 28.64 degrees, as twoway's, saved and served"

    // ------------------------------------------------------------
    // U02-02: msize(large) scales the head as twoway scales it.
    // ------------------------------------------------------------
    quietly twoway pcarrow y1 x1 y2 x2, msize(large) name(u02t, replace)
    local tl "`.u02t.plotregion1.plot1.style.marker.size.val'"
    local hs "${u02_hpx_s}"
    _u02_run 2 "pcarrow y1 x1 y2 x2, msize(large)" "`u2d'"
    foreach m in s v {
        _w31_expect U02-02 "(abs((${u02_hpx_`m'} / `hs') / (`tl' / `tsz') - 1) < .02)" "`m': large/default ${u02_hpx_`m'}/`hs' against twoway `tl'/`tsz'"
    }
    _w31_done U02-02 "msize(large) scales the head as twoway's, saved and served"

    // ------------------------------------------------------------
    // U02-03: barbsize(medium) fills a closed head in the series colour;
    // barbsize() = msize() puts the back point at the foot of A's
    // perpendicular (the right angle at B); mangle(45); the default is
    // open; pcbarrow heads both ends.
    // ------------------------------------------------------------
    quietly twoway pcarrow y1 x1 y2 x2, barbsize(medium) name(u02t, replace)
    local tb "`.u02t.plotregion1.plot1.style.marker.backsize.val'"
    _w31_expect U02-03 "(abs(`tb' - `tsz') < 1e-4)" "twoway's backsize `tb'"
    _u02_run 3 "pcarrow y1 x1 y2 x2, barbsize(medium)" "`u2d'"
    foreach m in s v {
        _w31_expect U02-03 `"("${u02_glyph_`m'}" == "Patches") & ("${u02_fill_`m'}" == "#1a476f")"' "`m': ${u02_glyph_`m'} filled ${u02_fill_`m'}"
        _w31_expect U02-03 "(abs(${u02_barb_`m'} - ${u02_hpx_`m'}) < 1e-6)" "`m': barb ${u02_barb_`m'} against msize ${u02_hpx_`m'} (right angle at B)"
    }
    quietly twoway pcarrow y1 x1 y2 x2, mangle(45) name(u02t, replace)
    local t45 "`.u02t.plotregion1.plot1.style.marker.angle.val'"
    _u02_run 4 "pcarrow y1 x1 y2 x2, mangle(45)" "`u2d'"
    foreach m in s v {
        _w31_expect U02-03 "(`t45' == 45) & (abs(${u02_ang_`m'} - c(pi) / 4) < 1e-6)" "`m': mangle(45) angle ${u02_ang_`m'}, twoway `t45'"
    }
    _u02_run 5 "pcbarrow y1 x1 y2 x2," "`u2d'"
    foreach m in s v {
        _w31_expect U02-03 `"("${u02_glyph_`m'}" == "MultiLine") & (${u02_ends_`m'} == 2)"' "`m': pcbarrow ${u02_glyph_`m'} ends ${u02_ends_`m'}"
    }
    _u02_run 6 "pcarrow y1 x1 y2 x2," "`u2d'"
    foreach m in s v {
        _w31_expect U02-03 `"("${u02_glyph_`m'}" == "MultiLine") & (${u02_ends_`m'} == 1)"' "`m': pcarrow ${u02_glyph_`m'} ends ${u02_ends_`m'}"
    }
    _w31_done U02-03 "barbsize() fills the head, mangle() turns it, pcbarrow heads both ends, saved and served"

    // ------------------------------------------------------------
    // U02-04: mlcolor() strokes, mfcolor() fills.
    // ------------------------------------------------------------
    _u02_run 7 "pcarrow y1 x1 y2 x2, mcolor(red) mlcolor(blue) mfcolor(green) barbsize(medium)" "`u2d'"
    foreach m in s v {
        _w31_expect U02-04 `"("${u02_line_`m'}" == "#0000ff") & ("${u02_fill_`m'}" == "#008000")"' "`m': line ${u02_line_`m'} fill ${u02_fill_`m'}"
    }
    _w31_done U02-04 "the head is stroked in mlcolor() and filled in mfcolor(), saved and served"

    // ------------------------------------------------------------
    // U02-05: a row missing its second point draws nothing, as twoway
    // (fixture onepoint: one shaft and two strokes fewer, no marker).
    // ------------------------------------------------------------
    _u02_run 8 "pcarrow y1 x1 y2m x2," "`u2d'"
    foreach m in s v {
        _w31_expect U02-05 "(${u02_rows_`m'} == 4)" "`m': ${u02_rows_`m'} rows headed"
    }
    _w31_done U02-05 "a row missing its second point draws no head and no marker, saved and served"

    // ------------------------------------------------------------
    // U02-06: headlabel labels the head.
    // ------------------------------------------------------------
    _u02_run 9 "pcarrow y1 x1 y2 x2, mlabel(lab) headlabel" "`u2d'"
    foreach m in s v {
        _w31_expect U02-06 `"("${u02_lab_`m'}" == "x2")"' "`m': headlabel labels at ${u02_lab_`m'}"
    }
    _u02_run 10 "pcarrow y1 x1 y2 x2, mlabel(lab)" "`u2d'"
    foreach m in s v {
        _w31_expect U02-06 `"("${u02_lab_`m'}" == "x1")"' "`m': labels at ${u02_lab_`m'}"
    }
    _w31_done U02-06 "headlabel puts the labels at the head, saved and served"

    local u02f : dir "`u2d'" files "*"
    foreach f of local u02f {
        capture erase "`u2d'/`f'"
    }
    capture rmdir "`u2d'"
    capture graph drop _all
    dash clear
    set scheme `u02_scheme'
    macro drop u02_*
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

// S03 helpers (WP-31 C2, B5a).  _u03_draw: what a registered dash graph
// draws, saved and served -- the glyph types, the Rect widths and width
// units, the VBar widths and the Scatter sizes -- into globals u03_<k>s
// (saved) and u03_<k>v (served); _u03_svg: twoway's median bar width over
// min(W, H) * 100 from an SVG, into u03_ratio.
python:
import os as _u03_os, sys as _u03_sys
for _u03_p in (_u03_os.path.abspath(".."),
               _u03_os.path.abspath(_u03_os.path.join("..", "scripts"))):
    if _u03_p not in _u03_sys.path:
        _u03_sys.path.insert(0, _u03_p)


def _u03_docs(sp, dp, app):
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_u03_app")
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_u03_app.py", "exec"),
             ns)
        doc = Document()
        ns["make_document"](doc)
    sv = [m for m in doc.models if type(m).__name__ == "figure"]
    return list(r.figures.values()), sv


def _u03_draw(sp, dp, app):
    from sfi import Macro
    a, b = _u03_docs(sp, dp, app)
    for figs, sfx in ((a, "s"), (b, "v")):
        out = {"k": [], "w": [], "u": [], "b": [], "m": [], "y0": [],
               "y1": []}
        for f in figs:
            out["y0"].append(float(f.y_range.start))
            out["y1"].append(float(f.y_range.end))
            for r in f.renderers:
                g = getattr(r, "glyph", None)
                t = type(g).__name__
                if t not in ("Rect", "VBar", "Scatter", "Line"):
                    continue
                out["k"].append(t)
                if t == "Rect":
                    out["w"].append("%.12g" % float(getattr(g.width, "value",
                                                            g.width)))
                    out["u"].append(str(g.width_units))
                elif t == "VBar":
                    out["b"].append("%.12g" % float(getattr(g.width, "value",
                                                            g.width)))
                elif t == "Scatter":
                    out["m"].append("%.12g" % float(g.size))
        for k, v in out.items():
            Macro.setGlobal("u03_%s%s" % (k, sfx),
                            " ".join(str(x) if not isinstance(x, str) else x
                                     for x in v))


def _u03_svg(path):
    from sfi import Macro
    from svg_truth import svg_document
    doc = svg_document(path)
    cw = doc["canvas"]["w"]
    narrow = [r for r in doc["rects"] if r["w"] and r["h"]
              and 0 < r["w"] < cw / 3.0 and r["h"] > 0]
    fills = {}
    for r in narrow:
        fills[r["fill"]] = fills.get(r["fill"], 0) + 1
    ws = sorted(r["w"] for r in narrow
                if fills and r["fill"] == max(fills, key=fills.get))
    m = min(doc["canvas"]["w"], doc["canvas"]["h"])
    Macro.setGlobal("u03_ratio",
                    "%.6g" % (100.0 * ws[len(ws) // 2] / m) if ws else "-1")
end

capture program drop _u03_reg
program define _u03_reg
    // _u03_reg <dir> <k> <dash command...>: register one graph, write its
    // spec and data, and read what both modes draw (_u03_draw).
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    dash clear
    quietly dash `0'
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    // Qualified through __main__: a bare name is not found from inside a
    // program (cert_svg.do's TRAP note).
    python: import __main__ as _u03_m; _u03_m._u03_draw("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py")
end

capture program drop _u03_all
program define _u03_all, rclass
    // _u03_all <want> <list...>: 1 when the list is not empty and every
    // value equals <want> to 1e-6 (relative).
    version 19
    gettoken want 0 : 0
    local ok = (`: word count `0'' > 0)
    foreach v of local 0 {
        if abs(`v' - (`want')) > 1e-6 * max(1, abs(`want')) local ok = 0
    }
    return scalar ok = `ok'
end

* ==== S03 C2: rbar mwidth ====
local only : env WP31_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w31_run' {
    display as text "S03 start " c(current_date) " " c(current_time)
    local u3d "`w31_work'/s03"
    capture mkdir "`u3d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear
    quietly generate yl = mpg - 1
    quietly generate yh = mpg + 1

    // ------------------------------------------------------------
    // U03-01: rbar mwidth is as wide as a medium marker, in screen units,
    // both modes; twoway's width over min(W, H) * 100 is its marker size.
    // ------------------------------------------------------------
    quietly twoway rbar yl yh weight, mwidth name(u03t, replace)
    local msv = `.u03t.plotregion1.plot1.style.marker.size.val'
    quietly graph export "`u3d'/t1.svg", replace
    python: _u03_svg("`u3d'/t1.svg")
    _w31_expect U03-01 "(abs(${u03_ratio} - `msv') <= .01 * `msv')" "twoway ratio ${u03_ratio}, marker.size.val `msv'"
    _u03_reg "`u3d'" 1 scatter mpg weight, name(zu1)
    local m0 "${u03_ms}"
    _u03_all `m0' ${u03_mv}
    _w31_expect U03-01 "(r(ok))" "dash scatter marker saved `m0' served ${u03_mv}"
    _u03_reg "`u3d'" 2 rbar yl yh weight, mwidth name(zu2)
    _u03_all `m0' ${u03_ws} ${u03_wv}
    _w31_expect U03-01 "(r(ok))" "Rect width saved ${u03_ws} served ${u03_wv}, marker `m0'"
    _w31_expect U03-01 `"("${u03_us} ${u03_uv}" == "screen screen")"' "width units ${u03_us} / ${u03_uv}"
    _w31_done U03-01 "rbar mwidth is a medium marker (`m0' px) wide in screen units, saved and served; twoway's ratio is its marker size"

    // ------------------------------------------------------------
    // U03-02: mwidth msize(large) is a large marker wide at both x
    // spacings (weight, turn), both modes.
    // ------------------------------------------------------------
    _u03_reg "`u3d'" 3 scatter mpg weight, msize(large) name(zu3)
    local ml "${u03_ms}"
    foreach xv in weight turn {
        quietly twoway rbar yl yh `xv', mwidth msize(large) name(u03t, replace)
        local msv = `.u03t.plotregion1.plot1.style.marker.size.val'
        quietly graph export "`u3d'/t2`xv'.svg", replace
        python: _u03_svg("`u3d'/t2`xv'.svg")
        _w31_expect U03-02 "(abs(${u03_ratio} - `msv') <= .01 * `msv')" "twoway on `xv': ratio ${u03_ratio}, marker.size.val `msv'"
        _u03_reg "`u3d'" 4`xv' rbar yl yh `xv', mwidth msize(large) name(zu4`xv')
        _u03_all `ml' ${u03_ws} ${u03_wv}
        _w31_expect U03-02 "(r(ok))" "on `xv': Rect width saved ${u03_ws} served ${u03_wv}, large marker `ml'"
    }
    _w31_done U03-02 "rbar mwidth msize(large) is a large marker (`ml' px) wide on weight and turn, saved and served"

    // ------------------------------------------------------------
    // U03-03: msize(large) without mwidth: the VBar is one x unit wide, as
    // before, and the note names msize() once.
    // ------------------------------------------------------------
    local lf "`u3d'/n3.log"
    dash clear
    quietly log using "`lf'", text replace name(u03n)
    dash rbar yl yh weight, msize(large) name(zu5)
    quietly log close u03n
    _dash_serve_spec, specpath("`u3d'/s5.json") datapath("`u3d'/d5.json")
    python: _u03_draw("`u3d'/s5.json", "`u3d'/d5.json", "`u3d'/a5.py")
    _u03_all 1 ${u03_bs} ${u03_bv}
    _w31_expect U03-03 "(r(ok))" "VBar width saved ${u03_bs} served ${u03_bv}"
    _w31_expect U03-03 `"("${u03_ks} ${u03_kv}" == "VBar VBar")"' "glyphs ${u03_ks} / ${u03_kv}"
    cert_log_has "`lf'", needle("msize()")
    _w31_expect U03-03 "(r(count) == 1)" "the log names msize() `r(count)' times"
    _w31_done U03-03 "rbar msize(large) without mwidth draws the one-unit VBar and names msize() once"

    capture erase "`lf'"
    foreach f in t1.svg t2weight.svg t2turn.svg {
        capture erase "`u3d'/`f'"
    }
    foreach k in 1 2 3 4weight 4turn 5 {
        foreach p in s d {
            capture erase "`u3d'/`p'`k'.json"
        }
        capture erase "`u3d'/a`k'.py"
    }
    capture rmdir "`u3d'"
    capture graph drop u03t
    dash clear
    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

* ==== append new blocks above this line ====

// ----------------------------------------------------------------
// Summary (test_wp29_truth.cscript's shape)
// ----------------------------------------------------------------
capture graph drop _all
capture dash clear
capture rmdir "`w31_work'"
local nfail    = ${w31_nfail}
local faillist "${w31_faillist}"
local ncase    = ${w31_ncase}
local only : env WP31_ONLY
macro drop w31_nfail w31_faillist w31_bad w31_ncase
display as text ""
display as text "============================================================"
if `ncase' == 0 {
    if `w31_N' > 1 & `"`macval(only)'"' == "" & "`w31_run'" == "" {
        display as text "test_wp31_truth: part `w31_k'/`w31_N' has no block to run"
        display as text "============================================================"
        exit 0
    }
    // A WP31_ONLY that names no block, or only a stub, ran nothing:
    // that is not a pass.
    display as error "  test_wp31_truth: no case ran (WP31_ONLY=`only')"
    display as text "============================================================"
    exit 9
}
else if `nfail' == 0 {
    display as text "  test_wp31_truth: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_wp31_truth: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
