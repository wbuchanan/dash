python:
def _u41_glyphs(sp, dp, app, kind):
    """[(saved glyphs), (served glyphs)] of class *kind* in the first
    figure, swatches left out, with the saved render's notes."""
    import __main__ as m
    import warnings
    import dash_render as dr
    a, b = m._u03_docs(sp, dp, app)
    out = []
    for figs in (a, b):
        out.append([r.glyph for r in figs[0].renderers
                    if type(getattr(r, "glyph", None)).__name__ == kind
                    and not dr._dash_is_swatch(r)])
    with warnings.catch_warnings(record=True) as w:
        warnings.simplefilter("always")
        dr.DashRenderer(sp, dp).render()
    return out, [str(x.message) for x in w]


def _u41_truth(fixture, key):
    import json
    with open(fixture, encoding="utf-8") as fh:
        return json.load(fh)[key]


def _u41_hist(sp, dp, app, fixture):
    """U41-09: the bars' opacity in both modes against hist.pct."""
    import __main__ as m
    from sfi import Macro
    rec = _u41_truth(fixture, "hist.pct")
    want = [float(e[5]) for e in rec["elements"]
            if e[0] == "rect" and e[1] == "#cac27e"][0]
    (a, b), _ = _u41_glyphs(sp, dp, app, "Quad")
    bad = []
    for name, gs in (("saved", a), ("served", b)):
        if not gs or abs(float(gs[0].fill_alpha) - want) > 1e-9:
            bad.append("%s fill_alpha %s, twoway %s" % (
                name, [g.fill_alpha for g in gs[:1]], want))
    Macro.setGlobal("u41_bad", "; ".join(bad))
end

capture program drop _u41_spec
program define _u41_spec
    // _u41_spec <dir> <k> <dash command>: dash's spec for the command.
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    dash clear
    quietly dash `0' name(zu41`k')
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
end

