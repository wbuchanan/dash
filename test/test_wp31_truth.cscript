* ==== S33 E6: Line-width edges ====
local only : env WP31_ONLY
if inlist("`only'", "", "S33") & `: list posof "S33" in w31_run' {
    display as text "S33 start " c(current_date) " " c(current_time)
    local u33d "`w31_work'/s33c"
    capture mkdir "`u33d'"
    capture graph drop _all
    sysuse auto, clear
    // A scheme whose xyline is vvthin: s2color with that one line changed.
    python: _u33_vvthin(r"`c(sysdir_base)'", r"`u33d'")
    adopath ++ "`u33d'"
    set scheme s2color
    quietly twoway scatter mpg weight, name(u33t, replace)
    quietly graph export "`u33d'/t0.svg", replace
    graph drop u33t

    // U33-08: lwidth(*2) multiplies before the floor, under vvthin and
    // under s2color's medium.
    _u33_reg "`u33d'" 8 xline scatter mpg weight, xline(3000, lwidth(*2)) scheme(u33vvthin)
    foreach m in s v {
        _w31_expect U33-08 `"("${u33_`m'}" == "${u33_tw}")"' "`m' vvthin: dash ${u33_`m'}; twoway ${u33_tw}"
    }
    _u33_reg "`u33d'" 9 xline scatter mpg weight, xline(3000, lwidth(*2))
    foreach m in s v {
        _w31_expect U33-08 `"("${u33_`m'}" == "${u33_tw}")"' "`m' medium: dash ${u33_`m'}; twoway ${u33_tw}"
    }
    _w31_done U33-08 "xline(, lwidth(*2)) floored after the multiply, saved and served"

    macro drop u33_tw u33_s u33_v u33_noted
    capture graph drop _all
    dash clear
    set scheme s2color
    display as text "S33 end " c(current_date) " " c(current_time)
}
