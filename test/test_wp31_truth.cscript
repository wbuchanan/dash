// S23 B4a helper.  _u23_check(case, arg): one comparison of dash's
// contour surface helpers with twoway's generator, read from
// fixtures/contour_truth.json (scripts/extract_contour_truth.do) or from
// a node matrix measured live (u23_M, Mata, _contour_heatmap's); globals u23_ok (1 when
// it holds) and u23_msg (what was compared).
python:
def _u23_check(case, arg=""):
    import json
    import os
    import sys
    import numpy as np
    for p in (os.path.abspath(".."), os.path.abspath(".")):
        if p not in sys.path:
            sys.path.insert(0, p)
    import dash_render as dr
    from sfi import Macro, Mata
    with open(os.path.join("fixtures", "contour_truth.json"), encoding="utf-8") as fh:
        t = json.load(fh)
    ok, msg = True, ""

    def node_index(hm, gx, gy):
        return (np.searchsorted(gy, np.asarray(hm["y0"]), side="left"),
                np.searchsorted(gx, np.asarray(hm["x0"]), side="left"))

    if case == 1:
        for ds in ("auto", "synthetic", "manual5"):
            inp = t["cases"][ds]["thinplatespline"]["input"]
            g = dr._dash_contour_grid(inp["x"], inp["y"])
            for axis, a in zip(("x", "y"), g):
                e = np.concatenate([[a[0]], (a[1:] + a[:-1]) / 2, [a[-1]]])
                want = np.asarray(t["grid"][ds][axis])
                ok &= e.shape == want.shape and bool(np.allclose(e, want, rtol=1e-6))
            msg += "%s %dx%d; " % (ds, g[0].size, g[1].size)
    elif case == 2:
        m = Mata.get("u23_M")
        node = [r[2] for r in m if r[0] == 2 and r[1] == 2]
        px, py, pz = dr._dash_contour_points([1, 2, 1, 2, 2], [1, 1, 2, 2, 2],
                                             [1, 2, 3, 4, 5])
        ok = pz.size == 4 and pz[-1] == 4 and node == [4.0]
        hm = t["cases"]["manual5"]["none"]["nodes"]
        lev = [lv for x0, x1, y0, y1, lv in zip(hm["x0"], hm["x1"], hm["y0"],
                                               hm["y1"], hm["lev"])
               if x0 <= 2 <= x1 and y0 <= 2 <= y1][0]
        ok &= int(np.searchsorted(t["cases"]["manual5"]["none"]["cuts"], 4.0,
                                  side="right")) + 1 == lev
        msg = "dash keeps z %g of 4 rows; twoway's interp(none) node %s, level %d" % (
            pz[-1], node, lev)
    elif case == 3:
        for ds in ("auto", "synthetic", "manual5"):
            for it in ("thinplatespline", "shepard"):
                c = t["cases"][ds][it]
                inp, hm, cuts = c["input"], c["nodes"], np.asarray(c["cuts"])
                x, y = np.asarray(inp["x"]), np.asarray(inp["y"])
                gx, gy = dr._dash_contour_grid(x, y)
                iy, ix = node_index(hm, gx, gy)
                at = dict(zip(zip(iy, ix), hm["z"]))
                # twoway's own pick at a duplicate (y, x) under these two
                # methods follows the sort seed: fit to the z it shows.
                z = np.array([at[(np.searchsorted(gy, b), np.searchsorted(gx, a))]
                              for a, b in zip(x, y)])
                s = dr._dash_contour_surface(x, y, z, it)
                got, want = s["gz"][iy, ix], np.asarray(hm["z"])
                span = s["zmax"] - s["zmin"]
                tol = 1e-6 if s["note"] == "singular" else 1e-9
                far = (np.min(np.abs(got[:, None] - cuts[None, :]), axis=1)
                       > 1e-6 * span) | (got == want)
                lev = np.searchsorted(cuts, got[far], side="right") + 1
                same = bool(np.array_equal(lev, np.asarray(hm["lev"])[far]))
                close = bool(np.allclose(got, want, rtol=tol, atol=tol * span))
                ok &= same and close and want.size == gx.size * gy.size
                msg += "%s/%s %d nodes z %d level %d; " % (
                    ds, it[:4], want.size, close, same)
    elif case == 4:
        for ds in ("auto", "synthetic", "manual5"):
            c = t["cases"][ds]["none"]
            inp = c["input"]
            s = dr._dash_contour_surface(inp["x"], inp["y"], inp["z"], "none")
            n = int(np.isfinite(s["gz"]).sum())
            ok &= n == inp["n_unique"] == c["nodes"]["n_rects"]
            msg += "%s %d/%d; " % (ds, n, c["nodes"]["n_rects"])
    elif case == 5:
        rng = np.random.default_rng(5)
        a = rng.uniform(0, 10, 1001)
        b = rng.uniform(0, 5, 1001)
        c = rng.normal(size=1001)
        hi = dr._dash_contour_surface(a, b, c)
        lo = dr._dash_contour_surface(a[:1000], b[:1000], c[:1000], "none")
        ok = (hi["capped"] is True and hi["gz"].shape == (100, 100)
              and lo["capped"] is False and lo["gz"].shape == (1000, 1000))
        msg = "1001 points capped %s %s; 1000 capped %s %s" % (
            hi["capped"], hi["gz"].shape, lo["capped"], lo["gz"].shape)
    elif case == 6:
        word = "" if arg == "EMPTY" else arg
        got = dr._dash_contour_interp(word)
        want = t["interp_abbrev"][arg]["method"]
        ok = got == want
        msg = "interp(%s): dash %s, twoway %s" % (word, got, want)
    Macro.setGlobal("u23_ok", str(int(bool(ok))))
    Macro.setGlobal("u23_msg", msg[:240])
end

* ==== S23 B4a: contour interpolation ====
local only : env WP31_ONLY
if inlist("`only'", "", "S23") & `: list posof "S23" in w31_run' {
    display as text "S23 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // U23-1: dash's grid is twoway's -- the node rectangles' edges are
    // the midpoints of consecutive distinct x (and y) and the min and max.
    // ------------------------------------------------------------
    python: _u23_check(1)
    _w31_expect U23-1 "(${u23_ok} == 1)" "grid edges: ${u23_msg}"
    _w31_done U23-1 "the grid is the distinct x by the distinct y: ${u23_msg}"

    // ------------------------------------------------------------
    // U23-2: a duplicate (y, x) keeps its smallest z, as twoway's help
    // says and its interp(none) does, measured live.
    // ------------------------------------------------------------
    clear
    mata: u23_D = (1,1,1 \ 1,2,2 \ 2,1,3 \ 2,2,4 \ 2,2,5)
    quietly set obs 5
    foreach v in y x z {
        quietly generate double `v' = .
    }
    mata: st_store(., ("y", "x", "z"), u23_D)
    mata: u23_M = _contour_heatmap("z", "y", "x", (2 \ 3 \ 4), "none")
    python: _u23_check(2)
    _w31_expect U23-2 "(${u23_ok} == 1)" "${u23_msg}"
    _w31_done U23-2 "the duplicate rule: ${u23_msg}"

    // ------------------------------------------------------------
    // U23-3: every node's z and level under thinplatespline and shepard
    // equal twoway's node grid on auto, the synthetic set and manual5.
    // ------------------------------------------------------------
    python: _u23_check(3)
    _w31_expect U23-3 "(${u23_ok} == 1)" "${u23_msg}"
    _w31_done U23-3 "node values and levels match twoway's: ${u23_msg}"

    // ------------------------------------------------------------
    // U23-4: interp(none) draws the observed nodes only, as many as
    // twoway's node rectangles.
    // ------------------------------------------------------------
    python: _u23_check(4)
    _w31_expect U23-4 "(${u23_ok} == 1)" "${u23_msg}"
    _w31_done U23-4 "interp(none) draws the observed nodes: ${u23_msg}"

    // ------------------------------------------------------------
    // U23-5: above _DASH_CONTOUR_EXACT_MAX distinct points the surface is
    // a flagged 100x100 grid; at the cap it is exact (DECISIONS D4).
    // ------------------------------------------------------------
    python: _u23_check(5)
    _w31_expect U23-5 "(${u23_ok} == 1)" "${u23_msg}"
    _w31_done U23-5 "the cap: ${u23_msg}"

    // ------------------------------------------------------------
    // U23-6: twoway never refuses an interp() word: its generator reads
    // a 4-letter-or-longer abbreviation of thinplatespline or shepard and
    // draws any other word as none.  Measured live on bogus: rc 0 and the
    // node grid of interp(none).
    // ------------------------------------------------------------
    capture twoway contour z y x, interp(bogus) nodraw
    local u23rc = _rc
    mata: st_local("u23same", strofreal(_contour_heatmap("z", "y", "x", (2 \ 3 \ 4), "bogus") == _contour_heatmap("z", "y", "x", (2 \ 3 \ 4), "none")))
    _w31_expect U23-6 "(`u23rc' == 0 & `u23same' == 1)" "twoway contour, interp(bogus): rc `u23rc', drawn as none `u23same'"
    foreach w in thinplatespline thin shepard shep th sh none bogus EMPTY {
        python: _u23_check(6, "`w'")
        _w31_expect U23-6 "(${u23_ok} == 1)" "${u23_msg}"
    }
    _w31_done U23-6 "interp() words read as twoway's generator reads them; bogus draws as none, r(0)"

    capture mata: mata drop u23_D u23_M
    macro drop u23_ok u23_msg
    clear
    capture graph drop _all
    display as text "S23 end " c(current_date) " " c(current_time)
}
* ==== end S23 ====

// S24 (WP-31 D1) helpers: register one dash graph, write its spec and
// data, and read the minor ticks and labels both modes draw.
// _u24_draw sets u24_x<m> (the x axis's minor positions), u24_y<m> (the
// y axis's), u24_y2<m> (the second y axis's), u24_l<m> (the x axis's minor
// labels, "pos|text" each) and u24_lo<m> (the x range's start), m = s
// saved, v served; numbers written %.10g.
python:
def _u24_draw(sp, dp, app):
    import __main__ as m
    from sfi import Macro
    from bokeh.models import CustomJSTicker, LabelSet
    a, b = m._u03_docs(sp, dp, app)

    def _minor(f, letter, name):
        sides = (f.below + f.above) if letter == "x" else (f.left + f.right)
        attr = letter + "_range_name"
        out = []
        for ax in sides:
            t = getattr(ax, "ticker", None)
            if getattr(ax, attr, "default") != name \
                    or not isinstance(t, CustomJSTicker):
                continue
            ar = dict(t.args or {})
            out += list(ar.get("mextra") or []) + list(ar.get("extra") or [])
            if ar.get("mfixed") is not None:
                out += list(ar["mfixed"].ticks or [])
        return " ".join(format(float(v), ".10g") for v in sorted(set(out)))

    for figs, sfx in ((a, "s"), (b, "v")):
        f = figs[0]
        Macro.setGlobal("u24_x" + sfx, _minor(f, "x", "default"))
        Macro.setGlobal("u24_y" + sfx, _minor(f, "y", "default"))
        Macro.setGlobal("u24_y2" + sfx, _minor(f, "y", "y2"))
        rows = []
        for mdl in f.center:
            if isinstance(mdl, LabelSet) and mdl.name == "dash_minor_labels" \
                    and list(mdl.tags or [])[:1] == ["x"]:
                d = mdl.source.data
                rows += ["%s|%s" % (format(float(p), ".10g"), t)
                         for p, t in zip(d["pos"], d["text"])]
        Macro.setGlobal("u24_l" + sfx, " ".join(rows))
        Macro.setGlobal("u24_lo" + sfx, format(float(f.x_range.start), ".10g"))
end

capture program drop _u24_reg
program define _u24_reg
    // _u24_reg <dir> <k> <dash command...>
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    dash clear
    capture quietly dash `0'
    if _rc {
        foreach m in s v {
            foreach g in x y y2 l lo {
                global u24_`g'`m' "rc `=_rc'"
            }
        }
        exit
    }
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u24_m; _u24_m._u24_draw("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py")
end

capture program drop _u24_tw
program define _u24_tw
    // _u24_tw <axis> <set>: twoway's positions on u24t's tickset, its
    // rule walked as tickset_g.class draws it, else its listed ticks,
    // into global u24_tw ("%.10g" each).
    version 19
    args axis set
    local p ".u24t.`axis'.`set'"
    local out ""
    if 0``p'.use_rule.istrue' & "``p'.delta'" != "0" & "``p'.min'" != "." {
        local lo = ``p'.min'
        local hi = ``p'.max'
        local d = ``p'.delta'
        if abs(`lo') < 1e299 & abs(`hi') < 1e299 {
            local n = floor((`hi' + .48 * `d' - `lo') / `d')
            forvalues i = 0/`n' {
                local x = `lo' + `i' * `d'
                if abs(`x') < `d' * 1e-6 local x 0
                local out "`out' `=strtrim(string(`x', "%18.10g"))'"
            }
        }
    }
    else {
        forvalues i = 1/0``p'.ticks.arrnels' {
            local out "`out' `=strtrim(string(``p'.ticks[`i'][1]', "%18.10g"))'"
        }
    }
    global u24_tw = strtrim("`out'")
end

* ==== S24 D1: Minor ticks and labels ====
local only : env WP31_ONLY
if inlist("`only'", "", "S24") & `: list posof "S24" in w31_run' {
    display as text "S24 start " c(current_date) " " c(current_time)
    local u24d "`w31_work'/s24"
    capture mkdir "`u24d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear

    // U24-1: xmtick(##5) over xlabel(0(1000)5000): twoway's minornl rule
    // walked (0(200)5000), the positions dash's ticker carries, both modes.
    quietly twoway scatter mpg weight, xlabel(0(1000)5000) xmtick(##5) name(u24t, replace)
    _u24_tw xaxis1 minornl
    local tw1 "${u24_tw}"
    graph drop u24t
    _u24_reg "`u24d'" 1 scatter mpg weight, xlabel(0(1000)5000) xmtick(##5) name(zu241)
    foreach m in s v {
        _w31_expect U24-1 `"("${u24_x`m'}" == "`tw1'")"' "`m': dash ${u24_x`m'}; twoway `tw1'"
    }
    // The default axis: extended below the first major to the data (1800).
    quietly twoway scatter mpg weight, xmtick(##5) name(u24t, replace)
    _u24_tw xaxis1 minornl
    local tw1b "${u24_tw}"
    graph drop u24t
    _u24_reg "`u24d'" 11 scatter mpg weight, xmtick(##5) name(zu2411)
    foreach m in s v {
        _w31_expect U24-1 `"("${u24_x`m'}" == "`tw1b'")"' "`m' default axis: dash ${u24_x`m'}; twoway `tw1b'"
    }
    _w31_done U24-1 "xmtick(##5) draws twoway's between positions on a rule and on the default axis, saved and served"

    // U24-2: majors that are an uneven list: twoway's one tick at 0 and
    // the scale widened to it.
    quietly twoway scatter mpg weight, xlabel(1000 2000 4000) xmtick(##5) name(u24t, replace)
    _u24_tw xaxis1 minornl
    local tw2 "${u24_tw}"
    local cm2 = `.u24t.plotregion1.xscale.curmin'
    graph drop u24t
    _u24_reg "`u24d'" 2 scatter mpg weight, xlabel(1000 2000 4000) xmtick(##5) name(zu242)
    foreach m in s v {
        _w31_expect U24-2 `"("${u24_x`m'}" == "`tw2'") & (${u24_lo`m'} <= `cm2')"' "`m': dash ${u24_x`m'} from ${u24_lo`m'}; twoway `tw2' from `cm2'"
    }
    _w31_done U24-2 "##5 over uneven majors draws twoway's one tick at 0 and widens the scale to it, saved and served"

    // U24-3: explicit positions.
    quietly twoway scatter mpg weight, xmtick(1500 2500) name(u24t, replace)
    _u24_tw xaxis1 minornl
    local tw3 "${u24_tw}"
    graph drop u24t
    _u24_reg "`u24d'" 3 scatter mpg weight, xmtick(1500 2500) name(zu243)
    foreach m in s v {
        _w31_expect U24-3 `"("${u24_x`m'}" == "`tw3'")"' "`m': dash ${u24_x`m'}; twoway `tw3'"
    }
    _w31_done U24-3 "xmtick(1500 2500) draws twoway's positions, saved and served"

    // U24-4: xmlabel(1500 "a" 2500): the positions, the quoted text and
    // the axis format's text (weight %8.0gc: 2,500).
    quietly twoway scatter mpg weight, xmlabel(1500 "a" 2500) name(u24t, replace)
    local fmt4 "`.u24t.xaxis1.minor.label_format'"
    local tw4 ""
    forvalues i = 1/0`.u24t.xaxis1.minor.ticks.arrnels' {
        local v = `.u24t.xaxis1.minor.ticks[`i'][1]'
        local t `"`.u24t.xaxis1.minor.ticks[`i'][2]'"'
        if `"`t'"' == "" local t = strtrim(string(`v', "`fmt4'"))
        local tw4 `"`tw4' `=strtrim(string(`v', "%18.10g"))'|`t'"'
    }
    local tw4 = strtrim(`"`tw4'"')
    graph drop u24t
    _u24_reg "`u24d'" 4 scatter mpg weight, xmlabel(1500 "a" 2500) name(zu244)
    foreach m in s v {
        _w31_expect U24-4 `"("${u24_l`m'}" == "`tw4'") & ("${u24_x`m'}" == "1500 2500")"' "`m': labels ${u24_l`m'} at ${u24_x`m'}; twoway `tw4'"
    }
    _w31_done U24-4 `"xmlabel(1500 "a" 2500) writes twoway's texts (`tw4') at its positions, saved and served"'

    // U24-6: ymtick(5000 10000, axis(2)) reaches the second axis only.
    quietly twoway scatter mpg weight || scatter price weight, yaxis(2) ymtick(5000 10000, axis(2)) name(u24t, replace)
    _u24_tw yaxis2 minornl
    local tw6 "${u24_tw}"
    graph drop u24t
    _u24_reg "`u24d'" 6 scatter mpg weight || scatter price weight, yaxis(2) ymtick(5000 10000, axis(2)) name(zu246)
    foreach m in s v {
        _w31_expect U24-6 `"("${u24_y2`m'}" == "`tw6'") & ("${u24_y`m'}" == "")"' "`m': y2 ${u24_y2`m'}, y '${u24_y`m'}'; twoway `tw6'"
    }
    _w31_done U24-6 "ymtick(, axis(2)) draws twoway's positions on the second axis and none on the first, saved and served"
    capture dash clear
    display as text "S24 end " c(current_date) " " c(current_time)
}
* ==== end S24 ====

// S25 C6b helpers.  _u25_tw <twoway plot>: plot 1's serset of the drawn
// twoway graph written to <dir>/t.csv (y, then x); _u25_cmp: the first
// visible Line a registered dash graph draws, saved and served, against
// that serset -- the vertex count and every vertex to 1e-6 relative (a
// serset stores floats) -- as globals u25_s and u25_v (1 when equal) and
// u25_msg.
capture program drop _u25_tw
program define _u25_tw
    // _u25_tw <dir> <twoway plot ...>
    version 19
    gettoken dir 0 : 0
    serset clear
    capture graph drop u25t
    quietly twoway (`0'), nodraw name(u25t, replace)
    local id "`.u25t.plotregion1.plot1.serset.id'"
    preserve
    quietly serset set `id'
    quietly serset use, clear
    quietly export delimited using "`dir'/t.csv", replace novarnames
    restore
    capture graph drop u25t
end

python:
def _u25_cmp(sp, dp, app, csv):
    import math
    from sfi import Macro
    import __main__ as m
    with open(csv, encoding="utf-8") as fh:
        want = [tuple(float(v) for v in ln.split(",")[:2][::-1])
                for ln in fh if ln.strip()]
    a, b = m._u03_docs(sp, dp, app)
    msg = []
    for figs, sfx in ((a, "s"), (b, "v")):
        got = None
        for f in figs:
            for r in f.renderers:
                g = getattr(r, "glyph", None)
                if (type(g).__name__ != "Line" or got is not None
                        or g.line_alpha == 0):
                    continue
                d = r.data_source.data
                got = list(zip((float(v) for v in d[g.x]),
                               (float(v) for v in d[g.y])))
        got = got or []
        ok = len(got) == len(want) and all(
            math.isclose(p, q, rel_tol=1e-6, abs_tol=1e-9)
            for gp, wp in zip(got, want) for p, q in zip(gp, wp))
        Macro.setGlobal("u25_" + sfx, str(int(ok)))
        msg.append("%s %d vertices" % ("saved" if sfx == "s" else "served",
                                        len(got)))
    Macro.setGlobal("u25_msg", ", ".join(msg) + "; twoway %d" % len(want))
end

capture program drop _u25_case
program define _u25_case
    // _u25_case <id> <dir> <k> <plot ...>: dash's line against twoway's.
    version 19
    gettoken id 0 : 0
    gettoken dir 0 : 0
    gettoken k 0 : 0
    _u25_tw "`dir'" `0'
    dash clear
    capture noisily dash (`0'), name(zu25`k')
    _w31_expect `id' "(_rc == 0)" "dash `0' rc `=_rc'"
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u25_m; _u25_m._u25_cmp("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py", "`dir'/t.csv")
    _w31_expect `id' "(${u25_s} == 1 & ${u25_v} == 1)" "`0': ${u25_msg}"
    foreach p in s d {
        capture erase "`dir'/`p'`k'.json"
    }
    capture erase "`dir'/a`k'.py"
    capture erase "`dir'/t.csv"
    dash clear
end

* ==== S25 C6b: mband and mspline over data with missing y or x ====
local only : env WP31_ONLY
if inlist("`only'", "", "S25") & `: list posof "S25" in w31_run' {
    display as text "S25 start " c(current_date) " " c(current_time)
    local u25d "`w31_work'/s25"
    capture mkdir "`u25d'"
    capture graph drop _all

    // ------------------------------------------------------------
    // U25-06: auto with mpg missing in 10/12 (area_cmissing_truth.json
    // E04, E05): the default band count is on the serset's N, the rows
    // with y or x (74, nine bands), where dash counted the 71 complete
    // rows (eight bands; mband 8 vertices for 9, mspline 78 for 89).
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly replace mpg = . in 10/12
    _u25_case U25-06 "`u25d'" 1 mband mpg weight
    _u25_case U25-06 "`u25d'" 2 mspline mpg weight
    _w31_done U25-06 "mpg missing in 10/12: mband and mspline draw twoway's vertices in both modes"

    // ------------------------------------------------------------
    // U25-07: weight missing on the 30 lightest cars, mpg present: those
    // rows stay in N (nine bands over the rest's x range).
    // ------------------------------------------------------------
    sysuse auto, clear
    sort weight, stable
    quietly replace weight = . in 1/30
    _u25_case U25-07 "`u25d'" 3 mband mpg weight
    _u25_case U25-07 "`u25d'" 4 mspline mpg weight
    _w31_done U25-07 "weight missing on 30 rows: mband and mspline draw twoway's vertices in both modes"

    // ------------------------------------------------------------
    // U25-08: mpg missing at the lightest car (its weight still sets the
    // bands' x range) and both missing on five rows (out of N), with
    // bands(3) n(2) and the default.
    // ------------------------------------------------------------
    sysuse auto, clear
    sort weight, stable
    quietly replace mpg = . in 1
    quietly replace mpg = . in 40/44
    quietly replace weight = . in 40/44
    _u25_case U25-08 "`u25d'" 5 mband mpg weight
    _u25_case U25-08 "`u25d'" 6 mspline mpg weight, bands(3) n(2)
    _w31_done U25-08 "mpg missing at the x minimum and both missing on five rows: mband and mspline draw twoway's vertices in both modes"

    capture rmdir "`u25d'"
    macro drop u25_s u25_v u25_msg
    capture graph drop _all
    dash clear
    display as text "S25 end " c(current_date) " " c(current_time)
}
* ==== end S25 ====

// S25 F1f helpers.  _u25_move: the saved page's mband or mspline line
// after one filter move, the callback run under node, against twoway's
// serset of the same rows in <csv> (_u25_tw) -- the vertex count and every
// vertex to <rtol> relative; globals u25_ok (1 when equal), u25_n (the
// saved vertex count), u25_cue (1
// when the layer is dimmed or the graph's stale caption shows) and
// u25_msg.
python:
def _u25_move(sp, dp, kind, value, csv, rtol):
    import math
    import os
    import sys
    import warnings
    if os.getcwd() not in sys.path:
        sys.path.insert(0, os.getcwd())
    import dash_render as dr
    import js_runner
    from sfi import Macro
    with open(csv, encoding="utf-8") as fh:
        want = [tuple(float(v) for v in ln.split(",")[:2][::-1])
                for ln in fh if ln.strip()]
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
    lay = [x for f in r.figures.values() for x in f.renderers
           if (getattr(x, "_dash_agg_config", None) or {}).get("type")
           in ("mband", "mspline")]
    w = [m for m in r.filter_widgets if type(m).__name__ == kind][0]
    if kind == "Select":
        w.value = [v for v, lab in w.options if lab == value][0]
    elif kind == "RangeSlider":
        w.value = tuple(float(v) for v in value.split())
    else:
        w.value = float(value)
    cb = r.filter_callbacks[r.filter_widgets.index(w)]
    js_runner.JsSession(r.filter_callbacks).run(cb)
    d = lay[0].data_source.data
    cx, cy = lay[0]._dash_agg_config["cols"]
    got = list(zip((float(v) for v in d[cx]), (float(v) for v in d[cy])))
    ok = len(got) == len(want) and all(
        math.isclose(p, q, rel_tol=float(rtol), abs_tol=1e-9)
        for gp, wp in zip(got, want) for p, q in zip(gp, wp))
    cue = [t for f in r.figures.values() for t in f.above
           if "dash_stale_cue" in (getattr(t, "tags", None) or [])]
    Macro.setGlobal("u25_ok", str(int(ok)))
    Macro.setGlobal("u25_n", str(len(got)))
    Macro.setGlobal("u25_cue", str(int(any(x.muted for x in lay) or (
        bool(cue) and bool(cue[0].visible)))))
    Macro.setGlobal("u25_msg", "saved %d vertices, twoway %d" % (
        len(got), len(want)))
end

capture program drop _u25_saved
program define _u25_saved
    // _u25_saved <id> <dir> <k> <rtol> <filter> | <kind> | <value> | <twoway plot> | <dash command>
    version 19
    gettoken id 0 : 0
    gettoken dir 0 : 0
    gettoken k 0 : 0
    gettoken rtol 0 : 0
    gettoken filt 0 : 0, parse("|")
    gettoken bar 0 : 0, parse("|")
    gettoken kind 0 : 0, parse("|")
    gettoken bar 0 : 0, parse("|")
    gettoken value 0 : 0, parse("|")
    gettoken bar 0 : 0, parse("|")
    gettoken tw 0 : 0, parse("|")
    gettoken bar 0 : 0, parse("|")
    local kind = strtrim("`kind'")
    local value = strtrim("`value'")
    _u25_tw "`dir'" `tw'
    dash clear
    capture noisily dash `0', name(zu25f`k')
    _w31_expect `id' "(_rc == 0)" "dash `0' rc `=_rc'"
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json") filter(`filt')
    python: import __main__ as _u25_m; _u25_m._u25_move("`dir'/s`k'.json", "`dir'/d`k'.json", "`kind'", "`value'", "`dir'/t.csv", "`rtol'")
    _w31_expect `id' "(${u25_ok} == 1)" "`0', `kind' to `value': ${u25_msg}"
    _w31_expect `id' "(${u25_cue} == 0)" "`0', `kind' to `value': the layer is marked (unfiltered)"
    foreach p in s d {
        capture erase "`dir'/`p'`k'.json"
    }
    capture erase "`dir'/t.csv"
    dash clear
end

* ==== S25 F1f: mband and mspline recompute on the saved page ====
local only : env WP31_ONLY
if inlist("`only'", "", "S25") & `: list posof "S25" in w31_run' {
    display as text "S25 start " c(current_date) " " c(current_time)
    local u25d "`w31_work'/s25f"
    capture mkdir "`u25d'"
    capture graph drop _all
    sysuse auto, clear

    // ------------------------------------------------------------
    // U25-01: mband after the dropdown to Foreign is twoway's mband on
    // the 22 Foreign cars (the default band count on the kept rows:
    // round(min(sqrt 22, 10 log10 22)) = 5 knots), not the build's.
    // ------------------------------------------------------------
    quietly count if foreign == 1
    local nf = r(N)
    local bf = max(min(`nf', 2), round(min(sqrt(`nf'), 10 * log10(`nf'))))
    _u25_saved U25-01 "`u25d'" 1 1e-6 foreign, type(dropdown) | Select | Foreign | mband mpg weight if foreign == 1 | (scatter mpg weight) (mband mpg weight)
    _w31_expect U25-01 "(${u25_n} == `bf')" "mband after the dropdown to Foreign: ${u25_n} knots, the rule on `nf' rows gives `bf'"
    _w31_done U25-01 "mband after the dropdown to Foreign: twoway's `bf' knots on the `nf' kept rows"
    sysuse auto, clear

    // ------------------------------------------------------------
    // U25-02: mspline bands(5) n(4) after the price range to 4500-11385:
    // (K-1)*4 + K points, as twoway's serset (floats: 1e-5).
    // ------------------------------------------------------------
    _u25_saved U25-02 "`u25d'" 2 1e-5 price, type(range) | RangeSlider | 4500 11385 | mspline mpg weight if inrange(price, 4500, 11385), bands(5) n(4) | (mspline mpg weight, bands(5) n(4))
    _w31_done U25-02 "mspline bands(5) n(4) after the range to 4500-11385: twoway's points"

    // ------------------------------------------------------------
    // U25-03: mband bands(20) after the dropdown to Domestic.
    // ------------------------------------------------------------
    _u25_saved U25-03 "`u25d'" 3 1e-6 foreign, type(dropdown) | Select | Domestic | mband mpg weight if foreign == 0, bands(20) | (mband mpg weight, bands(20))
    _w31_done U25-03 "mband bands(20) after the dropdown to Domestic: twoway's knots"

    // ------------------------------------------------------------
    // U25-04: mspline bands(2) on the Foreign cars is its two knots alone,
    // as twoway's serset.
    // ------------------------------------------------------------
    _u25_saved U25-04 "`u25d'" 4 1e-6 foreign, type(dropdown) | Select | Foreign | mspline mpg weight if foreign == 1, bands(2) | (mspline mpg weight, bands(2))
    _w31_done U25-04 "mspline bands(2) after the dropdown to Foreign: the two knots"

    // ------------------------------------------------------------
    // U25-05: a move leaving one row: mband is that one knot; twoway plots
    // one point, rc 0.
    // ------------------------------------------------------------
    quietly summarize price
    local pmax = r(max)
    _u25_saved U25-05 "`u25d'" 5 1e-6 price, type(slider) | Slider | `pmax' | mband mpg weight if price >= `pmax' | (mband mpg weight)
    _w31_done U25-05 "mband after the slider to `pmax' (one row): the one knot, as twoway's"

    capture rmdir "`u25d'"
    macro drop u25_ok u25_n u25_cue u25_msg
    capture graph drop _all
    dash clear
    display as text "S25 end " c(current_date) " " c(current_time)
}
* ==== end S25 ====

// S26 (WP-31 B4b) helpers: register one dash contour graph, write its
// spec and data, and read what both modes draw.  _u26_draw sets, per
// mode m (s saved, v served): u26_n<m> (contour renderers), u26_cut<m>
// (the cuts, %.10g), u26_rgb<m> (each band's fill, lowest first, or each
// line's colour for contourline), u26_tick<m> (the colour key's ticks),
// u26_side<m> (the key's side, "none" without one), u26_fx<m> (the fill
// polygons' x extent "lo hi"), u26_lv<m> (the number of line levels),
// u26_kind<m> (the saved layer's frozen kind), u26_cap<m> (capped 0/1)
// and u26_notes (approximate-surface notes printed, both builds).
python:
def _u26_docs(sp, dp, app):
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings(record=True) as w:
        warnings.simplefilter("always")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
        with open(app, encoding="utf-8") as fh:
            src = fh.read()
        attach = "if __name__ != '__main__':\n    make_document(curdoc())"
        ns = dict(__name__="dash_u26_app")
        exec(compile(src.replace(attach, "pass"), "dash_u26_app.py", "exec"),
             ns)
        doc = Document()
        ns["make_document"](doc)
    sv = [m for m in doc.models if type(m).__name__ == "figure"]
    notes = [str(x.message) for x in w]
    return list(r.figures.values()), sv, notes


def _u26_draw(sp, dp, app):
    from sfi import Macro
    a, b, notes = _u26_docs(sp, dp, app)
    Macro.setGlobal("u26_notes", str(sum("approximate surface" in n
                                         for n in notes)))
    for figs, sfx in ((a, "s"), (b, "v")):
        f = figs[0]
        crs = [r for r in f.renderers
               if type(r).__name__ == "ContourRenderer"]
        Macro.setGlobal("u26_n" + sfx, str(len(crs)))
        for g in ("cut", "rgb", "tick", "fx", "lv", "kind", "cap"):
            Macro.setGlobal("u26_%s%s" % (g, sfx), "")
        Macro.setGlobal("u26_side" + sfx, "none")
        if len(crs) != 1:
            continue
        cr = crs[0]
        cfg = getattr(cr, "_dash_contour_config", {}) or {}
        Macro.setGlobal("u26_cut" + sfx, " ".join(
            format(float(c), ".10g") for c in cfg.get("cuts", [])))
        fd = cr.fill_renderer.data_source.data
        ld = cr.line_renderer.data_source.data
        if cfg.get("type") == "contourline":
            cols = cr.line_renderer.glyph.line_color
            fld = cols if isinstance(cols, str) else getattr(cols, "field", None)
            cols = list(ld[fld]) if fld in ld else [cols]
        else:
            levels = [float(v) for v in cr.levels]
            by = {}
            for lo, c in zip(fd["lower_levels"], fd["fill_color"]):
                by[levels.index(float(lo))] = c
            cols = [by[k] for k in sorted(by)]
        Macro.setGlobal("u26_rgb" + sfx, " ".join(str(c).lower() for c in cols))
        xs = [v for p in fd["xs"] for poly in p for ring in poly for v in ring]
        if xs:
            Macro.setGlobal("u26_fx" + sfx, "%s %s" % (
                format(min(xs), ".10g"), format(max(xs), ".10g")))
        Macro.setGlobal("u26_lv" + sfx, str(len(ld.get("levels", []))))
        tag = getattr(cr, "_dash_frozen", None)
        Macro.setGlobal("u26_kind" + sfx, str((tag or {}).get("kind", "")))
        Macro.setGlobal("u26_cap" + sfx,
                        str(int(bool(getattr(cr, "_dash_contour_capped", 0)))))
        # Flipped (WP-42 CV-3): the key was a ContourColorBar on one of
        # the figure's sides, its ticks its ticker's; it is the figure's
        # key cell (fig._dash_key_cell), on its side (_dash_key_side),
        # ticked on its z axis.
        cell = getattr(f, "_dash_key_cell", None)
        if cell is not None and cell.visible:
            Macro.setGlobal("u26_side" + sfx,
                            str(getattr(cell, "_dash_key_side", "")))
            Macro.setGlobal("u26_tick" + sfx, " ".join(
                format(float(t), ".10g")
                for t in cell._dash_key_axis.ticker.ticks))


def _u26_raster(case, interp):
    """U26-2: the band of each cell of a 200 x 200 raster in twoway's
    filled rows (contour_truth.json) and in dash's polygons agree."""
    import os
    import sys
    from sfi import Macro
    sys.path.insert(0, os.getcwd())
    import test_contour_layers as t
    import numpy as np
    import pandas as pd
    import warnings
    import tempfile
    import pathlib
    c = t._T["cases"][case]
    rows = c["rows"]
    df = pd.DataFrame({"z": rows["z"], "y": rows["y"], "x": rows["x"]})
    cuts = " ".join(repr(float(v)) for v in c[interp]["cuts"])
    out = []
    for mode in ("saved", "served"):
        with warnings.catch_warnings():
            warnings.simplefilter("ignore")
            figs, _n = t._figs(mode, pathlib.Path(tempfile.mkdtemp()),
                               [t._plot(z="z", y="y", x="x",
                                        opts={"ccuts": cuts,
                                              "interp": interp})], df=df)
        [cr] = t._contours(figs[0])
        g = t._T["grid"][case]
        xs = np.linspace(min(g["x"]), max(g["x"]), 201)
        ys = np.linspace(min(g["y"]), max(g["y"]), 201)
        X, Y = np.meshgrid((xs[:-1] + xs[1:]) / 2, (ys[:-1] + ys[1:]) / 2)
        out.append(float((t._twoway_raster(c[interp]["filled"], X, Y)
                          == t._dash_raster(cr, X, Y)).mean()))
    Macro.setGlobal("u26_agree", " ".join("%.4f" % v for v in out))
end

capture mata: mata drop _u26_near() _u26_hex() _u26_h2()
mata:
// 1 when two lists of #rrggbb colours have the same length and every
// channel within 1/255.
real scalar _u26_near(string scalar a, string scalar b)
{
    string rowvector A, B
    real scalar i, j
    A = tokens(a)
    B = tokens(b)
    if (cols(A) != cols(B) | cols(A) == 0) return(0)
    for (i = 1; i <= cols(A); i++) {
        if (strlen(A[i]) != 7 | strlen(B[i]) != 7) return(0)
        for (j = 2; j <= 6; j = j + 2) {
            if (abs(_u26_hex(substr(A[i], j, 2)) - _u26_hex(substr(B[i], j, 2))) > 1) return(0)
        }
    }
    return(1)
}
string scalar _u26_h2(real scalar v)
{
    return(strlower(substr("0" + inbase(16, v), -2, 2)))
}
real scalar _u26_hex(string scalar h)
{
    string scalar d
    d = "0123456789abcdef"
    h = strlower(h)
    return(16 * (strpos(d, substr(h, 1, 1)) - 1) + strpos(d, substr(h, 2, 1)) - 1)
}
end

capture program drop _u26_reg
program define _u26_reg
    // _u26_reg <dir> <k> <dash command...>
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    dash clear
    capture quietly dash `0'
    global u26_rc = _rc
    if _rc {
        foreach m in s v {
            global u26_n`m' "rc `=_rc'"
        }
        exit
    }
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u26_m; _u26_m._u26_draw("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py")
end

capture program drop _u26_tw
program define _u26_tw
    // _u26_tw <twoway command>: twoway's cuts, band (or line) colours and
    // z-axis ticks, read from the drawn graph u26t, into u26_twcut,
    // u26_twrgb ("#rrggbb" each) and u26_twtick ("%.10g" each).
    version 19
    capture graph drop u26t
    twoway `0' name(u26t)
    local v ".u26t.`.u26t.contour_view'`.u26t.contourline_view'"
    local out ""
    foreach c in `.`v'.style.ccutsopt' {
        local out "`out' `=strtrim(string(`c', "%18.10g"))'"
    }
    global u26_twcut = strtrim("`out'")
    local L = 0`.`v'.style.levels.val'
    local n = cond("`.`v'.type.setting'" == "contourline", `L' - 1, `L')
    local out ""
    forvalues i = 1/`n' {
        tokenize `.`v'.style.cstyles[`i'].color.rgb'
        mata: st_local("out", st_local("out") + " #" + _u26_h2(`1') + _u26_h2(`2') + _u26_h2(`3'))
    }
    global u26_twrgb = strtrim("`out'")
    local za `.`v'.zaxis'
    local out ""
    foreach t in `.`za'.major.tick_values' {
        local out "`out' `=strtrim(string(`t', "%18.10g"))'"
    }
    global u26_twtick = strtrim("`out'")
    graph drop u26t
end

* ==== S26 B4b: contour and contourline ====
local only : env WP31_ONLY
if inlist("`only'", "", "S26") & `: list posof "S26" in w31_run' {
    display as text "S26 start " c(current_date) " " c(current_time)
    local u26dir "`w31_work'/u26"
    capture mkdir "`u26dir'"
    sysuse auto, clear

    // ------------------------------------------------------------
    // U26-1: dash contour mpg weight length registers z y x and both
    // modes draw one contour renderer with twoway's cuts and colours.
    // ------------------------------------------------------------
    _u26_tw contour mpg weight length,
    _u26_reg `u26dir' 1 contour mpg weight length, name(u261)
    foreach m in s v {
        _w31_expect U26-1 `"("${u26_n`m'}" == "1")"' "`m': ${u26_n`m'} contour renderers"
        _w31_expect U26-1 `"("${u26_cut`m'}" == "${u26_twcut}")"' "`m': cuts ${u26_cut`m'}; twoway's ${u26_twcut}"
        _w31_expect U26-1 `"("${u26_rgb`m'}" == "${u26_twrgb}")"' "`m': bands ${u26_rgb`m'}; twoway's ${u26_twrgb}"
    }
    _w31_done U26-1 "contour draws twoway's cuts ${u26_twcut} and bands ${u26_twrgb} in both modes"

    // ------------------------------------------------------------
    // U26-2: the level sets equal twoway's filled polygons
    // (contour_truth.json cases.*): a 200 x 200 raster agrees on 98% of
    // its cells (97% for auto's ill-conditioned thin-plate spline).
    // ------------------------------------------------------------
    foreach c in auto synthetic {
        foreach i in thinplatespline shepard {
            python: import __main__ as _u26_m; _u26_m._u26_raster("`c'", "`i'")
            local fl = cond("`c'`i'" == "autothinplatespline", .97, .98)
            foreach a of global u26_agree {
                _w31_expect U26-2 `"(`a' >= `fl')"' "`c' `i': `a' of the cells agree (at least `fl')"
            }
        }
    }
    _w31_done U26-2 "the bands' level sets equal twoway's filled polygons"

    // ------------------------------------------------------------
    // U26-3: ccuts(), levels(), levels() minmax: twoway's cuts.
    // ------------------------------------------------------------
    local k 3
    foreach o in "ccuts(30 15 25 20)" "levels(5)" "levels(5) minmax" "levels(1)" {
        _u26_tw contour mpg weight length, `o'
        _u26_reg `u26dir' `k' contour mpg weight length, `o' name(u263)
        foreach m in s v {
            _w31_expect U26-3 `"("${u26_cut`m'}" == "${u26_twcut}")"' "`o' `m': cuts ${u26_cut`m'}; twoway's ${u26_twcut}"
        }
        local ++k
    }
    _w31_done U26-3 "ccuts(), levels() and minmax cut where twoway cuts"

    // ------------------------------------------------------------
    // U26-4: the colour rules between scolor() and ecolor(), and
    // ccolors(): each band's colour twoway's (within 1/255 a channel).
    // ------------------------------------------------------------
    foreach o in "crule(linear) scolor(navy) ecolor(gold)" "crule(revlinear) scolor(navy) ecolor(gold)" "crule(intensity) scolor(navy) ecolor(gold)" "crule(hue) scolor(navy) ecolor(gold)" "crule(chue) scolor(navy) ecolor(gold)" "crule(phue)" "ccolors(red blue green)" "scheme(s1mono)" {
        _u26_tw contour mpg weight length, `o'
        _u26_reg `u26dir' `k' contour mpg weight length, `o' name(u264)
        foreach m in s v {
            mata: st_local("u26ok", strofreal(_u26_near(st_global("u26_rgb`m'"), st_global("u26_twrgb"))))
            _w31_expect U26-4 `"(`u26ok' == 1)"' "`o' `m': ${u26_rgb`m'}; twoway's ${u26_twrgb}"
        }
        local ++k
    }
    _w31_done U26-4 "every crule(), ccolors() and the scheme's own rule colour the bands as twoway does"

    // ------------------------------------------------------------
    // U26-5: the colour key: right of the plot, ticked at twoway's z-axis
    // ticks; none under clegend(off); on the left at position(9).
    // ------------------------------------------------------------
    _u26_tw contour mpg weight length,
    _u26_reg `u26dir' `k' contour mpg weight length, name(u265)
    foreach m in s v {
        _w31_expect U26-5 `"("${u26_side`m'}" == "right" & "${u26_tick`m'}" == "${u26_twtick}")"' "`m': key ${u26_side`m'} ticked ${u26_tick`m'}; twoway's ${u26_twtick}"
    }
    local ++k
    _u26_reg `u26dir' `k' contour mpg weight length, clegend(off) name(u265)
    foreach m in s v {
        _w31_expect U26-5 `"("${u26_side`m'}" == "none")"' "`m': clegend(off) key ${u26_side`m'}"
    }
    local ++k
    _u26_reg `u26dir' `k' contour mpg weight length, clegend(position(9)) name(u265)
    foreach m in s v {
        _w31_expect U26-5 `"("${u26_side`m'}" == "left")"' "`m': clegend(position(9)) key ${u26_side`m'}"
    }
    local ++k
    _w31_done U26-5 "the key is twoway's: right, ticked ${u26_twtick}; off and position(9) honoured"

    // ------------------------------------------------------------
    // U26-6: contourline: lines at the cuts and no fill; black unless
    // colorlines colours them in twoway's level colours.
    // ------------------------------------------------------------
    _u26_tw contourline mpg weight length,
    _u26_reg `u26dir' `k' contourline mpg weight length, name(u266)
    foreach m in s v {
        _w31_expect U26-6 `"("${u26_lv`m'}" == "`: word count ${u26_twcut}'" & "${u26_fx`m'}" == "" & "${u26_rgb`m'}" == "#000000 #000000")"' "`m': ${u26_lv`m'} line levels, colours ${u26_rgb`m'}, fill ${u26_fx`m'}"
    }
    local ++k
    _u26_tw contourline mpg weight length, colorlines
    _u26_reg `u26dir' `k' contourline mpg weight length, colorlines name(u266)
    foreach m in s v {
        _w31_expect U26-6 `"("${u26_rgb`m'}" == "${u26_twrgb}")"' "`m': colorlines ${u26_rgb`m'}; twoway's ${u26_twrgb}"
    }
    local ++k
    _w31_done U26-6 "contourline draws its lines at the cuts, black or in twoway's level colours"

    // ------------------------------------------------------------
    // U26-7: horizontal: the surface is turned, weight across.
    // ------------------------------------------------------------
    quietly summarize weight
    local wlo = r(min)
    local whi = r(max)
    _u26_reg `u26dir' `k' contour mpg weight length, horizontal name(u267)
    foreach m in s v {
        _w31_expect U26-7 `"("${u26_fx`m'}" == "`wlo' `whi'")"' "`m': fill x ${u26_fx`m'}; weight's range `wlo' `whi'"
    }
    local ++k
    _w31_done U26-7 "horizontal turns the surface: weight across"

    // ------------------------------------------------------------
    // U26-8: within the cap the saved page refits the layer (section
    // 29), so it is not frozen; the served app refits it too (its
    // redraw pairs the fill and line sources, test_contour_layers.py
    // TestMoves).  Flipped (WP-31 B4c): the saved layer was frozen with
    // the grid cue until the page's twin landed.
    // ------------------------------------------------------------
    _u26_reg `u26dir' `k' contour mpg weight length, name(u268)
    _w31_expect U26-8 `"("${u26_kinds}" == "")"' "saved: frozen kind ${u26_kinds}"
    local ++k
    _w31_done U26-8 "the saved page refits the contour: not frozen"

    // ------------------------------------------------------------
    // U26-10: above 1,000 distinct points: approximate, noted once a
    // build, flagged in both modes.
    // ------------------------------------------------------------
    clear
    quietly set obs 1001
    set seed 26
    quietly generate double x = runiform()
    quietly generate double y = runiform()
    quietly generate double z = rnormal()
    _u26_reg `u26dir' `k' contour z y x, name(u2610)
    _w31_expect U26-10 `"("${u26_caps}" == "1" & "${u26_capv}" == "1")"' "capped: saved ${u26_caps}, served ${u26_capv}"
    _w31_expect U26-10 `"("${u26_notes}" == "2")"' "approximate-surface notes: ${u26_notes} (one a build)"
    _w31_done U26-10 "a contour over 1,001 distinct points is approximate, noted once and flagged"

    dash clear
    clear
    macro drop u26_*
    capture graph drop _all
    display as text "S26 end " c(current_date) " " c(current_time)
}
* ==== end S26 ====

// S26 (WP-31 C8e) helpers: _u26_svgsame compares twoway's two exported
// SVGs with their generated ids taken out; _u26_bar reads dash's colour bar
// (palette ends, range, ticks) in both modes of a registered graph and the
// notes naming colorkeysreverse.
python:
def _u26_svgsame(a, b):
    import re
    from sfi import Macro
    def norm(p):
        with open(p, encoding="utf-8", errors="replace") as fh:
            t = fh.read()
        return re.sub(r'(id|href|clip-path)="[^"]*"', "", t)
    Macro.setGlobal("u26_same", "1" if norm(a) == norm(b) else "0")


def _u26_bar(sp, dp, app, sfx):
    import __main__ as m
    from sfi import Macro
    from bokeh.models import ColorBar
    a, b, notes = m._u26_docs(sp, dp, app)
    for figs, mode in ((a, "s"), (b, "v")):
        f = figs[0]
        bars = [k for side in (f.right, f.left, f.above, f.below)
                for k in side if isinstance(k, ColorBar)]
        view = ""
        # Flipped (WP-42 CV-3): the key was a ColorBar (its mapper's
        # palette ends, low and high, its ticker's ticks); it is the
        # figure's key cell: its swatches' first and last colours, its z
        # axis line's ends (bounds) and its z axis's ticks.
        cell = getattr(f, "_dash_key_cell", None)
        if not bars and cell is not None and cell.visible:
            ax = cell._dash_key_axis
            cs = [str(c) for c in cell._dash_keycell["src"].data.get("c") or []]
            if cs:
                view = "%s %s %s %s %s" % (cs[0], cs[-1],
                                           format(float(ax.bounds[0]), ".10g"),
                                           format(float(ax.bounds[1]), ".10g"),
                                           " ".join(format(float(t), ".10g")
                                                    for t in ax.ticker.ticks))
        if len(bars) == 1:
            cm = bars[0].color_mapper
            view = "%s %s %s %s %s" % (cm.palette[0], cm.palette[-1],
                                       format(float(cm.low), ".10g"),
                                       format(float(cm.high), ".10g"),
                                       " ".join(format(float(t), ".10g")
                                                for t in bars[0].ticker.ticks))
        Macro.setGlobal("u26_bar%s%s" % (sfx, mode), view)
    Macro.setGlobal("u26_rn" + sfx, str(sum("colorkeysreverse" in n
                                            for n in notes)))
end

* ==== S26 C8e: colorkeysreverse on a colour bar ====
local only : env WP31_ONLY
if inlist("`only'", "", "S26") & `: list posof "S26" in w31_run' {
    display as text "S26 start " c(current_date) " " c(current_time)
    local u26dir "`w31_work'/u26e"
