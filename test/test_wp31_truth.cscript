    local ++k
    dash clear
    capture noisily dash (scatter mpg weight) (scatter price weight, yaxis(2)), title("Z1:a \$ZTG_nosuch b") ///
        subtitle("Z2:a \$ZTG_nosuch b") ///
        note("Z3:a \$ZTG_nosuch b") ///
        caption("Z4:a \$ZTG_nosuch b") ///
