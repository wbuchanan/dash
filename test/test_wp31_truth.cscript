// S09 helpers (WP-31 C10c).  _u09_draw: for a registered graph, saved
// (sfx s) and served (sfx v), every continuous axis of letter L as
// "<n>:<side>:<order from the plot region outward>" in axis order
// (u09_ax<sfx>) and each layer's range name (u09_rn<sfx>); the axis-3
// facts as "<axis type>|<title>|<label ticks>|<extra ticks>|<spans on
// y3>" (u09_a3<sfx>); the spec's axisn object (u09_axn).  _u09_fix: the
// fixture's sides.<key> in the same form (u09_f).
python:
def _u09_axes(fig, letter):
    from bokeh.models.axes import ContinuousAxis
    sides = ("left", "right") if letter == "y" else ("below", "above")
    out = {}
    for side in sides:
        on = [a for a in getattr(fig, side) if isinstance(a, ContinuousAxis)]
        for i, a in enumerate(on, 1):
            nm = getattr(a, letter + "_range_name")
            out[1 if nm == "default" else int(nm[1:])] = "%s:%d" % (side, i)
    return " ".join("%d:%s" % (n, out[n]) for n in sorted(out))


def _u09_num(v):
    return "%g" % float(v)


def _u09_draw(sp, dp, app, letter):
    import json
    from sfi import Macro
    import __main__ as m
    a, b = m._u03_docs(sp, dp, app)
    for figs, sfx in ((a, "s"), (b, "v")):
        f = figs[0]
        Macro.setGlobal("u09_ax" + sfx, _u09_axes(f, letter))
        Macro.setGlobal("u09_rn" + sfx, " ".join(
            getattr(r, letter + "_range_name") for r in f.renderers
            if type(r).__name__ == "GlyphRenderer"))
        a3 = ""
        for ax in f.left + f.right:
            if getattr(ax, "y_range_name", "") != "y3":
                continue
            t = ax.ticker
            args = dict(getattr(t, "args", None) or {})
            base = args.get("base", getattr(t, "ticks", None)) or []
            base = getattr(base, "ticks", base)
            extra = args.get("extra") or []
            spans = [_u09_num(c.location) for c in f.center
                     if type(c).__name__ == "Span"
                     and getattr(c, "y_range_name", "") == "y3"]
            a3 = "|".join([type(ax).__name__, str(ax.axis_label or ""),
                           " ".join(_u09_num(v) for v in base),
                           " ".join(_u09_num(v) for v in extra),
                           " ".join(spans)])
        Macro.setGlobal("u09_a3" + sfx, a3)
    with open(sp, encoding="utf-8") as fh:
        go = json.load(fh)["graphs"][0]["graph_options"]
    Macro.setGlobal("u09_axn", json.dumps(go.get("axisn", {}),
                                          sort_keys=True))


def _u09_fix(key):
    import json, os
    from sfi import Macro
    with open(os.path.join("fixtures", "axes_n_truth.json"),
              encoding="utf-8") as fh:
        fx = json.load(fh)
    axes = sorted(fx["sides"][key]["axes"], key=lambda a: a["axis"])
    Macro.setGlobal("u09_f", " ".join("%d:%s:%d" % (a["axis"], a["side"],
                                                    a["order"])
                                      for a in axes))
end

capture program drop _u09_reg
program define _u09_reg
    // _u09_reg <dir> <k> <letter> <dash command...>
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    gettoken letter 0 : 0
    dash clear
    quietly dash `0'
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u09_m; _u09_m._u09_draw("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py", "`letter'")
end

* ==== S09 C10c: Axes three to nine ====
local only : env WP31_ONLY
if inlist("`only'", "", "S09") & `: list posof "S09" in w31_run' {
    display as text "S09 start " c(current_date) " " c(current_time)
    local u9d "`w31_work'/s09"
    capture mkdir "`u9d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear
    local three (scatter mpg weight, yaxis(1)) (scatter price weight, yaxis(2)) (scatter length weight, yaxis(3))

    // ------------------------------------------------------------
    // U09-1: three y axes -- twoway draws them (rc 0, three axes in the
    // .Graph); dash draws ranges y2 and y3, each layer on its own, and
    // the three axes on the fixture's sides (sides.y3: all on the left,
    // 1 innermost), the saved page and the served app alike.
    // ------------------------------------------------------------
    capture graph drop u9tw
    capture noisily twoway `three', nodraw name(u9tw, replace)
    _w31_expect U09-1 "(_rc == 0)" "twoway three axes rc `=_rc'"
    _w31_expect U09-1 `"("`.u9tw.yaxis3.isa'" != "")"' "twoway has no yaxis3"
    capture graph drop u9tw
    _u09_reg "`u9d'" 1 y `three', name(zu91)
    python: import __main__ as _u09_m; _u09_m._u09_fix("y3")
    foreach m in s v {
        _w31_expect U09-1 `"("${u09_ax`m'}" == "${u09_f}")"' "`m': axes ${u09_ax`m'}, twoway ${u09_f}"
        _w31_expect U09-1 `"("${u09_rn`m'}" == "default y2 y3")"' "`m': layers on ${u09_rn`m'}"
    }
    _w31_done U09-1 "three y axes drawn on twoway's sides, each layer on its own axis, saved and served"

    // ------------------------------------------------------------
    // U09-2: four y axes and three x axes on the fixture's sides
    // (sides.y4, sides.x3), and axes 1 and 3 alone (sides.y13: 3 on the
    // right), both modes.
    // ------------------------------------------------------------
    _u09_reg "`u9d'" 2 y `three' (scatter gear_ratio weight, yaxis(4)), name(zu92)
    python: import __main__ as _u09_m; _u09_m._u09_fix("y4")
    foreach m in s v {
        _w31_expect U09-2 `"("${u09_ax`m'}" == "${u09_f}")"' "y4 `m': axes ${u09_ax`m'}, twoway ${u09_f}"
    }
    _u09_reg "`u9d'" 3 x (scatter mpg weight, xaxis(1)) (scatter mpg price, xaxis(2)) (scatter mpg length, xaxis(3)), name(zu93)
    python: import __main__ as _u09_m; _u09_m._u09_fix("x3")
    foreach m in s v {
        _w31_expect U09-2 `"("${u09_ax`m'}" == "${u09_f}")"' "x3 `m': axes ${u09_ax`m'}, twoway ${u09_f}"
        _w31_expect U09-2 `"("${u09_rn`m'}" == "default x2 x3")"' "x3 `m': layers on ${u09_rn`m'}"
    }
    _u09_reg "`u9d'" 4 y (scatter mpg weight) (scatter length weight, yaxis(3)), name(zu94)
    python: import __main__ as _u09_m; _u09_m._u09_fix("y13")
    foreach m in s v {
        _w31_expect U09-2 `"("${u09_ax`m'}" == "${u09_f}")"' "y13 `m': axes ${u09_ax`m'}, twoway ${u09_f}"
    }
    _w31_done U09-2 "four y axes, three x axes and axes 1 and 3 on twoway's sides, saved and served"

    // ------------------------------------------------------------
    // U09-3: ylabel(), ytitle(), yscale(log), yline() and ytick() with
    // axis(3) reach the third axis, as twoway's do (routed.*: labels
    // 150-230, the title Len, unevenly spaced log labels, a line at 200,
    // ticks at 165 and 215), in the spec's axisn object and both modes.
    // ------------------------------------------------------------
    local rt ylabel(150(20)230, axis(3)) ytitle("Len", axis(3)) yscale(log axis(3)) yline(200, axis(3)) ytick(165 215, axis(3))
    capture graph drop u9tw
    capture noisily twoway `three', `rt' nodraw name(u9tw, replace)
    _w31_expect U09-3 "(_rc == 0)" "twoway routed rc `=_rc'"
    capture graph drop u9tw
    _u09_reg "`u9d'" 5 y `three', `rt' name(zu95)
    mata: st_local("hasl", strofreal(strpos(st_global("u09_axn"), char(34) + "label" + char(34) + ": " + char(34) + "150(20)230" + char(34)) > 0))
    _w31_expect U09-3 "(`hasl' == 1)" "the spec's axisn holds no ylabel(150(20)230, axis(3))"
    foreach m in s v {
        _w31_expect U09-3 `"("${u09_a3`m'}" == "LogAxis|Len|150 170 190 210 230|165 215|200")"' "`m': axis 3 ${u09_a3`m'}"
    }
    _w31_done U09-3 "axis(3) labels, title, log scale, line and ticks reach the third axis, saved and served"

    // ------------------------------------------------------------
    // U09-6: every layer on axis 3 -- twoway draws one left axis
    // (sides.y3_lone); dash draws one axis, the first, titled by
    // ytitle(, axis(3)).
    // ------------------------------------------------------------
    _u09_reg "`u9d'" 6 y scatter mpg weight, yaxis(3) ytitle("Only", axis(3)) name(zu96)
    foreach m in s v {
        _w31_expect U09-6 `"("${u09_ax`m'}" == "1:left:1" & "${u09_rn`m'}" == "default")"' "`m': axes ${u09_ax`m'}, layers ${u09_rn`m'}"
    }
    _w31_done U09-6 "a lone yaxis(3) is drawn as one left axis, saved and served"

    forvalues k = 1/6 {
        foreach p in s d {
            capture erase "`u9d'/`p'`k'.json"
        }
        capture erase "`u9d'/a`k'.py"
    }
    capture rmdir "`u9d'"
    dash clear
    display as text "S09 end " c(current_date) " " c(current_time)
}
* ==== end S09 ====

// S10 helpers (WP-31 F1a).  _u10_move: the saved page's lfit or qfit line
// after one filter move -- the page rendered, the widget set and its own
// callback run under node (test/js_runner.py) -- written to a JSON file,
// its point count in global u10_n.  _u10_ss: twoway's serset of one plot
// (drawn nodraw, saved, read back) written to a JSON file of its columns.
// _u10_close: the saved line against twoway's serset (either column
// order), the x converted to axis milliseconds for a date kind; global
// u10_ok 1 or 0 and u10_msg.
python:
def _u10_move(sp, dp, kind, value, out):
    import json
    import os
    import sys
    import warnings
    if os.getcwd() not in sys.path:
        sys.path.insert(0, os.getcwd())
    import dash_render as dr
    import js_runner
    from sfi import Macro
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
    w = [m for m in r.filter_widgets if type(m).__name__ == kind][0]
    if kind == "Select":
        w.value = [v for v, lab in w.options if lab == value][0]
    elif kind == "RangeSlider":
        w.value = tuple(float(v) for v in value.split())
    else:
        w.value = float(value)
    cb = r.filter_callbacks[r.filter_widgets.index(w)]
    js_runner.JsSession(r.filter_callbacks).run(cb)
    fits = [x for f in r.figures.values() for x in f.renderers
            if (getattr(x, "_dash_agg_config", None) or {}).get("type")
            in ("lfit", "qfit")]
    d = fits[0].data_source.data
    with open(out, "w", encoding="utf-8") as fh:
        json.dump({"x": [float(v) for v in d["x"]],
                   "y": [float(v) for v in d["y"]]}, fh)
    Macro.setGlobal("u10_n", str(len(d["x"])))


def _u10_take(out):
    import json
    from sfi import Data
    cols = {}
    for i in range(Data.getVarCount()):
        cols[Data.getVarName(i)] = [None if v is None or v >= 8.98e307
                                    else float(v) for v in Data.get(var=i)]
    with open(out, "w", encoding="utf-8") as fh:
        json.dump(cols, fh)


def _u10_close(tw, saved, xkind, rtol, xatol, lin=0):
    import json
    import numpy as np
    import dash_render as dr
    from sfi import Macro
    t = json.load(open(tw, encoding="utf-8"))
    g = json.load(open(saved, encoding="utf-8"))
    gx, gy = np.asarray(g["x"], float), np.asarray(g["y"], float)
    if xkind:
        # The saved x is axis ms; twoway's serset holds Stata units.
        gx = dr._dash_date_units(gx, xkind)
    cols = {k: np.asarray([np.nan if v is None else v for v in c], float)
            for k, c in t.items()}
    msg = "no column pair of twoway's serset (%s) matches the %d saved points" % (
        " ".join(cols), len(gx))
    ok = 0
    worst = []
    for a in cols:
        for b in cols:
            if a == b:
                continue
            tx, ty = cols[a], cols[b]
            keep = np.isfinite(tx) & np.isfinite(ty)
            tx, ty = tx[keep], ty[keep]
            if len(tx) == len(gx) and len(gx):
                worst.append("%s/%s: x %.3g y %.3g" % (
                    a, b, float(np.max(np.abs(gx - tx) / np.maximum(np.abs(tx), 1e-300))),
                    float(np.max(np.abs(gy - ty) / np.maximum(np.abs(ty), 1e-300)))))
            else:
                worst.append("%s/%s: %d rows" % (a, b, len(tx)))
            # twoway predicts at its grid as stored (a float x), so a
            # straight line is also read at those x: on a %td x the float
            # day is 0.001 off, a slope of 2 a day 0.002 in y.
            if len(tx) == len(gx) and len(gx) and np.allclose(
                    gx, tx, rtol=rtol, atol=float(xatol)) and (np.allclose(
                    gy, ty, rtol=rtol, atol=1e-12) or (lin and np.allclose(
                    np.interp(tx, gx, gy), ty, rtol=rtol, atol=1e-12))):
                ok, msg = 1, "%d points agree (x %s, y %s)" % (len(gx), a, b)
    if not ok:
        msg += " (largest relative differences " + "; ".join(worst) + ")"
    Macro.setGlobal("u10_ok", str(ok))
    Macro.setGlobal("u10_msg", msg)


def _u10_said(log, text):
    from sfi import Macro
    with open(log, encoding="utf-8", errors="replace") as fh:
        Macro.setGlobal("u10_said", "1" if text in fh.read() else "0")
end

capture program drop _u10_ss
program define _u10_ss
    // _u10_ss <out.json> <gph> <twoway plot ...>
    version 19
    gettoken out 0 : 0
    gettoken gph 0 : 0
    preserve
    capture erase "`gph'"
    quietly twoway (`0'), nodraw saving("`gph'", replace)
    capture graph drop _all
    capture serset drop _all
    quietly graph use "`gph'", nodraw
    quietly serset set 0
    quietly serset use, clear
    // A program's python runs in its own namespace: reach the do-file's.
    python: __import__("__main__")._u10_take("`out'")
    capture graph drop _all
    capture erase "`gph'"
    restore
end

* ==== S10 F1a: lfit and qfit refit on the saved page ====
local only : env WP31_ONLY
if inlist("`only'", "", "S10") & `: list posof "S10" in w31_run' {
    display as text "S10 start " c(current_date) " " c(current_time)
    local u10d "`w31_work'/s10"
    capture mkdir "`u10d'"
    capture graph drop _all

    // ------------------------------------------------------------
    // U10-01..03: after a move the saved line is twoway's line on the
    // kept rows: lfit after the dropdown to Foreign, qfit, n(50) after
    // the range to 4500-11385, lfit [aw=displacement] after the
    // dropdown to Domestic.  twoway's lfit draws 3 points by default
    // (the same line), so it is asked for dash's 100.
    // ------------------------------------------------------------
    local k 0
    foreach c in "U10-01|(scatter mpg weight) (lfit mpg weight)|foreign, type(dropdown)|Select|Foreign|lfit mpg weight if foreign == 1, n(100)" "U10-02|(scatter mpg weight) (qfit mpg weight, n(50))|price, type(range)|RangeSlider|4500 11385|qfit mpg weight if inrange(price, 4500, 11385), n(50)" "U10-03|lfit mpg weight [aw=displacement]|foreign, type(dropdown)|Select|Domestic|lfit mpg weight if foreign == 0 [aw=displacement], n(100)" {
        local ++k
        mata: u10_t = ustrsplit(st_local("c"), "[|]"); st_local("id", u10_t[1]); st_local("cmd", u10_t[2]); st_local("filt", u10_t[3]); st_local("kind", u10_t[4]); st_local("val", u10_t[5]); st_local("tw", u10_t[6])
        sysuse auto, clear
        dash clear
        capture noisily dash `cmd', name(zu10`k')
        _w31_expect `id' "(_rc == 0)" "dash `cmd' rc `=_rc'"
        _dash_serve_spec, specpath("`u10d'/s`k'.json") datapath("`u10d'/d`k'.json") filter(`filt')
        python: _u10_move("`u10d'/s`k'.json", "`u10d'/d`k'.json", "`kind'", "`val'", "`u10d'/g`k'.json")
        _u10_ss "`u10d'/t`k'.json" "`u10d'/t`k'.gph" `tw'
        // A serset stores floats: twoway's values are read to 3e-7.
        python: _u10_close("`u10d'/t`k'.json", "`u10d'/g`k'.json", "", 3e-7, 0)
        _w31_expect `id' "(${u10_ok} == 1)" "dash `cmd', filter(`filt') moved to `val': ${u10_msg}"
        _w31_done `id' "the saved `cmd' after the move to `val' is twoway `tw' (${u10_msg})"
    }

    // ------------------------------------------------------------
    // U10-04: a move leaving one row empties the saved line; twoway on
    // that row draws no line (rc and note measured).
    // ------------------------------------------------------------
    sysuse auto, clear
    dash clear
    capture noisily dash (scatter mpg weight) (lfit mpg weight), name(zu104)
    _w31_expect U10-04 "(_rc == 0)" "dash lfit rc `=_rc'"
    _dash_serve_spec, specpath("`u10d'/s4.json") datapath("`u10d'/d4.json") filter(price, type(slider))
    python: _u10_move("`u10d'/s4.json", "`u10d'/d4.json", "Slider", "15906", "`u10d'/g4.json")
    _w31_expect U10-04 "(${u10_n} == 0)" "the saved lfit after the slider to 15906 holds ${u10_n} points"
    quietly count if price >= 15906
    _w31_expect U10-04 "(r(N) == 1)" "price >= 15906 keeps `r(N)' rows"
    local lf "`u10d'/t4.log"
    quietly log using "`lf'", text replace name(u10l)
    capture noisily twoway lfit mpg weight if price >= 15906, nodraw
    local trc = _rc
    quietly log close u10l
    python: _u10_said("`lf'", "could not fit model")
    _w31_expect U10-04 "(`trc' != 0 | ${u10_said} == 1)" "twoway lfit on one row: rc `trc', note ${u10_said}"
    _w31_done U10-04 "one kept row: the saved line is empty; twoway draws none (rc `trc', note ${u10_said})"

    // ------------------------------------------------------------
    // U10-05: a %td x refits in days and is drawn in axis milliseconds:
    // the saved points after the slider to 4, read back in days
    // (_dash_date_units), are twoway's serset to its float precision.
    // ------------------------------------------------------------
    clear
    quietly set obs 10
    quietly generate x = _n
    quietly generate y = 2 * x + 1
    quietly generate d = mdy(1, _n, 2020)
    format d %td
    dash clear
    capture noisily dash lfit y d, name(zu105)
    _w31_expect U10-05 "(_rc == 0)" "dash lfit y d rc `=_rc'"
    _dash_serve_spec, specpath("`u10d'/s5.json") datapath("`u10d'/d5.json") filter(x, type(slider))
    python: _u10_move("`u10d'/s5.json", "`u10d'/d5.json", "Slider", "4", "`u10d'/g5.json")
    _u10_ss "`u10d'/t5.json" "`u10d'/t5.gph" lfit y d if x >= 4, n(100)
    python: _u10_close("`u10d'/t5.json", "`u10d'/g5.json", "td", 3e-7, 0, 1)
    _w31_expect U10-05 "(${u10_ok} == 1)" "dash lfit y d (%td) after the slider to 4: ${u10_msg}"
    _w31_done U10-05 "a %td x refits in days and draws in ms (${u10_msg})"

    forvalues k = 1/5 {
        foreach p in s d g t {
            capture erase "`u10d'/`p'`k'.json"
        }
    }
    capture erase "`lf'"
    capture rmdir "`u10d'"
    macro drop u10_n u10_ok u10_msg u10_said
    capture mata: mata drop u10_t
    dash clear
    display as text "S10 end " c(current_date) " " c(current_time)
}
* ==== end S10 ====

// S11 helpers (WP-31 C4).  _u11_run: one command under capture noisily
// with its own log; r(rc) and r(has) (1 when the log holds the needle,
// Stata's wrapped lines re-joined).  _u11_pts: the points dash stored for
// plot k of a graph (the served spec's function_points) against twoway's
// serset of the same layer (_u10_ss's JSON): every column within rtol;
// global u11_ok 1 or 0 and u11_msg.  _u11_layer: the saved page and the
// served app of a spec, the visibility of the layer's line and band.
python:
def _u11_pts(spec, gname, k, tw, rtol):
    import json
    import numpy as np
    from sfi import Macro
    sp = json.load(open(spec, encoding="utf-8"))
    p = (sp.get("function_points") or {}).get(gname, {}).get(str(k))
    t = json.load(open(tw, encoding="utf-8"))
    cols = [np.asarray([np.nan if v is None else v for v in c], float)
            for c in t.values()]
    if not isinstance(p, dict):
        Macro.setGlobal("u11_ok", "0")
        Macro.setGlobal("u11_msg", "no points stored for %s plot %s" % (gname, k))
        return
    want = [cols[-1], cols[0]] + (cols[1:3] if len(cols) == 4 else [])
    got = [np.asarray([np.nan if v is None else v for v in p[c]], float)
           for c in (["x", "y", "lo", "hi"] if "lo" in p else ["x", "y"])]
    ok = len(want) == len(got) and all(
        len(a) == len(b) and np.allclose(a, b, rtol=rtol, atol=0,
                                         equal_nan=True)
        for a, b in zip(got, want))
    Macro.setGlobal("u11_ok", "1" if ok else "0")
    Macro.setGlobal("u11_msg", "%d stored points, %d columns, against twoway's %d rows, %d columns" % (
        len(got[0]), len(got), len(want[0]), len(want)))


def _u11_layer(spec, data, gname):
    import os
    import sys
    import warnings
    if os.getcwd() not in sys.path:
        sys.path.insert(0, os.getcwd())
    import dash_render as dr
    from bokeh.document import Document
    from bokeh.models import GlyphRenderer, Plot
    from sfi import Macro
    out = []
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(spec, data)
        r.render()
        figs = [r.figures[gname]]
        app = os.path.join(os.path.dirname(spec), "u11_app.py")
        dr.ServerAppBuilder(spec, data).build(app)
        import importlib.util
        su = importlib.util.spec_from_file_location("u11_app", app)
        mod = importlib.util.module_from_spec(su)
        su.loader.exec_module(mod)
        doc = Document()
        mod.make_document(doc)
        figs += [m for m in doc.models if isinstance(m, Plot)
                 and any(isinstance(x, GlyphRenderer) for x in m.renderers)]
    for f in figs:
        rs = [x for x in f.renderers if isinstance(x, GlyphRenderer)]
        lines = [x.visible for x in rs if type(x.glyph).__name__ == "Line"]
        bands = [x.visible for x in rs if type(x.glyph).__name__ == "VArea"]
        out.append("%s/%s" % ("".join("1" if v else "0" for v in lines),
                              "".join("1" if v else "0" for v in bands)))
    Macro.setGlobal("u11_vis", " ".join(out))
end

capture program drop _u11_run
program define _u11_run, rclass
    // _u11_run <log> <needle> <command ...>
    version 19
    gettoken lf 0 : 0
    gettoken needle 0 : 0
    capture log close u11l
    quietly log using "`lf'", text replace name(u11l)
    capture noisily `0'
    local rc = _rc
    // A paragraph-mode message ({p 0 8}) reaches the log when it ends.
    display as text "{p_end}"
    quietly log close u11l
    local has 0
    if `"`needle'"' != "" {
        mata: st_local("has", strofreal(strpos(subinstr(invtokens(cat(st_local("lf"))', char(10)), char(10) + "> ", ""), st_local("needle")) > 0))
    }
    capture erase "`lf'"
    return scalar rc = `rc'
    return scalar has = `has'
end

* ==== S11 C4: fit options ====
local only : env WP31_ONLY
if inlist("`only'", "", "S11") & `: list posof "S11" in w31_run' {
    display as text "S11 start " c(current_date) " " c(current_time)
    local u11d "`w31_work'/s11"
    capture mkdir "`u11d'"
    local lf "`u11d'/run.log"
    capture graph drop _all
    sysuse auto, clear

    // ------------------------------------------------------------
    // U11-01: a second copy of atobs, nofit, fitplot() or ciplot() is
    // refused as twoway refuses it; estopts() twice is the rightmost.
    // ------------------------------------------------------------
    foreach c in "lfit mpg weight, atobs atobs|option atobs not allowed" "lfitci mpg weight, nofit nofit|option nofit not allowed" "lfitci mpg weight, fitplot(scatter) fitplot(line)|option fitplot() not allowed" "lfitci mpg weight, ciplot(rcap) ciplot(rarea)|option ciplot() not allowed" "lfit mpg weight, estopts(noconstant) estopts(noconstant)|" {
        gettoken cmd msg : c, parse("|")
        local msg = substr(`"`msg'"', 2, .)
        _u11_run "`lf'" `"`msg'"' twoway `cmd' nodraw
        local trc = r(rc)
        local th = r(has)
        dash clear
        _u11_run "`lf'" `"`msg'"' dash `cmd' name(zu11)
        local drc = r(rc)
        local dh = r(has)
        local nomsg = (`"`msg'"' == "")
        _w31_expect U11-01 "(`trc' == `drc') & (`th' == `dh') & (`th' == 1 | `nomsg')" "`cmd': twoway rc `trc' (`th'), dash rc `drc' (`dh')"
    }
    _w31_done U11-01 "a repeated fit option is refused, or taken, as twoway takes it"

    // ------------------------------------------------------------
    // U11-02: atobs and an observation-level predopts() with range()
    // are refused in twoway's words; predopts(stdp) with range() is taken.
    // ------------------------------------------------------------
    foreach c in "lfit mpg weight, atobs range(1000 5000)|may not combine atobs with range()" "qfitci mpg weight, predopts(residuals) range(1000 5000)|may not combine residuals with range()" "lfit mpg weight, predopts(stdp) range(1000 5000)|" {
        gettoken cmd msg : c, parse("|")
        local msg = substr(`"`msg'"', 2, .)
        _u11_run "`lf'" `"`msg'"' twoway `cmd' nodraw
        local trc = r(rc)
        local th = r(has)
        dash clear
        _u11_run "`lf'" `"`msg'"' dash `cmd' name(zu11)
        local drc = r(rc)
        local dh = r(has)
        local nomsg = (`"`msg'"' == "")
        _w31_expect U11-02 "(`trc' == `drc') & (`th' == `dh') & (`th' == 1 | `nomsg')" "`cmd': twoway rc `trc' (`th'), dash rc `drc' (`dh')"
    }
    _w31_done U11-02 "atobs and predopts() with range() as twoway reads them"

    // ------------------------------------------------------------
    // U11-03: estopts(), predopts() and estcmd() -- the points dash stores
    // are twoway's serset of the same layer (floats, so to 1e-7).
    // ------------------------------------------------------------
    local k 0
    foreach c in "lfit mpg weight, estopts(noconstant)" "fpfit mpg weight, estopts(degree(3))" "lfitci mpg weight, estopts(noconstant)" "qfitci mpg weight [aw=trunk], estopts(noconstant) level(90)" "fpfitci mpg weight, estcmd(glm)" "lfit mpg weight if foreign, predopts(residuals)" "qfit mpg weight, estopts(noconstant) n(7) range(2000 .)" {
        local ++k
        sysuse auto, clear
        dash clear
        capture noisily dash `c' name(zu113)
        _w31_expect U11-03 "(_rc == 0)" "dash `c' rc `=_rc'"
        _dash_serve_spec, specpath("`u11d'/s`k'.json") datapath("`u11d'/d`k'.json")
        _u10_ss "`u11d'/t`k'.json" "`u11d'/t`k'.gph" `c'
        python: _u11_pts("`u11d'/s`k'.json", "zu113", 1, "`u11d'/t`k'.json", 1e-7)
        _w31_expect U11-03 "(${u11_ok} == 1)" "`c': ${u11_msg}"
    }
    _w31_done U11-03 "estopts(), predopts() and estcmd() layers store twoway's own points (${u11_msg})"

    // ------------------------------------------------------------
    // U11-04: an unknown fitplot() or ciplot() name prints twoway's two
    // notes, rc 0; smoothplot() is taken in silence; the spellings.
    // ------------------------------------------------------------
    sysuse auto, clear
    foreach c in "lfitci mpg weight, fitplot(bogus)|named style bogus not found in class yxtype, default attributes used" "lfitci mpg weight, ciplot(sc)|named style sc not found in class y2xtype, default attributes used" "lfitci mpg weight, fitplot(sc) ciplot(rsc)|named style" "lpolyci mpg weight, smoothplot(bogus)|named style" {
        gettoken cmd msg : c, parse("|")
        local msg = substr(`"`msg'"', 2, .)
        _u11_run "`lf'" `"`msg'"' twoway `cmd' nodraw
        local trc = r(rc)
        local th = r(has)
        dash clear
        _u11_run "`lf'" `"`msg'"' dash `cmd' name(zu11)
        local drc = r(rc)
        local dh = r(has)
        _w31_expect U11-04 "(`trc' == 0) & (`drc' == 0) & (`th' == `dh')" "`cmd': twoway rc `trc' (`th'), dash rc `drc' (`dh')"
    }
    mata: st_local("u11c", _dash_recast_canon("rsc", "rscatter:3 rline:3 rarea:5"))
    _w31_expect U11-04 `"("`u11c'" == "rscatter")"' "_dash_recast_canon(rsc) is `u11c'"
    mata: st_local("u11c", _dash_recast_canon("rs", "rscatter:3 rline:3 rarea:5"))
    _w31_expect U11-04 `"("`u11c'" == "")"' "_dash_recast_canon(rs) is `u11c'"
    _w31_done U11-04 "fitplot(), ciplot() and smoothplot() names read as twoway reads them"

    // ------------------------------------------------------------
    // U11-05: nofit draws the band alone, in the saved page and the
    // served app.
    // ------------------------------------------------------------
    sysuse auto, clear
    dash clear
    capture noisily dash lfitci mpg weight, nofit name(zu115)
    _w31_expect U11-05 "(_rc == 0)" "dash lfitci, nofit rc `=_rc'"
    _dash_serve_spec, specpath("`u11d'/s5n.json") datapath("`u11d'/d5n.json")
    python: _u11_layer("`u11d'/s5n.json", "`u11d'/d5n.json", "zu115")
    _w31_expect U11-05 `"("${u11_vis}" == "0/1 0/1")"' "line/band visible, saved and served: ${u11_vis}"
    _w31_done U11-05 "lfitci, nofit: the band alone in both renderers (${u11_vis})"

    // ------------------------------------------------------------
    // U11-06: estopts() text that may not reach a command line is refused
    // before anything is registered.
    // ------------------------------------------------------------
    sysuse auto, clear
    dash clear
    local nl = char(10)
    local cr = char(13)
    foreach v in `"noconstant; display 1"' `"a`nl'b"' `"a`cr'b"' {
        _u11_run "`lf'" "option estopts() incorrectly specified" dash lfit mpg weight, estopts(`v') name(zu116)
        _w31_expect U11-06 "(r(rc) == 198) & (r(has) == 1)" "estopts() holding a refused character: rc `r(rc)', said `r(has)'"
    }
    // An odd double quote: refused by the command line's own parse first.
    _u11_run "`lf'" "" dash lfit mpg weight, estopts(x" y) name(zu116)
    _w31_expect U11-06 "(r(rc) == 198)" "estopts() holding an odd quote: rc `r(rc)'"
    _w31_expect U11-06 `"(`"${dash_graph_registry}"' == "")"' "the registry holds ${dash_graph_registry}"
    _w31_done U11-06 "estopts() with ; or a line break or an odd quote refused, nothing registered"

    forvalues k = 1/7 {
        foreach p in s d t {
            capture erase "`u11d'/`p'`k'.json"
        }
    }
    foreach f in s5n.json d5n.json u11_app.py {
        capture erase "`u11d'/`f'"
    }
    capture rmdir "`u11d'"
    macro drop u11_ok u11_msg u11_vis
    dash clear
    display as text "S11 end " c(current_date) " " c(current_time)
}
* ==== end S11 ====

// S12 helpers (WP-31 C5).  _u12_draw: what a registered dash graph draws,
// saved and served -- each Quad's width and centre, the first Line's x
// ends and y maximum, each Segment's y0 and y1, the VBar centres and the
// glyph types -- into globals u12_<k>s (saved) and u12_<k>v (served), and
// the spec's stored droplines pairs into u12_drops.  Built on _u03_docs.
python:
def _u12_draw(sp, dp, app):
    import json
    from sfi import Macro
    a, b = _u03_docs(sp, dp, app)
    for figs, sfx in ((a, "s"), (b, "v")):
        out = {"k": [], "qw": [], "qc": [], "lx0": [], "lx1": [], "ly": [],
               "sy0": [], "sy1": [], "bx": []}
        for f in figs:
            for r in f.renderers:
                g = getattr(r, "glyph", None)
                t = type(g).__name__
                d = getattr(r.data_source, "data", {})
                if t not in ("Quad", "Line", "Segment", "VBar", "Patch",
                             "VArea"):
                    continue
                out["k"].append(t)
                if t == "Quad":
                    for lo, hi in zip(d["left"], d["right"]):
                        out["qw"].append("%.15g" % (float(hi) - float(lo)))
                        out["qc"].append("%.15g" % ((float(hi) + float(lo)) / 2))
                elif t == "Line" and not out["lx0"]:
                    xs = [float(v) for v in d[g.x if isinstance(g.x, str) else g.x.field]]
                    ys = [float(v) for v in d[g.y if isinstance(g.y, str) else g.y.field]]
                    if xs:
                        out["lx0"].append("%.17g" % xs[0])
                        out["lx1"].append("%.17g" % xs[-1])
                        out["ly"].append("%.17g" % max(ys))
                elif t == "Segment":
                    out["sy0"] += ["%.15g" % float(v) for v in d["y0"]]
                    out["sy1"] += ["%.15g" % float(v) for v in d["y1"]]
                elif t == "VBar":
                    xf = g.x if isinstance(g.x, str) else g.x.field
                    out["bx"] += ["%.15g" % float(v) for v in d[xf]]
        for k, v in out.items():
            Macro.setGlobal("u12_%s%s" % (k, sfx), " ".join(v))
    with open(sp, encoding="utf-8") as fh:
        spec = json.load(fh)
    drops = []
    for g in (spec.get("function_points") or {}).values():
        for pts in g.values():
            for x, y in pts.get("drops", []):
                drops.append("%.15g %.15g" % (x, y))
    Macro.setGlobal("u12_drops", " ".join(drops))
end

capture program drop _u12_reg
program define _u12_reg
    // _u12_reg <dir> <k> <dash command...>: register one graph, write its
    // spec and data, and read what both modes draw (_u12_draw).
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    dash clear
    quietly dash `0'
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u12_m; _u12_m._u12_draw("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py")
end

capture program drop _u12_ser
program define _u12_ser, rclass
    // _u12_ser <graph>: plot 1's serset of a drawn twoway graph -- the
    // min and max of its first and second variables (r(min1) .. r(max2)).
    version 19
    args g
    local id "`.`g'.plotregion1.plot1.serset.id'"
    preserve
    quietly serset set `id'
    quietly serset use, clear
    unab vs : _all
    local i 0
    foreach v of local vs {
        local ++i
        quietly summarize `v'
        return scalar min`i' = r(min)
        return scalar max`i' = r(max)
    }
    restore
end

capture program drop _u12_refuse
program define _u12_refuse
    // _u12_refuse <id> <log> <message> | <command...>: twoway's and
    // dash's return codes for the command, and dash's log holds the
    // message twoway printed.
    version 19
    gettoken id 0 : 0
    gettoken lf 0 : 0
    gettoken msg 0 : 0
    capture graph drop _all
    capture noisily twoway `0' nodraw
    local tw = _rc
    dash clear
    quietly log using "`lf'", text replace name(u12r)
    capture noisily dash `0'
    local dr = _rc
    quietly log close u12r
    cert_log_has "`lf'", needle(`"`msg'"')
    _w31_expect `id' "(`tw' == `dr') & (`tw' != 0) & (r(found))" `"`0': twoway r(`tw'), dash r(`dr'), dash said "`msg'" `r(count)' times"'
end

* ==== S12 C5: distribution, area and bar odds ====
local only : env WP31_ONLY
if inlist("`only'", "", "S12") & `: list posof "S12" in w31_run' {
    display as text "S12 start " c(current_date) " " c(current_time)
    local u12d "`w31_work'/s12"
    capture mkdir "`u12d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear

    // ------------------------------------------------------------
    // U12-01: histogram gap(20): dash's bars are twoway's bar_size wide,
    // both modes; gap(20) gap(30) is taken twice, the rightmost standing.
    // ------------------------------------------------------------
    quietly twoway histogram mpg, gap(20) name(u12t, replace)
    local bs = `.u12t.plotregion1.plot1.bar_size'
    _u12_reg "`u12d'" 1 histogram mpg, gap(20) name(zu1)
    _u03_all `bs' ${u12_qws} ${u12_qwv}
    _w31_expect U12-01 "(r(ok))" "gap(20) widths saved ${u12_qws} served ${u12_qwv}, twoway bar_size `bs'"
    capture noisily twoway histogram mpg, gap(20) gap(30) name(u12t, replace)
    local tw = _rc
    local bs = `.u12t.plotregion1.plot1.bar_size'
    _u12_reg "`u12d'" 2 histogram mpg, gap(20) gap(30) name(zu2)
    _u03_all `bs' ${u12_qws} ${u12_qwv}
    _w31_expect U12-01 "(`tw' == 0) & (r(ok))" "gap(20) gap(30): twoway r(`tw') bar_size `bs', dash ${u12_qws}"
    _w31_done U12-01 "histogram gap(20) draws bars twoway's bar_size wide (saved and served); a second gap() stands"

    // ------------------------------------------------------------
    // U12-02: the refusals, in twoway's code and words.
    // ------------------------------------------------------------
    local lf "`u12d'/r.log"
    _u12_refuse U12-02 "`lf'" "option gap() must be between 0 and 100" histogram mpg, gap(100)
    _u12_refuse U12-02 "`lf'" "option gap() must be between 0 and 100" histogram mpg, gap(-1)
    _u12_refuse U12-02 "`lf'" "option area() expects a positive number" kdensity mpg, area(0)
    _u12_refuse U12-02 "`lf'" "only one of options range() or boundary is allowed" kdensity mpg, boundary range(10 30)
    _u12_refuse U12-02 "`lf'" "some droplines not within range() option" function y = x, range(0 1) droplines(2)
    _u12_refuse U12-02 "`lf'" "option boundary not allowed" kdensity mpg, boundary boundary
    _u12_refuse U12-02 "`lf'" "option nodropbase not allowed" area mpg weight, nodropbase nodropbase
    _u12_refuse U12-02 "`lf'" "option area() not allowed" histogram mpg, area(2)
    _w31_done U12-02 "gap(100), gap(-1), area(0), boundary with range(), a dropline outside range(), boundary twice, nodropbase twice and area() on histogram are refused as twoway refuses them"

    // ------------------------------------------------------------
    // U12-03: kdensity area(74) is 74 times the density and twoway's
    // curve; boundary's grid runs over twoway's x span.
    // ------------------------------------------------------------
    _u12_reg "`u12d'" 3 kdensity mpg, name(zu3)
    local y0s "${u12_lys}"
    _u12_reg "`u12d'" 4 kdensity mpg, area(74) name(zu4)
    _w31_expect U12-03 "(abs(${u12_lys} / `y0s' - 74) < 1e-9) & (abs(${u12_lyv} / `y0s' - 74) < 1e-9)" "area(74) max saved ${u12_lys} served ${u12_lyv}, plain `y0s'"
    quietly twoway kdensity mpg, area(74) name(u12t, replace)
    _u12_ser u12t
    local ty = r(max1)
    _w31_expect U12-03 "(abs(${u12_lys} / `ty' - 1) < 1e-6)" "area(74) max dash ${u12_lys}, twoway `ty'"
    foreach o in "boundary" "boundary bwidth(2)" {
        quietly twoway kdensity mpg, `o' name(u12t, replace)
        _u12_ser u12t
        local tx0 = r(min2)
        local tx1 = r(max2)
        _u12_reg "`u12d'" 5 kdensity mpg, `o' name(zu5)
        _w31_expect U12-03 "(abs(${u12_lx0s} - `tx0') < 1e-9) & (abs(${u12_lx1s} - `tx1') < 1e-9) & (abs(${u12_lx0v} - `tx0') < 1e-9) & (abs(${u12_lx1v} - `tx1') < 1e-9)" "`o': dash x ${u12_lx0s}..${u12_lx1s} (served ${u12_lx0v}..${u12_lx1v}), twoway `tx0'..`tx1'"
    }
    _w31_done U12-03 "kdensity area(74) scales the density 74 times as twoway does; boundary spans twoway's x range, saved and served"

    // ------------------------------------------------------------
    // U12-04: function droplines(-1 1) base(1): the stored pairs are
    // twoway's .droplines; both modes draw the Segments from y = 1.
    // ------------------------------------------------------------
    quietly twoway function y = x^2, range(-2 2) droplines(-1 1) base(1) name(u12t, replace)
    local tdl `"`.u12t.plotregion1.plot1.droplines'"'
    local tdl : subinstr local tdl `"""' "", all
    local tdl : list retok tdl
    _u12_reg "`u12d'" 6 function y = x^2, range(-2 2) droplines(-1 1) base(1) name(zu6)
    _w31_expect U12-04 `"("${u12_drops}" == "`tdl'")"' "stored drops ${u12_drops}, twoway `tdl'"
    _w31_expect U12-04 `"("${u12_sy0s}" == "1 1") & ("${u12_sy0v}" == "1 1") & ("${u12_sy1s}" == "1 1")"' "Segment y0 ${u12_sy0s} / ${u12_sy0v}, y1 ${u12_sy1s}"
    _w31_done U12-04 "function droplines(-1 1) base(1) stores twoway's pairs and draws the drops from y = 1, saved and served"

    // ------------------------------------------------------------
    // U12-05: function base(abc): twoway's code and sentence.
    // ------------------------------------------------------------
    _u12_refuse U12-05 "`lf'" "option base() incorrectly specified, abc is not a number" function y = x^2, base(abc)
    _w31_done U12-05 "function base(abc) is refused with twoway's code and sentence"

    // ------------------------------------------------------------
    // U12-06: area nodropbase is a Patch in both modes; twoway's
    // drop_base is no.
    // ------------------------------------------------------------
    quietly twoway area mpg weight, nodropbase name(u12t, replace)
    local tdb "`.u12t.plotregion1.plot1.drop_base.stylename'"
    _u12_reg "`u12d'" 7 area mpg weight, nodropbase name(zu7)
    _w31_expect U12-06 `"("`tdb'" == "no") & ("${u12_ks}" == "Patch") & ("${u12_kv}" == "Patch")"' "twoway drop_base `tdb', dash ${u12_ks} / ${u12_kv}"
    _w31_done U12-06 "area nodropbase draws one Patch closed on its chord, saved and served"

    // ------------------------------------------------------------
    // U12-07: bar baroffset(.5): each centre x + .5 * bar_size.
    // ------------------------------------------------------------
    quietly twoway bar mpg weight in 1/5, baroffset(.5) name(u12t, replace)
    local tbs = `.u12t.plotregion1.plot1.bar_size'
    local tbo = `.u12t.plotregion1.plot1.bar_offset'
    local want ""
    forvalues i = 1/5 {
        local want "`want' `=strofreal(weight[`i'] + `tbo' * `tbs', "%15.0g")'"
    }
    local want : list retok want
    _u12_reg "`u12d'" 8 bar mpg weight in 1/5, baroffset(.5) name(zu8)
    _w31_expect U12-07 `"("${u12_bxs}" == "`want'") & ("${u12_bxv}" == "`want'")"' "centres saved ${u12_bxs} served ${u12_bxv}, twoway `want'"
    _w31_done U12-07 "bar baroffset(.5) moves each bar half a bar, as twoway's bar_offset * bar_size"

    capture erase "`lf'"
    forvalues k = 1/8 {
        foreach p in s d {
            capture erase "`u12d'/`p'`k'.json"
        }
        capture erase "`u12d'/a`k'.py"
    }
    capture rmdir "`u12d'"
    capture graph drop u12t
    dash clear
    display as text "S12 end " c(current_date) " " c(current_time)
}
* ==== end S12 ====

// S13 helpers (WP-31 F1b).  _u13_move: the saved page's lfitci or qfitci
// after one filter move -- the page rendered, the widget set and its own
// callback run under node (test/js_runner.py) -- its four columns (x,
// line, lower, upper; a missing limit as null) written to a JSON file,
// the point count in global u13_n and the count of finite limits in
// u13_band.  _u13_close: each saved column against a column of twoway's
// serset (_u10_ss's JSON, rows in grid order), a missing value equal to
// a missing value; global u13_ok 1 or 0 and u13_msg.
python:
def _u13_move(sp, dp, kind, value, out):
    import json
    import math
    import os
    import sys
    import warnings
    if os.getcwd() not in sys.path:
        sys.path.insert(0, os.getcwd())
    import dash_render as dr
    import js_runner
    from sfi import Macro
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
    w = [m for m in r.filter_widgets if type(m).__name__ == kind][0]
    if kind == "Select":
        w.value = [v for v, lab in w.options if lab == value][0]
    elif kind == "RangeSlider":
        w.value = tuple(float(v) for v in value.split())
    else:
        w.value = float(value)
    cb = r.filter_callbacks[r.filter_widgets.index(w)]
    js_runner.JsSession(r.filter_callbacks).run(cb)
    fits = [x for f in r.figures.values() for x in f.renderers
            if (getattr(x, "_dash_agg_config", None) or {}).get("type")
            in ("lfitci", "qfitci")]
    d = fits[0].data_source.data

    def col(c):
        out = []
        for v in d[c]:
            v = float("nan") if v is None else float(v)
            out.append(v if math.isfinite(v) else None)
        return out

    cols = {c: col(c) for c in ("x_fit", "y_fit", "y_lower", "y_upper")}
    with open(out, "w", encoding="utf-8") as fh:
        json.dump(cols, fh)
    Macro.setGlobal("u13_n", str(len(cols["x_fit"])))
    Macro.setGlobal("u13_band", str(sum(v is not None
                                        for v in cols["y_lower"])))


def _u13_close(tw, saved, rtol):
    import json
    import numpy as np
    from sfi import Macro
    t = json.load(open(tw, encoding="utf-8"))
    g = json.load(open(saved, encoding="utf-8"))
    arr = lambda c: np.asarray([np.nan if v is None else v for v in c],
                               float)
    tcols = {k: arr(c) for k, c in t.items()}
    ok, said = 1, []
    for c in ("x_fit", "y_fit", "y_lower", "y_upper"):
        gv = arr(g[c])
        hit = [k for k, tv in tcols.items() if len(tv) == len(gv)
               and len(gv) and np.allclose(gv, tv, rtol=rtol, atol=1e-12,
                                           equal_nan=True)]
        if hit:
            said.append("%s=%s" % (c, hit[0]))
        else:
            ok = 0
            said.append("%s matches no serset column (%s; %d saved rows)"
                        % (c, " ".join(tcols), len(gv)))
    Macro.setGlobal("u13_ok", str(ok))
    Macro.setGlobal("u13_msg", ", ".join(said))
end

* ==== S13 F1b: lfitci and qfitci refit on the saved page ====
local only : env WP31_ONLY
if inlist("`only'", "", "S13") & `: list posof "S13" in w31_run' {
    display as text "S13 start " c(current_date) " " c(current_time)
    local u13d "`w31_work'/s13"
    capture mkdir "`u13d'"
    capture graph drop _all

    // ------------------------------------------------------------
    // U13-01..05: after a move the saved line and band are twoway's on
    // the kept rows: lfitci after the dropdown to Foreign; qfitci,
    // level(90) n(20) after the range to 4500-11385; lfitci, stdf after
    // the dropdown to Domestic; lfitci [fw=rep78] after the dropdown to
    // Foreign; and lfitci after the slider to 14500, which keeps two
    // rows: the line, and limits missing in both (df 0).
    // ------------------------------------------------------------
    local k 0
    foreach c in "U13-01|(scatter mpg weight) (lfitci mpg weight)|foreign, type(dropdown)|Select|Foreign|lfitci mpg weight if foreign == 1, n(100)" "U13-02|(qfitci mpg weight, level(90) n(20))|price, type(range)|RangeSlider|4500 11385|qfitci mpg weight if inrange(price, 4500, 11385), level(90) n(20)" "U13-03|(lfitci mpg weight, stdf)|foreign, type(dropdown)|Select|Domestic|lfitci mpg weight if foreign == 0, stdf n(100)" "U13-04|lfitci mpg weight [fw=rep78]|foreign, type(dropdown)|Select|Foreign|lfitci mpg weight if foreign == 1 [fw=rep78], n(100)" "U13-05|(scatter mpg weight) (lfitci mpg weight)|price, type(slider)|Slider|14500|lfitci mpg weight if price >= 14500, n(100)" {
        local ++k
        mata: u13_t = ustrsplit(st_local("c"), "[|]"); st_local("id", u13_t[1]); st_local("cmd", u13_t[2]); st_local("filt", u13_t[3]); st_local("kind", u13_t[4]); st_local("val", u13_t[5]); st_local("tw", u13_t[6])
        sysuse auto, clear
        dash clear
        capture noisily dash `cmd', name(zu13`k')
        _w31_expect `id' "(_rc == 0)" "dash `cmd' rc `=_rc'"
        _dash_serve_spec, specpath("`u13d'/s`k'.json") datapath("`u13d'/d`k'.json") filter(`filt')
        python: _u13_move("`u13d'/s`k'.json", "`u13d'/d`k'.json", "`kind'", "`val'", "`u13d'/g`k'.json")
        _u10_ss "`u13d'/t`k'.json" "`u13d'/t`k'.gph" `tw'
        // A serset stores floats: twoway's values are read to 3e-7.
        python: _u13_close("`u13d'/t`k'.json", "`u13d'/g`k'.json", 3e-7)
        _w31_expect `id' "(${u13_ok} == 1)" "dash `cmd', filter(`filt') moved to `val': ${u13_msg}"
        if "`id'" == "U13-05" {
            quietly count if price >= 14500
            _w31_expect `id' "(r(N) == 2)" "price >= 14500 keeps `r(N)' rows"
            _w31_expect `id' "(${u13_n} == 100 & ${u13_band} == 0)" "two kept rows: ${u13_n} line points, ${u13_band} finite limits"
        }
        _w31_done `id' "the saved `cmd' after the move to `val' is twoway `tw' (${u13_n} points, ${u13_band} finite limits; ${u13_msg})"
    }

    forvalues k = 1/5 {
        foreach p in s d g t {
            capture erase "`u13d'/`p'`k'.json"
        }
    }
    capture rmdir "`u13d'"
    macro drop u13_n u13_band u13_ok u13_msg
    capture mata: mata drop u13_t
    dash clear
    display as text "S13 end " c(current_date) " " c(current_time)
}
* ==== end S13 ====

// S14 helpers (WP-31 C6).  _u14_svg: twoway's drawing read from its SVG
// (scripts/svg_truth.py's axis fit maps pixels to data): each closed
// subpath's x extent (an area's or rarea's polygons), the first closed
// subpath's vertex count and each open subpath's vertex count, into
// globals u14_tpoly, u14_tnv and u14_truns.  _u14_draw: what a registered
// dash graph draws, saved and served (_u03_docs): the first VArea's
// filled runs (its vertex list split at each zero-height pair) as x
// extents, its vertex count, the first visible Line's runs and every
// glyph's type, into u14_poly<s|v>, u14_nv<s|v>, u14_runs<s|v> and
// u14_k<s|v>.
python:
def _u14_fit(path, axis):
    from svg_truth import svg_axis_reading
    pairs = svg_axis_reading(path, axis).get("pairs") or []
    n = float(len(pairs))
    mx = sum(p for p, _ in pairs) / n
    mv = sum(v for _, v in pairs) / n
    b = (sum((p - mx) * (v - mv) for p, v in pairs)
         / sum((p - mx) ** 2 for p, _ in pairs))
    return (mv - b * mx, b)


def _u14_svg(path):
    import re
    from sfi import Macro
    fx = _u14_fit(path, "x")
    with open(path, encoding="utf-8") as fh:
        text = fh.read()
    polys, runs, nv = [], [], []
    for el in re.findall(r"<path[^>]*>", text):
        m = re.search(r'\sd="([^"]*)"', el)
        if not m:
            continue
        for sub in re.split(r"(?=M)", m.group(1)):
            nums = re.findall(r"[ML]\s*(-?[0-9.]+)\s+(-?[0-9.]+)", sub)
            if not nums:
                continue
            xs = [fx[0] + fx[1] * float(a) for a, _ in nums]
            if "Z" in sub or "z" in sub:
                polys.append("%.1f:%.1f" % (min(xs), max(xs)))
                nv.append(str(len(nums)))
            else:
                runs.append(str(len(nums)))
    Macro.setGlobal("u14_tpoly", " ".join(polys))
    Macro.setGlobal("u14_tnv", nv[0] if nv else "0")
    Macro.setGlobal("u14_truns", " ".join(runs))


def _u14_draw(sp, dp, app):
    import math
    from sfi import Macro
    a, b = _u03_docs(sp, dp, app)

    def num(v):
        try:
            return float(v)
        except (TypeError, ValueError):
            return float("nan")

    for figs, sfx in ((a, "s"), (b, "v")):
        poly, nv, runs, kinds = [], "0", [], []
        for f in figs:
            for r in f.renderers:
                g = getattr(r, "glyph", None)
                t = type(g).__name__
                kinds.append(t)
                d = r.data_source.data
                if t == "VArea" and not poly:
                    xs = [num(v) for v in d[g.x if isinstance(g.x, str) else g.x.field]]
                    y1 = [num(v) for v in d[g.y1 if isinstance(g.y1, str) else g.y1.field]]
                    y2 = [num(v) for v in d[g.y2 if isinstance(g.y2, str) else g.y2.field]]
                    rid = d.get("__dash_row__")
                    nv = str(len(xs))
                    cur, i = [], 0
                    while i < len(xs):
                        syn = (lambda k: (rid[k] is None if rid is not None
                                          else y1[k] == y2[k]))
                        if (cur and i + 1 < len(xs) and syn(i) and syn(i + 1)
                                and y1[i] == y2[i] and y1[i + 1] == y2[i + 1]):
                            poly.append("%.1f:%.1f" % (min(cur), max(cur)))
                            cur = []
                            i += 2
                            continue
                        if math.isfinite(xs[i]):
                            cur.append(xs[i])
                        i += 1
                    if cur:
                        poly.append("%.1f:%.1f" % (min(cur), max(cur)))
                elif t == "Line" and not runs and g.line_alpha != 0:
                    xs = [num(v) for v in d[g.x if isinstance(g.x, str) else g.x.field]]
                    ys = [num(v) for v in d[g.y if isinstance(g.y, str) else g.y.field]]
                    n = 0
                    for x, y in zip(xs, ys):
                        if math.isfinite(x) and math.isfinite(y):
                            n += 1
                        elif n:
                            runs.append(str(n))
                            n = 0
                    if n:
                        runs.append(str(n))
        Macro.setGlobal("u14_poly" + sfx, " ".join(poly))
        Macro.setGlobal("u14_nv" + sfx, nv)
        Macro.setGlobal("u14_runs" + sfx, " ".join(runs))
        Macro.setGlobal("u14_k" + sfx, " ".join(kinds))
end

capture program drop _u14_reg
program define _u14_reg
    // _u14_reg <dir> <k> <dash command...>: register one graph under a
    // log (<dir>/n<k>.log), write its spec and data, and read what both
    // modes draw (_u14_draw).
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    dash clear
    quietly log using "`dir'/n`k'.log", text replace name(u14l)
    capture noisily dash `0'
    local rc = _rc
    quietly log close u14l
    if `rc' exit `rc'
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u14_m; _u14_m._u14_draw("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py")
end

capture program drop _u14_tw
program define _u14_tw
    // _u14_tw <svg> <twoway command...>: draw it, export the SVG and read
    // it (_u14_svg).
    version 19
    gettoken svg 0 : 0
    capture graph drop _all
    quietly twoway `0' name(u14t, replace)
    quietly graph export "`svg'", name(u14t) replace as(svg)
    python: import __main__ as _u14_m; _u14_m._u14_svg("`svg'")
end

capture program drop _u14_close
program define _u14_close, rclass
    // _u14_close "<a:b ...>" "<c:d ...>" tol: the two lists of extents
    // hold as many pairs, each end within tol (r(ok)).
    version 19
    args a b tol
    local na : word count `a'
    local nb : word count `b'
    local ok = (`na' == `nb') & (`na' > 0)
    forvalues i = 1/`na' {
        if !`ok' continue, break
        local p : word `i' of `a'
        local q : word `i' of `b'
        gettoken p0 p1 : p, parse(":")
        gettoken q0 q1 : q, parse(":")
        local p1 = substr("`p1'", 2, .)
        local q1 = substr("`q1'", 2, .)
        if abs(`p0' - `q0') > `tol' | abs(`p1' - `q1') > `tol' local ok 0
    }
    return scalar ok = `ok'
end

* ==== S14 C6: cmissing and connect on areas ====
local only : env WP31_ONLY
if inlist("`only'", "", "S14") & `: list posof "S14" in w31_run' {
    display as text "S14 start " c(current_date) " " c(current_time)
    local u14d "`w31_work'/s14"
    capture mkdir "`u14d'"
    capture graph drop _all
    set scheme stcolor
    sysuse auto, clear
    quietly replace mpg = . in 10/12
    quietly generate lo = mpg - 2
    quietly generate hi = mpg + 2

    // ------------------------------------------------------------
    // U14-01: area in 1/20, cmissing(n) sort: dash's filled regions are
    // twoway's polygons (x extents), both modes; no note names cmissing.
    // ------------------------------------------------------------
    _u14_tw "`u14d'/t1.svg" area mpg weight in 1/20, cmissing(n) sort
    local tp "${u14_tpoly}"
    _u14_reg "`u14d'" 1 area mpg weight in 1/20, cmissing(n) sort name(zu1)
    _u14_close "`tp'" "${u14_polys}" 2
    local oks = r(ok)
    _u14_close "`tp'" "${u14_polyv}" 2
    local okv = r(ok)
    cert_log_has "`u14d'/n1.log", needle("cmissing")
    local nn = r(count)
    _w31_expect U14-01 "(`oks') & (`okv') & (`: word count `tp'' == 3) & (`nn' == 0)" "twoway `tp'; dash saved ${u14_polys} served ${u14_polyv}; note names cmissing `nn' times"
    _w31_done U14-01 "area cmissing(n) fills twoway's three polygons, saved and served, and names nothing"

    // ------------------------------------------------------------
    // U14-02: rarea connect(stairstep): twoway's polygon has dash's
    // vertices plus its move-to and closing repeats; c(J) is taken.
    // ------------------------------------------------------------
    _u14_tw "`u14d'/t2.svg" rarea lo hi weight in 1/20, connect(stairstep) sort
    local tnv "${u14_tnv}"
    _u14_reg "`u14d'" 2 rarea lo hi weight in 1/20, connect(stairstep) sort name(zu2)
    cert_log_has "`u14d'/n2.log", needle("connect")
    local nn = r(count)
    _w31_expect U14-02 "(`tnv' == 2 * ${u14_nvs} + 2) & (`tnv' == 2 * ${u14_nvv} + 2) & (`nn' == 0)" "twoway vertices `tnv', dash saved ${u14_nvs} served ${u14_nvv} per bound; note names connect `nn' times"
    capture noisily twoway rarea lo hi weight, connect(J) nodraw
    local tw = _rc
    dash clear
    capture noisily dash rarea lo hi weight, connect(J)
    local dr = _rc
    _w31_expect U14-02 "(`tw' == 0) & (`dr' == 0)" "connect(J): twoway r(`tw'), dash r(`dr')"
    _w31_done U14-02 "rarea connect(stairstep) draws twoway's stepped polygon vertex for vertex, saved and served"

    // ------------------------------------------------------------
    // U14-03: lowess cmissing(n): dash's line breaks into twoway's runs
    // at the rows with no mpg; no note.
    // ------------------------------------------------------------
    _u14_tw "`u14d'/t3.svg" lowess mpg weight, cmissing(n)
    local tr "${u14_truns}"
    _u14_reg "`u14d'" 3 lowess mpg weight, cmissing(n) name(zu3)
    cert_log_has "`u14d'/n3.log", needle("cmissing")
    local nn = r(count)
    _w31_expect U14-03 `"("${u14_runss}" == "`tr'") & ("${u14_runsv}" == "`tr'") & (`: word count `tr'' == 4) & (`nn' == 0)"' "twoway runs `tr'; dash saved ${u14_runss} served ${u14_runsv}; note names cmissing `nn' times"
    _w31_done U14-03 "lowess cmissing(n) breaks where twoway's does, saved and served, and names nothing"

    forvalues k = 1/3 {
        foreach p in s d {
            capture erase "`u14d'/`p'`k'.json"
        }
        capture erase "`u14d'/a`k'.py"
        capture erase "`u14d'/n`k'.log"
        capture erase "`u14d'/t`k'.svg"
    }
    capture rmdir "`u14d'"
    capture graph drop _all
    dash clear
    display as text "S14 end " c(current_date) " " c(current_time)
}
* ==== end S14 ====

* ==== S14 C7: recast to range and pc types ====
local only : env WP31_ONLY
if inlist("`only'", "", "S14") & `: list posof "S14" in w31_run' {
    display as text "S14 start " c(current_date) " " c(current_time)
    local u14d "`w31_work'/s14c7"
    capture mkdir "`u14d'"
    capture graph drop _all
    set scheme stcolor
    sysuse auto, clear

    // ------------------------------------------------------------
    // U14-04: histogram recast(rarea) is twoway's rarea and dash's
    // VArea, both modes, no note; recast(bogus): twoway's two notes in
    // dash's log and rspike's Segment drawn, rc 0 both.
    // ------------------------------------------------------------
    quietly twoway histogram mpg, recast(rarea) name(u14t, replace)
    local tty "`.u14t.plotregion1.plot1.type.setting'"
    _u14_reg "`u14d'" 4 histogram mpg, recast(rarea) name(zu4)
    cert_log_has "`u14d'/n4.log", needle("recast")
    local nn = r(count)
    _w31_expect U14-04 `"("`tty'" == "rarea") & strpos("${u14_ks}", "VArea") & strpos("${u14_kv}", "VArea") & !strpos("${u14_ks}", "Quad") & (`nn' == 0)"' "twoway type `tty'; dash saved ${u14_ks} served ${u14_kv}; note names recast `nn' times"
    capture noisily twoway histogram mpg, recast(bogus) name(u14t, replace)
    local tw = _rc
    local tty "`.u14t.plotregion1.plot1.type.setting'"
    capture noisily _u14_reg "`u14d'" 5 histogram mpg, recast(bogus) name(zu5)
    local dr = _rc
    cert_log_has "`u14d'/n5.log", needle("named style bogus not found in class y2xtype")
    local n1 = r(count)
    cert_log_has "`u14d'/n5.log", needle("y2xtype not found in scheme")
    local n2 = r(count)
    _w31_expect U14-04 `"(`tw' == 0) & (`dr' == 0) & ("`tty'" == "rspike") & (`n1' == 1) & (`n2' == 1) & strpos("${u14_ks}", "Segment") & strpos("${u14_kv}", "Segment")"' "recast(bogus): twoway r(`tw') `tty', dash r(`dr') ${u14_ks} / ${u14_kv}, notes `n1' `n2'"
    _w31_done U14-04 "histogram recast(rarea) draws twoway's rarea, recast(bogus) twoway's notes and rspike, saved and served"

    // ------------------------------------------------------------
    // U14-05: pci recast(pcarrow) and pcarrowi recast(pcscatter): the
    // spec carries the target, dash draws its glyphs, twoway's type is
    // the target; no note.
    // ------------------------------------------------------------
    local k 6
    foreach c in "pci 20 2000 30 4000, recast(pcarrow)|pcarrow|MultiLine" "pcarrowi 20 2000 30 4000, recast(pcscatter)|pcscatter|Scatter" {
        gettoken cmd rest : c, parse("|")
        local rest = substr("`rest'", 2, .)
        gettoken tg gl : rest, parse("|")
        local gl = substr("`gl'", 2, .)
        quietly twoway `cmd' name(u14t, replace)
        local tty "`.u14t.plotregion1.plot1.type.setting'"
        _u14_reg "`u14d'" `k' `cmd' name(zu`k')
        cert_log_has "`u14d'/n`k'.log", needle("recast")
        local nn = r(count)
        cert_file_has "`u14d'/s`k'.json", needle(`""recast":"`tg'""')
        local sp = r(found)
        _w31_expect U14-05 `"("`tty'" == "`tg'") & strpos("${u14_ks}", "`gl'") & strpos("${u14_kv}", "`gl'") & (`nn' == 0) & (`sp')"' "`cmd': twoway `tty'; dash ${u14_ks} / ${u14_kv}; spec recast `sp'; note `nn'"
        local ++k
    }
    _w31_done U14-05 "pci and pcarrowi recast() draw the pc type named, as twoway does, saved and served"

    forvalues k = 4/7 {
        foreach p in s d {
            capture erase "`u14d'/`p'`k'.json"
        }
        capture erase "`u14d'/a`k'.py"
        capture erase "`u14d'/n`k'.log"
    }
    capture rmdir "`u14d'"
    capture graph drop _all
    dash clear
    display as text "S14 end " c(current_date) " " c(current_time)
}
* ==== end S14 ====

// S15 helpers (WP-31 C8a).  _u15_draw: what a registered dash graph
// draws, saved and served (S03's _u03_docs builds both) -- into globals
// u15_<k>s (saved) and u15_<k>v (served): cv, 1 when a plot of the spec
// carries colorvar; fld, the glyph types whose fill or line colour reads a
// field through a colour mapper; keys, the colour keys; mv, 1 when every
// marker of the layer moved from the data and none further than half of
// jitter(5)'s 5% of its axis range; seg, 1 when no Segment moved.
python:
def _u15_draw(sp, dp, app):
    import json
    import numpy as np
    from sfi import Macro
    spec = json.load(open(sp, encoding="utf-8"))
    cv = int(any("colorvar" in (p.get("options") or {})
                 for g in spec.get("graphs", []) for p in g.get("plots", [])))
    a, b = _u03_docs(sp, dp, app)
    for figs, sfx in ((a, "s"), (b, "v")):
        fld, keys, mv, seg = [], 0, 1, 1
        for f in figs:
            for side in (f.right, f.left, f.above, f.below, f.center):
                for m in side:
                    t = type(m).__name__
                    if t == "ColorBar" or (t == "Legend"
                                           and m.name == "_dash_clegend"):
                        keys += 1
            for r in f.renderers:
                g = getattr(r, "glyph", None)
                t = type(g).__name__
                if str(getattr(r, "name", "") or "").startswith("_clegend_"):
                    continue
                if any(getattr(getattr(g, p, None), "transform", None)
                       is not None for p in ("fill_color", "line_color")):
                    fld.append(t)
                d = r.data_source.data
                if t == "Scatter" and g.marker != "dash":
                    x, y = np.asarray(d[g.x], float), np.asarray(d[g.y], float)
                    x0 = np.asarray(d["x"], float)
                    y0 = np.asarray(d["y"], float)
                    rx = 0.025 * (np.nanmax(x0) - np.nanmin(x0)) + 1e-9
                    ry = 0.025 * (np.nanmax(y0) - np.nanmin(y0)) + 1e-9
                    if not (np.all((x != x0) | (y != y0))
                            and np.nanmax(np.abs(x - x0)) <= rx
                            and np.nanmax(np.abs(y - y0)) <= ry):
                        mv = 0
        Macro.setGlobal("u15_cv" + sfx, str(cv))
        Macro.setGlobal("u15_fld" + sfx, " ".join(sorted(set(fld))) or "none")
        Macro.setGlobal("u15_keys" + sfx, str(keys))
        Macro.setGlobal("u15_mv" + sfx, str(mv))
end

capture program drop _u15_reg
program define _u15_reg
    // _u15_reg <dir> <k> <dash command...>: register one graph, write its
    // spec and data, and read what both modes draw (_u15_draw).
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    dash clear
    quietly dash `0'
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u15_m; _u15_m._u15_draw("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py")
end

capture program drop _u15_try
program define _u15_try, rclass
    // _u15_try <log> <command...>: run it in its own log; r(rc), and
    // r(note) 1 when the log names colorvar() or jitter() as ignored.
    version 19
    gettoken lf 0 : 0
    capture dash clear
    capture log close u15l
    quietly log using "`lf'", text replace name(u15l)
    capture noisily `0'
    local rc = _rc
    quietly log close u15l
    cert_log_has "`lf'", needle("ignoring unsupported")
    local n = r(found)
    local hit = 0
    foreach o in colorvar jitter {
        cert_log_has "`lf'", needle("`o'(")
        if r(found) & `n' local hit = 1
    }
    return scalar rc = `rc'
    return scalar note = `hit'
end

* ==== S15 C8a: colorvar coverage and jitter ====
local only : env WP31_ONLY
if inlist("`only'", "", "S15") & `: list posof "S15" in w31_run' {
    display as text "S15 start " c(current_date) " " c(current_time)
    local u15d "`w31_work'/s15"
    capture mkdir "`u15d'"
    local lf "`u15d'/try.log"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear
    quietly keep if rep78 < .
    quietly generate z = rep78
    quietly generate lo = mpg - 2
    quietly generate hi = mpg + 2
    quietly generate y2 = mpg + 5
    quietly generate x2 = weight + 500
    sort weight
    quietly generate t = _n
    quietly tsset t

    // ------------------------------------------------------------
    // U15-01: colorvar(z) on every plot type: dash's rc is twoway's, the
    // note never names it, and the spec carries it where twoway colours
    // (the view's .cvar is set) and not where twoway drops it.
    // ------------------------------------------------------------
    local m6 `"scatter "scatter mpg t" line "line mpg t" connected "connected mpg t" scatteri "scatteri 20 30" area "area mpg t" bar "bar mpg t" spike "spike mpg t" dropline "dropline mpg t" dot "dot mpg t" rarea "rarea lo hi t" rbar "rbar lo hi t" rspike "rspike lo hi t" rcap "rcap lo hi t" rcapsym "rcapsym lo hi t" rscatter "rscatter lo hi t" rline "rline lo hi t" rconnected "rconnected lo hi t" pcspike "pcspike mpg t y2 t" pccapsym "pccapsym mpg t y2 t" pcarrow "pcarrow mpg t y2 t" pcbarrow "pcbarrow mpg t y2 t" pcscatter "pcscatter mpg t y2 t" pci "pci 20 30 25 40" pcarrowi "pcarrowi 20 30 25 40" tsline "tsline mpg" tsrline "tsrline lo hi" mband "mband mpg t" mspline "mspline mpg t" lowess "lowess mpg t" lfit "lfit mpg t" qfit "qfit mpg t" fpfit "fpfit mpg t" lfitci "lfitci mpg t" qfitci "qfitci mpg t" fpfitci "fpfitci mpg t" lpoly "lpoly mpg t" lpolyci "lpolyci mpg t" kdensity "kdensity mpg" histogram "histogram t" function "function y = x, range(0 1)""'
    local k 0
    while `"`m6'"' != "" {
        gettoken ty m6 : m6
        gettoken cmd m6 : m6
        local k = `k' + 1
        local sep = cond(strpos(`"`cmd'"', ","), " ", ", ")
        capture twoway `cmd' `sep' colorvar(z) name(u15t, replace)
        local tw = _rc
        local tcv = 0
        if `tw' == 0 {
            local c "`.u15t.plotregion1.plot1.cvar'"
            if "`c'" != "" & "`c'" != "." local tcv = 1
        }
        _u15_try "`lf'" dash `cmd' `sep' colorvar(z) name(zu15)
        local drc = r(rc)
        _w31_expect U15-01 "(`drc' == `tw')" "`ty': dash rc `drc', twoway r(`tw')"
        _w31_expect U15-01 "(r(note) == 0)" "`ty': the note names colorvar()"
        if `drc' == 0 {
            _dash_serve_spec, specpath("`u15d'/c`k'.json") datapath("`u15d'/cd`k'.json")
            python: import json as _u15j; from sfi import Macro as _u15M; _u15M.setGlobal("u15_cvs", str(int(any("colorvar" in (p.get("options") or {}) for g in _u15j.load(open("`u15d'/c`k'.json")).get("graphs", []) for p in g.get("plots", []))))) 
            _w31_expect U15-01 "(${u15_cvs} == `tcv')" "`ty': colorvar in the spec ${u15_cvs}, twoway's view carries it `tcv'"
            capture erase "`u15d'/c`k'.json"
            capture erase "`u15d'/cd`k'.json"
        }
    }
    quietly tsset, clear
    _w31_done U15-01 "colorvar(z) on 40 types: rc as twoway's, never named, in the spec exactly where twoway's view carries it"

    // ------------------------------------------------------------
    // U15-02: bar colorvar(z): the bars read a colour field, both modes,
    // with one key; twoway draws the bars in the five levels.
    // ------------------------------------------------------------
    quietly twoway bar mpg weight, colorvar(z) name(u15t, replace)
    local c "`.u15t.plotregion1.plot1.cvar'"
    _w31_expect U15-02 `"("`c'" != "." & "`c'" != "")"' "twoway bar's view has no colour variable (`c')"
    _u15_reg "`u15d'" 2 bar mpg weight, colorvar(z) name(zu2)
    _w31_expect U15-02 `"("${u15_flds}" == "VBar" & "${u15_fldv}" == "VBar")"' "colour fields on ${u15_flds} / ${u15_fldv}"
    _w31_expect U15-02 "(${u15_keyss} == 1 & ${u15_keysv} == 1)" "keys ${u15_keyss} / ${u15_keysv}"
    _w31_done U15-02 "bar colorvar(z): the bars take the colour field and one key, saved and served"

    // ------------------------------------------------------------
    // U15-03: rscatter jitter(5) jitterseed(1): twoway's view jitters, dash
    // moves every marker within the band in both modes and names nothing.
    // ------------------------------------------------------------
    quietly twoway rscatter lo hi weight, jitter(5) jitterseed(1) name(u15t, replace)
    local tj "`.u15t.plotregion1.plot1.jitter'"
    _w31_expect U15-03 "(`tj' == 5)" "twoway rscatter's view jitter `tj'"
    _u15_try "`lf'" dash rscatter lo hi weight, jitter(5) jitterseed(1) name(zu3)
    _w31_expect U15-03 "(r(rc) == 0 & r(note) == 0)" "dash rc `r(rc)', note `r(note)'"
    _u15_reg "`u15d'" 3 rscatter lo hi weight, jitter(5) jitterseed(1) name(zu3)
    _w31_expect U15-03 "(${u15_mvs} == 1 & ${u15_mvv} == 1)" "markers moved within the band: saved ${u15_mvs}, served ${u15_mvv}"
    _w31_done U15-03 "rscatter jitter(5): every marker moved within 2.5% of each range, both modes, as twoway's view jitters (`tj')"

    // ------------------------------------------------------------
    // U15-04: two y variables with colorvar(): twoway's rc and words.
    // ------------------------------------------------------------
    foreach ty in scatter line {
        capture noisily twoway `ty' mpg price weight, colorvar(z) name(u15t, replace)
        local tw = _rc
        _u15_try "`lf'" dash `ty' mpg price weight, colorvar(z) name(zu4)
        local drc = r(rc)
        cert_log_has "`lf'", needle("option colorvar() cannot be combined with multiple y variables in a `ty' plot")
        _w31_expect U15-04 "(`tw' == 198 & `drc' == 198 & r(found))" "`ty': twoway r(`tw'), dash rc `drc', words `r(found)'"
    }
    _w31_done U15-04 "colorvar() with two y variables: r(198) in twoway's words on scatter and line"

    // ------------------------------------------------------------
    // U15-05: lfit colorvar(z): rc 0, nothing said, nothing in the spec.
    // ------------------------------------------------------------
    capture twoway lfit mpg weight, colorvar(nosuchvar) name(u15t, replace)
    local tw = _rc
    _u15_try "`lf'" dash lfit mpg weight, colorvar(nosuchvar) name(zu5)
    _w31_expect U15-05 "(`tw' == 0 & r(rc) == 0 & r(note) == 0)" "colorvar(nosuchvar): twoway r(`tw'), dash rc `r(rc)', note `r(note)'"
    _u15_reg "`u15d'" 5 lfit mpg weight, colorvar(z) name(zu5)
    _w31_expect U15-05 "(${u15_cvs} == 0 & ${u15_keyss} == 0 & ${u15_keysv} == 0)" "spec colorvar ${u15_cvs}, keys ${u15_keyss} / ${u15_keysv}"
    _w31_done U15-05 "lfit colorvar(): dropped without a word and never looked up, as twoway drops it"

    capture erase "`lf'"
    foreach k in 2 3 5 {
        foreach p in s d {
            capture erase "`u15d'/`p'`k'.json"
        }
        capture erase "`u15d'/a`k'.py"
    }
    capture rmdir "`u15d'"
    capture graph drop u15t
    dash clear
    display as text "S15 end " c(current_date) " " c(current_time)
}
* ==== end S15 ====

// S16 helpers (WP-31 F1c).  _u16_move: the saved page's lowess line after
// one filter move -- the page rendered, the widget set and its own
// callback run under node (test/js_runner.py) -- written to a JSON file,
// its point count in global u16_n.  _u16_gen_compare: the saved line
// against Stata's lowess, gen() variable *s* on the rows where *touse* is
// 1 and *s* is not missing, in the data's current order (sorted stably by
// x); global u16_ok 1 or 0 and u16_msg.  _u16_said: does a log hold *text*.
python:
def _u16_move(sp, dp, kind, value, out):
    import json
    import os
    import sys
    import warnings
    if os.getcwd() not in sys.path:
        sys.path.insert(0, os.getcwd())
    import dash_render as dr
    import js_runner
    from sfi import Macro
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
    w = [m for m in r.filter_widgets if type(m).__name__ == kind][0]
    if kind == "Select":
        w.value = [v for v, lab in w.options if lab == value][0]
    elif kind == "RangeSlider":
        w.value = tuple(float(v) for v in value.split())
    else:
        w.value = float(value)
    cb = r.filter_callbacks[r.filter_widgets.index(w)]
    js_runner.JsSession(r.filter_callbacks).run(cb)
    lw = [x for f in r.figures.values() for x in f.renderers
          if (getattr(x, "_dash_agg_config", None) or {}).get("type")
          == "lowess"]
    d = lw[0].data_source.data
    with open(out, "w", encoding="utf-8") as fh:
        json.dump({"x": [float(v) for v in d["x_lw"]],
                   "y": [float(v) for v in d["y_lw"]]}, fh)
    Macro.setGlobal("u16_n", str(len(d["x_lw"])))


def _u16_gen_compare(saved, xvar, svar, touse, rtol):
    import json
    import numpy as np
    from sfi import Data, Macro
    g = json.load(open(saved, encoding="utf-8"))
    gx, gy = np.asarray(g["x"], float), np.asarray(g["y"], float)
    miss = lambda v: v is None or v >= 8.98e307
    xs, ss = [], []
    for x, s, t in zip(Data.get(var=xvar), Data.get(var=svar),
                       Data.get(var=touse)):
        if t == 1 and not miss(s) and not miss(x):
            xs.append(float(x))
            ss.append(float(s))
    tx, ty = np.asarray(xs), np.asarray(ss)
    ok = 0
    if len(tx) != len(gx):
        msg = "%d saved points, Stata %d" % (len(gx), len(tx))
    elif not len(tx):
        msg = "no points"
    else:
        dx = float(np.max(np.abs(gx - tx) / np.maximum(np.abs(tx), 1.0)))
        dy = float(np.max(np.abs(gy - ty) / np.maximum(np.abs(ty), 1.0)))
        ok = int(dx <= rtol and dy <= rtol)
        msg = "%d points, largest relative difference x %.3g y %.3g" % (
            len(gx), dx, dy)
    Macro.setGlobal("u16_ok", str(ok))
    Macro.setGlobal("u16_msg", msg)


def _u16_said(log, text):
    from sfi import Macro
    with open(log, encoding="utf-8", errors="replace") as fh:
        Macro.setGlobal("u16_said", "1" if text in fh.read() else "0")
end

* ==== S16 F1c: lowess re-smooths on the saved page ====
local only : env WP31_ONLY
if inlist("`only'", "", "S16") & `: list posof "S16" in w31_run' {
    display as text "S16 start " c(current_date) " " c(current_time)
    local u16d "`w31_work'/s16"
    capture mkdir "`u16d'"
    capture graph drop _all

    // ------------------------------------------------------------
    // U16-01..04: after a move the saved smooth is Stata's lowess on the
    // kept rows (gen(), sorted stably by x): the default after the
    // dropdown to Foreign; bwidth(.4) mean after the range to
    // 4500-11385; noweight adjust after the dropdown to Domestic (adjust's
    // mean is all 74 cars', in both); logit on foreign, constant 0 among
    // the Domestic cars.
    // ------------------------------------------------------------
    local k 0
    foreach c in "U16-01|(scatter mpg weight) (lowess mpg weight)|foreign, type(dropdown)|Select|Foreign|mpg|foreign == 1|" "U16-02|(lowess mpg weight, bwidth(.4) mean)|price, type(range)|RangeSlider|4500 11385|mpg|inrange(price, 4500, 11385)|bwidth(.4) mean" "U16-03|(lowess mpg weight, noweight adjust)|foreign, type(dropdown)|Select|Domestic|mpg|foreign == 0|noweight adjust" "U16-04|(lowess foreign weight, logit)|foreign, type(dropdown)|Select|Domestic|foreign|foreign == 0|logit" {
        local ++k
        mata: u16_t = ustrsplit(st_local("c"), "[|]"); st_local("id", u16_t[1]); st_local("cmd", u16_t[2]); st_local("filt", u16_t[3]); st_local("kind", u16_t[4]); st_local("val", u16_t[5]); st_local("yv", u16_t[6]); st_local("cond", u16_t[7]); st_local("lo", u16_t[8])
        sysuse auto, clear
        dash clear
        capture noisily dash `cmd', name(zu16`k')
        _w31_expect `id' "(_rc == 0)" "dash `cmd' rc `=_rc'"
        _dash_serve_spec, specpath("`u16d'/s`k'.json") datapath("`u16d'/d`k'.json") filter(`filt')
        python: _u16_move("`u16d'/s`k'.json", "`u16d'/d`k'.json", "`kind'", "`val'", "`u16d'/g`k'.json")
        quietly lowess `yv' weight if `cond', `lo' generate(u16s) nograph
        quietly generate byte u16u = (`cond')
        quietly generate long u16o = _n
        sort weight u16o
        python: _u16_gen_compare("`u16d'/g`k'.json", "weight", "u16s", "u16u", 1e-8)
        _w31_expect `id' "(${u16_ok} == 1)" "dash `cmd', filter(`filt') moved to `val': ${u16_msg}"
        _w31_done `id' "the saved `cmd' after the move to `val' is lowess `yv' weight if `cond', `lo' (${u16_msg})"
    }

    // ------------------------------------------------------------
    // U16-05: a move leaving two rows empties the saved smooth; twoway
    // lowess on them draws nothing, rc 0, in silence.
    // ------------------------------------------------------------
    sysuse auto, clear
    dash clear
    capture noisily dash (scatter mpg weight) (lowess mpg weight), name(zu165)
    _w31_expect U16-05 "(_rc == 0)" "dash lowess rc `=_rc'"
    _dash_serve_spec, specpath("`u16d'/s5.json") datapath("`u16d'/d5.json") filter(price, type(slider))
    python: _u16_move("`u16d'/s5.json", "`u16d'/d5.json", "Slider", "14500", "`u16d'/g5.json")
    quietly count if price >= 14500
    local nk = r(N)
    _w31_expect U16-05 "(`nk' == 2)" "price >= 14500 keeps `nk' rows"
    _w31_expect U16-05 "(${u16_n} == 0)" "the saved lowess after the slider to 14500 holds ${u16_n} points"
    local lf "`u16d'/t5.log"
    quietly log using "`lf'", text replace name(u16l)
    capture noisily twoway lowess mpg weight if price >= 14500, nodraw
    local trc = _rc
    quietly log close u16l
    python: _u16_said("`lf'", "(note:")
    _w31_expect U16-05 "(`trc' == 0 & ${u16_said} == 0)" "twoway lowess on two rows: rc `trc', note ${u16_said}"
    _w31_done U16-05 "two kept rows: the saved smooth is empty; twoway draws none (rc `trc', no note)"

    forvalues k = 1/5 {
        foreach p in s d g {
            capture erase "`u16d'/`p'`k'.json"
        }
    }
    capture erase "`lf'"
    capture rmdir "`u16d'"
    macro drop u16_n u16_ok u16_msg u16_said
    capture mata: mata drop u16_t
    capture graph drop _all
    dash clear
    display as text "S16 end " c(current_date) " " c(current_time)
}
* ==== end S16 ====

// S17 helpers (WP-31 C8b).  _u17_draw: what a registered dash graph draws,
// saved and served (S03's _u03_docs builds both) -- into globals
// u17_ok<s|v>, 1 when the first layer's colour mapper's palette starts
// with the colours of fixture probe u17_want (lowest level first, within
// 1/255 a channel); u17_c3<s|v>, 1 when the third Scatter is drawn in the
// first's colour; u17_keys<s|v>, the colour keys drawn.
python:
def _u17_draw(sp, dp, app, probe):
    import json
    from sfi import Macro
    want = []
    if probe:
        with open("fixtures/colorvar_options_truth.json", encoding="utf-8") as fh:
            want = list(reversed(json.load(fh)["probes"][probe]["key"]["fills"]))
    def rgb(h):
        h = str(h).lstrip("#")
        return [int(h[i:i + 2], 16) for i in (0, 2, 4)]
    a, b = _u03_docs(sp, dp, app)
    for figs, sfx in ((a, "s"), (b, "v")):
        pal, cols, keys = None, [], 0
        for f in figs:
            for side in (f.right, f.left, f.above, f.below, f.center):
                for m in side:
                    t = type(m).__name__
                    if t == "ColorBar" or (t == "Legend"
                                           and m.name == "_dash_clegend"):
                        keys += 1
            for r in f.renderers:
                g = getattr(r, "glyph", None)
                if type(g).__name__ != "Scatter" or str(
                        getattr(r, "name", "") or "").startswith("_clegend_"):
                    continue
                tr = getattr(g.fill_color, "transform", None)
                if tr is not None and pal is None:
                    pal = list(tr.palette)
                cols.append(str(g.fill_color).lower())
        ok = int(bool(want) and pal is not None and len(pal) >= len(want)
                 and all(abs(x - y) <= 1 for p, w in zip(pal, want)
                         for x, y in zip(rgb(p), rgb(w))))
        Macro.setGlobal("u17_ok" + sfx, str(ok))
        Macro.setGlobal("u17_c3" + sfx,
                        str(int(len(cols) >= 3 and cols[2] == cols[0])))
        Macro.setGlobal("u17_keys" + sfx, str(keys))
end

capture program drop _u17_reg
program define _u17_reg
    // _u17_reg <dir> <probe or .> <dash command...>: register one graph,
    // write its spec and data, and read what both modes draw.
    version 19
    gettoken dir 0 : 0
    gettoken probe 0 : 0
    if "`probe'" == "." local probe ""
    dash clear
    quietly dash `0'
    _dash_serve_spec, specpath("`dir'/s.json") datapath("`dir'/d.json")
    python: import __main__ as _u17_m; _u17_m._u17_draw("`dir'/s.json", "`dir'/d.json", "`dir'/a.py", "`probe'")
end

capture program drop _u17_try
program define _u17_try, rclass
    // _u17_try <log> <command...>: run it in its own log; r(rc), and
    // r(note) 1 when the log holds dash's ignoring note.
    version 19
    gettoken lf 0 : 0
    capture dash clear
    capture log close u17l
    quietly log using "`lf'", text replace name(u17l)
    capture noisily `0'
    local rc = _rc
    quietly log close u17l
    cert_log_has "`lf'", needle("ignoring unsupported")
    return scalar note = r(found)
    return scalar rc = `rc'
end

* ==== S17 C8b: colorvar options ====
local only : env WP31_ONLY
if inlist("`only'", "", "S17") & `: list posof "S17" in w31_run' {
    display as text "S17 start " c(current_date) " " c(current_time)
    local u17d "`w31_work'/s17"
    capture mkdir "`u17d'"
    local lf "`u17d'/try.log"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear

    // ------------------------------------------------------------
    // U17-01: colordiscrete's five levels in twoway's colours (hue from
    // blue to red in six steps, D01), both modes, and no note.
    // ------------------------------------------------------------
    _u17_try "`lf'" dash scatter mpg weight, colorvar(rep78) colordiscrete name(zu1)
    _w31_expect U17-01 "(r(rc) == 0 & r(note) == 0)" "dash rc `r(rc)', note `r(note)'"
    _u17_reg "`u17d'" D01 scatter mpg weight, colorvar(rep78) colordiscrete name(zu1)
    _w31_expect U17-01 "(${u17_oks} == 1 & ${u17_okv} == 1)" "level colours as twoway's: saved ${u17_oks}, served ${u17_okv}"
    _w31_done U17-01 "colorvar(rep78) colordiscrete: the levels in twoway's hue colours, saved and served"

    // ------------------------------------------------------------
    // U17-02: colorlist(red blue) on five levels: twoway's rc, and the
    // last colour repeated over the levels the list does not reach (D03).
    // ------------------------------------------------------------
    capture twoway scatter mpg weight, colorvar(rep78) colordiscrete colorlist(red blue) nodraw
    local tw = _rc
    _u17_try "`lf'" dash scatter mpg weight, colorvar(rep78) colordiscrete colorlist(red blue) name(zu2)
    _w31_expect U17-02 "(`tw' == 0 & r(rc) == 0 & r(note) == 0)" "twoway r(`tw'), dash rc `r(rc)', note `r(note)'"
    _u17_reg "`u17d'" D03 scatter mpg weight, colorvar(rep78) colordiscrete colorlist(red blue) name(zu2)
    _w31_expect U17-02 "(${u17_oks} == 1 & ${u17_okv} == 1)" "colours as twoway's: saved ${u17_oks}, served ${u17_okv}"
    _w31_done U17-02 "colorlist(red blue) on five levels: red, then blue four times, as twoway draws"

    // ------------------------------------------------------------
    // U17-03: colorformissing() is taken in silence; colormissing() is
    // dash's own, which twoway refuses (R04).
    // ------------------------------------------------------------
    _u17_try "`lf'" dash scatter mpg weight, colorvar(rep78) colorformissing(gray) name(zu3)
    _w31_expect U17-03 "(r(rc) == 0 & r(note) == 0)" "colorformissing(): dash rc `r(rc)', note `r(note)'"
    _u17_try "`lf'" dash scatter mpg weight, colorvar(rep78) colormissing(gray) name(zu3)
    _w31_expect U17-03 "(r(rc) == 0)" "colormissing(): dash rc `r(rc)'"
    capture twoway scatter mpg weight, colorvar(rep78) colormissing(red) nodraw
    _w31_expect U17-03 "(_rc == 198)" "twoway colormissing(): r(`=_rc')"
    _w31_done U17-03 "colorformissing() taken in silence; colormissing() dash's own, refused by twoway"

    // ------------------------------------------------------------
    // U17-04: refusals in twoway's rc and words: coloruseplegend without
    // colordiscrete (R01), a rule twoway has no style for (R02) and an
    // invalid % or * part, and a second colorvar() layer without
    // colorallowmultiple (R03) -- with it, drawn (R03b).
    // ------------------------------------------------------------
    local cases `" "scatter mpg weight, colorvar(rep78) coloruseplegend~you must specify option colordiscrete with option coloruseplegend" "scatter mpg weight, colorvar(rep78) colorrule(bogus)~named style bogus not found in class zyx2rule" "scatter mpg weight, colorvar(rep78) colorrule(hue *2 %x)~invalid colorrule specification" "scatter mpg weight, colorvar(rep78) || scatter price weight, colorvar(rep78)~multiple contour, patch, or colorvar plots not allowed" "'
    foreach c of local cases {
        gettoken cmd words : c, parse("~")
        local words = substr(`"`words'"', 2, .)
        capture log close u17t
        quietly log using "`u17d'/tw.log", text replace name(u17t)
        // Drawn, not nodraw: twoway refuses the rule and the second layer
        // when it draws the graph (with nodraw both are rc 0).
        capture noisily twoway `cmd' name(u17t, replace)
        local tw = _rc
        display as text "{p_end}"
        quietly log close u17t
        cert_log_has "`u17d'/tw.log", needle(`"`words'"')
        local twf = r(found)
        _u17_try "`lf'" dash `cmd' name(zu4)
        local drc = r(rc)
        cert_log_has "`lf'", needle(`"`words'"')
        _w31_expect U17-04 "(`tw' == 198 & `drc' == 198 & `twf' & r(found))" `"`cmd': twoway r(`tw') words `twf', dash rc `drc' words `r(found)'"'
    }
    capture twoway scatter mpg weight, colorvar(rep78) || scatter price weight, colorvar(rep78) colorallowmultiple name(u17t, replace)
    local tw = _rc
    _u17_try "`lf'" dash scatter mpg weight, colorvar(rep78) || scatter price weight, colorvar(rep78) colorallowmultiple name(zu4)
    _w31_expect U17-04 "(`tw' == 0 & r(rc) == 0)" "colorallowmultiple: twoway r(`tw'), dash rc `r(rc)'"
    capture erase "`u17d'/tw.log"
    _w31_done U17-04 "coloruseplegend, colorrule() and a second colorvar() layer refused in twoway's rc and words"

    // ------------------------------------------------------------
    // U17-05: pcycle(2) draws the third series in p1; pcycle(0), (16),
    // given twice, and colorrule() given twice: dash's rc is twoway's.
    // ------------------------------------------------------------
    _u17_reg "`u17d'" . scatter mpg trunk turn weight, pcycle(2) name(zu5)
    _w31_expect U17-05 "(${u17_c3s} == 1 & ${u17_c3v} == 1)" "third series in p1: saved ${u17_c3s}, served ${u17_c3v}"
    foreach o in "pcycle(0)" "pcycle(16)" "pcycle(2) pcycle(3)" "pcycle(abc)" {
        capture twoway scatter mpg trunk turn weight, `o' nodraw
        local tw = _rc
        _u17_try "`lf'" dash scatter mpg trunk turn weight, `o' name(zu5)
        _w31_expect U17-05 "(r(rc) == `tw')" "`o': twoway r(`tw'), dash rc `r(rc)'"
    }
    capture twoway scatter mpg weight, colorvar(rep78) colorrule(hue) colorrule(linear) nodraw
    local tw = _rc
    _u17_try "`lf'" dash scatter mpg weight, colorvar(rep78) colorrule(hue) colorrule(linear) name(zu5)
    _w31_expect U17-05 "(`tw' == 198 & r(rc) == 198)" "colorrule() twice: twoway r(`tw'), dash rc `r(rc)'"
    _w31_done U17-05 "pcycle(2) recycles p1 for the third series; pcycle() and colorrule() refused where twoway refuses them"

    // ------------------------------------------------------------
    // U17-06: colorvar(i.rep78) draws (it was r(111)) as colordiscrete
    // coloruseplegend; clegend(position(6)) and plegend(off) are taken in
    // silence.
    // ------------------------------------------------------------
    _u17_try "`lf'" dash scatter mpg weight, colorvar(i.rep78) name(zu6)
    _w31_expect U17-06 "(r(rc) == 0 & r(note) == 0)" "colorvar(i.rep78): dash rc `r(rc)', note `r(note)'"
    dash clear
    quietly dash scatter mpg weight, colorvar(i.rep78) name(zu6)
    _dash_serve_spec, specpath("`u17d'/s.json") datapath("`u17d'/d.json")
    cert_file_has "`u17d'/s.json", needle(`""colordiscrete":"colordiscrete""')
    local f1 = r(found)
    cert_file_has "`u17d'/s.json", needle(`""coloruseplegend":"coloruseplegend""')
    local f2 = r(found)
    cert_file_has "`u17d'/s.json", needle(`""colorvar":"rep78""')
    _w31_expect U17-06 "(`f1' & `f2' & r(found))" "spec: colordiscrete `f1', coloruseplegend `f2', colorvar(rep78) `r(found)'"
    _u17_try "`lf'" dash scatter mpg weight, colorvar(rep78) clegend(position(6)) name(zu6)
    _w31_expect U17-06 "(r(rc) == 0 & r(note) == 0)" "clegend(position(6)): dash rc `r(rc)', note `r(note)'"
    _u17_try "`lf'" dash scatter mpg weight, colorvar(rep78) colordiscrete coloruseplegend plegend(off) name(zu6)
    _w31_expect U17-06 "(r(rc) == 0 & r(note) == 0)" "plegend(off): dash rc `r(rc)', note `r(note)'"
    _u17_reg "`u17d'" . scatter mpg weight, colorvar(rep78) colordiscrete coloruseplegend plegend(off) name(zu6)
    _w31_expect U17-06 "(${u17_keyss} == 0 & ${u17_keysv} == 0)" "plegend(off): keys ${u17_keyss} / ${u17_keysv}"
    _w31_done U17-06 "colorvar(i.rep78) draws as colordiscrete coloruseplegend; clegend() and plegend() taken and drawn"

    capture erase "`lf'"
    foreach f in s.json d.json a.py {
        capture erase "`u17d'/`f'"
    }
    capture rmdir "`u17d'"
    macro drop u17_*
    capture graph drop _all
    dash clear
    display as text "S17 end " c(current_date) " " c(current_time)
}
* ==== end S17 ====

// S18 helpers (WP-31 B5b).  _u18_draw: what both modes draw of a
// registered dot graph's rows of dots (the renderer tagged dash_dots) --
// the dots per run in the order of the runs' shared coordinate, each
// run's lowest dot along the row, the axis the rows run along, the dots'
// fill and size and the marker's size -- into globals u18_<k>s (saved)
// and u18_<k>v (served); _u18_svg: twoway's own dots per run from its
// SVG (the circles of the smallest radius, a dot's outline, one a dot,
// grouped by the coordinate they share) into u18_tw.
python:
def _u18_draw(sp, dp, app):
    from sfi import Macro
    import __main__ as m
    a, b = m._u03_docs(sp, dp, app)
    for figs, sfx in ((a, "s"), (b, "v")):
        out = {"runs": "none", "lo": "none", "along": "none",
               "fill": "none", "size": "-1", "msize": "-1"}
        for f in figs:
            for r in f.renderers:
                g = getattr(r, "glyph", None)
                if type(g).__name__ != "Scatter":
                    continue
                if "dash_dots" not in (r.tags or []):
                    out["msize"] = "%.12g" % float(g.size)
                    continue
                d = r.data_source.data
                runs = {}
                for x, y in zip(d["x"], d["y"]):
                    runs.setdefault(float(x), []).append(float(y))
                ks = sorted(runs)
                out["runs"] = " ".join(str(len(runs[k])) for k in ks) or "none"
                out["lo"] = " ".join("%.12g" % min(runs[k]) for k in ks) or "none"
                gx = g.x if isinstance(g.x, str) else g.x.field
                out["along"] = "y" if gx == "x" else "x"
                out["fill"] = str(g.fill_color).lower()
                out["size"] = "%.12g" % float(g.size)
        for k, v in out.items():
            Macro.setGlobal("u18_%s%s" % (k, sfx), v)


def _u18_svg(path, along):
    from sfi import Macro
    from svg_truth import svg_document
    cs = [c for c in svg_document(path)["circles"] if c["r"] is not None]
    if not cs:
        Macro.setGlobal("u18_tw", "none")
        return
    rmin = min(round(c["r"], 3) for c in cs)
    key = "cx" if along == "y" else "cy"
    runs = {}
    for c in cs:
        if round(c["r"], 3) == rmin:
            runs[round(c[key], 2)] = runs.get(round(c[key], 2), 0) + 1
    ks = sorted(runs, reverse=(along == "x"))
    Macro.setGlobal("u18_tw", " ".join(str(runs[k]) for k in ks))
end

capture program drop _u18_reg
program define _u18_reg
    // _u18_reg <dir> <k> <dash command...>: register one graph, write its
    // spec and data, and read what both modes draw (_u18_draw).
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    dash clear
    quietly dash `0'
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u18_m; _u18_m._u18_draw("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py")
end

* ==== S18 B5b: dot rows ====
local only : env WP31_ONLY
if inlist("`only'", "", "S18") & `: list posof "S18" in w31_run' {
    display as text "S18 start " c(current_date) " " c(current_time)
    local u18d "`w31_work'/s18"
    capture mkdir "`u18d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear

    // ------------------------------------------------------------
    // U18-01: dot mpg weight in 1/5 draws twoway's rows: the same dots
    // per observation (75, from the base to curmin and to curmax), each
    // row starting at twoway's base, in both modes, with no note.
    // ------------------------------------------------------------
    quietly twoway dot mpg weight in 1/5, name(u18t, replace)
    local nd = `.u18t.plotregion1.plot1.num_dots'
    local lo = `.u18t.plotregion1.yscale.curmin'
    local hi = `.u18t.plotregion1.yscale.curmax'
    local base = cond(`lo' <= 0 & `hi' >= 0, 0, cond(`hi' < 0, `hi', `lo'))
    quietly graph export "`u18d'/t1.svg", replace
    python: _u18_svg("`u18d'/t1.svg", "y")
    local tw "${u18_tw}"
    // No twoway graph in memory, so dash's note is about the dots alone.
    graph drop u18t
    _w31_expect U18-01 "(`nd' == 75)" "twoway num_dots `nd'"
    local lf "`u18d'/n1.log"
    dash clear
    quietly log using "`lf'", text replace name(u18n)
    dash dot mpg weight in 1/5
    quietly log close u18n
    _u18_reg "`u18d'" 1 dot mpg weight in 1/5, name(zu181)
    _w31_expect U18-01 `"("${u18_runss}" == "`tw'" & "${u18_runsv}" == "`tw'")"' "dots per row: twoway `tw', saved ${u18_runss}, served ${u18_runsv}"
    _u03_all `base' ${u18_los} ${u18_lov}
    _w31_expect U18-01 "(r(ok))" "each row's first dot: saved ${u18_los}, served ${u18_lov}; twoway's base `base'"
    cert_log_has "`lf'", needle("(note")
    _w31_expect U18-01 "(r(count) == 0)" "the log notes `r(count)' times"
    _w31_done U18-01 "dot mpg weight in 1/5: rows of `tw' dots from the base `base' in both modes, as twoway draws them"

    // ------------------------------------------------------------
    // U18-02: ndots(x) and ndots() on scatter are refused in twoway's
    // words and codes; ndots(1), dotextend(maybe) and dlalign(x) are
    // taken as twoway takes them, dlalign() named.
    // ------------------------------------------------------------
    foreach c in "dot mpg weight, ndots(x)" "scatter mpg weight, ndots(10)" "line mpg weight, dotextend(no)" {
        capture twoway `c' nodraw
        local trc = _rc
        dash clear
        capture dash `c'
        local drc = _rc
        _w31_expect U18-02 "(`trc' == 198 & `drc' == `trc')" "`c': twoway rc `trc', dash rc `drc'"
    }
    local lf2 "`u18d'/n2.log"
    quietly log using "`lf2'", text replace name(u18n2)
    capture noisily dash dot mpg weight, ndots(x)
    quietly log close u18n2
    cert_log_has "`lf2'", needle("option ndots() incorrectly specified")
    _w31_expect U18-02 "(r(count) == 1)" "dash ndots(x) says twoway's line `r(count)' times"
    foreach c in "ndots(1)" "dotextend(maybe)" "dlalign(x)" "baroffset(.5)" {
        capture twoway dot mpg weight, `c' nodraw
        local trc = _rc
        dash clear
        capture dash dot mpg weight, `c'
        local drc = _rc
        _w31_expect U18-02 "(`trc' == 0 & `drc' == 0)" "dot `c': twoway rc `trc', dash rc `drc'"
    }
    _u18_reg "`u18d'" 2 dot mpg weight in 1/5, ndots(1) name(zu182)
    _w31_expect U18-02 `"("${u18_runss}" == "none" & "${u18_runsv}" == "none")"' "ndots(1) draws ${u18_runss} / ${u18_runsv} dots"
    local lf3 "`u18d'/n3.log"
    quietly log using "`lf3'", text replace name(u18n3)
    dash clear
    dash dot mpg weight, dlalign(x) name(zu183)
    quietly log close u18n3
    cert_log_has "`lf3'", needle("dlalign()")
    _w31_expect U18-02 "(r(count) == 1)" "dlalign() named `r(count)' times"
    _w31_done U18-02 "ndots() and dotextend() refused and taken as twoway does; ndots(1) draws no dot; dlalign() named"

    // ------------------------------------------------------------
    // U18-03: dcolor(red) dsize(medium): the dots are red and a medium
    // marker's size, both modes.
    // ------------------------------------------------------------
    _u18_reg "`u18d'" 4 dot mpg weight, dcolor(red) dsize(medium) name(zu184)
    _w31_expect U18-03 `"("${u18_fills}" == "#ff0000" & "${u18_fillv}" == "#ff0000")"' "dots filled ${u18_fills} / ${u18_fillv}"
    _u03_all ${u18_msizes} ${u18_sizes} ${u18_sizev} ${u18_msizev}
    _w31_expect U18-03 "(r(ok))" "dot size saved ${u18_sizes} served ${u18_sizev}, marker ${u18_msizes}"
    // p() drops the d-options, as twoway's p(p3) dcolor(red) draws black
    // dots (dot_truth.json D27).
    _u18_reg "`u18d'" 6 dot mpg weight, p(p3) dcolor(red) name(zu186)
    _w31_expect U18-03 `"("${u18_fills}" == "#000000" & "${u18_fillv}" == "#000000")"' "p(p3) dcolor(red): dots filled ${u18_fills} / ${u18_fillv}"
    _w31_done U18-03 "dcolor(red) dsize(medium): red dots a medium marker (${u18_msizes} px) across, both modes; p() drops dcolor()"

    // ------------------------------------------------------------
    // U18-04: horizontal: the rows run along x at each observation's
    // weight, as twoway's bar_drop_to y says, with its dots per row.
    // ------------------------------------------------------------
    quietly twoway dot mpg weight in 1/5, horizontal dotextend(no) name(u18t, replace)
    local dt "`.u18t.plotregion1.plot1.bar_drop_to.stylename'"
    quietly graph export "`u18d'/t4.svg", replace
    python: _u18_svg("`u18d'/t4.svg", "x")
    local tw "${u18_tw}"
    _u18_reg "`u18d'" 5 dot mpg weight in 1/5, horizontal dotextend(no) name(zu185)
    _w31_expect U18-04 `"("`dt'" == "y" & "${u18_alongs}" == "x" & "${u18_alongv}" == "x")"' "twoway drops to `dt'; dash's rows along ${u18_alongs} / ${u18_alongv}"
    _w31_expect U18-04 `"("${u18_runss}" == "`tw'" & "${u18_runsv}" == "`tw'")"' "dots per row: twoway `tw', saved ${u18_runss}, served ${u18_runsv}"
    _w31_done U18-04 "horizontal dotextend(no): rows along x of `tw' dots, both modes, as twoway draws them"

    foreach f in t1.svg t4.svg n1.log n2.log n3.log {
        capture erase "`u18d'/`f'"
    }
    foreach k in 1 2 4 5 6 {
        foreach p in s d {
            capture erase "`u18d'/`p'`k'.json"
        }
        capture erase "`u18d'/a`k'.py"
    }
    capture rmdir "`u18d'"
    macro drop u18_*
    capture graph drop _all
    dash clear
    display as text "S18 end " c(current_date) " " c(current_time)
}
* ==== end S18 ====

// S19 helpers (WP-31 F1d).  _u19_move: the saved page's lpoly line after
// one filter move -- the page rendered, the widget set and its own
// callback run under node (test/js_runner.py) -- written to a JSON file,
// its point count in global u19_n.  _u19_gen_compare: the saved line
// against Stata's lpoly gen(*gx* *gy*): the grid rows (gx not missing)
// whose smooth is not missing, in grid order; global u19_ok 1 or 0 and
// u19_msg.
python:
def _u19_move(sp, dp, kind, value, out):
    import json
    import os
    import sys
    import warnings
    if os.getcwd() not in sys.path:
        sys.path.insert(0, os.getcwd())
    import dash_render as dr
    import js_runner
    from sfi import Macro
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
    w = [m for m in r.filter_widgets if type(m).__name__ == kind][0]
    if kind == "Select":
        w.value = [v for v, lab in w.options if lab == value][0]
    elif kind == "RangeSlider":
        w.value = tuple(float(v) for v in value.split())
    else:
        w.value = float(value)
    cb = r.filter_callbacks[r.filter_widgets.index(w)]
    js_runner.JsSession(r.filter_callbacks).run(cb)
    lp = [x for f in r.figures.values() for x in f.renderers
          if (getattr(x, "_dash_agg_config", None) or {}).get("type")
          == "lpoly"]
    d = lp[0].data_source.data
    with open(out, "w", encoding="utf-8") as fh:
        json.dump({"x": [float(v) for v in d["x_lp"]],
                   "y": [float(v) for v in d["y_lp"]]}, fh)
    Macro.setGlobal("u19_n", str(len(d["x_lp"])))


def _u19_gen_compare(saved, gx, gy, rtol):
    import json
    import numpy as np
    from sfi import Data, Macro
    g = json.load(open(saved, encoding="utf-8"))
    sx, sy = np.asarray(g["x"], float), np.asarray(g["y"], float)
    miss = lambda v: v is None or v >= 8.98e307
    xs, ys = [], []
    for x, y in zip(Data.get(var=gx), Data.get(var=gy)):
        if not miss(x) and not miss(y):
            xs.append(float(x))
            ys.append(float(y))
    tx, ty = np.asarray(xs), np.asarray(ys)
    ok = 0
    if len(tx) != len(sx):
        msg = "%d saved points, Stata %d" % (len(sx), len(tx))
    elif not len(tx):
        msg = "no points"
    else:
        dx = float(np.max(np.abs(sx - tx) / np.maximum(np.abs(tx), 1.0)))
        dy = float(np.max(np.abs(sy - ty) / np.maximum(np.abs(ty), 1.0)))
        ok = int(dx <= rtol and dy <= rtol)
        msg = "%d points, largest relative difference x %.3g y %.3g" % (
            len(sx), dx, dy)
    Macro.setGlobal("u19_ok", str(ok))
    Macro.setGlobal("u19_msg", msg)
end

* ==== S19 F1d: lpoly refits on the saved page ====
local only : env WP31_ONLY
if inlist("`only'", "", "S19") & `: list posof "S19" in w31_run' {
    display as text "S19 start " c(current_date) " " c(current_time)
    local u19d "`w31_work'/s19"
    capture mkdir "`u19d'"
    capture graph drop _all

    // ------------------------------------------------------------
    // U19-01..04, U19-06: after a move the saved smooth is Stata's lpoly
    // on the kept rows, gen() on its grid: the default bandwidth (the
    // rule of thumb from the kept rows; only through the curve, which
    // agrees only when the bandwidth does) after the dropdown to Foreign;
    // degree(1) bwidth(400) n(20) after the range to 4500-11385; [aw]
    // biweight degree(2) after the dropdown to Domestic (degree 2's rule
    // of thumb fits x^0..x^6 in raw powers: Stata's round-off there is
    // test_lpoly_rot.py's 5e-5 tier; measured 8.1e-6); uslifeexp's
    // years (an offset x; Stata's own round-off on raw powers is about
    // 1e-5 there, test_lpoly_rot.py's tier) after the range to 1900-1950;
    // degree(4) bwidth(800) after the dropdown to Foreign.  auto's _N is
    // 74 and uslifeexp's 100, so lpoly's n is 50 unless n() is given.
    // ------------------------------------------------------------
    local k 0
    foreach c in "U19-01|auto|(scatter mpg weight) (lpoly mpg weight)|foreign, type(dropdown)|Select|Foreign|lpoly mpg weight if foreign == 1, nograph gen(u19x u19y)|1e-6" "U19-02|auto|(lpoly mpg weight, degree(1) bwidth(400) n(20))|price, type(range)|RangeSlider|4500 11385|lpoly mpg weight if inrange(price, 4500, 11385), degree(1) bwidth(400) n(20) nograph gen(u19x u19y)|1e-6" "U19-03|auto|(lpoly mpg weight [aw=displacement], kernel(biweight) degree(2))|foreign, type(dropdown)|Select|Domestic|lpoly mpg weight if foreign == 0 [aw=displacement], kernel(biweight) degree(2) nograph gen(u19x u19y)|5e-5" "U19-04|uslifeexp|(lpoly le year)|year, type(range)|RangeSlider|1900 1950|lpoly le year if inrange(year, 1900, 1950), nograph gen(u19x u19y)|1e-4" "U19-06|auto|(lpoly mpg weight, degree(4) bwidth(800))|foreign, type(dropdown)|Select|Foreign|lpoly mpg weight if foreign == 1, degree(4) bwidth(800) nograph gen(u19x u19y)|1e-6" {
        local ++k
        mata: u19_t = ustrsplit(st_local("c"), "[|]"); st_local("id", u19_t[1]); st_local("ds", u19_t[2]); st_local("cmd", u19_t[3]); st_local("filt", u19_t[4]); st_local("kind", u19_t[5]); st_local("val", u19_t[6]); st_local("lp", u19_t[7]); st_local("tol", u19_t[8])
        sysuse `ds', clear
        dash clear
        capture noisily dash `cmd', name(zu19`k')
        _w31_expect `id' "(_rc == 0)" "dash `cmd' rc `=_rc'"
        _dash_serve_spec, specpath("`u19d'/s`k'.json") datapath("`u19d'/d`k'.json") filter(`filt')
        python: _u19_move("`u19d'/s`k'.json", "`u19d'/d`k'.json", "`kind'", "`val'", "`u19d'/g`k'.json")
        quietly `lp'
        python: _u19_gen_compare("`u19d'/g`k'.json", "u19x", "u19y", `tol')
        _w31_expect `id' "(${u19_ok} == 1)" "dash `cmd', filter(`filt') moved to `val': ${u19_msg}"
        _w31_done `id' "the saved `cmd' after the move to `val' is `lp' (${u19_msg})"
    }

    // ------------------------------------------------------------
    // U19-05: a move leaving one row empties the saved smooth; twoway
    // lpoly on that row is refused (rc measured here).
    // ------------------------------------------------------------
    sysuse auto, clear
    dash clear
    capture noisily dash (scatter mpg weight) (lpoly mpg weight), name(zu195)
    _w31_expect U19-05 "(_rc == 0)" "dash lpoly rc `=_rc'"
    _dash_serve_spec, specpath("`u19d'/s5.json") datapath("`u19d'/d5.json") filter(price, type(slider))
    python: _u19_move("`u19d'/s5.json", "`u19d'/d5.json", "Slider", "15906", "`u19d'/g5.json")
    quietly count if price >= 15906
    local nk = r(N)
    _w31_expect U19-05 "(`nk' == 1)" "price >= 15906 keeps `nk' rows"
    _w31_expect U19-05 "(${u19_n} == 0)" "the saved lpoly after the slider to 15906 holds ${u19_n} points"
    capture noisily twoway lpoly mpg weight if price >= 15906, nodraw
    local trc = _rc
    _w31_expect U19-05 "(`trc' == 2001)" "twoway lpoly on one row: rc `trc'"
    _w31_done U19-05 "one kept row: the saved smooth is empty; twoway refuses it (rc `trc')"

    forvalues k = 1/6 {
        foreach p in s d g {
            capture erase "`u19d'/`p'`k'.json"
        }
    }
    capture rmdir "`u19d'"
    macro drop u19_n u19_ok u19_msg
    capture mata: mata drop u19_t
    capture graph drop _all
    dash clear
    display as text "S19 end " c(current_date) " " c(current_time)
}
* ==== end S19 ====

// S20 helpers (WP-31 C9).  _u20_draw: the marker sizes a registered dash
// graph draws, saved (DashRenderer) and served (the generated app's
// make_document), in data order, every marker renderer's (Scatter, not a
// dot row, not a colorvar swatch) one after another: u20_s, u20_v ("."
// for a marker not drawn); u20_f 1 when every one reads a size column;
// u20_d the dot rows' size kind ("field", "scalar" or "").  _u20_svg:
// the outlined marker radii of a twoway SVG, in drawing order (u20_r).
// _u20_match: u20_ok 1 when the sizes in global <s>, over <sb>, equal the
// radii in global <r>, over <rb>, within 2% (a radius of 0.25 is a marker
// of size zero), and every marker twoway drew is one dash draws.
python:
import os as _u20_os, re as _u20_re, sys as _u20_sys
for _u20_p in (_u20_os.path.abspath(".."),):
    if _u20_p not in _u20_sys.path:
        _u20_sys.path.insert(0, _u20_p)


def _u20_sizes(figs):
    import numpy as np
    import dash_render as dr
    out, field, dots = [], True, ""
    for f in figs:
        for r in f.renderers:
            g = getattr(r, "glyph", None)
            if type(g).__name__ != "Scatter":
                continue
            if "dash_dots" in (r.tags or []):
                dots = "field" if isinstance(g.size, str) else "scalar"
                continue
            if dr._dash_is_swatch(r):
                continue
            d = r.data_source.data
            if isinstance(g.size, str):
                vals = [float(v) for v in d[g.size]]
            else:
                field = False
                n = len(next(iter(d.values()), []))
                vals = [float(g.size)] * n
            out.extend("." if not np.isfinite(v) else "%.9g" % v
                       for v in vals)
    return " ".join(out), field, dots


def _u20_draw(sp, dp, app):
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    from bokeh.models import Plot
    from sfi import Macro
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_u20_app")
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_u20_app.py", "exec"),
             ns)
        doc = Document()
        ns["make_document"](doc)
    s, fs, ds = _u20_sizes(list(r.figures.values()))
    v, fv, dv = _u20_sizes([m for root in doc.roots
                            for m in root.select({"type": Plot})])
    Macro.setGlobal("u20_s", s)
    Macro.setGlobal("u20_v", v)
    Macro.setGlobal("u20_f", "1" if (fs and fv and s) else "0")
    Macro.setGlobal("u20_d", ds if ds == dv else "differ")


def _u20_svg(fn):
    from sfi import Macro
    with open(fn, encoding="utf-8") as fh:
        txt = fh.read()
    rr = [m.group(1) for m in _u20_re.finditer(
        r'<circle cx="[-\d.]+" cy="[-\d.]+" r="([\d.]+)" style="[^"]*fill:none',
        txt)]
    Macro.setGlobal("u20_r", " ".join(rr))


def _u20_match(skey, rkey, sb, rb):
    from sfi import Macro
    s = [None if t == "." else float(t)
         for t in (Macro.getGlobal(skey) or "").split()]
    r = [float(t) for t in (Macro.getGlobal(rkey) or "").split()]
    drawn = [x for x in s if x is not None]
    ok = bool(r) and len(drawn) == len(r)
    for a, b in zip(drawn, r):
        if b == 0.25:
            ok = ok and a == 0.0
        else:
            want = b / float(rb)
            ok = ok and abs(a / float(sb) - want) <= 0.02 * want
    Macro.setGlobal("u20_ok", "1" if ok else "0")
end

capture program drop _u20_reg
program define _u20_reg
    // _u20_reg <dir> <k> <dash command...>: register one graph under a
    // log (u20_log), write its spec and data, and read both modes.
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    foreach g in s v f d {
        global u20_`g' ""
    }
    dash clear
    capture log close _u20log
    quietly log using "`dir'/l`k'.log", text replace name(_u20log)
    capture noisily dash `0'
    global u20_rc = _rc
    quietly log close _u20log
    global u20_log "`dir'/l`k'.log"
    if ${u20_rc} exit
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u20_m; _u20_m._u20_draw("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py")
end

capture program drop _u20_tw
program define _u20_tw
    // _u20_tw <file> <twoway command...>: twoway's rc (u20_trc) and, when
    // it drew, its SVG's marker radii (u20_r).
    version 19
    gettoken fn 0 : 0
    global u20_r ""
    capture graph drop u20g
    capture noisily twoway `0' name(u20g, replace)
    global u20_trc = _rc
    if ${u20_trc} exit
    cert_svg_export, name(u20g) file("`fn'")
    python: import __main__ as _u20_m; _u20_m._u20_svg("`fn'")
    capture graph drop u20g
end

* ==== S20 C9: weighted markers ====
local only : env WP31_ONLY
if inlist("`only'", "", "S20") & `: list posof "S20" in w31_run' {
    display as text "S20 start " c(current_date) " " c(current_time)
    local u20d "`w31_work'/s20"
    capture mkdir "`u20d'"
    capture graph drop _all
    sysuse auto, clear
    quietly keep in 1/8
    quietly generate double lo = mpg - 2
    quietly generate double hi = mpg + 2
    quietly generate double wneg = cond(_n == 1, -1, price)
    quietly generate double wz = cond(_n == 1, 0, price)
    quietly generate double wmis = cond(_n == 1, ., price)
    quietly generate double zero = 0

    // ------------------------------------------------------------
    // U20-01: scatter [aw=price]: no note, the weight in the spec, and
    // each marker at twoway's size relative to the unweighted marker
    // (twoway's SVG in this session), saved and served.
    // ------------------------------------------------------------
    _u20_tw "`u20d'/t0.svg" scatter mpg weight,
    local r0 : word 1 of ${u20_r}
    _u20_tw "`u20d'/t1.svg" scatter mpg weight [aw=price],
    global u20_tr "${u20_r}"
    _u20_reg "`u20d'" 0 scatter mpg weight, name(u200)
    local s0 : word 1 of ${u20_s}
    _u20_reg "`u20d'" 1 scatter mpg weight [aw=price], name(u201)
    _w31_expect U20-01 "(${u20_rc} == 0)" "dash scatter [aw=price] rc ${u20_rc}"
    cert_log_has "${u20_log}", needle("weight]")
    _w31_expect U20-01 "(r(count) == 0)" "the weight was named"
    mata: st_local("js", st_global("dash_json_u201"))
    _w31_expect U20-01 `"(strpos(`"`macval(js)'"', `""weight":"aweight""') > 0 & strpos(`"`macval(js)'"', `""wexp":"price""') > 0)"' "the spec carries no weight"
    _w31_expect U20-01 "(${u20_f} == 1)" "a marker size is one number"
    python: import __main__ as _u20_m; _u20_m._u20_match("u20_s", "u20_tr", "`s0'", "`r0'")
    _w31_expect U20-01 "(${u20_ok} == 1)" "saved sizes ${u20_s} (unweighted `s0') against twoway's radii ${u20_tr} (`r0')"
    python: _u20_m._u20_match("u20_v", "u20_tr", "`s0'", "`r0'")
    _w31_expect U20-01 "(${u20_ok} == 1)" "served sizes ${u20_v} against twoway's radii ${u20_tr}"
    _w31_done U20-01 "scatter [aw=price] sizes each marker as twoway does, in both modes, naming nothing"

    // ------------------------------------------------------------
    // U20-02: msize(huge) is the size the weight multiplies (W03).
    // ------------------------------------------------------------
    _u20_tw "`u20d'/t2.svg" scatter mpg weight, msize(huge)
    local r0 : word 1 of ${u20_r}
    _u20_tw "`u20d'/t3.svg" scatter mpg weight [aw=price], msize(huge)
    global u20_tr "${u20_r}"
    _u20_reg "`u20d'" 2 scatter mpg weight, msize(huge) name(u202)
    local s0 : word 1 of ${u20_s}
    _u20_reg "`u20d'" 3 scatter mpg weight [aw=price], msize(huge) name(u203)
    _w31_expect U20-02 "(${u20_rc} == 0)" "rc ${u20_rc}"
    python: _u20_m._u20_match("u20_s", "u20_tr", "`s0'", "`r0'")
    _w31_expect U20-02 "(${u20_ok} == 1)" "saved sizes ${u20_s} (`s0') against ${u20_tr} (`r0')"
    python: _u20_m._u20_match("u20_v", "u20_tr", "`s0'", "`r0'")
    _w31_expect U20-02 "(${u20_ok} == 1)" "served sizes ${u20_v} against ${u20_tr}"
    _w31_done U20-02 "msize(huge) under [aw=price]: the weight multiplies it, as in twoway"

    // ------------------------------------------------------------
    // U20-03: a negative, a zero and a missing weight; no weight above
    // zero (W05, W06): twoway's rc and silence, its marker sizes.
    // ------------------------------------------------------------
    _u20_tw "`u20d'/t4.svg" scatter mpg weight,
    local r0 : word 1 of ${u20_r}
    _u20_reg "`u20d'" 4 scatter mpg weight, name(u204)
    local s0 : word 1 of ${u20_s}
    local k 5
    foreach w in wneg wz wmis {
        _u20_tw "`u20d'/t`k'.svg" scatter mpg weight [aw=`w'],
        _w31_expect U20-03 "(${u20_trc} == 0)" "twoway [aw=`w'] rc ${u20_trc}"
        global u20_tr "${u20_r}"
        _u20_reg "`u20d'" `k' scatter mpg weight [aw=`w'], name(u20`k')
        _w31_expect U20-03 "(${u20_rc} == 0)" "dash [aw=`w'] rc ${u20_rc}"
        cert_log_has "${u20_log}", needle("weight")
        _w31_expect U20-03 "(r(count) == 0)" "[aw=`w']: dash said something of the weight"
        python: _u20_m._u20_match("u20_s", "u20_tr", "`s0'", "`r0'")
        _w31_expect U20-03 "(${u20_ok} == 1)" "[aw=`w'] saved ${u20_s} against ${u20_tr}"
        local ++k
    }
    capture noisily twoway scatter mpg weight [aw=zero], name(u20g, replace)
    local trc = _rc
    capture graph drop u20g
    _u20_reg "`u20d'" 8 scatter mpg weight [aw=zero], name(u208)
    _w31_expect U20-03 "(`trc' == 198 & ${u20_rc} == `trc')" "no weight above zero: twoway rc `trc', dash ${u20_rc}"
    _w31_expect U20-03 `"("${dash_graph_registry}" == "")"' "the refused graph was registered"
    _u20_reg "`u20d'" 9 scatter mpg weight [aw=zero], mlabel(make) name(u209)
    _w31_expect U20-03 "(${u20_rc} == 0)" "[aw=zero] with mlabel(): rc ${u20_rc} (twoway draws it, W06_mlab)"
    _w31_done U20-03 "negative, zero and missing weights size the markers as twoway does; none above zero is twoway's r(198)"

    // ------------------------------------------------------------
    // U20-04: on markerless types the weight is taken and nothing is
    // said (W07; it was named in the note).
    // ------------------------------------------------------------
    local k 10
    foreach c in "line mpg weight [aw=price]" "bar mpg weight [fw=rep78]" "rspike lo hi weight [aw=price]" {
        _u20_reg "`u20d'" `k' `c', name(u20`k')
        _w31_expect U20-04 "(${u20_rc} == 0)" "`c': rc ${u20_rc}"
        cert_log_has "${u20_log}", needle("weight")
        _w31_expect U20-04 "(r(count) == 0)" "`c': the weight was named"
        local ++k
    }
    _w31_done U20-04 "line, bar and rspike take a weight and say nothing, as twoway"

    // ------------------------------------------------------------
    // U20-05: rscatter's two ends and dot's marker are sized; dot's rows
    // of dots are not (W08, W09).
    // ------------------------------------------------------------
    _u20_tw "`u20d'/t13.svg" rscatter lo hi weight,
    local r0 : word 1 of ${u20_r}
    _u20_tw "`u20d'/t14.svg" rscatter lo hi weight [aw=price],
    global u20_tr "${u20_r}"
    _u20_reg "`u20d'" 13 rscatter lo hi weight, name(u2013)
    local s0 : word 1 of ${u20_s}
    _u20_reg "`u20d'" 14 rscatter lo hi weight [aw=price], name(u2014)
    _w31_expect U20-05 "(${u20_rc} == 0 & ${u20_f} == 1)" "rscatter rc ${u20_rc}, field ${u20_f}"
    python: _u20_m._u20_match("u20_s", "u20_tr", "`s0'", "`r0'")
    _w31_expect U20-05 "(${u20_ok} == 1)" "rscatter saved ${u20_s} against ${u20_tr}"
    _u20_reg "`u20d'" 15 dot mpg weight [aw=price], name(u2015)
    _w31_expect U20-05 `"(${u20_rc} == 0 & ${u20_f} == 1 & "${u20_d}" == "scalar")"' "dot rc ${u20_rc}, marker field ${u20_f}, dot rows ${u20_d}"
    _w31_done U20-05 "rscatter's ends and dot's marker are sized by the weight; dot's rows are not"

    // ------------------------------------------------------------
    // U20-06: the refusals stay twoway's.
    // ------------------------------------------------------------
    dash clear
    foreach c in "scatteri 1 2 [aw=price]" "lowess mpg weight [aw=price]" "scatter mpg weight [iw=price]" {
        capture noisily twoway `c', nodraw
        local trc = _rc
        capture noisily dash `c', name(u20r)
        local drc = _rc
        _w31_expect U20-06 "(`trc' != 0 & `drc' == `trc')" "`c': twoway rc `trc', dash rc `drc'"
    }
    _w31_expect U20-06 `"("${dash_graph_registry}" == "")"' "a refused graph was registered"
    _w31_done U20-06 "scatteri, lowess and an iweight are refused with twoway's codes"

    forvalues k = 0/15 {
        foreach p in s d l {
            capture erase "`u20d'/`p'`k'.json"
        }
        capture erase "`u20d'/l`k'.log"
        capture erase "`u20d'/a`k'.py"
        capture erase "`u20d'/t`k'.svg"
    }
    capture rmdir "`u20d'"
    macro drop u20_*
    capture graph drop _all
    dash clear
    display as text "S20 end " c(current_date) " " c(current_time)
}
* ==== end S20 ====

// S20 helper (WP-31 A5b).  _u20_rows: the rows every glyph of a saved
// render draws, summed (u20_n).
python:
def _u20_rows(sp, dp):
    import warnings
    import dash_render as dr
    from sfi import Macro
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
    n = sum(len(next(iter(x.data_source.data.values()), []))
            for f in r.figures.values() for x in f.renderers
            if getattr(x, "data_source", None) is not None)
    Macro.setGlobal("u20_n", str(n))
end

* ==== S20 A5b: a weight zero on every row ====
local only : env WP31_ONLY
if inlist("`only'", "", "S20") & `: list posof "S20" in w31_run' {
    display as text "S20 start " c(current_date) " " c(current_time)
    local u20d "`w31_work'/s20b"
    capture mkdir "`u20d'"
    capture graph drop _all
    sysuse auto, clear
    quietly generate double zero = 0

    // ------------------------------------------------------------
    // U20-07: twoway's rc and words beside dash's, built (the notes are
    // the render's), for an all-zero expression and variable; dash draws
    // nothing, as twoway draws nothing.
    // ------------------------------------------------------------
    local k 0
    foreach c in "lfit mpg weight [aw=price-price]" "lfit mpg weight [aw=zero]" "qfitci mpg weight [aw=price-price]" "fpfit mpg weight [aw=zero]" "fpfitci mpg weight [aw=price-price]" "kdensity mpg [aw=price-price]" "histogram mpg [fw=zero]" "lpoly mpg weight [aw=price-price]" {
        local ++k
        capture log close _u20t
        quietly log using "`u20d'/t`k'.log", text replace name(_u20t)
        capture noisily twoway `c', nodraw
        local trc = _rc
        quietly log close _u20t
        dash clear
        capture log close _u20d
        quietly log using "`u20d'/d`k'.log", text replace name(_u20d)
        capture noisily dash `c'
        local drc = _rc
        quietly log close _u20d
        _w31_expect U20-07 "(`trc' == `drc')" "`c': twoway rc `trc', dash rc `drc'"
        foreach nd in "regress could not fit model" "fracpoly could not fit model" "no observations" {
            cert_log_has "`u20d'/t`k'.log", needle("`nd'")
            local tn = r(count) > 0
            cert_log_has "`u20d'/d`k'.log", needle("`nd'")
            local dn = r(count) > 0
            _w31_expect U20-07 "(`tn' == `dn')" "`c': twoway says '`nd'' `tn', dash `dn'"
        }
        foreach nd in "excluded" "__dashw" "weight=" {
            cert_log_has "`u20d'/d`k'.log", needle("`nd'")
            _w31_expect U20-07 "(r(count) == 0)" "`c': dash said '`nd''"
        }
        if `drc' == 0 {
            dash clear
            quietly dash `c', name(u20b`k')
            _dash_serve_spec, specpath("`u20d'/s`k'.json") datapath("`u20d'/j`k'.json")
            python: import __main__ as _u20_m; _u20_m._u20_rows("`u20d'/s`k'.json", "`u20d'/j`k'.json")
            _w31_expect U20-07 "(${u20_n} == 0)" "`c': dash draws ${u20_n} rows where twoway draws none"
        }
        dash clear
    }
    _w31_done U20-07 "an all-zero weight: twoway's note and rc, nothing drawn, nothing else said"

    forvalues k = 1/8 {
        foreach p in t d {
            capture erase "`u20d'/`p'`k'.log"
        }
        capture erase "`u20d'/s`k'.json"
        capture erase "`u20d'/j`k'.json"
    }
    capture rmdir "`u20d'"
    macro drop u20_*
    dash clear
    display as text "S20 end " c(current_date) " " c(current_time)
}
* ==== end S20 ====

// S21 helpers (WP-31 B1).  _u21_draw: what both modes draw of a
// registered one-graph spec, optionally after one filter move (the saved
// page's own callback under node, test/js_runner.py; the served app's
// widget callbacks) -- the spike, cap and marker renderers, the marker's
// y and x fields, the spike's x0/y0/x1 fields, cap and marker sizes, the
// rows each renderer holds, the y range and the y axis title -- into
// globals u21_<key>s (saved) and u21_<key>v (served); and the spec's
// first plot's type and variable keys into u21_spec.
python:
def _u21_draw(sp, dp, app, kind="", value=""):
    import json
    import os
    import sys
    import warnings
    if os.getcwd() not in sys.path:
        sys.path.insert(0, os.getcwd())
    import dash_render as dr
    from bokeh.document import Document
    from sfi import Macro
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
    if kind:
        import js_runner
        w = [m for m in r.filter_widgets if type(m).__name__ == kind][0]
        w.value = [v for v, lab in w.options if lab == value][0]
        cb = r.filter_callbacks[r.filter_widgets.index(w)]
        js_runner.JsSession(r.filter_callbacks).run(cb)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_u21_app")
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_u21_app.py", "exec"),
             ns)
        doc = Document()
        ns["make_document"](doc)
        if kind:
            ws = [m for m in doc.models if type(m).__name__ == kind]
            w = ws[0]
            w.value = [v for v, lab in w.options if lab == value][0]
            for key in ("value", "value_throttled"):
                for cb in list(w._callbacks.get(key, [])):
                    cb("value", None, w.value)
    sv = [m for m in doc.models if type(m).__name__ == "figure"]

    def fld(v):
        return v if isinstance(v, str) else (getattr(v, "field", None) or "")

    for figs, sfx in ((list(r.figures.values()), "s"), (sv, "v")):
        out = {"nseg": 0, "ncap": 0, "nmk": 0, "mky": "", "mkx": "",
               "segx0": "", "segx1": "", "segy0": "", "capsz": [],
               "mksz": "", "rows": [], "y0": "", "y1": "", "yt": ""}
        f = figs[0]
        out["y0"] = "%.12g" % float(f.y_range.start)
        out["y1"] = "%.12g" % float(f.y_range.end)
        out["yt"] = str(f.yaxis[0].axis_label or "")
        for x in f.renderers:
            g = getattr(x, "glyph", None)
            if g is None or dr._dash_is_swatch(x):
                continue
            t = type(g).__name__
            d = x.data_source.data
            col = "weight" if "weight" in d else sorted(d)[0]
            if t == "Segment":
                out["nseg"] += 1
                out["segx0"], out["segx1"] = fld(g.x0), fld(g.x1)
                out["segy0"] = fld(g.y0)
            elif t == "Scatter" and "dash_cap" in (x.tags or []):
                out["ncap"] += 1
                out["capsz"].append("%.12g" % float(g.size))
            elif t == "Scatter":
                out["nmk"] += 1
                out["mky"], out["mkx"] = fld(g.y), fld(g.x)
                out["mksz"] = "%.12g" % float(g.size)
            else:
                continue
            out["rows"].append(str(len(d[col])))
        for k, v in out.items():
            if isinstance(v, list):
                v = " ".join(v) or "none"
            Macro.setGlobal("u21_%s%s" % (k, sfx), str(v) if v != "" else "none")
    p = json.load(open(sp, encoding="utf-8"))["graphs"][0]["plots"][0]
    Macro.setGlobal("u21_spec", " ".join(
        "%s=%s" % (k, p.get(k, "")) for k in ("type", "yvar1", "yvar2",
                                              "yvar", "xvar")))
end

// _u21_wsized: whether the marker and the caps of a weighted rpcap read
// their size from a column, saved and served, into u21_ws / u21_wv as
// "<marker 1|0> <any cap 1|0>".
python:
def _u21_wsized(sp, dp, app):
    import __main__ as m
    from sfi import Macro
    a, b = m._u03_docs(sp, dp, app)
    for figs, sfx in ((a, "s"), (b, "v")):
        mk = cap = 0
        for x in figs[0].renderers:
            g = getattr(x, "glyph", None)
            if type(g).__name__ != "Scatter":
                continue
            if "dash_cap" in (x.tags or []):
                cap = cap or int(isinstance(g.size, str))
            else:
                mk = int(isinstance(g.size, str))
        Macro.setGlobal("u21_w" + sfx, "%d %d" % (mk, cap))
end

capture program drop _u21_reg
program define _u21_reg
    // _u21_reg <dir> <k> <kind> <value> <dash command...>: register one
    // graph, write its spec and data (with a dropdown filter on foreign
    // when <kind> is not "-"), and read what both modes draw (_u21_draw).
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    gettoken kind 0 : 0
    gettoken value 0 : 0
    dash clear
    capture quietly dash `0'
    if _rc {
        // Refused: nothing drawn, every count 0 and every size unequal.
        local rc = _rc
        foreach m in s v {
            foreach g in nseg ncap nmk {
                global u21_`g'`m' 0
            }
            foreach g in mky mkx segx0 segx1 segy0 rows yt {
                global u21_`g'`m' "none"
            }
            global u21_capsz`m' -2
            global u21_mksz`m' -1
            global u21_y0`m' -1
            global u21_y1`m' -1
        }
        global u21_spec "rc `rc'"
        exit
    }
    if "`kind'" == "-" {
        _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
        python: import __main__ as _u21_m; _u21_m._u21_draw("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py")
    }
    else {
        _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json") filter(foreign, type(dropdown))
        python: import __main__ as _u21_m; _u21_m._u21_draw("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py", "`kind'", "`value'")
    }
end

* ==== S21 B1: rpcap and rpspike ====
local only : env WP31_ONLY
if inlist("`only'", "", "S21") & `: list posof "S21" in w31_run' {
    display as text "S21 start " c(current_date) " " c(current_time)
    local u21d "`w31_work'/s21"
    capture mkdir "`u21d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear
    generate lo = turn - 5
    generate hi = turn + 5

    // ------------------------------------------------------------
    // U21-1: dash rpcap lo hi turn weight registers the four roles
    // twoway reads (y3xview: yvar, y2var, y3var, xvar) and draws, in
    // both modes, one spike, two caps and one marker at turn, the caps
    // as wide as the marker.
    // ------------------------------------------------------------
    quietly twoway rpcap lo hi turn weight, name(u21t, replace)
    local r1 "`.u21t.plotregion1.plot1.serset.sers[`.u21t.plotregion1.plot1.yvar'].name'"
    local r2 "`.u21t.plotregion1.plot1.serset.sers[`.u21t.plotregion1.plot1.y2var'].name'"
    local r3 "`.u21t.plotregion1.plot1.serset.sers[`.u21t.plotregion1.plot1.y3var'].name'"
    graph drop u21t
    _u21_reg "`u21d'" 1 - - rpcap lo hi turn weight, name(zu211)
    _w31_expect U21-1 `"("${u21_spec}" == "type=rpcap yvar1=`r1' yvar2=`r2' yvar=`r3' xvar=weight")"' "spec ${u21_spec}; twoway's roles `r1' `r2' `r3'"
    foreach m in s v {
        _w31_expect U21-1 `"(${u21_nseg`m'} == 1 & ${u21_ncap`m'} == 2 & ${u21_nmk`m'} == 1)"' "`m': ${u21_nseg`m'} spikes, ${u21_ncap`m'} caps, ${u21_nmk`m'} markers"
        _w31_expect U21-1 `"("${u21_mky`m'}" == "turn")"' "`m': marker y ${u21_mky`m'}"
        _u03_all ${u21_mksz`m'} ${u21_capsz`m'}
        _w31_expect U21-1 "(r(ok))" "`m': caps ${u21_capsz`m'}, marker ${u21_mksz`m'}"
    }
    _w31_done U21-1 "rpcap: one spike, two caps as wide as the marker (${u21_mkszs} px) and a marker at turn, both modes"

    // ------------------------------------------------------------
    // U21-2: rpspike: one spike and one marker, no cap.
    // ------------------------------------------------------------
    _u21_reg "`u21d'" 2 - - rpspike lo hi turn weight, name(zu212)
    foreach m in s v {
        _w31_expect U21-2 `"(${u21_nseg`m'} == 1 & ${u21_ncap`m'} == 0 & ${u21_nmk`m'} == 1 & "${u21_mky`m'}" == "turn")"' "`m': ${u21_nseg`m'} spikes, ${u21_ncap`m'} caps, ${u21_nmk`m'} markers at ${u21_mky`m'}"
    }
    _w31_done U21-2 "rpspike: one spike and one marker at turn, no cap, both modes"

    // ------------------------------------------------------------
    // U21-3: the y axis spans the three variables (y3xview_g.ranges):
    // the range of rcap lo hi with scatter turn on the same x, both
    // modes, and twoway's ranges agree.
    // ------------------------------------------------------------
    quietly twoway rpcap lo hi turn weight, name(u21t, replace)
    local ta = "`.u21t.yaxis1.major.min' `.u21t.yaxis1.major.max'"
    quietly twoway (rcap lo hi weight) (scatter turn weight), name(u21t, replace)
    local tb = "`.u21t.yaxis1.major.min' `.u21t.yaxis1.major.max'"
    graph drop u21t
    _w31_expect U21-3 `"("`ta'" == "`tb'")"' "twoway rpcap y major `ta', rcap and scatter `tb'"
    _u21_reg "`u21d'" 3 - - rpcap lo hi turn weight, name(zu213)
    local a "${u21_y0s} ${u21_y1s} ${u21_y0v} ${u21_y1v}"
    _u21_reg "`u21d'" 4 - - (rcap lo hi weight) (scatter turn weight), name(zu214)
    local b "${u21_y0s} ${u21_y1s} ${u21_y0v} ${u21_y1v}"
    _w31_expect U21-3 `"("`a'" == "`b'")"' "rpcap y range `a'; rcap and scatter `b'"
    _w31_done U21-3 "the y range spans lo, hi and turn as twoway's does: `a'"

    // ------------------------------------------------------------
    // U21-4: msize(large) sizes caps and marker together, larger than
    // the default (twoway: marker.size.gmval grows the same way).
    // ------------------------------------------------------------
    quietly twoway rpcap lo hi turn weight, name(u21t, replace)
    local g0 = `.u21t.plotregion1.plot1.style.marker.size.gmval'
    quietly twoway rpcap lo hi turn weight, msize(large) name(u21t, replace)
    local g1 = `.u21t.plotregion1.plot1.style.marker.size.gmval'
    graph drop u21t
    _w31_expect U21-4 "(`g1' > `g0')" "twoway marker size `g0' -> `g1'"
    _u21_reg "`u21d'" 5 - - rpcap lo hi turn weight, name(zu215)
    local d0 "${u21_mkszs}"
    _u21_reg "`u21d'" 6 - - rpcap lo hi turn weight, msize(large) name(zu216)
    foreach m in s v {
        _u03_all ${u21_mksz`m'} ${u21_capsz`m'}
        _w31_expect U21-4 "(r(ok) & ${u21_mksz`m'} > `d0')" "`m': msize(large) caps ${u21_capsz`m'}, marker ${u21_mksz`m'}, default `d0'"
    }
    _w31_done U21-4 "msize(large): caps and marker ${u21_mkszs} px, larger than the default `d0'"

    // ------------------------------------------------------------
    // U21-5: horizontal: twoway drops to y; the spike runs lo to hi
    // along x at weight, the marker at x = turn.
    // ------------------------------------------------------------
    quietly twoway rpcap lo hi turn weight, horizontal name(u21t, replace)
    local dt "`.u21t.plotregion1.plot1.bar_drop_to.stylename'"
    graph drop u21t
    _w31_expect U21-5 `"("`dt'" == "y")"' "twoway bar_drop_to `dt'"
    _u21_reg "`u21d'" 7 - - rpcap lo hi turn weight, horizontal name(zu217)
    foreach m in s v {
        _w31_expect U21-5 `"("${u21_segx0`m'} ${u21_segx1`m'} ${u21_segy0`m'} ${u21_mkx`m'}" == "lo hi weight turn")"' "`m': spike x0 ${u21_segx0`m'} x1 ${u21_segx1`m'} y0 ${u21_segy0`m'}; marker x ${u21_mkx`m'}"
    }
    _w31_done U21-5 "horizontal: the spike lo..hi along x at weight, the marker at turn, both modes"

    // ------------------------------------------------------------
    // U21-6: the y title is L(y1)/L(y2)/L(y3) when the labels differ
    // and the one label when they are equal (y3xview_g.dimtitle).
    // ------------------------------------------------------------
    label variable lo "Low"
    label variable hi "High"
    label variable turn "Turn"
    quietly twoway rpcap lo hi turn weight, name(u21t, replace)
    local t1 `"`.u21t.yaxis1.title.text[1]'"'
    _u21_reg "`u21d'" 8 - - rpcap lo hi turn weight, name(zu218)
    _w31_expect U21-6 `"("${u21_yts}" == "`t1'" & "${u21_ytv}" == "`t1'")"' "labels differ: twoway `t1', dash ${u21_yts} / ${u21_ytv}"
    label variable lo "Turn"
    label variable hi "Turn"
    quietly twoway rpcap lo hi turn weight, name(u21t, replace)
    local t2 `"`.u21t.yaxis1.title.text[1]'"'
    graph drop u21t
    _u21_reg "`u21d'" 9 - - rpcap lo hi turn weight, name(zu219)
    _w31_expect U21-6 `"("${u21_yts}" == "`t2'" & "${u21_ytv}" == "`t2'")"' "labels equal: twoway `t2', dash ${u21_yts} / ${u21_ytv}"
    _w31_done U21-6 "y title `t1' when the labels differ, `t2' when equal, as twoway writes it"
    label variable lo ""
    label variable hi ""
    label variable turn "Turn Circle (ft.)"

    // ------------------------------------------------------------
    // U21-7: a dropdown move to Foreign keeps the foreign cars' rows in
    // every renderer of the layer, both modes.
    // ------------------------------------------------------------
    quietly count if foreign == 1
    local nk = r(N)
    foreach t in rpcap rpspike {
        _u21_reg "`u21d'" 10 Select Foreign `t' lo hi turn weight, name(zu2110)
        foreach m in s v {
            local ok = ("${u21_rows`m'}" != "none")
            foreach n in ${u21_rows`m'} {
                if "`n'" != "`nk'" local ok 0
            }
            _w31_expect U21-7 "(`ok')" "`t' `m': rows after the move ${u21_rows`m'}, foreign cars `nk'"
        }
    }
    _w31_done U21-7 "after the move to Foreign every renderer of rpcap and rpspike holds the `nk' kept rows, both modes"

    // ------------------------------------------------------------
    // U21-11: a weight on rpcap and rpspike as twoway takes it: the y3
    // markers are sized by [aw=price] (the spec carries the weight, both
    // modes draw a size column on the marker and none on the caps);
    // [aw=price-price], [aw=(price)], [iw=price] and a weight zero on
    // every row are refused with twoway's codes (twoway's drawn graph).
    // ------------------------------------------------------------
    quietly generate double zero = 0
    foreach t in rpcap rpspike {
        foreach w in "aw=price-price" "aw=(price)" "iw=price" "aw=zero" "aw=price" "fw=rep78" {
            // Drawn, not nodraw: a weight zero on every row stops twoway
            // when it draws the markers (rangept_truth.json wzero.*).
            capture twoway `t' lo hi turn weight [`w'], name(u21w, replace)
            local trc = _rc
            capture graph drop _all
            dash clear
            capture dash `t' lo hi turn weight [`w'], name(zu2111)
            local drc = _rc
            _w31_expect U21-11 "(`trc' == `drc')" "`t' [`w']: twoway rc `trc', dash rc `drc'"
        }
    }
    dash clear
    quietly dash rpcap lo hi turn weight [aw=price], name(zu2111)
    _dash_serve_spec, specpath("`u21d'/s11.json") datapath("`u21d'/d11.json")
    python: import __main__ as _u21_m; _u21_m._u21_wsized("`u21d'/s11.json", "`u21d'/d11.json", "`u21d'/a11.py")
    _w31_expect U21-11 `"("${u21_ws}" == "1 0" & "${u21_wv}" == "1 0")"' "marker sized, caps sized: saved ${u21_ws}, served ${u21_wv}"
    foreach p in s d {
        capture erase "`u21d'/`p'11.json"
    }
    capture erase "`u21d'/a11.py"
    drop zero
    _w31_done U21-11 "rpcap and rpspike take, size and refuse a weight as twoway does"

    forvalues k = 1/10 {
        foreach p in s d {
            capture erase "`u21d'/`p'`k'.json"
        }
        capture erase "`u21d'/a`k'.py"
    }
    capture rmdir "`u21d'"
    macro drop u21_*
    capture graph drop _all
    dash clear
    display as text "S21 end " c(current_date) " " c(current_time)
}
* ==== end S21 ====

* ==== S21 B2: sunflower refused ====
local only : env WP31_ONLY
if inlist("`only'", "", "S21") & `: list posof "S21" in w31_run' {
    display as text "S21 start " c(current_date) " " c(current_time)
    local u21d "`w31_work'/s21b2"
    capture mkdir "`u21d'"
    capture graph drop _all
    sysuse auto, clear

    // ------------------------------------------------------------
    // U21-9: twoway draws sunflower (rc 0); dash refuses it by name,
    // r(198), with the manual's advice; twoway takes no shorter name,
    // and neither does dash: sunflow is "not a twoway plot type".
    // ------------------------------------------------------------
    capture twoway sunflower mpg weight, nodraw
    local trc = _rc
    capture graph drop _all
    _w31_expect U21-9 "(`trc' == 0)" "twoway sunflower rc `trc'"
    local lf "`u21d'/n9.log"
    dash clear
    local ls = c(linesize)
    set linesize 255
    quietly log using "`lf'", text replace name(u219)
    capture noisily dash sunflower mpg weight
    local drc = _rc
    quietly log close u219
    set linesize `ls'
    _w31_expect U21-9 "(`drc' == 198)" "dash sunflower rc `drc'"
    cert_log_has "`lf'", needle("dash: 'sunflower' is a twoway plot type dash does not draw: it bins points into density petals.")
    _w31_expect U21-9 "(r(count) == 1)" "the refusal's sentence found `r(count)' times"
    capture twoway sunflow mpg weight, nodraw
    local trc2 = _rc
    local lf2 "`u21d'/n9b.log"
    quietly log using "`lf2'", text replace name(u219b)
    capture noisily dash sunflow mpg weight
    local drc2 = _rc
    quietly log close u219b
    cert_log_has "`lf2'", needle("sunflow is not a twoway plot type")
    _w31_expect U21-9 "(`trc2' == 198 & `drc2' == 198 & r(count) == 1)" "sunflow: twoway rc `trc2', dash rc `drc2', twoway's line `r(count)' times"
    _w31_expect U21-9 `"("${dash_graph_registry}" == "")"' "registry ${dash_graph_registry}"
    _w31_done U21-9 "sunflower: twoway draws it; dash refuses it by name, r(198), with the manual's advice; sunflow is no plot type in either"

    capture erase "`lf'"
    capture erase "`lf2'"
    capture rmdir "`u21d'"
    capture graph drop _all
    dash clear
    display as text "S21 end " c(current_date) " " c(current_time)
}
* ==== end S21 ====

