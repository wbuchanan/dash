    python: import __main__ as _u26_m; _u26_m._u26_svgsame("`u26dir'/plain.svg", "`u26dir'/rev.svg")
    _w31_expect U26-11 `"("${u26_same}" == "1")"' "twoway's key with and without colorkeysreverse the same: ${u26_same}"
    foreach v in p r {
        local o = cond("`v'" == "r", "colorkeysreverse", "")
        dash clear
        quietly dash scatter mpg weight, colorvar(price) `o' name(u2611)
