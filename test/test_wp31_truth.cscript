    local u8d "`w31_work'/s08a"
    capture mkdir "`u8d'"
    sysuse auto, clear
    quietly generate t = _n
    quietly tsset t
    python: _u08_fixture()
    local lf "`u8d'/x.log"
    local u8ls = c(linesize)
    set linesize 200

    // ------------------------------------------------------------
    // U08-1: each of the thirteen shorter spellings dash took (ar ba sp
    // lfi qfi low lpo fp kde dr tsl tsrl msp) is refused as twoway
    // refuses it: r(198) and twoway's line "<word> is not a twoway plot
    // type", registering nothing.
    // ------------------------------------------------------------
    _w31_expect U08-1 "(${u08_xn} == 13)" "the fixture holds ${u08_xn} extras, want 13"
    // A loop header holds no ${...}: its brace ends the block scan.
    local n8x = ${u08_xn}
    forvalues i = 1/`n8x' {
        local cmd "${u08_xc`i'}"
        dash clear
        quietly log using "`lf'", text replace name(u08x)
        capture noisily dash `cmd' name(u081)
        local rc = _rc
        quietly log close u08x
        python: _u08_hasline("`lf'", "${u08_xt`i'}")
        _w31_expect U08-1 "(`rc' == ${u08_xr`i'})" "dash `cmd' rc `rc', twoway ${u08_xr`i'}"
        _w31_expect U08-1 "(${u08_found} == 1)" "dash `cmd' did not log twoway's line [${u08_xt`i'}]"
        _w31_expect U08-1 `"(`"${dash_graph_registry}"' == "")"' "dash `cmd' registered a graph"
    }
    _w31_done U08-1 "the thirteen shorter plot-type spellings are refused, r(198), in twoway's words"

    // ------------------------------------------------------------
    // U08-2: twoway's ten spellings (its eight minimums, mbands and fn)
