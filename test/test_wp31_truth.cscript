def _u46_fmt_cmp(fmt, value, want):
    """global u46_bad empty when dash's writer gives Stata's text."""
    import dash_render as dr
    from sfi import Macro
    got = dr._dash_fmt(float(value), fmt)
    Macro.setGlobal("u46_bad", "" if got == want.strip() else
                    "%s of %s: dash %r, Stata %r" % (fmt, value, got, want))
end

* ==== S46 G7: %d, %tb and xvarformat ====
local only : env WP31_ONLY
if inlist("`only'", "", "S46") & `: list posof "S46" in w31_run' {
    display as text "S46 start " c(current_date) " " c(current_time)
    local u46d "`w31_work'/s46"
    capture mkdir "`u46d'"

    // U46-07: %d is %td (dash's writer gives Stata's display text, and a
    // %d variable is a date at registration); xvarformat(bogus) draws, rc 0,
    // with twoway's line "bogus not found".
    foreach f in "%d" "%dCCYY-NN-DD" "%-dDD/NN/CCYY" {
        local want : display `f' 20000
        python: __import__("__main__")._u46_fmt_cmp("`f'", 20000, "`want'")
        _w31_expect U46-07 `"("${u46_bad}" == "")"' `"${u46_bad}"'
    }
    sysuse auto, clear
    capture twoway scatter mpg weight, xvarformat(bogus) nodraw
    local trc = _rc
    dash clear
    capture noisily dash scatter mpg weight, xvarformat(bogus) name(zu46x)
    local drc = _rc
    _w31_expect U46-07 "(`trc' == 0) & (`drc' == 0)" "xvarformat(bogus): twoway r(`trc'), dash r(`drc')"
    _dash_serve_spec, specpath("`u46d'/g7.json") datapath("`u46d'/g7d.json")
    python: __import__("__main__")._u46_said_render("`u46d'/g7.json", "`u46d'/g7d.json", "bogus not found")
    _w31_expect U46-07 "(${u46_said} == 1)" "dash did not say twoway's bogus not found"
    // %tb: a weekday calendar from 01jan2024, read by Stata at
    // registration and embedded; the axis is labelled as twoway labels it.
    clear
    quietly set obs 30
    quietly generate date = mdy(1, 1, 2024) + _n - 1
    quietly drop if inlist(dow(date), 0, 6)
    quietly bcal create "`u46d'/u46", from(date) replace
    adopath + "`u46d'"
    quietly generate bd = bofd("u46", date)
    format bd %tbu46
    quietly generate y = _n
    quietly twoway scatter y bd
    quietly graph export "`u46d'/g7_tb.svg", replace
    dash clear
    quietly dash scatter y bd, name(zu46tb)
    _dash_serve_spec, specpath("`u46d'/g7tb.json") datapath("`u46d'/g7tbd.json")
    python: __import__("__main__")._u46_tb_ticks("`u46d'/g7_tb.svg", "`u46d'/g7tb.json", "`u46d'/g7tbd.json", "%tbu46")
    _w31_expect U46-07 `"("${u46_bad}" == "")"' `"%tb: ${u46_bad}"'
    adopath - "`u46d'"
    _w31_done U46-07 "%d is written as %td, %tb through its calendar, and xvarformat(bogus) is twoway's note"
    display as text "S46 end " c(current_date) " " c(current_time)
}
* ==== end S46 ====

python:
def _u46_kd_empty(sp, dp):
    """global u46_bad empty when the saved page draws the kdensity curve
    with no point and says nothing about range()."""
    import warnings
    import dash_render as dr
    from sfi import Macro
    with warnings.catch_warnings(record=True) as w:
        warnings.simplefilter("always")
        r = dr.DashRenderer(sp, dp)
        r.render()
    bad = []
    lines = [g for f in r.figures.values() for g in f.renderers
             if type(g.glyph).__name__ == "Line"]
    n = sum(len(g.data_source.data.get(g.glyph.x, [])) for g in lines)
    if n:
        bad.append("dash drew %d points" % n)
    said = [str(m.message) for m in w if "range" in str(m.message)]
    if said:
        bad.append("dash said %s" % said[0][:80])
    Macro.setGlobal("u46_bad", "; ".join(bad))
end

* ==== S46 C10d: kdensity range() over no observation ====
local only : env WP31_ONLY
if inlist("`only'", "", "S46") & `: list posof "S46" in w31_run' {
    display as text "S46 start " c(current_date) " " c(current_time)
    local u46d "`w31_work'/s46"
    capture mkdir "`u46d'"

    // U46-13: kdensity mpg, range(make) and range(<all missing>): twoway
    // draws an empty curve, rc 0, silently (its serset's x and density all
    // missing); dash registers silently and draws the curve empty.
    sysuse auto, clear
    quietly generate u46m = .
    foreach v in make u46m {
        capture graph drop _all
        capture serset drop _all
        capture twoway kdensity mpg, range(`v') nodraw
        local trc = _rc
        quietly serset set 0
        preserve
        quietly serset use, clear
        quietly ds
        local _s1 : word 1 of `r(varlist)'
        quietly count if !missing(`_s1')
        local tn = r(N)
        restore
        dash clear
        capture log close _u46k
        quietly log using "`u46d'/c10d.log", text replace name(_u46k)
        capture noisily dash kdensity mpg, range(`v') name(zu46k)
        local drc = _rc
        quietly log close _u46k
        python: from sfi import Macro as _u46M; _u46M.setGlobal("u46_said", "1" if "range(" in open(r"`u46d'/c10d.log", encoding="utf-8", errors="replace").read().replace("range(`v') name", "") else "0")
        _w31_expect U46-13 "(`trc' == 0) & (`drc' == 0) & (`tn' == 0)" "range(`v'): twoway r(`trc') with `tn' points, dash r(`drc')"
        _w31_expect U46-13 "(${u46_said} == 0)" "range(`v'): dash named range() at registration"
        _dash_serve_spec, specpath("`u46d'/c10d.json") datapath("`u46d'/c10dd.json")
        python: __import__("__main__")._u46_kd_empty("`u46d'/c10d.json", "`u46d'/c10dd.json")
        _w31_expect U46-13 `"("${u46_bad}" == "")"' `"range(`v'): ${u46_bad}"'
    }
    _w31_done U46-13 "kdensity range() over no observation draws twoway's empty curve, silently"
    display as text "S46 end " c(current_date) " " c(current_time)
}
* ==== end S46 ====

python:
def _u47_grammar(path):
    """globals u47_ok1/u47_bad1 (rc-0 probes the fallback draws as twoway
    does) and u47_ok2/u47_bad2 (refused probes the fallback refuses) over
    function_expr_truth.json's fallback_grammar (WP-31 F2)."""
    import json
    import math
    import numpy as np
    import dash_render as dr
    from sfi import Macro
    g = json.load(open(path, encoding="utf-8"))["fallback_grammar"]
    x = np.linspace(-3.0, 3.0, 13)
    bad1, bad2, n1, n2 = [], [], 0, 0
    for text, p in sorted(g.items()):
        if p["rc"] == 0:
            n1 += 1
            try:
                got = np.asarray(dr._stata_fn_eval(dr._stata_fn_parse(text),
                                                   x), dtype=float)
            except ValueError as exc:
                bad1.append("%s refused (%s)" % (text, exc))
                continue
            if got.ndim == 0:
                got = np.full(13, float(got))
            want = np.array([np.nan if v is None else float(v)
                             for v in p["y"]])
            same = (np.array_equal(np.isnan(got), np.isnan(want))
                    and all(math.isclose(a, b, rel_tol=1e-12, abs_tol=1e-12)
                            for a, b in zip(got[~np.isnan(want)],
                                            want[~np.isnan(want)])))
            if not same:
                bad1.append(text)
        else:
            n2 += 1
            try:
                dr._stata_fn_parse(text)
                bad2.append(text)
            except ValueError:
                pass
    Macro.setGlobal("u47_n1", str(n1))
    Macro.setGlobal("u47_n2", str(n2))
    Macro.setGlobal("u47_bad1", "; ".join(bad1)[:300])
    Macro.setGlobal("u47_bad2", "; ".join(bad2)[:300])


def _u47_fallback_modes(sp, dp, app):
    """global u47_bad empty when a function spec stripped of its stored
    points draws, saved and served, the y Stata stored for it."""
    import json
    import os
    import numpy as np
    from bokeh.models import Plot
    from sfi import Macro
    spec = json.load(open(sp, encoding="utf-8"))
    tab = list((spec.pop("function_points", None) or {}).values())
    bad = []
    if not tab or "1" not in tab[0] or "y" not in tab[0]["1"]:
        Macro.setGlobal("u47_bad", "no stored points")
        return
    want = np.array([np.nan if v is None else float(v)
                     for v in tab[0]["1"]["y"]])
    sp2 = os.path.splitext(sp)[0] + "_nopoints.json"
    json.dump(spec, open(sp2, "w", encoding="utf-8"))
    r, _page, doc = __import__("__main__")._u02_docs(sp2, dp, app)
    roots = {"saved": [r._last_layout_root], "served": list(doc.roots)}
    for mode, rs in roots.items():
        ys = []
        for root in rs:
            for m in root.references():
                if isinstance(m, Plot):
                    for g in m.renderers:
                        d = getattr(getattr(g, "data_source", None), "data",
                                    {})
                        if "y_fn" in d:
                            ys.append(np.asarray(list(d["y_fn"]), float))
        if len(ys) != 1 or ys[0].shape != want.shape or not np.allclose(
                ys[0], want, rtol=1e-12, atol=0, equal_nan=True):
            bad.append("%s draws %s" % (mode, [list(y[:3]) for y in ys]))
    Macro.setGlobal("u47_bad", "; ".join(bad)[:300])
end

* ==== S47 F2: function fallback grammar ====
local only : env WP31_ONLY
if inlist("`only'", "", "S47") & `: list posof "S47" in w31_run' {
    display as text "S47 start " c(current_date) " " c(current_time)
    local u47d "`w31_work'/s47"
    capture mkdir "`u47d'"

    // U47-1, U47-2: each fallback_grammar probe of function_expr_truth.json
    // (twoway function y = <text>, range(-3 3) n(13)): the fallback draws
    // twoway's 13 values where twoway draws them (missing on both sides,
    // else within 1e-12) and refuses what twoway refuses.
    python: __import__("__main__")._u47_grammar("fixtures/function_expr_truth.json")
    _w31_expect U47-1 `"("${u47_bad1}" == "") & (${u47_n1} >= 60)"' `"${u47_n1} probes; differ: ${u47_bad1}"'
    _w31_done U47-1 "the fallback evaluates every probe twoway draws as twoway does"
    _w31_expect U47-2 `"("${u47_bad2}" == "") & (${u47_n2} >= 10)"' `"${u47_n2} probes; accepted: ${u47_bad2}"'
    _w31_done U47-2 "the fallback refuses every probe twoway refuses"

    // U47-3: a registered function graph carries Stata's points; the same
    // spec without them is drawn by the fallback, saved and served, to the
    // same 300 values.
    clear
    dash clear
    capture noisily dash function y = cond(x > 1, normal(x), 0), range(-3 3) name(u473)
    _w31_expect U47-3 "(_rc == 0)" "dash function cond() rc `=_rc'"
    _dash_serve_spec, specpath("`u47d'/fn.json") datapath("`u47d'/fnd.json")
    python: __import__("__main__")._u47_fallback_modes("`u47d'/fn.json", "`u47d'/fnd.json", "`u47d'/fn_app.py")
    _w31_expect U47-3 `"("${u47_bad}" == "")"' `"${u47_bad}"'
    _w31_done U47-3 "a function spec without points draws Stata's values in both modes"
    dash clear
    display as text "S47 end " c(current_date) " " c(current_time)
}
* ==== end S47 ====

