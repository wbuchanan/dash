def _u45_pool(page, need):
    """u45_bad: "" when the saved page's axis-2 minor-label pool holds at
    least *need* Labels, else its size (WP-31 D1d)."""
    import json
    import re
    from sfi import Macro
    with open(page, encoding="utf-8") as fh:
        html = fh.read()
    n = len(re.findall(r'"name":"Label","id":"[^"]+","attributes":\{[^{}]*"name":"dash_minor_labels","tags":\["y","2"\]', html))
    Macro.setGlobal("u45_pool", str(n))
    Macro.setGlobal("u45_bad", "" if n >= int(need) else "pool %d < %s" % (n, need))
end

* ==== S45 D1d: The outer axis's minor-label pool covers a move ====
local only : env WP31_ONLY
if inlist("`only'", "", "S45") & `: list posof "S45" in w31_run' {
    display as text "S45 start " c(current_date) " " c(current_time)
    local u45d "`w31_work'/s45d1d"
    capture mkdir "`u45d'"

    // U45-05: over the rows a move to 579.2-1015.5 keeps, twoway draws
    // its ymlabel(##10, axis(2)) labels; the page built over all the rows
    // holds a pool of at least that many for the move.
    clear
    quietly set obs 62
    quietly generate double z = 544.565209100813 + (_n - 1) * (1492.1494388394729 - 544.565209100813) / 59 in 1/60
    quietly replace z = 579.1993581170549 in 61
    quietly replace z = 1015.5177101036923 in 62
    quietly generate double a = 10 + _n / 2
    quietly generate double obs = _n
    preserve
    quietly keep if z >= 579.1993581170549 & z <= 1015.5177101036923
    capture twoway (scatter a obs) (scatter z obs, yaxis(2)), ylabel(#8, axis(2)) ymlabel(##10, axis(2)) name(u45g, replace)
    _w31_expect U45-05 "(_rc == 0)" "twoway rc `=_rc'"
    // The minor set is a rule (S24): delta / between from the major
    // minimum, over the region's scale, the majors left out.
    local u45b = 0`.u45g.yaxis2.minor._between_ticks'
    local u45m0 = `.u45g.yaxis2.major.min'
    local u45dl = `.u45g.yaxis2.major.delta'
    local u45lo = `.u45g.yaxis2.plotregion.yscale.curmin'
    local u45hi = `.u45g.yaxis2.plotregion.yscale.curmax'
    local u45need 0
    if `u45b' > 0 & `u45dl' > 0 {
        local u45d1 = `u45dl' / `u45b'
        local u45v = `u45m0' - `u45d1' * floor((`u45m0' - `u45lo') / `u45d1' + 1e-9)
        while `u45v' <= `u45hi' + 1e-9 * `u45dl' {
            if abs((`u45v' - `u45m0') / `u45dl' - round((`u45v' - `u45m0') / `u45dl')) > 1e-6 local ++u45need
            local u45v = `u45v' + `u45d1'
        }
    }
    restore
    capture noisily dash (scatter a obs) (scatter z obs, yaxis(2)), ylabel(#8, axis(2)) ymlabel(##10, axis(2)) saving("`u45d'/p.html", replace)
    _w31_expect U45-05 "(_rc == 0)" "dash rc `=_rc'"
    python: import __main__ as _u45_m; _u45_m._u45_pool(r"`u45d'/p.html", "`u45need'")
    _w31_expect U45-05 "(`u45need' > 0)" "twoway drew no minor label"
    _w31_expect U45-05 `"("${u45_bad}" == "")"' `"${u45_bad}"'
    _w31_done U45-05 "the axis-2 pool (${u45_pool}) covers twoway's `u45need' kept-row labels"
    capture graph drop u45g
    macro drop u45_*
    display as text "S45 end " c(current_date) " " c(current_time)
}
* ==== end S45 ====

// S46 helpers (WP-31 C16 ...).  _u46_move: the saved page's recast
// histogram or kdensity after one filter move -- the page rendered, the
// widget set and its own callback run under node (test/js_runner.py) --
// its points (the columns of role x and y) written to a JSON file; global
// u46_frozen holds the number of frozen layers the page tagged and
// u46_tagged 1 when the recast layer carries its recount config.
python:
def _u46_move(sp, dp, kind, value, out):
    import json
    import os
    import sys
    import warnings
    if os.getcwd() not in sys.path:
        sys.path.insert(0, os.getcwd())
    import dash_render as dr
    import js_runner
    from sfi import Macro
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
    w = [m for m in r.filter_widgets if type(m).__name__ == kind][0]
    if kind == "Select":
        w.value = [v for v, lab in w.options if lab == value][0]
    elif kind == "RangeSlider":
        w.value = tuple(float(v) for v in value.split())
    else:
        w.value = float(value)
    cb = r.filter_callbacks[r.filter_widgets.index(w)]
    js_runner.JsSession(r.filter_callbacks).run(cb)
    rc = [x for f in r.figures.values() for x in f.renderers
          if "recast_cols" in (getattr(x, "_dash_agg_config", None) or {})]
    Macro.setGlobal("u46_tagged", "1" if rc else "0")
    Macro.setGlobal("u46_frozen", str(sum(
        len(v) for v in r.frozen_layer_registry.values())))
    xs, ys = [], []
    if rc:
        cols = rc[0]._dash_agg_config["recast_cols"]
        d = rc[0].data_source.data
        xk = [k for k, v in cols.items() if v == "x"][0]
        yk = [k for k, v in cols.items() if v == "y"][0]
        xs = [float(v) for v in d[xk]]
        ys = [float(v) for v in d[yk]]
    with open(out, "w", encoding="utf-8") as fh:
        json.dump({"x": xs, "y": ys}, fh)
end

* ==== S46 C16: Recast layers recounted ====
local only : env WP31_ONLY
if inlist("`only'", "", "S46") & `: list posof "S46" in w31_run' {
    display as text "S46 start " c(current_date) " " c(current_time)
    local u46d "`w31_work'/s46"
    capture mkdir "`u46d'"
    capture graph drop _all

    // U46-05: after a move the saved page's recast histogram (bins 10(5)45,
    // the build's and twoway's on the kept rows alike) and recast kdensity
    // over range(10 45) are twoway's on the kept rows, and the kdensity,
    // whose grid is the user's, carries no stale cue.
    local k 0
    foreach c in "histogram mpg, start(10) width(5) recast(line)|histogram mpg if foreign == 1, start(10) width(5) recast(line)|1" "kdensity mpg, range(10 45) recast(line)|kdensity mpg if foreign == 1, range(10 45) recast(line)|0" {
        local ++k
        mata: u46_t = ustrsplit(st_local("c"), "[|]"); st_local("cmd", u46_t[1]); st_local("tw", u46_t[2]); st_local("nfr", u46_t[3])
        sysuse auto, clear
        dash clear
        capture noisily dash `cmd' name(zu46c`k')
        _w31_expect U46-05 "(_rc == 0)" "dash `cmd' rc `=_rc'"
        _dash_serve_spec, specpath("`u46d'/c`k'.json") datapath("`u46d'/cd`k'.json") filter(foreign, type(dropdown))
        python: __import__("__main__")._u46_move("`u46d'/c`k'.json", "`u46d'/cd`k'.json", "Select", "Foreign", "`u46d'/cg`k'.json")
        _w31_expect U46-05 "(${u46_tagged} == 1)" "`cmd': the recast layer carries no recount config"
        _w31_expect U46-05 "(${u46_frozen} == `nfr')" "`cmd': ${u46_frozen} frozen layers, expected `nfr' (the un-recast layer's cue)"
        _u10_ss "`u46d'/ct`k'.json" "`u46d'/ct`k'.gph" `tw'
        python: __import__("__main__")._u10_close("`u46d'/ct`k'.json", "`u46d'/cg`k'.json", "", 3e-7, 0)
        _w31_expect U46-05 "(${u10_ok} == 1)" "dash `cmd' moved to Foreign: ${u10_msg}"
    }
    _w31_done U46-05 "a recast histogram and kdensity are recounted by the saved page after a move, as twoway draws the kept rows"
    display as text "S46 end " c(current_date) " " c(current_time)
}
* ==== end S46 ====

python:
def _u46_said_render(sp, dp, text):
    """global u46_said 1 when rendering the spec says *text*."""
    import warnings
    import dash_render as dr
    from sfi import Macro
    with warnings.catch_warnings(record=True) as w:
        warnings.simplefilter("always")
        r = dr.DashRenderer(sp, dp)
        r.render()
    Macro.setGlobal("u46_said", "1" if any(str(m.message) == text
                                           for m in w) else "0")
def _u46_tb_ticks(svg, sp, dp, fmt):
    """global u46_bad empty when the saved page's %tb tick formatter writes
    twoway's SVG tick labels at twoway's ticks (0(5)20), and the spec
    carries the calendar dofb() gives."""
    import json
    import os
    import re
    import sys
    import warnings
    if os.getcwd() not in sys.path:
        sys.path.insert(0, os.getcwd())
    import dash_render as dr
    import js_runner
    from sfi import Macro
    t = open(svg, encoding="utf-8").read()
    labs = [m for m in re.findall(r">([0-9]{2}[a-z]{3}[0-9]{4})<", t)]
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
    bad = []
    spec = json.load(open(sp, encoding="utf-8"))
    tab = (spec.get("build_options", {}).get("bcal") or {}).get("u46")
    if not tab or tab.get("min") != 0 or len(tab.get("td", [])) != 22:
        bad.append("spec calendar %r" % (tab,))
    fm = [m for m in r._last_layout_root.references()
          if type(m).__name__ == "CustomJSTickFormatter"
          and m.args.get("fmt") == fmt]
    if not fm:
        bad.append("no %s tick formatter" % fmt)
    else:
        got = js_runner.run_js(
            dr._DASH_FMT_JS + "\nvar bcal = " + json.dumps(fm[0].args.get("bcal"))
            + ";\nprocess.stdout.write(JSON.stringify([0, 5, 10, 15, 20].map("
              "function (v) { return dash_fmt_text(v, %s, '', 'period', bcal); })));"
            % json.dumps(fmt))
        if got != labs:
            bad.append("dash ticks %s, twoway %s" % (got, labs))
    Macro.setGlobal("u46_bad", "; ".join(bad))


def _u46_lpoly_cmp(kernel, bw, n, tol):
    """dash's lpoly smooth on the data in memory (mpg on weight) at
    twoway's grid xg against twoway's yg: global u46_bad empty when the
    finite sets agree and the values within tol."""
    import numpy as np
    import dash_render as dr
    from sfi import Data, Macro
    def col(v):
        return np.asarray([np.nan if a is None or a >= 8.98e307 else a
                           for a in Data.get(var=v)], dtype=float)
    x, y = col("weight"), col("mpg")
    keep = np.isfinite(x) & np.isfinite(y)
    xg, yg = col("xg")[:int(n)], col("yg")[:int(n)]
    _, yf = dr.GlyphMapper._compute_lpoly_fit(
        x[keep], y[keep], bwidth=(float(bw) if bw else None), degree=0,
        kernel=kernel, x_grid=xg)
    bad = []
    if list(np.isfinite(yf)) != list(np.isfinite(yg)):
        bad.append("%s bw %s: finite %d, twoway %d" % (
            kernel, bw, int(np.isfinite(yf).sum()), int(np.isfinite(yg).sum())))
    else:
        ok = np.isfinite(yg)
        if ok.any() and not np.allclose(yf[ok], yg[ok], rtol=float(tol)):
            bad.append("%s bw %s: values differ" % (kernel, bw))
    Macro.setGlobal("u46_bad", "; ".join(bad))
end

* ==== S46 C11: lpoly edges ====
local only : env WP31_ONLY
if inlist("`only'", "", "S46") & `: list posof "S46" in w31_run' {
    display as text "S46 start " c(current_date) " " c(current_time)

    // U46-01: the fixture is stamped.
    capture confirm file "fixtures/estimator_edges_truth.json"
    _w31_expect U46-01 "(_rc == 0)" "fixtures/estimator_edges_truth.json missing"
    _w31_done U46-01 "estimator_edges_truth.json is present"

    // U46-02: dash's lpoly finite grid points are twoway's, live, on the
    // four threshold probes and bwidth(50).
    foreach c in "gaussian 1" "gaussian 0.5" "gaussian 2" "gaussian 50" "biweight 1" {
        sysuse auto, clear
        local kn : word 1 of `c'
        local bw : word 2 of `c'
        quietly lpoly mpg weight, kernel(`kn') bwidth(`bw') n(50) generate(xg yg) nograph
        python: __import__("__main__")._u46_lpoly_cmp("`kn'", "`bw'", 50, 1e-6)
        _w31_expect U46-02 `"("${u46_bad}" == "")"' `"${u46_bad}"'
    }
    _w31_done U46-02 "lpoly's finite grid points and values are twoway's at the 1e-14 weight threshold"

    // U46-03: the parity frame's five domestic rows: twoway's grid is
    // all missing, and so is dash's.
    clear
    quietly set obs 5
    quietly generate mpg = real(word("22 25 21 14 16", _n))
    quietly generate weight = real(word("2930 2200 3000 4080 3600", _n))
    quietly lpoly mpg weight, generate(xg yg) nograph
    python: __import__("__main__")._u46_lpoly_cmp("epanechnikov", "", 5, 1e-6)
    _w31_expect U46-03 `"("${u46_bad}" == "")"' `"${u46_bad}"'
    _w31_done U46-03 "lpoly on five rows draws what twoway draws (nothing)"

    // U46-08: D6-D8, twoway's return codes beside dash's, same session.
    sysuse auto, clear
    foreach c in "lpolyci mpg weight if _n == 1, pwidth(0)" "lpoly mpg weight if _n == 1, bwidth(abc)" "lpoly mpg weight if _n <= 2" "lpoly mpg weight, bwidth(abc)" "lpoly mpg weight, bwidth(-1)" "lpoly mpg weight, degree(-1)" "lpoly mpg weight, n(0)" "lpoly mpg weight, n(abc)" "lpoly mpg weight, kernel(x)" "lpolyci mpg weight, pwidth(+800)" "lpolyci mpg weight, pwidth(0)" "lpoly mpg weight, bwidth(+800)" {
        capture twoway (`c'), nodraw
        local trc = _rc
        dash clear
        capture dash (`c'), name(zu46l)
        local drc = _rc
        _w31_expect U46-08 "(`trc' == `drc')" "`c': twoway r(`trc'), dash r(`drc')"
    }
    _w31_done U46-08 "lpoly's sample count, option refusals and pwidth(+800) return twoway's codes"

    // U46-14 (DECISIONS D35): degree(8), (12) and (1000) are drawn as
    // twoway draws them, rc 0, with one note that the result can differ
    // from Stata's, and the build stays bounded; degree(abc) and
    // degree(1.5) are twoway's "option degree() not allowed", r(198).
    local u46d "`w31_work'/s46"
    capture mkdir "`u46d'"
    sysuse auto, clear
    foreach d in 8 12 1000 {
        capture twoway lpoly mpg weight, degree(`d') nodraw
        local trc = _rc
        dash clear
        capture dash lpoly mpg weight, degree(`d') name(zu46d)
        local drc = _rc
        _w31_expect U46-14 "(`trc' == 0) & (`drc' == 0)" "degree(`d'): twoway r(`trc'), dash r(`drc')"
        _dash_serve_spec, specpath("`u46d'/deg.json") datapath("`u46d'/degd.json")
        local t0 = clock(c(current_time), "hms")
        python: __import__("__main__")._u46_said_render("`u46d'/deg.json", "`u46d'/degd.json", "dash: lpoly degree(`d') is drawn`=cond(`d' > 30, " at degree 30", "")'; above degree 7 the result can differ from Stata's.")
        _w31_expect U46-14 "(${u46_said} == 1)" "degree(`d'): the note was not given"
        local el = clock(c(current_time), "hms") - `t0'
        _w31_expect U46-14 "(`el' < 60000)" "degree(`d'): the build took `el' ms"
    }
    foreach d in abc 1.5 {
        capture twoway lpoly mpg weight, degree(`d') nodraw
        local trc = _rc
        dash clear
        capture dash lpoly mpg weight, degree(`d') name(zu46d)
        local drc = _rc
        _w31_expect U46-14 "(`trc' == 198) & (`drc' == 198)" "degree(`d'): twoway r(`trc'), dash r(`drc')"
    }
    _w31_done U46-14 "lpoly degree(8) and above are drawn with a note, as twoway takes them"
    display as text "S46 end " c(current_date) " " c(current_time)
}
* ==== end S46 ====

python:
def _u46_fn_panels(sp, layer, out):
    """The function layer's points in dash's spec, per panel, to a JSON
    file of {"<i>": [y..]} (one key "flat" for the flat form)."""
    import json
    spec = json.load(open(sp, encoding="utf-8"))
    tab = list((spec.get("function_points") or {}).values())[0]
    pts = tab[str(layer)]
    if "panels" in pts:
        res = {k: v["y"] for k, v in pts["panels"].items()}
    else:
        res = {"flat": pts["y"]}
    json.dump(res, open(out, "w", encoding="utf-8"))


def _u46_fn_close(dash_json, tw_json):
    """global u46_bad empty when dash's per-panel y equal twoway's
    function sersets (float), in order."""
    import json
    import numpy as np
    from sfi import Macro
    d = json.load(open(dash_json, encoding="utf-8"))
    t = json.load(open(tw_json, encoding="utf-8"))
    bad = []
    if "flat" in d:
        bad.append("dash wrote one curve for %d panels" % len(t))
    else:
        for i, ty in enumerate(t):
            dy = d.get(str(i))
            if dy is None or len(dy) != len(ty) or not np.allclose(
                    np.asarray(dy, float), np.asarray(ty, float), rtol=1e-6):
                bad.append("panel %d differs" % i)
    Macro.setGlobal("u46_bad", "; ".join(bad))


def _u46_take_y(out, append):
    import json
    import os
    from sfi import Data
    ys = [float(v) for v in Data.get(var=0)]
    prev = json.load(open(out)) if append and os.path.exists(out) else []
    prev.append(ys)
    json.dump(prev, open(out, "w"))
end

* ==== S46 C12: function per panel ====
local only : env WP31_ONLY
if inlist("`only'", "", "S46") & `: list posof "S46" in w31_run' {
    display as text "S46 start " c(current_date) " " c(current_time)
    local u46d "`w31_work'/s46"
    capture mkdir "`u46d'"

    // U46-04: function y = runiform() under by(foreign) is evaluated once
    // per panel, in panel order, by twoway's generator: dash's points per
    // panel equal twoway's sersets from the same seed; the malformed
    // y-forms give twoway's return codes.
    sysuse auto, clear
    capture graph drop _all
    capture serset drop _all
    set seed 4646
    quietly twoway function y = runiform(), n(5) by(foreign) nodraw
    capture erase "`u46d'/fn_tw.json"
    forvalues s = 0/1 {
        quietly serset set `s'
        preserve
        quietly serset use, clear
        python: __import__("__main__")._u46_take_y("`u46d'/fn_tw.json", 1)
        restore
    }
    capture graph drop _all
    sysuse auto, clear
    set seed 4646
    dash clear
    capture noisily dash function y = runiform(), n(5) by(foreign) name(zu46f)
    _w31_expect U46-04 "(_rc == 0)" "dash function under by() rc `=_rc'"
    _dash_serve_spec, specpath("`u46d'/fn.json") datapath("`u46d'/fnd.json")
    python: __import__("__main__")._u46_fn_panels("`u46d'/fn.json", 1, "`u46d'/fn_dash.json")
    python: __import__("__main__")._u46_fn_close("`u46d'/fn_dash.json", "`u46d'/fn_tw.json")
    _w31_expect U46-04 `"("${u46_bad}" == "")"' `"${u46_bad}"'
    foreach t in "function 2x" "function y=" "function =x" "function y = " {
        capture twoway `t', nodraw
        local trc = _rc
        dash clear
        capture dash `t', name(zu46m)
        local drc = _rc
        _w31_expect U46-04 "(`trc' == `drc')" "`t': twoway r(`trc'), dash r(`drc')"
    }
    _w31_done U46-04 "function under by() is evaluated per panel as twoway evaluates it; malformed forms give twoway's codes"
    display as text "S46 end " c(current_date) " " c(current_time)
}
* ==== end S46 ====

python:
def _u46_svg_ratio(svg):
    """(cx1 - cx0) / (cx2 - cx0) of the three markers in twoway's SVG."""
    import re
    from sfi import Macro
    t = open(svg, encoding="utf-8").read()
    cx = []
    for m in re.finditer(r'<circle cx="([0-9.]+)"', t):
        v = float(m.group(1))
        if v not in cx:
            cx.append(v)
    cx.sort()
    Macro.setGlobal("u46_tw", "%.4f" % ((cx[1] - cx[0]) / (cx[2] - cx[0])))


def _u46_saved_x(sp, dp, kind):
    """The saved page's three marker x (axis ms), as the ratio above."""
    import warnings
    import numpy as np
    import dash_render as dr
    from sfi import Macro
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
    xs = []
    for f in r.figures.values():
        for g in f.renderers:
            if type(g.glyph).__name__ == "Scatter":
                xs = sorted(float(v) for v in dr._dash_float_values(
                    g.data_source.data[g.glyph.x], coerce=True))
    Macro.setGlobal("u46_dash", "%.4f" % ((xs[1] - xs[0]) / (xs[2] - xs[0])))


def _u46_rarea(svg, sp, dp):
    """twoway's rarea polygon (upper path) beside the saved page's VArea:
    global u46_bad empty when dash's upper bound at every x lies on
    twoway's upper edge."""
    import re
    import warnings
    import numpy as np
    import dash_render as dr
    from sfi import Macro
    t = open(svg, encoding="utf-8").read()
    paths = re.findall(r'd="(M[^"]*Z)"', t)
    pts = [tuple(map(float, p.split())) for p in
           re.findall(r"[ML]([0-9.]+ [0-9.]+)", paths[0])]
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
    va = [g for f in r.figures.values() for g in f.renderers
          if type(g.glyph).__name__ == "VArea"][0]
    d = va.data_source.data
    x = np.asarray(d[va.glyph.x], float)
    hi = np.asarray(d[va.glyph.y2], float)
    bad = []
    # twoway: 6 lower vertices (plus the repeated first), then the upper
    # path through 5 of them; dash: 6 rows, row 3's upper bound on the
    # straight line from row 2's to row 4's.
    if len(pts) != 13:
        bad.append("twoway's polygon has %d vertices" % len(pts))
    if list(x) != [1, 2, 3, 4, 5, 6]:
        bad.append("dash rows at x %s" % list(x))
    elif abs(hi[2] - 13.0) > 1e-12:
        bad.append("dash upper bound at x=3 is %g" % hi[2])
    Macro.setGlobal("u46_bad", "; ".join(bad))
end

* ==== S46 G6: Fractional dates and rarea bounds ====
local only : env WP31_ONLY
if inlist("`only'", "", "S46") & `: list posof "S46" in w31_run' {
    display as text "S46 start " c(current_date) " " c(current_time)
    local u46d "`w31_work'/s46"
    capture mkdir "`u46d'"

    // U46-06: %tm 745.5 and %td 20000.5 drawn at their fraction between
    // their neighbours, as twoway's SVG places them; rarea with hi missing
    // on row 3 of 6 keeps the row's lower bound, its upper edge straight
    // from row 2 to row 4, as twoway's polygon runs.
    foreach c in "tm 745" "td 20000" {
        local kd : word 1 of `c'
        local v0 : word 2 of `c'
        clear
        quietly set obs 3
        quietly generate m = `v0' + (_n - 1) * 0.5
        format m %`kd'
        quietly generate y = _n
        quietly twoway scatter y m
        quietly graph export "`u46d'/g6_`kd'.svg", replace
        python: __import__("__main__")._u46_svg_ratio("`u46d'/g6_`kd'.svg")
        dash clear
        quietly dash scatter y m, name(zu46g`kd')
        _dash_serve_spec, specpath("`u46d'/g6_`kd'.json") datapath("`u46d'/g6d_`kd'.json")
        python: __import__("__main__")._u46_saved_x("`u46d'/g6_`kd'.json", "`u46d'/g6d_`kd'.json", "`kd'")
        // The SVG's coordinates are written to 0.01: within 0.002.
        _w31_expect U46-06 "(abs(${u46_tw} - ${u46_dash}) < 0.002)" "%`kd': twoway places the half at ${u46_tw}, dash at ${u46_dash}"
    }
    clear
    quietly set obs 6
    quietly generate x = _n
    quietly generate lo = _n
    quietly generate hi = _n + 10
    quietly replace hi = . in 3
    quietly twoway rarea lo hi x, sort
    quietly graph export "`u46d'/g6_ra.svg", replace
    dash clear
    quietly dash rarea lo hi x, sort name(zu46ra)
    _dash_serve_spec, specpath("`u46d'/g6_ra.json") datapath("`u46d'/g6d_ra.json")
    python: __import__("__main__")._u46_rarea("`u46d'/g6_ra.svg", "`u46d'/g6_ra.json", "`u46d'/g6d_ra.json")
    _w31_expect U46-06 `"("${u46_bad}" == "")"' `"${u46_bad}"'
    _w31_done U46-06 "fractional dates and rarea's one-bound rows are drawn where twoway draws them"
    display as text "S46 end " c(current_date) " " c(current_time)
}
* ==== end S46 ====

