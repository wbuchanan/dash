def _u50_cards(sp, dp):
    """global u50_<name>: each KPI card's value text on the saved page the
    spec dash wrote builds."""
    import re
    import warnings
    import dash_render as dr
    from sfi import Macro
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
    for name, div in r.kpi_divs.items():
        m = re.search(r'id="kpi_val_[^"]*"[^>]*>([^<]*)<', div.text or "")
        Macro.setGlobal("u50_" + name, m.group(1).strip() if m else "")
end

* ==== S50 H2k: KPI weights ====
local only : env WP31_ONLY
if inlist("`only'", "", "S50") & `: list posof "S50" in w31_run' {
    display as text "S50 start " c(current_date) " " c(current_time)
    local u50d "`w31_work'/s50"
    capture mkdir "`u50d'"
    sysuse auto, clear

    // U50-1: a weighted KPI writes its class and variable into the spec.
    dash clear
    quietly dash scatter mpg price, name(zu50)
    foreach s in mean sd p75 kurtosis {
        quietly dash kpi `s'(mpg) [aw=weight], title("`s'") name(a_`s') fmt(%12.6f)
    }
    foreach s in mean var {
        quietly dash kpi `s'(mpg) [fw=rep78], title("fw `s'") name(f_`s') fmt(%12.6f)
        quietly dash kpi `s'(mpg) [iw=weight], title("iw `s'") name(i_`s') fmt(%12.6f)
    }
    quietly dash kpi semean(mpg), title("se") name(u_semean) fmt(%12.6f)
    quietly dash kpi semean(mpg) [aw=weight], title("se aw") name(a_semean) fmt(%12.6f)
    quietly dash kpi range(mpg), title("range") name(u_range) fmt(%12.6f)
    quietly dash kpi range(mpg) [aw=wei], title("range aw") name(a_range) fmt(%12.6f)
    capture noisily _dash_serve_spec, specpath("`u50d'/s1.json") datapath("`u50d'/d1.json")
    local rc1 = _rc
    _w31_expect U50-1 "(`rc1' == 0)" "_dash_serve_spec: r(`rc1')"
    if `rc1' == 0 {
        cert_file_has "`u50d'/s1.json", needle(`""name":"a_mean","stat":"mean","var":"mpg""')
        _w31_expect U50-1 "r(found) == 1" "the spec holds no KPI a_mean"
        cert_file_has "`u50d'/s1.json", needle(`""update":"filter","weight":"aweight","wexp":"weight","if_expr""')
        _w31_expect U50-1 "r(found) == 1" "the spec holds no aweight by weight"
        cert_file_has "`u50d'/s1.json", needle(`""weight":"fweight","wexp":"rep78""')
        _w31_expect U50-1 "r(found) == 1" "the spec holds no fweight by rep78"
        // An abbreviated weight is written out: [aw=wei] is weight.
        cert_file_has "`u50d'/s1.json", needle(`""name":"a_range","stat":"range","var":"mpg""')
        _w31_expect U50-1 "r(found) == 1" "the spec holds no KPI a_range"
        cert_file_has "`u50d'/d1.json", needle(`""rep78""')
        _w31_expect U50-1 "r(found) >= 1" "the data holds no rep78 column"
        python: __import__("__main__")._u50_cards("`u50d'/s1.json", "`u50d'/d1.json")
    }
    _w31_done U50-1 "dash kpi mean(mpg) [aw=weight] writes weight aweight, wexp weight; the data carries the weight"

    // U50-2..U50-5: each aweighted card is summarize [aw=weight], detail,
    // measured here, as the card shows it and as dash kpi stored it.
    quietly summarize mpg [aw=weight], detail
    local u50_mean = r(mean)
    local u50_sd = r(sd)
    local u50_p75 = r(p75)
    local u50_kurtosis = r(kurtosis)
    local k 2
    foreach s in mean sd p75 kurtosis {
        local want = strtrim(string(`u50_`s'', "%12.6f"))
        _w31_expect U50-`k' `"("${u50_a_`s'}" == "`want'")"' `"`s': the card shows ${u50_a_`s'}, summarize gives `want'"'
        _w31_expect U50-`k' "(reldif(${dash_kpi_a_`s'__val}, `u50_`s'') < 1e-12)" `"`s': dash kpi stored ${dash_kpi_a_`s'__val}, summarize gives `u50_`s''"'
        _w31_done U50-`k' "`s'(mpg) [aw=weight] is summarize's `want'"
        local ++k
    }

    // U50-6: fweight and iweight cards, mean and Var.
    foreach c in "f fw rep78" "i iw weight" {
        gettoken p c : c
        gettoken cl wv : c
        local wv = strtrim("`wv'")
        quietly summarize mpg [`cl'=`wv']
        local u50_mean = r(mean)
        local u50_var = r(Var)
        foreach s in mean var {
            local want = strtrim(string(`u50_`s'', "%12.6f"))
            _w31_expect U50-6 `"("${u50_`p'_`s'}" == "`want'")"' `"`s' [`cl'=`wv']: the card shows ${u50_`p'_`s'}, summarize gives `want'"'
        }
    }
    _w31_done U50-6 "mean and Var of mpg under [fw=rep78] and [iw=weight] are summarize's"

    // U50-7: a pweight is refused as summarize refuses it, and an iweight
    // with a statistic summarize, detail would need.
    local k 0
    foreach c in "p50(mpg) [pw=weight]|pweights not allowed" "p50(mpg) [iw=weight]|iweights not allowed" "kurtosis(mpg) [iw=weight]|iweights not allowed" {
        local ++k
        gettoken cmd msg : c, parse("|")
        local msg = substr(`"`msg'"', 2, .)
        local lf "`u50d'/r7_`k'.log"
        capture log close _u50l
        quietly log using "`lf'", text replace name(_u50l)
        capture noisily dash kpi `cmd', title("x") name(r7_`k')
        local rc = _rc
        quietly log close _u50l
        cert_log_has "`lf'", needle(`"`msg'"')
        _w31_expect U50-7 "(`rc' == 101) & (r(count) == 1)" `"`cmd': r(`rc'), "`msg'" `r(count)' times"'
    }
    capture summarize mpg [pw=weight]
    _w31_expect U50-7 "(_rc == 101)" "summarize [pw=weight] is r(`=_rc')"
    _w31_done U50-7 "[pw=] and an iweight with a detail statistic are refused r(101) in summarize's words"

    // U50-8: a weight expression is refused; dash evaluates none.
    local lf "`u50d'/r8.log"
    capture log close _u50l
    quietly log using "`lf'", text replace name(_u50l)
    capture noisily dash kpi mean(mpg) [aw=weight/2], title("x") name(r8)
    local rc = _rc
    quietly log close _u50l
    cert_log_has "`lf'", needle("dash kpi: the weight must be a variable name; dash does not evaluate 'weight/2'.")
    _w31_expect U50-8 "(`rc' == 198) & (r(count) == 1)" "[aw=weight/2]: r(`rc'), the sentence `r(count)' times"
    _w31_done U50-8 "[aw=weight/2] is refused r(198)"

    // U50-9: semean is r(sd)/sqrt(r(N)), tabstat's se(mean).
    quietly summarize mpg
    local want = strtrim(string(r(sd) / sqrt(r(N)), "%12.6f"))
    _w31_expect U50-9 `"("${u50_u_semean}" == "`want'")"' "semean: the card shows ${u50_u_semean}, r(sd)/sqrt(r(N)) is `want'"
    quietly tabstat mpg [aw=weight], statistics(semean) save
    matrix u50T = r(StatTotal)
    local want = strtrim(string(u50T[1, 1], "%12.6f"))
    _w31_expect U50-9 `"("${u50_a_semean}" == "`want'")"' "semean [aw=weight]: the card shows ${u50_a_semean}, tabstat gives `want'"
    _w31_done U50-9 "semean(mpg), unweighted and [aw=weight], is tabstat's se(mean)"

    // U50-10: range is r(max) - r(min).
    quietly summarize mpg
    local want = strtrim(string(r(max) - r(min), "%12.6f"))
    _w31_expect U50-10 `"("${u50_u_range}" == "`want'") & ("${u50_a_range}" == "`want'")"' "range: the cards show ${u50_u_range} and ${u50_a_range}, summarize gives `want'"
    _w31_done U50-10 "range(mpg) is r(max) - r(min)"

    // U50-11: a string weight is refused r(109), Stata's words.
    local lf "`u50d'/r11.log"
    capture log close _u50l
    quietly log using "`lf'", text replace name(_u50l)
    capture noisily dash kpi mean(mpg) [aw=make], title("x") name(r11)
    local rc = _rc
    quietly log close _u50l
    cert_log_has "`lf'", needle("type mismatch")
    _w31_expect U50-11 "(`rc' == 109) & (r(count) == 1)" "[aw=make]: r(`rc'), type mismatch `r(count)' times"
    _w31_done U50-11 "[aw=make] is refused r(109) type mismatch"
    dash clear
    display as text "S50 end " c(current_date) " " c(current_time)
}
* ==== end S50 ====

* ==== S51 H2l: link groups and brush ====
local only : env WP31_ONLY
if inlist("`only'", "", "S51") & `: list posof "S51" in w31_run' {
    display as text "S51 start " c(current_date) " " c(current_time)
    local u51d "`w31_work'/s51"
    capture mkdir "`u51d'"
    // link() groups and brush() are dash's own (twoway has neither): no
    // twoway truth; the spec keys and the refusals in dash's words.
    capture program drop _u51_bo
    program define _u51_bo
        version 19
        args spec key
        python: import json as _u51j; from sfi import Macro as _u51M; _u51M.setGlobal("u51_v", str(_u51j.load(open(r"`spec'", encoding="utf-8"))["build_options"].get("`key'", "<none>")))
    end
    sysuse auto, clear
    dash clear
    foreach g in g1 g2 g3 g4 {
        quietly dash scatter mpg weight, name(`g')
    }

    // U51-1: link(g1 g2) link(g3 g4) writes one group a copy, joined
    // with " || "; dash build draws it.
    capture noisily _dash_serve_spec, specpath("`u51d'/s1.json") datapath("`u51d'/d1.json") link(g1 g2) link(g3 g4)
    local rc1 = _rc
    _w31_expect U51-1 "(`rc1' == 0)" "two link() copies: r(`rc1')"
    if `rc1' == 0 {
        _u51_bo "`u51d'/s1.json" link
        _w31_expect U51-1 `"("${u51_v}" == "g1 g2 || g3 g4")"' `"link key "${u51_v}""'
    }
    capture noisily dash build, saving("`u51d'/b1.html") replace nobrowser link(g1 g2) link(g3 g4)
    local rc1b = _rc
    capture confirm file "`u51d'/b1.html"
    _w31_expect U51-1 "(`rc1b' == 0) & (_rc == 0)" "dash build with two link() copies: r(`rc1b')"
    _w31_done U51-1 `"link(g1 g2) link(g3 g4) writes "link":"g1 g2 || g3 g4""'

    // U51-2, U51-3, U51-5: the refusals, one sentence each, r(198), on
    // dash build.
    local k 2
    foreach o in "link(g1 g2) link(g2 g3)" "link(_all) link(g1 g2)" "brush(bogus)" {
        if `k' == 4 local k 5
        local lf "`u51d'/r`k'.log"
        capture log close _u51l
        quietly log using "`lf'", text replace name(_u51l)
        capture noisily dash build, saving("`u51d'/r`k'.html") replace nobrowser `o'
        local rc = _rc
        quietly log close _u51l
        if `k' == 2 local msg "dash build: link() name 'g2' is in more than one group."
        if `k' == 3 local msg "dash build: link(_all) links every graph; give it alone."
        if `k' == 5 local msg "dash build: brush() takes highlight or filter"
        cert_log_has "`lf'", needle(`"`msg'"')
        _w31_expect U51-`k' "(`rc' == 198) & (r(count) == 1)" `"`o': r(`rc'), the log says the sentence `r(count)' times"'
        _w31_done U51-`k' `"`o' is refused r(198): `msg'"'
        local ++k
    }

    // U51-4: brush(filter) writes "brush":"filter" (any case).
    capture noisily _dash_serve_spec, specpath("`u51d'/s4.json") datapath("`u51d'/d4.json") link(g1 g2) brush(FILTER)
    local rc4 = _rc
    _w31_expect U51-4 "(`rc4' == 0)" "brush(FILTER): r(`rc4')"
    if `rc4' == 0 {
        _u51_bo "`u51d'/s4.json" brush
        _w31_expect U51-4 `"("${u51_v}" == "filter")"' `"brush key "${u51_v}""'
    }
    _w31_done U51-4 `"brush(filter) writes "brush":"filter""'

    // U51-6: one link() writes no separator and no brush key (the spec
    // every earlier dashboard wrote).
    capture noisily _dash_serve_spec, specpath("`u51d'/s6.json") datapath("`u51d'/d6.json") link(g1 g2)
    local rc6 = _rc
    _w31_expect U51-6 "(`rc6' == 0)" "one link(): r(`rc6')"
    if `rc6' == 0 {
        _u51_bo "`u51d'/s6.json" link
        _w31_expect U51-6 `"("${u51_v}" == "g1 g2")"' `"link key "${u51_v}""'
        _u51_bo "`u51d'/s6.json" brush
        _w31_expect U51-6 `"("${u51_v}" == "<none>")"' `"brush key "${u51_v}""'
    }
    _w31_done U51-6 "a single link(g1 g2) writes no || and no brush key"

    // U51-7: dash serve refuses brush(bogus) in the same sentence.
    local lf "`u51d'/r7.log"
    capture log close _u51l
    quietly log using "`lf'", text replace name(_u51l)
    capture noisily _dash_serve_spec, specpath("`u51d'/s7.json") datapath("`u51d'/d7.json") brush(bogus)
    local rc7 = _rc
    quietly log close _u51l
    cert_log_has "`lf'", needle("dash serve: brush() takes highlight or filter")
    _w31_expect U51-7 "(`rc7' == 198) & (r(count) == 1)" "dash serve brush(bogus): r(`rc7'), the sentence `r(count)' times"
    _w31_done U51-7 "dash serve refuses brush(bogus) r(198)"
    dash clear
    display as text "S51 end " c(current_date) " " c(current_time)
}
* ==== end S51 ====

python:
def _u53_page(path):
    # The saved page's composite and print markers, as globals.
    from sfi import Macro
    with open(path, encoding="utf-8") as fh:
        page = fh.read()
    Macro.setGlobal("u53_png", str(page.count('"dash_composite_png"')))
    Macro.setGlobal("u53_svg", str(page.count('"dash_svg_save"')))
    Macro.setGlobal("u53_css", str(page.count("@media print { :host { display: none")))
    Macro.setGlobal("u53_bp", str(page.count("beforeprint")))

def _u53_app(spec, data, app):
    # Write the served app dash serve would run, for cert_file_has.
    import os
    import sys
    import warnings
    if os.getcwd() not in sys.path:
        sys.path.insert(0, os.getcwd())
    import dash_render as dr
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        dr.ServerAppBuilder(spec, data).build(app)
end

* ==== S53 H2x: export and print ====
local only : env WP31_ONLY
if inlist("`only'", "", "S53") & `: list posof "S53" in w31_run' {
    display as text "S53 start " c(current_date) " " c(current_time)
    local u53d "`w31_work'/s53"
    capture mkdir "`u53d'"
    // The whole-dashboard export and the print layout are dash's own
    // (twoway draws neither): no twoway truth; the markers each page and
    // the served app carry.
    sysuse auto, clear
    dash clear
    quietly dash scatter mpg weight, name(g1) by(foreign)
    quietly dash scatter price weight, name(g2)

    // U53-1: one top-level grid holds the composite PNG action once, and
    // the page's one toolbar its Save as SVG action (D67).
    capture noisily dash build, saving("`u53d'/p1.html") replace nobrowser title("Cars")
    local rc1 = _rc
    _w31_expect U53-1 "(`rc1' == 0)" "dash build: r(`rc1')"
    _w31_expect U53-2 "(`rc1' == 0)" "dash build: r(`rc1')"
    if `rc1' == 0 {
        python: _u53_page(r"`u53d'/p1.html")
        // Flipped (DECISIONS D67): one toolbar per page; the by() sub-grid
        // nested in the top-level grid has no toolbar, so no Save as SVG.
        _w31_expect U53-1 "(${u53_png} == 1) & (${u53_svg} == 1)" "dash_composite_png ${u53_png} times, dash_svg_save ${u53_svg} times"
        // U53-2: one print stylesheet (shared by the toolbars and the
        // filters) and one beforeprint hook.
        _w31_expect U53-2 "(${u53_css} == 1) & (${u53_bp} == 1)" "print rule ${u53_css} times, beforeprint ${u53_bp} times"
    }
    _w31_done U53-1 "the top-level grid has Save dashboard once; Save as SVG on the page's one toolbar"
    _w31_done U53-2 "the page holds one print stylesheet and one beforeprint hook"

    // U53-3: the served app defines the same constants and appends the
    // print hook to its document_ready list.
    capture noisily _dash_serve_spec, specpath("`u53d'/s3.json") datapath("`u53d'/d3.json") title("Cars")
    local rc3 = _rc
    _w31_expect U53-3 "(`rc3' == 0)" "_dash_serve_spec: r(`rc3')"
    if `rc3' == 0 {
        python: _u53_app(r"`u53d'/s3.json", r"`u53d'/d3.json", r"`u53d'/app3.py")
        foreach n in "_DASH_COMPOSITE_JS = " "_DASH_COMPOSITE_SAVE_JS = " "_DASH_PRINT_CSS = " "_DASH_PRINT_HOOK_JS = " "def _dash_add_composites(" "def _dash_print_models(" "_hooks += [_print_hook]" {
            cert_file_has "`u53d'/app3.py", needle(`"`n'"')
            _w31_expect U53-3 "(r(found) == 1)" `"the app holds `n'"'
        }
    }
    _w31_done U53-3 "the served app defines the composite and print names"
    dash clear
    display as text "S53 end " c(current_date) " " c(current_time)
}
* ==== end S53 ====

* ==== S54 K6: accessibility ====
local only : env WP31_ONLY
if inlist("`only'", "", "S54") & `: list posof "S54" in w31_run' {
    display as text "S54 start " c(current_date) " " c(current_time)
    local u54d "`w31_work'/s54"
    capture mkdir "`u54d'"
    // Accessible names and roles are dash's own (a Stata graph has none):
    // no twoway truth; the built page's model JSON is read, each needle
    // counted (cert_file_count).  BokehJS writes each html_attributes pair
    // as ["key","value"].
    sysuse auto, clear
    dash clear
    quietly dash scatter mpg weight, title(Mileage) name(g1)
    quietly dash scatter price weight, name(g2)
    quietly dash kpi mean(mpg), title(Average mileage) name(k1)

    // U54-1: each graph a named role=group (its toolbar holds a focusable
    // link, so not role=img: axe nested-interactive, WP-31 K6 follow-up);
    // the filter widget named by its title.
    capture noisily dash build, saving("`u54d'/a.html") replace nobrowser filter(foreign, type(dropdown))
    local rc1 = _rc
    _w31_expect U54-1 "(`rc1' == 0)" "dash build: r(`rc1')"
    if `rc1' == 0 {
        cert_file_count "`u54d'/a.html", needle(`"["role","img"]"')
        local nimg = r(count)
        cert_file_count "`u54d'/a.html", needle(`"[["role","group"],["aria-label","Mileage"]]"')
        local nt = r(count)
        cert_file_count "`u54d'/a.html", needle(`"[["role","group"],["aria-label","scatter of price versus weight"]]"')
        local nn = r(count)
        cert_file_count "`u54d'/a.html", needle(`"["aria-label","Car origin"]"')
        local nf = r(count)
        // Flipped: role=img 2 -> 0 (a figure with a toolbar is a group).
        _w31_expect U54-1 "(`nimg' == 0) & (`nt' == 1) & (`nn' == 1) & (`nf' == 1)" "role=img `nimg', title group `nt', derived group `nn', filter name `nf'"
    }
    _w31_done U54-1 "each graph is a role=group with its name; the filter is named"

    // U54-2: the KPI card is a group named by its title.
    if `rc1' == 0 {
        cert_file_count "`u54d'/a.html", needle(`"["aria-label","Average mileage"]"')
        local nk = r(count)
        cert_file_count "`u54d'/a.html", needle(`"["role","group"]"')
        local ng = r(count)
        _w31_expect U54-2 "(`nk' == 1) & (`ng' >= 1)" "KPI name `nk', role=group `ng'"
    }
    _w31_done U54-2 "a KPI card is role=group named by its title"

    // U54-3: tabs() gives a named region and the keyboard script, once.
    capture noisily dash build, saving("`u54d'/b.html") replace nobrowser tabs(One: g1 k1 / Two: g2)
    local rc3 = _rc
    _w31_expect U54-3 "(`rc3' == 0)" "dash build tabs(): r(`rc3')"
    if `rc3' == 0 {
        cert_file_count "`u54d'/b.html", needle(`"["aria-label","Dashboard tabs"]"')
        local nr = r(count)
        cert_file_count "`u54d'/b.html", needle(`""name":"dash_tabs_keys""')
        local nh = r(count)
        cert_file_count "`u54d'/b.html", needle("keydown")
        local nkd = r(count)
        _w31_expect U54-3 "(`nr' == 1) & (`nh' == 1) & (`nkd' >= 1)" "tabs region `nr', hook `nh', keydown `nkd'"
    }
    _w31_done U54-3 "tabs() is a named region with the keyboard script"
    dash clear
    display as text "S54 end " c(current_date) " " c(current_time)
}
* ==== end S54 ====

* ==== S55 H4: served environment and health ====
local only : env WP31_ONLY
if inlist("`only'", "", "S55") & `: list posof "S55" in w31_run' {
    display as text "S55 start " c(current_date) " " c(current_time)
    local u55d "`w31_work'/s55"
    capture mkdir "`u55d'"
    // dash's own served app (twoway has none): no twoway truth.  The app
    // dash build writes holds the BOKEH_RESOURCES refusal and the /health
    // fields; test/test_served_env.py runs them.
    sysuse auto, clear
    dash clear
    quietly dash scatter mpg weight, name(g1)
    capture noisily dash build, saving("`u55d'/app.py") server replace nobrowser
    local rc5 = _rc
    _w31_expect U55-5 "(`rc5' == 0)" "dash build, server: r(`rc5')"
    if `rc5' == 0 {
        foreach n in "uptime_s" "max_sessions" "BOKEH_RESOURCES is set to" "_dash_env_bundle_note()" {
            cert_file_has "`u55d'/app.py", needle(`"`n'"')
            _w31_expect U55-5 "(r(found) == 1)" `"the app lacks `n'"'
        }
    }
    _w31_done U55-5 "the served app refuses BOKEH_RESOURCES, notes the bundle and reports uptime_s and max_sessions on /health"
    dash clear
    display as text "S55 end " c(current_date) " " c(current_time)
}
* ==== end S55 ====

// S60 helpers (WP-31 K2).  _u60_docs: the saved renderer's figures and the
// served document (the generated app's make_document) for one written
// spec, as _u02_docs makes them.  _u60_glyphs: per figure in layout order,
// the glyph renderers' (type, rows) pairs.  _u60_compare: both modes'
// figures and glyphs into globals u60_<what>.
python:
import os as _u60_os, sys as _u60_sys
for _u60_p in (_u60_os.path.abspath(".."), _u60_os.path.abspath(".")):
    if _u60_p not in _u60_sys.path:
        _u60_sys.path.insert(0, _u60_p)


def _u60_docs(sp, dp, app):
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_u60_app")
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_u60_app.py", "exec"),
             ns)
        doc = Document()
        ns["make_document"](doc)
    return r, doc


def _u60_figs(roots):
    from bokeh.models import Plot
    out, seen = [], set()
    for root in roots:
        for m in root.references():
            if isinstance(m, Plot) and m.id not in seen:
                seen.add(m.id)
                out.append(m)
    return out


def _u60_glyphs(fig):
    from bokeh.models import GlyphRenderer
    rows = []
    for g in fig.renderers:
        if isinstance(g, GlyphRenderer):
            d = g.data_source.data
            n = len(next(iter(d.values()))) if d else 0
            rows.append((type(g.glyph).__name__, n))
    return rows


def _u60_quads(fig):
    from bokeh.models import GlyphRenderer, Quad
    for g in fig.renderers:
        if isinstance(g, GlyphRenderer) and isinstance(g.glyph, Quad):
            d = g.data_source.data
            return [(round(float(a), 9), round(float(b), 9), round(float(c), 9))
                    for a, b, c in zip(d[g.glyph.left], d[g.glyph.right],
                                       d[g.glyph.top])]
    return []


def _u60_xs(fig, kind):
    from bokeh.models import GlyphRenderer
    for g in fig.renderers:
        if isinstance(g, GlyphRenderer) and type(g.glyph).__name__ == kind:
            xs = [float(v) for v in g.data_source.data[g.glyph.x]]
            return (min(xs), max(xs)) if xs else (float("nan"),) * 2
    return (float("nan"),) * 2


def _u60_compare(sp, dp, app):
    from sfi import Macro
    r, doc = _u60_docs(sp, dp, app)
    # Every Plot in each mode's layout (by() adds empty plots for its
    # shared axis titles in both), walked the same way.
    fs = _u60_figs([r._last_layout_root])
    fv = _u60_figs(list(doc.roots))
    Macro.setGlobal("u60_nfs", str(len(fs)))
    Macro.setGlobal("u60_nfv", str(len(fv)))
    # Panels are paired as multisets: model ids differ between the modes.
    gs = sorted(_u60_glyphs(f) for f in fs)
    gv = sorted(_u60_glyphs(f) for f in fv)
    Macro.setGlobal("u60_gsame", "1" if gs == gv else "0")
    # The panels that draw data: plots with a glyph renderer.
    Macro.setGlobal("u60_nds", str(sum(1 for g in gs if g)))
    Macro.setGlobal("u60_ndv", str(sum(1 for g in gv if g)))
    Macro.setGlobal("u60_gs", str(gs)[:500])
    Macro.setGlobal("u60_gv", str(gv)[:500])
    qs = sorted(_u60_quads(f) for f in fs)
    qv = sorted(_u60_quads(f) for f in fv)
    Macro.setGlobal("u60_qsame", "1" if qs == qv else "0")
    Macro.setGlobal("u60_nbins", str(len(qv[0]) if qv else -1))
    for mode, figs in (("s", fs), ("v", fv)):
        lo, hi = _u60_xs(figs[0], "Line") if figs else (float("nan"),) * 2
        Macro.setGlobal("u60_lo_" + mode, repr(lo))
        Macro.setGlobal("u60_hi_" + mode, repr(hi))


def _u60_pyc_build(src_py, sp, dp, work):
    """The renderer imported from a .pyc with no .py beside it, then asked
    to write a served app: inspect.getsource has no source file to read,
    so the app is written from the compiled code (WP-32)."""
    import importlib.util, py_compile, shutil, warnings
    from sfi import Macro
    d = _u60_os.path.join(work, "pyc")
    _u60_os.makedirs(d, exist_ok=True)
    cp = _u60_os.path.join(d, "dash_render_u60.py")
    shutil.copyfile(src_py, cp)
    pyc = _u60_os.path.join(d, "dash_render_u60.pyc")
    py_compile.compile(cp, cfile=pyc, doraise=True)
    _u60_os.remove(cp)
    spec = importlib.util.spec_from_file_location("dash_render_u60", pyc)
    mod = importlib.util.module_from_spec(spec)
    import sys as _u60_sys
    _u60_sys.modules["dash_render_u60"] = mod  # as an import enters it
    err, ok = "", 0
    try:
        with warnings.catch_warnings():
            warnings.simplefilter("ignore")
            spec.loader.exec_module(mod)
            app = _u60_os.path.join(d, "app.py")
            mod.ServerAppBuilder(sp, dp).build(app)
            ok = 1 if _u60_os.path.isfile(app) else 0
    except Exception as e:
        err = "%s: %s" % (type(e).__name__, str(e)[:200])
    finally:
        _u60_sys.modules.pop("dash_render_u60", None)
    Macro.setGlobal("u60_pyc_ok", str(ok))
    Macro.setGlobal("u60_pyc_err", err.replace('"', "'").replace("`", "'"))
end

* ==== S60 K2: end-to-end gaps ====
local only : env WP31_ONLY
if inlist("`only'", "", "S60") & `: list posof "S60" in w31_run' {
    display as text "S60 start " c(current_date) " " c(current_time)
    local u60d "`w31_work'/s60"
    capture mkdir "`u60d'"

    // U60-1: a served histogram layer's output.  twoway's own bin rule
    // (twoway__histogram_gen, the program twoway histogram calls) gives
    // the bin count; the served document draws that many bars, with the
    // saved page's edges and heights.
    sysuse auto, clear
    quietly twoway__histogram_gen mpg, gen(_u60h _u60x)
    local tw_bins = r(bin)
    drop _u60h _u60x
    dash clear
    quietly dash histogram mpg, name(g1)
    _dash_serve_spec, specpath("`u60d'/s1.json") datapath("`u60d'/d1.json")
    python: __import__("__main__")._u60_compare("`u60d'/s1.json", "`u60d'/d1.json", "`u60d'/a1.py")
    _w31_expect U60-1 "(${u60_nbins} == `tw_bins')" "served bars ${u60_nbins}, twoway r(bin) `tw_bins'"
    _w31_expect U60-1 "(${u60_qsame} == 1)" "the served bars' edges and heights differ from the saved page's"
    _w31_done U60-1 "a served histogram draws twoway's `tw_bins' bins with the saved page's edges and heights"

    // U60-2: a computed layer on a %td variable, served.  The lfit's line
    // spans the date variable's range (summarize), saved and served.
    sysuse auto, clear
    generate double day = mdy(1, 1, 2000) + 10 * _n
    format day %td
    quietly summarize day
    local dmin = r(min)
    local dmax = r(max)
    dash clear
    quietly dash lfit mpg day, name(g1)
    _dash_serve_spec, specpath("`u60d'/s2.json") datapath("`u60d'/d2.json")
    python: __import__("__main__")._u60_compare("`u60d'/s2.json", "`u60d'/d2.json", "`u60d'/a2.py")
    // Drawn on a datetime axis: milliseconds since 1jan1970 (day 3653).
    local dlo = (`dmin' - 3653) * 86400000
    local dhi = (`dmax' - 3653) * 86400000
    foreach m in s v {
        _w31_expect U60-2 "(abs(${u60_lo_`m'} - `dlo') < 1 & abs(${u60_hi_`m'} - `dhi') < 1)" "`m': lfit x ${u60_lo_`m'}..${u60_hi_`m'} ms, summarize `dmin'..`dmax' days"
    }
    _w31_done U60-2 "an lfit on a %td x spans the dates' range, saved and served"

    // U60-3: the serve start line in the log.  A port another program
    // holds makes the launched app fail fast, after the announcement.
    sysuse auto, clear
    dash clear
    quietly dash scatter mpg weight, name(g1)
    python: import socket as _u60_sk
    python: _u60_hold = _u60_sk.socket(); _u60_hold.bind(("127.0.0.1", 0)); _u60_hold.listen(1)
    python: from sfi import Macro as _u60_M; _u60_M.setLocal("u60port", str(_u60_hold.getsockname()[1]))
    tempname u60lg
    local u60log "`u60d'/serve.log"
    quietly log using "`u60log'", replace text name(`u60lg')
    capture noisily dash serve, port(`u60port') nobrowser
    local rc3 = _rc
    quietly log close `u60lg'
    python: _u60_hold.close()
    cert_file_has "`u60log'", needle("dash serve: starting Bokeh Server on port `u60port'.")
    _w31_expect U60-3 "(r(found) == 1)" "the log lacks the start line for port `u60port'"
    _w31_expect U60-3 "(`rc3' != 0)" "dash serve on a held port: r(`rc3')"
    _w31_done U60-3 "dash serve logs its start line with the port, then the held port's refusal (r(`rc3'))"

    // U60-4: a served build from an installed tree: net install into a
    // scratch PLUS (test_render_locate.cscript LOC-13's way), only Stata's
    // directories and that PLUS on the path, then dash build, server.
    local u60plus0 "`c(sysdir_plus)'"
    local u60sado "$S_ADO"
    local u60plus "`u60d'/plus/"
    capture mkdir "`u60d'/plus"
    quietly cd ..
    local u60src "`c(pwd)'"
    quietly cd "`u60src'/test"
    local rc4i = -1
    local rc4b = -1
    local u60fr ""
    sysdir set PLUS "`u60plus'"
    if "`c(sysdir_plus)'" == "`u60plus'" {
        capture noisily net from "`u60src'"
        if _rc == 0 capture noisily net install dash, replace
        local rc4i = _rc
        mata: st_global("S_ADO", "BASE;SITE;PLUS")
        capture noisily _dash_find_render
        local u60fr `"`r(fn)'"'
        sysuse auto, clear
        dash clear
        quietly dash scatter mpg weight, name(g1)
        capture noisily dash build, saving("`u60d'/inst.py") server replace nobrowser
        local rc4b = _rc
        dash clear
        mata: st_global("S_ADO", st_local("u60sado"))
    }
    sysdir set PLUS "`u60plus0'"
    _w31_expect U60-4 "(`rc4i' == 0)" "net install: r(`rc4i')"
    mata: st_local("u60frok", strofreal(strpos(st_local("u60fr"), st_local("u60plus")) == 1))
    _w31_expect U60-4 "(`u60frok' == 1)" `"the renderer found was `u60fr', not the installed one"'
    _w31_expect U60-4 "(`rc4b' == 0)" "dash build, server from the install: r(`rc4b')"
    if `rc4b' == 0 {
        cert_file_has "`u60d'/inst.py", needle("def make_document")
        _w31_expect U60-4 "(r(found) == 1)" "the installed build's app has no make_document"
    }
    _w31_done U60-4 "a served build from a net-installed tree writes the app through the installed renderer"

    // U60-5: per-type by() parity.  twoway draws one panel per foreign
    // level (2); both modes draw two panels with the same glyphs and rows.
    foreach t in histogram kdensity scatter line bar {
        sysuse auto, clear
        dash clear
        if inlist("`t'", "histogram", "kdensity") quietly dash `t' mpg, by(foreign) name(g1)
        else if "`t'" == "line" quietly dash line mpg weight, sort by(foreign) name(g1)
        else quietly dash `t' mpg weight, by(foreign) name(g1)
        _dash_serve_spec, specpath("`u60d'/s5`t'.json") datapath("`u60d'/d5`t'.json")
        python: __import__("__main__")._u60_compare("`u60d'/s5`t'.json", "`u60d'/d5`t'.json", "`u60d'/a5`t'.py")
        quietly levelsof foreign
        local npan : word count `r(levels)'
        _w31_expect U60-5 "(${u60_nds} == `npan' & ${u60_ndv} == `npan')" "`t': drawn panels saved ${u60_nds} served ${u60_ndv}, twoway `npan'"
        _w31_expect U60-5 "(${u60_nfs} == ${u60_nfv})" "`t': plots saved ${u60_nfs} served ${u60_nfv}"
        _w31_expect U60-5 "(${u60_gsame} == 1)" "`t': glyphs saved ${u60_gs} served ${u60_gv}"
    }
    _w31_done U60-5 "by(foreign) draws twoway's two panels with the same glyphs in both modes, for histogram, kdensity, scatter, line and bar"

    // U60-6: the inspect.getsource path.  ServerAppBuilder copies the
    // renderer's functions by inspect.getsource (_dash_source_of); from a
    // .pyc with no .py beside it each copied object is written as a stub
    // bound to its compiled code (WP-32), so the build writes the app.
    // Flipped: WP-32 (BUGS.md "A renderer without its source file cannot
    // write a served app"); this case pinned the refusal before.
    sysuse auto, clear
    dash clear
    quietly dash scatter mpg weight, name(g1)
    _dash_serve_spec, specpath("`u60d'/s6.json") datapath("`u60d'/d6.json")
    python: __import__("__main__")._u60_pyc_build("../dash_render.py", "`u60d'/s6.json", "`u60d'/d6.json", "`u60d'")
    _w31_expect U60-6 "(${u60_pyc_ok} == 1)" `"a .pyc-only renderer did not write a served app: ${u60_pyc_err}"'
    _w31_done U60-6 "a .pyc-only renderer writes a served app from its compiled code"

    dash clear
    macro drop u60_*
    display as text "S60 end " c(current_date) " " c(current_time)
}
* ==== end S60 ====

* ==== append new blocks above this line ====

// ----------------------------------------------------------------
// Summary (test_wp29_truth.cscript's shape)
// ----------------------------------------------------------------
capture graph drop _all
capture dash clear
capture rmdir "`w31_work'"
local nfail    = ${w31_nfail}
local faillist "${w31_faillist}"
local ncase    = ${w31_ncase}
local only : env WP31_ONLY
macro drop w31_nfail w31_faillist w31_bad w31_ncase
display as text ""
display as text "============================================================"
if `ncase' == 0 {
    if `w31_N' > 1 & `"`macval(only)'"' == "" & "`w31_run'" == "" {
        display as text "test_wp31_truth: part `w31_k'/`w31_N' has no block to run"
        display as text "============================================================"
        exit 0
    }
    // A WP31_ONLY that names no block, or only a stub, ran nothing:
    // that is not a pass.
    display as error "  test_wp31_truth: no case ran (WP31_ONLY=`only')"
    display as text "============================================================"
    exit 9
}
else if `nfail' == 0 {
    display as text "  test_wp31_truth: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_wp31_truth: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
