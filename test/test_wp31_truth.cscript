// S09 helpers (WP-31 C10c).  _u09_draw: for a registered graph, saved
// (sfx s) and served (sfx v), every continuous axis of letter L as
// "<n>:<side>:<order from the plot region outward>" in axis order
// (u09_ax<sfx>) and each layer's range name (u09_rn<sfx>); the axis-3
// facts as "<axis type>|<title>|<label ticks>|<extra ticks>|<spans on
// y3>" (u09_a3<sfx>); the spec's axisn object (u09_axn).  _u09_fix: the
// fixture's sides.<key> in the same form (u09_f).
python:
def _u09_axes(fig, letter):
    from bokeh.models.axes import ContinuousAxis
    sides = ("left", "right") if letter == "y" else ("below", "above")
    out = {}
    for side in sides:
        on = [a for a in getattr(fig, side) if isinstance(a, ContinuousAxis)]
        for i, a in enumerate(on, 1):
            nm = getattr(a, letter + "_range_name")
            out[1 if nm == "default" else int(nm[1:])] = "%s:%d" % (side, i)
    return " ".join("%d:%s" % (n, out[n]) for n in sorted(out))


def _u09_num(v):
    return "%g" % float(v)


def _u09_draw(sp, dp, app, letter):
    import json
    from sfi import Macro
    import __main__ as m
    a, b = m._u03_docs(sp, dp, app)
    for figs, sfx in ((a, "s"), (b, "v")):
        f = figs[0]
        Macro.setGlobal("u09_ax" + sfx, _u09_axes(f, letter))
        Macro.setGlobal("u09_rn" + sfx, " ".join(
            getattr(r, letter + "_range_name") for r in f.renderers
            if type(r).__name__ == "GlyphRenderer"))
        a3 = ""
        for ax in f.left + f.right:
            if getattr(ax, "y_range_name", "") != "y3":
                continue
            t = ax.ticker
            args = dict(getattr(t, "args", None) or {})
            base = args.get("base", getattr(t, "ticks", None)) or []
            base = getattr(base, "ticks", base)
            extra = args.get("extra") or []
            spans = [_u09_num(c.location) for c in f.center
                     if type(c).__name__ == "Span"
                     and getattr(c, "y_range_name", "") == "y3"]
            a3 = "|".join([type(ax).__name__, str(ax.axis_label or ""),
                           " ".join(_u09_num(v) for v in base),
                           " ".join(_u09_num(v) for v in extra),
                           " ".join(spans)])
        Macro.setGlobal("u09_a3" + sfx, a3)
    with open(sp, encoding="utf-8") as fh:
        go = json.load(fh)["graphs"][0]["graph_options"]
    Macro.setGlobal("u09_axn", json.dumps(go.get("axisn", {}),
                                          sort_keys=True))


def _u09_fix(key):
    import json, os
    from sfi import Macro
    with open(os.path.join("fixtures", "axes_n_truth.json"),
              encoding="utf-8") as fh:
        fx = json.load(fh)
    axes = sorted(fx["sides"][key]["axes"], key=lambda a: a["axis"])
    Macro.setGlobal("u09_f", " ".join("%d:%s:%d" % (a["axis"], a["side"],
                                                    a["order"])
                                      for a in axes))
end

capture program drop _u09_reg
program define _u09_reg
    // _u09_reg <dir> <k> <letter> <dash command...>
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    gettoken letter 0 : 0
    dash clear
    quietly dash `0'
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u09_m; _u09_m._u09_draw("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py", "`letter'")
end

* ==== S09 C10c: Axes three to nine ====
local only : env WP31_ONLY
if inlist("`only'", "", "S09") & `: list posof "S09" in w31_run' {
    display as text "S09 start " c(current_date) " " c(current_time)
    local u9d "`w31_work'/s09"
    capture mkdir "`u9d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear
    local three (scatter mpg weight, yaxis(1)) (scatter price weight, yaxis(2)) (scatter length weight, yaxis(3))

    // ------------------------------------------------------------
    // U09-1: three y axes -- twoway draws them (rc 0, three axes in the
    // .Graph); dash draws ranges y2 and y3, each layer on its own, and
    // the three axes on the fixture's sides (sides.y3: all on the left,
    // 1 innermost), the saved page and the served app alike.
    // ------------------------------------------------------------
    capture graph drop u9tw
    capture noisily twoway `three', nodraw name(u9tw, replace)
    _w31_expect U09-1 "(_rc == 0)" "twoway three axes rc `=_rc'"
    _w31_expect U09-1 `"("`.u9tw.yaxis3.isa'" != "")"' "twoway has no yaxis3"
    capture graph drop u9tw
    _u09_reg "`u9d'" 1 y `three', name(zu91)
    python: import __main__ as _u09_m; _u09_m._u09_fix("y3")
    foreach m in s v {
        _w31_expect U09-1 `"("${u09_ax`m'}" == "${u09_f}")"' "`m': axes ${u09_ax`m'}, twoway ${u09_f}"
        _w31_expect U09-1 `"("${u09_rn`m'}" == "default y2 y3")"' "`m': layers on ${u09_rn`m'}"
    }
    _w31_done U09-1 "three y axes drawn on twoway's sides, each layer on its own axis, saved and served"

    // ------------------------------------------------------------
    // U09-2: four y axes and three x axes on the fixture's sides
    // (sides.y4, sides.x3), and axes 1 and 3 alone (sides.y13: 3 on the
    // right), both modes.
    // ------------------------------------------------------------
    _u09_reg "`u9d'" 2 y `three' (scatter gear_ratio weight, yaxis(4)), name(zu92)
    python: import __main__ as _u09_m; _u09_m._u09_fix("y4")
    foreach m in s v {
        _w31_expect U09-2 `"("${u09_ax`m'}" == "${u09_f}")"' "y4 `m': axes ${u09_ax`m'}, twoway ${u09_f}"
    }
    _u09_reg "`u9d'" 3 x (scatter mpg weight, xaxis(1)) (scatter mpg price, xaxis(2)) (scatter mpg length, xaxis(3)), name(zu93)
    python: import __main__ as _u09_m; _u09_m._u09_fix("x3")
    foreach m in s v {
        _w31_expect U09-2 `"("${u09_ax`m'}" == "${u09_f}")"' "x3 `m': axes ${u09_ax`m'}, twoway ${u09_f}"
        _w31_expect U09-2 `"("${u09_rn`m'}" == "default x2 x3")"' "x3 `m': layers on ${u09_rn`m'}"
    }
    _u09_reg "`u9d'" 4 y (scatter mpg weight) (scatter length weight, yaxis(3)), name(zu94)
    python: import __main__ as _u09_m; _u09_m._u09_fix("y13")
    foreach m in s v {
        _w31_expect U09-2 `"("${u09_ax`m'}" == "${u09_f}")"' "y13 `m': axes ${u09_ax`m'}, twoway ${u09_f}"
    }
    _w31_done U09-2 "four y axes, three x axes and axes 1 and 3 on twoway's sides, saved and served"

    // ------------------------------------------------------------
    // U09-3: ylabel(), ytitle(), yscale(log), yline() and ytick() with
    // axis(3) reach the third axis, as twoway's do (routed.*: labels
    // 150-230, the title Len, unevenly spaced log labels, a line at 200,
    // ticks at 165 and 215), in the spec's axisn object and both modes.
    // ------------------------------------------------------------
    local rt ylabel(150(20)230, axis(3)) ytitle("Len", axis(3)) yscale(log axis(3)) yline(200, axis(3)) ytick(165 215, axis(3))
    capture graph drop u9tw
    capture noisily twoway `three', `rt' nodraw name(u9tw, replace)
    _w31_expect U09-3 "(_rc == 0)" "twoway routed rc `=_rc'"
    capture graph drop u9tw
    _u09_reg "`u9d'" 5 y `three', `rt' name(zu95)
    mata: st_local("hasl", strofreal(strpos(st_global("u09_axn"), char(34) + "label" + char(34) + ": " + char(34) + "150(20)230" + char(34)) > 0))
    _w31_expect U09-3 "(`hasl' == 1)" "the spec's axisn holds no ylabel(150(20)230, axis(3))"
    foreach m in s v {
        _w31_expect U09-3 `"("${u09_a3`m'}" == "LogAxis|Len|150 170 190 210 230|165 215|200")"' "`m': axis 3 ${u09_a3`m'}"
    }
    _w31_done U09-3 "axis(3) labels, title, log scale, line and ticks reach the third axis, saved and served"

    // ------------------------------------------------------------
    // U09-6: every layer on axis 3 -- twoway draws one left axis
    // (sides.y3_lone); dash draws one axis, the first, titled by
    // ytitle(, axis(3)).
    // ------------------------------------------------------------
    _u09_reg "`u9d'" 6 y scatter mpg weight, yaxis(3) ytitle("Only", axis(3)) name(zu96)
    foreach m in s v {
        _w31_expect U09-6 `"("${u09_ax`m'}" == "1:left:1" & "${u09_rn`m'}" == "default")"' "`m': axes ${u09_ax`m'}, layers ${u09_rn`m'}"
    }
    _w31_done U09-6 "a lone yaxis(3) is drawn as one left axis, saved and served"

    forvalues k = 1/6 {
        foreach p in s d {
            capture erase "`u9d'/`p'`k'.json"
        }
        capture erase "`u9d'/a`k'.py"
    }
    capture rmdir "`u9d'"
    dash clear
    display as text "S09 end " c(current_date) " " c(current_time)
}
* ==== end S09 ====

// S10 helpers (WP-31 F1a).  _u10_move: the saved page's lfit or qfit line
// after one filter move -- the page rendered, the widget set and its own
// callback run under node (test/js_runner.py) -- written to a JSON file,
// its point count in global u10_n.  _u10_ss: twoway's serset of one plot
// (drawn nodraw, saved, read back) written to a JSON file of its columns.
// _u10_close: the saved line against twoway's serset (either column
// order), the x converted to axis milliseconds for a date kind; global
// u10_ok 1 or 0 and u10_msg.
python:
def _u10_move(sp, dp, kind, value, out):
    import json
    import os
    import sys
    import warnings
    if os.getcwd() not in sys.path:
        sys.path.insert(0, os.getcwd())
    import dash_render as dr
    import js_runner
    from sfi import Macro
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
    w = [m for m in r.filter_widgets if type(m).__name__ == kind][0]
    if kind == "Select":
        w.value = [v for v, lab in w.options if lab == value][0]
    elif kind == "RangeSlider":
        w.value = tuple(float(v) for v in value.split())
    else:
        w.value = float(value)
    cb = r.filter_callbacks[r.filter_widgets.index(w)]
    js_runner.JsSession(r.filter_callbacks).run(cb)
    fits = [x for f in r.figures.values() for x in f.renderers
            if (getattr(x, "_dash_agg_config", None) or {}).get("type")
            in ("lfit", "qfit")]
    d = fits[0].data_source.data
    with open(out, "w", encoding="utf-8") as fh:
        json.dump({"x": [float(v) for v in d["x"]],
                   "y": [float(v) for v in d["y"]]}, fh)
    Macro.setGlobal("u10_n", str(len(d["x"])))


def _u10_take(out):
    import json
    from sfi import Data
    cols = {}
    for i in range(Data.getVarCount()):
        cols[Data.getVarName(i)] = [None if v is None or v >= 8.98e307
                                    else float(v) for v in Data.get(var=i)]
    with open(out, "w", encoding="utf-8") as fh:
        json.dump(cols, fh)


def _u10_close(tw, saved, xkind, rtol, xatol, lin=0):
    import json
    import numpy as np
    import dash_render as dr
    from sfi import Macro
    t = json.load(open(tw, encoding="utf-8"))
    g = json.load(open(saved, encoding="utf-8"))
    gx, gy = np.asarray(g["x"], float), np.asarray(g["y"], float)
    if xkind:
        # The saved x is axis ms; twoway's serset holds Stata units.
        gx = dr._dash_date_units(gx, xkind)
    cols = {k: np.asarray([np.nan if v is None else v for v in c], float)
            for k, c in t.items()}
    msg = "no column pair of twoway's serset (%s) matches the %d saved points" % (
        " ".join(cols), len(gx))
    ok = 0
    worst = []
    for a in cols:
        for b in cols:
            if a == b:
                continue
            tx, ty = cols[a], cols[b]
            keep = np.isfinite(tx) & np.isfinite(ty)
            tx, ty = tx[keep], ty[keep]
            if len(tx) == len(gx) and len(gx):
                worst.append("%s/%s: x %.3g y %.3g" % (
                    a, b, float(np.max(np.abs(gx - tx) / np.maximum(np.abs(tx), 1e-300))),
                    float(np.max(np.abs(gy - ty) / np.maximum(np.abs(ty), 1e-300)))))
            else:
                worst.append("%s/%s: %d rows" % (a, b, len(tx)))
            # twoway predicts at its grid as stored (a float x), so a
            # straight line is also read at those x: on a %td x the float
            # day is 0.001 off, a slope of 2 a day 0.002 in y.
            if len(tx) == len(gx) and len(gx) and np.allclose(
                    gx, tx, rtol=rtol, atol=float(xatol)) and (np.allclose(
                    gy, ty, rtol=rtol, atol=1e-12) or (lin and np.allclose(
                    np.interp(tx, gx, gy), ty, rtol=rtol, atol=1e-12))):
                ok, msg = 1, "%d points agree (x %s, y %s)" % (len(gx), a, b)
    if not ok:
        msg += " (largest relative differences " + "; ".join(worst) + ")"
    Macro.setGlobal("u10_ok", str(ok))
    Macro.setGlobal("u10_msg", msg)


def _u10_said(log, text):
    from sfi import Macro
    with open(log, encoding="utf-8", errors="replace") as fh:
        Macro.setGlobal("u10_said", "1" if text in fh.read() else "0")
end

capture program drop _u10_ss
program define _u10_ss
    // _u10_ss <out.json> <gph> <twoway plot ...>
    version 19
    gettoken out 0 : 0
    gettoken gph 0 : 0
    preserve
    capture erase "`gph'"
    quietly twoway (`0'), nodraw saving("`gph'", replace)
    capture graph drop _all
    capture serset drop _all
    quietly graph use "`gph'", nodraw
    quietly serset set 0
    quietly serset use, clear
    // A program's python runs in its own namespace: reach the do-file's.
    python: __import__("__main__")._u10_take("`out'")
    capture graph drop _all
    capture erase "`gph'"
    restore
end

* ==== S10 F1a: lfit and qfit refit on the saved page ====
local only : env WP31_ONLY
if inlist("`only'", "", "S10") & `: list posof "S10" in w31_run' {
    display as text "S10 start " c(current_date) " " c(current_time)
    local u10d "`w31_work'/s10"
    capture mkdir "`u10d'"
    capture graph drop _all

    // ------------------------------------------------------------
    // U10-01..03: after a move the saved line is twoway's line on the
    // kept rows: lfit after the dropdown to Foreign, qfit, n(50) after
    // the range to 4500-11385, lfit [aw=displacement] after the
    // dropdown to Domestic.  twoway's lfit draws 3 points by default
    // (the same line), so it is asked for dash's 100.
    // ------------------------------------------------------------
    local k 0
    foreach c in "U10-01|(scatter mpg weight) (lfit mpg weight)|foreign, type(dropdown)|Select|Foreign|lfit mpg weight if foreign == 1, n(100)" "U10-02|(scatter mpg weight) (qfit mpg weight, n(50))|price, type(range)|RangeSlider|4500 11385|qfit mpg weight if inrange(price, 4500, 11385), n(50)" "U10-03|lfit mpg weight [aw=displacement]|foreign, type(dropdown)|Select|Domestic|lfit mpg weight if foreign == 0 [aw=displacement], n(100)" {
        local ++k
        mata: u10_t = ustrsplit(st_local("c"), "[|]"); st_local("id", u10_t[1]); st_local("cmd", u10_t[2]); st_local("filt", u10_t[3]); st_local("kind", u10_t[4]); st_local("val", u10_t[5]); st_local("tw", u10_t[6])
        sysuse auto, clear
        dash clear
        capture noisily dash `cmd', name(zu10`k')
        _w31_expect `id' "(_rc == 0)" "dash `cmd' rc `=_rc'"
        _dash_serve_spec, specpath("`u10d'/s`k'.json") datapath("`u10d'/d`k'.json") filter(`filt')
        python: _u10_move("`u10d'/s`k'.json", "`u10d'/d`k'.json", "`kind'", "`val'", "`u10d'/g`k'.json")
        _u10_ss "`u10d'/t`k'.json" "`u10d'/t`k'.gph" `tw'
        // A serset stores floats: twoway's values are read to 3e-7.
        python: _u10_close("`u10d'/t`k'.json", "`u10d'/g`k'.json", "", 3e-7, 0)
        _w31_expect `id' "(${u10_ok} == 1)" "dash `cmd', filter(`filt') moved to `val': ${u10_msg}"
        _w31_done `id' "the saved `cmd' after the move to `val' is twoway `tw' (${u10_msg})"
    }

    // ------------------------------------------------------------
    // U10-04: a move leaving one row empties the saved line; twoway on
    // that row draws no line (rc and note measured).
    // ------------------------------------------------------------
    sysuse auto, clear
    dash clear
    capture noisily dash (scatter mpg weight) (lfit mpg weight), name(zu104)
    _w31_expect U10-04 "(_rc == 0)" "dash lfit rc `=_rc'"
    _dash_serve_spec, specpath("`u10d'/s4.json") datapath("`u10d'/d4.json") filter(price, type(slider))
    python: _u10_move("`u10d'/s4.json", "`u10d'/d4.json", "Slider", "15906", "`u10d'/g4.json")
    _w31_expect U10-04 "(${u10_n} == 0)" "the saved lfit after the slider to 15906 holds ${u10_n} points"
    quietly count if price >= 15906
    _w31_expect U10-04 "(r(N) == 1)" "price >= 15906 keeps `r(N)' rows"
    local lf "`u10d'/t4.log"
    quietly log using "`lf'", text replace name(u10l)
    capture noisily twoway lfit mpg weight if price >= 15906, nodraw
    local trc = _rc
    quietly log close u10l
    python: _u10_said("`lf'", "could not fit model")
    _w31_expect U10-04 "(`trc' != 0 | ${u10_said} == 1)" "twoway lfit on one row: rc `trc', note ${u10_said}"
    _w31_done U10-04 "one kept row: the saved line is empty; twoway draws none (rc `trc', note ${u10_said})"

    // ------------------------------------------------------------
    // U10-05: a %td x refits in days and is drawn in axis milliseconds:
    // the saved points after the slider to 4, read back in days
    // (_dash_date_units), are twoway's serset to its float precision.
    // ------------------------------------------------------------
    clear
    quietly set obs 10
    quietly generate x = _n
    quietly generate y = 2 * x + 1
    quietly generate d = mdy(1, _n, 2020)
    format d %td
    dash clear
    capture noisily dash lfit y d, name(zu105)
    _w31_expect U10-05 "(_rc == 0)" "dash lfit y d rc `=_rc'"
    _dash_serve_spec, specpath("`u10d'/s5.json") datapath("`u10d'/d5.json") filter(x, type(slider))
    python: _u10_move("`u10d'/s5.json", "`u10d'/d5.json", "Slider", "4", "`u10d'/g5.json")
    _u10_ss "`u10d'/t5.json" "`u10d'/t5.gph" lfit y d if x >= 4, n(100)
    python: _u10_close("`u10d'/t5.json", "`u10d'/g5.json", "td", 3e-7, 0, 1)
    _w31_expect U10-05 "(${u10_ok} == 1)" "dash lfit y d (%td) after the slider to 4: ${u10_msg}"
    _w31_done U10-05 "a %td x refits in days and draws in ms (${u10_msg})"

    forvalues k = 1/5 {
        foreach p in s d g t {
            capture erase "`u10d'/`p'`k'.json"
        }
    }
    capture erase "`lf'"
    capture rmdir "`u10d'"
    macro drop u10_n u10_ok u10_msg u10_said
    capture mata: mata drop u10_t
    dash clear
    display as text "S10 end " c(current_date) " " c(current_time)
}
* ==== end S10 ====

// S11 helpers (WP-31 C4).  _u11_run: one command under capture noisily
// with its own log; r(rc) and r(has) (1 when the log holds the needle,
// Stata's wrapped lines re-joined).  _u11_pts: the points dash stored for
// plot k of a graph (the served spec's function_points) against twoway's
// serset of the same layer (_u10_ss's JSON): every column within rtol;
// global u11_ok 1 or 0 and u11_msg.  _u11_layer: the saved page and the
// served app of a spec, the visibility of the layer's line and band.
python:
def _u11_pts(spec, gname, k, tw, rtol):
    import json
    import numpy as np
    from sfi import Macro
    sp = json.load(open(spec, encoding="utf-8"))
    p = (sp.get("function_points") or {}).get(gname, {}).get(str(k))
    t = json.load(open(tw, encoding="utf-8"))
    cols = [np.asarray([np.nan if v is None else v for v in c], float)
            for c in t.values()]
    if not isinstance(p, dict):
        Macro.setGlobal("u11_ok", "0")
        Macro.setGlobal("u11_msg", "no points stored for %s plot %s" % (gname, k))
        return
    want = [cols[-1], cols[0]] + (cols[1:3] if len(cols) == 4 else [])
    got = [np.asarray([np.nan if v is None else v for v in p[c]], float)
           for c in (["x", "y", "lo", "hi"] if "lo" in p else ["x", "y"])]
    ok = len(want) == len(got) and all(
        len(a) == len(b) and np.allclose(a, b, rtol=rtol, atol=0,
                                         equal_nan=True)
        for a, b in zip(got, want))
    Macro.setGlobal("u11_ok", "1" if ok else "0")
    Macro.setGlobal("u11_msg", "%d stored points, %d columns, against twoway's %d rows, %d columns" % (
        len(got[0]), len(got), len(want[0]), len(want)))


def _u11_layer(spec, data, gname):
    import os
    import sys
    import warnings
    if os.getcwd() not in sys.path:
        sys.path.insert(0, os.getcwd())
    import dash_render as dr
    from bokeh.document import Document
    from bokeh.models import GlyphRenderer, Plot
    from sfi import Macro
    out = []
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(spec, data)
        r.render()
        figs = [r.figures[gname]]
        app = os.path.join(os.path.dirname(spec), "u11_app.py")
        dr.ServerAppBuilder(spec, data).build(app)
        import importlib.util
        su = importlib.util.spec_from_file_location("u11_app", app)
        mod = importlib.util.module_from_spec(su)
        su.loader.exec_module(mod)
        doc = Document()
        mod.make_document(doc)
        figs += [m for m in doc.models if isinstance(m, Plot)
                 and any(isinstance(x, GlyphRenderer) for x in m.renderers)]
    for f in figs:
        rs = [x for x in f.renderers if isinstance(x, GlyphRenderer)]
        lines = [x.visible for x in rs if type(x.glyph).__name__ == "Line"]
        bands = [x.visible for x in rs if type(x.glyph).__name__ == "VArea"]
        out.append("%s/%s" % ("".join("1" if v else "0" for v in lines),
                              "".join("1" if v else "0" for v in bands)))
    Macro.setGlobal("u11_vis", " ".join(out))
end

capture program drop _u11_run
program define _u11_run, rclass
    // _u11_run <log> <needle> <command ...>
    version 19
    gettoken lf 0 : 0
    gettoken needle 0 : 0
    capture log close u11l
    quietly log using "`lf'", text replace name(u11l)
    capture noisily `0'
    local rc = _rc
    // A paragraph-mode message ({p 0 8}) reaches the log when it ends.
    display as text "{p_end}"
    quietly log close u11l
    local has 0
    if `"`needle'"' != "" {
        mata: st_local("has", strofreal(strpos(subinstr(invtokens(cat(st_local("lf"))', char(10)), char(10) + "> ", ""), st_local("needle")) > 0))
    }
    capture erase "`lf'"
    return scalar rc = `rc'
    return scalar has = `has'
end

* ==== S11 C4: fit options ====
local only : env WP31_ONLY
if inlist("`only'", "", "S11") & `: list posof "S11" in w31_run' {
    display as text "S11 start " c(current_date) " " c(current_time)
    local u11d "`w31_work'/s11"
    capture mkdir "`u11d'"
    local lf "`u11d'/run.log"
    capture graph drop _all
    sysuse auto, clear

    // ------------------------------------------------------------
    // U11-01: a second copy of atobs, nofit, fitplot() or ciplot() is
    // refused as twoway refuses it; estopts() twice is the rightmost.
    // ------------------------------------------------------------
    foreach c in "lfit mpg weight, atobs atobs|option atobs not allowed" "lfitci mpg weight, nofit nofit|option nofit not allowed" "lfitci mpg weight, fitplot(scatter) fitplot(line)|option fitplot() not allowed" "lfitci mpg weight, ciplot(rcap) ciplot(rarea)|option ciplot() not allowed" "lfit mpg weight, estopts(noconstant) estopts(noconstant)|" {
        gettoken cmd msg : c, parse("|")
        local msg = substr(`"`msg'"', 2, .)
        _u11_run "`lf'" `"`msg'"' twoway `cmd' nodraw
        local trc = r(rc)
        local th = r(has)
        dash clear
        _u11_run "`lf'" `"`msg'"' dash `cmd' name(zu11)
        local drc = r(rc)
        local dh = r(has)
        local nomsg = (`"`msg'"' == "")
        _w31_expect U11-01 "(`trc' == `drc') & (`th' == `dh') & (`th' == 1 | `nomsg')" "`cmd': twoway rc `trc' (`th'), dash rc `drc' (`dh')"
    }
    _w31_done U11-01 "a repeated fit option is refused, or taken, as twoway takes it"

    // ------------------------------------------------------------
    // U11-02: atobs and an observation-level predopts() with range()
    // are refused in twoway's words; predopts(stdp) with range() is taken.
    // ------------------------------------------------------------
    foreach c in "lfit mpg weight, atobs range(1000 5000)|may not combine atobs with range()" "qfitci mpg weight, predopts(residuals) range(1000 5000)|may not combine residuals with range()" "lfit mpg weight, predopts(stdp) range(1000 5000)|" {
        gettoken cmd msg : c, parse("|")
        local msg = substr(`"`msg'"', 2, .)
        _u11_run "`lf'" `"`msg'"' twoway `cmd' nodraw
        local trc = r(rc)
        local th = r(has)
        dash clear
        _u11_run "`lf'" `"`msg'"' dash `cmd' name(zu11)
        local drc = r(rc)
        local dh = r(has)
        local nomsg = (`"`msg'"' == "")
        _w31_expect U11-02 "(`trc' == `drc') & (`th' == `dh') & (`th' == 1 | `nomsg')" "`cmd': twoway rc `trc' (`th'), dash rc `drc' (`dh')"
    }
    _w31_done U11-02 "atobs and predopts() with range() as twoway reads them"

    // ------------------------------------------------------------
    // U11-03: estopts(), predopts() and estcmd() -- the points dash stores
    // are twoway's serset of the same layer (floats, so to 1e-7).
    // ------------------------------------------------------------
    local k 0
    foreach c in "lfit mpg weight, estopts(noconstant)" "fpfit mpg weight, estopts(degree(3))" "lfitci mpg weight, estopts(noconstant)" "qfitci mpg weight [aw=trunk], estopts(noconstant) level(90)" "fpfitci mpg weight, estcmd(glm)" "lfit mpg weight if foreign, predopts(residuals)" "qfit mpg weight, estopts(noconstant) n(7) range(2000 .)" {
        local ++k
        sysuse auto, clear
        dash clear
        capture noisily dash `c' name(zu113)
        _w31_expect U11-03 "(_rc == 0)" "dash `c' rc `=_rc'"
        _dash_serve_spec, specpath("`u11d'/s`k'.json") datapath("`u11d'/d`k'.json")
        _u10_ss "`u11d'/t`k'.json" "`u11d'/t`k'.gph" `c'
        python: _u11_pts("`u11d'/s`k'.json", "zu113", 1, "`u11d'/t`k'.json", 1e-7)
        _w31_expect U11-03 "(${u11_ok} == 1)" "`c': ${u11_msg}"
    }
    _w31_done U11-03 "estopts(), predopts() and estcmd() layers store twoway's own points (${u11_msg})"

    // ------------------------------------------------------------
    // U11-04: an unknown fitplot() or ciplot() name prints twoway's two
    // notes, rc 0; smoothplot() is taken in silence; the spellings.
    // ------------------------------------------------------------
    sysuse auto, clear
    foreach c in "lfitci mpg weight, fitplot(bogus)|named style bogus not found in class yxtype, default attributes used" "lfitci mpg weight, ciplot(sc)|named style sc not found in class y2xtype, default attributes used" "lfitci mpg weight, fitplot(sc) ciplot(rsc)|named style" "lpolyci mpg weight, smoothplot(bogus)|named style" {
        gettoken cmd msg : c, parse("|")
        local msg = substr(`"`msg'"', 2, .)
        _u11_run "`lf'" `"`msg'"' twoway `cmd' nodraw
        local trc = r(rc)
        local th = r(has)
        dash clear
        _u11_run "`lf'" `"`msg'"' dash `cmd' name(zu11)
        local drc = r(rc)
        local dh = r(has)
        _w31_expect U11-04 "(`trc' == 0) & (`drc' == 0) & (`th' == `dh')" "`cmd': twoway rc `trc' (`th'), dash rc `drc' (`dh')"
    }
    mata: st_local("u11c", _dash_recast_canon("rsc", "rscatter:3 rline:3 rarea:5"))
    _w31_expect U11-04 `"("`u11c'" == "rscatter")"' "_dash_recast_canon(rsc) is `u11c'"
    mata: st_local("u11c", _dash_recast_canon("rs", "rscatter:3 rline:3 rarea:5"))
    _w31_expect U11-04 `"("`u11c'" == "")"' "_dash_recast_canon(rs) is `u11c'"
    _w31_done U11-04 "fitplot(), ciplot() and smoothplot() names read as twoway reads them"

    // ------------------------------------------------------------
    // U11-05: nofit draws the band alone, in the saved page and the
    // served app.
    // ------------------------------------------------------------
    sysuse auto, clear
    dash clear
    capture noisily dash lfitci mpg weight, nofit name(zu115)
    _w31_expect U11-05 "(_rc == 0)" "dash lfitci, nofit rc `=_rc'"
    _dash_serve_spec, specpath("`u11d'/s5n.json") datapath("`u11d'/d5n.json")
    python: _u11_layer("`u11d'/s5n.json", "`u11d'/d5n.json", "zu115")
    _w31_expect U11-05 `"("${u11_vis}" == "0/1 0/1")"' "line/band visible, saved and served: ${u11_vis}"
    _w31_done U11-05 "lfitci, nofit: the band alone in both renderers (${u11_vis})"

    // ------------------------------------------------------------
    // U11-06: estopts() text that may not reach a command line is refused
    // before anything is registered.
    // ------------------------------------------------------------
    sysuse auto, clear
    dash clear
    local nl = char(10)
    local cr = char(13)
    foreach v in `"noconstant; display 1"' `"a`nl'b"' `"a`cr'b"' {
        _u11_run "`lf'" "option estopts() incorrectly specified" dash lfit mpg weight, estopts(`v') name(zu116)
        _w31_expect U11-06 "(r(rc) == 198) & (r(has) == 1)" "estopts() holding a refused character: rc `r(rc)', said `r(has)'"
    }
    // An odd double quote: refused by the command line's own parse first.
    _u11_run "`lf'" "" dash lfit mpg weight, estopts(x" y) name(zu116)
    _w31_expect U11-06 "(r(rc) == 198)" "estopts() holding an odd quote: rc `r(rc)'"
    _w31_expect U11-06 `"(`"${dash_graph_registry}"' == "")"' "the registry holds ${dash_graph_registry}"
    _w31_done U11-06 "estopts() with ; or a line break or an odd quote refused, nothing registered"

    forvalues k = 1/7 {
        foreach p in s d t {
            capture erase "`u11d'/`p'`k'.json"
        }
    }
    foreach f in s5n.json d5n.json u11_app.py {
        capture erase "`u11d'/`f'"
    }
    capture rmdir "`u11d'"
    macro drop u11_ok u11_msg u11_vis
    dash clear
    display as text "S11 end " c(current_date) " " c(current_time)
}
* ==== end S11 ====

// S12 helpers (WP-31 C5).  _u12_draw: what a registered dash graph draws,
// saved and served -- each Quad's width and centre, the first Line's x
// ends and y maximum, each Segment's y0 and y1, the VBar centres and the
// glyph types -- into globals u12_<k>s (saved) and u12_<k>v (served), and
// the spec's stored droplines pairs into u12_drops.  Built on _u03_docs.
python:
def _u12_draw(sp, dp, app):
    import json
    from sfi import Macro
    a, b = _u03_docs(sp, dp, app)
    for figs, sfx in ((a, "s"), (b, "v")):
        out = {"k": [], "qw": [], "qc": [], "lx0": [], "lx1": [], "ly": [],
               "sy0": [], "sy1": [], "bx": []}
        for f in figs:
            for r in f.renderers:
                g = getattr(r, "glyph", None)
                t = type(g).__name__
                d = getattr(r.data_source, "data", {})
                if t not in ("Quad", "Line", "Segment", "VBar", "Patch",
                             "VArea"):
                    continue
                out["k"].append(t)
                if t == "Quad":
                    for lo, hi in zip(d["left"], d["right"]):
                        out["qw"].append("%.15g" % (float(hi) - float(lo)))
                        out["qc"].append("%.15g" % ((float(hi) + float(lo)) / 2))
                elif t == "Line" and not out["lx0"]:
                    xs = [float(v) for v in d[g.x if isinstance(g.x, str) else g.x.field]]
                    ys = [float(v) for v in d[g.y if isinstance(g.y, str) else g.y.field]]
                    if xs:
                        out["lx0"].append("%.17g" % xs[0])
                        out["lx1"].append("%.17g" % xs[-1])
                        out["ly"].append("%.17g" % max(ys))
                elif t == "Segment":
                    out["sy0"] += ["%.15g" % float(v) for v in d["y0"]]
                    out["sy1"] += ["%.15g" % float(v) for v in d["y1"]]
                elif t == "VBar":
                    xf = g.x if isinstance(g.x, str) else g.x.field
                    out["bx"] += ["%.15g" % float(v) for v in d[xf]]
        for k, v in out.items():
            Macro.setGlobal("u12_%s%s" % (k, sfx), " ".join(v))
    with open(sp, encoding="utf-8") as fh:
        spec = json.load(fh)
    drops = []
    for g in (spec.get("function_points") or {}).values():
        for pts in g.values():
            for x, y in pts.get("drops", []):
                drops.append("%.15g %.15g" % (x, y))
    Macro.setGlobal("u12_drops", " ".join(drops))
end

capture program drop _u12_reg
program define _u12_reg
    // _u12_reg <dir> <k> <dash command...>: register one graph, write its
    // spec and data, and read what both modes draw (_u12_draw).
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    dash clear
    quietly dash `0'
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u12_m; _u12_m._u12_draw("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py")
end

capture program drop _u12_ser
program define _u12_ser, rclass
    // _u12_ser <graph>: plot 1's serset of a drawn twoway graph -- the
    // min and max of its first and second variables (r(min1) .. r(max2)).
    version 19
    args g
    local id "`.`g'.plotregion1.plot1.serset.id'"
    preserve
    quietly serset set `id'
    quietly serset use, clear
    unab vs : _all
    local i 0
    foreach v of local vs {
        local ++i
        quietly summarize `v'
        return scalar min`i' = r(min)
        return scalar max`i' = r(max)
    }
    restore
end

capture program drop _u12_refuse
program define _u12_refuse
    // _u12_refuse <id> <log> <message> | <command...>: twoway's and
    // dash's return codes for the command, and dash's log holds the
    // message twoway printed.
    version 19
    gettoken id 0 : 0
    gettoken lf 0 : 0
    gettoken msg 0 : 0
    capture graph drop _all
    capture noisily twoway `0' nodraw
    local tw = _rc
    dash clear
    quietly log using "`lf'", text replace name(u12r)
    capture noisily dash `0'
    local dr = _rc
    quietly log close u12r
    cert_log_has "`lf'", needle(`"`msg'"')
    _w31_expect `id' "(`tw' == `dr') & (`tw' != 0) & (r(found))" `"`0': twoway r(`tw'), dash r(`dr'), dash said "`msg'" `r(count)' times"'
end

* ==== S12 C5: distribution, area and bar odds ====
local only : env WP31_ONLY
if inlist("`only'", "", "S12") & `: list posof "S12" in w31_run' {
    display as text "S12 start " c(current_date) " " c(current_time)
    local u12d "`w31_work'/s12"
    capture mkdir "`u12d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear

    // ------------------------------------------------------------
    // U12-01: histogram gap(20): dash's bars are twoway's bar_size wide,
    // both modes; gap(20) gap(30) is taken twice, the rightmost standing.
    // ------------------------------------------------------------
    quietly twoway histogram mpg, gap(20) name(u12t, replace)
    local bs = `.u12t.plotregion1.plot1.bar_size'
    _u12_reg "`u12d'" 1 histogram mpg, gap(20) name(zu1)
    _u03_all `bs' ${u12_qws} ${u12_qwv}
    _w31_expect U12-01 "(r(ok))" "gap(20) widths saved ${u12_qws} served ${u12_qwv}, twoway bar_size `bs'"
    capture noisily twoway histogram mpg, gap(20) gap(30) name(u12t, replace)
    local tw = _rc
    local bs = `.u12t.plotregion1.plot1.bar_size'
    _u12_reg "`u12d'" 2 histogram mpg, gap(20) gap(30) name(zu2)
    _u03_all `bs' ${u12_qws} ${u12_qwv}
    _w31_expect U12-01 "(`tw' == 0) & (r(ok))" "gap(20) gap(30): twoway r(`tw') bar_size `bs', dash ${u12_qws}"
    _w31_done U12-01 "histogram gap(20) draws bars twoway's bar_size wide (saved and served); a second gap() stands"

    // ------------------------------------------------------------
    // U12-02: the refusals, in twoway's code and words.
    // ------------------------------------------------------------
    local lf "`u12d'/r.log"
    _u12_refuse U12-02 "`lf'" "option gap() must be between 0 and 100" histogram mpg, gap(100)
    _u12_refuse U12-02 "`lf'" "option gap() must be between 0 and 100" histogram mpg, gap(-1)
    _u12_refuse U12-02 "`lf'" "option area() expects a positive number" kdensity mpg, area(0)
    _u12_refuse U12-02 "`lf'" "only one of options range() or boundary is allowed" kdensity mpg, boundary range(10 30)
    _u12_refuse U12-02 "`lf'" "some droplines not within range() option" function y = x, range(0 1) droplines(2)
    _u12_refuse U12-02 "`lf'" "option boundary not allowed" kdensity mpg, boundary boundary
    _u12_refuse U12-02 "`lf'" "option nodropbase not allowed" area mpg weight, nodropbase nodropbase
    _u12_refuse U12-02 "`lf'" "option area() not allowed" histogram mpg, area(2)
    _w31_done U12-02 "gap(100), gap(-1), area(0), boundary with range(), a dropline outside range(), boundary twice, nodropbase twice and area() on histogram are refused as twoway refuses them"

    // ------------------------------------------------------------
    // U12-03: kdensity area(74) is 74 times the density and twoway's
    // curve; boundary's grid runs over twoway's x span.
    // ------------------------------------------------------------
    _u12_reg "`u12d'" 3 kdensity mpg, name(zu3)
    local y0s "${u12_lys}"
    _u12_reg "`u12d'" 4 kdensity mpg, area(74) name(zu4)
    _w31_expect U12-03 "(abs(${u12_lys} / `y0s' - 74) < 1e-9) & (abs(${u12_lyv} / `y0s' - 74) < 1e-9)" "area(74) max saved ${u12_lys} served ${u12_lyv}, plain `y0s'"
    quietly twoway kdensity mpg, area(74) name(u12t, replace)
    _u12_ser u12t
    local ty = r(max1)
    _w31_expect U12-03 "(abs(${u12_lys} / `ty' - 1) < 1e-6)" "area(74) max dash ${u12_lys}, twoway `ty'"
    foreach o in "boundary" "boundary bwidth(2)" {
        quietly twoway kdensity mpg, `o' name(u12t, replace)
        _u12_ser u12t
        local tx0 = r(min2)
        local tx1 = r(max2)
        _u12_reg "`u12d'" 5 kdensity mpg, `o' name(zu5)
        _w31_expect U12-03 "(abs(${u12_lx0s} - `tx0') < 1e-9) & (abs(${u12_lx1s} - `tx1') < 1e-9) & (abs(${u12_lx0v} - `tx0') < 1e-9) & (abs(${u12_lx1v} - `tx1') < 1e-9)" "`o': dash x ${u12_lx0s}..${u12_lx1s} (served ${u12_lx0v}..${u12_lx1v}), twoway `tx0'..`tx1'"
    }
    _w31_done U12-03 "kdensity area(74) scales the density 74 times as twoway does; boundary spans twoway's x range, saved and served"

    // ------------------------------------------------------------
    // U12-04: function droplines(-1 1) base(1): the stored pairs are
    // twoway's .droplines; both modes draw the Segments from y = 1.
    // ------------------------------------------------------------
    quietly twoway function y = x^2, range(-2 2) droplines(-1 1) base(1) name(u12t, replace)
    local tdl `"`.u12t.plotregion1.plot1.droplines'"'
    local tdl : subinstr local tdl `"""' "", all
    local tdl : list retok tdl
    _u12_reg "`u12d'" 6 function y = x^2, range(-2 2) droplines(-1 1) base(1) name(zu6)
    _w31_expect U12-04 `"("${u12_drops}" == "`tdl'")"' "stored drops ${u12_drops}, twoway `tdl'"
    _w31_expect U12-04 `"("${u12_sy0s}" == "1 1") & ("${u12_sy0v}" == "1 1") & ("${u12_sy1s}" == "1 1")"' "Segment y0 ${u12_sy0s} / ${u12_sy0v}, y1 ${u12_sy1s}"
    _w31_done U12-04 "function droplines(-1 1) base(1) stores twoway's pairs and draws the drops from y = 1, saved and served"

    // ------------------------------------------------------------
    // U12-05: function base(abc): twoway's code and sentence.
    // ------------------------------------------------------------
    _u12_refuse U12-05 "`lf'" "option base() incorrectly specified, abc is not a number" function y = x^2, base(abc)
    _w31_done U12-05 "function base(abc) is refused with twoway's code and sentence"

    // ------------------------------------------------------------
    // U12-06: area nodropbase is a Patch in both modes; twoway's
    // drop_base is no.
    // ------------------------------------------------------------
    quietly twoway area mpg weight, nodropbase name(u12t, replace)
    local tdb "`.u12t.plotregion1.plot1.drop_base.stylename'"
    _u12_reg "`u12d'" 7 area mpg weight, nodropbase name(zu7)
    _w31_expect U12-06 `"("`tdb'" == "no") & ("${u12_ks}" == "Patch") & ("${u12_kv}" == "Patch")"' "twoway drop_base `tdb', dash ${u12_ks} / ${u12_kv}"
    _w31_done U12-06 "area nodropbase draws one Patch closed on its chord, saved and served"

    // ------------------------------------------------------------
    // U12-07: bar baroffset(.5): each centre x + .5 * bar_size.
    // ------------------------------------------------------------
    quietly twoway bar mpg weight in 1/5, baroffset(.5) name(u12t, replace)
    local tbs = `.u12t.plotregion1.plot1.bar_size'
    local tbo = `.u12t.plotregion1.plot1.bar_offset'
    local want ""
    forvalues i = 1/5 {
        local want "`want' `=strofreal(weight[`i'] + `tbo' * `tbs', "%15.0g")'"
    }
    local want : list retok want
    _u12_reg "`u12d'" 8 bar mpg weight in 1/5, baroffset(.5) name(zu8)
    _w31_expect U12-07 `"("${u12_bxs}" == "`want'") & ("${u12_bxv}" == "`want'")"' "centres saved ${u12_bxs} served ${u12_bxv}, twoway `want'"
    _w31_done U12-07 "bar baroffset(.5) moves each bar half a bar, as twoway's bar_offset * bar_size"

    capture erase "`lf'"
    forvalues k = 1/8 {
        foreach p in s d {
            capture erase "`u12d'/`p'`k'.json"
        }
        capture erase "`u12d'/a`k'.py"
    }
    capture rmdir "`u12d'"
    capture graph drop u12t
    dash clear
    display as text "S12 end " c(current_date) " " c(current_time)
}
* ==== end S12 ====

// S16 helpers (WP-31 F1c).  _u16_move: the saved page's lowess line after
// one filter move -- the page rendered, the widget set and its own
// callback run under node (test/js_runner.py) -- written to a JSON file,
// its point count in global u16_n.  _u16_gen_compare: the saved line
// against Stata's lowess, gen() variable *s* on the rows where *touse* is
// 1 and *s* is not missing, in the data's current order (sorted stably by
// x); global u16_ok 1 or 0 and u16_msg.  _u16_said: does a log hold *text*.
python:
def _u16_move(sp, dp, kind, value, out):
    import json
    import os
    import sys
    import warnings
    if os.getcwd() not in sys.path:
        sys.path.insert(0, os.getcwd())
    import dash_render as dr
    import js_runner
    from sfi import Macro
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
    w = [m for m in r.filter_widgets if type(m).__name__ == kind][0]
    if kind == "Select":
        w.value = [v for v, lab in w.options if lab == value][0]
    elif kind == "RangeSlider":
        w.value = tuple(float(v) for v in value.split())
    else:
        w.value = float(value)
    cb = r.filter_callbacks[r.filter_widgets.index(w)]
    js_runner.JsSession(r.filter_callbacks).run(cb)
    lw = [x for f in r.figures.values() for x in f.renderers
          if (getattr(x, "_dash_agg_config", None) or {}).get("type")
          == "lowess"]
    d = lw[0].data_source.data
    with open(out, "w", encoding="utf-8") as fh:
        json.dump({"x": [float(v) for v in d["x_lw"]],
                   "y": [float(v) for v in d["y_lw"]]}, fh)
    Macro.setGlobal("u16_n", str(len(d["x_lw"])))


def _u16_gen_compare(saved, xvar, svar, touse, rtol):
    import json
    import numpy as np
    from sfi import Data, Macro
    g = json.load(open(saved, encoding="utf-8"))
    gx, gy = np.asarray(g["x"], float), np.asarray(g["y"], float)
    miss = lambda v: v is None or v >= 8.98e307
    xs, ss = [], []
    for x, s, t in zip(Data.get(var=xvar), Data.get(var=svar),
                       Data.get(var=touse)):
        if t == 1 and not miss(s) and not miss(x):
            xs.append(float(x))
            ss.append(float(s))
    tx, ty = np.asarray(xs), np.asarray(ss)
    ok = 0
    if len(tx) != len(gx):
        msg = "%d saved points, Stata %d" % (len(gx), len(tx))
    elif not len(tx):
        msg = "no points"
    else:
        dx = float(np.max(np.abs(gx - tx) / np.maximum(np.abs(tx), 1.0)))
        dy = float(np.max(np.abs(gy - ty) / np.maximum(np.abs(ty), 1.0)))
        ok = int(dx <= rtol and dy <= rtol)
        msg = "%d points, largest relative difference x %.3g y %.3g" % (
            len(gx), dx, dy)
    Macro.setGlobal("u16_ok", str(ok))
    Macro.setGlobal("u16_msg", msg)


def _u16_said(log, text):
    from sfi import Macro
    with open(log, encoding="utf-8", errors="replace") as fh:
        Macro.setGlobal("u16_said", "1" if text in fh.read() else "0")
end

* ==== S16 F1c: lowess re-smooths on the saved page ====
local only : env WP31_ONLY
if inlist("`only'", "", "S16") & `: list posof "S16" in w31_run' {
    display as text "S16 start " c(current_date) " " c(current_time)
    local u16d "`w31_work'/s16"
    capture mkdir "`u16d'"
    capture graph drop _all

    // ------------------------------------------------------------
    // U16-01..04: after a move the saved smooth is Stata's lowess on the
    // kept rows (gen(), sorted stably by x): the default after the
    // dropdown to Foreign; bwidth(.4) mean after the range to
    // 4500-11385; noweight adjust after the dropdown to Domestic (adjust's
    // mean is all 74 cars', in both); logit on foreign, constant 0 among
    // the Domestic cars.
    // ------------------------------------------------------------
    local k 0
    foreach c in "U16-01|(scatter mpg weight) (lowess mpg weight)|foreign, type(dropdown)|Select|Foreign|mpg|foreign == 1|" "U16-02|(lowess mpg weight, bwidth(.4) mean)|price, type(range)|RangeSlider|4500 11385|mpg|inrange(price, 4500, 11385)|bwidth(.4) mean" "U16-03|(lowess mpg weight, noweight adjust)|foreign, type(dropdown)|Select|Domestic|mpg|foreign == 0|noweight adjust" "U16-04|(lowess foreign weight, logit)|foreign, type(dropdown)|Select|Domestic|foreign|foreign == 0|logit" {
        local ++k
        mata: u16_t = ustrsplit(st_local("c"), "[|]"); st_local("id", u16_t[1]); st_local("cmd", u16_t[2]); st_local("filt", u16_t[3]); st_local("kind", u16_t[4]); st_local("val", u16_t[5]); st_local("yv", u16_t[6]); st_local("cond", u16_t[7]); st_local("lo", u16_t[8])
        sysuse auto, clear
        dash clear
        capture noisily dash `cmd', name(zu16`k')
        _w31_expect `id' "(_rc == 0)" "dash `cmd' rc `=_rc'"
        _dash_serve_spec, specpath("`u16d'/s`k'.json") datapath("`u16d'/d`k'.json") filter(`filt')
        python: _u16_move("`u16d'/s`k'.json", "`u16d'/d`k'.json", "`kind'", "`val'", "`u16d'/g`k'.json")
        quietly lowess `yv' weight if `cond', `lo' generate(u16s) nograph
        quietly generate byte u16u = (`cond')
        quietly generate long u16o = _n
        sort weight u16o
        python: _u16_gen_compare("`u16d'/g`k'.json", "weight", "u16s", "u16u", 1e-8)
        _w31_expect `id' "(${u16_ok} == 1)" "dash `cmd', filter(`filt') moved to `val': ${u16_msg}"
        _w31_done `id' "the saved `cmd' after the move to `val' is lowess `yv' weight if `cond', `lo' (${u16_msg})"
    }

    // ------------------------------------------------------------
    // U16-05: a move leaving two rows empties the saved smooth; twoway
    // lowess on them draws nothing, rc 0, in silence.
    // ------------------------------------------------------------
    sysuse auto, clear
    dash clear
    capture noisily dash (scatter mpg weight) (lowess mpg weight), name(zu165)
    _w31_expect U16-05 "(_rc == 0)" "dash lowess rc `=_rc'"
    _dash_serve_spec, specpath("`u16d'/s5.json") datapath("`u16d'/d5.json") filter(price, type(slider))
    python: _u16_move("`u16d'/s5.json", "`u16d'/d5.json", "Slider", "14500", "`u16d'/g5.json")
    quietly count if price >= 14500
    local nk = r(N)
    _w31_expect U16-05 "(`nk' == 2)" "price >= 14500 keeps `nk' rows"
    _w31_expect U16-05 "(${u16_n} == 0)" "the saved lowess after the slider to 14500 holds ${u16_n} points"
    local lf "`u16d'/t5.log"
    quietly log using "`lf'", text replace name(u16l)
    capture noisily twoway lowess mpg weight if price >= 14500, nodraw
    local trc = _rc
    quietly log close u16l
    python: _u16_said("`lf'", "(note:")
    _w31_expect U16-05 "(`trc' == 0 & ${u16_said} == 0)" "twoway lowess on two rows: rc `trc', note ${u16_said}"
    _w31_done U16-05 "two kept rows: the saved smooth is empty; twoway draws none (rc `trc', no note)"

    forvalues k = 1/5 {
        foreach p in s d g {
            capture erase "`u16d'/`p'`k'.json"
        }
    }
    capture erase "`lf'"
    capture rmdir "`u16d'"
    macro drop u16_n u16_ok u16_msg u16_said
    capture mata: mata drop u16_t
    capture graph drop _all
    dash clear
    display as text "S16 end " c(current_date) " " c(current_time)
}
* ==== end S16 ====

* ==== append new blocks above this line ====

// ----------------------------------------------------------------
// Summary (test_wp29_truth.cscript's shape)
// ----------------------------------------------------------------
capture graph drop _all
capture dash clear
capture rmdir "`w31_work'"
local nfail    = ${w31_nfail}
local faillist "${w31_faillist}"
local ncase    = ${w31_ncase}
local only : env WP31_ONLY
macro drop w31_nfail w31_faillist w31_bad w31_ncase
display as text ""
display as text "============================================================"
if `ncase' == 0 {
    if `w31_N' > 1 & `"`macval(only)'"' == "" & "`w31_run'" == "" {
        display as text "test_wp31_truth: part `w31_k'/`w31_N' has no block to run"
        display as text "============================================================"
        exit 0
    }
    // A WP31_ONLY that names no block, or only a stub, ran nothing:
    // that is not a pass.
    display as error "  test_wp31_truth: no case ran (WP31_ONLY=`only')"
    display as text "============================================================"
    exit 9
}
else if `nfail' == 0 {
    display as text "  test_wp31_truth: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_wp31_truth: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
