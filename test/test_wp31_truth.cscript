def _u41_ciplot(sp, dp, app, svg):
    """U41-14: ciplot(rline)'s two limit Lines, saved and served, are the
    band colour twoway strokes (the path colour that is not the fit's)."""
    import re
    from sfi import Macro
    with open(svg, encoding="utf-8") as fh:
        cols = [c.lower() for c in re.findall(r'<path [^>]*style="fill:none;stroke:(#[0-9A-Fa-f]{6})', fh.read())]
    (a, b), _ = _u41_glyphs(sp, dp, app, "Line")
    bad = []
    for name, gs in (("saved", a), ("served", b)):
        got = [str(g.line_color).lower() for g in gs]
        if len(got) != 3 or got[2] not in cols or {got[0], got[1]} != set(cols) - {got[2]}:
            bad.append("%s %s, twoway %s" % (name, got, cols))
    prev = Macro.getGlobal("u41_bad")
    Macro.setGlobal("u41_bad", "; ".join([prev] * bool(prev) + bad))
end

python:
def _u41_ciall(sp, dp, app, svg, fit):
    """U41-16: the colours dash draws a ciplot() view in, saved and
    served, against every fill and stroke twoway's SVG holds but the
    chrome and the fit's."""
    import re
    import dash_render as dr
    from sfi import Macro
    chrome = {"", "none", "#eaf2f3", "#ffffff", "#f0f0f0", "#000000", fit}
    with open(svg, encoding="utf-8") as fh:
        txt = fh.read()
    want = {c.lower() for c in re.findall(r'(?:fill|stroke):(#[0-9A-Fa-f]{6})', txt)} - chrome
    a, b = __import__("__main__")._u03_docs(sp, dp, app)
    bad = []
    for name, figs in (("saved", a), ("served", b)):
        got = set()
        for r in figs[0].renderers:
            g = getattr(r, "glyph", None)
            if g is None or dr._dash_is_swatch(r):
                continue
            k = type(g).__name__
            if k in ("Line", "Segment"):
                got.add(str(g.line_color).lower())
            elif k in ("Scatter", "VBar", "VArea"):
                got.add(str(g.fill_color).lower())
        got -= chrome
        if got != want:
            bad.append("%s %s, twoway %s" % (name, sorted(got), sorted(want)))
    prev = Macro.getGlobal("u41_bad")
    Macro.setGlobal("u41_bad", "; ".join([prev] * bool(prev) + bad))
end

* ==== S41 C4b: fitplot() and ciplot() colours ====
local only : env WP31_ONLY
if inlist("`only'", "", "S41") & `: list posof "S41" in w31_run' {
    display as text "S41 start " c(current_date) " " c(current_time)
    local u41d "`w31_work'/s41f"
    capture mkdir "`u41d'"
    sysuse auto, clear

    // U41-14: lfitci ..., ciplot(rline) draws the limits in the band's
    // outline colour and the fit in p1, saved and served, as twoway
    // (live) under s2color and stcolor.
    global u41_bad ""
    local k 140
    foreach sch in s2color stcolor {
        local ++k
        capture graph drop u41t
        quietly twoway lfitci mpg weight, ciplot(rline) scheme(`sch') name(u41t, replace)
        quietly graph export "`u41d'/t`k'.svg", replace
        graph drop u41t
        _u41_spec "`u41d'" `k' lfitci mpg weight, ciplot(rline) scheme(`sch')
        python: import __main__ as _u41_m; _u41_m._u41_ciplot("`u41d'/s`k'.json", "`u41d'/d`k'.json", "`u41d'/a`k'.py", "`u41d'/t`k'.svg")
    }
    _w31_expect U41-14 `"(`"${u41_bad}"' == "")"' `"${u41_bad}"'
    _w31_done U41-14 "ciplot(rline) draws the limits in the band's outline colour, saved and served, as twoway"

    // U41-16: every other view ciplot() takes is drawn in the ci series
    // style (ci_arealine, ci_line, ci_symbol, ci_area), as twoway (live).
    global u41_bad ""
    local k 160
    foreach t in rbar rspike rcapsym rscatter rconnected scatter line bar dot {
        local ++k
        capture graph drop u41t
        quietly twoway lfitci mpg weight, ciplot(`t') scheme(s2color) name(u41t, replace)
        quietly graph export "`u41d'/t`k'.svg", replace
        graph drop u41t
        _u41_spec "`u41d'" `k' lfitci mpg weight, ciplot(`t') scheme(s2color)
        python: import __main__ as _u41_m; _u41_m._u41_ciall("`u41d'/s`k'.json", "`u41d'/d`k'.json", "`u41d'/a`k'.py", "`u41d'/t`k'.svg", "#1a476f")
    }
    _w31_expect U41-16 `"(`"${u41_bad}"' == "")"' `"${u41_bad}"'
    _w31_done U41-16 "ciplot() with rbar, rspike, rcapsym, rscatter, rconnected, scatter, line, bar and dot draws twoway's ci colours, saved and served"
    display as text "S41 end " c(current_date) " " c(current_time)
}
* ==== end S41 ====

* ==== S41 C17b: lalign()'s abbreviations ====
local only : env WP31_ONLY
if inlist("`only'", "", "S41") & `: list posof "S41" in w31_run' {
    display as text "S41 start " c(current_date) " " c(current_time)
    sysuse auto, clear

    // U41-15: la() .. lalign() are lalign() in both (live twoway rc and
    // its align setting beside dash's rc and spec); lalp() is twoway's
    // r(198) and dash's too (WP-35 DT-15).
    local bad ""
    local k 150
    foreach ab in la lal lali lalig lalign {
        local ++k
        capture graph drop Graph
        capture twoway line mpg weight, sort `ab'(outside)
        local trc = _rc
        local tset ""
        if !`trc' local tset "`.Graph.plotregion1.plot1.style.line.align.setting'"
        capture graph drop Graph
        dash clear
        capture dash line mpg weight, sort `ab'(outside) name(zu41`k')
        local drc = _rc
        mata: st_local("dhas", strofreal(strpos(st_global("dash_json_zu41`k'"), char(34) + "lalign" + char(34) + ":" + char(34) + "outside" + char(34)) > 0))
        if `trc' | "`tset'" != "outside" | `drc' | !`dhas' local bad `"`bad' [`ab': twoway `trc' `tset', dash `drc' `dhas']"'
    }
    capture twoway line mpg weight, sort lalp(50)
    local trc = _rc
    dash clear
    // Flipped (WP-35 DT-15): dash reading lalp() as its lalpha() was
    // wrong; twoway refuses it, and the maintainer ruled that dash mirrors
    // twoway (DECISIONS.md P4-7).
    capture dash line mpg weight, sort lalp(50) name(zu41159)
    local drc = _rc
    if `trc' != 198 | `drc' != 198 local bad `"`bad' [lalp: twoway `trc', dash `drc']"'
    _w31_expect U41-15 `"(`"`bad'"' == "")"' `"`bad'"'
    _w31_done U41-15 "la() lal() lali() lalig() lalign() are lalign(), as twoway reads them; lalp() is refused by both"
    display as text "S41 end " c(current_date) " " c(current_time)
}
* ==== end S41 ====

python:
def _u42_titles(sp, dp, app):
    """Every Title text both modes draw for the spec, as two globals
    (u42_s, u42_v) joined by char(1), and how many notes on graph text
    each mode raised (u42_ns, u42_nv)."""
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    from bokeh.models import Title
    from sfi import Macro
    with warnings.catch_warnings(record=True) as ws:
        warnings.simplefilter("always")
        r = dr.DashRenderer(sp, dp)
        r.render()
    ns = len([w for w in ws if "Text in graphs" in str(w.message)])
    with warnings.catch_warnings(record=True) as wv:
        warnings.simplefilter("always")
        dr.ServerAppBuilder(sp, dp).build(app)
        with open(app, encoding="utf-8") as fh:
            src = fh.read()
        attach = "if __name__ != '__main__':\n    make_document(curdoc())"
        g = dict(__name__="dash_u42_app")
        exec(compile(src.replace(attach, "pass"), "dash_u42_app.py", "exec"), g)
        doc = Document()
        g["make_document"](doc)
    nv = len([w for w in wv if "Text in graphs" in str(w.message)])
    figs = {"s": list(r.figures.values()),
            "v": [m for m in doc.models if type(m).__name__ == "figure"]}
    for sfx, fl in figs.items():
        texts = []
        for f in fl:
            for m in f.references():
                if isinstance(m, Title) and m.text:
                    texts.append(m.text)
        Macro.setGlobal("u42_" + sfx, "\x01".join(texts))
    Macro.setGlobal("u42_ns", str(ns))
    Macro.setGlobal("u42_nv", str(nv))


def _u42_check(fx, key, variant, today):
    """u42_ok 1 when both modes draw the fixture's text for the key (for
    {ccl current_date}, today's date where twoway drew its own)."""
    import json
    from sfi import Macro
    d = json.load(open(fx, encoding="utf-8"))
    rec = d[key] if variant == "main" else d[key]["variants"][variant]
    want = rec["text"]
    if key == "smcl.ccl" and variant == "main":
        want = want.replace(rec["current_date"], today)
    got = [Macro.getGlobal("u42_" + m).split("\x01") for m in ("s", "v")]
    ok = all(want in g for g in got)
    Macro.setGlobal("u42_ok", "1" if ok else "0")
    Macro.setGlobal("u42_got", repr(got)[:200] + " want " + repr(want)[:80])


def _u42_typed(fx, key, variant):
    import json
    from sfi import Macro
    d = json.load(open(fx, encoding="utf-8"))
    rec = d[key] if variant == "main" else d[key]["variants"][variant]
    Macro.setGlobal("u42_typed", rec["typed"])
end

capture program drop _u42_reg
program define _u42_reg
    // _u42_reg <dir> <k> <fixture> <key> <variant>: _u42_draw on the
    // key's typed text.
    version 19
    args dir k fx key variant
    python: import __main__ as _u42_m; _u42_m._u42_typed(r"`fx'", "`key'", "`variant'")
    _u42_draw "`dir'" `k'
end

capture program drop _u42_draw
program define _u42_draw
    // _u42_draw <dir> <k>: register a scatter whose title is ${u42_typed}
    // and read the titles and graph-text notes both modes draw.
    version 19
    args dir k
    dash clear
    capture noisily dash scatter mpg weight, title(`"${u42_typed}"') name(u42g`k')
    if _rc exit _rc
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u42_m; _u42_m._u42_titles("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py")
end

python:
def _u42_texts(sp, dp, app):
    """Every text both modes draw (titles, labels, axis titles, tick
    labels, legend keys), as two lists on the module (_u42_drawn)."""
    import json as _json
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
        with open(app, encoding="utf-8") as fh:
            src = fh.read()
        attach = "if __name__ != '__main__':\n    make_document(curdoc())"
        g = dict(__name__="dash_u42g_app")
        exec(compile(src.replace(attach, "pass"), "dash_u42g_app.py", "exec"), g)
        doc = Document()
        g["make_document"](doc)
    out = []
    for models in ([m for f in r.figures.values() for m in f.references()],
                   list(doc.models)):
        texts = []
        for m in models:
            for a in ("text", "axis_label", "title"):
                v = getattr(m, a, None)
                if isinstance(v, str):
                    texts.append(v)
            lab = getattr(m, "label", None)
            if isinstance(lab, dict) and isinstance(lab.get("value"), str):
                texts.append(lab["value"])
            elif isinstance(getattr(lab, "value", None), str):
                texts.append(lab.value)
            ov = getattr(m, "major_label_overrides", None)
            if isinstance(ov, dict):
                texts.extend(v for v in ov.values() if isinstance(v, str))
            args = getattr(m, "args", None)
            if isinstance(args, dict) and isinstance(args.get("labels"), str):
                try:
                    texts.extend(_json.loads(args["labels"]).values())
                except ValueError:
                    pass
        out.append(texts)
    import __main__
    __main__._u42_drawn = out


def _u42_gcheck(fx, kind):
    """u42_gbad: the options whose drawn text (its first line) differs
    from twoway's for this kind of global.  Z<i>: marks the i-th option of
    the fixture's order; an =exp global is evaluated as twoway evaluates
    it (WP-43 LT-20, P4-7); an option twoway refuses with the kind (rc
    198) was left out of the command."""
    import json
    import __main__
    from sfi import Macro
    d = json.load(open(fx, encoding="utf-8"))
    bad = []
    for i, c in enumerate([c for c in d["cases"] if c["kind"] == kind]):
        if c["rc"]:
            continue
        # Flipped: the eval kind drawn as written was wrong because twoway
        # evaluates a graph text option's =exp global and dash does too
        # (WP-43 LT-20, P4-7).
        want = c["drawn"][0]
        pre = "Z%d:" % (i + 1)
        for mode, texts in zip(("s", "v"), __main__._u42_drawn):
            got = sorted({t[len(pre):].split("\n")[0] for t in texts
                          if t.startswith(pre)})
            if got != [want]:
                bad.append("%s/%s:%r" % (c["option"], mode, got[:2]))
    Macro.setGlobal("u42_gbad", " ".join(bad)[:600])


def _u42_mcheck(fx, keys):
    """u42_mbad: each text twoway drew for the keys (smcl_more_truth.json)
    that one of the modes does not draw."""
    import json
    import __main__
    from sfi import Macro
    d = json.load(open(fx, encoding="utf-8"))
    bad = []
    for key in keys.split():
        for want in d[key]["texts"]:
            for mode, texts in zip(("s", "v"), __main__._u42_drawn):
                if want not in texts:
                    bad.append("%s/%s:%r" % (key, mode, want))
    Macro.setGlobal("u42_mbad", " ".join(bad)[:600])
end

capture program drop _u42_gread
program define _u42_gread
    // _u42_gread <dir> <k> <graph>: the texts both modes draw for the
    // registered graph (the module's _u42_drawn).
    version 19
    args dir k
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u42_m; _u42_m._u42_texts("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py")
end

* ==== S42 E9: SMCL inline runs ====
local only : env WP31_ONLY
if inlist("`only'", "", "S42") & `: list posof "S42" in w31_run' {
    display as text "S42 start " c(current_date) " " c(current_time)
    local u42d "`w31_work'/s42"
    capture mkdir "`u42d'"
    local u42fx "`c(pwd)'/fixtures/smcl_text_truth.json"
    sysuse auto, clear

    // U42-01: the fixture is stamped and holds its 17 keys.
    capture confirm file "`u42fx'"
    local frc = _rc
    _w31_expect U42-01 "`frc' == 0" "fixtures/smcl_text_truth.json missing"
    if `frc' == 0 {
        python: import json; from sfi import Macro; _d = json.load(open(r"`u42fx'")); Macro.setGlobal("u42_n", str(len([k for k in _d if k != "_meta"]))); Macro.setGlobal("u42_m", " ".join(sorted(_d["_meta"])))
        _w31_expect U42-01 `"(${u42_n} == 17) & ("${u42_m}" == "born_date dash_commit extracted source stata_version")"' "keys ${u42_n} meta ${u42_m}"
    }
    _w31_done U42-01 "smcl_text_truth.json is stamped and holds 17 keys"

    // U42-02: each directive's title, registered through dash.ado and
    // drawn by both modes, is twoway's text ({ccl} expanded at
    // registration: today's date, c(pi), an unknown name as nothing).
    local k 0
    local bad ""
    foreach kv in smcl.hline:main smcl.hline5:main smcl.space3:main ///
        smcl.dup3:main smcl.dup3:styled smcl.cmd:main smcl.hi:main ///
        smcl.ccl:main smcl.ccl:pi smcl.ccl:nosuch smcl.ccl:colon ///
        smcl.center:main smcl.center:width smcl.browse:main ///
        smcl.help:main smcl.stata:main smcl.dup_big:main smcl.dup_big:d300 {
        local ++k
        gettoken key variant : kv, parse(":")
        local variant = substr("`variant'", 2, .)
        capture noisily _u42_reg "`u42d'" `k' "`u42fx'" `key' `variant'
        if _rc {
            local bad "`bad' `kv'(rc `=_rc')"
            continue
        }
        python: import __main__ as _u42_m; _u42_m._u42_check(r"`u42fx'", "`key'", "`variant'", "`c(current_date)'")
        if "${u42_ok}" != "1" {
            local bad "`bad' `kv'"
            display as text _asis `"  `kv': ${u42_got}"'
        }
    }
    _w31_expect U42-02 `"("`bad'" == "")"' "titles differ from twoway's:`bad'"
    _w31_done U42-02 "every SMCL directive's title is drawn as twoway draws it, saved and served"

    // U42-03: {dup 1000:x} is drawn as typed, as twoway draws it (its
    // count is past 999), and nothing is noted; 25 {hline 200} stop at
    // 4,000 characters and say so once.
    local ++k
    capture noisily _u42_reg "`u42d'" `k' "`u42fx'" smcl.dup_big main
    local r1 = _rc
    python: import __main__ as _u42_m; _u42_m._u42_check(r"`u42fx'", "smcl.dup_big", "main", "")
    local ok1 "${u42_ok}"
    local ++k
    local n1 = ${u42_ns} + ${u42_nv}
    global u42_typed = 25 * "{hline 200}"
    capture noisily _u42_draw "`u42d'" `k'
    local r2 = _rc
    local n2 "${u42_ns}${u42_nv}"
    _w31_expect U42-03 `"(`r1' == 0) & ("`ok1'" == "1") & (`n1' == 0) & (`r2' == 0) & ("`n2'" == "11")"' "dup1000 rc `r1' drawn `ok1' notes `n1'; budget rc `r2' notes `n2'"
    _w31_done U42-03 "{dup 1000:x} is drawn as typed as twoway does; an expansion past 4,000 characters is cut and noted once"

    // U42-04: a {bf:} on part of a title is noted once; the help names
    // the measured example.
    local ++k
    capture noisily _u42_reg "`u42d'" `k' "`u42fx'" inline.bf_part main
    local r1 = _rc
    local n1 "${u42_ns}${u42_nv}"
    cert_file_has "`c(pwd)'/../dash.sthlp", needle(`"title("a {c -(}bf:b{c )-} c")"')
    local h1 = r(found)
    cert_file_has "`c(pwd)'/../dash.sthlp", needle("{c -(}sup:q{c )-}")
    local h2 = r(found)
    _w31_expect U42-04 `"(`r1' == 0) & ("`n1'" == "11") & (`h1' == 1) & (`h2' == 1)"' "rc `r1' notes `n1' help bf `h1' sup `h2'"
    _w31_done U42-04 "a style tag on part of a title is noted once and the help documents twoway's picture"
    dash clear

    // U42-07: {ccl} in a variable label (y title, legend key), a value
    // label (tick label) and an axis 3 title and label is c(name), and
    // {ccl version} is 9, as twoway draws them (smcl_more_truth.json).
    local u42mx "`c(pwd)'/fixtures/smcl_more_truth.json"
    local bad ""
    local k 0
    foreach case in m1 m2 m3 m4 {
        local ++k
        sysuse auto, clear
        label variable mpg "Qa {ccl pi} b"
        label define zmo 0 "Qd {ccl N}" 1 "Qf {hline 2}"
        label values foreign zmo
        dash clear
        if "`case'" == "m1" {
            capture noisily dash scatter mpg weight, legend(on) title("Q{ccl version}") name(u42m1)
            local keys "varlabel.ytitle varlabel.legend ccl.version"
        }
        if "`case'" == "m2" {
            capture noisily dash scatter mpg foreign, xlabel(0 1, valuelabel) name(u42m2)
            local keys "valuelabel.xlabel"
        }
        if "`case'" == "m3" {
            label variable mpg "Mileage (mpg)"
            capture noisily dash (scatter mpg weight) (scatter price weight, yaxis(3)), ytitle("Qa {ccl pi} b", axis(3)) name(u42m3)
            local keys "axis3.ytitle"
        }
        if "`case'" == "m4" {
            label variable mpg "Mileage (mpg)"
            capture noisily dash (scatter mpg weight) (scatter price weight, yaxis(3)), ylabel(5000 "Qe {ccl N}", axis(3)) name(u42m4)
            local keys "axis3.ylabel"
        }
        if _rc {
            local bad "`bad' `case'(rc `=_rc')"
            continue
        }
        _u42_gread "`u42d'" 7`k'
        python: import __main__ as _u42_m; _u42_m._u42_mcheck(r"`u42mx'", "`keys'")
        if `"${u42_mbad}"' != "" {
            local bad "`bad' `case'"
            mata: printf("  %s: %s\n", st_local("case"), st_global("u42_mbad"))
        }
    }
    _w31_expect U42-07 `"("`bad'" == "")"' "texts differ from twoway's:`bad'"
    _w31_done U42-07 "ccl in variable labels, value labels and axis 3 options, and ccl version, are drawn as twoway draws them"
    sysuse auto, clear
    dash clear
    display as text "S42 end " c(current_date) " " c(current_time)
}
* ==== end S42 ====

* ==== S42 D13b: Global macros in graph text options ====
local only : env WP31_ONLY
if inlist("`only'", "", "S42") & `: list posof "S42" in w31_run' {
    display as text "S42 start " c(current_date) " " c(current_time)
    local u42d "`w31_work'/s42g"
    capture mkdir "`u42d'"
    local u42gx "`c(pwd)'/fixtures/global_text_truth.json"
    sysuse auto, clear
    global ZTG_plain "hello"
    global ZTG_smcl "{bf:x}y"
    global ZTG_quote `"say "hi""'
    global ZTG_eval "\`=1+1'"
    global ZTG_empty ""
    global ZTG_nest "ZTG_plain"

    // U42-05: a global typed literally in every graph text option is
    // drawn as twoway draws it, saved and served (an =exp global as
    // written, where twoway evaluates it).
    // Each command is typed as a user types it (\$ keeps the dollar
    // sign): a command built in a macro is expanded by Stata first.
    local bad ""
    local k 0
    local ++k
    dash clear
    capture noisily dash (scatter mpg weight) (scatter price weight, yaxis(2)), title("Z1:a \$ZTG_plain b") ///
        subtitle("Z2:a \$ZTG_plain b") ///
        note("Z3:a \$ZTG_plain b") ///
        caption("Z4:a \$ZTG_plain b") ///
        xtitle("Z5:a \$ZTG_plain b") ///
        ytitle("Z6:a \$ZTG_plain b") ///
        t1title("Z7:a \$ZTG_plain b") ///
        b2title("Z8:a \$ZTG_plain b") ///
        l1title("Z9:a \$ZTG_plain b") ///
        r1title("Z10:a \$ZTG_plain b") ///
        legend(label(1 "Z11:a \$ZTG_plain b")) ///
        xlabel(3000 "Z12:a \$ZTG_plain b") ///
