// S35 (WP-31 C10e) helpers.  _u35_date: one fact of a registered graph on
// sp500 in each mode (u35_s, u35_v), in Stata days: "kind" the class of
// axis <name>'s axis and whether its range holds twoway's scale; "ticks"
// its major ticks; "range" its range's ends rounded to the day; "title"
// its title; "line" the reference lines on it; "minor" its visible minor
// labels.  The expected value is the caller's (from
// fixtures/axisn_date_truth.json, written into the block).
python:
def _u35_days(ms):
    return round(float(ms) / 86400000.0 + 3653.0, 3)


def _u35_date_fact(fig, name, fact, lo, hi):
    from bokeh.models import Label, LabelSet
    from bokeh.models.axes import ContinuousAxis
    import dash_render as dr
    letter = name[0]
    kw = letter + "_range_name"
    sides = ("left", "right") if letter == "y" else ("below", "above")
    ax = [a for sd in sides for a in getattr(fig, sd)
          if isinstance(a, ContinuousAxis) and getattr(a, kw) == name
          and "dash_alt_axis" not in (a.tags or [])][0]
    rng = getattr(fig, "extra_%s_ranges" % letter)[name]
    a, b = sorted((_u35_days(rng.start), _u35_days(rng.end)))
    if fact == "kind":
        return "%s %s" % (type(ax).__name__,
                          "holds" if a <= lo and b >= hi else "short")
    if fact == "ticks":
        return " ".join("%g" % _u35_days(t)
                        for t in sorted(dr._dash_axis_majors(ax)))
    if fact == "range":
        return "holds" if a <= lo and b >= hi else "%g %g" % (a, b)
    if fact == "title":
        return str(ax.axis_label or "")
    if fact == "line":
        out = []
        for m in fig.references():
            if type(m).__name__ in ("Arrow", "Span") \
                    and getattr(m, kw, None) == name:
                v = getattr(m, "x_start" if letter == "x" else "y_start",
                            None)
                if v is None:
                    v = getattr(m, "location", None)
                if isinstance(v, (int, float)):
                    out.append(_u35_days(v))
        return " ".join("%g" % v for v in sorted(set(out)))
    if fact == "minor":
        pos = []
        for m in fig.references():
            if getattr(m, "name", None) != "dash_minor_labels" \
                    or list(m.tags or []) != [letter, name[1:]]:
                continue
            if isinstance(m, LabelSet):
                pos += [_u35_days(v) for v in m.source.data["pos"]]
            elif isinstance(m, Label) and m.visible:
                pos.append(_u35_days(m.x if letter == "x" else m.y))
        return " ".join("%g" % v for v in sorted(pos))


def _u35_date(sp, dp, app, name, fact, lo, hi):
    from sfi import Macro
    _r, _d, a, b = _u35_docs(sp, dp, app)
    Macro.setGlobal("u35_s", _u35_date_fact(a[0], name, fact, lo, hi))
    Macro.setGlobal("u35_v", _u35_date_fact(b[0], name, fact, lo, hi))
end

