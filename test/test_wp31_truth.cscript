// S05 helpers (WP-31 C10a).  _u05_draw: the first Line glyph a
// registered dash graph draws, saved and served, as its point count, x
// min and max and y sum into globals u05_<k>s (saved) and u05_<k>v
// (served), and the spec's range() into u05_rng; _u05_tw: twoway's own
// plot 1 serset -- the y and x columns' nonmissing count, x min and max
// and y sum -- in r().
python:
def _u05_draw(sp, dp, app):
    import json
    from sfi import Macro
    import __main__ as m
    a, b = m._u03_docs(sp, dp, app)
    for figs, sfx in ((a, "s"), (b, "v")):
        vals = None
        for f in figs:
            for r in f.renderers:
                g = getattr(r, "glyph", None)
                if type(g).__name__ != "Line" or vals is not None:
                    continue
                d = r.data_source.data
                xs = [float(v) for v in d[g.x]]
                ys = [float(v) for v in d[g.y]]
                vals = (len(xs), min(xs) if xs else -1, max(xs) if xs else -1,
                        sum(ys))
        vals = vals or (-1, -1, -1, -1)
        for k, v in zip(("n", "x0", "x1", "ys"), vals):
            Macro.setGlobal("u05_%s%s" % (k, sfx), "%.17g" % v)
    with open(sp, encoding="utf-8") as fh:
        spec = json.load(fh)
    Macro.setGlobal("u05_rng", str(spec["graphs"][0]["plots"][0]
                                   .get("options", {}).get("range", "")))
end

capture program drop _u05_reg
program define _u05_reg
    // _u05_reg <dir> <k> <dash command...>
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    dash clear
    quietly dash `0'
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u05_m; _u05_m._u05_draw("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py")
end

capture program drop _u05_tw
program define _u05_tw, rclass
    // _u05_tw <twoway command with a comma>: plot 1's serset, y column 1
    // and x column 2.
    version 19
    serset clear
    capture graph drop u05t
    quietly twoway `0' nodraw name(u05t, replace)
    local id "`.u05t.plotregion1.plot1.serset.id'"
    preserve
    quietly serset set `id'
    quietly serset use, clear
    unab all : _all
    local yv : word 1 of `all'
    local xv : word 2 of `all'
    quietly summarize `yv'
    return scalar n = r(N)
    return scalar ys = r(sum)
    quietly summarize `xv'
    return scalar x0 = r(min)
    return scalar x1 = r(max)
    restore
    capture graph drop u05t
end

* ==== S05 C10a: Value bounds ====
local only : env WP31_ONLY
if inlist("`only'", "", "S05") & `: list posof "S05" in w31_run' {
    display as text "S05 start " c(current_date) " " c(current_time)
    local u5d "`w31_work'/s05"
    capture mkdir "`u5d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear

    // ------------------------------------------------------------
    // U05-01: kdensity mpg, range(weight) -- the spec's range is summarize
    // weight's min and max, and the drawn grid spans twoway's serset, both
    // modes; lfit range(. 4000) and range(1000 .) span twoway's serset,
    // the dot the data's own end (value_bounds_truth.json range.*).
    // ------------------------------------------------------------
    quietly summarize weight
    local wlo = r(min)
    local whi = r(max)
    _u05_tw kdensity mpg, range(weight)
    local t0 = r(x0)
    local t1 = r(x1)
    _u05_reg "`u5d'" 1 kdensity mpg, range(weight) name(zu51)
    _w31_expect U05-01 `"("${u05_rng}" == "`wlo' `whi'")"' "spec range ${u05_rng}, summarize weight `wlo' `whi'"
    foreach m in s v {
        _w31_expect U05-01 "(abs(${u05_x0`m'} - `t0') < 1e-6 & abs(${u05_x1`m'} - `t1') < 1e-6)" "kdensity range(weight) `m': x ${u05_x0`m'}..${u05_x1`m'}, twoway `t0'..`t1'"
    }
    local k 2
    foreach r in ". 4000" "1000 ." {
        _u05_tw lfit mpg weight, range(`r')
        local t0 = r(x0)
        local t1 = r(x1)
        _u05_reg "`u5d'" `k' lfit mpg weight, range(`r') name(zu5`k')
        foreach m in s v {
            _w31_expect U05-01 "(abs(${u05_x0`m'} - `t0') < 1e-6 & abs(${u05_x1`m'} - `t1') < 1e-6)" "lfit range(`r') `m': x ${u05_x0`m'}..${u05_x1`m'}, twoway `t0'..`t1'"
        }
        local ++k
    }
    _w31_done U05-01 "range(weight) on kdensity is weight's min and max; range(. 4000) and range(1000 .) on lfit span twoway's x, saved and served"

    // ------------------------------------------------------------
    // U05-02: kdensity bwidth(0) draws kdensity mpg's curve; lowess
    // bwidth() at each value twoway resets (value_bounds_truth.json
    // lowess_bwidth reset == 1: -1 0 1 1.5 5) draws bwidth(.8)'s curve and
    // not bwidth(.3)'s, both modes, as twoway's serset does.
    // ------------------------------------------------------------
    _u05_reg "`u5d'" 4 kdensity mpg, name(zu54)
    local ks "${u05_yss}"
    local kv "${u05_ysv}"
    _u05_reg "`u5d'" 5 kdensity mpg, bwidth(0) name(zu55)
    _w31_expect U05-02 "(abs(${u05_yss} - `ks') < 1e-9 & abs(${u05_ysv} - `kv') < 1e-9)" "kdensity bwidth(0) y sum ${u05_yss} / ${u05_ysv}, default `ks' / `kv'"
    _u05_tw lowess mpg weight, bwidth(.8)
    local t8 = r(ys)
    _u05_reg "`u5d'" 6 lowess mpg weight, bwidth(.8) name(zu56)
    local l8s "${u05_yss}"
    local l8v "${u05_ysv}"
    _u05_reg "`u5d'" 7 lowess mpg weight, bwidth(.3) name(zu57)
    local l3s "${u05_yss}"
    local k 8
    foreach v in -1 0 1 1.5 5 {
        _u05_tw lowess mpg weight, bwidth(`v')
        _w31_expect U05-02 "(abs(r(ys) - `t8') < 1e-6)" "twoway lowess bwidth(`v') y sum `r(ys)', bwidth(.8) `t8'"
        _u05_reg "`u5d'" `k' lowess mpg weight, bwidth(`v') name(zu5`k')
        _w31_expect U05-02 "(abs(${u05_yss} - `l8s') < 1e-9 & abs(${u05_ysv} - `l8v') < 1e-9)" "lowess bwidth(`v') y sum ${u05_yss} / ${u05_ysv}, bwidth(.8) `l8s' / `l8v'"
        _w31_expect U05-02 "(abs(${u05_yss} - `l3s') > 1e-6)" "lowess bwidth(`v') equals bwidth(.3)'s curve"
        _w31_expect U05-02 "(abs(${u05_yss} - `t8') < 1e-6)" "lowess bwidth(`v') y sum ${u05_yss}, twoway's `t8'"
        local ++k
    }
    _w31_done U05-02 "kdensity bwidth(0) is the default curve; lowess bwidth(-1 0 1 1.5 5) draws twoway's .8 curve, saved and served"

    // ------------------------------------------------------------
    // U05-03: lfit n(1) is accepted, as twoway accepts it, and its line
    // has one point, saved and served.
    // ------------------------------------------------------------
    capture noisily twoway lfit mpg weight, n(1) nodraw
    local trc = _rc
    _w31_expect U05-03 "(`trc' == 0)" "twoway lfit n(1) rc `trc'"
    _u05_reg "`u5d'" 13 lfit mpg weight, n(1) name(zu513)
    _w31_expect U05-03 "(${u05_ns} == 1 & ${u05_nv} == 1)" "lfit n(1) points ${u05_ns} / ${u05_nv}"
    _w31_done U05-03 "lfit n(1) is accepted and draws one point, saved and served"

    forvalues k = 1/13 {
        foreach p in s d {
            capture erase "`u5d'/`p'`k'.json"
        }
        capture erase "`u5d'/a`k'.py"
    }
    capture rmdir "`u5d'"
    dash clear
    display as text "S05 end " c(current_date) " " c(current_time)
}
* ==== end S05 ====

// S06 helpers (WP-31 C10b).  _u06_draw: what a registered dash graph
// draws, saved and served (sfx s, v): its Line renderers (u06_ln<sfx>),
// its right-hand axes on the second range (u06_rt<sfx>), whether that
// range is the first axis's own object (u06_tie<sfx>), the sorted fields
// of its LabelSets (u06_lab<sfx>); from the spec, each layer's mlabel()
// (u06_ml) and the first layer's yaxis() (u06_ya).  _u06_bw: dash's
// default lpoly bandwidth over the data in memory, y x, degree d, in
// u06_bw.
python:
def _u06_draw(sp, dp, app):
    import json
    from sfi import Macro
    import __main__ as m
    a, b = m._u03_docs(sp, dp, app)
    for figs, sfx in ((a, "s"), (b, "v")):
        ln = rt = tie = 0
        labs = []
        for f in figs:
            for r in f.renderers:
                if type(getattr(r, "glyph", None)).__name__ == "Line":
                    ln += 1
            rt += sum(1 for ax in f.right
                      if getattr(ax, "y_range_name", "") == "y2")
            if f.extra_y_ranges.get("y2") is not None \
                    and f.extra_y_ranges["y2"] is f.y_range:
                tie = 1
            for c in f.center:
                if type(c).__name__ == "LabelSet":
                    # The column is the variable's, prefixed.
                    labs.append(str(getattr(c.text, "field", c.text))
                                .replace("__dash_mlabel_", "", 1))
        Macro.setGlobal("u06_ln" + sfx, str(ln))
        Macro.setGlobal("u06_rt" + sfx, str(rt))
        Macro.setGlobal("u06_tie" + sfx, str(tie))
        Macro.setGlobal("u06_lab" + sfx, " ".join(sorted(labs)))
    with open(sp, encoding="utf-8") as fh:
        spec = json.load(fh)
    plots = spec["graphs"][0]["plots"]
    Macro.setGlobal("u06_ml", " ".join(
        str((p.get("options") or {}).get("mlabel", "")) for p in plots))
    Macro.setGlobal("u06_ya", str((plots[0].get("options") or {})
                                  .get("yaxis", "")))


def _u06_bw(y, x, d):
    import numpy as np
    from sfi import Data, Macro
    import dash_render as dr
    ys = np.asarray(Data.get(y), dtype=float).ravel()
    xs = np.asarray(Data.get(x), dtype=float).ravel()
    h = dr.GlyphMapper._default_lpoly_bwidth(xs, ys, None, int(d),
                                             "epanechnikov")
    Macro.setGlobal("u06_bw", "%.17g" % h)
end

capture program drop _u06_reg
program define _u06_reg
    // _u06_reg <dir> <k> <dash command...>
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    dash clear
    quietly dash `0'
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u06_m; _u06_m._u06_draw("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py")
end

* ==== S06 C10b: Parsed values ====
local only : env WP31_ONLY
if inlist("`only'", "", "S06") & `: list posof "S06" in w31_run' {
    display as text "S06 start " c(current_date) " " c(current_time)
    local u6d "`w31_work'/s06"
    capture mkdir "`u6d'"
    capture graph drop _all
    set scheme s2color
    sysuse auto, clear

    // ------------------------------------------------------------
    // U06-01: lpoly degree(4)..degree(7) draw, saved and served, with
    // dash's default bandwidth at the lpoly command's r(bwidth) from the
    // same run -- 5e-4 at degree 4-5, 1e-2 at 6-7 (Stata's degree 9-10
    // global fit in raw powers is round-off there; test_lpoly_degree.py)
    // -- and the fixture's; degree(8), which twoway draws, is dash's own
    // bound: r(198) naming degree 7.
    // ------------------------------------------------------------
    local k 1
    foreach d in 4 5 6 7 {
        quietly lpoly mpg weight, degree(`d') nograph
        local rb = r(bwidth)
        python: import __main__ as _u06_m; _u06_m._u06_bw("mpg", "weight", `d')
        local tol = cond(`d' <= 5, 5e-4, 1e-2)
        _w31_expect U06-01 "(abs(${u06_bw} / `rb' - 1) <= `tol')" "degree(`d') bandwidth ${u06_bw}, lpoly r(bwidth) `rb'"
        capture noisily twoway lpoly mpg weight, degree(`d') nodraw
        _w31_expect U06-01 "(_rc == 0)" "twoway lpoly degree(`d') rc `=_rc'"
        _u06_reg "`u6d'" `k' lpoly mpg weight, degree(`d') name(zu6`k')
        _w31_expect U06-01 "(${u06_lns} == 1 & ${u06_lnv} == 1)" "degree(`d') lines ${u06_lns} / ${u06_lnv}"
        local ++k
    }
    capture noisily twoway lpoly mpg weight, degree(8) nodraw
    local trc = _rc
    dash clear
    capture noisily dash lpoly mpg weight, degree(8) name(zu68)
    local drc = _rc
    // Flipped (WP-31 D35): degree(8) is drawn, as twoway draws it.
    _w31_expect U06-01 "(`trc' == 0 & `drc' == 0)" "degree(8): twoway rc `trc', dash rc `drc'"
    _w31_done U06-01 "lpoly degree(4)-(7) draw with Stata's rule-of-thumb bandwidth, saved and served; degree(8) is taken"

    // ------------------------------------------------------------
    // U06-02: scatter mpg price weight, mlabel(t*) -- the element is
    // unab'd: mpg is labelled by trunk, price by turn, as twoway's serset
    // carries them; both modes draw two LabelSets of those columns.
    // ------------------------------------------------------------
    capture noisily twoway scatter mpg price weight, mlabel(t*) nodraw
    _w31_expect U06-02 "(_rc == 0)" "twoway mlabel(t*) rc `=_rc'"
    _u06_reg "`u6d'" 5 scatter mpg price weight, mlabel(t*) name(zu65)
    _w31_expect U06-02 `"("${u06_ml}" == "trunk turn")"' "spec mlabel ${u06_ml}"
    _w31_expect U06-02 `"("${u06_labs}" == "trunk turn" & "${u06_labv}" == "trunk turn")"' "label sets ${u06_labs} / ${u06_labv}"
    dash clear
    capture noisily dash scatter mpg weight, mlabel(zz*) name(zu6z)
    _w31_expect U06-02 "(_rc == 111)" "mlabel(zz*) rc `=_rc'"
    _w31_done U06-02 "mlabel(t*) labels mpg with trunk and price with turn, saved and served; mlabel(zz*) is r(111)"

    // ------------------------------------------------------------
    // U06-03: line mpg weight, yaxis(1 2) -- twoway draws the layer once
    // on one scale both axes read (parsed_values_truth.json yaxis.both);
    // dash draws one Line, a right-hand axis on y2, and y2 is the first
    // axis's own range, saved and served.  A filter move of that range is
    // the second axis's: test_yaxis_both.py::TestMoves.
    // ------------------------------------------------------------
    capture graph drop u6tw
    quietly twoway line mpg weight, yaxis(1 2) nodraw name(u6tw, replace)
    local t1 "`.u6tw.yaxis1.plotregion.yscale.curmin' `.u6tw.yaxis1.plotregion.yscale.curmax'"
    local t2 "`.u6tw.yaxis2.plotregion.yscale.curmin' `.u6tw.yaxis2.plotregion.yscale.curmax'"
    _w31_expect U06-03 `"("`t1'" == "`t2'" & "`.u6tw.plotregion1.plot2.isa'" == "")"' "twoway: scales `t1' / `t2', one plot"
    capture graph drop u6tw
    _u06_reg "`u6d'" 6 line mpg weight, yaxis(1 2) name(zu66)
    _w31_expect U06-03 `"("${u06_ya}" == "1 2")"' "spec yaxis ${u06_ya}"
    foreach m in s v {
        _w31_expect U06-03 "(${u06_ln`m'} == 1 & ${u06_rt`m'} == 1 & ${u06_tie`m'} == 1)" "`m': lines ${u06_ln`m'}, right axes ${u06_rt`m'}, tied ${u06_tie`m'}"
    }
    _w31_done U06-03 "yaxis(1 2) draws the layer once with a second axis on the same scale, saved and served"

    forvalues k = 1/6 {
        foreach p in s d {
            capture erase "`u6d'/`p'`k'.json"
        }
        capture erase "`u6d'/a`k'.py"
    }
    capture rmdir "`u6d'"
    dash clear
    display as text "S06 end " c(current_date) " " c(current_time)
}
* ==== end S06 ====

// S07 helpers (WP-31 A5-A8).  _u07_draw: what a registered dash graph
// draws, saved (DashRenderer) and served (the generated app's
// make_document): each line's and bar's y values (u07_ys, u07_yv), the
// saved aggregate layers' weight columns (u07_w), the data file's
// generated columns (u07_cols), and u07_tw 1 when the saved drawing is
// twoway's (the fixture key's serset: the lfit line through its points,
// the histogram's heights of the bins that hold rows, the kdensity
// curve) to 1e-5, relative.
python:
import json as _u07_json, os as _u07_os, sys as _u07_sys
for _u07_p in (_u07_os.path.abspath(".."),):
    if _u07_p not in _u07_sys.path:
        _u07_sys.path.insert(0, _u07_p)
with open(_u07_os.path.join("fixtures", "weight_operator_truth.json"),
          encoding="utf-8") as _u07_fh:
    _U07_FIX = _u07_json.load(_u07_fh)


def _u07_ys(figs):
    out = []
    for f in figs:
        for r in f.renderers:
            g = getattr(r, "glyph", None)
            t = type(g).__name__
            if t not in ("Line", "VBar", "Quad"):
                continue
            d = r.data_source.data
            yf = {"Line": "y", "VBar": "top", "Quad": "top"}[t]
            xf = {"Line": "x", "VBar": "x", "Quad": "left"}[t]
            yk = getattr(g, yf)
            xk = getattr(g, xf)
            yk = yk if isinstance(yk, str) else getattr(yk, "field", yf)
            xk = xk if isinstance(xk, str) else getattr(xk, "field", xf)
            pts = sorted(zip([float(v) for v in d[xk]],
                             [float(v) for v in d[yk]]))
            out.append((t, pts))
    return out


def _u07_tw(key, drawn):
    ss = _U07_FIX["weights"][key]["serset"]
    tol = lambda a, b: abs(a - b) <= 1e-5 * max(1.0, abs(b))
    if not drawn:
        return 0
    t, pts = drawn[0]
    if key.startswith("lfit"):
        xs, ys = ss["c2"], ss["c1"]
        s = (ys[-1] - ys[0]) / (xs[-1] - xs[0])
        return int(all(tol(y, ys[0] + s * (x - xs[0])) for x, y in pts))
    want = [float(v) for v in ss["c1"]]
    # twoway's histogram serset holds the bins that hold rows.
    got = [y for _, y in pts if not (key.startswith("hist") and y == 0)]
    return int(len(got) == len(want) and all(map(tol, got, want)))


def _u07_draw(sp, dp, app, key=""):
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    from bokeh.models import Plot
    from sfi import Macro
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_u07_app")
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_u07_app.py", "exec"),
             ns)
        doc = Document()
        ns["make_document"](doc)
    saved = list(r.figures.values())
    served = [m for root in doc.roots for m in root.select({"type": Plot})]
    a, b = _u07_ys(saved), _u07_ys(served)
    sig = lambda v: " ".join("%s:%s" % (t, ";".join(
        "%.9g,%.9g" % p for p in pts)) for t, pts in v)
    Macro.setGlobal("u07_ys", sig(a))
    Macro.setGlobal("u07_yv", sig(b))
    Macro.setGlobal("u07_w", " ".join(
        str(rr._dash_agg_config.get("wvar", ""))
        for f in saved for rr in f.renderers
        if isinstance(getattr(rr, "_dash_agg_config", None), dict)))
    with open(dp, encoding="utf-8") as fh:
        _u07_d = _u07_json.load(fh)
    names = _u07_d.get("StataJSON", _u07_d).get("variableNames", [])
    Macro.setGlobal("u07_cols", " ".join(n for n in names
                                         if n.startswith("__dash")))
    Macro.setGlobal("u07_tw", str(_u07_tw(key, a)) if key else "")
end

capture program drop _u07_reg
program define _u07_reg
    // _u07_reg <dir> <k> <fixture key or -> <dash command...>: register
    // one graph, write its spec and data, and read both modes (_u07_draw).
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    gettoken key 0 : 0
    if "`key'" == "-" local key ""
    foreach g in ys yv w cols tw {
        global u07_`g' ""
    }
    dash clear
    global u07_rc 0
    capture noisily dash `0'
    global u07_rc = _rc
    if ${u07_rc} exit
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _u07_m; _u07_m._u07_draw("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py", "`key'")
end

* ==== S07 A5: Weight expressions ====
local only : env WP31_ONLY
if inlist("`only'", "", "S07") & `: list posof "S07" in w31_run' {
    display as text "S07 start " c(current_date) " " c(current_time)
    local u7d "`w31_work'/s07a"
    capture mkdir "`u7d'"
    capture graph drop _all
    sysuse auto, clear
    quietly generate t = _n
    quietly tsset t
    quietly generate double w1 = price + 1
    quietly generate double w2 = L.price
    quietly generate double w3 = rep78 + 1

    // ------------------------------------------------------------
    // U07-1: lfit [aw=price+1] is fitted as [aw=w1], w1 = price+1, in
    // both modes, on twoway's line (weights.lfit_aw_expr).
    // ------------------------------------------------------------
    _u07_reg "`u7d'" 1 lfit_aw_expr lfit mpg weight [aw=price+1], name(u071a)
    _w31_expect U07-1 "(${u07_rc} == 0)" "dash lfit [aw=price+1] rc ${u07_rc}"
    local e_s "${u07_ys}"
    local e_v "${u07_yv}"
    local e_tw "${u07_tw}"
    local e_c "${u07_cols}"
    _u07_reg "`u7d'" 2 lfit_aw_var lfit mpg weight [aw=w1], name(u071b)
    _w31_expect U07-1 "(${u07_rc} == 0)" "dash lfit [aw=w1] rc ${u07_rc}"
    _w31_expect U07-1 `"("`e_s'" == "${u07_ys}" & "`e_v'" == "${u07_yv}" & "`e_s'" != "")"' "[aw=price+1] drew `e_s' / `e_v', [aw=w1] ${u07_ys} / ${u07_yv}"
    _w31_expect U07-1 `"("`e_tw'" == "1")"' "the saved line is not twoway's (`e_s')"
    _w31_expect U07-1 `"("`e_c'" == "__dashw1")"' "the data file's generated columns: `e_c'"
    capture describe __dash*, varlist
    _w31_expect U07-1 "(_rc != 0)" "a __dash column was left in the data: `r(varlist)'"
    _w31_done U07-1 "lfit [aw=price+1] is fitted as twoway fits it, saved and served, from __dashw1"

    // ------------------------------------------------------------
    // U07-2: lfit [aw=L.price] is fitted as [aw=w2], w2 = L.price, from
    // the time-series column __dasht1 (weights.lfit_aw_ts).
    // ------------------------------------------------------------
    _u07_reg "`u7d'" 3 lfit_aw_ts lfit mpg weight [aw=L.price], name(u072a)
    _w31_expect U07-2 "(${u07_rc} == 0)" "dash lfit [aw=L.price] rc ${u07_rc}"
    local e_s "${u07_ys}"
    local e_v "${u07_yv}"
    local e_tw "${u07_tw}"
    local e_c "${u07_cols}"
    _u07_reg "`u7d'" 4 lfit_aw_ts_var lfit mpg weight [aw=w2], name(u072b)
    _w31_expect U07-2 `"("`e_s'" == "${u07_ys}" & "`e_v'" == "${u07_yv}" & "`e_s'" != "")"' "[aw=L.price] drew `e_s' / `e_v', [aw=w2] ${u07_ys} / ${u07_yv}"
    _w31_expect U07-2 `"("`e_tw'" == "1")"' "the saved line is not twoway's (`e_s')"
    _w31_expect U07-2 `"("`e_c'" == "__dasht1")"' "the data file's generated columns: `e_c'"
    _w31_done U07-2 "lfit [aw=L.price] is fitted as twoway fits it, saved and served, from __dasht1"

    // ------------------------------------------------------------
    // U07-3: histogram [fw=rep78+1] and kdensity [aw=price+1] read the
    // column __dashw1 as their weight and draw as their twins do
    // ([fw=w3], [aw=w1]) and as twoway draws (weights.hist_fw_expr,
    // kde_aw_expr).
    // ------------------------------------------------------------
    local k 5
    foreach c in "hist_fw_expr histogram mpg [fw=rep78+1]|hist_fw_var histogram mpg [fw=w3]" "kde_aw_expr kdensity mpg [aw=price+1]|kde_aw_var kdensity mpg [aw=w1]" {
        gettoken a b : c, parse("|")
        local b = substr(`"`b'"', 2, .)
        gettoken ka a : a
        gettoken kb b : b
        _u07_reg "`u7d'" `k' `ka' `a', name(u073`k')
        _w31_expect U07-3 "(${u07_rc} == 0)" "dash `a' rc ${u07_rc}"
        local e_s "${u07_ys}"
        local e_v "${u07_yv}"
        _w31_expect U07-3 `"("${u07_w}" == "__dashw1")"' "`a': the weight column read is ${u07_w}"
        _w31_expect U07-3 `"("${u07_tw}" == "1")"' "`a': the saved drawing is not twoway's"
        local ++k
        _u07_reg "`u7d'" `k' `kb' `b', name(u073`k')
        _w31_expect U07-3 `"("`e_s'" == "${u07_ys}" & "`e_v'" == "${u07_yv}" & "`e_s'" != "")"' "`a' and `b' draw differently"
        local ++k
    }
    _w31_done U07-3 "histogram [fw=rep78+1] and kdensity [aw=price+1] weight by __dashw1, as twoway weights them"

    forvalues k = 1/8 {
        foreach p in s d {
            capture erase "`u7d'/`p'`k'.json"
        }
        capture erase "`u7d'/a`k'.py"
    }
    capture rmdir "`u7d'"
    tsset, clear
    dash clear
    display as text "S07 end " c(current_date) " " c(current_time)
}
* ==== end S07 ====

// S07 helper (WP-31 A6).  _u07_ops: the fixture's operator forms, each
// as the dash command, twoway's rc and its line, into globals
// u07_on, u07_oc<k>, u07_or<k>, u07_ot<k>; _u07_last: the last line of a
// log that is not blank, into u07_line.
python:
def _u07_ops():
    from sfi import Macro
    ops = _U07_FIX["operators"]
    keys = sorted(ops)
    Macro.setGlobal("u07_on", str(len(keys)))
    for i, k in enumerate(keys, 1):
        cmd = ops[k]["cmd"]
        if cmd.startswith("twoway "):
            cmd = cmd[len("twoway "):]
        Macro.setGlobal("u07_oc%d" % i, cmd)
        Macro.setGlobal("u07_or%d" % i, str(ops[k]["rc"]))
        Macro.setGlobal("u07_ot%d" % i, ops[k]["text"])


def _u07_last(path):
    from sfi import Macro
    with open(path, encoding="utf-8", errors="replace") as fh:
        got = [ln.rstrip() for ln in fh if ln.strip()]
    Macro.setGlobal("u07_line", got[-1] if got else "")
end

* ==== S07 A6: Operators in option varlists ====
local only : env WP31_ONLY
if inlist("`only'", "", "S07") & `: list posof "S07" in w31_run' {
    display as text "S07 start " c(current_date) " " c(current_time)
    local u7d "`w31_work'/s07b"
    capture mkdir "`u7d'"
    capture graph drop _all

    // ------------------------------------------------------------
    // U07-4: each operator form of the fixture (twoway refuses every one:
    // mlabel() r(111) "variable L not found", colorvar() and by() r(101)
    // "factor-variable and time-series operators not allowed",
    // mlabvposition() r(198) "L.pos invalid name") is refused by dash
    // with twoway's rc and line, on tsset data and on data not tsset.
    // ------------------------------------------------------------
    python: _u07_ops()
    local lf "`u7d'/ops.log"
    local u7ls = c(linesize)
    set linesize 200
    foreach ts in 1 0 {
        sysuse auto, clear
        quietly generate t = _n
        quietly generate int pos = mod(_n, 12)
        if `ts' quietly tsset t
        forvalues i = 1/${u07_on} {
            local cmd "${u07_oc`i'}"
            dash clear
            quietly log using "`lf'", text replace name(u07o)
            capture noisily dash `cmd' name(u074)
            local rc = _rc
            quietly log close u07o
            python: _u07_last("`lf'")
            _w31_expect U07-4 "(`rc' == ${u07_or`i'})" "tsset `ts': dash `cmd' rc `rc', twoway ${u07_or`i'}"
            _w31_expect U07-4 `"(`"${u07_line}"' == `"${u07_ot`i'}"')"' "tsset `ts': dash `cmd' said [${u07_line}], twoway [${u07_ot`i'}]"
        }
    }
    _w31_done U07-4 "mlabel(L.make), mlabel(L.rep78), colorvar(L.mpg), mlabvposition(L.pos) and by(L.foreign) refused with twoway's rc and line, tsset or not"

    set linesize `u7ls'
    capture erase "`lf'"
    capture rmdir "`u7d'"
    tsset, clear
    dash clear
    display as text "S07 end " c(current_date) " " c(current_time)
}
* ==== end S07 ====

// S07 helper (WP-31 A7).  _u07_tips: the tooltip rows a registered dash
// graph shows, saved and served -- each HoverTool's row labels joined by
// "|" -- into globals u07_tts and u07_ttv.
python:
def _u07_tips(sp, dp, app):
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    from bokeh.models import HoverTool, Plot
    from sfi import Macro
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_u07t_app")
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_u07t_app.py", "exec"),
             ns)
        doc = Document()
        ns["make_document"](doc)
    saved = list(r.figures.values())
    served = [m for root in doc.roots for m in root.select({"type": Plot})]

    def rows(figs):
        out = []
        for f in figs:
            for t in f.tools:
                if isinstance(t, HoverTool) and isinstance(t.tooltips, list):
                    out.append("|".join(str(a) for a, _ in t.tooltips))
        return " ".join(out)
    Macro.setGlobal("u07_tts", rows(saved))
    Macro.setGlobal("u07_ttv", rows(served))
end

* ==== S07 A7: hover() merge ====
local only : env WP31_ONLY
if inlist("`only'", "", "S07") & `: list posof "S07" in w31_run' {
    display as text "S07 start " c(current_date) " " c(current_time)
    local u7d "`w31_work'/s07c"
    capture mkdir "`u7d'"
    capture graph drop _all
    sysuse auto, clear
    label variable mpg ""
    label variable weight ""
    label variable make ""
    label variable price ""

    // ------------------------------------------------------------
    // U07-5: hover(make) in the layer and hover(price) after the comma
    // are both shown, in the order written, saved and served; a
    // variable given in both lists is shown once.
    // ------------------------------------------------------------
    local k 0
    // The rows: x, y, then hover()'s variables (_dash_build_hover).
    foreach c in "(scatter mpg weight, hover(make)), hover(price)|make price|weight|mpg|make|price" "(scatter mpg weight, hover(price)), hover(make)|price make|weight|mpg|price|make" "(scatter mpg weight, hover(make)), hover(make price)|make make price|weight|mpg|make|price" {
        local ++k
        gettoken cmd rest : c, parse("|")
        local rest = substr(`"`rest'"', 2, .)
        gettoken want rest : rest, parse("|")
        local rows = substr(`"`rest'"', 2, .)
        dash clear
        capture noisily dash `cmd' name(u075`k')
        _w31_expect U07-5 "(_rc == 0)" "dash `cmd' rc `=_rc'"
        mata: st_local("got", st_global("dash_json_u075`k'"))
        mata: st_local("hit", strofreal(strpos(st_local("got"), char(34) + "hover" + char(34) + ":" + char(34) + st_local("want") + char(34)) > 0))
        _w31_expect U07-5 "(`hit')" "dash `cmd': the spec's hover is not [`want']"
        _dash_serve_spec, specpath("`u7d'/s`k'.json") datapath("`u7d'/d`k'.json")
        python: _u07_tips("`u7d'/s`k'.json", "`u7d'/d`k'.json", "`u7d'/a`k'.py")
        _w31_expect U07-5 `"("${u07_tts}" == "`rows'" & "${u07_ttv}" == "`rows'")"' "dash `cmd': tooltip rows saved [${u07_tts}] served [${u07_ttv}], want [`rows']"
    }
    _w31_done U07-5 "hover() in the layer and after the comma are merged in order, each variable once, saved and served"

    forvalues k = 1/3 {
        foreach p in s d {
            capture erase "`u7d'/`p'`k'.json"
        }
        capture erase "`u7d'/a`k'.py"
    }
    capture rmdir "`u7d'"
    dash clear
    display as text "S07 end " c(current_date) " " c(current_time)
}
* ==== end S07 ====

// S07 helper (WP-31 A8).  _u07_yd: the fixture's y date forms, each as
// the dash command, twoway's rc and its line, into globals u07_yn,
// u07_yc<k>, u07_yr<k>, u07_yt<k>.
python:
def _u07_yd():
    from sfi import Macro
    yd = _U07_FIX["ydates"]
    keys = sorted(yd)
    Macro.setGlobal("u07_yn", str(len(keys)))
    for i, k in enumerate(keys, 1):
        cmd = yd[k]["cmd"]
        if cmd.startswith("twoway "):
            cmd = cmd[len("twoway "):]
        Macro.setGlobal("u07_yc%d" % i, cmd)
        Macro.setGlobal("u07_yr%d" % i, str(yd[k]["rc"]))
        Macro.setGlobal("u07_yt%d" % i, yd[k]["text"] if yd[k]["rc"] else "")
end

* ==== S07 A8: y date literals ====
local only : env WP31_ONLY
if inlist("`only'", "", "S07") & `: list posof "S07" in w31_run' {
    display as text "S07 start " c(current_date) " " c(current_time)
    local u7d "`w31_work'/s07d"
    capture mkdir "`u7d'"
    capture graph drop _all
    local u7ls = c(linesize)
    set linesize 200

    // ------------------------------------------------------------
    // U07-6: a date literal in ylabel(), ytick(), ymlabel(), ymtick(),
    // their axis-2 forms and yscale(range()) -- also on a %tm y variable
    // -- is refused with twoway's rc and line (ydates.*); ylabel(480) on
    // the %tm variable and on mpg draws (guard).
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly generate ym = ym(2000, mod(_n, 12) + 1)
    format ym %tm
    python: _u07_yd()
    local lf "`u7d'/yd.log"
    // In a loop, so the count is read after _u07_yd set it.
    foreach u7f in yd {
        forvalues i = 1/${u07_yn} {
            local cmd "${u07_yc`i'}"
            dash clear
            quietly log using "`lf'", text replace name(u07y)
            capture noisily dash `cmd' name(u076)
            local rc = _rc
            quietly log close u07y
            python: _u07_last("`lf'")
            _w31_expect U07-6 "(`rc' == ${u07_yr`i'})" "dash `cmd' rc `rc', twoway ${u07_yr`i'}"
            if ${u07_yr`i'} {
                _w31_expect U07-6 `"(`"${u07_line}"' == `"${u07_yt`i'}"')"' "dash `cmd' said [${u07_line}], twoway [${u07_yt`i'}]"
            }
        }
    }
    _w31_done U07-6 "a date literal in a y label, tick or scale option is refused with twoway's rc and line; ylabel(480) draws"

    set linesize `u7ls'
    capture erase "`lf'"
    capture rmdir "`u7d'"
    dash clear
    display as text "S07 end " c(current_date) " " c(current_time)
}
* ==== end S07 ====

// S08 helpers (WP-31 A2, A1, A4).  _u08_fixture: test/fixtures/
// bare_prefix_truth.json's extras.* and twoways.* as dash commands, into
// globals u08_xn/u08_xw<k>/u08_xc<k>/u08_xr<k>/u08_xt<k> (word, command,
// twoway's rc, twoway's line) and u08_wn/u08_ww<k>/u08_wc<k>/u08_wf<k>
// (word, command, the full type name twoway reads it as); _u08_hasline:
// u08_found 1 when a line of the log, trimmed, is the text.
python:
import json as _u08_json, os as _u08_os
with open(_u08_os.path.join("fixtures", "bare_prefix_truth.json"),
          encoding="utf-8") as _u08_fh:
    _U08_FIX = _u08_json.load(_u08_fh)
_U08_FULL = {"sc": "scatter", "li": "line", "con": "connected",
             "hist": "histogram", "rsc": "rscatter", "rl": "rline",
             "rcon": "rconnected", "fun": "function", "mbands": "mband",
             "fn": "function"}


def _u08_cmd(cmd):
    """twoway's probe as the dash command: no prefix, no nodraw."""
    cmd = cmd[len("twoway "):] if cmd.startswith("twoway ") else cmd
    return cmd.replace(", nodraw", ",")


def _u08_fixture():
    from sfi import Macro
    for tag, grp in (("x", "extras"), ("w", "twoways")):
        keys = sorted(_U08_FIX[grp])
        Macro.setGlobal("u08_%sn" % tag, str(len(keys)))
        for i, k in enumerate(keys, 1):
            r = _U08_FIX[grp][k]
            Macro.setGlobal("u08_%sw%d" % (tag, i), k)
            Macro.setGlobal("u08_%sc%d" % (tag, i), _u08_cmd(r["cmd"]))
            Macro.setGlobal("u08_%sr%d" % (tag, i), str(r["rc"]))
            Macro.setGlobal("u08_%st%d" % (tag, i), r["message"])
            Macro.setGlobal("u08_%sf%d" % (tag, i), _U08_FULL.get(k, ""))


def _u08_hasline(path, text):
    from sfi import Macro
    with open(path, encoding="utf-8", errors="replace") as fh:
        got = [ln.strip() for ln in fh]
    Macro.setGlobal("u08_found", "1" if text in got else "0")
end

* ==== S08 A2: Plot-type abbreviations ====
local only : env WP31_ONLY
if inlist("`only'", "", "S08") & `: list posof "S08" in w31_run' {
    display as text "S08 start " c(current_date) " " c(current_time)
    local u8d "`w31_work'/s08a"
    capture mkdir "`u8d'"
    sysuse auto, clear
    quietly generate t = _n
    quietly tsset t
    python: _u08_fixture()
    local lf "`u8d'/x.log"
    local u8ls = c(linesize)
    set linesize 200

    // ------------------------------------------------------------
    // U08-1: each of the thirteen shorter spellings dash took (ar ba sp
    // lfi qfi low lpo fp kde dr tsl tsrl msp) is refused as twoway
    // refuses it: r(198) and twoway's line "<word> is not a twoway plot
    // type", registering nothing.
    // ------------------------------------------------------------
    _w31_expect U08-1 "(${u08_xn} == 13)" "the fixture holds ${u08_xn} extras, want 13"
    // A loop header holds no ${...}: its brace ends the block scan.
    local n8x = ${u08_xn}
    forvalues i = 1/`n8x' {
        local cmd "${u08_xc`i'}"
        dash clear
        quietly log using "`lf'", text replace name(u08x)
        capture noisily dash `cmd' name(u081)
        local rc = _rc
        quietly log close u08x
        python: _u08_hasline("`lf'", "${u08_xt`i'}")
        _w31_expect U08-1 "(`rc' == ${u08_xr`i'})" "dash `cmd' rc `rc', twoway ${u08_xr`i'}"
        _w31_expect U08-1 "(${u08_found} == 1)" "dash `cmd' did not log twoway's line [${u08_xt`i'}]"
        _w31_expect U08-1 `"(`"${dash_graph_registry}"' == "")"' "dash `cmd' registered a graph"
    }
    _w31_done U08-1 "the thirteen shorter plot-type spellings are refused, r(198), in twoway's words"

    // ------------------------------------------------------------
    // U08-2: twoway's ten spellings (its eight minimums, mbands and fn)
    // draw in twoway and register in dash as the full type.
    // ------------------------------------------------------------
    _w31_expect U08-2 "(${u08_wn} == 10)" "the fixture holds ${u08_wn} spellings, want 10"
    // A loop header holds no ${...}: its brace ends the block scan.
    local n8w = ${u08_wn}
    forvalues i = 1/`n8w' {
        local cmd "${u08_wc`i'}"
        dash clear
        capture noisily dash `cmd' name(u082)
        local rc = _rc
        _w31_expect U08-2 "(${u08_wr`i'} == 0)" "twoway ${u08_ww`i'} rc ${u08_wr`i'}"
        _w31_expect U08-2 "(`rc' == 0)" "dash `cmd' rc `rc'"
        mata: st_local("hit", strofreal(strpos(st_global("dash_json_u082"), char(34) + "type" + char(34) + ":" + char(34) + st_global("u08_wf`i'") + char(34)) > 0))
        _w31_expect U08-2 "(`hit' == 1)" "dash `cmd' did not register type ${u08_wf`i'}"
    }
    _w31_done U08-2 "twoway's own plot-type spellings register as the type twoway reads"

    set linesize `u8ls'
    capture erase "`lf'"
    capture rmdir "`u8d'"
    tsset, clear
    dash clear
    display as text "S08 end " c(current_date) " " c(current_time)
}
* ==== end S08 ====

// S08 helpers (WP-31 A4).  _u08_mla: the fixture's mla.* as dash option
// spellings, into u08_mn/u08_mk<k>/u08_mo<k>/u08_mr<k>/u08_mt<k>/u08_mb<k>
// (key, option as typed, twoway's rc and line, the option twoway binds it
// to); _u08_has: u08_found 1 when the log holds the text, its lines
// joined.
python:
def _u08_mla():
    from sfi import Macro
    mla = _U08_FIX["mla"]
    keys = sorted(mla)
    Macro.setGlobal("u08_mn", str(len(keys)))
    for i, k in enumerate(keys, 1):
        r = mla[k]
        opt = r["cmd"].split(", ", 1)[1].replace(" nodraw", "")
        Macro.setGlobal("u08_mk%d" % i, k)
        Macro.setGlobal("u08_mo%d" % i, opt)
        Macro.setGlobal("u08_mr%d" % i, str(r["rc"]))
        Macro.setGlobal("u08_mt%d" % i, r["message"])
        Macro.setGlobal("u08_mb%d" % i, r["resolves_to"] or "")


def _u08_has(path, text):
    from sfi import Macro
    with open(path, encoding="utf-8", errors="replace") as fh:
        got = " ".join(ln.strip().lstrip("> ") for ln in fh)
    Macro.setGlobal("u08_found", "1" if text in got else "0")
end

* ==== S08 A4: mlalign ====
local only : env WP31_ONLY
if inlist("`only'", "", "S08") & `: list posof "S08" in w31_run' {
    display as text "S08 start " c(current_date) " " c(current_time)
    local u8d "`w31_work'/s08c"
    capture mkdir "`u8d'"
    sysuse auto, clear
    local lf "`u8d'/m.log"
    local u8ls = c(linesize)
