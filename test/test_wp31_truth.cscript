        caption("Z4:a \${ZTG_plain}b") ///
        xtitle("Z5:a \${ZTG_plain}b") ///
        ytitle("Z6:a \${ZTG_plain}b") ///
        t1title("Z7:a \${ZTG_plain}b") ///
        b2title("Z8:a \${ZTG_plain}b") ///
        l1title("Z9:a \${ZTG_plain}b") ///
        r1title("Z10:a \${ZTG_plain}b") ///
