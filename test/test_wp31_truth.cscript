    // ------------------------------------------------------------
    // U03-04: dot base(50) widens the y axis to 50 in both modes, as
    // twoway's scale reaches 50, and moves no dot.
    // ------------------------------------------------------------
    quietly twoway dot mpg weight, base(50) name(u03t, replace)
    local cmax = `.u03t.plotregion1.yscale.curmax'
    _w31_expect U03-04 "(`cmax' >= 50)" "twoway dot base(50) curmax `cmax'"
    _u03_reg "`u3d'" 6 dot mpg weight, name(zu6)
