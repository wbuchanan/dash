// ----------------------------------------------------------------
// Q4105-1 (WP-41 BY-5): aspectratio() with by()'s shrink or
// overallshrink is refused in twoway's words, r(198) "options aspect()
// and shrink may not be combined" (test/fixtures/by_layout_truth.json
// Y05 shrink, Y06 overallshrink, Y07 shr, Y08b overallshr, Y08c total
// shrink, Y08e aspectratio() after by()); ishrink (Y08), noshrink (Y08d)
// and a shrink inside note() text (Y21) are drawn, rc 0.  The Mata
// reader _dash_by_shrinks matches the words as _dash_by_scan does.
// ----------------------------------------------------------------
foreach w in "shrink" "overallshrink" "shr" "overallshr" "total shrink" {
    _u46_rc Q4105-1 198 `"dash scatter mpg weight, aspectratio(1) by(foreign, `w') name(q41051)"'
    _ov_said Q4105-1 "options aspect() and shrink may not be combined"
}
_u46_rc Q4105-1 198 `"dash scatter mpg weight, by(foreign, shrink) aspectratio(1) name(q41051)"'
_ov_said Q4105-1 "options aspect() and shrink may not be combined"
foreach w in "ishrink" "noshrink" `"note("a shrink b")"' {
    _u46_rc Q4105-1 0 `"dash scatter mpg weight, aspectratio(1) by(foreign, `w') name(q41051)"'
}
capture dash clear
capture program drop _q41_shr
program define _q41_shr
    version 16.0
    gettoken want 0 : 0
    local w = strtrim(`"`macval(0)'"')
    local _q41 = -1
    capture mata: st_local("_q41", strofreal(_dash_by_shrinks(st_local("w"))))
    local mrc = _rc
    _ov_assert Q4105-1 "(`mrc' == 0 & `_q41' == `want')" `"_dash_by_shrinks(`macval(w)') is `_q41' (rc `mrc'; expected `want')"'
end
_q41_shr 1 shr
_q41_shr 1 overallshrink
_q41_shr 1 total shrink
_q41_shr 0 ishrink
_q41_shr 0 noshrink
_q41_shr 0 note("a shrink b")
_q41_shr 0

