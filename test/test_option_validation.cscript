_af_case AF-06 `"dash scatter mpg weight, xlabel(, format(%12s)) ylabel(, for(%9.1f)) name(af06)"' 0 ""
_af_case AF-07 `"dash scatter mpg weight, xlabel(, format(%21x)) ylabel(, format("%9.2f")) name(af07)"' 0 ""
_af_case AF-08 `"dash scatter mpg weight, xlabel(, format()) ylabel(, format(%9.2f %9.1f)) name(af08)"' 0 ""
