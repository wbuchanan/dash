    capture noisily twoway (scatter mpg weight) (scatter trunk weight), `macval(opt)' name(q4305t, replace)
    local trc = _rc
    quietly log close _q5log
    quietly log using "`c(tmpdir)'dash_q4305d.log", name(_q5log) text replace
    capture noisily dash (scatter mpg weight) (scatter trunk weight), `macval(opt)' name(q4305d)
    local drc = _rc
