// U27-6 .. U27-8 (WP-31 D2): title2() and subtitle2(), which twoway has
// not, refused with twoway's rc and line wherever they are written.
foreach u in 6 7 8 {
    local bad ""
    if `u' == 6 local cases `"`"scatter mpg weight, title2("x")"' `"scatter mpg weight, title2"'"'
    if `u' == 7 local cases `"`"scatter mpg weight, subtitle2("x")"'"'
    if `u' == 8 local cases `"`"(scatter mpg weight, title2(x)),"' `"scatter mpg weight || scatter price weight, title2("x")"'"'
    foreach cmd of local cases {
        _u07_rc `"`macval(cmd)'"' "not allowed"
        if r(trc) != 198 | r(drc) != 198 | strtrim(`"`r(tline)'"') != strtrim(`"`r(dline)'"') | `"`r(dline)'"' == "" | r(noted) != 0 {
            local bad `"`bad' [`cmd': twoway `r(trc)' `r(tline)', dash `r(drc)' `r(dline)', notes `r(noted)']"'
        }
    }
    if `"`bad'"' != "" {
        display as error `"U27-`u' FAIL:`bad'"'
        global ov_nfail    = ${ov_nfail} + 1
        global ov_faillist "${ov_faillist} U27-`u'"
    }
    else if `u' == 6 display as text "U27-6 PASS: title2() and a bare title2 refused with twoway's rc and line"
    else if `u' == 7 display as text "U27-7 PASS: subtitle2() refused with twoway's rc and line"
    else display as text "U27-8 PASS: title2() in a plot's parentheses and after a segment's comma refused with twoway's rc and line"
}

