    python: import __main__ as _q4505m; _q4505m._q4505_said(r"`c(tmpdir)'dash_q4505.log", __import__("sfi").Macro.getGlobal("q4505_m`i'"))
    if `drc' != ${q4505_r`i'} | `q4505_has' != 1 local q4505_bad `"`q4505_bad' [${q4505_k`i'}: twoway ${q4505_r`i'}, dash `drc', line `q4505_has']"'
    macro drop q4505_k`i' q4505_c`i' q4505_r`i' q4505_m`i'
}
