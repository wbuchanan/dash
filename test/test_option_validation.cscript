_ov_case OV-118 `"dash kpi mean(mpg), name(k) title(T) fmt(%12s)"' 198 fmt
_ov_case OV-119 `"dash kpi mean(mpg), name(k) title(T) fmt(%tdCCYY-NN-DD)"' 0 ""
_ov_case OV-120 `"dash kpi mean(mpg), name(k) title(T) fmt(%9.0fc)"' 0 ""

// ----------------------------------------------------------------
// OV-121 .. OV-134: the adversarial review's findings (DESIGN.md 7.1)
// ----------------------------------------------------------------
// A1 -- a time-series expression in a var kind.  The data are tsset on t
// (above).  twoway refuses it in its own words, whatever the tsset, and
// so does dash (Flipped, WP-31 A6: dash said r(198) "not a time-series
// expression", or r(111) on data not tsset; test/fixtures/
// weight_operator_truth.json operators.*), never clearing the segment's
// s().  _ov_tsop <id> <rc> <cmd>: the command's rc, its log kept for
// _ov_said.
capture program drop _ov_tsop
program define _ov_tsop
    version 16.0
    args id expected cmdtext
    local logfile "`c(tmpdir)'dash_ov.log"
    capture log close _ovlog
    capture erase "`logfile'"
    capture dash clear
    log using "`logfile'", name(_ovlog) text replace
    capture noisily `cmdtext'
    local rc = _rc
    log close _ovlog
    _ov_assert `id' "(`rc' == `expected')" `"rc `rc' (expected `expected') -- `macval(cmdtext)'"'
end
_ov_tsop OV-121 101 `"dash scatter mpg weight, colorvar(L.price) jitter(5) name(ov121)"'
_ov_said OV-121m "factor-variable and time-series operators not allowed"
_ov_case OV-122 `"dash scatter mpg weight, colorvar(price) jitter(5) name(ov122)"' 0 "" `""jitter":"5""' `""colorvar":"price""'
quietly tsset, clear
_ov_tsop OV-123 101 `"dash scatter mpg weight, colorvar(L.price) jitter(5) name(ov123)"'
quietly tsset t
_ov_tsop OV-124 111 `"dash scatter mpg weight, mlabel(L.mpg) jitter(5) name(ov124)"'
_ov_said OV-124m "variable L not found"

// A2 -- a refused replace leaves the old KPI whole, and the registry
// still builds.  Hand-rolled: _ov_probe clears the registry first.
capture dash clear
dash scatter mpg weight, name(ov125g)
dash kpi mean(mpg), title(T) name(ov125k) fmt(%9.2f)
local _ov_log "`c(tmpdir)'dash_ov.log"
capture log close _ovlog
capture erase "`_ov_log'"
log using "`_ov_log'", name(_ovlog) text replace
capture noisily dash kpi mean(mpg), title(T) name(ov125k, replace) fmt(bogus)
local _ov_rc = _rc
log close _ovlog
_ov_assert OV-125 "(`_ov_rc' == 198)" "name(ov125k, replace) fmt(bogus): rc `_ov_rc' (expected 198)"
_ov_said OV-125m "fmt()"
_ov_assert OV-125a `"("${dash_kpi_ov125k}" == "1")"' `"the old KPI's marker global survives (dash_kpi_ov125k = [${dash_kpi_ov125k}])"'
_ov_assert OV-125b `"("${dash_kpi_ov125k__fmt}" == "%9.2f")"' `"the old KPI's fmt global survives (dash_kpi_ov125k__fmt = [${dash_kpi_ov125k__fmt}])"'
local _ov_nk  = 0
local _ov_reg "${dash_graph_registry}"
foreach _r of local _ov_reg {
    if "`_r'" == "ov125k" local ++_ov_nk
}
_ov_assert OV-125c "(`_ov_nk' == 1)" "the registry lists ov125k once (registry = [${dash_graph_registry}])"
capture noisily dash kpi mean(mpg), title(T) name(ov125k, replace) update(bogus)
local _ov_rc = _rc
_ov_assert OV-125u `"(`_ov_rc' == 198 & "${dash_kpi_ov125k__fmt}" == "%9.2f")"' "name(ov125k, replace) update(bogus): rc `_ov_rc' (expected 198), fmt global = [${dash_kpi_ov125k__fmt}]"
tempfile _ov_tf
local _ov_html "`_ov_tf'.html"
capture erase "`_ov_html'"
capture noisily dash build, saving("`_ov_html'") replace
local _ov_rc = _rc
_ov_assert OV-125d "(`_ov_rc' == 0)" "dash build after the refused replace: rc `_ov_rc' (expected 0)"
capture confirm file "`_ov_html'"
local _ov_rc = _rc
_ov_assert OV-125e "(`_ov_rc' == 0)" "dash build wrote the dashboard"
capture erase "`_ov_html'"

// A3 -- a graph-level option inside a segment is validated even when a
// later value outranks it, as twoway refuses the whole command.
_ov_case OV-126 `"dash (scatter mpg weight, xsize(500)) , xsize(5) name(ov126)"' 198 xsize
_ov_case OV-127 `"dash (scatter mpg weight, by(nosuch)) , by(foreign) name(ov127)"' 111 by

