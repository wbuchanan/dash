// ----------------------------------------------------------------
// Q4901-1..5 (WP-49 section 49-01, plot:PT-7): refusal first lines.
// test/fixtures/refusal_line_truth.json (scripts/extract_refusal_line_truth.do)
// holds each probe's twoway rc and lines.  Q4901-1 (pt7.typed.*) and
// Q4901-3 (sd12.*): dash's rc and first line are twoway's; Q4901-3's
// D-49-01.c rows print no second line.  Q4901-4: after "is not a twoway
// plot type" the Supported list follows, as the fixture's dash lines
// recorded it.  Q4901-5 (pt7.kept.*): dash's every line is the fixture's.
// Q4901-2: value_truth.json's five TR-10 rows print one line (their rc
// and first line are test_wp33_truth.cscript's Q3310-1).
// ----------------------------------------------------------------
python:
import json as _q4901_json
import re as _q4901_re
from sfi import Macro as _q4901_M
with open("fixtures/refusal_line_truth.json", encoding="utf-8") as _q4901_fh:
    _q4901_fx = _q4901_json.load(_q4901_fh)["probes"]
with open("fixtures/value_truth.json", encoding="utf-8") as _q4901_fh:
    _q4901_vt = {r["id"]: r for r in _q4901_json.load(_q4901_fh)["twoway"]}
_q4901_tr10 = ("kdensity_bwidth_1", "mband_bands_1", "kdensity_kernel_1",
               "colorlevels_1", "mlabangle_4")
# sd12 rows whose dash sentence is dropped (D-49-01.c): one line only.
_q4901_one = ("sd12.Q14", "sd12.by_nosuch", "sd12.mlabel_nosuch",
              "sd12.colorvar_nosuch", "sd12.bar_word", "sd12.legloc",
              "sd12.legloc_word", "sd12.legloc_graph", "sd12.useplotregion",
              "sd12.useplotregion_word", "sd12.useplotregion_graph")
_q4901_M.setLocal("q_typed", " ".join(sorted(
    k for k, v in _q4901_fx.items() if k.startswith("pt7.typed.") and v["twoway_rc"])))
_q4901_M.setLocal("q_sd12", " ".join(sorted(
    k for k, v in _q4901_fx.items() if k.startswith("sd12.") and v["twoway_rc"])))
_q4901_M.setLocal("q_kept", " ".join(sorted(
    k for k in _q4901_fx if k.startswith("pt7.kept."))))
_q4901_M.setLocal("q_tr10", " ".join(_q4901_tr10))


def _q4901_take(key):
    if key in _q4901_vt:
        _q4901_M.setLocal("q_cmd", _q4901_vt[key]["command"][len("twoway "):])
        return
    _q4901_M.setLocal("q_cmd", _q4901_fx[key]["command"])


def _q4901_lines(path):
    out = []
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for ln in fh:
                if ln.strip() and not ln.startswith((". ", "> ")):
                    out.append(_q4901_re.sub(r"\s+", " ", ln).strip())
    except OSError:
        pass
    return out


def _q4901_clean(text):
    for ch, to in (('"', "'"), ("\x60", "'"), ("$", "S")):
        text = text.replace(ch, to)
    return text[:200]


def _q4901_judge(case, key, path, rc):
    got = _q4901_lines(path)
    rc = int(rc)
    if case == "Q4901-2":
        ok = rc != 0 and len(got) == 1
        want = "one line"
    else:
        r = _q4901_fx[key]
        tw = r["twoway_lines"]
        want = tw[0] if tw else ""
        ok = rc == r["twoway_rc"] and got[:1] == tw[:1]
        if case == "Q4901-3" and key in _q4901_one:
            ok = ok and len(got) == 1
        if case == "Q4901-4":
            base = _q4901_fx["pt7.kept.plottype"]["dash_lines"][1:]
            ok = rc == r["twoway_rc"] and got[1:] == base and len(base) >= 3
            want = "the Supported list: " + " / ".join(base)
        if case == "Q4901-5":
            ok = rc == r["dash_rc"] and got == r["dash_lines"]
            want = " / ".join(r["dash_lines"])
    _q4901_M.setLocal("q_ok", "1" if ok else "0")
    _q4901_M.setLocal("q_got", _q4901_clean(" / ".join(got)))
    _q4901_M.setLocal("q_want", _q4901_clean(want))
end
capture program drop _q4901
program define _q4901
    version 19
    args case key
    quietly sysuse auto, clear
    quietly generate yl = mpg - 1
    quietly generate yh = mpg + 1
    python: import __main__; __main__._q4901_take("`key'")
    set linesize 255
    capture dash clear
    capture log close _ovlog
    capture erase "`c(tmpdir)'dash_ov.log"
    quietly log using "`c(tmpdir)'dash_ov.log", name(_ovlog) text replace
    capture noisily dash `q_cmd'
    local rc = _rc
    quietly log close _ovlog
    python: import __main__; __main__._q4901_judge("`case'", "`key'", r"`c(tmpdir)'dash_ov.log", "`rc'")
    _ov_assert `case' "(`q_ok' == 1)" `"`key': rc `rc'; dash said: `macval(q_got)'; want: `macval(q_want)'"'
    set linesize 80
end
foreach _q49k of local q_typed {
    _q4901 Q4901-1 `_q49k'
}
foreach _q49k of local q_tr10 {
    _q4901 Q4901-2 `_q49k'
}
foreach _q49k of local q_sd12 {
    _q4901 Q4901-3 `_q49k'
}
foreach _q49k in pt7.kept.plottype sd12.E08 {
    _q4901 Q4901-4 `_q49k'
}
foreach _q49k of local q_kept {
    _q4901 Q4901-5 `_q49k'
}
capture dash clear

// Summary
// ----------------------------------------------------------------
local nfail    = ${ov_nfail}
local faillist "${ov_faillist}"
macro drop ov_nfail ov_faillist
capture dash clear
capture erase "`c(tmpdir)'dash_ov.log"
display as text ""
display as text "============================================================"
if `nfail' == 0 {
    display as text "  test_option_validation: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_option_validation: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
