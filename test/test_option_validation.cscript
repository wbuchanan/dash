_af_case AF-11 `"dash scatter mpg weight, xvarformat(%9.2f) yvarformat(%9.1f) name(af11)"' 0 "" `""xvarformat":"%9.2f""'
_af_case AF-12 `"dash scatter mpg weight, xvarformat(bogus) name(af12)"' 0 "" `""xvarformat":"bogus""'
