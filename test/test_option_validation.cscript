local ++_u50n
local _u50c`_u50n' `"lfit mpg weight, bogus atobs atobs"'
local _u50m`_u50n' `"option bogus not allowed"'
local ++_u50n
local _u50c`_u50n' `"lowess mpg weight, bogus lo nolo"'
local _u50m`_u50n' `"option bogus not allowed"'
local ++_u50n
local _u50c`_u50n' `"lowess mpg weight, lo nolo bogus"'
local _u50m`_u50n' `"option nolo not allowed"'
local ++_u50n
local _u50c`_u50n' `"kdensity mpg, epan2 bogus"'
local _u50m`_u50n' `"option bogus not allowed"'
local ++_u50n
local _u50c`_u50n' `"kdensity mpg, ep bogus"'
local _u50m`_u50n' `"option bogus not allowed"'
local ++_u50n
local _u50c`_u50n' `"(scatter mpg weight), bogus"'
local _u50m`_u50n' `"option bogus not allowed"'
local ++_u50n
local _u50c`_u50n' `"(scatter mpg weight), xsize(3) xsize(4) bogus"'
local _u50m`_u50n' `"option xsize() not allowed"'
local ++_u50n
local _u50c`_u50n' `"(scatter mpg weight), bogus atobs"'
local _u50m`_u50n' `"option bogus not allowed"'
local ++_u50n
local _u50c`_u50n' `"(scatter mpg weight), atobs bogus"'
local _u50m`_u50n' `"option atobs not allowed"'
local ++_u50n
local _u50c`_u50n' `"(scatter mpg weight), ATOBS bogus"'
local _u50m`_u50n' `"option ATOBS not allowed"'
local ++_u50n
local _u50c`_u50n' `"(scatter mpg weight, bogus)"'
local _u50m`_u50n' `"option bogus not allowed"'
local ++_u50n
local _u50c`_u50n' `"scatter mpg weight || line mpg weight, bogus"'
local _u50m`_u50n' `"option bogus not allowed"'
local ++_u50n
local _u50c`_u50n' `"scatter mpg weight, bogus || line mpg weight, zork"'
local _u50m`_u50n' `"option bogus not allowed"'
local ++_u50n
local _u50c`_u50n' `"scatter mpg weight, below || line mpg weight, below bogus"'
local _u50m`_u50n' `"option bogus not allowed"'
local ++_u50n
local _u50c`_u50n' `"(scatter mpg weight), bogus xsize(3) xsize(4)"'
local _u50m`_u50n' `"option bogus not allowed"'
local ++_u50n
local _u50c`_u50n' `"(scatter mpg weight), bogus below below"'
local _u50m`_u50n' `"option bogus not allowed"'
local ++_u50n
local _u50c`_u50n' `"(scatter mpg weight), below below bogus"'
local _u50m`_u50n' `"option below not allowed"'
// dash.sthlp's claim: a typo of title() twoway refuses (measured 19oct2026).
local ++_u50n
local _u50c`_u50n' `"scatter mpg weight, titel(x)"'
local _u50m`_u50n' `"option titel() not allowed"'
// WP-32 (U50-57..U50-62): across || segments and plot groups, every plot's own
// options are read before any kernel, mlabfontface() or graph option given
// twice, and the options after the groups' comma last (measured 19oct2026).
local ++_u50n
local _u50c`_u50n' `"kdensity mpg, gaussian epan2 || scatter mpg weight, bogus"'
local _u50m`_u50n' `"option bogus not allowed"'
local ++_u50n
local _u50c`_u50n' `"scatter mpg weight, xsize(3) xsize(4) || line mpg weight, bogus"'
local _u50m`_u50n' `"option bogus not allowed"'
local ++_u50n
local _u50c`_u50n' `"(scatter mpg weight, bogus), xsize(3) xsize(4)"'
local _u50m`_u50n' `"option bogus not allowed"'
local ++_u50n
local _u50c`_u50n' `"(scatter mpg weight, xsize(3) xsize(4)), bogus"'
local _u50m`_u50n' `"option xsize() not allowed"'
local ++_u50n
local _u50c`_u50n' `"(kdensity mpg, gaussian epan2), bogus"'
local _u50m`_u50n' `"only one kernel may be specified"'
local ++_u50n
local _u50c`_u50n' `"(scatter mpg weight, mlabfontface(x)), bogus"'
local _u50m`_u50n' `"option(s) fontface(x) not allowed"'
forvalues _u50k = 1/`_u50n' {
    local _u50x `"`_u50c`_u50k''"'
    local _u50sep ","
    if strpos(`"`_u50x'"', ",") local _u50sep ""
    if substr(`"`_u50x'"', 1, 1) == "(" & !strpos(`"`_u50x'"', "),") local _u50sep ","
    capture dash clear
    capture log close _ovlog
    log using "`c(tmpdir)'dash_ov.log", name(_ovlog) text replace
    capture noisily dash `_u50x'`_u50sep' name(ovu50)
    local _u50rc = _rc
    log close _ovlog
    _ov_assert U50-`_u50k' "(`_u50rc' == 198)" `"`_u50x': rc `_u50rc' (expected 198, as twoway)"'
    _ov_said U50-`_u50k' `"`_u50m`_u50k''"'
    _ov_count "`c(tmpdir)'dash_ov.log" "ignoring unsupported"
    _ov_assert U50-`_u50k' "(r(n) == 0)" `"`_u50x': not named in the note"'
}
// U50-0: every case above ran (62), so none was skipped by a typo.
_ov_assert U50-0 "(`_u50n' == 62)" "the 62 U50 cases ran"
capture dash clear

// U51 (WP-32): the ignoring note names each word as twoway names it -- "()"
// after one typed with a value or that takes one, none after one typed
// bare (titling, below, logging ...), where it wrote titling() (BUGS.md
// "The "ignoring unsupported" note writes a word typed without a value as
// name(), where twoway's own messages name it as typed").  Each case: the
// command and the names the note must end with.
// U51-1 .. U51-8, one case each; each prints its verdict, the first as
// "U51-1 PASS".
// Flipped (WP-47 basic:PT-10): U51-2 and U51-3 named afcolor() and
// afintensity(), which dash now reads as fcolor() and fintensity(), as
// twoway draws them (alias_truth.json P1); bmcolor() and bmlwidth(), back
// marker options dash still names, take their place.
// Flipped (WP-49 basic:PT-12): the in-plot cases are taken in silence on
// scatter and bar, as twoway draws the same picture with them and prints
// nothing (noted_option_truth.json probes); on contour and contourline
// twoway's picture differs and dash names them, so the cases are carried
// there (titling, silent on every type, by copyscheme).  U51-5's words
// after the plot groups' comma are noted still.
local _u51n 0
foreach _u51p in "contour mpg weight price, copyscheme|copyscheme)" ///
    "contour mpg weight price, bmcolor(red) below|bmcolor() below)" ///
    "contour mpg weight price, logging bmlwidth(thin)|logging bmlwidth())" ///
    "contour mpg weight price, clalign(outside)|clalign())" ///
    "(scatter mpg weight), titling below|titling below)" ///
    "contour mpg weight price, logging|logging)" ///
    "contourline mpg weight price, omitallmiss|omitallmiss)" ///
    "contour mpg weight price, nologging|nologging)" {
    local ++_u51n
    gettoken _u51x _u51m : _u51p, parse("|")
    local _u51m = substr(`"`_u51m'"', 2, .)
    capture dash clear
    capture log close _ovlog
    log using "`c(tmpdir)'dash_ov.log", name(_ovlog) text replace
    capture noisily dash `_u51x' name(ovu51)
    local _u51rc = _rc
    log close _ovlog
    _ov_assert U51-`_u51n' "(`_u51rc' == 0)" `"`_u51x': rc `_u51rc' (expected 0)"'
    _ov_said U51-`_u51n' `"ignoring unsupported option(s): `_u51m'"'
}
// Flipped (WP-32): U51-4, U51-6 and U51-7 were sort() and a bare sort on
// scatter and bar, drawn in sort order now and named by nothing (U55);
// maxaxes(), logging and omitallmiss, which twoway takes and dash names,
// carry the cases.
// Flipped (WP-35 GW-3): U51-4 was maxaxes(2), which is checked and taken
// in silence now (Q3506-3); zmtick(), which twoway takes on scatter and
// dash names, carries the case.
// Flipped (WP-42 AX-12): zmtick() is drawn on the colour key and taken in
// silence; numkeys(), which twoway takes and dash names, carries it.
// Flipped (WP-47 basic:PT-11): numkeys(2) is drawn now (two keys, as
// twoway keys the plot: noted_drawn_truth.json NK01); clalign(), which
// twoway takes and draws nothing different with, carries U51-4.
// Flipped (WP-32): U51-8's bare headlabel on pcspike is taken in silence,
// as twoway draws nothing of it there (U55-6); a bare nologging carries
// U51-8.
// U51-6 .. U51-8 (WP-32): a bare sort, which dash does not draw on
// scatter or bar, and a bare headlabel on pcspike are named as typed, as
// twoway names them, where the note wrote sort() and headlabel() (BUGS.md
// "A bare sort or headlabel is named sort() or headlabel() in the note").
_ov_assert U51-0 "(`_u51n' == 8)" "the 8 U51 cases ran"
capture dash clear

// U52 (WP-32): an option dash declares and named in its note as not
// drawn, which twoway refuses on that plot type, is refused as twoway
// refuses it, r(198), naming the word as typed, in the list's order:
// at(), blabel(), ciopts(), fitopts(), lineopts(), mlabwidth(), filter()
// and link() on all forty-four types, filter() and link() after the plot
// groups' comma, headlabel off the paired-coordinate types (measured
// 19oct2026, test/fixtures/noted_option_truth.json; BUGS.md "dash names
// in its note, as not drawn, options twoway refuses on that plot type").
// U52-1 .. U52-19, one case each; each prints its verdict, the first as
// "U52-1 PASS".
local _u52n 0
foreach _u52p in "scatter mpg weight, at(mpg)@option at() not allowed" ///
    "bar mpg weight, blabel(total)@option blabel() not allowed" ///
    "lfitci mpg weight, ciopts(lcolor(red))@option ciopts() not allowed" ///
    "lfitci mpg weight, fitopts(lcolor(red))@option fitopts() not allowed" ///
    "kdensity mpg, lineopts(lcolor(red))@option lineopts() not allowed" ///
    "scatter mpg weight, mlabel(make) mlabwidth(thick)@option mlabwidth() not allowed" ///
    "scatter mpg weight, mlabw(thick)@option mlabw() not allowed" ///
    "scatter mpg weight, filter(foreign)@option filter() not allowed" ///
    "scatter mpg weight, filt(foreign)@option filt() not allowed" ///
    "scatter mpg weight, link(g1)@option link() not allowed" ///
    "scatter mpg weight, headlabel@option headlabel not allowed" ///
    "lfit mpg weight, head@option head not allowed" ///
    "(scatter mpg weight), filter(foreign)@option filter() not allowed" ///
    "(scatter mpg weight), link(g1)@option link() not allowed" ///
    "scatter mpg weight, at(1) bogus@option at() not allowed" ///
    "scatter mpg weight, bogus at(1)@option bogus not allowed" ///
    "function y = x, range(0 1) at(1)@option at() not allowed" ///
    "scatter mpg weight, afcolor(red) mlabwidth(1)@option mlabwidth() not allowed" ///
    "scatter mpg weight || line mpg weight, blabel(total)@option blabel() not allowed" {
    local ++_u52n
    gettoken _u52x _u52m : _u52p, parse("@")
    local _u52m = substr(`"`_u52m'"', 2, .)
    capture dash clear
    capture log close _ovlog
    log using "`c(tmpdir)'dash_ov.log", name(_ovlog) text replace
    capture noisily dash `_u52x' name(ovu52)
    local _u52rc = _rc
    log close _ovlog
    _ov_assert U52-`_u52n' "(`_u52rc' == 198)" `"`_u52x': rc `_u52rc' (expected 198, as twoway)"'
    _ov_said U52-`_u52n' `"`_u52m'"'
    _ov_count "`c(tmpdir)'dash_ov.log" "ignoring unsupported"
    _ov_assert U52-`_u52n' "(r(n) == 0)" `"`_u52x': not named in the note"'
}
_ov_assert U52-0 "(`_u52n' == 19)" "the 19 U52 cases ran"
// U52-20: where twoway takes headlabel (pcspike) and draws nothing of it,
// dash takes it in silence.  Flipped: WP-32 -- it was named, which was
// wrong because twoway draws the same picture (U55).
capture dash clear
capture log close _ovlog
log using "`c(tmpdir)'dash_ov.log", name(_ovlog) text replace
capture noisily dash pcspike mpg weight trunk turn, headlabel name(ovu52)
local _u52rc = _rc
log close _ovlog
_ov_assert U52-20 "(`_u52rc' == 0)" "pcspike, headlabel: rc `_u52rc' (expected 0)"
_ov_count "`c(tmpdir)'dash_ov.log" "ignoring unsupported"
_ov_assert U52-20 "(r(n) == 0)" "pcspike, headlabel: not named"
capture dash clear

// U53 (WP-32): a bare replace with nothing to replace -- no saving(), or a
// named graph, which writes nothing -- is refused as twoway refuses it in
// every position, "option replace not allowed", r(198), where dash named
// it in its note; twoway refuses it beside saving() too, and in the
// list's order (measured 19oct2026, test/fixtures/noted_option_truth.json
// graph_level; BUGS.md "A bare replace with nothing to replace is named
// in the note, where twoway refuses it"); beside the one-line form's
// saving() too (U53-0b), where saving(f, replace) writes over (U53-0c).
// U53-1 .. U53-7, one case each; each prints its verdict, the first as
// "U53-1 PASS".
local _u53n 0
foreach _u53p in "scatter mpg weight, replace@option replace not allowed" ///
    "(scatter mpg weight), replace@option replace not allowed" ///
    "scatter mpg weight || line mpg weight, replace@option replace not allowed" ///
    "scatter mpg weight, name(ovu53) replace@option replace not allowed" ///
    "(scatter mpg weight), name(ovu53) replace@option replace not allowed" ///
    "scatter mpg weight, name(ovu53) saving(ovu53) replace@option replace not allowed" ///
    "scatter mpg weight, name(ovu53) replace bogus@option replace not allowed" {
    local ++_u53n
    gettoken _u53x _u53m : _u53p, parse("@")
    local _u53m = substr(`"`_u53m'"', 2, .)
    capture dash clear
    capture log close _ovlog
    log using "`c(tmpdir)'dash_ov.log", name(_ovlog) text replace
    capture noisily dash `_u53x'
    local _u53rc = _rc
    log close _ovlog
    _ov_assert U53-`_u53n' "(`_u53rc' == 198)" `"`_u53x': rc `_u53rc' (expected 198, as twoway)"'
    _ov_said U53-`_u53n' `"`_u53m'"'
    _ov_count "`c(tmpdir)'dash_ov.log" "ignoring unsupported"
    _ov_assert U53-`_u53n' "(r(n) == 0)" `"`_u53x': not named in the note"'
    _ov_count "`c(tmpdir)'dash_ov.log" "registered"
    _ov_assert U53-`_u53n' "(r(n) == 0)" `"`_u53x': nothing registered"'
}
_ov_assert U53-0 "(`_u53n' == 7)" "the 7 U53 cases ran"
// U53-0b: Flipped (WP-32, maintainer ruling 19oct2026): the one-line
// form's saving() took a bare replace, as dash build takes it, which was
// wrong because twoway refuses a bare replace beside saving() too, r(198)
// (noted_option_truth.json graph_level).  It is refused, the file kept;
// twoway's saving(f, replace) writes over it.
capture erase "`c(tmpdir)'ovu53b.html"
capture dash clear
capture log close _ovlog
log using "`c(tmpdir)'dash_ov.log", name(_ovlog) text replace
capture noisily dash scatter mpg weight, saving("`c(tmpdir)'ovu53b.html") replace
local _u53rc = _rc
log close _ovlog
_ov_assert U53-0b "(`_u53rc' == 198)" "one-line saving() replace: rc `_u53rc' (expected 198, as twoway)"
_ov_said U53-0b "option replace not allowed"
capture confirm file "`c(tmpdir)'ovu53b.html"
_ov_assert U53-0b "(_rc != 0)" "one-line saving() replace: no page written"
// U53-0c: saving(f, replace) writes over a file there, as twoway's does.
capture file close _u53fh
file open _u53fh using "`c(tmpdir)'ovu53b.html", write replace text
file write _u53fh "users file" _n
file close _u53fh
capture noisily dash scatter mpg weight, saving("`c(tmpdir)'ovu53b.html", replace)
local _u53rc = _rc
_ov_assert U53-0c "(`_u53rc' == 0)" "saving(f, replace): rc `_u53rc' (expected 0)"
mata: st_local("_u53w", strofreal(strpos(invtokens(cat(c("tmpdir") + "ovu53b.html")'), "users file") == 0))
_ov_assert U53-0c "(`_u53w' == 1)" "saving(f, replace): the file was written over"
capture erase "`c(tmpdir)'ovu53b.html"
capture dash clear

// U54 (WP-32): play() is looked for as twoway's gr_play looks for it --
// ".grec" added when the file name has no extension, then the name as
// given (the working directory, or a path), then PERSONAL's grec/
// folder, never the rest of the ado-path -- and refused as twoway refuses
// it: none found is "recording <name> not found in either PERSONAL or
// working directory", r(601); a file without the GREC header is "<file>
// is not a Graph Recorder file", r(198); each after every other refusal
// of the command, as twoway plays a recording last; play() empty is
// taken (measured 19oct2026, StataNow 19.5, gr_play.ado and
// _gs_rec_rdfilehdr.ado; BUGS.md "play() is named in the note, where
// twoway refuses a recording it cannot find or read").  A recording
// twoway can read is refused too, r(198): dash cannot apply Graph Editor
// edits to a dashboard.  PERSONAL is set for the session only and put
// back.
// U54-1 .. U54-10, one case each; each prints its verdict, the first as
// "U54-1 PASS".
local _u54d "`c(tmpdir)'ovu54"
capture mkdir "`_u54d'"
capture mkdir "`_u54d'/pers"
capture mkdir "`_u54d'/pers/grec"
capture mkdir "`_u54d'/adod"
local _u54pers "`c(sysdir_personal)'"
capture program drop _u54_rec
program define _u54_rec
    args f good
    tempname fh
    file open `fh' using `"`f'"', write replace text
    if `good' {
        file write `fh' "StataFileTM:00001:01100:GREC:                          :" _n
        file write `fh' "00008:00008:00001:" _n
        file write `fh' "*! classname: twowaygraph_g" _n
        file write `fh' "*! end" _n
    }
    else file write `fh' "hello" _n
    file close `fh'
end
_u54_rec "`_u54d'/bad.grec" 0
_u54_rec "`_u54d'/ok.grec" 1
_u54_rec "`_u54d'/ok.txt" 1
_u54_rec "`_u54d'/pers/grec/pp.grec" 0
_u54_rec "`_u54d'/pers/pq.grec" 1
_u54_rec "`_u54d'/adod/pa.grec" 1
sysdir set PERSONAL "`_u54d'/pers/"
adopath ++ "`_u54d'/adod"
local _u54n 0
foreach _u54p in "scatter mpg weight, play(ovu54_none)@601@recording ovu54_none not found in either PERSONAL or working directory" ///
    "scatter mpg weight, play(`_u54d'/bad)@198@`_u54d'/bad.grec is not a Graph Recorder file" ///
    "scatter mpg weight, play(`_u54d'/ok)@198@dash cannot apply its Graph Editor edits" ///
    "scatter mpg weight, play(`_u54d'/ok.txt)@198@dash cannot apply its Graph Editor edits" ///
    "scatter mpg weight, play(`_u54d'/ok.txt.grec)@601@not found in either PERSONAL or working directory" ///
    "scatter mpg weight, play(pp)@198@`_u54d'/pers/grec/pp.grec is not a Graph Recorder file" ///
    "scatter mpg weight, play(pq)@601@recording pq not found in either PERSONAL or working directory" ///
    "scatter mpg weight, play(pa)@601@recording pa not found in either PERSONAL or working directory" ///
    "(scatter mpg weight), play(ovu54_none)@601@recording ovu54_none not found" ///
    "scatter mpg weight, play(ovu54_none) bogus@198@option bogus not allowed" ///
    "kdensity mpg, play(ovu54_none) gaussian epan2@198@only one kernel may be specified" ///
    "scatter mpg weight, play(ovu54_none) xsize(3) xsize(4)@198@option xsize() not allowed" {
    local ++_u54n
    gettoken _u54x _u54r : _u54p, parse("@")
    gettoken _u54a _u54r : _u54r, parse("@")
    gettoken _u54w _u54r : _u54r, parse("@")
    gettoken _u54a _u54m : _u54r, parse("@")
    capture dash clear
    capture log close _ovlog
    log using "`c(tmpdir)'dash_ov.log", name(_ovlog) text replace
    capture noisily dash `_u54x' name(ovu54)
    local _u54rc = _rc
    log close _ovlog
    _ov_assert U54-`_u54n' "(`_u54rc' == `_u54w')" `"`_u54x': rc `_u54rc' (expected `_u54w', as twoway)"'
    _ov_said U54-`_u54n' `"`_u54m'"'
    _ov_count "`c(tmpdir)'dash_ov.log" "ignoring unsupported"
    _ov_assert U54-`_u54n' "(r(n) == 0)" `"`_u54x': not named in the note"'
}
_ov_assert U54-0 "(`_u54n' == 12)" "the 12 U54 cases ran"
// U54-0b: an empty play() is taken in silence, as twoway takes it.
capture dash clear
capture log close _ovlog
log using "`c(tmpdir)'dash_ov.log", name(_ovlog) text replace
capture noisily dash scatter mpg weight, play() name(ovu54)
local _u54rc = _rc
log close _ovlog
_ov_assert U54-0b "(`_u54rc' == 0)" "play(): rc `_u54rc' (expected 0)"
_ov_count "`c(tmpdir)'dash_ov.log" "ignoring unsupported"
_ov_assert U54-0b "(r(n) == 0)" "play(): nothing named"
sysdir set PERSONAL "`_u54pers'"
adopath - "`_u54d'/adod"
capture program drop _u54_rec
foreach _u54f in bad.grec ok.grec ok.txt pers/grec/pp.grec pers/pq.grec adod/pa.grec {
    capture erase "`_u54d'/`_u54f'"
}
capture dash clear

// U55 (WP-32): an option dash declares and does not draw, which twoway
// takes and draws nothing different with on that plot type, is taken as
// twoway takes it, without a note (measured 19oct2026, graph export SVG,
// test/fixtures/noted_option_truth.json; BUGS.md "dash names options
// twoway takes and draws nothing of, where twoway is silent").  Where
// twoway does draw something different, the note stays (U55-11).
// Flipped (WP-32): U55-12, lstyle() on area, was named; it is drawn now,
// the outline in the named line style, as twoway draws it.
// U55-1 .. U55-12, one case each; each prints its verdict, the first as
// "U55-1 PASS".
local _u55n 0
foreach _u55p in "scatter mpg weight, acolor(red) alcolor(red) alwidth(thick) alpattern(dash)@0" ///
    "line mpg weight, alwidth(thick)@0" ///
    "scatter mpg weight, bmlinestyle(p3)@0" ///
    "dot mpg weight, dlalign(inside)@0" ///
    "scatter mpg weight, mangle(30) barbsize(2)@0" ///
    "pcspike mpg weight trunk turn, headlabel@0" ///
    "rbar mpg trunk weight, msize(small)@0" ///
    "dot mpg weight, recast(line)@0" ///
    "lfit mpg weight, sort@0" ///
    "histogram mpg, sort(price)@0" ///
    "area mpg weight, lstyle(p3)@0" ///
    "pcarrow mpg weight trunk turn, mstyle(p3) mlstyle(p4)@0" ///
    "rbar mpg trunk weight, baroffset(1)@0" ///
    "histogram mpg, mwidth@0" ///
    "contour mpg weight length, bmlinestyle(p3) acolor(red)@0" ///
    "contourline mpg weight length, sort dlalign(inside)@0" ///
    "scatter mpg weight, sort@0" ///
    "scatter mpg weight, sort(price)@0" ///
    "pcspike mpg weight trunk turn, sort@0" ///
    "contour mpg weight length, outlines@0" ///
    "contour mpg weight length, alpattern(dash)@0" ///
    "contour mpg weight length, sort@0" {
    local ++_u55n
    if `_u55n' == 11 local ++_u55n
    gettoken _u55x _u55w : _u55p, parse("@")
    local _u55w = substr("`_u55w'", 2, .)
    capture dash clear
    capture log close _ovlog
    log using "`c(tmpdir)'dash_ov.log", name(_ovlog) text replace
    capture noisily dash `_u55x' name(ovu55)
    local _u55rc = _rc
    log close _ovlog
    _ov_assert U55-`_u55n' "(`_u55rc' == 0)" `"`_u55x': rc `_u55rc' (expected 0)"'
    _ov_count "`c(tmpdir)'dash_ov.log" "ignoring unsupported"
    _ov_assert U55-`_u55n' "(r(n) == `_u55w')" `"`_u55x': `r(n)' note(s) (expected `_u55w')"'
}
// 12 -> 13: WP-32 mstyle()/mlstyle() on pcarrow drawn, not named.
// 13 -> 14: WP-32 baroffset() on rbar drawn, not named.
// 14 -> 15: WP-32 mwidth on histogram drawn, not named.
// 15 -> 17: WP-32 contour and contourline measured on a grid: taken in
// silence where twoway draws the same.
// 17 -> 20: WP-32 sort and sort(varlist) on the marker types drawn in
// sort order, not named.
// 20 -> 23: WP-32 contour's outlines, alpattern() and sort drawn, not
// named.
// 23 -> 22 cases: U55-11 goes with the option contour no longer takes
// (D65); its id is skipped so the later ids keep their numbers.
_ov_assert U55-0 "(`_u55n' == 23)" "the 22 U55 cases ran (U55-11 retired)"
// U55-0s (WP-32): sort(price) on scatter writes its rank list, which
// both renderers draw the layer in.
capture dash clear
quietly dash scatter mpg weight, sort(price) name(ovu55s)
_ov_has "ovu55s" `""sortvars":"price""'
_ov_assert U55-0s "(r(found) == 1)" "scatter sort(price): the spec names its sort list"
capture dash clear

// Q4705-7 (WP-47 basic:PT-11): the noted options dash now draws are still
// refused where twoway refuses them, with twoway's return code and words,
// each measured here beside dash (noted_option_truth.json: bartype(),
// dropto() off the bar family, noback off mspline and mband; numkeys()'s
// values, noted_drawn_truth.json NK08, NK09).
local _q57n 0
foreach _q57 in "scatter mpg weight, bartype(spanning)#option bartype() not allowed" "scatter mpg weight, dropto(y)#option dropto() not allowed" "scatter mpg weight, noback#option noback not allowed" "scatter mpg weight, numkeys(abc) || scatter turn weight ||,#abc not found" "scatter mpg weight, numkeys(-1) || scatter turn weight ||,#invalid syntax" "lfit mpg weight, bart(spanning)#option bart() not allowed" {
    local ++_q57n
    gettoken _q57c _q57w : _q57, parse("#")
    local _q57w = substr(`"`_q57w'"', 2, .)
    capture dash clear
    capture log close _ovlog
    log using "`c(tmpdir)'dash_ov.log", name(_ovlog) text replace
    capture noisily twoway `_q57c' nodraw
    local _q57t = _rc
    log close _ovlog
    _ov_count "`c(tmpdir)'dash_ov.log" `"`_q57w'"'
    local _q57tn = r(n)
    log using "`c(tmpdir)'dash_ov.log", name(_ovlog) text replace
    capture noisily dash `_q57c' name(ovq57)
    local _q57d = _rc
    log close _ovlog
    _ov_count "`c(tmpdir)'dash_ov.log" `"`_q57w'"'
    _ov_assert Q4705-7 "(`_q57t' != 0 & `_q57d' == `_q57t' & `_q57tn' >= 1 & r(n) >= 1)" `"`_q57c': dash rc `_q57d', twoway rc `_q57t', the words `_q57w'"'
    capture dash clear
}
_ov_assert Q4705-7 "(`_q57n' == 6)" "the six Q4705-7 refusals ran"

// Q3707-1 (WP-37 D65): contour and contourline do not take heatmap; dash
// refuses it, r(198), as it refuses any option contour does not take.
foreach _q71t in contour contourline {
    capture dash clear
    capture log close _ovlog
    log using "`c(tmpdir)'dash_ov.log", name(_ovlog) text replace
    capture noisily dash `_q71t' mpg weight length, heatmap name(ovq71)
    local _q71rc = _rc
    log close _ovlog
    _ov_assert Q3707-1 "(`_q71rc' == 198)" `"`_q71t' heatmap: rc `_q71rc' (expected 198)"'
    _ov_said Q3707-1 "option heatmap not allowed"
}
capture dash clear
capture dash clear

// U56 (WP-32): off the ci types twoway draws acolor(), alcolor(),
// alwidth() and alpattern() as color(), lcolor(), lwidth() and
// lpattern(), each over the plain option whatever their order: on the
// fill types acolor() is color() (fcolor() still fills), on the line and
// paired types the line's colour alone (measured 19oct2026, graph export
// SVG; BUGS.md "The fitarea options are named on the fill, line and
// paired types, where twoway draws them").  dash writes the plain
// options to the spec, so both renderers draw them, and names none.
// U56-1 .. U56-8, one case each; each prints its verdict, the first as
// "U56-1 PASS".
local _u56n 0
foreach _u56p in `"bar mpg weight, acolor(red)@"color":"red"@"lcolor":"red""' ///
    `"bar mpg weight, color(blue) acolor(red)@"color":"red"@"lcolor":"red""' ///
    `"bar mpg weight, fcolor(blue) acolor(red)@"fcolor":"blue"@"color":"red""' ///
    `"spike mpg weight, acolor(red) lcolor(blue)@"lcolor":"red"@"lcolor":"red""' ///
    `"dropline mpg weight, color(blue) acolor(red)@"color":"blue"@"lcolor":"red""' ///
    `"histogram mpg, alwidth(thick) lwidth(thin)@"lwidth":"thick"@"lwidth":"thick""' ///
    `"rcap mpg trunk weight, alpattern(dash)@"lpattern":"dash"@"lpattern":"dash""' ///
    `"pcarrow mpg weight trunk turn, acolor(blue) alcolor(red)@"lcolor":"red"@"lcolor":"red""' {
    local ++_u56n
    gettoken _u56x _u56r : _u56p, parse("@")
    gettoken _u56a _u56r : _u56r, parse("@")
    gettoken _u56k1 _u56r : _u56r, parse("@")
    gettoken _u56a _u56k2 : _u56r, parse("@")
    mata: st_local("_u56k1", subinstr(st_local("_u56k1"), "@", "", .))
    mata: st_local("_u56k2", subinstr(st_local("_u56k2"), "@", "", .))
    capture dash clear
    capture log close _ovlog
    log using "`c(tmpdir)'dash_ov.log", name(_ovlog) text replace
    capture noisily dash `_u56x' name(ovu56)
    local _u56rc = _rc
    log close _ovlog
    _ov_assert U56-`_u56n' "(`_u56rc' == 0)" `"`_u56x': rc `_u56rc' (expected 0)"'
    _ov_count "`c(tmpdir)'dash_ov.log" "ignoring unsupported"
    _ov_assert U56-`_u56n' "(r(n) == 0)" `"`_u56x': not named in the note"'
    _ov_has "ovu56" `"`_u56k1'"'
    _ov_assert U56-`_u56n' "(r(found) == 1)" `"`_u56x': the spec has `_u56k1'"'
    _ov_has "ovu56" `"`_u56k2'"'
    _ov_assert U56-`_u56n' "(r(found) == 1)" `"`_u56x': the spec has `_u56k2'"'
}
_ov_assert U56-0 "(`_u56n' == 8)" "the 8 U56 cases ran"
capture dash clear

// ----------------------------------------------------------------
// Q3307-2..4 (WP-33 33-07): a graph's frame is Stata's own frame prefix,
// as twoway's is; dash takes no frame() option.
// ----------------------------------------------------------------
quietly sysuse auto, clear
quietly generate zz = 1
capture frame drop cars
frame create cars
frame cars: quietly sysuse auto, clear
capture dash clear
// Q3307-2: frame() is refused as twoway refuses it.
capture twoway scatter mpg weight, frame(cars)
local _q2tw = _rc
capture dash scatter mpg weight, name(g2) frame(cars)
local _q2d = _rc
local _q2g : length global dash_frm_g2
_ov_assert Q3307-2 "(`_q2tw' == 198 & `_q2d' == `_q2tw' & `_q2g' == 0)" "frame() refused as twoway refuses it: rc `_q2tw' twoway, `_q2d' dash"
// Q3307-3: a variable missing in the prefixed frame is twoway's refusal.
capture log close _ovlog
log using "`c(tmpdir)'dash_ov.log", name(_ovlog) text replace
capture noisily frame cars: twoway scatter zz weight
local _q3tw = _rc
log close _ovlog
_ov_count "`c(tmpdir)'dash_ov.log" "variable zz not found"
local _q3twn = r(n)
_ov_count "`c(tmpdir)'dash_ov.log" "frame cars not found"
local _q3twf = r(n)
capture log close _ovlog
log using "`c(tmpdir)'dash_ov.log", name(_ovlog) text replace
capture noisily frame cars: dash scatter zz weight, name(g3)
local _q3d = _rc
log close _ovlog
_ov_count "`c(tmpdir)'dash_ov.log" "variable zz not found"
local _q3dn = r(n)
_ov_count "`c(tmpdir)'dash_ov.log" "frame cars not found"
local _q3df = r(n)
local _q3g : length global dash_frm_g3
_ov_assert Q3307-3 "(`_q3tw' == 111 & `_q3d' == 111 & `_q3twn' >= 1 & `_q3dn' >= 1 & `_q3twf' == 0 & `_q3df' == 0 & `_q3g' == 0)" "a variable missing in frame cars: rc `_q3tw' twoway, `_q3d' dash"
// Q3307-4: the refused registration leaves nothing for the next one.
dash scatter mpg weight, name(g9)
local _q4ok = ("${dash_frm_g9}" == c(frame))
_ov_assert Q3307-4 "(`_q4ok' == 1)" "a registration after a refused one records the current frame (got ${dash_frm_g9})"
drop zz
frame drop cars
capture dash clear

// ----------------------------------------------------------------
// Q3506 (WP-35 section 35-06): graph-wide refusals in twoway's words.
// Each key of test/fixtures/graph_refusal_truth.json is run through dash
// on the one-line route and with name(): dash's rc must be the fixture's,
// and for a refusal its first printed line the fixture's first line.
// The helpers are reached through __main__ from inside the program
// (cert_svg.do's TRAP note).
// ----------------------------------------------------------------
python:
import json as _q3506_json
from sfi import Macro as _q3506_M
_q3506_fx = _q3506_json.load(open("fixtures/graph_refusal_truth.json", encoding="utf-8"))


def _q3506_keys(prefix):
    _q3506_M.setLocal("q_keys", " ".join(sorted(k for k in _q3506_fx if k.startswith(prefix))))


def _q3506_take(key):
    r = _q3506_fx[key]
    c = r["cmd"].strip()
    if c.startswith("twoway "):
        c = c[len("twoway "):]
    c = c.replace(" name(zg1, replace)", "").rstrip()
    _q3506_M.setLocal("q_cmd", c)
    _q3506_M.setLocal("q_rc", str(r["rc"]))


def _q3506_judge(key, path, rc):
    r = _q3506_fx[key]
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            text = fh.read()
    except OSError:
        text = ""
    lines = [ln.strip() for ln in text.replace("\n> ", "").splitlines()
             if ln.strip() and not ln.lstrip().startswith(("(note:", "log:", "log type:", "opened on:", "closed on:", "name:"))
             and not ln.startswith("---")]
    got = lines[0] if lines else ""
    ok = int(rc) == r["rc"] and (r["rc"] == 0 or got == r["first"])
    _q3506_M.setLocal("q_ok", "1" if ok else "0")
    _q3506_M.setLocal("q_got", got[:200])
    _q3506_M.setLocal("q_want", r["first"][:200])
end

capture program drop _q3506
program define _q3506
    version 16.0
    args id key
    local logfile "`c(tmpdir)'dash_ov.log"
    python: import __main__ as _q3506_main; _q3506_main._q3506_take("`key'")
    foreach route in line named {
        local c `"`macval(q_cmd)'"'
        if "`route'" == "line" {
            if substr(`"`macval(c)'"', -1, 1) == "," local c = substr(`"`macval(c)'"', 1, strlen(`"`macval(c)'"') - 1)
        }
        else local c `"`macval(c)' name(q3506r)"'
        set linesize 255
        capture dash clear
        capture log close _ovlog
        capture erase "`logfile'"
        quietly log using "`logfile'", name(_ovlog) text replace
        capture noisily dash `macval(c)'
        local rc = _rc
        quietly log close _ovlog
        python: import __main__ as _q3506_main; _q3506_main._q3506_judge("`key'", r"`logfile'", "`rc'")
        _ov_assert `id' "(`q_ok' == 1)" `"`key' (`route'): rc `rc' (twoway `q_rc'); dash said: `macval(q_got)'; twoway: `macval(q_want)'"'
    }
    capture dash clear
end

// Q3506-1 (basic:PT-8, syn:SD-10): two omit options anywhere in one
// command -- one list, two lists, after the comma, the same word twice --
// refused, r(198), naming twoway's words in its order; one drawn; a pair
// on each of the forty-four types, drawn where twoway draws it (the fits
// lfit, qfit, fpfit and their ci forms, scatteri, pci, pcarrowi): every
// omit.* key of the fixture.
// The data the fixture's commands were run on (extract_graph_refusal_truth.do).
quietly sysuse auto, clear
quietly generate yl = mpg - 1
quietly generate yh = mpg + 1
quietly generate t = _n
quietly tsset t
quietly generate gx = mod(_n - 1, 9) + 1 if _n <= 72
quietly generate gy = floor((_n - 1) / 9) + 1 if _n <= 72
quietly generate gz = gx * gy + gy
python: _q3506_keys("omit.")
foreach _q1k of local q_keys {
    _q3506 Q3506-1 `_q1k'
}

// Q3506-3 (GW-3): maxaxes() is checked as twoway checks it -- a value that
// is no integer refused, r(198), "option maxaxes() not allowed"; a
// yaxis() or xaxis() number above it, in any list, r(125), in twoway's
// words, the layers in order and xaxis() before yaxis() in one; any
// integer drawn when no axis is above it; only the full spelling: every
// maxaxes.* key of the fixture.  A valid maxaxes() is not named.
python: _q3506_keys("maxaxes.")
foreach _q3k of local q_keys {
    _q3506 Q3506-3 `_q3k'
}
capture dash clear
capture log close _ovlog
quietly log using "`c(tmpdir)'dash_ov.log", name(_ovlog) text replace
capture noisily dash scatter mpg weight, maxaxes(2) name(q3506n)
local _q3rc = _rc
quietly log close _ovlog
_ov_count "`c(tmpdir)'dash_ov.log" "ignoring unsupported"
_ov_assert Q3506-3 "(`_q3rc' == 0 & r(n) == 0)" "maxaxes(2) taken and not named (rc `_q3rc')"
capture dash clear

// Q3506-5 (sil:SD-8): title(), subtitle(), note() or caption() with
// notitling -- in a list or after the comma, in either order -- is refused,
// r(4018), "<kind>.edit , mtextq(`"<its text>"') : class type not found",
// the first of note, caption, subtitle, title given; notitling alone is
// drawn: every notitling.* key of the fixture.
python: _q3506_keys("notitling.")
foreach _q5k of local q_keys {
    _q3506 Q3506-5 `_q5k'
}

// Q3506-7 (syn:SD-22, ruling D54, documented): twoway's contour and
// contourline with levels() ignore an option they do not know (fixture
// contour.levels_bogus, contourline.levels_bogus: rc 0); dash refuses it
// as it does without levels(), r(198), "option bogus() not allowed", as
// the help says (dash.sthlp "An option contour does not know").
foreach _q7t in contour contourline {
    foreach _q7o in "levels(10) bogus(1)" "bogus(1)" {
        capture dash clear
        capture log close _ovlog
        quietly log using "`c(tmpdir)'dash_ov.log", name(_ovlog) text replace
        capture noisily dash `_q7t' gz gy gx, `_q7o' name(q3506c)
        local _q7rc = _rc
        quietly log close _ovlog
        _ov_count "`c(tmpdir)'dash_ov.log" "option bogus() not allowed"
        _ov_assert Q3506-7 "(`_q7rc' == 198 & r(n) >= 1)" "`_q7t', `_q7o': rc `_q7rc' (expected 198, option bogus() not allowed)"
    }
}
capture dash clear

// ----------------------------------------------------------------
// Q3504 (WP-35 section 35-04): statistical-type refusals in twoway's
// words.  Each key of test/fixtures/stat_refusal_truth.json named is run
// through dash on the data the extractor ran it on: dash's rc must be the
// fixture's; for a refusal its first printed line the fixture's first
// line, and for a drawn probe the log names no option.  A second argument
// is the line that must follow the refusal ("-" none may).
// ----------------------------------------------------------------
python:
import json as _q3504_json
from sfi import Macro as _q3504_M
_q3504_fx = _q3504_json.load(open("fixtures/stat_refusal_truth.json", encoding="utf-8"))


def _q3504_keys(prefix):
    _q3504_M.setLocal("q_keys", " ".join(sorted(k for k in _q3504_fx if k.startswith(prefix))))


def _q3504_take(key):
    r = _q3504_fx[key]
    c = r["cmd"].strip()
    if c.startswith("twoway "):
        c = c[len("twoway "):]
    _q3504_M.setLocal("q_cmd", c)
    _q3504_M.setLocal("q_rc", str(r["rc"]))
    _q3504_M.setLocal("q_data", "sandstone" if key.startswith("contour.") else "auto")


def _q3504_judge(key, path, rc, second):
    r = _q3504_fx[key]
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            text = fh.read()
    except OSError:
        text = ""
    lines = [ln.strip() for ln in text.replace("\n> ", "").splitlines()
             if ln.strip() and not ln.lstrip().startswith(("(note:", "log:", "log type:", "opened on:", "closed on:", "name:"))
             and not ln.startswith("---")]
    got = lines[0] if lines else ""
    nxt = lines[1] if len(lines) > 1 else ""
    ok = int(rc) == r["rc"]
    if r["rc"]:
        ok = ok and got == r["message"]
        if second == "-":
            ok = ok and "use barwidth()" not in lines[1:]
        elif second:
            ok = ok and nxt == second
    else:
        ok = ok and "ignoring unsupported" not in text
    _q3504_M.setLocal("q_ok", "1" if ok else "0")
    _q3504_M.setLocal("q_got", (got + " / " + nxt)[:200])
    _q3504_M.setLocal("q_want", (r["message"] + " / " + second)[:200])
end

capture program drop _q3504
program define _q3504
    version 16.0
    args id key second
    local logfile "`c(tmpdir)'dash_ov.log"
    python: import __main__ as _q3504_main; _q3504_main._q3504_take("`key'")
    quietly sysuse `q_data', clear
    set linesize 255
    capture dash clear
    capture log close _ovlog
    capture erase "`logfile'"
    quietly log using "`logfile'", name(_ovlog) text replace
    capture noisily dash `macval(q_cmd)' name(q3504r)
    local rc = _rc
    quietly log close _ovlog
    python: import __main__ as _q3504_main; _q3504_main._q3504_judge("`key'", r"`logfile'", "`rc'", r"""`second'""")
    _ov_assert `id' "(`q_ok' == 1)" `"`key': rc `rc' (twoway `q_rc'); dash said: `macval(q_got)'; twoway: `macval(q_want)'"'
    capture dash clear
end

// Q3504-1 (stat:PT-1): histogram with bin() and width(), or with two or
// three of density, fraction, frequency and percent, refused r(198),
// "options bins() and width() may not be combined" and "options <words>
// may not be combined" (twoway's order); discrete with bin() still first.
foreach _q1k in hist.bins_width hist.density_fraction hist.fraction_percent hist.frequency_density hist.percent_frequency hist.density_fraction_frequency hist.discrete_bin_width {
    _q3504 Q3504-1 `_q1k'
}

// Q3504-2 (stat:PT-2): density, fraction, frequency and percent on
// scatter, line, lfit, kdensity, function and bar refused, r(198),
// "option <word> not allowed", as twoway refuses them; on histogram drawn.
python: _q3504_keys("flag.")
foreach _q2k of local q_keys {
    _q3504 Q3504-2 `_q2k'
}

// Q3504-5 (stat:PT-14; P4-7, P4-9): bw() off the bandwidth types is
// refused, r(198), "option bw() not allowed", as twoway refuses it; on
// bar, rbar, histogram, dot and spike, where dash read it as barwidth(),
// the next line is "use barwidth()", and on scatter, line, lfit and fpfit
// no such line follows; on lowess, lpoly, lpolyci and kdensity it is
// bwidth(), drawn with no note.
foreach _q5t in bar rbar histogram dot spike {
    _q3504 Q3504-5 bw.`_q5t' "use barwidth()"
}
foreach _q5t in scatter line lfit fpfit {
    _q3504 Q3504-5 bw.`_q5t' "-"
}
foreach _q5t in lowess lpoly lpolyci kdensity {
    _q3504 Q3504-5 bw.`_q5t'
}

// ----------------------------------------------------------------
// Q3505-1 (WP-35 section 35-05, basic:PT-9): every probe of
// test/fixtures/value_codes_truth.json that twoway refuses -- its
// "probes" and each type of its "per_type" sets -- through dash: the rc
// must be twoway's and the first printed line twoway's first line.
// (value_truth.json's refused probes are test_wp33_truth.cscript's
// Q3310-1; the lwidth(*#) multipliers are basic:PT-13's.)
// ----------------------------------------------------------------
python:
import json as _q3505_json
from sfi import Macro as _q3505_M
with open("fixtures/value_codes_truth.json", encoding="utf-8") as _q3505_fh:
    _q3505_fx = _q3505_json.load(_q3505_fh)
_q3505_rows = {}
for _q3505_k, _q3505_p in _q3505_fx["probes"].items():
    if _q3505_p["rc"] and not _q3505_k.startswith("lwidth_mult_line"):
        _q3505_rows[_q3505_k] = _q3505_p
for _q3505_o, _q3505_tt in _q3505_fx["per_type"].items():
    for _q3505_t, _q3505_p in _q3505_tt.items():
        if _q3505_p["rc"]:
            _q3505_rows[_q3505_o + "." + _q3505_t] = _q3505_p
_q3505_M.setLocal("q_keys", " ".join(sorted(_q3505_rows)))


def _q3505_take(key):
    c = _q3505_rows[key]["command"]
    _q3505_M.setLocal("q_cmd", c[len("twoway "):])
    _q3505_M.setLocal("q_rc", str(_q3505_rows[key]["rc"]))


def _q3505_judge(key, path, rc):
    import re
    r = _q3505_rows[key]
    got = ""
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for ln in fh:
                if ln.strip() and not ln.startswith((". ", "> ")):
                    got = re.sub(r"\s+", " ", ln).strip()
                    break
    except OSError:
        pass
    ok = int(rc) == r["rc"] and got == r["first"]
    _q3505_M.setLocal("q_ok", "1" if ok else "0")
    for name, text in (("q_got", got), ("q_want", r["first"])):
        for ch, to in (('"', "'"), ("\x60", "'"), ("$", "S")):
            text = text.replace(ch, to)
        _q3505_M.setLocal(name, text[:200])
end
