foreach c in `"title("T", color("1,2,3"))"' `"subtitle("T", color("1,2,3"))"' `"note("T", color("1,2,3"))"' ///
        `"caption("T", color("1,2,3"))"' `"xline(3000, lcolor("1,2,3"))"' `"yline(20, lcolor("1,2,3"))"' ///
        `"xlabel(, labcolor("1,2,3"))"' `"ylabel(, labcolor("1,2,3"))"' `"plotregion(color("1,2,3"))"' ///
        `"plotregion(lcolor("1,2,3"))"' `"graphregion(color("1,2,3"))"' `"graphregion(lcolor("1,2,3"))"' ///
        `"legend(color("1,2,3"))"' `"title(, size(medium) color("1,2,3"))"' {
