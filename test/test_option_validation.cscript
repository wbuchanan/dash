local _u50m`_u50n' `"option bogus not allowed"'
local ++_u50n
local _u50c`_u50n' `"scatter mpg weight, bogus scheme(s1color) scheme(s2color)"'
local _u50m`_u50n' `"option bogus not allowed"'
local ++_u50n
local _u50c`_u50n' `"scatter mpg weight, bogus hover(make)"'
local _u50m`_u50n' `"option bogus not allowed"'
local ++_u50n
local _u50c`_u50n' `"scatter mpg weight, xreverse"'
local _u50m`_u50n' `"option xreverse not allowed"'
local ++_u50n
local _u50c`_u50n' `"scatter mpg weight, bargap(10)"'
local _u50m`_u50n' `"option bargap() not allowed"'
local ++_u50n
