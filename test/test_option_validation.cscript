// ----------------------------------------------------------------
// CG-nn (WP-30 P1.13a): a comma-written plot colour is refused as twoway
// refuses it, invalid '<word>', r(198), before anything is registered;
// mcolor("1,,2") and bgcolor("1,2,3") draw in twoway and register here.
// _cg_case: rc must equal `expected'; the log must say `needle' (when
// given); a refusal registers nothing; an acceptance registers cgNN and
// carries `json' (when given).
capture program drop _cg_case
program define _cg_case
    version 16.0
    args id cmdtext expected needle json
    local logfile "`c(tmpdir)'dash_ov.log"
    local nm = "cg" + subinstr("`id'", "CG-", "", 1)
    set linesize 80
    capture log close _ovlog
    capture erase "`logfile'"
    capture dash clear
    log using "`logfile'", name(_ovlog) text replace
    capture noisily `cmdtext'
    local rc = _rc
    log close _ovlog
    local bad = 0
    if `rc' != `expected' {
        display as error `"`id' FAIL: expected rc `expected', got rc `rc': `macval(cmdtext)'"'
        local bad = 1
    }
    if `"`macval(needle)'"' != "" {
        _ov_count "`logfile'" `"`macval(needle)'"'
        if r(n) == 0 {
            display as error `"`id' FAIL: the log does not say `macval(needle)'"'
            local bad = 1
        }
    }
    if `expected' != 0 & `"${dash_json_`nm'}"' != "" {
        display as error `"`id' FAIL: the refused command still registered `nm'"'
        local bad = 1
    }
    if `expected' == 0 & `"${dash_json_`nm'}"' == "" {
        display as error `"`id' FAIL: nothing was registered as `nm'"'
        local bad = 1
    }
    if `expected' == 0 & `"`macval(json)'"' != "" & `bad' == 0 {
        _ov_has "`nm'" `"`macval(json)'"'
        if r(found) != 1 {
            display as error `"`id' FAIL: the registered spec does not carry `macval(json)'"'
            local bad = 1
        }
    }
    if `bad' {
        global ov_nfail    = ${ov_nfail} + 1
        global ov_faillist "${ov_faillist} `id'"
    }
    else display as text `"`id' PASS: rc `rc' -- `macval(cmdtext)'"'
end
_cg_case CG-01 `"dash scatter mpg weight, mcolor("255,0,128") name(cg01)"' 198 "invalid '0'"
_cg_case CG-02 `"dash line mpg weight, lcolor("1,2,3") name(cg02)"' 198 "invalid '2'"
_cg_case CG-03 `"dash scatter mpg weight, mcolor("red,blue") name(cg03)"' 198 "invalid 'blue'"
_cg_case CG-04 `"dash scatter mpg weight, mcolor("1,") name(cg04)"' 198 "invalid 'editcopy'"
_cg_case CG-05 `"dash scatter mpg turn weight, mcolor(red "255,0,0") name(cg05)"' 198 "invalid '0'"
_cg_case CG-06 `"dash scatter mpg weight, mcolor("1,,2") name(cg06)"' 0 ""
_cg_case CG-07 `"dash scatter mpg weight, bgcolor("1,2,3") name(cg07)"' 0 ""
_cg_case CG-08 `"dash scatter mpg weight, mcolor(navy*.5) name(cg08)"' 0 "" `""mcolor":"navy*.5""'

// CG-09 (18oct2026, BUGS.md "mcolor(255 0,0) is refused where twoway notes
// the named style and draws"): twoway reads a colour written with commas
// as its parts between commas, every second one of which must be blank
// (the last with twoway's own editcopy after it): mcolor(255,0,0) is
// "invalid '0'", mcolor(red,) "invalid 'editcopy'", mcolor(1,,2,3)
// "invalid '3'", and mcolor(1,,2) draws "1 2" with a note.  On a plot
// option the rule holds for each stylelist element a y uses --
// mcolor(255 0,0) on one y is the element 255, noted and drawn, and on two
// y "invalid '0'" -- and on a sub-option for the whole value.  Each form's
// rc and refusal line are twoway's, run live beside dash's.
local cg09 0
local cg09log "`c(tmpdir)'zcg09.log"
python: from sfi import Macro as _cgM; _cgv = ['255 0,0', '255,0 0', '"255 0,0"', '255, 0, 0', '255 ,0,0', '255 0 0,', 'red,blue green', 'red blue,green', '1,,2', '1,,2,3', '"255 0" ,0', 'red,"blue"', '"red",blue', '255,,0,,0']; _cgh = ['scatter mpg weight, mcolor(@)', 'scatter mpg weight turn, mcolor(@)', 'line mpg weight, lcolor(@)', 'area mpg weight, fcolor(@)', 'scatter mpg weight, mlabel(make) mlabcolor(@)', 'scatter mpg weight, title("T", color(@))', 'scatter mpg weight, subtitle("T", color(@))', 'scatter mpg weight, note("T", color(@))', 'scatter mpg weight, caption("T", color(@))', 'scatter mpg weight, xline(3000, lcolor(@))', 'scatter mpg weight, yline(20, lcolor(@))', 'scatter mpg weight, xlabel(, labcolor(@))', 'scatter mpg weight, ylabel(, labcolor(@))', 'scatter mpg weight, plotregion(color(@))', 'scatter mpg weight, plotregion(lcolor(@))', 'scatter mpg weight, graphregion(color(@))', 'scatter mpg weight, graphregion(lcolor(@))', 'scatter mpg weight turn, legend(color(@))']; _cgc = [h.replace('@', v) for v in _cgv for h in _cgh]; [_cgM.setLocal("cg09_c%d" % (k + 1), c) for k, c in enumerate(_cgc)]; _cgM.setLocal("cg09_n", str(len(_cgc)))
forvalues i = 1/`cg09_n' {
    local o : copy local cg09_c`i'
    foreach who in twoway dash {
        capture dash clear
        graph drop _all
        capture log close _zcg09
        quietly log using "`cg09log'", text replace name(_zcg09)
        if "`who'" == "twoway" capture noisily twoway `macval(o)' name(zcg09, replace)
        else capture noisily dash `macval(o)' name(zcg09)
        local rc_`who' = _rc
        quietly log close _zcg09
        python: from sfi import Macro as _cgM; _cga = [l.rstrip() for l in open(_cgM.getLocal("cg09log"), encoding="utf-8", errors="replace")]; _cgl = [l.strip() for l in _cga if l.strip().startswith("invalid '")]; _cgM.setLocal("line_`who'", (_cgl[-1] if _cgl else "")[:120])
    }
    mata: st_local("_cg_same", strofreal(st_local("line_twoway") == st_local("line_dash")))
    if `rc_twoway' != `rc_dash' | !`_cg_same' {
        mata: printf("{err}CG-09 FAIL case %s [%s]: twoway r(%s) [%s], dash r(%s) [%s]\n", st_local("i"), st_local("o"), st_local("rc_twoway"), st_local("line_twoway"), st_local("rc_dash"), st_local("line_dash"))
        local cg09 1
    }
}
capture erase "`cg09log'"
capture dash clear
graph drop _all
if `cg09' {
    global ov_nfail    = ${ov_nfail} + 1
    global ov_faillist "${ov_faillist} CG-09"
}
else display as text "CG-09 PASS: blank-and-comma colours refused where twoway refuses them, in its words, and taken where it draws them"

// ----------------------------------------------------------------
// CV-nn: the corpus arbiter.  Every line of the conformance corpus must
// register with rc 0 and no refusal: the table accepts every value the
// documented corpus writes.  Read with `file read' as
// test_conformance.cscript does; a line with no top-level comma needs
// the comma before name().
// ----------------------------------------------------------------
tempname fh
file open `fh' using "fixtures/conformance_corpus.txt", read text
file read `fh' line
local ncv = 0
while r(eof) == 0 {
    if `"`macval(line)'"' != "" {
        local ++ncv
        mata: st_local("_tlc", strofreal(_ov_tlc(st_local("line"))))
        if `_tlc' == 0 {
            local cmd `"dash `macval(line)', name(cv`ncv')"'
        }
        else {
            local cmd `"dash `macval(line)' name(cv`ncv')"'
        }
        _ov_case "CV-`ncv'" `"`macval(cmd)'"' 0 ""
    }
    file read `fh' line
}
file close `fh'
// Every line was probed: the loop ran once per line the fixture holds,
// counted here without it, as test_conformance.cscript C-01 counts them.
// It was held to a floor of 55 while the fixture holds 71 lines, none of
// them blank (measured 24sep2026), so a loop that stopped early lost the
// rest of the corpus without a word.
mata: st_local("cv_lines", strofreal(sum(cat("fixtures/conformance_corpus.txt") :!= "")))
if `cv_lines' == 0 | `ncv' != `cv_lines' {
    display as error "CV FAIL: `ncv' corpus lines were probed; the corpus holds `cv_lines'"
    global ov_nfail    = ${ov_nfail} + 1
    global ov_faillist "${ov_faillist} CV-count"
}
else display as text "CV: all `ncv' corpus lines probed"

// ----------------------------------------------------------------
// HZ: horizontal and vertical refused as twoway refuses them (WP-30 P1.9a)
// ----------------------------------------------------------------
// Each case runs twoway's own command (nodraw) and dash's, and compares
// rc and the first error line (test/fixtures/horizontal_truth.json holds
// the same rows); an accepted case must not name either flag.  E4's
// order: a refusing type names its first refused flag as typed, then the
// two together are refused; recast() is judged first, a derived type on
// both its own type and its target.
capture program drop _hz_case
program define _hz_case
    version 16.0
    args id cmd
    local logfile "`c(tmpdir)'dash_ov.log"
    set linesize 120
    capture log close _ovlog
    capture erase "`logfile'"
    log using "`logfile'", name(_ovlog) text replace
    capture noisily twoway `cmd' nodraw
    local trc = _rc
    log close _ovlog
    // The recast() class notes twoway prints ("<class>type not found in
    // scheme", one per unknown name): none before a refusal of
    // the flags (WP-46: lfit, recast(rsc) horizontal).
    _ov_count "`logfile'" "type not found in scheme"
    local tnote = r(n)
    _ov_count "`logfile'" "not allowed"
    local tline `"`r(line)'"'
    if `trc' != 0 & `"`tline'"' == "" {
        _ov_count "`logfile'" "may not combine"
        local tline `"`r(line)'"'
    }
    capture log close _ovlog
    capture erase "`logfile'"
    capture dash clear
    quietly graph drop _all
    log using "`logfile'", name(_ovlog) text replace
    capture noisily dash `cmd' name(hz)
    local drc = _rc
    log close _ovlog
    _ov_count "`logfile'" "not allowed"
    local dline `"`r(line)'"'
    if `drc' != 0 & `"`dline'"' == "" {
        _ov_count "`logfile'" "may not combine"
        local dline `"`r(line)'"'
    }
    _ov_count "`logfile'" "unsupported option"
    local named = r(n)
    _ov_count "`logfile'" "type not found in scheme"
    local dnote = r(n)
    local bad = (`trc' != `drc') | (strtrim(`"`tline'"') != strtrim(`"`dline'"')) | (`drc' == 0 & `named' > 0) | (`tnote' != `dnote')
    if `bad' {
        display as error `"`id' FAIL: twoway rc `trc' [`tline'], dash rc `drc' [`dline'], named `named', class notes `tnote' vs `dnote': `cmd'"'
        global ov_nfail    = ${ov_nfail} + 1
        global ov_faillist "${ov_faillist} `id'"
    }
    else display as text `"`id' PASS: rc `drc' as twoway -- `cmd'"'
end
_hz_case HZ-01 "scatter mpg weight, horizontal"
_hz_case HZ-02 "kdensity mpg, vertical"
_hz_case HZ-03 "scatter mpg weight, vertical horizontal"
_hz_case HZ-04 "kdensity mpg, horizontal vertical"
_hz_case HZ-05 "bar mpg weight, vertical horizontal"
_hz_case HZ-06 "bar mpg weight, recast(scatter) horizontal"
_hz_case HZ-07 "kdensity mpg, recast(area) vertical"
_hz_case HZ-08 "lfit mpg weight, recast(bar) horizontal"
_hz_case HZ-09 "lfit mpg weight, recast(scatter) horizontal"
_hz_case HZ-10 "histogram mpg, recast(line) vertical"
_hz_case HZ-11 "scatter mpg weight, recast(bar) horizontal"
_hz_case HZ-12 "area mpg weight, recast(line) vertical"
_hz_case HZ-13 "rcap mpg price weight, recast(rscatter) horizontal vertical"
_hz_case HZ-14 "tsline mpg, horizontal"
_hz_case HZ-15 "bar mpg weight, hor"
_hz_case HZ-16 "kdensity mpg, vert horizontal"
// The typed-order scan itself: minimums, parentheses and quoted text.
mata: st_local("_hz_o1", _dash_hz_order("vert hor"))
mata: st_local("_hz_o2", _dash_hz_order("horizontal"))
mata: st_local("_hz_o3", _dash_hz_order("hor(1) ve"))
mata: st_local("_hz_o4", _dash_hz_order(`"title("vert hor") horiz vertical"'))
_ov_assert HZ-17 `"("`_hz_o1'" == "vert hor") & ("`_hz_o2'" == "horizontal") & ("`_hz_o3'" == "") & ("`_hz_o4'" == "horiz vertical")"' "_dash_hz_order reads the flags in typed order, as typed"
// WP-46 RH-1: a range type recast to a yx type takes horizontal and
// vertical (twoway_y2xview_parse reads them for every range source);
// together they are still refused (test/fixtures/horizontal_truth.json
// recast.RH1-*).
_hz_case Q4601-1 "rarea mpg price weight, recast(line) horizontal"
_hz_case Q4601-2 "rcap mpg price weight, recast(scatter) vertical"
_hz_case Q4601-3 "rarea mpg price weight, recast(connected) horizontal"
_hz_case Q4601-4 "rspike mpg price weight, recast(bar) horizontal"
_hz_case Q4601-5 "rarea mpg price weight, recast(area) horizontal"
_hz_case Q4601-6 "rspike mpg price weight, recast(spike) horizontal"
_hz_case Q4601-7 "rcap mpg price weight, recast(dropline) horizontal"
_hz_case Q4601-8 "rbar mpg price weight, recast(dot) horizontal"
_hz_case Q4601-9 "rarea mpg price weight, recast(line) horizontal vertical"
_hz_case Q4601-26 "tsrline mpg price, recast(line) horizontal"
// WP-46 RH-9: judged on the recast word as typed -- dot takes the flags
// only under a bar-like recast typed in full; scatteri recast to a
// bar-like type takes them; an abbreviated bar-like recast takes neither
// (BarOrBarDerived compares the typed word; horizontal_truth.json
// recast.RH9-*).
_hz_case Q4601-10 "dot mpg weight, recast(line) horizontal"
_hz_case Q4601-11 "dot mpg weight, recast(scatter) vertical"
_hz_case Q4601-12 "dot mpg weight, recast(bar) horizontal"
_hz_case Q4601-13 "dot mpg weight, recast(b) horizontal"
_hz_case Q4601-14 "scatteri 1 1 2 2 3 1, recast(bar) horizontal"
_hz_case Q4601-15 "scatteri 1 1 2 2 3 1, recast(area) vertical"
_hz_case Q4601-16 "scatter mpg weight, recast(b) horizontal"
_hz_case Q4601-17 "scatter mpg weight, recast(ba) horizontal"
_hz_case Q4601-18 "scatter mpg weight, recast(bar) horizontal"
_hz_case Q4601-27 "bar mpg weight, recast(b) horizontal"
_hz_case Q4601-28 "lfit mpg weight, recast(b) horizontal"
_hz_case Q4601-29 "dot mpg weight, recast(dot dot) horizontal"
_hz_case Q4601-30 "scatter mpg weight, recast(bar bar) horizontal"
_hz_case Q4601-31 "kdensity mpg, recast(b) horizontal"
_hz_case Q4601-32 "tsline mpg, recast(b) horizontal"
// An unknown recast name with a refused flag: twoway prints the refusal
// alone, no class notes (measured 09nov2026); taken, the notes stay.
_hz_case Q4601-34 "lfit mpg weight, recast(rsc) horizontal"
_hz_case Q4601-35 "scatter mpg weight, recast(zz) horizontal"
_hz_case Q4601-36 "rline mpg price weight, recast(sc) horizontal"
// An abbreviated bar recast is drawn in the plain p# style (D-46-01.d):
// the spec carries typesfx generic; recast(bar) does not.
capture dash clear
capture noisily dash scatter mpg weight, recast(b) name(q4601g)
local _q46_rc = _rc
_ov_has "q4601g" `""typesfx":"generic""'
local _q46_g = r(found)
capture noisily dash scatter mpg weight, recast(bar) name(q4601b)
_ov_has "q4601b" `""typesfx""'
local _q46_b = r(found)
_ov_assert Q4601-33 "(`_q46_rc' == 0) & (`_q46_g' == 1) & (`_q46_b' == 0)" "recast(b) writes typesfx generic, recast(bar) none (rc `_q46_rc', `_q46_g', `_q46_b')"
capture dash clear

// ----------------------------------------------------------------
// U04: an option twoway refuses on a plot type is refused there (WP-31 C3)
// ----------------------------------------------------------------
// _u04_case id expected twoway-command dash-command: both run in this
// session with their logs captured; rc must be `expected' for both and,
// on a refusal, the first error line ("option <opt>() not allowed") the
// same.  On an acceptance nothing may name the option (opt).
capture program drop _u04_case
program define _u04_case
    version 16.0
    args id expected opt tcmd dcmd
    local logfile "`c(tmpdir)'dash_ov.log"
    set linesize 120
    capture log close _ovlog
    capture erase "`logfile'"
    quietly graph drop _all
    log using "`logfile'", name(_ovlog) text replace
    capture noisily twoway `tcmd' nodraw
    local trc = _rc
    log close _ovlog
    _ov_count "`logfile'" "not allowed"
    local tline `"`r(line)'"'
    capture log close _ovlog
    capture erase "`logfile'"
    capture dash clear
    log using "`logfile'", name(_ovlog) text replace
    capture noisily dash `dcmd' name(zu04k)
    local drc = _rc
    log close _ovlog
    _ov_count "`logfile'" "not allowed"
    local dline `"`r(line)'"'
    _ov_count "`logfile'" "`opt'()"
    local named = r(n)
    local bad = (`trc' != `expected') | (`drc' != `expected')
    if `expected' {
        local bad = `bad' | (strtrim(`"`tline'"') != strtrim(`"`dline'"')) | (strtrim(`"`dline'"') != "option `opt'() not allowed")
    }
    else local bad = `bad' | (`named' > 0)
    if `bad' {
        display as error `"`id' FAIL: twoway rc `trc' [`tline'], dash rc `drc' [`dline'], named `named': `dcmd'"'
        global ov_nfail    = ${ov_nfail} + 1
        global ov_faillist "${ov_faillist} `id'"
    }
    else display as text `"`id' PASS: rc `drc' as twoway -- `dcmd'"'
end
// U04-01: one refused pair per option; U04-02: one accepted pair each.
_u04_case U04-01 198 kernel "scatter mpg weight, kernel(gaussian)" "scatter mpg weight, kernel(gaussian)"
_u04_case U04-01 198 n "scatter mpg weight, n(50)" "scatter mpg weight, n(50)"
_u04_case U04-01 198 level "scatter mpg weight, level(90)" "scatter mpg weight, level(90)"
_u04_case U04-01 198 bwidth "scatter mpg weight, bwidth(.5)" "scatter mpg weight, bwidth(.5)"
_u04_case U04-01 198 bands "kdensity mpg, bands(5)" "kdensity mpg, bands(5)"
_u04_case U04-01 198 range "scatter mpg weight, range(1 10)" "scatter mpg weight, range(1 10)"
_u04_case U04-01 198 base "scatter mpg weight, base(0)" "scatter mpg weight, base(0)"
_u04_case U04-01 198 degree "lowess mpg weight, degree(1)" "lowess mpg weight, degree(1)"
_u04_case U04-01 198 bin "scatter mpg weight, bin(5)" "scatter mpg weight, bin(5)"
_u04_case U04-01 198 width "scatter mpg weight, width(1)" "scatter mpg weight, width(1)"
_u04_case U04-01 198 start "scatter mpg weight, start(0)" "scatter mpg weight, start(0)"
_u04_case U04-01 198 barwidth "rspike lo hi weight, barwidth(.5)" "rspike lo hi weight, barwidth(.5)"
_u04_case U04-02 0 kernel "lpoly mpg weight, kernel(gaussian)" "lpoly mpg weight, kernel(gaussian)"
_u04_case U04-02 0 n "lfit mpg weight, n(50)" "lfit mpg weight, n(50)"
_u04_case U04-02 0 level "lfitci mpg weight, level(90)" "lfitci mpg weight, level(90)"
_u04_case U04-02 0 bwidth "lowess mpg weight, bwidth(.5)" "lowess mpg weight, bwidth(.5)"
_u04_case U04-02 0 bands "mband mpg weight, bands(5)" "mband mpg weight, bands(5)"
_u04_case U04-02 0 range "function y = x, range(1 10)" "function y = x, range(1 10)"
_u04_case U04-02 0 base "bar mpg weight, base(0)" "bar mpg weight, base(0)"
_u04_case U04-02 0 degree "lpoly mpg weight, degree(1)" "lpoly mpg weight, degree(1)"
_u04_case U04-02 0 bin "histogram mpg, bin(5)" "histogram mpg, bin(5)"
_u04_case U04-02 0 width "histogram mpg, width(1)" "histogram mpg, width(1)"
_u04_case U04-02 0 start "histogram mpg, start(0)" "histogram mpg, start(0)"
_u04_case U04-02 0 barwidth "bar mpg weight, barwidth(.5)" "bar mpg weight, barwidth(.5)"
// U04-03: inside ( ) and after ||, the layer's own type decides.
_u04_case U04-03 198 kernel `"(scatter mpg weight, kernel(gaussian)),"' `"(scatter mpg weight, kernel(gaussian)),"'
_u04_case U04-03 198 kernel `"lfit mpg weight || scatter mpg weight, kernel(gaussian)"' `"lfit mpg weight || scatter mpg weight, kernel(gaussian)"'
// U04-04: the type is refused before any value rule reads the value.
_u04_case U04-04 198 kernel `"scatter mpg weight, kernel(nosuch)"' `"scatter mpg weight, kernel(nosuch)"'
capture dash clear
local logfile "`c(tmpdir)'dash_ov.log"
capture log close _ovlog
capture erase "`logfile'"
log using "`logfile'", name(_ovlog) text replace
capture noisily dash lpoly mpg weight, kernel(nosuch) name(zu04k)
local _u04_rc = _rc
log close _ovlog
_ov_count "`logfile'" "option kernel() not allowed"
local _u04_n = r(n)
_ov_count "`logfile'" "kernel"
local _u04_k = r(n)
_ov_assert U04-04 `"(`_u04_rc' == 198) & (`_u04_n' == 0) & (`_u04_k' > 0)"' "lpoly kernel(nosuch) is refused by the kernel's own rule, not the type's"
// U02-07, U02-08 (WP-31 C1): barbsize(), mangle() and headlabel are
// taken as twoway takes them -- any number for the two sizes and a name
// noted at drawing (barbsize(-1), barbsize(20000), mangle(400),
// mangle(abc), barbsize(abc) rc 0, measured 13oct2026,
// test/fixtures/arrowhead_truth.json refusals), with no note at
// registration; headlabel twice refused in twoway's words, r(198).
// ----------------------------------------------------------------
sysuse auto, clear
_hz_case U02-07 "pcarrow mpg weight trunk length, barbsize(-1)"
_hz_case U02-07 "pcarrow mpg weight trunk length, barbsize(20000)"
_hz_case U02-08 "pcarrow mpg weight trunk length, mangle(45)"
_hz_case U02-08 "pcarrow mpg weight trunk length, mangle(400)"
_hz_case U02-08 "pcarrow mpg weight trunk length, mangle(abc) barbsize(abc)"
_hz_case U02-08 "pcarrow mpg weight trunk length, headlabel headlabel"

// ----------------------------------------------------------------
// WP-31 S03 (C2, B5a).  _u03_rc <cmd>: twoway's and dash's rc and first
// "not allowed" line for one command, into r(trc) r(drc) r(tline)
// r(dline), and r(named) the lines of dash's note naming `needle'.
// ----------------------------------------------------------------
capture program drop _u03_rc
program define _u03_rc, rclass
    version 16.0
    args cmd needle
    local logfile "`c(tmpdir)'dash_ov.log"
    set linesize 120
    capture log close _ovlog
    capture erase "`logfile'"
    log using "`logfile'", name(_ovlog) text replace
    capture noisily twoway `cmd' nodraw
    local trc = _rc
    log close _ovlog
    _ov_count "`logfile'" "not allowed"
    local tline `"`r(line)'"'
    capture erase "`logfile'"
    capture dash clear
    quietly graph drop _all
    log using "`logfile'", name(_ovlog) text replace
    capture noisily dash `cmd' name(u03)
    local drc = _rc
    log close _ovlog
    _ov_count "`logfile'" "not allowed"
    local dline `"`r(line)'"'
    local named 0
    if `"`needle'"' != "" {
        _ov_count "`logfile'" `"`needle'"'
        local named = r(n)
    }
    capture erase "`logfile'"
    capture dash clear
    return scalar trc = `trc'
    return scalar drc = `drc'
    return scalar named = `named'
    return local tline `"`macval(tline)'"'
    return local dline `"`macval(dline)'"'
end

// U03-06: a second mwidth on rbar, and mwidth on scatter and bar, are
// refused as twoway refuses them (rc and line); mwidth once on rbar and
// histogram is taken.
sysuse auto, clear
local bad ""
foreach c in "rbar mpg price weight, mwidth mwidth" "scatter mpg weight, mwidth" "bar mpg weight, mwidth" "rbar mpg price weight, mwidth" "histogram mpg, mwidth" {
    _u03_rc `"`c'"'
    if r(trc) != r(drc) | strtrim(`"`r(tline)'"') != strtrim(`"`r(dline)'"') {
        local bad `"`bad' [`c': twoway `r(trc)' `r(tline)', dash `r(drc)' `r(dline)']"'
    }
}
if `"`bad'"' != "" {
    display as error `"U03-06 FAIL:`bad'"'
    global ov_nfail    = ${ov_nfail} + 1
    global ov_faillist "${ov_faillist} U03-06"
}
else display as text "U03-06 PASS: mwidth twice, and on scatter and bar, refused as twoway refuses it; once on rbar and histogram taken"

// U03-05: recast() on dot: twoway takes it (rc 0) and draws the dot graph
// unchanged (rbar_dot_truth.json), so dash takes it; the spec keeps type
// dot and no recast key.  Flipped: WP-32 -- recast() was named once in
// the note, which was wrong because twoway draws the same picture and
// says nothing (noted_option_truth.json; BUGS.md "dash names options
// twoway takes and draws nothing of, where twoway is silent").
sysuse auto, clear
local bad ""
foreach c in "dot mpg weight, recast(line)" "dot mpg weight, recast(scatter)" {
    _u03_rc `"`c'"' "recast()"
    if r(trc) != 0 | r(drc) != 0 | r(named) != 0 {
        local bad `"`bad' [`c': twoway `r(trc)', dash `r(drc)', named `r(named)']"'
    }
}
capture dash clear
quietly dash dot mpg weight, recast(line) name(u03r)
_ov_has "u03r" `""type":"dot""'
if r(found) != 1 local bad `"`bad' [spec type not dot]"'
_ov_has "u03r" `""recast":"'
if r(found) != 0 local bad `"`bad' [spec carries recast]"'
capture dash clear
if `"`bad'"' != "" {
    display as error `"U03-05 FAIL:`bad'"'
    global ov_nfail    = ${ov_nfail} + 1
    global ov_faillist "${ov_faillist} U03-05"
}
else display as text "U03-05 PASS: recast() on dot taken as twoway takes it, in silence; dot drawn"

// U12-08 (WP-31 C5): gap(), area(), boundary, droplines() and baroffset()
// on a type twoway's parser does not declare them for are refused as
// twoway refuses them (rc and line; kde_hist_fn_truth.json applies), and
// taken on the types it does.
sysuse auto, clear
local bad ""
foreach c in "scatter mpg weight, gap(5)" "scatter mpg weight, area(2)" "scatter mpg weight, boundary" "line mpg weight, droplines(1)" "scatter mpg weight, baroffset(.5)" "histogram mpg, gap(20)" "kdensity mpg, area(2)" "spike mpg weight, baroffset(.5)" "scatter mpg weight, nodropbase" {
    _u03_rc `"`c'"'
    if r(trc) != r(drc) | strtrim(`"`r(tline)'"') != strtrim(`"`r(dline)'"') {
        local bad `"`bad' [`c': twoway `r(trc)' `r(tline)', dash `r(drc)' `r(dline)']"'
    }
}
if `"`bad'"' != "" {
    display as error `"U12-08 FAIL:`bad'"'
    global ov_nfail    = ${ov_nfail} + 1
    global ov_faillist "${ov_faillist} U12-08"
}
else display as text "U12-08 PASS: gap(), area(), boundary, droplines() and baroffset() refused where twoway refuses them, taken where it takes them"

// U05 (WP-31 C10a): _u05_rc <twoway command> -- twoway's rc and the
// count of `needle' in its log, then dash's rc and the count in its, and
// whether dash's log names the option in a refusal ("must be").
capture program drop _u05_rc
program define _u05_rc, rclass
    version 16.0
    args cmd needle
    local logfile "`c(tmpdir)'dash_ov.log"
    set linesize 200
    sysuse auto, clear
    capture log close _ovlog
    capture erase "`logfile'"
    log using "`logfile'", name(_ovlog) text replace
    capture noisily twoway `cmd' nodraw
    local trc = _rc
    log close _ovlog
    local tn 1
    if `"`needle'"' != "" {
        _ov_count "`logfile'" `"`needle'"'
        local tn = r(n)
    }
    capture erase "`logfile'"
    capture dash clear
    quietly graph drop _all
    sysuse auto, clear
    log using "`logfile'", name(_ovlog) text replace
    capture noisily dash `cmd' name(u05)
    local drc = _rc
    log close _ovlog
    local dn 1
    if `"`needle'"' != "" {
        _ov_count "`logfile'" `"`needle'"'
        local dn = r(n)
    }
    _ov_count "`logfile'" "must be"
    local dmust = r(n)
    // Any line of dash's but the registration's.
    _ov_count "`logfile'" "dash:"
    local dnote = r(n)
    _ov_count "`logfile'" "registered."
    local dnote = `dnote' - r(n)
    capture erase "`logfile'"
    capture dash clear
    return scalar trc = `trc'
    return scalar drc = `drc'
    return scalar tn = `tn'
    return scalar dn = `dn'
    return scalar dmust = `dmust'
    return scalar dnote = `dnote'
end

capture program drop _u05_judge
program define _u05_judge
    version 16.0
    args id bad what
    if `"`bad'"' != "" {
        display as error `"`id' FAIL:`bad'"'
        global ov_nfail    = ${ov_nfail} + 1
        global ov_faillist "${ov_faillist} `id'"
    }
    else display as text `"`id' PASS: `what'"'
end

// U05-04: level() as twoway bounds it -- on lpolyci alone.
local bad ""
foreach c in "lpolyci mpg weight, level(5)" "lpolyci mpg weight, level(9.99)" "lpolyci mpg weight, level(100)" {
    _u05_rc `"`c'"' "level() must be between 10 and 99.99 inclusive"
    if r(trc) != 198 | r(drc) != 198 | r(tn) < 1 | r(dn) < 1 {
        local bad `"`bad' [`c': twoway `r(trc)' (`r(tn)'), dash `r(drc)' (`r(dn)')]"'
    }
}
foreach c in "lpolyci mpg weight, level(10)" "lpolyci mpg weight, level(99.99)" "lfitci mpg weight, level(5)" "lfitci mpg weight, level(100)" "lfitci mpg weight, level(150)" "lfitci mpg weight, level(0)" "lfitci mpg weight, level(-1)" "qfitci mpg weight, level(5)" "qfitci mpg weight, level(100)" "fpfitci mpg weight, level(5)" "fpfitci mpg weight, level(100)" {
    _u05_rc `"`c'"' ""
    if r(trc) != 0 | r(drc) != 0 | r(dnote) != 0 {
        local bad `"`bad' [`c': twoway `r(trc)', dash `r(drc)', notes `r(dnote)']"'
    }
}
_u05_judge U05-04 `"`bad'"' "level() refused on lpolyci outside 10-99.99 in twoway's line, any number taken on lfitci, qfitci and fpfitci, as twoway"

// U05-05: range() refused with twoway's rc and line.
local bad ""
foreach c in "lfit mpg weight, range(nosuch)|range() invalid -- invalid numlist" ///
             "lfit mpg weight, range(make)|range() invalid -- invalid numlist" ///
             "lfit mpg weight, range(weight)|range() invalid -- invalid numlist" ///
             "lfit mpg weight, range(10)|range() invalid -- invalid numlist has too few elements" ///
             "lfit mpg weight, range(1 2 3)|range() invalid -- invalid numlist has too many elements" ///
             "function y=x, range(10)|option range() requires two numbers" ///
             "function y=x, range(1 2 3)|option range() requires two numbers" ///
             "function y=x, range(. 3)|option range() requires two numbers" ///
             "function y=x, range(nosuch)|variable nosuch not found" ///
             "function y=x, range(make)|no observations" ///
             "kdensity mpg, range(10)|option range() requires two numbers" ///
             "kdensity mpg, range(. 30)|option range() requires two numbers" ///
             "kdensity mpg, range(nosuch)|variable nosuch not found" {
    local at = strpos(`"`c'"', "|")
    local cmd = substr(`"`c'"', 1, `at' - 1)
    local nd = substr(`"`c'"', `at' + 1, .)
    _u05_rc `"`cmd'"' `"`nd'"'
    if r(trc) == 0 | r(trc) != r(drc) | r(tn) < 1 | r(dn) < 1 {
        local bad `"`bad' [`cmd': twoway `r(trc)' (`r(tn)'), dash `r(drc)' (`r(dn)')]"'
    }
}
foreach c in "lfit mpg weight, range(. 4000)" "qfitci mpg weight, range(1000 .)" "kdensity mpg, range(weight)" "function y=x, range(weight)" {
    _u05_rc `"`c'"' ""
    if r(trc) != 0 | r(drc) != 0 | r(dnote) != 0 {
        local bad `"`bad' [`c': twoway `r(trc)', dash `r(drc)', notes `r(dnote)']"'
    }
}
_u05_judge U05-05 `"`bad'"' "range() refused with twoway's rc and line, and its dot and variable forms taken in silence"

// U05-06: lowess bwidth() takes every value twoway takes, in silence.
local bad ""
foreach v in -1 0 1 1.5 5 {
    _u05_rc `"lowess mpg weight, bwidth(`v')"' ""
    if r(trc) != 0 | r(drc) != 0 | r(dnote) != 0 {
        local bad `"`bad' [bwidth(`v'): twoway `r(trc)', dash `r(drc)', notes `r(dnote)']"'
    }
}
_u05_judge U05-06 `"`bad'"' "lowess bwidth(-1 0 1 1.5 5) taken in silence, as twoway takes it"

// U06-04 (WP-31 C10b): yaxis()/xaxis() lists as twoway reads them, each
// against twoway in the same run.
local bad ""
foreach c in "line mpg weight, yaxis(1 1)" "line mpg weight, yaxis(2 1)" "line mpg weight, yaxis(1 2)" "line mpg weight, xaxis(1 2)" {
    _u05_rc `"`c'"' ""
    if r(trc) != 0 | r(drc) != 0 | r(dnote) != 0 {
        local bad `"`bad' [`c': twoway `r(trc)', dash `r(drc)', notes `r(dnote)']"'
    }
}
foreach c in "line mpg weight, yaxis(0)|yaxis() invalid -- invalid numlist has elements outside of allowed range" ///
             "line mpg weight, yaxis(10)|yaxis() invalid -- invalid numlist has elements outside of allowed range" ///
             "line mpg weight, yaxis(1.5)|yaxis() invalid -- invalid numlist has noninteger elements" ///
             "line mpg weight, yaxis(abc)|yaxis() invalid -- invalid numlist" ///
             "line mpg weight, xaxis(0)|xaxis() invalid -- invalid numlist has elements outside of allowed range" ///
             "scatter mpg weight, xaxis(abc)|xaxis() invalid -- invalid numlist" {
    local at = strpos(`"`c'"', "|")
    local cmd = substr(`"`c'"', 1, `at' - 1)
    local nd = substr(`"`c'"', `at' + 1, .)
    _u05_rc `"`cmd'"' `"`nd'"'
    if r(trc) == 0 | r(trc) != r(drc) | r(tn) < 1 | r(dn) < 1 {
        local bad `"`bad' [`cmd': twoway `r(trc)' (`r(tn)'), dash `r(drc)' (`r(dn)')]"'
    }
}
// Flipped (WP-31 C10c): yaxis(1 2 3) is drawn, as twoway draws it.
_u05_rc "line mpg weight, yaxis(1 2 3)" ""
if r(trc) != 0 | r(drc) != 0 {
    local bad `"`bad' [yaxis(1 2 3): twoway `r(trc)', dash `r(drc)']"'
}
_u05_judge U06-04 `"`bad'"' "yaxis()/xaxis() lists taken and refused as twoway does"

// ----------------------------------------------------------------
// WP-31 S07 (A5-A8).  _u07_rc <cmd> [needle]: twoway's and dash's rc for
// one command and the first line of each log that holds `needle', into
// r(trc) r(drc) r(tline) r(dline), and r(noted) the lines of dash's log holding "(note:".
// ----------------------------------------------------------------
capture program drop _u07_rc
program define _u07_rc, rclass
    version 16.0
    args cmd needle
    local logfile "`c(tmpdir)'dash_ov.log"
    set linesize 120
    capture log close _ovlog
    capture erase "`logfile'"
    quietly graph drop _all
    log using "`logfile'", name(_ovlog) text replace
    capture noisily twoway `macval(cmd)' nodraw
    local trc = _rc
    log close _ovlog
    _ov_count "`logfile'" `"`macval(needle)'"'
    local tline `"`r(line)'"'
    capture erase "`logfile'"
    capture dash clear
    log using "`logfile'", name(_ovlog) text replace
    capture noisily dash `macval(cmd)' name(u07)
    local drc = _rc
    log close _ovlog
    _ov_count "`logfile'" `"`macval(needle)'"'
    local dline `"`r(line)'"'
    _ov_count "`logfile'" "(note:"
    local noted = r(n)
    capture erase "`logfile'"
    capture dash clear
    return scalar trc = `trc'
    return scalar drc = `drc'
    return scalar noted = `noted'
    return local tline `"`macval(tline)'"'
    return local dline `"`macval(dline)'"'
end

// U07-7 (WP-31 A5): a weight expression is taken as twoway takes it, with
// no note; one Stata cannot evaluate is refused with twoway's rc and line
// (test/fixtures/weight_operator_truth.json weights.bad_*).
sysuse auto, clear
local bad ""
_u07_rc "lfit mpg weight [aw=price+1]," "dash:"
if r(trc) != 0 | r(drc) != 0 | r(noted) != 0 {
    local bad `"`bad' [[aw=price+1]: twoway `r(trc)', dash `r(drc)', noted `r(noted)']"'
}
foreach c in "lfit mpg weight [aw=nosuch+1],|nosuch not found" "lfit mpg weight [aw=price+],|invalid name" "kdensity mpg [aw=nosuch*2],|nosuch not found" {
    gettoken cmd nd : c, parse("|")
    local nd = substr(`"`nd'"', 2, .)
    _u07_rc `"`cmd'"' `"`nd'"'
    if r(trc) == 0 | r(trc) != r(drc) | strtrim(`"`r(tline)'"') != strtrim(`"`r(dline)'"') | `"`r(dline)'"' == "" {
        local bad `"`bad' [`cmd': twoway `r(trc)' `r(tline)', dash `r(drc)' `r(dline)']"'
    }
}
if `"`bad'"' != "" {
    display as error `"U07-7 FAIL:`bad'"'
    global ov_nfail    = ${ov_nfail} + 1
    global ov_faillist "${ov_faillist} U07-7"
}
else display as text "U07-7 PASS: [aw=price+1] taken with no note; nosuch+1, price+ and nosuch*2 refused with twoway's rc and line"

// U07-8 (WP-31 A5): a weight text holding a backtick, a dollar sign, a
// semicolon, a double quote or a tab never reaches a command line.  Typed,
// Stata's own weight syntax refuses each first, with twoway's rc
// (measured in the same run); _dash_wexp_ok refuses each by value; and a
// registry edited to hold one is refused at export, r(198), "holds a
// weight dash cannot evaluate".  Nothing is generated: no __dash variable
// is left and the data are kept.
sysuse auto, clear
local bad ""
mata: _u07_t = ("price+" + char(96) + "x'", "price+" + char(36) + "x", "price;drop _all", char(34) + "a" + char(34) + "+1", "price" + char(9) + "+price")
local logfile "`c(tmpdir)'dash_ov.log"
forvalues i = 1/5 {
    capture dash clear
    mata: st_local("_u07_c", "lfit mpg weight [aw=" + _u07_t[`i'] + "],")
    capture twoway `macval(_u07_c)' nodraw
    local trc = _rc
    capture noisily dash `macval(_u07_c)' name(u078)
    local rc = _rc
    mata: st_local("_u07_ok", strofreal(_dash_wexp_ok(_u07_t[`i'])))
    capture describe __dash*, varlist
    local left = (_rc == 0)
    capture confirm variable price
    local gone = (_rc != 0)
    if `rc' == 0 | `rc' != `trc' | `_u07_ok' | `left' | `gone' {
        local bad `"`bad' [text `i': rc `rc' (twoway `trc'), wexp_ok `_u07_ok', __dash left `left', data dropped `gone']"'
    }
    // The registry route: the stored weight replaced by the text.
    capture dash clear
    quietly dash lfit mpg weight [aw=price+1], name(u078)
    mata: st_global("dash_json_u078", subinstr(st_global("dash_json_u078"), char(34) + "wexp" + char(34) + ":" + char(34) + "price+1" + char(34), char(34) + "wexp" + char(34) + ":" + char(34) + _dash_json_escape(_u07_t[`i']) + char(34)))
    capture log close _ovlog
    capture erase "`logfile'"
    log using "`logfile'", name(_ovlog) text replace
    capture noisily _dash_serve_spec, specpath("`c(tmpdir)'u078s.json") datapath("`c(tmpdir)'u078d.json")
    local src = _rc
    log close _ovlog
    _ov_count "`logfile'" "holds a weight dash cannot evaluate"
    local said = r(n)
    capture describe __dash*, varlist
    local left = (_rc == 0)
    capture confirm variable price
    local gone = (_rc != 0)
    if `src' != 198 | `said' != 1 | `left' | `gone' {
        local bad `"`bad' [registry text `i': rc `src', said `said', __dash left `left', data dropped `gone']"'
    }
}
capture erase "`logfile'"
capture erase "`c(tmpdir)'u078s.json"
capture erase "`c(tmpdir)'u078d.json"
mata: st_local("_u07_ok", strofreal(_dash_wexp_ok("price+1")))
if `_u07_ok' != 1 local bad `"`bad' [_dash_wexp_ok(price+1) is `_u07_ok']"'
capture mata: mata drop _u07_t
capture dash clear
if `"`bad'"' != "" {
    display as error `"U07-8 FAIL:`bad'"'
    global ov_nfail    = ${ov_nfail} + 1
    global ov_faillist "${ov_faillist} U07-8"
}
else display as text "U07-8 PASS: weight texts with a backtick, a dollar sign, a semicolon, a quote or a tab refused typed (twoway's rc) and in the registry (r(198)); nothing generated"

// Q4103-4..9 (WP-41 section 41-03, sil:SD-7): a weighted marker layer
// under by() with a panel whose weights are all zero (or missing) stops,
// r(198), with no message, as twoway's _draw_weighted_points stops for
// that panel; msymbol(none) draws (by_scale_range_truth.json W01-W06,
// measured drawn; twoway is run here too, drawn, under the same data).
python:
import json
from sfi import Macro
_q41w = json.load(open("fixtures/by_scale_range_truth.json", encoding="utf-8"))["probes"]
Macro.setGlobal("q4103_wrc", " ".join(str(_q41w["W0%d" % k]["rc"]) for k in range(1, 7)))
end
local q41_cmds `""scatter mpg weight [aw=w], by(foreign)" "scatter mpg weight [aw=w], by(foreign, total)" "scatter mpg weight [aw=w3], by(rep78)" "scatter mpg weight [aw=w3], by(rep78, missing)" "(scatter mpg weight [aw=w]) (scatter mpg weight), by(foreign)" "scatter mpg weight [aw=w], by(foreign) msymbol(none)""'
local q41_k 0
foreach q41_c of local q41_cmds {
    local ++q41_k
    local q41_id = `q41_k' + 3
    local q41_want : word `q41_k' of ${q4103_wrc}
    sysuse auto, clear
    quietly generate double w = cond(foreign, 0, 1 + mod(_n, 3))
    quietly generate double w3 = cond(rep78 == 3, 0, 1 + mod(_n, 3))
    capture twoway `q41_c' name(q4103tw, replace)
    local q41_trc = _rc
    capture graph drop q4103tw
    capture dash clear
    capture log close _ovlog
    capture erase "`c(tmpdir)'q4103.log"
    quietly log using "`c(tmpdir)'q4103.log", name(_ovlog) text replace
    capture noisily dash `q41_c' name(q4103)
    local q41_drc = _rc
    quietly log close _ovlog
    _ov_count "`c(tmpdir)'q4103.log" "dash:"
    local q41_said = r(n)
    // Refused: no dash line at all; drawn: only its "registered" line.
    _ov_assert Q4103-`q41_id' "(`q41_drc' == `q41_want' & `q41_trc' == `q41_want' & `q41_said' == (`q41_want' == 0))" "`q41_c': dash rc `q41_drc', twoway rc `q41_trc' (fixture `q41_want'), dash lines `q41_said'"
}
capture erase "`c(tmpdir)'q4103.log"
capture dash clear
macro drop q4103_wrc

// U07-9 (WP-31 A6): mlabel(L.make) on the types that never read mlabel()
// (histogram: dropped, rc 0) or refuse it (mspline: r(111)) keeps
// twoway's code, measured in the same run (guard).
sysuse auto, clear
quietly generate t = _n
quietly tsset t
local bad ""
foreach c in "histogram mpg, mlabel(L.make)" "function y = x, mlabel(L.make)" "mspline mpg weight, mlabel(L.make)" "mband mpg weight, mlabel(L.make)" {
    _u07_rc `"`c'"' "not found"
    if r(trc) != r(drc) {
        local bad `"`bad' [`c': twoway `r(trc)', dash `r(drc)']"'
    }
}
tsset, clear
if `"`bad'"' != "" {
    display as error `"U07-9 FAIL:`bad'"'
    global ov_nfail    = ${ov_nfail} + 1
    global ov_faillist "${ov_faillist} U07-9"
}
else display as text "U07-9 PASS: mlabel(L.make) on histogram, function, mspline and mband answers with twoway's code"

// ----------------------------------------------------------------
// WP-31 S09 (C10c): axes three to nine.  Lines are the fixture's
// (test/fixtures/axes_n_truth.json bounds.*, refusals.axis3_unused), and
// twoway is asked again in the same run.
// ----------------------------------------------------------------
// U09-4: the bounds, in twoway's rc and words; no sentence of dash's.
local bad ""
foreach c in "scatter mpg weight, yaxis(0)|125|yaxis() invalid -- invalid numlist has elements outside of allowed range" ///
             "scatter mpg weight, yaxis(10)|125|yaxis() invalid -- invalid numlist has elements outside of allowed range" ///
             "scatter mpg weight, yaxis(2.5)|126|yaxis() invalid -- invalid numlist has noninteger elements" ///
             "scatter mpg weight, xaxis(10)|125|xaxis() invalid -- invalid numlist has elements outside of allowed range" {
    local at = strpos(`"`c'"', "|")
    local cmd = substr(`"`c'"', 1, `at' - 1)
    local rest = substr(`"`c'"', `at' + 1, .)
    local at = strpos(`"`rest'"', "|")
    local want = substr(`"`rest'"', 1, `at' - 1)
    local nd = substr(`"`rest'"', `at' + 1, .)
    _u05_rc `"`cmd'"' `"`nd'"'
    if r(trc) != `want' | r(drc) != `want' | r(tn) < 1 | r(dn) < 1 {
        local bad `"`bad' [`cmd': twoway `r(trc)' (`r(tn)'), dash `r(drc)' (`r(dn)')]"'
    }
    _u05_rc `"`cmd'"' "two axes"
    if r(dn) != 0 {
        local bad `"`bad' [`cmd': dash says two axes]"'
    }
}
_u05_rc "scatter mpg weight, yaxis(9)" ""
if r(trc) != 0 | r(drc) != 0 {
    local bad `"`bad' [yaxis(9): twoway `r(trc)', dash `r(drc)']"'
}
_u05_judge U09-4 `"`bad'"' "yaxis()/xaxis() bounds refused with twoway's rc and line, no dash sentence; yaxis(9) drawn"

// U09-5: an axis(3) option needs a layer on axis 3, as twoway says.
local bad ""
_u05_rc "scatter mpg weight, ylabel(1 2, axis(3))" "ylabels(1 2, axis(3)) not allowed, yaxis3 does not exist"
if r(trc) != 198 | r(drc) != 198 | r(tn) < 1 | r(dn) < 1 {
    local bad `"`bad' [unused: twoway `r(trc)' (`r(tn)'), dash `r(drc)' (`r(dn)')]"'
}
_u05_rc "(scatter mpg weight) (scatter length weight, yaxis(3)), ylabel(150(20)230, axis(3))" ""
if r(trc) != 0 | r(drc) != 0 {
    local bad `"`bad' [used: twoway `r(trc)', dash `r(drc)']"'
}
_u05_judge U09-5 `"`bad'"' "axis(3) options refused without a layer on axis 3 and taken with one, as twoway does"

// U09-7: yaxis(3) on every kind of layer, rc 0 as twoway.
local bad ""
