_u46_rc OV-144 0 `"dash scatter mpg weight, scheme(nosuchthing) name(ov144)"'
_ov_said OV-144 "(note: scheme nosuchthing not found, using s2color)"
_u46_rc OV-145 0 `"dash scatter mpg weight, scheme(../x) name(ov145)"'
_ov_said OV-145 "(note: scheme ../x not found, using s2color)"

// ----------------------------------------------------------------
// OV-146 .. OV-148: a shipped name written WITH the extension
// (scheme(s2color.scheme), in any case) is the shipped scheme -- the
// renderer's SchemeParser._resolve_path reads that spelling from the
// package's dash-<name>.scheme too -- so the gate accepts it with no file in the
// working directory (test/ holds no .scheme file).  A name that is not
// shipped still needs the file.  Measured before the fix: OV-146 and
// OV-147 were refused, rc 198 -- the extension form was looked for as a
// working-directory file only, although the renderer would have drawn it.
// ----------------------------------------------------------------
_ov_case OV-146 `"dash scatter mpg weight, scheme(s2color.scheme) name(ov146)"' 0 "" `""scheme":"s2color.scheme""'
_ov_case OV-147 `"dash scatter mpg weight, scheme(S2COLOR.SCHEME) name(ov147)"' 0 ""
// Flipped (WP-45 ST-16): twoway draws s2color with a note for a scheme it cannot find (ST-16).
_u46_rc OV-148 0 `"dash scatter mpg weight, scheme(nosuch.scheme) name(ov148)"'
_ov_said OV-148 "(note: scheme nosuch.scheme not found, using s2color)"

