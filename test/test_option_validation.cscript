_u41_pair "`_u41l'" `"scatter mpg weight turn, mcolor("(red)")"' 198 "option(s) ( red ) not allowed" "option(s) ( red ) not allowed"
_u41_pair "`_u41l'" "line mpg turn weight, sort lwidth((thick))" 198 "option(s) ( thick ) not allowed" "option(s) ( thick ) not allowed"
_u41_pair "`_u41l'" "scatter mpg weight turn, mcolor(red (blue))" 198 "option(s) ( blue ) not allowed" "option(s) ( blue ) not allowed"
_u05_judge U41-11 `"${u41_bad}"' "a parenthesised stylelist element is refused in twoway's words, r(198)"

