// Q4701-4 (WP-47 MS-7): mlabel() on scatteri, pci and pcarrowi is not
// looked up in the data, as twoway does not look it up (rc 0; measured
// 10nov2026, test/fixtures/immediate_label_truth.json M01-M04, M07);
// .. and = are refused as twoway refuses them there, r(198) ".. not
// allowed in option mlabel()" and "invalid syntax" (M05, M06).  Each line
// is checked against twoway, run live beside it.
capture program drop _q4701_imm
program define _q4701_imm
    version 19
    args want msg cmd
    capture noisily twoway `macval(cmd)' nodraw
    local trc = _rc
    capture graph drop _all
    capture log close _ovlog
    quietly log using "`c(tmpdir)'dash_q4701.log", name(_ovlog) text replace
    capture noisily dash `macval(cmd)' name(q4701)
    local drc = _rc
    quietly log close _ovlog
    capture dash clear
    _ov_assert Q4701-4 "(`trc' == `want' & `drc' == `want')" `"`macval(cmd)': twoway rc `trc', dash rc `drc' (expected `want')"'
    if `"`msg'"' != "" {
        _ov_count "`c(tmpdir)'dash_q4701.log" `"`msg'"'
        _ov_assert Q4701-4 "(r(n) >= 1)" `"`macval(cmd)': dash's first line is twoway's `msg'"'
    }
    capture erase "`c(tmpdir)'dash_q4701.log"
end
_q4701_imm 0 "" "scatteri 20 3000, mlabel(nosuch)"
_q4701_imm 0 "" `"scatteri 20 3000 "A" 25 4000 "B", mlabel(nosuch)"'
_q4701_imm 0 "" "pci 20 2000 30 4000, mlabel(nosuch)"
_q4701_imm 0 "" "pcarrowi 20 2000 30 4000, mlabel(nosuch)"
_q4701_imm 198 ".. not allowed in option mlabel()" "scatteri 20 3000, mlabel(..)"
_q4701_imm 198 "invalid syntax" "scatteri 20 3000, mlabel(=)"
_q4701_imm 0 "" "scatteri 20 3000, mlabel(make)"

