             "line mpg weight, yaxis(10)|yaxis() invalid -- invalid numlist has elements outside of allowed range" ///
             "line mpg weight, yaxis(1.5)|yaxis() invalid -- invalid numlist has noninteger elements" ///
             "line mpg weight, yaxis(abc)|yaxis() invalid -- invalid numlist" ///
             "line mpg weight, xaxis(0)|xaxis() invalid -- invalid numlist has elements outside of allowed range" ///
             "scatter mpg weight, xaxis(abc)|xaxis() invalid -- invalid numlist" {
    local at = strpos(`"`c'"', "|")
