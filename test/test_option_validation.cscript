local bad ""
foreach c in "scatter mpg weight, yaxis(0)|125|yaxis() invalid -- invalid numlist has elements outside of allowed range" ///
             "scatter mpg weight, yaxis(10)|125|yaxis() invalid -- invalid numlist has elements outside of allowed range" ///
             "scatter mpg weight, yaxis(2.5)|126|yaxis() invalid -- invalid numlist has noninteger elements" ///
             "scatter mpg weight, xaxis(10)|125|xaxis() invalid -- invalid numlist has elements outside of allowed range" {
    local at = strpos(`"`c'"', "|")
    local cmd = substr(`"`c'"', 1, `at' - 1)
    local rest = substr(`"`c'"', `at' + 1, .)
    local at = strpos(`"`rest'"', "|")
    local want = substr(`"`rest'"', 1, `at' - 1)
    local nd = substr(`"`rest'"', `at' + 1, .)
    _u05_rc `"`cmd'"' `"`nd'"'
    if r(trc) != `want' | r(drc) != `want' | r(tn) < 1 | r(dn) < 1 {
        local bad `"`bad' [`cmd': twoway `r(trc)' (`r(tn)'), dash `r(drc)' (`r(dn)')]"'
    }
    _u05_rc `"`cmd'"' "two axes"
    if r(dn) != 0 {
        local bad `"`bad' [`cmd': dash says two axes]"'
    }
}
_u05_rc "scatter mpg weight, yaxis(9)" ""
if r(trc) != 0 | r(drc) != 0 {
    local bad `"`bad' [yaxis(9): twoway `r(trc)', dash `r(drc)']"'
}
_u05_judge U09-4 `"`bad'"' "yaxis()/xaxis() bounds refused with twoway's rc and line, no dash sentence; yaxis(9) drawn"

