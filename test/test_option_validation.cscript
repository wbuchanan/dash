python:
def _q4402_rows():
    import json, os
    from sfi import Macro
    with open(os.path.join("fixtures", "tick_style_truth.json"),
              encoding="utf-8") as fh:
        t = json.load(fh)
    rows = []
    for k in sorted(t):
        if not k.startswith("ax5_"):
            continue
        r = t[k]
        cmd = r["command"]
        if cmd.endswith(" name(u442k, replace)"):
            cmd = cmd[:-len(" name(u442k, replace)")]
        if cmd.startswith("twoway "):
            cmd = cmd[len("twoway "):]
        rows.append((k, cmd, str(r["rc"]),
                     r["log"][0] if r["rc"] and r["log"] else ""))
    Macro.setGlobal("q4402_n", str(len(rows)))
    for i, (k, c, rc, m) in enumerate(rows, 1):
        for name, v in (("k", k), ("c", c), ("r", rc), ("m", m)):
            Macro.setGlobal("q4402_%s%d" % (name, i), v)
end
