// OV-22 .. OV-45: numeric kinds
// ----------------------------------------------------------------
_ov_case OV-22 `"dash scatter mpg weight, jitter(5) name(ov22)"' 0 ""
_ov_case OV-23 `"dash scatter mpg weight, jitter(abc) name(ov23)"' 198 jitter
_ov_case OV-24 `"dash scatter mpg weight, jitter(-3) name(ov24)"' 198 jitter
_ov_case OV-25 `"dash scatter mpg weight, jitter(101) name(ov25)"' 198 jitter
_ov_case OV-26 `"dash scatter mpg weight, jitter(5) jitterseed(20260920) name(ov26)"' 0 ""
