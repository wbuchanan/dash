// ----------------------------------------------------------------
// WP-31 S07 (A5-A8).  _u07_rc <cmd> [needle]: twoway's and dash's rc for
// one command and the first line of each log that holds `needle', into
// r(trc) r(drc) r(tline) r(dline), and r(noted) the lines of dash's log holding "(note:".
// ----------------------------------------------------------------
capture program drop _u07_rc
program define _u07_rc, rclass
    version 16.0
    args cmd needle
    local logfile "`c(tmpdir)'dash_ov.log"
    set linesize 120
    capture log close _ovlog
    capture erase "`logfile'"
    quietly graph drop _all
    log using "`logfile'", name(_ovlog) text replace
    capture noisily twoway `macval(cmd)' nodraw
    local trc = _rc
    log close _ovlog
    _ov_count "`logfile'" `"`macval(needle)'"'
    local tline `"`r(line)'"'
    capture erase "`logfile'"
    capture dash clear
    log using "`logfile'", name(_ovlog) text replace
    capture noisily dash `macval(cmd)' name(u07)
    local drc = _rc
    log close _ovlog
    _ov_count "`logfile'" `"`macval(needle)'"'
    local dline `"`r(line)'"'
    _ov_count "`logfile'" "(note:"
    local noted = r(n)
    capture erase "`logfile'"
    capture dash clear
    return scalar trc = `trc'
    return scalar drc = `drc'
    return scalar noted = `noted'
    return local tline `"`macval(tline)'"'
    return local dline `"`macval(dline)'"'
end

// U07-7 (WP-31 A5): a weight expression is taken as twoway takes it, with
// no note; one Stata cannot evaluate is refused with twoway's rc and line
// (test/fixtures/weight_operator_truth.json weights.bad_*).
sysuse auto, clear
local bad ""
_u07_rc "lfit mpg weight [aw=price+1]," "dash:"
if r(trc) != 0 | r(drc) != 0 | r(noted) != 0 {
    local bad `"`bad' [[aw=price+1]: twoway `r(trc)', dash `r(drc)', noted `r(noted)']"'
}
foreach c in "lfit mpg weight [aw=nosuch+1],|nosuch not found" "lfit mpg weight [aw=price+],|invalid name" "kdensity mpg [aw=nosuch*2],|nosuch not found" {
    gettoken cmd nd : c, parse("|")
    local nd = substr(`"`nd'"', 2, .)
    _u07_rc `"`cmd'"' `"`nd'"'
    if r(trc) == 0 | r(trc) != r(drc) | strtrim(`"`r(tline)'"') != strtrim(`"`r(dline)'"') | `"`r(dline)'"' == "" {
        local bad `"`bad' [`cmd': twoway `r(trc)' `r(tline)', dash `r(drc)' `r(dline)']"'
    }
}
if `"`bad'"' != "" {
    display as error `"U07-7 FAIL:`bad'"'
    global ov_nfail    = ${ov_nfail} + 1
    global ov_faillist "${ov_faillist} U07-7"
}
else display as text "U07-7 PASS: [aw=price+1] taken with no note; nosuch+1, price+ and nosuch*2 refused with twoway's rc and line"

// U07-8 (WP-31 A5): a weight text holding a backtick, a dollar sign, a
// semicolon, a double quote or a tab never reaches a command line.  Typed,
// Stata's own weight syntax refuses each first, with twoway's rc
// (measured in the same run); _dash_wexp_ok refuses each by value; and a
// registry edited to hold one is refused at export, r(198), "holds a
// weight dash cannot evaluate".  Nothing is generated: no __dash variable
// is left and the data are kept.
sysuse auto, clear
local bad ""
mata: _u07_t = ("price+" + char(96) + "x'", "price+" + char(36) + "x", "price;drop _all", char(34) + "a" + char(34) + "+1", "price" + char(9) + "+price")
local logfile "`c(tmpdir)'dash_ov.log"
forvalues i = 1/5 {
    capture dash clear
    mata: st_local("_u07_c", "lfit mpg weight [aw=" + _u07_t[`i'] + "],")
    capture twoway `macval(_u07_c)' nodraw
    local trc = _rc
    capture noisily dash `macval(_u07_c)' name(u078)
    local rc = _rc
    mata: st_local("_u07_ok", strofreal(_dash_wexp_ok(_u07_t[`i'])))
    capture describe __dash*, varlist
    local left = (_rc == 0)
    capture confirm variable price
    local gone = (_rc != 0)
    if `rc' == 0 | `rc' != `trc' | `_u07_ok' | `left' | `gone' {
        local bad `"`bad' [text `i': rc `rc' (twoway `trc'), wexp_ok `_u07_ok', __dash left `left', data dropped `gone']"'
    }
    // The registry route: the stored weight replaced by the text.
    capture dash clear
    quietly dash lfit mpg weight [aw=price+1], name(u078)
    mata: st_global("dash_json_u078", subinstr(st_global("dash_json_u078"), char(34) + "wexp" + char(34) + ":" + char(34) + "price+1" + char(34), char(34) + "wexp" + char(34) + ":" + char(34) + _json_escape(_u07_t[`i']) + char(34)))
    capture log close _ovlog
    capture erase "`logfile'"
    log using "`logfile'", name(_ovlog) text replace
    capture noisily _dash_serve_spec, specpath("`c(tmpdir)'u078s.json") datapath("`c(tmpdir)'u078d.json")
    local src = _rc
    log close _ovlog
    _ov_count "`logfile'" "holds a weight dash cannot evaluate"
    local said = r(n)
    capture describe __dash*, varlist
    local left = (_rc == 0)
    capture confirm variable price
    local gone = (_rc != 0)
    if `src' != 198 | `said' != 1 | `left' | `gone' {
        local bad `"`bad' [registry text `i': rc `src', said `said', __dash left `left', data dropped `gone']"'
    }
}
capture erase "`logfile'"
capture erase "`c(tmpdir)'u078s.json"
capture erase "`c(tmpdir)'u078d.json"
mata: st_local("_u07_ok", strofreal(_dash_wexp_ok("price+1")))
if `_u07_ok' != 1 local bad `"`bad' [_dash_wexp_ok(price+1) is `_u07_ok']"'
capture mata: mata drop _u07_t
capture dash clear
if `"`bad'"' != "" {
    display as error `"U07-8 FAIL:`bad'"'
    global ov_nfail    = ${ov_nfail} + 1
    global ov_faillist "${ov_faillist} U07-8"
}
else display as text "U07-8 PASS: weight texts with a backtick, a dollar sign, a semicolon, a quote or a tab refused typed (twoway's rc) and in the registry (r(198)); nothing generated"

// U07-9 (WP-31 A6): mlabel(L.make) on the types that never read mlabel()
// (histogram: dropped, rc 0) or refuse it (mspline: r(111)) keeps
// twoway's code, measured in the same run (guard).
sysuse auto, clear
quietly generate t = _n
quietly tsset t
local bad ""
foreach c in "histogram mpg, mlabel(L.make)" "function y = x, mlabel(L.make)" "mspline mpg weight, mlabel(L.make)" "mband mpg weight, mlabel(L.make)" {
    _u07_rc `"`c'"' "not found"
    if r(trc) != r(drc) {
        local bad `"`bad' [`c': twoway `r(trc)', dash `r(drc)']"'
    }
}
tsset, clear
if `"`bad'"' != "" {
    display as error `"U07-9 FAIL:`bad'"'
    global ov_nfail    = ${ov_nfail} + 1
    global ov_faillist "${ov_faillist} U07-9"
}
else display as text "U07-9 PASS: mlabel(L.make) on histogram, function, mspline and mband answers with twoway's code"

// ----------------------------------------------------------------
// WP-31 S09 (C10c): axes three to nine.  Lines are the fixture's
