// nosuchscheme not found, using s2color)", and for a path-like name the
// same note alone, no file read (test/fixtures/style_leaf_truth.json
// U_unknown, U_path) -- the registered spec carrying s2color; dash
// build's scheme() keeps its refusal, r(198).
// ----------------------------------------------------------------
foreach q45s in nosuchscheme ../nosuch {
    _u46_rc Q4503-5 0 `"dash scatter mpg weight, scheme(`q45s') name(q45035)"'
    _ov_said Q4503-5 "(note: scheme `q45s' not found, using s2color)"
    _ov_count "`c(tmpdir)'dash_ov.log" "never given as a path"
