// ----------------------------------------------------------------
// Q3507-1 (WP-35 section 35-07, DT-15; DECISIONS.md P4-7, P4-9, D53):
// every spelling twoway refuses that dash took -- ytitle2() .. ttitle2(),
// marker(), malpha(), lalpha(), falpha(), jseed(), mlg(), cv(), colv(),
// colornlevels(), colormissing(), plotbgcolor(), pbgc(), colpalette() --
// and kernel(GAUSSIAN), xsize(()) and a string colorvar(), through dash
// as test/fixtures/dash_only_words_truth.json ran them in twoway, on the
// one-line route and with name(): the rc and first line are twoway's, the
// second line names twoway's spelling (none for xsize(()) and a string
// colorvar()), and no line follows.  Each word inside p1() (p.<word>):
// twoway's p# line and the hint, or rc 0 where twoway takes it
// (p.marker).  The order probes (order.*): dash names what twoway names
// first.
// ----------------------------------------------------------------
python:
import json as _q3507_json
import re as _q3507_re
from sfi import Macro as _q3507_M
with open("fixtures/dash_only_words_truth.json", encoding="utf-8") as _q3507_fh:
    _q3507_fx = _q3507_json.load(_q3507_fh)
with open("../dash_parse.mata", encoding="utf-8") as _q3507_fh:
    _q3507_src = _q3507_fh.read()
_q3507_i = _q3507_src.index("string matrix _dash_dashonly_list()")
_q3507_hint = {}
for _q3507_r in _q3507_re.findall(r'"([^"]*)", "([^"]*)", "([^"]*)", "([^"]*)", "([^"]*)"', _q3507_src[_q3507_i:_q3507_src.index("\n}\n", _q3507_i)]):
    _q3507_hint[_q3507_r[0]] = _q3507_r[3]
_q3507_pkeys = ["p." + w for w in _q3507_hint]
_q3507_hint["V1"] = "use kernel(gaussian)"
_q3507_M.setLocal("q_words", " ".join(list(_q3507_hint) + ["V2", "V3"]))
_q3507_M.setLocal("q_pkeys", " ".join(_q3507_pkeys))
_q3507_M.setLocal("q_okeys", " ".join(sorted(k for k in _q3507_fx if k.startswith("order.")) + ["space.run"]))


def _q3507_take(key, named):
    c = _q3507_fx[key]["cmd"][len("twoway "):]
    if named == "1":
        c = c + " name(q3507n)"
    _q3507_M.setLocal("q_cmd", c)
    _q3507_M.setLocal("q_rc", str(_q3507_fx[key]["rc"]))


def _q3507_judge(key, path, rc, mode):
    r = _q3507_fx[key]
    lines = []
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for ln in fh:
                if ln.strip() and not ln.startswith((". ", "> ")):
                    lines.append(ln.rstrip())
    except OSError:
        pass
    got = lines[0].strip() if lines else ""
    nxt = lines[1].strip() if len(lines) > 1 else ""
    ok = int(rc) == r["rc"]
    want2 = ""
    if r["rc"]:
        ok = ok and got == r["message"]
        if mode != "order":
            w = key[2:] if key.startswith("p.") else key
            want2 = _q3507_hint.get(w, "")
            ok = ok and nxt == want2 and len(lines) == (2 if want2 else 1)
    _q3507_M.setLocal("q_ok", "1" if ok else "0")
    for name, text in (("q_got", got + " / " + nxt + " / " + str(len(lines))),
                       ("q_want", r["message"] + " / " + want2)):
        for ch, to in (('"', "'"), ("\x60", "'"), ("$", "S")):
            text = text.replace(ch, to)
        _q3507_M.setLocal(name, text[:200])
end
