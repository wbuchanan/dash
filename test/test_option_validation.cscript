// ----------------------------------------------------------------
// Q4403-2 / Q4403-6 / Q4403-12 (WP-44 section 44-03): the scale words
// and spans twoway's graph refuses.  Every probe of
// test/fixtures/axis_scale_truth.json (scripts/
// extract_axis_scale_truth.do) whose key starts with a prefix below is
// run through dash with twoway's rc, and a refused one with twoway's
// line: Q4403-2 (AX-9, ruling D75) atanh, logit and log1m on any scale
// option, refused r(199) "unrecognized command" as twoway's graph fails
// on them, and the forms twoway draws (a later copy's transform word or
// no form clears them); Q4403-6 (AX-10) two transform words in one copy
// refused r(198) in twoway's opts_exclusive line; Q4403-12 (DG-13) a
// span past c(maxdouble) refused r(199).  The style() and drawn keys
// are pinned elsewhere (test_axis_scales_p9.py, test_wp44_truth.cscript).
// ----------------------------------------------------------------
python:
def _q4403_rows(groups):
    import json, os
    from sfi import Macro
    with open(os.path.join("fixtures", "axis_scale_truth.json"),
              encoding="utf-8") as fh:
        t = json.load(fh)["graphs"]
    rows = []
    for case, pre in groups:
        for k in sorted(t):
            if not k.startswith(pre) or "_style_" in k:
                continue
            r = t[k]
            cmd = r["command"].rstrip()
            if cmd.endswith(","):
                cmd = cmd[:-1].rstrip()
            if cmd.startswith("twoway "):
                cmd = cmd[len("twoway "):]
            if "," not in cmd:
                cmd += ","
            # A copy with two transform words is AX-10's whichever probe
            # set records it.
            ex = (r.get("error") or "").startswith("only one of options")
            rows.append(("Q4403-6" if ex else case, k, r["data"], r["prep"],
                         cmd, str(r["rc"]),
                         r.get("error") or ""))
    Macro.setGlobal("q4403_n", str(len(rows)))
    for i, (case, k, d, p, c, rc, m) in enumerate(rows, 1):
        for name, v in (("i", case), ("k", k), ("d", d), ("p", p),
                        ("c", c), ("r", rc), ("m", m)):
            Macro.setGlobal("q4403_%s%d" % (name, i), v)


def _q4403_said(path, want):
    from sfi import Macro
    with open(path, encoding="utf-8", errors="replace") as fh:
        lines = [ln.strip() for ln in fh]
    Macro.setLocal("q4403_has", "1" if want in lines else "0")
end
