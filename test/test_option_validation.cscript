// ----------------------------------------------------------------
// Q4505-2 (WP-45 section 45-05, ST-22): a used blank style-list element
// is refused with twoway's line, then dash's hint.  Every B_ row of
// test/fixtures/colour_edges_truth.json (scripts/
// extract_colour_edges_truth.do) that twoway refuses and dash's table
// (_dash_stylelist_blank_words) words is run through dash; its rc and
// first line are the fixture's, never typed here, and twoway's line comes
// before dash's "dash: " line.  test_colour_font_edges.py::
// TestBlankElements::test_the_table_is_twoways holds the table to every
// row.
// ----------------------------------------------------------------
python:
def _q4505_rows():
    import json, os
    from sfi import Macro
    with open(os.path.join("fixtures", "colour_edges_truth.json"),
              encoding="utf-8") as fh:
        t = json.load(fh)["rows"]
    rows = [(k, t[k]) for k in sorted(t)
            if k.startswith("B_") and t[k]["rc"]]
    Macro.setGlobal("q4505_n", str(len(rows)))
    for i, (k, r) in enumerate(rows, 1):
        cmd = r["value"]
        if cmd.startswith("twoway "):
            cmd = cmd[len("twoway "):]
        for name, v in (("k", k), ("c", cmd), ("r", str(r["rc"])),
                        ("m", r["first_line"])):
            Macro.setGlobal("q4505_%s%d" % (name, i), v)


def _q4505_said(path, want):
    from sfi import Macro
    with open(path, encoding="utf-8", errors="replace") as fh:
        lines = [ln.strip() for ln in fh]
    ok = want in lines
    if ok:
        # dash's hint, when one is printed, follows twoway's line (a value
        # list such as barwidth() is refused by its own reader first, in
        # twoway's line alone).
        hint = [j for j, ln in enumerate(lines) if ln.startswith("dash: ")]
        ok = not hint or lines.index(want) < hint[0]
    Macro.setLocal("q4505_has", "1" if ok else "0")
end
python: import __main__ as _q4505m; _q4505m._q4505_rows()
local q4505_ls = c(linesize)
