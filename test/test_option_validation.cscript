// U24-5 (WP-31 D1): ##N on a major option.  twoway takes it, rc 0, and
// notes "##5 ignored, only allowed for minor ticks"; dash takes it and
// prints the same note when it draws the graph (the immediate route), and
// writes the option to the spec as typed.
local bad ""
local u24msg "##5 ignored, only allowed for minor ticks"
_u05_rc "scatter mpg weight, xlabel(##5)" `"`u24msg'"'
if r(trc) != 0 | r(drc) != 0 | r(tn) < 1 {
    local bad `"`bad' [registration: twoway `r(trc)' (`r(tn)'), dash `r(drc)']"'
}
local u24log "`c(tmpdir)'dash_ov.log"
local u24html "`c(tmpdir)'dash_u24_5.html"
capture erase "`u24html'"
capture log close _ovlog
capture erase "`u24log'"
sysuse auto, clear
log using "`u24log'", name(_ovlog) text replace
capture noisily dash scatter mpg weight, xlabel(##5) saving("`u24html'", replace)
local u24rc = _rc
log close _ovlog
_ov_count "`u24log'" `"`u24msg'"'
if `u24rc' != 0 | r(n) < 1 {
    local bad `"`bad' [drawn: dash rc `u24rc', note lines `r(n)']"'
}
capture erase "`u24log'"
capture erase "`u24html'"
capture dash clear
_u05_judge U24-5 `"`bad'"' "xlabel(##5) taken as twoway takes it, rc 0, with twoway's note when drawn"

// U27-6 .. U27-8 (WP-31 D2): title2() and subtitle2(), which twoway has
// not, refused with twoway's rc and line wherever they are written.
foreach u in 6 7 8 {
    local bad ""
    if `u' == 6 local cases `"`"scatter mpg weight, title2("x")"' `"scatter mpg weight, title2"'"'
    if `u' == 7 local cases `"`"scatter mpg weight, subtitle2("x")"'"'
    if `u' == 8 local cases `"`"(scatter mpg weight, title2(x)),"' `"scatter mpg weight || scatter price weight, title2("x")"'"'
    foreach cmd of local cases {
        _u07_rc `"`macval(cmd)'"' "not allowed"
        if r(trc) != 198 | r(drc) != 198 | strtrim(`"`r(tline)'"') != strtrim(`"`r(dline)'"') | `"`r(dline)'"' == "" | r(noted) != 0 {
            local bad `"`bad' [`cmd': twoway `r(trc)' `r(tline)', dash `r(drc)' `r(dline)', notes `r(noted)']"'
        }
    }
    if `"`bad'"' != "" {
        display as error `"U27-`u' FAIL:`bad'"'
        global ov_nfail    = ${ov_nfail} + 1
        global ov_faillist "${ov_faillist} U27-`u'"
    }
    else if `u' == 6 display as text "U27-6 PASS: title2() and a bare title2 refused with twoway's rc and line"
    else if `u' == 7 display as text "U27-7 PASS: subtitle2() refused with twoway's rc and line"
    else display as text "U27-8 PASS: title2() in a plot's parentheses and after a segment's comma refused with twoway's rc and line"
}

// U27-9 (WP-31 D2): title("A") title("B") is no title2(): rc 0 in both,
// and dash keeps the last copy, as twoway draws it.
local bad ""
_u07_rc `"scatter mpg weight, title("A") title("B")"' "not allowed"
if r(trc) != 0 | r(drc) != 0 {
    local bad `"`bad' [twoway `r(trc)', dash `r(drc)']"'
}
capture dash clear
capture noisily dash scatter mpg weight, title(A) title(B) name(u279)
local u279rc = _rc
mata: st_local("u279b", strofreal(strpos(st_global("dash_json_u279"), char(34) + "title" + char(34) + ":" + char(34) + "B" + char(34)) > 0))
if `u279rc' != 0 | `u279b' != 1 {
    local bad `"`bad' [title(A) title(B): rc `u279rc', title B `u279b']"'
}
capture dash clear
if `"`bad'"' != "" {
    display as error `"U27-9 FAIL:`bad'"'
    global ov_nfail    = ${ov_nfail} + 1
    global ov_faillist "${ov_faillist} U27-9"
}
else display as text "U27-9 PASS: title(A) title(B) taken, the last copy kept"

// U30-7 .. U30-8 (WP-31 D3): twoway takes span at position(0) and an
// unknown tstyle(), rc 0, and notes each; dash takes both and prints
// twoway's words when it draws the graph.
foreach u in 7 8 {
    local bad ""
    if `u' == 7 {
        local cmd `"scatter mpg weight, title("T", position(0) span)"'
        local u30msg "option span ignored for position(0)"
    }
    else {
        local cmd `"scatter mpg weight, note("N", tstyle(nosuch))"'
        local u30msg "named style nosuch not found in class textboxstyle, default attributes used"
    }
    _u05_rc `"`macval(cmd)'"' `"`u30msg'"'
    if r(trc) != 0 | r(drc) != 0 | r(tn) < 1 {
        local bad `"`bad' [registration: twoway `r(trc)' (`r(tn)'), dash `r(drc)']"'
    }
    local u30log "`c(tmpdir)'dash_ov.log"
    local u30html "`c(tmpdir)'dash_u30_`u'.html"
    capture erase "`u30html'"
    capture log close _ovlog
    capture erase "`u30log'"
    sysuse auto, clear
    log using "`u30log'", name(_ovlog) text replace
    capture noisily dash `cmd' saving("`u30html'", replace)
    local u30rc = _rc
    log close _ovlog
    _ov_count "`u30log'" `"`u30msg'"'
    if `u30rc' != 0 | r(n) != 1 {
        local bad `"`bad' [drawn: dash rc `u30rc', note lines `r(n)']"'
    }
    capture erase "`u30log'"
    capture erase "`u30html'"
    capture dash clear
    _u05_judge U30-`u' `"`bad'"' `"`u30msg': rc 0 and twoway's note, once, when drawn"'
}

