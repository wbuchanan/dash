*! test_setup_honesty.cscript  v1.0
*! Certification script for dash_setup's summary and its version gate.
*!
*! dash_setup ended, unconditionally, with
*!
*!     dash_setup complete.  All dependencies are satisfied.
*!
*! and FOUR branches reached it after reporting a failure:
*!
*!   1. Python below the minimum.  The branch displays "version X is below
*!      the minimum" (the one _dash_pymin returns) and "bokeh and pandas
*!      will not install or import reliably" -- and there is no `exit'.
*!      Every `exit' in the file was on another branch (no Python at all, a
*!      required pip install that failed, and the two jsonio ones).
*!   2. A required package present but BELOW its minimum.  The gate prints
*!      "(below minimum 3.8)" and carries on.
*!   3. An optional package that could not be installed -- `continue'.
*!   4. `packaging' itself failing to install, which disables the gate.
*!
*! So a user on Python 3.7 was told their setup was fine and sent on to fail
*! inside bokeh later.  That is the honesty rule (CLAUDE.md 2) inverted by
*! the one command whose job is to tell the truth about the environment.
*!
*! THE VERSION GATE LIED IN A SECOND WAY.  When `packaging' is unavailable
*! the gate's `else' prints
*!
*!     bokeh ............. OK (version unknown)
*!
*! for EVERY package -- although `_dash_pkg_version' has already retrieved
*! the real version.  Measured on this machine it returns bokeh 3.8.0,
*! numpy 2.3.5, pandas 2.3.3, scipy 1.16.3, statsmodels 0.14.5, so "version
*! unknown" is false, and "OK" is unverified rather than true: a bokeh 2.4
*! would be reported OK.
*!
*! WHY THE FALLBACK COMPARATOR IS NOT SIMPLY SWAPPED IN.  dash already has a
*! pure-Stata numeric comparator, `_dash_pyver_ok'.  Measured against
*! packaging on nine version pairs it agrees on six and DISAGREES on three,
*! all of them pre/post-release forms:
*!
*!     0.13.0rc1 >= 0.13    _dash_pyver_ok 1, packaging 0
*!     3.0b1     >= 3.0     _dash_pyver_ok 1, packaging 0
*!     3.0.post1 >= 3.0     _dash_pyver_ok -1 (unreadable), packaging 1
*!
*! PEP 440 puts a release candidate BEFORE its release, and the numeric
*! comparator cannot see that.  So it is used only as a FALLBACK when
*! packaging is absent, and its answer is labelled approximate rather than
*! reported as OK.
*!
*! HOW THIS IS TESTED WITHOUT INSTALLING ANYTHING.  dash_setup pip-installs
*! into the user's real environment, so no test here may let it reach pip.
*! The summary and the gate are therefore separate programs -- `_dash_setup_summary'
*! and `_dash_setup_gate' -- which these cases call directly with the state
*! they want to test.  That refactor is what makes the requirement testable
*! at all; before it, the summary was four inline `display' lines.  HON-19..25
*! run the command itself, with pip replaced by a recorder in Stata's Python
*! for exactly the length of each run, so it can reach pip and install
*! nothing (WP-24: the helpers alone left the body's wiring untested).
*!
*! PEP-17..19 (WP-29 P0.19): dash_setup, venv() on real venvs, offline, and
*! pip's non-ASCII PEP 668 refusal read in Stata's own interpreter.
*!
*! Tests: HON-01 through HON-42, PEP-17..19.  HON-40..42 (WP-30 P1.32): dash_setup's
*! first Python call, captured and retried, through test/dep_block.py.  HON-19..25 run dash_setup itself with pip
*! replaced by a recorder, so nothing is installed (see the section header).
*! HON-26..28 run it in test/setup_sandbox.py's sandbox, for the order of its
*! steps (packaging before the packages that need it) and for what it leaves
*! alone (scipy and statsmodels) -- claims test_server.py and
*! test_help_claims_8.py held by reading dash_setup.ado's text.  HON-29..30
*! (WP-28 K2) run the same sandbox against the declared floor -- bokeh
*! 3.7.3 and Python 3.12.11, both below it -- refused by name with the
*! c(python_exec) pip line (Q27), nothing installed.
*!
*! Usage:  do test/test_setup_honesty.cscript
*! Version: 1.1  24sep2026

cscript "dash_setup does not claim success it did not achieve" adodir ".."
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}

if "`c(python_exec)'" == "" {
    display as error "SKIP: Python not available."
    exit 222
}

qui do "../dash_setup.ado"
// cert_log_has, for HON-16/17's captured log: it re-joins the lines a log
// wraps, which a line-by-line search cannot.
do "cert_helpers.do"

// Read a captured log in Mata: a line of it is a value there, so nothing a
// message contains can end a Stata string or be parsed as code.  The
// registry cscript uses the same helper (the serve and locator cscripts
// moved to cert_log_has, 24sep2026).
mata:
real scalar _hon_log_has(string scalar fn, string scalar needle)
{
    // A log's logical lines: Stata wraps a line at the column, anywhere --
    // mid-word included -- and goes on with "> "; a physical line comes
    // back from fget() in 32,768-character pieces.  Each is searched
    // re-joined, as cert_helpers.do's _cert_log_count does (WP-24: read
    // line by line, a needle the wrap split was not found).
    real scalar   fh, found, piece
    string scalar line, full
    found = 0
    full  = ""
    piece = 0
    fh = fopen(fn, "r")
    while ((line = fget(fh)) != J(0, 0, "")) {
        if (piece | substr(line, 1, 2) == "> ") {
            full = full + (piece ? line : substr(line, 3, .))
        }
        else {
            if (strpos(strlower(full), strlower(needle))) found = 1
            full = line
        }
        piece = (strlen(line) == 32768)
    }
    if (strpos(strlower(full), strlower(needle))) found = 1
    fclose(fh)
    return(found)
}

// Count lines matching in CODE only, so a comment quoting the old text
// cannot satisfy or defeat an assertion about the code.
real scalar _hon_code_has(string scalar fn, string scalar needle)
{
    real scalar   fh, n
    string scalar line, trimmed
    n  = 0
    fh = fopen(fn, "r")
    while ((line = fget(fh)) != J(0,0,"")) {
        trimmed = strltrim(line)
        if (substr(trimmed, 1, 2) == "//") continue
        if (substr(trimmed, 1, 2) == "*!") continue
        if (strpos(line, needle)) n = n + 1
    }
    fclose(fh)
    return(n)
}
end

// Run the summary with a given number of failures and warnings, and hand
// back the return code plus what it said.
capture program drop _hon_summary
program define _hon_summary, rclass
    args nfail nwarn what
    tempname lf
    tempfile lg
    quietly log using "`lg'", replace text name(`lf')
    capture noisily _dash_setup_summary, failures(`nfail') warnings(`nwarn') ///
        items(`"`what'"')
    local rc = _rc
    quietly log close `lf'
    mata: st_local("_hon_ok",  strofreal(_hon_log_has("`lg'", "All dependencies are satisfied")))
    mata: st_local("_hon_bad", strofreal(_hon_log_has("`lg'", "did not complete")))
    mata: st_local("_hon_named", strofreal(_hon_log_has("`lg'", `"`what'"')))
    return scalar rc      = `rc'
    return scalar claimed = `_hon_ok'
    return scalar failed  = `_hon_bad'
    return scalar named   = `_hon_named'
end


// ================================================================
// HON-01..05 — the summary must reflect what happened
// ================================================================

_hon_summary 0 0 ""
assert r(rc) == 0
assert r(claimed) == 1
assert r(failed) == 0
display "HON-01 PASS: a clean run still reports success"

_hon_summary 1 0 "Python"
assert r(claimed) == 0
// ... and says so, in the words HON-01 requires absent from a clean run:
// the positive control for its r(failed) == 0.  No case asserted "did not
// complete" present before 24sep2026, so a reworded failure line left
// HON-01's check nothing to find.
assert r(failed) == 1
display "HON-02 PASS: a failure suppresses the success banner and says the setup did not complete"

_hon_summary 1 0 "Python"
assert r(rc) != 0
display "HON-03 PASS: a failure exits non-zero"

_hon_summary 1 0 "Python"
assert r(named) == 1
display "HON-04 PASS: the summary names what failed"

// A warning is not a failure: `packaging' that could not be installed
// costs exact version checks, not the setup.  (This used to be scipy, an
// optional package; since WP-18 no package is optional.)
_hon_summary 0 1 "packaging (version checks approximate)"
assert r(rc) == 0
assert r(claimed) == 0
assert r(named) == 1
display "HON-05 PASS: a warning is reported without failing the run"


// ================================================================
// HON-06..11 — the version gate never reports OK for an unverified version
// ================================================================
// _dash_setup_gate takes the package, its installed version, its minimum and
// whether packaging is available, and returns r(verdict) in
// {ok, below, unverified, unknown}.  Driving it directly is what lets this
// be tested without downgrading anything.

capture program drop _hon_gate
program define _hon_gate, rclass
    args pkg got want haspkg
    _dash_setup_gate "`pkg'" "`got'" "`want'" `haspkg'
    return local verdict "`r(verdict)'"
end

_hon_gate bokeh "3.8.0" "3.0" 1
assert "`r(verdict)'" == "ok"
display "HON-06 PASS: an at-or-above version with packaging is ok"

_hon_gate bokeh "2.4" "3.0" 1
assert "`r(verdict)'" == "below"
display "HON-07 PASS: a below-minimum version with packaging is below"

// The one that used to print "OK (version unknown)".
_hon_gate bokeh "2.4" "3.0" 0
assert "`r(verdict)'" == "below"
display "HON-08 PASS: a below-minimum version is still caught without packaging"

_hon_gate bokeh "3.8.0" "3.0" 0
assert "`r(verdict)'" == "unverified"
display "HON-09 PASS: without packaging an at-or-above version is unverified, not OK"

_hon_gate bokeh "unknown" "3.0" 1
assert "`r(verdict)'" == "unknown"
display "HON-10 PASS: a version that could not be read is unknown, not OK"

// A form the numeric fallback cannot judge must not be guessed at.
_hon_gate bokeh "3.0.post1" "3.0" 0
assert "`r(verdict)'" == "unverified"
display "HON-11 PASS: a version the fallback cannot parse is unverified"


// ================================================================
// HON-12..13 — an unparseable version must not kill the command
// ================================================================
// Measured before the fix: the `Version(...)' call had no `capture', and
// `Version("0.1.0_1")' raised InvalidVersion, giving r(7102) from inside
// dash_setup with no message of its own.
capture noisily _hon_gate bokeh "0.1.0_1" "3.0" 1
assert _rc == 0
assert "`r(verdict)'" != ""
display "HON-12 PASS: an unparseable version does not abort the gate"

capture noisily _hon_gate bokeh "not-a-version" "3.0" 1
assert _rc == 0
display "HON-13 PASS: a wholly unparseable version does not abort either"


// ================================================================
// HON-14..15 — dash_setup declares its own surface
// ================================================================
// It had no `syntax' line, so `dash_setup, garbage(1)' ran the whole setup
// and ignored the option in silence.  dash_setup.sthlp's Syntax section is
// the bare command, so anything supplied is an error.
// Measured: a `syntax' line with no specification rejects both an option
// and a stray argument with r(101), not r(198) -- 101 is Stata's own
// "options not allowed".  Asserting the exact code rather than merely
// non-zero, so a future `syntax' that accidentally accepts something and
// fails later for a different reason does not pass this.
// WP-29 P0.19: dash_setup now declares venv(), so an unknown option is
// Stata's "option garbage() not allowed", r(198) (T7); an argument stays
// r(101) (HON-15).
capture dash_setup , garbage(1)
assert _rc == 198
display "HON-14 PASS: an unknown option on dash_setup is r(198)"

capture dash_setup nonsense
assert _rc == 101
display "HON-15 PASS: a stray argument on dash_setup is r(101)"


// ================================================================
// HON-16 — dash's own files are checked, not just its dependencies
// ================================================================
// dash_setup checked Python, five packages and jsonio, and never asked
// whether dash_render.py or the schemes were reachable.  That is why an
// install whose fourteen schemes all fell back was reported as "All
// dependencies are satisfied".
//
// _hon_files runs the check with its output captured.  Until 24sep2026 it
// was defined here and never called: HON-16 asserted rc 0 alone, which a
// check that printed and counted nothing passed as well.
capture program drop _hon_files
program define _hon_files, rclass
    tempname lf
    tempfile lg
    quietly log using "`lg'", replace text name(`lf')
    capture noisily _dash_setup_check_files
    local rc = _rc
    // Read at once: the next rclass call replaces r().
    local nf = r(failures)
    quietly log close `lf'
    cert_log_has "`lg'", needle("dash_render.py") lower
    local said_r = r(found)
    cert_log_has "`lg'", needle("scheme") lower
    local said_s = r(found)
    cert_log_has "`lg'", needle("not found") lower
    local said_nf = r(found)
    return scalar rc       = `rc'
    return scalar failures = `nf'
    return scalar said_r   = `said_r'
    return scalar said_s   = `said_s'
    return scalar said_nf  = `said_nf'
end

// Both cases run on an ado-path narrowed to BASE and ONE directory, so
// what the check finds is that directory's and no other copy's.  On the
// ado-path the script is given, findfile answers with whichever dash comes
// first -- test_setup_python_gate.cscript found it returning an installed
// copy under the full runner -- and a check that found another copy passed
// for a tree whose own renderer was missing.
//   (a) this tree: both files present, reachable and OK;
//   (b) a directory holding a copy of dash.ado and no dash_render.py: the
//       renderer on no ado-path and not beside dash.ado, which must be
//       counted as one failure and said ("not found").
// No case drove (b) before 24sep2026, so a check that counted nothing
// passed HON-17.  Every result is read into a local, inside a captured
// block, before the ado-path is put back: a failure cannot leave it
// narrowed for the scripts the runner runs after this one.
local _hon_here "`c(pwd)'"
quietly cd ..
local _hon_tree "`c(pwd)'"
quietly cd "`_hon_here'"
tempfile _hon_tmp
local _hon_nodash "`_hon_tmp'_hon17"
capture mkdir "`_hon_nodash'"
copy "../dash.ado" "`_hon_nodash'/dash.ado", replace
mata: st_local("_hon_sado", st_global("S_ADO"))
local a_rc = -1
local b_rc = -1
capture noisily {
    mata: st_global("S_ADO", "BASE;" + char(96) + char(34) + st_local("_hon_tree") + char(34) + char(39))
    _hon_files
    local a_rc = r(rc)
    local a_nf = r(failures)
    local a_r  = r(said_r)
    local a_s  = r(said_s)
    mata: st_global("S_ADO", "BASE;" + char(96) + char(34) + st_local("_hon_nodash") + char(34) + char(39))
    _hon_files
    local b_rc = r(rc)
    local b_nf = r(failures)
    local b_nd = r(said_nf)
}
local _hon_blk = _rc
mata: st_global("S_ADO", st_local("_hon_sado"))
capture erase "`_hon_nodash'/dash.ado"
capture rmdir "`_hon_nodash'"

assert `_hon_blk' == 0
assert `a_rc' == 0
assert `a_r' == 1
assert `a_s' == 1
display "HON-16 PASS: dash_setup checks its own renderer and schemes"

// In this tree both are present, so the check must find them -- and where
// the renderer is missing, it must count it and say so.
assert `a_nf' == 0
assert `b_rc' == 0
assert `b_nf' == 1
assert `b_nd' == 1
display "HON-17 PASS: a healthy tree reports no missing files, and a missing renderer is one"


// ================================================================
// HON-18 — no branch prints a failure and then claims success
// ================================================================
// A source check, because the four branches cannot all be driven without
// breaking the machine's Python.  The success line must appear exactly once
// and only inside the summary program.
mata: st_local("_hon_n", strofreal(_hon_code_has("../dash_setup.ado", ///
    "All dependencies are satisfied")))
assert `_hon_n' == 1
display "HON-18 PASS: the success banner is written in exactly one place"


// ================================================================
// HON-19..25 -- dash_setup itself, run end to end, installing nothing
// ================================================================
// HON-01..18 drive the helpers, and nothing ran dash_setup's own body, so
// the wiring from each branch to the counters was untested.  Measured under
// WP-24, each of these left HON-01..18 green: Python below the minimum
// printed and not counted (the J1 defect itself), a required package below
// its minimum not counted, pip handed the bare name, the --user retry
// removed, pip's output for `packaging' discarded, an unverified version
// displayed as "OK (version unknown)", _dash_setup_check_files never
// called, its scheme probe never failing, and a missing renderer reported
// as present.
//
// dash_setup runs for real here, with pip replaced by a recorder in Stata's
// Python for exactly the length of the run (_hon_run_setup): every call is
// written down, nothing is installed, and every call "fails", so a missing
// package stays missing.  A missing package is made by putting None in
// sys.modules, which Python's import refuses, and the module is put back
// before anything is asserted.  The logs are
// read line by line, so they are written at full width, and the session's
// width is put back at the end.
local _hon_ls = c(linesize)
set linesize 255
local _hon_live 1
// An import can only be asked by importing, and the first python call of a
// session can fail under the runner whatever it asks: warm up, ask, and ask
// once more before concluding a module is missing.
capture python: pass
foreach m in packaging bokeh numpy pandas {
    capture python: import `m'
    if _rc capture python: import `m'
    if _rc local _hon_live 0
}

// Put dash_setup's programs back after a case replaced one with a stub.
capture program drop _hon_reload
program define _hon_reload
    foreach p in dash_setup _dash_pymin _dash_pyver_ok _dash_pip_command ///
            _dash_pkg_version _dash_setup_summary _dash_setup_gate ///
            _dash_setup_check_files _dash_setup_lib _dash_setup_detect ///
            _dash_setup_pip _dash_setup_guide _dash_setup_venv ///
            _dash_statamin _dash_setup_stata _dash_setup_pystart {
        capture program drop `p'
    }
    quietly do "../dash_setup.ado"
end

// Run dash_setup with pip recorded, optionally with one module made
// unimportable; hand back its rc, its log and the pip calls it made
// (each without the interpreter path, "|"-separated).
capture program drop _hon_run_setup
program define _hon_run_setup, rclass
    args block
    local lg "`c(tmpdir)'dash_hon_setup.log"
    capture erase "`lg'"
    python: import subprocess as _hon_sp; _hon_real_run = _hon_sp.run; _hon_calls = []
    python: import subprocess as _hon_sp; _hon_sp.run = lambda args, **kw: (_hon_calls.append([str(a) for a in args]), type("_HonPip", (), {"returncode": 1, "stdout": "HONPIPOUT", "stderr": "HONPIPERR"})())[1]
    if "`block'" != "" {
        python: import sys, sfi; _hon_b = sfi.Macro.getLocal("block"); _hon_saved = sys.modules.get(_hon_b); sys.modules[_hon_b] = None
    }
    tempname lf
    quietly log using "`lg'", replace text name(`lf')
    capture noisily dash_setup
    local rc = _rc
    quietly log close `lf'
    if "`block'" != "" {
        python: import sys; (sys.modules.__setitem__(_hon_b, _hon_saved) if _hon_saved is not None else sys.modules.pop(_hon_b, None))
    }
    python: import subprocess as _hon_sp, sfi; _hon_sp.run = _hon_real_run; sfi.Macro.setLocal("calls", " | ".join(("-c <code>" if c[1:2] == ["-c"] else " ".join(c[1:])) for c in _hon_calls))
    return scalar rc = `rc'
    return local log "`lg'"
    return local calls `"`calls'"'
end

capture program drop _hon_has
program define _hon_has
    args fn needle out
    mata: st_local("_hh", strofreal(_hon_log_has(st_local("fn"), st_local("needle"))))
    c_local `out' `_hh'
end

// Without all four, dash_setup would try to install what is missing, and
// the cases below would measure the recorder rather than the command.
// (A program cannot be defined inside braces, hence the early exit.)
if !`_hon_live' {
    display "HON-19..28 SKIP: packaging, bokeh, numpy and pandas must all be present to run dash_setup without installing"
    foreach p in _hon_summary _hon_gate _hon_files _hon_run_setup _hon_reload _hon_has {
        capture program drop `p'
    }
    set linesize `_hon_ls'
    display ""
    display "All dash_setup honesty tests PASSED."
    exit
}

// ---- HON-19: Python below the minimum (J1, AC-06.1) ----
// The real comparator runs, under dash_setup's own `version 16.0', against
// a minimum no interpreter meets.
capture program drop _dash_pymin
program define _dash_pymin, rclass
    return local pymin "99.0"
end
_hon_run_setup
local h19rc = r(rc)
local h19log "`r(log)'"
local h19calls `"`r(calls)'"'
_hon_reload
_hon_has "`h19log'" "is below the minimum 99.0" h19below
_hon_has "`h19log'" "(needs 99.0)" h19unmet
_hon_has "`h19log'" "All dependencies are satisfied" h19ok
assert `h19rc' == 198
assert `h19below' == 1
assert `h19unmet' == 1
assert `h19ok' == 0
assert `"`h19calls'"' == ""
display "HON-19 PASS: Python below the minimum is counted: r(198), named, no success banner"

// ---- HON-20: a required package below its minimum (AC-06.2) ----
capture program drop _dash_pkg_version
program define _dash_pkg_version
    args pkg outmac
    if "`pkg'" == "bokeh" {
        c_local `outmac' "2.4"
    }
    else {
        c_local `outmac' "99.0"
    }
end
_hon_run_setup
local h20rc = r(rc)
local h20log "`r(log)'"
local h20calls `"`r(calls)'"'
_hon_reload
_hon_has "`h20log'" "(below minimum 3.8)" h20below
// Q27: the upgrade line names the interpreter Stata is linked to, never
// a bare `python'.  WP-29 P0.19: quoted for the shell (the shlex oracle).
// Flipped (WP-30 P1.30): dash_setup installs bokeh inside the verified window.
python: import shlex, sfi; sfi.Macro.setLocal("h20wantcmd", shlex.join([sfi.SFIToolkit.macroExpand(chr(96) + "c(python_exec)'"), "-m", "pip", "install", "bokeh>=3.8,<3.10"]))
_hon_has "`h20log'" `"`h20wantcmd'"' h20cmd
_hon_has "`h20log'" "bokeh 2.4 (needs 3.8)" h20unmet
_hon_has "`h20log'" "All dependencies are satisfied" h20ok
assert `h20rc' == 198
assert `h20below' == 1
assert `h20cmd' == 1
assert `h20unmet' == 1
assert `h20ok' == 0
// WP-29 P0.19: the below verdict inspects the Python (a probe, not an
// install) to know whether it is managed (N4).
assert `"`h20calls'"' == "-c <code>"
display "HON-20 PASS: bokeh 2.4 is reported unmet with the upgrade command, and not upgraded"

// ---- HON-21: packaging unavailable (AC-06.3, TR-06.7) ----
_hon_run_setup packaging
local h21rc = r(rc)
local h21log "`r(log)'"
local h21calls `"`r(calls)'"'
_hon_has "`h21log'" "HONPIPOUT" h21out
_hon_has "`h21log'" "with 1 warning" h21warn
_hon_has "`h21log'" "All dependencies are satisfied" h21ok
_hon_has "`h21log'" "(not verified against 3.8)" h21v1
_hon_has "`h21log'" "(not verified against 2.3)" h21v2
_hon_has "`h21log'" "(not verified against 2.3)" h21v3
_hon_has "`h21log'" "bokeh ............. OK" h21k1
_hon_has "`h21log'" "numpy ............. OK" h21k2
_hon_has "`h21log'" "pandas ............. OK" h21k3
assert `h21rc' == 0
// WP-29 P0.19: the probe first, then pip with -P and its fixed flags.
assert `"`h21calls'"' == "-c <code> | -P -m pip install --disable-pip-version-check --no-input --only-binary=:all: packaging"
assert `h21out' == 1
assert `h21warn' == 1
assert `h21ok' == 0
assert `h21v1' == 1 & `h21v2' == 1 & `h21v3' == 1
assert `h21k1' == 0 & `h21k2' == 0 & `h21k3' == 0
display "HON-21 PASS: without packaging no package is OK, pip's own output is shown, one warning"

// ---- HON-22: a missing package (TR-06.2, TR-06.6) ----
