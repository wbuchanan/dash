// ================================================================
// PEP-17..19 -- dash_setup, venv() with real processes, offline, and
//               pip's non-ASCII refusal in Stata's own interpreter
//               (WP-29 P0.19, N1)
// ================================================================
// PEP-17/18 build real venvs from c(python_exec) with PIP_NO_INDEX=1, so
// nothing is downloaded; PIP_NO_INDEX is put back after each.  Each case
// reports and the run goes on; the ids that failed are listed at the end.
global PEP_FAILED ""
capture program drop _pep_fail
program define _pep_fail
    args id rc
    global PEP_FAILED `"$PEP_FAILED `id'"'
    display as error "`id' FAIL rc `rc'"
end

// The N1 probe: a child writing pip's PEP 668 bytes (the fixture's), read
// by run_child, and by plain text=True as the control.
python:
def _pep19_probe():
    import json, locale, subprocess, sys
    from sfi import Macro, SFIToolkit
    m = sys.modules["_dash_setup_lib"]
    with open("fixtures/pip_refusals.json", encoding="utf-8") as fh:
        hexb = json.load(fh)["externally_managed"]["stderr"].encode("utf-8").hex()
    exe = SFIToolkit.macroExpand(chr(96) + "c(python_exec)'")
    fake = [exe, "-c", "import sys; sys.stderr.buffer.write(bytes.fromhex(%r)); sys.exit(1)" % hexb]
    control = "ok"
    try:
        subprocess.run(fake, capture_output=True, text=True)
    except UnicodeDecodeError:
        control = "raised"
    rc, out, err = m.run_child(fake)
    Macro.setLocal("p19rc", str(rc))
    Macro.setLocal("p19x", "1" if chr(0xd7) in err and "externally-managed-environment" in err else "0")
    Macro.setLocal("p19ascii", "1" if "ascii" in locale.getpreferredencoding(False).lower() else "0")
    Macro.setLocal("p19control", control)
end

// ---- PEP-17: a venv whose install fails (offline) is left, named ----
local p17 "`c(tmpdir)'pep17 venv"
python: import shutil, sfi; shutil.rmtree(sfi.Macro.getLocal("p17"), True)
python: import os; _pep_pni = os.environ.get("PIP_NO_INDEX"); os.environ["PIP_NO_INDEX"] = "1"
capture noisily {
    local lg "`c(tmpdir)'dash_pep17.log"
    capture erase "`lg'"
    capture log close _pep17
    quietly log using "`lg'", text replace name(_pep17)
    capture noisily dash_setup, venv("`p17'")
    local rc = _rc
    mata: st_local("hint", st_global("r(hint_cmd)"))
    quietly log close _pep17
    python: import os, stat, sfi; _pep_p = sfi.Macro.getLocal("p17"); _pep_s = os.stat(_pep_p); sfi.Macro.setLocal("ok17", "1" if os.path.isfile(os.path.join(_pep_p, "pyvenv.cfg")) and stat.S_IMODE(_pep_s.st_mode) == 0o755 and _pep_s.st_uid == os.getuid() else "0")
    _hon_has "`lg'" "No matching distribution" h17nm
    _hon_has "`lg'" "you may delete it" h17del
    display as text "  PEP-17: rc `rc', venv `ok17', offline refusal `h17nm', delete note `h17del'"
    assert `rc' == 198
    assert "`ok17'" == "1"
    assert `h17nm' == 1
    assert `h17del' == 1
    assert `"`hint'"' == ""
    display "PEP-17 PASS: a venv whose install fails offline is left in place with a note, no link line, r(198)"
}
local pep_rc = _rc
capture log close _pep17
python: import os; (os.environ.__setitem__("PIP_NO_INDEX", _pep_pni) if _pep_pni is not None else os.environ.pop("PIP_NO_INDEX", None))
python: import shutil, sfi; shutil.rmtree(sfi.Macro.getLocal("p17"), True)
if `pep_rc' _pep_fail PEP-17 `pep_rc'

// ---- PEP-18: a venv that sees the linked Python's packages verifies ----
local p18 "`c(tmpdir)'pep18 venv"
python: import shutil, sfi; shutil.rmtree(sfi.Macro.getLocal("p18"), True)
python: import os; _pep_pni = os.environ.get("PIP_NO_INDEX"); os.environ["PIP_NO_INDEX"] = "1"
capture noisily {
    python: import os, subprocess, sysconfig, sfi; _pep_p = sfi.Macro.getLocal("p18"); _pep_e = sfi.SFIToolkit.macroExpand(chr(96) + "c(python_exec)'"); _pep_r = subprocess.run([_pep_e, "-m", "venv", _pep_p], capture_output=True); _pep_l = subprocess.run([os.path.join(_pep_p, "bin", "python"), "-c", "import sysconfig; print(sysconfig.get_paths()['purelib'])"], capture_output=True, text=True).stdout.strip(); open(os.path.join(_pep_l, "dash_base.pth"), "w").write(sysconfig.get_paths()["purelib"] + chr(10)); sfi.Macro.setLocal("mk18", str(_pep_r.returncode)); sfi.Macro.setLocal("py18", os.path.join(os.path.realpath(_pep_p), "bin", "python"))
    assert "`mk18'" == "0"
    local lg "`c(tmpdir)'dash_pep18.log"
    capture erase "`lg'"
    capture log close _pep18
    quietly log using "`lg'", text replace name(_pep18)
    capture noisily dash_setup, venv("`p18'")
    local rc = _rc
    mata: st_local("hint", st_global("r(hint_cmd)"))
    mata: st_local("vpy", st_global("r(venv_python)"))
    local vl "`r(venv_linked)'"
    quietly log close _pep18
    _hon_has "`lg'" "Requirement already satisfied" h18sat
    display as text "  PEP-18: rc `rc', satisfied `h18sat', linked `vl'"
    assert `rc' == 0
    assert `h18sat' == 1
    mata: st_local("vpyok", strofreal(st_local("vpy") == st_local("py18")))
    mata: st_local("hintok", strofreal(st_local("hint") == "python set exec " + char(34) + st_local("py18") + char(34) + ", permanently"))
    assert `vpyok' == 1
    assert `hintok' == 1
    assert "`vl'" == "0"
    display "PEP-18 PASS: a venv that sees the packages is verified and its python set exec line returned, rc 0"
}
local pep_rc = _rc
capture log close _pep18
python: import os; (os.environ.__setitem__("PIP_NO_INDEX", _pep_pni) if _pep_pni is not None else os.environ.pop("PIP_NO_INDEX", None))
python: import shutil, sfi; shutil.rmtree(sfi.Macro.getLocal("p18"), True)
if `pep_rc' _pep_fail PEP-18 `pep_rc'

// ---- PEP-19: pip's PEP 668 bytes under Stata's locale (N1) ----
capture noisily {
    _dash_setup_lib
    assert r(ok) == 1
    python: _pep19_probe()
    display as text "  PEP-19: rc `p19rc', text holds the bytes `p19x', ASCII locale `p19ascii', control `p19control'"
    assert "`p19rc'" == "1"
    assert "`p19x'" == "1"
    if "`p19ascii'" == "1" {
        assert "`p19control'" == "raised"
    }
    else {
        display as text "  PEP-19: the locale is not ASCII here, so the control was not exercised"
    }
    display "PEP-19 PASS: pip's non-ASCII refusal is read as UTF-8 in Stata's own interpreter"
}
if _rc _pep_fail PEP-19 `=_rc'
local pep_failed `"$PEP_FAILED"'
macro drop PEP_FAILED
capture program drop _pep_fail
if `"`pep_failed'"' != "" {
    display as error "PEP FAILED: `pep_failed'"
    exit 9
}

// ================================================================
// HON-31..32 -- the measured floor admits Python 3.11 and 3.12
// (WP-30 P1.33)
// ================================================================
// With every package present, a Python at or above the floor is OK: the
// run ends "All dependencies are satisfied", rc 0, installing nothing.

// ---- HON-31: Python 3.12.12 is above the floor ----
global HON_SB_SPEC `"{"pyversion": "3.12.12 (dash test sandbox)"}"'
global HON_SB_EXPECT "[]"
_hon_sb_setup
local h31rc = r(rc)
local h31m = r(match)
local h31log "`r(log)'"
if `h31m' != 1 {
    mata: printf("{err}HON-31: %s\n", st_global("HON_SB_WHY"))
}
assert `h31m' == 1
assert `h31rc' == 0
_hon_has "`h31log'" "All dependencies are satisfied" h31ok
_hon_has "`h31log'" "below the minimum" h31below
assert `h31ok' == 1
assert `h31below' == 0
display "HON-31 PASS: Python 3.12.12 is accepted, every package OK, rc 0"

// ---- HON-32: Python 3.11.2 is at the floor ----
global HON_SB_SPEC `"{"pyversion": "3.11.2 (dash test sandbox)"}"'
global HON_SB_EXPECT "[]"
_hon_sb_setup
local h32rc = r(rc)
local h32m = r(match)
local h32log "`r(log)'"
if `h32m' != 1 {
    mata: printf("{err}HON-32: %s\n", st_global("HON_SB_WHY"))
}
assert `h32m' == 1
assert `h32rc' == 0
_hon_has "`h32log'" "All dependencies are satisfied" h32ok
_hon_has "`h32log'" "below the minimum" h32below
assert `h32ok' == 1
assert `h32below' == 0
display "HON-32 PASS: Python 3.11.2 is accepted, every package OK, rc 0"

// ================================================================
// HON-40..42 (WP-30 P1.32): dash_setup's first Python call is captured,
// retried once, and a Python that cannot start is reported in the summary.
// Run in setup_sandbox's sandbox with test/dep_block.py between install
// and run; Python is restored before any assert.
// ================================================================
python: import os as _rg_os, sys as _rg_sys
python: _rg_sys.path.insert(0, _rg_os.getcwd())
python: import dep_block
global HON_SB_SPEC "{}"
global HON_SB_EXPECT "[]"

// ---- HON-40: a Python that cannot start ----
local lg40 "`c(tmpdir)'dash_hon40.log"
capture erase "`lg40'"
python: import setup_sandbox; setup_sandbox.stata_install("HON_SB_SPEC")
local h40ok "`pc_sb_ok'"
python: dep_block.block("sfi", "missing")
quietly log using "`lg40'", text replace name(_hon40)
capture noisily dash_setup
local h40rc = _rc
quietly log close _hon40
python: dep_block.stata_restored()
local h40c "`rg_clean'"
python: import setup_sandbox; setup_sandbox.stata_verdict("HON_SB_EXPECT")
local h40m "`pc_sb_match'"
python: import setup_sandbox; setup_sandbox.restore()
python: import setup_sandbox; setup_sandbox.stata_restored()
local h40sb "`pc_sb_clean'"
local h40s ""
foreach nd in "could not be started" "`c(python_exec)'" "dash_setup did not complete" "Unmet:" "Python (could not be started)" "both arm64" {
    _hon_has "`lg40'" `"`nd'"' _h40
    local h40s "`h40s' `_h40'"
}
capture erase "`lg40'"
display "HON-40 measured: install `h40ok' rc `h40rc' said`h40s' match `h40m' clean `h40c' `h40sb'"

// ---- HON-41: a first start that fails is tried once more ----
local lg41 "`c(tmpdir)'dash_hon41.log"
capture erase "`lg41'"
python: import setup_sandbox; setup_sandbox.stata_install("HON_SB_SPEC")
local h41ok "`pc_sb_ok'"
python: dep_block.sfi_flaky()
quietly log using "`lg41'", text replace name(_hon41)
capture noisily dash_setup
local h41rc = _rc
quietly log close _hon41
python: dep_block.stata_hits()
local h41h "`rg_hits'"
python: dep_block.stata_restored()
local h41c "`rg_clean'"
python: import setup_sandbox; setup_sandbox.stata_verdict("HON_SB_EXPECT")
local h41m "`pc_sb_match'"
python: import setup_sandbox; setup_sandbox.restore()
python: import setup_sandbox; setup_sandbox.stata_restored()
local h41sb "`pc_sb_clean'"
_hon_has "`lg41'" "Python ............. OK" h41py
capture erase "`lg41'"
display "HON-41 measured: install `h41ok' rc `h41rc' python-ok `h41py' hits `h41h' match `h41m' clean `h41c' `h41sb'"

// ---- HON-42: the start program by itself ----
capture _dash_setup_pystart
local h42rc = _rc
local h42v `"`r(pyver)'"'
local h42t = r(tries)
python: import sys; from sfi import Macro; Macro.setLocal("h42want", sys.version.split()[0])
display "HON-42 measured: rc `h42rc' pyver `h42v' want `h42want' tries `h42t'"

assert "`h40ok'" == "1" & `h40rc' == 198
assert "`h40s'" == " 1 1 1 1 1 1"
assert "`h40m'" == "1" & "`h40c'" == "1" & "`h40sb'" == "1"
display "HON-40 PASS: a Python that cannot start is reported in the summary with its path and the processor rule, r(198), no process started"
assert "`h41ok'" == "1" & `h41rc' == 0 & `h41py' == 1 & "`h41h'" == "1"
assert "`h41m'" == "1" & "`h41c'" == "1" & "`h41sb'" == "1"
display "HON-41 PASS: a first Python call that fails is tried once more and dash_setup completes"
assert `h42rc' == 0 & `"`h42v'"' == "`h42want'" & `h42t' == 1
display "HON-42 PASS: _dash_setup_pystart returns the version from one try"


// ---- U59-1 (WP-31 I7): a render from an installed tree writes no bytecode ----
// The renderer is loaded from a staged install -- dash.ado, dash_parse.mata
// and dash_render.py copied into a scratch directory put first on the
// ado-path, so _dash_xm_load finds the dash_render.py beside that dash.ado
// -- and a render must leave no __pycache__ there, as an installed PLUS/py
// must not get one (ado uninstall would leave it behind).
local u59d "`c(tmpdir)'dash_u59_plus_`c(current_time)'"
local u59d : subinstr local u59d ":" "", all
capture mkdir "`u59d'"
foreach f in dash.ado dash_parse.mata dash_render.py {
    copy "../`f'" "`u59d'/`f'", replace
}
python: import sys; from sfi import Macro; Macro.setLocal("u59dwb", "1" if sys.dont_write_bytecode else "0"); sys.dont_write_bytecode = False
adopath ++ "`u59d'"
capture findfile dash.ado
local u59fn `"`r(fn)'"'
sysuse auto, clear
capture noisily dash scatter mpg weight, saving("`u59d'/u59.html") replace
local u59rc = _rc
python: import sys; from sfi import Macro; Macro.setLocal("u59after", "1" if sys.dont_write_bytecode else "0")
adopath - "`u59d'"
mata: st_local("u59pyc", strofreal(direxists(st_local("u59d") + "/__pycache__")))
mata: st_local("u59page", strofreal(fileexists(st_local("u59d") + "/u59.html")))
python: import sys; from sfi import Macro; sys.dont_write_bytecode = Macro.getLocal("u59dwb") == "1"
display "U59-1 measured: rc `u59rc' page `u59page' pycache `u59pyc' flag-after `u59after' dash.ado `u59fn'"
python: import shutil; from sfi import Macro; shutil.rmtree(Macro.getLocal("u59d"), ignore_errors=True)
assert `u59rc' == 0 & `u59page' == 1
assert `u59pyc' == 0
assert "`u59after'" == "0"
display "U59-1 PASS: a render from an installed tree writes no __pycache__ and leaves dont_write_bytecode as it was"


macro drop HON_SB_SPEC HON_SB_EXPECT HON_SB_WHY

capture erase "`c(tmpdir)'dash_hon_setup.log"
capture erase "`c(tmpdir)'dash_hon_sb.log"
capture erase "`lg23'"
capture erase "`lg24'"

capture program drop _hon_summary
capture program drop _hon_gate
capture program drop _hon_files
capture program drop _hon_run_setup
capture program drop _hon_reload
capture program drop _hon_has
capture program drop _hon_sb_setup
set linesize `_hon_ls'

display ""
display "All dash_setup honesty tests PASSED."
