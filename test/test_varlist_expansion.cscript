_ps_tally PS-07 `ok' "histogram, function, mspline and mband check mlabel as twoway does"

// PS-08 jitter per series
local ok 1
local i 0
foreach c in "jitter(2 3)|{'jitter':'2'}|{'jitter':'3'}" "jitter(2 ..)|{'jitter':'2'}|{'jitter':'2'}" ///
    "jitter(2 =)|{'jitter':'2'}|{'jitter':'2'}" "jitter(. 3)|{}|{'jitter':'3'}" "jitter(5)|{'jitter':'5'}|{}" ///
    "jitter(1d1 2)|{'jitter':'10'}|{'jitter':'2'}" "jitter(.)|{}|{}" {
    local ++i
    mata: _ps_p = strpos(st_local("c"), "|")
    mata: st_local("o", substr(st_local("c"), 1, _ps_p - 1)); st_local("w", substr(st_local("c"), _ps_p + 1, .))
    capture noisily dash `two' `o' name(ps08_`i')
    mata: st_local("_o", strofreal(_sl_spec("ps08_`i'", st_local("w"))))
    if _rc | !`_o' {
        display as error `"PS-08.`i': `o' :: ${dash_json_ps08_`i'}"'
        local ok 0
    }
}
capture noisily dash scatter mpg weight, jitter(2 200) name(ps08s)
capture noisily dash scatter mpg weight, jitter(2 abc) name(ps08t)
mata: st_local("_o", strofreal(_sl_spec("ps08s", "{'jitter':'2'}") & _sl_spec("ps08t", "{'jitter':'2'}")))
local ok = `ok' & `_o'
_ps_run dash rscatter mpg turn weight, jitter(.) name(ps08r), log($ps_log)
mata: st_local("_o", strofreal(_sl_log_has(st_global("ps_log"), "jitter")))
if $ps_rc | `_o' local ok 0
_ps_tally PS-08 `ok' "jitter() one element per y; unused elements unchecked; jitter(.) is no jitter"

// PS-09 jitter refusals
local ok 1
// Flipped (WP-35 basic:PT-13): r(198) was wrong; twoway draws it
// (value_codes_truth.json jitter_150, jitter_abc_ref; twoway takes any jitter() text, rc 0).
capture noisily dash `two' jitter(2 200) name(ps09a)
local _r = _rc
mata: st_local("_o", strofreal(_sl_spec("ps09a", "{'jitter':'2'}|{'jitter':'200'}")))
if `_r' | !`_o' local ok 0
capture noisily dash `two' jitter(2 abc) name(ps09b)
local _r = _rc
mata: st_local("_o", strofreal(_sl_spec("ps09b", "{'jitter':'2'}|{}") & !strpos(st_global("dash_json_ps09b"), "abc")))
if `_r' | !`_o' local ok 0
_ps_refuse PS-09 198 "jitter(2 .. 5):  invalid syntax" |`two' jitter(2 .. 5)
// The text never reaches the spec: it is no number, so no jitter.
capture noisily dash scatter mpg weight, jitter(5; import os) name(ps09)
if _rc | strpos(`"${dash_json_ps09}"', "import") local ok 0
_ps_tally PS-09 `ok' "jitter() elements twoway draws are taken, as it draws them; a misplaced .. in twoway's words"

// PS-10 base and barwidth per series
local ok 1
local i 0
local b "bar mpg turn weight,"
foreach c in "`b' base(10 20) barwidth(1 2)|{'barwidth':'1','base':'10'}|{'barwidth':'2','base':'20'}" ///
    "`b' base(10 ..)|{'base':'10'}|{'base':'10'}" "`b' base(10 =)|{'base':'10'}|{'base':'10'}" ///
    "`b' barwidth(. 200)|{}|{'barwidth':'200'}" "`b' barwidth(1 ..)|{'barwidth':'1'}|{'barwidth':'1'}" ///
    "`b' barwidth(.)|{}|{}" "`b' base(10)|{'base':'10'}|{}" ///
    "dropline mpg turn weight, base(10 20)|{'base':'10'}|{'base':'20'}" ///
    "spike mpg turn weight, base(10 20)|{'base':'10'}|{'base':'20'}" ///
    "area mpg turn weight, sort base(10 20)|{'base':'10','sort':'sort'}|{'base':'20','sort':'sort'}" ///
    "bar mpg weight, barwidth(1 2) base(10 20)|{'barwidth':'1','base':'10'}" {
    local ++i
    mata: _ps_p = strpos(st_local("c"), "|")
    mata: st_local("o", substr(st_local("c"), 1, _ps_p - 1)); st_local("w", substr(st_local("c"), _ps_p + 1, .))
    capture noisily dash `o' name(ps10_`i')
    mata: st_local("_o", strofreal(_sl_spec("ps10_`i'", st_local("w"))))
    if _rc | !`_o' {
        display as error `"PS-10.`i': `o' :: ${dash_json_ps10_`i'}"'
        local ok 0
    }
}
// Flipped (WP-35 stat:PT-14): bw(1 2) read as barwidth() per y was wrong
// because twoway refuses bw() off the bandwidth types (P4-7); it is
// refused, r(198), "option bw() not allowed".
_ps_refuse PS-10 198 "option bw() not allowed" |`b' bw(1 2)
_ps_tally PS-10 `ok' "base() and barwidth() one element per y; bw() refused"

// PS-11 base and barwidth refusals
local ok 1
_ps_refuse PS-11 198 "base(10 .. 20):  invalid syntax" |bar mpg turn weight, base(10 .. 20)
// Flipped (WP-35 basic:PT-13): r(198) was wrong; twoway draws it
// (value_codes_truth.json barwidth_m2_ref, barwidth_0).
capture noisily dash bar mpg turn weight, barwidth(1 -2) name(ps11a)
if _rc | !strpos(`"${dash_json_ps11a}"', char(34) + "-2" + char(34)) local ok 0
capture noisily dash bar mpg turn weight, barwidth(1 0) name(ps11b)
if _rc | !strpos(`"${dash_json_ps11b}"', char(34) + "0" + char(34)) local ok 0
// Flipped (WP-35 basic:PT-9): r(198) in dash's words was wrong; twoway
// refuses it r(4026) (value_list_truth.json B23).
_ps_refuse PS-11 4026 "option base() incorrectly specified, abc is not a number" |bar mpg turn weight, base(10 abc)
_ps_tally PS-11 `ok' "a used base() element is held to the rule; barwidth() elements twoway draws are taken"

// PS-12 a list where twoway takes one value
local ok 1
_ps_refuse PS-12 198 "option barwidth() not allowed" |rbar mpg turn weight, barwidth(50 100)
_ps_refuse PS-12 198 "option barwidth() not allowed" |rbar mpg turn weight, barwidth(50 ..)
_ps_refuse PS-12 198 "option barwidth() not allowed" |rbar mpg turn weight, barwidth(50) barwidth(10 20)
_ps_refuse PS-12 198 "option barwidth() not allowed" |rbar mpg turn weight, barwidth(" 50")
_ps_refuse PS-12 198 "option barwidth() not allowed" |histogram mpg, barwidth(1 2)
_ps_refuse PS-12 198 "option barwidth() not allowed" |rspike mpg turn weight, barwidth(1 2)
_ps_refuse PS-12 198 "" |rcap mpg turn weight, barwidth(1 2)
_ps_refuse PS-12 198 "option base() not allowed" |rbar mpg turn weight, base(10 20)
_ps_refuse PS-12 198 "option base() not allowed" |histogram mpg, base(10 20)
_ps_refuse PS-12 198 "" |lowess mpg weight, bwidth(.5 .8)
capture noisily dash rbar mpg turn weight, barwidth(50) name(ps12a)
capture noisily dash histogram mpg, barwidth(1) name(ps12b)
mata: st_local("_o", strofreal(_sl_spec("ps12a", "{'barwidth':'50'}") & strpos(st_global("dash_json_ps12b"), "barwidth")))
local ok = `ok' & `_o'
_ps_tally PS-12 `ok' "barwidth() and base() lists refused in twoway's words where it takes one value"

// PS-13 guard (S11): mlabposition() per series beside mlabel()
capture noisily dash `two' mlabel(make rep78) mlabposition(3 9) name(ps13a)
capture noisily dash `two' mlabel(make) mlabposition(3 ..) name(ps13b)
mata: st_local("ok", strofreal(_sl_spec("ps13a", "{'mlabel':'make','mlabposition':'3'}|{'mlabel':'rep78','mlabposition':'9'}") & ///
    _sl_spec("ps13b", "{'mlabel':'make','mlabposition':'3'}|{'mlabposition':'3'}")))
_ps_tally PS-13 `ok' "mlabposition() keeps S11's reading beside an mlabel() list"

// PS-14 by()
capture noisily dash `two' mlabel(make rep78) by(foreign) name(ps14a)
capture noisily dash bar mpg turn weight, base(10 20) by(foreign) name(ps14b)
mata: st_local("ok", strofreal(_sl_spec("ps14a", "{'mlabel':'make'}|{'mlabel':'rep78'}") & _sl_spec("ps14b", "{'base':'10'}|{'base':'20'}")))
_ps_tally PS-14 `ok' "by() keeps each series' value"

// PS-15 guard: elements by value
local ok 1
_ps_refuse PS-15 111 "*not found" |`two' mlabel("\`jgnone'" rep78)
mata: st_local("_o", strofreal(strpos(st_global("ps_line"), char(96) + "jgnone' not found") > 0))
local ok = `ok' & `_o'
// Flipped (WP-35 basic:PT-13): r(198) was wrong; twoway draws it
// (value_codes_truth.json twoway takes any jitter() text; jitter_abc_ref).
// The text, no number, is dropped: it never reaches the spec.
capture noisily dash `two' jitter("\$G") name(ps15j)
local _r = _rc
mata: st_local("_o", strofreal(!strpos(st_global("dash_json_ps15j"), char(36) + "G")))
if `_r' | !`_o' local ok 0
_ps_tally PS-15 `ok' "a backtick or dollar in an element stays literal"

// PS-16 guard: one plain value on one y writes what it wrote
capture noisily dash scatter mpg weight, mlabel(make) jitter(5) name(ps16a)
capture noisily dash area mpg weight, base(5) name(ps16b)
capture noisily dash bar mpg weight, barwidth(20) name(ps16c)
mata: st_local("ok", strofreal(_sl_spec("ps16a", "{'mlabel':'make','jitter':'5'}") & _sl_spec("ps16b", "{'base':'5'}") & _sl_spec("ps16c", "{'barwidth':'20'}")))
_ps_tally PS-16 `ok' "a single plain value is written as before"
dash clear

// NP-46..NP-48 (WP-30 P1.14a): the named styles per y.  pstyle(p3 p4)
// gives each y its element; p() is one name and is not split; p3 .. on
// three y is p3 on each.
capture noisily dash scatter mpg turn weight, pstyle(p3 p4) name(np46)
mata: st_local("ok", strofreal(_sl_spec("np46", "{'pstyle':'p3'}|{'pstyle':'p4'}")))
_ps_tally NP-46 `ok' "pstyle(p3 p4) writes pstyle per series"
capture noisily dash scatter mpg turn weight, p(p3 p4) name(np47)
mata: st_local("ok", strofreal(_sl_spec("np47", "{'p':'p3 p4'}|{'p':'p3 p4'}")))
_ps_tally NP-47 `ok' "p(p3 p4) is written whole on both series"
capture noisily dash scatter mpg turn trunk weight, pstyle(p3 ..) name(np48)
mata: st_local("ok", strofreal(_sl_spec("np48", "{'pstyle':'p3'}|{'pstyle':'p3'}|{'pstyle':'p3'}")))
_ps_tally NP-48 `ok' "pstyle(p3 ..) on three y is p3 on each"
dash clear
local nfail = `nfail' + ${ps_nfail}
local faillist `"`faillist'${ps_faillist}"'

// ----------------------------------------------------------------
// Q3506-6 (WP-35 syn:SD-8): factor-variable notation in by(), colorvar()
// and mlabel() is refused as twoway refuses it -- by(i.foreign),
// by(c.foreign), colorvar(c.price) r(101) "factor-variable and
// time-series operators not allowed", a # r(101) "interactions not
// allowed", mlabel(c.make) r(111) "variable c not found", mlabel(45)
// r(198) "45 invalid name", mlabel(%9.1f) r(198) "invalid '%'";
// colorvar(i.foreign) drawn: every fv.* key of
// test/fixtures/graph_refusal_truth.json, rc and first line, on the
// one-line route and with name().  The helpers are reached through
// __main__ (cert_svg.do's TRAP note).
// ----------------------------------------------------------------
python:
import json as _q35066_json
from sfi import Macro as _q35066_M
_q35066_fx = _q35066_json.load(open("fixtures/graph_refusal_truth.json", encoding="utf-8"))
_q35066_M.setLocal("q6keys", " ".join(sorted(k for k in _q35066_fx if k.startswith("fv."))))


def _q35066_take(key):
    r = _q35066_fx[key]
    c = r["cmd"].strip()
    if c.startswith("twoway "):
        c = c[len("twoway "):]
    _q35066_M.setLocal("q6c", c.replace(" name(zg1, replace)", "").rstrip())
    _q35066_M.setLocal("q6tw", str(r["rc"]))


def _q35066_judge(key, path, rc):
    r = _q35066_fx[key]
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            text = fh.read()
    except OSError:
        text = ""
    lines = [ln.strip() for ln in text.replace("\n> ", "").splitlines()
             if ln.strip() and not ln.lstrip().startswith(("(note:", "log:", "log type:", "opened on:", "closed on:", "name:"))
             and not ln.startswith("---")]
    got = lines[0] if lines else ""
    ok = int(rc) == r["rc"] and (r["rc"] == 0 or got == r["first"])
    _q35066_M.setLocal("q6ok", "1" if ok else "0")
    _q35066_M.setLocal("q6got", got[:200])
    _q35066_M.setLocal("q6want", r["first"][:200])
end
quietly sysuse auto, clear
// cscript drops every global: a route twoway draws builds a page here,
// so no browser may open (Q3506-6).
global dash_nobrowser 1
local q6bad 0
foreach q6k of local q6keys {
    python: import __main__ as _q35066_main; _q35066_main._q35066_take("`q6k'")
    foreach q6r in line named {
        local q6d `"`q6c'"'
        if "`q6r'" == "named" local q6d `"`q6c' name(q3506v)"'
        set linesize 255
        dash clear
        capture log close _q6log
        capture erase "`c(tmpdir)'dash_q35066.log"
        quietly log using "`c(tmpdir)'dash_q35066.log", name(_q6log) text replace
        capture noisily dash `q6d'
        local q6rc = _rc
        quietly log close _q6log
        python: import __main__ as _q35066_main; _q35066_main._q35066_judge("`q6k'", r"`c(tmpdir)'dash_q35066.log", "`q6rc'")
        if !`q6ok' {
            display as error `"Q3506-6 FAIL `q6k' (`q6r'): rc `q6rc' (twoway `q6tw'); dash said: `macval(q6got)'; twoway: `macval(q6want)'"'
            local q6bad 1
        }
        else display as text `"Q3506-6 `q6k' (`q6r'): rc `q6rc' as twoway"'
    }
}
dash clear
capture erase "`c(tmpdir)'dash_q35066.log"
if `q6bad' {
    local nfail = `nfail' + 1
    local faillist `"`faillist' Q3506-6"'
}
else display as text "Q3506-6 PASS: factor-variable notation refused in twoway's words"

// ----------------------------------------------------------------
// Summary
// ----------------------------------------------------------------
dash clear
display as text ""
display as text "============================================================"
if `nfail' == 0 {
    display as text "  test_varlist_expansion: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_varlist_expansion: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
