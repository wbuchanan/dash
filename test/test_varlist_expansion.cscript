    _dash_stylelist_blank(char(36) + "G " + _sl_q(" "), 2) == 2 & ///
    _sl_E(char(36) + "G " + _sl_q(" ")) == char(36) + "G|0; |1"))
_sl_tally SL-25 `ok' "_dash_stylelist_blank finds a used blank element only"
dash clear
local nfail = `nfail' + ${sl_nfail}
local faillist `"`faillist'${sl_faillist}"'

// ----------------------------------------------------------------
// PS: per-series value lists (WP-30 P1.1b)
//
// twoway reads mlabel(), jitter(), base() and barwidth() over an expanded
// varlist one element per y, as a stylelist; dash refused every list,
// r(198), and gave a lone value to every y (measured 03oct2026, probe
// d1.do; twoway's readings: test/fixtures/value_list_truth.json).  PS-01
// is the Mata unit; the rest read each plot's options object and the
// refusals' first error line.
// ----------------------------------------------------------------
qui sysuse auto, clear
dash clear
global ps_nfail 0
global ps_faillist ""
tempfile ps_log
global ps_log "`ps_log'"

capture program drop _ps_tally
program define _ps_tally
    args id ok what
    if `ok' == 1 display as text "`id' PASS: `what'"
    else {
        display as error "`id' FAIL: `what'"
        global ps_nfail = ${ps_nfail} + 1
        global ps_faillist `"${ps_faillist} `id'"'
    }
end

capture program drop _ps_run
program define _ps_run
    // _ps_run <command>, log(<path>): $ps_rc is its rc and $ps_line the
    // first line it printed, read by value.
    mata: _sl_p = strrpos(st_local("0"), ", log(")
    mata: st_local("cmd", substr(st_local("0"), 1, _sl_p - 1))
    mata: st_local("log", substr(st_local("0"), _sl_p + 6, strlen(st_local("0")) - _sl_p - 6))
    capture log close _ps
    quietly log using `"`log'"', text replace name(_ps)
    capture noisily `macval(cmd)'
    global ps_rc = _rc
    quietly log close _ps
    mata: st_global("ps_line", _ps_first(st_local("log")))
end

capture program drop _ps_refuse
program define _ps_refuse
    // _ps_refuse id rc line <command>: the command is refused with rc and
    // first line exactly line (or a line ending in it when line starts
    // with "*"), and registers nothing.
    args id rc line
    mata: st_local("cmd", substr(st_local("0"), strpos(st_local("0"), "|") + 1, .))
    capture dash clear
    _ps_run dash `macval(cmd)' name(psr), log($ps_log)
    if substr(`"`line'"', 1, 1) == "*" {
        mata: st_local("_o", strofreal(substr(st_global("ps_line"), -strlen(st_local("line")) + 1, .) == substr(st_local("line"), 2, .)))
    }
    else mata: st_local("_o", strofreal(st_global("ps_line") == st_local("line") | st_local("line") == ""))
    if $ps_rc != `rc' | !`_o' | `"${dash_json_psr}"' != "" {
        display as error `"`id': rc $ps_rc, line: $ps_line :: `macval(cmd)'"'
        c_local ok 0
    }
end

mata:
string scalar _ps_first(string scalar path)
{
    real scalar   fh
    string scalar ln, s
    fh = fopen(path, "r")
    while ((ln = fget(fh)) != J(0, 0, "")) {
        s = strtrim(ln)
        if (s == "" | substr(s, 1, 1) == "(" | substr(s, 1, 5) == "name:" | substr(s, 1, 4) == "log:" | substr(s, 1, 9) == "log type:" | substr(s, 1, 10) == "opened on:" | substr(s, 1, 10) == "closed on:") continue
        fclose(fh)
        return(s)
    }
    fclose(fh)
    return("")
}
end
local two "scatter mpg turn weight,"

// PS-01 _dash_stylelist_locals
mata: _dash_stylelist_locals("make " + _sl_q("") + " rep78 ..", "_p")
local ok = ("`_pn'" == "4" & "`_pt1'" == "make" & "`_pq1'" == "0" & "`_pt2'" == "" & "`_pq2'" == "1" & "`_pt3'" == "rep78" & "`_pt4'" == "..")
mata: _dash_stylelist_locals(_sl_q("make") + " " + _sl_cq("rep78"), "_p")
local ok = `ok' & "`_pq1'`_pq2'" == "11" & "`_pt1'`_pt2'" == "makerep78"
mata: _dash_stylelist_locals("", "_p")
local ok = `ok' & "`_pn'" == "0"
mata: _dash_stylelist_locals(char(36) + "G a" + char(96) + "b", "_p")
mata: st_local("_o", strofreal(st_local("_pt1") == char(36) + "G" & st_local("_pt2") == "a" + char(96) + "b"))
local ok = `ok' & `_o'
timer clear 98
timer on 98
mata: _dash_stylelist_locals(5000 * "make ", "_p")
timer off 98
quietly timer list 98
local ok = `ok' & "`_pn'" == "5000" & r(t98) < 5
_ps_tally PS-01 `ok' "_dash_stylelist_locals: elements, quoted flags, by value, linear"

// PS-02 one label variable per series, each exported
capture noisily dash `two' mlabel(make rep78) name(ps02)
mata: _dash_extract_vars(st_global("dash_json_ps02"), "_pv")
local ok = (!_rc & `: list posof "make" in _pv' & `: list posof "rep78" in _pv')
mata: st_local("_o", strofreal(_sl_spec("ps02", "{'mlabel':'make'}|{'mlabel':'rep78'}")))
_ps_tally PS-02 `=`ok' & `_o'' "mlabel(make rep78) labels each y with its own variable"

// PS-03 padding, shorthands, abbreviations, quotes, extras, repeats
local ok 1
local i 0
foreach c in `"mlabel(make)|{'mlabel':'make'}|{}"' `"mlabel(. rep78)|{}|{'mlabel':'rep78'}"' ///
    `"mlabel(make .)|{'mlabel':'make'}|{}"' `"mlabel(make "")|{'mlabel':'make'}|{}"' ///
    `"mlabel(make rep78 foreign)|{'mlabel':'make'}|{'mlabel':'rep78'}"' ///
    `"mlabel(mak rep7)|{'mlabel':'make'}|{'mlabel':'rep78'}"' `"mlabel(rep*)|{'mlabel':'rep78'}|{}"' ///
    `"mlabel("make" "rep78")|{'mlabel':'make'}|{'mlabel':'rep78'}"' ///
    `"mlabel(make) mlabel(rep78 foreign)|{'mlabel':'rep78'}|{'mlabel':'foreign'}"' {
    local ++i
    mata: _ps_p = strpos(st_local("c"), "|")
    mata: st_local("o", substr(st_local("c"), 1, _ps_p - 1)); st_local("w", substr(st_local("c"), _ps_p + 1, .))
    capture noisily dash `two' `macval(o)' name(ps03_`i')
    mata: st_local("_o", strofreal(_sl_spec("ps03_`i'", st_local("w"))))
    if _rc | !`_o' {
        display as error `"PS-03.`i': rc `=_rc' `macval(o)' :: ${dash_json_ps03_`i'}"'
        local ok 0
    }
}
mata: _dash_extract_vars(st_global("dash_json_ps03_5"), "_pv")
if `: list posof "foreign" in _pv' local ok 0
_ps_tally PS-03 `ok' "a short list is padded with ., extras ignored, shorthands and quotes read"

// PS-04 a single-y type takes the first element
capture noisily dash scatter mpg weight, mlabel(make foreign) name(ps04a)
capture noisily dash rscatter mpg turn weight, mlabel(make rep78) name(ps04b)
mata: st_local("ok", strofreal(_sl_spec("ps04a", "{'mlabel':'make'}") & _sl_spec("ps04b", "{'mlabel':'make'}")))
_ps_tally PS-04 `ok' "a single-y type labels with the first element"

// PS-05 mlabel shorthands refused in twoway's words
local ok 1
_ps_refuse PS-05 198 ".. not allowed in option mlabel()" |`two' mlabel(make ..)
_ps_refuse PS-05 198 "... not allowed in option mlabel()" |`two' mlabel(make ...)
_ps_refuse PS-05 198 ".. not allowed in option mlabel()" |`two' mlabel(make .. rep78)
_ps_refuse PS-05 101 "=exp not allowed" |`two' mlabel(make =)
_ps_refuse PS-05 101 "=exp not allowed" |`two' mlabel(= make)
