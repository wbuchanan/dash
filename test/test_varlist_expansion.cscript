// as twoway refuses it; recast, yaxis and sort still stand for the rest.
capture noisily dash scatter mpg turn weight, recast(line) yaxis(2) sort name(sl22)
mata: _sl22 = st_global("dash_json_sl22"); _sl22rc = char(34) + "type" + char(34) + ":" + char(34) + "line" + char(34) + "," + ///
    char(34) + "recast_from" + char(34) + ":" + char(34) + "scatter" + char(34)
mata: st_local("ok", strofreal(_sl_opts(_sl22, 1) == _sl_opts(_sl22, 2) & ///
    !strpos(_sl_opts(_sl22, 1), "recast") & ///
    (strlen(_sl22) - strlen(subinstr(_sl22, _sl22rc, ""))) / strlen(_sl22rc) == 2 & ///
    strpos(_sl_opts(_sl22, 1), "yaxis") & strpos(_sl_opts(_sl22, 1), "sort")))
_sl_tally SL-22 `ok' "recast, yaxis and sort stay one value on every y"

