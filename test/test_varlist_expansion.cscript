_ps_refuse PS-05 102 "too few variables specified" |`two' mlabel(.)
_ps_refuse PS-05 102 "too few variables specified" |`two' mlabel(. ..)
_ps_tally PS-05 `ok' "mlabel's .., ..., = and no-variable lists refused as twoway refuses them"

// PS-06 every mlabel variable is checked, in twoway's order
local ok 1
_ps_refuse PS-06 111 "*variable nosuch not found" |`two' mlabel(make rep78 nosuch)
_ps_refuse PS-06 111 "*variable nosuch not found" |scatter mpg weight, mlabel(rep78 nosuch)
_ps_refuse PS-06 111 "*variable nosuch not found" |`two' mlabel(nosuch ..)
_ps_refuse PS-06 111 "*variable nosuch not found" |`two' mlabel(make .. nosuch)
_ps_refuse PS-06 111 "*variable nosuch not found" |`two' mlabel(nosuch =)
_ps_refuse PS-06 101 "=exp not allowed" |`two' mlabel(= nosuch)
// Flipped (WP-31 C10b): mlabel(t*) is expanded as twoway expands it
// (U06-02); a pattern naming nothing is twoway's r(111).
_ps_refuse PS-06 111 "*variable zz* not found" |`two' mlabel(zz*)
// Flipped (WP-35 basic:PT-9): r(198) ".. not allowed" was wrong; twoway
// reads make.. as an operator, r(101) (value_codes_truth.json mlabel_dotdot).
_ps_refuse PS-06 101 "factor-variable and time-series operators not allowed" |`two' mlabel(make..)
_ps_tally PS-06 `ok' "every mlabel variable is checked, past the last y too, before .."

// PS-07 by plot type
local ok 1
_ps_refuse PS-07 198 ".. not allowed in option mlabel()" |histogram mpg, mlabel(nosuch ..)
_ps_refuse PS-07 198 "invalid syntax" |histogram mpg, mlabel(= make)
_ps_refuse PS-07 198 ".. not allowed in option mlabel()" |function y=x, mlabel(make ..)
_ps_refuse PS-07 103 "" |mspline mpg weight, mlabel(make rep78)
_ps_refuse PS-07 103 "" |mspline mpg weight, mlabel(. make)
_ps_refuse PS-07 198 ".. not allowed in option mlabel()" |mspline mpg weight, mlabel(make ..)
_ps_refuse PS-07 111 "*variable nosuch not found" |mband mpg weight, mlabel(nosuch rep78)
capture noisily dash histogram mpg, mlabel(nosuch) name(ps07a)
if _rc | strpos(`"${dash_json_ps07a}"', "mlabel") local ok 0
capture noisily dash function y=x, mlabel(nosuch =) name(ps07b)
