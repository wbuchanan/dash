    _dash_stylelist_blank("red " + _sl_q(" "), 2) == 2 & ///
    _dash_stylelist_blank("red blue " + _sl_q(" "), 2) == 0 & ///
    _dash_stylelist_blank(_sl_q(" ") + " blue", 0) == 1 & ///
    _dash_stylelist_blank(_sl_q(" ") + " blue", .) == 1 & ///
    _dash_stylelist_blank(_sl_q("") + " blue", 2) == 0 & ///
    _dash_stylelist_blank("red " + _sl_cq(""), 2) == 0 & ///
    _dash_stylelist_blank("red blue", 2) == 0 & ///
    _dash_stylelist_blank(_sl_q(".") + " blue", 2) == 0 & ///
    _dash_stylelist_blank(_sl_q("..") + " blue", 2) == 0 & ///
    _dash_stylelist_blank(_sl_q("hsv 240 1 1") + " red", 2) == 0 & ///
