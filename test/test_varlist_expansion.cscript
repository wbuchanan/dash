// SL-24 a used blank quoted element is refused (Q-11.1, ratified 06oct2026)
local ok 1
local b1 `"scatter mpg turn weight, mcolor(" " blue)"'
local y1 `"dash: mcolor() element 1 is blank; use . for the default (got: " " blue)"'
local b2 `"scatter mpg turn trunk weight, mcolor(red " " blue)"'
local y2 `"dash: mcolor() element 2 is blank; use . for the default (got: red " " blue)"'
local b3 `"scatter mpg turn weight, mcolor(`" "' blue)"'
local y3 `"dash: mcolor() element 1 is blank; use . for the default (got: `" "' blue)"'
local b4 `"scatter mpg turn trunk weight, mcolor(red "   " blue)"'
local y4 `"dash: mcolor() element 2 is blank; use . for the default (got: red "   " blue)"'
local b5 `"scatter mpg turn weight, msymbol("   " T)"'
local y5 `"dash: msymbol() element 1 is blank; use . for the default (got: "   " T)"'
local b6 `"scatter mpg turn weight, mc(red " ")"'
local y6 `"dash: mcolor() element 2 is blank; use . for the default (got: red " ")"'
local b7 `"scatter mpg weight, mcolor(" ")"'
local y7 `"dash: mcolor() element 1 is blank; use . for the default (got: " ")"'
local b8 `"scatter mpg turn weight, mcolor(" " .. blue)"'
local y8 `"mcolor(" " .. blue):  invalid syntax"'
// Flipped (WP-45 ST-22): twoway's line now comes first (dash's words
// alone were wrong because twoway names the option's class path, test/
// fixtures/colour_edges_truth.json B_*); dash's line, still checked
// above, follows it.  _sl_tw_first: twoway's line is the log's first
// error line and precedes the dash: line.
local tw_m "option(s) marker(fillcolor(@)  linestyle(color(@))) not allowed"
local tw_s "option(s) marker(symbol(@)) not allowed"
forvalues i = 1/8 {
    _sl_run dash `macval(b`i')' name(sl24_`i'), log(`sl_log')
    mata: st_local("_o", strofreal(st_global("sl_line") == st_local("y`i'") & st_global("dash_json_sl24_`i'") == ""))
    if `i' < 8 {
        local tw = cond(`i' == 5, "`tw_s'", "`tw_m'")
        mata: st_local("_o", strofreal(`_o' & _sl_tw_first(st_local("sl_log"), subinstr(st_local("tw"), "@", char(96) + char(39)))))
    }
    if $sl_rc != 198 | !`_o' {
        display as error `"SL-24.`i': rc $sl_rc, line: $sl_line"'
        local ok 0
    }
}
