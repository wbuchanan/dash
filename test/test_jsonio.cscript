*! test_jsonio.cscript
*! Certification script for jsonio integration with dash.
*!
*! Tests: P1B-57 through P1B-65
*!
*! Usage:  do test/test_jsonio.cscript
*!
*! Requires: jsonio installed (run dash_setup first)
*! Version: 1.0.0  25mar2026

cscript "jsonio integration" adodir ".."

// ----------------------------------------------------------------
// Setup
// ----------------------------------------------------------------
capture which jsonio
if _rc != 0 {
    display as error "SKIP: jsonio not installed. Run dash_setup first."
    exit 0
}

qui sysuse auto, clear

// ================================================================
// P1B-59 — jsonio out if foreign==1 → JSON has only matching records
// ================================================================

// Count domestic obs in Stata
quietly count if foreign == 0
local n_domestic = r(N)
quietly count if foreign == 1
local n_foreign  = r(N)
local n_total    = `n_domestic' + `n_foreign'

// Serialize foreign==1 subset
tempfile jout_foreign
quietly jsonio out mpg weight foreign if foreign == 1, ///
    what(all) filenm("`jout_foreign'") ///
    metaprint(varnames varlabels vallabs labelnames)

// Read the JSON back and parse the values array length
// We do this by counting occurrences of "mpg" in the values array.
// jsonio produces one object per observation in the values array.
tempname fh
file open `fh' using "`jout_foreign'", read text
local json_content ""
local line ""
file read `fh' line
while r(eof) == 0 {
    local json_content = `"`json_content'`line'"'
    file read `fh' line
}
file close `fh'

// Extract record count from jsonio's "numberOfRecords" metadata field.
// jsonio formats JSON as "key" : value (with spaces around colon).
local nr_pos = strpos(`"`json_content'"', "numberOfRecords")
local obs_count = 0
if `nr_pos' > 0 {
    local nr_snippet = substr(`"`json_content'"', `nr_pos' + 15, 20)
    if regexm(`"`nr_snippet'"', "([0-9]+)") {
        local obs_count = real(regexs(1))
    }
}
assert `obs_count' == `n_foreign'
display "P1B-59 PASS: if foreign==1 → `obs_count' records (expected `n_foreign')"

// ================================================================
// P1B-60 — jsonio out in 1/10 → JSON has exactly 10 records
// ================================================================
tempfile jout_10
quietly jsonio out mpg weight in 1/10, ///
    what(all) filenm("`jout_10'") ///
    metaprint(varnames varlabels vallabs labelnames)

tempname fh2
file open `fh2' using "`jout_10'", read text
local json10 ""
local line ""
file read `fh2' line
while r(eof) == 0 {
    local json10 = `"`json10'`line'"'
    file read `fh2' line
}
file close `fh2'

// Extract record count from numberOfRecords field
local nr_pos10 = strpos(`"`json10'"', "numberOfRecords")
local obs10 = 0
if `nr_pos10' > 0 {
    local nr_snippet10 = substr(`"`json10'"', `nr_pos10' + 15, 20)
    if regexm(`"`nr_snippet10'"', "([0-9]+)") {
        local obs10 = real(regexs(1))
    }
}
assert `obs10' == 10
display "P1B-60 PASS: in 1/10 → `obs10' records"

// ================================================================
// P1B-61 — what(all) metaprint produces variableNames array
// ================================================================
tempfile jout_full
quietly jsonio out mpg weight foreign, ///
    what(all) filenm("`jout_full'") ///
    metaprint(varnames varlabels vallabs labelnames)

tempname fh3
file open `fh3' using "`jout_full'", read text
local jfull ""
local line ""
file read `fh3' line
while r(eof) == 0 {
    local jfull = `"`jfull'`line'"'
    file read `fh3' line
}
file close `fh3'

// Check for variableNames key in JSON
assert strpos(`"`jfull'"', "variableNames") > 0
display "P1B-61 PASS: JSON contains variableNames array"

// ================================================================
// P1B-62 — variableLabels present with at least one label
// ================================================================
assert strpos(`"`jfull'"', "variableLabels") > 0
// mpg has label "Mileage (mpg)" in auto.dta
assert strpos(`"`jfull'"', "Mileage") > 0
display "P1B-62 PASS: variableLabels present with label for mpg"

// ================================================================
// P1B-63 — valueLabels object present (foreign → Domestic/Foreign)
// ================================================================
assert strpos(`"`jfull'"', "valueLabels") > 0
assert strpos(`"`jfull'"', "Domestic") > 0 | strpos(`"`jfull'"', "Foreign") > 0
display "P1B-63 PASS: valueLabels present with Domestic/Foreign labels"

// ================================================================
// P1B-64 — values array length matches observation count
// ================================================================
// Total obs in auto.dta = 74
quietly count
local total_obs = r(N)

// Extract record count from numberOfRecords field
local nr_pos_f = strpos(`"`jfull'"', "numberOfRecords")
local obs_total = 0
if `nr_pos_f' > 0 {
    local nr_snippet_f = substr(`"`jfull'"', `nr_pos_f' + 15, 20)
    if regexm(`"`nr_snippet_f'"', "([0-9]+)") {
        local obs_total = real(regexs(1))
    }
}
assert `obs_total' == `total_obs'
display "P1B-64 PASS: values array has `obs_total' records (matches N=`total_obs')"

// ================================================================
// P1B-65 — Stata missing values handled — no crash or malformed JSON
// ================================================================
// rep78 has missing values in auto.dta
tempfile jout_rep78
capture quietly jsonio out mpg rep78, ///
    what(all) filenm("`jout_rep78'") ///
    metaprint(varnames varlabels vallabs labelnames)
// jsonio should handle missing values without crashing
assert _rc == 0
// File should exist and be non-empty
capture confirm file "`jout_rep78'"
assert _rc == 0
display "P1B-65 PASS: missing values (rep78) handled without crash"

display ""
display "All jsonio integration tests PASSED."
