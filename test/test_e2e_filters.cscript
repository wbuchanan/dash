*! test_e2e_filters.cscript
*! End-to-end certification script for filter widgets in dashboard output.
*!
*! Tests: P2-73 through P2-75, FL-EX-1, FL-CP-1, FL-QT-1, FL-QT-2 and
*! HE-01 through HE-04
*!
*! Usage:  do test/test_e2e_filters.cscript
*!
*! Requires: dash_setup completed, Python + bokeh installed
*! Version: 1.0.0  25mar2026

cscript "dash filter widget E2E" adodir ".."

// ----------------------------------------------------------------
// Setup
// ----------------------------------------------------------------

// Do NOT probe with `capture python: pass'.  Measured: that returns a
// nonzero rc inside the runner even though the very same session renders
// Bokeh output through `dash build' moments later, and it made 9 of the 14
// scripts -- every end-to-end one -- skip while the suite reported ALL TESTS
// PASSED.  c(python_exec) is set by Stata's own Python configuration and
// reads without executing anything, so it cannot fail for reasons unrelated
// to Python being present.
if "`c(python_exec)'" == "" {
    display as error "SKIP: Python not available."
    exit 222
}

qui sysuse auto, clear

do "../dash_parse.mata"
do "../dash.ado"

// cert_file_has: asks whether a generated file contains a string, from Mata,
// where the file's text is a value rather than macro text.  The scans below
// used to expand each line of Bokeh output into a Stata expression, which a
// quote character in that line ends.  The runner runs each script from this
// directory, so this path is bare while the dash sources above are "../".
do "cert_helpers.do"

// ================================================================
// P2-73 — dash build with filter(foreign, type(dropdown)) → HTML contains Select widget
// ================================================================
dash clear

dash scatter mpg weight, name(s1) title("MPG vs Weight")
dash scatter price mpg,  name(s2) title("Price vs MPG")

tempfile outfile
local outpath = "`outfile'.html"
capture erase "`outpath'"

dash build, saving("`outpath'") ///
    filter(foreign, type(dropdown)) ///
    replace

capture confirm file "`outpath'"
assert _rc == 0

// Search HTML for Bokeh Select widget indicator.
//
// This replaces a loop that read the file line by line and tested each line
// with strpos(lower(`"`ln'"'), ...).  A line of Bokeh's document JSON is
// dense with " characters, and a sequence such as "' inside one terminates
// the compound quotes the macro is expanded in; the rest of the line is then
// parsed as Stata code, and measured, this search died with r(133),
// "unknown function ()".  cert_file_has asks the same question from Mata,
// where the line is a value and can never be parsed.
//
// The loop's fourth needle, type.*select, was a regular expression handed to
// strpos, which searches for a literal substring; no HTML file contains
// those eleven characters, so that branch could not fire even before the
// quoting broke.  What it meant to ask is whether a Select MODEL appears in
// the document JSON, and the literal form of that question is a colon
// followed by the quoted name: Bokeh 3 serialises the widget as
// "name":"Select" and Bokeh 2 as "type":"Select", so :"select" matches
// either.  Measured on the dashboards in this repository: :"Select" occurs
// once in each file built with a dropdown filter and not at all in one built
// without.  The branch is repaired rather than dropped because it is the
// only one of the four that distinguishes a filter widget from the page it
// is embedded in -- bokeh.min.js registers the class as o("Select", ...) and
// sets __name__="Select", so the bare quoted name below is present in every
// Bokeh document whether or not a widget was built.
//
// And so the max() of the four could not fail.  Measured 24sep2026 on the
// page these two graphs build WITHOUT filter(): "select" in quotes, lower-
// cased, occurs 5 times -- all in the BokehJS the page inlines -- so
// found_select was 1 with no widget at all, while bk-select and
// select_widget occur on neither page.  The model is what is counted now,
// exactly: Bokeh 3 (dash.pkg requires 3.0 or later) writes each model once
// as "type":"object","name":"<Model>", and the one dropdown filter builds
// one Select -- "name":"Select" occurs once on this page and not at all on
// the page without the filter.
cert_file_count "`outpath'", needle(`""name":"Select""')
assert r(count) == 1
display "P2-73 PASS: HTML contains Bokeh Select widget for foreign filter"

// ================================================================
// P2-74 — "Domestic" and "Foreign" value labels appear in filter options
// ================================================================
// The same substitution: the loop that scanned for these two labels expanded
// every line of the file into a strpos() expression, and a quote character in
// the data ends that expression.  The search stays case-sensitive, as the
// loop's was -- the value labels are capitalised in the option list.
cert_file_has "`outpath'", needle("Domestic")
local found_domestic = r(found)
cert_file_has "`outpath'", needle("Foreign")
local found_foreign  = r(found)
assert `found_domestic' == 1
assert `found_foreign'  == 1
display "P2-74 PASS: value labels 'Domestic' and 'Foreign' in filter widget HTML"

// ================================================================
// P2-75 — "All" option present in filter widget HTML
// ================================================================
// The same substitution.  "All" is the label Bokeh writes for the sentinel
// option the dropdown opens on, and it appears as an option value or label
// in the Select widget JSON.  The loop OR'd a quoted needle with a bare one,
// and the bare one decided the verdict alone: measured 24sep2026, All
// occurs 17 times in the inlined BokehJS of the page built without a filter
// (23 in that page), so the OR was 1 on any dashboard.  The two are asserted
// separately now.  The quoted "All" occurs once on this page and not at all
// on the page without the filter.  And the option itself: the Select's
// options open with the pair [sentinel, label], ["__all__","All"] -- the
// value the dropdown opens on, then the text it shows -- once on this page
// and nowhere on the page without.
cert_file_has "`outpath'", needle(`""All""')
assert r(found) == 1
cert_file_count "`outpath'", needle(`"["__all__","All"]"')
assert r(count) == 1
display "P2-75 PASS: 'All' option present in filter widget HTML"

// ================================================================
// FL-EX-1 — exclude() is validated on EVERY filter group, not the first
// ================================================================
// This was covered only by a Python re-implementation of the Stata
// validation loop in test/test_server.py, which meant reverting the loop to
// its original single-group form left the tests green.  It is asserted here,
// against the real command.
dash clear
sysuse auto, clear
dash scatter mpg weight, name(gA)

tempfile exfile
capture dash build, saving("`exfile'.html") replace ///
    filter(weight, type(range) exclude(gA)) ///
    filter(mpg, type(range) exclude(nosuchgraph))
assert _rc == 198
display "FL-EX-1 PASS: an unknown exclude() name in the SECOND group is rejected"

// The control: the same command with both names known must succeed, or the
// assertion above would pass on any error at all.
capture dash build, saving("`exfile'2.html") replace ///
    filter(weight, type(range) exclude(gA)) ///
    filter(mpg, type(range) exclude(gA))
assert _rc == 0
display "FL-EX-1 PASS: both groups naming a real graph is accepted"

// ================================================================
// FL-CP-1 — filter() is extracted when it follows the comma directly
// ================================================================
// `dash build,filter(...)' with no space after the comma.  The Mata
// extractor's word-boundary check is what makes this work, and it too was
// covered only by a Python simulation.
dash clear
sysuse auto, clear
dash scatter mpg weight, name(gB)

tempfile cpfile
capture dash build,saving("`cpfile'.html") replace filter(foreign, type(dropdown))
assert _rc == 0
// This searched for Select, which occurs 143 times in this graph's page
// built with no filter at all (measured 24sep2026: 140 in the inlined
// BokehJS, 3 in the names of BoxSelectTool, LassoSelectTool and Selection),
// so it found the library and the toolbar, not the widget.  The model is
// counted, as at P2-73.
cert_file_count "`cpfile'.html", needle(`""name":"Select""')
assert r(count) == 1
// The command above puts saving() after the comma and filter() after a
// blank, `replace filter(', so the boundary this case is named for is not
// the one it reads: measured 24sep2026, with the comma taken out of
// _dash_extract_filters' boundary test it still built its widget.  Here
// filter() is the first thing after the comma.
tempfile cpfile2
capture dash build,filter(foreign, type(dropdown)) saving("`cpfile2'.html") replace
assert _rc == 0
cert_file_count "`cpfile2'.html", needle(`""name":"Select""')
assert r(count) == 1
display "FL-CP-1 PASS: filter() directly after the comma builds its widget"

// ================================================================
// FL-QT-1..2 -- filter( inside a quoted title is the title's text
// ================================================================
// ROADMAP WP-01 AC-01.2: `dash build, title("Q1 filter(foreign) report")'
// renders the title as written and creates no filter widget.  Measured
// before 9c7dbf7: rc 0, the title drawn as "Q1 report" and a live
// dropdown on foreign that nobody asked for.  test_parser_integrity.cscript
// P1B-20 and P1B-33 hold the extractor itself; these hold the command, so
// a regression anywhere between the extractor and the page shows.  WP-24
// measured them against 9c7dbf7's extractor change put back in a copy of
// the tree: every check below failed there, and passed here.
dash clear
sysuse auto, clear
dash scatter mpg weight, name(gQ)

// FL-QT-1: the title of AC-01.2, word for word.
tempfile qtfile
capture erase "`qtfile'.html"
capture noisily dash build, saving("`qtfile'.html") replace nobrowser ///
    title("Q1 filter(foreign) report")
assert _rc == 0
cert_file_has "`qtfile'.html", needle("Q1 filter(foreign) report")
assert r(found) == 1
// A widget is looked for as a MODEL, a colon and its quoted name, as P2-73
// looks for it: Bokeh's own script, inlined in every page, spells both
// class names bare (measured: "RangeSlider" is in a page with no filter).
cert_file_has "`qtfile'.html", needle(`":"select""') lower
assert r(found) == 0
cert_file_has "`qtfile'.html", needle(`":"rangeslider""') lower
assert r(found) == 0
display "FL-QT-1 PASS: the title Q1 filter(foreign) report is drawn as written, with no filter widget"

// FL-QT-2: a ')' in the quote before the word, which closes title( for any
// scan that does not track the quote.
tempfile qtfile2
capture erase "`qtfile2'.html"
capture noisily dash build, saving("`qtfile2'.html") replace nobrowser ///
    title("Q1 ) filter(foreign) report")
assert _rc == 0
cert_file_has "`qtfile2'.html", needle("Q1 ) filter(foreign) report")
assert r(found) == 1
cert_file_has "`qtfile2'.html", needle(`":"select""') lower
assert r(found) == 0
display "FL-QT-2 PASS: a quoted ')' before filter( in the title is text too"

// ---- WP-28 C2: histogram edge rule (HE-01..HE-04) ----
// A continuous histogram used to drop the observation at its last bin
// edge (2245 of 2246 rows on nlsw88 ttl_exp bin(27)) and accept a
// tolerated start() while still dropping the rows below it.  These cases
// build the real dashboard and read the drawn bars back out of its own
// embedded document -- the one Bokeh document a saved page's
// <script type="application/json"> block holds, reconstructed the way
// test_e2e_kpi.cscript and test_adversarial.cscript P2-78 already read
// one back -- rather than trust a byte count in the file.
dash clear
sysuse nlsw88, clear

python:
import json, re
from sfi import Macro
from bokeh.document import Document
from bokeh.models import ColumnDataSource


def _he_unescape(text):
    ents = {"amp": "&", "lt": "<", "gt": ">", "quot": chr(34),
            "#x27": chr(39), "#x60": chr(96)}
    return re.sub(r"&(amp|lt|gt|quot|#x27|#x60);",
                  lambda m: ents[m.group(1)], text)


def _he_read(path, p):
    """Set `p'_sum and `p'_nbar from the one histogram quad's source in
    the page at *path*: the sum of its bars and how many there are."""
    with open(path, encoding="utf-8") as fh:
        page = fh.read()
    blocks = re.findall(
        r'<script type="application/json" id="[^"]+">\s*(.*?)\s*</script>',
        page, re.S)
    docs = [d for b in blocks
            for d in json.loads(_he_unescape(b)).values()]
    if len(docs) != 1:
        raise RuntimeError("%s holds %d Bokeh documents" % (path, len(docs)))
    doc = Document.from_json(docs[0])
    tops = None
    for m in doc.models:
        if isinstance(m, ColumnDataSource) and "left" in m.data:
            tops = list(m.data["top"])
            break
    if tops is None:
        raise RuntimeError("%s: no histogram source found" % path)
    Macro.setGlobal(p + "_sum", str(int(round(sum(float(v) for v in tops)))))
    Macro.setGlobal(p + "_nbar", str(len(tops)))
end

// HE-01 -- bin(27): the exact case GAPS2 measured at 2245 of 2246.
tempfile he1
local he1path = "`he1'.html"
capture erase "`he1path'"
capture noisily dash histogram ttl_exp, bin(27) frequency saving("`he1path'", replace)
assert _rc == 0
cert_file_has "`he1path'", needle("top")
assert r(found) == 1
python: _he_read(Macro.getLocal("he1path"), "he1")
assert ${he1_sum} == 2246
assert ${he1_nbar} == 27
display "HE-01 PASS: dash histogram ttl_exp, bin(27) frequency counts all 2246 rows over 27 bars"

// HE-02 -- bin(83): the widest of GAPS2's four measured bin counts.
dash clear
tempfile he2
local he2path = "`he2'.html"
capture erase "`he2path'"
capture noisily dash histogram ttl_exp, bin(83) frequency saving("`he2path'", replace)
assert _rc == 0
cert_file_has "`he2path'", needle("top")
assert r(found) == 1
python: _he_read(Macro.getLocal("he2path"), "he2")
assert ${he2_sum} == 2246
assert ${he2_nbar} == 83
display "HE-02 PASS: dash histogram ttl_exp, bin(83) frequency counts all 2246 rows over 83 bars"

// HE-03 -- a start() dash.ado tolerates (reldif < 1e-5 above the
// minimum): every row still counts, the ones below start() folded into
// bar 0.
dash clear
quietly summarize ttl_exp, meanonly
local s = r(min)*(1+5e-6)
tempfile he3
local he3path = "`he3'.html"
capture erase "`he3path'"
capture noisily dash histogram ttl_exp, bin(27) frequency start(`s') saving("`he3path'", replace)
assert _rc == 0
cert_file_has "`he3path'", needle("top")
assert r(found) == 1
python: _he_read(Macro.getLocal("he3path"), "he3")
assert ${he3_sum} == 2246
assert ${he3_nbar} == 27
display "HE-03 PASS: start() tolerated within reldif 1e-5 of the minimum still counts all 2246 rows"

// HE-04 -- a start() above that tolerance is refused with twoway's own
// words (dash.ado:3827-3837, untouched by this section).
dash clear
quietly summarize ttl_exp, meanonly
local s2 = r(min)*1.01
tempfile he4log
local he4logpath = "`he4log'.log"
capture log close _all
capture log using "`he4logpath'", replace text
capture noisily dash histogram ttl_exp, bin(27) frequency start(`s2')
local he4rc = _rc
capture log close _all
assert `he4rc' == 198
cert_log_has "`he4logpath'", needle("option start() may not be larger than minimum of ttl_exp")
assert r(found) == 1
display "HE-04 PASS: start() above the minimum by more than reldif 1e-5 is refused with twoway's own words"

sysuse auto, clear

// ----------------------------------------------------------------
// Cleanup
// ----------------------------------------------------------------
dash clear

display ""
display "All filter widget E2E tests PASSED."
