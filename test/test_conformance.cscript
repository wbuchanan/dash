*! test_conformance.cscript
*! The drop-in claim, proved by RENDERING rather than by parsing.
*!
*! Usage:  do test/test_conformance.cscript
*! Version: 1.0.1  08oct2026
*!
*! WHY THIS EXISTS
*!
*! dash.sthlp says a twoway command copied into dash runs.  The 299-command
*! corpus in test_option_surface.cscript checks that claim at the -syntax-
*! layer and no further: _dsp_probe appends name() to every probe, which
*! registers the specification and never renders it.  A command can be
*! accepted with rc 0 and then draw nothing, and that corpus is structurally
*! incapable of noticing -- which is exactly what `pci' and `pcscatter' did,
*! for as long as the package has existed, without one test failing.
*!
*! So this script registers a corpus covering every plot type dash draws --
*! exactly the renderer's own list, _dash_plot_type_names() -- and every
*! option family, then renders all of it in ONE `dash build', and asserts
*! three things:
*!
*!   1. no command is rejected          -- rc 0 on every registration
*!   2. no graph is silently dropped    -- the saved page holds one grid
*!                                         cell per registered name, in
*!                                         registry order, each a figure
*!   3. no layer silently draws nothing -- in the saved page every corpus
*!                                         figure draws, per layer its spec
*!                                         holds, a visible glyph with a
*!                                         finite value; and the renderer's
*!                                         own per-layer report names none
*!
*! 2 and 3 are read off what was DRAWN -- the page's Bokeh document, against
*! each graph's spec in the registry -- not off a message.  C-03 used to pass
*! when the build log held no line containing "drew nothing", so a reworded
*! report, or one that Stata's log wrapping split (a Python warning starts
*! with the path to dash_render.py, so where it wraps depends on where the
*! checkout lives), passed whatever was drawn (GAPS.md L6).  The report is
*! still read, as a second witness, and two control layers that draw
*! nothing -- one for each form the report takes -- are rendered in the same
*! build, so its wording and its way into the log are proved on every run:
*! a reworded report fails a control rather than passing the corpus.  C-00
*! holds the readers themselves to what they claim.
*!
*! One build renders the whole corpus, so the cost is one Python invocation
*! rather than one per command.
*!
*! lowess was deliberately absent while it needed the OPTIONAL statsmodels
*! package (a machine without it drew the layer empty, on purpose).  Since
*! WP-18 it is Stata's own smoother in numpy, needs nothing, and is in the
*! corpus with its sub-options; so are WP-18's other additions -- discrete,
*! stdf/stdr, mspline's bands()/n() and two weighted layers -- so each is
*! rendered end to end, not only registered.
*!
*! Fixtures:
*!   test/fixtures/conformance_corpus.txt   the corpus C-01 registers and
*!                                          C-02..C-04 render
*!   test/fixtures/help_examples.txt        every plot example dash.sthlp
*!                                          prints, one per line, with the
*!                                          name()/saving() stripped; C-05
*!                                          registers each and requires it to
*!                                          parse clean -- rc 0 and nothing
*!                                          named in the unsupported-option
*!                                          note (WP-15, the F5 baseline made
*!                                          mechanical)

cscript "dash conformance: the corpus renders" adodir ".."
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}

adopath ++ ".."


global dash_nobrowser 1

capture program drop cert_file_has
quietly do "cert_helpers.do"

// ----------------------------------------------------------------
// C-00 -- the readers every verdict below rests on.
// ----------------------------------------------------------------
// C-03..C-05 judge a log and the saved page by searching them, so the
// searches (cert_helpers.do) are held to what they claim first, on files
// whose contents are known:
//   * cert_file_has finds a needle that straddles the 32,768-character
//     pieces fget() reads a long line in -- a saved dashboard's lines run
//     to ~100,000 characters -- and cert_file_count counts every copy;
//   * cert_log_has finds a message that Stata's own log wrapping broke
//     mid-word, in a log Stata wrote, where a search of the raw lines does
//     not, and counts logical lines, not physical ones;
//   * each reports a file it cannot open as r(603), never as "absent".
tempfile c0a c0b
mata:
_c0 = fopen(st_local("c0a"), "w")
fput(_c0, ("a" * 32765) + "NEEDLE" + ("b" * 40000) + "NEEDLE" + ("c" * 30000) + "NEEDLE")
fclose(_c0)
_c0 = fopen(st_local("c0b"), "w")
fput(_c0, ("a" * 32765) + "NEEDLE" + ("b" * 100))
fclose(_c0)
mata drop _c0
end
// c0b's one NEEDLE sits at 32,766..32,771: across the first piece's end.
cert_file_has "`c0b'", needle("NEEDLE")
assert r(found) == 1
cert_file_has "`c0b'", needle("needle") lower
assert r(found) == 1
cert_file_has "`c0b'", needle("NEEDLES")
assert r(found) == 0
cert_file_count "`c0a'", needle("NEEDLE")
assert r(count) == 3
cert_file_count "`c0b'", needle("NEEDLE")
assert r(count) == 1

// A log Stata wraps: at linesize 80 the message breaks inside "global".
// The command is spelled so that its echo never holds the needle whole.
local c0log "`c(tmpdir)'dash_cf_c00.log"
capture log close _c0log
quietly log using "`c0log'", text replace name(_c0log)
local c0ls = c(linesize)
set linesize 80
display ("x" * 70) + " Set glo" + "bal dash_max_by_groups to draw more."
display ("again: Set glo" + "bal dash_max_by_groups to draw more.")
set linesize `c0ls'
quietly log close _c0log
cert_file_has "`c0log'", needle("global dash_max_by_groups to draw more")
local c0raw = r(found)
cert_log_has "`c0log'", needle("global dash_max_by_groups to draw more")
assert r(found) == 1
assert r(count) == 2
cert_log_has "`c0log'", needle("GLOBAL DASH_MAX_BY_GROUPS") lower
assert r(count) == 2
cert_log_has "`c0log'", needle("dash_max_by_groups to draw less")
assert r(found) == 0 & r(count) == 0
// The first copy is wrapped, so a raw search finds only the second.  Were
// neither wrapped, the check above would not have tested the re-join.
mata: st_local("c0phys", strofreal(sum(strpos(cat(st_local("c0log")), "global dash_max_by_groups to draw more") :> 0)))
assert `c0raw' == 1 & `c0phys' == 1
capture erase "`c0log'"

// A file that cannot be opened is an error, not "absent".
local c0none "`c(tmpdir)'dash_cf_c00_no_such_file.txt"
capture erase "`c0none'"
foreach c0cmd in cert_file_has cert_log_has cert_file_count {
    capture `c0cmd' "`c0none'", needle("x")
    assert _rc == 603
}
display "C-00 PASS: the file, log and count readers find what the file holds, across fget's pieces and Stata's wrapping"

sysuse auto, clear
generate double lo   = mpg - 3
generate double hi   = mpg + 3
generate double w2   = weight + 250
generate double m2   = mpg + 4
generate int    t    = _n
tsset t

dash clear

local n_cmd  = 0
local n_bad  = 0
local n_badn = 0
local names  ""

// ----------------------------------------------------------------
// C-01 — register the corpus.
// ----------------------------------------------------------------
// The commands live in test/fixtures/conformance_corpus.txt, one per line,
// so they can be read and added to without touching this script.
//
// The line is expanded with `macval' straight into the command rather than
// through a helper program or a global: a global whose value is a command
// carrying commas and parentheses does not survive the round trip, and the
// loop fails to parse.
//
// A command with no options of its own needs a comma before name(); one
// that already has options needs only a space, or Stata reads name() as
// part of the varlist and answers r(101).
tempname fh
file open `fh' using "fixtures/conformance_corpus.txt", read text
file read `fh' line
while r(eof) == 0 {
    if `"`macval(line)'"' != "" {
        local ++n_cmd
        local id "c`n_cmd'"
        if strpos(`"`macval(line)'"', ",") == 0 {
            capture noisily dash `macval(line)', name(`id')
        }
        else {
            capture noisily dash `macval(line)' name(`id')
        }
        if _rc != 0 {
            local ++n_bad
            display as error `"C-01 REJECTED [`id'] rc=`=_rc': `macval(line)'"'
        }
        else {
            local names "`names' `id'"
        }
    }
    file read `fh' line
}
file close `fh'

// The controls: two layers dash accepts and draws nothing for, one in each
// form of the renderer's report (_dash_report_empty_layer, through the one
// rule both modes run, _dash_note_empty_layer):
//   ctl   a function layer whose stored points are not drawable -- a
//         registered `function y = x', its $dash_fpts_ctl then set by hand
//         to a points object with no y value, which passes the spec
//         writer's character check and is refused where it is drawn
//         (_dash_function_points) -- reported whatever the data:
//           dash: graph 'ctl' plot 1 (function) drew nothing: it needs
//           the points Stata computes for it when dash registers the
//           graph, and the points this spec carries for it cannot be read.
//         (WP-30 P1.22: the note says why; it was the bare "drew
//         nothing.", and the points cannot be read is that why.)
//         (It was normal(x), which the renderer's whitelist refused; WP-29
//         P0.6 has Stata evaluate every function layer, so normal(x) now
//         draws twoway's points, and an empty function layer is made from
//         its points instead.  Before that it was nosuchfunction(x), which
//         dash refuses at registration, r(133), as twoway does.)
//   ctl2  a line of a variable missing on every observation, which twoway
//         draws empty and silent (rc 0, measured 19oct2026), and dash too:
//         it draws nothing and is not reported.
//         Flipped: WP-32 -- it was a scatter, then a line, each reported
//         "drew nothing from 74 observations"; both are drawn in silence
//         now, as twoway draws them (BUGS.md "An all-missing scatter, a
//         constant-x lowess and a constant kdensity keep dash's "drew
//         nothing" note" and "An all-missing line, area, bar or other
//         plain layer says "drew nothing", where twoway draws it in
//         silence"), so the report's "from N observations" form is
//         certified by test_immediate_dashboards.py alone.
// C-03 requires these to be the only figures with nothing on them and the
// only layers reported: that proves, on every run, that the page check can
// see an empty figure and that each form of the report reaches this log in
// the words C-03 reads.
quietly generate double allmiss = .
capture noisily dash function y = x, range(0 10) name(ctl)
local ctl_rc = _rc
mata: st_global("dash_fpts_ctl", `"{"1":{"x0":0,"dx":1,"y":[]}}"')
capture noisily dash line allmiss weight, name(ctl2)
local ctl_rc = max(`ctl_rc', _rc)

// Every command was read: the loop ran once per line the fixture holds,
// counted here without it.  (It was held only to a floor of 55, so a loop
// that stopped early lost the rest of the corpus without a word.)
mata: st_local("c1_lines", strofreal(sum(cat("fixtures/conformance_corpus.txt") :!= "")))

display ""
display "C-01: `n_cmd' commands registered of `c1_lines' in the corpus, `n_bad' rejected"
assert `n_cmd' == `c1_lines'
assert `n_bad' == 0
assert `ctl_rc' == 0

// The corpus covers every plot type the renderer draws, and nothing else:
// the types in the registered specs against _dash_plot_type_names(), the
// list read off the dispatch tables both render modes use.
capture findfile dash_render.py
assert _rc == 0
local renderpy `"`r(fn)'"'
python:
import importlib.util
import json
from sfi import Macro
_c1s = importlib.util.spec_from_file_location("_dash_render_c01",
                                              Macro.getLocal("renderpy"))
_c1m = importlib.util.module_from_spec(_c1s)
_c1s.loader.exec_module(_c1m)
_c1drawn = set(_c1m._dash_plot_type_names())
_c1types = set()
for _c1n in Macro.getLocal("names").split():
    for _c1p in json.loads(Macro.getGlobal("dash_json_" + _c1n))["plots"]:
        _c1types.add(_c1p["type"])
Macro.setLocal("c1_missing", " ".join(sorted(_c1drawn - _c1types)))
Macro.setLocal("c1_extra", " ".join(sorted(_c1types - _c1drawn)))
Macro.setLocal("c1_ntypes", str(len(_c1drawn)))
del _c1s, _c1m
end
if "`c1_missing'`c1_extra'" != "" {
    display as error "C-01 FAIL: plot types dash draws that the corpus never renders: `c1_missing'"
    display as error "           types in the corpus the renderer does not list: `c1_extra'"
}
assert "`c1_missing'`c1_extra'" == ""
assert `c1_ntypes' > 0
display "C-01 PASS: all `n_cmd' corpus commands were accepted, covering all `c1_ntypes' plot types dash draws"

// ----------------------------------------------------------------
// C-02 — render the whole corpus in one build, capturing the log.
// ----------------------------------------------------------------
tempfile outhtml
tempfile buildlog
capture log close _cflog
quietly log using "`buildlog'", replace text name(_cflog)
capture noisily dash build, saving("`outhtml'.html") replace
local build_rc = _rc
capture quietly log close _cflog

assert `build_rc' == 0
display "C-02 PASS: the corpus rendered (rc 0)"

// ----------------------------------------------------------------
// C-03 and C-04 -- what the saved page draws.
// ----------------------------------------------------------------
// The page's one Bokeh document is read back with Bokeh.  Its layout is a
// grid with one cell per registered name, placed in registry order (no
// layout() is given), so each cell is matched to its graph's spec in the
// registry ($dash_json_<name>).  A cell is a figure, or a sub-grid of
// figures for a by() graph.  What a figure DRAWS is its visible glyph
// renderers whose data holds a finite value -- the legend swatches a
// colorvar() graph adds are invisible and are not counted, and a column of
// missing values draws nothing.
//
//   C-04: the grid has one cell per registered name, each a figure;
//   C-03: every corpus figure draws at least as many glyphs as its spec
//         has layers, and the controls' figures draw none.
local c3page "`outhtml'.html"
python:
import json
import math
import re
import numpy as np
from sfi import Macro
from bokeh.document import Document
from bokeh.models import GlyphRenderer, GridPlot, Plot


def _c3_finite(value):
    # How many finite numbers a column holds, looking inside nested lists
    # and arrays (a patch or multi-line glyph keeps one list per shape).
    n, stack = 0, [value]
    while stack:
        x = stack.pop()
        if x is None or isinstance(x, (str, bytes, bool)):
            continue
        if isinstance(x, np.ndarray):
            if x.dtype.kind in "fiu":
                n += int(np.isfinite(x.astype(float)).sum())
            elif x.dtype.kind == "O":
                stack.extend(x.tolist())
        elif isinstance(x, (list, tuple)):
            stack.extend(x)
        elif isinstance(x, (int, float)) and math.isfinite(x):
            n += 1
    return n


def _c3_drawn(fig):
    return sum(1 for r in fig.renderers
               if isinstance(r, GlyphRenderer) and r.visible
               and any(_c3_finite(c) for c in r.data_source.data.values()))


def _c3_grid(doc):
    # The dashboard's grid: the first GridPlot below the roots.
    todo = list(doc.roots)
    while todo:
        m = todo.pop(0)
        if isinstance(m, GridPlot):
            return m
        todo.extend(getattr(m, "children", None) or [])
    return None


with open(Macro.getLocal("c3page"), encoding="utf-8") as _c3fh:
    _c3html = _c3fh.read()
_c3blocks = re.findall(
    r'<script type="application/json" id="[^"]+">\s*(.*?)\s*</script>',
    _c3html, re.S)
_c3docs = [d for b in _c3blocks for d in json.loads(b).values()]
_c3grid = _c3_grid(Document.from_json(_c3docs[0])) if len(_c3docs) == 1 else None
_c3reg = Macro.getGlobal("dash_graph_registry").split()
_c3cells = ([c[0] for c in sorted(_c3grid.children, key=lambda c: (c[1], c[2]))]
            if _c3grid is not None else [])
_c4bad, _c3bad = [], []
if len(_c3docs) != 1 or _c3grid is None:
    _c4bad.append("the page holds %d Bokeh documents, and no grid was found "
                  "in the first" % len(_c3docs))
elif len(_c3cells) != len(_c3reg):
    _c4bad.append("%d grid cells for %d registered names"
                  % (len(_c3cells), len(_c3reg)))
for _c3name, _c3cell in zip(_c3reg, _c3cells):
    if isinstance(_c3cell, Plot):
        _c3figs = [_c3cell]
    elif isinstance(_c3cell, GridPlot):
        # WP-30 P1.15a: a by() grid's head and foot cells hold its
        # overall text, not a panel.  WP-30 P1.15c: nor do its title,
        # legend, colour-key and ruler cells; every such cell is dash_by_*.
        _c3figs = [c[0] for c in _c3cell.children if isinstance(c[0], Plot)
                   and not str(c[0].name or "").startswith("dash_by_")]
    else:
        _c3figs = []
    if not _c3figs:
        _c4bad.append("%s: its cell holds no figure (%s)"
                      % (_c3name, type(_c3cell).__name__))
        continue
    _c3layers = len(json.loads(Macro.getGlobal("dash_json_" + _c3name))["plots"])
    _c3counts = [_c3_drawn(f) for f in _c3figs]
    if _c3name in ("ctl", "ctl2"):
        if any(_c3counts):
            _c3bad.append("%s: the control drew %s, where it draws nothing"
                          % (_c3name, _c3counts))
    elif min(_c3counts) < _c3layers:
        _c3bad.append("%s: %d layer(s), glyphs drawn per figure %s"
                      % (_c3name, _c3layers, _c3counts))
for _c3line in _c4bad + _c3bad:
    print("C-03/C-04: " + _c3line)
Macro.setLocal("c4_ncells", str(len(_c3cells)))
Macro.setLocal("c4_nbad", str(len(_c4bad)))
Macro.setLocal("c3_nbad", str(len(_c3bad)))
del _c3html, _c3blocks, _c3docs, _c3grid, _c3cells
end
local n_reg : word count ${dash_graph_registry}
display "C-04: `c4_ncells' grid cells in the page for `n_reg' registered names"
assert `c4_nbad' == 0
assert `c4_ncells' == `n_reg' & `n_reg' == `n_cmd' + 2

// The renderer's own report of a graph dropped between the registry and the
// page, read as a second witness: none.  The words read are held to the
// line that emits them, so rewording the report fails here instead of
// passing unseen.
cert_file_has "`renderpy'", needle("registered graph(s) did not reach ")
assert r(found) == 1
cert_log_has "`buildlog'", needle("registered graph(s) did not reach")
assert r(count) == 0

// And the file is real, not an empty shell.
capture confirm file "`outhtml'.html"
assert _rc == 0
checksum "`outhtml'.html"
assert r(filelen) > 100000
display "C-04 PASS: all `n_reg' registered graphs reached the page, each as a figure in its own cell"

// C-03: what was drawn, then what the renderer said.  The report names an
// empty layer by graph, plot number and type, "(<type>) drew nothing" in
// its function form; ctl's must be the only one, in exactly its own words,
// and ctl2 is drawn in silence.
cert_log_has "`buildlog'", needle(") drew nothing")
local c3_nrep = r(count)
cert_log_has "`buildlog'", needle("dash: graph 'ctl' plot 1 (function) drew nothing: it needs the points Stata computes for it when dash registers the graph, and the points this spec carries for it cannot be read.")
local c3_nctl = r(count)
cert_log_has "`buildlog'", needle("'ctl2'")
local c3_nctl2 = r(count)
display "C-03: `c3_nbad' figure(s) drew less than they should; `c3_nrep' empty-layer report(s), `c3_nctl' + `c3_nctl2' of them the controls'"
if `c3_nbad' > 0 | `c3_nrep' != 1 | `c3_nctl' != 1 | `c3_nctl2' != 0 {
    display as error "C-03 FAIL: a corpus layer drew nothing, or a control was not seen; the build log:"
    type "`buildlog'"
}
assert `c3_nbad' == 0
assert `c3_nrep' == 1 & `c3_nctl' == 1 & `c3_nctl2' == 0
display "C-03 PASS: every corpus figure drew a glyph per layer; only the two controls drew nothing, the function reported and the all-missing line in silence"

// ----------------------------------------------------------------
// C-05 — every documented example parses clean.
// ----------------------------------------------------------------
// dash.sthlp's own examples live in test/fixtures/help_examples.txt, one
// per line with the name()/saving() stripped.  Each is registered under
// ONE captured log; every rc must be 0 and the log must hold no line of
// the note that names a dropped option -- a documented example has, by
// definition, nothing pending and nothing unknown.
//
// The ytitle2 example draws sales and margin against year; auto has none
// of those, so they are generated here rather than the example dropped.
//
// The comma rule of C-01 is applied to a comma OUTSIDE every parenthesis:
// the examples include paren-mode commands whose only comma belongs to a
// segment, and name() then still needs the graph-level comma.
quietly generate int    year   = 1970 + _n
quietly generate double sales  = price
quietly generate double margin = mpg

capture mata: mata drop _cf_toplevel_comma()
mata:
real scalar _cf_toplevel_comma(string scalar s)
{
    real scalar   i, depth
    string scalar c
    depth = 0
    for (i = 1; i <= strlen(s); i++) {
        c = substr(s, i, 1)
        if (c == "(") depth = depth + 1
        else if (c == ")") depth = depth - 1
        else if (c == "," & depth == 0) return(1)
    }
    return(0)
}
end

// The loop runs inside a program so that only dash's own output reaches
// the log: at the top level the do-file's every line is echoed into it.
// The line is expanded with `macval' straight into the command, for the
// reason C-01 gives.
capture program drop _cf_help_register
program define _cf_help_register
    version 16.0
    local n_help = 0
    local n_hbad = 0
    tempname hh
    file open `hh' using "fixtures/help_examples.txt", read text
    file read `hh' line
    while r(eof) == 0 {
        if `"`macval(line)'"' != "" {
            local ++n_help
            local hid "h`n_help'"
            mata: st_local("_tlc", strofreal(_cf_toplevel_comma(st_local("line"))))
            if `_tlc' == 0 {
                capture noisily dash `macval(line)', name(`hid')
            }
            else {
                capture noisily dash `macval(line)' name(`hid')
            }
            local hrc = _rc
            if `hrc' != 0 {
                local ++n_hbad
                display as error `"C-05 REJECTED [`hid'] rc=`hrc': `macval(line)'"'
            }
        }
        file read `hh' line
    }
    file close `hh'
    c_local n_help `n_help'
    c_local n_hbad `n_hbad'
end

// The control, registered under the same log: an option twoway has and
// dash does not draw, so the note must name it.  Flipped: WP-32 -- it was
// addplot(), which twoway refuses on scatter, r(198), and dash now refuses
// as twoway does (BUGS.md "In a few mixed lists dash names another word
// than twoway names first ..."); afcolor() twoway takes on every type.  It proves on every run
// that the note reaches this log in the words read below -- the check used
// to pass whenever no line held "ignoring unsupported", so a reworded note
// passed every example unread.
capture program drop _cf_help_control
program define _cf_help_control
    version 16.0
    capture noisily dash scatter mpg weight, afcolor(red) name(hctl)
    c_local n_hctl_rc = _rc
end

// An empty registry: the corpus is done with, and left registered it put
// the examples within two graphs of the 100 a dashboard draws (71 + 27 =
// 98), so two more corpus lines -- or the controls -- got an example or the
// control refused for the registry being full rather than for itself.
quietly dash clear

local helplog "`c(tmpdir)'dash_cf_help.log"
capture log close _cfhelp
capture erase "`helplog'"
quietly log using "`helplog'", replace text name(_cfhelp)
_cf_help_register
_cf_help_control
capture quietly log close _cfhelp

// Every example was read: one registration per line the fixture holds.
mata: st_local("c5_lines", strofreal(sum(cat("fixtures/help_examples.txt") :!= "")))

display ""
display "C-05: `n_help' documented examples registered of `c5_lines', `n_hbad' rejected"
assert `n_help' == `c5_lines'
assert `n_hbad' == 0
assert `n_hctl_rc' == 0
cert_log_has "`helplog'", needle("dash: ignoring unsupported option(s):")
local n_noted = r(count)
cert_log_has "`helplog'", needle("dash: ignoring unsupported option(s): afcolor()")
local n_ctl = r(count)
if `n_noted' != 1 | `n_ctl' != 1 {
    display as error "C-05 FAIL: `n_noted' unsupported-option note(s), `n_ctl' of them the control's; the log:"
    type "`helplog'"
}
assert `n_noted' == 1 & `n_ctl' == 1
capture erase "`helplog'"
display "C-05 PASS: every documented example parses clean, with nothing dropped; only the control drew the note"

// ----------------------------------------------------------------
// C-06 -- pccapsym and pcarrowi each build on their own (WP-22 TR-22.1).
// ----------------------------------------------------------------
// Both exited r(198) "unrecognised plot type" until WP-22, where twoway
// draws them (measured 23sep2026, rc 0).  C-01..C-04 render both inside
// the whole corpus; here each is built alone on the immediate route, and
// the saved page is read for what twoway draws: for pccapsym a spike (a
// Segment) capped by markers (a Scatter) and the marker labels mlabel()
// asks for; for pcarrowi pcarrow's own arrow (a Segment and an Arrow with
// an OpenHead) and the labels written among its values, as text.
// pcarrowi names no variable: the immediate route refused every such type
// but scatteri, pci, pcscatter and function, so it is built here too.
tempfile c6a c6b
local c6a "`c6a'.html"
local c6b "`c6b'.html"
dash clear
capture noisily dash pccapsym mpg weight m2 w2, msymbol(D) lcolor(navy) mlabel(make) saving("`c6a'", replace)
assert _rc == 0
confirm file "`c6a'"
foreach nd in Segment Scatter LabelSet {
    cert_file_has "`c6a'", needle(`""name":"`nd'""')
    assert r(found) == 1
}
cert_file_has "`c6a'", needle("AMC Concord")
assert r(found) == 1
// A %td label with a missing date.  The WP-22 review found the saved page
// failed to write here: the label column became a list of Timestamps and
// NaT, and Bokeh wrote NaT as a bare NaN, which is not JSON.
tempfile c6d
local c6d "`c6d'.html"
quietly generate double c6date = mdy(1, _n, 2020) if _n != 3
format c6date %td
capture noisily dash pccapsym mpg weight m2 w2, mlabel(c6date) saving("`c6d'", replace)
assert _rc == 0
confirm file "`c6d'"
cert_file_has "`c6d'", needle(`""name":"LabelSet""')
assert r(found) == 1
drop c6date
capture erase "`c6d'"
capture noisily dash pcarrowi 41 2200 41 2060 (3) "VW Diesel" 31 3460 28 3280 (9) "Plymouth Arrow", saving("`c6b'", replace)
assert _rc == 0
confirm file "`c6b'"
// Flipped (WP-31 C1): an Arrow with an OpenHead was the old head; twoway's
// head is _gr_arrowhead's geometry, a MultiLine the page's script fills.
foreach nd in Segment MultiLine LabelSet {
    cert_file_has "`c6b'", needle(`""name":"`nd'""')
    assert r(found) == 1
}
foreach nd in "VW Diesel" "Plymouth Arrow" {
    cert_file_has "`c6b'", needle("`nd'")
    assert r(found) == 1
}
capture erase "`c6a'"
capture erase "`c6b'"
display "C-06 PASS: pccapsym and pcarrowi each build alone: spikes capped with markers and their labels, arrows with theirs"

dash clear

display ""
display "All conformance tests PASSED (`n_cmd' commands rendered)."
