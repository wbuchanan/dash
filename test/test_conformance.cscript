*! test_conformance.cscript
*! The drop-in claim, proved by RENDERING rather than by parsing.
*!
*! Usage:  do test/test_conformance.cscript
*! Version: 1.0.0  20sep2026
*!
*! WHY THIS EXISTS
*!
*! dash.sthlp says a twoway command copied into dash runs.  The 299-command
*! corpus in test_option_surface.cscript checks that claim at the -syntax-
*! layer and no further: _dsp_probe appends name() to every probe, which
*! registers the specification and never renders it.  A command can be
*! accepted with rc 0 and then draw nothing, and that corpus is structurally
*! incapable of noticing -- which is exactly what `pci' and `pcscatter' did,
*! for as long as the package has existed, without one test failing.
*!
*! So this script registers a corpus covering every plot type dash advertises
*! and every option family, then renders all of it in ONE `dash build', and
*! asserts three things:
*!
*!   1. no command is rejected          -- rc 0 on every registration
*!   2. no graph is silently dropped    -- every name reaches the output
*!   3. no layer silently draws nothing -- the renderer reports an empty
*!                                         layer by graph and plot number,
*!                                         and the log must hold none
*!
*! One build renders the whole corpus, so the cost is one Python invocation
*! rather than one per command.
*!
*! lowess was deliberately absent while it needed the OPTIONAL statsmodels
*! package (a machine without it drew the layer empty, on purpose).  Since
*! WP-18 it is Stata's own smoother in numpy, needs nothing, and is in the
*! corpus with its sub-options; so are WP-18's other additions -- discrete,
*! stdf/stdr, mspline's bands()/n() and two weighted layers -- so each is
*! rendered end to end, not only registered.
*!
*! Fixtures:
*!   test/fixtures/conformance_corpus.txt   the corpus C-01 registers and
*!                                          C-02..C-04 render
*!   test/fixtures/help_examples.txt        every plot example dash.sthlp
*!                                          prints, one per line, with the
*!                                          name()/saving() stripped; C-05
*!                                          registers each and requires it to
*!                                          parse clean -- rc 0 and nothing
*!                                          named in the unsupported-option
*!                                          note (WP-15, the F5 baseline made
*!                                          mechanical)

cscript "dash conformance: the corpus renders" adodir ".."

adopath ++ ".."

if "`c(python_exec)'" == "" {
    display as error "SKIP: Python not available."
    exit 222
}

global dash_nobrowser 1

capture program drop cert_file_has
quietly do "cert_helpers.do"

sysuse auto, clear
generate double lo   = mpg - 3
generate double hi   = mpg + 3
generate double w2   = weight + 250
generate double m2   = mpg + 4
generate int    t    = _n
tsset t

dash clear

local n_cmd  = 0
local n_bad  = 0
local n_badn = 0
local names  ""

// ----------------------------------------------------------------
// C-01 — register the corpus.
// ----------------------------------------------------------------
// The commands live in test/fixtures/conformance_corpus.txt, one per line,
// so they can be read and added to without touching this script.
//
// The line is expanded with `macval' straight into the command rather than
// through a helper program or a global: a global whose value is a command
// carrying commas and parentheses does not survive the round trip, and the
// loop fails to parse.
//
// A command with no options of its own needs a comma before name(); one
// that already has options needs only a space, or Stata reads name() as
// part of the varlist and answers r(101).
tempname fh
file open `fh' using "fixtures/conformance_corpus.txt", read text
file read `fh' line
while r(eof) == 0 {
    if `"`macval(line)'"' != "" {
        local ++n_cmd
        local id "c`n_cmd'"
        if strpos(`"`macval(line)'"', ",") == 0 {
            capture noisily dash `macval(line)', name(`id')
        }
        else {
            capture noisily dash `macval(line)' name(`id')
        }
        if _rc != 0 {
            local ++n_bad
            display as error `"C-01 REJECTED [`id'] rc=`=_rc': `macval(line)'"'
        }
        else {
            local names "`names' `id'"
        }
    }
    file read `fh' line
}
file close `fh'


display ""
display "C-01: `n_cmd' commands registered, `n_bad' rejected"
assert `n_cmd' >= 55
assert `n_bad' == 0
display "C-01 PASS: every corpus command was accepted"

// ----------------------------------------------------------------
// C-02 — render the whole corpus in one build, capturing the log.
// ----------------------------------------------------------------
tempfile outhtml
tempfile buildlog
capture log close _cflog
quietly log using "`buildlog'", replace text name(_cflog)
capture noisily dash build, saving("`outhtml'.html") replace
local build_rc = _rc
capture quietly log close _cflog

assert `build_rc' == 0
display "C-02 PASS: the corpus rendered (rc 0)"

// ----------------------------------------------------------------
// C-03 — no layer drew nothing.
// ----------------------------------------------------------------
// The renderer names an empty layer by graph and plot number.  Anything
// reported here is a command dash accepted and then did not draw.
tempname lg
local n_empty = 0
local emptylist ""
file open `lg' using "`buildlog'", read text
file read `lg' line
while r(eof) == 0 {
    if strpos(`"`macval(line)'"', "drew nothing") > 0 {
        local ++n_empty
        local emptylist `"`emptylist' | `macval(line)'"'
    }
    file read `lg' line
}
file close `lg'

if `n_empty' > 0 {
    display as error "C-03 FAIL: `n_empty' layer(s) drew nothing:"
    display as error `"`emptylist'"'
}
assert `n_empty' == 0
display "C-03 PASS: every layer in the corpus drew something"

// ----------------------------------------------------------------
// C-04 — no graph was silently dropped.
// ----------------------------------------------------------------
// The renderer names any registered graph that did not become a figure.
// A graph dropped between the registry and the dashboard leaves no other
// trace: the file is written, rc is 0, and the user counts the panels.
tempname lg2
local n_drop = 0
local droplist ""
file open `lg2' using "`buildlog'", read text
file read `lg2' line
while r(eof) == 0 {
    if strpos(`"`macval(line)'"', "did not reach") > 0 {
        local ++n_drop
        local droplist `"`droplist' | `macval(line)'"'
    }
    file read `lg2' line
}
file close `lg2'

if `n_drop' > 0 {
    display as error "C-04 FAIL: a registered graph was dropped:"
    display as error `"`droplist'"'
}
assert `n_drop' == 0

// And the file is real, not an empty shell.
capture confirm file "`outhtml'.html"
assert _rc == 0
checksum "`outhtml'.html"
assert r(filelen) > 100000
display "C-04 PASS: all `n_cmd' graphs reached the rendered dashboard"

// ----------------------------------------------------------------
// C-05 — every documented example parses clean.
// ----------------------------------------------------------------
// dash.sthlp's own examples live in test/fixtures/help_examples.txt, one
// per line with the name()/saving() stripped.  Each is registered under
// ONE captured log; every rc must be 0 and the log must hold no line of
// the note that names a dropped option -- a documented example has, by
// definition, nothing pending and nothing unknown.
//
// The ytitle2 example draws sales and margin against year; auto has none
// of those, so they are generated here rather than the example dropped.
//
// The comma rule of C-01 is applied to a comma OUTSIDE every parenthesis:
// the examples include paren-mode commands whose only comma belongs to a
// segment, and name() then still needs the graph-level comma.
quietly generate int    year   = 1970 + _n
quietly generate double sales  = price
quietly generate double margin = mpg

capture mata: mata drop _cf_toplevel_comma()
mata:
real scalar _cf_toplevel_comma(string scalar s)
{
    real scalar   i, depth
    string scalar c
    depth = 0
    for (i = 1; i <= strlen(s); i++) {
        c = substr(s, i, 1)
        if (c == "(") depth = depth + 1
        else if (c == ")") depth = depth - 1
        else if (c == "," & depth == 0) return(1)
    }
    return(0)
}
end

// The loop runs inside a program so that only dash's own output reaches
// the log: at the top level the do-file's every line is echoed into it.
// The line is expanded with `macval' straight into the command, for the
// reason C-01 gives.
capture program drop _cf_help_register
program define _cf_help_register
    version 16.0
    local n_help = 0
    local n_hbad = 0
    tempname hh
    file open `hh' using "fixtures/help_examples.txt", read text
    file read `hh' line
    while r(eof) == 0 {
        if `"`macval(line)'"' != "" {
            local ++n_help
            local hid "h`n_help'"
            mata: st_local("_tlc", strofreal(_cf_toplevel_comma(st_local("line"))))
            if `_tlc' == 0 {
                capture noisily dash `macval(line)', name(`hid')
            }
            else {
                capture noisily dash `macval(line)' name(`hid')
            }
            local hrc = _rc
            if `hrc' != 0 {
                local ++n_hbad
                display as error `"C-05 REJECTED [`hid'] rc=`hrc': `macval(line)'"'
            }
        }
        file read `hh' line
    }
    file close `hh'
    c_local n_help `n_help'
    c_local n_hbad `n_hbad'
end

local helplog "`c(tmpdir)'dash_cf_help.log"
capture log close _cfhelp
capture erase "`helplog'"
quietly log using "`helplog'", replace text name(_cfhelp)
_cf_help_register
capture quietly log close _cfhelp

display ""
display "C-05: `n_help' documented examples registered, `n_hbad' rejected"
assert `n_help' >= 25
assert `n_hbad' == 0
cert_file_has "`helplog'", needle("ignoring unsupported")
local n_noted = r(found)
if `n_noted' != 0 {
    display as error "C-05 FAIL: a documented example drew the unsupported-option note:"
    type "`helplog'"
}
assert `n_noted' == 0
capture erase "`helplog'"
display "C-05 PASS: every documented example parses clean, with nothing dropped"

// ----------------------------------------------------------------
// C-06 -- pccapsym and pcarrowi each build on their own (WP-22 TR-22.1).
// ----------------------------------------------------------------
// Both exited r(198) "unrecognised plot type" until WP-22, where twoway
// draws them (measured 23sep2026, rc 0).  C-01..C-04 render both inside
// the whole corpus; here each is built alone on the immediate route, and
// the saved page is read for what twoway draws: for pccapsym a spike (a
// Segment) capped by markers (a Scatter) and the marker labels mlabel()
// asks for; for pcarrowi pcarrow's own arrow (a Segment and an Arrow with
// an OpenHead) and the labels written among its values, as text.
// pcarrowi names no variable: the immediate route refused every such type
// but scatteri, pci, pcscatter and function, so it is built here too.
tempfile c6a c6b
local c6a "`c6a'.html"
local c6b "`c6b'.html"
dash clear
capture noisily dash pccapsym mpg weight m2 w2, msymbol(D) lcolor(navy) mlabel(make) saving("`c6a'")
assert _rc == 0
confirm file "`c6a'"
foreach nd in Segment Scatter LabelSet {
    cert_file_has "`c6a'", needle(`""name":"`nd'""')
    assert r(found) == 1
}
cert_file_has "`c6a'", needle("AMC Concord")
assert r(found) == 1
// A %td label with a missing date.  The WP-22 review found the saved page
// failed to write here: the label column became a list of Timestamps and
// NaT, and Bokeh wrote NaT as a bare NaN, which is not JSON.
tempfile c6d
local c6d "`c6d'.html"
quietly generate double c6date = mdy(1, _n, 2020) if _n != 3
format c6date %td
capture noisily dash pccapsym mpg weight m2 w2, mlabel(c6date) saving("`c6d'")
assert _rc == 0
confirm file "`c6d'"
cert_file_has "`c6d'", needle(`""name":"LabelSet""')
assert r(found) == 1
drop c6date
capture erase "`c6d'"
capture noisily dash pcarrowi 41 2200 41 2060 (3) "VW Diesel" 31 3460 28 3280 (9) "Plymouth Arrow", saving("`c6b'")
assert _rc == 0
confirm file "`c6b'"
foreach nd in Segment Arrow OpenHead LabelSet {
    cert_file_has "`c6b'", needle(`""name":"`nd'""')
    assert r(found) == 1
}
foreach nd in "VW Diesel" "Plymouth Arrow" {
    cert_file_has "`c6b'", needle("`nd'")
    assert r(found) == 1
}
capture erase "`c6a'"
capture erase "`c6b'"
display "C-06 PASS: pccapsym and pcarrowi each build alone: spikes capped with markers and their labels, arrows with theirs"

dash clear

display ""
display "All conformance tests PASSED (`n_cmd' commands rendered)."
