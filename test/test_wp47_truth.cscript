python:
def _q470616_dot(sp, dp, app):
    """The dot's drawn outer size in outline widths, saved and served
    (WP-47 PIC-16)."""
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    from sfi import Macro
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
        with open(app, encoding="utf-8") as fh:
            src = fh.read()
        attach = "if __name__ != '__main__':\n    make_document(curdoc())"
        ns = dict(__name__="dash_q470616_app")
        exec(compile(src.replace(attach, "pass"), "dash_q470616_app.py",
                     "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    for tag, models in (("saved", r._last_layout_root.references()),
                        ("served", doc.models)):
        g = [m.glyph for m in models if type(m).__name__ == "GlyphRenderer"
             and "dash_dots" in (m.tags or [])]
        v = ((float(g[0].size) + float(g[0].line_width))
             / float(g[0].line_width)) if len(g) == 1 else -1.0
        Macro.setGlobal("q470616_" + tag, "%.3f" % v)
end

* ==== S06 PIC-16: a dot plot's dot floored on its fill plus outline ====
local only : env WP47_ONLY
if inlist("`only'", "", "S06") & `: list posof "S06" in w47_run' {
    display as text "S06 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4706-16: twoway's default dot (dot mpg weight in 1/5) is a ring
