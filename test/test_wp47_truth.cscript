*! test_wp47_truth.cscript
*! WP-47's ONE certification script (.ultraplan/sections/index.md PD-6):
*! every comparison with twoway's drawing or with Stata's own values that
*! WP-47's sections need lives here, one block per GAPS4 row (or per
*! harness tool), appended above the "append new blocks above this line"
*! marker in section order.  Refusal, message and return-code checks join
*! the EXISTING script for their area (merge rule R1).
*!
*! Made from test/templates/wp_truth_template.cscript (47 -> the WP's
*! number).  S00 is the scaffold smoke (Q4700-1).  A section appends
*! `* ==== S<MM> <lead id>: <what> ====` ... `* ==== end S<MM> ====` (or
*! `S<MM> tool: <what>` for a section with no item), its helper programs
*! directly above its first header, and writes only inside its own
*! blocks.  Case ids are Q47<MM>-<k> (PD-5).
*!
*! Usage: via run_all_cscripts.do.  One block alone: WP47_ONLY=S<MM> in
*! the driver's environment.  Each block prints "S<MM> start" and "S<MM>
*! end" with the date and time.  The suite runs it in every session;
*! DASH_CERT_SHARD=k/N runs part k of N of the blocks; a part with no
*! block ends 0.

cscript "WP-47 truth: twoway comparisons" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off


do "cert_helpers.do"
quietly do "cert_svg.do"
qui do "../dash_parse.mata"
qui do "../dash.ado"
global dash_nobrowser 1

// ----------------------------------------------------------------
// Tally helpers -- test_wp29_truth.cscript's _w29_expect/_w29_done,
// renamed _w47_ for this script.  A case is any number of
// _w47_expect lines closed by one _w47_done.
// ----------------------------------------------------------------
global w47_nfail    = 0
global w47_faillist ""
global w47_bad      = 0
global w47_ncase    = 0

capture program drop _w47_expect
program define _w47_expect
    version 19
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global w47_bad = 1
    }
end

capture program drop _w47_done
program define _w47_done
    version 19
    args id msg
    if ${w47_bad} {
        global w47_nfail    = ${w47_nfail} + 1
        global w47_faillist "${w47_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global w47_bad   = 0
    global w47_ncase = ${w47_ncase} + 1
end

// A fresh directory for this run's files, never one that already exists:
// a fixed name in a shared temp directory could be planted by another
// account (rule 1), so a name Stata has not handed out before is made and
// the run fails if it cannot be.  Every block writes only under it.
tempfile w47_base
local w47_work "`w47_base'_w47"
capture mkdir "`w47_work'"
if _rc {
    display as error "test_wp47_truth: cannot create the work directory `w47_work' (rc `=_rc')"
    exit 9
}

// ---- parts: begin (WP-47 test performance) ----
// The certification suite runs this script in every one of its sessions
// (its row in run_all_cscripts.do's shard table is "* * *"); with
// DASH_CERT_SHARD=k/N set, the session runs part k of N of the blocks.
// The parts are balanced longest first onto the least loaded part (the
// lowest numbered of equals), by the seconds below -- a block not listed
// counts 1 s (section-01 D-01.f) -- the rule scripts/cert_shards.py uses
// for the scripts.  Unset, or with WP47_ONLY set
// (which keeps its precedence), every block runs.  A block runs when its
// gate finds its id in w47_run.
// Seconds: each block's start/end lines in the WP's last measured
// certification run, rounded up, at least 1; a block not listed
// counts 1 s.
local w47_secs S00 1
local w47_sh : environment DASH_CERT_SHARD
mata: st_local("w47_ok", strofreal(st_local("w47_sh") == "" | ustrregexm(st_local("w47_sh"), "^[1-4]/[1-4]$")))
if !`w47_ok' {
    display as error "test_wp47_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 4"
    exit 198
}
local w47_k 1
local w47_N 1
if "`w47_sh'" != "" {
    local w47_k = real(substr("`w47_sh'", 1, 1))
    local w47_N = real(substr("`w47_sh'", 3, 1))
}
local w47_only : env WP47_ONLY
if `"`macval(w47_only)'"' != "" | `w47_N' == 1 {
    local w47_k 1
    local w47_N 1
}
if `w47_k' > `w47_N' {
    display as error "test_wp47_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 4"
    exit 198
}
capture confirm file "test_wp47_truth.cscript"
if _rc {
    display as error "test_wp47_truth: run it from test/, where it reads its own blocks"
    exit 601
}
capture mata: mata drop _w47_part()
mata:
// The ids of the blocks (their header lines, in file order), and those of
// part k of n: longest first onto the least loaded part.
void _w47_part(string scalar file, string scalar table, real scalar k,
               real scalar n)
{
    string colvector lines, ids
    string rowvector tok
    real colvector sec, o, at
    real rowvector load
    real scalar i, j, p, best
    string scalar run

    lines = cat(file)
    ids = J(0, 1, "")
    for (i = 1; i <= rows(lines); i++) {
        if (ustrregexm(lines[i], "^\* ==== (S[0-9]+) ")) {
            if (!anyof(ids, ustrregexs(1))) ids = ids \ ustrregexs(1)
        }
    }
    sec = J(rows(ids), 1, 1)
    tok = tokens(table)
    for (j = 1; j + 1 <= cols(tok); j = j + 2) {
        for (i = 1; i <= rows(ids); i++) {
            if (ids[i] == tok[j]) sec[i] = strtoreal(tok[j + 1])
        }
    }
    o = order((-sec, (1::rows(ids))), (1, 2))
    load = J(1, n, 0)
    at = J(rows(ids), 1, 0)
    for (i = 1; i <= rows(o); i++) {
        best = 1
        for (p = 2; p <= n; p++) if (load[p] < load[best]) best = p
        load[best] = load[best] + sec[o[i]]
        at[o[i]] = best
    }
    run = ""
    for (i = 1; i <= rows(ids); i++) if (at[i] == k) run = run + " " + ids[i]
    st_local("w47_run", strtrim(run))
}
end
mata: _w47_part("test_wp47_truth.cscript", st_local("w47_secs"), `w47_k', `w47_N')
display as text "test_wp47_truth: part `w47_k'/`w47_N' runs `: word count `w47_run'' blocks: `w47_run'"
// ---- parts: end ----

* ==== S00 scaffold: the helpers load and a twoway SVG is read ====
local only : env WP47_ONLY
if inlist("`only'", "", "S00") & `: list posof "S00" in w47_run' {
    display as text "S00 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4700-1: cert_svg_export and cert_svg_texts on one twoway scatter,
    // and dash's own programs are loaded from this tree.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(w47s01, replace)
    cert_svg_export, name(w47s01) file("`w47_work'/w47s01.svg")
    local s01_rc   = r(rc)
    local s01_file "`r(file)'"
    _w47_expect Q4700-1 "(`s01_rc' == 0)" "cert_svg_export rc `s01_rc'"
    capture confirm file "`s01_file'"
    _w47_expect Q4700-1 "(_rc == 0)" "r(file) `s01_file' does not exist"
    cert_svg_texts, file("`s01_file'")
    local s01_n    = r(n)
    local s01_list "`r(list)'"
    _w47_expect Q4700-1 "(`s01_n' > 0)" "cert_svg_texts found no text elements"
    capture program list _dash_serve
    _w47_expect Q4700-1 "(_rc == 0)" "dash.ado's _dash_serve is not loaded"
    _w47_done Q4700-1 "a twoway SVG was written and read (`s01_n' texts); dash is loaded"

    capture erase "`s01_file'"
    capture erase "`s01_list'"
    capture graph drop w47s01
    display as text "S00 end " c(current_date) " " c(current_time)
}
* ==== end S00 ====

* ==== S01 basic:PT-1: headlabel on pcscatter, pccapsym, pcarrowi ====
local only : env WP47_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w47_run' {
    display as text "S01 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4701-1: headlabel with mlabel() on pcscatter and pccapsym is taken
    // as twoway takes it (rc 0) and never named in the note: dash draws it
    // (the labels at the second point; test_pc_immediate_labels.py
    // TestHeadlabel, immediate_label_truth.json H02, H04).
    // ------------------------------------------------------------
    sysuse auto, clear
    foreach t in pcscatter pccapsym {
        capture noisily twoway `t' mpg weight trunk turn in 1/5, mlabel(make) headlabel name(q4701, replace)
        local q1t = _rc
        capture graph drop q4701
        local q1lg "`w47_work'/q4701_1_`t'.log"
        capture erase "`q1lg'"
        quietly log using "`q1lg'", text replace name(q4701)
        capture noisily dash `t' mpg weight trunk turn in 1/5, mlabel(make) headlabel name(q4701a)
        local q1d = _rc
        quietly log close q4701
        capture dash clear
        _w47_expect Q4701-1 "(`q1t' == 0 & `q1d' == 0)" "`t': twoway rc `q1t', dash rc `q1d'"
        cert_log_has "`q1lg'", needle("headlabel")
        _w47_expect Q4701-1 "(r(found) == 0)" "`t': the note names headlabel"
        capture erase "`q1lg'"
    }
    _w47_done Q4701-1 "pcscatter and pccapsym take mlabel() headlabel, rc 0, and say nothing"

    // ------------------------------------------------------------
    // Q4701-2: the same on pcarrowi with labels, and under
    // recast(pcbarrow) (immediate_label_truth.json H06, H07).
    // ------------------------------------------------------------
    foreach r in "" "recast(pcbarrow)" {
        capture noisily twoway pcarrowi 20 2000 30 4000 "A" 25 3000 35 4000 (9) "B", headlabel `r' name(q4701, replace)
        local q2t = _rc
        capture graph drop q4701
        local q2lg "`w47_work'/q4701_2.log"
        capture erase "`q2lg'"
        quietly log using "`q2lg'", text replace name(q4701)
        capture noisily dash pcarrowi 20 2000 30 4000 "A" 25 3000 35 4000 (9) "B", headlabel `r' name(q4701b)
        local q2d = _rc
        quietly log close q4701
        capture dash clear
        _w47_expect Q4701-2 "(`q2t' == 0 & `q2d' == 0)" "pcarrowi `r': twoway rc `q2t', dash rc `q2d'"
        cert_log_has "`q2lg'", needle("headlabel")
        _w47_expect Q4701-2 "(r(found) == 0)" "pcarrowi `r': the note names headlabel"
        capture erase "`q2lg'"
    }
    _w47_done Q4701-2 "pcarrowi takes headlabel with labels, plain and recast(pcbarrow), rc 0, and says nothing"

    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====

* ==== S01 MS-7: immediate labels under recast() ====
local only : env WP47_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w47_run' {
    display as text "S01 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4701-3: pci with a label under recast(pccapsym) is taken, rc 0, as
    // twoway takes it, and no note says pci draws no labels (twoway draws
    // them under the recast: immediate_label_truth.json R01; dash draws
    // them too, test_pc_immediate_labels.py TestImmediateRecast).  Plain
    // pci with a label is silent too, as twoway is.
    // ------------------------------------------------------------
    foreach r in "recast(pccapsym)" "" {
        capture noisily twoway pci 20 2000 30 4000 "A", `r' name(q4701, replace)
        local q3t = _rc
        capture graph drop q4701
        local q3lg "`w47_work'/q4701_3.log"
        capture erase "`q3lg'"
        quietly log using "`q3lg'", text replace name(q4701)
        capture noisily dash pci 20 2000 30 4000 "A", `r' name(q4701c)
        local q3d = _rc
        quietly log close q4701
        capture dash clear
        _w47_expect Q4701-3 "(`q3t' == 0 & `q3d' == 0)" "pci `r': twoway rc `q3t', dash rc `q3d'"
        cert_log_has "`q3lg'", needle("draws no labels")
        _w47_expect Q4701-3 "(r(found) == 0)" "pci `r': a note says pci draws no labels"
        capture erase "`q3lg'"
    }
    _w47_done Q4701-3 "pci with a label, under recast(pccapsym) or plain, rc 0 and no false note"

    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====
// ----------------------------------------------------------------
// S02 helpers (WP-47 47-02).  _q4702_tw reads twoway's graph g: its y
// and x titles' lines and its legend labels, "|"-joined, into locals
// q2ty, q2tx and q2tk.  _q4702 builds the saved page and the served
// app from dash's spec and puts in $q4702, for each mode, 1 when the
// first figure's y title, x title and legend keys equal the locals
// q2ty, q2tx and q2tk (a title's lines "|"-joined), and in $q4702_lab
// the saved figure's marker-label texts, "|"-joined.
// ----------------------------------------------------------------
capture program drop _q4702_tw
program define _q4702_tw
    version 19
    args g
    local ty ""
    local tx ""
    local tk ""
    local n "`.`g'.yaxis1.title.text.arrnels'"
    forvalues i = 1/0`n' {
        local ty `"`ty'`=cond(`i' > 1, "|", "")'`.`g'.yaxis1.title.text[`i']'"'
    }
    local n "`.`g'.xaxis1.title.text.arrnels'"
    forvalues i = 1/0`n' {
        local tx `"`tx'`=cond(`i' > 1, "|", "")'`.`g'.xaxis1.title.text[`i']'"'
    }
    if "`.`g'.legend.draw_view.istrue'" == "1" {
        local n "`.`g'.legend.labels.arrnels'"
        forvalues i = 1/0`n' {
            local tk `"`tk'`=cond(`i' > 1, "|", "")'`.`g'.legend.labels[`i']'"'
        }
    }
    c_local q2ty `"`ty'"'
    c_local q2tx `"`tx'"'
    c_local q2tk `"`tk'"'
end

python:
def _q4702(sp, dp, app):
    import os
    import sys
    import warnings
    # The block runs from test/ (the script checks): the repo is above.
    repo = os.path.dirname(os.path.abspath(os.getcwd()))
    if repo not in sys.path:
        sys.path.insert(0, repo)
    import dash_render as dr
    from bokeh.document import Document
    from bokeh.models import LabelSet
    from sfi import Macro
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
        src = open(app, encoding="utf-8").read()
        attach = "if __name__ != '__main__':\n    make_document(curdoc())"
        ns = dict(__name__="dash_q4702_app")
        exec(compile(src.replace(attach, "pass"), "dash_q4702_app.py",
                     "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    want = (Macro.getLocal("q2ty"), Macro.getLocal("q2tx"),
            Macro.getLocal("q2tk"))
    sv = [m for m in doc.models if type(m).__name__ == "figure"]
    out, seen = [], []
    for figs in (list(r.figures.values()), sv):
        f = figs[0]
        keys = []
        for lg in f.legend:
            if not lg.visible:
                continue
            for it in lg.items:
                lab = it.label
                keys.append(lab.get("value") if isinstance(lab, dict)
                            else getattr(lab, "value", lab))
        got = ((f.yaxis[0].axis_label or "").replace("\n", "|"),
               (f.xaxis[0].axis_label or "").replace("\n", "|"),
               "|".join(str(k) for k in keys))
        seen.append("[%s][%s][%s]" % got)
        out.append("1" if got == want else "0")
    f = list(r.figures.values())[0]
    sets = [m for m in (list(f.center) + list(f.above) + list(f.below)
                        + list(f.left) + list(f.right) + list(f.renderers))
            if isinstance(m, LabelSet)]
    labs = []
    for m in sets:
        fld = getattr(m.text, "field", None) or m.text
        if isinstance(fld, str) and fld in m.source.data:
            labs.extend(str(v) for v in m.source.data[fld])
    Macro.setGlobal("q4702", " ".join(out))
    Macro.setGlobal("q4702_seen", " ".join(seen))
    Macro.setGlobal("q4702_lab", "|".join(labs) or ".")
    Macro.setGlobal("q4702_nlab", str(len(sets)))
end

* ==== S02 MS-2: yvarlabel() and xvarlabel() on every plot type ====
local only : env WP47_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w47_run' {
    display as text "S02 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4702-1: kdensity, histogram, scatteri, function and pci take
    // yvarlabel() and xvarlabel(): dash's titles and keys (saved and
    // served) equal twoway's, measured live from its graph.
    // ------------------------------------------------------------
    sysuse auto, clear
    local q1n 0
    foreach c in `"kdensity mpg, xvarlabel("M") yvarlabel("D")"' ///
                 `"histogram mpg, xvarlabel("M") yvarlabel("D")"' ///
                 `"scatteri 20 3000 25 4000, yvarlabel("Q") xvarlabel("R")"' ///
                 `"function y = x, range(0 1) yvarlabel("Q") xvarlabel("R")"' ///
                 `"pci 20 2000 30 4000, yvarlabel("Q" "R") xvarlabel("S")"' ///
                 `"(scatter mpg weight) (function y = 20, range(weight) yvarlab("y=x")), legend(on)"' {
        local ++q1n
        quietly twoway `c' name(q4702, replace)
        _q4702_tw q4702
        capture graph drop q4702
        dash clear
        capture noisily dash `c' name(q1)
        local drc = _rc
        _w47_expect Q4702-1 "(`drc' == 0)" `"dash `c': rc `drc'"'
        _dash_serve_spec, specpath("`w47_work'/q4702_1s.json") datapath("`w47_work'/q4702_1d.json")
        python: import __main__ as _m4702; _m4702._q4702("`w47_work'/q4702_1s.json", "`w47_work'/q4702_1d.json", "`w47_work'/q4702_1a.py")
        _w47_expect Q4702-1 `"("${q4702}" == "1 1")"' `"`c': twoway [`q2ty'][`q2tx'][`q2tk'], dash ${q4702_seen}"'
        dash clear
    }
    _w47_done Q4702-1 "`q1n' types take yvarlabel()/xvarlabel() as twoway does, in both modes"
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

* ==== S02 MS-3: yvarlabel("") is the name; a variable relabelled graph-wide ====
local only : env WP47_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w47_run' {
    display as text "S02 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4702-2: the last yvarlabel() given for a variable labels it in
    // every plot of the same rows, yvarlabel("") is the variable's name,
    // and plots of other if keep their own: dash's titles and keys
    // (saved and served) equal twoway's, measured live.
    // ------------------------------------------------------------
    sysuse auto, clear
    local q2n 0
    foreach c in `"(scatter mpg weight, yvarlabel("A")) (scatter mpg length, yvarlabel("B")), legend(on)"' ///
                 `"scatter mpg weight, yvarlabel("")"' ///
                 `"scatter mpg price weight, yvarlabel("A" "") legend(on)"' ///
                 `"(scatter mpg weight if foreign) (scatter mpg weight if !foreign, yvarlabel("B")), legend(on)"' ///
                 `"(lfit mpg weight, yvarlabel("Q")) (scatter mpg weight), legend(on)"' {
        local ++q2n
        quietly twoway `c' name(q4702, replace)
        _q4702_tw q4702
        capture graph drop q4702
        dash clear
        capture noisily dash `c' name(q2)
        local drc = _rc
        _w47_expect Q4702-2 "(`drc' == 0)" `"dash `c': rc `drc'"'
        _dash_serve_spec, specpath("`w47_work'/q4702_2s.json") datapath("`w47_work'/q4702_2d.json")
        python: import __main__ as _m4702; _m4702._q4702("`w47_work'/q4702_2s.json", "`w47_work'/q4702_2d.json", "`w47_work'/q4702_2a.py")
        _w47_expect Q4702-2 `"("${q4702}" == "1 1")"' `"`c': twoway [`q2ty'][`q2tx'][`q2tk'], dash ${q4702_seen}"'
        dash clear
    }
    _w47_done Q4702-2 "`q2n' graphs title and key relabelled variables as twoway does, in both modes"
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

* ==== S02 MS-5: marker labels in the layer's varformat ====
local only : env WP47_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w47_run' {
    display as text "S02 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4702-3: mlabel(mpg) yvarformat(%9.2f) labels the markers as
    // twoway does (its first SVG text, measured live: 22.00); dash's
    // first label is the same, and mlabformat(%9.1f) wins (22.0).
    // ------------------------------------------------------------
    sysuse auto, clear
    foreach f in "" "mlabformat(%9.1f)" {
        quietly twoway scatter mpg weight in 1/5, mlabel(mpg) yvarformat(%9.2f) `f' name(q4702, replace)
        cert_svg_export, name(q4702) file("`w47_work'/q4702_3.svg")
        capture graph drop q4702
        cert_svg_texts, file("`r(file)'")
        local q3l "`r(list)'"
        python: import json as _j4702; from sfi import Macro as _M4702; _M4702.setLocal("q3tw", _j4702.loads(open(_M4702.getLocal("q3l"), encoding="utf-8").readline())["text"])
        capture erase "`q3l'"
        capture erase "`w47_work'/q4702_3.svg"
        _q4702_tw q4702
        dash clear
        capture noisily dash scatter mpg weight in 1/5, mlabel(mpg) yvarformat(%9.2f) `f' name(q3)
        _w47_expect Q4702-3 "(_rc == 0)" "dash rc `=_rc'"
        _dash_serve_spec, specpath("`w47_work'/q4702_3s.json") datapath("`w47_work'/q4702_3d.json")
        local q2ty ""
        local q2tx ""
        local q2tk ""
        python: import __main__ as _m4702; _m4702._q4702("`w47_work'/q4702_3s.json", "`w47_work'/q4702_3d.json", "`w47_work'/q4702_3a.py")
        mata: st_local("q3d", tokens(st_global("q4702_lab"), "|")[1])
        _w47_expect Q4702-3 `"("`q3d'" == "`q3tw'")"' "`f': twoway's first label [`q3tw'], dash's [`q3d']"
        dash clear
    }
    _w47_done Q4702-3 "marker labels of the y variable take its yvarformat(), mlabformat() first, as twoway writes them"
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

* ==== S02 basic:PT-3: no labels for an mlabel() pattern naming several variables ====
local only : env WP47_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w47_run' {
    display as text "S02 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4702-4: twoway draws as many marker-label texts for mlabel(t*)
    // as for no mlabel() (measured live: SVG text counts), and the
    // y's a pattern naming one variable labels; dash draws a label set
    // for each y twoway labels: none for t*, one for (make t*).
    // ------------------------------------------------------------
    sysuse auto, clear
    local q4n 0
    foreach m in "" "t*" "make t*" "tr*" {
        local ++q4n
        local ys = cond("`m'" == "tr*", "mpg", "mpg price")
        local mo = cond("`m'" == "", "", "mlabel(`m')")
        quietly twoway scatter `ys' weight in 1/5, `mo' name(q4702, replace)
        cert_svg_export, name(q4702) file("`w47_work'/q4702_4.svg")
        capture graph drop q4702
        cert_svg_texts, file("`r(file)'")
        local q4n`q4n' = r(n)
        capture erase "`r(list)'"
        capture erase "`w47_work'/q4702_4.svg"
        if "`m'" == "" continue
        dash clear
        capture noisily dash scatter `ys' weight in 1/5, `mo' name(q4)
        _w47_expect Q4702-4 "(_rc == 0)" "dash mlabel(`m') rc `=_rc'"
        _dash_serve_spec, specpath("`w47_work'/q4702_4s.json") datapath("`w47_work'/q4702_4d.json")
        local q2ty ""
        local q2tx ""
        local q2tk ""
        python: import __main__ as _m4702; _m4702._q4702("`w47_work'/q4702_4s.json", "`w47_work'/q4702_4d.json", "`w47_work'/q4702_4a.py")
        local want = cond("`m'" == "t*", 0, 1)
        _w47_expect Q4702-4 "(${q4702_nlab} == `want')" "mlabel(`m'): dash draws ${q4702_nlab} label sets, want `want'"
        dash clear
    }
    _w47_expect Q4702-4 "(`q4n2' == `q4n1')" "twoway mlabel(t*) draws `q4n2' texts, none `q4n1'"
    _w47_expect Q4702-4 "(`q4n3' == `q4n1' + 5)" "twoway mlabel(make t*) draws `q4n3' texts, none `q4n1'"
    _w47_done Q4702-4 "an mlabel() pattern naming several variables draws no labels for its y, as twoway draws none"
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

* ==== S02 DG-7: titles and keys of emptied layers ====
local only : env WP47_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w47_run' {
    display as text "S02 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4702-5: a fit or histogram that if leaves no row is titled and
    // keyed as twoway titles it -- the fit by its y's name, the
    // histogram's x "x": dash's titles and keys (saved and served)
    // equal twoway's, measured live from its graph.
    // ------------------------------------------------------------
    sysuse auto, clear
    local q5n 0
    foreach c in "lfit mpg weight if price<0, legend(on)" ///
                 "qfitci mpg weight if price<0, legend(on)" ///
                 "(scatter mpg weight) (lfit mpg weight if price<0), legend(on)" ///
                 "histogram mpg if price<0," {
        local ++q5n
        quietly twoway `c' name(q4702, replace)
        _q4702_tw q4702
        capture graph drop q4702
        dash clear
        capture noisily dash `c' name(q5)
        local drc = _rc
        _w47_expect Q4702-5 "(`drc' == 0)" `"dash `c': rc `drc'"'
        _dash_serve_spec, specpath("`w47_work'/q4702_5s.json") datapath("`w47_work'/q4702_5d.json")
        python: import __main__ as _m4702; _m4702._q4702("`w47_work'/q4702_5s.json", "`w47_work'/q4702_5d.json", "`w47_work'/q4702_5a.py")
        _w47_expect Q4702-5 `"("${q4702}" == "1 1")"' `"`c': twoway [`q2ty'][`q2tx'][`q2tk'], dash ${q4702_seen}"'
        dash clear
    }
    _w47_done Q4702-5 "`q5n' emptied layers are titled and keyed as twoway titles them, in both modes"
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

// ----------------------------------------------------------------
// S03 basic:PT-4 helpers.  _q4703_1_tw reads twoway's first stroked
// bar rect and its fill rect from an SVG; _q4703_1 builds the saved
// page and the served app from dash's spec and puts in $q4703_1, for
// each mode, 1 when every bar layer has an outline-only companion over
// its own source moved out (g > 0) and the fill draws no stroke.
// ----------------------------------------------------------------
python:
def _q4703_1_tw(path):
    import re
    from sfi import Macro
    txt = open(path, encoding="utf-8").read()
    rs = []
    for m in re.finditer(r"<rect\b([^>]*)>", txt):
        a = dict(re.findall(r'([\w:-]+)="([^"]*)"', m.group(1)))
        st = dict(kv.split(":", 1) for kv in a.get("style", "").split(";")
                  if ":" in kv)
        st = {k.strip(): v.strip() for k, v in st.items()}
        try:
            sw = float(st.get("stroke-width", ""))
        except ValueError:
            sw = 0.0
        rs.append((float(a.get("x", 0)), st.get("fill"), sw))
    w = max(r[2] for r in rs)
    ok = 0
    for i, r in enumerate(rs):
        if r[2] == w and r[1] in (None, "none") and i > 0:
            ok = int(r[0] < rs[i - 1][0] - 1)
            break
    Macro.setLocal("q1tw", str(ok))


def _q4703_1(sp, dp, app):
    import os
    import sys
    import warnings
    # The block runs from test/ (the script checks): the repo is above.
    repo = os.path.dirname(os.path.abspath(os.getcwd()))
    if repo not in sys.path:
        sys.path.insert(0, repo)
    import dash_render as dr
    from bokeh.document import Document
    from sfi import Macro
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
        src = open(app, encoding="utf-8").read()
        attach = "if __name__ != '__main__':\n    make_document(curdoc())"
        ns = dict(__name__="dash_q4703_app")
        exec(compile(src.replace(attach, "pass"), "dash_q4703_app.py",
                     "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    sv = [m for m in doc.models if type(m).__name__ == "figure"]
    out = []
    for figs in (list(r.figures.values()), sv):
        fills = [x for f in figs for x in f.renderers
                 if type(getattr(x, "glyph", None)).__name__ == "VBar"]
        outs = [x for f in figs for x in f.renderers
                if "dash_outline" in (x.tags or [])]
        good = bool(fills) and len(outs) == len(fills) and all(
            o.data_source is fl.data_source and fl.glyph.line_alpha == 0
            and o.glyph.left.expr.args["g"] > 0
            for o, fl in zip(outs, fills))
        out.append("1" if good else "0")
    Macro.setGlobal("q4703_1", " ".join(out))
end

* ==== S03 basic:PT-4: bar outlines aligned as twoway aligns them ====
local only : env WP47_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w47_run' {
    display as text "S03 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4703-1: twoway strokes a bar's outline outside its edge under
    // lalign(outside) (the outline rect, measured live from its SVG,
    // starts left of the fill rect), and dash takes lalign(outside) in
    // silence and draws an outline-only companion moved out (g > 0)
    // over the bars' own source, in both modes.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway bar mpg weight in 1/5, lwidth(vthick) barwidth(100) lalign(outside) name(q4703o, replace)
    cert_svg_export, name(q4703o) file("`w47_work'/q4703o.svg")
    capture graph drop q4703o
    local q1tw 0
    python: import __main__ as _m4703; _m4703._q4703_1_tw(r"`w47_work'/q4703o.svg")
    capture erase "`w47_work'/q4703o.svg"
    _w47_expect Q4703-1 "(`q1tw' == 1)" "twoway's outline rect does not start outside its fill rect"
    local lf "`w47_work'/q4703_1.log"
    capture erase "`lf'"
    quietly log using "`lf'", text replace name(q47031)
    dash clear
    capture noisily dash bar mpg weight in 1/5, lwidth(vthick) lalign(outside) name(q1)
    local drc = _rc
    quietly log close q47031
    _w47_expect Q4703-1 "(`drc' == 0)" "dash bar lalign(outside) rc `drc'"
    cert_log_has "`lf'", needle("lalign()")
    _w47_expect Q4703-1 "(r(count) == 0)" "dash names lalign() `r(count)' times"
    cert_log_has "`lf'", needle("alignstroke")
    _w47_expect Q4703-1 "(r(count) == 0)" "dash notes the alignment `r(count)' times"
    _dash_serve_spec, specpath("`w47_work'/q4703_1s.json") datapath("`w47_work'/q4703_1d.json")
    python: import __main__ as _m4703; _m4703._q4703_1("`w47_work'/q4703_1s.json", "`w47_work'/q4703_1d.json", "`w47_work'/q4703_1a.py")
    _w47_expect Q4703-1 `"("${q4703_1}" == "1 1")"' "the outline companions moved out over the bars' source (saved, served): ${q4703_1}"
    dash clear
    _w47_done Q4703-1 "twoway strokes outside the bar; dash draws the outline moved out in both modes, in silence"
    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

* ==== S03 basic:PT-6: markers sized by their outline alignment ====
local only : env WP47_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w47_run' {
    display as text "S03 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4703-2: twoway draws inside, center and outside as three pictures
    // (the ring's radius moves, measured live from its SVG), and dash
