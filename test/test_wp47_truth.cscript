// ----------------------------------------------------------------
// Summary (test_wp29_truth.cscript's shape)
// ----------------------------------------------------------------
capture graph drop _all
capture dash clear
capture rmdir "`w47_work'"
local nfail    = ${w47_nfail}
local faillist "${w47_faillist}"
local ncase    = ${w47_ncase}
local only : env WP47_ONLY
macro drop w47_nfail w47_faillist w47_bad w47_ncase
display as text ""
display as text "============================================================"
if `ncase' == 0 {
    if `w47_N' > 1 & `"`macval(only)'"' == "" & "`w47_run'" == "" {
        display as text "test_wp47_truth: part `w47_k'/`w47_N' has no block to run"
        display as text "============================================================"
        exit 0
    }
    // A WP47_ONLY that names no block, or only a stub, ran nothing:
    // that is not a pass.
    display as error "  test_wp47_truth: no case ran (WP47_ONLY=`only')"
    display as text "============================================================"
    exit 9
}
else if `nfail' == 0 {
    display as text "  test_wp47_truth: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_wp47_truth: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
