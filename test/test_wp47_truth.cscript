import os as _q47064_os, sys as _q47064_sys
for _q47064_p in (_q47064_os.path.abspath(".."),
                  _q47064_os.path.abspath(_q47064_os.path.join("..", "scripts"))):
    if _q47064_p not in _q47064_sys.path:
        _q47064_sys.path.insert(0, _q47064_p)


def _q47064_count(sp, dp, app):
    """Dots and rows of the dot layer, saved and served (WP-47 PIC-10)."""
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    from sfi import Macro
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
        with open(app, encoding="utf-8") as fh:
            src = fh.read()
        attach = "if __name__ != '__main__':\n    make_document(curdoc())"
        ns = dict(__name__="dash_q47064_app")
        exec(compile(src.replace(attach, "pass"), "dash_q47064_app.py",
                     "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    for tag, models in (("saved", r._last_layout_root.references()),
                        ("served", doc.models)):
        dots = [m for m in models if type(m).__name__ == "GlyphRenderer"
                and "dash_dots" in (m.tags or [])]
        d = dots[0].data_source.data if len(dots) == 1 else {"x": [], "y": []}
        Macro.setGlobal("q47064_" + tag, "%d %d" % (len(d["y"]),
                                                   len(set(d["x"]))))
end

* ==== S06 PIC-10: a dot row for an observation whose y is missing ====
local only : env WP47_ONLY
if inlist("`only'", "", "S06") & `: list posof "S06" in w47_run' {
    display as text "S06 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4706-4: twoway's dot close date in 1/45 (sp500, close missing in
    // row 3) draws 45 rows of 75 dots, 3375 (live SVG, the dots in
    // magenta); dash draws the same rows in both modes.
