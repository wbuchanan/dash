    _dash_serve_spec, specpath("`w47_work'/q47064s.json") datapath("`w47_work'/q47064d.json")
    python: import __main__ as _q47064_m; _q47064_m._q47064_count(r"`w47_work'/q47064s.json", r"`w47_work'/q47064d.json", r"`w47_work'/q47064a.py")
    _w47_expect Q4706-4 `"("${q47064_saved}" == "3375 45")"' "dash's saved page draws ${q47064_saved} dots and rows"
    _w47_expect Q4706-4 `"("${q47064_served}" == "3375 45")"' "dash's served app draws ${q47064_served} dots and rows"
    capture erase "`w47_work'/q47064s.json"
