    // included (live SVG: the smallest circle's radius and stroke width);
    // dash draws its dot that wide in both modes, not floored to 1 px
    // before the outline.
    // ------------------------------------------------------------
    sysuse auto, clear
    keep in 1/5
    quietly twoway dot mpg weight, name(q4706t, replace)
    cert_svg_export, name(q4706t) file("`w47_work'/q4706t.svg")
    python: import os as _o470616, sys as _s470616; _s470616.path.insert(0, _o470616.path.abspath("../scripts")); import svg_layer as _sl470616; _c = [e for e in _sl470616.svg_elements(r"`w47_work'/q4706t.svg") if e["kind"] == "circle" and e["extent"] and e["stroke_width"]]; _m = min(e["extent"] for e in _c) / 2; _w = [e["stroke_width"] for e in _c if e["extent"] / 2 == _m][0]; from sfi import Macro as _M470616; _M470616.setLocal("q16tw", "%.3f" % ((2 * _m + _w) / _w))
    capture erase "`w47_work'/q4706t.svg"
    capture graph drop q4706t
    _w47_expect Q4706-16 "(abs(`q16tw' - 1.517) < 0.02)" "twoway's dot is `q16tw' outline widths across"
    dash clear
    capture noisily dash dot mpg weight in 1/5, name(q4706f)
    local q16rc = _rc
    _w47_expect Q4706-16 "(`q16rc' == 0)" "dash dot rc `q16rc'"
    _dash_serve_spec, specpath("`w47_work'/q470616s.json") datapath("`w47_work'/q470616d.json")
    python: import __main__ as _q470616_m; _q470616_m._q470616_dot(r"`w47_work'/q470616s.json", r"`w47_work'/q470616d.json", r"`w47_work'/q470616a.py")
    _w47_expect Q4706-16 "(abs(${q470616_saved} - `q16tw') < 0.03 & abs(${q470616_served} - `q16tw') < 0.03)" "dash's dot is ${q470616_saved} (saved) / ${q470616_served} (served) widths across"
    capture erase "`w47_work'/q470616s.json"
    capture erase "`w47_work'/q470616d.json"
    capture erase "`w47_work'/q470616a.py"
    dash clear
    _w47_done Q4706-16 "twoway's and dash's default dot are `q16tw' outline widths across, outline included"
    display as text "S06 end " c(current_date) " " c(current_time)
}
