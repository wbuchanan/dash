// Each case runs dash with the alias and with the option twoway
// factors it onto, and compares the plot options dash writes (the
// spec _dash_serve_spec builds); twoway draws the alias's SVG as the
// target's (test/fixtures/alias_truth.json P1, P2, P3).  q4704_cmp
// sets $q4704_same (1 when the two plots' options are equal) and
// $q4704_opts (the first plot's options, as JSON).
capture program drop _q4704_run
program define _q4704_run
    version 19
    args tag cmd
    capture dash clear
    quietly log using "${q4704_dir}/q4704_`tag'.log", text replace name(q4704)
    capture noisily dash `cmd' name(q4704)
    local rc = _rc
    quietly log close q4704
    global q4704_rc_`tag' `rc'
    if !`rc' quietly _dash_serve_spec, specpath("${q4704_dir}/q4704_`tag's.json") datapath("${q4704_dir}/q4704_`tag'd.json")
    capture dash clear
end
python:
import json as _q4704_json
from sfi import Macro as _q4704_M
def _q4704_opts(tag):
    with open("%s/q4704_%ss.json" % (_q4704_M.getGlobal("q4704_dir"), tag), encoding="utf-8") as fh:
        d = _q4704_json.load(fh)
    return [p.get("options") for g in d.get("graphs", []) for p in g.get("plots", [])]

def _q4704_cmp(a, b):
    x, y = _q4704_opts(a), _q4704_opts(b)
    _q4704_M.setGlobal("q4704_same", "1" if x == y else "0")
    _q4704_M.setGlobal("q4704_opts", _q4704_json.dumps(x[0] if x else {}, sort_keys=True))

end

* ==== S04 basic:PT-10: older spellings ====
local only : env WP47_ONLY
if inlist("`only'", "", "S04") & `: list posof "S04" in w47_run' {
    display as text "S04 start " c(current_date) " " c(current_time)
    global q4704_dir "`w47_work'"

    // ------------------------------------------------------------
    // Q4704-1: scatter symbol(Oh) is msymbol(Oh) -- rc 0, no note, the
    // marker hollow -- and drawn over msymbol() in either order, as twoway
    // draws it (pairs msymbol_symbol); msymangle(45) is msangle(45), and
    // msangle() is drawn over it (msymangle P2, P3); mlabels(make) and
    // mlabels(t*) are mlabel()'s, the rightmost copy drawn.
    // ------------------------------------------------------------
    sysuse auto, clear
    local q1n 0
    foreach q1 in "symbol(Oh)|msymbol(Oh)" "msymbol(T) symbol(Oh)|msymbol(Oh)" "symbol(Oh) msymbol(T)|msymbol(Oh)" "msymbol(T) msymangle(45)|msymbol(T) msangle(45)" "msymbol(T) msangle(10) msymangle(45)|msymbol(T) msangle(10)" "msymbol(T) msymangle(45) msangle(10)|msymbol(T) msangle(10)" "mlabels(make)|mlabel(make)" "mlabels(t*)|mlabel(t*)" "mlabel(make) mlabels(foreign)|mlabel(foreign)" "mlabels(foreign) mlabel(make)|mlabel(make)" {
        local ++q1n
        gettoken qa qb : q1, parse("|")
        local qb = substr(`"`qb'"', 2, .)
        _q4704_run a`q1n' `"scatter mpg weight in 1/10, `qa'"'
        _q4704_run b`q1n' `"scatter mpg weight in 1/10, `qb'"'
        _w47_expect Q4704-1 "(${q4704_rc_a`q1n'} == 0 & ${q4704_rc_b`q1n'} == 0)" `"`qa': rc ${q4704_rc_a`q1n'}, `qb': rc ${q4704_rc_b`q1n'}"'
        cert_log_has "${q4704_dir}/q4704_a`q1n'.log", needle("unsupported option")
        _w47_expect Q4704-1 "(r(found) == 0)" `"`qa': the note is printed"'
        if ${q4704_rc_a`q1n'} == 0 & ${q4704_rc_b`q1n'} == 0 {
            python: _q4704_cmp("a`q1n'", "b`q1n'")
            _w47_expect Q4704-1 "(${q4704_same} == 1)" `"`qa' writes ${q4704_opts}, not `qb''s"'
        }
    }
    _w47_done Q4704-1 "symbol(), msymangle() and mlabels() are read as msymbol(), msangle() and mlabel(), with twoway's precedence, and not named"

    // ------------------------------------------------------------
    // Q4704-2: bar bcolor(red) blwidth(thick) is acolor(red) alwidth(thick)
    // -- rc 0, no note; bcolor() is drawn over acolor() and alcolor(),
    // afcolor() gives way to fcolor() and bcolor(), fintensity() is drawn
    // over bfintensity() over afintensity(), and the shortest spellings
    // (bc, bfi, blw, blp, afc, afi) are read (alias_truth.json pairs, P4).
    // ------------------------------------------------------------
    local q2n 0
    foreach q2 in "bcolor(red) blwidth(thick)|acolor(red) alwidth(thick)" "bc(red) blw(thick) blp(dash)|acolor(red) alwidth(thick) alpattern(dash)" "acolor(blue) bcolor(red)|acolor(red)" "bcolor(red) alcolor(blue)|acolor(red)" "afcolor(red)|fcolor(red)" "afc(red) fcolor(blue)|fcolor(blue)" "bcolor(blue) afcolor(red)|acolor(blue)" "bfi(30)|fintensity(30)" "afi(30) bfintensity(80)|fintensity(80)" "fintensity(30) afintensity(80) bfintensity(50)|fintensity(30)" "alwidth(thin) blwidth(thick) alpattern(dot) blpattern(dash)|alwidth(thick) alpattern(dash)" {
        local ++q2n
        gettoken qa qb : q2, parse("|")
        local qb = substr(`"`qb'"', 2, .)
        _q4704_run c`q2n' `"bar mpg weight in 1/10, `qa'"'
        _q4704_run d`q2n' `"bar mpg weight in 1/10, `qb'"'
        _w47_expect Q4704-2 "(${q4704_rc_c`q2n'} == 0 & ${q4704_rc_d`q2n'} == 0)" `"`qa': rc ${q4704_rc_c`q2n'}, `qb': rc ${q4704_rc_d`q2n'}"'
        cert_log_has "${q4704_dir}/q4704_c`q2n'.log", needle("unsupported option")
        _w47_expect Q4704-2 "(r(found) == 0)" `"`qa': the note is printed"'
        if ${q4704_rc_c`q2n'} == 0 & ${q4704_rc_d`q2n'} == 0 {
            python: _q4704_cmp("c`q2n'", "d`q2n'")
            _w47_expect Q4704-2 "(${q4704_same} == 1)" `"`qa' writes ${q4704_opts}, not `qb''s"'
        }
    }
    _w47_done Q4704-2 "bcolor(), blwidth(), blpattern(), afcolor(), afintensity() and bfintensity() are read as their targets, with twoway's precedence, and not named"

    // ------------------------------------------------------------
    // Q4704-3: pcarrow bmsize(3) is barbsize(3) (twoway: one SVG,
    // alias_truth.json bmsize P1), drawn over barbsize() (pairs
    // barbsize_bmsize), bmsi() read; off the arrows bmsize() stays named
    // and bsymbol() is named as bmsymbol(), the back marker 47-05 draws.
    // ------------------------------------------------------------
    local q3n 0
    foreach q3 in "bmsize(3)|barbsize(3)" "barbsize(1) bmsize(3)|barbsize(3)" "bmsi(3)|barbsize(3)" {
        local ++q3n
        gettoken qa qb : q3, parse("|")
        local qb = substr(`"`qb'"', 2, .)
        _q4704_run e`q3n' `"pcarrow mpg weight trunk turn in 1/10, `qa'"'
        _q4704_run f`q3n' `"pcarrow mpg weight trunk turn in 1/10, `qb'"'
        _w47_expect Q4704-3 "(${q4704_rc_e`q3n'} == 0 & ${q4704_rc_f`q3n'} == 0)" `"`qa': rc ${q4704_rc_e`q3n'}"'
        cert_log_has "${q4704_dir}/q4704_e`q3n'.log", needle("unsupported option")
        _w47_expect Q4704-3 "(r(found) == 0)" `"`qa': the note is printed"'
        if ${q4704_rc_e`q3n'} == 0 & ${q4704_rc_f`q3n'} == 0 {
            python: _q4704_cmp("e`q3n'", "f`q3n'")
            _w47_expect Q4704-3 "(${q4704_same} == 1)" `"`qa' writes ${q4704_opts}, not `qb''s"'
        }
    }
    _q4704_run g1 "scatter mpg weight in 1/10, bmsize(3)"
    cert_log_has "${q4704_dir}/q4704_g1.log", needle("unsupported option(s): bmsize()")
    _w47_expect Q4704-3 "(${q4704_rc_g1} == 0 & r(found) == 1)" "scatter bmsize(3): rc ${q4704_rc_g1}, bmsize() not named"
    _q4704_run g2 "scatter mpg weight in 1/10, bmsymbol(T) bsymbol(O)"
    cert_log_has "${q4704_dir}/q4704_g2.log", needle("unsupported option(s): bmsymbol()")
    _w47_expect Q4704-3 "(${q4704_rc_g2} == 0 & r(found) == 1)" "scatter bsymbol(O): rc ${q4704_rc_g2}, not named as bmsymbol()"
    _w47_done Q4704-3 "bmsize() on pcarrow is barbsize(); off the arrows bmsize() and bsymbol() (as bmsymbol()) stay named"

    macro drop q4704_*
    display as text "S04 end " c(current_date) " " c(current_time)
}
* ==== end S04 ====

* ==== S06 PIC-2: twoway's marker shapes and msymbol(invisible) ====
local only : env WP47_ONLY
if inlist("`only'", "", "S06") & `: list posof "S06" in w47_run' {
    display as text "S06 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4706-1: twoway draws D as a square on its point, as wide as it is
    // tall (its SVG polygon's box, live); dash's page draws it with the
    // @dash_diamond marker and carries that marker's defs function.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway scatter mpg weight in 1/3, msymbol(D) msize(vlarge) name(q4706d, replace)
    cert_svg_export, name(q4706d) file("`w47_work'/q4706d.svg")
    python: import re as _re4706; _t = open(r"`w47_work'/q4706d.svg").read(); _p = _re4706.findall(r'<polygon[^>]* points="([^"]+)"', _t)[0]; _n = [float(v) for v in _re4706.findall(r"-?[0-9.]+", _p)]; _xs, _ys = _n[0::2], _n[1::2]; from sfi import Macro as _M4706; _M4706.setLocal("q1wh", "%.3f" % ((max(_xs) - min(_xs)) / (max(_ys) - min(_ys))))
    capture erase "`w47_work'/q4706d.svg"
    capture graph drop q4706d
    _w47_expect Q4706-1 "(abs(`q1wh' - 1) < 0.05)" "twoway's diamond is `q1wh' as wide as tall"
    local q1f "`w47_work'/q4706_1.html"
    capture erase "`q1f'"
    dash clear
    capture noisily dash scatter mpg weight in 1/3, msymbol(D) name(q4706a)
    local q1rc = _rc
    capture noisily dash build, saving("`q1f'", replace) nobrowser
    local q1brc = _rc
    _w47_expect Q4706-1 "(`q1rc' == 0 & `q1brc' == 0)" "dash msymbol(D) rc `q1rc', build rc `q1brc'"
    cert_file_has "`q1f'", needle("@dash_diamond")
    _w47_expect Q4706-1 "(r(count) >= 2)" "the page names @dash_diamond `r(count)' times (marker and defs)"
    cert_file_has "`q1f'", needle("const {ctx, i, r, visuals} = cb_data;")
    _w47_expect Q4706-1 "(r(count) >= 1)" "the page holds no function-form defs body"
    capture erase "`q1f'"
    dash clear
    _w47_done Q4706-1 "twoway's diamond w/h `q1wh'; dash draws @dash_diamond with its defs"

    // ------------------------------------------------------------
    // Q4706-2: msymbol(invisible) is no Stata symbol: twoway notes it and
    // draws the default (live); dash prints the same note and draws.
    // ------------------------------------------------------------
    local lf "`w47_work'/q4706_2tw.log"
    capture erase "`lf'"
    quietly log using "`lf'", text replace name(q47062t)
    capture noisily twoway scatter mpg weight in 1/3, msymbol(invisible) name(q4706i, replace)
    local q2trc = _rc
    quietly log close q47062t
    capture graph drop q4706i
    cert_log_has "`lf'", needle("named style invisible not found in class symbol")
    _w47_expect Q4706-2 "(`q2trc' == 0 & r(count) == 1)" "twoway msymbol(invisible) rc `q2trc', note count `r(count)'"
    local lf "`w47_work'/q4706_2.log"
    capture erase "`lf'"
    quietly log using "`lf'", text replace name(q47062)
    dash clear
    capture noisily dash scatter mpg weight in 1/3, msymbol(invisible) name(q4706b)
    local q2rc = _rc
    capture noisily dash build, saving("`w47_work'/q4706_2.html", replace) nobrowser
    local q2brc = _rc
    quietly log close q47062
    _w47_expect Q4706-2 "(`q2rc' == 0 & `q2brc' == 0)" "dash msymbol(invisible) rc `q2rc', build rc `q2brc'"
    cert_log_has "`lf'", needle("invisible")
    _w47_expect Q4706-2 "(r(count) >= 1)" "dash does not note msymbol(invisible)"
    capture erase "`w47_work'/q4706_2.html"
    dash clear
    _w47_done Q4706-2 "twoway and dash both note msymbol(invisible) and draw"
    display as text "S06 end " c(current_date) " " c(current_time)
}
* ==== end S06 ====

* ==== S06 DG-12: zero- and missing-weight markers ====
local only : env WP47_ONLY
if inlist("`only'", "", "S06") & `: list posof "S06" in w47_run' {
    display as text "S06 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4706-5: twoway draws a zero-weight marker as its minimal dot, a
    // ring of radius under one unit (live SVG); dash's page draws the
    // size-zero row through the transform that floors it
    // (_DASH_ZERO_WEIGHT_PX), where BokehJS would stroke nothing.
    // ------------------------------------------------------------
    sysuse auto, clear
    keep in 1/8
    generate wz = cond(_n == 1, 0, price)
    quietly twoway scatter mpg weight [aw=wz], name(q4706w, replace)
    cert_svg_export, name(q4706w) file("`w47_work'/q4706w.svg")
    python: import re as _re4706; _t = open(r"`w47_work'/q4706w.svg").read(); _r = [float(v) for v in _re4706.findall(r'<circle[^>]* r="([0-9.]+)"', _t)]; from sfi import Macro as _M4706; _M4706.setLocal("q5n", str(sum(1 for v in _r if v < 1)))
    capture erase "`w47_work'/q4706w.svg"
    capture graph drop q4706w
    _w47_expect Q4706-5 "(`q5n' >= 1)" "twoway draws `q5n' rings under one unit for the zero weight"
    local q5f "`w47_work'/q4706_5.html"
    capture erase "`q5f'"
    dash clear
    capture noisily dash scatter mpg weight [aw=wz], name(q4706z)
    local q5rc = _rc
    capture noisily dash build, saving("`q5f'", replace) nobrowser
    local q5brc = _rc
    _w47_expect Q4706-5 "(`q5rc' == 0 & `q5brc' == 0)" "dash [aw=wz] rc `q5rc', build rc `q5brc'"
    cert_file_has "`q5f'", needle("(v === 0 ? z : v)")
    _w47_expect Q4706-5 "(r(count) >= 1)" "the page has no size-zero floor for the weighted markers"
    capture erase "`q5f'"
    dash clear
    _w47_done Q4706-5 "twoway draws a minimal dot (`q5n' small rings); dash floors size zero"
    display as text "S06 end " c(current_date) " " c(current_time)
}
* ==== end S06 ====

* ==== S06 basic:PT-15: the documented plain-type differences ====
