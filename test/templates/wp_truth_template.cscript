*! test_wp@@WP@@_truth.cscript
*! WP-@@WP@@'s ONE certification script (.ultraplan/sections/index.md PD-6):
*! every comparison with twoway's drawing or with Stata's own values that
*! WP-@@WP@@'s sections need lives here, one block per GAPS4 row (or per
*! harness tool), appended above the "append new blocks above this line"
*! marker in section order.  Refusal, message and return-code checks join
*! the EXISTING script for their area (merge rule R1).
*!
*! Made from test/templates/wp_truth_template.cscript (@@WP@@ -> the WP's
*! number).  S00 is the scaffold smoke (Q@@WP@@00-1).  A section appends
*! `* ==== S<MM> <lead id>: <what> ====` ... `* ==== end S<MM> ====` (or
*! `S<MM> tool: <what>` for a section with no item), its helper programs
*! directly above its first header, and writes only inside its own
*! blocks.  Case ids are Q@@WP@@<MM>-<k> (PD-5).
*!
*! Usage: via run_all_cscripts.do.  One block alone: WP@@WP@@_ONLY=S<MM> in
*! the driver's environment.  Each block prints "S<MM> start" and "S<MM>
*! end" with the date and time.  The suite runs it in every session;
*! DASH_CERT_SHARD=k/N runs part k of N of the blocks; a part with no
*! block ends 0.

cscript "WP-@@WP@@ truth: twoway comparisons" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off


do "cert_helpers.do"
quietly do "cert_svg.do"
qui run "../dash_parse.mata"
qui run "../dash.ado"
global dash_nobrowser 1

// ----------------------------------------------------------------
// Tally helpers -- test_wp29_truth.cscript's _w29_expect/_w29_done,
// renamed _w@@WP@@_ for this script.  A case is any number of
// _w@@WP@@_expect lines closed by one _w@@WP@@_done.
// ----------------------------------------------------------------
global w@@WP@@_nfail    = 0
global w@@WP@@_faillist ""
global w@@WP@@_bad      = 0
global w@@WP@@_ncase    = 0

capture program drop _w@@WP@@_expect
program define _w@@WP@@_expect
    version 19
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global w@@WP@@_bad = 1
    }
end

capture program drop _w@@WP@@_done
program define _w@@WP@@_done
    version 19
    args id msg
    if ${w@@WP@@_bad} {
        global w@@WP@@_nfail    = ${w@@WP@@_nfail} + 1
        global w@@WP@@_faillist "${w@@WP@@_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global w@@WP@@_bad   = 0
    global w@@WP@@_ncase = ${w@@WP@@_ncase} + 1
end

// A fresh directory for this run's files, never one that already exists:
// a fixed name in a shared temp directory could be planted by another
// account (rule 1), so a name Stata has not handed out before is made and
// the run fails if it cannot be.  Every block writes only under it.
tempfile w@@WP@@_base
local w@@WP@@_work "`w@@WP@@_base'_w@@WP@@"
capture mkdir "`w@@WP@@_work'"
if _rc {
    display as error "test_wp@@WP@@_truth: cannot create the work directory `w@@WP@@_work' (rc `=_rc')"
    exit 9
}

// ---- parts: begin (WP-@@WP@@ test performance) ----
// The certification suite runs this script in every one of its sessions
// (its row in run_all_cscripts.do's shard table is "* * *"); with
// DASH_CERT_SHARD=k/N set, the session runs part k of N of the blocks.
// The parts are balanced longest first onto the least loaded part (the
// lowest numbered of equals), by the seconds below -- a block not listed
// counts 1 s (section-01 D-01.f) -- the rule scripts/cert_shards.py uses
// for the scripts.  Unset, or with WP@@WP@@_ONLY set
// (which keeps its precedence), every block runs.  A block runs when its
// gate finds its id in w@@WP@@_run.
// Seconds: each block's start/end lines in the WP's last measured
// certification run, rounded up, at least 1; a block not listed
// counts 1 s.
local w@@WP@@_secs S00 1
local w@@WP@@_sh : environment DASH_CERT_SHARD
mata: st_local("w@@WP@@_ok", strofreal(st_local("w@@WP@@_sh") == "" | ustrregexm(st_local("w@@WP@@_sh"), "^[1-8]/[1-8]$")))
if !`w@@WP@@_ok' {
    display as error "test_wp@@WP@@_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 8"
    exit 198
}
local w@@WP@@_k 1
local w@@WP@@_N 1
if "`w@@WP@@_sh'" != "" {
    local w@@WP@@_k = real(substr("`w@@WP@@_sh'", 1, 1))
    local w@@WP@@_N = real(substr("`w@@WP@@_sh'", 3, 1))
}
local w@@WP@@_only : env WP@@WP@@_ONLY
if `"`macval(w@@WP@@_only)'"' != "" | `w@@WP@@_N' == 1 {
    local w@@WP@@_k 1
    local w@@WP@@_N 1
}
if `w@@WP@@_k' > `w@@WP@@_N' {
    display as error "test_wp@@WP@@_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 8"
    exit 198
}
capture confirm file "test_wp@@WP@@_truth.cscript"
if _rc {
    display as error "test_wp@@WP@@_truth: run it from test/, where it reads its own blocks"
    exit 601
}
capture mata: mata drop _w@@WP@@_part()
mata:
// The ids of the blocks (their header lines, in file order), and those of
// part k of n: longest first onto the least loaded part.
void _w@@WP@@_part(string scalar file, string scalar table, real scalar k,
               real scalar n)
{
    string colvector lines, ids
    string rowvector tok
    real colvector sec, o, at
    real rowvector load
    real scalar i, j, p, best
    string scalar run

    lines = cat(file)
    ids = J(0, 1, "")
    for (i = 1; i <= rows(lines); i++) {
        if (ustrregexm(lines[i], "^\* ==== (S[0-9]+) ")) {
            if (!anyof(ids, ustrregexs(1))) ids = ids \ ustrregexs(1)
        }
    }
    sec = J(rows(ids), 1, 1)
    tok = tokens(table)
    for (j = 1; j + 1 <= cols(tok); j = j + 2) {
        for (i = 1; i <= rows(ids); i++) {
            if (ids[i] == tok[j]) sec[i] = strtoreal(tok[j + 1])
        }
    }
    o = order((-sec, (1::rows(ids))), (1, 2))
    load = J(1, n, 0)
    at = J(rows(ids), 1, 0)
    for (i = 1; i <= rows(o); i++) {
        best = 1
        for (p = 2; p <= n; p++) if (load[p] < load[best]) best = p
        load[best] = load[best] + sec[o[i]]
        at[o[i]] = best
    }
    run = ""
    for (i = 1; i <= rows(ids); i++) if (at[i] == k) run = run + " " + ids[i]
    st_local("w@@WP@@_run", strtrim(run))
}
end
// The part this session runs: the runner's shard table may turn the
// parts (cert_helpers.do's cert_split_part, 11nov2026), so that
// each script's longest part lands on a different session.
cert_split_part "test_wp@@WP@@_truth.cscript" `w@@WP@@_k' `w@@WP@@_N'
local w@@WP@@_p = r(part)
mata: _w@@WP@@_part("test_wp@@WP@@_truth.cscript", st_local("w@@WP@@_secs"), `w@@WP@@_p', `w@@WP@@_N')
display as text "test_wp@@WP@@_truth: session `w@@WP@@_k'/`w@@WP@@_N' runs part `w@@WP@@_p', `: word count `w@@WP@@_run'' blocks: `w@@WP@@_run'"
// ---- parts: end ----

* ==== S00 scaffold: the helpers load and a twoway SVG is read ====
local only : env WP@@WP@@_ONLY
if inlist("`only'", "", "S00") & `: list posof "S00" in w@@WP@@_run' {
    display as text "S00 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q@@WP@@00-1: cert_svg_export and cert_svg_texts on one twoway scatter,
    // and dash's own programs are loaded from this tree.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(w@@WP@@s01, replace)
    cert_svg_export, name(w@@WP@@s01) file("`w@@WP@@_work'/w@@WP@@s01.svg")
    local s01_rc   = r(rc)
    local s01_file "`r(file)'"
    _w@@WP@@_expect Q@@WP@@00-1 "(`s01_rc' == 0)" "cert_svg_export rc `s01_rc'"
    capture confirm file "`s01_file'"
    _w@@WP@@_expect Q@@WP@@00-1 "(_rc == 0)" "r(file) `s01_file' does not exist"
    cert_svg_texts, file("`s01_file'")
    local s01_n    = r(n)
    local s01_list "`r(list)'"
    _w@@WP@@_expect Q@@WP@@00-1 "(`s01_n' > 0)" "cert_svg_texts found no text elements"
    capture program list _dash_serve
    _w@@WP@@_expect Q@@WP@@00-1 "(_rc == 0)" "dash.ado's _dash_serve is not loaded"
    _w@@WP@@_done Q@@WP@@00-1 "a twoway SVG was written and read (`s01_n' texts); dash is loaded"

    capture erase "`s01_file'"
    capture erase "`s01_list'"
    capture graph drop w@@WP@@s01
    display as text "S00 end " c(current_date) " " c(current_time)
}
* ==== end S00 ====

* ==== append new blocks above this line ====

// ----------------------------------------------------------------
// Summary (test_wp29_truth.cscript's shape)
// ----------------------------------------------------------------
capture graph drop _all
capture dash clear
capture rmdir "`w@@WP@@_work'"
local nfail    = ${w@@WP@@_nfail}
local faillist "${w@@WP@@_faillist}"
local ncase    = ${w@@WP@@_ncase}
local only : env WP@@WP@@_ONLY
macro drop w@@WP@@_nfail w@@WP@@_faillist w@@WP@@_bad w@@WP@@_ncase
display as text ""
display as text "============================================================"
if `ncase' == 0 {
    if `w@@WP@@_N' > 1 & `"`macval(only)'"' == "" & "`w@@WP@@_run'" == "" {
        display as text "test_wp@@WP@@_truth: part `w@@WP@@_k'/`w@@WP@@_N' has no block to run"
        display as text "============================================================"
        exit 0
    }
    // A WP@@WP@@_ONLY that names no block, or only a stub, ran nothing:
    // that is not a pass.
    display as error "  test_wp@@WP@@_truth: no case ran (WP@@WP@@_ONLY=`only')"
    display as text "============================================================"
    exit 9
}
else if `nfail' == 0 {
    display as text "  test_wp@@WP@@_truth: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_wp@@WP@@_truth: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
