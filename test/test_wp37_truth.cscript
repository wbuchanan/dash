        _w37_expect Q3705-3 "(_rc == 0)" "dash line mpg weight, sort (build `s05_k') rc `=_rc'"
        python: _w37s05_ties(r"`w37_work'/s05_ties`s05_k'.html", "3370 3600 4060")
        local s05_all "`s05_all' ${w37s05_ties}"
