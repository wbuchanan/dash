local only : env WP37_ONLY
if inlist("`only'", "", "S05") & `: list posof "S05" in w37_run' {
    display as text "S05 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3705-3: dash line mpg weight, sort joins the cars of equal
    // weight 3370, 3600 and 4060 in the data's order, the same in two
    // builds (twoway's order among ties changes from run to run, so it
    // is not compared).
