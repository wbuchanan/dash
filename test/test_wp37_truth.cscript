// S06 helpers (WP-37 TR-13a).  _w37s06_opts: "outlines=<v>"
// of graph <g>'s first plot in a served spec, into global w37s06_v.
// _w37s06_page: what a saved page draws for its contour key and parts --
// "<bar line colour> <key line colour> <key lines> <key levels>" per
// ContourColorBar, then "lines=<renderers tagged dash_contour_lines>",
// into w37s06_v.
// _w37s06_svg: of a twoway SVG, "<black key-box strokes> <filled
// rectangles in the plot region> <MD5 of the plot region's shapes>",
// into w37s06_v.
python:
def _w37s06_opts(path, g):
    try:
        d = _w37s02_json.load(open(path, encoding="utf-8"))
        [gr] = [x for x in d["graphs"]
                if x.get("graph_options", {}).get("name") == g]
        o = gr["plots"][0].get("options", {})
        v = "outlines=%s" % o.get("outlines", "")
    except Exception as e:
        v = "error " + str(e)
    _w37s02_M.setGlobal("w37s06_v", _w37s02_safe(v))


def _w37s06_page(path):
    out = []
    try:
        objs = _w37s02_objs(path)

        def cols(src):
            data = src.get("data", {})
            return {e[0]: e[1] for e in data.get("entries", [])} \
                if isinstance(data, dict) and "entries" in data else data
        # Flipped (WP-42 CV-3): the key is a key cell, not a
        # ContourColorBar: its swatches' outline colour and how many boxes
        # it draws, as twoway's key boxes are counted.
        for _t, _tk, lc, n in _w37_keycells(objs):
            out.append("%s %d" % (lc, n))
        nl = 0
        for o in objs.values():
            a = o.get("attributes") or {}
            tags = a.get("tags") or []
            if o.get("name") == "ContourRenderer" and "dash_contour_lines" in tags:
                nl += 1
        out.append("lines=%d" % nl)
        v = ";".join(out)
    except Exception as e:
        v = "error " + str(e)
    _w37s02_M.setGlobal("w37s06_v", _w37s02_safe(v))


def _w37s06_svg(path):
    import hashlib
    try:
        txt = open(path, encoding="utf-8").read()
        rects = _w37s02_re.findall(r'<rect x="([0-9.]+)" y="[0-9.]+" width="([0-9.]+)"', txt)
        right = [float(x) + float(w) for x, w in rects][3]
        defs = dict(_w37s02_re.findall(r'<path id="([^"]+)" d="([^"]*)"', txt))
        black, filled_rects, plot = 0, 0, []
        for pid, st in _w37s02_re.findall(r'<use xlink:href="#([^"]+)"[^>]*? style="([^"]*)"', txt):
            d = defs.get(pid, "")
            pts = [(float(a), float(b)) for a, b in _w37s02_re.findall(r"[ML]\s*(-?[0-9.]+)[ ,]+(-?[0-9.]+)", d)]
            if not pts:
                continue
            if all(p[0] > right for p in pts):
                # Black at twice the scheme's medium line (19.44 under
                # stcolor, 17.28 under s2color), clipped to the box.
                if "fill:none;stroke:#000000;" in st:
                    black += 1
                continue
            plot.append(d + "|" + st)
            last = pts[-5:]
            if ("fill:none" not in st and len(last) == 5
                    and len({round(p[0], 2) for p in last}) == 2
                    and len({round(p[1], 2) for p in last}) == 2):
                filled_rects += 1
        v = "%d %d %s" % (black, filled_rects,
                          hashlib.md5("\n".join(sorted(plot)).encode()).hexdigest())
    except Exception as e:
        v = "error " + str(e)
    _w37s02_M.setGlobal("w37s06_v", _w37s02_safe(v))
end

* ==== S06 TR-13a: contour's outlines ====
local only : env WP37_ONLY
if inlist("`only'", "", "S06") & `: list posof "S06" in w37_run' {
    display as text "S06 start " c(current_date) " " c(current_time)
    local s06_h "`w37_work'/s06.html"
    local s06_s "`w37_work'/s06.json"
    local s06_d "`w37_work'/s06d.json"
    local s06_g "`w37_work'/s06.svg"

    // ------------------------------------------------------------
    // Q3706-1: the real ado path -- contour and contourline with outlines
    // carry it in the served spec (s(_outlines) never reached it).
    // ------------------------------------------------------------
    sysuse sandstone, clear
    capture dash clear
    dash contour depth northing easting, outlines name(q6a)
    dash contourline depth northing easting, outlines name(q6b)
    capture erase "`s06_s'"
    _dash_serve_spec, specpath("`s06_s'") datapath("`s06_d'")
    foreach g in q6a q6b {
        python: _w37s06_opts(r"`s06_s'", "`g'")
        _w37_expect Q3706-1 `"("${w37s06_v}" == "outlines=outlines")"' "`g': ${w37s06_v}"
    }
    capture dash clear
    _w37_done Q3706-1 "the spec carries outlines"

    // ------------------------------------------------------------
    // Q3706-2: sandstone (twoway's generator): twoway's outlines draws
    // the plot region as without it and strokes the key's 5 boxes black
    // (measured here); dash draws the bands from the generator
    // (contour_gen_truth.json sandstone.default), no boundary lines, and
    // the key outlined black, one key line per level.
    // ------------------------------------------------------------
    local s06_c "depth northing easting"
    foreach o in "" "outlines" {
        capture graph drop w37s06
        quietly twoway contour `s06_c', `o' name(w37s06)
        capture erase "`s06_g'"
        cert_svg_export, name(w37s06) file("`s06_g'")
        python: _w37s06_svg(r"`s06_g'")
        local s06_tw`o' "${w37s06_v}"
    }
    capture graph drop w37s06
    _w37_expect Q3706-2 `"(word("`s06_tw'", 1) == "0" & word("`s06_twoutlines'", 1) == "5")"' "twoway's black key boxes: `s06_tw' / `s06_twoutlines'"
    _w37_expect Q3706-2 `"(word("`s06_tw'", 3) == word("`s06_twoutlines'", 3))"' "twoway's plot region differs under outlines"
    capture erase "`s06_h'"
    capture noisily dash contour `s06_c', outlines saving("`s06_h'", replace)
    _w37_expect Q3706-2 "(_rc == 0)" "dash contour, outlines rc `=_rc'"
    python: _w37s06_page(r"`s06_h'")
    // Flipped (WP-42 CV-3): the key cell's boxes, outlined black, one a
    // box twoway strokes (was a ContourColorBar's outline and level lines).
    _w37_expect Q3706-2 `"("${w37s06_v}" == "#000000 `=word("`s06_twoutlines'", 1)';lines=0")"' "dash: ${w37s06_v}, twoway `s06_twoutlines'"
    python: _w37s03_fill(r"`s06_h'")
    local got "${w37s03_v}"
    python: _w37s03_fix("sandstone.default", "polys_per_band")
    _w37_expect Q3706-2 `"("`got'" == "${w37s03_f}")"' "polygons per band `got', twoway ${w37s03_f}"
    _w37_done Q3706-2 "sandstone outlines: twoway's plot, the key outlined (${w37s06_v})"

    // ------------------------------------------------------------
    // Q3706-3: auto (dash's own fit): twoway outlines the key's 3 boxes
    // and leaves the plot region; dash outlines its key, draws no
    // boundary lines.
    // ------------------------------------------------------------
    sysuse auto, clear
    foreach o in "" "outlines" {
        capture graph drop w37s06
        quietly twoway contour price mpg weight, `o' name(w37s06)
        capture erase "`s06_g'"
        cert_svg_export, name(w37s06) file("`s06_g'")
        python: _w37s06_svg(r"`s06_g'")
        local s06_tw`o' "${w37s06_v}"
    }
    capture graph drop w37s06
    _w37_expect Q3706-3 `"(word("`s06_tw'", 1) == "0" & word("`s06_twoutlines'", 1) == "3")"' "twoway's black key boxes: `s06_tw' / `s06_twoutlines'"
    _w37_expect Q3706-3 `"(word("`s06_tw'", 3) == word("`s06_twoutlines'", 3))"' "twoway's plot region differs under outlines"
    capture erase "`s06_h'"
    capture noisily dash contour price mpg weight, outlines saving("`s06_h'", replace)
    _w37_expect Q3706-3 "(_rc == 0)" "dash contour, outlines rc `=_rc'"
    python: _w37s06_page(r"`s06_h'")
    // Flipped (WP-42 CV-3): the key cell's boxes, outlined black, one a
    // box twoway strokes.
    _w37_expect Q3706-3 `"("${w37s06_v}" == "#000000 `=word("`s06_twoutlines'", 1)';lines=0")"' "dash: ${w37s06_v}, twoway `s06_twoutlines'"
    _w37_done Q3706-3 "auto outlines: the key outlined, no boundary lines (${w37s06_v})"

    // Q3706-4 retired with the option contour no longer takes (D65).
    sysuse sandstone, clear

    // ------------------------------------------------------------
    // Q3706-5: contourline takes outlines and draws twoway's lines as
    // without it (sandstone.default.line, from the generator).
    // ------------------------------------------------------------
    python: _w37s03_fix("sandstone.default.line", "lines_per_cut")
    foreach o in outlines {
        capture erase "`s06_h'"
        capture noisily dash contourline `s06_c', `o' saving("`s06_h'", replace)
        _w37_expect Q3706-5 "(_rc == 0)" "contourline, `o' rc `=_rc'"
        python: _w37s03_lines(r"`s06_h'", "dash_contour")
        _w37_expect Q3706-5 `"(strpos("${w37s03_v}", "${w37s03_f}|") == 1)"' "contourline, `o': ${w37s03_v}, twoway ${w37s03_f}"
    }
    _w37_done Q3706-5 "contourline draws its lines as without outlines"
    capture erase "`s06_h'"
    capture erase "`s06_g'"
    capture erase "`s06_s'"
    capture erase "`s06_d'"
    capture dash clear
    macro drop w37s06_v
    display as text "S06 end " c(current_date) " " c(current_time)
}
* ==== end S06 ====

* ==== append new blocks above this line ====

// ----------------------------------------------------------------
// Summary (test_wp29_truth.cscript's shape)
// ----------------------------------------------------------------
capture graph drop _all
capture dash clear
capture rmdir "`w37_work'"
local nfail    = ${w37_nfail}
local faillist "${w37_faillist}"
local ncase    = ${w37_ncase}
local only : env WP37_ONLY
macro drop w37_nfail w37_faillist w37_bad w37_ncase
display as text ""
display as text "============================================================"
if `ncase' == 0 {
    if `w37_N' > 1 & `"`macval(only)'"' == "" & "`w37_run'" == "" {
        display as text "test_wp37_truth: part `w37_k'/`w37_N' has no block to run"
        display as text "============================================================"
        exit 0
    }
    // A WP37_ONLY that names no block, or only a stub, ran nothing:
    // that is not a pass.
    display as error "  test_wp37_truth: no case ran (WP37_ONLY=`only')"
    display as text "============================================================"
    exit 9
}
else if `nfail' == 0 {
    display as text "  test_wp37_truth: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_wp37_truth: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
