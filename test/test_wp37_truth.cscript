*! test_wp37_truth.cscript
*! WP-37's ONE certification script (.ultraplan/sections/index.md PD-6):
*! every comparison with twoway's drawing or with Stata's own values that
*! WP-37's sections need lives here, one block per GAPS4 row (or per
*! harness tool), appended above the "append new blocks above this line"
*! marker in section order.  Refusal, message and return-code checks join
*! the EXISTING script for their area (merge rule R1).
*!
*! Made from test/templates/wp_truth_template.cscript (37 -> the WP's
*! number).  S00 is the scaffold smoke (Q3700-1).  A section appends
*! `* ==== S<MM> <lead id>: <what> ====` ... `* ==== end S<MM> ====` (or
*! `S<MM> tool: <what>` for a section with no item), its helper programs
*! directly above its first header, and writes only inside its own
*! blocks.  Case ids are Q37<MM>-<k> (PD-5).
*!
*! Usage: via run_all_cscripts.do.  One block alone: WP37_ONLY=S<MM> in
*! the driver's environment.  Each block prints "S<MM> start" and "S<MM>
*! end" with the date and time.  The suite runs it in every session;
*! DASH_CERT_SHARD=k/N runs part k of N of the blocks; a part with no
*! block ends 0.

cscript "WP-37 truth: twoway comparisons" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off


do "cert_helpers.do"
quietly do "cert_svg.do"
qui run "../dash_parse.mata"
qui run "../dash.ado"
global dash_nobrowser 1

// ----------------------------------------------------------------
// Tally helpers -- test_wp29_truth.cscript's _w29_expect/_w29_done,
// renamed _w37_ for this script.  A case is any number of
// _w37_expect lines closed by one _w37_done.
// ----------------------------------------------------------------
global w37_nfail    = 0
global w37_faillist ""
global w37_bad      = 0
global w37_ncase    = 0

capture program drop _w37_expect
program define _w37_expect
    version 19
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global w37_bad = 1
    }
end

capture program drop _w37_done
program define _w37_done
    version 19
    args id msg
    if ${w37_bad} {
        global w37_nfail    = ${w37_nfail} + 1
        global w37_faillist "${w37_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global w37_bad   = 0
    global w37_ncase = ${w37_ncase} + 1
end

// A fresh directory for this run's files, never one that already exists:
// a fixed name in a shared temp directory could be planted by another
// account (rule 1), so a name Stata has not handed out before is made and
// the run fails if it cannot be.  Every block writes only under it.
tempfile w37_base
local w37_work "`w37_base'_w37"
capture mkdir "`w37_work'"
if _rc {
    display as error "test_wp37_truth: cannot create the work directory `w37_work' (rc `=_rc')"
    exit 9
}

// ---- parts: begin (WP-37 test performance) ----
// The certification suite runs this script in every one of its sessions
// (its row in run_all_cscripts.do's shard table is "* * *"); with
// DASH_CERT_SHARD=k/N set, the session runs part k of N of the blocks.
// The parts are balanced longest first onto the least loaded part (the
// lowest numbered of equals), by the seconds below -- a block not listed
// counts 1 s (section-01 D-01.f) -- the rule scripts/cert_shards.py uses
// for the scripts.  Unset, or with WP37_ONLY set
// (which keeps its precedence), every block runs.  A block runs when its
// gate finds its id in w37_run.
// Seconds: each block's start/end lines in the WP's last measured
// certification run, rounded up, at least 1; a block not listed
// counts 1 s.
local w37_secs S00 1 S01 8 S02 1 S03 10 S04 4 S05 1 S06 4
local w37_sh : environment DASH_CERT_SHARD
mata: st_local("w37_ok", strofreal(st_local("w37_sh") == "" | ustrregexm(st_local("w37_sh"), "^[1-8]/[1-8]$")))
if !`w37_ok' {
    display as error "test_wp37_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 8"
    exit 198
}
local w37_k 1
local w37_N 1
if "`w37_sh'" != "" {
    local w37_k = real(substr("`w37_sh'", 1, 1))
    local w37_N = real(substr("`w37_sh'", 3, 1))
}
local w37_only : env WP37_ONLY
if `"`macval(w37_only)'"' != "" | `w37_N' == 1 {
    local w37_k 1
    local w37_N 1
}
if `w37_k' > `w37_N' {
    display as error "test_wp37_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 8"
    exit 198
}
capture confirm file "test_wp37_truth.cscript"
if _rc {
    display as error "test_wp37_truth: run it from test/, where it reads its own blocks"
    exit 601
}
capture mata: mata drop _w37_part()
mata:
// The ids of the blocks (their header lines, in file order), and those of
// part k of n: longest first onto the least loaded part.
void _w37_part(string scalar file, string scalar table, real scalar k,
               real scalar n)
{
    string colvector lines, ids
    string rowvector tok
    real colvector sec, o, at
    real rowvector load
    real scalar i, j, p, best
    string scalar run

    lines = cat(file)
    ids = J(0, 1, "")
    for (i = 1; i <= rows(lines); i++) {
        if (ustrregexm(lines[i], "^\* ==== (S[0-9]+) ")) {
            if (!anyof(ids, ustrregexs(1))) ids = ids \ ustrregexs(1)
        }
    }
    sec = J(rows(ids), 1, 1)
    tok = tokens(table)
    for (j = 1; j + 1 <= cols(tok); j = j + 2) {
        for (i = 1; i <= rows(ids); i++) {
            if (ids[i] == tok[j]) sec[i] = strtoreal(tok[j + 1])
        }
    }
    o = order((-sec, (1::rows(ids))), (1, 2))
    load = J(1, n, 0)
    at = J(rows(ids), 1, 0)
    for (i = 1; i <= rows(o); i++) {
        best = 1
        for (p = 2; p <= n; p++) if (load[p] < load[best]) best = p
        load[best] = load[best] + sec[o[i]]
        at[o[i]] = best
    }
    run = ""
    for (i = 1; i <= rows(ids); i++) if (at[i] == k) run = run + " " + ids[i]
    st_local("w37_run", strtrim(run))
}
end
// The part this session runs: the runner's shard table may turn the
// parts (cert_helpers.do's cert_split_part, 11nov2026), so that
// each script's longest part lands on a different session.
cert_split_part "test_wp37_truth.cscript" `w37_k' `w37_N'
local w37_p = r(part)
mata: _w37_part("test_wp37_truth.cscript", st_local("w37_secs"), `w37_p', `w37_N')
display as text "test_wp37_truth: session `w37_k'/`w37_N' runs part `w37_p', `: word count `w37_run'' blocks: `w37_run'"
// ---- parts: end ----

* ==== S00 scaffold: the helpers load and a twoway SVG is read ====
local only : env WP37_ONLY
if inlist("`only'", "", "S00") & `: list posof "S00" in w37_run' {
    display as text "S00 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3700-1: cert_svg_export and cert_svg_texts on one twoway scatter,
    // and dash's own programs are loaded from this tree.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(w37s01, replace)
    cert_svg_export, name(w37s01) file("`w37_work'/w37s01.svg")
    local s01_rc   = r(rc)
    local s01_file "`r(file)'"
    _w37_expect Q3700-1 "(`s01_rc' == 0)" "cert_svg_export rc `s01_rc'"
    capture confirm file "`s01_file'"
    _w37_expect Q3700-1 "(_rc == 0)" "r(file) `s01_file' does not exist"
    cert_svg_texts, file("`s01_file'")
    local s01_n    = r(n)
    local s01_list "`r(list)'"
    _w37_expect Q3700-1 "(`s01_n' > 0)" "cert_svg_texts found no text elements"
    capture program list _dash_serve
    _w37_expect Q3700-1 "(_rc == 0)" "dash.ado's _dash_serve is not loaded"
    _w37_done Q3700-1 "a twoway SVG was written and read (`s01_n' texts); dash is loaded"

    capture erase "`s01_file'"
    capture erase "`s01_list'"
    capture graph drop w37s01
    display as text "S00 end " c(current_date) " " c(current_time)
}
* ==== end S00 ====

// S01's helpers (WP-37 DG-1): the fixture read into the current frame,
// each probe's one-line dash command, a command's message lines from its
// log, and a saved page's contour keys.
python:
import json as _w37s01_json
import re as _w37s01_re
from html import unescape as _w37s01_unescape
from sfi import Data as _w37s01_D
from sfi import Macro as _w37s01_M

_W37S01_CASE = {"a": "none", "b1": "none", "b2": "none", "c": "none",
                "d": "none", "f": "allmissing", "e1": "", "e2": "byempty"}


def _w37s01_safe(v):
    """v with no character that ends or expands a Stata string."""
    return str(v).replace('"', "'").replace("`", "'").replace("$", "S")[:400]


def _w37_keycells(objs):
    """Each colour key cell of a page's models *objs* ({id: model}), as
    (title, ticks, swatch line colour, swatches).  WP-42 CV-3: the contour
    key is a key cell -- a Plot tagged dash_key_cell, its title a Label
    named dash_key_title, its ticks on its z axis, its bands one Quad named
    dash_key_swatch -- where it was a ContourColorBar."""
    def ref(v):
        return objs.get(v.get("id"), v) if isinstance(v, dict) else {}

    def nums(v):
        if isinstance(v, dict):
            v = v.get("array", v.get("value", []))
        return [float(x) for x in v] if isinstance(v, list) else []

    def rows(src):
        data = (src.get("attributes") or {}).get("data", {})
        cols = data
        if isinstance(data, dict) and "entries" in data:
            cols = {e[0]: e[1] for e in data.get("entries", [])}
        c = cols.get("c") if isinstance(cols, dict) else None
        if isinstance(c, dict):
            c = c.get("array", c.get("value", []))
        return len(c) if isinstance(c, list) else 0
    out = []
    for b in objs.values():
        a = b.get("attributes") or {}
        if b.get("name") != "Plot" or "dash_key_cell" not in (a.get("tags") or []):
            continue
        title, ticks, lc, n = "", [], None, 0
        for side in ("left", "right", "above", "below", "center"):
            for m in a.get(side) or ():
                m = ref(m)
                ma = m.get("attributes") or {}
                if m.get("name") == "Label" and ma.get("name") == "dash_key_title":
                    title = ma.get("text", "")
                elif str(m.get("name", "")).endswith("Axis"):
                    ticks = nums((ref(ma.get("ticker")).get("attributes") or {}).get("ticks", []))
        for r in a.get("renderers") or ():
            ra = ref(r).get("attributes") or {}
            if ra.get("name") == "dash_key_swatch":
                g = ref(ra.get("glyph")).get("attributes") or {}
                lc = g.get("line_color")
                lc = lc.get("value") if isinstance(lc, dict) else lc
                n = rows(ref(ra.get("data_source")))
        out.append((title, ticks, lc, n))
    return out


def _w37s01_fx(path):
    with open(path, encoding="utf-8") as fh:
        return _w37s01_json.load(fh)


def _w37s01_fill(path):
    """The fixture's probes into the current (empty) frame: key, type
    (the horizontal variants under their type), the rule's case, rc and
    twoway's first two message lines."""
    d = _w37s01_fx(path)
    keys = sorted(k for k in d if k != "_meta")
    for v in ("key", "type", "case", "line1", "line2"):
        _w37s01_D.addVarStrL(v)
    _w37s01_D.addVarLong("rc")
    _w37s01_D.setObsTotal(len(keys))
    for i, k in enumerate(keys):
        t, c = k.rsplit(".", 1)
        ls = list(d[k]["lines"]) + ["", ""]
        _w37s01_D.storeAt("key", i, k)
        _w37s01_D.storeAt("type", i, t[:-2] if t.endswith("_h") else t)
        _w37s01_D.storeAt("case", i, _W37S01_CASE[c])
        _w37s01_D.storeAt("line1", i, ls[0])
        _w37s01_D.storeAt("line2", i, ls[1])
        _w37s01_D.storeAt("rc", i, int(d[k]["rc"]))


def _w37s01_dash(cmd, html):
    """cmd as one dash command with saving(html, replace) among the
    options of its last || segment."""
    depth, seg_start, i = 0, 0, 0
    while i < len(cmd):
        ch = cmd[i]
        if ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
        elif depth == 0 and cmd.startswith("||", i):
            seg_start = i + 2
            i += 1
        i += 1
    last, depth, comma = cmd[seg_start:], 0, False
    for ch in last:
        if ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
        elif ch == "," and depth == 0:
            comma = True
    sv = 'saving("%s", replace)' % html
    return cmd + (" " + sv if comma else ", " + sv)


def _w37s01_q2_list(path, html):
    """Globals w37s01_q2n and, for each probe Q3701-2 runs (every one
    twoway refuses, and every contour and contourline probe), w37s01_q2k_i
    (its key) and w37s01_q2c_i (its one-line dash command)."""
    d = _w37s01_fx(path)
    keys = [k for k in sorted(d) if k != "_meta"
            and (d[k]["rc"] or k.split(".")[0] in ("contour",
                                                   "contourline"))]
    for i, k in enumerate(keys, 1):
        _w37s01_M.setGlobal("w37s01_q2k_%d" % i, k)
        _w37s01_M.setGlobal("w37s01_q2c_%d" % i,
                            _w37s01_dash(d[k]["cmd"], html))
    _w37s01_M.setGlobal("w37s01_q2n", str(len(keys)))


def _w37s01_lines(log):
    try:
        with open(log, encoding="utf-8", errors="replace") as fh:
            text = fh.read()
    except OSError:
        return []
    return [ln.rstrip() for ln in text.replace("\n> ", "").splitlines()
            if ln.strip() and not ln.startswith(". ")]


def _w37s01_q2(path, key, log, rc):
    """Global w37s01_v: "" when dash's rc and first message line are
    twoway's (key's), and, refused, the next line after twoway's names the
    plot; else what differs."""
    r = _w37s01_fx(path)[key]
    got = _w37s01_lines(log)
    t = key.split(".")[0]
    t = t[:-2] if t.endswith("_h") else t
    v = ""
    if int(rc) != r["rc"]:
        v = "rc %s, twoway %d (%s)" % (rc, r["rc"], " | ".join(got[:3]))
    elif r["rc"]:
        n = len(r["lines"])
        if got[:n] != r["lines"]:
            v = "lines %r, twoway %r" % (got[:n], r["lines"])
        elif len(got) <= n or not _w37s01_re.match(
                r"dash: plot [0-9]+ \(%s\)" % _w37s01_re.escape(t), got[n]):
            v = "no plot line after twoway's: %r" % (got[n:n + 1],)
    _w37s01_M.setGlobal("w37s01_v", _w37s01_safe(v))


def _w37s01_after(twlog, dlog, line):
    """Global w37s01_v: "" when the dash log's lines are the twoway log's,
    then line; else what differs."""
    tw, got = _w37s01_lines(twlog), _w37s01_lines(dlog)
    want = tw + [line]
    v = "" if got[:len(want)] == want else "dash %r, want %r" % (got[:4], want)
    _w37s01_M.setGlobal("w37s01_v", _w37s01_safe(v))


def _w37s01_keys(path):
    """Global w37s01_keys: "<title>|<ticks>" for each ContourColorBar of
    the saved page path, ";"-joined."""
    out = []
    try:
        page = open(path, encoding="utf-8").read()
        m = _w37s01_re.search(
            r'<script[^>]+type=["\']application/json["\'][^>]*>', page)
        body = page[m.end():page.index("</script>", m.end())]
        objs, bars = {}, []

        def walk(node):
            if isinstance(node, dict):
                if "id" in node and "name" in node:
                    objs[node["id"]] = node
                    if node["name"] == "ContourColorBar":
                        bars.append(node)
                for v in node.values():
                    walk(v)
            elif isinstance(node, list):
                for v in node:
                    walk(v)

        walk(_w37s01_json.loads(_w37s01_unescape(body)))
        # Flipped (WP-42 CV-3): the key is a key cell, not a
        # ContourColorBar; its title and its z axis's ticks.
        for title, ticks, _lc, _n in _w37_keycells(objs):
            out.append("%s|%d" % (title, len(ticks)))
        _w37s01_M.setGlobal("w37s01_keys", _w37s01_safe(";".join(out)))
    except Exception as e:
        _w37s01_M.setGlobal("w37s01_keys", _w37s01_safe("error " + str(e)))
end

// _w37s01_log <log> <command>: the command run under a text log of its
// output alone (a program's commands are not echoed); its rc in the
// caller's local _w37s01_rc.
capture program drop _w37s01_log
program define _w37s01_log
    version 19
    gettoken f 0 : 0
    capture erase "`f'"
    quietly log using "`f'", text replace name(w37s01l) nomsg
    capture noisily `0'
    local rc = _rc
    quietly log close w37s01l
    c_local _w37s01_rc `rc'
end

capture mata: mata drop _w37s01_rules()
mata:
// The rows of the current frame (_w37s01_fill) _dash_zero_obs_rule
// answers otherwise than the fixture; the first five are printed.
real scalar _w37s01_rules()
{
    string matrix    S
    real colvector   rc
    string rowvector a
    real scalar      i, bad, ok

    S  = st_sdata(., ("key", "type", "case", "line1", "line2"))
    rc = st_data(., "rc")
    bad = 0
    for (i = 1; i <= rows(S); i++) {
        if (S[i, 3] == "") continue
        a  = _dash_zero_obs_rule(S[i, 2], S[i, 3])
        ok = (strtoreal(a[1]) == rc[i])
        if (ok & rc[i] != 0) {
            if (a[2] != "") ok = (a[2] == S[i, 4] & a[3] == S[i, 5])
            else ok = (a[3] == S[i, 4])
        }
        if (!ok) {
            bad++
            if (bad <= 5) printf("{err}Q3701-1 FAIL: %s: rule (%s, %s, %s), twoway (%g, %s, %s)\n",
                S[i, 1], a[1], a[2], a[3], rc[i], S[i, 4], S[i, 5])
        }
    }
    return(bad)
}
end

* ==== S01 DG-1: zero observations answered as twoway answers them ====
local only : env WP37_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w37_run' {
    display as text "S01 start " c(current_date) " " c(current_time)
    local s01_fx "fixtures/zero_obs_truth.json"
    local s01_h "`w37_work'/s01.html"
    local s01_l "`w37_work'/s01_d.log"
    local s01_t "`w37_work'/s01_t.log"

    // ------------------------------------------------------------
    // Q3701-1: the rule table equals twoway on every fixture probe
    // (cases a-d none, f allmissing, e2 byempty; e1 is the renderer's).
    // ------------------------------------------------------------
    capture frame drop w37s01
    frame create w37s01
    frame w37s01: python: _w37s01_fill(r"`s01_fx'")
    frame w37s01: quietly count
    local s01_n = r(N)
    local s01_bad -1
    capture noisily frame w37s01: mata: st_local("s01_bad", strofreal(_w37s01_rules()))
    _w37_expect Q3701-1 "(`s01_n' == 400)" "the fixture holds `s01_n' probes"
    _w37_expect Q3701-1 "(`s01_bad' == 0)" "`s01_bad' probe(s) differ (-1: the rule did not run)"
    _w37_done Q3701-1 "_dash_zero_obs_rule equals twoway on `s01_n' probes"
    frame drop w37s01

    // ------------------------------------------------------------
    // Q3701-2: the one-line form gives twoway's rc and first lines on
    // every probe twoway refuses and every contour probe; a refusal's
    // next line names the plot.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly gen t = _n
    quietly tsset t
    quietly gen ymiss = .
    quietly gen ydom = mpg if !foreign
    tempfile s01_data
    quietly save "`s01_data'"
    python: _w37s01_q2_list(r"`s01_fx'", r"`s01_h'")
    local s01_bad 0
    local s01_q2n = ${w37s01_q2n}
    forvalues i = 1/`s01_q2n' {
        quietly use "`s01_data'", clear
        capture erase "`s01_h'"
        _w37s01_log "`s01_l'" dash ${w37s01_q2c_`i'}
        python: _w37s01_q2(r"`s01_fx'", "${w37s01_q2k_`i'}", r"`s01_l'", "`_w37s01_rc'")
        if `"${w37s01_v}"' != "" {
            local ++s01_bad
            _w37_expect Q3701-2 "0" `"${w37s01_q2k_`i'}: ${w37s01_v}"'
        }
    }
    _w37_done Q3701-2 "${w37s01_q2n} one-line probes, `s01_bad' differ"

    // ------------------------------------------------------------
    // Q3701-4: an emptied contour draws its key's title and no level.
    // ------------------------------------------------------------
    foreach c in a d f {
        quietly use "`s01_data'", clear
        local s01_z "Mileage (mpg)"
        if "`c'" == "f" local s01_z "ymiss"
        local s01_cmd "contour mpg weight length if 0"
        if "`c'" == "d" local s01_cmd "contour mpg weight length in 1 if foreign"
        if "`c'" == "f" local s01_cmd "contour ymiss weight length"
        capture erase "`s01_h'"
        capture noisily dash `s01_cmd', saving("`s01_h'", replace)
        _w37_expect Q3701-4 "(_rc == 0)" "`s01_cmd' rc `=_rc'"
        python: _w37s01_keys(r"`s01_h'")
        _w37_expect Q3701-4 `"("${w37s01_keys}" == "`s01_z'|0")"' "`c': keys ${w37s01_keys}"
    }
    sysuse auto, clear
    capture erase "`s01_h'"
    capture noisily dash contour price mpg weight if price < 0, saving("`s01_h'", replace)
    _w37_expect Q3701-4 "(_rc == 0)" "contour price mpg weight if price < 0 rc `=_rc'"
    python: _w37s01_keys(r"`s01_h'")
    _w37_expect Q3701-4 `"("${w37s01_keys}" == "Price|0")"' "keys ${w37s01_keys}"
    _w37_done Q3701-4 "an emptied contour draws, its key titled and empty"

    // ------------------------------------------------------------
    // Q3701-3: a graph registered on data that has none left at dash
    // build is answered as twoway answers the same command on that data,
    // run live beside it, and the next line names the plot and graph.
    // ------------------------------------------------------------
    local s01_c1 "lpoly mpg weight"
    local s01_c2 "fpfit mpg weight"
    local s01_c3 "mspline mpg weight"
    local s01_c4 "histogram mpg"
    local s01_c5 "scatter mpg weight, by(foreign)"
    local s01_c6 "function y = x, by(foreign)"
    forvalues k = 1/6 {
        capture dash clear
        sysuse auto, clear
        local s01_o ","
        if `k' >= 5 local s01_o ""
        quietly dash `s01_c`k''`s01_o' name(z`k')
        local s01_tp : word 1 of `s01_c`k''
        local s01_want "dash: plot 1 (`s01_tp') of graph 'z`k'' has no observations."
        if `k' >= 5 local s01_want "dash: plot 1 (`s01_tp') of graph 'z`k'' leaves no by() panel."
        preserve
        quietly keep if 0
        local s01_tc "`s01_c`k''`s01_o' nodraw"
        _w37s01_log "`s01_t'" twoway `s01_tc'
        local s01_trc `_w37s01_rc'
        capture erase "`s01_h'"
        _w37s01_log "`s01_l'" dash build, saving("`s01_h'") replace nobrowser
        local s01_drc `_w37s01_rc'
        restore
        _w37_expect Q3701-3 "(`s01_trc' != 0 & `s01_drc' == `s01_trc')" "z`k' (`s01_c`k''): dash rc `s01_drc', twoway rc `s01_trc'"
        python: _w37s01_after(r"`s01_t'", r"`s01_l'", _w37s01_M.getLocal("s01_want"))
        _w37_expect Q3701-3 `"("${w37s01_v}" == "")"' `"z`k': ${w37s01_v}"'
    }
    capture dash clear
    _w37_done Q3701-3 "six graphs built on emptied data answered as twoway, the plot named"

    // ------------------------------------------------------------
    // Q3701-5: the plots walker and the graph's own keys read after the
    // plots array; a by() refusal's line names every plot.
    // ------------------------------------------------------------
    capture dash clear
    sysuse auto, clear
    quietly dash (scatter mpg weight if foreign) (lpoly mpg weight) if price > 5000, by(rep78) name(z7)
    mata: _dash_qual_reset()
    mata: _w37s01_j = _dash_qual_rewrite(st_global("dash_json_z7"), "s01_e", 1)
    mata: _w37s01_p = 0
    mata: _w37s01_r = _dash_zo_records(_w37s01_j, _w37s01_p)
    mata: st_local("s01_nr", strofreal(rows(_w37s01_r)))
    mata: st_local("s01_at", substr(_w37s01_j, _w37s01_p, 1))
    mata: _dash_json_get_str(substr(_w37s01_j, _w37s01_p + 1, .), "qual_col", "s01_gq")
    mata: _dash_json_get_str(_w37s01_j, "qual_col", "s01_pq")
    mata: _dash_json_get_str(substr(_w37s01_j, _w37s01_p + 1, .), "by", "s01_by")
    mata: _dash_json_get_str(_w37s01_r[1], "qual_col", "s01_q1")
    capture mata: mata drop _w37s01_j _w37s01_p _w37s01_r
    mata: _dash_qual_reset()
    _w37_expect Q3701-5 "(`s01_nr' == 2)" "`s01_nr' records"
    _w37_expect Q3701-5 `"("`s01_at'" == "]")"' "the byte at pend is `s01_at'"
    _w37_expect Q3701-5 `"("`s01_gq'" != "" & "`s01_pq'" != "" & "`s01_gq'" != "`s01_pq'" & "`s01_pq'" == "`s01_q1'")"' "graph column `s01_gq', first column `s01_pq', plot 1's `s01_q1'"
    _w37_expect Q3701-5 `"("`s01_by'" == "rep78")"' "by is `s01_by'"
    preserve
    quietly replace price = 1
    capture erase "`s01_h'"
    _w37s01_log "`s01_l'" dash build, saving("`s01_h'") replace nobrowser
    local s01_drc `_w37s01_rc'
    restore
    _w37_expect Q3701-5 "(`s01_drc' == 198)" "dash build rc `s01_drc'"
    python: _w37s01_M.setGlobal("w37s01_v", "" if _w37s01_lines(_w37s01_M.getLocal("s01_l"))[:2] == ["nothing to graph", "dash: no by() panel of graph 'z7' holds an observation of plot 1 (scatter), plot 2 (lpoly)."] else _w37s01_safe(_w37s01_lines(_w37s01_M.getLocal("s01_l"))[:2]))
    _w37_expect Q3701-5 `"("${w37s01_v}" == "")"' `"lines ${w37s01_v}"'
    capture dash clear
    _w37_done Q3701-5 "two records, the graph's keys after the plots, the by() line names both plots"

    // ------------------------------------------------------------
    // Q3701-6: the check in the frame the data are written from: a
    // graph's own frame on a build of several frames, and 35-08's
    // working frame, each beside twoway on the same data.
    // ------------------------------------------------------------
    capture frame drop q6f
    frame create q6f
    sysuse auto, clear
    foreach s01_c in "lpoly mpg weight" "histogram mpg" {
        capture dash clear
        frame q6f: quietly sysuse auto, clear
        quietly dash scatter mpg weight, name(z9)
        frame q6f: quietly dash `s01_c', name(z8)
        frame q6f: quietly drop if 1
        local s01_tp : word 1 of `s01_c'
        _w37s01_log "`s01_t'" frame q6f: twoway `s01_c', nodraw
        local s01_trc `_w37s01_rc'
        capture erase "`s01_h'"
        _w37s01_log "`s01_l'" dash build, saving("`s01_h'") replace nobrowser
        local s01_drc `_w37s01_rc'
        _w37_expect Q3701-6 "(`s01_trc' != 0 & `s01_drc' == `s01_trc')" "frame q6f `s01_c': dash rc `s01_drc', twoway rc `s01_trc'"
        local s01_want "dash: plot 1 (`s01_tp') of graph 'z8' has no observations."
        python: _w37s01_after(r"`s01_t'", r"`s01_l'", _w37s01_M.getLocal("s01_want"))
        _w37_expect Q3701-6 `"("${w37s01_v}" == "")"' `"frame q6f `s01_c': ${w37s01_v}"'
    }
    frame drop q6f
    capture dash clear
    sysuse auto, clear
    quietly dash histogram mpg, name(z4)
    global dash__force_frame 1
    preserve
    quietly keep if 0
    _w37s01_log "`s01_t'" twoway histogram mpg, nodraw
    local s01_trc `_w37s01_rc'
    capture erase "`s01_h'"
    _w37s01_log "`s01_l'" dash build, saving("`s01_h'") replace nobrowser
    local s01_drc `_w37s01_rc'
    restore
    global dash__force_frame
    _w37_expect Q3701-6 "(`s01_trc' != 0 & `s01_drc' == `s01_trc')" "working frame: dash rc `s01_drc', twoway rc `s01_trc'"
    python: _w37s01_after(r"`s01_t'", r"`s01_l'", "dash: plot 1 (histogram) of graph 'z4' has no observations.")
    _w37_expect Q3701-6 `"("${w37s01_v}" == "")"' `"working frame: ${w37s01_v}"'
    capture dash clear
    _w37_done Q3701-6 "a graph's own frame and the working frame answered as twoway"

    capture erase "`s01_h'"
    capture erase "`s01_l'"
    capture erase "`s01_t'"
    macro drop w37s01_*
    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====

// S02's helpers (WP-37 DG-5, DG-8): a saved page's Bokeh models by id,
// rarea's outline runs against a fixture's polygons, and its colour keys.
python:
import base64 as _w37s02_b64
import gzip as _w37s02_gzip
import json as _w37s02_json
import math as _w37s02_math
import re as _w37s02_re
import struct as _w37s02_struct
from html import unescape as _w37s02_unescape
from sfi import Macro as _w37s02_M


def _w37s02_safe(v):
    """v with no character that ends or expands a Stata string."""
    return str(v).replace('"', "'").replace("`", "'").replace("$", "S")[:400]


def _w37s02_dec(v):
    """A column of the page's JSON as a list of floats (None -> nan)."""
    if isinstance(v, dict) and v.get("type") == "ndarray":
        arr = v.get("array")
        if isinstance(arr, dict) and arr.get("type") == "bytes":
            raw = _w37s02_b64.b64decode(arr.get("data", ""))
            if raw[:2] == b"\x1f\x8b":
                # The saved page gzips a column's bytes.
                raw = _w37s02_gzip.decompress(raw)
            f = {"float64": "d", "float32": "f", "int32": "i",
                 "int64": "q"}.get(str(v.get("dtype")))
            if f is None:
                return []
            n = len(raw) // _w37s02_struct.calcsize(f)
            return [float(x) for x in _w37s02_struct.unpack("<%d%s" % (n, f),
                                                            raw[:n * _w37s02_struct.calcsize(f)])]
        v = arr
    out = []
    for x in v if isinstance(v, list) else []:
        try:
            out.append(float("nan") if x is None else float(x))
        except (TypeError, ValueError):
            out.append(float("nan"))
    return out


def _w37s02_objs(path):
    """{id: model} of every model of the saved page *path*."""
    page = open(path, encoding="utf-8").read()
    m = _w37s02_re.search(
        r'<script[^>]+type=["\']application/json["\'][^>]*>', page)
    body = page[m.end():page.index("</script>", m.end())]
    objs = {}

    def walk(node):
        if isinstance(node, dict):
            if "id" in node and "name" in node:
                objs[node["id"]] = node
            for v in node.values():
                walk(v)
        elif isinstance(node, list):
            for v in node:
                walk(v)

    walk(_w37s02_json.loads(_w37s02_unescape(body)))
    return objs


def _w37s02_ref(objs, v):
    return objs.get(v.get("id"), v) if isinstance(v, dict) else {}


def _w37s02_fld(objs, spec, key):
    """The source column a coordinate spec reads: its field, or (Flipped,
    WP-47 basic:PT-4: rarea's bounds are drawn through the inset
    expression over their own source) the field its CustomJSExpr's
    *key* argument (xs or ys) names."""
    spec = spec or {}
    if spec.get("field"):
        return spec["field"]
    if spec.get("type") == "expr":
        e = _w37s02_ref(objs, spec.get("expr")).get("attributes", {})
        args = e.get("args") or {}
        args = dict(args.get("entries", [])) if "entries" in args else args
        v = args.get(key)
        return v[0] if isinstance(v, list) and v else None
    return None


def _w37s02_outline(path, fixture, key):
    """Global w37s02_v: "" when each rarea outline Line (tag
    dash_rarea_outline) of the saved page is one run of finite vertices
    per polygon of the fixture's probe *key*, over its x extent (within
    2); else what differs.  Global w37s02_n: the runs of every outline."""
    v, total = "", 0
    try:
        polys = _w37s02_json.load(open(fixture, encoding="utf-8"))[key]["polys"]
        objs = _w37s02_objs(path)
        lines = [o for o in objs.values() if o.get("name") == "GlyphRenderer"
                 and "dash_rarea_outline" in
                 ((o.get("attributes") or {}).get("tags") or [])]
        if len(lines) != 2:
            v = "%d outline Lines, not 2" % len(lines)
        for o in lines:
            a = o["attributes"]
            g = _w37s02_ref(objs, a.get("glyph")).get("attributes", {})
            src = _w37s02_ref(objs, a.get("data_source")).get("attributes", {})
            data = src.get("data", {})
            cols = {e[0]: e[1] for e in data.get("entries", [])} \
                if isinstance(data, dict) and "entries" in data else data
            xs = _w37s02_dec(cols.get(_w37s02_fld(objs, g.get("x"), "xs")))
            ys = _w37s02_dec(cols.get(_w37s02_fld(objs, g.get("y"), "ys")))
            runs, cur = [], []
            for x, y in zip(xs, ys):
                if _w37s02_math.isfinite(x) and _w37s02_math.isfinite(y):
                    cur.append(x)
                elif cur:
                    runs.append(cur)
                    cur = []
            if cur:
                runs.append(cur)
            total += len(runs)
            ext = [[min(r), max(r)] for r in runs]
            ok = len(ext) == len(polys) and all(
                abs(e[0] - p[0]) <= 2 and abs(e[1] - p[1]) <= 2
                for e, p in zip(ext, polys))
            if not ok and not v:
                v = "runs %s, twoway's polygons %s" % (
                    [[round(e[0]), round(e[1])] for e in ext],
                    [[round(p[0]), round(p[1])] for p in polys])
    except Exception as e:
        v = "error " + str(e)
    _w37s02_M.setGlobal("w37s02_v", _w37s02_safe(v))
    _w37s02_M.setGlobal("w37s02_n", str(total))


def _w37s02_bars(path):
    """Global w37s02_bars: "<title>|<tick> <tick> ..." for each
    ContourColorBar of the saved page *path*, ";"-joined (ticks %g)."""
    out = []
    try:
        objs = _w37s02_objs(path)
        # Flipped (WP-42 CV-3): the key is a key cell, not a
        # ContourColorBar; its title and its z axis's ticks.
        for title, ticks, _lc, _n in _w37_keycells(objs):
            out.append("%s|%s" % (title, " ".join("%g" % t for t in ticks)))
        _w37s02_M.setGlobal("w37s02_bars", _w37s02_safe(";".join(out)))
    except Exception as e:
        _w37s02_M.setGlobal("w37s02_bars", _w37s02_safe("error " + str(e)))


def _w37s02_texts(listfile, want):
    """Global w37s02_v: "" when every "|"-separated text of *want* is
    one of the SVG texts cert_svg_texts listed in *listfile*."""
    try:
        have = [_w37s02_json.loads(ln)["text"]
                for ln in open(listfile, encoding="utf-8") if ln.strip()]
        miss = [w for w in want.split("|") if w not in have]
        v = "missing %s of %s" % (miss, have) if miss else ""
    except Exception as e:
        v = "error " + str(e)
    _w37s02_M.setGlobal("w37s02_v", _w37s02_safe(v))
end

* ==== S02 DG-5: rarea outlines break at gaps ====
local only : env WP37_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w37_run' {
    display as text "S02 start " c(current_date) " " c(current_time)
    local s02_h "`w37_work'/s02.html"

    // ------------------------------------------------------------
    // Q3702-1: rarea lo hi weight in 1/20, cmissing(n) sort -- twoway
    // strokes three polygons (fixtures/area_cmissing_truth.json R02, the
    // data its extract script makes); each of dash's two outline Lines
    // is three runs, one over each polygon, none across a gap.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly replace mpg = . in 10/12
    quietly generate lo = mpg - 2
    quietly generate hi = mpg + 2
    capture dash clear
    capture erase "`s02_h'"
    capture noisily dash rarea lo hi weight in 1/20, cmissing(n) sort saving("`s02_h'", replace)
    _w37_expect Q3702-1 "(_rc == 0)" "dash rarea rc `=_rc'"
    python: _w37s02_outline(r"`s02_h'", r"fixtures/area_cmissing_truth.json", "R02")
    _w37_expect Q3702-1 `"("${w37s02_v}" == "")"' "${w37s02_v}"
    _w37_expect Q3702-1 "(${w37s02_n} == 6)" "${w37s02_n} outline runs, not 6"
    _w37_done Q3702-1 "each rarea outline breaks where twoway's polygons do (${w37s02_n} runs)"
    capture erase "`s02_h'"
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

* ==== S02 DG-8: contour key without a surface ====
local only : env WP37_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w37_run' {
    display as text "S02 start " c(current_date) " " c(current_time)
    local s02_h "`w37_work'/s02k.html"
    local s02_s "`w37_work'/s02k.svg"

    // ------------------------------------------------------------
    // Q3702-2: contour price mpg weight in 1/2 -- two points, no
    // surface; twoway draws its key, labelled 4,000 to 4,800 and titled
    // Price (measured here); dash's saved page has one key, titled Price,
    // with those five ticks.
    // ------------------------------------------------------------
    sysuse auto, clear
    capture graph drop w37s02k
    capture noisily twoway contour price mpg weight in 1/2, name(w37s02k)
    _w37_expect Q3702-2 "(_rc == 0)" "twoway contour rc `=_rc'"
    capture erase "`s02_s'"
    cert_svg_export, name(w37s02k) file("`s02_s'")
    cert_svg_texts, file("`s02_s'")
    local s02_l "`r(list)'"
    python: _w37s02_texts(r"`s02_l'", "4,000|4,200|4,400|4,600|4,800|Price")
    _w37_expect Q3702-2 `"("${w37s02_v}" == "")"' "twoway's key: ${w37s02_v}"
    capture dash clear
    capture erase "`s02_h'"
    capture noisily dash contour price mpg weight in 1/2, saving("`s02_h'", replace)
    _w37_expect Q3702-2 "(_rc == 0)" "dash contour rc `=_rc'"
    python: _w37s02_bars(r"`s02_h'")
    _w37_expect Q3702-2 `"("${w37s02_bars}" == "Price|4000 4200 4400 4600 4800")"' "dash's keys: ${w37s02_bars}"
    _w37_done Q3702-2 "two points: twoway's key and dash's (${w37s02_bars})"
    capture erase "`s02_h'"
    capture erase "`s02_s'"
    capture erase "`s02_l'"
    capture graph drop w37s02k
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

// S03 helpers (WP-37 TR-13).  _w37s03_fill: the polygons per band of each
// contour layer (ContourRenderer tagged dash_contour) of the saved page,
// "b1 b2 .." per layer, ";"-joined, into global w37s03_v.  _w37s03_lines:
// the NaN-separated runs per level of the line source of each
// ContourRenderer tagged <tag>, and its first line colour, likewise.
// _w37s03_spec: what the served spec's contour_grids holds for graph
// <g>, layer 1 ("none" without the member), into global w37s03_v.
// _w37s03_fix: a field of contour_gen_truth.json into global w37s03_f.
python:
def _w37s03_fill(path):
    out = []
    try:
        objs = _w37s02_objs(path)
        for o in objs.values():
            a = o.get("attributes") or {}
            if o.get("name") != "ContourRenderer" or "dash_contour" not in (a.get("tags") or []):
                continue
            lv = _w37s02_dec(a.get("levels", []))
            fr = _w37s02_ref(objs, a.get("fill_renderer")).get("attributes", {})
            src = _w37s02_ref(objs, fr.get("data_source")).get("attributes", {})
            data = src.get("data", {})
            cols = {e[0]: e[1] for e in data.get("entries", [])} \
                if isinstance(data, dict) and "entries" in data else data
            lows = _w37s02_dec(cols.get("lower_levels", []))
            per = [0] * max(len(lv) - 1, 0)
            for item, lo in zip(cols.get("xs", []), lows):
                b = min(range(len(per)), key=lambda i: abs(lv[i] - lo))
                per[b] += len(item)
            out.append(" ".join(str(p) for p in per))
        _w37s02_M.setGlobal("w37s03_v", _w37s02_safe(";".join(out)))
    except Exception as e:
        _w37s02_M.setGlobal("w37s03_v", _w37s02_safe("error " + str(e)))


def _w37s03_lines(path, tag):
    out = []
    try:
        objs = _w37s02_objs(path)
        for o in objs.values():
            a = o.get("attributes") or {}
            if o.get("name") != "ContourRenderer" or tag not in (a.get("tags") or []):
                continue
            lr = _w37s02_ref(objs, a.get("line_renderer")).get("attributes", {})
            src = _w37s02_ref(objs, lr.get("data_source")).get("attributes", {})
            data = src.get("data", {})
            cols = {e[0]: e[1] for e in data.get("entries", [])} \
                if isinstance(data, dict) and "entries" in data else data
            per = []
            for xs in cols.get("xs", []):
                runs, inrun = 0, False
                for v in _w37s02_dec(xs):
                    if v != v:
                        inrun = False
                    elif not inrun:
                        runs, inrun = runs + 1, True
                per.append(runs)
            colr = cols.get("line_color", [""])
            out.append(" ".join(str(p) for p in per) + "|" + str(colr[0] if colr else ""))
        _w37s02_M.setGlobal("w37s03_v", _w37s02_safe(";".join(out)))
    except Exception as e:
        _w37s02_M.setGlobal("w37s03_v", _w37s02_safe("error " + str(e)))


def _w37s03_spec(path, g):
    try:
        d = _w37s02_json.load(open(path, encoding="utf-8"))
        cg = d.get("contour_grids")
        if cg is None:
            v = "none"
        else:
            o = cg[g]["1"]
            if "panels" in o:
                v = ";".join("%s %d %s" % (_w37s02_json.dumps(p["key"]), p["grid"]["n"],
                                           " ".join("%g" % c for c in p["grid"]["cuts"]))
                             for p in o["panels"])
                if "total" in o:
                    v += ";total %d" % o["total"]["n"]
            else:
                v = "%d %d %s" % (o["n"], len(o["x"]), " ".join("%g" % c for c in o["cuts"]))
    except Exception as e:
        v = "error " + str(e)
    _w37s02_M.setGlobal("w37s03_v", _w37s02_safe(v))


def _w37s03_fix(key, field):
    try:
        d = _w37s02_json.load(open("fixtures/contour_gen_truth.json", encoding="utf-8"))
        v = d
        for k in key.split("|"):
            v = v[int(k)] if isinstance(v, list) else v[k]
        v = " ".join("%g" % x for x in v[field]) if field else str(v)
    except Exception as e:
        v = "error " + str(e)
    _w37s02_M.setGlobal("w37s03_f", _w37s02_safe(v))
end

* ==== S03 TR-13: contour from twoway's own generator ====
local only : env WP37_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w37_run' {
    display as text "S03 start " c(current_date) " " c(current_time)
    local s03_h "`w37_work'/s03.html"
    local s03_s "`w37_work'/s03.json"
    local s03_d "`w37_work'/s03d.json"
    local s03_l "`w37_work'/s03.log"

    // ------------------------------------------------------------
    // Q3703-1: sandstone, the default cuts: no approximation note,
    // twoway's polygons per band (contour_gen_truth.json
    // sandstone.default), the key at 7700 .. 8000; then the same layer
    // registered under frame q3s: (A-17) and built with a graph of the
    // current frame (the stack): the same polygons, both frames unchanged.
    // The page's size is displayed (REVIEW R3-22, no cap).
    // ------------------------------------------------------------
    sysuse sandstone, clear
    capture dash clear
    capture erase "`s03_h'"
    capture log close s03log
    quietly log using "`s03_l'", text replace name(s03log)
    capture noisily dash contour depth northing easting, saving("`s03_h'", replace)
    local rc = _rc
    quietly log close s03log
    _w37_expect Q3703-1 "(`rc' == 0)" "dash contour rc `rc'"
    cert_log_has "`s03_l'", needle("approximate surface")
    _w37_expect Q3703-1 "(r(found) == 0)" "the approximation note was printed"
    python: _w37s03_fill(r"`s03_h'")
    local got "${w37s03_v}"
    python: _w37s03_fix("sandstone.default", "polys_per_band")
    _w37_expect Q3703-1 `"("`got'" == "${w37s03_f}")"' "polygons per band `got', twoway ${w37s03_f}"
    python: _w37s02_bars(r"`s03_h'")
    // The key is ticked at twoway's z axis ticks, 7600 .. 8100, whose
    // interior are the cuts 7700 .. 8000 (measured: .zaxis major
    // tick_values on the drawn graph).
    _w37_expect Q3703-1 `"("${w37s02_bars}" == "Depth (ft.)|7600 7700 7800 7900 8000 8100")"' "key ${w37s02_bars}"
    checksum "`s03_h'"
    display as text "Q3703-1 page bytes `r(filelen)'"
    capture frame drop q3s
    frame create q3s
    frame q3s: sysuse sandstone, clear
    sysuse auto, clear
    quietly datasignature
    local sig0 "`r(datasignature)'"
    frame q3s: quietly datasignature
    local sig1 "`r(datasignature)'"
    capture dash clear
    frame q3s: dash contour depth northing easting, name(c1)
    dash scatter mpg weight, name(c2)
    capture erase "`s03_h'"
    capture noisily dash build, saving("`s03_h'") replace nobrowser
    _w37_expect Q3703-1 "(_rc == 0)" "framed build rc `=_rc'"
    python: _w37s03_fill(r"`s03_h'")
    local got "${w37s03_v}"
    _w37_expect Q3703-1 `"("`got'" == "${w37s03_f}")"' "framed: polygons per band `got', twoway ${w37s03_f}"
    quietly datasignature
    _w37_expect Q3703-1 `"("`r(datasignature)'" == "`sig0'")"' "the current frame changed"
    frame q3s: quietly datasignature
    _w37_expect Q3703-1 `"("`r(datasignature)'" == "`sig1'")"' "frame q3s changed"
    frame drop q3s
    capture dash clear
    _w37_done Q3703-1 "sandstone: twoway's polygons per band (`got'), in place and from a frame"

    // ------------------------------------------------------------
    // Q3703-2: levels(10), ccuts(7600(100)8000), contourline (polylines
    // per cut) and the boundary lines from the generator (D-37-03.h).
    // alpattern(dash) draws them (outlines draws none: twoway outlines
    // the key's boxes, WP-37 TR-13a).
    // ------------------------------------------------------------
    sysuse sandstone, clear
    foreach p in levels10 ccuts {
        local o = cond("`p'" == "levels10", "levels(10)", "ccuts(7600(100)8000)")
        capture erase "`s03_h'"
        capture noisily dash contour depth northing easting, `o' saving("`s03_h'", replace)
        _w37_expect Q3703-2 "(_rc == 0)" "`p' rc `=_rc'"
        python: _w37s03_fill(r"`s03_h'")
        local got "${w37s03_v}"
        python: _w37s03_fix("sandstone.`p'", "polys_per_band")
        _w37_expect Q3703-2 `"("`got'" == "${w37s03_f}")"' "`p': `got', twoway ${w37s03_f}"
    }
    capture erase "`s03_h'"
    capture noisily dash contourline depth northing easting, saving("`s03_h'", replace)
    _w37_expect Q3703-2 "(_rc == 0)" "contourline rc `=_rc'"
    python: _w37s03_lines(r"`s03_h'", "dash_contour")
    local got "${w37s03_v}"
    python: _w37s03_fix("sandstone.default.line", "lines_per_cut")
    _w37_expect Q3703-2 `"(strpos("`got'", "${w37s03_f}|") == 1)"' "contourline: `got', twoway ${w37s03_f}"
    capture erase "`s03_h'"
    capture noisily dash contour depth northing easting, alpattern(dash) saving("`s03_h'", replace)
    _w37_expect Q3703-2 "(_rc == 0)" "alpattern rc `=_rc'"
    python: _w37s03_lines(r"`s03_h'", "dash_contour_lines")
    local got "${w37s03_v}"
    _w37_expect Q3703-2 `"(strpos("`got'", "${w37s03_f}|") == 1)"' "boundary lines: `got', twoway ${w37s03_f}"
    python: _w37s03_fill(r"`s03_h'")
    python: _w37s03_fix("sandstone.default", "polys_per_band")
    _w37_expect Q3703-2 `"("${w37s03_v}" == "${w37s03_f}")"' "alpattern bands ${w37s03_v}"
    _w37_done Q3703-2 "levels(), ccuts(), contourline and boundary lines from the generator"

    // ------------------------------------------------------------
    // Q3703-3: 100 scattered points: interp(none) draws twoway's
    // polygons; the default interp() keeps dash's own exact fit, with no
    // contour_grids member in the spec.
    // ------------------------------------------------------------
    clear
    set obs 100
    set seed 20261020
    generate double x = runiform()
    generate double y = runiform()
    generate double z = runiform()
    capture erase "`s03_h'"
    capture noisily dash contour z y x, interp(none) saving("`s03_h'", replace)
    _w37_expect Q3703-3 "(_rc == 0)" "interp(none) rc `=_rc'"
    python: _w37s03_fill(r"`s03_h'")
    local got "${w37s03_v}"
    python: _w37s03_fix("scatter100.none", "polys_per_band")
    _w37_expect Q3703-3 `"("`got'" == "${w37s03_f}")"' "interp(none): `got', twoway ${w37s03_f}"
    capture dash clear
    dash contour z y x, name(q3c)
    capture erase "`s03_s'"
    _dash_serve_spec, specpath("`s03_s'") datapath("`s03_d'")
    python: _w37s03_spec(r"`s03_s'", "q3c")
    _w37_expect Q3703-3 `"("${w37s03_v}" == "none")"' "default interp(): ${w37s03_v}"
    capture dash clear
    _w37_done Q3703-3 "scattered points: interp(none) twoway's, the default dash's own"

    // ------------------------------------------------------------
    // Q3703-4: the data and the frames are unchanged by a build.
    // ------------------------------------------------------------
    sysuse sandstone, clear
    quietly datasignature
    local sig0 "`r(datasignature)'"
    quietly frames dir
    local fr0 "`r(frames)'"
    capture erase "`s03_h'"
    capture noisily dash contour depth northing easting, alpattern(dash) saving("`s03_h'", replace)
    quietly datasignature
    _w37_expect Q3703-4 `"("`r(datasignature)'" == "`sig0'")"' "the data changed"
    quietly frames dir
    _w37_expect Q3703-4 `"("`r(frames)'" == "`fr0'")"' "frames `r(frames)', were `fr0'"
    _w37_done Q3703-4 "data and frames unchanged"

    // ------------------------------------------------------------
    // Q3703-5: by(half): each panel carries its own grid, n 3200, cut at
    // the first panel's cuts (sandstone.by, first_panel_rule); each
    // panel's polygons per band are twoway's; by(half, total) adds the
    // Total panel's grid, n 6400.
    // ------------------------------------------------------------
    sysuse sandstone, clear
    quietly summarize northing, detail
    generate byte half = northing > r(p50)
    capture dash clear
    dash contour depth northing easting, by(half) name(q5)
    capture erase "`s03_s'"
    _dash_serve_spec, specpath("`s03_s'") datapath("`s03_d'")
    python: _w37s03_spec(r"`s03_s'", "q5")
    local got "${w37s03_v}"
    python: _w37s03_fix("sandstone.by|panels|0", "cuts")
    local c0 "${w37s03_f}"
    python: _w37s03_fix("sandstone.by|panels|1", "cuts")
    local c1 "${w37s03_f}"
    _w37_expect Q3703-5 `"("`got'" == "[0] 3200 `c0';[1] 3200 `c1'")"' "panels `got'"
    capture erase "`s03_h'"
    capture noisily dash build, saving("`s03_h'") replace nobrowser
    _w37_expect Q3703-5 "(_rc == 0)" "by() build rc `=_rc'"
    python: _w37s03_fill(r"`s03_h'")
    local got "${w37s03_v}"
    python: _w37s03_fix("sandstone.by|panels|0", "polys_per_band")
    local p0 "${w37s03_f}"
    python: _w37s03_fix("sandstone.by|panels|1", "polys_per_band")
    local p1 "${w37s03_f}"
    _w37_expect Q3703-5 `"("`got'" == "`p0';`p1'" | "`got'" == "`p1';`p0'")"' "panels' polygons `got', twoway `p0';`p1'"
    capture dash clear
    dash contour depth northing easting, by(half, total) name(q5t)
    capture erase "`s03_s'"
    _dash_serve_spec, specpath("`s03_s'") datapath("`s03_d'")
    python: _w37s03_spec(r"`s03_s'", "q5t")
    _w37_expect Q3703-5 `"(strpos("${w37s03_v}", ";total 6400") > 0)"' "total: ${w37s03_v}"
    capture dash clear
    _w37_done Q3703-5 "by(): each panel twoway's own polygons"

    // ------------------------------------------------------------
    // Q3703-6: small layers never reach the generator (REVIEW R3-5):
    // no rows, and two rows, under interp(none): twoway's rc and dash's
    // equal, no contour_grids member, 37-01's empty key and 37-02's key.
    // ------------------------------------------------------------
    sysuse auto, clear
    local k 0
    foreach q in "if price < 0" "in 1/2" {
        local ++k
        capture graph drop w37s03
        capture noisily twoway contour price mpg weight `q', interp(none) nodraw name(w37s03)
        local trc = _rc
        capture erase "`s03_h'"
        capture noisily dash contour price mpg weight `q', interp(none) saving("`s03_h'", replace)
        local drc = _rc
        _w37_expect Q3703-6 "(`trc' == `drc')" "`q': twoway rc `trc', dash rc `drc'"
        python: _w37s02_bars(r"`s03_h'")
        local want = cond(`k' == 1, "Price|", "Price|4000 4200 4400 4600 4800")
        _w37_expect Q3703-6 `"("${w37s02_bars}" == "`want'")"' "`q': key ${w37s02_bars}"
        capture dash clear
        dash contour price mpg weight `q', interp(none) name(q6)
        capture erase "`s03_s'"
        _dash_serve_spec, specpath("`s03_s'") datapath("`s03_d'")
        python: _w37s03_spec(r"`s03_s'", "q6")
        _w37_expect Q3703-6 `"("${w37s03_v}" == "none")"' "`q': spec ${w37s03_v}"
        capture dash clear
    }
    _w37_done Q3703-6 "small layers: twoway's rc, no generator"
    capture erase "`s03_h'"
    capture erase "`s03_s'"
    capture erase "`s03_d'"
    capture erase "`s03_l'"
    capture graph drop w37s03
    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

// S04 helpers (WP-37 stat:PT-12).  _q4_take: the data in memory (a
// serset after serset use) appended to a JSON list in <out>, its columns
// in order, missing as null.  _q4_cmp: the points dash stored for plot k
// of a graph (the served spec's function_points) -- flat, the by() panel
// whose key is <key> (JSON), or "total" -- against twoway's serset number
// <s> of <tw>: y, then lo and hi for a band, then x, within rtol; global
// q4_ok 1 or 0 and q4_msg.  _q4_same: two served specs' plots equal.
// _q4_first: the first line of output between two markers of a log.
python:
def _q4_take(out):
    import json
    import os
    from sfi import Data
    have = json.load(open(out, encoding="utf-8")) if os.path.exists(out) else []
    d = Data.getAsDict(missingval=None)
    names = [Data.getVarName(i) for i in range(Data.getVarCount())]
    have.append([[None if v is None else float(v) for v in d[n]] for n in names])
    json.dump(have, open(out, "w", encoding="utf-8"))


def _q4_cmp(spec, gname, k, which, tw, s, rtol):
    import json
    import numpy as np
    import os
    from sfi import Macro
    if not os.path.exists(spec) or not os.path.exists(tw):
        Macro.setGlobal("q4_ok", "0")
        Macro.setGlobal("q4_msg", "no spec or no twoway serset file")
        return
    sp = json.load(open(spec, encoding="utf-8"))
    p = (sp.get("function_points") or {}).get(gname, {}).get(str(k))
    if which == "total":
        p = p.get("total") if isinstance(p, dict) else None
    elif which:
        key = json.loads(which)
        pan = p.get("panels") if isinstance(p, dict) else None
        p = None
        for e in pan if isinstance(pan, list) else []:
            if isinstance(e, dict) and e.get("key") == key:
                p = e.get("points")
    cols = json.load(open(tw, encoding="utf-8"))[int(s)]
    cols = [np.asarray([np.nan if v is None else v for v in c], float)
            for c in cols]
    if not isinstance(p, dict) or "x" not in p:
        Macro.setGlobal("q4_ok", "0")
        Macro.setGlobal("q4_msg", "no points stored for %s plot %s %s" % (gname, k, which))
        return
    want = [cols[0]] + (cols[1:3] if len(cols) == 4 else []) + [cols[-1]]
    got = [np.asarray([np.nan if v is None else v for v in p[c]], float)
           for c in (["y", "lo", "hi", "x"] if "lo" in p else ["y", "x"])]
    ok = len(want) == len(got) and all(
        len(a) == len(b) and np.allclose(a, b, rtol=rtol, atol=0,
                                         equal_nan=True)
        for a, b in zip(got, want))
    Macro.setGlobal("q4_ok", "1" if ok else "0")
    Macro.setGlobal("q4_msg", "%d stored points in %d columns, twoway's %d rows in %d (y %s)" % (
        len(got[0]), len(got), len(want[0]), len(want),
        " ".join("%.6g" % v for v in got[0][:3])))


def _q4_same(a, b):
    import json
    import os
    from sfi import Macro
    if not (os.path.exists(a) and os.path.exists(b)):
        Macro.setGlobal("q4_ok", "0")
        return
    pa = [g.get("plots") for g in json.load(open(a, encoding="utf-8")).get("graphs", [])]
    pb = [g.get("plots") for g in json.load(open(b, encoding="utf-8")).get("graphs", [])]
    fa = json.load(open(a, encoding="utf-8")).get("function_points")
    fb = json.load(open(b, encoding="utf-8")).get("function_points")
    Macro.setGlobal("q4_ok", "1" if (pa == pb and fa == fb and pa) else "0")


def _q4_first(log):
    from sfi import Macro
    lines = open(log, encoding="utf-8", errors="replace").read().splitlines()
    out, on = "", False
    for ln in lines:
        if ln.strip() == "Q4MARK":
            on = True
            continue
        if ln.strip() == "Q4END":
            break
        if not on or not ln.strip() or ln.startswith(". ") or ln.startswith("> "):
            continue
        out = ln.strip()
        break
    Macro.setGlobal("q4_line", out)


def _q4_has(log, text):
    from sfi import Macro
    body = open(log, encoding="utf-8", errors="replace").read()
    Macro.setGlobal("q4_has", "1" if text in body else "0")
end

capture program drop _q4_tw
program define _q4_tw
    // _q4_tw <out.json> <twoway command ...>: twoway's sersets, in order,
    // into <out.json> (_q4_take).
    version 19
    gettoken out 0 : 0
    capture erase "`out'"
    capture graph drop _all
    capture serset drop _all
    quietly `0'
    forvalues s = 0/20 {
        capture serset set `s'
        if _rc continue, break
        preserve
        quietly serset use, clear
        python: __import__("__main__")._q4_take("`out'")
        restore
    }
    capture graph drop _all
end

* ==== S04 stat:PT-12: lfit and lfitci on a transformed x ====
local only : env WP37_ONLY
if inlist("`only'", "", "S04") & `: list posof "S04" in w37_run' {
    display as text "S04 start " c(current_date) " " c(current_time)
    local q4d "`w37_work'/s04"
    capture mkdir "`q4d'"

    // ------------------------------------------------------------
    // Q3704-1..3: the stored points are twoway's serset -- xtransform(X^2)
    // n(7); xlog with no n(), 100 points; lfitci xlog n(5) with its band.
    // ------------------------------------------------------------
    local k 0
    foreach c in "Q3704-1|lfit mpg weight, xtransform(X^2) n(7)|7" "Q3704-2|lfit mpg weight, xlog|100" "Q3704-3|lfitci mpg weight, xlog n(5)|5" {
        local ++k
        mata: q4_t = ustrsplit(st_local("c"), "[|]"); st_local("id", q4_t[1]); st_local("cmd", q4_t[2]); st_local("np", q4_t[3])
        sysuse auto, clear
        _q4_tw "`q4d'/t`k'.json" twoway `cmd' nodraw
        dash clear
        capture noisily dash `cmd' name(q4a`k')
        _w37_expect `id' "(_rc == 0)" "dash `cmd' rc `=_rc'"
        capture noisily _dash_serve_spec, specpath("`q4d'/s`k'.json") datapath("`q4d'/d`k'.json")
        python: __import__("__main__")._q4_cmp("`q4d'/s`k'.json", "q4a`k'", 1, "", "`q4d'/t`k'.json", 0, 1e-9)
        _w37_expect `id' "(${q4_ok} == 1)" "dash `cmd': ${q4_msg}"
        _w37_expect `id' `"(strpos("${q4_msg}", "`np' stored points") == 1)"' "dash `cmd': ${q4_msg}, not `np' points"
        _w37_done `id' "dash `cmd' stores twoway's serset (${q4_msg})"
    }

    // ------------------------------------------------------------
    // Q3704-4: no note on lfit; qfit, qfitci and fpfitci take both
    // options, with no note, and draw as without them; fpfit refuses them
    // as twoway does.
    // ------------------------------------------------------------
    sysuse auto, clear
    local lf "`q4d'/n.log"
    dash clear
    quietly log using "`lf'", text replace name(q4l)
    capture noisily dash lfit mpg weight, xlog name(q4n)
    local drc = _rc
    quietly log close q4l
    python: __import__("__main__")._q4_has("`lf'", "ignoring unsupported")
    _w37_expect Q3704-4 "(`drc' == 0 & ${q4_has} == 0)" "dash lfit mpg weight, xlog: rc `drc', note ${q4_has}"
    local j 0
    foreach t in qfit qfitci fpfitci {
        foreach o in "xlog" "xtransform(X^2)" {
            local ++j
            capture noisily twoway `t' mpg weight, `o' nodraw
            local trc = _rc
            dash clear
            quietly log using "`lf'", text replace name(q4l)
            capture noisily dash `t' mpg weight, `o' name(q4o)
            local drc = _rc
            quietly log close q4l
            python: __import__("__main__")._q4_has("`lf'", "ignoring unsupported")
            _w37_expect Q3704-4 "(`trc' == 0 & `drc' == 0 & ${q4_has} == 0)" "`t' mpg weight, `o': twoway rc `trc', dash rc `drc', note ${q4_has}"
            capture noisily _dash_serve_spec, specpath("`q4d'/o`j'a.json") datapath("`q4d'/o`j'd.json")
            dash clear
            capture quietly dash `t' mpg weight, name(q4o)
            capture noisily _dash_serve_spec, specpath("`q4d'/o`j'b.json") datapath("`q4d'/o`j'd.json")
            python: __import__("__main__")._q4_same("`q4d'/o`j'a.json", "`q4d'/o`j'b.json")
            _w37_expect Q3704-4 "(${q4_ok} == 1)" "dash `t' mpg weight, `o' is not the layer without it"
        }
    }
    foreach o in "xlog" "xtransform(X^2)" {
        quietly log using "`lf'", text replace name(q4l)
        display "Q4MARK"
        capture noisily twoway fpfit mpg weight, `o' nodraw
        local trc = _rc
        display "Q4END"
        quietly log close q4l
        python: __import__("__main__")._q4_first("`lf'")
        local tline "${q4_line}"
        dash clear
        quietly log using "`lf'", text replace name(q4l)
        display "Q4MARK"
        capture noisily dash fpfit mpg weight, `o' name(q4f)
        local drc = _rc
        display "Q4END"
        quietly log close q4l
        python: __import__("__main__")._q4_first("`lf'")
        _w37_expect Q3704-4 `"(`trc' == `drc' & "`tline'" == "${q4_line}" & `trc' == 198)"' "fpfit mpg weight, `o': twoway r(`trc') `tline', dash r(`drc') ${q4_line}"
    }
    _w37_done Q3704-4 "lfit xlog has no note; qfit, qfitci, fpfitci draw as without the options; fpfit refuses them as twoway does"

    // ------------------------------------------------------------
    // Q3704-5: under by() each panel's stored points are that panel's
    // serset, and the Total panel's the whole sample's.
    // ------------------------------------------------------------
    local k 0
    foreach c in "lfit mpg weight, xlog by(foreign)|0 1|" "lfitci mpg weight, xtransform(X^2) n(5) by(foreign, total)|0 1|total" {
        local ++k
        mata: q4_t = ustrsplit(st_local("c"), "[|]"); st_local("cmd", q4_t[1]); st_local("keys", q4_t[2]); st_local("tot", q4_t[3])
        sysuse auto, clear
        _q4_tw "`q4d'/p`k'.json" twoway `cmd' nodraw
        dash clear
        capture noisily dash `cmd' name(q4p`k')
        _w37_expect Q3704-5 "(_rc == 0)" "dash `cmd' rc `=_rc'"
        capture noisily _dash_serve_spec, specpath("`q4d'/ps`k'.json") datapath("`q4d'/pd`k'.json")
        local s 0
        foreach v of local keys {
            python: __import__("__main__")._q4_cmp("`q4d'/ps`k'.json", "q4p`k'", 1, "[`v']", "`q4d'/p`k'.json", `s', 1e-9)
            _w37_expect Q3704-5 "(${q4_ok} == 1)" "dash `cmd', panel foreign == `v': ${q4_msg}"
            local ++s
        }
        if "`tot'" != "" {
            python: __import__("__main__")._q4_cmp("`q4d'/ps`k'.json", "q4p`k'", 1, "total", "`q4d'/p`k'.json", `s', 1e-9)
            _w37_expect Q3704-5 "(${q4_ok} == 1)" "dash `cmd', the Total panel: ${q4_msg}"
        }
    }
    _w37_done Q3704-5 "under by() each panel stores its own serset, and the Total panel the whole sample's"

    // ------------------------------------------------------------
    // Q3704-6: xtransform() text reaches twoway's generator by value:
    // dash gives twoway's return code and first line for each.
    // ------------------------------------------------------------
    sysuse auto, clear
    local q4t1 = "X+" + char(36) + "y"
    local q4t2 "X;"
    local q4t3 `"X+"a""'
    local q4t4 = "X+" + char(96) + "y" + char(39)
    local q4t5 "nosuchvar"
    forvalues i = 1/5 {
        quietly log using "`lf'", text replace name(q4l)
        display "Q4MARK"
        capture noisily twoway lfit mpg weight, xtransform(`macval(q4t`i')') nodraw
        local trc = _rc
        display "Q4END"
        quietly log close q4l
        python: __import__("__main__")._q4_first("`lf'")
        local tline "${q4_line}"
        dash clear
        quietly log using "`lf'", text replace name(q4l)
        display "Q4MARK"
        capture noisily dash lfit mpg weight, xtransform(`macval(q4t`i')') name(q4x, replace)
        local drc = _rc
        display "Q4END"
        quietly log close q4l
        python: __import__("__main__")._q4_first("`lf'")
        display as text `"Q3704-6 text `i': twoway r(`trc') `tline' | dash r(`drc') ${q4_line}"'
        _w37_expect Q3704-6 `"(`trc' == `drc' & `"`tline'"' == `"${q4_line}"')"' `"text `i': twoway r(`trc') `tline', dash r(`drc') ${q4_line}"'
    }
    _w37_done Q3704-6 "xtransform() text is answered as twoway answers it"

    // ------------------------------------------------------------
    // Q3704-7: estopts() under by(): each panel's own fit, as twoway's.
    // ------------------------------------------------------------
    sysuse auto, clear
    _q4_tw "`q4d'/e.json" twoway lfit mpg weight, estopts(nocons) by(foreign) nodraw
    dash clear
    capture noisily dash lfit mpg weight, estopts(nocons) by(foreign) name(q4e)
    _w37_expect Q3704-7 "(_rc == 0)" "dash lfit estopts(nocons) by(foreign) rc `=_rc'"
    capture noisily _dash_serve_spec, specpath("`q4d'/es.json") datapath("`q4d'/ed.json")
    forvalues v = 0/1 {
        python: __import__("__main__")._q4_cmp("`q4d'/es.json", "q4e", 1, "[`v']", "`q4d'/e.json", `v', 1e-9)
        _w37_expect Q3704-7 "(${q4_ok} == 1)" "panel foreign == `v': ${q4_msg}"
        local q4e`v' "${q4_msg}"
    }
    _w37_expect Q3704-7 `"("`q4e0'" != "`q4e1'")"' "the two panels store the same points: `q4e0'"
    _w37_done Q3704-7 "estopts() under by() is fitted per panel as twoway fits it"

    capture erase "`lf'"
    local q4files : dir "`q4d'" files "*"
    foreach f of local q4files {
        capture erase "`q4d'/`f'"
    }
    capture rmdir "`q4d'"
    capture mata: mata drop q4_t
    macro drop q4_ok q4_msg q4_has q4_line
    dash clear
    display as text "S04 end " c(current_date) " " c(current_time)
}
* ==== end S04 ====

python:
import json as _w37s05_json
import numpy as _w37s05_np
from sfi import Data as _w37s05_D
from sfi import Macro as _w37s05_M


def _w37s05_render():
    """dash_render from this tree: the script runs from test/."""
    import os
    import sys
    repo = os.path.abspath("..")
    if repo not in sys.path:
        sys.path.insert(0, repo)
    import dash_render
    return dash_render


def _w37s05_col(name):
    return _w37s05_np.asarray(_w37s05_D.get(name), dtype=float).ravel()


def _w37s05_zero_df(fixture):
    """Globals w37s05_tw (twoway's band at a_d3 grid index 47: lower,
    upper, width) and w37s05_dw (dash's band width there): mpg on weight
    in memory, degree(3), the renderer's rule of thumb, local fit and
    standard error at the fixture's grid."""
    try:
        dr = _w37s05_render()
        [c] = [c for c in _w37s05_json.load(open(fixture, encoding="utf-8"))["cases"]
               if c["id"] == "a_d3"]
        lo, hi = float(c["cl"][47]), float(c["cu"][47])
        _w37s05_M.setGlobal("w37s05_tw", "%r %r %r" % (lo, hi, hi - lo))
        x, y = _w37s05_col("weight"), _w37s05_col("mpg")
        gm = dr.GlyphMapper
        rot = gm._default_lpoly_bwidth(x, y, None, 3, "epanechnikov")
        gx, gy = gm._compute_lpoly_fit(x, y, bwidth=rot, degree=3,
                                       kernel="epanechnikov", n_grid=50)
        if abs(gx[47] - float(c["gx"][47])) > 1e-9 * gx[47]:
            raise ValueError("grid %r against the fixture's %r" % (gx[47], c["gx"][47]))
        se = dr._lpoly_se(x, y, gx, rot, 1.5 * rot, 3, "epanechnikov")
        z = dr._dash_invnormal(0.975)
        _w37s05_M.setGlobal("w37s05_dw", repr(float((gy[47] + z * se[47])
                                                    - (gy[47] - z * se[47]))))
    except Exception as e:
        _w37s05_M.setGlobal("w37s05_tw", "error")
        _w37s05_M.setGlobal("w37s05_dw", "error " + str(e)[:200])


def _w37s05_rot(degree):
    """Global w37s05_h: dash's default lpoly bandwidth of mpg on weight in
    memory at *degree*, epanechnikov (GlyphMapper's rule of thumb)."""
    try:
        dr = _w37s05_render()
        h = dr.GlyphMapper._default_lpoly_bwidth(
            _w37s05_col("weight"), _w37s05_col("mpg"), None, int(degree),
            "epanechnikov")
        _w37s05_M.setGlobal("w37s05_h", repr(float(h)))
    except Exception as e:
        _w37s05_M.setGlobal("w37s05_h", "error " + str(e)[:200])


def _w37s05_ties(path, keys):
    """Global w37s05_ties: for each weight in *keys*, "ok" when the saved
    page's one Line joins the tied points' mpg in the data's order (mpg
    and weight in memory, in observation order), else what it drew."""
    import re
    from bokeh.document import Document
    from bokeh.models import GlyphRenderer, Line
    try:
        page = open(path, encoding="utf-8").read()
        ents = {"amp": "&", "lt": "<", "gt": ">", "quot": chr(34),
                "#x27": chr(39), "#x60": chr(96)}
        blocks = re.findall(
            r'<script type="application/json" id="[^"]+">\s*(.*?)\s*</script>',
            page, re.S)
        docs = [d for b in blocks
                for d in _w37s05_json.loads(re.sub(
                    r"&(amp|lt|gt|quot|#x27|#x60);",
                    lambda m: ents[m.group(1)], b)).values()]
        doc = Document.from_json(docs[0])
        [line] = [m for m in doc.models if isinstance(m, GlyphRenderer)
                  and isinstance(m.glyph, Line)]
        d = line.data_source.data
        lx = [float(v) for v in d[line.glyph.x.field]]
        ly = [float(v) for v in d[line.glyph.y.field]]
        x, y = _w37s05_col("weight"), _w37s05_col("mpg")
        out = []
        for k in [float(v) for v in keys.split()]:
            want = [float(b) for a, b in zip(x, y) if a == k]
            got = [b for a, b in zip(lx, ly) if a == k]
            out.append("ok" if len(want) > 1 and got == want
                       else "%g:%r/%r" % (k, got, want))
        _w37s05_M.setGlobal("w37s05_ties", " ".join(out))
    except Exception as e:
        _w37s05_M.setGlobal("w37s05_ties", "error " + str(e)[:200])
end

* ==== S05 stat:PT-16: lpolyci with no residual df ====
local only : env WP37_ONLY
if inlist("`only'", "", "S05") & `: list posof "S05" in w37_run' {
    display as text "S05 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3705-1: lpolyci mpg weight, degree(3) at grid index 47 (weight
    // 4714.29), where the pilot window has no residual degrees of
    // freedom: twoway's band (fixtures/lpolyci_truth.json case a_d3,
    // the committed truth) is finite and wider than 100, -50.75 to
    // 74.75; dash's band there has zero width.
    // ------------------------------------------------------------
    sysuse auto, clear
    python: _w37s05_zero_df("fixtures/lpolyci_truth.json")
    local s05_tw "${w37s05_tw}"
    local s05_dw "${w37s05_dw}"
    display as text "Q3705-1: twoway lower upper width `s05_tw'; dash width `s05_dw'"
    _w37_expect Q3705-1 `"(wordcount("`s05_tw'") == 3)"' "twoway's band not read: `s05_tw'"
    _w37_expect Q3705-1 `"(real(word("`s05_tw'", 3)) > 100 & real(word("`s05_tw'", 3)) < .)"' "twoway's band is not finite and wider than 100: `s05_tw'"
    _w37_expect Q3705-1 `"(abs(real(word("`s05_tw'", 1)) + 50.75) < .005 & abs(real(word("`s05_tw'", 2)) - 74.75) < .005)"' "twoway's band is not -50.75 to 74.75: `s05_tw'"
    _w37_expect Q3705-1 `"(abs(real("`s05_dw'")) < 1e-9)"' "dash's band width is `s05_dw', not 0"
    _w37_done Q3705-1 "at weight 4714.29 twoway draws -50.75 to 74.75 and dash a zero-width band"
    macro drop w37s05_tw w37s05_dw
    display as text "S05 end " c(current_date) " " c(current_time)
}
* ==== end S05 ====

* ==== S05 DT-26: numeric limits ====
local only : env WP37_ONLY
if inlist("`only'", "", "S05") & `: list posof "S05" in w37_run' {
    display as text "S05 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3705-2: the help's degree-8 numbers.  lpoly mpg weight,
    // degree(8)'s r(bwidth) is 484.23 in Stata, and dash's default
    // bandwidth there is 400.94 (both to 0.01).
    // ------------------------------------------------------------
    sysuse auto, clear
    capture noisily lpoly mpg weight, degree(8) nograph
    local s05_rc = _rc
    local s05_sh = r(bwidth)
    python: _w37s05_rot(8)
    local s05_dh "${w37s05_h}"
    display as text "Q3705-2: Stata r(bwidth) `s05_sh' (rc `s05_rc'); dash `s05_dh'"
    _w37_expect Q3705-2 "(`s05_rc' == 0)" "lpoly ..., degree(8) rc `s05_rc'"
    _w37_expect Q3705-2 "(abs(`s05_sh' - 484.23) < .01)" "Stata's r(bwidth) is `s05_sh', not 484.23"
    _w37_expect Q3705-2 `"(abs(real("`s05_dh'") - 400.94) < .01)"' "dash's bandwidth is `s05_dh', not 400.94"
    _w37_done Q3705-2 "degree 8: Stata's bandwidth `s05_sh', dash's `s05_dh'"
    macro drop w37s05_h
    display as text "S05 end " c(current_date) " " c(current_time)
}
