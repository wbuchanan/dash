*! test_wp38_truth.cscript
*! WP-38's ONE certification script (.ultraplan/sections/index.md PD-6):
*! every comparison with twoway's drawing or with Stata's own values that
*! WP-38's sections need lives here, one block per GAPS4 row (or per
*! harness tool), appended above the "append new blocks above this line"
*! marker in section order.  Refusal, message and return-code checks join
*! the EXISTING script for their area (merge rule R1).
*!
*! Made from test/templates/wp_truth_template.cscript (38 -> the WP's
*! number).  S00 is the scaffold smoke (Q3800-1).  A section appends
*! `* ==== S<MM> <lead id>: <what> ====` ... `* ==== end S<MM> ====` (or
*! `S<MM> tool: <what>` for a section with no item), its helper programs
*! directly above its first header, and writes only inside its own
*! blocks.  Case ids are Q38<MM>-<k> (PD-5).
*!
*! Usage: via run_all_cscripts.do.  One block alone: WP38_ONLY=S<MM> in
*! the driver's environment.  Each block prints "S<MM> start" and "S<MM>
*! end" with the date and time.  Its row in run_all_cscripts.do's shard
*! table is `*' when the script is long enough to split
*! (scripts/cert_shards.py's rule), else a shard number, and then the
*! session that runs it runs every block; under a `*' row
*! DASH_CERT_SHARD=k/N runs part k of N of the blocks, and a part with no
*! block ends 0.  A new WP's row: `python3 scripts/cert_shards.py add
*! test_wpNN_truth.cscript'.

cscript "WP-38 truth: twoway comparisons" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off


do "cert_helpers.do"
quietly do "cert_svg.do"
qui run "../dash_parse.mata"
qui run "../dash.ado"
global dash_nobrowser 1

// ----------------------------------------------------------------
// Tally helpers -- test_wp29_truth.cscript's _w29_expect/_w29_done,
// renamed _w38_ for this script.  A case is any number of
// _w38_expect lines closed by one _w38_done.
// ----------------------------------------------------------------
global w38_nfail    = 0
global w38_faillist ""
global w38_bad      = 0
global w38_ncase    = 0

capture program drop _w38_expect
program define _w38_expect
    version 19
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global w38_bad = 1
    }
end

capture program drop _w38_done
program define _w38_done
    version 19
    args id msg
    if ${w38_bad} {
        global w38_nfail    = ${w38_nfail} + 1
        global w38_faillist "${w38_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global w38_bad   = 0
    global w38_ncase = ${w38_ncase} + 1
end

// A fresh directory for this run's files, never one that already exists:
// a fixed name in a shared temp directory could be planted by another
// account (rule 1), so a name Stata has not handed out before is made and
// the run fails if it cannot be.  Every block writes only under it.
tempfile w38_base
local w38_work "`w38_base'_w38"
capture mkdir "`w38_work'"
if _rc {
    display as error "test_wp38_truth: cannot create the work directory `w38_work' (rc `=_rc')"
    exit 9
}

// ---- parts: begin (WP-38 test performance) ----
// Its row in run_all_cscripts.do's shard table is "*" when the script is
// long enough to split (scripts/cert_shards.py's rule), else a shard
// number, and then the session that runs it runs every block
// (_w38_whole reads the row).  Under a "*" row, with
// DASH_CERT_SHARD=k/N set, the session runs part k of N of the blocks.
// The parts are balanced longest first onto the least loaded part (the
// lowest numbered of equals), by the blocks' seconds -- a block not listed
// counts 1 s (section-01 D-01.f) -- the rule scripts/cert_shards.py uses
// for the scripts.  Unset, or with WP38_ONLY set
// (which keeps its precedence), every block runs.  A block runs when its
// gate finds its id in w38_run.
// Seconds: the runner's block seconds line for this script (secs
// test_wp38_truth.cscript S00 1 ..., after the shard table), where
// cert_shards.py write puts each block's start/end lines of a measured
// certification run, rounded up, at least 1; no line: S00 1.
capture mata: mata drop _w38_part()
capture mata: mata drop _w38_whole()
capture mata: mata drop _w38_secs()
mata:
// 1 when the runner's shard table gives the script a shard number for n
// sessions (its row's word n + 2), so that it runs whole; 0 for "*" or
// "*r", no runner, no table or no row (the script then splits).
real scalar _w38_whole(string scalar runner, string scalar script,
                       real scalar n)
{
    string colvector l
    string rowvector t
    real scalar i, inside

    if (n < 2 | !fileexists(runner)) return(0)
    l = cat(runner)
    inside = 0
    for (i = 1; i <= rows(l); i++) {
        if (strpos(l[i], "// ---- shards: begin") == 1) inside = 1
        else if (strpos(l[i], "// ---- shards: end") == 1) inside = 0
        else if (inside) {
            t = tokens(l[i])
            if (cols(t) < n + 2) continue
            if (t[1] != script) continue
            return(ustrregexm(t[n + 2], "^[0-9]+$"))
        }
    }
    return(0)
}
// The blocks' seconds, "S00 1 S01 12 ...", from the runner's
// block seconds line for the script; none (or no runner): "S00 1".
string scalar _w38_secs(string scalar runner, string scalar script)
{
    string colvector l
    string rowvector t
    real scalar i

    if (!fileexists(runner)) return("S00 1")
    l = cat(runner)
    for (i = 1; i <= rows(l); i++) {
        t = tokens(l[i])
        if (cols(t) < 5) continue
        if (t[1] == "//" & t[2] == "secs" & t[3] == script) {
            return(invtokens(t[|4 \ cols(t)|]))
        }
    }
    return("S00 1")
}
end
mata: st_local("w38_secs", _w38_secs("run_all_cscripts.do", "test_wp38_truth.cscript"))
local w38_sh : environment DASH_CERT_SHARD
mata: st_local("w38_ok", strofreal(st_local("w38_sh") == "" | ustrregexm(st_local("w38_sh"), "^[1-8]/[1-8]$")))
if !`w38_ok' {
    display as error "test_wp38_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 8"
    exit 198
}
local w38_k 1
local w38_N 1
if "`w38_sh'" != "" {
    local w38_k = real(substr("`w38_sh'", 1, 1))
    local w38_N = real(substr("`w38_sh'", 3, 1))
}
local w38_only : env WP38_ONLY
if `"`macval(w38_only)'"' != "" | `w38_N' == 1 {
    local w38_k 1
    local w38_N 1
}
if `w38_k' > `w38_N' {
    display as error "test_wp38_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 8"
    exit 198
}
// A shard number in its row: the runner runs the script only in that
// shard's session, so the session runs every block.
local w38_how ""
if `w38_N' > 1 {
    mata: st_local("w38_whole", strofreal(_w38_whole("run_all_cscripts.do", "test_wp38_truth.cscript", `w38_N')))
    if `w38_whole' {
        local w38_how " whole (shard `w38_k'/`w38_N')"
        local w38_k 1
        local w38_N 1
    }
}
capture confirm file "test_wp38_truth.cscript"
if _rc {
    display as error "test_wp38_truth: run it from test/, where it reads its own blocks"
    exit 601
}
mata:
// The ids of the blocks (their header lines, in file order), and those of
// part k of n: longest first onto the least loaded part.
void _w38_part(string scalar file, string scalar table, real scalar k,
               real scalar n)
{
    string colvector lines, ids
    string rowvector tok
    real colvector sec, o, at
    real rowvector load
    real scalar i, j, p, best
    string scalar run

    lines = cat(file)
    ids = J(0, 1, "")
    for (i = 1; i <= rows(lines); i++) {
        if (ustrregexm(lines[i], "^\* ==== (S[0-9]+) ")) {
            if (!anyof(ids, ustrregexs(1))) ids = ids \ ustrregexs(1)
        }
    }
    sec = J(rows(ids), 1, 1)
    tok = tokens(table)
    for (j = 1; j + 1 <= cols(tok); j = j + 2) {
        for (i = 1; i <= rows(ids); i++) {
            if (ids[i] == tok[j]) sec[i] = strtoreal(tok[j + 1])
        }
    }
    o = order((-sec, (1::rows(ids))), (1, 2))
    load = J(1, n, 0)
    at = J(rows(ids), 1, 0)
    for (i = 1; i <= rows(o); i++) {
        best = 1
        for (p = 2; p <= n; p++) if (load[p] < load[best]) best = p
        load[best] = load[best] + sec[o[i]]
        at[o[i]] = best
    }
    run = ""
    for (i = 1; i <= rows(ids); i++) if (at[i] == k) run = run + " " + ids[i]
    st_local("w38_run", strtrim(run))
}
end
// The part this session runs: the runner's shard table may turn the
// parts (cert_helpers.do's cert_split_part, 11nov2026), so that
// each script's longest part lands on a different session.
cert_split_part "test_wp38_truth.cscript" `w38_k' `w38_N'
local w38_p = r(part)
mata: _w38_part("test_wp38_truth.cscript", st_local("w38_secs"), `w38_p', `w38_N')
if "`w38_how'" != "" display as text "test_wp38_truth: runs`w38_how', `: word count `w38_run'' blocks: `w38_run'"
else display as text "test_wp38_truth: session `w38_k'/`w38_N' runs part `w38_p', `: word count `w38_run'' blocks: `w38_run'"
// ---- parts: end ----

* ==== S00 scaffold: the helpers load and a twoway SVG is read ====
local only : env WP38_ONLY
if inlist("`only'", "", "S00") & `: list posof "S00" in w38_run' {
    display as text "S00 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3800-1: cert_svg_export and cert_svg_texts on one twoway scatter,
    // and dash's own programs are loaded from this tree.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(w38s01, replace)
    cert_svg_export, name(w38s01) file("`w38_work'/w38s01.svg")
    local s01_rc   = r(rc)
    local s01_file "`r(file)'"
    _w38_expect Q3800-1 "(`s01_rc' == 0)" "cert_svg_export rc `s01_rc'"
    capture confirm file "`s01_file'"
    _w38_expect Q3800-1 "(_rc == 0)" "r(file) `s01_file' does not exist"
    cert_svg_texts, file("`s01_file'")
    local s01_n    = r(n)
    local s01_list "`r(list)'"
    _w38_expect Q3800-1 "(`s01_n' > 0)" "cert_svg_texts found no text elements"
    capture program list _dash_serve
    _w38_expect Q3800-1 "(_rc == 0)" "dash.ado's _dash_serve is not loaded"
    _w38_done Q3800-1 "a twoway SVG was written and read (`s01_n' texts); dash is loaded"

    capture erase "`s01_file'"
    capture erase "`s01_list'"
    capture graph drop w38s01
    display as text "S00 end " c(current_date) " " c(current_time)
}
* ==== end S00 ====

// ----------------------------------------------------------------
// S01's helper (section 38-01): _w38_s01_log <log> <needle> sets
// c_local s01c to the number of logical lines of <log> holding <needle>.
// ----------------------------------------------------------------
capture program drop _w38_s01_log
program define _w38_s01_log
    version 19
    cert_log_has "`1'", needle(`"`2'"')
    c_local s01c = r(count)
end
// _w38_s01_tv: registers q3801v, a graph of a temporary variable that is
// dropped when this program ends (Q3801-3).
capture program drop _w38_s01_tv
program define _w38_s01_tv
    version 19
    tempvar tv
    quietly generate `tv' = 2 * mpg
    dash scatter `tv' weight, name(q3801v)
end

* ==== S01 syn:SD-17: a dashboard is not a Stata graph ====
local only : env WP38_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w38_run' {
    display as text "S01 start " c(current_date) " " c(current_time)
    local s01d "`w38_work'/s01"
    capture mkdir "`s01d'"
    capture dash clear
    capture graph drop _all

    // ------------------------------------------------------------
    // Q3801-1 (syn:SD-17): name() registers and draws nothing; saving()
    // beside it is named in the note and writes nothing, where twoway's
    // name() with saving() writes the .gph.
    // ------------------------------------------------------------
    sysuse auto, clear
    capture erase "`s01d'/q1.html"
    capture log close s01l
    quietly log using "`s01d'/q1.log", text replace name(s01l) nomsg
    capture noisily dash scatter mpg weight, name(q3801a) saving("`s01d'/q1.html", replace)
    local q1_rc = _rc
    quietly log close s01l
    _w38_expect Q3801-1 "(`q1_rc' == 0)" "dash ..., name() saving() rc `q1_rc'"
    capture confirm file "`s01d'/q1.html"
    _w38_expect Q3801-1 "(_rc == 601)" "saving() beside name() wrote a file"
    _w38_s01_log "`s01d'/q1.log" "dash: ignoring unsupported option(s): saving()"
    _w38_expect Q3801-1 "(`s01c' == 1)" "the note naming saving() was printed `s01c' times"
    local q1_reg : list posof "q3801a" in global(dash_graph_registry)
    _w38_expect Q3801-1 "(`q1_reg' > 0)" "q3801a is not registered"
    capture graph describe q3801a
    _w38_expect Q3801-1 "(_rc != 0)" "dash made a Stata graph q3801a"
    capture erase "`s01d'/q1t.gph"
    capture noisily twoway scatter mpg weight, name(q3801t) saving("`s01d'/q1t.gph", replace) nodraw
    local q1_trc = _rc
    _w38_expect Q3801-1 "(`q1_trc' == 0)" "twoway name() saving() nodraw rc `q1_trc'"
    capture confirm file "`s01d'/q1t.gph"
    _w38_expect Q3801-1 "(_rc == 0)" "twoway's saving() beside name() wrote no .gph"
    _w38_done Q3801-1 "name() registers and saving() beside it writes nothing; twoway writes the .gph"
    capture dash clear
    capture graph drop _all

    // ------------------------------------------------------------
    // Q3801-2 (GW-12): after dash, graph export writes the graph twoway
    // drew before it, and dash's note names that graph; a drawn graph
    // since dropped is still the one written.  The r(601) cases need a
    // session in which nothing was drawn, which this shared session is
    // not: graph_export_truth.json (no_graph, nodraw_only) holds them,
    // and test_help_graph_integration.py reads it.
    // ------------------------------------------------------------
    quietly twoway scatter mpg weight, name(q3801d)
    capture log close s01l
    quietly log using "`s01d'/q2.log", text replace name(s01l) nomsg
    capture noisily dash scatter mpg weight, saving("`s01d'/q2.html", replace)
    local q2_rc = _rc
    quietly log close s01l
    _w38_expect Q3801-2 "(`q2_rc' == 0)" "dash ..., saving() rc `q2_rc'"
    _w38_s01_log "`s01d'/q2.log" "graph export writes the graph in Stata's Graph window, not this dashboard; graphs in memory: q3801d"
    _w38_expect Q3801-2 "(`s01c' == 1)" "the graph-memory note naming q3801d was printed `s01c' times"
    capture erase "`s01d'/q2.png"
    capture noisily graph export "`s01d'/q2.png", replace
    _w38_expect Q3801-2 "(_rc == 0)" "graph export after dash rc `=_rc'"
    capture confirm file "`s01d'/q2.png"
    _w38_expect Q3801-2 "(_rc == 0)" "graph export after dash wrote no file"
    capture graph drop _all
    capture erase "`s01d'/q2b.png"
    capture noisily graph export "`s01d'/q2b.png", replace
    _w38_expect Q3801-2 "(_rc == 0)" "graph export after graph drop _all rc `=_rc'"
    capture graph describe q3801d
    _w38_expect Q3801-2 "(_rc != 0)" "q3801d is still in memory"
    _w38_done Q3801-2 "graph export after dash writes twoway's earlier graph, dropped or not, and the note names it"
    capture graph drop _all

    // ------------------------------------------------------------
    // Q3801-3 (ECO-1): a registered graph keeps no data.  Registered on
    // collapsed data and built after restore, it draws the restored rows
    // (69 with rep78), with no note; a graph of a tempvar that is gone
    // by the build fails there, r(111).
    // ------------------------------------------------------------
    capture dash clear
    sysuse auto, clear
    preserve
    collapse (mean) mpg, by(rep78)
    local q3_nc = _N
    dash line mpg rep78, name(q3801r)
    restore
    capture erase "`s01d'/q3.html"
    capture log close s01l
    quietly log using "`s01d'/q3.log", text replace name(s01l) nomsg
    capture noisily dash build, saving("`s01d'/q3.html") replace nobrowser
    local q3_rc = _rc
    quietly log close s01l
    _w38_expect Q3801-3 "(`q3_rc' == 0)" "dash build after restore rc `q3_rc'"
    _w38_s01_log "`s01d'/q3.log" "note"
    _w38_expect Q3801-3 "(`s01c' == 0)" "dash build printed `s01c' notes"
    global w38_s01_page "`s01d'/q3.html"
    python:
import os as _q3_os, sys as _q3_sys
from sfi import Macro as _q3_M
_q3_sys.path.insert(0, _q3_os.path.abspath("."))
import embed_truth_check as _q3_c
_q3_M.setGlobal("w38_s01_rows", str(_q3_c.page_rows(_q3_M.getGlobal("w38_s01_page"))["rows"]))
end
    local q3_rows ${w38_s01_rows}
    macro drop w38_s01_page w38_s01_rows
    quietly count if !missing(rep78)
    _w38_expect Q3801-3 "(`q3_rows' == r(N) & `q3_rows' != `q3_nc')" "the page holds `q3_rows' rows; restored data `=r(N)', collapsed `q3_nc'"
    capture dash clear
    _w38_s01_tv
    capture erase "`s01d'/q3v.html"
    capture log close s01l
    quietly log using "`s01d'/q3v.log", text replace name(s01l) nomsg
    capture noisily dash build, saving("`s01d'/q3v.html") replace nobrowser
    local q3_vrc = _rc
    quietly log close s01l
    _w38_expect Q3801-3 "(`q3_vrc' == 111)" "dash build of a gone tempvar rc `q3_vrc'"
    _w38_s01_log "`s01d'/q3v.log" " not found"
    _w38_expect Q3801-3 "(`s01c' >= 1)" "no 'not found' message"
    _w38_done Q3801-3 "a registered graph draws the data at dash build: restored rows `q3_rows' (collapsed `q3_nc'), a gone tempvar r(111)"
    capture dash clear

    // ------------------------------------------------------------
    // Q3801-4 (ECO-4): dash build takes title() and subtitle() but none of
    // graph combine's other options, "option X not allowed", r(198), where
    // graph combine takes them; graph combine of a registered name is
    // refused, "<name> is not a memory graph", r(198).
    // ------------------------------------------------------------
    sysuse auto, clear
    dash scatter mpg weight, name(q3801g)
    foreach o in "cols(2)" "rows(2)" "holes(2)" "colfirst" "xcommon" "ycommon" "iscale(.5)" "imargin(small)" "note(n)" "caption(c)" "xsize(5)" "ysize(5)" {
        local q4_w = ustrregexra("`o'", "\(.*\)", "()")
        capture log close s01l
        quietly log using "`s01d'/q4.log", text replace name(s01l) nomsg
        capture noisily dash build, saving("`s01d'/q4.html") replace nobrowser `o'
        local q4_rc = _rc
        quietly log close s01l
        _w38_expect Q3801-4 "(`q4_rc' == 198)" "dash build, `o' rc `q4_rc'"
        _w38_s01_log "`s01d'/q4.log" "option `q4_w' not allowed"
        _w38_expect Q3801-4 "(`s01c' == 1)" "dash build, `o': no 'option `q4_w' not allowed'"
    }
    foreach o in "title(T)" "subtitle(S)" {
        capture noisily dash build, saving("`s01d'/q4.html") replace nobrowser `o'
        _w38_expect Q3801-4 "(_rc == 0)" "dash build, `o' rc `=_rc'"
    }
    capture graph drop _all
    quietly twoway scatter mpg weight, nodraw name(q3801ca)
    quietly twoway scatter price weight, nodraw name(q3801cb)
    capture noisily graph combine q3801ca q3801cb, cols(2) holes(3) colfirst xcommon ycommon iscale(.5) imargin(small) note(n) caption(c) xsize(5) ysize(5) nodraw name(q3801cc)
    _w38_expect Q3801-4 "(_rc == 0)" "graph combine with its options rc `=_rc'"
    capture log close s01l
    quietly log using "`s01d'/q4c.log", text replace name(s01l) nomsg
    capture noisily graph combine q3801g
    local q4_crc = _rc
    quietly log close s01l
    _w38_expect Q3801-4 "(`q4_crc' == 198)" "graph combine q3801g rc `q4_crc'"
    _w38_s01_log "`s01d'/q4c.log" "q3801g is not a memory graph"
    _w38_expect Q3801-4 "(`s01c' == 1)" "no 'q3801g is not a memory graph'"
    _w38_done Q3801-4 "dash build refuses graph combine's options and takes title() and subtitle(); graph combine refuses a registered name"
    capture dash clear
    capture graph drop _all

    // ------------------------------------------------------------
    // Q3801-5 (ECO-7): dash leaves s(_recast_type) and s(g_saving) or
    // s(g_name); twoway, run after it, leaves s() empty.
    // ------------------------------------------------------------
    sysuse auto, clear
    sreturn clear
    capture erase "`s01d'/q5.html"
    dash scatter mpg weight, saving("`s01d'/q5.html", replace)
    _w38_expect Q3801-5 `"("`s(_recast_type)'" == "scatter")"' `"dash left s(_recast_type) "`s(_recast_type)'""'
    _w38_expect Q3801-5 `"("`s(g_saving)'" != "")"' "dash left no s(g_saving)"
    dash scatter mpg weight, name(q3801s)
    _w38_expect Q3801-5 `"("`s(g_name)'" == "q3801s")"' `"dash left s(g_name) "`s(g_name)'""'
    quietly twoway scatter mpg weight, nodraw name(q3801st)
    mata: st_local("q5_left", invtokens(st_dir("s()", "macro", "*")'))
    _w38_expect Q3801-5 `"("`q5_left'" == "")"' "twoway after dash left s(): `q5_left'"
    _w38_done Q3801-5 "dash leaves its parsers' s(); twoway after it leaves s() empty"
    capture dash clear
    capture graph drop _all

    local s01f : dir "`s01d'" files "*"
    foreach f of local s01f {
        capture erase "`s01d'/`f'"
    }
    capture rmdir "`s01d'"
    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====

* ==== append new blocks above this line ====

// ----------------------------------------------------------------
// Summary (test_wp29_truth.cscript's shape)
// ----------------------------------------------------------------
capture graph drop _all
capture dash clear
capture rmdir "`w38_work'"
local nfail    = ${w38_nfail}
local faillist "${w38_faillist}"
local ncase    = ${w38_ncase}
local only : env WP38_ONLY
macro drop w38_nfail w38_faillist w38_bad w38_ncase
display as text ""
display as text "============================================================"
if `ncase' == 0 {
    if `w38_N' > 1 & `"`macval(only)'"' == "" & "`w38_run'" == "" {
        display as text "test_wp38_truth: part `w38_k'/`w38_N' has no block to run"
        display as text "============================================================"
        exit 0
    }
    // A WP38_ONLY that names no block, or only a stub, ran nothing:
    // that is not a pass.
    display as error "  test_wp38_truth: no case ran (WP38_ONLY=`only')"
    display as text "============================================================"
    exit 9
}
else if `nfail' == 0 {
    display as text "  test_wp38_truth: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_wp38_truth: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
