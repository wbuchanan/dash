*! test_wp38_truth.cscript
*! WP-38's ONE certification script (.ultraplan/sections/index.md PD-6):
*! every comparison with twoway's drawing or with Stata's own values that
*! WP-38's sections need lives here, one block per GAPS4 row (or per
*! harness tool), appended above the "append new blocks above this line"
*! marker in section order.  Refusal, message and return-code checks join
*! the EXISTING script for their area (merge rule R1).
*!
*! Made from test/templates/wp_truth_template.cscript (38 -> the WP's
*! number).  S00 is the scaffold smoke (Q3800-1).  A section appends
*! `* ==== S<MM> <lead id>: <what> ====` ... `* ==== end S<MM> ====` (or
*! `S<MM> tool: <what>` for a section with no item), its helper programs
*! directly above its first header, and writes only inside its own
*! blocks.  Case ids are Q38<MM>-<k> (PD-5).
*!
*! Usage: via run_all_cscripts.do.  One block alone: WP38_ONLY=S<MM> in
*! the driver's environment.  Each block prints "S<MM> start" and "S<MM>
*! end" with the date and time.  The suite runs it in every session;
*! DASH_CERT_SHARD=k/N runs part k of N of the blocks; a part with no
*! block ends 0.

cscript "WP-38 truth: twoway comparisons" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off


do "cert_helpers.do"
quietly do "cert_svg.do"
qui do "../dash_parse.mata"
qui do "../dash.ado"
global dash_nobrowser 1

// ----------------------------------------------------------------
// Tally helpers -- test_wp29_truth.cscript's _w29_expect/_w29_done,
// renamed _w38_ for this script.  A case is any number of
// _w38_expect lines closed by one _w38_done.
// ----------------------------------------------------------------
global w38_nfail    = 0
global w38_faillist ""
global w38_bad      = 0
global w38_ncase    = 0

capture program drop _w38_expect
program define _w38_expect
    version 19
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global w38_bad = 1
    }
end

capture program drop _w38_done
program define _w38_done
    version 19
    args id msg
    if ${w38_bad} {
        global w38_nfail    = ${w38_nfail} + 1
        global w38_faillist "${w38_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global w38_bad   = 0
    global w38_ncase = ${w38_ncase} + 1
end

// A fresh directory for this run's files, never one that already exists:
// a fixed name in a shared temp directory could be planted by another
// account (rule 1), so a name Stata has not handed out before is made and
// the run fails if it cannot be.  Every block writes only under it.
tempfile w38_base
local w38_work "`w38_base'_w38"
capture mkdir "`w38_work'"
if _rc {
    display as error "test_wp38_truth: cannot create the work directory `w38_work' (rc `=_rc')"
    exit 9
}

// ---- parts: begin (WP-38 test performance) ----
// The certification suite runs this script in every one of its sessions
// (its row in run_all_cscripts.do's shard table is "* * *"); with
// DASH_CERT_SHARD=k/N set, the session runs part k of N of the blocks.
// The parts are balanced longest first onto the least loaded part (the
// lowest numbered of equals), by the seconds below -- a block not listed
// counts 1 s (section-01 D-01.f) -- the rule scripts/cert_shards.py uses
// for the scripts.  Unset, or with WP38_ONLY set
// (which keeps its precedence), every block runs.  A block runs when its
// gate finds its id in w38_run.
// Seconds: each block's start/end lines in the WP's last measured
// certification run, rounded up, at least 1; a block not listed
// counts 1 s.
local w38_secs S00 1
local w38_sh : environment DASH_CERT_SHARD
mata: st_local("w38_ok", strofreal(st_local("w38_sh") == "" | ustrregexm(st_local("w38_sh"), "^[1-4]/[1-4]$")))
if !`w38_ok' {
    display as error "test_wp38_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 4"
    exit 198
}
local w38_k 1
local w38_N 1
if "`w38_sh'" != "" {
    local w38_k = real(substr("`w38_sh'", 1, 1))
    local w38_N = real(substr("`w38_sh'", 3, 1))
}
local w38_only : env WP38_ONLY
if `"`macval(w38_only)'"' != "" | `w38_N' == 1 {
    local w38_k 1
    local w38_N 1
}
if `w38_k' > `w38_N' {
    display as error "test_wp38_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 4"
    exit 198
}
capture confirm file "test_wp38_truth.cscript"
if _rc {
    display as error "test_wp38_truth: run it from test/, where it reads its own blocks"
    exit 601
}
capture mata: mata drop _w38_part()
mata:
// The ids of the blocks (their header lines, in file order), and those of
// part k of n: longest first onto the least loaded part.
void _w38_part(string scalar file, string scalar table, real scalar k,
               real scalar n)
{
    string colvector lines, ids
    string rowvector tok
    real colvector sec, o, at
    real rowvector load
    real scalar i, j, p, best
    string scalar run

    lines = cat(file)
    ids = J(0, 1, "")
    for (i = 1; i <= rows(lines); i++) {
        if (ustrregexm(lines[i], "^\* ==== (S[0-9]+) ")) {
            if (!anyof(ids, ustrregexs(1))) ids = ids \ ustrregexs(1)
        }
    }
    sec = J(rows(ids), 1, 1)
    tok = tokens(table)
    for (j = 1; j + 1 <= cols(tok); j = j + 2) {
        for (i = 1; i <= rows(ids); i++) {
            if (ids[i] == tok[j]) sec[i] = strtoreal(tok[j + 1])
        }
    }
    o = order((-sec, (1::rows(ids))), (1, 2))
    load = J(1, n, 0)
    at = J(rows(ids), 1, 0)
    for (i = 1; i <= rows(o); i++) {
        best = 1
        for (p = 2; p <= n; p++) if (load[p] < load[best]) best = p
        load[best] = load[best] + sec[o[i]]
        at[o[i]] = best
    }
    run = ""
    for (i = 1; i <= rows(ids); i++) if (at[i] == k) run = run + " " + ids[i]
    st_local("w38_run", strtrim(run))
}
end
mata: _w38_part("test_wp38_truth.cscript", st_local("w38_secs"), `w38_k', `w38_N')
display as text "test_wp38_truth: part `w38_k'/`w38_N' runs `: word count `w38_run'' blocks: `w38_run'"
// ---- parts: end ----

* ==== S00 scaffold: the helpers load and a twoway SVG is read ====
local only : env WP38_ONLY
if inlist("`only'", "", "S00") & `: list posof "S00" in w38_run' {
    display as text "S00 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3800-1: cert_svg_export and cert_svg_texts on one twoway scatter,
    // and dash's own programs are loaded from this tree.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(w38s01, replace)
    cert_svg_export, name(w38s01) file("`w38_work'/w38s01.svg")
    local s01_rc   = r(rc)
    local s01_file "`r(file)'"
    _w38_expect Q3800-1 "(`s01_rc' == 0)" "cert_svg_export rc `s01_rc'"
    capture confirm file "`s01_file'"
    _w38_expect Q3800-1 "(_rc == 0)" "r(file) `s01_file' does not exist"
    cert_svg_texts, file("`s01_file'")
    local s01_n    = r(n)
    local s01_list "`r(list)'"
    _w38_expect Q3800-1 "(`s01_n' > 0)" "cert_svg_texts found no text elements"
    capture program list _dash_serve
    _w38_expect Q3800-1 "(_rc == 0)" "dash.ado's _dash_serve is not loaded"
    _w38_done Q3800-1 "a twoway SVG was written and read (`s01_n' texts); dash is loaded"

    capture erase "`s01_file'"
    capture erase "`s01_list'"
    capture graph drop w38s01
    display as text "S00 end " c(current_date) " " c(current_time)
}
* ==== end S00 ====

// ----------------------------------------------------------------
// S01's helper (section 38-01): _w38_s01_log <log> <needle> sets
// c_local s01c to the number of logical lines of <log> holding <needle>.
// ----------------------------------------------------------------
capture program drop _w38_s01_log
program define _w38_s01_log
    version 19
    cert_log_has "`1'", needle(`"`2'"')
    c_local s01c = r(count)
end

* ==== S01 syn:SD-17: a dashboard is not a Stata graph ====
local only : env WP38_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w38_run' {
    display as text "S01 start " c(current_date) " " c(current_time)
    local s01d "`w38_work'/s01"
    capture mkdir "`s01d'"
    capture dash clear
    capture graph drop _all

    // ------------------------------------------------------------
    // Q3801-1 (syn:SD-17): name() registers and draws nothing; saving()
    // beside it is named in the note and writes nothing, where twoway's
    // name() with saving() writes the .gph.
    // ------------------------------------------------------------
    sysuse auto, clear
    capture erase "`s01d'/q1.html"
    capture log close s01l
    quietly log using "`s01d'/q1.log", text replace name(s01l) nomsg
    capture noisily dash scatter mpg weight, name(q3801a) saving("`s01d'/q1.html", replace)
    local q1_rc = _rc
    quietly log close s01l
    _w38_expect Q3801-1 "(`q1_rc' == 0)" "dash ..., name() saving() rc `q1_rc'"
    capture confirm file "`s01d'/q1.html"
    _w38_expect Q3801-1 "(_rc == 601)" "saving() beside name() wrote a file"
    _w38_s01_log "`s01d'/q1.log" "dash: ignoring unsupported option(s): saving()"
    _w38_expect Q3801-1 "(`s01c' == 1)" "the note naming saving() was printed `s01c' times"
    local q1_reg : list posof "q3801a" in global(dash_graph_registry)
    _w38_expect Q3801-1 "(`q1_reg' > 0)" "q3801a is not registered"
    capture graph describe q3801a
    _w38_expect Q3801-1 "(_rc != 0)" "dash made a Stata graph q3801a"
    capture erase "`s01d'/q1t.gph"
    capture noisily twoway scatter mpg weight, name(q3801t) saving("`s01d'/q1t.gph", replace) nodraw
    local q1_trc = _rc
    _w38_expect Q3801-1 "(`q1_trc' == 0)" "twoway name() saving() nodraw rc `q1_trc'"
    capture confirm file "`s01d'/q1t.gph"
    _w38_expect Q3801-1 "(_rc == 0)" "twoway's saving() beside name() wrote no .gph"
    _w38_done Q3801-1 "name() registers and saving() beside it writes nothing; twoway writes the .gph"
    capture dash clear
    capture graph drop _all

    // ------------------------------------------------------------
    // Q3801-2 (GW-12): after dash, graph export writes the graph twoway
    // drew before it, and dash's note names that graph; a drawn graph
    // since dropped is still the one written.  The r(601) cases need a
    // session in which nothing was drawn, which this shared session is
    // not: graph_export_truth.json (no_graph, nodraw_only) holds them,
    // and test_help_graph_integration.py reads it.
    // ------------------------------------------------------------
    quietly twoway scatter mpg weight, name(q3801d)
    capture log close s01l
    quietly log using "`s01d'/q2.log", text replace name(s01l) nomsg
    capture noisily dash scatter mpg weight, saving("`s01d'/q2.html", replace)
    local q2_rc = _rc
    quietly log close s01l
    _w38_expect Q3801-2 "(`q2_rc' == 0)" "dash ..., saving() rc `q2_rc'"
    _w38_s01_log "`s01d'/q2.log" "graph export writes the graph in Stata's Graph window, not this dashboard; graphs in memory: q3801d"
    _w38_expect Q3801-2 "(`s01c' == 1)" "the graph-memory note naming q3801d was printed `s01c' times"
    capture erase "`s01d'/q2.png"
    capture noisily graph export "`s01d'/q2.png", replace
    _w38_expect Q3801-2 "(_rc == 0)" "graph export after dash rc `=_rc'"
    capture confirm file "`s01d'/q2.png"
    _w38_expect Q3801-2 "(_rc == 0)" "graph export after dash wrote no file"
    capture graph drop _all
    capture erase "`s01d'/q2b.png"
    capture noisily graph export "`s01d'/q2b.png", replace
    _w38_expect Q3801-2 "(_rc == 0)" "graph export after graph drop _all rc `=_rc'"
    capture graph describe q3801d
    _w38_expect Q3801-2 "(_rc != 0)" "q3801d is still in memory"
    _w38_done Q3801-2 "graph export after dash writes twoway's earlier graph, dropped or not, and the note names it"
    capture graph drop _all

    local s01f : dir "`s01d'" files "*"
    foreach f of local s01f {
        capture erase "`s01d'/`f'"
    }
    capture rmdir "`s01d'"
    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====

* ==== append new blocks above this line ====

// ----------------------------------------------------------------
// Summary (test_wp29_truth.cscript's shape)
// ----------------------------------------------------------------
capture graph drop _all
capture dash clear
capture rmdir "`w38_work'"
local nfail    = ${w38_nfail}
local faillist "${w38_faillist}"
local ncase    = ${w38_ncase}
local only : env WP38_ONLY
macro drop w38_nfail w38_faillist w38_bad w38_ncase
display as text ""
display as text "============================================================"
if `ncase' == 0 {
    if `w38_N' > 1 & `"`macval(only)'"' == "" & "`w38_run'" == "" {
        display as text "test_wp38_truth: part `w38_k'/`w38_N' has no block to run"
        display as text "============================================================"
        exit 0
    }
    // A WP38_ONLY that names no block, or only a stub, ran nothing:
    // that is not a pass.
    display as error "  test_wp38_truth: no case ran (WP38_ONLY=`only')"
    display as text "============================================================"
    exit 9
}
else if `nfail' == 0 {
    display as text "  test_wp38_truth: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_wp38_truth: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
