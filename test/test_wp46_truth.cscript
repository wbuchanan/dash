*! test_wp46_truth.cscript
*! WP-46's ONE certification script (.ultraplan/sections/index.md PD-6):
*! every comparison with twoway's drawing or with Stata's own values that
*! WP-46's sections need lives here, one block per GAPS4 row (or per
*! harness tool), appended above the "append new blocks above this line"
*! marker in section order.  Refusal, message and return-code checks join
*! the EXISTING script for their area (merge rule R1).
*!
*! Made from test/templates/wp_truth_template.cscript (46 -> the WP's
*! number).  S00 is the scaffold smoke (Q4600-1).  A section appends
*! `* ==== S<MM> <lead id>: <what> ====` ... `* ==== end S<MM> ====` (or
*! `S<MM> tool: <what>` for a section with no item), its helper programs
*! directly above its first header, and writes only inside its own
*! blocks.  Case ids are Q46<MM>-<k> (PD-5).
*!
*! Usage: via run_all_cscripts.do.  One block alone: WP46_ONLY=S<MM> in
*! the driver's environment.  Each block prints "S<MM> start" and "S<MM>
*! end" with the date and time.  Its row in run_all_cscripts.do's shard
*! table is `*' when the script is long enough to split
*! (scripts/cert_shards.py's rule), else a shard number, and then the
*! session that runs it runs every block; under a `*' row
*! DASH_CERT_SHARD=k/N runs part k of N of the blocks, and a part with no
*! block ends 0.  A new WP's row: `python3 scripts/cert_shards.py add
*! test_wpNN_truth.cscript'.

cscript "WP-46 truth: twoway comparisons" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off


do "cert_helpers.do"
quietly do "cert_svg.do"
qui run "../dash_parse.mata"
qui run "../dash.ado"
global dash_nobrowser 1

// ----------------------------------------------------------------
// Tally helpers -- test_wp29_truth.cscript's _w29_expect/_w29_done,
// renamed _w46_ for this script.  A case is any number of
// _w46_expect lines closed by one _w46_done.
// ----------------------------------------------------------------
global w46_nfail    = 0
global w46_faillist ""
global w46_bad      = 0
global w46_ncase    = 0

capture program drop _w46_expect
program define _w46_expect
    version 19
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global w46_bad = 1
    }
end

capture program drop _w46_done
program define _w46_done
    version 19
    args id msg
    if ${w46_bad} {
        global w46_nfail    = ${w46_nfail} + 1
        global w46_faillist "${w46_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global w46_bad   = 0
    global w46_ncase = ${w46_ncase} + 1
end

// A fresh directory for this run's files, never one that already exists:
// a fixed name in a shared temp directory could be planted by another
// account (rule 1), so a name Stata has not handed out before is made and
// the run fails if it cannot be.  Every block writes only under it.
tempfile w46_base
local w46_work "`w46_base'_w46"
capture mkdir "`w46_work'"
if _rc {
    display as error "test_wp46_truth: cannot create the work directory `w46_work' (rc `=_rc')"
    exit 9
}

// ---- parts: begin (WP-46 test performance) ----
// Its row in run_all_cscripts.do's shard table is "*" when the script is
// long enough to split (scripts/cert_shards.py's rule), else a shard
// number, and then the session that runs it runs every block
// (_w46_whole reads the row).  Under a "*" row, with
// DASH_CERT_SHARD=k/N set, the session runs part k of N of the blocks.
// The parts are balanced longest first onto the least loaded part (the
// lowest numbered of equals), by the blocks' seconds -- a block not listed
// counts 1 s (section-01 D-01.f) -- the rule scripts/cert_shards.py uses
// for the scripts.  Unset, or with WP46_ONLY set
// (which keeps its precedence), every block runs.  A block runs when its
// gate finds its id in w46_run.
// Seconds: the runner's block seconds line for this script (secs
// test_wp46_truth.cscript S00 1 ..., after the shard table), where
// cert_shards.py write puts each block's start/end lines of a measured
// certification run, rounded up, at least 1; no line: S00 1.
capture mata: mata drop _w46_part()
capture mata: mata drop _w46_whole()
capture mata: mata drop _w46_secs()
mata:
// 1 when the runner's shard table gives the script a shard number for n
// sessions (its row's word n + 2), so that it runs whole; 0 for "*" or
// "*r", no runner, no table or no row (the script then splits).
real scalar _w46_whole(string scalar runner, string scalar script,
                       real scalar n)
{
    string colvector l
    string rowvector t
    real scalar i, inside

    if (n < 2 | !fileexists(runner)) return(0)
    l = cat(runner)
    inside = 0
    for (i = 1; i <= rows(l); i++) {
        if (strpos(l[i], "// ---- shards: begin") == 1) inside = 1
        else if (strpos(l[i], "// ---- shards: end") == 1) inside = 0
        else if (inside) {
            t = tokens(l[i])
            if (cols(t) < n + 2) continue
            if (t[1] != script) continue
            return(ustrregexm(t[n + 2], "^[0-9]+$"))
        }
    }
    return(0)
}
// The blocks' seconds, "S00 1 S01 12 ...", from the runner's
// block seconds line for the script; none (or no runner): "S00 1".
string scalar _w46_secs(string scalar runner, string scalar script)
{
    string colvector l
    string rowvector t
    real scalar i

    if (!fileexists(runner)) return("S00 1")
    l = cat(runner)
    for (i = 1; i <= rows(l); i++) {
        t = tokens(l[i])
        if (cols(t) < 5) continue
        if (t[1] == "//" & t[2] == "secs" & t[3] == script) {
            return(invtokens(t[|4 \ cols(t)|]))
        }
    }
    return("S00 1")
}
end
mata: st_local("w46_secs", _w46_secs("run_all_cscripts.do", "test_wp46_truth.cscript"))
local w46_sh : environment DASH_CERT_SHARD
mata: st_local("w46_ok", strofreal(st_local("w46_sh") == "" | ustrregexm(st_local("w46_sh"), "^[1-8]/[1-8]$")))
if !`w46_ok' {
    display as error "test_wp46_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 8"
    exit 198
}
local w46_k 1
local w46_N 1
if "`w46_sh'" != "" {
    local w46_k = real(substr("`w46_sh'", 1, 1))
    local w46_N = real(substr("`w46_sh'", 3, 1))
}
local w46_only : env WP46_ONLY
if `"`macval(w46_only)'"' != "" | `w46_N' == 1 {
    local w46_k 1
    local w46_N 1
}
if `w46_k' > `w46_N' {
    display as error "test_wp46_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 8"
    exit 198
}
// A shard number in its row: the runner runs the script only in that
// shard's session, so the session runs every block.
local w46_how ""
if `w46_N' > 1 {
    mata: st_local("w46_whole", strofreal(_w46_whole("run_all_cscripts.do", "test_wp46_truth.cscript", `w46_N')))
    if `w46_whole' {
        local w46_how " whole (shard `w46_k'/`w46_N')"
        local w46_k 1
        local w46_N 1
    }
}
capture confirm file "test_wp46_truth.cscript"
if _rc {
    display as error "test_wp46_truth: run it from test/, where it reads its own blocks"
    exit 601
}
mata:
// The ids of the blocks (their header lines, in file order), and those of
// part k of n: longest first onto the least loaded part.
void _w46_part(string scalar file, string scalar table, real scalar k,
               real scalar n)
{
    string colvector lines, ids
    string rowvector tok
    real colvector sec, o, at
    real rowvector load
    real scalar i, j, p, best
    string scalar run

    lines = cat(file)
    ids = J(0, 1, "")
    for (i = 1; i <= rows(lines); i++) {
        if (ustrregexm(lines[i], "^\* ==== (S[0-9]+) ")) {
            if (!anyof(ids, ustrregexs(1))) ids = ids \ ustrregexs(1)
        }
    }
    sec = J(rows(ids), 1, 1)
    tok = tokens(table)
    for (j = 1; j + 1 <= cols(tok); j = j + 2) {
        for (i = 1; i <= rows(ids); i++) {
            if (ids[i] == tok[j]) sec[i] = strtoreal(tok[j + 1])
        }
    }
    o = order((-sec, (1::rows(ids))), (1, 2))
    load = J(1, n, 0)
    at = J(rows(ids), 1, 0)
    for (i = 1; i <= rows(o); i++) {
        best = 1
        for (p = 2; p <= n; p++) if (load[p] < load[best]) best = p
        load[best] = load[best] + sec[o[i]]
        at[o[i]] = best
    }
    run = ""
    for (i = 1; i <= rows(ids); i++) if (at[i] == k) run = run + " " + ids[i]
    st_local("w46_run", strtrim(run))
}
end
// The part this session runs: the runner's shard table may turn the
// parts (cert_helpers.do's cert_split_part, 11nov2026), so that
// each script's longest part lands on a different session.
cert_split_part "test_wp46_truth.cscript" `w46_k' `w46_N'
local w46_p = r(part)
mata: _w46_part("test_wp46_truth.cscript", st_local("w46_secs"), `w46_p', `w46_N')
if "`w46_how'" != "" display as text "test_wp46_truth: runs`w46_how', `: word count `w46_run'' blocks: `w46_run'"
else display as text "test_wp46_truth: session `w46_k'/`w46_N' runs part `w46_p', `: word count `w46_run'' blocks: `w46_run'"
// ---- parts: end ----

* ==== S00 scaffold: the helpers load and a twoway SVG is read ====
local only : env WP46_ONLY
if inlist("`only'", "", "S00") & `: list posof "S00" in w46_run' {
    display as text "S00 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4600-1: cert_svg_export and cert_svg_texts on one twoway scatter,
    // and dash's own programs are loaded from this tree.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(w46s01, replace)
    cert_svg_export, name(w46s01) file("`w46_work'/w46s01.svg")
    local s01_rc   = r(rc)
    local s01_file "`r(file)'"
    _w46_expect Q4600-1 "(`s01_rc' == 0)" "cert_svg_export rc `s01_rc'"
    capture confirm file "`s01_file'"
    _w46_expect Q4600-1 "(_rc == 0)" "r(file) `s01_file' does not exist"
    cert_svg_texts, file("`s01_file'")
    local s01_n    = r(n)
    local s01_list "`r(list)'"
    _w46_expect Q4600-1 "(`s01_n' > 0)" "cert_svg_texts found no text elements"
    capture program list _dash_serve
    _w46_expect Q4600-1 "(_rc == 0)" "dash.ado's _dash_serve is not loaded"
    _w46_done Q4600-1 "a twoway SVG was written and read (`s01_n' texts); dash is loaded"

    capture erase "`s01_file'"
    capture erase "`s01_list'"
    capture graph drop w46s01
    display as text "S00 end " c(current_date) " " c(current_time)
}
* ==== end S00 ====

// ----------------------------------------------------------------
// S01 helpers (WP-46 46-01): one recast layer drawn by twoway and by
// dash in both modes, read as the draw rows of
// scripts/extract_horizontal_truth.do read twoway's SVG.
// ----------------------------------------------------------------
capture program drop _q4601_data
program define _q4601_data
    // _q4601_data hz|rc: the data of extract_horizontal_truth.do (hz) or
    // of extract_recast_truth.do (rc).
    version 19
    args which
    clear
    if "`which'" == "hz" {
        quietly set obs 5
        generate double x = _n
        generate double y = .
        local ys 10 30 20 50 40
        forvalues i = 1/5 {
            quietly replace y = `: word `i' of `ys'' in `i'
        }
        generate double lo = y - 5
        generate double hi = y + 5
        label variable x "Xvar"
        label variable y "Yvar"
        label variable lo "Lovar"
        label variable hi "Hivar"
    }
    else {
        quietly set obs 8
        generate double x = _n
        generate double y = .
        local ys 3 5 2 6 4 7 1 8
        forvalues i = 1/8 {
            quietly replace y = `: word `i' of `ys'' in `i'
        }
        generate double y2 = y + 3
    }
end

python:
import os as _q4601_os, sys as _q4601_sys
for _q4601_p in (_q4601_os.path.abspath(".."),
                 _q4601_os.path.abspath(_q4601_os.path.join("..", "scripts"))):
    if _q4601_p not in _q4601_sys.path:
        _q4601_sys.path.insert(0, _q4601_p)


def _q4601_docs(sp, dp, app):
    """Both modes' figures of one spec: (saved, served)."""
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_q4601_app")
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_q4601_app.py",
                     "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    sv = [m for m in doc.models if type(m).__name__ == "figure"]
    return list(r.figures.values()), sv


def _q4601_tw(svg):
    """twoway's x and y labels (numbers) and its titles: b1 (flat, below
    the plot region) and l1 (rotated, left of it)."""
    import svg_truth
    doc = svg_truth.svg_document(svg)
    pr = doc["plotregion"]
    out = {"b1": "", "l1": ""}
    labs = set()
    for ax in ("x", "y"):
        rd = svg_truth.svg_axis_reading(svg, ax, doc=doc)
        vals = [str(v) for v in (rd.get("labels") or [])]
        labs |= set(vals)
        out[ax] = sorted(float(v) for v in vals)
    mid = (pr["left"] + pr["right"]) / 2.0
    for t in doc["texts"]:
        s = t.get("text", "")
        if not s or s in labs:
            continue
        if t.get("rotate") is not None and t.get("x", 0) < mid:
            out["l1"] = out["l1"] or s
        elif t.get("rotate") is None and t.get("y", 0) > pr["bottom"]:
            out["b1"] = out["b1"] or s
    return out


def _q4601_verdict(case, tw, fig):
    """'ok', or what differs, for one mode's figure."""
    xt = fig.xaxis[0].axis_label or ""
    yt = fig.yaxis[0].axis_label or ""
    xr = sorted((fig.x_range.start, fig.x_range.end))
    yr = sorted((fig.y_range.start, fig.y_range.end))
    eps = 1e-9
    if case == "RH1-01":
        # Turned: Xvar on the vertical axis, the first bound (5..45)
        # across the horizontal one, inside twoway's x labels' span.
        if yt != tw["l1"]:
            return "y title %r, twoway's %r" % (yt, tw["l1"])
        if not (xr[0] <= 5 + eps and xr[1] >= 45 - eps):
            return "x range %r does not span the bound 5..45" % (xr,)
        if not (xr[0] < tw["x"][-1] and xr[1] > tw["x"][0]):
            return "x range %r misses twoway's x labels %r" % (xr, tw["x"])
        return "ok"
    if case == "RH9-05":
        for ax, r in (("x", xr), ("y", yr)):
            if not (r[0] <= tw[ax][0] + eps and r[1] >= tw[ax][-1] - eps):
                return "%s range %r, twoway's %s labels %r" % (ax, r, ax,
                                                              tw[ax])
        return "ok"
    if case == "RH11-01":
        if (xt, yt) != (tw["b1"], tw["l1"]):
            return "titles %r, twoway's %r" % ((xt, yt), (tw["b1"], tw["l1"]))
        if not (yr[0] <= tw["y"][0] + eps and yr[1] >= tw["y"][-1] - eps):
            return "y range %r, twoway's y labels %r" % (yr, tw["y"])
        return "ok"
    return "unknown case " + case


def _q4601_check(sp, dp, app, svg, case):
    from sfi import Macro
    tw = _q4601_tw(svg)
    a, b = _q4601_docs(sp, dp, app)
    Macro.setGlobal("q4601_tw", "b1 %r l1 %r x %r y %r" % (
        tw["b1"], tw["l1"], tw["x"], tw["y"]))
    for figs, sfx in ((a, "s"), (b, "v")):
        Macro.setGlobal("q4601_" + sfx, _q4601_verdict(case, tw, figs[0])
                        if len(figs) == 1 else "%d figures" % len(figs))
end

capture program drop _q4601_draw
program define _q4601_draw
    // _q4601_draw <dir> <k> <hz|rc> <case> <command with options...>:
    // twoway draws the command into t<k>.svg, dash builds it, and the
    // case's verdict for each mode lands in $q4601_s and $q4601_v
    // (twoway's rc in $q4601_trc, dash's in $q4601_drc).
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    gettoken data 0 : 0
    gettoken case 0 : 0
    global q4601_s ""
    global q4601_v ""
    global q4601_tw ""
    global q4601_drc = -1
    _q4601_data `data'
    capture graph drop q4601t
    capture noisily twoway `0' name(q4601t, replace)
    global q4601_trc = _rc
    if ${q4601_trc} exit
    capture erase "`dir'/t`k'.svg"
    cert_svg_export, name(q4601t) file("`dir'/t`k'.svg")
    capture graph drop q4601t
    capture dash clear
    capture noisily dash `0' name(zq4601`k')
    global q4601_drc = _rc
    if ${q4601_drc} exit
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _q4601_m; _q4601_m._q4601_check("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py", "`dir'/t`k'.svg", "`case'")
    capture dash clear
end

* ==== S01 RH-1: recast range layers take horizontal ====
local only : env WP46_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w46_run' {
    display as text "S01 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4601-23 (RH1-01): a range layer recast to line under horizontal
    // is taken and turned, as twoway turns it: Xvar on the vertical axis
    // in both modes, the bound across the horizontal one.  The second
    // bound's extent and title are RH-3's (46-02).
    // ------------------------------------------------------------
    _q4601_draw "`w46_work'" 23 hz RH1-01 rarea lo hi x, recast(line) horizontal
    _w46_expect Q4601-23 "(${q4601_trc} == 0)" "twoway rc ${q4601_trc}"
    _w46_expect Q4601-23 "(${q4601_trc} != 0 | ${q4601_drc} == 0)" "dash rc ${q4601_drc}"
    _w46_expect Q4601-23 `"("${q4601_s}" == "ok")"' "saved: ${q4601_s} (twoway: ${q4601_tw})"
    _w46_expect Q4601-23 `"("${q4601_v}" == "ok")"' "served: ${q4601_v} (twoway: ${q4601_tw})"
    _w46_done Q4601-23 "rarea recast(line) horizontal is turned as twoway turns it, in both modes"

    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====

* ==== S01 RH-9: horizontal judged on the typed recast word ====
local only : env WP46_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w46_run' {
    display as text "S01 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4601-24 (RH9-05): scatteri recast to bar under horizontal is
    // taken and turned, as twoway turns it: twoway's x and y labels lie
    // inside dash's x and y ranges in both modes.
    // ------------------------------------------------------------
    _q4601_draw "`w46_work'" 24 hz RH9-05 scatteri 1 1 2 2 3 1, recast(bar) horizontal
    _w46_expect Q4601-24 "(${q4601_trc} == 0)" "twoway rc ${q4601_trc}"
    _w46_expect Q4601-24 "(${q4601_trc} != 0 | ${q4601_drc} == 0)" "dash rc ${q4601_drc}"
    _w46_expect Q4601-24 `"("${q4601_s}" == "ok")"' "saved: ${q4601_s} (twoway: ${q4601_tw})"
    _w46_expect Q4601-24 `"("${q4601_v}" == "ok")"' "served: ${q4601_v} (twoway: ${q4601_tw})"
    _w46_done Q4601-24 "scatteri recast(bar) horizontal is turned as twoway turns it, in both modes"

    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====

* ==== S01 RH-11: yx names on a y2xtype source read in full ====
local only : env WP46_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w46_run' {
    display as text "S01 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4601-25 (RH11-01): rline recast(sc) is twoway's rspike, after its
    // two notes: dash's x and y titles are twoway's and twoway's y labels
    // lie inside dash's y range (the spikes span both bounds), in both
    // modes.
    // ------------------------------------------------------------
    _q4601_draw "`w46_work'" 25 rc RH11-01 rline y y2 x, recast(sc)
    _w46_expect Q4601-25 "(${q4601_trc} == 0)" "twoway rc ${q4601_trc}"
    _w46_expect Q4601-25 "(${q4601_trc} != 0 | ${q4601_drc} == 0)" "dash rc ${q4601_drc}"
    _w46_expect Q4601-25 `"("${q4601_s}" == "ok")"' "saved: ${q4601_s} (twoway: ${q4601_tw})"
    _w46_expect Q4601-25 `"("${q4601_v}" == "ok")"' "served: ${q4601_v} (twoway: ${q4601_tw})"
    _w46_done Q4601-25 "rline recast(sc) is drawn as twoway's rspike, in both modes"

    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====

// ----------------------------------------------------------------
// S02 helpers (WP-46 46-02): one recast layer drawn by twoway and by
// dash in both modes, on the data in memory, judged by _q4602_check
// with S01's readers (_q4601_docs, _q4601_tw).
// ----------------------------------------------------------------
python:
def _q4602_verdict(case, tw, fig):
    """'ok', or what differs, for one mode's figure."""
    xt = fig.xaxis[0].axis_label or ""
    yt = fig.yaxis[0].axis_label or ""
    yr = sorted((fig.y_range.start, fig.y_range.end))
    eps = 1e-9
    if case == "RB-01":
        # Both bounds on the axis (y2 reaches 11) and in the title.
        if (xt, yt) != (tw["b1"], tw["l1"]):
            return "titles %r, twoway's %r" % ((xt, yt), (tw["b1"], tw["l1"]))
        if not (yr[0] <= tw["y"][0] + eps and yr[1] >= tw["y"][-1] - eps):
            return "y range %r, twoway's y labels %r" % (yr, tw["y"])
        if yr[1] < 11 - eps:
            return "y range %r leaves out the second bound's 11" % (yr,)
        return "ok"
    if case == "RH5-04":
        # 0 on the height axis, as twoway's labels start at 0.
        if not (tw["y"] and tw["y"][0] == 0.0):
            return "twoway's y labels %r do not start at 0" % (tw["y"],)
        if yr[0] > eps:
            return "y range %r leaves out 0" % (yr,)
        return "ok"
    if case == "RH8-01":
        # The documented transpose: horizontal bars.
        kinds = {type(r.glyph).__name__ for r in fig.renderers
                 if getattr(r, "glyph", None) is not None}
        return "ok" if "HBar" in kinds else "no HBar: %r" % sorted(kinds)
    return "unknown case " + case


def _q4602_check(sp, dp, app, svg, case):
    from sfi import Macro
    tw = _q4601_tw(svg)
    a, b = _q4601_docs(sp, dp, app)
    Macro.setGlobal("q4602_tw", "b1 %r l1 %r x %r y %r" % (
        tw["b1"], tw["l1"], tw["x"], tw["y"]))
    for figs, sfx in ((a, "s"), (b, "v")):
        Macro.setGlobal("q4602_" + sfx, _q4602_verdict(case, tw, figs[0])
                        if len(figs) == 1 else "%d figures" % len(figs))
end

capture program drop _q4602_draw
program define _q4602_draw
    // _q4602_draw <dir> <k> <case> <command with options...>: twoway
    // draws the command on the data in memory into t<k>.svg, dash builds
    // it, and the case's verdict for each mode lands in $q4602_s and
    // $q4602_v (twoway's rc in $q4602_trc, dash's in $q4602_drc).
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    gettoken case 0 : 0
    global q4602_s ""
    global q4602_v ""
    global q4602_tw ""
    global q4602_drc = -1
    capture graph drop q4602t
    capture noisily twoway `0' name(q4602t, replace)
    global q4602_trc = _rc
    if ${q4602_trc} exit
    capture erase "`dir'/t`k'.svg"
    cert_svg_export, name(q4602t) file("`dir'/t`k'.svg")
    capture graph drop q4602t
    capture dash clear
    capture noisily dash `0' name(zq4602`k')
    global q4602_drc = _rc
    if ${q4602_drc} exit
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _q4602_m; _q4602_m._q4602_check("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py", "`dir'/t`k'.svg", "`case'")
    capture dash clear
end

* ==== S02 RH-3: a recast range layer keeps its second bound ====
local only : env WP46_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w46_run' {
    display as text "S02 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4602-1 (RB-01): rline y y2 x, recast(line) draws the line through
    // y, but twoway's y axis spans both bounds (0..11) and is titled
    // y/y2; dash's y range covers twoway's y labels and the second
    // bound, and its titles are twoway's, in both modes.
    // ------------------------------------------------------------
    _q4601_data rc
    _q4602_draw "`w46_work'" 1 RB-01 rline y y2 x, recast(line)
    _w46_expect Q4602-1 "(${q4602_trc} == 0)" "twoway rc ${q4602_trc}"
    _w46_expect Q4602-1 "(${q4602_trc} != 0 | ${q4602_drc} == 0)" "dash rc ${q4602_drc}"
    _w46_expect Q4602-1 `"("${q4602_s}" == "ok")"' "saved: ${q4602_s} (twoway: ${q4602_tw})"
    _w46_expect Q4602-1 `"("${q4602_v}" == "ok")"' "served: ${q4602_v} (twoway: ${q4602_tw})"
    _w46_done Q4602-1 "rline recast(line) keeps both bounds on the axis and in its title, in both modes"

    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

* ==== S02 RH-5: a recast histogram from zero, in its own style ====
local only : env WP46_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w46_run' {
    display as text "S02 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4602-2 (as RH5-04): histogram y, recast(scatter) on ten values
    // whose bins are all well above 0 (test_mode_parity._DF's mpg):
    // twoway's height axis starts at 0; dash's y range starts at or
    // below 0, in both modes.  (An area or dropline target holds 0 by
    // its base already.)
    // ------------------------------------------------------------
    clear
    quietly set obs 10
    generate double y = .
    local ys 22 17 25 30 21 19 14 28 16 23
    forvalues i = 1/10 {
        quietly replace y = `: word `i' of `ys'' in `i'
    }
    _q4602_draw "`w46_work'" 2 RH5-04 histogram y, recast(scatter)
    _w46_expect Q4602-2 "(${q4602_trc} == 0)" "twoway rc ${q4602_trc}"
    _w46_expect Q4602-2 "(${q4602_trc} != 0 | ${q4602_drc} == 0)" "dash rc ${q4602_drc}"
    _w46_expect Q4602-2 `"("${q4602_s}" == "ok")"' "saved: ${q4602_s} (twoway: ${q4602_tw})"
    _w46_expect Q4602-2 `"("${q4602_v}" == "ok")"' "served: ${q4602_v} (twoway: ${q4602_tw})"
    _w46_done Q4602-2 "histogram recast(scatter) keeps 0 on its height axis, in both modes"

    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

* ==== S02 RH-8: recast() with horizontal drawn as the transpose ====
local only : env WP46_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w46_run' {
    display as text "S02 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4602-3 (RH8-01): histogram mpg, recast(bar) horizontal: twoway
    // draws a broken picture (documented, Q25); dash takes it, rc 0, and
    // draws horizontal bars, the transpose, in both modes.
    // ------------------------------------------------------------
    sysuse auto, clear
    _q4602_draw "`w46_work'" 3 RH8-01 histogram mpg, recast(bar) horizontal
    _w46_expect Q4602-3 "(${q4602_trc} == 0)" "twoway rc ${q4602_trc}"
    _w46_expect Q4602-3 "(${q4602_drc} == 0)" "dash rc ${q4602_drc}"
    _w46_expect Q4602-3 `"("${q4602_s}" == "ok")"' "saved: ${q4602_s}"
    _w46_expect Q4602-3 `"("${q4602_v}" == "ok")"' "served: ${q4602_v}"
    _w46_done Q4602-3 "histogram recast(bar) horizontal is drawn as horizontal bars, in both modes"

    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

* ==== append new blocks above this line ====

// ----------------------------------------------------------------
// Summary (test_wp29_truth.cscript's shape)
// ----------------------------------------------------------------
capture graph drop _all
capture dash clear
capture rmdir "`w46_work'"
local nfail    = ${w46_nfail}
local faillist "${w46_faillist}"
local ncase    = ${w46_ncase}
local only : env WP46_ONLY
macro drop w46_nfail w46_faillist w46_bad w46_ncase
display as text ""
display as text "============================================================"
if `ncase' == 0 {
    if `w46_N' > 1 & `"`macval(only)'"' == "" & "`w46_run'" == "" {
        display as text "test_wp46_truth: part `w46_k'/`w46_N' has no block to run"
        display as text "============================================================"
        exit 0
    }
    // A WP46_ONLY that names no block, or only a stub, ran nothing:
    // that is not a pass.
    display as error "  test_wp46_truth: no case ran (WP46_ONLY=`only')"
    display as text "============================================================"
    exit 9
}
else if `nfail' == 0 {
    display as text "  test_wp46_truth: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_wp46_truth: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
