*! test_serve_launch.cscript  v1.0
*! Certification script for `dash serve' as a COMMAND.
*!
*! `dash serve, port(5006)' -- the example dash.sthlp gives -- returned
*! r(198) "invalid 'port'".  So did timeout() and nobrowser, and so did every
*! build option the help says serve inherits.  Only the bare form ran.
*!
*! _dash_serve forwarded `0' to _dash_serve_spec verbatim, and `0' still
*! carries its leading comma, so the call became
*!     _dash_serve_spec, specpath(...) datapath(...) , port(5006)
*! -- two commas on one line, and everything after the second was read as a
*! positional argument.  _dash_build fixes exactly this at its own forwarding
*! site with `: subinstr local' and has done for some time; the serve path
*! never got the same treatment.
*!
*! Nothing caught it because test_serve_options.cscript calls
*! _dash_serve_spec DIRECTLY, bypassing the one line the defect lives on --
*! its own header says it covers "everything `dash serve' does except the
*! launch".  Its five PASS banners are labelled "dash serve ..." and none of
*! them runs `dash serve'.  Every other serve case in the suite is a
*! `capture' asserting _rc == 198 on an error path.
*!
*! WHY THIS SCRIPT DOES NOT START A SERVER.  `dash serve' blocks Stata until
*! the server stops, and timeout() is measured in MINUTES, so the shortest
*! real launch this suite could assert would hold it for sixty seconds.  The
*! cases below instead drive `dash serve' with an EMPTY registry: option
*! parsing happens first, so a correctly-parsed command reaches the registry
*! check and stops there.  That distinguishes the two outcomes precisely --
*! "no graphs registered" means the options parsed, "invalid 'port'" means
*! they did not -- and costs nothing.  A real launch was verified by hand
*! against this fix; see the BUGS.md entry.
*!
*! Tests: SRV-01 through SRV-20 (SRV-17 to SRV-20, added by ROADMAP WP-24,
*! drive `dash serve' with a graph registered, against a stub renderer that
*! starts no server; SRV-19 checks the app file it is handed is app.py in
*! a private run folder of this session, c(tmpdir)dash-<uid>/run-<pid>-*,
*! with spec.json and data.json beside it and the folder gone after
*! (BUG-47; WP-29 P0.12b); SRV-20, added in WP-24's second round, is the
*! serve-side twin of test_render_locate.cscript LOC-17 -- the renderer
*! path dash serve runs is handed to Python as data, BUG-SEC-1.  SRV-20
*! runs before SRV-19, which does not restore the real locator.)  SPU-01
*! to SPU-03 (WP-28 F1), also before SRV-19, drive a real launch against
*! a held port and the box _dash_serve reads from the launch report.
*! PF-07 (WP-29 P0.12b), after SPU-02: the r(198) branch leaves no run
*! folder of this session.
*! LC-02..LC-04 (WP-29 P0.13 F4), after SPU-03 and before SRV-19: an
*! interruption the launcher reports ends dash serve with r(1) and no
*! traceback (LC-02); a real launch stopped by a patched pollstd ends r(1)
*! with its port freed (LC-03, dash's catch, not Stata's Break key); the
*! announcement names Break (LC-04).
*! TOK-01..TOK-04 (WP-29 P0.12a), after LC-04 and before SRV-19: the
*! served dashboard needs its per-launch key; dash build, server says so
*! (TOK-01); a real dash serve refuses without the key and serves 74 rows
*! with it, the link in a 0600 file of a 0700 folder (TOK-02); no log
*! holds the key (TOK-03); the help names it (TOK-04).
*! GE-20 (WP-30 P1.28a), after TOK-04 and before SRV-19: dash serve stores
*! nothing in r().
*! NC-07..NC-08 (WP-30 P1.26b), after TOK-04 and before SRV-19: dash
*! build, server prints the notes dash build prints (NC-07); a real dash
*! serve relays the app's notes once each and no key (NC-08).
*!
*! Usage:  do test/test_serve_launch.cscript
*! Version: 1.2  24sep2026

cscript "dash serve accepts its own options" adodir ".."
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}

// ----------------------------------------------------------------
// Setup
// ----------------------------------------------------------------

qui sysuse auto, clear
run "../dash_parse.mata"
run "../dash.ado"
do "cert_helpers.do"

// Run `dash serve' with whatever options are given, on an EMPTY registry,
// and hand back the return code and the message.  Options are parsed before
// the registry is looked at, so this separates "the options parsed" from
// "the options did not".
capture program drop _srv_try
program define _srv_try, rclass
    args opts
    dash clear
    tempname lf
    tempfile lg
    quietly log using "`lg'", replace text name(`lf')
    capture noisily dash serve, `opts'
    local rc = _rc
    quietly log close `lf'
    // Searched with cert_log_has (case-insensitively, as the line-by-line
    // Mata reader this replaced did, 24sep2026): the log is read as a value
    // in Mata, so nothing a message contains can end a Stata string or be
    // parsed as code, and a line Stata wrapped at the column is searched
    // re-joined.  Each result is read into a local at once: every call
    // replaces r().
    cert_log_has "`lg'", needle("invalid") lower
    local invalid = r(found)
    cert_log_has "`lg'", needle("no graphs registered") lower
    local noregist = r(found)
    cert_log_has "`lg'", needle("only apply to") lower
    local buildonly = r(found)
    // The port check's own refusal: "dash serve: port() must be between
    // 1024 and 65535 (got: 80)", "... must be a positive integer (got:
    // abc)" (measured 24sep2026).
    cert_log_has "`lg'", needle("port() must be") lower
    local portmsg = r(found)
    return scalar rc        = `rc'
    return scalar invalid   = `invalid'
    return scalar noregist  = `noregist'
    return scalar buildonly = `buildonly'
    return scalar portmsg   = `portmsg'
end


// ================================================================
// SRV-01..04 — each documented option must PARSE
// ================================================================
// "invalid 'port'" means the option never reached the parser.  Reaching the
// registry check means it did.

_srv_try "port(5099)"
assert r(invalid) == 0
assert r(noregist) == 1
display "SRV-01 PASS: port() parses"

_srv_try "timeout(1)"
assert r(invalid) == 0
assert r(noregist) == 1
display "SRV-02 PASS: timeout() parses"

_srv_try "nobrowser"
assert r(invalid) == 0
assert r(noregist) == 1
display "SRV-03 PASS: nobrowser parses"

_srv_try "port(5099) timeout(1) nobrowser"
assert r(invalid) == 0
assert r(noregist) == 1
display "SRV-04 PASS: all three together parse"

// ================================================================
// SRV-05..08 — the build options the help says serve inherits
// ================================================================
// dash.sthlp: "dash serve also accepts every option dash build accepts --
// title(), subtitle(), layout(), link(), filter(), theme(), scheme(),
// tabs() and filterposition()".

_srv_try `"title("A Title")"'
assert r(invalid) == 0
assert r(noregist) == 1
display "SRV-05 PASS: title() parses on dash serve"

_srv_try "layout(1 1)"
assert r(invalid) == 0
assert r(noregist) == 1
display "SRV-06 PASS: layout() parses on dash serve"

_srv_try "scheme(s2color)"
assert r(invalid) == 0
assert r(noregist) == 1
display "SRV-07 PASS: scheme() parses on dash serve"

_srv_try `"port(5099) title("T") layout(1 1) nobrowser"'
assert r(invalid) == 0
assert r(noregist) == 1
display "SRV-08 PASS: serve options and build options mix"

// ================================================================
// SRV-09..11 — validation must still reject bad values
// ================================================================
// The fix must not turn a rejected value into an accepted one.
//
// ... and each must be refused BY THE PORT CHECK.  rc 198 alone could not
// say so: the empty-registry refusal is r(198) too, and every _srv_try runs
// on an empty registry, so these three passed with port() validation
// deleted (found 24sep2026).  The refusal names port(), and comes before
// the registry is looked at -- the "no graphs registered" that SRV-01..08
// and SRV-12 find present is absent.

_srv_try "port(80)"
assert r(rc) == 198
assert r(portmsg) == 1
assert r(noregist) == 0
display "SRV-09 PASS: port() below 1024 is still rejected"

_srv_try "port(70000)"
assert r(rc) == 198
assert r(portmsg) == 1
assert r(noregist) == 0
display "SRV-10 PASS: port() above 65535 is still rejected"

_srv_try "port(abc)"
assert r(rc) == 198
assert r(portmsg) == 1
assert r(noregist) == 0
display "SRV-11 PASS: a non-numeric port() is still rejected"

// ================================================================
// SRV-12 — the bare form still works
// ================================================================
_srv_try ""
assert r(invalid) == 0
assert r(noregist) == 1
display "SRV-12 PASS: bare dash serve still reaches the registry check"

// ================================================================
// SRV-13..15 — build-only options are NAMED, not silently dropped
// ================================================================
// saving(), replace and server describe writing a file.  dash.sthlp does not
// list them for dash serve, and _dash_prepare_spec declares all three and
// reads none, so before this they were accepted and vanished.

_srv_try `"saving(out.html)"'
assert r(invalid) == 0
assert r(buildonly) == 1
display "SRV-13 PASS: saving() on dash serve is reported, not dropped"

_srv_try "replace"
assert r(invalid) == 0
assert r(buildonly) == 1
display "SRV-14 PASS: replace on dash serve is reported, not dropped"

_srv_try "server"
assert r(invalid) == 0
assert r(buildonly) == 1
display "SRV-15 PASS: server on dash serve is reported, not dropped"

// ... and a command with none of them must NOT print the note.
_srv_try "port(5099)"
assert r(buildonly) == 0
display "SRV-15b PASS: the note is silent when no build-only option is given"

// ================================================================
// SRV-16 — the option surface of dash serve and _dash_serve_spec agree
// ================================================================
// test_serve_options.cscript drives _dash_serve_spec directly, which is why
// it never saw the forwarding defect.  This asserts the two entry points
// accept the same things, so a future divergence shows up here.
dash clear
qui sysuse auto, clear
dash scatter mpg weight, name(sv1)
tempfile sp dp
capture noisily _dash_serve_spec, specpath("`sp'") datapath("`dp'") ///
    port(5099) timeout(1) nobrowser title("T")
assert _rc == 0
assert "`r(port)'" == "5099"
assert "`r(timeout)'" == "1"
assert "`r(nobrowser)'" == "nobrowser"
display "SRV-16 PASS: _dash_serve_spec still parses the same options directly"

// ================================================================
// SRV-17..18 -- ROADMAP WP-03's AC-03.3 and AC-03.2 through dash serve
// ================================================================
// Added by WP-24, whose mutation check of WP-03 found both criteria held
// only below the command: test_serve_options.cscript [3/5] calls
// _dash_serve_spec directly (with port() and timeout(), never bare), and
// SRV-09 to SRV-11 above run against an EMPTY registry, which exits 198
// on its own -- measured, with the port() range check deleted from
// _dash_serve_spec, SRV-09 still passed.
//
// A stub dash_render.py placed first on the ado-path (the method of
// test_help_claims_4.cscript HC4-16 and test_serve_browser.cscript) stands
// in for the renderer.  `dash serve' runs whole -- options, inheritance,
// spec, browser decision, the handoff -- and the stub copies the spec and
// the data it is handed and exits, so no server starts, and none could
// start if a check below broke.  The served document is then built from
// exactly what dash serve handed over, by the real renderer.
global dash_nobrowser 1
tempfile srvbase
local srvstub "`srvbase'_srv_stub"
capture mkdir "`srvstub'"
tempname sfh
file open `sfh' using "`srvstub'/dash_render.py", write text replace
file write `sfh' `"import os, shutil, sys"' _n
file write `sfh' `"_a = sys.argv[1:]"' _n
file write `sfh' `"_d = os.path.dirname(os.path.abspath(__file__))"' _n
file write `sfh' `"shutil.copyfile(_a[_a.index("--spec") + 1], os.path.join(_d, "spec.json"))"' _n
file write `sfh' `"shutil.copyfile(_a[_a.index("--data") + 1], os.path.join(_d, "data.json"))"' _n
file write `sfh' `"open(_a[_a.index("--output") + 1], "w", encoding="utf-8").write("# app")"' _n
file close `sfh'
global SRV_STUB "`srvstub'"

// SRV-17 -- AC-03.3: `dash build, filter(...)' and then a bare `dash serve'
// serves a dashboard carrying that filter.
dash clear
qui sysuse auto, clear
dash scatter mpg weight, name(sv17)
tempfile b17
capture noisily dash build, saving("`b17'.html") replace nobrowser ///
    filter(foreign, type(dropdown))
assert _rc == 0
capture erase "`srvstub'/spec.json"
capture erase "`srvstub'/data.json"
adopath ++ "`srvstub'"
capture noisily {
    _dash_find_render
    assert strpos(`"`r(fn)'"', "_srv_stub") > 0
    capture noisily dash serve
    assert _rc == 0
}
local rc17 = _rc
adopath - "`srvstub'"
assert `rc17' == 0
confirm file "`srvstub'/spec.json"
cert_file_has "`srvstub'/spec.json", needle(`""filter":"foreign, type(dropdown)""') lower
local s17f = r(found)
assert `s17f' == 1
global SRV17_NSEL ""
global SRV17_FOREIGN ""
python:
import importlib.util as _s17_il
import os as _s17_os
import sys as _s17_sys
import warnings as _s17_w
from sfi import Macro as _s17_M
from bokeh.document import Document as _s17_Doc
from bokeh.models import Select as _s17_Select

# The real renderer of this tree, registered while it is used:
# ServerAppBuilder copies helpers into the app from its own source, which
# it finds through sys.modules (test_json_escaping.cscript does the same).
_s17_spec = _s17_il.spec_from_file_location("_srv17_dash_render", _s17_os.path.abspath("../dash_render.py"))
_s17_dr = _s17_il.module_from_spec(_s17_spec)
_s17_sys.modules["_srv17_dash_render"] = _s17_dr
_s17_spec.loader.exec_module(_s17_dr)
_s17_dir = _s17_M.getGlobal("SRV_STUB")
_s17_app = _s17_os.path.join(_s17_dir, "app.py")
with _s17_w.catch_warnings():
    _s17_w.simplefilter("ignore")
    _s17_dr.ServerAppBuilder(_s17_os.path.join(_s17_dir, "spec.json"), _s17_os.path.join(_s17_dir, "data.json")).build(_s17_app)
with open(_s17_app, encoding="utf-8") as _s17_fh:
    _s17_src = _s17_fh.read()
_s17_attach = "if __name__ != '__main__':" + chr(10) + "    make_document(curdoc())"
assert _s17_attach in _s17_src, "the generated app's curdoc attach moved"
_s17_ns = {"__name__": "_srv17_app"}
with _s17_w.catch_warnings():
    _s17_w.simplefilter("ignore")
    exec(compile(_s17_src.replace(_s17_attach, "pass"), "_srv17_app.py", "exec"), _s17_ns)
    _s17_doc = _s17_Doc()
    _s17_ns["make_document"](_s17_doc)
_s17_sel = list(_s17_doc.select({"type": _s17_Select}))
_s17_opts = [str(o[1]) if isinstance(o, (list, tuple)) else str(o) for s in _s17_sel for o in s.options]
_s17_M.setGlobal("SRV17_NSEL", str(len(_s17_sel)))
_s17_M.setGlobal("SRV17_FOREIGN", "1" if ("Foreign" in _s17_opts and "Domestic" in _s17_opts) else "0")
_s17_gone = _s17_sys.modules.pop("_srv17_dash_render", None)
end
display as text "     served document: ${SRV17_NSEL} Select widget(s); Foreign and Domestic among its options: ${SRV17_FOREIGN}"
assert "${SRV17_NSEL}" == "1"
assert "${SRV17_FOREIGN}" == "1"
display "SRV-17 PASS: AC-03.3 -- a bare dash serve after dash build, filter() serves the build's dropdown"

// SRV-18 -- AC-03.2: `dash serve, port(80)' exits 198 with the range
// message, with a graph registered, so the registry check cannot answer
// for the port() check; the stub is first on the path, so a broken check
// could not start a server.
dash clear
dash scatter mpg weight, name(sv18)
capture erase "`srvstub'/spec.json"
adopath ++ "`srvstub'"
local s18bad ""
local s18ls = c(linesize)
set linesize 255
foreach p in 80 65536 {
    tempname lf18
    tempfile lg18
    quietly log using "`lg18'", replace text name(`lf18')
    capture noisily dash serve, port(`p') nobrowser
    local rc18 = _rc
    quietly log close `lf18'
    cert_log_has "`lg18'", needle("port() must be between 1024 and 65535 (got: `p')") lower
    local s18m = r(found)
    capture confirm file "`srvstub'/spec.json"
    local s18ran = (_rc == 0)
    if `rc18' != 198 | `s18m' != 1 | `s18ran' != 0 {
        local s18bad "`s18bad' [port(`p'): rc `rc18', range message `s18m', renderer ran `s18ran']"
    }
}
set linesize `s18ls'
adopath - "`srvstub'"
if "`s18bad'" != "" {
    display as error "SRV-18 FAIL:`s18bad'"
    exit 9
}
display "SRV-18 PASS: AC-03.2 -- dash serve, port(80) and port(65536) exit 198 with the range message, a graph registered"

capture erase "`srvstub'/spec.json"
capture erase "`srvstub'/data.json"
capture erase "`srvstub'/app.py"
capture erase "`srvstub'/dash_render.py"
capture rmdir "`srvstub'"
macro drop SRV_STUB SRV17_*
dash clear

// ================================================================
// SRV-20 -- the renderer path dash serve runs is handed to Python as data
// ================================================================
// The serve-side twin of test_render_locate.cscript LOC-17.  BUGS.md
// BUG-SEC-1: _dash_do_render and _dash_serve wrote the renderer path and
// the output path into python: lines; a double quote in either ended the
// literal and the rest ran as Python.  LOC-17 runs the immediate route's
// _dash_do_render with payload paths; nothing ran dash serve, whose own
// interpolation (dash.ado ~5481, `runpy.run_path("`_py_render'", ...)';
// since WP-30's test performance work, B1, the same escaped literal is
// the first argument of _dash_xm._dash_run_renderer, which runs the file
// as run_path did) is a SECOND copy of the same idiom.  This drives
// `dash serve' whole against
// a renderer whose DIRECTORY name is a Python payload -- whose double quote
// would end the literal the path is interpolated into -- located through
// the real _dash_find_render (findfile off S_ADO, as LOC-10/11 do), so the
// located path is the locator's own answer, escaped by _dash_json_str and
// handed to runpy.run_path.  Measured 24sep2026: with `_py_render'
// replaced by `render_py' (the pre-fix raw form), the quote in the path
// ends run_path's string argument, the rest is read as code, and the
// payload's touch runs -- dash serve creates the sentinel and returns
// r(7102) (run_path then fails on the non-path second argument).  SRV-20
// requires serve rc 0 AND the sentinel absent, as LOC-17 requires its
// render rc 0 and its sentinel absent.  With the escaping the quote is
// written \" inside the literal, run_path is given the whole path as one
// string, opens the stub there and runs it -- which records its arguments
// and starts no server -- rc 0, nothing touched.  So `dash serve' runs
// whole (options, spec, browser decision, the handoff) and no server can
// start; the stub's record proves the payload PATH reached Python as the
// string runpy executed, not as code.  The spec, data and app paths dash
// serve also interpolates are session tempfiles, escaped by the same
// _dash_json_str; the renderer path is the one the locator's answer
// controls, as in LOC-17.
//
// This runs BEFORE SRV-19, which replaces _dash_find_render with a
// stand-in and does not restore it.
global dash_nobrowser 1
tempfile s20base
// The payload, appended to the directory name: x, a double quote to end
// run_path's string argument, then `,__import__("os").system("touch
// s20_sent") or"y' -- so raw, the path splits into two arguments to
// run_path, the second `system(...) or "y<...>/dash_render.py"', and the
// system() runs the touch before run_path fails on a non-dict second
// argument.  Measured 24sep2026 (probe): raw, the sentinel is created and
// the call is r(7102); escaped, run_path is given the whole path as one
// string, opens the stub there and runs it, rc 0, nothing touched.  Built
// with char() so this file holds no unescaped quote of its own, and with
// no "/" so it is one directory name.
mata: st_local("_s20p", "x" + char(34) + ",__import__(" + char(34) + "os" + char(34) + ").system(" + char(34) + "touch s20_sent" + char(34) + ") or" + char(34) + "y")
local s20dir `"`s20base'`_s20p'"'
global SRV20_DIR "`s20dir'"
// The stub writes its record beside itself, so its path need carry no
// quote of its own; read back from the same directory (a value in Mata,
// so its quotes cannot break anything).
global SRV20_REC `"`s20dir'/argv.jsonl"'
capture erase "$SRV20_REC"
mata: mkdir(st_local("s20dir"))
mata: st_local("_s20made", strofreal(direxists(st_local("s20dir"))))
assert `_s20made' == 1
tempname s20fh
file open `s20fh' using `"`s20dir'/dash_render.py"', write text replace
file write `s20fh' "import json, os, sys" _n
file write `s20fh' `"_p = os.path.join(os.path.dirname(os.path.abspath(__file__)), "argv.jsonl")"' _n
file write `s20fh' `"with open(_p, "a", encoding="utf-8") as _fh:"' _n
file write `s20fh' "    _fh.write(json.dumps([__file__] + sys.argv) + chr(10))" _n
file close `s20fh'
dash clear
qui sysuse auto, clear
dash scatter mpg weight, name(sv20)
mata: st_local("_s20sado", st_global("S_ADO"))
// The payload directory first on the ado-path, in the compound-quoted form
// $S_ADO writes a directory in (LOC-11).
local here20 "`c(pwd)'"
quietly cd "`c(tmpdir)'"
capture erase "s20_sent"
mata: st_global("S_ADO", char(96) + char(34) + st_local("s20dir") + char(34) + char(39) + ";" + st_global("S_ADO"))
capture noisily _dash_find_render
local s20frc = _rc
local s20fn `"`r(fn)'"'
capture noisily dash serve, port(5099) timeout(1) nobrowser
local s20rc = _rc
mata: st_global("S_ADO", st_local("_s20sado"))
capture confirm file "s20_sent"
local s20ran = (_rc == 0)
capture erase "s20_sent"
quietly cd "`here20'"
display as text "  SRV-20 locator rc `s20frc', serve rc `s20rc', payload ran `s20ran'"
assert `s20frc' == 0
assert strpos(`"`s20fn'"', "s20") > 0
assert `s20rc' == 0
assert `s20ran' == 0
global SRV20_OUT ""
global SRV20_NRUN ""
python:
import json as _s20_json
import os as _s20_os
from sfi import Macro as _s20_M
with open(_s20_M.getGlobal("SRV20_REC"), encoding="utf-8") as _s20_fh:
    _s20_runs = [_s20_json.loads(_l) for _l in _s20_fh if _l.strip()]
_s20_M.setGlobal("SRV20_NRUN", str(len(_s20_runs)))
_s20_out = ""
if _s20_runs:
    _a = _s20_runs[0][1:]
    _s20_out = _a[_a.index("--output") + 1] if "--output" in _a else ""
_s20_M.setGlobal("SRV20_OUT", _s20_out)
end
display as text "  SRV-20 stub runs: ${SRV20_NRUN}; app path handed over: [${SRV20_OUT}]"
// The stub ran exactly once -- so the payload path reached Python as the
// string runpy executed, not as code -- and was handed a real .py path
// (a session tempfile), not the payload.
assert "${SRV20_NRUN}" == "1"
assert `"${SRV20_OUT}"' != ""
mata: st_local("_s20outok", strofreal(strpos(st_global("SRV20_OUT"), "s20_sent") == 0))
assert `_s20outok' == 1
capture erase "$SRV20_REC"
capture erase `"`s20dir'/dash_render.py"'
capture erase `"`s20dir'/argv.jsonl"'
capture rmdir `"`s20dir'"'
macro drop SRV20_*
dash clear
display "SRV-20 PASS: dash serve hands the renderer path to Python as data; a quote-and-code path runs nothing"

// ================================================================
// SPU-01..SPU-03 -- dash serve reports a real launch failure (WP-28 F1)
// ================================================================
// GAPS2 F1, measured 25sep2026: a socket held on 127.0.0.1 -- the address
// the app binds, dash_render.py ~27320 -- made `dash serve, port(N)'
// return rc 0 after about 1.7 s: the child's own "Address already in
// use" never left process stderr.  SPU-01 drives a REAL launch against a
// held port (this section's fix, TR-09.2/09.4).  SPU-02 and SPU-03 drive
// the box _dash_serve now reads (TR-09.4) through a stub renderer, so
// they add no wall time.  Run BEFORE SRV-19, which replaces
// _dash_find_render for good: SPU-01 needs the real one.  A socket held
// on 0.0.0.0 would leave 127.0.0.1 free beside it on macOS and pass
// SPU-01 for the wrong reason (F1.5) -- the holder below is on 127.0.0.1
// and listening, the measured case.
// Paths below are built by hand from c(tmpdir) and c(pid), never from
// `tempfile'/`tempname': those draw on the SAME session counter SRV-19
// reads a few cases later (its own `tempfile s19base' must land on a
// slot with no letter suffix), and inserting extra tempfile/tempname
// calls here shifted that counter enough to make SRV-19's own check
// fail below (measured while writing this block) -- a self-contained
// case must not perturb a later one's assumptions about the session's
// naming sequence.
global dash_nobrowser 1
python:
import socket as _spu_sock
from sfi import Macro as _spu_M
_spu_s = _spu_sock.socket(_spu_sock.AF_INET, _spu_sock.SOCK_STREAM)
_spu_s.bind(("127.0.0.1", 0))
_spu_s.listen(1)
_spu_M.setGlobal("spu_port", str(_spu_s.getsockname()[1]))
end
dash clear
qui sysuse auto, clear
dash scatter mpg weight, name(spu01)
local spu01lg "`c(tmpdir)'dash_spu_`c(pid)'_01.log"
capture erase "`spu01lg'"
quietly log using "`spu01lg'", replace text name(_spu01lf)
timer clear 92
timer on 92
capture noisily dash serve, port($spu_port) timeout(1) nobrowser
local spu01rc = _rc
timer off 92
quietly timer list 92
local spu01elapsed = r(t92)
quietly log close _spu01lf
python: _spu_s.close()
cert_log_has "`spu01lg'", needle("no server started on port") lower
local spu01m1 = r(found)
cert_log_has "`spu01lg'", needle("the port is in use") lower
local spu01m2 = r(found)
cert_log_has "`spu01lg'", needle("traceback") lower
local spu01tb = r(found)
cert_log_has "`spu01lg'", needle("server running at") lower
local spu01ran = r(found)
capture erase "`spu01lg'"
display as text "  SPU-01 rc `spu01rc', elapsed `spu01elapsed's, message `spu01m1'/`spu01m2', traceback `spu01tb', ran `spu01ran'"
assert `spu01rc' == 198
assert `spu01m1' == 1
assert `spu01m2' == 1
assert `spu01tb' == 0
assert `spu01ran' == 0
assert `spu01elapsed' < 40
dash clear
macro drop spu_port
display "SPU-01 PASS: dash serve against a held port on 127.0.0.1 returns r(198), names the port, under 40s"

// SPU-02/SPU-03 -- the box _dash_serve reads from the renderer (TR-09.4):
// a stub dash_render.py first on the ado-path (SRV-17's method) writes
// into globals().get("_dash_launch_report") when the dict is present.
local spustub "`c(tmpdir)'dash_spu_stub_`c(pid)'"
capture mkdir "`spustub'"
file open _spufh using "`spustub'/dash_render.py", write text replace
file write _spufh `"_spu_g = globals().get("_dash_launch_report")"' _n
file write _spufh `"if _spu_g is not None:"' _n
file write _spufh `"    _spu_g["error"] = ("no server started on port 5006: the app exited with status 3" + chr(10) + "stub: boom")"' _n
file close _spufh
adopath ++ "`spustub'"
dash clear
dash scatter mpg weight, name(spu02)
local spu02lg "`c(tmpdir)'dash_spu_`c(pid)'_02.log"
capture erase "`spu02lg'"
quietly log using "`spu02lg'", replace text name(_spu02lf)
capture noisily dash serve, port(5006) timeout(1) nobrowser
local spu02rc = _rc
quietly log close _spu02lf
cert_log_has "`spu02lg'", needle("the app exited with status 3") lower
local spu02m1 = r(found)
cert_log_has "`spu02lg'", needle("stub: boom") lower
local spu02m2 = r(found)
capture erase "`spu02lg'"
display as text "  SPU-02 rc `spu02rc', message `spu02m1'/`spu02m2'"
assert `spu02rc' == 198
assert `spu02m1' == 1
assert `spu02m2' == 1
display "SPU-02 PASS: dash serve turns the launch report's error into r(198) naming the app's status and stderr"

// PF-07 (WP-29 P0.12b) -- the r(198) branch above (_srv_err) removes the
// command's run folder before it exits: no run-<pid>-* folder of this
// session is left under c(tmpdir)dash-<uid>, which must exist (dash serve
// made its folder there).  Uid and pid from Python (c(pid) does not exist).
global pf07_tmp "`c(tmpdir)'"
python:
import os as _pf7_os, re as _pf7_re
from sfi import Macro as _pf7_M
_pf7_root = _pf7_os.path.join(_pf7_M.getGlobal("pf07_tmp"), "dash-%d" % _pf7_os.getuid())
_pf7_re_run = _pf7_re.compile(r"^run-%d-" % _pf7_os.getpid())
_pf7_left = ([n for n in _pf7_os.listdir(_pf7_root) if _pf7_re_run.match(n)]
             if _pf7_os.path.isdir(_pf7_root) else None)
_pf7_M.setGlobal("pf07_root", "1" if _pf7_left is not None else "0")
_pf7_M.setGlobal("pf07_left", " ".join(_pf7_left or []))
end
display as text "  PF-07 root present ${pf07_root}, run folders left [${pf07_left}]"
assert "${pf07_root}" == "1"
assert "${pf07_left}" == ""
macro drop pf07_*
display "PF-07 PASS: dash serve's r(198) branch leaves no run folder of this session"

// SPU-03 -- the control: the same stub told to write nothing leaves the
// box empty, so _dash_serve proceeds and returns rc 0.
file open _spufh3 using "`spustub'/dash_render.py", write text replace
file write _spufh3 "pass" _n
file close _spufh3
dash clear
dash scatter mpg weight, name(spu03)
capture noisily dash serve, port(5006) timeout(1) nobrowser
local spu03rc = _rc
display as text "  SPU-03 rc `spu03rc'"
assert `spu03rc' == 0
adopath - "`spustub'"
capture erase "`spustub'/dash_render.py"
capture rmdir "`spustub'"
dash clear
display "SPU-03 PASS: without a launch report error, dash serve returns rc 0 (the control)"

// ================================================================
// LC-02..LC-04 (WP-29 P0.13 F4) -- Break ends dash serve with r(1)
// ================================================================
// LC-02: a stub renderer reports an interruption in the launch box, as the
// real launcher does when Break (sfi's BreakError) or Ctrl+C stops the
// server; dash serve removes its run folder and ends with r(1) -- --Break--,
// no traceback, no r(7102).  LC-04 reads the announcement in the same log.
// LC-03: a real launch, stopped by a patched pollstd that raises BreakError
// once /health has answered: this tests dash's catch and its error 1, not
// Stata's own Break key (A11; the manual GUI check is recorded apart).
// Names are built from c(tmpdir) and the Python pid, with no tempfile or
// tempname draw (see the SPU note above).
global lc_tmp "`c(tmpdir)'"
python:
import os as _lc_os, re as _lc_re, socket as _lc_sock
from sfi import Macro as _lc_M
_lc_pid = _lc_os.getpid()
_lc_M.setGlobal("lc_pid", str(_lc_pid))
_lc_root = _lc_os.path.join(_lc_M.getGlobal("lc_tmp"), "dash-%d" % _lc_os.getuid())
def _lc_runs():
    if not _lc_os.path.isdir(_lc_root):
        return ""
    return " ".join(sorted(n for n in _lc_os.listdir(_lc_root)
                           if _lc_re.match(r"^run-%d-" % _lc_pid, n)))
end
local lcstub "`c(tmpdir)'dash_lc_stub_${lc_pid}"
capture mkdir "`lcstub'"
file open _lcfh using "`lcstub'/dash_render.py", write text replace
file write _lcfh `"_lc_g = globals().get("_dash_launch_report")"' _n
file write _lcfh `"if _lc_g is not None:"' _n
file write _lcfh `"    _lc_g["interrupted"] = True"' _n
file close _lcfh
adopath ++ "`lcstub'"
dash clear
dash scatter mpg weight, name(lc02)
local lc02lg "`c(tmpdir)'dash_lc_${lc_pid}_02.log"
capture erase "`lc02lg'"
quietly log using "`lc02lg'", replace text name(_lc02lf)
capture noisily dash serve, port(5006) timeout(1) nobrowser
local lc02rc = _rc
quietly log close _lc02lf
adopath - "`lcstub'"
cert_log_has "`lc02lg'", needle("traceback") lower
local lc02tb = r(found)
cert_log_has "`lc02lg'", needle("r(7102)")
local lc02r7 = r(found)
cert_log_has "`lc02lg'", needle("press Break (Ctrl+C in console Stata)")
local lc04brk = r(found)
cert_log_has "`lc02lg'", needle("Stata is blocked until the server stops (Ctrl+C)")
local lc04old = r(found)
capture erase "`lc02lg'"
python: _lc_M.setGlobal("lc_runs", _lc_runs())
display as text "  LC-02 rc `lc02rc', traceback `lc02tb', r(7102) `lc02r7', run folders left [${lc_runs}]"
assert `lc02rc' == 1
assert `lc02tb' == 0
assert `lc02r7' == 0
assert "${lc_runs}" == ""
display "LC-02 PASS: an interruption the launcher reports ends dash serve with r(1), no traceback, and its run folder removed"
display as text "  LC-04 Break hint `lc04brk', old Ctrl+C line `lc04old'"
assert `lc04brk' == 1
assert `lc04old' == 0
display "LC-04 PASS: dash serve's announcement names Break (Ctrl+C in console Stata)"
capture erase "`lcstub'/dash_render.py"
capture rmdir "`lcstub'"

// LC-03: the real launcher and app; pollstd raises BreakError once a
// thread has seen /health answer.  The original pollstd is restored after.
dash clear
dash scatter mpg weight, name(lc03)
python:
import threading as _lc_th, time as _lc_time, urllib.request as _lc_url
import sfi as _lc_sfi
_lc_s = _lc_sock.socket()
_lc_s.bind(("127.0.0.1", 0))
_lc_port = _lc_s.getsockname()[1]
_lc_s.close()
_lc_M.setGlobal("lc_port", str(_lc_port))
_lc_up = _lc_th.Event()
def _lc_probe():
    _end = _lc_time.time() + 120
    while _lc_time.time() < _end:
        try:
            _lc_url.urlopen("http://127.0.0.1:%d/health" % _lc_port, timeout=1)
            _lc_up.set()
            return
        except Exception:
            _lc_time.sleep(0.2)
_lc_th.Thread(target=_lc_probe, daemon=True).start()
_lc_orig = _lc_sfi.SFIToolkit.pollstd
def _lc_poll():
    if _lc_up.is_set():
        raise _lc_sfi.BreakError("LC-03 Break")
    return _lc_orig()
_lc_sfi.SFIToolkit.pollstd = _lc_poll
end
timer clear 93
timer on 93
capture noisily dash serve, port(${lc_port}) timeout(1) nobrowser
local lc03rc = _rc
timer off 93
quietly timer list 93
local lc03s = r(t93)
python:
_lc_sfi.SFIToolkit.pollstd = _lc_orig
_lc_free = False
for _i in range(50):
    _b = _lc_sock.socket()
    try:
        _b.setsockopt(_lc_sock.SOL_SOCKET, _lc_sock.SO_REUSEADDR, 1)
        _b.bind(("127.0.0.1", _lc_port))
        _lc_free = True
        break
    except OSError:
        _lc_time.sleep(0.2)
    finally:
        _b.close()
_lc_M.setGlobal("lc_free", "1" if _lc_free else "0")
_lc_M.setGlobal("lc_up", "1" if _lc_up.is_set() else "0")
_lc_M.setGlobal("lc_runs", _lc_runs())
end
display as text "  LC-03 rc `lc03rc' after `lc03s' s, served ${lc_up}, port free ${lc_free}, run folders left [${lc_runs}]"
assert `lc03rc' == 1
assert `lc03s' < 40
assert "${lc_up}" == "1"
assert "${lc_free}" == "1"
assert "${lc_runs}" == ""
display "LC-03 PASS: Break (a patched pollstd) stops a real dash serve with r(1) in `lc03s' s; the port is free and no run folder is left"
dash clear
macro drop lc_*

// ================================================================
// TOK-01..TOK-04 (WP-29 P0.12a) -- the served dashboard needs its key
// ================================================================
// TOK-02 follows LC-03's and PF-08's pattern (TD-3): a daemon thread,
// started in Stata's Python before dash serve blocks, waits for /health,
// reads the key from the run folder's 0600 link.html, runs
// serve_token_probe.py with the file's PATH (never the key), and stops the
// listener whatever happened.  The key stays in Python memory
// (_tok_state) only, so TOK-03 can look for it in the logs without it ever
// passing through a Stata macro or a display.  The thread calls no sfi
// function.  Names are built from c(tmpdir) and the Python pid.
python:
import os as _tok_os
from sfi import Macro as _tok_M
_tok_M.setLocal("tokpid", str(_tok_os.getpid()))
end
local tokdir "`c(tmpdir)'"

// TOK-01: dash build, server writes an app that makes its own key
sysuse auto, clear
dash clear
dash scatter mpg weight, name(tok01)
local tok01py "`tokdir'dash_tok_`tokpid'_01.py"
local tok01lg "`tokdir'dash_tok_`tokpid'_01.log"
capture erase "`tok01lg'"
quietly log using "`tok01lg'", replace text name(_tok01)
dash build, saving("`tok01py'") server replace
quietly log close _tok01
cert_log_has "`tok01lg'", needle("a new key for each launch")
local tok01a = r(found)
cert_file_has "`tok01py'", needle("--token-stdin")
local tok01b = r(found)
// WP-30 P1.31a: the key's provider inside the open-session cap's.
cert_file_has "`tok01py'", needle("auth_provider=_dash_cap_auth(_dash_token_auth(")
local tok01c = r(found)
cert_file_has "`tok01py'", needle("_DASH_SERVE_TOKEN = None")
local tok01d = r(found)
capture erase "`tok01lg'"
capture erase "`tok01py'"
display as text "  TOK-01 access line `tok01a', flag `tok01b', provider `tok01c', global `tok01d'"
assert `tok01a' == 1
assert `tok01b' == 1
assert `tok01c' == 1
assert `tok01d' == 1
display "TOK-01 PASS: dash build, server names the per-launch key and writes an app that requires it"

// TOK-02: a real dash serve refuses without the key and serves with it
dash clear
dash scatter mpg weight, name(tok02)
local toktmp "`tokdir'"
local tokres "`tokdir'dash_tok_`tokpid'_02.txt"
local toklg "`tokdir'dash_tok_`tokpid'_02.log"
local toksm "`tokdir'dash_tok_`tokpid'_02.smcl"
capture erase "`tokres'"
capture erase "`toklg'"
capture erase "`toksm'"
python:
import glob as _tok_glob, re as _tok_re, signal as _tok_sig
import socket as _tok_sock, stat as _tok_stat, subprocess as _tok_sp
import sys as _tok_sys, threading as _tok_th, time as _tok_time
import urllib.error as _tok_ue, urllib.request as _tok_url
_tok_s = _tok_sock.socket()
_tok_s.bind(("127.0.0.1", 0))
_tok_port = _tok_s.getsockname()[1]
_tok_s.close()
_tok_M.setLocal("tokport", str(_tok_port))
_tok_tmp = _tok_M.getLocal("toktmp")
_tok_res = _tok_M.getLocal("tokres")
_tok_probe = _tok_os.path.abspath("serve_token_probe.py")
_tok_state = {}
def _tok_status(url):
    try:
        with _tok_url.urlopen(url, timeout=5) as r:
            return r.status
    except _tok_ue.HTTPError as e:
        return e.code
    except Exception as e:
        return type(e).__name__
def _tok_run():
    lines = []
    try:
        t0 = _tok_time.time()
        while _tok_time.time() - t0 < 60:
            if _tok_status("http://127.0.0.1:%d/health" % _tok_port) == 200:
                break
            _tok_time.sleep(0.2)
        link = None
        t0 = _tok_time.time()
        pat = _tok_os.path.join(_tok_tmp, "dash-%d" % _tok_os.getuid(),
                                "run-%d-*" % _tok_os.getpid(), "link.html")
        while _tok_time.time() - t0 < 10:
            found = _tok_glob.glob(pat)
            if found:
                link = found[0]
                break
            _tok_time.sleep(0.2)
        if link is None:
            lines.append("link=missing")
            lines.append("root_without_key=%s" % _tok_status(
                "http://127.0.0.1:%d/" % _tok_port))
        else:
            lines.append("link=found")
            lines.append("link_mode=" + oct(_tok_stat.S_IMODE(
                _tok_os.stat(link).st_mode))[-3:])
            lines.append("link_dir_mode=" + oct(_tok_stat.S_IMODE(
                _tok_os.stat(_tok_os.path.dirname(link)).st_mode))[-3:])
            _tok_state["link"] = link
            with open(link, encoding="utf-8") as fh:
                m = _tok_re.search(r"\?token=([A-Za-z0-9_-]{43})", fh.read())
            _tok_state["token"] = m.group(1) if m else ""
            r = _tok_sp.run([_tok_sys.executable, _tok_probe, str(_tok_port),
                             link, _tok_res], timeout=120,
                            capture_output=True, text=True)
            if r.stderr:
                lines.append("probe_stderr=" + r.stderr[-300:].replace(
                    "\n", " ").replace("\r", " "))
    except Exception as e:
        lines.append("thread_error=" + type(e).__name__)
    finally:
        try:
            out = _tok_sp.run(["lsof", "-ti", "tcp:%d" % _tok_port,
                               "-sTCP:LISTEN"], capture_output=True,
                              text=True, timeout=10).stdout
            for pid in out.split():
                try:
                    _tok_os.kill(int(pid), _tok_sig.SIGTERM)
                except (ValueError, OSError):
                    pass
        except Exception:
            pass
        lines.append("stopped=1")
        with open(_tok_res, "a", encoding="utf-8") as fh:
            fh.write("\n".join(lines) + "\n")
_tok_thread = _tok_th.Thread(target=_tok_run, daemon=True)
_tok_thread.start()
end
quietly log using "`toklg'", replace text name(_tok02t)
quietly log using "`toksm'", replace smcl name(_tok02s)
timer clear 93
timer on 93
capture noisily dash serve, port(`tokport') timeout(1) nobrowser
local tok02rc = _rc
timer off 93
quietly timer list 93
local tok02s = r(t93)
quietly log close _tok02s
quietly log close _tok02t
python: _tok_thread.join(60)
foreach n in link=found link_port=ok health=200 root_without_key=403 near_miss=403 page_with_key=200 pull_without_key=refused pull_with_key_rows=74 link_mode=600 link_dir_mode=700 stopped=1 {
    cert_file_has "`tokres'", needle("`n'")
    local tok02_`=strtoname("`n'")' = r(found)
}
type "`tokres'"
display as text "  TOK-02 rc `tok02rc' after `tok02s' s"
assert `tok02rc' == 0
assert `tok02s' < 60
foreach n in link=found link_port=ok health=200 root_without_key=403 near_miss=403 page_with_key=200 pull_without_key=refused pull_with_key_rows=74 link_mode=600 link_dir_mode=700 stopped=1 {
    assert `tok02_`=strtoname("`n'")'' == 1
}
display "TOK-02 PASS: a real dash serve refuses every request without its key and serves 74 rows with it, its link 0600 in a 0700 folder"

// TOK-03: no log holds the key
python:
_tok_bad = 0
_tok_key = _tok_state.get("token", "")
for _tok_p in (_tok_M.getLocal("toklg"), _tok_M.getLocal("toksm")):
    with open(_tok_p, encoding="utf-8", errors="replace") as fh:
        _tok_txt = fh.read().replace("\n> ", "")
    if (_tok_key and _tok_key in _tok_txt) or \
            _tok_re.search(r"\?token=[A-Za-z0-9_-]{32,}", _tok_txt):
        _tok_bad += 1
_tok_M.setLocal("tok03bad", str(_tok_bad))
_tok_M.setLocal("tok03len", str(len(_tok_key)))
_tok_gone = "link" in _tok_state and not _tok_os.path.exists(_tok_state["link"])
_tok_M.setLocal("tok03gone", "1" if _tok_gone else "0")
end
cert_log_has "`toklg'", needle("opens only through its link")
local tok03a = r(found)
cert_log_has "`toklg'", needle("link.html")
local tok03b = r(found)
display as text "  TOK-03 logs holding the key `tok03bad', key length `tok03len', link removed `tok03gone', said `tok03a' `tok03b'"
capture erase "`toklg'"
capture erase "`toksm'"
capture erase "`tokres'"
assert `tok03bad' == 0
assert `tok03len' == 43
assert `tok03gone' == 1
assert `tok03a' == 1
assert `tok03b' == 1
display "TOK-03 PASS: neither the text log nor the SMCL log holds the key, and the link file is gone once the server stops"

// TOK-04: the help names the key
cert_file_has "../dash.sthlp", needle("DASH_SERVE_TOKEN")
local tok04a = r(found)
cert_file_has "../dash.sthlp", needle("?token=")
local tok04b = r(found)
cert_file_has "../dash.sthlp", needle("--token-stdin")
local tok04c = r(found)
cert_file_has "../dash.sthlp", needle("only this machine can reach it")
local tok04d = r(found)
cert_file_has "../dash.sthlp", needle("There is no password")
local tok04e = r(found)
display as text "  TOK-04 `tok04a' `tok04b' `tok04c' stale `tok04d' `tok04e'"
assert `tok04a' == 1
assert `tok04b' == 1
assert `tok04c' == 1
assert `tok04d' == 0
assert `tok04e' == 0
display "TOK-04 PASS: the help names DASH_SERVE_TOKEN, ?token= and --token-stdin, and no longer claims only this machine can reach it"
dash clear

// ================================================================
// GE-20 (WP-30 P1.28a) -- dash serve stores nothing in r(), so neither a
// path nor the served key can be: a stub renderer (SRV-17's) stands in.
// Paths are built by hand, never from tempfile or tempname (the session
// counter SRV-19 reads; see SPU-01).
// ================================================================
local ge20d "`c(tmpdir)'dash_ge20_`c(current_time)'"
local ge20d = subinstr("`ge20d'", ":", "", .)
capture mkdir "`ge20d'"
capture file close ge20fh
file open ge20fh using "`ge20d'/dash_render.py", write text replace
file write ge20fh `"import os, shutil, sys"' _n
file write ge20fh `"_a = sys.argv[1:]"' _n
file write ge20fh `"_d = os.path.dirname(os.path.abspath(__file__))"' _n
file write ge20fh `"shutil.copyfile(_a[_a.index("--spec") + 1], os.path.join(_d, "spec.json"))"' _n
file write ge20fh `"shutil.copyfile(_a[_a.index("--data") + 1], os.path.join(_d, "data.json"))"' _n
file write ge20fh `"open(_a[_a.index("--output") + 1], "w", encoding="utf-8").write("# app")"' _n
file close ge20fh
dash clear
qui sysuse auto, clear
dash scatter mpg weight, name(ge20)
dash build, saving("`ge20d'/ge20.html") replace nobrowser
adopath ++ "`ge20d'"
capture noisily {
    quietly summarize price
    dash serve
    mata: st_local("ge20m", invtokens(st_dir("r()", "macro", "*")'))
    mata: st_local("ge20s", strofreal(rows(st_dir("r()", "numscalar", "*"))))
}
local rc20 = _rc
adopath - "`ge20d'"
local fl : dir "`ge20d'" files "*"
foreach f of local fl {
    capture erase "`ge20d'/`f'"
}
capture rmdir "`ge20d'"
dash clear
assert `rc20' == 0
assert "`ge20m'" == "" & "`ge20s'" == "0"
display "GE-20 PASS: dash serve stores nothing in r()"

// ================================================================
// NC-07..NC-08 (WP-30 P1.26b) -- the served app's notes reach Stata
// ================================================================
// _nc_notes reads a text log (path in local nclog), joins Stata's "> "
// continuation lines, and sets local ncnotes to its sorted lines holding
// "(note:" joined by " || ", and ncn to their count.  Each case opens with
// graph drop _all: S22 notes graph export while a Stata graph is in memory.
python:
import re as _nc_re
from sfi import Macro as _nc_M
def _nc_notes():
    with open(_nc_M.getLocal("nclog"), encoding="utf-8", errors="replace") as fh:
        txt = fh.read().replace("\n> ", "")
    got = sorted(_nc_re.sub(r"\(note: +", "(note:  ", l.strip())
                 for l in txt.splitlines() if "(note:" in l)
    _nc_M.setLocal("ncnotes", " || ".join(got))
    _nc_M.setLocal("ncn", str(len(got)))
end
local ncdir "`c(tmpdir)'"
local ncls = c(linesize)
set linesize 255

// NC-07: dash build, server names what dash build names
quietly graph drop _all
sysuse auto, clear
dash clear
dash (scatter mpg weight, mcolor(notacolor) msymbol(weird)) (lfit mpg weight if price > 20000) (bar mpg weight if price > 20000) (line mpg weight if price > 20000), name(nc07)
foreach q in noisily quietly {
    foreach m in saved server {
        local nclog "`ncdir'dash_nc07_`q'_`m'.log"
        local ext = cond("`m'" == "saved", "html", "py")
        local opt = cond("`m'" == "saved", "", "server")
        capture erase "`nclog'"
        quietly log using "`nclog'", replace text name(_nc07)
        // capture would hide the notes (S06): quietly runs uncaptured.
        if "`q'" == "quietly" quietly dash build, saving("`ncdir'dash_nc07.`ext'") replace `opt'
        else capture noisily dash build, saving("`ncdir'dash_nc07.`ext'") replace `opt'
        local nc07rc_`q'_`m' = _rc
        quietly log close _nc07
        python: _nc_notes()
        local nc07_`q'_`m' `"`ncnotes'"'
        local nc07n_`q'_`m' = `ncn'
        cert_log_has "`nclog'", needle("drew nothing")
        local nc07dn_`q'_`m' = r(found)
        capture erase "`nclog'"
    }
}
capture erase "`ncdir'dash_nc07.html"
capture erase "`ncdir'dash_nc07.py"
display as text `"  NC-07 saved   `nc07_noisily_saved'"'
display as text `"  NC-07 server  `nc07_noisily_server'"'
display as text `"  NC-07 quietly `nc07n_quietly_saved' `nc07n_quietly_server'"'
foreach q in noisily quietly {
    assert `nc07rc_`q'_saved' == 0 & `nc07rc_`q'_server' == 0
    assert `nc07dn_`q'_saved' == 0 & `nc07dn_`q'_server' == 0
    assert `"`nc07_`q'_saved'"' == `"`nc07_`q'_server'"'
}
assert `nc07n_noisily_saved' >= 3
assert `nc07n_quietly_saved' >= 2
local ncsaved `"`nc07_noisily_saved'"'
display "NC-07 PASS: dash build, server prints the notes dash build prints, noisily and quietly, and no drew-nothing note"

// NC-08: a real dash serve relays the app's notes once each, never the key
quietly graph drop _all
local nclog "`ncdir'dash_nc08.log"
local ncsm "`ncdir'dash_nc08.smcl"
capture erase "`nclog'"
capture erase "`ncsm'"
python:
import glob as _nc_glob, os as _nc_os, signal as _nc_sig, socket as _nc_sock
import subprocess as _nc_sp, threading as _nc_th, time as _nc_time
import urllib.error as _nc_ue, urllib.request as _nc_url
_nc_s = _nc_sock.socket()
_nc_s.bind(("127.0.0.1", 0))
_nc_port = _nc_s.getsockname()[1]
_nc_s.close()
_nc_M.setLocal("ncport", str(_nc_port))
_nc_tmp = _nc_M.getLocal("ncdir")
_nc_state = {}
def _nc_get(url):
    try:
        with _nc_url.urlopen(url, timeout=20) as r:
            return r.status
    except _nc_ue.HTTPError as e:
        return e.code
    except Exception as e:
        return type(e).__name__
def _nc_run():
    try:
        t0 = _nc_time.time()
        while _nc_time.time() - t0 < 60:
            if _nc_get("http://127.0.0.1:%d/health" % _nc_port) == 200:
                break
            _nc_time.sleep(0.2)
        pat = _nc_os.path.join(_nc_tmp, "dash-%d" % _nc_os.getuid(),
                               "run-%d-*" % _nc_os.getpid(), "link.html")
        t0 = _nc_time.time()
        while _nc_time.time() - t0 < 10 and not _nc_glob.glob(pat):
            _nc_time.sleep(0.2)
        with open(_nc_glob.glob(pat)[0], encoding="utf-8") as fh:
            m = _nc_re.search(r"\?token=([A-Za-z0-9_-]{43})", fh.read())
        _nc_state["token"] = m.group(1)
        url = "http://127.0.0.1:%d/?token=%s" % (_nc_port, m.group(1))
        _nc_state["gets"] = [_nc_get(url), _nc_get(url),
                             _nc_get("http://127.0.0.1:%d/" % _nc_port)]
        _nc_time.sleep(3)
    except Exception as e:
        _nc_state["error"] = type(e).__name__
    finally:
        try:
            out = _nc_sp.run(["lsof", "-ti", "tcp:%d" % _nc_port,
                              "-sTCP:LISTEN"], capture_output=True,
                             text=True, timeout=10).stdout
            for pid in out.split():
                try:
                    _nc_os.kill(int(pid), _nc_sig.SIGTERM)
                except (ValueError, OSError):
                    pass
        except Exception:
            pass
_nc_thread = _nc_th.Thread(target=_nc_run, daemon=True)
_nc_thread.start()
end
quietly log using "`nclog'", replace text name(_nc08t)
quietly log using "`ncsm'", replace smcl name(_nc08s)
timer clear 94
timer on 94
capture noisily dash serve, port(`ncport') timeout(1) nobrowser
local nc08rc = _rc
timer off 94
quietly timer list 94
local nc08s = r(t94)
quietly log close _nc08s
quietly log close _nc08t
python:
_nc_thread.join(60)
_nc_notes()
_nc_bad = []
_nc_key = _nc_state.get("token", "")
for _nc_p in (_nc_M.getLocal("nclog"), _nc_M.getLocal("ncsm")):
    with open(_nc_p, encoding="utf-8", errors="replace") as fh:
        _nc_txt = fh.read().replace("\n> ", "")
    if not _nc_key or _nc_key in _nc_txt:
        _nc_bad.append("key")
    for _nc_w in ("UserWarning", "Traceback", ".py:", "403 GET"):
        if _nc_w in _nc_txt:
            _nc_bad.append(_nc_w)
_nc_M.setLocal("nc08bad", " ".join(_nc_bad))
_nc_M.setLocal("nc08gets", str(_nc_state.get("gets", _nc_state.get("error"))))
end
local nc08 `"`ncnotes'"'
capture erase "`nclog'"
capture erase "`ncsm'"
display as text `"  NC-08 rc `nc08rc' after `nc08s' s, requests `nc08gets', bad [`nc08bad']"'
display as text `"  NC-08 notes `nc08'"'
assert `nc08rc' == 0
assert `nc08s' < 60
assert "`nc08gets'" == "[200, 200, 403]"
assert "`nc08bad'" == ""
assert `"`nc08'"' == `"`ncsaved'"'
set linesize `ncls'
dash clear
display "NC-08 PASS: a real dash serve relays the app's notes once each over two sessions, with no warning path, traceback, access line or key"

// ================================================================
// SRV-19 -- dash serve writes its app into a private run folder of this
// session, and the folder is gone when the command ends
// ================================================================
// BUGS.md BUG-47: dash serve wrote every app to one fixed name,
// dash_serve_app.py, so two sessions serving at once overwrote each other's
// file.  The launch is the renderer's, so the locator is stubbed -- as
// LOC-09 does -- to hand dash serve a renderer that records the arguments
// it was run with and returns instead of serving.
// Flipped (WP-29 P0.12b): the app used to be a Stata tempfile of this
// session (St<pid>.<n>, 0644, beside the spec and data in c(tmpdir)).  It
// is now app.py in c(tmpdir)dash-<uid>/run-<pid>-<random>/, a 0700 folder
// of this session, with spec.json and data.json beside it, and dash
// removes the folder when the command ends.  Uid and pid come from Python
// (c(pid) does not exist); c(tmpdir) is compared as spelled.
// Last in the script: the stub replaces the real locator for good.
// The stand-in and its record are named from a tempfile, so two sessions
// running this script at once cannot write into each other's.
tempfile s19base
local s19fake "`s19base'.py"
global SRV19_FAKE "`s19fake'"
global SRV19_BASE "`s19base'"
global SRV19_REC  "`s19base'.argv"
global SRV19_TMP  "`c(tmpdir)'"
capture erase "$SRV19_REC"
tempname s19fh
quietly file open `s19fh' using "`s19fake'", write replace text
file write `s19fh' "import json, os, sys" _n
file write `s19fh' `"_p = os.path.splitext(os.path.abspath(__file__))[0] + ".argv""' _n
file write `s19fh' `"with open(_p, "a", encoding="utf-8") as _fh:"' _n
file write `s19fh' "    _fh.write(json.dumps(sys.argv) + chr(10))" _n
file close `s19fh'
capture program drop _dash_find_render
program define _dash_find_render, rclass
    return local fn "$SRV19_FAKE"
end
dash clear
qui sysuse auto, clear
dash scatter mpg weight, name(sv17)
capture noisily dash serve, port(5099) timeout(1) nobrowser
assert _rc == 0
python:
import json as _s19_json
import os as _s19_os
import re as _s19_re
from sfi import Macro as _s19_M
with open(_s19_M.getGlobal("SRV19_REC"), encoding="utf-8") as _s19_fh:
    _s19_runs = [_s19_json.loads(_s19_l) for _s19_l in _s19_fh if _s19_l.strip()]
_s19_arg = lambda r, k: r[r.index(k) + 1] if k in r else ""
_s19_outs = [_s19_arg(_s19_r, "--output") for _s19_r in _s19_runs]
_s19_tmp = _s19_M.getGlobal("SRV19_TMP")
_s19_pat = (_s19_re.escape(_s19_os.path.join(_s19_tmp, "dash-%d" % _s19_os.getuid()))
            + _s19_re.escape(_s19_os.sep) + r"run-%d-[A-Za-z0-9_]+" % _s19_os.getpid()
            + _s19_re.escape(_s19_os.sep) + r"app\.py")
_s19_ok = len(_s19_outs) == 1 and _s19_re.fullmatch(_s19_pat, _s19_outs[0]) is not None
if _s19_ok:
    _s19_dir = _s19_os.path.dirname(_s19_outs[0])
    _s19_ok = (_s19_arg(_s19_runs[0], "--spec") == _s19_os.path.join(_s19_dir, "spec.json")
               and _s19_arg(_s19_runs[0], "--data") == _s19_os.path.join(_s19_dir, "data.json")
               and not _s19_os.path.lexists(_s19_dir))
_s19_M.setGlobal("SRV19_OUT", _s19_outs[0] if _s19_outs else "")
_s19_M.setGlobal("SRV19_OK", "1" if _s19_ok else "0")
end
display as text "  SRV-19 app file: [$SRV19_OUT]"
assert "$SRV19_OK" == "1"
capture erase "$SRV19_REC"
capture erase "`s19fake'"
capture program drop _dash_find_render
dash clear
macro drop SRV19_*
display "SRV-19 PASS: dash serve writes its app to app.py in a private run folder of this session, spec.json and data.json beside it, and the folder is gone when it returns"

capture program drop _srv_try

display ""
display "All dash serve option tests PASSED."
