*! test_serve_launch.cscript  v1.0
*! Certification script for `dash serve' as a COMMAND.
*!
*! `dash serve, port(5006)' -- the example dash.sthlp gives -- returned
*! r(198) "invalid 'port'".  So did timeout() and nobrowser, and so did every
*! build option the help says serve inherits.  Only the bare form ran.
*!
*! _dash_serve forwarded `0' to _dash_serve_spec verbatim, and `0' still
*! carries its leading comma, so the call became
*!     _dash_serve_spec, specpath(...) datapath(...) , port(5006)
*! -- two commas on one line, and everything after the second was read as a
*! positional argument.  _dash_build fixes exactly this at its own forwarding
*! site with `: subinstr local' and has done for some time; the serve path
*! never got the same treatment.
*!
*! Nothing caught it because test_serve_options.cscript calls
*! _dash_serve_spec DIRECTLY, bypassing the one line the defect lives on --
*! its own header says it covers "everything `dash serve' does except the
*! launch".  Its five PASS banners are labelled "dash serve ..." and none of
*! them runs `dash serve'.  Every other serve case in the suite is a
*! `capture' asserting _rc == 198 on an error path.
*!
*! WHY THIS SCRIPT DOES NOT START A SERVER.  `dash serve' blocks Stata until
*! the server stops, and timeout() is measured in MINUTES, so the shortest
*! real launch this suite could assert would hold it for sixty seconds.  The
*! cases below instead drive `dash serve' with an EMPTY registry: option
*! parsing happens first, so a correctly-parsed command reaches the registry
*! check and stops there.  That distinguishes the two outcomes precisely --
*! "no graphs registered" means the options parsed, "invalid 'port'" means
*! they did not -- and costs nothing.  A real launch was verified by hand
*! against this fix; see the BUGS.md entry.
*!
*! Tests: SRV-01 through SRV-20 (SRV-17 to SRV-20, added by ROADMAP WP-24,
*! drive `dash serve' with a graph registered, against a stub renderer that
*! starts no server; SRV-19 checks the app file it is handed is a tempfile
*! of this session, BUG-47; SRV-20, added in WP-24's second round, is the
*! serve-side twin of test_render_locate.cscript LOC-17 -- the renderer
*! path dash serve runs is handed to Python as data, BUG-SEC-1.  SRV-20
*! runs before SRV-19, which does not restore the real locator.)
*!
*! Usage:  do test/test_serve_launch.cscript
*! Version: 1.2  24sep2026

cscript "dash serve accepts its own options" adodir ".."

// ----------------------------------------------------------------
// Setup
// ----------------------------------------------------------------
if "`c(python_exec)'" == "" {
    display as error "SKIP: Python not available."
    exit 222
}

qui sysuse auto, clear
do "../dash_parse.mata"
do "../dash.ado"
do "cert_helpers.do"

// Run `dash serve' with whatever options are given, on an EMPTY registry,
// and hand back the return code and the message.  Options are parsed before
// the registry is looked at, so this separates "the options parsed" from
// "the options did not".
capture program drop _srv_try
program define _srv_try, rclass
    args opts
    dash clear
    tempname lf
    tempfile lg
    quietly log using "`lg'", replace text name(`lf')
    capture noisily dash serve, `opts'
    local rc = _rc
    quietly log close `lf'
    // Searched with cert_log_has (case-insensitively, as the line-by-line
    // Mata reader this replaced did, 24sep2026): the log is read as a value
    // in Mata, so nothing a message contains can end a Stata string or be
    // parsed as code, and a line Stata wrapped at the column is searched
    // re-joined.  Each result is read into a local at once: every call
    // replaces r().
    cert_log_has "`lg'", needle("invalid") lower
    local invalid = r(found)
    cert_log_has "`lg'", needle("no graphs registered") lower
    local noregist = r(found)
    cert_log_has "`lg'", needle("only apply to") lower
    local buildonly = r(found)
    // The port check's own refusal: "dash serve: port() must be between
    // 1024 and 65535 (got: 80)", "... must be a positive integer (got:
    // abc)" (measured 24sep2026).
    cert_log_has "`lg'", needle("port() must be") lower
    local portmsg = r(found)
    return scalar rc        = `rc'
    return scalar invalid   = `invalid'
    return scalar noregist  = `noregist'
    return scalar buildonly = `buildonly'
    return scalar portmsg   = `portmsg'
end


// ================================================================
// SRV-01..04 — each documented option must PARSE
// ================================================================
// "invalid 'port'" means the option never reached the parser.  Reaching the
// registry check means it did.

_srv_try "port(5099)"
assert r(invalid) == 0
assert r(noregist) == 1
display "SRV-01 PASS: port() parses"

_srv_try "timeout(1)"
assert r(invalid) == 0
assert r(noregist) == 1
display "SRV-02 PASS: timeout() parses"

_srv_try "nobrowser"
assert r(invalid) == 0
assert r(noregist) == 1
display "SRV-03 PASS: nobrowser parses"

_srv_try "port(5099) timeout(1) nobrowser"
assert r(invalid) == 0
assert r(noregist) == 1
display "SRV-04 PASS: all three together parse"

// ================================================================
// SRV-05..08 — the build options the help says serve inherits
// ================================================================
// dash.sthlp: "dash serve also accepts every option dash build accepts --
// title(), subtitle(), layout(), link(), filter(), theme(), scheme(),
// tabs() and filterposition()".

_srv_try `"title("A Title")"'
assert r(invalid) == 0
assert r(noregist) == 1
display "SRV-05 PASS: title() parses on dash serve"

_srv_try "layout(1 1)"
assert r(invalid) == 0
assert r(noregist) == 1
display "SRV-06 PASS: layout() parses on dash serve"

_srv_try "scheme(s2color)"
assert r(invalid) == 0
assert r(noregist) == 1
display "SRV-07 PASS: scheme() parses on dash serve"

_srv_try `"port(5099) title("T") layout(1 1) nobrowser"'
assert r(invalid) == 0
assert r(noregist) == 1
display "SRV-08 PASS: serve options and build options mix"

// ================================================================
// SRV-09..11 — validation must still reject bad values
// ================================================================
// The fix must not turn a rejected value into an accepted one.
//
// ... and each must be refused BY THE PORT CHECK.  rc 198 alone could not
// say so: the empty-registry refusal is r(198) too, and every _srv_try runs
// on an empty registry, so these three passed with port() validation
// deleted (found 24sep2026).  The refusal names port(), and comes before
// the registry is looked at -- the "no graphs registered" that SRV-01..08
// and SRV-12 find present is absent.

_srv_try "port(80)"
assert r(rc) == 198
assert r(portmsg) == 1
assert r(noregist) == 0
display "SRV-09 PASS: port() below 1024 is still rejected"

_srv_try "port(70000)"
assert r(rc) == 198
assert r(portmsg) == 1
assert r(noregist) == 0
display "SRV-10 PASS: port() above 65535 is still rejected"

_srv_try "port(abc)"
assert r(rc) == 198
assert r(portmsg) == 1
assert r(noregist) == 0
display "SRV-11 PASS: a non-numeric port() is still rejected"

// ================================================================
// SRV-12 — the bare form still works
// ================================================================
_srv_try ""
assert r(invalid) == 0
assert r(noregist) == 1
display "SRV-12 PASS: bare dash serve still reaches the registry check"

// ================================================================
// SRV-13..15 — build-only options are NAMED, not silently dropped
// ================================================================
// saving(), replace and server describe writing a file.  dash.sthlp does not
// list them for dash serve, and _dash_prepare_spec declares all three and
// reads none, so before this they were accepted and vanished.

_srv_try `"saving(out.html)"'
assert r(invalid) == 0
assert r(buildonly) == 1
display "SRV-13 PASS: saving() on dash serve is reported, not dropped"

_srv_try "replace"
assert r(invalid) == 0
assert r(buildonly) == 1
display "SRV-14 PASS: replace on dash serve is reported, not dropped"

_srv_try "server"
assert r(invalid) == 0
assert r(buildonly) == 1
display "SRV-15 PASS: server on dash serve is reported, not dropped"

// ... and a command with none of them must NOT print the note.
_srv_try "port(5099)"
assert r(buildonly) == 0
display "SRV-15b PASS: the note is silent when no build-only option is given"

// ================================================================
// SRV-16 — the option surface of dash serve and _dash_serve_spec agree
// ================================================================
// test_serve_options.cscript drives _dash_serve_spec directly, which is why
// it never saw the forwarding defect.  This asserts the two entry points
// accept the same things, so a future divergence shows up here.
dash clear
qui sysuse auto, clear
dash scatter mpg weight, name(sv1)
tempfile sp dp
capture noisily _dash_serve_spec, specpath("`sp'") datapath("`dp'") ///
    port(5099) timeout(1) nobrowser title("T")
assert _rc == 0
assert "`r(port)'" == "5099"
assert "`r(timeout)'" == "1"
assert "`r(nobrowser)'" == "nobrowser"
display "SRV-16 PASS: _dash_serve_spec still parses the same options directly"

// ================================================================
// SRV-17..18 -- ROADMAP WP-03's AC-03.3 and AC-03.2 through dash serve
// ================================================================
// Added by WP-24, whose mutation check of WP-03 found both criteria held
// only below the command: test_serve_options.cscript [3/5] calls
// _dash_serve_spec directly (with port() and timeout(), never bare), and
// SRV-09 to SRV-11 above run against an EMPTY registry, which exits 198
// on its own -- measured, with the port() range check deleted from
// _dash_serve_spec, SRV-09 still passed.
//
// A stub dash_render.py placed first on the ado-path (the method of
// test_help_claims_4.cscript HC4-16 and test_serve_browser.cscript) stands
// in for the renderer.  `dash serve' runs whole -- options, inheritance,
// spec, browser decision, the handoff -- and the stub copies the spec and
// the data it is handed and exits, so no server starts, and none could
// start if a check below broke.  The served document is then built from
// exactly what dash serve handed over, by the real renderer.
global dash_nobrowser 1
tempfile srvbase
local srvstub "`srvbase'_srv_stub"
capture mkdir "`srvstub'"
tempname sfh
file open `sfh' using "`srvstub'/dash_render.py", write text replace
file write `sfh' `"import os, shutil, sys"' _n
file write `sfh' `"_a = sys.argv[1:]"' _n
file write `sfh' `"_d = os.path.dirname(os.path.abspath(__file__))"' _n
file write `sfh' `"shutil.copyfile(_a[_a.index("--spec") + 1], os.path.join(_d, "spec.json"))"' _n
file write `sfh' `"shutil.copyfile(_a[_a.index("--data") + 1], os.path.join(_d, "data.json"))"' _n
file write `sfh' `"open(_a[_a.index("--output") + 1], "w", encoding="utf-8").write("# app")"' _n
file close `sfh'
global SRV_STUB "`srvstub'"

// SRV-17 -- AC-03.3: `dash build, filter(...)' and then a bare `dash serve'
// serves a dashboard carrying that filter.
dash clear
qui sysuse auto, clear
dash scatter mpg weight, name(sv17)
tempfile b17
capture noisily dash build, saving("`b17'.html") replace nobrowser ///
    filter(foreign, type(dropdown))
assert _rc == 0
capture erase "`srvstub'/spec.json"
capture erase "`srvstub'/data.json"
adopath ++ "`srvstub'"
capture noisily {
    _dash_find_render
    assert strpos(`"`r(fn)'"', "_srv_stub") > 0
    capture noisily dash serve
    assert _rc == 0
}
local rc17 = _rc
adopath - "`srvstub'"
assert `rc17' == 0
confirm file "`srvstub'/spec.json"
cert_file_has "`srvstub'/spec.json", needle(`""filter":"foreign, type(dropdown)""') lower
local s17f = r(found)
assert `s17f' == 1
global SRV17_NSEL ""
global SRV17_FOREIGN ""
python:
import importlib.util as _s17_il
import os as _s17_os
import sys as _s17_sys
import warnings as _s17_w
from sfi import Macro as _s17_M
from bokeh.document import Document as _s17_Doc
from bokeh.models import Select as _s17_Select

# The real renderer of this tree, registered while it is used:
# ServerAppBuilder copies helpers into the app from its own source, which
# it finds through sys.modules (test_json_escaping.cscript does the same).
_s17_spec = _s17_il.spec_from_file_location("_srv17_dash_render", _s17_os.path.abspath("../dash_render.py"))
_s17_dr = _s17_il.module_from_spec(_s17_spec)
_s17_sys.modules["_srv17_dash_render"] = _s17_dr
_s17_spec.loader.exec_module(_s17_dr)
_s17_dir = _s17_M.getGlobal("SRV_STUB")
_s17_app = _s17_os.path.join(_s17_dir, "app.py")
with _s17_w.catch_warnings():
    _s17_w.simplefilter("ignore")
    _s17_dr.ServerAppBuilder(_s17_os.path.join(_s17_dir, "spec.json"), _s17_os.path.join(_s17_dir, "data.json")).build(_s17_app)
with open(_s17_app, encoding="utf-8") as _s17_fh:
    _s17_src = _s17_fh.read()
_s17_attach = "if __name__ != '__main__':" + chr(10) + "    make_document(curdoc())"
assert _s17_attach in _s17_src, "the generated app's curdoc attach moved"
_s17_ns = {"__name__": "_srv17_app"}
with _s17_w.catch_warnings():
    _s17_w.simplefilter("ignore")
    exec(compile(_s17_src.replace(_s17_attach, "pass"), "_srv17_app.py", "exec"), _s17_ns)
    _s17_doc = _s17_Doc()
    _s17_ns["make_document"](_s17_doc)
_s17_sel = list(_s17_doc.select({"type": _s17_Select}))
_s17_opts = [str(o[1]) if isinstance(o, (list, tuple)) else str(o) for s in _s17_sel for o in s.options]
_s17_M.setGlobal("SRV17_NSEL", str(len(_s17_sel)))
_s17_M.setGlobal("SRV17_FOREIGN", "1" if ("Foreign" in _s17_opts and "Domestic" in _s17_opts) else "0")
_s17_gone = _s17_sys.modules.pop("_srv17_dash_render", None)
end
display as text "     served document: ${SRV17_NSEL} Select widget(s); Foreign and Domestic among its options: ${SRV17_FOREIGN}"
assert "${SRV17_NSEL}" == "1"
assert "${SRV17_FOREIGN}" == "1"
display "SRV-17 PASS: AC-03.3 -- a bare dash serve after dash build, filter() serves the build's dropdown"

// SRV-18 -- AC-03.2: `dash serve, port(80)' exits 198 with the range
// message, with a graph registered, so the registry check cannot answer
// for the port() check; the stub is first on the path, so a broken check
// could not start a server.
dash clear
dash scatter mpg weight, name(sv18)
capture erase "`srvstub'/spec.json"
adopath ++ "`srvstub'"
local s18bad ""
local s18ls = c(linesize)
set linesize 255
foreach p in 80 65536 {
    tempname lf18
    tempfile lg18
    quietly log using "`lg18'", replace text name(`lf18')
    capture noisily dash serve, port(`p') nobrowser
    local rc18 = _rc
    quietly log close `lf18'
    cert_log_has "`lg18'", needle("port() must be between 1024 and 65535 (got: `p')") lower
    local s18m = r(found)
    capture confirm file "`srvstub'/spec.json"
    local s18ran = (_rc == 0)
    if `rc18' != 198 | `s18m' != 1 | `s18ran' != 0 {
        local s18bad "`s18bad' [port(`p'): rc `rc18', range message `s18m', renderer ran `s18ran']"
    }
}
set linesize `s18ls'
adopath - "`srvstub'"
if "`s18bad'" != "" {
    display as error "SRV-18 FAIL:`s18bad'"
    exit 9
}
display "SRV-18 PASS: AC-03.2 -- dash serve, port(80) and port(65536) exit 198 with the range message, a graph registered"

capture erase "`srvstub'/spec.json"
capture erase "`srvstub'/data.json"
capture erase "`srvstub'/app.py"
capture erase "`srvstub'/dash_render.py"
capture rmdir "`srvstub'"
macro drop SRV_STUB SRV17_*
dash clear

// ================================================================
// SRV-20 -- the renderer path dash serve runs is handed to Python as data
// ================================================================
// The serve-side twin of test_render_locate.cscript LOC-17.  BUGS.md
// BUG-SEC-1: _dash_do_render and _dash_serve wrote the renderer path and
// the output path into python: lines; a double quote in either ended the
// literal and the rest ran as Python.  LOC-17 runs the immediate route's
// _dash_do_render with payload paths; nothing ran dash serve, whose own
// interpolation (dash.ado ~5481, `runpy.run_path("`_py_render'", ...)') is
// a SECOND copy of the same idiom.  This drives `dash serve' whole against
// a renderer whose DIRECTORY name is a Python payload -- whose double quote
// would end the literal the path is interpolated into -- located through
// the real _dash_find_render (findfile off S_ADO, as LOC-10/11 do), so the
// located path is the locator's own answer, escaped by _dash_json_str and
// handed to runpy.run_path.  Measured 24sep2026: with `_py_render'
// replaced by `render_py' (the pre-fix raw form), the quote in the path
// ends run_path's string argument, the rest is read as code, and the
// payload's touch runs -- dash serve creates the sentinel and returns
// r(7102) (run_path then fails on the non-path second argument).  SRV-20
// requires serve rc 0 AND the sentinel absent, as LOC-17 requires its
// render rc 0 and its sentinel absent.  With the escaping the quote is
// written \" inside the literal, run_path is given the whole path as one
// string, opens the stub there and runs it -- which records its arguments
// and starts no server -- rc 0, nothing touched.  So `dash serve' runs
// whole (options, spec, browser decision, the handoff) and no server can
// start; the stub's record proves the payload PATH reached Python as the
// string runpy executed, not as code.  The spec, data and app paths dash
// serve also interpolates are session tempfiles, escaped by the same
// _dash_json_str; the renderer path is the one the locator's answer
// controls, as in LOC-17.
//
// This runs BEFORE SRV-19, which replaces _dash_find_render with a
// stand-in and does not restore it.
global dash_nobrowser 1
tempfile s20base
// The payload, appended to the directory name: x, a double quote to end
// run_path's string argument, then `,__import__("os").system("touch
// s20_sent") or"y' -- so raw, the path splits into two arguments to
// run_path, the second `system(...) or "y<...>/dash_render.py"', and the
// system() runs the touch before run_path fails on a non-dict second
// argument.  Measured 24sep2026 (probe): raw, the sentinel is created and
// the call is r(7102); escaped, run_path is given the whole path as one
// string, opens the stub there and runs it, rc 0, nothing touched.  Built
// with char() so this file holds no unescaped quote of its own, and with
// no "/" so it is one directory name.
mata: st_local("_s20p", "x" + char(34) + ",__import__(" + char(34) + "os" + char(34) + ").system(" + char(34) + "touch s20_sent" + char(34) + ") or" + char(34) + "y")
local s20dir `"`s20base'`_s20p'"'
global SRV20_DIR "`s20dir'"
// The stub writes its record beside itself, so its path need carry no
// quote of its own; read back from the same directory (a value in Mata,
// so its quotes cannot break anything).
global SRV20_REC `"`s20dir'/argv.jsonl"'
capture erase "$SRV20_REC"
mata: mkdir(st_local("s20dir"))
mata: st_local("_s20made", strofreal(direxists(st_local("s20dir"))))
assert `_s20made' == 1
tempname s20fh
file open `s20fh' using `"`s20dir'/dash_render.py"', write text replace
file write `s20fh' "import json, os, sys" _n
file write `s20fh' `"_p = os.path.join(os.path.dirname(os.path.abspath(__file__)), "argv.jsonl")"' _n
file write `s20fh' `"with open(_p, "a", encoding="utf-8") as _fh:"' _n
file write `s20fh' "    _fh.write(json.dumps([__file__] + sys.argv) + chr(10))" _n
file close `s20fh'
dash clear
qui sysuse auto, clear
dash scatter mpg weight, name(sv20)
mata: st_local("_s20sado", st_global("S_ADO"))
// The payload directory first on the ado-path, in the compound-quoted form
// $S_ADO writes a directory in (LOC-11).
local here20 "`c(pwd)'"
quietly cd "`c(tmpdir)'"
capture erase "s20_sent"
mata: st_global("S_ADO", char(96) + char(34) + st_local("s20dir") + char(34) + char(39) + ";" + st_global("S_ADO"))
capture noisily _dash_find_render
local s20frc = _rc
local s20fn `"`r(fn)'"'
capture noisily dash serve, port(5099) timeout(1) nobrowser
local s20rc = _rc
mata: st_global("S_ADO", st_local("_s20sado"))
capture confirm file "s20_sent"
local s20ran = (_rc == 0)
capture erase "s20_sent"
quietly cd "`here20'"
display as text "  SRV-20 locator rc `s20frc', serve rc `s20rc', payload ran `s20ran'"
assert `s20frc' == 0
assert strpos(`"`s20fn'"', "s20") > 0
assert `s20rc' == 0
assert `s20ran' == 0
global SRV20_OUT ""
global SRV20_NRUN ""
python:
import json as _s20_json
import os as _s20_os
from sfi import Macro as _s20_M
with open(_s20_M.getGlobal("SRV20_REC"), encoding="utf-8") as _s20_fh:
    _s20_runs = [_s20_json.loads(_l) for _l in _s20_fh if _l.strip()]
_s20_M.setGlobal("SRV20_NRUN", str(len(_s20_runs)))
_s20_out = ""
if _s20_runs:
    _a = _s20_runs[0][1:]
    _s20_out = _a[_a.index("--output") + 1] if "--output" in _a else ""
_s20_M.setGlobal("SRV20_OUT", _s20_out)
end
display as text "  SRV-20 stub runs: ${SRV20_NRUN}; app path handed over: [${SRV20_OUT}]"
// The stub ran exactly once -- so the payload path reached Python as the
// string runpy executed, not as code -- and was handed a real .py path
// (a session tempfile), not the payload.
assert "${SRV20_NRUN}" == "1"
assert `"${SRV20_OUT}"' != ""
mata: st_local("_s20outok", strofreal(strpos(st_global("SRV20_OUT"), "s20_sent") == 0))
assert `_s20outok' == 1
capture erase "$SRV20_REC"
capture erase `"`s20dir'/dash_render.py"'
capture erase `"`s20dir'/argv.jsonl"'
capture rmdir `"`s20dir'"'
macro drop SRV20_*
dash clear
display "SRV-20 PASS: dash serve hands the renderer path to Python as data; a quote-and-code path runs nothing"

// ================================================================
// SRV-19 -- dash serve writes its app to a tempfile of this session
// ================================================================
// BUGS.md BUG-47: dash serve wrote every app to one fixed name,
// dash_serve_app.py, so two sessions serving at once overwrote each other's
// file.  test_server.py read _dash_serve's text for `tempfile ...
// serve_app'; this runs dash serve.  The launch is the renderer's, so the
// locator is stubbed -- as LOC-09 does -- to hand dash serve a renderer that
// records the arguments it was run with and returns instead of serving.
// The app file it was handed must be a tempfile of THIS session: in the
// temporary directory and named with the session's own tempfile prefix,
// which is what keeps two sessions' files apart.  (Not "two runs, two
// names": a session reuses a tempfile's name once the file is released,
// and one session's runs cannot overlap -- dash serve blocks.)
// Last in the script: the stub replaces the real locator for good.
// The stand-in and its record are named from a tempfile too, so two
// sessions running this script at once cannot write into each other's.
tempfile s19base
local s19fake "`s19base'.py"
global SRV19_FAKE "`s19fake'"
global SRV19_BASE "`s19base'"
global SRV19_REC  "`s19base'.argv"
capture erase "$SRV19_REC"
tempname s19fh
quietly file open `s19fh' using "`s19fake'", write replace text
file write `s19fh' "import json, os, sys" _n
file write `s19fh' `"_p = os.path.splitext(os.path.abspath(__file__))[0] + ".argv""' _n
file write `s19fh' `"with open(_p, "a", encoding="utf-8") as _fh:"' _n
file write `s19fh' "    _fh.write(json.dumps(sys.argv) + chr(10))" _n
file close `s19fh'
capture program drop _dash_find_render
program define _dash_find_render, rclass
    return local fn "$SRV19_FAKE"
end
dash clear
qui sysuse auto, clear
dash scatter mpg weight, name(sv17)
capture noisily dash serve, port(5099) timeout(1) nobrowser
assert _rc == 0
python:
import json as _s19_json
import os as _s19_os
from sfi import Macro as _s19_M
with open(_s19_M.getGlobal("SRV19_REC"), encoding="utf-8") as _s19_fh:
    _s19_runs = [_s19_json.loads(_s19_l) for _s19_l in _s19_fh if _s19_l.strip()]
_s19_outs = [_s19_os.path.normpath(_s19_r[_s19_r.index("--output") + 1]) for _s19_r in _s19_runs]
_s19_base = _s19_os.path.normpath(_s19_M.getGlobal("SRV19_BASE"))
_s19_pref = _s19_base.rstrip("0123456789")
_s19_ok = (len(_s19_outs) == 1 and len(_s19_pref) < len(_s19_base)
           and _s19_outs[0].startswith(_s19_pref) and _s19_outs[0] != _s19_base)
_s19_M.setGlobal("SRV19_OUT", _s19_outs[0] if _s19_outs else "")
_s19_M.setGlobal("SRV19_PREF", _s19_pref)
_s19_M.setGlobal("SRV19_OK", "1" if _s19_ok else "0")
end
display as text "  SRV-19 app file: [$SRV19_OUT]  session prefix: [$SRV19_PREF]"
assert "$SRV19_OK" == "1"
capture erase "$SRV19_REC"
capture erase "`s19fake'"
capture program drop _dash_find_render
dash clear
macro drop SRV19_*
display "SRV-19 PASS: dash serve writes its app to a tempfile of this session"

capture program drop _srv_try

display ""
display "All dash serve option tests PASSED."
