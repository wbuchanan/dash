*! test_e2e_kpi.cscript
*! End-to-end certification script for KPI card output.
*!
*! Tests: P2-76 through P2-77
*!
*! Usage:  do test/test_e2e_kpi.cscript
*!
*! Requires: dash_setup completed, Python + bokeh installed
*! Version: 1.0.0  25mar2026

cscript "dash KPI card E2E" adodir ".."
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}

// ----------------------------------------------------------------
// Setup
// ----------------------------------------------------------------

// Do NOT probe with `capture python: pass'.  Measured: that returns a
// nonzero rc inside the runner even though the very same session renders
// Bokeh output through `dash build' moments later, and it made 9 of the 14
// scripts -- every end-to-end one -- skip while the suite reported ALL TESTS
// PASSED.  Nothing decides whether Python is there (WP-36 plat:PT-1, M8):
// with no Python set, Stata finds one on the first python: line.

qui sysuse auto, clear

do "../dash_parse.mata"
do "../dash.ado"

// cert_file_has: asks whether a generated file contains a string, from Mata,
// where the file's text is a value rather than macro text.  The scans below
// used to expand each line of Bokeh output into a Stata expression, which a
// quote character in that line ends.  The runner runs each script from this
// directory, so this path is bare while the dash sources above are "../".
do "cert_helpers.do"

// The KPI cards of a saved dashboard, read back from its Bokeh document.
//
// A text search of the page cannot tell a card from the library: the page
// inlines the whole of BokehJS.  Measured 24sep2026 on each case's scatter
// built with NO KPI: 21.3 occurs 14 times, "div" in quotes 8 times and kpi
// once on P2-76's, and 74 occurs 107 times on P2-77b's -- every value and
// structure check below used to pass without a card.  So the document is
// decoded the way BokehJS decodes it -- the page's one application/json
// block, unescaped (its unescape undoes these six entities) and parsed --
// and handed to Document.from_json, as test_conformance.cscript C-03 does.
// A card is the markup _dash_kpi_card_html writes into a Div:
//     <div class="db-kpi-card" ...><div ...>title</div>
//     <div id="kpi_val_<name>" ...>value</div>...
// _e2k_read(path, p) sets, for the caller's asserts:
//     `p'_ndiv        the Div models in the document
//     `p'_n           the value divs, id="kpi_val_<name>" -- one per card
//     `p'_names       their names, sorted
//     `p'_val_<name>  the text of a card's value div
//     `p'_ncard       the value divs inside a db-kpi-card, after its title
//     `p'_title_<name> that card's title text
//     `p'_styled      1 when every such card's Div carries a stylesheet with
//                     the .db-kpi-card rule the scheme styles it by, else 0
python:
import html as _e2k_html
import json as _e2k_json
import re as _e2k_re
from sfi import Macro as _e2k_Macro
from bokeh.document import Document as _e2k_Document
from bokeh.models import Div as _e2k_Div


def _e2k_unescape(text):
    ents = {"amp": "&", "lt": "<", "gt": ">", "quot": chr(34),
            "#x27": chr(39), "#x60": chr(96)}
    return _e2k_re.sub(r"&(amp|lt|gt|quot|#x27|#x60);",
                       lambda m: ents[m.group(1)], text)


def _e2k_read(path, p):
    with open(path, encoding="utf-8") as fh:
        page = fh.read()
    blocks = _e2k_re.findall(
        r'<script type="application/json" id="[^"]+">\s*(.*?)\s*</script>',
        page, _e2k_re.S)
    docs = [d for b in blocks
            for d in _e2k_json.loads(_e2k_unescape(b)).values()]
    if len(docs) != 1:
        raise RuntimeError("%s holds %d Bokeh documents" % (path, len(docs)))
    divs = [m for m in _e2k_Document.from_json(docs[0]).models
            if isinstance(m, _e2k_Div)]
    names, ncard, styled = [], 0, 1
    for d in divs:
        for nm, val in _e2k_re.findall(
                r'<div id="kpi_val_([^"]*)"[^>]*>([^<]*)</div>', d.text):
            names.append(nm)
            _e2k_Macro.setLocal(p + "_val_" + nm, _e2k_html.unescape(val))
        for title, nm in _e2k_re.findall(
                r'<div class="db-kpi-card"[^>]*><div[^>]*>([^<]*)</div>'
                r'<div id="kpi_val_([^"]*)"', d.text):
            ncard += 1
            _e2k_Macro.setLocal(p + "_title_" + nm, _e2k_html.unescape(title))
            if not any(".db-kpi-card" in (getattr(s, "css", "") or "")
                       for s in d.stylesheets):
                styled = 0
    _e2k_Macro.setLocal(p + "_ndiv", str(len(divs)))
    _e2k_Macro.setLocal(p + "_n", str(len(names)))
    _e2k_Macro.setLocal(p + "_names", " ".join(sorted(names)))
    _e2k_Macro.setLocal(p + "_ncard", str(ncard))
    _e2k_Macro.setLocal(p + "_styled", str(styled if ncard else 0))
end

// ================================================================
// P2-76 — dash kpi mean(mpg) + build → HTML contains formatted mean value
// ================================================================
dash clear

// Compute expected mean for assertion
quietly summarize mpg
local expected_mean : display %9.1f r(mean)
local expected_mean = strtrim("`expected_mean'")

dash scatter mpg weight, name(s1) title("MPG vs Weight")
dash kpi mean(mpg), title("Avg MPG") name(k1) fmt(%9.1f) update(filter)

tempfile outfile
local outpath = "`outfile'.html"
capture erase "`outpath'"

dash build, saving("`outpath'") replace

capture confirm file "`outpath'"
assert _rc == 0

// Search for the formatted mean in the HTML.
//
// This replaces a loop that read the file line by line and tested each line
// with strpos(`"`ln'"', "`expected_mean'").  A line of Bokeh's document JSON
// is dense with " characters, and a sequence such as "' inside one
// terminates the compound quotes the macro is expanded in; the rest of the
// line is then parsed as Stata code, and measured, this search died with
// r(132), "too few quotes".  cert_file_has runs the search in Mata, where
// the line is a value and can never be parsed.
//
// The needle is this script's own macro, not file content, so expanding it
// is safe.  It must stay strtrim()'d (above): %9.1f right-aligns in nine
// columns, so Stata's own : display gives "     21.3", while the card holds
// the value stripped, and the leading blanks would never be found.
//
// That search found 21.3 in the inlined BokehJS on any page (14 times on
// this scatter without a KPI, measured 24sep2026), so it is replaced by the
// card itself: the page holds one card, k1's, and its value div reads the
// mean exactly as Stata's %9.1f writes it.
python: _e2k_read(r"`outpath'", "k76")
assert `k76_n' == 1
assert "`k76_names'" == "k1"
assert "`k76_val_k1'" == "`expected_mean'"
display "P2-76 PASS: formatted mean value '`expected_mean'' found in HTML"

// ================================================================
// P2-77 — KPI card structure (title + styled div) present in output HTML
// ================================================================
// The same substitution as above; the loop expanded each line of the file
// into two strpos() expressions, and a quote character in the data ends
// them.  The title search stays case-sensitive and the Div search stays
// case-insensitive, exactly as the loop had them.
//
// Title "Avg MPG" should appear in the KPI card Div.
cert_file_has "`outpath'", needle("Avg MPG")
local found_title = r(found)
assert `found_title' == 1
// The Div half was "div" in quotes OR kpi, lower-cased.  Measured 24sep2026
// on this scatter built with no KPI, the first occurs 8 times and the second
// once, all in the inlined BokehJS, so the OR held on any page.  The card's
// structure is read from the document instead (_e2k_read, above): the page
// holds one Div model, the card; its markup is the db-kpi-card box with the
// title "Avg MPG" above k1's value; and the Div carries the scheme's
// .db-kpi-card rule as a stylesheet -- a Bokeh 3 Div renders in a shadow
// root, so that rule is what styles it.
assert `k76_ndiv' == 1
assert `k76_ncard' == 1
assert "`k76_title_k1'" == "Avg MPG"
assert `k76_styled' == 1
display "P2-77 PASS: KPI card title and Div structure found in HTML"

// ----------------------------------------------------------------
// Additional: verify KPI card with count statistic
// ----------------------------------------------------------------
dash clear

quietly count
local n_obs = r(N)
local expected_count : display %9.0fc `n_obs'
local expected_count = strtrim("`expected_count'")

dash scatter mpg weight, name(s1) title("Scatter")
dash kpi count(mpg), title("Sample Size") name(k2) fmt(%9.0fc) update(both)

tempfile outfile2
local outpath2 = "`outfile2'.html"
dash build, saving("`outpath2'") replace

// The same substitution.  As with the mean, the needle is this script's own
// macro and is strtrim()'d (above) because %9.0fc right-aligns in nine
// columns while the card holds the value stripped.  cert_file_has exits 603
// if the file cannot be opened, so a dashboard that was never written is
// reported as an unreadable file rather than as a value that is absent from
// it -- this second build has no confirm file of its own.
//
// 74 occurs 107 times on this scatter built with no KPI (measured
// 24sep2026: 102 in the inlined BokehJS, 5 in the document), so that search
// could not fail; the card is read back instead, and its value div must
// read the count as %9.0fc writes it.  The open() in _e2k_read stops the script on a
// page that was never written, as cert_file_has did.
python: _e2k_read(r"`outpath2'", "k77")
assert `k77_n' == 1
assert "`k77_names'" == "k2"
assert "`k77_val_k2'" == "`expected_count'"
display "P2-77b PASS: count KPI value '`expected_count'' found in HTML"

// ----------------------------------------------------------------
// P2-78 — a by() graph named after an update() mode does not split a card
// ----------------------------------------------------------------
// Measured 23sep2026: with a by() graph named filter, dash build drew the
// default KPI (update filter) as one card per panel, kpi_val_k1__by__0 and
// kpi_val_k1__by__1 -- the saved renderer read the mode as a graph's name
// -- where the served app drew one card.  A KPI is one card in both modes.
dash clear
dash scatter mpg weight, by(foreign) name(filter)
dash kpi mean(mpg), title("K1") name(k1)
tempfile p278
local p278f = "`p278'.html"
capture noisily dash build, saving("`p278f'") replace nobrowser
assert _rc == 0
cert_file_has "`p278f'", needle("kpi_val_k1__by__")
assert r(found) == 0
cert_file_has "`p278f'", needle("kpi_val_k1")
assert r(found) == 1
// Those two cannot see a split under any other name: nothing writes
// kpi_val_k1__by__ now (card ids come only from _dash_kpi_card_html, as
// kpi_val_<name>), and kpi_val_k1 is also the start of kpi_val_k1_0.  The
// cards are counted instead: this page holds exactly one, k1's -- and, the
// control, the same page with a second KPI holds two, so the count is of
// cards and not a constant.
python: _e2k_read(r"`p278f'", "k78")
assert `k78_n' == 1
assert "`k78_names'" == "k1"
dash kpi mean(price), title("K2") name(k2)
capture noisily dash build, saving("`p278f'") replace nobrowser
assert _rc == 0
python: _e2k_read(r"`p278f'", "k78b")
assert `k78b_n' == 2
assert "`k78b_names'" == "k1 k2"
display "P2-78 PASS: a by() graph named filter leaves the default KPI one card"

// ----------------------------------------------------------------
// Cleanup
// ----------------------------------------------------------------
dash clear

display ""
display "All KPI card E2E tests PASSED."
