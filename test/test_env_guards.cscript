// The asserts, in id order.
foreach pkg in numpy pandas bokeh {
    assert `e31i_`pkg'' == 198 & `e31r_`pkg'' == 198 & `e31b_`pkg'' == 198 & `e31s_`pkg'' == 198 & `e31v_`pkg'' == 198
    assert `e31w_`pkg'' == 0
    assert "`e31s1_`pkg''" == " 1 1 1 1 0 0"
    assert "`e31c_`pkg''" == "1"
}
display "ENV-31 PASS: with numpy, pandas or bokeh missing every route stops r(198) naming the package, the Python and dash_setup, writing and announcing nothing"
assert `e32rc' == 198 & `e32w' == 0
assert "`e32s'" == " 1 1 1 0"
assert "`e32c'" == "1"
display "ENV-32 PASS: a package that will not import is refused r(198) with its reason and dash_setup"
assert `e33rc' == 198 & `e33w' == 0
assert "`e33s'" == " 1 1 1"
assert "`e33c'" == "1"
display "ENV-33 PASS: a Python below the floor is refused r(198) naming its version, the floor and dash_setup"
assert `e34rc' == 198 & `e34w' == 0
assert "`e34s'" == " 1 1 1 1 0"
assert "`e34c'" == "1"
display "ENV-34 PASS: a Python that cannot start is refused r(198) naming the Python, the processor rule and dash_setup"
assert `e35rc' == 0 & `e35j' == 1
assert "`e35h'" == "1"
assert "`e35c'" == "1"
display "ENV-35 PASS: a first start that fails is tried once more and the command runs"
assert `e36rc' == 0 & `e36rc2' == 0 & `e36w' == 1
assert `e36note' == 1 & `e36n' == 1 & `e36n2' == 0
assert "`e36c'" == "1"
display "ENV-36 PASS: numpy below dash_setup's minimum is one note per load and the page is written"
assert `e37had' == 1 & `e37rc' == 0 & `e37said' == 1 & `e37left' == 0
assert "`e37c'" == "1"
display "ENV-37 PASS: dash clear prunes dash's temporary files with numpy missing"
assert `e38rc' == 198
assert "`e38s'" == " 1 1 0"
assert "`e38c'" == "1"
display "ENV-38 PASS: dash serve's child lacking pandas ends r(198) with its one line naming dash_setup"
assert `e39rc' == 0 & `e39said' == 1
assert "`e39c'" == "1"
display "ENV-39 PASS: dash clear clears the registry when no Python can start"
capture dash clear

display ""
display "All environment guard tests PASSED."
