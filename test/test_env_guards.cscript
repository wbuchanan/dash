// ENV-36: numpy below dash_setup's minimum is a note, once per load.
tempfile e36
capture erase "`e36'a.html"
capture erase "`e36'b.html"
python: dep_block.fake_package_version("numpy", "2.1.3")
python: dep_block.forget_renderer()
local lg36 "`c(tmpdir)'dash_env36.log"
local lg36b "`c(tmpdir)'dash_env36b.log"
