capture confirm file "`e36'a.html"
local e36w = (_rc == 0)
cert_log_has "`lg36'", needle("numpy 2.1.3")
local e36n = r(count)
cert_log_has "`lg36'", needle("(note:")
local e36note = r(found)
cert_log_has "`lg36b'", needle("numpy 2.1.3")
local e36n2 = r(count)
capture erase "`lg36'"
capture erase "`lg36b'"
capture erase "`e36'a.html"
capture erase "`e36'b.html"
display "ENV-36 measured: rc `e36rc' `e36rc2' written `e36w' note `e36note' first `e36n' second `e36n2' clean `e36c'"

