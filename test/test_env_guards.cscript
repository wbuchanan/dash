capture erase "`lg36b'"
quietly log using "`lg36'", replace text name(e36l)
capture noisily dash scatter mpg weight, saving("`e36'a.html") replace
local e36rc = _rc
quietly log close e36l
quietly log using "`lg36b'", replace text name(e36l)
capture noisily dash scatter mpg weight, saving("`e36'b.html") replace
local e36rc2 = _rc
quietly log close e36l
python: dep_block.stata_restored()
