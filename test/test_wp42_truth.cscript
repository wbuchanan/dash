    python: import __main__ as _q4217_m; _q4217_m._q4217_keys("`dir'/s.json", "`dir'/d.json", "`dir'/a.py")
end

* ==== S01 CV-17: a colorlist() of quoted RGB colours ====
local only : env WP42_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w42_run' {
