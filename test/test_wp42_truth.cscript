    _q4217_reg "`q17d'" scatter mpg weight, colorvar(price) colorlevels(8) colorlist(`cl') scheme(s2color) name(q17a)
    _w42_expect Q4201-6 "(`: word count `tw'' == 8)" `"twoway draws `tw'"'
    _w42_expect Q4201-6 `"(`"${q4217_s}"' == `"`tw'"')"' `"saved ${q4217_s}, twoway `tw'"'
    _w42_expect Q4201-6 `"(`"${q4217_v}"' == `"`tw'"')"' `"served ${q4217_v}, twoway `tw'"'
    _w42_done Q4201-6 "colorlist() of quoted RGB colours: twoway's eight colours, saved and served"

    foreach f in q17a.svg s.json d.json a.py try.log {
