// S03 helpers (WP-42 42-03).  _q4203_bykeys: the contour keys a
// registered by() graph draws, saved and served -- into globals
// q4203_p<s|v> (keys on the panels) and q4203_c<s|v> (keys in the by()
// colour-key cell, dash_by_clegend); _q4203_svgkey: how many unrotated
// texts twoway draws right of or below its panels, into q4203_tw.
python:
def _q4203_models(sp, dp, app):
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_q4203_app")
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_q4203_app.py",
                     "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    return list(r._last_layout_root.references()), list(doc.models)


def _q4203_bykeys(sp, dp, app):
    from sfi import Macro
    from bokeh.models import Plot
    a, b = _q4203_models(sp, dp, app)
    for models, sfx in ((a, "s"), (b, "v")):
        on_panel, in_cell = 0, 0
        for m in models:
            if not isinstance(m, Plot):
                continue
            # WP-42 CV-3: the by() key is a key cell (dash_key_cell).
            if "dash_key_cell" in (m.tags or []):
                if getattr(m, "name", None) == "dash_by_clegend":
                    in_cell += 1
                continue
            for side in (m.right, m.left, m.above, m.below, m.center):
                for k in side:
                    if type(k).__name__ != "ContourColorBar":
                        continue
                    if getattr(m, "name", None) == "dash_by_clegend":
                        in_cell += 1
                    else:
                        on_panel += 1
        Macro.setGlobal("q4203_p" + sfx, str(on_panel))
        Macro.setGlobal("q4203_c" + sfx, str(in_cell))


def _q4203_svgkey(path):
    from sfi import Macro
    from svg_truth import svg_document
    d = svg_document(path)
    pans = [g for g in d["regions"] if g.get("fill") == "#ffffff"]
    right = max(g["right"] for g in pans)
    bottom = max(g["bottom"] for g in pans)
    n = 0
    for t in d["texts"]:
        if t["rotate"] or t["x"] is None:
            continue
        try:
            float(str(t["text"]).replace(",", ""))
        except ValueError:
            continue
        if t["x"] > right + 1 or t["y"] > bottom + 200:
            n += 1
    Macro.setGlobal("q4203_tw", str(n))
end

capture program drop _q4203_reg
program define _q4203_reg
    // _q4203_reg <dir> <dash command...>: register one graph, write its
    // spec and data, and read the contour keys both modes draw.
    version 19
    gettoken dir 0 : 0
    dash clear
    quietly dash `0'
    _dash_serve_spec, specpath("`dir'/s.json") datapath("`dir'/d.json")
    python: import __main__ as _q4203_m; _q4203_m._q4203_bykeys("`dir'/s.json", "`dir'/d.json", "`dir'/a.py")
end

// S03 CV-3 helpers: _q4203_cells: the colour key both modes draw for a
// registered graph -- the key cell's axis labels and texts top first into
// q4203_ks/q4203_kv, the Legend or ColorBar keys drawn on a figure into
// q4203_os/q4203_ov; _q4203_svgk: twoway's unrotated texts right of the
// plot region, top first, into q4203_kt.
python:
def _q4203_cells(sp, dp, app):
    from sfi import Macro
    from bokeh.models import ColorBar, Legend, Plot
    import dash_render as dr
    a, b = _q4203_models(sp, dp, app)
    for models, sfx in ((a, "s"), (b, "v")):
        texts, other, ztitle, boxes, zml, ticks, axl = [], 0, "", 0, [], "", ""
        for m in models:
            if not isinstance(m, Plot):
                continue
            if "dash_key_cell" in (m.tags or []):
                # The z title (a Label up the axis) and title(, box)'s box
                # (WP-42 LT-12).
                for side in (m.right, m.left):
                    for lab in side:
                        if type(lab).__name__ == "Label" and \
                                (lab.name or "") == "dash_key_title":
                            ztitle = str(lab.text)
                boxes += sum(1 for r in m.renderers
                             if (r.name or "") == "dash_key_title_box")
                # The axis line drawn (WP-42 LT-22: C_plain's vline).
                _ax = m._dash_keycell["axis"]
                axl = "1" if (_ax.axis_line_color is not None
                              and (_ax.axis_line_alpha or 0) > 0
                              and _ax.visible) else "0"
                # The major and minor ticks on the axis (WP-42 AX-12).
                tk = m._dash_keycell["ticker"]
                lo_, hi_ = m._dash_keycell["axis"].bounds
                ticks = "%d %d" % (
                    sum(1 for t in tk.ticks or [] if lo_ <= t <= hi_),
                    sum(1 for t in tk.minor_ticks or [] if lo_ <= t <= hi_))
                ax = (list(m.right) + list(m.left))[0]
                ovr = dict(ax.major_label_overrides or {})
                up = m.y_range.start <= m.y_range.end
                # The axis labels and clegend()'s texts (Text glyphs named
                # dash_key_*, WP-42 CV-15) at their z, top first.
                # ztick()'s ticks carry no label (WP-42 AX-12).
                rows = [(float(k), str(v)) for k, v in ovr.items()
                        if str(v) != ""]
                for r in m.renderers:
                    if (r.name or "") == "dash_key_zmlabel":
                        # zmlabel()'s texts stand upright (WP-42 AX-12).
                        zml += [str(t) for _y, t in sorted(
                            zip(r.data_source.data["y"],
                                r.data_source.data["text"]), reverse=up)]
                        continue
                    if (r.name or "").startswith("dash_key_") and \
                            "text" in r.data_source.data:
                        d = r.data_source.data
                        rows.append((float(d["y"][0]), str(d["text"][0])))
                rows.sort(key=lambda t: t[0], reverse=up)
                texts += [t for _y, t in rows]
                continue
            for side in (m.right, m.left, m.above, m.below, m.center):
                for k in side:
                    bar = isinstance(k, ColorBar) and k.name != "dash_by_label_box"
                    leg = isinstance(k, Legend) and k.name == dr._COLORVAR_LEGEND_NAME
                    if bar or leg:
                        other += 1
        Macro.setGlobal("q4203_k" + sfx, " ".join(texts))
        Macro.setGlobal("q4203_o" + sfx, str(other))
        Macro.setGlobal("q4203_z" + sfx, ztitle)
        Macro.setGlobal("q4203_b" + sfx, str(boxes))
        Macro.setGlobal("q4203_m" + sfx, " ".join(zml))
        Macro.setGlobal("q4203_t" + sfx, ticks)
        Macro.setGlobal("q4203_a" + sfx, axl)


def _q4203_svgk(path):
    from sfi import Macro
    from svg_truth import svg_document
    d = svg_document(path)
    r = d["plotregion"]["right"]
    ts = sorted((t for t in d["texts"] if t["x"] is not None
                 and t["x"] > r + 1 and not t["rotate"]),
                key=lambda t: t["y"])
    Macro.setGlobal("q4203_kt", " ".join(t["text"] for t in ts))
    # The rotated z title right of the plot region, and the filled boxes
    # there (WP-42 LT-12).
    zt = [t["text"] for t in d["texts"] if t["x"] is not None
          and t["x"] > r + 1 and t["rotate"]]
    Macro.setGlobal("q4203_ktz", zt[0] if zt else "")
    Macro.setGlobal("q4203_ktb", str(sum(1 for g in d["regions"]
                                         if g.get("left", 0) > r + 1)))
    # The key's ticks right of the plot region, major and minor by their
    # length, and its upright minor labels (WP-42 AX-12).
    hl = [h for h in d["hlines"] if h["x1"] is not None and h["x1"] > r + 1
          and h.get("stroke") not in (None, "none")]
    longest = max((abs(h["x2"] - h["x1"]) for h in hl), default=0)
    maj = sum(1 for h in hl if abs(h["x2"] - h["x1"]) > 0.75 * longest)
    Macro.setGlobal("q4203_ktt", "%d %d" % (maj, len(hl) - maj))
    zm = sorted((t for t in d["texts"] if t["x"] is not None
                 and t["x"] > r + 1 and t["rotate"] and t["size"] < 80),
                key=lambda t: t["y"])
    Macro.setGlobal("q4203_ktm", " ".join(t["text"] for t in zm))
    # An axis line right of the plot region (WP-42 LT-22).
    vl = [v for v in d["vlines"] if v["x1"] is not None and v["x1"] > r + 1]
    Macro.setGlobal("q4203_kta", "1" if vl else "0")
end

capture program drop _q4203_kreg
program define _q4203_kreg
    // _q4203_kreg <dir> <dash command...>: register one graph and read
    // the colour key both modes draw.
    version 19
    gettoken dir 0 : 0
    dash clear
    quietly dash `0'
    _dash_serve_spec, specpath("`dir'/s.json") datapath("`dir'/d.json")
    python: import __main__ as _q4203_m; _q4203_m._q4203_cells("`dir'/s.json", "`dir'/d.json", "`dir'/a.py")
end

* ==== S03 CV-3: twoway's axis-style colour key ====
local only : env WP42_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w42_run' {
    display as text "S03 start " c(current_date) " " c(current_time)
    local q03d "`w42_work'/s03k"
    capture mkdir "`q03d'"
    capture graph drop _all
    sysuse auto, clear

    // ------------------------------------------------------------
    // Q4203-1: the colour key's texts, top first, are twoway's -- the
    // highest level at the top, a discrete key labelled at its axis's
    // ticks, a binned or stepped key at its cuts, no missing entry --
    // and no figure draws a Legend or ColorBar key, saved and served.
    // ------------------------------------------------------------
    local k 0
    foreach o in "colorvar(rep78) colordiscrete" "colorvar(rep78) colorlevels(3)" "colorvar(rep78) colorcuts(2 4)" "colorvar(price)" {
        local ++k
        quietly twoway scatter mpg weight, `o' name(q03k`k', replace)
        capture erase "`q03d'/q03k`k'.svg"
        cert_svg_export, name(q03k`k') file("`q03d'/q03k`k'.svg")
        python: import __main__ as _q4203_m; _q4203_m._q4203_svgk("`q03d'/q03k`k'.svg")
        local tw "${q4203_kt}"
        _q4203_kreg "`q03d'" scatter mpg weight, `o' name(q03k`k')
        _w42_expect Q4203-1 `"("${q4203_ks}" == "`tw'" & "${q4203_kv}" == "`tw'")"' `"`o': twoway `tw', saved ${q4203_ks}, served ${q4203_kv}"'
        _w42_expect Q4203-1 "(${q4203_os} == 0 & ${q4203_ov} == 0)" "`o': Legend or ColorBar keys saved ${q4203_os}, served ${q4203_ov}"
    }
    _w42_done Q4203-1 "the colour key is twoway's axis-style key, saved and served"

    foreach f in q03k1.svg q03k2.svg q03k3.svg q03k4.svg s.json d.json a.py {
        capture erase "`q03d'/`f'"
    }
    capture rmdir "`q03d'"
    macro drop q4203_ks q4203_kv q4203_os q4203_ov q4203_kt
    capture graph drop _all
    dash clear
    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

* ==== S03 CV-15: zlabel() and zscale() drawn on the colour key ====
local only : env WP42_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w42_run' {
    display as text "S03 start " c(current_date) " " c(current_time)
