* ==== S04 CV-5: legend() leaves the colour key ====
local only : env WP42_ONLY
if inlist("`only'", "", "S04") & `: list posof "S04" in w42_run' {
    display as text "S04 start " c(current_date) " " c(current_time)
    local q04d "`w42_work'/s04l"
    capture mkdir "`q04d'"
    capture graph drop _all
    sysuse auto, clear

    // ------------------------------------------------------------
    // Q4204-2: legend(off), legend(rows(1)) and legend(size(huge)) leave
    // the colour key -- twoway's key texts keep their size and places,
    // and dash's key (the coloruseplegend Legend, the key cell) keeps its
    // text size and grid, saved and served.
    // ------------------------------------------------------------
    local pl "colorvar(rep78) colordiscrete coloruseplegend"
    local k 0
    local sc "scatter mpg weight,"
    local p2 "(scatter mpg weight, `pl') (lfit mpg weight),"
    local c2 "(scatter mpg weight, colorvar(price)) (lfit mpg weight),"
    local k 0
    foreach c in "`sc' `pl'|`sc' `pl' legend(off)" "`sc' `pl'|`sc' `pl' legend(rows(1))" "`p2'|`p2' legend(size(huge))" "`c2'|`c2' legend(size(huge))" "`c2'|`c2' legend(rows(1))" {
        local ++k
        gettoken base opt : c, parse("|")
        local opt = substr(`"`opt'"', 2, .)
        foreach w in base opt {
            local cmd `"``w'' name(q04l`k'`w', replace)"'
            quietly twoway `cmd'
            capture erase "`q04d'/q04l`k'`w'.svg"
            cert_svg_export, name(q04l`k'`w') file("`q04d'/q04l`k'`w'.svg")
            python: import __main__ as _q4204_m; _q4204_m._q4204_svg("`q04d'/q04l`k'`w'.svg")
            local tw_`w' "${q4204_kt}|${q4204_kz}"
            _q4204_reg "`q04d'" `cmd'
            local zs_`w' "${q4204_zs}"
            local zv_`w' "${q4204_zv}"
            capture erase "`q04d'/q04l`k'`w'.svg"
        }
        _w42_expect Q4204-2 `"("`tw_base'" == "`tw_opt'")"' `"`opt': twoway's key `tw_opt', without it `tw_base'"'
        _w42_expect Q4204-2 `"("`zs_base'" == "`zs_opt'" & "`zv_base'" == "`zv_opt'" & "`zs_opt'" != "")"' `"`opt': saved `zs_opt' (was `zs_base'), served `zv_opt' (was `zv_base')"'
    }
    _w42_done Q4204-2 "legend() leaves the colour key, saved and served"

    foreach f in s.json d.json a.py {
        capture erase "`q04d'/`f'"
    }
    capture rmdir "`q04d'"
    macro drop q4204_*
    capture graph drop _all
    dash clear
    display as text "S04 end " c(current_date) " " c(current_time)
}
* ==== end S04 ====

* ==== S04 CV-11: colorkeysreverse and a one-value key ====
local only : env WP42_ONLY
if inlist("`only'", "", "S04") & `: list posof "S04" in w42_run' {
    display as text "S04 start " c(current_date) " " c(current_time)
    local q04d "`w42_work'/s04r"
    capture mkdir "`q04d'"
    capture graph drop _all
    sysuse auto, clear

    // ------------------------------------------------------------
    // Q4204-3: colorkeysreverse reverses a discrete key's colours, its
    // labels where they are; under coloruseplegend it changes nothing;
    // colorlevels() over one value keys the value with no swatch --
    // twoway's texts and swatch colours, saved and served.
    // ------------------------------------------------------------
    local k 0
    foreach c in "scatter mpg weight, colorvar(rep78) colordiscrete colorkeysreverse" "scatter mpg weight, colorvar(rep78) colordiscrete coloruseplegend colorkeysreverse" "scatter mpg weight if rep78 == 3, colorvar(rep78) colorlevels(3)" "scatter mpg weight if rep78 == 3, colorvar(rep78) colorlevels(3) colorvarminmax" {
        local ++k
        quietly twoway `c' name(q04r`k', replace)
        capture erase "`q04d'/q04r`k'.svg"
        cert_svg_export, name(q04r`k') file("`q04d'/q04r`k'.svg")
        python: import __main__ as _q4204_m; _q4204_m._q4204_svg("`q04d'/q04r`k'.svg")
        local tw "${q4204_kt}"
        local twf "${q4204_kf}"
        _q4204_reg "`q04d'" `c' name(q04r`k')
        if `k' == 2 {
            // The plot legend's texts and swatches, as without the option.
            _w42_expect Q4204-3 `"("${q4204_ts}" == "`tw'" & "${q4204_tv}" == "`tw'")"' `"`c': twoway `tw', saved ${q4204_ts}, served ${q4204_tv}"'
        }
        else {
            // The key cell: its swatches' colours top first, and its
            // labels (one value written once) twoway's.
            local tw1 : list uniq tw
            python: import __main__ as _q4204_m; _q4204_m._q4204_near("`twf'")
            _w42_expect Q4204-3 "(${q4204_ok} == 1)" `"`c': swatches twoway `twf', saved ${q4204_cs}, served ${q4204_cv}"'
            python: import __main__ as _q4204_m; _q4204_m._q4204_cell_texts("`q04d'/s.json", "`q04d'/d.json", "`q04d'/a.py")
            _w42_expect Q4204-3 `"("${q4204_ls}" == "`tw1'" & "${q4204_lv}" == "`tw1'")"' `"`c': labels twoway `tw1', saved ${q4204_ls}, served ${q4204_lv}"'
        }
        capture erase "`q04d'/q04r`k'.svg"
    }
    _w42_done Q4204-3 "colorkeysreverse and a one-value key are twoway's, saved and served"

    foreach f in s.json d.json a.py {
        capture erase "`q04d'/`f'"
    }
    capture rmdir "`q04d'"
    macro drop q4204_*
    capture graph drop _all
    dash clear
    display as text "S04 end " c(current_date) " " c(current_time)
}
* ==== end S04 ====

// S05 helpers (WP-42 42-05).  _q4205_row: a probe of
// fixtures/colorvar_refusal_truth.json into locals q05_rc, q05_n,
// q05_l1 .. (its printed lines, trimmed), q05_cmd (twoway's command) and
// q05_kt (its key's numbers, sorted); _q4205_keys: the key numbers both
// modes of a registered dash graph draw, into globals q4205_s and
// q4205_v (S01's _q4201_docs builds them); _q4205_list: the probe ids
// starting with a prefix, into local q05_ids.
python:
def _q4205_rows():
    import json
    with open("fixtures/colorvar_refusal_truth.json", encoding="utf-8") as fh:
        return json.load(fh)["probes"]


def _q4205_nums(texts):
    import re
    out = set()
    for t in texts:
        t = str(t).strip()
        if re.fullmatch(r"-?[\d,]*\.?\d+", t):
            out.add(float(t.replace(",", "")))
    return " ".join("%g" % v for v in sorted(out))


def _q4205_row(key):
    from sfi import Macro
    p = _q4205_rows()[key]
    Macro.setLocal("q05_rc", str(p["rc"]))
    Macro.setLocal("q05_n", str(len(p["lines"])))
    for i, ln in enumerate(p["lines"], 1):
        Macro.setLocal("q05_l%d" % i, ln.strip())
    Macro.setLocal("q05_cmd", p["command"])
    Macro.setLocal("q05_kt", _q4205_nums(p.get("key_texts", [])))


def _q4205_list(prefix):
    from sfi import Macro
    Macro.setLocal("q05_ids", " ".join(sorted(k for k in _q4205_rows()
                                              if k.startswith(prefix))))


def _q4205_judge(key, path, rc):
    from sfi import Macro
    r = _q4205_rows()[key]
    lines = []
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for ln in fh:
                if ln.strip() and not ln.startswith((". ", "> ")):
                    lines.append(ln.strip())
    except OSError:
        pass
    want = [ln.strip() for ln in r["lines"]]
    ok = int(rc) == r["rc"] and (r["rc"] == 0 or lines == want)
    Macro.setLocal("q05_ok", "1" if ok else "0")
    for name, text in (("q05_got", " / ".join(lines)),
                       ("q05_want", " / ".join(want))):
        for ch, to in (('"', "'"), ("\x60", "'"), ("$", "S")):
            text = text.replace(ch, to)
        Macro.setLocal(name, text[:200])


def _q4205_keys(sp, dp, app):
    from sfi import Macro
    a, b = _q4201_docs(sp, dp, app)
    for figs, sfx in ((a, "s"), (b, "v")):
        texts = []
        # Flipped (WP-42 CV-3): the key was a Legend or a ColorBar on the
        # figure; twoway draws swatches beside a z axis, the figure's key
        # cell (in a served document's Plots, itself), labelled on its axis.
        seen = set()
        for f in figs:
            own = "dash_key_cell" in (getattr(f, "tags", None) or [])
            cells = [f] if own else [getattr(f, "_dash_key_cell", None)]
            for c in cells:
                if c is None or id(c) in seen:
                    continue
                seen.add(id(c))
                over = dict(c._dash_keycell["axis"].major_label_overrides or {})
                texts += [str(over[k]) for k in sorted(over, key=float)
                          if str(over[k]) != ""]
        for f in figs:
            for side in (f.right, f.left, f.above, f.below, f.center):
                for m in side:
                    tn = type(m).__name__
                    if tn == "Legend" and m.visible is not False:
                        for it in m.items:
                            lab = it.label
                            v = getattr(lab, "value", None)
                            if v is None and isinstance(lab, dict):
                                v = lab.get("value")
                            texts.append(str(lab if v is None else v))
                    elif tn == "ColorBar" and m.name != "dash_by_label_box":
                        over = dict(m.major_label_overrides or {})
                        for t in list(getattr(m.ticker, "ticks", []) or []):
                            texts.append(str(over.get(t, over.get(str(t), t))))
        Macro.setGlobal("q4205_" + sfx, _q4205_nums(texts))
end

capture program drop _q4205_reg
program define _q4205_reg
    // _q4205_reg <dir> <dash command...>: register one graph, write its
    // spec and data, and read the key numbers both modes draw.
    version 19
    gettoken dir 0 : 0
    dash clear
    quietly dash `0'
    _dash_serve_spec, specpath("`dir'/s.json") datapath("`dir'/d.json")
    python: import __main__ as _q4205_m; _q4205_m._q4205_keys("`dir'/s.json", "`dir'/d.json", "`dir'/a.py")
end

* ==== S05 CV-2: colordiscrete colorlevels cuts ====
local only : env WP42_ONLY
if inlist("`only'", "", "S05") & `: list posof "S05" in w42_run' {
    display as text "S05 start " c(current_date) " " c(current_time)
    local q05d "`w42_work'/s05c"
    capture mkdir "`q05d'"
    capture graph drop _all

    // ------------------------------------------------------------
    // Q4205-1: colordiscrete colorlevels(4) on z = 0, 10, ..., 100 keys
    // twoway's levels (fixture rows L2, L3: twoway's own key texts),
    // saved and served.
    // ------------------------------------------------------------
    clear
    quietly set obs 11
    gen z = (_n - 1) * 10
    gen y = _n
    gen x = _n
    foreach k in L2 L3 {
        python: import __main__ as _q4205_m; _q4205_m._q4205_row("`k'")
        local q05_dcmd : subinstr local q05_cmd "twoway " ""
        _q4205_reg "`q05d'" `q05_dcmd' name(q05g)
        foreach m in s v {
            _w42_expect Q4205-1 `"("${q4205_`m'}" == "`q05_kt'")"' `"`k' `m': dash keys ${q4205_`m'}, twoway `q05_kt'"'
        }
    }
    _w42_done Q4205-1 "colordiscrete colorlevels(4) keys twoway's levels, saved and served"

    foreach f in s.json d.json a.py {
        capture erase "`q05d'/`f'"
    }
    capture rmdir "`q05d'"
    macro drop q4205_*
    capture graph drop _all
    dash clear
    display as text "S05 end " c(current_date) " " c(current_time)
}
* ==== end S05 ====

* ==== S05 CV-10: malformed colour-key options ====
local only : env WP42_ONLY
if inlist("`only'", "", "S05") & `: list posof "S05" in w42_run' {
    display as text "S05 start " c(current_date) " " c(current_time)
    capture graph drop _all

    // ------------------------------------------------------------
    // Q4205-3: every clegend(), plegend(), zlabel() and zscale() probe
    // of the fixture (K_*) run through dash: dash's rc is twoway's, and
    // a refusal prints twoway's line and nothing else; the words twoway
    // draws are drawn.  Every expectation is the fixture's.
    // ------------------------------------------------------------
    python: import __main__ as _q4205_m; _q4205_m._q4205_list("K_")
    local q05_klf "`w42_work'/q4205k.log"
    foreach k of local q05_ids {
        python: import __main__ as _q4205_m; _q4205_m._q4205_row("`k'")
        local q05_dcmd : subinstr local q05_cmd "twoway " ""
        quietly sysuse auto, clear
        set linesize 255
        capture dash clear
        capture log close q4205l
        capture erase "`q05_klf'"
        quietly log using "`q05_klf'", text replace name(q4205l)
        capture noisily dash `q05_dcmd'
        local q05_rcd = _rc
        quietly log close q4205l
        set linesize 80
        python: import __main__ as _q4205_m; _q4205_m._q4205_judge("`k'", r"`q05_klf'", "`q05_rcd'")
        _w42_expect Q4205-3 "(`q05_ok' == 1)" `"`k': rc `q05_rcd' (twoway `q05_rc'); dash said: `macval(q05_got)'; want: `macval(q05_want)'"'
    }
    _w42_done Q4205-3 "clegend(), plegend(), zlabel() and zscale() words read as twoway reads them"
    capture erase "`q05_klf'"
    capture graph drop _all
    dash clear
    display as text "S05 end " c(current_date) " " c(current_time)
}
* ==== end S05 ====

* ==== append new blocks above this line ====

// ----------------------------------------------------------------
// Summary (test_wp29_truth.cscript's shape)
// ----------------------------------------------------------------
capture graph drop _all
capture dash clear
capture rmdir "`w42_work'"
local nfail    = ${w42_nfail}
local faillist "${w42_faillist}"
local ncase    = ${w42_ncase}
local only : env WP42_ONLY
macro drop w42_nfail w42_faillist w42_bad w42_ncase
display as text ""
display as text "============================================================"
if `ncase' == 0 {
    if `w42_N' > 1 & `"`macval(only)'"' == "" & "`w42_run'" == "" {
        display as text "test_wp42_truth: part `w42_k'/`w42_N' has no block to run"
        display as text "============================================================"
        exit 0
    }
    // A WP42_ONLY that names no block, or only a stub, ran nothing:
    // that is not a pass.
    display as error "  test_wp42_truth: no case ran (WP42_ONLY=`only')"
    display as text "============================================================"
    exit 9
}
else if `nfail' == 0 {
    display as text "  test_wp42_truth: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_wp42_truth: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
