* ==== S03 CV-8a: a by() contour draws twoway's one key ====
local only : env WP42_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w42_run' {
    display as text "S03 start " c(current_date) " " c(current_time)
    local q03d "`w42_work'/s03b"
    capture mkdir "`q03d'"
    capture graph drop _all
    sysuse surface, clear

    // ------------------------------------------------------------
    // Q4203-6: by(date) draws no contour key (twoway: no key number
    // beside or below the panels); by(date, clegend(on)) one key beside
    // them and by(date, clegend(on pos(6))) one below them (twoway: the
    // key's numbers there) -- dash: none on a panel and one in the by()
    // colour-key cell, saved and served.
    // ------------------------------------------------------------
    local k 0
    foreach bo in "date" "date, clegend(on)" "date, clegend(on pos(6))" {
        local ++k
        quietly twoway contour temperature latitude longitude, levels(10) by(`bo') name(q03b`k', replace)
        capture erase "`q03d'/q03b`k'.svg"
        cert_svg_export, name(q03b`k') file("`q03d'/q03b`k'.svg")
        python: import __main__ as _q4203_m; _q4203_m._q4203_svgkey("`q03d'/q03b`k'.svg")
        local tw ${q4203_tw}
        local want = cond(`k' == 1, 0, 1)
        _w42_expect Q4203-6 "(cond(`want', `tw' > 0, `tw' == 0))" "by(`bo'): twoway draws `tw' key numbers"
        _q4203_reg "`q03d'" contour temperature latitude longitude, levels(10) by(`bo') name(q03b`k')
        _w42_expect Q4203-6 "(${q4203_ps} == 0 & ${q4203_pv} == 0)" "by(`bo'): panel keys saved ${q4203_ps}, served ${q4203_pv}"
        _w42_expect Q4203-6 "(${q4203_cs} == `want' & ${q4203_cv} == `want')" "by(`bo'): keys beside the panels saved ${q4203_cs}, served ${q4203_cv}, want `want'"
    }
    _w42_done Q4203-6 "a by() contour draws twoway's one key, saved and served"

    foreach f in q03b1.svg q03b2.svg q03b3.svg s.json d.json a.py {
        capture erase "`q03d'/`f'"
    }
    capture rmdir "`q03d'"
    macro drop q4203_ps q4203_pv q4203_cs q4203_cv q4203_tw
    capture graph drop _all
    dash clear
    display as text "S03 end " c(current_date) " " c(current_time)
}
