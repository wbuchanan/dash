    python: import __main__ as _q4201_m; _q4201_m._q4201_svg("`q17d'/q17a.svg")
    local tw "${q4201_tw}"
    _q4201_try "`lf'" dash scatter mpg weight, colorvar(price) colorlevels(8) colorlist(`cl') name(q17a)
    _w42_expect Q4201-6 "(r(rc) == 0 & r(note) == 0)" "dash rc `r(rc)', note `r(note)'"
    cert_log_has "`lf'", needle("class color")
