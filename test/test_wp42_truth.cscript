        _w42_expect Q4203-3 `"("${q4203_zs}" == "`twz'" & "${q4203_zv}" == "`twz'")"' `"`cmd': z title twoway `twz', saved ${q4203_zs}, served ${q4203_zv}"'
        _w42_expect Q4203-3 "(${q4203_bs} == `twb' & ${q4203_bv} == `twb')" "`cmd': boxes twoway `twb', saved ${q4203_bs}, served ${q4203_bv}"
