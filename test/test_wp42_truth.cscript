*! test_wp42_truth.cscript
*! WP-42's ONE certification script (.ultraplan/sections/index.md PD-6):
*! every comparison with twoway's drawing or with Stata's own values that
*! WP-42's sections need lives here, one block per GAPS4 row (or per
*! harness tool), appended above the "append new blocks above this line"
*! marker in section order.  Refusal, message and return-code checks join
*! the EXISTING script for their area (merge rule R1).
*!
*! Made from test/templates/wp_truth_template.cscript (42 -> the WP's
*! number).  S00 is the scaffold smoke (Q4200-1).  A section appends
*! `* ==== S<MM> <lead id>: <what> ====` ... `* ==== end S<MM> ====` (or
*! `S<MM> tool: <what>` for a section with no item), its helper programs
*! directly above its first header, and writes only inside its own
*! blocks.  Case ids are Q42<MM>-<k> (PD-5).
*!
*! Usage: via run_all_cscripts.do.  One block alone: WP42_ONLY=S<MM> in
*! the driver's environment.  Each block prints "S<MM> start" and "S<MM>
*! end" with the date and time.  The suite runs it in every session;
*! DASH_CERT_SHARD=k/N runs part k of N of the blocks; a part with no
*! block ends 0.

cscript "WP-42 truth: twoway comparisons" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off


do "cert_helpers.do"
quietly do "cert_svg.do"
qui do "../dash_parse.mata"
qui do "../dash.ado"
global dash_nobrowser 1

// ----------------------------------------------------------------
// Tally helpers -- test_wp29_truth.cscript's _w29_expect/_w29_done,
// renamed _w42_ for this script.  A case is any number of
// _w42_expect lines closed by one _w42_done.
// ----------------------------------------------------------------
global w42_nfail    = 0
global w42_faillist ""
global w42_bad      = 0
global w42_ncase    = 0

capture program drop _w42_expect
program define _w42_expect
    version 19
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global w42_bad = 1
    }
end

capture program drop _w42_done
program define _w42_done
    version 19
    args id msg
    if ${w42_bad} {
        global w42_nfail    = ${w42_nfail} + 1
        global w42_faillist "${w42_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global w42_bad   = 0
    global w42_ncase = ${w42_ncase} + 1
end

// A fresh directory for this run's files, never one that already exists:
// a fixed name in a shared temp directory could be planted by another
// account (rule 1), so a name Stata has not handed out before is made and
// the run fails if it cannot be.  Every block writes only under it.
tempfile w42_base
local w42_work "`w42_base'_w42"
capture mkdir "`w42_work'"
if _rc {
    display as error "test_wp42_truth: cannot create the work directory `w42_work' (rc `=_rc')"
    exit 9
}

// ---- parts: begin (WP-42 test performance) ----
// The certification suite runs this script in every one of its sessions
// (its row in run_all_cscripts.do's shard table is "* * *"); with
// DASH_CERT_SHARD=k/N set, the session runs part k of N of the blocks.
// The parts are balanced longest first onto the least loaded part (the
// lowest numbered of equals), by the seconds below -- a block not listed
// counts 1 s (section-01 D-01.f) -- the rule scripts/cert_shards.py uses
// for the scripts.  Unset, or with WP42_ONLY set
// (which keeps its precedence), every block runs.  A block runs when its
// gate finds its id in w42_run.
// Seconds: each block's start/end lines in the WP's last measured
// certification run, rounded up, at least 1; a block not listed
// counts 1 s.
local w42_secs S00 1
local w42_sh : environment DASH_CERT_SHARD
mata: st_local("w42_ok", strofreal(st_local("w42_sh") == "" | ustrregexm(st_local("w42_sh"), "^[1-4]/[1-4]$")))
if !`w42_ok' {
    display as error "test_wp42_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 4"
    exit 198
}
local w42_k 1
local w42_N 1
if "`w42_sh'" != "" {
    local w42_k = real(substr("`w42_sh'", 1, 1))
    local w42_N = real(substr("`w42_sh'", 3, 1))
}
local w42_only : env WP42_ONLY
if `"`macval(w42_only)'"' != "" | `w42_N' == 1 {
    local w42_k 1
    local w42_N 1
}
if `w42_k' > `w42_N' {
    display as error "test_wp42_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 4"
    exit 198
}
capture confirm file "test_wp42_truth.cscript"
if _rc {
    display as error "test_wp42_truth: run it from test/, where it reads its own blocks"
    exit 601
}
capture mata: mata drop _w42_part()
mata:
// The ids of the blocks (their header lines, in file order), and those of
// part k of n: longest first onto the least loaded part.
void _w42_part(string scalar file, string scalar table, real scalar k,
               real scalar n)
{
    string colvector lines, ids
    string rowvector tok
    real colvector sec, o, at
    real rowvector load
    real scalar i, j, p, best
    string scalar run

    lines = cat(file)
    ids = J(0, 1, "")
    for (i = 1; i <= rows(lines); i++) {
        if (ustrregexm(lines[i], "^\* ==== (S[0-9]+) ")) {
            if (!anyof(ids, ustrregexs(1))) ids = ids \ ustrregexs(1)
        }
    }
    sec = J(rows(ids), 1, 1)
    tok = tokens(table)
    for (j = 1; j + 1 <= cols(tok); j = j + 2) {
        for (i = 1; i <= rows(ids); i++) {
            if (ids[i] == tok[j]) sec[i] = strtoreal(tok[j + 1])
        }
    }
    o = order((-sec, (1::rows(ids))), (1, 2))
    load = J(1, n, 0)
    at = J(rows(ids), 1, 0)
    for (i = 1; i <= rows(o); i++) {
        best = 1
        for (p = 2; p <= n; p++) if (load[p] < load[best]) best = p
        load[best] = load[best] + sec[o[i]]
        at[o[i]] = best
    }
    run = ""
    for (i = 1; i <= rows(ids); i++) if (at[i] == k) run = run + " " + ids[i]
    st_local("w42_run", strtrim(run))
}
end
mata: _w42_part("test_wp42_truth.cscript", st_local("w42_secs"), `w42_k', `w42_N')
display as text "test_wp42_truth: part `w42_k'/`w42_N' runs `: word count `w42_run'' blocks: `w42_run'"
// ---- parts: end ----

* ==== S00 scaffold: the helpers load and a twoway SVG is read ====
local only : env WP42_ONLY
if inlist("`only'", "", "S00") & `: list posof "S00" in w42_run' {
    display as text "S00 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4200-1: cert_svg_export and cert_svg_texts on one twoway scatter,
    // and dash's own programs are loaded from this tree.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(w42s01, replace)
    cert_svg_export, name(w42s01) file("`w42_work'/w42s01.svg")
    local s01_rc   = r(rc)
    local s01_file "`r(file)'"
    _w42_expect Q4200-1 "(`s01_rc' == 0)" "cert_svg_export rc `s01_rc'"
    capture confirm file "`s01_file'"
    _w42_expect Q4200-1 "(_rc == 0)" "r(file) `s01_file' does not exist"
    cert_svg_texts, file("`s01_file'")
    local s01_n    = r(n)
    local s01_list "`r(list)'"
    _w42_expect Q4200-1 "(`s01_n' > 0)" "cert_svg_texts found no text elements"
    capture program list _dash_serve
    _w42_expect Q4200-1 "(_rc == 0)" "dash.ado's _dash_serve is not loaded"
    _w42_done Q4200-1 "a twoway SVG was written and read (`s01_n' texts); dash is loaded"

    capture erase "`s01_file'"
    capture erase "`s01_list'"
    capture graph drop w42s01
    display as text "S00 end " c(current_date) " " c(current_time)
}
* ==== end S00 ====

// S01 helpers (WP-42 42-01).  _q4201_draw: the distinct colours a
// registered dash graph's colour layer draws, each row through its mapper,
// saved and served -- into globals q4201_s and q4201_v (sorted hex, space
// separated), and q4201_w<s|v>, the colour bar's thickness in px;
// _q4201_svg: twoway's distinct plot-region marker fills from an SVG, into
// q4201_tw, and the colour key's width over the graph's (q4201_kw).
python:
import os as _q4201_os, sys as _q4201_sys
for _q4201_p in (_q4201_os.path.abspath(".."),
                 _q4201_os.path.abspath(_q4201_os.path.join("..", "scripts"))):
    if _q4201_p not in _q4201_sys.path:
        _q4201_sys.path.insert(0, _q4201_p)


def _q4201_docs(sp, dp, app):
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_q4201_app")
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_q4201_app.py",
                     "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    sv = [m for m in doc.models if type(m).__name__ == "figure"]
    return list(r.figures.values()), sv


def _q4201_colour(m, v):
    if v is None or v != v:
        return str(m.nan_color).lower()
    pal = [str(c).lower()[:7] for c in m.palette]
    lo, hi = float(m.low), float(m.high)
    v = float(v)
    if v < lo:
        return pal[0]
    if v > hi:
        return pal[-1]
    return pal[min(int((v - lo) / (hi - lo) * len(pal)), len(pal) - 1)]


def _q4201_draw(sp, dp, app):
    from sfi import Macro
    a, b = _q4201_docs(sp, dp, app)
    for figs, sfx in ((a, "s"), (b, "v")):
        cols, width = set(), 0
        for f in figs:
            for side in (f.right, f.left, f.above, f.below, f.center):
                for m in side:
                    if type(m).__name__ in ("ColorBar", "ContourColorBar") \
                            and m.name != "dash_by_label_box":
                        width = m.width
            for r in f.renderers:
                g = getattr(r, "glyph", None)
                if str(getattr(r, "name", "") or "").startswith("_clegend_"):
                    continue
                fc = getattr(g, "fill_color", None)
                tr = getattr(fc, "transform", None)
                fld = getattr(fc, "field", None)
                if tr is None or not hasattr(tr, "low") \
                        or fld not in r.data_source.data:
                    continue
                for v in r.data_source.data[fld]:
                    cols.add(_q4201_colour(tr, v))
        Macro.setGlobal("q4201_" + sfx, " ".join(sorted(cols)))
        Macro.setGlobal("q4201_w" + sfx, str(width))


def _q4201_svg(path):
    from sfi import Macro
    from svg_truth import svg_document
    d = svg_document(path)
    pr = d["plotregion"]
    fills = sorted({c["fill"] for c in d["circles"]
                    if c.get("fill") and c["fill"] != "none"
                    and pr["left"] <= c["cx"] <= pr["right"]
                    and pr["top"] <= c["cy"] <= pr["bottom"]})
    Macro.setGlobal("q4201_tw", " ".join(fills))
    ax = [v["x1"] for v in d["vlines"] if v["x1"] > pr["right"]
          and (v.get("stroke") or "") == "#000000"]
    sw = [c["cx"] for c in d["circles"] if c["cx"] > pr["right"]
          and c.get("fill") and c["fill"] != "none"]
    kw = (2 * (min(ax) - sum(sw) / len(sw)) / d["canvas"]["w"]
          if ax and sw else 0)
    Macro.setGlobal("q4201_kw", "%.6f" % kw)
end

capture program drop _q4201_reg
program define _q4201_reg
    // _q4201_reg <dir> <dash command...>: register one graph, write its
    // spec and data, and read what both modes draw.
    version 19
    gettoken dir 0 : 0
    dash clear
    quietly dash `0'
    _dash_serve_spec, specpath("`dir'/s.json") datapath("`dir'/d.json")
    python: import __main__ as _q4201_m; _q4201_m._q4201_draw("`dir'/s.json", "`dir'/d.json", "`dir'/a.py")
end

capture program drop _q4201_try
program define _q4201_try, rclass
    // _q4201_try <log> <command...>: run it in its own log; r(rc), and
    // r(note) 1 when the log holds dash's ignoring note.
    version 19
    gettoken lf 0 : 0
    capture dash clear
    capture log close q4201l
    quietly log using "`lf'", text replace name(q4201l)
    capture noisily `0'
    local rc = _rc
    quietly log close q4201l
    cert_log_has "`lf'", needle("ignoring unsupported")
    return scalar note = r(found)
    return scalar rc = `rc'
end

* ==== S01 CV-8: continuous colorvar binned at the key's ticks ====
local only : env WP42_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w42_run' {
    display as text "S01 start " c(current_date) " " c(current_time)
    local q01d "`w42_work'/s01"
    capture mkdir "`q01d'"
    local lf "`q01d'/try.log"
    capture graph drop _all
    sysuse auto, clear

    // ------------------------------------------------------------
    // Q4201-1: colorvar(price) on a scatter draws twoway's level colours
    // (four, measured live from twoway's SVG), saved and served.
    // ------------------------------------------------------------
    quietly twoway scatter mpg weight, colorvar(price) scheme(s2color) name(q01a, replace)
    capture erase "`q01d'/q01a.svg"
    cert_svg_export, name(q01a) file("`q01d'/q01a.svg")
    python: import __main__ as _q4201_m; _q4201_m._q4201_svg("`q01d'/q01a.svg")
    local tw "${q4201_tw}"
    _q4201_reg "`q01d'" scatter mpg weight, colorvar(price) scheme(s2color) name(q01a)
    _w42_expect Q4201-1 "(`: word count `tw'' == 4)" `"twoway draws `tw'"'
    _w42_expect Q4201-1 `"(`"${q4201_s}"' == `"`tw'"')"' `"saved ${q4201_s}, twoway `tw'"'
    _w42_expect Q4201-1 `"(`"${q4201_v}"' == `"`tw'"')"' `"served ${q4201_v}, twoway `tw'"'
    _w42_done Q4201-1 "colorvar(price): twoway's four level colours, saved and served"

    // ------------------------------------------------------------
    // Q4201-2: the stepped default is drawn with rc 0 and no note.
    // ------------------------------------------------------------
    _q4201_try "`lf'" dash scatter mpg weight, colorvar(price) name(q01b)
    _w42_expect Q4201-2 "(r(rc) == 0 & r(note) == 0)" "dash rc `r(rc)', note `r(note)'"
    _w42_done Q4201-2 "colorvar(price) is drawn with rc 0 and no note"

    // ------------------------------------------------------------
    // Q4201-3: under s1mono the levels start at twoway's #bfbfbf.
    // ------------------------------------------------------------
    quietly twoway scatter mpg weight, colorvar(price) scheme(s1mono) name(q01c, replace)
    capture erase "`q01d'/q01c.svg"
    cert_svg_export, name(q01c) file("`q01d'/q01c.svg")
    python: import __main__ as _q4201_m; _q4201_m._q4201_svg("`q01d'/q01c.svg")
    local tw "${q4201_tw}"
    _q4201_reg "`q01d'" scatter mpg weight, colorvar(price) scheme(s1mono) name(q01c)
    _w42_expect Q4201-3 `"(strpos(`"`tw'"', "#bfbfbf") > 0)"' `"twoway draws `tw'"'
    _w42_expect Q4201-3 `"(`"${q4201_s}"' == `"`tw'"')"' `"saved ${q4201_s}, twoway `tw'"'
    _w42_expect Q4201-3 `"(`"${q4201_v}"' == `"`tw'"')"' `"served ${q4201_v}, twoway `tw'"'
    _w42_done Q4201-3 "scheme(s1mono): twoway's grey levels from #bfbfbf, saved and served"

    foreach f in q01a.svg q01c.svg s.json d.json a.py try.log {
        capture erase "`q01d'/`f'"
    }
    capture rmdir "`q01d'"
    macro drop q4201_s q4201_v q4201_ws q4201_wv q4201_tw q4201_kw
    capture graph drop _all
    dash clear
    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====

* ==== append new blocks above this line ====

// ----------------------------------------------------------------
// Summary (test_wp29_truth.cscript's shape)
// ----------------------------------------------------------------
capture graph drop _all
capture dash clear
capture rmdir "`w42_work'"
local nfail    = ${w42_nfail}
local faillist "${w42_faillist}"
local ncase    = ${w42_ncase}
local only : env WP42_ONLY
macro drop w42_nfail w42_faillist w42_bad w42_ncase
display as text ""
display as text "============================================================"
if `ncase' == 0 {
    if `w42_N' > 1 & `"`macval(only)'"' == "" & "`w42_run'" == "" {
        display as text "test_wp42_truth: part `w42_k'/`w42_N' has no block to run"
        display as text "============================================================"
        exit 0
    }
    // A WP42_ONLY that names no block, or only a stub, ran nothing:
    // that is not a pass.
    display as error "  test_wp42_truth: no case ran (WP42_ONLY=`only')"
    display as text "============================================================"
    exit 9
}
else if `nfail' == 0 {
    display as text "  test_wp42_truth: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_wp42_truth: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
