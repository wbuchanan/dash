// S03 AX-12 helper: _q4203_keynums: the colour key's tick texts both
// modes draw for a registered graph, into q4203_ks and q4203_kv.
// Flipped (WP-42 AX-12): it read a ColorBar's ticks, which CV-3's key cell
// replaced, so every key read empty and the plurals compared "" with "";
// it reads the key cell as S03 CV-3's _q4203_cells does (its ticks, minor
// labels and the rest too).
python:
def _q4203_keynums(sp, dp, app):
    _q4203_cells(sp, dp, app)
end

capture program drop _q4203_kreg
program define _q4203_kreg, rclass
    // _q4203_kreg <dir> <dash command...>: register one graph (its rc in
    // r(rc)) and, when it registers, read the key both modes draw.
    version 19
    gettoken dir 0 : 0
    dash clear
    capture quietly dash `0'
    return scalar rc = _rc
    global q4203_ks ""
    global q4203_kv ""
    if _rc == 0 {
        _dash_serve_spec, specpath("`dir'/s.json") datapath("`dir'/d.json")
        python: import __main__ as _q4203_m; _q4203_m._q4203_keynums("`dir'/s.json", "`dir'/d.json", "`dir'/a.py")
    }
end

* ==== S03 AX-12: the z tick family's plurals ====
local only : env WP42_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w42_run' {
    display as text "S03 start " c(current_date) " " c(current_time)
    local q03d "`w42_work'/s03z"
    capture mkdir "`q03d'"
    capture graph drop _all
    sysuse auto, clear

    // ------------------------------------------------------------
    // Q4203-4: zlabels(), zticks(), zmlabels() and zmticks() are twoway's
    // spellings of zlabel(), ztick(), zmlabel() and zmtick() (twoway: rc 0
    // for each, live): dash takes each as its singular -- the same rc, 0,
    // and the same key, saved and served.
    // ------------------------------------------------------------
    foreach pr in "zlabel|4000 8000 12000" "ztick|5000 10000" "zmlabel|7500" "zmtick|2500(5000)17500" {
        gettoken w v : pr, parse("|")
        local v = substr("`v'", 2, .)
        capture noisily twoway scatter mpg weight, colorvar(price) `w's(`v') nodraw
        _w42_expect Q4203-4 "(_rc == 0)" "twoway `w's(`v'): rc `=_rc'"
        _q4203_kreg "`q03d'" scatter mpg weight, colorvar(price) `w'(`v') name(q03z)
        local rc1 = r(rc)
        local s1 "${q4203_ks}"
        local v1 "${q4203_kv}"
        _q4203_kreg "`q03d'" scatter mpg weight, colorvar(price) `w's(`v') name(q03z)
        _w42_expect Q4203-4 "(r(rc) == 0 & `rc1' == 0)" "dash `w's(`v'): rc `=r(rc)', `w'(): rc `rc1'"
        _w42_expect Q4203-4 `"("${q4203_ks}" == "`s1'" & "${q4203_kv}" == "`v1'")"' "`w's(): saved ${q4203_ks} / `s1', served ${q4203_kv} / `v1'"
        _w42_expect Q4203-4 `"("`s1'" != "" & "`v1'" != "")"' "`w'(): the key's labels read empty, saved `s1', served `v1'"
    }
    // ztick(), zmlabel() and zmtick() drawn (colorvar_key_truth.json Z1b,
    // Z2, Z3): the key's major and minor ticks, its labels top first and
    // its upright minor labels are twoway's, saved and served.
    local k 0
    foreach o in "ztick(2500 7500)" "zmlabel(7500)" "zmtick(2500(5000)17500)" {
        local ++k
        quietly twoway scatter mpg weight, colorvar(price) `o' name(q03y`k', replace)
        capture erase "`q03d'/q03y`k'.svg"
        cert_svg_export, name(q03y`k') file("`q03d'/q03y`k'.svg")
        python: import __main__ as _q4203_m; _q4203_m._q4203_svgk("`q03d'/q03y`k'.svg")
        local tw "${q4203_kt}"
        local twt "${q4203_ktt}"
        local twm "${q4203_ktm}"
        _q4203_kreg "`q03d'" scatter mpg weight, colorvar(price) `o' name(q03y`k')
        _w42_expect Q4203-4 `"("${q4203_ks}" == "`tw'" & "${q4203_kv}" == "`tw'")"' `"`o': labels twoway `tw', saved ${q4203_ks}, served ${q4203_kv}"'
        _w42_expect Q4203-4 `"("${q4203_ts}" == "`twt'" & "${q4203_tv}" == "`twt'")"' `"`o': ticks twoway `twt', saved ${q4203_ts}, served ${q4203_tv}"'
        _w42_expect Q4203-4 `"("${q4203_ms}" == "`twm'" & "${q4203_mv}" == "`twm'")"' `"`o': minor labels twoway `twm', saved ${q4203_ms}, served ${q4203_mv}"'
    }
    _w42_done Q4203-4 "the z tick family's plurals are their singulars, and ztick(), zmlabel() and zmtick() are drawn, saved and served"

    foreach f in s.json d.json a.py q03y1.svg q03y2.svg q03y3.svg {
        capture erase "`q03d'/`f'"
    }
    capture rmdir "`q03d'"
    macro drop q4203_ks q4203_kv q4203_kt q4203_ktt q4203_ktm q4203_ts q4203_tv q4203_ms q4203_mv
    capture graph drop _all
    dash clear
    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

// S04 helpers (WP-42 42-04).  _q4204_keys: the colour keys both modes
// draw for a registered graph (S03's _q4203_models builds them) -- the
// coloruseplegend Legend's texts top first into q4204_t<s|v>, its title
// into q4204_h<s|v>, its swatches' glyph kinds into q4204_g<s|v>; each
// colour key's text size and grid (a Legend's size, orientation, rows
// and columns, a key cell's label size) into q4204_z<s|v>; the key cell's
// swatch colours top first into q4204_c<s|v>.  _q4204_svg: twoway's
// texts right of the plot region top first into q4204_kt, and their sizes
// into q4204_kz.
python:
def _q4204_keys(sp, dp, app):
    from sfi import Macro
    from bokeh.models import Legend, Plot
    import dash_render as dr
    a, b = _q4203_models(sp, dp, app)
    for models, sfx in ((a, "s"), (b, "v")):
        texts, title, kinds, style, cols = [], "", [], [], []
        for m in models:
            if isinstance(m, Legend) and m.name == dr._COLORVAR_LEGEND_NAME \
                    and m.items and m.visible is not False:
                for it in m.items:
                    lab = it.label
                    v = getattr(lab, "value", None)
                    if v is None and isinstance(lab, dict):
                        v = lab.get("value")
                    texts.append(str(lab if v is None else v))
                    kinds.append(type(it.renderers[0].glyph).__name__)
                title = str(m.title or "")
                style.append("%s/%s/%s/%s" % (m.label_text_font_size,
                                              m.orientation, m.nrows,
                                              m.ncols))
            if isinstance(m, Plot) and "dash_key_cell" in (m.tags or []):
                ax = m._dash_keycell["axis"]
                style.append(str(ax.major_label_text_font_size))
                up = m.y_range.start <= m.y_range.end
                # The swatches' source (colour_bins.KeyView's reading):
                # each swatch's place on the axis and its colour.
                d = m._dash_keycell["src"].data
                at = d.get("y" if m._dash_keycell["vert"] else "x") or []
                cols += [str(c) for _y, c in sorted(
                    zip(at, d.get("c") or []), key=lambda t: t[0],
                    reverse=up)]
        Macro.setGlobal("q4204_t" + sfx, " ".join(texts))
        Macro.setGlobal("q4204_h" + sfx, title)
        Macro.setGlobal("q4204_g" + sfx, " ".join(sorted(set(kinds))))
        Macro.setGlobal("q4204_z" + sfx, " ".join(style))
        Macro.setGlobal("q4204_c" + sfx, " ".join(c.lower() for c in cols))


def _q4204_svg(path):
    from sfi import Macro
    from svg_truth import svg_document
    d = svg_document(path)
    r = d["plotregion"]["right"]
    ts = sorted((t for t in d["texts"] if t["x"] is not None
                 and t["x"] > r + 1 and not t["rotate"]),
                key=lambda t: (t["y"], t["x"]))
    Macro.setGlobal("q4204_kt", " ".join(t["text"] for t in ts))
    Macro.setGlobal("q4204_kz", " ".join("%g" % t["size"] for t in ts))
    # The key's filled swatches right of the plot region, top first.
    sw = sorted((c for c in d["circles"] if c["cx"] is not None
                 and c["cx"] > r + 1 and c["fill"] not in (None, "none")),
                key=lambda c: c["cy"])
    Macro.setGlobal("q4204_kf", " ".join(c["fill"] for c in sw))

def _q4204_near(want):
    """q4204_ok 1 when both modes' key cell colours (q4204_cs, q4204_cv)
    are twoway's *want*, top first, to 1/255 a channel (D-17a)."""
    from sfi import Macro

    def rgb(h):
        h = h.lstrip("#")
        return [int(h[i:i + 2], 16) for i in (0, 2, 4)]

    def near(a, b):
        return len(a) == len(b) and all(
            max(abs(x - y) for x, y in zip(rgb(p), rgb(q))) <= 1
            for p, q in zip(a, b))
    w = want.split()
    ok = all(near(Macro.getGlobal(k).split(), w)
             for k in ("q4204_cs", "q4204_cv"))
    Macro.setGlobal("q4204_ok", "1" if ok else "0")


def _q4204_cell_texts(sp, dp, app):
    """The key cell's labels, unique, top first, into q4204_l<s|v>."""
    from sfi import Macro
    from bokeh.models import Plot
    a, b = _q4203_models(sp, dp, app)
    for models, sfx in ((a, "s"), (b, "v")):
        out = []
        for m in models:
            if isinstance(m, Plot) and "dash_key_cell" in (m.tags or []):
                ovr = dict(m._dash_keycell["axis"].major_label_overrides
                           or {})
                up = m.y_range.start <= m.y_range.end
                for _k, v in sorted(ovr.items(), key=lambda t: float(t[0]),
                                    reverse=up):
                    if str(v) != "" and str(v) not in out:
                        out.append(str(v))
        Macro.setGlobal("q4204_l" + sfx, " ".join(out))
end

capture program drop _q4204_reg
program define _q4204_reg
    // _q4204_reg <dir> <dash command...>: register one graph and read the
    // colour keys both modes draw.
    version 19
    gettoken dir 0 : 0
    dash clear
    quietly dash `0'
    _dash_serve_spec, specpath("`dir'/s.json") datapath("`dir'/d.json")
    python: import __main__ as _q4204_m; _q4204_m._q4204_keys("`dir'/s.json", "`dir'/d.json", "`dir'/a.py")
end

* ==== S04 CV-4: the coloruseplegend key ====
local only : env WP42_ONLY
if inlist("`only'", "", "S04") & `: list posof "S04" in w42_run' {
    display as text "S04 start " c(current_date) " " c(current_time)
    local q04d "`w42_work'/s04p"
    capture mkdir "`q04d'"
    capture graph drop _all
    sysuse auto, clear

    // ------------------------------------------------------------
    // Q4204-1: under coloruseplegend the key's texts, top first, are
    // twoway's -- the highest level first, then Other (or
    // colorotherlabel()), the levels in the variable's format, not its
    // value labels -- untitled, with marker swatches under colorkeysrange
    // too, saved and served.
    // ------------------------------------------------------------
    local k 0
    foreach o in "colorvar(rep78) colordiscrete coloruseplegend" "colorvar(foreign) colordiscrete coloruseplegend" `"colorvar(rep78) colordiscrete coloruseplegend colorotherlabel("rest")"' "colorvar(rep78) colordiscrete coloruseplegend colorkeysrange" {
        local ++k
        quietly twoway scatter mpg weight, `o' name(q04p`k', replace)
        capture erase "`q04d'/q04p`k'.svg"
        cert_svg_export, name(q04p`k') file("`q04d'/q04p`k'.svg")
        python: import __main__ as _q4204_m; _q4204_m._q4204_svg("`q04d'/q04p`k'.svg")
        local tw "${q4204_kt}"
        _q4204_reg "`q04d'" scatter mpg weight, `o' name(q04p`k')
        _w42_expect Q4204-1 `"("${q4204_ts}" == "`tw'" & "${q4204_tv}" == "`tw'")"' `"`o': twoway `tw', saved ${q4204_ts}, served ${q4204_tv}"'
        _w42_expect Q4204-1 `"("${q4204_hs}" == "" & "${q4204_hv}" == "")"' `"`o': titled saved ${q4204_hs}, served ${q4204_hv}"'
        _w42_expect Q4204-1 `"("${q4204_gs}" == "Scatter" & "${q4204_gv}" == "Scatter")"' `"`o': swatches saved ${q4204_gs}, served ${q4204_gv}"'
    }
    _w42_done Q4204-1 "the coloruseplegend key is twoway's, saved and served"

    foreach f in q04p1.svg q04p2.svg q04p3.svg q04p4.svg s.json d.json a.py {
        capture erase "`q04d'/`f'"
    }
    capture rmdir "`q04d'"
