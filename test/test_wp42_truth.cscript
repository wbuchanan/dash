    local k 0
    foreach o in "colorvar(rep78) colordiscrete zlabel(1 3 5)" "colorvar(rep78) colordiscrete zscale(reverse)" "colorvar(foreign) colordiscrete zlabel(, valuelabel)" "colorvar(rep78) colordiscrete clegend(altaxis)" "colorvar(rep78) colordiscrete clegend(region(fcolor(gs14) lcolor(red)))" "colorvar(rep78) colordiscrete clegend(bmargin(large))" "colorvar(rep78) colordiscrete clegend(bmargin(vlarge))" "colorvar(rep78) colordiscrete clegend(bplacement(north))" "colorvar(rep78) colordiscrete clegend(subtitle(S) note(N) caption(C))" {
