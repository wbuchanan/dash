    local k 0
    foreach c in "auto|scatter mpg weight, colorvar(rep78) colordiscrete clegend(title(Z))" "auto|scatter mpg weight, colorvar(rep78) colordiscrete clegend(title(Z, box))" "sandstone|contour depth northing easting, clegend(title(Z, box))" {
        local ++k
