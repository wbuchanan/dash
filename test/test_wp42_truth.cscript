    capture graph drop _all
    sysuse auto, clear
    local cl `""68 1 84" "70 50 126" "54 92 141" "39 127 142" "31 161 135" "74 193 109" "160 218 57" "253 231 37""'

    // ------------------------------------------------------------
    // Q4201-6: the corpus example ex-feature_tour-eaf70b99 keys the eight
    // listed colours twoway draws (measured live from twoway's SVG),
    // saved and served, with rc 0 and no note.
