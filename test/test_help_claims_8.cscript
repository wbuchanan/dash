// ================================================================
// HC8-10 -- an inherited session scheme Stata found: rc 0, no note, drawn
// (WP-30 P1.25b; zzdashtest includes s2color, whose heading is #1e2d53)
// ================================================================
// HC8-09's nodraw twoway graph would add dash's graph export note.
quietly graph drop _all
set scheme zzdashtest
_hc_run "dash scatter mpg weight, name(g1)" `"dash build, saving("`hc_dir'/hc10.html") replace"'
local rc = r(rc)
local lf "`r(logfile)'"
set scheme `hc_scheme0'
_hc_expect "HC8-10" "(`rc' == 0)" "rc `rc'"
_hc_log "HC8-10" "`lf'" "(note:" 0
_hc_log "HC8-10" "`lf'" "is not a known theme or scheme" 0
cert_file_has "`hc_dir'/hc10.html", needle("#1e2d53")
_hc_expect "HC8-10" "(`r(found)' == 1)" "the page does not draw zzdashtest (s2color's heading)"
_hc_done "HC8-10" "an inherited session scheme Stata found: rc 0, no note, drawn"

// ================================================================
// HC8-11 -- a working-directory scheme inside a layer's parentheses and on
//           dash serve's spec path
// ================================================================
foreach nm in mytheme mytheme.scheme {
    _hc_run "" `"dash (scatter mpg weight, scheme(`nm')), saving("`hc_dir'/hc11.html", replace)"'
    local rc = r(rc)
    local lf "`r(logfile)'"
    _hc_expect "HC8-11" "(`rc' == 0)" "paren layer scheme(`nm'): rc `rc'"
    _hc_log "HC8-11" "`lf'" "not a known theme or scheme" 0
    cert_file_has "`hc_dir'/hc11.html", needle("#123456")
    _hc_expect "HC8-11" "(`r(found)' == 1)" "paren layer scheme(`nm'): the page does not carry #123456"
}
tempfile hc_sp hc_dp
foreach nm in mytheme mytheme.scheme {
    capture dash clear
    quietly dash scatter mpg weight, name(g1)
    capture noisily _dash_serve_spec, specpath("`hc_sp'") datapath("`hc_dp'") scheme(`nm')
    local rc = _rc
    _hc_expect "HC8-11" "(`rc' == 0)" "_dash_serve_spec scheme(`nm'): rc `rc'"
    if `rc' == 0 {
        cert_file_has "`hc_sp'", needle(`""scheme": "`nm'""')
        local f1 = r(found)
        cert_file_has "`hc_sp'", needle(`""scheme":"`nm'""')
        _hc_expect "HC8-11" "(`f1' + `r(found)' == 1)" "the served spec does not carry scheme `nm'"
        local hc_app "`hc_dir'/hc11_app.py"
        capture erase "`hc_app'"
        local hc_render "`hc_home'/../dash_render.py"
        // Loaded by path under a name of its own, and registered, as the
        // builder reads its own module's source through sys.modules.
        python: import importlib.util as _hc_iu, sys as _hc_sys, sfi as _hc_sfi
        python: _hc_s = _hc_iu.spec_from_file_location("_hc8_dash_render", _hc_sfi.Macro.getLocal("hc_render")); _hc_m = _hc_iu.module_from_spec(_hc_s); _hc_sys.modules["_hc8_dash_render"] = _hc_m; _hc_s.loader.exec_module(_hc_m)
        python: _hc_m.ServerAppBuilder(_hc_sfi.Macro.getLocal("hc_sp"), _hc_sfi.Macro.getLocal("hc_dp")).build(_hc_sfi.Macro.getLocal("hc_app"))
        cert_file_has "`hc_app'", needle("#123456")
        _hc_expect "HC8-11" "(`r(found)' == 1)" "the served app built from scheme(`nm') does not carry #123456"
    }
}
_hc_done "HC8-11" "bare and file names work in a layer and on dash serve; the app carries the file"

// ================================================================
