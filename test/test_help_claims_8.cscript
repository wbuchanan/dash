*! test_help_claims_8.cscript
*! Certification script: the Stata-side claims of dash.sthlp's last four
*! sections -- Stata scheme support, Unsupported Stata twoway options,
*! Dependencies, Also see -- and of dash_setup.sthlp, each held to dash.ado
*! and, where the help says what twoway does, to twoway itself.
*!
*! ROADMAP WP-23 (AC-23.1: every claim in dash.sthlp is verified by a test or
*! corrected).  The renderer-side claims of the same sections are pinned in
*! test_help_claims_8.py.  Measured 23sep2026 in console Stata 19.5; a twoway
*! claim is measured here, not recalled: `set graphics off', and what twoway
*! DRAWS is read from `graph export' SVG.
*!
*!   HC8-01  the note the help prints for `dash scatter mpg weight,
*!           bmcolor(red) bmlcolor(red)' is, word for word, "dash:
*!           ignoring unsupported option(s): bmcolor() bmlcolor()".
*!           (Flipped, WP-30 P1.14a: pstyle() is drawn now; flipped,
*!           WP-31 D2: t1title() is drawn now.)
*!   HC8-02  every option on the Unsupported list is accepted (rc 0) and
*!           named in the note, the plot-level list in comma mode and the
*!           graph-level list after the paren-mode comma.  Most of them had
*!           never been sent through dash.ado by any script.
*!   HC8-03  twoway's own verdict on each option the rewritten prose names:
*!           title2(), subtitle2(), mlabwidth(), at(), blabel() (twoway
*!           bar), ciopts(), lineopts(), fitopts() (lfitci, kdensity),
*!           link() and filter() are r(198); the rest are accepted; play()
*!           looks for a recording, r(601); and horizontal turns twoway's
*!           bars on their side (a different picture).
*!   HC8-04  twoway: scale() resizes a graph's text on its own, and fxsize()
*!           changes a graph that is not combined -- neither is a graph
*!           combine option only, as the help used to say.
*!   HC8-05  bargap(): twoway bar draws the same picture with it, and dash
*!           names it; xscale(alt) is drawn, not named (flipped, WP-30
*!           P1.18a); xscale(reverse) is honoured, not named.
*!   HC8-06  titl(x) abbreviates title() and is honoured; titel(x) is
*!           refused as twoway refuses it.
*!   HC8-07  the note names option names, never the values supplied.
*!   HC8-08  the scheme() and theme() refusals are r(198) with the help's
*!           exact wording.
*!   HC8-09  twoway draws an unknown scheme as s2color with a note, rc 0;
*!           `set scheme' refuses it, r(111).
*!   HC8-10  an inherited session scheme Stata found: rc 0, no note, drawn
*!           (WP-30 P1.25b).
*!   HC8-11  a working-directory scheme, by bare name and by file name,
*!           inside a layer's parentheses and on dash serve's spec path; the
*!           served app built from that spec carries it.
*!   HC8-12  a scheme name carrying a directory separator is not read: noted
*!           and drawn as s2color on a graph, refused on dash build.
*!   HC8-13  `set scheme NAME' takes scheme-NAME.scheme over NAME.scheme,
*!           and dash's translations beside it change nothing twoway draws.
*!   HC8-14  clwidth(): twoway refuses 10001 and -1 where it draws the line
*!           and takes 10000; dash refuses and takes the same.
*!   HC8-15  twoway joins line points in data order, in x order with sort,
*!           and with sort(varlist) on a variable with ties in an order that
*!           changes from one draw to the next.
*!   HC8-16  dash build takes nobrowser, not nodraw.
*!   HC8-17  jsonio is not required (since 24sep2026 dash writes its data
*!           from Python, test_string_values.cscript): with it off the
*!           ado-path and out of memory dash draws, on the immediate route
*!           and (HC8-17b) on dash build's, and never loads it.
*!   HC8-18  every Also see target resolves to a help file (jsonio is no
*!           longer one: dash does not use it).
*!   HC8-19  dash_setup's summary: an unmet requirement is r(198) and says
*!           dash_setup did not complete; a warning completes; a clean run
*!           says every dependency is satisfied.
*!   HC8-20  twoway joins a line across a missing y by default and breaks
*!           it with cmissing(n).
*!   Q4801-1 .. Q4801-10 (WP-48 48-01) -- the behaviour each corrected help
*!           sentence states: a sub-option note names the token as typed;
*!           the words of no twoway option refused as twoway refuses them.
*!   Q4802-1 .. Q4802-6 (WP-48 48-02, RH-15) -- horizontal and vertical
*!           under recast() judged and drawn as the Orientation and Recast
*!           paragraphs say (the saved figure read through dash_render).
*!   Q4802-7 .. Q4802-9, Q4802-11 (ECO-16) -- the three recipes of Commands
*!           that draw through twoway run as shown; Stata's graph commands
*!           find no dash graph in graph memory.
*!
*! Every command runs with its log captured and read back with Stata's
*! wrapped lines re-joined, as test_custom_scheme.cscript does.  The cases
*! run in a temporary working directory; the session scheme and the
*! ado-path are restored at the end.
*!
*! Usage:  via a wrapper that puts the dash directory on the
*!         ado-path and does `cd <dash>/test', then `do test_help_claims_8.cscript'.

cscript "dash help claims 8" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off
set graphics off


do "cert_helpers.do"
quietly do "cert_svg.do"
qui do "../dash_parse.mata"
qui do "../dash.ado"
qui do "../dash_setup.ado"

global dash_nobrowser 1
sysuse auto, clear

local hc_home    "`c(pwd)'"
local hc_scheme0 "`c(scheme)'"
local hc_dir     "`c(tmpdir)'dash_hc8_wd"
capture mkdir "`hc_dir'"
capture mkdir "`hc_dir'/sub"

capture mata: mata drop _hc_theme()
capture mata: mata drop _hc_scan()
capture mata: mata drop _hc_svg_same()
capture mata: mata drop _hc_svg_path()
capture mata: mata drop _hc_svg_moves()
capture mata: mata drop _hc_ndiff3()
capture mata: mata drop _hc_svg_x_sorted()
capture mata: mata drop _hc_svg_maxfont()
mata:
// Copy `src' to `dst' with `color background' replaced by `bg'.  Returns
// the number of lines replaced.
real scalar _hc_theme(string scalar src, string scalar dst, string scalar bg)
{
    string colvector L
    real scalar      i, fh, n
    L = cat(src)
    n = 0
    for (i = 1; i <= rows(L); i++) {
        if (regexm(L[i], "^color background[ \t]")) {
            L[i] = "color background      " + bg
            n = n + 1
        }
    }
    _unlink(dst)
    fh = fopen(dst, "w")
    for (i = 1; i <= rows(L); i++) fput(fh, L[i])
    fclose(fh)
    return(n)
}

// Re-join "> " continuations, count the logical lines that carry
// `needle' (exact = 1: that ARE `needle'), and hand back the first.
void _hc_scan(string scalar fn, string scalar needle, real scalar exact)
{
    real scalar   fh, n, hit
    string scalar line, full, first
    fh = fopen(fn, "r")
    n = 0
    full = ""
    first = ""
    while ((line = fget(fh)) != J(0, 0, "")) {
        if (substr(line, 1, 2) == "> ") {
            full = full + substr(line, 3, .)
            continue
        }
        hit = exact ? (strtrim(full) == needle) : (strpos(full, needle) > 0)
        if (hit) {
            n = n + 1
            if (first == "") first = full
        }
        full = line
    }
    hit = exact ? (strtrim(full) == needle) : (strpos(full, needle) > 0)
    if (hit) {
        n = n + 1
        if (first == "") first = full
    }
    fclose(fh)
    st_local("_hc_n", strofreal(n))
    st_local("_hc_line", first)
}

// Do two exported SVGs draw the same picture?  The <desc> line names the
// graph and is the one line that must differ.
real scalar _hc_svg_same(string scalar a, string scalar b)
{
    string colvector A, B
    A = cat(a)
    B = cat(b)
    A = select(A, !strmatch(strtrim(A), "<desc>*"))
    B = select(B, !strmatch(strtrim(B), "<desc>*"))
    if (rows(A) != rows(B)) return(0)
    return(all(A :== B))
}

// The longest <path> of an SVG -- the data line of a one-line plot.
string scalar _hc_svg_path(string scalar f)
{
    string colvector L
    string scalar    best
    real scalar      i
    L = cat(f)
    best = ""
    for (i = 1; i <= rows(L); i++) {
        if (strpos(L[i], "<path") & strlen(L[i]) > strlen(best)) best = L[i]
    }
    return(best)
}

// How many subpaths (M commands) the data path of an SVG draws.
real scalar _hc_svg_moves(string scalar f)
{
    string scalar p, d
    p = _hc_svg_path(f)
    if (!regexm(p, "d=" + char(34) + "([^" + char(34) + "]*)" + char(34))) return(0)
    d = regexs(1)
    return(strlen(d) - strlen(subinstr(d, "M", "", .)))
}

// Are the x coordinates of an SVG's data path non-decreasing, point to
// point -- is the line joined in the order of x?
real scalar _hc_svg_x_sorted(string scalar f)
{
    string scalar    p, d
    string rowvector T
    real scalar      i, last, x, k
    p = _hc_svg_path(f)
    if (!regexm(p, "d=" + char(34) + "([^" + char(34) + "]*)" + char(34))) return(-1)
    d = subinstr(subinstr(regexs(1), "M", " "), "L", " ")
    T = tokens(d)
    last = .
    k = 0
    for (i = 1; i <= cols(T); i = i + 2) {
        x = strtoreal(T[i])
        if (k & x < last) return(0)
        last = x
        k = 1
    }
    return(1)
}

// How many of the three pairs among three SVGs' data paths differ.
real scalar _hc_ndiff3(string scalar a, string scalar b, string scalar c)
{
    string scalar pa, pb, pc
    pa = _hc_svg_path(a)
    pb = _hc_svg_path(b)
    pc = _hc_svg_path(c)
    return((pa != pb) + (pb != pc) + (pa != pc))
}

// The largest font-size, in px, any <text> of an SVG is drawn at.
// Superseded at its call sites (HC8-04) by cert_svg_texts's r(maxsize),
// through scripts/svg_truth.py (WP-28 S02); kept for any private use.
real scalar _hc_svg_maxfont(string scalar f)
{
    string colvector L
    real scalar      i, best, v
    L = cat(f)
    best = 0
    for (i = 1; i <= rows(L); i++) {
        if (regexm(L[i], "font-size:([0-9.]+)px")) {
            v = strtoreal(regexs(1))
            if (v > best) best = v
        }
    }
    return(best)
}
end

local hc_src "`hc_home'/../dash-s1rcolor.scheme"
mata: st_local("hc_nsub", strofreal(_hc_theme(st_local("hc_src"), ///
    st_local("hc_dir") + "/mytheme.scheme", "#123456")))
if `hc_nsub' != 1 {
    display as error "SETUP FAIL: expected one `color background' line in `hc_src'"
    exit 9
}
mata: st_local("hc_nsub", strofreal(_hc_theme(st_local("hc_src"), ///
    st_local("hc_dir") + "/sub/mytheme.scheme", "#123456")))
tempname fh
file open `fh' using "`hc_dir'/scheme-zzdashtest.scheme", write text replace
file write `fh' "#include s2color" _n
file close `fh'

cd "`hc_dir'"

// ----------------------------------------------------------------
// Helpers
// ----------------------------------------------------------------
capture program drop _hc_run
program define _hc_run, rclass
    version 16.0
    args prep main
    local logfile "`c(tmpdir)'dash_hc8.log"
    set linesize 255
    capture log close _hclog
    capture erase "`logfile'"
    capture dash clear
    log using "`logfile'", name(_hclog) text replace
    local prc = 0
    if `"`macval(prep)'"' != "" {
        capture noisily `macval(prep)'
        local prc = _rc
    }
    capture noisily `macval(main)'
    local rc = _rc
    log close _hclog
    set linesize 80
    return scalar rc  = `rc'
    return scalar prc = `prc'
    return local logfile "`logfile'"
end

capture program drop _hc_count
program define _hc_count, rclass
    version 16.0
    args logfile needle exact
    if "`exact'" == "" local exact 0
    mata: _hc_scan(st_local("logfile"), st_local("needle"), `exact')
    return scalar n = `_hc_n'
    return local line `"`macval(_hc_line)'"'
end

global hc_nfail    = 0
global hc_faillist ""
global hc_bad      = 0

capture program drop _hc_expect
program define _hc_expect
    version 16.0
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global hc_bad = 1
    }
end

capture program drop _hc_done
program define _hc_done
    version 16.0
    args id msg
    if ${hc_bad} {
        global hc_nfail    = ${hc_nfail} + 1
        global hc_faillist "${hc_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global hc_bad = 0
end

// The log of the case just run must carry `needle' exactly `want' times
// (`want' = -1: at least once).  `exact' = 1 matches whole lines.
capture program drop _hc_log
program define _hc_log
    version 16.0
    args id logfile needle want exact
    _hc_count "`logfile'" `"`macval(needle)'"' `exact'
    local n = r(n)
    local line `"`r(line)'"'
    if `want' == -1 {
        _hc_expect "`id'" "(`n' > 0)" `"the log does not say `macval(needle)'"'
    }
    else {
        _hc_expect "`id'" "(`n' == `want')" `"expected `want' log line(s) with `macval(needle)', found `n': `macval(line)'"'
    }
end

// twoway's rc for one command, graphs dropped either side.
capture program drop _hc_tw
program define _hc_tw, rclass
    version 16.0
    args cmdtext
    capture graph drop _all
    capture `cmdtext'
    local rc = _rc
    capture graph drop _all
    return scalar rc = `rc'
end

// Export one twoway command's picture to `file' (WP-28 S02: through the
// shared cert_svg_export, so every reader downstream is svg_truth.py's).
capture program drop _hc_svg
program define _hc_svg, rclass
    version 16.0
    args cmdtext file
    capture graph drop _all
    capture erase "`file'"
    capture `cmdtext' name(_hcg, replace)
    local rc = _rc
    if `rc' == 0 {
        cert_svg_export, name(_hcg) file("`file'")
        local rc = r(rc)
    }
    capture graph drop _all
    return scalar rc = `rc'
end

generate pos = mod(_n, 12) + 1

// Flipped (WP-47 basic:PT-10): afcolor() and afintensity() are read as
// fcolor() and fintensity() now, as twoway draws them (alias_truth.json
// P1), and not named; bmcolor() and bmlcolor(), back-marker options
// twoway takes on every type and dash names, take their place.
// ================================================================
// HC8-01 -- the note, word for word
// ================================================================
// Flipped (WP-30 P1.14a): pstyle() -> mlpattern(), which is still named.
// Flipped (WP-31 D2): t1title() -> scale(), which is still named;
// t1title() is drawn, as twoway draws it (edge_title_truth.json).
// Flipped (WP-31 D5): scale() -> play(), which is still named; scale() is
// drawn, as twoway draws it (sizing_truth.json scale_15).
// Flipped (WP-31 E2): mlpattern() -> mlabwidth(), which is still named;
// twoway draws a marker's outline solid whatever mlpattern() says
// (symbol_pattern_truth.json mlp.*), so dash takes it silently.
// Flipped (WP-32): mlabwidth() -> bmlinestyle(), which is still named;
// twoway refuses mlabwidth() on every type, r(198), and dash now does
// (noted_option_truth.json).
// Flipped (WP-32): bmlinestyle() play() -> afcolor() afintensity();
// twoway refuses a recording it cannot find, r(601), and dash now does
// (BUGS.md "play() is named in the note, where twoway refuses a recording
// it cannot find or read"), and twoway draws nothing of bmlinestyle().
_hc_run "" `"dash scatter mpg weight, bmcolor(red) bmlcolor(red)"'
local rc = r(rc)
local lf "`r(logfile)'"
_hc_expect "HC8-01" "(`rc' == 0)" "rc `rc'"
_hc_log "HC8-01" "`lf'" "(note:  dash: ignoring unsupported option(s): bmcolor() bmlcolor())" 1 1
_hc_done "HC8-01" "the note is the help's, word for word"

// ================================================================
// HC8-02 -- every option on the list: accepted, and named
// ================================================================
// Plot level, comma mode: the 38 names of _dash_parse_plot_opts' list
// (41 -> 39: WP-30 P1.9a draws horizontal and takes vertical silently,
// and refuses both on a scatter, as twoway does; the HZ cases of
// test_option_validation.cscript check them).
// Flipped (WP-30 P1.9a): horizontal and vertical named in the note was
// wrong, because twoway refuses both on scatter and dash now does
// (horizontal_truth.json accept scatter).
// (42 -> 41: WP-30 P1.8b draws recast(), which would turn this scatter
// into a line; HC8-02r checks it below)
// (45 -> 42: WP-30 P1.8a draws connect() and cmissing(), and a scatter
// given connect() honours sort, given here and not named)
// (47 -> 45: WP-30 P1.24 honours mlabvposition() and mlabtextstyle(),
// given here and not named)
// (flipped, WP-30 P1.14a: 48 -> 44, pstyle() lstyle() mstyle() mlstyle()
// are drawn and left the list; the
// four fitarea options among them, named on scatter: _dash_fold_typed takes
// them off only on the ci types).
// Flipped (WP-32): at(), blabel(), ciopts(), filter(), fitopts(),
// link(), lineopts() and mlabwidth() named in the note was wrong, because
// twoway refuses each on every type, r(198), and dash now does
// (noted_option_truth.json); not given (24 -> 16 named, and after the
// comma filter() and link() likewise, 3 -> 1).
local p_opts `"bmcolor(red) acolor(red) alcolor(red) alpattern(dash) alwidth(thick) b1title(b) b2title(b) bmlinestyle(p3) cmissing(n) colorlist(red blue) coloruseplegend connect(l) dlstyle(p3) dstyle(p3) fxsize(50) fysize(50) l1title(l) l2title(l) mlabtextstyle(heading) mlabvposition(pos) mlpattern(dash) r1title(r) r2title(r) scale(1.5) sort t1title(t) t2title(t) text(20 3000 "hi") xmlabel(2500 3500) xmtick(2500 3500) xoverhangs ymlabel(15 25) ymtick(15 25) yoverhangs"'
// Flipped (WP-30 P1.10): text() named in the note was wrong, because dash
// draws it as twoway does (added_text_truth.json); it is given and not
// named, here and after the comma (39 -> 38 and 23 -> 22).
// Flipped (WP-31 C8b): colorlist() and coloruseplegend named in the note
// was wrong, because dash draws them as twoway does
// (colorvar_options_truth.json); given here and not named.
// Flipped (WP-31 D1): xmlabel(), xmtick(), ymlabel() and ymtick() named
// in the note was wrong, because dash draws minor ticks and labels as
// twoway does (minor_tick_truth.json); given here and not named (38 -> 34
// and 22 -> 18).
// Flipped (WP-31 D2): t1title() .. r2title() named in the note was
// wrong, because dash draws them as twoway does (edge_title_truth.json);
// given here and not named.  title2() and subtitle2() are refused, as
// twoway refuses them (U27-6 .. U27-8), so they are not given (34 -> 24
// and 18 -> 8).
// Flipped (WP-31 D5): fxsize(), fysize(), scale(), xoverhangs and
// yoverhangs named in the note was wrong, because dash draws them as
// twoway does (sizing_truth.json); given here and not named (24 -> 19 and
// 8 -> 3).
// Flipped (WP-31 E2): mlpattern() named in the note was wrong, because
// twoway draws the outline solid whatever it says; given and not named.
// Flipped (WP-32): play() left the list; it is refused as twoway refuses
// a recording it cannot find (U54).
// Flipped (WP-32): acolor() alcolor() alpattern() alwidth() and
// bmlinestyle() on scatter named in the note was wrong, because twoway
// draws nothing different with them there (noted_option_truth.json;
// BUGS.md "dash names options twoway takes and draws nothing of, where
// twoway is silent"): taken in silence, in p_honoured; afcolor(), which
// twoway takes and dash names, is the named one.
local p_names "bmcolor"
// Flipped (WP-30 P1.24): mlabvposition named in the note was wrong,
// because dash draws it per row as twoway does; it is given and not named.
// Flipped (WP-30 P1.24, part 2): mlabtextstyle likewise, drawn in the
// scheme's text box style.
// Flipped (WP-30 P1.8a): connect(), cmissing() and sort named in the note
// was wrong, because a scatter given connect() is drawn as twoway's
// connected plot, its line joined in x order under sort.
local p_honoured "acolor alcolor alpattern alwidth bmlinestyle mlpattern mlabvposition mlabtextstyle cmissing connect sort text colorlist coloruseplegend dstyle dlstyle xmlabel xmtick ymlabel ymtick b1title b2title l1title l2title r1title r2title t1title t2title fxsize fysize scale xoverhangs yoverhangs"
_hc_run "" `"dash scatter mpg weight, mlabel(make) `p_opts' name(hc02p, replace)"'
local rc = r(rc)
local lf "`r(logfile)'"
_hc_expect "HC8-02" "(`rc' == 0)" "plot level: rc `rc'"
_hc_count "`lf'" "dash: ignoring unsupported option(s):"
local note `"`r(line)'"'
// The note is "(note:  dash: ...)" since WP-30 P1.26a: its closing
// parenthesis is not part of the last name.
mata: st_local("note", substr(st_local("note"), 1, 8) == "(note:  " ? substr(st_local("note"), 1, strlen(st_local("note")) - 1) : st_local("note"))
_hc_expect "HC8-02" "(`r(n)' == 1)" "plot level: `r(n)' notes"
local nmiss 0
foreach nm of local p_names {
    if !strpos(`" `macval(note)' "', " `nm'() ") {
        display as error "HC8-02: plot-level `nm'() is not in the note"
        local nmiss = `nmiss' + 1
    }
}
_hc_expect "HC8-02" "(`nmiss' == 0)" "`nmiss' plot-level option(s) not named"
local nnamed 0
foreach nm of local p_honoured {
    if strpos(`" `macval(note)' "', " `nm'() ") {
        display as error "HC8-02: plot-level `nm'() is honoured and named in the note"
        local nnamed = `nnamed' + 1
    }
}
_hc_expect "HC8-02" "(`nnamed' == 0)" "`nnamed' honoured plot-level option(s) named"
// Graph level, after the paren-mode comma: the 22 of _dash_parse_graph_opts.
local g_opts `"b1title(b) b2title(b) fxsize(50) fysize(50) l1title(l) l2title(l) titling ztick(5) zmlabel(5) zmtick(5) r1title(r) r2title(r) scale(1.5) t1title(t) t2title(t) text(20 3000 "hi") xmlabel(2500 3500) xmtick(2500 3500) xoverhangs ymlabel(15 25) ymtick(15 25) yoverhangs"'
// Flipped (WP-31 D1): the four minor options are drawn, given and not
// named (see the plot level).
// Flipped (WP-31 D2): the eight edge titles are drawn, given and not
// named; title2() and subtitle2() refused, not given (see the plot level).
// Flipped (WP-32): play() -> maxaxes(), which twoway takes after the
// comma and dash names; play() is refused (U54).
// Flipped (WP-35 GW-3): maxaxes() -> zmtick(); a valid maxaxes() is
// checked and taken in silence (test_option_validation.cscript Q3506-3).
// Flipped (WP-42 AX-12): zmtick() -> titling; zmtick() is drawn on the
// colour key and taken in silence (test_colorvar_key.py TestZTickFamily).
local g_names "titling"
_hc_run "" `"dash (scatter mpg weight), `g_opts' name(hc02g, replace)"'
local rc = r(rc)
local lf "`r(logfile)'"
_hc_expect "HC8-02" "(`rc' == 0)" "graph level: rc `rc'"
_hc_count "`lf'" "dash: ignoring unsupported option(s):"
local note `"`r(line)'"'
// The note is "(note:  dash: ...)" since WP-30 P1.26a: its closing
// parenthesis is not part of the last name.
mata: st_local("note", substr(st_local("note"), 1, 8) == "(note:  " ? substr(st_local("note"), 1, strlen(st_local("note")) - 1) : st_local("note"))
local nmiss 0
foreach nm of local g_names {
    if !strpos(`" `macval(note)' "', " `nm'() ") & !strpos(`" `macval(note)' "', " `nm' ") {
        display as error "HC8-02: graph-level `nm'() is not in the note"
        local nmiss = `nmiss' + 1
    }
}
_hc_expect "HC8-02" "(`nmiss' == 0)" "`nmiss' graph-level option(s) not named"
mata: st_local("gtext", strofreal(strpos(" " + st_local("note") + " ", " text() ") > 0))
_hc_expect "HC8-02" "(`gtext' == 0)" "graph-level text() is drawn and named in the note"
foreach nm in ztick zmlabel zmtick xmlabel xmtick ymlabel ymtick b1title b2title l1title l2title r1title r2title t1title t2title fxsize fysize scale xoverhangs yoverhangs {
    mata: st_local("gmin", strofreal(strpos(" " + st_local("note") + " ", " `nm'() ") > 0))
    _hc_expect "HC8-02" "(`gmin' == 0)" "graph-level `nm'() is drawn and named in the note"
}
_hc_done "HC8-02" "every named plot-level and graph-level option accepted and named; mlabvposition(), mlabtextstyle(), connect(), cmissing(), sort, text(), the minor ticks and labels and the edge titles honoured"
// HC8-02r (WP-30 P1.8b): recast() is drawn, so a scatter given it names
// nothing.  Flipped (WP-31 C7): on pci it was named, which was wrong
// because twoway draws pci recast(pcarrow) as arrows and dash now does.
_hc_run "" `"dash scatter mpg weight, recast(line) name(hc02r, replace)"'
local rc = r(rc)
_hc_count "`r(logfile)'" "dash: ignoring unsupported option(s):"
_hc_expect "HC8-02r" "(`rc' == 0 & `r(n)' == 0)" "scatter, recast(line): rc `rc', `r(n)' notes"
_hc_run "" `"dash pci 20 3000 30 4000, recast(pcarrow) name(hc02r, replace)"'
local rc = r(rc)
_hc_count "`r(logfile)'" "recast()"
_hc_expect "HC8-02r" "(`rc' == 0 & `r(n)' == 0)" "pci, recast(pcarrow): rc `rc', `r(n)' notes naming recast()"
_hc_done "HC8-02r" "recast() is drawn on scatter and on pci, and named on neither"

// ================================================================
// HC8-03 -- twoway's own verdict on each option the prose names
// ================================================================
local refused `" "scatter mpg weight, title2(t)" "scatter mpg weight, subtitle2(t)" "scatter mpg weight, mlabel(make) mlabwidth(thick)" "bar mpg weight, at(mpg)" "bar mpg weight, blabel(total)" "lfitci mpg weight, ciopts(color(red))" "lfitci mpg weight, lineopts(lcolor(red))" "lfitci mpg weight, fitopts(lcolor(red))" "kdensity mpg, lineopts(lcolor(red))" "scatter mpg weight, link(g1)" "scatter mpg weight, filter(foreign)" "'
foreach c of local refused {
    _hc_tw "twoway `c' nodraw"
    _hc_expect "HC8-03" "(`r(rc)' == 198)" "twoway `c' is r(`r(rc)'), not r(198)"
}
local taken `" "scatter mpg weight, t1title(t) t2title(t) b1title(b) b2title(b) l1title(l) l2title(l) r1title(r) r2title(r)" "scatter mpg weight, xmtick(2500 3500) ymtick(15 25) xmlabel(2500 3500) ymlabel(15 25)" "scatter mpg weight, fxsize(50) fysize(50) scale(1.5)" "scatter mpg weight, pstyle(p3) mstyle(p3) mlstyle(p3) mlpattern(dash)" "line mpg weight, sort lstyle(p3)" "scatter mpg weight, colorvar(rep78) colorlist(red blue green orange navy)" "scatter mpg weight, colorvar(rep78) colordiscrete coloruseplegend" "bar mpg weight, horizontal" "bar mpg weight, vertical" "spike mpg weight, horizontal" "dropline mpg weight, horizontal" "line mpg weight, sort(price)" "scatter mpg weight, mlabel(make) mlabvposition(pos) mlabtextstyle(heading)" "scatter mpg weight, xoverhangs yoverhangs" "scatter mpg weight, connect(l) sort" "line mpg weight, cmissing(n)" "scatter mpg weight, recast(line)" "bar mpg weight, bargap(10)" "'
foreach c of local taken {
    _hc_tw `"twoway `c' nodraw"'
    _hc_expect "HC8-03" "(`r(rc)' == 0)" `"twoway `c' is r(`r(rc)'), not accepted"'
}
_hc_tw `"twoway scatter mpg weight, text(20 3000 "hi") nodraw"'
_hc_expect "HC8-03" "(`r(rc)' == 0)" "twoway text() is r(`r(rc)'), not accepted"
_hc_tw "twoway scatter mpg weight, play(hc8_no_such_recording) nodraw"
_hc_expect "HC8-03" "(`r(rc)' == 601)" "play() is r(`r(rc)'), not r(601) (recording not found)"
// horizontal is drawn, not just accepted: the bars turn on their side.
_hc_svg "twoway bar mpg weight," "`hc_dir'/hc03v.svg"
_hc_svg "twoway bar mpg weight, horizontal" "`hc_dir'/hc03h.svg"
mata: st_local("same", strofreal(_hc_svg_same(st_local("hc_dir") + "/hc03v.svg", st_local("hc_dir") + "/hc03h.svg")))
_hc_expect "HC8-03" "(`same' == 0)" "twoway bar drew the same picture with horizontal"
_hc_done "HC8-03" "11 refusals, 19 acceptances and play()'s r(601) are twoway's"

// ================================================================
