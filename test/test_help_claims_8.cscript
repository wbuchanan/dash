_hc_svg "twoway scatter mpg weight," "`hc_dir'/hc04a.svg"
local r1 = r(rc)
_hc_svg "twoway scatter mpg weight, scale(1.5)" "`hc_dir'/hc04b.svg"
local r2 = r(rc)
_hc_svg "twoway scatter mpg weight, fxsize(50)" "`hc_dir'/hc04c.svg"
local r3 = r(rc)
