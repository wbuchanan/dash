// ================================================================
// HC8-13 -- set scheme's lookup, and twoway beside dash's translations
// ================================================================
file open `fh' using "`hc_dir'/zzq.scheme", write text replace
file write `fh' "#include s2color" _n "color background red" _n
file close `fh'
file open `fh' using "`hc_dir'/scheme-zzq.scheme", write text replace
file write `fh' "#include s2color" _n "color background blue" _n
file close `fh'
capture noisily set scheme zzq
local rc = _rc
_hc_svg "twoway scatter mpg weight," "`hc_dir'/hc13a.svg"
set scheme `hc_scheme0'
cert_file_has "`hc_dir'/hc13a.svg", needle("fill:#0000FF")
local blue = r(found)
cert_file_has "`hc_dir'/hc13a.svg", needle("fill:#FF0000")
local red = r(found)
_hc_expect "HC8-13" "(`rc' == 0 & `blue' == 1 & `red' == 0)" "set scheme zzq: rc `rc', blue `blue', red `red' -- scheme-zzq.scheme did not win"
// A name with no scheme- file at all (a fresh one: Stata keeps a scheme it
// has loaded, so erasing scheme-zzq.scheme would not show the fallback).
file open `fh' using "`hc_dir'/zzr.scheme", write text replace
file write `fh' "#include s2color" _n "color background red" _n
file close `fh'
capture noisily set scheme zzr
local rc = _rc
_hc_svg "twoway scatter mpg weight," "`hc_dir'/hc13b.svg"
set scheme `hc_scheme0'
cert_file_has "`hc_dir'/hc13b.svg", needle("fill:#FF0000")
_hc_expect "HC8-13" "(`rc' == 0 & `r(found)' == 1)" "set scheme zzr with only zzr.scheme: rc `rc', red `r(found)'"
// dash's s2color translation in the working directory, where set scheme
// could find it as s2color.scheme: twoway draws exactly what it draws
// without it.
set scheme s2color
_hc_svg "twoway scatter mpg weight," "`hc_dir'/hc13c.svg"
copy "`hc_home'/../dash-s2color.scheme" "`hc_dir'/s2color.scheme", replace
set scheme s2color
_hc_svg "twoway scatter mpg weight," "`hc_dir'/hc13d.svg"
erase "`hc_dir'/s2color.scheme"
set scheme `hc_scheme0'
mata: st_local("same", strofreal(_hc_svg_same(st_local("hc_dir") + "/hc13c.svg", st_local("hc_dir") + "/hc13d.svg")))
_hc_expect "HC8-13" "(`same' == 1)" "twoway drew differently beside dash's s2color.scheme"
_hc_done "HC8-13" "scheme-NAME.scheme first, then NAME.scheme; dash's files change nothing twoway draws"

