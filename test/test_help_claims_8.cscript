// ================================================================
// HC8-17 -- jsonio is not required
// ================================================================
// Until 24sep2026 dash exported its data with jsonio and refused without
// it, r(198).  It now writes the data from Python (_dash_write_data), and
// the dependencies section says jsonio is no longer needed.  jsonio may sit
// in more than one directory (a source checkout and PLUS both, on this
// machine), so the ado-path is cut down to Stata's own directories, the
// working directory and the one holding dash_render.py, for the one
// command, and put back whole: S_ADO is the ado-path.  dash's own programs
// are already loaded; jsonio is dropped from memory, and must not be
// loaded again.
_dash_find_render
local hc_rdir = substr(`"`r(fn)'"', 1, strlen(`"`r(fn)'"') - strlen("dash_render.py"))
local hc_ado `"$S_ADO"'
global S_ADO `"BASE;SITE;.;`hc_rdir'"'
capture program drop jsonio
capture which jsonio
local hidden = (_rc != 0)
if `hidden' {
    capture erase "`hc_dir'/hc17.html"
    _hc_run "" `"dash scatter mpg weight, saving("`hc_dir'/hc17.html", replace)"'
    local rc = r(rc)
    capture confirm file "`hc_dir'/hc17.html"
    local wrote = (_rc == 0)
    capture program list jsonio
    local loaded = (_rc == 0)
}
global S_ADO `"`hc_ado'"'
if !`hidden' {
    display as text "HC8-17 SKIP: jsonio is still found on the cut-down ado-path."
}
else {
    _hc_expect "HC8-17" "(`rc' == 0)" "rc `rc'"
    _hc_expect "HC8-17" "(`wrote' == 1)" "no page was written"
    _hc_expect "HC8-17" "(`loaded' == 0)" "jsonio was loaded"
    _hc_done "HC8-17" "without jsonio dash draws, and never loads it"
}

// HC8-17b -- and on the dash build route, which dash serve's export shares
// (_dash_prepare_spec).  test_help_claims_8.py holds dash.ado to one writer
// on both routes and no jsonio call.
global S_ADO `"BASE;SITE;.;`hc_rdir'"'
capture program drop jsonio
capture which jsonio
local hidden = (_rc != 0)
if `hidden' {
    capture erase "`hc_dir'/hc17b.html"
    _hc_run "dash scatter mpg weight, name(g1)" `"dash build, saving("`hc_dir'/hc17b.html") replace nobrowser"'
    local rc = r(rc)
    local prc = r(prc)
    capture confirm file "`hc_dir'/hc17b.html"
    local wrote = (_rc == 0)
    capture program list jsonio
    local loaded = (_rc == 0)
}
global S_ADO `"`hc_ado'"'
if !`hidden' {
    display as text "HC8-17b SKIP: jsonio is still found on the cut-down ado-path."
}
else {
    _hc_expect "HC8-17b" "(`prc' == 0)" "registering without jsonio: rc `prc'"
    _hc_expect "HC8-17b" "(`rc' == 0)" "dash build without jsonio: rc `rc'"
    _hc_expect "HC8-17b" "(`wrote' == 1)" "dash build without jsonio wrote no page"
    _hc_expect "HC8-17b" "(`loaded' == 0)" "jsonio was loaded"
    _hc_done "HC8-17b" "without jsonio dash build draws, and never loads it"
}

// ================================================================
// HC8-18 -- every Also see target resolves
// ================================================================
// help twoway is graph_twoway.sthlp and help python is
// pystata_integration.sthlp, by Stata's own aliases (thelp_alias.maint and
// phelp_alias.maint).
foreach f in dash_setup.sthlp graph_twoway.sthlp pystata_integration.sthlp {
    capture findfile `f'
    _hc_expect "HC8-18" "(_rc == 0)" "`f' is not on the ado-path"
}
// Both steps are required: until 24sep2026 an alias table findfile could
// not find, or a Mata error reading it, skipped the check in silence.
foreach pair in "t/thelp_alias.maint twoway graph_twoway" "p/phelp_alias.maint python pystata_integration" {
    tokenize `pair'
    capture findfile `1'
    local frc = _rc
    local afn `"`r(fn)'"'
    _hc_expect "HC8-18" "(`frc' == 0)" "`1', Stata's alias table, is not on the ado-path"
    local amatch 0
    if `frc' == 0 {
        capture mata: st_local("amatch", strofreal(any(regexm(cat(st_local("afn")), "^`2'[ \t]+`3'[ \t]*$"))))
        local mrc = _rc
        _hc_expect "HC8-18" "(`mrc' == 0 & `amatch' == 1)" "`1' does not map `2' to `3' (Mata rc `mrc')"
    }
}
_hc_done "HC8-18" "dash_setup, twoway and python all resolve"

// ================================================================
// HC8-19 -- dash_setup's summary
// ================================================================
_hc_run "" "_dash_setup_summary, failures(1) warnings(0) items(bokeh 2.4 (needs 3.8))"
_hc_expect "HC8-19" "(`r(rc)' == 198)" "one unmet requirement: rc `r(rc)'"
_hc_log "HC8-19" "`r(logfile)'" "dash_setup did not complete: 1 unmet requirement(s)." 1
_hc_run "" "_dash_setup_summary, failures(0) warnings(1) items(packaging)"
_hc_expect "HC8-19" "(`r(rc)' == 0)" "one warning: rc `r(rc)'"
_hc_log "HC8-19" "`r(logfile)'" "dash_setup complete, with 1 warning(s)." 1
_hc_run "" "_dash_setup_summary, failures(0) warnings(0)"
_hc_expect "HC8-19" "(`r(rc)' == 0)" "clean: rc `r(rc)'"
_hc_log "HC8-19" "`r(logfile)'" "dash_setup complete. All dependencies are satisfied." 1
_hc_done "HC8-19" "unmet is r(198); a warning completes; clean says satisfied"

// ================================================================
// HC8-20 -- cmissing: twoway joins across a missing y by default
// ================================================================
preserve
clear
input x y
1 1
2 2
3 .
4 4
5 5
end
_hc_svg "twoway line y x," "`hc_dir'/hc20a.svg"
_hc_svg "twoway line y x, cmissing(n)" "`hc_dir'/hc20b.svg"
restore
mata: st_local("m1", strofreal(_hc_svg_moves(st_local("hc_dir") + "/hc20a.svg")))
mata: st_local("m2", strofreal(_hc_svg_moves(st_local("hc_dir") + "/hc20b.svg")))
_hc_expect "HC8-20" "(`m1' == 1 & `m2' == 2)" "default drew `m1' piece(s), cmissing(n) `m2'"
_hc_done "HC8-20" "one unbroken line by default, two pieces with cmissing(n)"

// ================================================================
* WP-48 48-01: probes for the corrected sentences
// ================================================================
// Q4801-1 -- a sub-option note names the token as typed, value and all
// (the typo paragraph's "never the values supplied" is gone).  The
// misspelled titel(x) itself is HC8-06.
_hc_run "" `"dash scatter mpg weight, legend(note("HCQ1"))"'
local rc = r(rc)
local lf "`r(logfile)'"
_hc_expect "Q4801-1" "(`rc' == 0)" "legend(note()): rc `rc'"
_hc_log "Q4801-1" "`lf'" `"legend() sub-option(s) not implemented and ignored: note("HCQ1")"' 1
_hc_done "Q4801-1" "a sub-option note prints the token as typed"

// Q4801-2 -- the words of no twoway option are refused as twoway refuses
// them, its line and r(198), in dash and twoway alike.
foreach w in xreverse yreverse xalternate yalternate xcommon ycommon "margin(small)" "region(fcolor(red))" altaxis "addplot(scatter mpg weight)" lockaspect "zoom(2)" ddensity {
    local o = regexr(`"`w'"', "\(.*$", "")
    if strpos(`"`w'"', "(") local o "`o'()"
    _hc_run "" `"twoway scatter mpg weight, `w'"'
    local trc = r(rc)
    _hc_log "Q4801-2" "`r(logfile)'" "option `o' not allowed" 1 1
    _hc_run "" `"dash scatter mpg weight, `w' name(q4801b, replace)"'
    local drc = r(rc)
    local lf "`r(logfile)'"
    _hc_expect "Q4801-2" "(`drc' == 198 & `trc' == 198)" `"`w': dash rc `drc', twoway rc `trc'"'
    _hc_log "Q4801-2" "`lf'" "option `o' not allowed" 1 1
}
_hc_done "Q4801-2" "xreverse, xcommon, margin(), lockaspect and the rest refused as twoway refuses them"

// Q4801-3 -- graph after dash is refused as twoway refuses twoway graph,
// "graph is not a twoway plot type", r(198); no "unrecognised plot type".
_hc_run "" "twoway graph scatter mpg weight"
local trc = r(rc)
_hc_log "Q4801-3" "`r(logfile)'" "graph is not a twoway plot type" 1 1
_hc_run "" "dash graph scatter mpg weight, name(q4801c, replace)"
local drc = r(rc)
local lf "`r(logfile)'"
_hc_expect "Q4801-3" "(`drc' == 198 & `trc' == 198)" "dash rc `drc', twoway rc `trc'"
_hc_log "Q4801-3" "`lf'" "graph is not a twoway plot type" 1 1
_hc_log "Q4801-3" "`lf'" "unrecognised plot type" 0
_hc_done "Q4801-3" "dash graph scatter is refused in twoway's words"

// Q4801-4 -- headlabel on pcscatter and pccapsym is drawn, never noted;
// off the paired-coordinate types it is refused as twoway refuses it.
foreach t in pcscatter pccapsym {
    _hc_run "" "dash `t' mpg weight price length, headlabel mlabel(make)"
    local rc = r(rc)
    local lf "`r(logfile)'"
    _hc_expect "Q4801-4" "(`rc' == 0)" "`t' headlabel: rc `rc'"
    _hc_log "Q4801-4" "`lf'" "note:" 0
}
_hc_run "" "dash scatter mpg weight, headlabel name(q4801d, replace)"
local rc = r(rc)
_hc_log "Q4801-4" "`r(logfile)'" "option headlabel not allowed" 1 1
_hc_expect "Q4801-4" "(`rc' == 198)" "scatter headlabel: rc `rc'"
_hc_done "Q4801-4" "headlabel taken in silence on pcscatter and pccapsym, refused on scatter"

// Q4801-5 -- recast() on dot is taken in silence.
_hc_run "" "dash dot mpg weight, recast(line)"
local rc = r(rc)
local lf "`r(logfile)'"
_hc_expect "Q4801-5" "(`rc' == 0)" "dot recast(line): rc `rc'"
_hc_log "Q4801-5" "`lf'" "note:" 0
_hc_done "Q4801-5" "recast(line) on dot: rc 0, no note"

// Q4801-6 -- lpoly degree(8) is drawn, with the help's note.
_hc_run "" "dash lpoly mpg weight, degree(8)"
local rc = r(rc)
local lf "`r(logfile)'"
_hc_expect "Q4801-6" "(`rc' == 0)" "lpoly degree(8): rc `rc'"
_hc_log "Q4801-6" "`lf'" "(note:  dash: lpoly degree(8) is drawn; above degree 7 the result can differ from Stata's.)" 1 1
_hc_done "Q4801-6" "degree(8) drawn with the note"

// Q4801-7 -- fpfit refuses bwidth(), degree() and kernel() as twoway
// refuses them.
foreach o in "bwidth(2)" "degree(2)" "kernel(gaussian)" {
    local nm = regexr("`o'", "\(.*$", "")
    _hc_run "" "twoway fpfit mpg weight, `o'"
    local trc = r(rc)
    _hc_log "Q4801-7" "`r(logfile)'" "option `nm'() not allowed" 1 1
    _hc_run "" "dash fpfit mpg weight, `o' name(q4801g, replace)"
    local drc = r(rc)
    _hc_log "Q4801-7" "`r(logfile)'" "option `nm'() not allowed" 1 1
    _hc_expect "Q4801-7" "(`drc' == 198 & `trc' == 198)" "fpfit `o': dash rc `drc', twoway rc `trc'"
}
_hc_done "Q4801-7" "fpfit bwidth(), degree() and kernel() refused, r(198), in twoway's words"

// Q4801-8 -- acolor() and its outline twins on scatter are taken in
// silence.
_hc_run "" "dash scatter mpg weight, acolor(red) alcolor(red) alwidth(thick) alpattern(dash)"
local rc = r(rc)
local lf "`r(logfile)'"
_hc_expect "Q4801-8" "(`rc' == 0)" "scatter acolor(): rc `rc'"
_hc_log "Q4801-8" "`lf'" "note:" 0
_hc_done "Q4801-8" "acolor(), alcolor(), alwidth(), alpattern() on scatter: no note"

// Q4801-9 -- the options twoway takes once, given once: clegend(),
// plegend(), pcycle(), atobs, nofit, fitplot(), ciplot() and a kernel
// written as an option of its own are drawn with no note; a graph-wide
// setting of the Unsupported list (titling) is named.
foreach c in "scatter mpg weight, clegend(on)" "scatter mpg weight, plegend(on)" "scatter mpg weight, pcycle(2)" "lfit mpg weight, atobs" "lfitci mpg weight, nofit" "lfitci mpg weight, fitplot(line) ciplot(rline)" "lpoly mpg weight, gaussian" {
    _hc_run "" "dash `c'"
    local rc = r(rc)
    local lf "`r(logfile)'"
    _hc_expect "Q4801-9" "(`rc' == 0)" "`c': rc `rc'"
    _hc_log "Q4801-9" "`lf'" "note:" 0
}
_hc_run "" "dash scatter mpg weight, titling"
local rc = r(rc)
local lf "`r(logfile)'"
_hc_expect "Q4801-9" "(`rc' == 0)" "titling: rc `rc'"
_hc_log "Q4801-9" "`lf'" "(note:  dash: ignoring unsupported option(s): titling)" 1 1
_hc_done "Q4801-9" "clegend(), plegend(), pcycle() and the fit options drawn with no note; titling named"

// Q4801-10 -- by()'s style(rescale) and subtitle()'s box words are drawn
// with no note.
foreach o in "by(foreign, style(rescale))" "by(foreign) subtitle(, fcolor(red) lcolor(blue))" "by(foreign) subtitle(, nobox)" {
    _hc_run "" "dash scatter mpg weight, `o'"
    local rc = r(rc)
    local lf "`r(logfile)'"
    _hc_expect "Q4801-10" "(`rc' == 0)" "`o': rc `rc'"
    _hc_log "Q4801-10" "`lf'" "note:" 0
}
_hc_done "Q4801-10" "style(rescale) and subtitle(, fcolor() lcolor() nobox) under by(): no note"

// ================================================================
// WP-48 48-02: probes
// ================================================================
// Q4802-1 .. Q4802-6 (RH-15) record what the Orientation and Recast
// paragraphs state: twoway's and dash's return codes, and the saved
// page's figure (glyph kinds, ranges, axis titles, bar widths) read
// through dash_render from the spec dash wrote.
python:
import os as _q48_os, sys as _q48_sys
from sfi import Macro as _q48_M
_q48_p = _q48_os.path.abspath(_q48_os.path.join(_q48_M.getLocal("hc_home"),
                                                ".."))
if _q48_p not in _q48_sys.path:
    _q48_sys.path.insert(0, _q48_p)


def _q4802_fig(sp, dp):
    """The saved figure of one spec, summarised into $q4802_* globals."""
    import warnings
    import dash_render as dr
    from sfi import Macro
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
    figs = list(r.figures.values())
    Macro.setGlobal("q4802_nfig", str(len(figs)))
    if not figs:
        return
    fig = figs[0]
    kinds, widths = set(), []
    for g in fig.renderers:
        gl = getattr(g, "glyph", None)
        if gl is None or not getattr(g, "visible", True):
            continue
        tags = list(getattr(g, "tags", []) or [])
        if "dash_bound_extent" in tags:
            continue
        nm = type(gl).__name__
        kinds.add(nm)
        w = None
        if nm == "VBar":
            w = gl.width
        elif nm == "HBar":
            w = gl.height
        if isinstance(w, (int, float)):
            widths.append(float(w))
        elif w is not None and getattr(g, "data_source", None) is not None:
            col = getattr(w, "field", None) or (w.get("field")
                                                if isinstance(w, dict)
                                                else None)
            if col and col in g.data_source.data:
                widths.extend(float(v) for v in g.data_source.data[col])
    Macro.setGlobal("q4802_kinds", " ".join(sorted(kinds)))
    Macro.setGlobal("q4802_bw", "%.6g" % widths[0] if widths else ".")
    Macro.setGlobal("q4802_bwn", str(len(set(round(v, 9) for v in widths))))
    for ax, rg in (("x", fig.x_range), ("y", fig.y_range)):
        lo, hi = sorted((float(rg.start), float(rg.end)))
        Macro.setGlobal("q4802_%slo" % ax, "%.9g" % lo)
        Macro.setGlobal("q4802_%shi" % ax, "%.9g" % hi)
    Macro.setGlobal("q4802_xt", fig.xaxis[0].axis_label or "")
    Macro.setGlobal("q4802_yt", fig.yaxis[0].axis_label or "")
end

// _q4802_fig <k> <command>: twoway's rc for `twoway <command>' in
// $q4802_trc, dash's in $q4802_drc, and (dash rc 0) its saved figure.
capture program drop _q4802_fig
program define _q4802_fig
    version 19
    gettoken k 0 : 0
    foreach g in nfig bw bwn xlo xhi ylo yhi {
        global q4802_`g' "."
    }
    foreach g in kinds xt yt {
        global q4802_`g' ""
    }
    capture graph drop _all
    capture noisily twoway `0' nodraw
    global q4802_trc = _rc
    capture graph drop _all
    capture dash clear
    capture noisily dash `0' name(zq4802`k')
    global q4802_drc = _rc
    if ${q4802_drc} exit
    capture erase "`c(pwd)'/q4802s`k'.json"
    capture erase "`c(pwd)'/q4802d`k'.json"
    _dash_serve_spec, specpath("`c(pwd)'/q4802s`k'.json") datapath("`c(pwd)'/q4802d`k'.json")
    python: import __main__ as _q4802_m; _q4802_m._q4802_fig(r"`c(pwd)'/q4802s`k'.json", r"`c(pwd)'/q4802d`k'.json")
    capture dash clear
end

sysuse auto, clear
quietly generate yl = mpg - 1
quietly generate yh = mpg + 1

// Q4802-1 (RH-1) -- a range type recast to line, scatter or connected
// takes horizontal and vertical and is turned by horizontal: the mpg
// bounds run across, weight up the y axis.
_q4802_fig 1 rarea yl yh weight, recast(line) horizontal
_hc_expect "Q4802-1" "(${q4802_trc} == 0 & ${q4802_drc} == 0)" "recast(line) horizontal: twoway rc ${q4802_trc}, dash rc ${q4802_drc}"
_hc_expect "Q4802-1" "(${q4802_yhi} > 1000 & ${q4802_xhi} < 100)" "recast(line) horizontal not turned: x ${q4802_xlo}..${q4802_xhi}, y ${q4802_ylo}..${q4802_yhi}"
foreach t in scatter connected {
    _q4802_fig 1 rcap yl yh weight, recast(`t') vertical
    _hc_expect "Q4802-1" "(${q4802_trc} == 0 & ${q4802_drc} == 0)" "recast(`t') vertical: twoway rc ${q4802_trc}, dash rc ${q4802_drc}"
    _hc_expect "Q4802-1" "(${q4802_xhi} > 1000)" "recast(`t') vertical turned: x ${q4802_xlo}..${q4802_xhi}"
}
// rbar too, and recast to a range type (rcap) it is turned.
foreach t in line rcap {
    _q4802_fig 1 rbar yl yh weight, recast(`t') horizontal
    _hc_expect "Q4802-1" "(${q4802_trc} == 0 & ${q4802_drc} == 0)" "rbar recast(`t') horizontal: twoway rc ${q4802_trc}, dash rc ${q4802_drc}"
    _hc_expect "Q4802-1" "(${q4802_yhi} > 1000 & ${q4802_xhi} < 100)" "rbar recast(`t') horizontal not turned: x ${q4802_xlo}..${q4802_xhi}, y ${q4802_ylo}..${q4802_yhi}"
}
_hc_done "Q4802-1" "a range type recast to line, scatter or connected takes both flags and is turned by horizontal"

// Q4802-2 (RH-1, RH-2) -- recast to bar, area, spike, dropline or dot
// a range type takes horizontal and is drawn upright, as twoway draws it.
foreach t in bar area spike dropline dot {
    _q4802_fig 2 rarea yl yh weight, recast(`t') horizontal
    _hc_expect "Q4802-2" "(${q4802_trc} == 0 & ${q4802_drc} == 0)" "recast(`t') horizontal: twoway rc ${q4802_trc}, dash rc ${q4802_drc}"
    _hc_expect "Q4802-2" "(${q4802_xhi} > 1000 & ${q4802_yhi} < 100)" "recast(`t') horizontal turned: x ${q4802_xlo}..${q4802_xhi}, y ${q4802_ylo}..${q4802_yhi}"
}
_q4802_fig 2 rbar yl yh weight, recast(bar) horizontal
_hc_expect "Q4802-2" "(${q4802_trc} == 0 & ${q4802_drc} == 0)" "rbar recast(bar) horizontal: twoway rc ${q4802_trc}, dash rc ${q4802_drc}"
_hc_expect "Q4802-2" "(${q4802_xhi} > 1000 & ${q4802_yhi} < 100)" "rbar recast(bar) horizontal turned: x ${q4802_xlo}..${q4802_xhi}, y ${q4802_ylo}..${q4802_yhi}"
_hc_done "Q4802-2" "a range type recast to a bar-like type takes horizontal and is drawn upright, rbar too"

// Q4802-3 (RH-3) -- a range type drawn as a yx type draws its first
// bound and keeps both on the axis and in its title.
_q4802_fig 3 rline yl yh weight, recast(line)
_hc_expect "Q4802-3" "(${q4802_trc} == 0 & ${q4802_drc} == 0)" "rline recast(line): twoway rc ${q4802_trc}, dash rc ${q4802_drc}"
_hc_expect "Q4802-3" "(${q4802_yhi} >= 42 & ${q4802_ylo} <= 11)" "the y range ${q4802_ylo}..${q4802_yhi} leaves out a bound (11..42)"
_hc_expect "Q4802-3" `"("${q4802_yt}" == "yl/yh")"' "the y title is ${q4802_yt}"
_hc_expect "Q4802-3" `"("${q4802_kinds}" == "Line")"' "drawn as ${q4802_kinds}"
_hc_done "Q4802-3" "rline recast(line) draws its first bound and keeps both on the axis and in its title"

// Q4802-4 (RH-5, RH-6) -- histogram recast(bar) is one bin wide (mpg's
// eight bins are 3.625 wide); kdensity and scatteri recast(bar) one x
// unit wide, as twoway's bar_size of 1 draws them (yxview.class).
_q4802_fig 4 histogram mpg, recast(bar)
_hc_expect "Q4802-4" "(${q4802_trc} == 0 & ${q4802_drc} == 0)" "histogram recast(bar): twoway rc ${q4802_trc}, dash rc ${q4802_drc}"
_hc_expect "Q4802-4" "(abs(${q4802_bw} - 3.625) < 1e-6 & ${q4802_bwn} == 1)" "histogram recast(bar) width ${q4802_bw} (${q4802_bwn} widths)"
_hc_expect "Q4802-4" "(${q4802_ylo} <= 0)" "histogram recast(bar) height axis from ${q4802_ylo}"
foreach c in "kdensity mpg, recast(bar)" "scatteri 1 2 3 4 5 6, recast(bar)" {
    _q4802_fig 4 `c'
    _hc_expect "Q4802-4" "(${q4802_trc} == 0 & ${q4802_drc} == 0)" "`c': twoway rc ${q4802_trc}, dash rc ${q4802_drc}"
    _hc_expect "Q4802-4" "(abs(${q4802_bw} - 1) < 1e-9 & ${q4802_bwn} == 1)" "`c' width ${q4802_bw} (${q4802_bwn} widths)"
}
_hc_done "Q4802-4" "histogram recast(bar) is one bin wide, kdensity and scatteri recast(bar) one x unit"

// Q4802-5 (RH-9) -- on dot only a bar-like recast typed in full takes
// the flags; recast(b) takes neither on any type; as twoway judges them.
foreach c in "dot mpg weight, recast(line) horizontal" "dot mpg weight, recast(b) horizontal" "scatter mpg weight, recast(b) horizontal" "scatter mpg weight, recast(b) vertical" {
    _q4802_fig 5 `c'
    _hc_expect "Q4802-5" "(${q4802_trc} == 198 & ${q4802_drc} == 198)" "`c': twoway rc ${q4802_trc}, dash rc ${q4802_drc}"
}
foreach t in bar area dot dropline spike {
    _q4802_fig 5 dot mpg weight, recast(`t') horizontal
    _hc_expect "Q4802-5" "(${q4802_trc} == 0 & ${q4802_drc} == 0)" "dot recast(`t') horizontal: twoway rc ${q4802_trc}, dash rc ${q4802_drc}"
}
_hc_done "Q4802-5" "the flags on dot and under recast(b) are judged as twoway judges them"

// Q4802-6 (RH-9 RH-10) -- scatteri recast to bar or area takes the flags
// and is turned.
foreach t in bar area {
    _q4802_fig 6 scatteri 1 2 3 4 5 6, recast(`t') horizontal
    _hc_expect "Q4802-6" "(${q4802_trc} == 0 & ${q4802_drc} == 0)" "scatteri recast(`t') horizontal: twoway rc ${q4802_trc}, dash rc ${q4802_drc}"
    _hc_expect "Q4802-6" "(${q4802_xhi} < 6 & ${q4802_yhi} >= 6)" "scatteri recast(`t') horizontal not turned: x ${q4802_xlo}..${q4802_xhi}, y ${q4802_ylo}..${q4802_yhi}"
}
_hc_done "Q4802-6" "scatteri recast(bar) and recast(area) take horizontal and are turned"

// Q4802-7 .. Q4802-9 (ECO-16) -- the recipes of Commands that draw through
// twoway, each run as the help shows it, its dash line writing a page.
capture erase "`hc_dir'/q4802_7.html"
sysuse auto, clear
summarize mpg
scalar mpg_mean = r(mean)
scalar mpg_sd = r(sd)
_hc_run "" `"dash (histogram mpg) (function normalden(x, mpg_mean, mpg_sd), range(mpg)), saving("`hc_dir'/q4802_7.html", replace)"'
local rc = r(rc)
_hc_expect "Q4802-7" "(`rc' == 0)" "the histogram recipe: rc `rc'"
capture confirm file "`hc_dir'/q4802_7.html"
_hc_expect "Q4802-7" "(_rc == 0)" "the histogram recipe wrote no page"
_hc_done "Q4802-7" "histogram mpg, normal drawn with dash from summarize's mean and sd"

capture erase "`hc_dir'/q4802_8.html"
sysuse auto, clear
quietly regress mpg weight
quietly margins, at(weight=(2000(500)4500))
matrix T = r(table)'
matrix A = r(at)
svmat T, names(col)
svmat A, names(at)
_hc_run "" `"dash (rcap ll ul at1) (connected b at1), saving("`hc_dir'/q4802_8.html", replace)"'
local rc = r(rc)
_hc_expect "Q4802-8" "(`rc' == 0)" "the marginsplot recipe: rc `rc'"
capture confirm file "`hc_dir'/q4802_8.html"
_hc_expect "Q4802-8" "(_rc == 0)" "the marginsplot recipe wrote no page"
quietly count if !missing(b, ll, ul, at1)
_hc_expect "Q4802-8" "(r(N) == 6)" "svmat gave `r(N)' rows of margins, not 6"
_hc_done "Q4802-8" "marginsplot's margins drawn with dash from r(table) and r(at)"

capture erase "`hc_dir'/q4802_9.html"
sysuse cancer, clear
stset studytime, failure(died)
sts generate s = s
_hc_run "" `"dash line s _t, sort connect(J) saving("`hc_dir'/q4802_9.html", replace)"'
local rc = r(rc)
_hc_expect "Q4802-9" "(`rc' == 0)" "the sts graph recipe: rc `rc'"
capture confirm file "`hc_dir'/q4802_9.html"
_hc_expect "Q4802-9" "(_rc == 0)" "the sts graph recipe wrote no page"
_hc_done "Q4802-9" "sts graph's survivor function drawn with dash after stset"

// Q4802-11 (ECO-16) -- Stata's graph commands after dash ..., name(g1):
// no graph memory holds g1.  A bare graph replays the last graph command
// Stata ran, the same before dash and after it (this session has drawn
// twoway graphs; in a session with none it is "no existing graph command
// to replay", r(198), measured 12nov2026).
sysuse auto, clear
capture graph drop _all
_hc_run "" "graph"
local rc0 = r(rc)
_hc_run "" "dash scatter mpg weight, name(g1)"
_hc_expect "Q4802-11" "(r(rc) == 0)" "dash name(g1): rc `r(rc)'"
foreach c in "graph describe g1" "graph rename g1 g2" "graph copy g1 g3" "graph drop g1" "graph display g1" {
    _hc_run "" "`c'"
    local rc = r(rc)
    local lf "`r(logfile)'"
    _hc_expect "Q4802-11" "(`rc' == 111)" "`c': rc `rc'"
    _hc_log "Q4802-11" "`lf'" "graph g1 not found" 1 1
}
_hc_run "" "graph replay g1"
local rc = r(rc)
_hc_expect "Q4802-11" "(`rc' == 0)" "graph replay g1: rc `rc'"
_hc_log "Q4802-11" "`r(logfile)'" "graph g1 not found" 1 1
_hc_run "" "graph use g1"
local rc = r(rc)
_hc_expect "Q4802-11" "(`rc' == 601)" "graph use g1: rc `rc'"
_hc_log "Q4802-11" "`r(logfile)'" "file g1.gph not found" 1 1
_hc_run "" "graph"
_hc_expect "Q4802-11" "(r(rc) == `rc0')" "bare graph: rc `rc0' before dash, `r(rc)' after"
capture graph drop _all
capture dash clear
_hc_done "Q4802-11" "graph describe, rename, copy, drop, display, replay, use and a bare graph find no dash graph"

// ----------------------------------------------------------------
cd "`hc_home'"
set scheme `hc_scheme0'
capture dash clear
if ${hc_nfail} {
    display as error "SOME TESTS FAILED: ${hc_faillist}"
    exit 9
}
display as text "ALL TESTS PASSED"
