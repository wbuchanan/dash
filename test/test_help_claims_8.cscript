// ================================================================
// HC8-07 -- names, never values
// ================================================================
// Flipped (WP-30 P1.14a): pstyle() is drawn now, so mlpattern() carries
// the value.  Flipped (WP-31 E2): mlpattern() is taken as twoway takes it
// (an unknown pattern gets twoway's note, value and all), so mlabwidth()
// carries it.
// Flipped: WP-32 -- the second value rode on nosuchopt(), which twoway
// refuses and dash now refuses; afcolor() twoway takes on every type.
// Flipped (WP-32): mlabwidth() -> bmlinestyle(); twoway refuses
// mlabwidth() on every type, r(198), and dash now does.
// Flipped (WP-32): bmlinestyle() -> afintensity(); twoway draws nothing
// of bmlinestyle(), and dash takes it in silence.
_hc_run "" "dash scatter mpg weight, bmlcolor(HC8SECRETVALUE) bmcolor(HC8OTHERVALUE) name(hc07, replace)"
local lf "`r(logfile)'"
_hc_expect "HC8-07" "(`r(rc)' == 0)" "rc `r(rc)'"
_hc_log "HC8-07" "`lf'" "(note:  dash: ignoring unsupported option(s): bmlcolor() bmcolor())" 1 1
_hc_log "HC8-07" "`lf'" "HC8SECRETVALUE" 0
_hc_log "HC8-07" "`lf'" "HC8OTHERVALUE" 0
_hc_done "HC8-07" "the note carries the names and neither value"

