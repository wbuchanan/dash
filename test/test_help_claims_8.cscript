_hc_run "" `"dash scatter mpg weight, scheme(sub/mytheme) saving("`hc_dir'/hc12.html", replace)"'
_hc_expect "HC8-12" "(`r(rc)' == 198)" "scheme(sub/mytheme) on scatter: rc `r(rc)'"
_hc_run "dash scatter mpg weight, name(g1)" `"dash build, saving("`hc_dir'/hc12.html") scheme(sub/mytheme) replace"'
_hc_expect "HC8-12" "(`r(rc)' == 198)" "scheme(sub/mytheme) on build: rc `r(rc)'"
_hc_done "HC8-12" "a name with a directory separator is r(198), although sub/mytheme.scheme exists"

// ================================================================
// HC8-13 -- set scheme's lookup, and twoway beside dash's translations
// ================================================================
file open `fh' using "`hc_dir'/zzq.scheme", write text replace
file write `fh' "#include s2color" _n "color background red" _n
file close `fh'
file open `fh' using "`hc_dir'/scheme-zzq.scheme", write text replace
file write `fh' "#include s2color" _n "color background blue" _n
file close `fh'
capture noisily set scheme zzq
local rc = _rc
_hc_svg "twoway scatter mpg weight," "`hc_dir'/hc13a.svg"
set scheme `hc_scheme0'
cert_file_has "`hc_dir'/hc13a.svg", needle("fill:#0000FF")
local blue = r(found)
cert_file_has "`hc_dir'/hc13a.svg", needle("fill:#FF0000")
local red = r(found)
_hc_expect "HC8-13" "(`rc' == 0 & `blue' == 1 & `red' == 0)" "set scheme zzq: rc `rc', blue `blue', red `red' -- scheme-zzq.scheme did not win"
// A name with no scheme- file at all (a fresh one: Stata keeps a scheme it
// has loaded, so erasing scheme-zzq.scheme would not show the fallback).
file open `fh' using "`hc_dir'/zzr.scheme", write text replace
file write `fh' "#include s2color" _n "color background red" _n
file close `fh'
capture noisily set scheme zzr
local rc = _rc
_hc_svg "twoway scatter mpg weight," "`hc_dir'/hc13b.svg"
set scheme `hc_scheme0'
cert_file_has "`hc_dir'/hc13b.svg", needle("fill:#FF0000")
_hc_expect "HC8-13" "(`rc' == 0 & `r(found)' == 1)" "set scheme zzr with only zzr.scheme: rc `rc', red `r(found)'"
// dash's s2color translation in the working directory, where set scheme
// could find it as s2color.scheme: twoway draws exactly what it draws
// without it.
set scheme s2color
_hc_svg "twoway scatter mpg weight," "`hc_dir'/hc13c.svg"
copy "`hc_home'/../dash-s2color.scheme" "`hc_dir'/s2color.scheme", replace
set scheme s2color
_hc_svg "twoway scatter mpg weight," "`hc_dir'/hc13d.svg"
erase "`hc_dir'/s2color.scheme"
set scheme `hc_scheme0'
mata: st_local("same", strofreal(_hc_svg_same(st_local("hc_dir") + "/hc13c.svg", st_local("hc_dir") + "/hc13d.svg")))
_hc_expect "HC8-13" "(`same' == 1)" "twoway drew differently beside dash's s2color.scheme"
_hc_done "HC8-13" "scheme-NAME.scheme first, then NAME.scheme; dash's files change nothing twoway draws"

// ================================================================
// HC8-14 -- clwidth()'s range, twoway against dash
// ================================================================
foreach w in 10001 -1 {
    _hc_tw "twoway line mpg weight, sort clwidth(`w') name(_hcg, replace)"
    local tw = r(rc)
    _hc_run "" "dash line mpg weight, clwidth(`w') name(hc14, replace)"
    _hc_expect "HC8-14" "(`tw' == 198 & `r(rc)' == 198)" "line clwidth(`w'): twoway r(`tw'), dash r(`r(rc)')"
}
_hc_tw "twoway line mpg weight, sort clwidth(10000) name(_hcg, replace)"
local tw = r(rc)
_hc_run "" "dash line mpg weight, clwidth(10000) name(hc14, replace)"
_hc_expect "HC8-14" "(`tw' == 0 & `r(rc)' == 0)" "line clwidth(10000): twoway r(`tw'), dash r(`r(rc)')"
_hc_tw "twoway scatter mpg weight, clwidth(10001) name(_hcg, replace)"
local tw = r(rc)
_hc_run "" "dash scatter mpg weight, clwidth(10001) name(hc14, replace)"
_hc_expect "HC8-14" "(`tw' == 0 & `r(rc)' == 0)" "scatter clwidth(10001): twoway r(`tw'), dash r(`r(rc)')"
_hc_done "HC8-14" "0 to 10000 where the line is drawn, in both; nothing refused on scatter"

// ================================================================
// HC8-15 -- the order twoway joins line points in
// ================================================================
forvalues k = 1/3 {
    _hc_svg "twoway line mpg weight, sort(rep78)" "`hc_dir'/hc15_`k'.svg"
}
mata: st_local("ndiff", strofreal(_hc_ndiff3(st_local("hc_dir") + "/hc15_1.svg", st_local("hc_dir") + "/hc15_2.svg", st_local("hc_dir") + "/hc15_3.svg")))
_hc_expect "HC8-15" "(`ndiff' >= 2)" "three draws of sort(rep78) joined the points the same way `=3-`ndiff'' time(s)"
_hc_svg "twoway line mpg weight," "`hc_dir'/hc15_d.svg"
_hc_svg "twoway line mpg weight, sort" "`hc_dir'/hc15_s.svg"
mata: st_local("sx", strofreal(_hc_svg_x_sorted(st_local("hc_dir") + "/hc15_s.svg")))
mata: st_local("dx", strofreal(_hc_svg_x_sorted(st_local("hc_dir") + "/hc15_d.svg")))
_hc_expect "HC8-15" "(`sx' == 1 & `dx' == 0)" "sort joins in x order: `sx'; no sort joins in x order: `dx'"
_hc_done "HC8-15" "data order by default, x order with sort, a changing order among sort(varlist)'s ties"

// ================================================================
// HC8-16 -- dash build takes nobrowser, not nodraw
// ================================================================
_hc_run "dash scatter mpg weight, name(g1)" `"dash build, saving("`hc_dir'/hc16.html") nodraw replace"'
_hc_expect "HC8-16" "(`r(rc)' == 198)" "dash build, nodraw: rc `r(rc)'"
_hc_run "dash scatter mpg weight, name(g1)" `"dash build, saving("`hc_dir'/hc16.html") nobrowser replace"'
_hc_expect "HC8-16" "(`r(rc)' == 0)" "dash build, nobrowser: rc `r(rc)'"
_hc_done "HC8-16" "nodraw is a graph's option; dash build's own is nobrowser"

// ================================================================
// HC8-17 -- jsonio is not required
// ================================================================
// Until 24sep2026 dash exported its data with jsonio and refused without
// it, r(198).  It now writes the data from Python (_dash_write_data), and
// the dependencies section says jsonio is no longer needed.  jsonio may sit
// in more than one directory (a source checkout and PLUS both, on this
// machine), so the ado-path is cut down to Stata's own directories, the
// working directory and the one holding dash_render.py, for the one
// command, and put back whole: S_ADO is the ado-path.  dash's own programs
// are already loaded; jsonio is dropped from memory, and must not be
// loaded again.
_dash_find_render
local hc_rdir = substr(`"`r(fn)'"', 1, strlen(`"`r(fn)'"') - strlen("dash_render.py"))
local hc_ado `"$S_ADO"'
global S_ADO `"BASE;SITE;.;`hc_rdir'"'
capture program drop jsonio
capture which jsonio
local hidden = (_rc != 0)
if `hidden' {
    capture erase "`hc_dir'/hc17.html"
    _hc_run "" `"dash scatter mpg weight, saving("`hc_dir'/hc17.html", replace)"'
    local rc = r(rc)
    capture confirm file "`hc_dir'/hc17.html"
    local wrote = (_rc == 0)
    capture program list jsonio
    local loaded = (_rc == 0)
}
global S_ADO `"`hc_ado'"'
if !`hidden' {
    display as text "HC8-17 SKIP: jsonio is still found on the cut-down ado-path."
}
else {
    _hc_expect "HC8-17" "(`rc' == 0)" "rc `rc'"
    _hc_expect "HC8-17" "(`wrote' == 1)" "no page was written"
    _hc_expect "HC8-17" "(`loaded' == 0)" "jsonio was loaded"
    _hc_done "HC8-17" "without jsonio dash draws, and never loads it"
}

// HC8-17b -- and on the dash build route, which dash serve's export shares
// (_dash_prepare_spec).  test_help_claims_8.py holds dash.ado to one writer
// on both routes and no jsonio call.
global S_ADO `"BASE;SITE;.;`hc_rdir'"'
capture program drop jsonio
capture which jsonio
local hidden = (_rc != 0)
if `hidden' {
    capture erase "`hc_dir'/hc17b.html"
    _hc_run "dash scatter mpg weight, name(g1)" `"dash build, saving("`hc_dir'/hc17b.html") replace nobrowser"'
    local rc = r(rc)
    local prc = r(prc)
    capture confirm file "`hc_dir'/hc17b.html"
    local wrote = (_rc == 0)
    capture program list jsonio
    local loaded = (_rc == 0)
}
global S_ADO `"`hc_ado'"'
if !`hidden' {
    display as text "HC8-17b SKIP: jsonio is still found on the cut-down ado-path."
}
else {
    _hc_expect "HC8-17b" "(`prc' == 0)" "registering without jsonio: rc `prc'"
    _hc_expect "HC8-17b" "(`rc' == 0)" "dash build without jsonio: rc `rc'"
    _hc_expect "HC8-17b" "(`wrote' == 1)" "dash build without jsonio wrote no page"
    _hc_expect "HC8-17b" "(`loaded' == 0)" "jsonio was loaded"
    _hc_done "HC8-17b" "without jsonio dash build draws, and never loads it"
}

// ================================================================
// HC8-18 -- every Also see target resolves
// ================================================================
// help twoway is graph_twoway.sthlp and help python is
// pystata_integration.sthlp, by Stata's own aliases (thelp_alias.maint and
// phelp_alias.maint).
foreach f in dash_setup.sthlp graph_twoway.sthlp pystata_integration.sthlp {
    capture findfile `f'
    _hc_expect "HC8-18" "(_rc == 0)" "`f' is not on the ado-path"
}
// Both steps are required: until 24sep2026 an alias table findfile could
// not find, or a Mata error reading it, skipped the check in silence.
foreach pair in "t/thelp_alias.maint twoway graph_twoway" "p/phelp_alias.maint python pystata_integration" {
    tokenize `pair'
    capture findfile `1'
    local frc = _rc
    local afn `"`r(fn)'"'
    _hc_expect "HC8-18" "(`frc' == 0)" "`1', Stata's alias table, is not on the ado-path"
    local amatch 0
    if `frc' == 0 {
        capture mata: st_local("amatch", strofreal(any(regexm(cat(st_local("afn")), "^`2'[ \t]+`3'[ \t]*$"))))
        local mrc = _rc
        _hc_expect "HC8-18" "(`mrc' == 0 & `amatch' == 1)" "`1' does not map `2' to `3' (Mata rc `mrc')"
    }
}
_hc_done "HC8-18" "dash_setup, twoway and python all resolve"

// ================================================================
// HC8-19 -- dash_setup's summary
// ================================================================
_hc_run "" "_dash_setup_summary, failures(1) warnings(0) items(bokeh 2.4 (needs 3.8))"
_hc_expect "HC8-19" "(`r(rc)' == 198)" "one unmet requirement: rc `r(rc)'"
_hc_log "HC8-19" "`r(logfile)'" "dash_setup did not complete: 1 unmet requirement(s)." 1
_hc_run "" "_dash_setup_summary, failures(0) warnings(1) items(packaging)"
_hc_expect "HC8-19" "(`r(rc)' == 0)" "one warning: rc `r(rc)'"
_hc_log "HC8-19" "`r(logfile)'" "dash_setup complete, with 1 warning(s)." 1
_hc_run "" "_dash_setup_summary, failures(0) warnings(0)"
_hc_expect "HC8-19" "(`r(rc)' == 0)" "clean: rc `r(rc)'"
_hc_log "HC8-19" "`r(logfile)'" "dash_setup complete. All dependencies are satisfied." 1
_hc_done "HC8-19" "unmet is r(198); a warning completes; clean says satisfied"

// ================================================================
// HC8-20 -- cmissing: twoway joins across a missing y by default
// ================================================================
preserve
clear
input x y
1 1
2 2
3 .
4 4
5 5
end
_hc_svg "twoway line y x," "`hc_dir'/hc20a.svg"
_hc_svg "twoway line y x, cmissing(n)" "`hc_dir'/hc20b.svg"
restore
mata: st_local("m1", strofreal(_hc_svg_moves(st_local("hc_dir") + "/hc20a.svg")))
mata: st_local("m2", strofreal(_hc_svg_moves(st_local("hc_dir") + "/hc20b.svg")))
_hc_expect "HC8-20" "(`m1' == 1 & `m2' == 2)" "default drew `m1' piece(s), cmissing(n) `m2'"
_hc_done "HC8-20" "one unbroken line by default, two pieces with cmissing(n)"

// ----------------------------------------------------------------
cd "`hc_home'"
set scheme `hc_scheme0'
capture dash clear
if ${hc_nfail} {
    display as error "SOME TESTS FAILED: ${hc_faillist}"
    exit 9
}
display as text "ALL TESTS PASSED"
