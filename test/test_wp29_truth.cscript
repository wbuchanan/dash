*! test_wp29_truth.cscript
*! WP-29's ONE new certification script (.ultraplan/wp29/index.md, A3):
*! every comparison with twoway's drawing or with Stata's own values that
*! WP-29's sections need lives here, one block per section, in section
*! order, so the certification suite grows by one script.  Refusal,
*! message and return-code checks join the EXISTING script for their area
*! instead (index.md rule R1); this script never gains one of those.
*!
*! Blocks, in section order (extended by each section that lands one):
*!   S01  scaffold smoke: the helpers load and a twoway SVG is read (W29-01)
*!   S02  line join order against twoway's sersets and SVG (JO-01..JO-12)
*!   S03  P0.3 unlabelled variables (UL-01..UL-08); P0.4 title sub-options without text (ET-01..ET-10)
*!   S04  function points are twoway's (FX-20..FX-24)
*!   S05  P0.8 / P0.20 date units (DU-01..DU-06, KD-01..KD-03)
*!   S06  P0.10 hover() variables exported (HX-01..HX-08)
*!   S07  colorvar key from the layer's rows, saved and served (CQV-01..09)
*!   S08  private temporary files: twoway leaves nothing, named-page modes
*!        match twoway's, every copy is 0600 in a 0700 folder (PF-01..PF-06,
*!        PF-11, PF-12)
*!   S10  P0.5 axis(#) routed to the axis it names, against twoway's .Graph
*!        members, saved and served (AX-11..AX-18); P0.2 by() panels share
*!        one scale per axis unless rescaled (BSC-01..BSC-07)
*!
*! Usage: via run_all_cscripts.do (registered as its block 68).  One
*! block alone: set WP29_ONLY=S<NN> in the environment of the driver run
*! (index.md "The cscript driver").  Each block prints "S<NN> start" and
*! "S<NN> end" with the time, so the closeout can time it.

cscript "WP-29 truth: twoway comparisons" adodir ".."

clear all
set more off

if `"`c(python_exec)'"' == "" {
    display as error "SKIP: Python not available."
    exit 222
}

do "cert_helpers.do"
quietly do "cert_svg.do"
qui do "../dash_parse.mata"
qui do "../dash.ado"
global dash_nobrowser 1

// ----------------------------------------------------------------
// Tally helpers -- test_gaps2_truth.cscript's _gt_expect/_gt_done,
// renamed _w29_ for this script.
// ----------------------------------------------------------------
global w29_nfail    = 0
global w29_faillist ""
global w29_bad      = 0
global w29_ncase    = 0

capture program drop _w29_expect
program define _w29_expect
    version 16.0
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global w29_bad = 1
    }
end

capture program drop _w29_done
program define _w29_done
    version 16.0
    args id msg
    if ${w29_bad} {
        global w29_nfail    = ${w29_nfail} + 1
        global w29_faillist "${w29_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global w29_bad   = 0
    global w29_ncase = ${w29_ncase} + 1
end

// A fresh directory for this run's files, never one that already exists:
// a fixed name in a shared temp directory could be planted by another
// account (rule 1), so a name Stata has not handed out before is made and
// the run fails if it cannot be.
tempfile w29_base
local w29_work "`w29_base'_w29"
capture mkdir "`w29_work'"
if _rc {
    display as error "test_wp29_truth: cannot create the work directory `w29_work' (rc `=_rc')"
    exit 9
}

* ==== S01 scaffold: the helpers load and a twoway SVG is read ====
local only : env WP29_ONLY
if inlist("`only'", "", "S01") {
    display as text "S01 start `c(current_time)'"

    // ------------------------------------------------------------
    // W29-01: cert_svg_export and cert_svg_texts on one twoway scatter,
    // and dash's own programs are loaded from this tree.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(w29s01, replace)
    cert_svg_export, name(w29s01) file("`w29_work'/w29s01.svg")
    local s01_rc   = r(rc)
    local s01_file "`r(file)'"
    _w29_expect W29-01 "(`s01_rc' == 0)" "cert_svg_export rc `s01_rc'"
    capture confirm file "`s01_file'"
    _w29_expect W29-01 "(_rc == 0)" "r(file) `s01_file' does not exist"
    cert_svg_texts, file("`s01_file'")
    local s01_n    = r(n)
    local s01_list "`r(list)'"
    _w29_expect W29-01 "(`s01_n' > 0)" "cert_svg_texts found no text elements"
    capture program list _dash_serve
    _w29_expect W29-01 "(_rc == 0)" "dash.ado's _dash_serve is not loaded"
    _w29_done W29-01 "a twoway SVG was written and read (`s01_n' texts); dash is loaded"

    capture erase "`s01_file'"
    capture erase "`s01_list'"
    capture graph drop w29s01
    display as text "S01 end `c(current_time)'"
}
* ==== end S01 ====

// Helpers of block S02 (line join order), defined before it: programs
// are not defined inside a block's braces.

// twoway joins line, connected, area, rline, rarea and rconnected in
// the data's order, in x order under sort, in the order of sort()'s
// varlist under sort(varlist), and tsline and tsrline in time order;
// each bound of a range line keeps its own rows (WP-29 P0.1).  Every
// case below asks twoway in the same run: its serset (serset use) or
// its exported SVG, against the sources of dash's saved page or
// served app.  Data: scripts/extract_join_order_truth.do's datasets A
// (eight rows, y = 100 * obs, tie-free under every key) and B
// (missing values).

capture program drop _jo_dataA
program define _jo_dataA
    version 16.0
    clear
    quietly set obs 8
    generate double obs = _n
    generate double x = .
    generate double z = .
    generate str1 s = ""
    generate double zz = .
    generate double keyw = 9 - _n
    generate double g = .
    generate double t = .
    local xs  4 1 3 2 8 5 7 6
    local zs  3 .b 1 .a 2 . 5 4
    local ss  `""b" "B" "a" "" "_" "A" "C" "c""'
    local zzs 2 1 2 1 1 2 1 2
    local gs  1 2 1 2 . 1 2 1
    local ts  3 8 1 6 2 7 4 5
    forvalues i = 1/8 {
        quietly replace x  = `: word `i' of `xs''  in `i'
        quietly replace z  = `: word `i' of `zs''  in `i'
        quietly replace s  = `"`: word `i' of `ss''"' in `i'
        quietly replace zz = `: word `i' of `zzs'' in `i'
        quietly replace g  = `: word `i' of `gs''  in `i'
        quietly replace t  = `: word `i' of `ts''  in `i'
    }
    generate double y  = 100 * obs
    generate double y2 = y + 1
end

capture program drop _jo_dataB
program define _jo_dataB
    version 16.0
    clear
    quietly set obs 7
    generate double x   = .
    generate double y   = .
    generate double y2a = .
    generate double y2b = .
    local xs  2 5 3 6 1 . 7
    local ys  10 20 . 40 50 45 60
    local as  11 . 31 41 51 46 61
    local bs  11 21 . 41 51 46 61
    forvalues i = 1/7 {
        quietly replace x   = `: word `i' of `xs'' in `i'
        quietly replace y   = `: word `i' of `ys'' in `i'
        quietly replace y2a = `: word `i' of `as'' in `i'
        quietly replace y2b = `: word `i' of `bs'' in `i'
    }
end

// Every serset in memory, each as its observations (y = 100 * obs),
// ";"-joined, into the global jo_tw.
capture program drop _jo_sersets
program define _jo_sersets
    version 16.0
    local all ""
    forvalues k = 0/40 {
        capture serset set `k'
        if _rc continue
        preserve
        serset use, clear
        local o ""
        forvalues i = 1/`=_N' {
            local o `o' `=round(y[`i'] / 100)'
        }
        restore
        local all "`all';`o'"
    }
    global jo_tw "`all'"
end

// twoway's sersets for one command (run with nodraw).
capture program drop _jo_twoway
program define _jo_twoway, rclass
    version 16.0
    serset clear
    capture graph drop _all
    capture noisily `0'
    return scalar rc = _rc
    if _rc == 0 _jo_sersets
    else global jo_tw ""
    capture graph drop _all
end

// A dash command under its own log: r(rc), r(note) (the ignoring
// note is in the log), r(log).
capture program drop _jo_dash
program define _jo_dash, rclass
    version 16.0
    args cmdtext logpath
    capture log close _jolog
    capture erase "`logpath'"
    log using "`logpath'", name(_jolog) text replace
    capture noisily `cmdtext'
    local rc = _rc
    log close _jolog
    cert_log_has "`logpath'", needle("ignoring unsupported")
    return scalar note = r(found)
    return scalar rc   = `rc'
    return local log "`logpath'"
end

python:
import json as _jo_json, os as _jo_os, re as _jo_re, sys as _jo_sys
import warnings as _jo_w
from sfi import Macro as _JoM
from bokeh.document import Document as _JoDoc
from bokeh.models import Line as _JoLine, VArea as _JoVArea


def _jo_unescape(text):
    ents = {"amp": "&", "lt": "<", "gt": ">", "quot": chr(34),
            "#x27": chr(39), "#x60": chr(96)}
    return _jo_re.sub(r"&(amp|lt|gt|quot|#x27|#x60);",
                      lambda m: ents[m.group(1)], text)


def _jo_figs(doc):
    out = []

    def visit(m):
        if isinstance(m, (list, tuple)):
            for x in m:
                visit(x)
            return
        if m is None:
            return
        if type(m).__name__ in ("figure", "Plot"):
            out.append(m)
            return
        for attr in ("children", "tabs", "child"):
            k = getattr(m, attr, None)
            if k is not None:
                visit(k)
    for r in doc.roots:
        visit(r)
    return out


def _jo_field(v):
    if isinstance(v, dict):
        return v.get("field")
    return getattr(v, "field", v)


def _jo_doc_xs(doc):
    out = []
    for f in _jo_figs(doc):
        for g in f.renderers:
            gl = getattr(g, "glyph", None)
            if isinstance(gl, (_JoLine, _JoVArea)):
                col = _jo_field(gl.x)
                data = g.data_source.data
                if col in data:
                    out.append([float(v) for v in data[col]])
    return out


def _jo_page_doc(path):
    with open(path, encoding="utf-8") as fh:
        page = fh.read()
    blocks = _jo_re.findall(
        r'<script type="application/json" id="[^"]+">\s*(.*?)\s*</script>',
        page, _jo_re.S)
    docs = [d for b in blocks
            for d in _jo_json.loads(_jo_unescape(b)).values()]
    if len(docs) != 1:
        raise RuntimeError("%s holds %d Bokeh documents" % (path, len(docs)))
    return _JoDoc.from_json(docs[0]), page


def _jo_xmap():
    xs = _JoM.getGlobal("jo_xs").split()
    return dict((float(v), i + 1) for i, v in enumerate(xs) if v != ".")


def _jo_obs_str(lists):
    m = _jo_xmap()
    return ";" + ";".join(" ".join(str(m[v]) for v in xs) for xs in lists)


def _jo_page():
    # global jo_page: the saved page; jo_dash: its sources as observations.
    doc, page = _jo_page_doc(_JoM.getGlobal("jo_page"))
    _JoM.setGlobal("jo_dash", _jo_obs_str(_jo_doc_xs(doc)))
    _JoM.setGlobal("jo_hasdashs", str(int("__dashs" in page)))
    # The variable as a name: quoted, as a column or a key would be
    # ("keyw" alone is in the page's JavaScript, inside "keyword").
    _JoM.setGlobal("jo_haskeyw", str(int(chr(34) + "keyw" + chr(34) in page)))


def _jo_page_xs():
    # The raw x of each source (dataset B: x has a missing row).
    doc, _page = _jo_page_doc(_JoM.getGlobal("jo_page"))
    lists = _jo_doc_xs(doc)
    _JoM.setGlobal("jo_dash", ";" + ";".join(
        " ".join("%g" % v for v in xs) for xs in lists))


def _jo_app():
    # global jo_app: a generated served app, run without being served.
    with open(_JoM.getGlobal("jo_app"), encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_jo_app")
    with _jo_w.catch_warnings():
        _jo_w.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_jo_app.py", "exec"),
             ns)
        doc = _JoDoc()
        ns["make_document"](doc)
        spec, _df, _meta = ns["_load_spec_and_data"]()
    _JoM.setGlobal("jo_dash", _jo_obs_str(_jo_doc_xs(doc)))
    cols = (spec.get("build_options") or {}).get("sort_cols")
    _JoM.setGlobal("jo_sortcols", _jo_json.dumps(cols, sort_keys=True))


def _jo_svg():
    # global jo_svg: twoway's SVG; jo_tw: the x of every path's vertices,
    # read through the x axis's own labels; area paths cut to their data
    # vertices (consecutive repeats merged, the return to the start
    # dropped), rarea's to its lower bound.
    _jo_sys.path.insert(0, _jo_os.path.abspath(_jo_os.path.join("..", "scripts")))
    import svg_truth
    path = _JoM.getGlobal("jo_svg")
    kind = _JoM.getGlobal("jo_kind")
    pairs = svg_truth.svg_axis_reading(path, "x").get("pairs") or []
    if len(pairs) < 2:
        raise RuntimeError("no x axis reading in " + path)
    n = float(len(pairs))
    mx = sum(p for p, _ in pairs) / n
    mv = sum(v for _, v in pairs) / n
    b = (sum((p - mx) * (v - mv) for p, v in pairs)
         / sum((p - mx) ** 2 for p, _ in pairs))
    a = mv - b * mx
    with open(path, encoding="utf-8") as fh:
        text = fh.read()
    out = []
    for d in _jo_re.findall(r'<path[^>]*\sd="([^"]*)"', text):
        xs = []
        for px, _py in _jo_re.findall(r"[ML]\s*(-?[0-9.]+)\s+(-?[0-9.]+)", d):
            v = a + b * float(px)
            if abs(v - round(v)) > 1e-3:
                raise RuntimeError("vertex x %r is not an integer" % v)
            xs.append(int(round(v)))
        if kind == "area":
            xs = [v for i, v in enumerate(xs) if i == 0 or v != xs[i - 1]][:-1]
        elif kind == "rarea":
            xs = xs[1:len(xs) // 2]
        out.append(xs)
    _JoM.setGlobal("jo_tw", ";" + ";".join(" ".join(str(v) for v in xs)
                                           for xs in out))


def _jo_same():
    # jo_eq: 1 when jo_dash and jo_tw hold the same set of joins and
    # neither is empty.
    def parts(s):
        return set(p.strip() for p in s.split(";")[1:])
    d, t = parts(_JoM.getGlobal("jo_dash")), parts(_JoM.getGlobal("jo_tw"))
    _JoM.setGlobal("jo_eq", str(int(bool(d) and d == t)))
end

// Compare one twoway command's sersets with dash's saved page of the
// same command: `t' the type, `v' the varlist and any qualifier, `o' the
// options.  Sets the globals jo_ok (1 when equal) and jo_why.
capture program drop _jo_case
program define _jo_case
    version 16.0
    args t v o page
    _jo_twoway twoway `t' `v', `o' nodraw
    local twrc = r(rc)
    global jo_twrc = `twrc'
    capture erase "`page'"
    capture noisily dash `t' `v', `o' saving("`page'", replace)
    local drc = _rc
    global jo_ok = 0
    global jo_why "twoway r(`twrc'), dash r(`drc')"
    // Both refused with the same code: the same answer (sort(_all) over
    // more than eight variables, measured: twoway counts two variables of
    // its own and takes ten names at most).
    if `twrc' != 0 & `twrc' == `drc' global jo_ok = 1
    if `twrc' == 0 & `drc' == 0 {
        global jo_page "`page'"
        global jo_dash ""
        global jo_eq 0
        capture noisily python: __import__("__main__")._jo_page()
        capture noisily python: __import__("__main__")._jo_same()
        global jo_ok = ${jo_eq}
        global jo_why "twoway ${jo_tw} dash ${jo_dash}"
    }
end

* ==== S02 P0.1: line join order ====
local only : env WP29_ONLY
if inlist("`only'", "", "S02") {
    display as text "S02 start `c(current_time)'"
    local jo_log "`w29_work'/jo.log"
    local jo_pg  "`w29_work'/jo.html"
    local six "line connected area rline rarea rconnected"

    _jo_dataA
    global jo_xs "4 1 3 2 8 5 7 6"

    // JO-01: the data's order, no option.
    foreach t of local six {
        local v "y x"
        if inlist("`t'", "rline", "rarea", "rconnected") local v "y y2 x"
        _jo_case `t' "`v'" "" "`jo_pg'"
        _w29_expect JO-01 "(${jo_ok} == 1)" "`t': ${jo_why}"
    }
    _w29_done JO-01 "the six types join in the data's order, as twoway's serset"

    // JO-02: sort, the order of x.
    foreach t of local six {
        local v "y x"
        if inlist("`t'", "rline", "rarea", "rconnected") local v "y y2 x"
        _jo_case `t' "`v'" "sort" "`jo_pg'"
        _w29_expect JO-02 "(${jo_ok} == 1)" "`t' sort: ${jo_why}"
    }
    _w29_done JO-02 "sort joins the six types in the order of x"

    // JO-03: sort(varlist): missing values, strings, an abbreviation, two
    // variables and _all.
    foreach t of local six {
        local v "y x"
        if inlist("`t'", "rline", "rarea", "rconnected") local v "y y2 x"
        foreach o in "sort(z)" "sort(s)" "sort(key)" "sort(zz x)" "sort(_all)" {
            _jo_case `t' "`v'" "`o'" "`jo_pg'"
            _w29_expect JO-03 "(${jo_ok} == 1)" "`t' `o': ${jo_why}"
        }
    }
    // sort(_all) where twoway takes it: eight variables or fewer.
    preserve
    keep obs x y y2 z
    foreach t of local six {
        local v "y x"
        if inlist("`t'", "rline", "rarea", "rconnected") local v "y y2 x"
        _jo_case `t' "`v'" "sort(_all)" "`jo_pg'"
        _w29_expect JO-03 "(${jo_ok} == 1 & ${jo_twrc} == 0)" "`t' sort(_all) on five variables: ${jo_why}"
    }
    restore
    _w29_done JO-03 "sort(varlist) joins in Stata's order of the varlist"

    // JO-04: repeats and the bare flag beside sort(): the rightmost
    // non-empty copy decides; dash's rc is twoway's.  The empty copy is
    // set beside z, which has no ties (zz has: twoway's tie order is
    // random).
    foreach t of local six {
        local v "y x"
        if inlist("`t'", "rline", "rarea", "rconnected") local v "y y2 x"
        foreach o in "sort sort(z)" "sort(z) sort(x)" "sort(x*) sort(z)" "sort(z) sort()" "sort() sort(z)" {
            _jo_case `t' "`v'" "`o'" "`jo_pg'"
            _w29_expect JO-04 "(${jo_ok} == 1)" "`t' `o': ${jo_why}"
        }
    }
    _w29_done JO-04 "repeated sort() copies join as twoway's rightmost non-empty copy"

    // JO-05: dataset B, missing values: each path dash draws is the path
    // twoway's SVG draws.  rarea is compared where both bounds are missing
    // together (y2b); with one bound missing twoway's polygon keeps the
    // other bound's row, which one VArea cannot draw (residual O1).
    _jo_dataB
    global jo_xs "2 5 3 6 1 . 7"
    foreach c in "line y x" "connected y x" "area y x" "rline y y2a x" "rconnected y y2a x" "rarea y y2b x" {
        gettoken t v : c
        foreach o in "" "sort" {
            capture graph drop _all
            serset clear
            quietly twoway `t' `v', `o' xscale(range(0 8)) xlabel(0(2)8)
            global jo_svg "`w29_work'/jo05.svg"
            capture erase "${jo_svg}"
            quietly graph export "${jo_svg}", replace as(svg)
            capture graph drop _all
            global jo_kind "`t'"
            global jo_tw ""
            capture noisily python: __import__("__main__")._jo_svg()
            capture erase "`jo_pg'"
            capture noisily dash `t' `v', `o' saving("`jo_pg'", replace)
            local drc = _rc
            global jo_page "`jo_pg'"
            global jo_dash ""
            global jo_eq 0
            if `drc' == 0 capture noisily python: __import__("__main__")._jo_page_xs()
            capture noisily python: __import__("__main__")._jo_same()
            _w29_expect JO-05 "(`drc' == 0 & ${jo_eq} == 1)" "`t' `v' `o': twoway ${jo_tw} dash ${jo_dash} (rc `drc')"
        }
    }
    capture erase "`w29_work'/jo05.svg"
    _w29_done JO-05 "with missing values each path dash draws is twoway's, each range bound its own rows"

    // JO-06: by(), by(, total), by(, total missing): each panel joins in
    // the data's order within its group (per-panel joins, as a set).
    _jo_dataA
    global jo_xs "4 1 3 2 8 5 7 6"
    foreach t in line rline {
        local v "y x"
        if "`t'" == "rline" local v "y y2 x"
        foreach b in "by(g)" "by(g, total)" "by(g, total missing)" {
            foreach o in "" "sort" {
                _jo_case `t' "`v'" "`b' `o'" "`jo_pg'"
                _w29_expect JO-06 "(${jo_ok} == 1)" "`t' `b' `o': ${jo_why}"
            }
        }
    }
    _w29_done JO-06 "every by() panel, the Total panel included, joins as twoway's"

    // JO-07: in and if.
    foreach t of local six {
        local v "y x"
        if inlist("`t'", "rline", "rarea", "rconnected") local v "y y2 x"
        foreach q in "in 2/6" "if g==1" {
            _jo_case `t' "`v' `q'" "" "`jo_pg'"
            _w29_expect JO-07 "(${jo_ok} == 1)" "`t' `q': ${jo_why}"
        }
    }
    _w29_done JO-07 "in and if join the rows they keep in the data's order"

    // JO-08: tsline and tsrline join in time order whatever they are
    // given, and sort and sort(y) on them are silent, rc 0.
    quietly tsset t
    foreach t in tsline tsrline {
        local v "y"
        if "`t'" == "tsrline" local v "y y2"
        global jo_xs "3 8 1 6 2 7 4 5"
        foreach o in "" "sort" "sort(y)" {
            _jo_case `t' "`v'" "`o'" "`jo_pg'"
            _w29_expect JO-08 "(${jo_ok} == 1)" "`t' `o': ${jo_why}"
            capture dash clear
            _jo_dash `"dash `t' `v', `o' name(jo08)"' "`jo_log'"
            _w29_expect JO-08 "(r(rc) == 0 & r(note) == 0)" "`t' `o': dash rc `r(rc)', note `r(note)'"
        }
    }
    quietly tsset, clear
    sort obs
    global jo_xs "4 1 3 2 8 5 7 6"
    _w29_done JO-08 "tsline and tsrline join in time order, silent under sort and sort(y)"

    // JO-09: the build route; then a sort() variable dropped after the
    // graph was registered is refused in twoway's words, nothing left.
    capture dash clear
    _jo_twoway twoway line y x, sort(z) nodraw
    quietly dash line y x, sort(z) name(g1)
    capture erase "`jo_pg'"
    capture noisily dash build, saving("`jo_pg'") replace
    local brc = _rc
    global jo_dash ""
    global jo_page "`jo_pg'"
    global jo_eq 0
    if `brc' == 0 capture noisily python: __import__("__main__")._jo_page()
    capture noisily python: __import__("__main__")._jo_same()
    _w29_expect JO-09 "(`brc' == 0 & ${jo_eq} == 1)" "dash build rc `brc': twoway ${jo_tw} dash ${jo_dash}"
    preserve
    drop z
    capture erase "`jo_pg'"
    _jo_dash `"dash build, saving("`jo_pg'") replace"' "`jo_log'"
    local brc = r(rc)
    cert_log_has "`jo_log'", needle("variable z not found")
    local h1 = r(found)
    cert_log_has "`jo_log'", needle("option sort() incorrectly specified")
    local h2 = r(found)
    capture unab _jo_left : __dash*
    local urc = _rc
    capture confirm file "`jo_pg'"
    local pgrc = _rc
    restore
    _w29_expect JO-09 "(`brc' == 198 & `h1' == 1 & `h2' == 1 & `urc' == 111 & `pgrc' != 0)" "dropped z: rc `brc', lines `h1'/`h2', __dash* unab rc `urc', page rc `pgrc'"
    capture dash clear
    _w29_done JO-09 "dash build joins by sort(); a dropped sort() variable is refused r(198) in twoway's words"

    // JO-10: estimates in memory survive the rank columns.
    quietly regress y x
    _jo_case line "y x" "sort(z)" "`jo_pg'"
    _w29_expect JO-10 "(${jo_ok} == 1)" "line sort(z) after regress: ${jo_why}"
    local ok10 = ("`e(cmd)'" == "regress")
    _w29_expect JO-10 "(`ok10' == 1)" "e(cmd) is `e(cmd)', not regress"
    ereturn clear
    _w29_done JO-10 "estimates in memory are held while the rank columns are made"

    // JO-11: the served app joins as twoway does.
    local jo_app "`w29_work'/jo11.py"
    foreach t in line rline {
        local v "y x"
        if "`t'" == "rline" local v "y y2 x"
        foreach o in "" "sort(z)" {
            capture dash clear
            _jo_twoway twoway `t' `v', `o' nodraw
            quietly dash `t' `v', `o' name(g1)
            capture erase "`jo_app'"
            capture noisily dash build, server saving("`jo_app'") replace nobrowser
            local brc = _rc
            global jo_dash ""
            global jo_app "`jo_app'"
            global jo_eq 0
            if `brc' == 0 capture noisily python: __import__("__main__")._jo_app()
            capture noisily python: __import__("__main__")._jo_same()
            _w29_expect JO-11 "(`brc' == 0 & ${jo_eq} == 1)" "`t' `o' served rc `brc': twoway ${jo_tw} dash ${jo_dash}"
        }
    }
    capture dash clear
    _w29_done JO-11 "the served app joins as twoway does"

    // JO-12: a variable named only in sort() reaches no page; the spec
    // maps it to its rank column.
    capture erase "`jo_pg'"
    capture noisily dash line y x, sort(keyw) saving("`jo_pg'", replace)
    local drc = _rc
    global jo_hasdashs = 1
    global jo_haskeyw = 1
    global jo_page "`jo_pg'"
    if `drc' == 0 capture noisily python: __import__("__main__")._jo_page()
    _w29_expect JO-12 "(`drc' == 0 & ${jo_hasdashs} == 0 & ${jo_haskeyw} == 0)" "page rc `drc', __dashs in page ${jo_hasdashs}, keyw in page ${jo_haskeyw}"
    capture dash clear
    quietly dash line y x, sort(keyw) name(g1)
    capture erase "`jo_app'"
    capture noisily dash build, server saving("`jo_app'") replace nobrowser
    local brc = _rc
    global jo_sortcols ""
    global jo_app "`jo_app'"
    if `brc' == 0 capture noisily python: __import__("__main__")._jo_app()
    local ok12 = (`"${jo_sortcols}"' == `"{"keyw": "__dashs1"}"')
    if !`ok12' display as error `"JO-12: sort_cols is ${jo_sortcols}"'
    _w29_expect JO-12 "(`ok12' == 1)" "the served spec's sort_cols does not map keyw to __dashs1 (rc `brc')"
    capture dash clear
    _w29_done JO-12 "a variable named only in sort() is never written; its rank column is named in the spec"

    capture erase "`jo_pg'"
    capture erase "`jo_app'"
    capture erase "`jo_log'"
    macro drop jo_*
    display as text "S02 end `c(current_time)'"
}
* ==== end S02 ====
// S03's helpers, defined here, outside every block and gate, where a
// python block may hold braces (test_cscript_hygiene.py requires each
// block to open with its gate).  Used by the S03 P0.3 and P0.4 blocks.
// Helpers, reached through __main__ (cert_svg.do's TRAP note).  Defined
// outside the gate, where braces are safe:
//   _s03_page()        S03_AX S03_AXS S03_KEYS S03_TIPS S03_W S03_CBAR
//                      S03_TITLE of the
//                      saved page S03_PAGE (KEYS: each legend's labels in
//                      order joined by "|", legends sorted and joined by ";")
//   _s03_app()         the same, prefixed S03_S, of the served app S03_APP;
//                      then fires the RangeSlider filtering S03_MOVE and sets
//                      S03_FIRED and S03_SAME_AFTER
//   _s03_twoway_keys() S03_TW: twoway's legend keys, S03_BARE minus S03_OFF
//                      (cert_svg_texts lists), sorted by y then x
//   _s03_text()        S03_OUT: "size|fill|rotate" of each <text> equal to
//                      S03_TXT in S03_SVG, joined by ";"
python:
import collections as _s03_col, json as _s03_json, re as _s03_re, html as _s03_html
import warnings as _s03_w
import __main__ as _s03_main
from sfi import Macro as _s03_M

_S03_AXES = ("LinearAxis", "LogAxis", "DatetimeAxis", "CategoricalAxis")
_S03_WIDGETS = ("Select", "RangeSlider", "Slider", "DateRangeSlider", "DateSlider")


def _s03_val(v):
    if isinstance(v, dict):
        return v.get("value")
    inner = getattr(v, "value", None)
    return v if inner is None else inner


def _s03_models(path):
    try:
        with open(path, encoding="utf-8") as fh:
            page = fh.read()
    except OSError:
        return []
    objs, stack = {}, []
    for blob in _s03_re.findall('<script type="application/json"[^>]*>(.*?)</script>', page, _s03_re.S):
        try:
            stack.append(_s03_json.loads(_s03_html.unescape(blob)))
        except ValueError:
            pass
    while stack:
        v = stack.pop()
        if isinstance(v, dict):
            if v.get("type") == "object" and "id" in v and "name" in v:
                objs.setdefault(v["id"], v)
            stack.extend(v.values())
        elif isinstance(v, list):
            stack.extend(v)
    return list(objs.values())


class _S03Saved:
    """A saved page's model, read as the served one is."""

    def __init__(self, obj):
        self.kind = obj["name"]
        self.attrs = obj.get("attributes", {}) or {}
        self._defaults = None

    def get(self, attr):
        if attr in self.attrs:
            return _s03_val(self.attrs[attr])
        if self._defaults is None:
            import bokeh.models as _bm
            try:
                self._defaults = getattr(_bm, self.kind)()
            except Exception:
                self._defaults = False
        return _s03_val(getattr(self._defaults, attr, None)) if self._defaults else None


class _S03Served:
    def __init__(self, model):
        self.kind = type(model).__name__
        self.model = model

    def get(self, attr):
        return _s03_val(getattr(self.model, attr, None))


def _s03_summary(models, by_id):
    ax, axs, keys, tips, ws, cbar, titles = [], [], [], [], [], [], []
    for m in models:
        if m.kind in _S03_AXES:
            rn = m.get("y_range_name")
            if rn in (None, "default"):
                rn = m.get("x_range_name") or "default"
            lab = m.get("axis_label")
            lab = "" if lab is None else str(lab)
            ax.append("%s=%s" % (rn, lab))
            axs.append("%s=%s@%s@%s" % (rn, lab, m.get("axis_label_text_font_size"),
                                        m.get("axis_label_text_color")))
        elif m.kind == "Legend":
            if m.get("name") == "_dash_clegend":
                if m.get("title"):
                    cbar.append("%s@%s@%s" % (m.get("title"), m.get("title_text_font_size"),
                                              m.get("title_text_color")))
                continue
            one = []
            for it in (m.get("items") or []):
                item = by_id(it)
                if item is not None:
                    lab = item.get("label")
                    one.append("" if lab is None else str(lab))
            keys.append("|".join(one))
        elif m.kind == "HoverTool":
            tt = m.get("tooltips")
            if isinstance(tt, list):
                tips.append(",".join(str(p[0]) for p in tt))
        elif m.kind in _S03_WIDGETS:
            ws.append(str(m.get("title") or ""))
        elif m.kind == "Title":
            if m.get("text"):
                titles.append(str(m.get("text")))
        elif m.kind == "ColorBar":
            cbar.append("%s@%s@%s" % (m.get("title"), m.get("title_text_font_size"),
                                      m.get("title_text_color")))
    return dict(AX="|".join(sorted(ax)), AXS="|".join(sorted(axs)),
                KEYS=";".join(sorted(keys)), TIPS=";".join(sorted(tips)),
                W="|".join(sorted(ws)), CBAR="|".join(sorted(cbar)),
                TITLE="|".join(sorted(titles)))


def _s03_set(prefix, summ):
    for k, v in summ.items():
        _s03_M.setGlobal(prefix + k, v)


def _s03_page():
    objs = _s03_models(_s03_M.getGlobal("S03_PAGE"))
    by = dict((o["id"], _S03Saved(o)) for o in objs)
    models = [by[o["id"]] for o in objs]

    def by_id(ref):
        rid = ref.get("id") if isinstance(ref, dict) else getattr(ref, "id", None)
        return by.get(rid)
    _s03_set("S03_", _s03_summary(models, by_id))


def _s03_doc_summary(doc):
    from bokeh.model import Model
    seen = dict()
    for root in doc.roots:
        for m in root.references():
            seen[m.id] = m
    wrapped = [_S03Served(m) for m in seen.values()]

    def by_id(ref):
        return _S03Served(ref) if ref is not None else None
    return _s03_summary(wrapped, by_id)


def _s03_app():
    from bokeh.document import Document
    from bokeh.models import RangeSlider
    with open(_s03_M.getGlobal("S03_APP"), encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_s03_app")
    with _s03_w.catch_warnings():
        _s03_w.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_s03_app.py", "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    before = _s03_doc_summary(doc)
    _s03_set("S03_S", before)
    var = _s03_M.getGlobal("S03_MOVE")
    sl = [s for s in doc.select(dict(type=RangeSlider)) if getattr(s, "_dash_var", None) == var]
    fired = 0
    if len(sl) == 1:
        old = sl[0].value
        lo, hi = old
        new = (lo + (hi - lo) / 4.0, hi)
        sl[0].value = new
        with _s03_w.catch_warnings():
            _s03_w.simplefilter("ignore")
            for attr in ("value", "value_throttled"):
                for cb in sl[0]._callbacks.get(attr, []):
                    cb(attr, old, new)
                    fired += 1
    _s03_M.setGlobal("S03_FIRED", str(fired))
    _s03_M.setGlobal("S03_SAME_AFTER", str(int(_s03_doc_summary(doc) == before)))


def _s03_lines(path):
    with open(path, encoding="utf-8") as fh:
        return [_s03_json.loads(s) for s in fh if s.strip()]


def _s03_twoway_keys():
    bare = _s03_lines(_s03_M.getGlobal("S03_BARE"))
    off = _s03_lines(_s03_M.getGlobal("S03_OFF"))
    left = _s03_col.Counter(e["text"] for e in bare) - _s03_col.Counter(e["text"] for e in off)
    seen, out = _s03_col.Counter(), []
    for e in bare:
        if seen[e["text"]] < left.get(e["text"], 0):
            out.append(e)
            seen[e["text"]] += 1
    out.sort(key=lambda e: (float(e.get("y") or 0.0), float(e.get("x") or 0.0)))
    _s03_M.setGlobal("S03_TW", "|".join(e["text"] for e in out))


def _s03_text():
    import svg_truth as _s03_svg
    want = _s03_M.getGlobal("S03_TXT")
    out = []
    for e in _s03_svg.svg_texts(_s03_M.getGlobal("S03_SVG")):
        if e["text"] == want:
            out.append("%s|%s|%s" % (e["size"], e["fill"], e["rotate"]))
    _s03_M.setGlobal("S03_OUT", ";".join(out))


_s03_main._s03_page = _s03_page
_s03_main._s03_app = _s03_app
_s03_main._s03_twoway_keys = _s03_twoway_keys
_s03_main._s03_text = _s03_text
end

* ==== S03 P0.3: unlabelled variables ====
local only : env WP29_ONLY
if inlist("`only'", "", "S03") {
    // UL-01..UL-08: an unlabelled variable (label "" as Stata holds it) is
    // named by its name in dash's axis titles, legend keys, tooltip rows and
    // filter widgets, as twoway draws it; saved page and served app agree,
    // before and after a filter move.
    display as text "S03 P0.3 start `c(current_time)'"
    // dash build finds dash_render.py through the ado-path.
    quietly adopath ++ "`c(pwd)'/.."

    capture program drop _s03_data
    program define _s03_data
        version 16.0
        clear
        quietly set obs 12
        quietly gen double y = _n + 0.5
        quietly gen double y1 = _n
        quietly gen double y2 = _n + 3
        quietly gen double x = _n*2
        quietly gen double z = mod(_n,4)
        quietly gen g = mod(_n,2)
        quietly gen double w = _n*1.5
    end

    // Builds the saved page of one dash command and reads it.
    capture program drop _s03_dash
    program define _s03_dash
        version 16.0
        args id gname cmd dir
        capture dash clear
        capture noisily dash `cmd' name(`gname')
        _w29_expect `id' "(_rc == 0)" "dash rc `_rc'"
        capture erase "`dir'/`gname'.html"
        capture noisily dash build, saving("`dir'/`gname'.html") replace nobrowser
        _w29_expect `id' "(_rc == 0)" "dash build rc `_rc'"
        global S03_PAGE "`dir'/`gname'.html"
        python: __import__("__main__")._s03_page()
    end

    // twoway's legend keys of `body' (bare minus legend(off)) against
    // dash's.
    capture program drop _s03_keys
    program define _s03_keys
        version 16.0
        args id gname body dir want
        quietly twoway `body', name(s03b, replace)
        cert_svg_export, name(s03b) file("`dir'/`id'_bare.svg")
        cert_svg_texts, file("`dir'/`id'_bare.svg")
        global S03_BARE "`r(list)'"
        quietly twoway `body', legend(off) name(s03o, replace)
        cert_svg_export, name(s03o) file("`dir'/`id'_off.svg")
        cert_svg_texts, file("`dir'/`id'_off.svg")
        global S03_OFF "`r(list)'"
        python: __import__("__main__")._s03_twoway_keys()
        _s03_dash `id' `gname' "`body'," "`dir'"
        display as text `"  `id' twoway [$S03_TW] dash [$S03_KEYS]"'
        _w29_expect `id' `"("$S03_TW" == "$S03_KEYS")"' `"twoway $S03_TW dash $S03_KEYS"'
        _w29_expect `id' `"("$S03_KEYS" == "`want'")"' `"dash keys $S03_KEYS, want `want'"'
        capture graph drop s03b s03o
    end

    local d "`w29_work'"

    // ---- UL-01: scatter y x ----
    _s03_data
    quietly twoway scatter y x, name(s03a, replace)
    cert_svg_export, name(s03a) file("`d'/ul01.svg")
    local f "`r(file)'"
    cert_svg_has_text, file("`f'") text("y")
    local ty = r(found)
    cert_svg_has_text, file("`f'") text("x")
    local tx = r(found)
    _s03_dash UL-01 ul01 "scatter y x," "`d'"
    display as text `"  UL-01 twoway y:`ty' x:`tx' dash [$S03_AX]"'
    _w29_expect UL-01 "(`ty' == 1 & `tx' == 1)" "twoway did not title the axes y and x"
    _w29_expect UL-01 `"("$S03_AX" == "default=x|default=y")"' "dash axes $S03_AX"
    _w29_done UL-01 "scatter y x is titled x and y in twoway and dash"

    // ---- UL-02: two layers keyed by name ----
    _s03_data
    _s03_keys UL-02 ul02 "(scatter y1 x) (scatter y2 x)" "`d'" "y1|y2"
    _w29_done UL-02 "two unlabelled layers are keyed y1 and y2"

    // ---- UL-03: a fit beside data ----
    _s03_data
    _s03_keys UL-03 ul03 "(scatter y x) (lfit y x)" "`d'" "y|Fitted values"
    _w29_done UL-03 "the data layer is keyed y, the fit Fitted values"

    // ---- UL-04: a label of blanks is drawn as given ----
    _s03_data
    label variable w "   "
    quietly twoway scatter w x, name(s03a, replace)
    cert_svg_export, name(s03a) file("`d'/ul04.svg")
    global S03_SVG "`r(file)'"
    global S03_TXT "   "
    python: __import__("__main__")._s03_text()
    local tw4 "$S03_OUT"
    _s03_dash UL-04 ul04 "scatter w x," "`d'"
    display as text `"  UL-04 twoway [`tw4'] dash [$S03_AX]"'
    _w29_expect UL-04 `"(strpos("`tw4'", "|-90") > 0)"' "twoway drew no rotated blank title: `tw4'"
    _w29_expect UL-04 `"("$S03_AX" == "default=   |default=x")"' "dash axes $S03_AX"
    _s03_data
    label variable w "   "
    _s03_keys UL-04 ul04k "(scatter w x) (scatter y2 x)" "`d'" "   |y2"
    _w29_done UL-04 "a label of blanks is drawn blank, as twoway draws it"

    // ---- UL-05: histogram ----
    _s03_data
    quietly twoway histogram x, name(s03a, replace)
    cert_svg_export, name(s03a) file("`d'/ul05.svg")
    local f "`r(file)'"
    cert_svg_has_text, file("`f'") text("Density")
    local td = r(found)
    cert_svg_has_text, file("`f'") text("x")
    local tx = r(found)
    _s03_dash UL-05 ul05 "histogram x," "`d'"
    display as text `"  UL-05 twoway Density:`td' x:`tx' dash [$S03_AX]"'
    _w29_expect UL-05 "(`td' == 1 & `tx' == 1)" "twoway titles differ"
    _w29_expect UL-05 `"("$S03_AX" == "default=Density|default=x")"' "dash axes $S03_AX"
    _w29_done UL-05 "histogram x is titled Density and x"

    // ---- UL-06: univariate keys ----
    _s03_data
    _s03_keys UL-06 ul06a "(histogram x) (kdensity x)" "`d'" "Density|kdensity x"
    _s03_data
    _s03_keys UL-06 ul06b "(kdensity x) (kdensity y)" "`d'" "kdensity x|kdensity y"
    _w29_done UL-06 "histogram and kdensity layers are keyed as twoway keys them"

    // ---- UL-07: tooltip rows on the saved page ----
    _s03_data
    _s03_dash UL-07 ul07a "scatter y x," "`d'"
    local t1 "$S03_TIPS"
    _s03_data
    _s03_dash UL-07 ul07b "lfit y2 y1," "`d'"
    local t2 "$S03_TIPS"
    display as text `"  UL-07 scatter [`t1'] lfit [`t2']"'
    _w29_expect UL-07 `"("`t1'" == "x,y")"' "scatter tooltip `t1'"
    _w29_expect UL-07 `"("`t2'" == "y1,y2")"' "lfit tooltip `t2'"
    _w29_done UL-07 "tooltip rows name the layer's own variables"

    // ---- UL-08: the served app agrees, before and after a move ----
    _s03_data
    capture dash clear
    capture noisily dash scatter y x, name(ul08a)
    _w29_expect UL-08 "(_rc == 0)" "dash rc `_rc'"
    capture noisily dash (scatter y1 x) (scatter y2 x), name(ul08b)
    _w29_expect UL-08 "(_rc == 0)" "dash rc `_rc'"
    capture erase "`d'/ul08.html"
    capture erase "`d'/ul08_app.py"
    capture noisily dash build, saving("`d'/ul08.html") replace nobrowser ///
        filter(x, type(range)) filter(g, type(dropdown))
    _w29_expect UL-08 "(_rc == 0)" "saved build rc `_rc'"
    capture noisily dash build, saving("`d'/ul08_app.py") server replace ///
        filter(x, type(range)) filter(g, type(dropdown))
    _w29_expect UL-08 "(_rc == 0)" "served build rc `_rc'"
    global S03_PAGE "`d'/ul08.html"
    python: __import__("__main__")._s03_page()
    global S03_APP "`d'/ul08_app.py"
    global S03_MOVE "x"
    python: __import__("__main__")._s03_app()
    display as text `"  UL-08 saved [$S03_AX][$S03_KEYS][$S03_TIPS][$S03_W]"'
    display as text `"  UL-08 served [$S03_SAX][$S03_SKEYS][$S03_STIPS][$S03_SW] fired $S03_FIRED same $S03_SAME_AFTER"'
    _w29_expect UL-08 `"("$S03_AX" == "$S03_SAX" & "$S03_KEYS" == "$S03_SKEYS" & "$S03_TIPS" == "$S03_STIPS")"' "saved and served differ"
    _w29_expect UL-08 `"("$S03_W" == "g|x" & "$S03_SW" == "g|x")"' "widget titles $S03_W / $S03_SW"
    _w29_expect UL-08 `"(strpos(";$S03_KEYS;", ";y1|y2;") > 0)"' "keys $S03_KEYS"
    _w29_expect UL-08 "($S03_FIRED == 1 & $S03_SAME_AFTER == 1)" "after the move: fired $S03_FIRED same $S03_SAME_AFTER"
    _w29_done UL-08 "the served app names the variables as the saved page does, before and after a move"

    capture dash clear
    capture graph drop _all
    display as text "S03 P0.3 end `c(current_time)'"
}
* ==== end S03 ====

* ==== S03 P0.4: title sub-options without text ====
local only : env WP29_ONLY
if inlist("`only'", "", "S03") {
    // ET-01..ET-10: a title option that gives only sub-options keeps
    // twoway's default title and is styled by them; trailing and doubled
    // commas open an empty sub-option list; the second axis is titled by
    // default except under by(); the colour key keeps its title; saved and
    // served agree before and after a move.  The helpers are S03 P0.3's.
    display as text "S03 P0.4 start `c(current_time)'"
    quietly adopath ++ "`c(pwd)'/.."
    local d "`w29_work'"

    // twoway's size|fill|rotate of each <text> equal to `txt' in a fresh
    // export of `cmd'.
    capture program drop _s03_tw
    program define _s03_tw
        version 16.0
        args cmd txt file
        quietly `cmd' name(s03t, replace)
        cert_svg_export, name(s03t) file("`file'")
        global S03_SVG "`file'"
        global S03_TXT "`txt'"
        python: __import__("__main__")._s03_text()
        capture graph drop s03t
    end

    // twoway's default title size under the scheme in force: every size
    // check below is against it.
    sysuse auto, clear
    _s03_tw "twoway scatter mpg weight," "Mileage (mpg)" "`d'/et00.svg"
    local base = real(substr("$S03_OUT", 1, strpos("$S03_OUT", "|") - 1))
    display as text "  twoway default title size `base'"

    // ---- ET-01: ytitle(, size(large)) ----
    _s03_tw "twoway scatter mpg weight, ytitle(, size(large))" "Mileage (mpg)" "`d'/et01.svg"
    local tw "$S03_OUT"
    _s03_dash ET-01 et01 "scatter mpg weight, ytitle(, size(large))" "`d'"
    display as text `"  ET-01 twoway [`tw'] dash [$S03_AXS]"'
    _w29_expect ET-01 `"(real(substr("`tw'", 1, strpos("`tw'", "|") - 1)) > `base' & strpos("`tw'", "|-90") > 0)"' "twoway `tw'"
    _w29_expect ET-01 `"(strpos("$S03_AXS", "default=Mileage (mpg)@15px@") > 0)"' "dash $S03_AXS"
    _w29_done ET-01 "ytitle(, size(large)) keeps Mileage (mpg), at large"

    // ---- ET-02: xtitle(, color(red)) ----
    _s03_tw "twoway scatter mpg weight, xtitle(, color(red))" "Weight (lbs.)" "`d'/et02.svg"
    local tw "$S03_OUT"
    _s03_dash ET-02 et02 "scatter mpg weight, xtitle(, color(red))" "`d'"
    display as text `"  ET-02 twoway [`tw'] dash [$S03_AXS]"'
    _w29_expect ET-02 `"(strpos("`tw'", "|#ff0000|") > 0)"' "twoway `tw'"
    _w29_expect ET-02 `"(ustrregexm("$S03_AXS", "default=Weight \(lbs\.\)@[^@|]*@#ff0000"))"' "dash $S03_AXS"
    _w29_done ET-02 "xtitle(, color(red)) keeps Weight (lbs.), in red"

    // ---- ET-03: ytitle(,), ytitle(A,), title(A,) ----
    _s03_tw "twoway scatter mpg weight, ytitle(,)" "Mileage (mpg)" "`d'/et03a.svg"
    local tw1 "$S03_OUT"
    _s03_tw "twoway scatter mpg weight, ytitle(A,)" "A" "`d'/et03b.svg"
    local tw2 "$S03_OUT"
    _s03_tw "twoway scatter mpg weight, title(A,)" "A" "`d'/et03c.svg"
    local tw3 "$S03_OUT"
    _s03_dash ET-03 et03a "scatter mpg weight, ytitle(,)" "`d'"
    local a1 "$S03_AX"
    _s03_dash ET-03 et03b "scatter mpg weight, ytitle(A,)" "`d'"
    local a2 "$S03_AX"
    _s03_dash ET-03 et03c "scatter mpg weight, title(A,)" "`d'"
    local t3 "$S03_TITLE"
    display as text `"  ET-03 twoway [`tw1'][`tw2'][`tw3'] dash [`a1'][`a2'][`t3']"'
    _w29_expect ET-03 `"("`tw1'" != "" & "`tw2'" != "" & "`tw3'" != "")"' "twoway texts missing"
    _w29_expect ET-03 `"("`a1'" == "default=Mileage (mpg)|default=Weight (lbs.)")"' "ytitle(,) `a1'"
    _w29_expect ET-03 `"("`a2'" == "default=A|default=Weight (lbs.)")"' "ytitle(A,) `a2'"
    _w29_expect ET-03 `"("`t3'" == "A")"' "title(A,) `t3'"
    _w29_done ET-03 "a comma followed by nothing opens an empty sub-option list"

    // ---- ET-04: histogram and kdensity keep their titles ----
    _s03_tw "twoway histogram mpg, ytitle(, size(large))" "Density" "`d'/et04a.svg"
    local tw1 "$S03_OUT"
    _s03_tw "twoway kdensity mpg, ytitle(, size(large))" "kdensity mpg" "`d'/et04b.svg"
    local tw2 "$S03_OUT"
    _s03_dash ET-04 et04a "histogram mpg, ytitle(, size(large))" "`d'"
    local a1 "$S03_AXS"
    _s03_dash ET-04 et04b "kdensity mpg, ytitle(, size(large))" "`d'"
    local a2 "$S03_AXS"
    display as text `"  ET-04 twoway [`tw1'][`tw2'] dash [`a1'][`a2']"'
    _w29_expect ET-04 `"(real(substr("`tw1'", 1, strpos("`tw1'", "|") - 1)) > `base' & real(substr("`tw2'", 1, strpos("`tw2'", "|") - 1)) > `base')"' "twoway `tw1' `tw2'"
    _w29_expect ET-04 `"(strpos("`a1'", "default=Density@15px@") > 0)"' "histogram `a1'"
    _w29_expect ET-04 `"(strpos("`a2'", "default=kdensity mpg@15px@") > 0)"' "kdensity `a2'"
    _w29_done ET-04 "histogram and kdensity keep Density and kdensity mpg at large"

    // ---- ET-05: the second axis ----
    local Y2 "(scatter mpg weight) (line price weight, yaxis(2))"
    _s03_tw "twoway `Y2', ytitle(, axis(2) size(large))" "Price" "`d'/et05a.svg"
    local tw1 "$S03_OUT"
    _s03_tw "twoway `Y2'," "Price" "`d'/et05b.svg"
    local tw2 "$S03_OUT"
    _s03_dash ET-05 et05a "`Y2', ytitle(, axis(2) size(large))" "`d'"
    local a1 "$S03_AXS"
    _s03_dash ET-05 et05b "`Y2'," "`d'"
    local a2 "$S03_AXS"
    display as text `"  ET-05 twoway [`tw1'][`tw2'] dash [`a1'][`a2']"'
    _w29_expect ET-05 `"(real(substr("`tw1'", 1, strpos("`tw1'", "|") - 1)) > `base' & strpos("`tw1'", "|-90") > 0 & real(substr("`tw2'", 1, strpos("`tw2'", "|") - 1)) == `base' & strpos("`tw2'", "|-90") > 0)"' "twoway `tw1' / `tw2'"
    _w29_expect ET-05 `"(strpos("`a1'", "y2=Price@15px@") > 0)"' "sized `a1'"
    _w29_expect ET-05 `"(strpos("`a2'", "y2=Price@") > 0 & strpos("`a2'", "y2=Price@15px@") == 0)"' "default `a2'"
    _w29_done ET-05 "the second axis is titled Price, styled by ytitle(, axis(2) size(large))"

    // ---- ET-06: the colour key ----
    _s03_tw "twoway scatter mpg weight, colorvar(price) ztitle(, size(large))" "Price" "`d'/et06.svg"
    local tw "$S03_OUT"
    _s03_dash ET-06 et06 "scatter mpg weight, colorvar(price) ztitle(, size(large))" "`d'"
    display as text `"  ET-06 twoway [`tw'] dash [$S03_CBAR]"'
    _w29_expect ET-06 `"(real(substr("`tw'", 1, strpos("`tw'", "|") - 1)) > `base')"' "twoway `tw'"
    _w29_expect ET-06 `"(strpos("$S03_CBAR", "Price@15px@") == 1)"' "dash $S03_CBAR"
    _w29_done ET-06 "ztitle(, size(large)) keeps the key title Price"

    // ---- ET-07: merges ----
    _s03_tw `"twoway scatter mpg weight, ytitle("") ytitle(, size(large))"' "Mileage (mpg)" "`d'/et07a.svg"
    local tw1 "$S03_OUT"
    _s03_tw `"twoway scatter mpg weight, ytitle(, size(large)) ytitle("A")"' "A" "`d'/et07b.svg"
    local tw2 "$S03_OUT"
    _s03_dash ET-07 et07a `"scatter mpg weight, ytitle("") ytitle(, size(large))"' "`d'"
    local a1 "$S03_AX"
    _s03_dash ET-07 et07b `"scatter mpg weight, ytitle(, size(large)) ytitle("A")"' "`d'"
    local a2 "$S03_AXS"
    display as text `"  ET-07 twoway [`tw1'][`tw2'] dash [`a1'][`a2']"'
    _w29_expect ET-07 `"("`tw1'" == "" & real(substr("`tw2'", 1, strpos("`tw2'", "|") - 1)) > `base')"' "twoway `tw1' / `tw2'"
    _w29_expect ET-07 `"("`a1'" == "default=|default=Weight (lbs.)")"' "removed `a1'"
    _w29_expect ET-07 `"(strpos("`a2'", "default=A@15px@") > 0)"' "merged `a2'"
    _w29_done ET-07 `"ytitle("") still removes; ytitle("A") merged with size(large) is A at large"'

    // ---- ET-08: doubled and trailing commas ----
    _s03_tw "twoway scatter mpg weight, ytitle(A,,)" "A" "`d'/et08a.svg"
    local tw1 "$S03_OUT"
    _s03_tw "twoway scatter mpg weight, ytitle(A, size(large),)" "A" "`d'/et08b.svg"
    local tw2 "$S03_OUT"
    _s03_dash ET-08 et08a "scatter mpg weight, ytitle(A,,)" "`d'"
    local a1 "$S03_AX"
    _s03_dash ET-08 et08b "scatter mpg weight, ytitle(A, size(large),)" "`d'"
    local a2 "$S03_AXS"
    display as text `"  ET-08 twoway [`tw1'][`tw2'] dash [`a1'][`a2']"'
    _w29_expect ET-08 `"(strpos("`tw1'", "|-90") > 0 & real(substr("`tw2'", 1, strpos("`tw2'", "|") - 1)) > `base')"' "twoway `tw1' / `tw2'"
    _w29_expect ET-08 `"("`a1'" == "default=A|default=Weight (lbs.)")"' "ytitle(A,,) `a1'"
    _w29_expect ET-08 `"(strpos("`a2'", "default=A@15px@") > 0)"' "ytitle(A, size(large),) `a2'"
    _w29_done ET-08 "ytitle(A,,) and ytitle(A, size(large),) title A"

    // ---- ET-09: no axis-2 default under by() ----
    _s03_tw "twoway `Y2', by(foreign)" "Price" "`d'/et09.svg"
    local tw "$S03_OUT"
    _s03_dash ET-09 et09 "`Y2', by(foreign)" "`d'"
    display as text `"  ET-09 twoway [`tw'] dash [$S03_AX]"'
    _w29_expect ET-09 `"(strpos("`tw'", "|-90") == 0)"' "twoway drew a rotated Price: `tw'"
    _w29_expect ET-09 `"(strpos("$S03_AX", "y2=") > 0 & !ustrregexm("$S03_AX", "y2=[^|]"))"' "dash $S03_AX"
    _w29_done ET-09 "under by() the second axis has no default title, as in twoway"

    // ---- ET-10: the served app of ET-01, ET-05 and ET-06 ----
    capture dash clear
    capture noisily dash scatter mpg weight, ytitle(, size(large)) name(et10a)
    _w29_expect ET-10 "(_rc == 0)" "dash rc `_rc'"
    capture noisily dash `Y2', ytitle(, axis(2) size(large)) name(et10b)
    _w29_expect ET-10 "(_rc == 0)" "dash rc `_rc'"
    capture noisily dash scatter mpg weight, colorvar(price) ztitle(, size(large)) name(et10c)
    _w29_expect ET-10 "(_rc == 0)" "dash rc `_rc'"
    capture erase "`d'/et10.html"
    capture erase "`d'/et10_app.py"
    capture noisily dash build, saving("`d'/et10.html") replace nobrowser filter(mpg, type(range))
    _w29_expect ET-10 "(_rc == 0)" "saved build rc `_rc'"
    capture noisily dash build, saving("`d'/et10_app.py") server replace filter(mpg, type(range))
    _w29_expect ET-10 "(_rc == 0)" "served build rc `_rc'"
    global S03_PAGE "`d'/et10.html"
    python: __import__("__main__")._s03_page()
    global S03_APP "`d'/et10_app.py"
    global S03_MOVE "mpg"
    python: __import__("__main__")._s03_app()
    display as text `"  ET-10 saved [$S03_AXS][$S03_CBAR]"'
    display as text `"  ET-10 served [$S03_SAXS][$S03_SCBAR] fired $S03_FIRED same $S03_SAME_AFTER"'
    _w29_expect ET-10 `"("$S03_AXS" == "$S03_SAXS" & "$S03_CBAR" == "$S03_SCBAR")"' "saved and served differ"
    _w29_expect ET-10 `"(strpos("$S03_SAXS", "default=Mileage (mpg)@15px@") > 0 & strpos("$S03_SAXS", "y2=Price@15px@") > 0)"' "served axes $S03_SAXS"
    _w29_expect ET-10 `"(strpos("$S03_SCBAR", "Price@15px@") == 1)"' "served key $S03_SCBAR"
    _w29_expect ET-10 "($S03_FIRED == 1 & $S03_SAME_AFTER == 1)" "after the move: fired $S03_FIRED same $S03_SAME_AFTER"
    _w29_done ET-10 "the served app draws the same titles, sizes and key title, before and after a move"

    capture dash clear
    capture graph drop _all
    display as text "S03 P0.4 end `c(current_time)'"
}
* ==== end S03 ====
* ==== S04 P0.6: function points are twoway's ====
local only : env WP29_ONLY
if inlist("`only'", "", "S04") {
    display as text "S04 start `c(current_time)'"

    // A function layer's points are Stata's own (section 04): dash runs
    // twoway__function_gen at registration and stores x0, dx and y in
    // $dash_fpts_<name>; both renderers draw those numbers.  Each case
    // compares them with twoway's serset, read live, then builds the
    // saved page and the served app and reads the drawn source back.

    // _fx_serset: twoway's last graph's first plot, read from its serset
    // into the row matrices fx_sy and fx_sx (y, then x, as twoway keeps
    // them; sorted by x).
    capture program drop _fx_serset
    program define _fx_serset
        version 16.0
        preserve
        serset set `.Graph.plotregion1.plot1.serset.id'
        serset use, clear
        mata: st_matrix("fx_sy", st_data(., 1)')
        mata: st_matrix("fx_sx", st_data(., 2)')
        restore
    end
    // _fx_stored <name>: the stored points of graph <name>'s layer 1, as
    // the row matrix fx_dy and the locals fx_x0, fx_dx (r()-free).
    capture program drop _fx_stored
    program define _fx_stored
        version 16.0
        args name
        mata: _s = st_global("dash_fpts_" + st_local("name")); _a = strpos(_s, `""y":["') + 5; _t = substr(_s, _a, strpos(substr(_s, _a, .), "]") - 1); _v = tokens(_t, ","); _v = select(_v, _v :!= ","); st_matrix("fx_dy", strtoreal(_v)); _b = strpos(_s, `""x0":"') + 5; st_local("_x0", substr(_s, _b, strpos(substr(_s, _b, .), ",") - 1)); _b = strpos(_s, `""dx":"') + 5; st_local("_dx", substr(_s, _b, strpos(substr(_s, _b, .), ",") - 1))
        c_local fx_x0 `_x0'
        c_local fx_dx `_dx'
    end
    // _fx_gen <exp> <lo> <hi> <n>: the generator's own r(min), r(delta).
    capture program drop _fx_gen
    program define _fx_gen
        version 16.0
        args e lo hi n
        preserve
        tempvar fy fx
        quietly twoway__function_gen `macval(e)', range(`lo' `hi') x(x) n(`n') generate(`fy' `fx')
        c_local fx_g0 = r(min)
        c_local fx_gd = r(delta)
        restore
    end

    // ------------------------------------------------------------
    // FX-20: E1's twenty expressions -- stored, saved and served points
    // equal twoway's serset.
    // ------------------------------------------------------------
    sysuse auto, clear
    dash clear
    local fx20_list `" "2^3^x" "2^-1^2" "x^2^-1" "-x^-x^-1" "2^-x^2" "-2^-2^-2" "2^-2^-1" "x^-1^-1" "2^+1" "-2^2" "-x^2" "x*-2^2" "3-2^2" "- -x" "--x" "0.1*3/0.3" "1e16+1-2" "1+0.1-0.7" "10-2-3" "100/10/5" "'
    local k 0
    local fx_names ""
    foreach e of local fx20_list {
        local ++k
        quietly twoway function y = `e', range(0 2) n(3) nodraw
        _fx_serset
        matrix fx_want_`k' = fx_sy
        matrix fx_wantx_`k' = fx_sx
        capture noisily dash function y = `e', range(0 2) n(3) name(fx20_`k') title("fx20_`k'")
        _w29_expect FX-20 "(_rc == 0)" `"dash function y = `e' r(`=_rc')"'
        _fx_stored fx20_`k'
        mata: st_local("fx_eq", strofreal(st_matrix("fx_dy") == st_matrix("fx_sy")))
        _w29_expect FX-20 "(`fx_eq' == 1)" `"`e': stored y differs from twoway's serset"'
        _fx_gen `"y = `e'"' 0 2 3
        _w29_expect FX-20 `"(real("`fx_x0'") == `fx_g0' & real("`fx_dx'") == `fx_gd')"' `"`e': x0 `fx_x0' dx `fx_dx', generator `fx_g0' `fx_gd'"'
        local fx_names `fx_names' fx20_`k'
    }
    local fx20_html "`w29_work'/fx20.html"
    local fx20_app  "`w29_work'/fx20_app.py"
    quietly dash build, saving("`fx20_html'") replace nobrowser
    quietly dash build, saving("`fx20_app'") server replace
    global fx_names "`fx_names'"
    global fx_html "`fx20_html'"
    global fx_app "`fx20_app'"
    python:
import json as _json
import math as _math
import re as _re
import warnings as _w
from sfi import Macro as _M, Matrix as _X, Missing as _Miss
from bokeh.document import Document as _Doc
from bokeh.models import Plot as _Plot


def _fx_plots_saved(path):
    with open(path, encoding="utf-8") as fh:
        page = fh.read()
    out = dict()
    for blob in _re.findall(r'<script type="application/json" id="[^"]*">\s*(.*?)\s*</script>', page, _re.S):
        dj = _json.loads(blob)
        for dd in dj.values():
            doc = _Doc.from_json(dd)
            for p in doc.select(dict(type=_Plot)):
                out[p.title.text if p.title is not None else ""] = p
    return out


def _fx_plots_served(path):
    with open(path, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_s04_app")
    with _w.catch_warnings():
        _w.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_s04_app.py", "exec"), ns)
        doc = _Doc()
        ns["make_document"](doc)
    out = dict()
    for p in doc.select(dict(type=_Plot)):
        out[p.title.text if p.title is not None else ""] = p
    return out


def _fx_xy(plot):
    for g in plot.renderers:
        src = getattr(g, "data_source", None)
        if src is not None and "x_fn" in src.data:
            return [float(v) for v in src.data["x_fn"]], [float(v) for v in src.data["y_fn"]]
    return None, None


def _fx_row(name):
    vals = _X.get(name)[0]
    return [float("nan") if _Miss.isMissing(v) else float(v) for v in vals]


def _fx_same(a, b):
    if len(a) != len(b):
        return False
    for u, v in zip(a, b):
        if _math.isnan(u) and _math.isnan(v):
            continue
        if u != v:
            return False
    return True


def _fx_check(names, html, app):
    bad = []
    for mode, plots in (("saved", _fx_plots_saved(html)), ("served", _fx_plots_served(app))):
        for i, nm in enumerate(names):
            k = nm.split("_")[-1]
            pre = nm.rsplit("_", 1)[0]
            want_y = _fx_row("fx_want_" + k if pre == "fx20" else pre + "_want_" + k)
            want_x = _fx_row("fx_wantx_" + k if pre == "fx20" else pre + "_wantx_" + k)
            x, y = _fx_xy(plots[nm]) if nm in plots else (None, None)
            if y is None:
                bad.append(mode + ":" + nm + ":missing")
                continue
            pairs = sorted(zip(x, y), key=lambda t: t[0])
            if sorted(x) != want_x or not _fx_same([t[1] for t in pairs], want_y):
                bad.append(mode + ":" + nm + ":" + repr(y[:4]))
    return bad


_bad = _fx_check(_M.getGlobal("fx_names").split(), _M.getGlobal("fx_html"), _M.getGlobal("fx_app"))
_M.setGlobal("fx_bad", " ".join(_bad))
end
    _w29_expect FX-20 `"("${fx_bad}" == "")"' `"drawn points differ: ${fx_bad}"'
    _w29_done FX-20 "twenty expressions: the stored, saved and served points are twoway's serset, x0 and dx the generator's"
    dash clear
    capture erase "`fx20_html'"
    capture erase "`fx20_app'"

    // ------------------------------------------------------------
    // FX-21: what only Stata can evaluate -- estimates, scalars, ln(),
    // c(pi) and a variable -- is drawn at twoway's points.
    // ------------------------------------------------------------
    sysuse auto, clear
    dash clear
    quietly regress mpg weight
    scalar s = 2
    gen educ = 7
    local fx21_list `" "_b[_cons]+_b[weight]*x|1760 4840" "s*normalden(x)|0 2" "ln(x)|0.5 2" "c(pi)*x|0 2" "educ*x|0 2" "'
    local k 0
    local fx_names ""
    foreach item of local fx21_list {
        local ++k
        gettoken e rest : item, parse("|")
        local rng = substr(`"`rest'"', 2, .)
        quietly twoway function y = `e', range(`rng') n(5) nodraw
        _fx_serset
        matrix fx21_want_`k' = fx_sy
        matrix fx21_wantx_`k' = fx_sx
        capture noisily dash function y = `e', range(`rng') n(5) name(fx21_`k') title("fx21_`k'")
        _w29_expect FX-21 "(_rc == 0)" `"dash function y = `e' r(`=_rc')"'
        _fx_stored fx21_`k'
        mata: st_local("fx_eq", strofreal(st_matrix("fx_dy") == st_matrix("fx_sy")))
        _w29_expect FX-21 "(`fx_eq' == 1)" `"`e': stored y differs from twoway's serset"'
        local fx_names `fx_names' fx21_`k'
    }
    local fx21_html "`w29_work'/fx21.html"
    local fx21_app  "`w29_work'/fx21_app.py"
    quietly dash build, saving("`fx21_html'") replace nobrowser
    quietly dash build, saving("`fx21_app'") server replace
    global fx_names "`fx_names'"
    global fx_html "`fx21_html'"
    global fx_app "`fx21_app'"
    python:
_bad = _fx_check(_M.getGlobal("fx_names").split(), _M.getGlobal("fx_html"), _M.getGlobal("fx_app"))
_M.setGlobal("fx_bad", " ".join(_bad))
end
    _w29_expect FX-21 `"("${fx_bad}" == "")"' `"drawn points differ: ${fx_bad}"'
    _w29_done FX-21 "estimates, a scalar, ln(), c(pi) and a variable are drawn at twoway's points, saved and served"
    drop educ
    scalar drop s
    dash clear
    capture erase "`fx21_html'"
    capture erase "`fx21_app'"

    // ------------------------------------------------------------
    // FX-22: the caller's version picks the random-number generator.
    // ------------------------------------------------------------
    sysuse auto, clear
    dash clear
    version 13: set seed 1
    version 13: twoway function y = runiform(), n(3) nodraw
    version 13: local fx22_st = c(rngstate)
    _fx_serset
    version 13: set seed 1
    version 13: dash function y = runiform(), n(3) name(fx22)
    version 13: local fx22_dst = c(rngstate)
    _fx_stored fx22
    mata: st_local("fx_eq", strofreal(st_matrix("fx_dy") == st_matrix("fx_sy")))
    _w29_expect FX-22 "(`fx_eq' == 1)" "version 13: stored y differs from version 13's twoway"
    _w29_expect FX-22 `"("`fx22_dst'" == "`fx22_st'")"' "version 13: the random-number state differs from twoway's"
    _w29_done FX-22 "under version 13 the points and the random-number state are version 13's twoway's"
    dash clear

    // ------------------------------------------------------------
    // FX-23: a descending range is the generator's order, drawn as
    // twoway's polyline; a typed range keeps its 17 digits.
    // ------------------------------------------------------------
    sysuse auto, clear
    dash clear
    quietly twoway function y = x^2, range(2 0) n(3) nodraw
    _fx_serset
    matrix fx23_want_1 = fx_sy
    matrix fx23_wantx_1 = fx_sx
    dash function y = x^2, range(2 0) n(3) name(fx23_1) title("fx23_1")
    _w29_expect FX-23 `"(strpos(`"${dash_fpts_fx23_1}"', `""x0":2,"dx":-1,"y":[4,1,0]"') > 0)"' `"stored ${dash_fpts_fx23_1}"'
    dash function y = x, range(0 0.123456789012345678) n(3) name(fx23_2)
    _w29_expect FX-23 `"(strpos(`"${dash_fpts_fx23_2}"', "0.12345678901234568]") > 0)"' `"stored ${dash_fpts_fx23_2}"'
    local fx23_html "`w29_work'/fx23.html"
    local fx23_app  "`w29_work'/fx23_app.py"
    quietly dash build, saving("`fx23_html'") replace nobrowser
    quietly dash build, saving("`fx23_app'") server replace
    global fx_names "fx23_1"
    global fx_html "`fx23_html'"
    global fx_app "`fx23_app'"
    python:
_bad = _fx_check(_M.getGlobal("fx_names").split(), _M.getGlobal("fx_html"), _M.getGlobal("fx_app"))
_M.setGlobal("fx_bad", " ".join(_bad))
end
    _w29_expect FX-23 `"("${fx_bad}" == "")"' `"drawn polyline differs: ${fx_bad}"'
    _w29_done FX-23 "range(2 0) is stored in the generator's order and drawn as twoway's polyline; a typed range keeps 17 digits"
    dash clear
    capture erase "`fx23_html'"
    capture erase "`fx23_app'"

    // ------------------------------------------------------------
    // FX-24: by() -- the documented residual.  twoway evaluates once per
    // panel (by(foreign, total): draws 1-3, 4-6, 7-9); dash once, drawn in
    // every panel: its points are twoway's first panel's, and the state is
    // left after 3 draws where twoway leaves it after 9.
    // ------------------------------------------------------------
    sysuse auto, clear
    dash clear
    preserve
    clear
    quietly set obs 9
    set seed 1
    quietly gen double u = runiform() in 1/3
    local fx24_s3 = c(rngstate)
    quietly replace u = runiform() in 4/9
    local fx24_s9 = c(rngstate)
    mata: st_matrix("fx24_want", st_data((1, 3), "u")')
    restore
    set seed 1
    quietly twoway function y = runiform(), range(0 2) n(3) by(foreign, total) nodraw
    _w29_expect FX-24 `"(c(rngstate) == "`fx24_s9'")"' "twoway's by(foreign, total) did not take nine draws"
    set seed 1
    capture noisily dash function y = runiform(), range(0 2) n(3) by(foreign, total) name(fx24)
    _w29_expect FX-24 "(_rc == 0)" "dash by() r(`=_rc')"
    _w29_expect FX-24 `"(c(rngstate) == "`fx24_s3'")"' "dash did not take exactly three draws"
    _fx_stored fx24
    mata: st_local("fx_eq", strofreal(st_matrix("fx_dy") == st_matrix("fx24_want")))
    _w29_expect FX-24 "(`fx_eq' == 1)" "the stored points are not the first three draws"
    _w29_done FX-24 "by(): one evaluation, twoway's first panel's points, drawn in every panel (the documented residual)"
    dash clear
    macro drop fx_names fx_html fx_app fx_bad
    capture matrix drop fx_sy fx_sx fx_dy fx24_want

    display as text "S04 end `c(current_time)'"
}
* ==== end S04 ====
* ==== S05 P0.8: computed layers on a date in Stata units ====
local only : env WP29_ONLY
if inlist("`only'", "", "S05") {
    display as text "S05 start `c(current_time)'"
    // Every variable the probes generate is a double: a float keeps seven
    // digits, and the comparisons are at 1e-9.
    local du_type = c(type)
    set type double


    // The page and app readers, and the comparisons.  The python blocks
    // hold no brace: Stata still reads a block another WP29_ONLY skips.
    python:
import json as _json
import re as _re
import warnings as _w
from sfi import Macro as _M
from bokeh.document import Document as _Doc
from bokeh.models import Plot as _Plot, Slider as _Slider


def _du_unescape(text):
    ents = dict(amp="&", lt="<", gt=">", quot=chr(34))
    ents["#x27"] = chr(39)
    ents["#x60"] = chr(96)
    return _re.sub(r"&(amp|lt|gt|quot|#x27|#x60);",
                   lambda m: ents[m.group(1)], text)


def _du_read(path):
    # A saved page's one Bokeh document (HE-05's _he5_read).
    with open(path, encoding="utf-8") as fh:
        page = fh.read()
    blocks = _re.findall(
        r'<script type="application/json" id="[^"]+">\s*(.*?)\s*</script>',
        page, _re.S)
    docs = [d for b in blocks
            for d in _json.loads(_du_unescape(b)).values()]
    if len(docs) != 1:
        raise RuntimeError("%s holds %d Bokeh documents" % (path, len(docs)))
    return _Doc.from_json(docs[0])


def _du_app(path):
    # One session of the generated app, its curdoc attach replaced so
    # nothing is served (KF-03).  The app is dash's file, never user data.
    with open(path, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_s05_app")
    with _w.catch_warnings():
        _w.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_s05_app.py", "exec"),
             ns)
        doc = _Doc()
        ns["make_document"](doc)
    return doc


def _du_move(doc, value):
    sl = [s for s in doc.select(dict(type=_Slider))
          if getattr(s, "_dash_var", None) == "close"]
    fired = 0
    if len(sl) == 1:
        old = sl[0].value
        with _w.catch_warnings():
            _w.simplefilter("ignore")
            sl[0].value = value
            for attr in ("value", "value_throttled"):
                for cb in sl[0]._callbacks.get(attr, []):
                    cb(attr, old, value)
                    fired += 1
    return fired


def _du_layers(doc):
    # (plot, data) of every computed layer: no scatter, no row source.
    out = []
    for p in doc.select(dict(type=_Plot)):
        for r in p.renderers:
            g = getattr(r, "glyph", None)
            if g is None or type(g).__name__ == "Scatter":
                continue
            if "__dash_row__" in r.data_source.data:
                continue
            out.append((p, r.data_source.data))
    return out


def _du_col(doc, col):
    hits = [(p, d) for p, d in _du_layers(doc) if col in d]
    if not hits:
        return None, []
    p, d = hits[-1]
    return p, [float(v) for v in d[col]]


def _du_nums(name):
    return [float(t) for t in (_M.getGlobal(name) or "").split()]


def _du_same(a, b, tol):
    return len(a) == len(b) and len(a) > 0 and all(
        abs(x - y) <= tol * abs(y) + 1e-15 for x, y in zip(a, b))


def _du_bars(px, ph, start, width, nbin):
    # twoway__histogram_gen's generate() pairs placed at their bars.
    out = [0.0] * nbin
    for x, h in zip(px, ph):
        i = int((x - start) / width + 1e-7)
        if 0 <= i < nbin:
            out[i] = h
    return out


def _du_axes(p):
    return type(p.xaxis[0]).__name__, type(p.yaxis[0]).__name__


def _du_hist_bad(doc, pre, label):
    bad = []
    p, tops = _du_col(doc, "top")
    _p, left = _du_col(doc, "left")
    nbin = int(float(_M.getGlobal(pre + "_bin")))
    want = _du_bars(_du_nums(pre + "_x"), _du_nums(pre + "_h"),
                    float(_M.getGlobal(pre + "_start")),
                    float(_M.getGlobal(pre + "_width")), nbin)
    if len(tops) != nbin:
        bad.append("%s: %d bars, twoway %d" % (label, len(tops), nbin))
    elif not _du_same(tops, want, 1e-9):
        bad.append("%s: tops %r, twoway %r" % (label, tops[:3], want[:3]))
    lw = _M.getGlobal(pre + "_left")
    if lw and (not left or left[0] != float(lw)):
        bad.append("%s: first left %r, want %s" % (label, left[:1], lw))
    return bad, p


def _du_curve_bad(doc, xcol, ycol, pre, label):
    bad = []
    p, xs = _du_col(doc, xcol)
    _p, ys = _du_col(doc, ycol)
    if not _du_same(ys, _du_nums(pre + "_y"), 1e-9):
        bad.append("%s: y %r, Stata %r" % (label, ys, _du_nums(pre + "_y")))
    if not _du_same(xs, _du_nums(pre + "_xms"), 1e-12):
        bad.append("%s: x %r, Stata (ms) %r" % (label, xs,
                                                 _du_nums(pre + "_xms")))
    return bad, p
end

    sysuse sp500, clear
    keep date close
    generate m = mofd(date)
    format m %tm
    capture dash clear

    // ------------------------------------------------------------
    // DU-01: histogram date, width(30) start(14975): twoway's 13 bars,
    // per day, from 14975 (978220800000 ms), the date on x.
    // ------------------------------------------------------------
    twoway__histogram_gen date, density width(30) start(14975) gen(duh dux, replace)
    global du1_bin   = r(bin)
    global du1_start = r(start)
    global du1_width = r(width)
    global du1_left  = strofreal((r(start) - td(01jan1970))*86400000, "%21.0g")
    mata: _du_v = st_data(., "dux")
    mata: st_global("du1_x", invtokens(strofreal(select(_du_v, _du_v :< .), "%21.0g")'))
    mata: _du_v = st_data(., "duh")
    mata: st_global("du1_h", invtokens(strofreal(select(_du_v, _du_v :< .), "%21.0g")'))
    drop duh dux
    local du1 "`w29_work'/du1.html"
    capture erase "`du1'"
    capture noisily dash histogram date, width(30) start(14975) saving("`du1'", replace)
    local du_rc = _rc
    _w29_expect DU-01 "(`du_rc' == 0)" "dash histogram date, width(30) start(14975) refused: rc `du_rc'"
    _w29_expect DU-01 "(${du1_bin} == 13)" "twoway__histogram_gen gave ${du1_bin} bars, not 13"
    python:
_d = _du_read(_M.getLocal("du1"))
_bad, _p = _du_hist_bad(_d, "du1", "DU-01")
if _p is None or _du_axes(_p) != ("DatetimeAxis", "LinearAxis"):
    _bad.append("axes %r" % (None if _p is None else _du_axes(_p),))
_M.setGlobal("du_bad", "; ".join(_bad))
_M.setGlobal("du_nbad", str(len(_bad)))
end
    _w29_expect DU-01 "(${du_nbad} == 0)" `"${du_bad}"'
    _w29_done DU-01 "13 bars equal twoway__histogram_gen's per day, from 14975, on a date x axis"
    capture erase "`du1'"

    // ------------------------------------------------------------
    // DU-02: histogram m (%tm): the non-empty bars equal twoway's.
    // ------------------------------------------------------------
    twoway__histogram_gen m, density gen(duh dux, replace)
    global du2_bin   = r(bin)
    global du2_start = r(start)
    global du2_width = r(width)
    global du2_left  ""
    mata: _du_v = st_data(., "dux")
    mata: st_global("du2_x", invtokens(strofreal(select(_du_v, _du_v :< .), "%21.0g")'))
    mata: _du_v = st_data(., "duh")
    mata: st_global("du2_h", invtokens(strofreal(select(_du_v, _du_v :< .), "%21.0g")'))
    drop duh dux
    local du2 "`w29_work'/du2.html"
    capture erase "`du2'"
    capture noisily dash histogram m, saving("`du2'", replace)
    local du_rc = _rc
    _w29_expect DU-02 "(`du_rc' == 0)" "dash histogram m refused: rc `du_rc'"
    python:
_d = _du_read(_M.getLocal("du2"))
_bad, _p = _du_hist_bad(_d, "du2", "DU-02")
if _p is None or _du_axes(_p)[0] != "DatetimeAxis":
    _bad.append("axes %r" % (None if _p is None else _du_axes(_p),))
_M.setGlobal("du_bad", "; ".join(_bad))
_M.setGlobal("du_nbad", str(len(_bad)))
end
    _w29_expect DU-02 "(${du_nbad} == 0)" `"${du_bad}"'
    _w29_done DU-02 "a %tm histogram's bars equal twoway__histogram_gen's, on a date x axis"
    capture erase "`du2'"

    // ------------------------------------------------------------
    // DU-03: kdensity date, bwidth(10) range(14900 15400) n(5): y is
    // twoway__kdensity_gen's, x its grid in epoch ms, on a date axis.
    // ------------------------------------------------------------
    twoway__kdensity_gen date, gen(dud dux) n(5) range(14900 15400) bwidth(10)
    generate double duxms = (dux - td(01jan1970))*86400000
    mata: _du_v = st_data(., "dud")
    mata: st_global("du3_y", invtokens(strofreal(select(_du_v, _du_v :< .), "%21.0g")'))
    mata: _du_v = st_data(., "duxms")
    mata: st_global("du3_xms", invtokens(strofreal(select(_du_v, _du_v :< .), "%21.0g")'))
    drop dud dux duxms
    local du3 "`w29_work'/du3.html"
    capture erase "`du3'"
    capture noisily dash kdensity date, bwidth(10) range(14900 15400) n(5) saving("`du3'", replace)
    local du_rc = _rc
    _w29_expect DU-03 "(`du_rc' == 0)" "dash kdensity date refused: rc `du_rc'"
    python:
_d = _du_read(_M.getLocal("du3"))
_bad, _p = _du_curve_bad(_d, "x", "y", "du3", "DU-03")
if _p is None or _du_axes(_p)[0] != "DatetimeAxis":
    _bad.append("axes %r" % (None if _p is None else _du_axes(_p),))
_M.setGlobal("du_bad", "; ".join(_bad))
_M.setGlobal("du_nbad", str(len(_bad)))
end
    _w29_expect DU-03 "(${du_nbad} == 0)" `"${du_bad}"'
    _w29_done DU-03 "kdensity of a date equals twoway__kdensity_gen per day, drawn at its dates"
    capture erase "`du3'"

    // ------------------------------------------------------------
    // DU-04: lpoly close date, bwidth(30) n(5): Stata's curve, at its
    // grid in epoch ms, on a date axis.
    // ------------------------------------------------------------
    quietly lpoly close date, nograph gen(dux duy) n(5) bwidth(30)
    generate double duxms = (dux - td(01jan1970))*86400000
    mata: _du_v = st_data(., "duy")
    mata: st_global("du4_y", invtokens(strofreal(select(_du_v, _du_v :< .), "%21.0g")'))
    mata: _du_v = st_data(., "duxms")
    mata: st_global("du4_xms", invtokens(strofreal(select(_du_v, _du_v :< .), "%21.0g")'))
    drop dux duy duxms
    local du4 "`w29_work'/du4.html"
    capture erase "`du4'"
    capture noisily dash lpoly close date, bwidth(30) n(5) saving("`du4'", replace)
    local du_rc = _rc
    _w29_expect DU-04 "(`du_rc' == 0)" "dash lpoly close date refused: rc `du_rc'"
    python:
_d = _du_read(_M.getLocal("du4"))
_bad, _p = _du_curve_bad(_d, "x_lp", "y_lp", "du4", "DU-04")
if _p is None or _du_axes(_p)[0] != "DatetimeAxis":
    _bad.append("axes %r" % (None if _p is None else _du_axes(_p),))
_M.setGlobal("du_bad", "; ".join(_bad))
_M.setGlobal("du_nbad", str(len(_bad)))
end
    _w29_expect DU-04 "(${du_nbad} == 0)" `"${du_bad}"'
    _w29_done DU-04 "lpoly over a date, bwidth(30) in days, is Stata's curve at its dates"
    capture erase "`du4'"

    // ------------------------------------------------------------
    // DU-05: fpfit close date: the first and last fitted values equal
    // fracpoly's predictions.
    // ------------------------------------------------------------
    preserve
    sort date
    quietly fracpoly: regress close date
    quietly predict double dufp
    global du5_y = strofreal(dufp[1], "%21.0g") + " " + strofreal(dufp[_N], "%21.0g")
    restore
    local du5 "`w29_work'/du5.html"
    capture erase "`du5'"
    capture noisily dash fpfit close date, saving("`du5'", replace)
    local du_rc = _rc
    _w29_expect DU-05 "(`du_rc' == 0)" "dash fpfit close date refused: rc `du_rc'"
    python:
_d = _du_read(_M.getLocal("du5"))
_p, _ys = _du_col(_d, "y_fp")
_bad = []
if not _ys or not _du_same([_ys[0], _ys[-1]], _du_nums("du5_y"), 1e-9):
    _bad.append("y_fp ends %r, fracpoly %r" % (_ys[:1] + _ys[-1:],
                                               _du_nums("du5_y")))
_M.setGlobal("du_bad", "; ".join(_bad))
_M.setGlobal("du_nbad", str(len(_bad)))
end
    _w29_expect DU-05 "(${du_nbad} == 0)" `"${du_bad}"'
    _w29_done DU-05 "fpfit over a date equals fracpoly's predictions"
    capture erase "`du5'"

    // ------------------------------------------------------------
    // DU-06: the served app of DU-01's histogram and DU-04's lpoly with
    // a close slider: as opened, and after the slider moves to 1200
    // (the served app re-bins and refits from the kept rows).
    // ------------------------------------------------------------
    twoway__histogram_gen date if close >= 1200, density width(30) start(14975) gen(duh dux, replace)
    global du6_bin   = r(bin)
    global du6_start = r(start)
    global du6_width = r(width)
    global du6_left  = strofreal((r(start) - td(01jan1970))*86400000, "%21.0g")
    mata: _du_v = st_data(., "dux")
    mata: st_global("du6_x", invtokens(strofreal(select(_du_v, _du_v :< .), "%21.0g")'))
    mata: _du_v = st_data(., "duh")
    mata: st_global("du6_h", invtokens(strofreal(select(_du_v, _du_v :< .), "%21.0g")'))
    drop duh dux
    quietly lpoly close date if close >= 1200, nograph gen(dux duy) n(5) bwidth(30)
    generate double duxms = (dux - td(01jan1970))*86400000
    mata: _du_v = st_data(., "duy")
    mata: st_global("du7_y", invtokens(strofreal(select(_du_v, _du_v :< .), "%21.0g")'))
    mata: _du_v = st_data(., "duxms")
    mata: st_global("du7_xms", invtokens(strofreal(select(_du_v, _du_v :< .), "%21.0g")'))
    drop dux duy duxms
    capture dash clear
    quietly dash histogram date, width(30) start(14975) name(du6h)
    quietly dash lpoly close date, bwidth(30) n(5) name(du6l)
    local du6 "`w29_work'/du6_app.py"
    capture erase "`du6'"
    capture noisily dash build, saving("`du6'") server replace filter(close, type(slider))
    local du_rc = _rc
    _w29_expect DU-06 "(`du_rc' == 0)" "dash build, server refused: rc `du_rc'"
    python:
_d = _du_app(_M.getLocal("du6"))
_b1, _p = _du_hist_bad(_d, "du1", "DU-06 opened")
_b2, _p = _du_curve_bad(_d, "x_lp", "y_lp", "du4", "DU-06 opened")
_f = _du_move(_d, 1200.0)
_b3, _p = _du_hist_bad(_d, "du6", "DU-06 moved")
_b4, _p = _du_curve_bad(_d, "x_lp", "y_lp", "du7", "DU-06 moved")
_bad = _b1 + _b2 + _b3 + _b4
if _f != 1:
    _bad.append("the close slider fired %d callbacks" % _f)
_M.setGlobal("du_bad", "; ".join(_bad))
_M.setGlobal("du_nbad", str(len(_bad)))
end
    _w29_expect DU-06 "(${du_nbad} == 0)" `"${du_bad}"'
    _w29_done DU-06 "served: bars and lpoly equal Stata's, opened and after the close slider moves to 1200"
    capture erase "`du6'"

    capture dash clear
    set type `du_type'
    macro drop du1_* du2_* du3_* du4_* du5_* du6_* du7_* du_bad du_nbad
    capture mata: mata drop _du_v
    display as text "S05 end `c(current_time)'"
}
* ==== end S05 ====
* ==== S05 P0.20: KPI statistics of a date in Stata units ====
local only : env WP29_ONLY
if inlist("`only'", "", "S05") {
    display as text "S05 P0.20 start `c(current_time)'"

    // The card readers (KF-01/KF-03's) and the comparison.  The python
    // block holds no brace: Stata still reads a block another WP29_ONLY
    // skips.
    python:
import html as _kd_html
import re as _kd_re
import warnings as _kd_w
from sfi import Macro as _KM
from bokeh.document import Document as _KDoc
from bokeh.models import Div as _KDiv, Slider as _KSlider


def _kd_card(text, name):
    m = _kd_re.search(r'id=\\"kpi_val_' + _kd_re.escape(name)
                      + r'\\"[^&]*&gt;(.*?)&lt;/div&gt;', text)
    return None if m is None else _kd_html.unescape(m.group(1))


def _kd_served_card(text, name):
    m = _kd_re.search(r'id="kpi_val_' + _kd_re.escape(name)
                      + r'"[^>]*>(.*?)</div>', text or "")
    return None if m is None else _kd_html.unescape(m.group(1))


def _kd_session(path):
    with open(path, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_s05_kpi_app")
    with _kd_w.catch_warnings():
        _kd_w.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_s05_kpi_app.py",
                     "exec"), ns)
        doc = _KDoc()
        ns["make_document"](doc)
    return doc


def _kd_served(doc, names):
    out = dict()
    for d in doc.select(dict(type=_KDiv)):
        for n in names:
            v = _kd_served_card(d.text, n)
            if v is not None:
                out[n] = v
    return out


def _kd_move(doc, value):
    sl = [s for s in doc.select(dict(type=_KSlider))
          if getattr(s, "_dash_var", None) == "close"]
    fired = 0
    if len(sl) == 1:
        old = sl[0].value
        with _kd_w.catch_warnings():
            _kd_w.simplefilter("ignore")
            sl[0].value = value
            for attr in ("value", "value_throttled"):
                for cb in sl[0]._callbacks.get(attr, []):
                    cb(attr, old, value)
                    fired += 1
    return fired


def _kd_compare(got, names, prefix, label):
    bad = []
    for n in names:
        want = _KM.getGlobal(prefix + n)
        if got.get(n) != want:
            bad.append("%s %s: card %r, Stata %r" % (label, n, got.get(n),
                                                     want))
    return bad
end

    // ------------------------------------------------------------
    // KD-01 / KD-02: sd var iqr cv sum skewness of date and mean p50 of m
    // on the saved page, and served as opened and after the close slider
    // moves to 1200, against summarize's display text, live.
    // ------------------------------------------------------------
    sysuse sp500, clear
    keep date close
    generate m = mofd(date)
    format m %tm
    global kd_names "kd1 kd2 kd3 kd4 kd5 kd6 kd7 kd8"
    foreach scope in all if {
        if "`scope'" == "all" {
            local kd_if ""
            local kd_p "kd_want_"
        }
        else {
            local kd_if "if close >= 1200"
            local kd_p "kd_wantif_"
        }
        quietly summarize date `kd_if', detail
        local v : display %9.0g r(sd)
        global `kd_p'kd1 = strtrim("`v'")
        local v : display %9.0g r(Var)
        global `kd_p'kd2 = strtrim("`v'")
        local v : display %9.0g r(p75) - r(p25)
        global `kd_p'kd3 = strtrim("`v'")
        local v : display %9.0g r(sd)/r(mean)
        global `kd_p'kd4 = strtrim("`v'")
        local v : display %9.0g r(sum)
        global `kd_p'kd5 = strtrim("`v'")
        local v : display %9.0g r(skewness)
        global `kd_p'kd6 = strtrim("`v'")
        quietly summarize m `kd_if', detail
        local v : display %tm r(mean)
        global `kd_p'kd7 = strtrim("`v'")
        local v : display %tm r(p50)
        global `kd_p'kd8 = strtrim("`v'")
    }
    capture dash clear
    quietly dash scatter close date, name(g1)
    quietly dash kpi sd(date), name(kd1) title("T")
    quietly dash kpi var(date), name(kd2) title("T")
    quietly dash kpi iqr(date), name(kd3) title("T")
    quietly dash kpi cv(date), name(kd4) title("T")
    quietly dash kpi sum(date), name(kd5) title("T")
    quietly dash kpi skewness(date), name(kd6) title("T")
    quietly dash kpi mean(m), name(kd7) title("T")
    quietly dash kpi p50(m), name(kd8) title("T")
    local kd_html "`w29_work'/kd_cards.html"
    local kd_app  "`w29_work'/kd_cards_app.py"
    capture erase "`kd_html'"
    capture erase "`kd_app'"
    capture noisily dash build, saving("`kd_html'") replace nobrowser filter(close, type(slider))
    local kd_rc1 = _rc
    capture noisily dash build, saving("`kd_app'") server replace filter(close, type(slider))
    local kd_rc2 = _rc
    python:
_names = _KM.getGlobal("kd_names").split()
with open(_KM.getLocal("kd_html"), encoding="utf-8") as _fh:
    _page = _fh.read()
_saved = dict((n, _kd_card(_page, n)) for n in _names)
_b1 = _kd_compare(_saved, _names, "kd_want_", "saved")
_doc = _kd_session(_KM.getLocal("kd_app"))
_b2 = _kd_compare(_kd_served(_doc, _names), _names, "kd_want_", "served opened")
_f = _kd_move(_doc, 1200.0)
_b2 += _kd_compare(_kd_served(_doc, _names), _names, "kd_wantif_",
                   "served moved")
if _f != 1:
    _b2.append("the close slider fired %d callbacks" % _f)
_KM.setGlobal("kd_bad1", "; ".join(_b1))
_KM.setGlobal("kd_n1", str(len(_b1)))
_KM.setGlobal("kd_bad2", "; ".join(_b2))
_KM.setGlobal("kd_n2", str(len(_b2)))
end
    _w29_expect KD-01 "(`kd_rc1' == 0)" "dash build (saved) refused: rc `kd_rc1'"
    _w29_expect KD-01 "(${kd_n1} == 0)" `"${kd_bad1}"'
    _w29_done KD-01 "saved cards of sd var iqr cv sum skewness (date) and mean p50 (m) are summarize's"
    _w29_expect KD-02 "(`kd_rc2' == 0)" "dash build, server refused: rc `kd_rc2'"
    _w29_expect KD-02 "(${kd_n2} == 0)" `"${kd_bad2}"'
    _w29_done KD-02 "served cards are summarize's, opened and after the close slider moves to 1200"
    capture erase "`kd_html'"
    capture erase "`kd_app'"

    // ------------------------------------------------------------
    // KD-03: the mean of 2001m1 and 2001m3 is 2001m2, saved and served.
    // ------------------------------------------------------------
    clear
    quietly set obs 2
    generate m = 492 + 2*(_n-1)
    format m %tm
    generate close = _n
    quietly summarize m
    local v : display %tm r(mean)
    global kd_want_kd9 = strtrim("`v'")
    global kd_names "kd9"
    capture dash clear
    quietly dash scatter close m, name(g1)
    quietly dash kpi mean(m), name(kd9) title("T")
    local kd_html "`w29_work'/kd3_cards.html"
    local kd_app  "`w29_work'/kd3_cards_app.py"
    capture erase "`kd_html'"
    capture erase "`kd_app'"
    capture noisily dash build, saving("`kd_html'") replace nobrowser
    local kd_rc1 = _rc
    capture noisily dash build, saving("`kd_app'") server replace
    local kd_rc2 = _rc
    python:
with open(_KM.getLocal("kd_html"), encoding="utf-8") as _fh:
    _page = _fh.read()
_b3 = _kd_compare(dict(kd9=_kd_card(_page, "kd9")), ["kd9"], "kd_want_",
                  "saved")
_b3 += _kd_compare(_kd_served(_kd_session(_KM.getLocal("kd_app")), ["kd9"]),
                   ["kd9"], "kd_want_", "served")
_KM.setGlobal("kd_bad3", "; ".join(_b3))
_KM.setGlobal("kd_n3", str(len(_b3)))
end
    _w29_expect KD-03 "(`kd_rc1' == 0 & `kd_rc2' == 0)" "dash build refused: rc `kd_rc1' / `kd_rc2'"
    _w29_expect KD-03 `"("${kd_want_kd9}" == "2001m2")"' "summarize's mean displays ${kd_want_kd9}"
    _w29_expect KD-03 "(${kd_n3} == 0)" `"${kd_bad3}"'
    _w29_done KD-03 "mean(m) of 2001m1 and 2001m3 reads 2001m2, saved and served"
    capture erase "`kd_html'"
    capture erase "`kd_app'"

    capture dash clear
    macro drop kd_*
    display as text "S05 P0.20 end `c(current_time)'"
}
* ==== end S05 ====
* ==== S06 P0.10: hover() variables exported ====
local only : env WP29_ONLY
if inlist("`only'", "", "S06") {
    display as text "S06 start `c(current_time)'"

    // Every variable hover() names is exported and shown, its value-label
    // text equal row by row to Stata's own `: label (var) value', on the
    // one-line route, through dash build and in the served app, before
    // and after a filter move, under by() and link(), for dates, strings
    // and a Unicode name.  twoway has no hover() (it refuses the option,
    // r(198)), so the truth is Stata's own text per observation, computed
    // here into the scratch variable _hx_lab after each case's dash
    // commands.  The python blocks read only the generated files and
    // Stata's data; they hold no brace, so a WP29_ONLY that skips this
    // block still reads it.  The work directory is this run's own fresh
    // one (the scaffold's w29_work), never a fixed name in c(tmpdir).
    local d "`w29_work'/s06"
    capture mkdir "`d'"

    python:
import base64 as _hx_b64
import json as _hx_json
import re as _hx_re
import struct as _hx_struct
import warnings as _hx_w
from sfi import Data as _hx_D
from sfi import Macro as _hx_M

_HX_O = chr(123)
_HX_C = chr(125)
_HX_FMT = dict(float64="d", float32="f", float16="e", int64="q",
               int32="i", int16="h", int8="b", uint64="Q", uint32="I",
               uint16="H", uint8="B", bool="?")
_HX_REP = "Repair record 1978"
_HX_GROSSE = "gr" + chr(246) + chr(223) + "e"


def _hx_field(name):
    return "@" + _HX_O + name + _HX_C


def _hx_cols_named(field):
    # The column names a tooltip field reads, as @<open>name<close>.
    pat = "@" + chr(92) + _HX_O + "([^" + _HX_C + "]*)" + chr(92) + _HX_C
    return _hx_re.findall(pat, field)


def _hx_safe(text):
    # A message Stata may echo: printable ASCII, no quote, backtick,
    # dollar or backslash, at most 240 characters.
    s = "".join(ch if (32 <= ord(ch) < 127 and ch not in chr(34) + chr(96)
                       + chr(36) + chr(92) + chr(39)) else "?"
                for ch in str(text))
    return s if len(s) <= 240 else s[:237] + "..."


def _hx_set(k, bad):
    _hx_M.setGlobal("hx_n" + k, str(len(bad)))
    _hx_M.setGlobal("hx_bad" + k, _hx_safe(" | ".join(bad) or "none"))


def _hx_dec(v):
    if isinstance(v, dict) and v.get("type") == "ndarray":
        arr = v.get("array")
        if isinstance(arr, dict) and arr.get("type") == "bytes":
            raw = _hx_b64.b64decode(arr.get("data", ""))
            f = _HX_FMT.get(str(v.get("dtype")))
            if f is None or len(raw) % _hx_struct.calcsize(f):
                return None
            n = len(raw) // _hx_struct.calcsize(f)
            return list(_hx_struct.unpack("<%d%s" % (n, f), raw))
        return arr if isinstance(arr, list) else None
    return v


def _hx_walk(o, tips, cols):
    if isinstance(o, dict):
        if o.get("type") == "map" and isinstance(o.get("entries"), list):
            for e in o["entries"]:
                if (isinstance(e, list) and len(e) == 2
                        and isinstance(e[0], str)):
                    v = _hx_dec(e[1])
                    if isinstance(v, list) and e[0] not in cols:
                        cols[e[0]] = v
        for key, v in o.items():
            if key == "tooltips" and isinstance(v, list):
                for row in v:
                    if isinstance(row, list) and len(row) == 2:
                        tips.append((str(row[0]), str(row[1])))
            _hx_walk(v, tips, cols)
    elif isinstance(o, list):
        for x in o:
            _hx_walk(x, tips, cols)


def _hx_page(path):
    # (tooltip rows, columns, raw text) of a saved page, its JSON decoded
    # (review A2: Bokeh writes non-ASCII escaped).
    with open(path, encoding="utf-8") as fh:
        raw = fh.read()
    tips, cols = [], dict()
    pat = r'<script type="application/json"[^>]*>(.*?)</script>'
    for body in _hx_re.findall(pat, raw, _hx_re.S):
        _hx_walk(_hx_json.loads(body), tips, cols)
    return tips, cols, raw


def _hx_app(path):
    # The generated app, loaded as KF-03 loads it: its curdoc attach is
    # replaced, so nothing is served.
    from bokeh.document import Document
    with open(path, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_s06_app")
    with _hx_w.catch_warnings():
        _hx_w.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_s06_app.py",
                     "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    return doc


def _hx_tools(doc):
    from bokeh.models import HoverTool
    return [t for t in doc.select(dict(type=HoverTool))
            if isinstance(t.tooltips, list)]


def _hx_rows(tool):
    return [(str(a), str(b)) for a, b in tool.tooltips]


def _hx_sources(tools):
    seen, out = set(), []
    for t in tools:
        for r in t.renderers:
            s = r.data_source
            if id(s) not in seen:
                seen.add(id(s))
                out.append(s)
    return out


def _hx_fire(w, value):
    with _hx_w.catch_warnings():
        _hx_w.simplefilter("ignore")
        w.value = value
        for key in ("value", "value_throttled"):
            for cb in list(w._callbacks.get(key, [])):
                cb("value", None, value)


def _hx_col(name):
    return [r[0] if isinstance(r, list) else r for r in _hx_D.get(name)]


def _hx_truth():
    return dict(zip(_hx_col("make"), _hx_col("_hx_lab")))


def _hx_saved_rep(k, path):
    bad = []
    try:
        tips, cols, raw = _hx_page(path)
    except Exception as e:
        _hx_set(k, ["page not read: %s %s" % (type(e).__name__, e)])
        return
    want = (_HX_REP, _hx_field("__dash_hover_rep78"))
    if want not in tips:
        bad.append("no tooltip row %r in %r" % (want, tips[:6]))
    for word in ("Poor", "Fair", "Average", "Good", "Excellent"):
        if word not in raw:
            bad.append("the page holds no %s" % word)
    lab = _hx_col("_hx_lab")
    got = cols.get("__dash_hover_rep78")
    if got is None:
        bad.append("no column __dash_hover_rep78")
    elif [str(x) for x in got] != lab:
        diff = [i for i in range(min(len(got), len(lab)))
                if str(got[i]) != lab[i]]
        bad.append("labels: %d entries, %d differ, first %r" % (
            len(got), len(diff), diff[:3]))
    elif lab.count(".") != 5:
        bad.append("%d missing labels, not 5" % lab.count("."))
    mpg = cols.get("mpg")
    if mpg is None or [float(x) for x in mpg] != [float(x) for x in
                                                  _hx_col("mpg")]:
        bad.append("column mpg is not Stata's mpg in order")
    _hx_set(k, bad)


def _hx_served_rep(k, path, keep=None):
    # keep: None (as opened), or the makes the move keeps.
    bad = []
    try:
        doc = _hx_app(path)
    except Exception as e:
        _hx_set(k, ["app not loaded: %s" % type(e).__name__])
        return None
    _hx_set(k, bad)
    return doc


def _hx_check_rep_tools(k, doc, keep, onefor=False):
    bad = []
    want = (_HX_REP, _hx_field("__dash_hover_rep78"))
    tools = [t for t in _hx_tools(doc) if want in _hx_rows(t)]
    if not tools:
        bad.append("no tooltip shows %r" % (want,))
    elif not all(any(f.startswith(_hx_field("make")) for _l, f in
                     _hx_rows(t)) for t in tools):
        bad.append("a tooltip has no make field")
    truth = _hx_truth()
    makes = []
    for s in _hx_sources(tools):
        data = s.data
        if "__dash_hover_rep78" not in data or "make" not in data:
            bad.append("a source lacks __dash_hover_rep78 or make")
            continue
        ms = [str(m) for m in data["make"]]
        ls = [str(x) for x in data["__dash_hover_rep78"]]
        makes.extend(ms)
        off = [m for m, x in zip(ms, ls) if truth.get(m) != x]
        if off:
            bad.append("%d rows show the wrong label, first %r" % (
                len(off), off[:2]))
        if onefor:
            fr = dict(zip(_hx_col("make"), _hx_col("foreign")))
            if len(set(fr.get(m) for m in ms)) > 1:
                bad.append("a source mixes foreign values")
    if keep is None:
        if len(makes) != 74 or len(set(makes)) != 74:
            bad.append("%d rows, not 74" % len(makes))
    elif sorted(makes) != sorted(keep):
        bad.append("%d rows kept, Stata keeps %d" % (len(makes), len(keep)))
    _hx_set(k, bad)
end

    // ------------------------------------------------------------
    // HX-01: the one-line route, saved.  rep78 is named only in hover().
    // ------------------------------------------------------------
    sysuse auto, clear
    label define alrep 1 "Poor" 2 "Fair" 3 "Average" 4 "Good" 5 "Excellent", replace
    label values rep78 alrep
    dash clear
    capture erase "`d'/hx1.html"
    capture noisily dash scatter mpg weight, hover(rep78) saving("`d'/hx1.html") replace
    local hx_rc = _rc
    capture drop _hx_lab
    quietly generate str244 _hx_lab = ""
    forvalues i = 1/`=_N' {
        local hx_l : label (rep78) `=rep78[`i']'
        quietly replace _hx_lab = `"`hx_l'"' in `i'
    }
    global hx_f1 "`d'/hx1.html"
    python:
_hx_saved_rep("1", _hx_M.getGlobal("hx_f1"))
end
    _w29_expect HX-01 "(`hx_rc' == 0)" "dash rc `hx_rc'"
    _w29_expect HX-01 "(${hx_n1} == 0)" `"${hx_bad1}"'
    _w29_done HX-01 "hover(rep78) alone: its labels on every row, 74 rows, saved one-line"

    // ------------------------------------------------------------
    // HX-02: name() then dash build, saved.
    // ------------------------------------------------------------
    drop _hx_lab
    dash clear
    capture erase "`d'/hx2.html"
    quietly dash scatter mpg weight, hover(rep78) name(g1)
    capture noisily dash build, saving("`d'/hx2.html") replace nobrowser
    local hx_rc = _rc
    quietly generate str244 _hx_lab = ""
    forvalues i = 1/`=_N' {
        local hx_l : label (rep78) `=rep78[`i']'
        quietly replace _hx_lab = `"`hx_l'"' in `i'
    }
    global hx_f2 "`d'/hx2.html"
    python:
_hx_saved_rep("2", _hx_M.getGlobal("hx_f2"))
end
    _w29_expect HX-02 "(`hx_rc' == 0)" "dash build rc `hx_rc'"
    _w29_expect HX-02 "(${hx_n2} == 0)" `"${hx_bad2}"'
    _w29_done HX-02 "hover(rep78) alone through dash build: the same, saved"

    // ------------------------------------------------------------
    // HX-03: the served app as opened.
    // ------------------------------------------------------------
    drop _hx_lab
    dash clear
    capture erase "`d'/hx3.py"
    quietly dash scatter mpg weight, hover(rep78 make) name(g1)
    capture noisily dash build, server saving("`d'/hx3.py") replace nobrowser
    local hx_rc = _rc
    quietly generate str244 _hx_lab = ""
    forvalues i = 1/`=_N' {
        local hx_l : label (rep78) `=rep78[`i']'
        quietly replace _hx_lab = `"`hx_l'"' in `i'
    }
    global hx_f3 "`d'/hx3.py"
    python:
_hx_doc = _hx_served_rep("3", _hx_M.getGlobal("hx_f3"))
if _hx_doc is not None:
    _hx_check_rep_tools("3", _hx_doc, None)
end
    _w29_expect HX-03 "(`hx_rc' == 0)" "dash build, server rc `hx_rc'"
    _w29_expect HX-03 "(${hx_n3} == 0)" `"${hx_bad3}"'
    _w29_done HX-03 "served as opened: rep78's labels and make on all 74 rows"

    // ------------------------------------------------------------
    // HX-04: the served app after a dropdown move to Foreign.
    // ------------------------------------------------------------
    drop _hx_lab
    dash clear
    capture erase "`d'/hx4.py"
    quietly dash scatter mpg weight, hover(rep78 make) name(g1)
    capture noisily dash build, server saving("`d'/hx4.py") replace nobrowser filter(foreign, type(dropdown))
    local hx_rc = _rc
    quietly count if foreign == 1
    local hx_nf = r(N)
    quietly generate str244 _hx_lab = ""
    forvalues i = 1/`=_N' {
        local hx_l : label (rep78) `=rep78[`i']'
        quietly replace _hx_lab = `"`hx_l'"' in `i'
    }
    global hx_f4 "`d'/hx4.py"
    python:
_hx_doc = _hx_served_rep("4", _hx_M.getGlobal("hx_f4"))
if _hx_doc is not None:
    from bokeh.models import Select as _hx_Select
    _hx_keep = [m for m, f in zip(_hx_col("make"), _hx_col("foreign"))
                if f == 1]
    _hx_sel = [w for w in _hx_doc.select(dict(type=_hx_Select))
               if getattr(w, "_dash_var", None) == "foreign"]
    _hx_raw = [o[0] for o in (_hx_sel[0].options if _hx_sel else [])
               if isinstance(o, (list, tuple)) and o[1] == "Foreign"]
    if len(_hx_sel) != 1 or not _hx_raw:
        _hx_set("4", ["no foreign dropdown with a Foreign option"])
    else:
        _hx_fire(_hx_sel[0], _hx_raw[0])
        _hx_check_rep_tools("4", _hx_doc, _hx_keep)
end
    _w29_expect HX-04 "(`hx_rc' == 0)" "dash build, server rc `hx_rc'"
    _w29_expect HX-04 "(`hx_nf' == 22)" "Stata counts `hx_nf' foreign cars"
    _w29_expect HX-04 "(${hx_n4} == 0)" `"${hx_bad4}"'
    _w29_done HX-04 "served after a move to Foreign: 22 rows, each its own labels"

    // ------------------------------------------------------------
    // HX-05: served, by(foreign), after a price range move.
    // ------------------------------------------------------------
    drop _hx_lab
    dash clear
    capture erase "`d'/hx5.py"
    quietly dash scatter mpg weight, by(foreign) hover(rep78 make) name(g1)
    capture noisily dash build, server saving("`d'/hx5.py") replace nobrowser filter(price, type(range))
    local hx_rc = _rc
    quietly generate str244 _hx_lab = ""
    forvalues i = 1/`=_N' {
        local hx_l : label (rep78) `=rep78[`i']'
        quietly replace _hx_lab = `"`hx_l'"' in `i'
    }
    global hx_f5 "`d'/hx5.py"
    python:
_hx_doc = _hx_served_rep("5", _hx_M.getGlobal("hx_f5"))
if _hx_doc is not None:
    from bokeh.models import RangeSlider as _hx_RS
    _hx_keep = [m for m, p in zip(_hx_col("make"), _hx_col("price"))
                if 5000 <= p <= 15906]
    _hx_rs = [w for w in _hx_doc.select(dict(type=_hx_RS))
              if getattr(w, "_dash_var", None) == "price"]
    if len(_hx_rs) != 1:
        _hx_set("5", ["%d price range sliders" % len(_hx_rs)])
    else:
        _hx_fire(_hx_rs[0], (5000.0, 15906.0))
        _hx_check_rep_tools("5", _hx_doc, _hx_keep, onefor=True)
end
    _w29_expect HX-05 "(`hx_rc' == 0)" "dash build, server rc `hx_rc'"
    _w29_expect HX-05 "(${hx_n5} == 0)" `"${hx_bad5}"'
    _w29_done HX-05 "served by(foreign) after a range move: Stata's rows, one origin per panel, each its own labels"
    drop _hx_lab

    // ------------------------------------------------------------
    // HX-06: a date and a number named only in hover(), both modes.
    // ------------------------------------------------------------
    sysuse sp500, clear
    dash clear
    capture erase "`d'/hx6.html"
    capture erase "`d'/hx6.py"
    capture noisily dash scatter close open, hover(date volume) saving("`d'/hx6.html") replace
    local hx_rc = _rc
    quietly dash scatter close open, hover(date volume) name(g1)
    capture noisily dash build, server saving("`d'/hx6.py") replace nobrowser
    local hx_rc2 = _rc
    global hx_f6 "`d'/hx6.html"
    global hx_f6s "`d'/hx6.py"
    python:
_hx_bad = []
try:
    _hx_t, _hx_c, _hx_r = _hx_page(_hx_M.getGlobal("hx_f6"))
    _hx_f = [f for _l, f in _hx_t]
    if (_hx_field("date") + _HX_O + "custom" + _HX_C) not in _hx_f:
        _hx_bad.append("saved: no date field in %r" % (_hx_f[:6],))
    if not any(f.startswith(_hx_field("volume")) for f in _hx_f):
        _hx_bad.append("saved: no volume field")
except Exception as e:
    _hx_bad.append("page not read: %s %s" % (type(e).__name__, e))
try:
    _hx_doc = _hx_app(_hx_M.getGlobal("hx_f6s"))
    _hx_f = [f for t in _hx_tools(_hx_doc) for _l, f in _hx_rows(t)]
    if (_hx_field("date") + _HX_O + "custom" + _HX_C) not in _hx_f:
        _hx_bad.append("served: no date field in %r" % (_hx_f[:6],))
    if not any(f.startswith(_hx_field("volume")) for f in _hx_f):
        _hx_bad.append("served: no volume field")
except Exception as e:
    _hx_bad.append("app not loaded: %s" % type(e).__name__)
_hx_set("6", _hx_bad)
end
    _w29_expect HX-06 "(`hx_rc' == 0 & `hx_rc2' == 0)" "dash rc `hx_rc' / `hx_rc2'"
    _w29_expect HX-06 "(${hx_n6} == 0)" `"${hx_bad6}"'
    _w29_done HX-06 "hover(date volume): the date field and volume, saved and served"

    // ------------------------------------------------------------
    // HX-07: a string and a Unicode name named only in hover().
    // ------------------------------------------------------------
    sysuse auto, clear
    generate größe = mpg
    dash clear
    capture erase "`d'/hx7.html"
    capture erase "`d'/hx7.py"
    capture noisily dash scatter mpg weight, hover(make größe) saving("`d'/hx7.html") replace
    local hx_rc = _rc
    quietly dash scatter mpg weight, hover(make größe) name(g1)
    capture noisily dash build, server saving("`d'/hx7.py") replace nobrowser
    local hx_rc2 = _rc
    global hx_f7 "`d'/hx7.html"
    global hx_f7s "`d'/hx7.py"
    python:
_hx_bad = []
try:
    _hx_t, _hx_c, _hx_r = _hx_page(_hx_M.getGlobal("hx_f7"))
    _hx_f = [f for _l, f in _hx_t]
    if not any(f.startswith(_hx_field(_HX_GROSSE)) for f in _hx_f):
        _hx_bad.append("saved: no field for the Unicode variable")
    if not any(f.startswith(_hx_field("make")) for f in _hx_f):
        _hx_bad.append("saved: no make field")
    if len(_hx_c.get(_HX_GROSSE) or []) != 74:
        _hx_bad.append("saved: the Unicode column has %d entries" % len(
            _hx_c.get(_HX_GROSSE) or []))
    if (_hx_c.get("make") or [None])[0] != "AMC Concord":
        _hx_bad.append("saved: make does not start AMC Concord")
except Exception as e:
    _hx_bad.append("page not read: %s %s" % (type(e).__name__, e))
try:
    from bokeh.models import ColumnDataSource as _hx_CDS
    _hx_doc = _hx_app(_hx_M.getGlobal("hx_f7s"))
    if not any(_HX_GROSSE in s.data
               for s in _hx_doc.select(dict(type=_hx_CDS))):
        _hx_bad.append("served: no source holds the Unicode variable")
except Exception as e:
    _hx_bad.append("app not loaded: %s" % type(e).__name__)
_hx_set("7", _hx_bad)
end
    _w29_expect HX-07 "(`hx_rc' == 0 & `hx_rc2' == 0)" "dash rc `hx_rc' / `hx_rc2'"
    _w29_expect HX-07 "(${hx_n7} == 0)" `"${hx_bad7}"'
    _w29_done HX-07 "hover(make größe): a string and a Unicode name exported in both modes"

    // ------------------------------------------------------------
    // HX-08: link() of two graphs, each with its own hover() variable.
    // ------------------------------------------------------------
    sysuse auto, clear
    label define alrep 1 "Poor" 2 "Fair" 3 "Average" 4 "Good" 5 "Excellent", replace
    label values rep78 alrep
    dash clear
    capture erase "`d'/hx8.html"
    capture erase "`d'/hx8.py"
    quietly dash scatter mpg weight, hover(rep78) name(g1)
    quietly dash scatter price weight, hover(headroom) name(g2)
    capture noisily dash build, link(g1 g2) filter(foreign, type(dropdown)) saving("`d'/hx8.html") replace nobrowser
    local hx_rc = _rc
    capture noisily dash build, server link(g1 g2) filter(foreign, type(dropdown)) saving("`d'/hx8.py") replace nobrowser
    local hx_rc2 = _rc
    global hx_f8 "`d'/hx8.html"
    global hx_f8s "`d'/hx8.py"
    python:
_hx_bad = []
try:
    _hx_t, _hx_c, _hx_r = _hx_page(_hx_M.getGlobal("hx_f8"))
    _hx_l = set(lab for lab, _f in _hx_t)
    for _hx_w8 in (_HX_REP, "Headroom (in.)"):
        if _hx_w8 not in _hx_l:
            _hx_bad.append("saved: no row labelled %r" % _hx_w8)
except Exception as e:
    _hx_bad.append("page not read: %s %s" % (type(e).__name__, e))
try:
    _hx_doc = _hx_app(_hx_M.getGlobal("hx_f8s"))
    _hx_ts = _hx_tools(_hx_doc)
    _hx_l = set(lab for t in _hx_ts for lab, _f in _hx_rows(t))
    for _hx_w8 in (_HX_REP, "Headroom (in.)"):
        if _hx_w8 not in _hx_l:
            _hx_bad.append("served: no row labelled %r" % _hx_w8)
    for t in _hx_ts:
        _hx_need = [c for _l, f in _hx_rows(t) for c in _hx_cols_named(f)]
        for r in t.renderers:
            data = r.data_source.data
            _hx_gone = [c for c in _hx_need if c not in data]
            if _hx_gone:
                _hx_bad.append("served: a source lacks %r" % (_hx_gone,))
            _hx_n = max((len(v) for v in data.values()), default=0)
            if _hx_n != 74:
                _hx_bad.append("served: a source has %d rows" % _hx_n)
except Exception as e:
    _hx_bad.append("app not loaded: %s" % type(e).__name__)
_hx_set("8", _hx_bad)
end
    _w29_expect HX-08 "(`hx_rc' == 0 & `hx_rc2' == 0)" "dash build rc `hx_rc' / `hx_rc2'"
    _w29_expect HX-08 "(${hx_n8} == 0)" `"${hx_bad8}"'
    _w29_done HX-08 "link(g1 g2): each graph's hover() variable labelled, every field on every source"

    forvalues k = 1/8 {
        capture erase "`d'/hx`k'.html"
        capture erase "`d'/hx`k'.py"
    }
    capture rmdir "`d'"
    dash clear
    macro drop hx_*
    display as text "S06 end `c(current_time)'"
}
* ==== end S06 ====
* ==== S07 P0.16: colorvar key from the layer's rows ====
local only : env WP29_ONLY
if inlist("`only'", "", "S07") {
    display as text "S07 start `c(current_time)'"

    // twoway draws a colorvar() key from the observations the plot draws:
    // its own if/in, the graph's and its by() panel's, an observation
    // whose y or x is missing included.  Each case exports twoway's SVG
    // live and compares dash's saved and served pages with it and with
    // Stata's own summarize/levelsof.  Globals carry numbers and file
    // names only; the python blocks never call back into Stata.
    python:
import os, sys
sys.path.insert(0, os.path.abspath("."))
sys.path.insert(0, os.path.abspath(os.path.join("..", "scripts")))
import filter_truth_check as ftc
import colour_bins as _cqv_cb
from svg_truth import svg_document as _cqv_doc
from sfi import Macro as _cqv_M


def _cqv_g(name):
    return _cqv_M.getGlobal(name)


def _cqv_texts(path):
    return [t["text"] for t in _cqv_doc(path)["texts"]]


def _cqv_num(t):
    try:
        return float(str(t).replace(",", ""))
    except ValueError:
        return None


def _cqv_key_numbers(path):
    """The numbers twoway writes right of the plot region: its key."""
    d = _cqv_doc(path)
    pr = d["plotregion"] or {}
    return [t["text"] for t in d["texts"] if pr and t.get("x") is not None
            and t["x"] > pr["right"] and _cqv_num(t["text"]) is not None]


def _cqv_matches(b, key_texts):
    """Does bound *b* round to one of twoway's key texts, at the text's
    own precision?"""
    for t in key_texts:
        v = _cqv_num(t)
        dec = len(t.split(".", 1)[1]) if "." in t else 0
        if v is not None and abs(b - v) <= 0.5 * 10 ** (-dec) + 1e-9:
            return True
    return False


def _cqv_inner(factors):
    out = set()
    for lo, hi in _cqv_cb.interval_bounds(factors):
        out |= {x for x in (lo, hi) if x is not None}
    s = sorted(out)
    return s[1:-1]


def _cqv_fills(path):
    """(in-region circle fills in document order, counts over every
    circle)."""
    d = _cqv_doc(path)
    pr = d["plotregion"] or {}
    cs = [c for c in d["circles"] if c.get("fill") and c["fill"] != "none"]
    inside = [c["fill"] for c in cs if pr and c.get("cx") is not None
              and pr["left"] <= c["cx"] <= pr["right"]
              and pr["top"] <= c["cy"] <= pr["bottom"]]
    counts = {}
    for c in cs:
        counts[c["fill"]] = counts.get(c["fill"], 0) + 1
    return inside, counts


def _cqv_keys():
    return ftc.colour_keys(_cqv_g("cqv_spec"), _cqv_g("cqv_data"))


def _cqv_cut_case():
    keys = _cqv_key_numbers(_cqv_g("cqv_svg"))
    k = _cqv_keys()
    inner = {m: [_cqv_inner(fs) for f in k[m] for fs in f["factors"]]
             for m in ("saved", "served")}
    ok = "9,598.5" in keys and all(
        v and all(x == [9598.5] for x in v) for v in inner.values())
    _cqv_put(ok, "twoway key %s; dash interior bounds %s" % (keys, inner))


def _cqv_put(ok, why):
    ftc.put("cqv_ok", int(bool(ok)))
    ftc.put("cqv_why", why if not ok else "")

end

    // ------------------------------------------------------------
    // CQV-01: a plot's own if sets its continuous key's range.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway (scatter mpg weight if foreign==1, colorvar(price)) ///
        (scatter mpg weight if foreign==0), name(cqv1, replace)
    cert_svg_export, name(cqv1) file("`w29_work'/cqv1.svg")
    global cqv_svg "`r(file)'"
    quietly summarize price if foreign == 1
    global cqv_min = r(min)
    global cqv_max = r(max)
    dash clear
    dash (scatter mpg weight if foreign==1, colorvar(price)) ///
        (scatter mpg weight if foreign==0), name(cqv1)
    tempfile cqv1s cqv1d
    global cqv_spec "`cqv1s'"
    global cqv_data "`cqv1d'"
    _dash_serve_spec, specpath("${cqv_spec}") datapath("${cqv_data}")
    python:
t = _cqv_texts(_cqv_g("cqv_svg"))
want = [float(_cqv_g("cqv_min")), float(_cqv_g("cqv_max"))]
k = _cqv_keys()
got = {m: k[m][0]["bars"] for m in ("saved", "served")}
ok = ("4,000" in t and "14,000" in t and "15,000" not in t
      and all(got[m] == [want] for m in got))
_cqv_put(ok, "twoway key %s; dash bars %s, want %s" % (
    [x for x in t if _cqv_num(x) is not None], got, want))
end
    _w29_expect CQV-01 "${cqv_ok}" "${cqv_why}"
    _w29_done CQV-01 "the bar spans summarize price if foreign==1 (${cqv_min} to ${cqv_max}) in both modes; twoway's key is 4,000-14,000"
    capture graph drop cqv1

    // ------------------------------------------------------------
    // CQV-02: colordiscrete levels of a plot's own if.
    // ------------------------------------------------------------
    quietly twoway (scatter mpg weight if foreign==1, colorvar(rep78) ///
        colordiscrete) (scatter mpg weight if foreign==0), name(cqv2, replace)
    cert_svg_export, name(cqv2) file("`w29_work'/cqv2.svg")
    global cqv_svg "`r(file)'"
    quietly count if foreign == 1
    global cqv_n = r(N)
    quietly levelsof rep78 if foreign == 1
    global cqv_levels "`r(levels)'"
    dash clear
    dash (scatter mpg weight if foreign==1, colorvar(rep78) colordiscrete) ///
        (scatter mpg weight if foreign==0), name(cqv2)
    tempfile cqv2s cqv2d
    global cqv_spec "`cqv2s'"
    global cqv_data "`cqv2d'"
    _dash_serve_spec, specpath("${cqv_spec}") datapath("${cqv_data}")
    python:
inside, _c = _cqv_fills(_cqv_g("cqv_svg"))
n = int(_cqv_g("cqv_n"))
groups = {f for f in inside[:n] if f != "#808080"}
want = _cqv_g("cqv_levels").split()
k = _cqv_keys()
got = {m: k[m][0]["factors"] for m in ("saved", "served")}
ok = len(groups) == 3 and all(got[m] == [want] for m in got)
_cqv_put(ok, "twoway %d non-gray groups; dash factors %s, want %s" % (
    len(groups), got, want))
end
    _w29_expect CQV-02 "${cqv_ok}" "${cqv_why}"
    _w29_done CQV-02 "the levels are levelsof rep78 if foreign==1 (${cqv_levels}) in both modes, twoway's three colours"
    capture graph drop cqv2

    // ------------------------------------------------------------
    // CQV-03: colorlevels(3) cuts of a plot's own if.
    // ------------------------------------------------------------
    quietly twoway (scatter mpg weight if foreign==1, colorvar(price) ///
        colorlevels(3)) (scatter mpg weight if foreign==0), name(cqv3, replace)
    cert_svg_export, name(cqv3) file("`w29_work'/cqv3.svg")
    global cqv_svg "`r(file)'"
    dash clear
    dash (scatter mpg weight if foreign==1, colorvar(price) colorlevels(3)) ///
        (scatter mpg weight if foreign==0), name(cqv3)
    tempfile cqv3s cqv3d
    global cqv_spec "`cqv3s'"
    global cqv_data "`cqv3d'"
    _dash_serve_spec, specpath("${cqv_spec}") datapath("${cqv_data}")
    python:
keys = _cqv_key_numbers(_cqv_g("cqv_svg"))
k = _cqv_keys()
inner = {m: _cqv_inner(k[m][0]["factors"][0]) for m in ("saved", "served")}
ok = ("6,828.7" in keys and "9,909.3" in keys and all(
    len(v) == 2 and all(_cqv_matches(b, ["6,828.7", "9,909.3"]) for b in v)
    for v in inner.values()))
_cqv_put(ok, "twoway key %s; dash interior bounds %s" % (keys, inner))
end
    _w29_expect CQV-03 "${cqv_ok}" "${cqv_why}"
    _w29_done CQV-03 "the interior bounds are twoway's 6,828.7 and 9,909.3 in both modes"
    capture graph drop cqv3

    // ------------------------------------------------------------
    // CQV-04: a linked graph's own if sets its key's range.
    // ------------------------------------------------------------
    quietly twoway scatter mpg weight if foreign==1, colorvar(price) ///
        name(cqv4, replace)
    cert_svg_export, name(cqv4) file("`w29_work'/cqv4.svg")
    global cqv_svg "`r(file)'"
    quietly summarize price if foreign == 1
    global cqv_min = r(min)
    global cqv_max = r(max)
    dash clear
    dash scatter mpg weight if foreign == 1, colorvar(price) name(c4a)
    dash scatter mpg weight, name(c4b)
    tempfile cqv4s cqv4d
    global cqv_spec "`cqv4s'"
    global cqv_data "`cqv4d'"
    _dash_serve_spec, specpath("${cqv_spec}") datapath("${cqv_data}") ///
        link(c4a c4b)
    python:
t = _cqv_texts(_cqv_g("cqv_svg"))
want = [float(_cqv_g("cqv_min")), float(_cqv_g("cqv_max"))]
k = _cqv_keys()
got = {m: [b for f in k[m] for b in f["bars"]] for m in ("saved", "served")}
ok = "14,000" in t and "15,000" not in t and all(
    got[m] == [want] for m in got)
_cqv_put(ok, "dash bars %s, want %s" % (got, want))
end
    _w29_expect CQV-04 "${cqv_ok}" "${cqv_why}"
    _w29_done CQV-04 "a linked graph's if: the bar spans ${cqv_min} to ${cqv_max} in both modes"
    capture graph drop cqv4

    // ------------------------------------------------------------
    // CQV-05: by(foreign) colorlevels(4), linked: each panel its own.
    // ------------------------------------------------------------
    quietly twoway scatter mpg weight, colorvar(price) colorlevels(4) ///
        by(foreign) name(cqv5, replace)
    cert_svg_export, name(cqv5) file("`w29_work'/cqv5.svg")
    global cqv_svg "`r(file)'"
    quietly twoway scatter mpg weight if foreign==0, colorvar(price) ///
        colorlevels(4) name(cqv5a, replace)
    cert_svg_export, name(cqv5a) file("`w29_work'/cqv5a.svg")
    global cqv_svga "`r(file)'"
    quietly twoway scatter mpg weight if foreign==1, colorvar(price) ///
        colorlevels(4) name(cqv5b, replace)
    cert_svg_export, name(cqv5b) file("`w29_work'/cqv5b.svg")
    global cqv_svgb "`r(file)'"
    dash clear
    dash scatter mpg weight, colorvar(price) colorlevels(4) by(foreign) ///
        name(c5a)
    dash scatter mpg weight, name(c5b)
    tempfile cqv5s cqv5d
    global cqv_spec "`cqv5s'"
    global cqv_data "`cqv5d'"
    _dash_serve_spec, specpath("${cqv_spec}") datapath("${cqv_data}") ///
        link(c5a c5b)
    python:
ka = _cqv_key_numbers(_cqv_g("cqv_svga"))
kb = _cqv_key_numbers(_cqv_g("cqv_svgb"))
_i, cby = _cqv_fills(_cqv_g("cqv_svg"))
_i, ca = _cqv_fills(_cqv_g("cqv_svga"))
_i, cb_ = _cqv_fills(_cqv_g("cqv_svgb"))
panels_ok = all(
    cby.get(c, 0) == max(ca.get(c, 0) - 1, 0) + max(cb_.get(c, 0) - 1, 0)
    for c in set(cby) | set(ca) | set(cb_))
k = _cqv_keys()
why, ok = [], panels_ok
for m in ("saved", "served"):
    figs = [f for f in k[m] if f["factors"]]
    inner = [_cqv_inner(f["factors"][0]) for f in figs]
    good = (len(inner) == 2 and len(inner[0]) == 3 and len(inner[1]) == 3
            and all(_cqv_matches(b, ka) for b in inner[0])
            and all(_cqv_matches(b, kb) for b in inner[1]))
    ok = ok and good
    why.append("%s %s" % (m, inner))

_cqv_put(ok, "twoway panels %s / %s; by() counts per panel %s; dash %s" % (
    ka, kb, panels_ok, "; ".join(why)))
end
    _w29_expect CQV-05 "${cqv_ok}" "${cqv_why}"
    _w29_done CQV-05 "each linked by() panel's cuts are its own single-panel twoway key, in both modes"
    capture graph drop cqv5 cqv5a cqv5b

    // ------------------------------------------------------------
    // CQV-06..08: an observation whose y or x is missing counts.
    // ------------------------------------------------------------
    quietly gen y2 = mpg if price < 15000
    quietly gen x2 = weight if price < 15000
    // CQV-06: scatter y2 weight
    quietly twoway scatter y2 weight, colorvar(price) colorlevels(2) ///
        name(cqv6, replace)
    cert_svg_export, name(cqv6) file("`w29_work'/cqv6.svg")
    global cqv_svg "`r(file)'"
    dash clear
    dash scatter y2 weight, colorvar(price) colorlevels(2) name(cqv6)
    tempfile cqv6s cqv6d
    global cqv_spec "`cqv6s'"
    global cqv_data "`cqv6d'"
    _dash_serve_spec, specpath("${cqv_spec}") datapath("${cqv_data}")
    python:
_cqv_cut_case()
end
    _w29_expect CQV-06 "${cqv_ok}" "${cqv_why}"
    _w29_done CQV-06 "scatter y2 weight, colorlevels(2): the cut is twoway's 9,598.5 in both modes"
    capture graph drop cqv6
    // CQV-07: scatter mpg x2
    quietly twoway scatter mpg x2, colorvar(price) colorlevels(2) ///
        name(cqv7, replace)
    cert_svg_export, name(cqv7) file("`w29_work'/cqv7.svg")
    global cqv_svg "`r(file)'"
    dash clear
    dash scatter mpg x2, colorvar(price) colorlevels(2) name(cqv7)
    tempfile cqv7s cqv7d
    global cqv_spec "`cqv7s'"
    global cqv_data "`cqv7d'"
    _dash_serve_spec, specpath("${cqv_spec}") datapath("${cqv_data}")
    python:
_cqv_cut_case()
end
    _w29_expect CQV-07 "${cqv_ok}" "${cqv_why}"
    _w29_done CQV-07 "scatter mpg x2, colorlevels(2): the cut is twoway's 9,598.5 in both modes"
    capture graph drop cqv7
    // CQV-08: connected y2 weight
    quietly twoway connected y2 weight, colorvar(price) colorlevels(2) ///
        name(cqv8, replace)
    cert_svg_export, name(cqv8) file("`w29_work'/cqv8.svg")
    global cqv_svg "`r(file)'"
    dash clear
    dash connected y2 weight, colorvar(price) colorlevels(2) name(cqv8)
    tempfile cqv8s cqv8d
    global cqv_spec "`cqv8s'"
    global cqv_data "`cqv8d'"
    _dash_serve_spec, specpath("${cqv_spec}") datapath("${cqv_data}")
    python:
_cqv_cut_case()
end
    _w29_expect CQV-08 "${cqv_ok}" "${cqv_why}"
    _w29_done CQV-08 "connected y2 weight, colorlevels(2): the cut is twoway's 9,598.5 in both modes"
    capture graph drop cqv8
    drop y2 x2

    // ------------------------------------------------------------
    // CQV-09: rconnected draws one key.
    // ------------------------------------------------------------
    quietly gen lo = mpg - 2
    quietly twoway rconnected lo mpg weight, colorvar(price) ///
        name(cqv9, replace)
    cert_svg_export, name(cqv9) file("`w29_work'/cqv9.svg")
    global cqv_svg "`r(file)'"
    dash clear
    dash rconnected lo mpg weight, colorvar(price) name(cqv9)
    tempfile cqv9s cqv9d
    global cqv_spec "`cqv9s'"
    global cqv_data "`cqv9d'"
    _dash_serve_spec, specpath("${cqv_spec}") datapath("${cqv_data}")
    python:
n_title = sum(1 for t in _cqv_texts(_cqv_g("cqv_svg")) if t == "Price")
k = _cqv_keys()
got = {m: sum(f["keys"] for f in k[m]) for m in ("saved", "served")}
ok = n_title == 1 and all(v == 1 for v in got.values())
_cqv_put(ok, "twoway draws Price %d time(s); dash keys %s" % (n_title, got))
end
    _w29_expect CQV-09 "${cqv_ok}" "${cqv_why}"
    _w29_done CQV-09 "rconnected draws one key, as twoway's one Price title"
    drop lo
    capture graph drop cqv9

    dash clear
    capture erase "`w29_work'/cqv1.svg"
    forvalues i = 2/9 {
        capture erase "`w29_work'/cqv`i'.svg"
    }
    capture erase "`w29_work'/cqv5a.svg"
    capture erase "`w29_work'/cqv5b.svg"
    macro drop cqv_*
    display as text "S07 end `c(current_time)'"
}
* ==== end S07 ====

* ==== S08 P0.12b, P0.14: private temporary files ====
local only : env WP29_ONLY
if inlist("`only'", "", "S08") {
    display as text "S08 start `c(current_time)'"
    // dash's temporary copies of the data (spec, data, the served app and
    // the one-line preview) are 0600 in a 0700 c(tmpdir)dash-<uid>/ folder
    // and removed when the command ends; a location that cannot be private
    // is noted once, never refused (section 08 R-8, ratified 01oct2026).
    // twoway is the truth for what a command leaves behind (PF-01) and for
    // the mode of a page the user names (PF-03).  The uid and pid come from
    // Python (c(pid) does not exist, A1); paths are compared as spelled
    // from c(tmpdir), never through realpath (A2).  The python blocks hold
    // no brace, so a WP29_ONLY that skips this block still reads it.
    sysuse auto, clear
    set linesize 255
    local pf_tmp "`c(tmpdir)'"
    local d8 "`w29_work'/s08"
    capture mkdir "`d8'"
    python:
import json as _pf_json
import os as _pf_os
import re as _pf_re
import shutil as _pf_shutil
import stat as _pf_stat
import sys as _pf_sys
from sfi import Macro as _pf_M

_PF_UID = _pf_os.getuid()
_PF_PID = _pf_os.getpid()
_PF_TMP = _pf_M.getLocal("pf_tmp")
_PF_ROOT = _pf_os.path.join(_PF_TMP, "dash-%d" % _PF_UID)
_PF_FB = _pf_re.compile("^dash-%d-" % _PF_UID + "[a-z0-9_]" * 8 + "$")
_PF_RUN = _pf_re.compile("^run-%d-[A-Za-z0-9_]+$" % _PF_PID)
_pf_M.setLocal("pf_pid", str(_PF_PID))
_pf_M.setLocal("pf_uid", str(_PF_UID))


def _pf_safe(s):
    s = str(s)
    for ch in (chr(34), chr(39), chr(96), chr(36)):
        s = s.replace(ch, " ")
    return s[:600]


def _pf_mode(p):
    try:
        return oct(_pf_stat.S_IMODE(_pf_os.lstat(p).st_mode))
    except OSError:
        return "none"


def _pf_log_lines(p):
    try:
        with open(p, encoding="utf-8", errors="replace") as fh:
            t = fh.read()
    except OSError:
        return []
    t = t.replace(chr(13), "").replace(chr(10) + "> ", "")
    return t.split(chr(10))


def _pf_notes(p):
    return [x for x in _pf_log_lines(p) if x.startswith("dash: note:")]


def _pf_roots():
    out = []
    try:
        names = sorted(_pf_os.listdir(_PF_TMP))
    except OSError:
        return out
    for n in names:
        p = _pf_os.path.join(_PF_TMP, n)
        if (n == "dash-%d" % _PF_UID or _PF_FB.match(n)) and \
                _pf_os.path.isdir(p) and not _pf_os.path.islink(p):
            out.append(p)
    return out


def _pf_my_pages():
    pages = []
    for r in _pf_roots():
        d = _pf_os.path.join(r, "previews")
        if _pf_os.path.isdir(d) and not _pf_os.path.islink(d):
            for n in _pf_os.listdir(d):
                if n.startswith("dash-preview-") and \
                        ("-%d-" % _PF_PID) in n:
                    pages.append(_pf_os.path.join(d, n))
    return sorted(pages, key=lambda p: (_pf_os.lstat(p).st_mtime, p))


def _pf_my_runs():
    out = []
    for r in _pf_roots():
        for n in _pf_os.listdir(r):
            if _PF_RUN.match(n):
                out.append(_pf_os.path.join(r, n))
    return out


def _pf_walk():
    work = _pf_M.getLocal("w29_work")
    seen = set()
    for dp, dns, fns in _pf_os.walk(_PF_TMP):
        if dp.startswith(work):
            continue
        for f in fns:
            seen.add(_pf_os.path.join(dp, f))
    return seen


def _pf_set(case, bad):
    _pf_M.setLocal(case + "_bad", str(len(bad)))
    _pf_M.setLocal(case + "_why", _pf_safe("; ".join(bad)))
end

    // ------------------------------------------------------------
    // PF-01 (truth guard): twoway leaves no file anywhere in c(tmpdir).
    // ------------------------------------------------------------
    // Stata keeps each graph in memory in its own session files (SG<pid>.*,
    // SJ<pid>.*) until the graph is dropped, so the graphs are dropped
    // before the second snapshot: what is measured is what twoway leaves.
    quietly twoway scatter mpg price, name(pf01w, replace)
    capture graph drop pf01w
    python: _pf_before = _pf_walk()
    quietly twoway scatter mpg weight, name(pf01a, replace)
    quietly twoway line mpg weight, sort name(pf01b, replace)
    capture graph drop pf01a pf01b
    python: _pf_new = sorted(_pf_walk() - _pf_before)
    python: _pf_set("pf01", ["twoway added " + _pf_os.path.basename(x) for x in _pf_new])
    _w29_expect PF-01 "(`pf01_bad' == 0)" `"`pf01_why'"'
    _w29_done PF-01 "twoway scatter and twoway line leave no file under c(tmpdir)"

    // ------------------------------------------------------------
    // PF-02: three one-line previews, then dash clear, leave no page of
    // this session: no St<pid>*.html in c(tmpdir), no dash-preview of
    // this pid; the root and previews/ are 0700.
    // ------------------------------------------------------------
    capture dash clear
    capture noisily {
        dash scatter mpg weight
        dash scatter mpg price
        dash line mpg weight, sort
        dash clear
    }
    local pf02rc = _rc
    python:
_pf_b = []
if _pf_M.getLocal("pf02rc") != "0":
    _pf_b.append("the previews or dash clear ended rc " + _pf_M.getLocal("pf02rc"))
for _n in _pf_os.listdir(_PF_TMP):
    if _pf_re.match(r"^St0*%d[.]" % _PF_PID, _n) and _n.endswith(".html"):
        _pf_b.append(_n + " remains in c(tmpdir)")
for _p in _pf_my_pages():
    _pf_b.append(_pf_os.path.basename(_p) + " remains in previews")
if _pf_mode(_PF_ROOT) != "0o700":
    _pf_b.append("the root is " + _pf_mode(_PF_ROOT))
if _pf_mode(_pf_os.path.join(_PF_ROOT, "previews")) != "0o700":
    _pf_b.append("previews/ is " + _pf_mode(_pf_os.path.join(_PF_ROOT, "previews")))
_pf_set("pf02", _pf_b)
end
    _w29_expect PF-02 "(`pf02_bad' == 0)" `"`pf02_why'"'
    _w29_done PF-02 "three previews and dash clear leave no page of this session; root and previews/ are 0700"

    // ------------------------------------------------------------
    // PF-03 (parity guard): dash's saving(.html) has the mode twoway's
    // saving(.gph) and graph export .svg have, under this runner's umask.
    // ------------------------------------------------------------
    capture erase "`d8'/pf03.html"
    capture noisily {
        dash scatter mpg weight, saving("`d8'/pf03.html")
        quietly twoway scatter mpg weight, saving("`d8'/pf03.gph", replace) name(pf03, replace)
        quietly graph export "`d8'/pf03.svg", replace name(pf03)
    }
    local pf03rc = _rc
    python:
_pf_ms = [_pf_mode(_pf_os.path.join(_pf_M.getLocal("d8"), "pf03" + x)) for x in (".html", ".gph", ".svg")]
_pf_b = [] if (_pf_M.getLocal("pf03rc") == "0" and _pf_ms[0] == _pf_ms[1] == _pf_ms[2] and _pf_ms[0] != "none") else ["modes html/gph/svg " + " ".join(_pf_ms) + " rc " + _pf_M.getLocal("pf03rc")]
_pf_set("pf03", _pf_b)
_pf_M.setLocal("pf03_m", _pf_ms[0])
end
    _w29_expect PF-03 "(`pf03_bad' == 0)" `"`pf03_why'"'
    _w29_done PF-03 "dash saving(.html), twoway saving(.gph) and graph export .svg are all `pf03_m'"
    capture graph drop pf03

    // ------------------------------------------------------------
    // PF-04: the one-line preview is 0600, owned, in a 0700 previews/
    // under a 0700 root, its path spelled from c(tmpdir), and the
    // "dashboard saved to" line names it.
    // ------------------------------------------------------------
    capture log close pf04
    quietly log using "`d8'/pf04.log", text replace name(pf04)
    capture noisily dash scatter mpg weight
    local pf04rc = _rc
    quietly log close pf04
    python:
_pf_b = []
_pf_pg = _pf_my_pages()
if not _pf_pg:
    _pf_b.append("no preview of pid %d under dash-%d/previews" % (_PF_PID, _PF_UID))
else:
    _p = _pf_pg[-1]
    if _pf_mode(_p) != "0o600":
        _pf_b.append("page " + _pf_mode(_p))
    if _pf_os.lstat(_p).st_uid != _PF_UID:
        _pf_b.append("page not owned by the uid")
    if _pf_mode(_pf_os.path.dirname(_p)) != "0o700":
        _pf_b.append("previews/ " + _pf_mode(_pf_os.path.dirname(_p)))
    if _pf_mode(_pf_os.path.dirname(_pf_os.path.dirname(_p))) != "0o700":
        _pf_b.append("root " + _pf_mode(_pf_os.path.dirname(_pf_os.path.dirname(_p))))
    if not _p.startswith(_PF_TMP):
        _pf_b.append("path not spelled from c(tmpdir)")
    _said = [x for x in _pf_log_lines(_pf_os.path.join(_pf_M.getLocal("d8"), "pf04.log")) if x.startswith("dash: dashboard saved to") and _pf_os.path.basename(_p) in x]
    if not _said:
        _pf_b.append("the saved-to line does not name the page")
if _pf_M.getLocal("pf04rc") != "0":
    _pf_b.append("rc " + _pf_M.getLocal("pf04rc"))
_pf_set("pf04", _pf_b)
end
    _w29_expect PF-04 "(`pf04_bad' == 0)" `"`pf04_why'"'
    _w29_done PF-04 "the preview is 0600 in a 0700 previews/ and root, and the log names it"

    // ------------------------------------------------------------
    // PF-05: the spec writer reproduces Macro.getLocal exactly (a backtick
    // and dollar sequence, and 300 KB with compound quotes, a backslash and
    // CJK), and _dash_empty_data writes its JSON plus one newline.
    // ------------------------------------------------------------
    capture noisily _dash_xm_load
    local pf05rc = _rc
    mata: st_local("pf05a", char(96) + "x' " + char(36) + "y " + char(96) + "c(pid)'")
    mata: st_local("pf05b", (char(96) + char(34) + "q" + char(34) + char(39) + " " + char(92) + " 中文 ") * 30000)
    capture erase "`d8'/pf05e.json"
    capture noisily _dash_empty_data "`d8'/pf05e.json"
    local pf05erc = _rc
    python:
def _pf05():
    bad = []
    if _pf_M.getLocal("pf05rc") != "0":
        bad.append("_dash_xm_load rc " + _pf_M.getLocal("pf05rc"))
    xm = _pf_sys.modules.get("_dash_render_export")
    if xm is None or not hasattr(xm, "_dash_tmp_write_text"):
        bad.append("no _dash_tmp_write_text")
        return bad
    d = _pf_M.getLocal("d8")
    for k in ("pf05a", "pf05b"):
        v = _pf_M.getLocal(k)
        p = _pf_os.path.join(d, k + ".json")
        r = xm._dash_tmp_write_text(p, v)
        with open(p, encoding="utf-8") as fh:
            got = fh.read()
        if r != "" or got != v:
            bad.append("%s differs (%d vs %d chars)" % (k, len(got), len(v)))
        if _pf_mode(p) != "0o600":
            bad.append(k + " " + _pf_mode(p))
    e = _pf_os.path.join(d, "pf05e.json")
    if _pf_M.getLocal("pf05erc") != "0":
        bad.append("_dash_empty_data rc " + _pf_M.getLocal("pf05erc"))
        return bad
    with open(e, encoding="utf-8") as fh:
        t = fh.read()
    want = dict(values=[], variableIsString=dict(), variableNames=[],
                variableLabels=dict(), valueLabelNames=dict(),
                valueLabels=dict(), numberOfRecords=0, numberOfVariables=0)
    if not t.endswith(chr(10)) or chr(10) in t[:-1]:
        bad.append("the empty data does not end in exactly one newline")
    elif _pf_json.loads(t) != want:
        bad.append("the empty data is not the empty layout")
    if _pf_mode(e) != "0o600":
        bad.append("empty data " + _pf_mode(e))
    return bad


try:
    _pf_set("pf05", _pf05())
except Exception as _e:
    _pf_set("pf05", ["raised " + repr(_e)])
end
    _w29_expect PF-05 "(`pf05_bad' == 0)" `"`pf05_why'"'
    _w29_done PF-05 "the spec writer keeps the text exactly, 0600; the empty data is its JSON and one newline"

    // ------------------------------------------------------------
    // The stand-in renderer for PF-06 and PF-12's dash serve route: first
    // on the ado-path, it records the modes of --spec, --data and their
    // folder, the folder, and whether --private-output was passed, and
    // writes --output with a plain open.  Its folder is named from
    // c(tmpdir) and the Python pid.
    // ------------------------------------------------------------
    local pf_sd "`pf_tmp'dash_pf06_`pf_pid'"
    capture mkdir "`pf_sd'"
    tempname pfh
    file open `pfh' using "`pf_sd'/dash_render.py", write text replace
    file write `pfh' `"import os, stat, sys"' _n
    file write `pfh' `"_a = sys.argv[1:]"' _n
    file write `pfh' `"_v = lambda k: _a[_a.index(k) + 1] if k in _a else """' _n
    file write `pfh' `"def _m(p):"' _n
    file write `pfh' `"    try:"' _n
    file write `pfh' `"        return oct(stat.S_IMODE(os.lstat(p).st_mode))"' _n
    file write `pfh' `"    except OSError:"' _n
    file write `pfh' `"        return "none""' _n
    file write `pfh' `"_s = _v("--spec")"' _n
    file write `pfh' `"_d = _v("--data")"' _n
    file write `pfh' `"_dir = os.path.dirname(_s)"' _n
    file write `pfh' `"_pv = "1" if "--private-output" in _a else "0""' _n
    file write `pfh' `"_ln = " ".join([_m(_s), _m(_d), _m(_dir), _pv, _dir])"' _n
    file write `pfh' `"_r = os.path.join(os.path.dirname(os.path.abspath(__file__)), "rec.txt")"' _n
    file write `pfh' `"open(_r, "a", encoding="utf-8").write(_ln + chr(10))"' _n
    file write `pfh' `"open(_v("--output"), "w", encoding="utf-8").write("x")"' _n
    file close `pfh'
    python:
def _pf06_check(route, want_priv):
    rec = _pf_os.path.join(_pf_M.getLocal("pf_sd"), "rec.txt")
    try:
        with open(rec, encoding="utf-8") as fh:
            last = fh.read().strip().split(chr(10))[-1]
    except OSError:
        return [route + ": the stand-in recorded nothing"]
    f = last.split(" ", 4)
    bad = []
    if len(f) < 5:
        return [route + ": record " + last]
    if f[0] != "0o600" or f[1] != "0o600":
        bad.append(route + ": spec " + f[0] + " data " + f[1])
    if f[2] != "0o700":
        bad.append(route + ": folder " + f[2])
    if not _PF_RUN.match(_pf_os.path.basename(f[4])):
        bad.append(route + ": folder " + _pf_os.path.basename(f[4]))
    if f[3] != want_priv:
        bad.append(route + ": --private-output " + f[3])
    if _pf_os.path.lexists(f[4]) and _PF_RUN.match(_pf_os.path.basename(f[4])):
        bad.append(route + ": the run folder is still there")
    return bad


_pf06_bad = []
end

    // ------------------------------------------------------------
    // PF-06: every route hands the renderer a 0600 spec and data in one
    // 0700 run-<pid>-* folder, passes --private-output on the one-line
    // route only, and removes the folder when the command ends.
    // ------------------------------------------------------------
    capture erase "`pf_sd'/rec.txt"
    capture dash clear
    adopath ++ "`pf_sd'"
    capture noisily {
        dash scatter mpg weight
        python: _pf06_bad += _pf06_check("one-line", "1")
        // name() registers without drawing; build and serve need a graph.
        dash scatter mpg weight, name(pf06)
        dash build, saving("`d8'/pf06.html") replace nobrowser
        python: _pf06_bad += _pf06_check("build", "0")
        dash build, server saving("`d8'/pf06.py") replace nobrowser
        python: _pf06_bad += _pf06_check("build server", "0")
        dash serve, nobrowser timeout(1)
        python: _pf06_bad += _pf06_check("serve", "0")
    }
    local pf06rc = _rc
    adopath - "`pf_sd'"
    python: _pf_set("pf06", _pf06_bad + ([] if _pf_M.getLocal("pf06rc") == "0" else ["a route ended rc " + _pf_M.getLocal("pf06rc")]))
    _w29_expect PF-06 "(`pf06_bad' == 0)" `"`pf06_why'"'
    _w29_done PF-06 "each route's spec and data are 0600 in a 0700 run folder that is gone after it; --private-output on the one-line form only"
    capture dash clear

    // ------------------------------------------------------------
    // PF-11: dash build, server's .py is 0600 whatever the umask (M4, R-7),
    // replace makes a new file, a link at the name is refused r(7102)
    // with its target kept, and a folder of the user's that others can
    // write is neither refused, re-moded nor noted.
    // ------------------------------------------------------------
    local pf11d "`pf_tmp'dash_pf11_`pf_pid'"
    python:
_pf11d = _pf_M.getLocal("pf11d")
_pf_shutil.rmtree(_pf11d, True)
_pf_os.mkdir(_pf11d, 0o700)
_pf_u = _pf_os.umask(0o022)
_pf_os.umask(_pf_u)
_pf_M.setLocal("pf11_umask", oct(_pf_u))
with open(_pf_os.path.join(_pf11d, "pf11r.py"), "w") as _fh:
    _fh.write("OLD")
_pf_os.chmod(_pf_os.path.join(_pf11d, "pf11r.py"), 0o644)
with open(_pf_os.path.join(_pf11d, "pf11v.txt"), "w") as _fh:
    _fh.write("V")
_pf_os.chmod(_pf_os.path.join(_pf11d, "pf11v.txt"), 0o644)
_pf_os.symlink(_pf_os.path.join(_pf11d, "pf11v.txt"), _pf_os.path.join(_pf11d, "pf11l.py"))
end
    display as text "PF-11: the runner's umask is `pf11_umask'"
    capture dash clear
    capture noisily dash scatter mpg weight, name(pf11)
    capture noisily dash build, server saving("`pf11d'/pf11.py") replace nobrowser
    local pf11rc1 = _rc
    capture noisily dash build, server saving("`pf11d'/pf11r.py") replace nobrowser
    local pf11rc2 = _rc
    capture log close pf11
    quietly log using "`d8'/pf11.log", text replace name(pf11)
    capture noisily dash build, server saving("`pf11d'/pf11l.py") replace nobrowser
    local pf11rc3 = _rc
    quietly log close pf11
    python: _pf_os.chmod(_pf11d, 0o777)
    capture log close pf11o
    quietly log using "`d8'/pf11o.log", text replace name(pf11o)
    capture noisily dash build, server saving("`pf11d'/pf11o.py") replace nobrowser
    local pf11rc4 = _rc
    quietly log close pf11o
    python:
_pf_b = []
_j = lambda n: _pf_os.path.join(_pf11d, n)
if _pf_M.getLocal("pf11rc1") != "0" or _pf_mode(_j("pf11.py")) != "0o600" or _pf_os.lstat(_j("pf11.py")).st_uid != _PF_UID:
    _pf_b.append("step 1 rc " + _pf_M.getLocal("pf11rc1") + " mode " + _pf_mode(_j("pf11.py")))
with open(_j("pf11r.py"), encoding="utf-8", errors="replace") as _fh:
    _t = _fh.read()
if _pf_M.getLocal("pf11rc2") != "0" or _pf_mode(_j("pf11r.py")) != "0o600" or "_DATA_B64" not in _t:
    _pf_b.append("step 2 rc " + _pf_M.getLocal("pf11rc2") + " mode " + _pf_mode(_j("pf11r.py")))
_lg = " ".join(_pf_log_lines(_pf_os.path.join(_pf_M.getLocal("d8"), "pf11.log")))
with open(_j("pf11v.txt"), encoding="utf-8", errors="replace") as _fh:
    _v = _fh.read()
if _pf_M.getLocal("pf11rc3") != "7102":
    _pf_b.append("step 3 rc " + _pf_M.getLocal("pf11rc3"))
if "refused to write" not in _lg or "(it is a link)" not in _lg:
    _pf_b.append("step 3 log does not name the refusal")
if _v != "V":
    _pf_b.append("step 3 the victim was overwritten")
if not _pf_os.path.islink(_j("pf11l.py")):
    _pf_b.append("step 3 the link is gone")
if _pf_M.getLocal("pf11rc4") != "0" or _pf_mode(_j("pf11o.py")) != "0o600":
    _pf_b.append("step 4 rc " + _pf_M.getLocal("pf11rc4") + " mode " + _pf_mode(_j("pf11o.py")))
if _pf_mode(_pf11d) != "0o777":
    _pf_b.append("step 4 the folder is now " + _pf_mode(_pf11d))
if [x for x in _pf_notes(_pf_os.path.join(_pf_M.getLocal("d8"), "pf11o.log")) if _pf11d in x]:
    _pf_b.append("step 4 a note names the folder")
_pf_set("pf11", _pf_b)
_pf_shutil.rmtree(_pf11d, True)
end
    _w29_expect PF-11 "(`pf11_bad' == 0)" `"`pf11_why'"'
    _w29_done PF-11 "dash build, server .py is 0600 under umask `pf11_umask', replace writes anew, a link is refused r(7102), the user's folder is left as it is"
    capture dash clear

    // ------------------------------------------------------------
    // PF-12 (ratified 01oct2026): a c(tmpdir) other accounts can change
    // (group write, as a STATATMP made under umask 002) stops no route, as
    // it stops no twoway command: each gives rc 0 and exactly one note
    // naming c(tmpdir), chmod go-w and STATATMP.  The mode is restored
    // whatever fails, before anything is asserted.
    // ------------------------------------------------------------
    python: _pf_m12 = _pf_stat.S_IMODE(_pf_os.stat(_PF_TMP).st_mode)
    python: _pf_M.setLocal("pf12_before", oct(_pf_m12))
    capture erase "`pf_sd'/rec.txt"
    capture dash clear
    python: _pf_os.chmod(_PF_TMP, _pf_m12 | 0o020)
    capture noisily {
        capture log close pf12
        quietly log using "`d8'/pf12_1.log", text replace name(pf12)
        capture noisily dash scatter mpg weight
        local pf12rc1 = _rc
        quietly log close pf12
        python: _pf12_page = (_pf_my_pages() or [""])[-1]
        // name() registers without drawing: the graph routes 2-4 build.
        capture dash scatter mpg weight, name(pf12)
        quietly log using "`d8'/pf12_2.log", text replace name(pf12)
        capture noisily dash build, saving("`d8'/pf12.html") replace nobrowser
        local pf12rc2 = _rc
        quietly log close pf12
        quietly log using "`d8'/pf12_3.log", text replace name(pf12)
        capture noisily dash build, server saving("`d8'/pf12.py") replace nobrowser
        local pf12rc3 = _rc
        quietly log close pf12
        adopath ++ "`pf_sd'"
        quietly log using "`d8'/pf12_4.log", text replace name(pf12)
        capture noisily dash serve, nobrowser timeout(1)
        local pf12rc4 = _rc
        quietly log close pf12
        adopath - "`pf_sd'"
    }
    local pf12rc = _rc
    capture log close pf12
    capture adopath - "`pf_sd'"
    python: _pf_os.chmod(_PF_TMP, _pf_m12)
    python: _pf_M.setLocal("pf12_after", oct(_pf_stat.S_IMODE(_pf_os.stat(_PF_TMP).st_mode)))
    display as text "PF-12: c(tmpdir) mode before `pf12_before', after the restore `pf12_after'"
    python:
_pf_b = []
if _pf_M.getLocal("pf12rc") != "0":
    _pf_b.append("the routes block ended rc " + _pf_M.getLocal("pf12rc"))
for _i in ("1", "2", "3", "4"):
    _rc = _pf_M.getLocal("pf12rc" + _i)
    if _rc != "0":
        _pf_b.append("route %s rc %s" % (_i, _rc))
    _lp = _pf_os.path.join(_pf_M.getLocal("d8"), "pf12_%s.log" % _i)
    _ns = _pf_notes(_lp)
    if len(_ns) != 1:
        _pf_b.append("route %s has %d note lines" % (_i, len(_ns)))
    elif _PF_TMP not in _ns[0] or "chmod go-w" not in _ns[0] or "STATATMP" not in _ns[0]:
        _pf_b.append("route %s note lacks c(tmpdir), chmod go-w or STATATMP" % _i)
    _all = _pf_log_lines(_lp)
    if [x for x in _all if x.startswith("r(603);") or x.startswith("r(198);")]:
        _pf_b.append("route %s logged r(603) or r(198)" % _i)
if not _pf12_page or _pf_mode(_pf12_page) != "0o600" or _pf_mode(_pf_os.path.dirname(_pf12_page)) != "0o700":
    _pf_b.append("route 1 preview " + _pf_mode(_pf12_page) + " in " + _pf_mode(_pf_os.path.dirname(_pf12_page)))
if _pf_mode(_pf_os.path.join(_pf_M.getLocal("d8"), "pf12.py")) != "0o600":
    _pf_b.append("route 3 pf12.py " + _pf_mode(_pf_os.path.join(_pf_M.getLocal("d8"), "pf12.py")))
_pf_b += _pf06_check("route 4", "0")
if _pf_M.getLocal("pf12_before") != _pf_M.getLocal("pf12_after"):
    _pf_b.append("c(tmpdir) mode not restored")
_pf_set("pf12", _pf_b)
end
    _w29_expect PF-12 "(`pf12_bad' == 0)" `"`pf12_why'"'
    _w29_done PF-12 "a c(tmpdir) others can change stops no route: rc 0 and one note naming chmod go-w and STATATMP on each"

    capture dash clear
    python: _pf_shutil.rmtree(_pf_M.getLocal("pf_sd"), True)
    python: _pf_shutil.rmtree(_pf_M.getLocal("d8"), True)
    set linesize 80
    display as text "S08 end `c(current_time)'"
}
* ==== end S08 ====

// Helpers of block S10 (axis(#) routing and by() shared scales), defined
// before it: programs and python definitions are not made inside a
// block's braces.
//
// twoway routes ylabel(), yscale(), yline() and ytick() (x too) to the axis
// axis(#) names (graph_g.class ParseAndLogAxes; WP-29 P0.5).  Each AX case
// draws the command in twoway, reads its .Graph members, and compares them
// with the models of dash's saved page and of its served app (imported,
// make_document) for the same command.

// _s10_ticks <object path> <set>: the tick positions of
// .Graph.<path>.<set> (major, majornl ...), blank-separated, in r(list).
capture program drop _s10_ticks
program define _s10_ticks, rclass
    version 16.0
    args obj set
    local n "`.Graph.`obj'.`set'.dlg_tickpos.arrnels'"
    local v ""
    if "`n'" != "" {
        forvalues i = 1/`n' {
            local v `v' `.Graph.`obj'.`set'.dlg_tickpos[`i']'
        }
    }
    return local list "`v'"
end

// _s10_build <stub>: dash's saved page and served app of the graphs
// registered, into <stub>.html and <stub>_app.py.
capture program drop _s10_build
program define _s10_build
    version 16.0
    args stub
    quietly dash build, saving("`stub'.html") replace nobrowser
    quietly dash build, saving("`stub'_app.py") server replace
    global s10_html "`stub'.html"
    global s10_app  "`stub'_app.py"
end

python:
import json as _s10_json
import re as _s10_re
import warnings as _s10_w
from sfi import Macro as _s10_M
from bokeh.document import Document as _s10_Doc
from bokeh.models import Plot as _s10_Plot


def _s10_saved():
    with open(_s10_M.getGlobal("s10_html"), encoding="utf-8") as fh:
        page = fh.read()
    out = []
    for blob in _s10_re.findall(r'<script type="application/json" id="[^"]*">\s*(.*?)\s*</script>', page, _s10_re.S):
        for dd in _s10_json.loads(blob).values():
            out += list(_s10_Doc.from_json(dd).select(dict(type=_s10_Plot)))
    return sorted(out, key=lambda p: str(p.title.text if p.title is not None else ""))


def _s10_served():
    with open(_s10_M.getGlobal("s10_app"), encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_s10_app")
    with _s10_w.catch_warnings():
        _s10_w.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_s10_app.py", "exec"), ns)
        doc = _s10_Doc()
        ns["make_document"](doc)
    return sorted(doc.select(dict(type=_s10_Plot)),
                  key=lambda p: str(p.title.text if p.title is not None else ""))


def _s10_cont(side):
    return [a for a in side if type(a).__name__ in ("LinearAxis", "LogAxis", "DatetimeAxis")]


def _s10_axis(p, side, rname):
    attr = "y_range_name" if side in ("left", "right") else "x_range_name"
    got = [a for a in _s10_cont(getattr(p, side)) if getattr(a, attr) == rname]
    return got[0] if len(got) == 1 else None


def _s10_major(a):
    t = a.ticker
    if type(t).__name__ == "CustomJSTicker":
        t = (t.args or {}).get("base")
    if t is not None and type(t).__name__ == "FixedTicker":
        return sorted(float(v) for v in t.ticks)
    return None


def _s10_extra(a):
    t = a.ticker
    if type(t).__name__ == "CustomJSTicker":
        return sorted(float(v) for v in (t.args or {}).get("extra", []))
    return None


def _s10_spans(p):
    return [(float(s.location), s.dimension, s.y_range_name, s.x_range_name)
            for s in p.center if type(s).__name__ == "Span"]


def _s10_nums(name):
    return sorted(float(v) for v in _s10_M.getGlobal(name).split())


def _s10_put(ok, why):
    _s10_M.setGlobal("s10_ok", "1" if ok else "0")
    _s10_M.setGlobal("s10_why", "" if ok else str(why)[:600])


def _s10_both(check):
    """check(plots) -> list of problems, for the saved page and the app."""
    bad = []
    for mode, get in (("saved", _s10_saved), ("served", _s10_served)):
        try:
            plots = get()
            bad += ["%s: %s" % (mode, b) for b in check(plots)]
        except Exception as e:  # noqa: BLE001 -- reported as the failure
            bad.append("%s: %s %s" % (mode, type(e).__name__, e))
    _s10_put(not bad, "; ".join(bad))


def _s10_ax11(plots):
    want = _s10_nums("s10_tw")
    a = _s10_axis(plots[0], "right", "y2")
    if a is None or _s10_major(a) != want:
        return ["y2 ticks %s, twoway yaxis2 %s" % (a and _s10_major(a), want)]
    if _s10_major(_s10_axis(plots[0], "left", "default")) == want:
        return ["the left axis has the y2 ticks"]
    return []


def _s10_ax12(plots):
    a = _s10_axis(plots[0], "right", "y2")
    left = _s10_axis(plots[0], "left", "default")
    if _s10_M.getGlobal("s10_tw") != "log":
        return ["twoway plotregion2 transform %s" % _s10_M.getGlobal("s10_tw")]
    if a is None or type(a).__name__ != "LogAxis" or type(left).__name__ != "LinearAxis":
        return ["right %s left %s" % (type(a).__name__, type(left).__name__)]
    return []


def _s10_ax13(plots):
    want = _s10_nums("s10_tw")
    got = sorted(s[0] for s in _s10_spans(plots[0]) if s[2] == "y2")
    if got != want or [s for s in _s10_spans(plots[0]) if s[2] != "y2"]:
        return ["spans %s, twoway plotregion2 lines %s" % (_s10_spans(plots[0]), want)]
    return []


def _s10_ax14(plots):
    want = _s10_nums("s10_tw")
    a = _s10_axis(plots[0], "right", "y2")
    if a is None or _s10_extra(a) != want:
        return ["y2 tick-only %s, twoway yaxis2 majornl %s" % (a and _s10_extra(a), want)]
    return []


def _s10_ax15(plots):
    p = plots[0]
    a = _s10_axis(p, "above", "x2")
    bad = []
    if a is None:
        return ["no x2 axis"]
    if _s10_M.getGlobal("s10_tr") == "log" and type(a).__name__ != "LogAxis":
        bad.append("x2 is %s, twoway log" % type(a).__name__)
    if _s10_major(a) != _s10_nums("s10_tw"):
        bad.append("x2 labels %s, twoway %s" % (_s10_major(a), _s10_nums("s10_tw")))
    if _s10_extra(a) != _s10_nums("s10_tk"):
        bad.append("x2 ticks %s, twoway %s" % (_s10_extra(a), _s10_nums("s10_tk")))
    got = sorted(s[0] for s in _s10_spans(p) if s[3] == "x2")
    if got != _s10_nums("s10_tl"):
        bad.append("x2 lines %s, twoway %s" % (got, _s10_nums("s10_tl")))
    return bad


def _s10_ax16(plots):
    by_title = {str(p.title.text if p.title is not None else ""): p for p in plots}
    tick, line = by_title.get("ax16a"), by_title.get("ax16b")
    if tick is None or line is None:
        return ["graphs %s" % sorted(by_title)]
    t2, l2 = tick.extra_y_ranges.get("y2"), line.extra_y_ranges.get("y2")
    tmax = float(_s10_M.getGlobal("s10_tw"))
    lmax = float(_s10_M.getGlobal("s10_tl"))
    bad = []
    if not (tmax >= 20000 and max(t2.start, t2.end) >= 20000):
        bad.append("ytick(20000, axis(2)): dash y2 ends %s, twoway curmax %s" % (max(t2.start, t2.end), tmax))
    if not (lmax < 30000 and max(l2.start, l2.end) < 30000):
        bad.append("yline(30000, axis(2)): dash y2 ends %s, twoway curmax %s" % (max(l2.start, l2.end), lmax))
    return bad


def _s10_ax17(plots):
    p = plots[0]
    want = _s10_nums("s10_tw")
    left = _s10_cont(p.left)
    if len(left) != 1 or _s10_cont(p.right) or _s10_major(left[0]) != want:
        return ["left %s right %s, twoway yaxis2 %s" % (
            [_s10_major(a) for a in left], _s10_cont(p.right), want)]
    return []


def _s10_ax18(plots):
    want = [sorted(float(v) for v in w.split()) for w in _s10_M.getGlobal("s10_tw").split("|") if w.strip()]
    got = [_s10_major(_s10_axis(p, "right", "y2")) for p in plots]
    if len(got) != len(want) or any(g != w for g, w in zip(got, want)):
        return ["panels' y2 ticks %s, twoway %s" % (got, want)]
    return []

end

* ==== S10 P0.5: axis(#) routing ====
local only : env WP29_ONLY
if inlist("`only'", "", "S10") {
    display as text "S10 start `c(current_time)'"
    local s10d "`w29_work'/s10"
    capture mkdir "`s10d'"
    local B "(scatter mpg weight) (line price weight, yaxis(2) sort)"

    // AX-11: ylabel(..., axis(2)) labels the second axis.
    sysuse auto, clear
    quietly twoway `B', ylabel(5000 10000 15000, axis(2))
    _s10_ticks yaxis2 major
    global s10_tw "`r(list)'"
    dash clear
    quietly dash `B', ylabel(5000 10000 15000, axis(2)) name(ax11)
    _s10_build "`s10d'/ax11"
    python: _s10_both(_s10_ax11)
    _w29_expect AX-11 "(${s10_ok} == 1)" `"${s10_why}"'
    _w29_done AX-11 "ylabel(5000 10000 15000, axis(2)) labels the second axis, as twoway's yaxis2 (${s10_tw}), saved and served"

    // AX-12: yscale(log axis(2)) logs the second axis only.
    quietly twoway `B', yscale(log axis(2))
    global s10_tw "`.Graph.plotregion2.yscale.transform.stylename'"
    dash clear
    quietly dash `B', yscale(log axis(2)) name(ax12)
    _s10_build "`s10d'/ax12"
    python: _s10_both(_s10_ax12)
    _w29_expect AX-12 "(${s10_ok} == 1)" `"${s10_why}"'
    _w29_done AX-12 "yscale(log axis(2)) is a log second axis and a linear first one, as twoway's plotregion2 (${s10_tw})"

    // AX-13: yline(#, axis(2)) is drawn on the second axis's scale.
    quietly twoway `B', yline(5000, axis(2))
    global s10_tw "`.Graph.plotregion2._xylines[1].z'"
    dash clear
    quietly dash `B', yline(5000, axis(2)) name(ax13)
    _s10_build "`s10d'/ax13"
    python: _s10_both(_s10_ax13)
    _w29_expect AX-13 "(${s10_ok} == 1)" `"${s10_why}"'
    _w29_done AX-13 "yline(5000, axis(2)) is drawn on the second axis, where twoway's plotregion2 holds it"

    // AX-14: ytick(..., axis(2)) ticks the second axis.
    quietly twoway `B', ytick(5000 7500, axis(2))
    _s10_ticks yaxis2 majornl
    global s10_tw "`r(list)'"
    dash clear
    quietly dash `B', ytick(5000 7500, axis(2)) name(ax14)
    _s10_build "`s10d'/ax14"
    python: _s10_both(_s10_ax14)
    _w29_expect AX-14 "(${s10_ok} == 1)" `"${s10_why}"'
    _w29_done AX-14 "ytick(5000 7500, axis(2)) ticks the second axis, as twoway's yaxis2 majornl (${s10_tw})"

    // AX-15: the x family on the second x axis.
    local X "(scatter mpg weight) (scatter mpg length, xaxis(2))"
    local o "xlabel(150 200, axis(2)) xscale(log axis(2)) xline(200, axis(2)) xtick(160 180, axis(2))"
    quietly twoway `X', `o'
    _s10_ticks xaxis2 major
    global s10_tw "`r(list)'"
    _s10_ticks xaxis2 majornl
    global s10_tk "`r(list)'"
    global s10_tr "`.Graph.plotregion2.xscale.transform.stylename'"
    global s10_tl "`.Graph.plotregion2._xylines[1].z'"
    dash clear
    quietly dash `X', `o' name(ax15)
    _s10_build "`s10d'/ax15"
    python: _s10_both(_s10_ax15)
    _w29_expect AX-15 "(${s10_ok} == 1)" `"${s10_why}"'
    _w29_done AX-15 "xlabel(), xscale(log), xline() and xtick() with axis(2) are on the second x axis, as twoway draws them"

    // AX-16: a tick widens the second axis, a line does not.
    quietly twoway `B', ytick(20000, axis(2))
    global s10_tw "`.Graph.plotregion2.yscale.curmax'"
    quietly twoway `B', yline(30000, axis(2))
    global s10_tl "`.Graph.plotregion2.yscale.curmax'"
    dash clear
    quietly dash `B', ytick(20000, axis(2)) title("ax16a") name(ax16a)
    quietly dash `B', yline(30000, axis(2)) title("ax16b") name(ax16b)
    _s10_build "`s10d'/ax16"
    python: _s10_both(_s10_ax16)
    _w29_expect AX-16 "(${s10_ok} == 1)" `"${s10_why}"'
    _w29_done AX-16 "ytick(20000, axis(2)) widens the second axis to 20000 and yline(30000, axis(2)) does not, as in twoway (${s10_tw}, ${s10_tl})"

    // AX-17: a lone yaxis(2) graph's one axis takes the axis(2) options.
    quietly twoway line price weight, yaxis(2) sort ylabel(5000 10000, axis(2))
    _s10_ticks yaxis2 major
    global s10_tw "`r(list)'"
    dash clear
    quietly dash line price weight, yaxis(2) sort ylabel(5000 10000, axis(2)) name(ax17)
    _s10_build "`s10d'/ax17"
    python: _s10_both(_s10_ax17)
    _w29_expect AX-17 "(${s10_ok} == 1)" `"${s10_why}"'
    _w29_done AX-17 "a lone yaxis(2) graph draws one left axis labelled ${s10_tw}, as twoway's"

    // AX-18: under by(), every panel's second axis.
    quietly twoway `B', by(foreign) ylabel(5000 10000, axis(2))
    local tw ""
    forvalues k = 1/2 {
        _s10_ticks graphs[`k'].yaxis2 major
        local tw "`tw'`r(list)'|"
    }
    global s10_tw "`tw'"
    dash clear
    quietly dash `B', by(foreign) ylabel(5000 10000, axis(2)) name(ax18)
    _s10_build "`s10d'/ax18"
    python: _s10_both(_s10_ax18)
    _w29_expect AX-18 "(${s10_ok} == 1)" `"${s10_why}"'
    _w29_done AX-18 "under by(), every panel's second axis is labelled as twoway's (${s10_tw})"

    capture dash clear
    capture graph drop _all
    macro drop s10_*
    display as text "S10 end `c(current_time)'"
}
* ==== end S10 ====

// Helpers of block S10 P0.2 (by() shared scales).  twoway draws a by()
// graph's panels on one scale per axis unless yrescale, xrescale or
// rescale gives each its own (bygraph_g.class); each BSC case reads the
// live .Graph.graphs[k] members and compares them with the panels of
// dash's saved page and served app (test_by_scales.py's emulated hull,
// what BokehJS spans over a shared DataRange1d).

// _s10_panels: every panel of the current by() graph, into $s10_tw as
// "title|ymin|ymax|xmin|xmax|y2min|y2max|majmin|majmax|majdelta|curmin;".
capture program drop _s10_panels
program define _s10_panels
    version 16.0
    local n "`.Graph.graphs.arrnels'"
    local out ""
    forvalues k = 1/`n' {
        local p ".Graph.graphs[`k']"
        local out "`out'``p'.subtitle.text[1]'|``p'.plotregion1.yscale.min'|``p'.plotregion1.yscale.max'|``p'.plotregion1.xscale.min'|``p'.plotregion1.xscale.max'|``p'.yaxis2.plotregion.yscale.min'|``p'.yaxis2.plotregion.yscale.max'|``p'.yaxis1.major.min'|``p'.yaxis1.major.max'|``p'.yaxis1.major.delta'|``p'.plotregion1.yscale.curmin';"
    }
    global s10_tw "`out'"
end

python:
import os as _s10_os
import sys as _s10_sys
_s10_sys.path.insert(0, _s10_os.path.abspath("."))
import test_by_scales as _s10_tb


def _s10_live():
    out = {}
    for row in _s10_M.getGlobal("s10_tw").split(";"):
        f = row.split("|")
        if len(f) < 11:
            continue
        num = [float(v) if v.strip() not in ("", ".") else None for v in f[1:]]
        out[f[0]] = dict(zip(("ymin", "ymax", "xmin", "xmax", "y2min", "y2max",
                              "majmin", "majmax", "majdelta", "curmin"), num))
    return out


def _s10_panelmap(plots):
    return {str(p.title.text if p.title is not None else ""): p for p in plots}


def _s10_by(shared, rescaled=(), y2=False, ticks=False, no_zero=False):
    def check(plots):
        live, got, bad = _s10_live(), _s10_panelmap(plots), []
        if sorted(live) != sorted(got):
            return ["panels %s, twoway %s" % (sorted(got), sorted(live))]
        figs = [got[t] for t in sorted(live)]
        for d in ("x", "y"):
            ids = {id(getattr(f, d + "_range")) for f in figs}
            if d in shared and len(ids) != 1:
                bad.append("%s is not one shared range" % d)
            if d in rescaled and len(ids) != len(figs):
                bad.append("%s is not per panel" % d)
            for t in sorted(live):
                f = got[t]
                h = (_s10_tb._emulated_hull(figs, d) if d in shared
                     else _s10_tb._hull_of(f, d))
                want = (live[t][d + "min"], live[t][d + "max"])
                if not _s10_tb._close(h, want):
                    bad.append("%s %s hull %s, twoway %s" % (t, d, h, want))
        if y2:
            for t in sorted(live):
                r2 = got[t].extra_y_ranges.get("y2")
                h = _s10_tb.dr._dash_range_hull(r2) if r2 is not None else None
                want = (live[t]["y2min"], live[t]["y2max"])
                if not _s10_tb._close(h, want):
                    bad.append("%s y2 hull %s, twoway %s" % (t, h, want))
        if ticks:
            for t in sorted(live):
                tk = _s10_tb._major_ticks(_s10_tb._left(got[t]))
                want = _s10_tb._steps(live[t]["majmin"], live[t]["majmax"],
                                      live[t]["majdelta"])
                if tk != want:
                    bad.append("%s ticks %s, twoway %s" % (t, tk, want))
        if no_zero:
            for t in sorted(live):
                h = _s10_tb._hull_of(got[t], "y")
                if h is None or h[0] <= 0 or live[t]["curmin"] != 10:
                    bad.append("%s hull %s, twoway curmin %s" % (t, h, live[t]["curmin"]))
        return bad
    return check


def _s10_bsc_check():
    g = _s10_M.getGlobal
    _s10_both(_s10_by(g("s10_sh"), g("s10_rs"), ticks=g("s10_tk") == "1",
                      no_zero=g("s10_nz") == "1"))

end

// (the check runs in the block: a python line inside a program does not
// see the definitions above)
// _s10_bsc <id> <dir> `"<by and graph options>"' <shared> <rescaled> <ticks> <nozero> `"<what>"'
capture program drop _s10_bsc
program define _s10_bsc
    version 16.0
    args id dir opts sh rs tk nz why
    quietly twoway scatter mpg weight, `opts'
    _s10_panels
    dash clear
    quietly dash scatter mpg weight, `opts' name(`=lower(subinstr("`id'", "-", "", .))')
    _s10_build "`dir'/`id'"
    global s10_sh "`sh'"
    global s10_rs "`rs'"
    global s10_tk "`tk'"
    global s10_nz "`nz'"
end

* ==== S10 P0.2: by() shared scales ====
local only : env WP29_ONLY
if inlist("`only'", "", "S10") {
    display as text "S10 start `c(current_time)'"
    local s10d "`w29_work'/s10b"
    capture mkdir "`s10d'"
    sysuse auto, clear

    _s10_bsc BSC-01 "`s10d'" "by(foreign)" "xy" "" 0 0
    python: _s10_bsc_check()
    _w29_expect BSC-01 "(${s10_ok} == 1)" `"${s10_why}"'
    _w29_done BSC-01 "by(foreign): one shared x and y scale spanning every panel, as twoway's"
    _s10_bsc BSC-02 "`s10d'" "by(foreign, yrescale)" "x" "y" 0 0
    python: _s10_bsc_check()
    _w29_expect BSC-02 "(${s10_ok} == 1)" `"${s10_why}"'
    _w29_done BSC-02 "yrescale gives each panel its own y scale, as twoway"
    _s10_bsc BSC-03 "`s10d'" "by(foreign, rescale)" "" "xy" 0 0
    python: _s10_bsc_check()
    _w29_expect BSC-03 "(${s10_ok} == 1)" `"${s10_why}"'
    _s10_bsc BSC-03 "`s10d'" "by(foreign, r)" "" "xy" 0 0
    python: _s10_bsc_check()
    _w29_expect BSC-03 "(${s10_ok} == 1)" `"${s10_why}"'
    _w29_done BSC-03 "rescale and r give each panel its own x and y scales, as twoway"
    _s10_bsc BSC-04 "`s10d'" "by(foreign, total)" "xy" "" 0 0
    python: _s10_bsc_check()
    _w29_expect BSC-04 "(${s10_ok} == 1)" `"${s10_why}"'
    _w29_done BSC-04 "the Total panel shares the scale, as twoway's"
    _s10_bsc BSC-06 "`s10d'" "by(foreign, yrescale) ylabel(#5)" "x" "y" 1 0
    python: _s10_bsc_check()
    _w29_expect BSC-06 "(${s10_ok} == 1)" `"${s10_why}"'
    _w29_done BSC-06 "ylabel(#5) ticks each rescaled panel over its own data, as twoway"
    _s10_bsc BSC-07 "`s10d'" "by(foreign, yrescale) yscale(range(0))" "x" "y" 0 1
    python: _s10_bsc_check()
    _w29_expect BSC-07 "(${s10_ok} == 1)" `"${s10_why}"'
    _w29_done BSC-07 "range(0) is not applied on a rescaled axis; twoway's curmin is 10"

    // BSC-05: under by(), the second axis is shared too.
    local D "(scatter mpg weight) (scatter price weight, yaxis(2))"
    quietly twoway `D', by(foreign)
    _s10_panels
    dash clear
    quietly dash `D', by(foreign) name(bsc5)
    _s10_build "`s10d'/bsc5"
    python: _s10_both(_s10_by("xy", y2=True))
    _w29_expect BSC-05 "(${s10_ok} == 1)" `"${s10_why}"'
    _w29_done BSC-05 "the panels' second axis spans every panel's data, as twoway's yaxis2"

    capture dash clear
    capture graph drop _all
    macro drop s10_*
    display as text "S10 end `c(current_time)'"
}
* ==== end S10 ====

// Helpers of block S11 (lpoly's default bandwidth and lpolyci's band),
// defined before it: programs and python definitions are not made inside a
// block's braces.
//
// _lw_read <page> <prefix> <kind> <first x>: the lpoly line (kind "line"),
// or the lpolyci source with a band (kind "ci"), of dash's saved page,
// whose first drawn x is <first x> (any, when "."), into the globals
// <prefix>_x and <prefix>_y (and _lo, _hi for "ci") as blank-separated
// reprs, and <prefix>_n its point count; <prefix>_err names a failure.
python:
import json as _lw_json
import re as _lw_re
from sfi import Macro as _lw_M
from bokeh.document import Document as _lw_Doc
from bokeh.models import ColumnDataSource as _lw_CDS


def _lw_read(path, prefix, kind="line", first="."):
    _lw_M.setGlobal(prefix + "_err", "")
    try:
        with open(path, encoding="utf-8") as fh:
            page = fh.read()
        srcs = []
        for blob in _lw_re.findall(r'<script type="application/json" id="[^"]*">\s*(.*?)\s*</script>', page, _lw_re.S):
            for dd in _lw_json.loads(blob).values():
                srcs += [dict(m.data) for m in _lw_Doc.from_json(dd).select(dict(type=_lw_CDS))]
        if kind == "ci":
            cand = [s for s in srcs if "x_lp" in s and "y_lower" in s]
        else:
            cand = [s for s in srcs if "x_lp" in s and "y_lp" in s and "y_lower" not in s]
        if first != ".":
            f = float(first)
            cand = [s for s in cand if len(s["x_lp"]) and abs(float(s["x_lp"][0]) - f) <= 1e-9 * max(1.0, abs(f))]
        if len(cand) != 1:
            _lw_M.setGlobal(prefix + "_err", "%d candidate sources" % len(cand))
            _lw_M.setGlobal(prefix + "_n", "0")
            return
        s = cand[0]
        _lw_M.setGlobal(prefix + "_n", str(len(s["x_lp"])))
        cols = [("_x", "x_lp"), ("_y", "y_lp")]
        if kind == "ci":
            cols += [("_lo", "y_lower"), ("_hi", "y_upper")]
        for suf, c in cols:
            _lw_M.setGlobal(prefix + suf, " ".join(repr(float(v)) for v in s.get(c, [])))
    except Exception as e:  # noqa: BLE001 -- reported as the failure
        _lw_M.setGlobal(prefix + "_err", "%s %s" % (type(e).__name__, e))
        _lw_M.setGlobal(prefix + "_n", "0")
end

python:
def _lw_dash_h(yv, xv, sel, degree, kernel):
    """dash's default bandwidth on Stata's sample (rows where *sel* is 1),
    by the renderer's own rule, into the global lw_hd."""
    import os as _o
    import sys as _s
    root = _o.path.abspath("..")
    if root not in _s.path:
        _s.path.insert(0, root)
    import numpy as _np
    import dash_render as _dr
    from sfi import Data as _D
    def _col(v):
        return _np.array([r[0] if isinstance(r, list) else r
                          for r in _D.get(v, selectvar=sel)], dtype=float)
    x = _col(xv)
    y = _col(yv)
    h = _dr.GlyphMapper._default_lpoly_bwidth(x, y, None, int(degree), kernel)
    _lw_M.setGlobal("lw_hd", repr(float(h)))
end

mata:
// _lw_cmp(): the drawn (x, y) in globals lw_x lw_y against Stata's
// variables gx gy (grid) and, for the sensitivity rule, gy1 (Stata's curve
// at bwidth*(1+1e-6)).  x maps through (gx - xoff)*xmul.  Sets the globals
// lw_ok, lw_why and lw_excl (the grid x left out as sensitive).
void _lw_cmp(real scalar tol, real scalar xoff, real scalar xmul,
             real scalar sens)
{
    real colvector px, py, gx, gy, gy1, ok
    real scalar i, j, n, bad, dmin
    string scalar why, excl
    px = strtoreal(tokens(st_global("lw_x")))'
    py = strtoreal(tokens(st_global("lw_y")))'
    gx = st_data(., "gx")
    gy = st_data(., "gy")
    gy1 = sens ? st_data(., "gy1") : J(rows(gy), 1, .)
    ok = (gx :< .) :& (gy :< .)
    n = sum(ok)
    bad = 0
    why = ""
    excl = ""
    if (rows(px) != n) {
        bad = 1
        why = sprintf("dash drew %g points, Stata %g", rows(px), n)
    }
    for (i = 1; i <= rows(px) & !bad; i++) {
        dmin = .
        j = 0
        for (k = 1; k <= rows(gx); k++) {
            if (ok[k] & (dmin >= . | abs((gx[k] - xoff) * xmul - px[i]) < dmin)) {
                dmin = abs((gx[k] - xoff) * xmul - px[i])
                j = k
            }
        }
        if (j == 0 | dmin > 1e-9 * max((1, abs(px[i])))) {
            bad = 1
            why = sprintf("drawn x %21.17g is not on Stata's grid", px[i])
        }
        else if (sens & abs(gy1[j] - gy[j]) > tol) {
            excl = excl + sprintf(" %g(moves %g at dash's bandwidth)", gx[j], abs(gy1[j] - gy[j]))
        }
        else if (abs(py[i] - gy[j]) > tol) {
            bad = 1
            why = sprintf("at x %g dash %21.17g, Stata %21.17g (tol %g)", gx[j], py[i], gy[j], tol)
        }
    }
    st_global("lw_ok", bad ? "0" : "1")
    st_global("lw_why", why)
    st_global("lw_excl", excl)
}
end

// _lw_case <id> <stub> <dash plot> <lpoly args> <frac> [<sens>] [<xoff> <xmul>] [<first>]
// Stata: `lpoly <lpoly args>, nograph generate(gx gy)'; dash: <dash plot>
// on a saved page.  Each drawn y is within <frac> of the range of y of
// Stata's gy at the same gx.  <sens> 1 (unweighted only; globals lw_deg,
// lw_ker, lw_tier) leaves out, and names, the grid points whose Stata
// value moves more than that when Stata's bandwidth moves by dash's actual
// relative gap (maintainer ruling, 01oct2026).
capture program drop _lw_case
program define _lw_case
    version 16.0
    args id stub dplot largs frac sens xoff xmul first
    if "`sens'" == "" local sens 0
    if "`xoff'" == "" local xoff 0
    if "`xmul'" == "" local xmul 1
    if "`first'" == "" local first "."
    foreach v in gx gy gy1 {
        capture drop `v'
    }
    gettoken lyx lopts : largs, parse(",")
    local lopts = subinstr(`"`lopts'"', ",", "", 1)
    quietly lpoly `lyx', `lopts' nograph generate(gx gy)
    local bw = r(bwidth)
    gettoken yv0 rest0 : lyx
    gettoken xv0 rest0 : rest0
    if `sens' {
        // The sensitivity rule (maintainer ruling, 01oct2026): Stata's
        // curve at its bandwidth moved by dash's actual relative gap, i.e.
        // at dash's bandwidth; the gap must be within the row's tier.
        tempvar sel
        local cnd = cond(strpos(`"`rest0'"', "if "), substr(`"`rest0'"', strpos(`"`rest0'"', "if ") + 3, .), "1")
        quietly gen byte `sel' = (`cnd') & !missing(`yv0', `xv0')
        python: import __main__; __main__._lw_dash_h("`yv0'", "`xv0'", "`sel'", "${lw_deg}", "${lw_ker}")
        local gap = abs(${lw_hd} / `bw' - 1)
        _w29_expect `id' "(`gap' <= ${lw_tier})" "dash's bandwidth ${lw_hd} is `gap' from r(bwidth) `bw'"
        local bw1 = string(${lw_hd}, "%21.17g")
        quietly lpoly `lyx', `lopts' nograph bwidth(`bw1') generate(gx1 gy1)
        drop gx1
        display as text "`id' bandwidth: dash ${lw_hd}, Stata `bw', gap `gap'"
    }
    // y's range over lpoly's sample
    gettoken yv rest : lyx
    gettoken xv rest : rest
    local ifin ""
    if strpos(`"`rest'"', "if ") local ifin = substr(`"`rest'"', strpos(`"`rest'"', "if "), .)
    quietly summarize `yv' `ifin'
    local tol = `frac' * (r(max) - r(min))
    dash clear
    quietly dash `dplot'
    quietly dash build, saving("`stub'.html") replace nobrowser
    python: import __main__; __main__._lw_read(r"`stub'.html", "lw", "line", "`first'")
    if "${lw_err}" != "" {
        global lw_ok 0
        global lw_why "${lw_err}"
    }
    else mata: _lw_cmp(`tol', `xoff', `xmul', `sens')
    _w29_expect `id' "(${lw_ok} == 1)" `"`id' `dplot': ${lw_why}"'
    if "${lw_excl}" != "" display as text `"`id' left out as bandwidth-sensitive:${lw_excl}"'
    foreach v in gx gy gy1 {
        capture drop `v'
    }
end

* ==== S11 P0.7: lpoly default bandwidth ====
local only : env WP29_ONLY
if inlist("`only'", "", "S11") {
    display as text "S11 P0.7 start `c(current_time)'"
    local s11d "`w29_work'/s11"
    capture mkdir "`s11d'"

    // LW-01: auto mpg weight, 8 kernels x degree 0-3, at the default
    // bandwidth: the drawn count is r(ngrid) and each drawn y is Stata's
    // gy within 1e-6 (degree 0/1) or 1e-4 (degree 2/3) of y's range.
    sysuse auto, clear
    foreach k in epanechnikov epan2 biweight cosine gaussian parzen rectangle triangle {
        forvalues d = 0/3 {
            local f = cond(`d' < 2, 1e-6, 1e-4)
            _lw_case LW-01 "`s11d'/lw01" "lpoly mpg weight, kernel(`k') degree(`d') name(lw01)" "mpg weight, kernel(`k') degree(`d')" `f'
        }
    }
    _w29_done LW-01 "8 kernels x degree 0-3: dash's default lpoly is Stata's (count and curve)"

    // LW-02: aweights and fweights.
    foreach w in "aw=price" "fw=rep78" {
        foreach d in 0 2 {
            local f = cond(`d' < 2, 1e-6, 1e-4)
            _lw_case LW-02 "`s11d'/lw02" "lpoly mpg weight [`w'], degree(`d') name(lw02)" "mpg weight [`w'], degree(`d')" `f'
        }
    }
    _w29_done LW-02 "[aw=price] and [fw=rep78] at degree 0 and 2: Stata's default lpoly"

    // LW-03: by(foreign) biweight degree 2: each panel is `lpoly ... if
    // foreign==k'.  Grid points whose Stata value moves more than the
    // tolerance when Stata's bandwidth moves by dash's actual relative gap
    // (itself within the degree-2 tier, 5e-5) are left out and named
    // (maintainer ruling, 01oct2026: there Stata's round-off decides it).
    global lw_deg 2
    global lw_ker biweight
    global lw_tier 5e-5
    forvalues g = 0/1 {
        quietly summarize weight if foreign == `g'
        local first = r(min)
        _lw_case LW-03 "`s11d'/lw03" "lpoly mpg weight, kernel(biweight) degree(2) by(foreign) name(lw03)" "mpg weight if foreign==`g', kernel(biweight) degree(2)" 1e-4 1 0 1 `first'
    }
    _w29_done LW-03 "by(foreign) biweight degree 2: each panel is lpoly ... if foreign==k"

    // LW-04: uslifeexp le year at degree 0 and 2.
    sysuse uslifeexp, clear
    foreach d in 0 2 {
        local f = cond(`d' < 2, 1e-6, 1e-4)
        _lw_case LW-04 "`s11d'/lw04" "lpoly le year, degree(`d') name(lw04)" "le year, degree(`d')" `f'
    }
    _w29_done LW-04 "uslifeexp le on year at degree 0 and 2: Stata's default lpoly"

    // LW-05: sp500 close on date (%td) at degree 0 and 2.  The bandwidth is
    // in days (S05, Stata units); dash draws x in epoch ms on its date
    // axis, so Stata's gx is compared as (gx - td(01jan1970))*86400000.
    sysuse sp500, clear
    foreach d in 0 2 {
        local f = cond(`d' < 2, 1e-6, 1e-4)
        _lw_case LW-05 "`s11d'/lw05" "lpoly close date, degree(`d') name(lw05)" "close date, degree(`d')" `f' 0 `=td(01jan1970)' 86400000
    }
    _w29_done LW-05 "sp500 close on date at degree 0 and 2: Stata's default lpoly, drawn at its dates"

    // LW-06: an x of 0 and 1 draws y = 0 at 50 points from 0 to 1; `in
    // 1/5' draws nothing.
    sysuse auto, clear
    dash clear
    quietly dash lpoly mpg foreign, name(lw06)
    quietly dash build, saving("`s11d'/lw06.html") replace nobrowser
    python: _lw_read(r"`s11d'/lw06.html", "lw")
    mata: st_global("lw_ok", strofreal(st_global("lw_err") == "" & st_global("lw_n") == "50" & all(strtoreal(tokens(st_global("lw_y"))) :== 0) & strtoreal(tokens(st_global("lw_x")))[1] == 0 & strtoreal(tokens(st_global("lw_x")))[50] == 1))
    _w29_expect LW-06 "(${lw_ok} == 1)" "lpoly mpg foreign: n ${lw_n}, y ${lw_y} ${lw_err}"
    dash clear
    quietly dash lpoly mpg weight in 1/5, name(lw06b)
    quietly dash build, saving("`s11d'/lw06b.html") replace nobrowser
    python: _lw_read(r"`s11d'/lw06b.html", "lw")
    mata: st_global("lw_ok", strofreal(st_global("lw_n") == "0" & st_global("lw_err") == ""))
    _w29_expect LW-06 "(${lw_ok} == 1)" "lpoly mpg weight in 1/5 drew ${lw_n} points ${lw_err}"
    _w29_done LW-06 "an x of 0 and 1 draws a line at 0 on 50 points; in 1/5 draws nothing"

    // LW-07: lpolyci's line is lpoly's line (same options, default bandwidth).
    dash clear
    quietly dash lpoly mpg weight, kernel(biweight) degree(2) name(lw07a)
    quietly dash build, saving("`s11d'/lw07a.html") replace nobrowser
    python: _lw_read(r"`s11d'/lw07a.html", "lwa")
    dash clear
    quietly dash lpolyci mpg weight, kernel(biweight) degree(2) name(lw07b)
    quietly dash build, saving("`s11d'/lw07b.html") replace nobrowser
    python: _lw_read(r"`s11d'/lw07b.html", "lwb", "ci")
    mata: st_global("lw_ok", strofreal(st_global("lwa_x") == st_global("lwb_x") & st_global("lwa_y") == st_global("lwb_y") & st_global("lwa_n") == "50" & st_global("lwa_err") + st_global("lwb_err") == ""))
    _w29_expect LW-07 "(${lw_ok} == 1)" "lpoly n ${lwa_n} vs lpolyci n ${lwb_n} ${lwa_err}${lwb_err}"
    _w29_done LW-07 "lpolyci's line is lpoly's line at the default bandwidth"

    capture dash clear
    foreach v in gx gy gy1 {
        capture drop `v'
    }
    macro drop lw_* lwa_* lwb_*
    display as text "S11 P0.7 end `c(current_time)'"
}
* ==== end S11 ====

* ==== append new blocks above this line ====

// ----------------------------------------------------------------
// Summary (test_gaps2_truth.cscript's shape)
// ----------------------------------------------------------------
capture graph drop _all
capture dash clear
capture rmdir "`w29_work'"
local nfail    = ${w29_nfail}
local faillist "${w29_faillist}"
local ncase    = ${w29_ncase}
local only : env WP29_ONLY
macro drop w29_nfail w29_faillist w29_bad w29_ncase
display as text ""
display as text "============================================================"
if `ncase' == 0 {
    // A WP29_ONLY that names no block ran nothing: that is not a pass.
    display as error "  test_wp29_truth: no case ran (WP29_ONLY=`only')"
    display as text "============================================================"
    exit 9
}
else if `nfail' == 0 {
    display as text "  test_wp29_truth: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_wp29_truth: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
