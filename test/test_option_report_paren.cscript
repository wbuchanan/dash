*! test_option_report_paren.cscript
*! Certification: the unsupported-option note in paren mode, and its wording.
*!
*! Usage:  do test/test_option_report_paren.cscript
*!
*! Requires: dash_setup completed.
*! Version: 1.0.0  20sep2026
*!
*! WHY THIS EXISTS
*!
*! Two defects in the reporter, both in the paren/`||' form.
*!
*! 1. GRAPH-LEVEL OPTIONS WERE DROPPED IN SILENCE.
*!    _dash_parse_graph_opts sreturns s(_pending) and s(_unknown), and
*!    _dash_plot read neither: it initialised the accumulator to "" and the
*!    first thing the segment loop did was `sreturn clear'.  So
*!        dash (scatter mpg weight) (lfit mpg weight), fxsize(30)
*!    named nothing, while the identical option in comma mode
*!        dash scatter mpg weight, fxsize(30)
*!    was named correctly.  A silent drop is the one thing this mechanism
*!    exists to prevent.
*!
*! 2. AN OPTION'S ARGUMENT BECAME EXTRA OPTION NAMES.
*!    _dash_report_ignored split with `foreach tok of local raw', which
*!    splits on whitespace; parentheses do not group.  So an undeclared
*!    option with a multi-word argument was reported as several:
*!        dash scatter mpg weight, addplot(line price weight)
*!        dash: ignoring unsupported option(s): addplot() price() weight)()
*!    naming two options that do not exist.

cscript "option report paren mode" adodir ".."
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}


qui do "../dash.ado"
do "cert_helpers.do"

global dash_nobrowser 1

// A named log is how the note itself can be inspected.
local logfile "`c(tmpdir)'dash_option_report.log"

program define _dash_note_for, rclass
    version 16.0
    args cmdtext logpath
    capture log close _optlog
    capture erase "`logpath'"
    log using "`logpath'", name(_optlog) text replace
    capture noisily `cmdtext'
    log close _optlog
end

// ---------------------------------------------------------------
// 1. comma mode still names an unsupported graph-level option
// ---------------------------------------------------------------
// Flipped: WP-31 D5 draws fxsize(), so play() is the pending example.
sysuse auto, clear
dash clear
_dash_note_for `"dash scatter mpg weight, name(c1) play(x)"' "`logfile'"
cert_file_has "`logfile'", needle("play()")
assert r(found) == 1

display as result "  [1/4] comma mode names it: PASS"

// ---------------------------------------------------------------
// 2. paren mode names it too
// ---------------------------------------------------------------
dash clear
_dash_note_for `"dash (scatter mpg weight) (lfit mpg weight), name(p1) play(x)"' "`logfile'"
cert_file_has "`logfile'", needle("play()")
assert r(found) == 1

display as result "  [2/4] paren mode names it: PASS"

// ---------------------------------------------------------------
// 3. an undeclared option with a multi-word argument is ONE name
// ---------------------------------------------------------------
// Flipped: WP-32 -- the option was addplot(), which twoway refuses on
// scatter and dash now refuses as twoway does (BUGS.md "In a few mixed
// lists dash names another word than twoway names first ..."); p1(),
// which twoway takes and dash names, carries a several-word argument.
dash clear
_dash_note_for `"dash scatter mpg weight, name(m1) p1(mcolor(red) msize(small))"' "`logfile'"
cert_file_has "`logfile'", needle("p1()")
assert r(found) == 1
// the argument's words must NOT appear as option names
cert_file_has "`logfile'", needle("msize()")
assert r(found) == 0
cert_file_has "`logfile'", needle("small))()")
assert r(found) == 0

display as result "  [3/4] an argument is not reported as options: PASS"

// ---------------------------------------------------------------
// 4. a quoted argument containing a paren cannot unbalance the scan
// ---------------------------------------------------------------
dash clear
_dash_note_for `"dash scatter mpg weight, name(q1) p1(mcolor(red) msize(small)) play(x)"' "`logfile'"
cert_file_has "`logfile'", needle("p1()")
assert r(found) == 1
cert_file_has "`logfile'", needle("play()")
assert r(found) == 1

display as result "  [4/4] several unsupported options are all named: PASS"

capture program drop _dash_note_for
dash clear
display as result "test_option_report_paren.cscript: ALL PASS"
