*! test_wp44_truth.cscript
*! WP-44's ONE certification script (.ultraplan/sections/index.md PD-6):
*! every comparison with twoway's drawing or with Stata's own values that
*! WP-44's sections need lives here, one block per GAPS4 row (or per
*! harness tool), appended above the "append new blocks above this line"
*! marker in section order.  Refusal, message and return-code checks join
*! the EXISTING script for their area (merge rule R1).
*!
*! Made from test/templates/wp_truth_template.cscript (44 -> the WP's
*! number).  S00 is the scaffold smoke (Q4400-1).  A section appends
*! `* ==== S<MM> <lead id>: <what> ====` ... `* ==== end S<MM> ====` (or
*! `S<MM> tool: <what>` for a section with no item), its helper programs
*! directly above its first header, and writes only inside its own
*! blocks.  Case ids are Q44<MM>-<k> (PD-5).
*!
*! Usage: via run_all_cscripts.do.  One block alone: WP44_ONLY=S<MM> in
*! the driver's environment.  Each block prints "S<MM> start" and "S<MM>
*! end" with the date and time.  The suite runs it in every session;
*! DASH_CERT_SHARD=k/N runs part k of N of the blocks; a part with no
*! block ends 0.

cscript "WP-44 truth: twoway comparisons" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off


do "cert_helpers.do"
quietly do "cert_svg.do"
qui run "../dash_parse.mata"
qui run "../dash.ado"
global dash_nobrowser 1

// ----------------------------------------------------------------
// Tally helpers -- test_wp29_truth.cscript's _w29_expect/_w29_done,
// renamed _w44_ for this script.  A case is any number of
// _w44_expect lines closed by one _w44_done.
// ----------------------------------------------------------------
global w44_nfail    = 0
global w44_faillist ""
global w44_bad      = 0
global w44_ncase    = 0

capture program drop _w44_expect
program define _w44_expect
    version 19
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global w44_bad = 1
    }
end

capture program drop _w44_done
program define _w44_done
    version 19
    args id msg
    if ${w44_bad} {
        global w44_nfail    = ${w44_nfail} + 1
        global w44_faillist "${w44_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global w44_bad   = 0
    global w44_ncase = ${w44_ncase} + 1
end

// A fresh directory for this run's files, never one that already exists:
// a fixed name in a shared temp directory could be planted by another
// account (rule 1), so a name Stata has not handed out before is made and
// the run fails if it cannot be.  Every block writes only under it.
tempfile w44_base
local w44_work "`w44_base'_w44"
capture mkdir "`w44_work'"
if _rc {
    display as error "test_wp44_truth: cannot create the work directory `w44_work' (rc `=_rc')"
    exit 9
}

// ---- parts: begin (WP-44 test performance) ----
// The certification suite runs this script in every one of its sessions
// (its row in run_all_cscripts.do's shard table is "* * *"); with
// DASH_CERT_SHARD=k/N set, the session runs part k of N of the blocks.
// The parts are balanced longest first onto the least loaded part (the
// lowest numbered of equals), by the seconds below -- a block not listed
// counts 1 s (section-01 D-01.f) -- the rule scripts/cert_shards.py uses
// for the scripts.  Unset, or with WP44_ONLY set
// (which keeps its precedence), every block runs.  A block runs when its
// gate finds its id in w44_run.
// Seconds: each block's start/end lines in the WP's last measured
// certification run, rounded up, at least 1; a block not listed
// counts 1 s.
local w44_secs S00 1 S01 20 S02 23 S03 13 S04 20 S05 6
local w44_sh : environment DASH_CERT_SHARD
mata: st_local("w44_ok", strofreal(st_local("w44_sh") == "" | ustrregexm(st_local("w44_sh"), "^[1-8]/[1-8]$")))
if !`w44_ok' {
    display as error "test_wp44_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 8"
    exit 198
}
local w44_k 1
local w44_N 1
if "`w44_sh'" != "" {
    local w44_k = real(substr("`w44_sh'", 1, 1))
    local w44_N = real(substr("`w44_sh'", 3, 1))
}
local w44_only : env WP44_ONLY
if `"`macval(w44_only)'"' != "" | `w44_N' == 1 {
    local w44_k 1
    local w44_N 1
}
if `w44_k' > `w44_N' {
    display as error "test_wp44_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 8"
    exit 198
}
capture confirm file "test_wp44_truth.cscript"
if _rc {
    display as error "test_wp44_truth: run it from test/, where it reads its own blocks"
    exit 601
}
capture mata: mata drop _w44_part()
mata:
// The ids of the blocks (their header lines, in file order), and those of
// part k of n: longest first onto the least loaded part.
void _w44_part(string scalar file, string scalar table, real scalar k,
               real scalar n)
{
    string colvector lines, ids
    string rowvector tok
    real colvector sec, o, at
    real rowvector load
    real scalar i, j, p, best
    string scalar run

    lines = cat(file)
    ids = J(0, 1, "")
    for (i = 1; i <= rows(lines); i++) {
        if (ustrregexm(lines[i], "^\* ==== (S[0-9]+) ")) {
            if (!anyof(ids, ustrregexs(1))) ids = ids \ ustrregexs(1)
        }
    }
    sec = J(rows(ids), 1, 1)
    tok = tokens(table)
    for (j = 1; j + 1 <= cols(tok); j = j + 2) {
        for (i = 1; i <= rows(ids); i++) {
            if (ids[i] == tok[j]) sec[i] = strtoreal(tok[j + 1])
        }
    }
    o = order((-sec, (1::rows(ids))), (1, 2))
    load = J(1, n, 0)
    at = J(rows(ids), 1, 0)
    for (i = 1; i <= rows(o); i++) {
        best = 1
        for (p = 2; p <= n; p++) if (load[p] < load[best]) best = p
        load[best] = load[best] + sec[o[i]]
        at[o[i]] = best
    }
    run = ""
    for (i = 1; i <= rows(ids); i++) if (at[i] == k) run = run + " " + ids[i]
    st_local("w44_run", strtrim(run))
}
end
// The part this session runs: the runner's shard table may turn the
// parts (cert_helpers.do's cert_split_part, 11nov2026), so that
// each script's longest part lands on a different session.
cert_split_part "test_wp44_truth.cscript" `w44_k' `w44_N'
local w44_p = r(part)
mata: _w44_part("test_wp44_truth.cscript", st_local("w44_secs"), `w44_p', `w44_N')
display as text "test_wp44_truth: session `w44_k'/`w44_N' runs part `w44_p', `: word count `w44_run'' blocks: `w44_run'"
// ---- parts: end ----

* ==== S00 scaffold: the helpers load and a twoway SVG is read ====
local only : env WP44_ONLY
if inlist("`only'", "", "S00") & `: list posof "S00" in w44_run' {
    display as text "S00 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q4400-1: cert_svg_export and cert_svg_texts on one twoway scatter,
    // and dash's own programs are loaded from this tree.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(w44s01, replace)
    cert_svg_export, name(w44s01) file("`w44_work'/w44s01.svg")
    local s01_rc   = r(rc)
    local s01_file "`r(file)'"
    _w44_expect Q4400-1 "(`s01_rc' == 0)" "cert_svg_export rc `s01_rc'"
    capture confirm file "`s01_file'"
    _w44_expect Q4400-1 "(_rc == 0)" "r(file) `s01_file' does not exist"
    cert_svg_texts, file("`s01_file'")
    local s01_n    = r(n)
    local s01_list "`r(list)'"
    _w44_expect Q4400-1 "(`s01_n' > 0)" "cert_svg_texts found no text elements"
    capture program list _dash_serve
    _w44_expect Q4400-1 "(_rc == 0)" "dash.ado's _dash_serve is not loaded"
    _w44_done Q4400-1 "a twoway SVG was written and read (`s01_n' texts); dash is loaded"

    capture erase "`s01_file'"
    capture erase "`s01_list'"
    capture graph drop w44s01
    display as text "S00 end " c(current_date) " " c(current_time)
}
* ==== end S00 ====

// ----------------------------------------------------------------
// S01 helpers (WP-44 44-01, axis titles).  _q4401_reg draws one
// command with twoway (log, SVG) and registers it with dash; the
// python helper _q4401_check builds both modes from the spec and puts
// twoway's answer in $q4401_tw, the saved and served answers in
// $q4401_s and $q4401_v, and whether a "not implemented" note was
// printed in $q4401_noted.  Legend key proxies are never read (only
// axes, titles and side-panel Labels are).
// ----------------------------------------------------------------
python:
def _q4401_docs(sp, dp, app):
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings(record=True) as w1:
        warnings.simplefilter("always")
        r = dr.DashRenderer(sp, dp)
        r.render()
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        dr.ServerAppBuilder(sp, dp).build(app)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_q4401_app")
    with warnings.catch_warnings(record=True) as w2:
        warnings.simplefilter("always")
        exec(compile(src.replace(attach, "pass"), "dash_q4401_app.py",
                     "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    sv = [m for m in doc.models if type(m).__name__ == "figure"]
    return (list(r.figures.values()), sv,
            "\n".join(str(x.message) for x in w1),
            "\n".join(str(x.message) for x in w2))


def _q4401_deg(v):
    import math
    if v == "parallel":
        return "parallel"
    try:
        return "%d" % int(round(math.degrees(float(v))))
    except (TypeError, ValueError):
        return str(v)


def _q4401_texts(f):
    """Every axis title, Title and side-panel Label text of figure *f*."""
    out = []
    for side in ("left", "right", "below", "above"):
        for m in getattr(f, side):
            t = getattr(m, "axis_label", None) if hasattr(
                m, "axis_label") else getattr(m, "text", None)
            if t:
                out.append((side, type(m).__name__, str(t), m))
    if f.title is not None and getattr(f.title, "text", None):
        out.append(("above", "Title", str(f.title.text), f.title))
    return out


def _q4401_dash(figs, case):
    f = [g for g in figs if getattr(g, "left", None) is not None][0]
    kind, _, arg = case.partition(":")
    if kind in ("orient", "right"):
        side = "left" if kind == "orient" else "right"
        axs = [m for m in getattr(f, side)
               if type(m).__name__.endswith("Axis") and m.axis_label]
        return _q4401_deg(axs[0].axis_label_orientation) if axs else "none"
    if kind == "box":
        labs = [m for s in ("left", "right", "below", "above")
                for m in getattr(f, s)
                if "dash_axis_title_box" in (m.tags or [])]
        if not labs:
            return "none"
        side = next(s for s in ("left", "right", "below", "above")
                    if any(m is labs[0] for m in getattr(f, s)))
        return "box %s %s" % (side, _q4401_deg(labs[0].angle))
    if kind == "lines":
        ts = [t for _s, _k, t, _m in _q4401_texts(f)]
        if any(t in ("A\nB", "B\nA") for t in ts):
            return "two"
        if any(t in ("A B", "B A") for t in ts):
            return "one"
        return "none"
    if kind == "xt":
        ts = [t for s, _k, t, _m in _q4401_texts(f) if s == "below"]
        return arg if arg in ts else "|".join(ts) or "none"
    return "?"


def _q4401_tw(case, svg):
    import svg_truth
    texts = svg_truth.svg_document(svg)["texts"]
    kind, _, arg = case.partition(":")
    if kind in ("orient", "right"):
        t = [x for x in texts if x["text"] == arg]
        if not t:
            return "none"
        return "%d" % int(round(-(t[0]["rotate"] or 0.0)))
    if kind == "box":
        # A small filled rect round the title's text, whatever the scheme.
        doc = svg_truth.svg_document(svg)
        t = [x for x in texts if x["text"] == arg]
        if not t:
            return "none"
        tx, ty = t[0]["x"], t[0]["y"]
        drawn = any(r["fill"] not in (None, "none") and r["w"] and r["h"]
                    and r["x"] <= tx <= r["x"] + r["w"]
                    and r["y"] <= ty <= r["y"] + r["h"]
                    and r["w"] < 0.25 * doc["canvas"]["w"]
                    and r["h"] < 0.5 * doc["canvas"]["h"]
                    for r in doc["rects"])
        return "box" if drawn else "none"
    if kind == "lines":
        ts = [x["text"] for x in texts]
        if "A B" in ts or "B A" in ts:
            return "one"
        if "A" in ts and "B" in ts:
            return "two"
        return "none"
    if kind == "xt":
        ts = [x["text"] for x in texts]
        return arg if arg in ts else "none"
    return "?"


def _q4401_check(sp, dp, app, svg, case):
    import os
    import sys
    from sfi import Macro
    repo = os.path.abspath(Macro.getGlobal("q4401_repo"))
    for d in (repo, os.path.join(repo, "scripts")):
        if d not in sys.path:
            sys.path.insert(0, d)
    a, b, na, nb = _q4401_docs(sp, dp, app)
    Macro.setGlobal("q4401_tw", _q4401_tw(case, svg))
    Macro.setGlobal("q4401_s", _q4401_dash(a, case))
    Macro.setGlobal("q4401_v", _q4401_dash(b, case))
    Macro.setGlobal("q4401_noted", "1" if "not implemented" in na + nb
                    else "0")
end

capture program drop _q4401_reg
program define _q4401_reg
    // _q4401_reg <dir> <k> <case> <data> <command with options...>
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    gettoken case 0 : 0
    gettoken data 0 : 0
    sysuse `data', clear
    capture graph drop q4401t
    capture noisily twoway `0' name(q4401t, replace)
    capture erase "`dir'/t`k'.svg"
    quietly graph export "`dir'/t`k'.svg", replace
    graph drop q4401t
    dash clear
    capture noisily dash `0' name(zq4401`k')
    local drc = _rc
    if `drc' {
        global q4401_tw "(twoway drawn)"
        global q4401_s "rc `drc'"
        global q4401_v "rc `drc'"
        global q4401_noted 0
        exit
    }
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _q4401_m; _q4401_m._q4401_check("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py", "`dir'/t`k'.svg", "`case'")
end

capture program drop _q4401_same
program define _q4401_same
    // _q4401_same <id> <label> <want>: twoway, saved and served all <want>,
    // with no note.
    version 19
    args id label want
    _w44_expect `id' `"("${q4401_tw}" == "`want'")"' `"`label': twoway drew ${q4401_tw}, expected `want'"'
    _w44_expect `id' `"("${q4401_s}" == "`want'")"' `"`label': saved ${q4401_s}, twoway `want'"'
    _w44_expect `id' `"("${q4401_v}" == "`want'")"' `"`label': served ${q4401_v}, twoway `want'"'
    _w44_expect `id' "(${q4401_noted} == 0)" `"`label': a not-implemented note was printed"'
end

* ==== S01 AX-13: axis title sub-options drawn ====
local only : env WP44_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w44_run' {
    display as text "S01 start " c(current_date) " " c(current_time)
    local q01 "`w44_work'/s01"
    capture mkdir "`q01'"
    global q4401_repo : env DASH_REPO
    if `"${q4401_repo}"' == "" global q4401_repo ".."

    // Q4401-1: ytitle("Y", orientation(horizontal)) draws the title
    // upright in twoway and in both modes, with no note.
    _q4401_reg "`q01'" 1 "orient:Y" auto scatter mpg weight, ytitle("Y", orientation(horizontal))
    _q4401_same Q4401-1 "orientation(horizontal)" "0"
    _w44_done Q4401-1 "orientation(horizontal): twoway ${q4401_tw}, saved ${q4401_s}, served ${q4401_v}"

    // Q4401-2: a boxed y title, left and on axis 2: twoway frames it;
    // dash draws it as a side-panel Label beside its axis, reading
    // upward, with no note.
    _q4401_reg "`q01'" 2 "box:Y" auto scatter mpg weight, ytitle("Y", box)
    _w44_expect Q4401-2 `"("${q4401_tw}" == "box")"' "left: twoway drew no box"
    _w44_expect Q4401-2 `"("${q4401_s}" == "box left 90" & "${q4401_v}" == "box left 90")"' "left: saved ${q4401_s}, served ${q4401_v}"
    _w44_expect Q4401-2 "(${q4401_noted} == 0)" "left: a note was printed"
    _q4401_reg "`q01'" 3 "box:Y" auto (scatter mpg weight) (scatter price weight, yaxis(2)), ytitle("Y", box axis(2))
    _w44_expect Q4401-2 `"("${q4401_tw}" == "box")"' "axis 2: twoway drew no box"
    _w44_expect Q4401-2 `"("${q4401_s}" == "box right 90" & "${q4401_v}" == "box right 90")"' "axis 2: saved ${q4401_s}, served ${q4401_v}"
    _w44_expect Q4401-2 "(${q4401_noted} == 0)" "axis 2: a note was printed"
    _w44_done Q4401-2 "boxed y titles drawn left and on axis 2"

    capture graph drop _all
    dash clear
    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====
* ==== S01 PIC-12: right-hand y titles read upward ====
local only : env WP44_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w44_run' {
    display as text "S01 start " c(current_date) " " c(current_time)
    local q01 "`w44_work'/s01"
    capture mkdir "`q01'"
    global q4401_repo : env DASH_REPO
    if `"${q4401_repo}"' == "" global q4401_repo ".."

    // Q4401-3: the y2 title and economist's right-hand y title read
    // upward (twoway rotate(-90)) in both modes.
    _q4401_reg "`q01'" 4 "right:Price" auto (scatter mpg weight) (scatter price weight, yaxis(2)),
    _q4401_same Q4401-3 "yaxis(2)" "90"
    _q4401_reg "`q01'" 5 "right:Mileage (mpg)" auto scatter mpg weight, scheme(economist)
    _q4401_same Q4401-3 "economist" "90"
    _w44_done Q4401-3 "right-hand y titles read upward (yaxis(2), economist)"

    // Q4401-4: orientation(horizontal) on the axis-2 title wins.
    _q4401_reg "`q01'" 6 "right:P" auto (scatter mpg weight) (scatter price weight, yaxis(2)), ytitle("P", axis(2) orientation(horizontal))
    _q4401_same Q4401-4 "axis(2) orientation(horizontal)" "0"
    _w44_done Q4401-4 "the axis-2 title's orientation(horizontal) is drawn upright"

    capture graph drop _all
    dash clear
    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====

* ==== S01 MS-13: axis title copies on two lines ====
local only : env WP44_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w44_run' {
    display as text "S01 start " c(current_date) " " c(current_time)
    local q01 "`w44_work'/s01"
    capture mkdir "`q01'"
    global q4401_repo : env DASH_REPO
    if `"${q4401_repo}"' == "" global q4401_repo ".."

    // Q4401-5: <key>(A) <key>(B, suffix) -- and prefix -- draws two
    // lines on xtitle(), ytitle(), ttitle() and their axis(2) forms, in
    // twoway and in both modes; title(A) title(B, suffix) draws one.
    local i 10
    foreach k in xtitle ytitle {
        foreach w in suffix prefix {
            local ++i
            _q4401_reg "`q01'" `i' "lines" auto scatter mpg weight, `k'(A) `k'(B, `w')
            _q4401_same Q4401-5 "`k' `w'" "two"
        }
    }
    foreach w in suffix prefix {
        local ++i
        _q4401_reg "`q01'" `i' "lines" sp500 line close date, ttitle(A) ttitle(B, `w')
        _q4401_same Q4401-5 "ttitle `w'" "two"
        local ++i
        _q4401_reg "`q01'" `i' "lines" auto (scatter mpg weight) (scatter price weight, yaxis(2)), ytitle(A, axis(2)) ytitle(B, `w' axis(2))
        _q4401_same Q4401-5 "ytitle axis(2) `w'" "two"
        local ++i
        _q4401_reg "`q01'" `i' "lines" auto (scatter mpg weight) (scatter mpg length, xaxis(2)), xtitle(A, axis(2)) xtitle(B, `w' axis(2))
        _q4401_same Q4401-5 "xtitle axis(2) `w'" "two"
        local ++i
        _q4401_reg "`q01'" `i' "lines" sp500 line close date, xaxis(1 2) ttitle(A, axis(2)) ttitle(B, `w' axis(2))
        _q4401_same Q4401-5 "ttitle axis(2) `w'" "two"
    }
    local ++i
    _q4401_reg "`q01'" `i' "lines" auto scatter mpg weight, title(A) title(B, suffix)
    _q4401_same Q4401-5 "title suffix" "one"
    _w44_done Q4401-5 "axis-title copies on two lines; title() on one"

    capture graph drop _all
    dash clear
    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====

* ==== S01 MS-11: the ... default title ====
local only : env WP44_ONLY
if inlist("`only'", "", "S01") & `: list posof "S01" in w44_run' {
    display as text "S01 start " c(current_date) " " c(current_time)
    local q01 "`w44_work'/s01"
    capture mkdir "`q01'"
    global q4401_repo : env DASH_REPO
    if `"${q4401_repo}"' == "" global q4401_repo ".."

    // Q4401-6: layers on two y axes with different x variables: twoway
    // titles the x axis "Weight (lbs.)..." (audit E12, E13, C04), and so
    // does dash in both modes.
    _q4401_reg "`q01'" 41 "xt:Weight (lbs.)..." auto (scatter mpg weight) (scatter price length, yaxis(2)),
    _q4401_same Q4401-6 "E12" "Weight (lbs.)..."
    _q4401_reg "`q01'" 42 "xt:Weight (lbs.)..." auto (scatter mpg weight) (scatteri 20 3000 25 4000, yaxis(2)),
    _q4401_same Q4401-6 "E13" "Weight (lbs.)..."
    _q4401_reg "`q01'" 43 "xt:Weight (lbs.)..." auto (scatter mpg weight) (scatter mpg length, yaxis(2)) (scatter price weight, yaxis(2)),
    _q4401_same Q4401-6 "C04" "Weight (lbs.)..."
    _w44_done Q4401-6 "the ... x title of E12, E13 and C04"

    // Q4401-7: an upright layer beside a turned one on y axis 2 (HZ-28).
    _q4401_reg "`q01'" 44 "xt:Weight (lbs.)..." auto (scatter mpg weight) (rcap mpg turn weight, horizontal yaxis(2)),
    _q4401_same Q4401-7 "HZ-28" "Weight (lbs.)..."
    _w44_done Q4401-7 "the ... x title beside a turned layer"

    capture graph drop _all
    dash clear
    display as text "S01 end " c(current_date) " " c(current_time)
}
* ==== end S01 ====

// ----------------------------------------------------------------
// S02 helpers (WP-44 44-02, label and tick sub-options).  _q4402_reg
// <dir> <k> <case> <command...> draws the command on auto with twoway
// (SVG) and registers it with dash; the python helper _q4402_check
// builds both modes from the spec (S01's _q4401_docs) and puts twoway's
// answer in $q4402_tw and the saved and served answers in $q4402_s and
// $q4402_v.  Cases: "ycol:<text>" -- the colours of the y labels other
// than <text>; "ylabs" -- whether the y labels are drawn; "ygrid" --
// the colours of the y gridlines; "xtgrid" -- the colour of the x
// tick-option gridlines; "yticks" -- whether the y ticks are drawn;
// "ygridall" -- the colours of the y gridlines, black included;
// "gxext" -- the x values the y gridlines run between; "ytext:<values>"
// -- the y label texts at <values> (twoway's in the order written, dash's
// from its y axis writer's format); "xlens" -- along the x axis, L for
// each tick drawn at the major length and S for one drawn shorter.
// Legend key proxies are never read (only axes and grids are).
// ----------------------------------------------------------------
python:
def _q4402_dash(figs, case):
    from bokeh.models import Axis, Grid
    f = [g for g in figs if getattr(g, "left", None) is not None][0]
    kind, _, arg = case.partition(":")
    if kind == "ycol":
        ax = [m for m in f.left if isinstance(m, Axis)][0]
        return str(ax.major_label_text_color).lower()
    if kind == "ylabs":
        ax = [m for m in f.left if isinstance(m, Axis)][0]
        return "none" if ax.major_label_text_font_size == "0px" else "labels"
    if kind == "ygrid":
        gs = [g for g in f.renderers + f.center if isinstance(g, Grid)
              and g.dimension == 1 and g.grid_line_color is not None]
        return " ".join(sorted({str(g.grid_line_color).lower()
                                for g in gs})) or "none"
    if kind == "xtgrid":
        gs = [g for g in f.renderers + f.center if isinstance(g, Grid)
              and g.dimension == 0 and g.minor_grid_line_color is not None]
        return " ".join(sorted({str(g.minor_grid_line_color).lower()
                                for g in gs})) or "none"
    if kind == "yticks":
        ax = [m for m in f.left if isinstance(m, Axis)][0]
        drawn = ax.major_tick_out or ax.major_tick_in
        return "ticks" if drawn else "none"
    if kind == "ygridall":
        gs = [g for g in f.renderers + f.center if isinstance(g, Grid)
              and g.dimension == 1 and g.grid_line_color is not None]
        return " ".join(sorted({str(g.grid_line_color).lower()
                                for g in gs})) or "none"
    if kind == "xlens":
        import dash_render as dr
        from bokeh.models import CustomJSTicker
        ax = [m for m in f.below if isinstance(m, Axis)][0]
        t = ax.ticker
        a = dict(t.args or {}) if isinstance(t, CustomJSTicker) else {}
        lo, hi = sorted((f.x_range.start, f.x_range.end))
        base = list(getattr(a.get("base", t), "ticks", None) or [])
        extra = list(a.get("extra") or [])
        own = list(a.get("mextra") or [])
        if getattr(t, "major_code", "") == getattr(
                dr, "_DASH_TICK_UNION_JS", None):
            major, minor = base + extra, own
        else:
            major, minor = base, extra + own
        drawn = {}
        for v in minor:
            drawn[float(v)] = ax.minor_tick_out
        for v in major:
            drawn[float(v)] = ax.major_tick_out
        top = max(drawn.values())
        return " ".join("L" if drawn[v] == top else "S"
                        for v in sorted(drawn) if lo <= v <= hi)
    if kind == "ytext":
        import dash_render as dr
        ax = [m for m in f.left if isinstance(m, Axis)][0]
        fmt = (getattr(ax.formatter, "args", None) or {}).get("fmt")
        return " ".join(dr._dash_fmt_text(float(v), fmt or "%9.0g")
                        for v in arg.split())
    if kind == "gxext":
        gs = [g for g in f.renderers + f.center if isinstance(g, Grid)
              and g.dimension == 1 and g.grid_line_color is not None]
        b = gs[0].cross_bounds if gs else "auto"
        return "full" if b == "auto" else "%d %d" % (round(b[0]),
                                                     round(b[1]))
    return "?"


def _q4402_tw(case, svg):
    import svg_truth
    doc = svg_truth.svg_document(svg)
    kind, _, arg = case.partition(":")
    pr = doc["plotregion"]
    if kind == "ycol":
        # The texts left of the plot region but the outermost (the axis
        # title), whichever way the scheme turns them.
        left = [t for t in doc["texts"]
                if t["x"] is not None and t["x"] < pr["left"]]
        if left:
            far = min(t["x"] for t in left)
            left = [t for t in left if t["x"] > far]
        fills = {t["fill"] for t in left if t["text"] != arg}
        return " ".join(sorted(fills)) or "none"
    if kind == "ylabs":
        left = [t for t in doc["texts"]
                if t["x"] is not None and t["x"] < pr["left"]]
        return "labels" if len(left) > 1 else "none"
    if kind == "xlens":
        ts = sorted((ln["x1"], abs(ln["y2"] - ln["y1"]))
                    for ln in doc["vlines"]
                    if min(ln["y1"], ln["y2"]) >= pr["bottom"] - 1)
        top = max(n for _x, n in ts) if ts else 0
        return " ".join("L" if n > 0.75 * top else "S" for _x, n in ts)
    if kind == "ytext":
        # In the order written, the outermost text (the axis title) left
        # out, whichever way the scheme turns them.
        left = [t for t in doc["texts"]
                if t["x"] is not None and t["x"] < pr["left"]]
        far = min(t["x"] for t in left) if left else 0
        return " ".join(t["text"] for t in left if t["x"] > far)
    if kind == "ygrid":
        got = sorted({ln["stroke"] for ln in doc["hlines"]
                      if ln["stroke"] not in (None, "#000000")})
        return " ".join(got) or "none"
    if kind == "xtgrid":
        # twoway writes a dashed line as short segments, so the colour
        # is compared (the pattern is pinned by TestTickGrid).
        got = sorted({ln["stroke"] for ln in doc["vlines"]
                      if ln["stroke"] not in (None, "#000000")})
        return " ".join(got) or "none"
    if kind == "yticks":
        ticks = [ln for ln in doc["hlines"]
                 if min(ln["x1"], ln["x2"]) < pr["left"] - 1]
        return "ticks" if ticks else "none"
    grid = [ln for ln in doc["hlines"] if ln["y1"] < pr["bottom"] - 1
            and max(ln["x1"], ln["x2"]) > pr["left"] + 100]
    if kind == "ygridall":
        return " ".join(sorted({ln["stroke"] for ln in grid})) or "none"
    if kind == "gxext":
        # The x labels 2,000 and 5,000 give the x scale's mapping.
        at = {t["text"]: t["x"] for t in doc["texts"]
              if t["text"] in ("2,000", "5,000")}
        k = 3000.0 / (at["5,000"] - at["2,000"])
        lo = min(min(ln["x1"], ln["x2"]) for ln in grid)
        hi = max(max(ln["x1"], ln["x2"]) for ln in grid)
        if lo <= pr["left"] + 1 and hi >= pr["right"] - 1:
            return "full"
        return "%d %d" % (round(2000 + (lo - at["2,000"]) * k),
                          round(2000 + (hi - at["2,000"]) * k))
    return "?"


def _q4402_check(sp, dp, app, svg, case):
    import os
    import sys
    from sfi import Macro
    repo = os.path.abspath(Macro.getGlobal("q4401_repo"))
    for d in (repo, os.path.join(repo, "scripts")):
        if d not in sys.path:
            sys.path.insert(0, d)
    a, b, _na, _nb = _q4401_docs(sp, dp, app)
    Macro.setGlobal("q4402_tw", _q4402_tw(case, svg))
    Macro.setGlobal("q4402_s", _q4402_dash(a, case))
    Macro.setGlobal("q4402_v", _q4402_dash(b, case))
end

capture program drop _q4402_reg
program define _q4402_reg
    // _q4402_reg <dir> <k> <case> <command with options...>
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    gettoken case 0 : 0
    sysuse auto, clear
    capture graph drop q4402t
    quietly twoway `0' name(q4402t, replace)
    capture erase "`dir'/t`k'.svg"
    quietly graph export "`dir'/t`k'.svg", replace
    graph drop q4402t
    dash clear
    quietly dash `0' name(zq4402`k')
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _q4402_m; _q4402_m._q4402_check("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py", "`dir'/t`k'.svg", "`case'")
end

capture program drop _q4402_same
program define _q4402_same
    // _q4402_same <id> <label>: saved and served equal twoway.
    version 19
    args id label
    _w44_expect `id' `"("${q4402_s}" == "${q4402_tw}")"' `"`label': saved ${q4402_s}, twoway ${q4402_tw}"'
    _w44_expect `id' `"("${q4402_v}" == "${q4402_tw}")"' `"`label': served ${q4402_v}, twoway ${q4402_tw}"'
end

* ==== S02 AX-5: custom ticks styled alone ====
local only : env WP44_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w44_run' {
    display as text "S02 start " c(current_date) " " c(current_time)
    local q02 "`w44_work'/s02"
    capture mkdir "`q02'"
    global q4401_repo : env DASH_REPO
    if `"${q4401_repo}"' == "" global q4401_repo ".."

    // Q4402-1: ylabel(25 "x", add custom labcolor(red)) draws every y
    // label red, where twoway leaves the other labels in the axis's
    // colour (ruling D73, a documented difference: Bokeh draws one label
    // look per axis), and a custom option's glcolor() changes no
    // gridline, as twoway draws them, saved and served.
    _q4402_reg "`q02'" 1 "ycol:x" scatter mpg weight, ylabel(25 "x", add custom labcolor(red) labsize(large))
    _w44_expect Q4402-1 `"("${q4402_s}" == "#ff0000")"' `"add custom labcolor(red): saved ${q4402_s} (D73: every label), twoway ${q4402_tw}"'
    _w44_expect Q4402-1 `"("${q4402_v}" == "#ff0000")"' `"add custom labcolor(red): served ${q4402_v} (D73: every label), twoway ${q4402_tw}"'
    _q4402_reg "`q02'" 2 "ygrid" scatter mpg weight, ylabel(25, add custom labcolor(red) grid glcolor(red))
    _q4402_same Q4402-1 "add custom glcolor(red): the gridlines"
    _q4402_reg "`q02'" 3 "ygrid" scatter mpg weight, ylabel(, custom grid glcolor(red))
    _q4402_same Q4402-1 "custom grid glcolor(red): the gridlines"
    _w44_done Q4402-1 "add custom styles every label (D73) and its grid edits change nothing"

    capture graph drop _all
    dash clear
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

* ==== S02 AX-6: tick-option gridlines in the major style ====
local only : env WP44_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w44_run' {
    display as text "S02 start " c(current_date) " " c(current_time)
    local q02 "`w44_work'/s02b"
    capture mkdir "`q02'"
    global q4401_repo : env DASH_REPO
    if `"${q4401_repo}"' == "" global q4401_repo ".."

    // Q4402-3: xtick(, grid) and xmtick(, grid) draw their gridlines in
    // the major grid's colour under s2color and stcolor, as twoway draws
    // them (the x major grid is off under s2color, so twoway's only x
    // gridlines are the tick option's), saved and served.
    local k 0
    foreach sch in s2color stcolor {
        foreach o in xtick xmtick {
            local ++k
            _q4402_reg "`q02'" `k' "xtgrid" scatter mpg weight, `o'(2500 3500, grid) scheme(`sch')
            _q4402_same Q4402-3 "`o'(, grid) under `sch'"
        }
    }
    _w44_done Q4402-3 "tick-option gridlines take the major grid's look"

    capture graph drop _all
    dash clear
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

* ==== S02 AX-8: the label words ====
local only : env WP44_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w44_run' {
    display as text "S02 start " c(current_date) " " c(current_time)
    local q02 "`w44_work'/s02c"
    capture mkdir "`q02'"
    global q4401_repo : env DASH_REPO
    if `"${q4401_repo}"' == "" global q4401_repo ".."

    // Q4402-4: noshowlabels hides the y labels and showlabels beside
    // nolabels shows them; nopgmgrid hides the y grid, nogrid wins over
    // pgmgrid and grid over nopgmgrid, as twoway draws them, saved and
    // served.
    local k 0
    foreach o in "noshowlabels" "showlabels nolabels" "noshowlabels labels" {
        local ++k
        _q4402_reg "`q02'" `k' "ylabs" scatter mpg weight, ylabel(, `o')
        _q4402_same Q4402-4 "ylabel(, `o')"
    }
    foreach o in "nopgmgrid" "nogrid pgmgrid" "grid nopgmgrid" {
        local ++k
        _q4402_reg "`q02'" `k' "ygrid" scatter mpg weight, ylabel(, `o') scheme(s2color)
        _q4402_same Q4402-4 "ylabel(, `o')"
    }
    _w44_done Q4402-4 "showlabels, noshowlabels, pgmgrid and nopgmgrid drawn as twoway draws them"

    capture graph drop _all
    dash clear
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

* ==== S02 AX-14: the style names and nogextend ====
local only : env WP44_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w44_run' {
    display as text "S02 start " c(current_date) " " c(current_time)
    local q02 "`w44_work'/s02d"
    capture mkdir "`q02'"
    global q4401_repo : env DASH_REPO
    if `"${q4401_repo}"' == "" global q4401_repo ".."

    // Q4402-5: tstyle(), style(), gstyle() and glstyle() read Stata's
    // style files and nogextend ends the y gridlines at the x scale, as
    // twoway draws them, saved and served (AX-14, and AX-8's style()).
    local k 0
    foreach o in "tstyle(major_notick)" "style(major_vert_notick)" {
        local ++k
        _q4402_reg "`q02'" `k' "yticks" scatter mpg weight, ylabel(, `o')
        _q4402_same Q4402-5 "ylabel(, `o'): the ticks"
    }
    foreach o in "tstyle(major_nolabel)" "style(major_vert_nolabel)" {
        local ++k
        _q4402_reg "`q02'" `k' "ylabs" scatter mpg weight, ylabel(, `o')
        _q4402_same Q4402-5 "ylabel(, `o'): the labels"
    }
    foreach o in "grid gstyle(dot)" "grid glstyle(refline)" {
        local ++k
        _q4402_reg "`q02'" `k' "ygridall" scatter mpg weight, ylabel(, `o')
        _q4402_same Q4402-5 "ylabel(, `o'): the gridlines"
    }
    foreach o in "grid nogextend" "grid" {
        local ++k
        _q4402_reg "`q02'" `k' "gxext" scatter mpg weight, ylabel(, `o')
        _q4402_same Q4402-5 "ylabel(, `o'): the gridlines' ends"
    }
    _w44_done Q4402-5 "the axis style names and nogextend drawn as twoway draws them"

    capture graph drop _all
    dash clear
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

* ==== S02 AX-15: string and hex formats, two tick lengths ====
local only : env WP44_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w44_run' {
    display as text "S02 start " c(current_date) " " c(current_time)
    local q02 "`w44_work'/s02e"
    capture mkdir "`q02'"
    global q4401_repo : env DASH_REPO
    if `"${q4401_repo}"' == "" global q4401_repo ".."

    // Q4402-6: ylabel(, format()) with %21x, %-21x, %16H, %8H, %16L and
    // %12s writes each y label as twoway writes it, saved and served.
    local L "0 0.1 -0.5 10 33.3333333"
    local k 0
    foreach f in %21x %-21x %16H %8H %16L %12s {
        local ++k
        _q4402_reg "`q02'" `k' "ytext:`L'" scatter mpg weight, ylabel(`L', format(`f'))
        _q4402_same Q4402-6 "ylabel(, format(`f'))"
    }
    _w44_done Q4402-6 "the hexadecimal, IEEE-byte and string axis formats written as twoway writes them"

    // Q4402-9: xtick() beside xmtick() draws its positions as long as the
    // labelled ticks and the xmtick() ones shorter, as twoway draws them,
    // saved and served.
    local ++k
    _q4402_reg "`q02'" `k' "xlens" scatter mpg weight, xtick(2500 4500) xmtick(3500)
    _q4402_same Q4402-9 "xtick(2500 4500) xmtick(3500)"
    _w44_done Q4402-9 "xtick() and xmtick() drawn at their own lengths"

    capture graph drop _all
    dash clear
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

// ----------------------------------------------------------------
// S03 helpers (WP-44 section 44-03, scales).  _q4403_reg draws one
// command in twoway (an SVG) and in dash (the saved page and the served
// app, through _q4401_docs) and sets q4403_tw, q4403_s and q4403_v to
// what <case> reads of each: yleft/xbottom the plot region's edge in
// twoway and, in dash, whether the axis is "kept" (laid out, painting
// nothing), "hidden" or "plain"; yticks the y axis's tick values.
// ----------------------------------------------------------------
python:
def _q4403_num(s):
    try:
        return float(str(s).replace(",", ""))
    except ValueError:
        return None


def _q4403_tw(case, svg):
    import svg_truth
    doc = svg_truth.svg_document(svg)
    pr = doc["plotregion"]
    if case == "yleft":
        return "%.1f" % pr["left"]
    if case == "xbottom":
        return "%.1f" % pr["bottom"]
    if case in ("ygrid", "xgrid"):
        # twoway writes a dashed grid line as short segments: the rows
        # (columns) of non-black lines inside the plot region.
        if case == "ygrid":
            got = {round(ln["y1"], 1) for ln in doc["hlines"]
                   if pr["top"] + 0.5 < ln["y1"] < pr["bottom"] - 0.5
                   and ln["stroke"] not in (None, "#000000")}
        else:
            got = {round(ln["x1"], 1) for ln in doc["vlines"]
                   if pr["left"] + 0.5 < ln["x1"] < pr["right"] - 0.5
                   and ln["stroke"] not in (None, "#000000")}
        return "grid" if got else "none"
    if case == "xline":
        on = [ln for ln in doc["hlines"]
              if abs(ln["y1"] - pr["bottom"]) < 0.5
              and abs(ln["x2"] - ln["x1"]) > 0.5 * (pr["right"] - pr["left"])]
        return "line" if on else "none"
    if case == "ylabtext":
        # The y labels' texts, bottom to top; the axis title, the
        # outermost text, left out (labels may be turned under s2color).
        left = [t for t in doc["texts"] if t["x"] is not None
                and t["y"] is not None and t["x"] < pr["left"]]
        far = min(t["x"] for t in left) if left else 0
        got = [(t["y"], t["text"]) for t in left if t["x"] > far]
        return " ".join(txt for _y, txt in sorted(got, reverse=True))
    if case in ("yticks", "xticks"):
        if case == "yticks":
            vals = [_q4403_num(t["text"]) for t in doc["texts"]
                    if t["x"] is not None and t["x"] < pr["left"]]
        else:
            vals = [_q4403_num(t["text"]) for t in doc["texts"]
                    if t["y"] is not None and t["y"] > pr["bottom"]
                    and t["rotate"] is None]
        return " ".join("%g" % v for v in sorted(v for v in vals
                                                   if v is not None))
    return "?"


def _q4403_dash(figs, case):
    from bokeh.models import Axis
    f = [g for g in figs if getattr(g, "left", None) is not None][0]
    if case in ("yleft", "xbottom"):
        side = f.left if case == "yleft" else f.below
        ax = [m for m in side if isinstance(m, Axis)][0]
        if ax.visible is False:
            return "hidden"
        return ("kept" if str(ax.major_label_text_color) == "#00000000"
                and ax.axis_line_color is None else "plain")
    if case in ("ygrid", "xgrid"):
        from bokeh.models import Grid
        dim = 1 if case == "ygrid" else 0
        on = [g for g in list(f.renderers) + list(f.center)
              if isinstance(g, Grid) and g.dimension == dim and g.visible
              and g.grid_line_color is not None]
        return "grid" if on else "none"
    if case == "xline":
        ax = [m for m in f.below if isinstance(m, Axis)][0]
        return "none" if ax.axis_line_color is None else "line"
    if case == "ylabtext":
        ax = [m for m in f.left if isinstance(m, Axis)][0]
        ov = {float(k): v for k, v in dict(ax.major_label_overrides).items()}
        t = sorted(getattr(ax.ticker, "ticks", None) or [])
        return " ".join(str(ov.get(float(v), v)) for v in t)
    if case in ("yticks", "xticks"):
        side = f.left if case == "yticks" else f.below
        ax = [m for m in side if isinstance(m, Axis)][0]
        t = list(getattr(ax.ticker, "ticks", None) or [])
        return " ".join("%g" % v for v in sorted(t))
    return "?"


def _q4403_check(sp, dp, app, svg, case):
    import os
    import sys
    from sfi import Macro
    repo = os.path.abspath(Macro.getGlobal("q4401_repo"))
    for d in (repo, os.path.join(repo, "scripts")):
        if d not in sys.path:
            sys.path.insert(0, d)
    a, b, _na, _nb = _q4401_docs(sp, dp, app)
    Macro.setGlobal("q4403_tw", _q4403_tw(case, svg))
    Macro.setGlobal("q4403_s", _q4403_dash(a, case))
    Macro.setGlobal("q4403_v", _q4403_dash(b, case))
end

capture program drop _q4403_reg
program define _q4403_reg
    // _q4403_reg <dir> <k> <case> <prep|-> <command with options...>
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    gettoken case 0 : 0
    gettoken prep 0 : 0
    sysuse auto, clear
    if `"`prep'"' != "-" {
        `prep'
    }
    capture graph drop q4403t
    quietly twoway `0' name(q4403t, replace)
    capture erase "`dir'/t`k'.svg"
    quietly graph export "`dir'/t`k'.svg", replace
    graph drop q4403t
    dash clear
    quietly dash `0' name(zq4403`k')
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _q4403_m; _q4403_m._q4403_check("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py", "`dir'/t`k'.svg", "`case'")
end

* ==== S03 AX-7: off fill keeps the space ====
local only : env WP44_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w44_run' {
    display as text "S03 start " c(current_date) " " c(current_time)
    local q03 "`w44_work'/s03"
    capture mkdir "`q03'"
    global q4401_repo : env DASH_REPO
    if `"${q4401_repo}"' == "" global q4401_repo ".."

    // Q4403-1: yscale(off fill) and xscale(off fill) keep the axis's
    // space, as twoway keeps the plain graph's plot-region edge, with
    // nothing of the axis painted, saved and served; off alone hides it.
    foreach L in y x {
        local case = cond("`L'" == "y", "yleft", "xbottom")
        _q4403_reg "`q03'" `L'1 `case' - scatter mpg weight,
        local plain "${q4403_tw}"
        _q4403_reg "`q03'" `L'2 `case' - scatter mpg weight, `L'scale(off fill)
        _w44_expect Q4403-1 `"("${q4403_tw}" == "`plain'")"' `"`L'scale(off fill): twoway's edge ${q4403_tw}, the plain graph's `plain'"'
        _w44_expect Q4403-1 `"("${q4403_s}" == "kept")"' `"`L'scale(off fill): saved ${q4403_s}"'
        _w44_expect Q4403-1 `"("${q4403_v}" == "kept")"' `"`L'scale(off fill): served ${q4403_v}"'
        _q4403_reg "`q03'" `L'3 `case' - scatter mpg weight, `L'scale(off)
        _w44_expect Q4403-1 `"("${q4403_tw}" != "`plain'")"' `"`L'scale(off): twoway's edge ${q4403_tw} moves"'
        _w44_expect Q4403-1 `"("${q4403_s}" == "hidden" & "${q4403_v}" == "hidden")"' `"`L'scale(off): saved ${q4403_s}, served ${q4403_v}"'
    }
    _w44_done Q4403-1 "off fill keeps the axis's space; off alone takes it"

    capture graph drop _all
    dash clear
    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

* ==== S03 AX-9: scale styles ====
local only : env WP44_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w44_run' {
    display as text "S03 start " c(current_date) " " c(current_time)
    local q03 "`w44_work'/s03b"
    capture mkdir "`q03'"
    global q4401_repo : env DASH_REPO
    if `"${q4401_repo}"' == "" global q4401_repo ".."

    // Q4403-5: yscale(style(vertical_nogrid)) draws no y grid and
    // xscale(style(horizontal_noline)) no x axis line and no x grid (its
    // file names a grid key no scheme declares), as twoway draws them,
    // saved and served, under stcolor.
    local k 0
    foreach c in "ygrid yscale(style(vertical_nogrid))" "xgrid yscale(style(vertical_nogrid))" "xline xscale(style(horizontal_noline))" "xgrid xscale(style(horizontal_noline))" {
        local ++k
        gettoken case opt : c
        _q4403_reg "`q03'" `k' `case' - scatter mpg weight, `opt' scheme(stcolor)
        _w44_expect Q4403-5 `"("${q4403_s}" == "${q4403_tw}" & "${q4403_v}" == "${q4403_tw}")"' `"`opt' `case': twoway ${q4403_tw}, saved ${q4403_s}, served ${q4403_v}"'
    }
    _w44_done Q4403-5 "scale style() reads Stata's axis style file as twoway does"

    capture graph drop _all
    dash clear
    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

* ==== S03 AX-11: log ticks over every value ====
local only : env WP44_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w44_run' {
    display as text "S03 start " c(current_date) " " c(current_time)
    local q03 "`w44_work'/s03c"
    capture mkdir "`q03'"
    global q4401_repo : env DASH_REPO
    if `"${q4401_repo}"' == "" global q4401_repo ".."

    // Q4403-7: a log axis over values at or below 0 is ticked as twoway
    // ticks it, over every finite value (z = mpg - 25: 10 20, where dash
    // drew 5 10 15), and a log axis over positive values keeps its ticks,
    // saved and served.  twoway's degenerate picture is documented (A-5).
    _q4403_reg "`q03'" 1 yticks "generate z = mpg - 25" scatter z weight, yscale(log)
    _w44_expect Q4403-7 `"("${q4403_s}" == "${q4403_tw}" & "${q4403_v}" == "${q4403_tw}")"' `"scatter z weight, yscale(log): twoway ${q4403_tw}, saved ${q4403_s}, served ${q4403_v}"'
    _q4403_reg "`q03'" 2 yticks - scatter mpg weight, yscale(log)
    _w44_expect Q4403-7 `"("${q4403_s}" == "${q4403_tw}" & "${q4403_v}" == "${q4403_tw}")"' `"scatter mpg weight, yscale(log): twoway ${q4403_tw}, saved ${q4403_s}, served ${q4403_v}"'
    _w44_done Q4403-7 "a log axis is ticked over every finite value, as twoway ticks it"

    capture graph drop _all
    dash clear
    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

* ==== S03 MS-14: log range() ticks over the data ====
local only : env WP44_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w44_run' {
    display as text "S03 start " c(current_date) " " c(current_time)
    local q03 "`w44_work'/s03d"
    capture mkdir "`q03'"
    global q4401_repo : env DASH_REPO
    if `"${q4401_repo}"' == "" global q4401_repo ".."

    // Q4403-8 / Q4403-9: range() on a log axis adds no tick at the
    // range's end (B04 on x, b2 on y), as twoway ticks them over the
    // data, saved and served (34-03's range rule; pinned by WP-44 MS-14).
    _q4403_reg "`q03'" 1 xticks - scatter mpg weight, xscale(range(1000)) xscale(log)
    _w44_expect Q4403-8 `"("${q4403_s}" == "${q4403_tw}" & "${q4403_v}" == "${q4403_tw}")"' `"xscale(range(1000)) xscale(log): twoway ${q4403_tw}, saved ${q4403_s}, served ${q4403_v}"'
    _w44_done Q4403-8 "xscale(range()) on a log axis adds no end tick"
    _q4403_reg "`q03'" 2 yticks - scatter weight mpg, yscale(log range(1000 20000))
    _w44_expect Q4403-9 `"("${q4403_s}" == "${q4403_tw}" & "${q4403_v}" == "${q4403_tw}")"' `"yscale(log range(1000 20000)): twoway ${q4403_tw}, saved ${q4403_s}, served ${q4403_v}"'
    _w44_done Q4403-9 "yscale(log range()) adds no end tick"

    capture graph drop _all
    dash clear
    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

* ==== S03 DG-13: empty minmax and overflowing spans ====
local only : env WP44_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w44_run' {
    display as text "S03 start " c(current_date) " " c(current_time)
    local q03 "`w44_work'/s03e"
    capture mkdir "`q03'"
    global q4401_repo : env DASH_REPO
    if `"${q4401_repo}"' == "" global q4401_repo ".."

    // Q4403-10 / Q4403-11: ylabel(minmax) on a graph with no observation
    // writes twoway's labels, 1.e+300 at the bottom and -1.e+300 at the
    // top, and 1.e+300 alone on a log axis, saved and served.  (The span
    // refusal is Q4403-12, in test_option_validation.cscript.)
    _q4403_reg "`q03'" 1 ylabtext - scatter mpg weight if price < 0, xlabel(#5) ylabel(minmax)
    _w44_expect Q4403-10 `"("${q4403_s}" == "${q4403_tw}" & "${q4403_v}" == "${q4403_tw}")"' `"ylabel(minmax), no row: twoway ${q4403_tw}, saved ${q4403_s}, served ${q4403_v}"'
    _w44_done Q4403-10 "minmax on an empty scale writes twoway's two labels"
    _q4403_reg "`q03'" 2 ylabtext - scatter mpg weight if price < 0, xlabel(#5) ylabel(minmax) yscale(log)
    _w44_expect Q4403-11 `"("${q4403_s}" == "${q4403_tw}" & "${q4403_v}" == "${q4403_tw}")"' `"ylabel(minmax) yscale(log), no row: twoway ${q4403_tw}, saved ${q4403_s}, served ${q4403_v}"'
    _w44_done Q4403-11 "minmax on an empty log scale writes twoway's label"

    capture graph drop _all
    dash clear
    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

// WP-44 WE: the prep of the block below.
capture program drop _q4403_cut
program define _q4403_cut
    // The 20 lightest cars keep their mpg; the other 54 miss it.
    sort weight
    quietly replace mpg = . if _n > 20
end
* ==== S03 AX-19: each variable over the layer's own rows ====
local only : env WP44_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w44_run' {
    display as text "S03 start " c(current_date) " " c(current_time)
    local q03 "`w44_work'/s03f"
    capture mkdir "`q03'"
    global q4401_repo : env DASH_REPO
    if `"${q4401_repo}"' == "" global q4401_repo ".."

    // Q4403-13: a row whose y is missing still counts for x, and one whose
    // x is missing for y, as twoway reads each variable over the layer's
    // rows (WP-44 AX-19; axis_rows_truth.json), saved and served -- the
    // export asking Stata over the same rows.
    _q4403_reg "`q03'" 1 xticks _q4403_cut scatter mpg weight,
    _w44_expect Q4403-13 `"("${q4403_s}" == "${q4403_tw}" & "${q4403_v}" == "${q4403_tw}")"' `"scatter mpg weight, mpg on 20 rows: twoway x ${q4403_tw}, saved ${q4403_s}, served ${q4403_v}"'
    _q4403_reg "`q03'" 2 yticks _q4403_cut line weight mpg,
    _w44_expect Q4403-13 `"("${q4403_s}" == "${q4403_tw}" & "${q4403_v}" == "${q4403_tw}")"' `"line weight mpg, mpg on 20 rows: twoway y ${q4403_tw}, saved ${q4403_s}, served ${q4403_v}"'
    _w44_done Q4403-13 "each variable is read over the layer's own rows"

    capture graph drop _all
    dash clear
    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

// S04 helpers (WP-44 44-04).  _q4404_reg <dir> <k> <key> <axis> <dash
// command...>: registers the dash graph, builds it saved and served, and
// writes each mode's <axis> axis as "<axis type>|<label texts>"
// (q4404_got_s, q4404_got_v; the labels are the formatter's format
// written at each tick by dash's own Python writer) and twoway's, from
// test/fixtures/date_axis_rule_truth.json <key>, in the same form
// (q4404_want): LogAxis under a log scale, DatetimeAxis where twoway
// writes dates, else LinearAxis.  Legend-only key proxies are no axis.
python:
import os as _q4404_os
import sys as _q4404_sys
# dash_render.py of this tree (the script runs from test/).
_q4404_sys.path.insert(0, _q4404_os.path.abspath(".."))


def _q4404_docs(sp, dp, app):
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
    with open(app, encoding="utf-8") as fh:
        src = fh.read()
    attach = "if __name__ != '__main__':\n    make_document(curdoc())"
    ns = dict(__name__="dash_q4404_app")
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        exec(compile(src.replace(attach, "pass"), "dash_q4404_app.py",
                     "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    sv = [m for m in doc.models if type(m).__name__ == "figure"
          and m.renderers]
    return list(r.figures.values()), sv


def _q4404_axis(fig, which):
    import dash_render as dr
    side, rn, nm = {"x": ("below", "x_range_name", "default"),
                    "y": ("left", "y_range_name", "default"),
                    "x2": ("above", "x_range_name", "x2"),
                    "y2": ("right", "y_range_name", "y2")}[which]
    axes = [a for a in getattr(fig, side) if hasattr(a, "ticker")
            and getattr(a, rn, "default") == nm]
    if not axes:
        return "none"
    ax = axes[0]
    t = ax.ticker
    args = dict(getattr(t, "args", None) or {})
    base = args.get("base", t)
    ticks = list(getattr(base, "ticks", None) or [])
    fa = dict(getattr(ax.formatter, "args", None) or {})
    fmt, kind = fa.get("fmt", "%9.0g"), fa.get("kind", "")
    texts = []
    for v in ticks:
        u = dr._dash_stata_value_of(v, kind) if kind else v
        texts.append(dr._dash_fmt(u, fmt, strip=True))
    return type(ax).__name__ + "|" + " ".join(texts)


def _q4404_draw(sp, dp, app, key, which):
    import json, os, re
    from sfi import Macro
    a, b = _q4404_docs(sp, dp, app)
    Macro.setGlobal("q4404_got_s", _q4404_axis(a[0], which))
    Macro.setGlobal("q4404_got_v", _q4404_axis(b[0], which))
    with open(os.path.join("fixtures", "date_axis_rule_truth.json"),
              encoding="utf-8") as fh:
        row = json.load(fh)[key]
    labels = list(row[which[0] + "axis"]["labels"])
    if which[0] == "y":
        labels.reverse()
    cmd = row["command"]
    dated = any(re.search(r"[a-z]", t or "") for t in labels)
    typ = ("LogAxis" if re.search(r"scale\(log", cmd) else
           "DatetimeAxis" if dated else "LinearAxis")
    Macro.setGlobal("q4404_want", typ + "|" + " ".join(labels))
end

capture program drop _q4404_reg
program define _q4404_reg
    // _q4404_reg <dir> <k> <key> <axis> <dash command, options>
    version 19
    gettoken dir 0 : 0
    gettoken k 0 : 0
    gettoken key 0 : 0
    gettoken which 0 : 0
    dash clear
    // A registered graph: name() after the command's own options (every
    // case's command ends in its option comma or its options).
    quietly dash `0' name(zq4404_`k')
    _dash_serve_spec, specpath("`dir'/s`k'.json") datapath("`dir'/d`k'.json")
    python: import __main__ as _q4404_m; _q4404_m._q4404_draw("`dir'/s`k'.json", "`dir'/d`k'.json", "`dir'/a`k'.py", "`key'", "`which'")
end

* ==== S04 AX-18: numbers and log on date axes ====
local only : env WP44_ONLY
if inlist("`only'", "", "S04") & `: list posof "S04" in w44_run' {
    display as text "S04 start " c(current_date) " " c(current_time)
    local q4d "`w44_work'/s04"
    capture mkdir "`q4d'"
    capture graph drop _all
    set scheme s2color
    sysuse sp500, clear

    // ------------------------------------------------------------
    // Q4404-1: kdensity of a date labels its axis with the date's
    // numbers, 15000 ... 15400, as twoway does (first layer, alone and
    // horizontal), both modes.
    // ------------------------------------------------------------
    local k 0
    foreach c in "ax18.first_kdensity x (kdensity date) (scatter close date)," ///
                 "ax18.kdensity_alone x kdensity date," ///
                 "ax18.hz y kdensity date, horizontal" {
        local ++k
        gettoken key c : c
        gettoken which c : c
        _q4404_reg "`q4d'" 1`k' `key' `which' `c'
        foreach m in s v {
            _w44_expect Q4404-1 `"("${q4404_got_`m'}" == "${q4404_want}")"' "`key' `m': ${q4404_got_`m'}, twoway ${q4404_want}"
        }
    }
    _w44_done Q4404-1 "kdensity of a date is labelled with its numbers, as twoway labels it, saved and served"

    // ------------------------------------------------------------
    // Q4404-2: a fit or an immediate type that gives the axis its format
    // labels it with numbers; a scatter, fpfit or line first keeps the
    // dates; with a second y axis the group whose first layer comes last
    // decides (ax18.ygrp_*), both modes.
    // ------------------------------------------------------------
    local k 0
    foreach c in "ax18.first_lfit x (lfit close date) (scatter close date)," ///
                 "ax18.first_qfitci x (qfitci close date) (scatter close date)," ///
                 "ax18.first_lpoly x (lpoly close date) (scatter close date)," ///
                 "ax18.first_scatteri x (scatteri 1300 15400) (scatter close date)," ///
                 "ax18.first_pci x (pci 1300 15200 1400 15300) (scatter close date)," ///
                 "ax18.first_function x (function y = 1300, range(15000 15400)) (scatter close date)," ///
                 "ax18.first_fpfit x (fpfit close date) (scatter close date)," ///
                 "ax18.scatter_first x (scatter close date) (lfit close date)," ///
                 "ax18.lfit_range x (lfit close date, range(14900 15400)) (scatter close date)," ///
                 "ax18.y_lfit y (lfit date close) (scatter date close)," ///
                 "ax18.ygrp_lfit_second x (scatter close date) (lfit open date, yaxis(2))," ///
                 "ax18.ygrp_lfit_first x (lfit close date) (scatter open date, yaxis(2))," {
        local ++k
        gettoken key c : c
        gettoken which c : c
        _q4404_reg "`q4d'" 2`k' `key' `which' `c'
        foreach m in s v {
            _w44_expect Q4404-2 `"("${q4404_got_`m'}" == "${q4404_want}")"' "`key' `m': ${q4404_got_`m'}, twoway ${q4404_want}"
        }
    }
    _w44_done Q4404-2 "the layer an axis takes its format from decides dates or numbers, as twoway, saved and served"

    // ------------------------------------------------------------
    // Q4404-3: xscale(log)/yscale(log) on a date axis draw a log axis
    // with twoway's date labels (%td and %tm, #4 included), and dash
    // writes no warning.
    // ------------------------------------------------------------
    gen int m = mofd(date)
    format m %tm
    local k 0
    foreach c in "ax18.log_x_td x line close date, xscale(log)" ///
                 "ax18.log_y_td y scatter date close, yscale(log)" ///
                 "ax18.log_x4_td x line close date, xscale(log) xlabel(#4)" ///
                 "ax18.log_x_tm x line close m, xscale(log)" ///
                 "ax18.log_y_tm y scatter m close, yscale(log)" ///
                 "ax18.log_x4_tm x line close m, xscale(log) xlabel(#4)" {
        local ++k
        gettoken key c : c
        gettoken which c : c
        _q4404_reg "`q4d'" 3`k' `key' `which' `c'
        foreach m in s v {
            _w44_expect Q4404-3 `"("${q4404_got_`m'}" == "${q4404_want}")"' "`key' `m': ${q4404_got_`m'}, twoway ${q4404_want}"
        }
    }
    dash clear
    capture noisily dash line close date, xscale(log)
    local q3rc = _rc
    _w44_expect Q4404-3 "(`q3rc' == 0)" "dash line close date, xscale(log) rc `q3rc'"
    _w44_done Q4404-3 "log date axes are drawn with twoway's date labels, saved and served"
    drop m

    dash clear
    capture graph drop _all
    display as text "S04 end " c(current_date) " " c(current_time)
}
* ==== end S04 ====

* ==== S04 DG-6: %tC ticks in raw units ====
local only : env WP44_ONLY
if inlist("`only'", "", "S04") & `: list posof "S04" in w44_run' {
    display as text "S04 start " c(current_date) " " c(current_time)
    local q4d "`w44_work'/s04"
    capture mkdir "`q4d'"
    capture graph drop _all
    set scheme s2color

    // ------------------------------------------------------------
    // Q4404-4: a %tC axis is ticked over its raw values and labelled to
    // the second as twoway labels it (dg6.T05: 01jan2001 20:26:18 ...;
    // dg6.tC_2016 across the 2016 leap second); %tc is unchanged
    // (dg6.T04), both modes.
    // ------------------------------------------------------------
    local k 0
    // The first instants as numbers: tc(01jan2001 00:00:00) and
    // tc(31dec2016 23:58:00), the extract script's.
    foreach c in "dg6.T04 1293926400000 86400000 t" ///
                 "dg6.T05 1293926400000 86400000 tC" ///
                 "dg6.tC_2016 1798847880000 10000 tC" {
        local ++k
        gettoken key c : c
        gettoken t0 c : c
        gettoken step c : c
        gettoken var c : c
        clear
        quietly set obs 30
        quietly gen double t = `t0' + (_n - 1) * `step'
        quietly gen double tC = Cofc(t)
        format t %tc
        format tC %tC
        quietly gen y = _n
        _q4404_reg "`q4d'" 4`k' `key' x scatter y `var',
        foreach m in s v {
            _w44_expect Q4404-4 `"("${q4404_got_`m'}" == "${q4404_want}")"' "`key' `m': ${q4404_got_`m'}, twoway ${q4404_want}"
        }
    }
    _w44_done Q4404-4 "%tC axes are ticked and labelled as twoway's, to the second, saved and served"

    dash clear
    capture graph drop _all
    display as text "S04 end " c(current_date) " " c(current_time)
}
* ==== end S04 ====

// S04 DG-4 helper: the registered graph's x options, as dash.ado wrote
// them into its spec (q4404_xl, q4404_xn, q4404_xs: xlabel, xline,
// xscale), and twoway's rc and first log line for <key> from
// date_axis_rule_truth.json (q4404_trc, q4404_tmsg); _q4404_said: 1 when
// dash's log holds that line (q4404_said).
python:
def _q4404_opts(sp, key):
    import json, os
    from sfi import Macro
    go = {}
    if sp:
        with open(sp, encoding="utf-8") as fh:
            go = json.load(fh)["graphs"][0]["graph_options"]
    for k, nm in (("xlabel", "xl"), ("xline", "xn"), ("xscale", "xs")):
        Macro.setGlobal("q4404_" + nm, " ".join(str(go.get(k, "")).split()))
    with open(os.path.join("fixtures", "date_axis_rule_truth.json"),
              encoding="utf-8") as fh:
        row = json.load(fh)[key]
    Macro.setGlobal("q4404_trc", str(row["rc"]))
    Macro.setGlobal("q4404_tmsg", row["log"][0] if row["log"] else "")


def _q4404_said(logpath):
    """1 when dash's log holds twoway's first line (both read with their
    runs of blanks as one, as the fixture records them)."""
    from sfi import Macro
    want = Macro.getGlobal("q4404_tmsg")
    with open(logpath, encoding="utf-8", errors="replace") as fh:
        got = [" ".join(ln.split()) for ln in fh]
    Macro.setGlobal("q4404_said", "1" if want and want in got else "0")
end

* ==== S04 DG-4: parenthesised dates with blanks ====
local only : env WP44_ONLY
if inlist("`only'", "", "S04") & `: list posof "S04" in w44_run' {
    display as text "S04 start " c(current_date) " " c(current_time)
    local q4d "`w44_work'/s04"
    capture mkdir "`q4d'"
    capture graph drop _all
    set scheme s2color
    sysuse sp500, clear

    // ------------------------------------------------------------
    // Q4404-5: a date in parentheses holding blanks is read in tlabel(),
    // tline() and tscale(range()) as twoway reads it (dg4.DT04, DT05,
    // DT09, DT20: drawn at 01jan2001, 01jul2001, 15jun2001, 01dec2000
    // and 31jan2002); one twoway refuses keeps its rc and line
    // (dg4.DT06: a comma inside; dg4.ttext: ttext()'s position).
    // ------------------------------------------------------------
    local d1 = td(01jan2001)
    local d2 = td(01jul2001)
    local d3 = td(15jun2001)
    local d4 = td(01dec2000)
    local d5 = td(31jan2002)
    local k 0
    foreach c in "dg4.DT04 xl `d1' `d2'|tlabel((1 jan 2001) (1 jul 2001))" ///
                 "dg4.DT05 xl `d1' `d2'|tlabel(01jan2001 (1 jul 2001))" ///
                 "dg4.DT09 xn `d3'|tline((15 jun 2001))" ///
                 "dg4.DT20 xs range(`d4' `d5')|tscale(range((1 dec 2000) (31 jan 2002)))" ///
                 "dg4.DT06 -|tlabel((july 1, 2001))" {
        local ++k
        gettoken head opt : c, parse("|")
        local opt = substr(`"`opt'"', 2, .)
        gettoken key head : head
        gettoken fld want : head
        local want = strtrim(`"`want'"')
        dash clear
        capture log close _q45
        quietly log using "`q4d'/q45_`k'.log", text replace name(_q45)
        capture noisily dash line close date, `opt' name(zq45_`k')
        local drc = _rc
        quietly log close _q45
        if `drc' == 0 {
            _dash_serve_spec, specpath("`q4d'/s5`k'.json") datapath("`q4d'/d5`k'.json")
            python: import __main__ as _q4404_m; _q4404_m._q4404_opts("`q4d'/s5`k'.json", "`key'")
        }
        else {
            python: import __main__ as _q4404_m; _q4404_m._q4404_opts("", "`key'")
        }
        _w44_expect Q4404-5 "(`drc' == ${q4404_trc})" "`key': dash rc `drc', twoway rc ${q4404_trc}"
        if ${q4404_trc} == 0 & `drc' == 0 {
            _w44_expect Q4404-5 `"("${q4404_`fld'}" == "`want'")"' "`key': dash wrote `fld' ${q4404_`fld'}, twoway's dates `want'"
        }
        if ${q4404_trc} != 0 {
            python: import __main__ as _q4404_m; _q4404_m._q4404_said("`q4d'/q45_`k'.log")
            _w44_expect Q4404-5 "(${q4404_said} == 1)" "`key': dash's log lacks twoway's line ${q4404_tmsg}"
        }
    }
    // ttext()'s position: twoway refuses a parenthesised date there.
    dash clear
    capture noisily dash line close date, ttext(1300 (15 jun 2001) "x") name(zq45_t)
    local drc = _rc
    python: import __main__ as _q4404_m; _q4404_m._q4404_opts("", "dg4.ttext")
    _w44_expect Q4404-5 "(`drc' == ${q4404_trc})" "dg4.ttext: dash rc `drc', twoway rc ${q4404_trc}"
    _w44_done Q4404-5 "parenthesised dates with blanks are read where twoway reads them, refused where it refuses them"

    dash clear
    capture graph drop _all
    display as text "S04 end " c(current_date) " " c(current_time)
}
* ==== end S04 ====

// WP-44 WE: the prep of the block below.
capture program drop _q4404_bars
program define _q4404_bars
    quietly keep in 1/8
    quietly generate t = _n
end
* ==== S04 AX-20: a baroffset() bar is ticked over its x ====
local only : env WP44_ONLY
if inlist("`only'", "", "S04") & `: list posof "S04" in w44_run' {
    display as text "S04 start " c(current_date) " " c(current_time)
    local q04 "`w44_work'/s04x"
    capture mkdir "`q04'"
    global q4401_repo : env DASH_REPO
    if `"${q4401_repo}"' == "" global q4401_repo ".."

    // Q4404-6: bar and rbar with baroffset(3) are ticked over the bars' x
    // (1-8: 0(2)8), as twoway ticks them (yxview.class minmax_range;
    // axis_rows_truth.json ax20_n_three), saved and served.
    _q4403_reg "`q04'" 1 xticks _q4404_bars bar mpg t, baroffset(3)
    _w44_expect Q4404-6 `"("${q4403_s}" == "${q4403_tw}" & "${q4403_v}" == "${q4403_tw}")"' `"bar mpg t, baroffset(3): twoway ${q4403_tw}, saved ${q4403_s}, served ${q4403_v}"'
    _q4403_reg "`q04'" 2 xticks _q4404_bars rbar mpg price t, baroffset(-2)
    _w44_expect Q4404-6 `"("${q4403_s}" == "${q4403_tw}" & "${q4403_v}" == "${q4403_tw}")"' `"rbar mpg price t, baroffset(-2): twoway ${q4403_tw}, saved ${q4403_s}, served ${q4403_v}"'
    _w44_done Q4404-6 "a baroffset() bar is ticked over its x"

    capture graph drop _all
    dash clear
    display as text "S04 end " c(current_date) " " c(current_time)
}
* ==== end S04 ====

// S05 helpers (WP-44 44-05).  _q4405_reg <dir> <dash command...>:
// register one graph and count the drawn y and x grids (a Grid whose
// line colour is set) both modes draw, into q4405_<y|x><s|v>;
// _q4405_svg <file>: twoway's gridline groups -- the horizontal and
// vertical lines whose stroke is not black -- into q4405_ty and q4405_tx.
python:
import os as _q4405_os, sys as _q4405_sys
for _q4405_p in (_q4405_os.path.abspath(".."),
                 _q4405_os.path.abspath(_q4405_os.path.join("..", "scripts"))):
    if _q4405_p not in _q4405_sys.path:
        _q4405_sys.path.insert(0, _q4405_p)


def _q4405_read(sp, dp, app):
    import warnings
    import dash_render as dr
    from bokeh.document import Document
    from bokeh.models import Grid
    from sfi import Macro
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        r = dr.DashRenderer(sp, dp)
        r.render()
        dr.ServerAppBuilder(sp, dp).build(app)
        with open(app, encoding="utf-8") as fh:
            src = fh.read()
        attach = "if __name__ != '__main__':\n    make_document(curdoc())"
        ns = dict(__name__="dash_q4405_app")
        exec(compile(src.replace(attach, "pass"), "dash_q4405_app.py",
                     "exec"), ns)
        doc = Document()
        ns["make_document"](doc)
    for models, sfx in ((list(r._last_layout_root.references()), "s"),
                        (list(doc.models), "v")):
        grids = [m for m in models if isinstance(m, Grid)
                 and m.grid_line_color is not None]
        Macro.setGlobal("q4405_y" + sfx,
                        str(sum(1 for g in grids if g.dimension == 1)))
        Macro.setGlobal("q4405_x" + sfx,
                        str(sum(1 for g in grids if g.dimension == 0)))


def _q4405_svg(path):
    from sfi import Macro
    from svg_truth import svg_document
    d = svg_document(path)
    for kind, g in (("hlines", "q4405_ty"), ("vlines", "q4405_tx")):
        Macro.setGlobal(g, str(sum(1 for ln in d[kind]
                                   if ln.get("stroke") not in (None, "#000000"))))
end

capture program drop _q4405_reg
program define _q4405_reg
    version 19
    gettoken dir 0 : 0
    dash clear
    quietly dash `0'
    _dash_serve_spec, specpath("`dir'/s.json") datapath("`dir'/d.json")
    python: import __main__ as _q4405_m; _q4405_m._q4405_read("`dir'/s.json", "`dir'/d.json", "`dir'/a.py")
end

* ==== S05 MS-12: lone second axis without gridlines ====
local only : env WP44_ONLY
if inlist("`only'", "", "S05") & `: list posof "S05" in w44_run' {
    display as text "S05 start " c(current_date) " " c(current_time)
    local q05d "`w44_work'/s05a"
    capture mkdir "`q05d'"
    capture graph drop _all

    // ------------------------------------------------------------
    // Q4405-1: a graph whose every layer is on a second (or third)
    // axis draws no gridline of that dimension, live twoway beside
    // dash, saved and served; ylabel(, grid axis(2)) and a graph on
    // axis 1 draw them (test/fixtures/axis_misc_truth.json ms12.*).
    // ------------------------------------------------------------
    foreach c in "y|0|scatter mpg weight, yaxis(2)" "y|0|pci 20 3000 30 4000, yaxis(2)" ///
            "y|0|scatter mpg weight, yaxis(3)" "y|1|scatter mpg weight, yaxis(2) ylabel(, grid axis(2))" ///
            "y|1|scatter mpg weight" "x|0|scatter mpg weight, xaxis(2) scheme(stcolor)" ///
            "x|1|scatter mpg weight, scheme(stcolor)" {
        gettoken d c : c, parse("|")
        gettoken w c : c, parse("|")
        gettoken w c : c, parse("|")
        gettoken bar c : c, parse("|")
        sysuse auto, clear
        local comma = cond(strpos(`"`c'"', ","), "", ",")
        quietly twoway `c'`comma' name(q05t, replace)
        capture erase "`q05d'/q05t.svg"
        cert_svg_export, name(q05t) file("`q05d'/q05t.svg")
        python: import __main__ as _q4405_m; _q4405_m._q4405_svg("`q05d'/q05t.svg")
        local tw = (${q4405_t`d'} > 0)
        _q4405_reg "`q05d'" `c'`comma' name(q05d)
        local gs = (${q4405_`d's} > 0)
        local gv = (${q4405_`d'v} > 0)
        _w44_expect Q4405-1 "(`tw' == `w' & `gs' == `w' & `gv' == `w')" `"`c': `d' grid twoway `tw' (want `w'), dash saved `gs', served `gv'"'
    }
    _w44_done Q4405-1 "a lone second or third axis draws no gridline, as twoway draws it; grid asked for and axis 1 keep theirs, saved and served"

    capture graph drop _all
    capture dash clear
    macro drop q4405_*
    display as text "S05 end " c(current_date) " " c(current_time)
}
* ==== end S05 ====

* ==== append new blocks above this line ====

// ----------------------------------------------------------------
// Summary (test_wp29_truth.cscript's shape)
// ----------------------------------------------------------------
capture graph drop _all
capture dash clear
capture rmdir "`w44_work'"
local nfail    = ${w44_nfail}
local faillist "${w44_faillist}"
local ncase    = ${w44_ncase}
local only : env WP44_ONLY
macro drop w44_nfail w44_faillist w44_bad w44_ncase
display as text ""
display as text "============================================================"
if `ncase' == 0 {
    if `w44_N' > 1 & `"`macval(only)'"' == "" & "`w44_run'" == "" {
        display as text "test_wp44_truth: part `w44_k'/`w44_N' has no block to run"
        display as text "============================================================"
        exit 0
    }
    // A WP44_ONLY that names no block, or only a stub, ran nothing:
    // that is not a pass.
    display as error "  test_wp44_truth: no case ran (WP44_ONLY=`only')"
    display as text "============================================================"
    exit 9
}
else if `nfail' == 0 {
    display as text "  test_wp44_truth: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_wp44_truth: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
