*! test_adversarial.cscript
*! Adversarial/security certification script for dash command.
*! Tests XSS, injection, path traversal, resource exhaustion, and
*! server-mode security properties.
*!
*! Tests: P2-78 through P2-84, P4-84 through P4-86
*!         SV-01..SV-87 (WP-28 G2, generated region)
*!         DL-01..DL-06 (WP-28 G3)
*!
*! Usage:  do test/test_adversarial.cscript
*!
*! Requires: dash_setup completed, Python + bokeh installed
*! Version: 1.0.0  25mar2026

cscript "dash adversarial security" adodir ".."

// ----------------------------------------------------------------
// Setup — check dependencies
// ----------------------------------------------------------------

// Do NOT probe with `capture python: pass'.  Measured: that returns a
// nonzero rc inside the runner even though the very same session renders
// Bokeh output through `dash build' moments later, and it made 9 of the 14
// scripts -- every end-to-end one -- skip while the suite reported ALL TESTS
// PASSED.  c(python_exec) is set by Stata's own Python configuration and
// reads without executing anything, so it cannot fail for reasons unrelated
// to Python being present.
if "`c(python_exec)'" == "" {
    display as error "SKIP: Python not available."
    exit 222
}

// Whether bokeh is importable can only be answered by importing it, so
// this probe does run Python -- but the FIRST python call of a session
// returns a nonzero rc under the runner for reasons that have nothing to do
// with the import (see the c(python_exec) note above).  Spend that failure
// on a throwaway call, then ask the real question, then ask it once more.
capture python: pass
capture python: import bokeh
if _rc != 0 capture python: import bokeh
if _rc != 0 {
    display as error "SKIP: bokeh not installed. Run dash_setup first."
    exit 222
}

qui sysuse auto, clear

// Load the dash command and parser
do "../dash_parse.mata"
do "../dash.ado"

// Shared certification helpers.  cert_file_has searches a file from Mata,
// where a line is a value rather than macro text, so no character in the
// rendered dashboard can end a quote or be parsed as Stata code -- and it
// exits 603 if the file cannot be opened, so a security check that reads no
// file fails instead of reporting "payload not found".
do "cert_helpers.do"

// cscript runs `macro drop _all', which takes the runner's
// $dash_nobrowser with it, so P2-78's `dash build' below reached the shell
// line that opens a browser on every run (the console binary reports
// c(os) "Unix" and ran xdg-open).  Set again here, after cscript.
global dash_nobrowser 1

// ================================================================
// P2-78 — XSS in title → <script> HTML-escaped in output HTML
// ================================================================
qui sysuse auto, clear
dash scatter mpg weight, name(s1) title(`"<script>alert(1)</script>"')
tempfile xss_out
local xss_path = "`xss_out'.html"
capture erase "`xss_path'"
// The payload goes in the dashboard's own title() too.  That title is drawn
// in the page header, a Div, whose text a browser parses as HTML -- the one
// title on the page that reaches markup; a graph's title is text drawn on a
// canvas.
dash build, saving("`xss_path'") replace title(`"<script>alert(1)</script>"')

// Scan the output file for the raw payload — it must NOT be present.
//
// This was a line-by-line scan testing
// `strpos(`"`line'"', "<script>alert(1)")'.  A line of the rendered
// dashboard is JSON full of " characters, and a sequence such as "' or `"
// inside it terminates the compound quotes the macro is expanded in; the
// scan died with "too few quotes" r(132) and the document's own content was
// handed to Stata as code.  It never reached its assertion, so this
// security check has never once executed.
//
// WHAT IS ASSERTED.  The needle is the literal byte sequence
// "<script>alert(1)" -- the payload in the form a browser would execute.
// The renderer escapes what it puts in the document (html.escape for text
// it writes itself, Bokeh's own serializer for text carried inside the
// document JSON), so the payload is EXPECTED to be present in the file in
// escaped form -- as HTML entities (&lt; and &gt;) where dash writes the
// text itself, and as HTML entities again where Bokeh writes the document
// blob (measured 24sep2026: "text":"&lt;script&gt;alert(1)&lt;/script&gt;"
// in the Title model; it is not written as JSON unicode escapes).  Neither
// escaped form contains the raw literal we search for.  An escaped payload
// therefore passes, which is the correct verdict: escaped, it is inert
// text.  Only a payload that arrived as executable markup fails.  The
// search is CASE-SENSITIVE: the question is whether the exact bytes that
// were injected came back out, not whether the page anywhere mentions the
// word "script".
//
// The limit of the check, stated rather than papered over: it asserts the
// payload is not present raw, not that the title reached the document at
// all, so a renderer that silently dropped the title would also pass -- the
// document checks after it close that gap.  What this check no longer does
// is pass when there is no file to read: cert_file_has exits 603 on a file
// it cannot open.
cert_file_has "`xss_path'", needle("<script>alert(1)")
local found_raw_xss = r(found)
assert `found_raw_xss' == 0

// And that search cannot fail on the document: Bokeh HTML-escapes the whole
// embedded JSON (bokeh/embed/elements.py), so no text inside a model ever
// reaches the page as raw <script> -- measured 24sep2026, with the header's
// html.escape removed the payload became live markup in the header Div and
// the search above still passed.  It keeps its use for the page around the
// document (its <title> carries this title, escaped by the page template).
// The document is read back instead, decoded as BokehJS
// decodes it (JSON.parse of the unescaped block) and read with
// Document.from_json: the graph's Title model holds the payload as its
// literal text, so the title reached the canvas intact; no HTML-rendering
// model -- Div, Paragraph, PreText -- holds it literally; and the header
// Div holds it escaped, so the one markup sink was reached, as text.
local p278page "`xss_path'"
python:
import html
import json
import re
from sfi import Macro
from bokeh.document import Document
from bokeh.models import Div, Markup, Title


def _p278_doc(path):
    with open(path, encoding="utf-8") as fh:
        page = fh.read()
    ents = {"amp": "&", "lt": "<", "gt": ">", "quot": chr(34),
            "#x27": chr(39), "#x60": chr(96)}
    blocks = re.findall(
        r'<script type="application/json" id="[^"]+">\s*(.*?)\s*</script>',
        page, re.S)
    docs = [d for b in blocks
            for d in json.loads(re.sub(r"&(amp|lt|gt|quot|#x27|#x60);",
                                       lambda m: ents[m.group(1)], b)).values()]
    return Document.from_json(docs[0]) if len(docs) == 1 else None


_p278pl = "<script>alert(1)</script>"
_p278 = _p278_doc(Macro.getLocal("p278page"))
_p278all = list(_p278.models) if _p278 is not None else []
_p278t = [m.text for m in _p278all if isinstance(m, Title) and m.text]
_p278mk = [m for m in _p278all if isinstance(m, Markup)]
Macro.setLocal("p278_ndoc", "1" if _p278 is not None else "0")
Macro.setLocal("p278_title", "1" if _p278t == [_p278pl] else "0")
Macro.setLocal("p278_raw", str(sum(_p278pl in (m.text or "") for m in _p278mk)))
Macro.setLocal("p278_esc", str(sum(html.escape(_p278pl) in (m.text or "")
                                   for m in _p278mk if isinstance(m, Div))))
del _p278, _p278all, _p278t, _p278mk
end
assert `p278_ndoc' == 1
assert `p278_title' == 1
assert `p278_raw' == 0
assert `p278_esc' == 1
display "P2-78 PASS: XSS title not present unescaped in HTML output"
dash clear

// ================================================================
// P2-79 — Shell injection in varname → Mata parser rejects
// ================================================================
// Stata variable names must match [a-zA-Z_][a-zA-Z0-9_]{0,31}.
// A semicolon in what looks like a varname is not a valid variable;
// confirm variable will reject it, guaranteeing no shell execution.
qui sysuse auto, clear

// Runs one command with its output logged to the caller's <logfile> and
// returns its code in r(rc).  P2-79, P2-82, P2-83 and P2-84 asserted only
// rc != 0, which a crash passes as readily as a refusal -- a Mata error
// (3xxx) or a Python traceback is not "graceful".  Each now asserts the
// code the refusal gives and the words it says, read back from the log
// with cert_log_has, which re-joins the lines Stata wraps.
capture program drop _adv_log_run
program define _adv_log_run, rclass
    version 16.0
    args logfile cmdtext
    tempname lh
    quietly log using "`logfile'", text replace name(`lh')
    capture noisily `cmdtext'
    local rc = _rc
    quietly log close `lh'
    return scalar rc = `rc'
end

// "mpg;" is not a valid Stata variable — confirm variable will reject it
// (measured 24sep2026: syntax's own "; invalid name", r(198)).
tempfile p279log
_adv_log_run "`p279log'" `"dash scatter mpg; weight, saving(`"_tmp_p279.html"')"'
local p279_rc = r(rc)
// Clean up any accidental output
capture erase "_tmp_p279.html"
assert `p279_rc' == 198
cert_log_has "`p279log'", needle("; invalid name")
assert r(count) == 1
display "P2-79 PASS: injection chars in varname rejected (rc=`p279_rc')"

// ================================================================
// P2-80 — Path traversal in saving() → rc == 198
// ================================================================
qui sysuse auto, clear
capture dash scatter mpg weight, saving("../../../tmp/evil.html")
assert _rc == 198
display "P2-80 PASS: path traversal in saving() returns rc=198"

// ================================================================
// P2-81 — Python injection in option value → treated as literal
// ================================================================
// An option value like mc("red); import os; os.system('id')") should
// be HTML-escaped and treated as a literal string, not executed.
qui sysuse auto, clear
local inject_val `"red); import os; os.system('id')"'
tempfile inject_out
local inject_path = "`inject_out'.html"
capture erase "`inject_path'"
// Use as a mcolor value — the renderer receives it, html-escapes it
capture dash scatter mpg weight, ///
    mc(`"`inject_val'"') saving("`inject_path'") replace
local p281_rc = _rc
// Either the command succeeds (injection treated as bad color → default)
// or it errors gracefully — either way, no OS execution should occur.
// The key check: if the file was produced, it must not contain the literal call
if `p281_rc' == 0 {
    // This was a line-by-line scan testing
    // `strpos(`"`line'"', "os.system")'.  Expanding a line of the rendered
    // dashboard into a compound-quoted macro cannot survive the
    // double-quote characters the embedded Bokeh document is made of, so
    // the scan died instead of reaching a verdict and this branch asserted
    // nothing.
    //
    // What is asserted: the literal "os.system" must appear nowhere in the
    // rendered dashboard.  The payload was handed to dash as a colour
    // value, so a value that was rejected or escaped leaves no executable
    // trace of the call; a hit would mean the option value was carried
    // through into the generated document as code.  The search is
    // case-sensitive, as the loop's was -- it is a Python attribute name
    // and its case is fixed.
    cert_file_has "`inject_path'", needle("os.system")
    local found_exec = r(found)
    assert `found_exec' == 0
}
capture erase "`inject_path'"

// An execution marker, checked whatever the return code.  The check above
// runs only when the build succeeded and reads only the page, so a payload
// that ran at build time and left nothing in the page -- or that made the
// build fail -- was never seen.  This payload creates a file if Python ever
// evaluates or executes the option value; the file must not exist
// afterwards, rc 0 or not.  The control: the same text handed to exec()
// here does create it, so the marker is one Python can set.  (P20-22 uses a
// global the same way.)
tempfile p281m
local p281mk "`p281m'.marker"
capture erase "`p281mk'"
local inject_mk `"__import__('pathlib').Path('`p281mk'').touch()"'
capture dash scatter mpg weight, mc(`"`inject_mk'"') saving("`inject_path'")
local p281b_rc = _rc
capture erase "`inject_path'"
capture confirm file "`p281mk'"
assert _rc != 0
python: exec(__import__("sfi").Macro.getLocal("inject_mk"))
confirm file "`p281mk'"
erase "`p281mk'"
display "P2-81 PASS: Python injection in option value treated as literal (rc=`p281_rc', marker payload rc=`p281b_rc')"

// ================================================================
// P2-82 — Resource exhaustion: large varlist → graceful error
// ================================================================
qui sysuse auto, clear
// Construct a varlist of 100 non-existent variables
local biglist ""
forvalues i = 1/100 {
    local biglist "`biglist' novar`i'"
}
// The Mata parser (confirm variable) should reject non-existent vars
// and return a non-zero rc without crashing or hanging -- measured
// 24sep2026, at the first of them: "variable novar1 not found", r(111).
tempfile p282log
_adv_log_run "`p282log'" `"dash scatter `biglist', saving("_tmp_p282.html")"'
local p282_rc = r(rc)
capture erase "_tmp_p282.html"
assert `p282_rc' == 111
cert_log_has "`p282log'", needle("variable novar1 not found")
assert r(count) == 1
display "P2-82 PASS: resource exhaustion (100 bogus vars) → graceful error (rc=`p282_rc')"

// ================================================================
// P2-83 — Stack overflow: 100 levels of nested parens → graceful error
// ================================================================
qui sysuse auto, clear
// Build 50 opening and 50 closing parentheses around a valid spec
local oparens ""
local cparens ""
forvalues i = 1/50 {
    local oparens "`oparens'("
    local cparens "`cparens')"
}
// dash reads one level of parentheses as a plot group; what is left is
// refused by name (measured 24sep2026): the plot type it cannot recognise
// is the 49 remaining "(" and scatter, r(198).
tempfile p283log
_adv_log_run "`p283log'" `"dash `oparens'scatter mpg weight`cparens', saving("_tmp_p283.html")"'
local p283_rc = r(rc)
capture erase "_tmp_p283.html"
assert `p283_rc' == 198
local p283msg = "dash: unrecognised plot type '" + substr("`oparens'", 2, .) + "scatter'."
cert_log_has "`p283log'", needle("`p283msg'")
assert r(count) == 1
display "P2-83 PASS: 50-level nested parens → graceful error (rc=`p283_rc')"

// ================================================================
// P2-84 — JS injection in filter varname → invalid varname rejected
// ================================================================
// filter() takes a Stata varname. Stata variable names can only contain
// letters, digits, and underscores. Any attempt to embed JS code via the
// varname would require characters not allowed in Stata variable names,
// so confirm variable (called inside _dash_build) will reject it.
qui sysuse auto, clear
dash scatter mpg weight, name(s1)
// "<script>" is not a valid Stata variable name — expect failure
// (measured 24sep2026, r(198)).  The refusal names the filter with every
// character that is not part of a name shown as ?, so the echo is text.
tempfile p284log
_adv_log_run "`p284log'" `"dash build, saving("_tmp_p284.html") filter(<script>alert, type(dropdown)) replace"'
local p284_rc = r(rc)
capture erase "_tmp_p284.html"
assert `p284_rc' == 198
cert_log_has "`p284log'", needle("dash build: filter() names '?script?alert', which is not a valid Stata variable name.")
assert r(count) == 1
display "P2-84 PASS: JS injection in filter varname rejected (rc=`p284_rc')"
dash clear

// ================================================================
// P4-84 — Port value with semicolon → rejected by integer regex
// ================================================================
qui sysuse auto, clear
dash scatter mpg weight, name(s1)
// Port "1234;" contains a non-digit character; regex ^[0-9]+$ rejects it
capture dash serve, port(1234;)
assert _rc == 198
display "P4-84 PASS: port value with semicolon rejected by integer regex (rc=198)"
dash clear

// ================================================================
// P4-85 — XSS in KPI title (server mode) → <script> HTML-escaped in .py
// ================================================================
qui sysuse auto, clear
dash scatter mpg weight, name(s1)
dash kpi mean(mpg), title(`"<script>alert(1)</script>"') name(k1) fmt(%9.1f)

tempfile xss_py
local xss_py_path = "`xss_py'.py"
capture erase "`xss_py_path'"
dash build, saving("`xss_py_path'") server replace

// Scan the generated .py for the raw payload — it must NOT be present.
//
// This was a line-by-line scan testing
// `strpos(`"`line'"', "<script>alert(1)")'.  The generated app is made of
// quoted base64 constants and quoted JS, so its lines are dense with "
// characters and the expansion died the same way P2-78's did, without ever
// asserting anything.
//
// WHAT IS ASSERTED, and what it does and does not cover.  The needle is the
// raw payload as a browser would execute it.  This is the FIRST of dash's
// two layers: the KPI title is carried into the app only inside the
// base64-encoded spec constant, so the raw text must not appear as a
// literal anywhere in the generated Python source -- if it did, the payload
// would be injecting into the source file itself.  Because the title
// travels base64-encoded, its absence in raw form is what a correct build
// looks like, and no escaped form of it appears in this file either.  The
// second layer, make_document calling html.escape on the decoded title
// before it reaches a Div, is asserted positively by the Python suite
// (test_server.py, test_xss_title_escaped), which can import the generated
// module and inspect the document it builds.  The search is CASE-SENSITIVE:
// the question is whether the exact bytes injected came back out.
cert_file_has "`xss_py_path'", needle("<script>alert(1)")
local found_raw_script = r(found)
assert `found_raw_script' == 0
display "P4-85 PASS: XSS in KPI title → <script> not present unescaped in .py"
dash clear

// ================================================================
// P4-86 — Data value with injection chars → generated .py still compiles
// ================================================================
// Variable labels are serialized by jsonio and then base64-encoded in
// the generated server app. Injection characters in a label must not
// break Python file syntax.
qui sysuse auto, clear
// Set a variable label containing Python injection characters
label variable mpg `"Mileage'); exec('id'); x='"'
dash scatter mpg weight, name(s1)

tempfile inj_py
local inj_py_path = "`inj_py'.py"
capture erase "`inj_py_path'"
dash build, saving("`inj_py_path'") server replace

// A `python: ... end' block cannot be nested inside `capture { }'.  The
// python block swallows the brace block's own closing `}' and then every
// line after it up to the next `end', hands the lot to Python as source,
// and -capture- hides the SyntaxError.  Measured in test_e2e_serve, where
// the same construct ate an assert, a PASS message and the whole setup of
// the following test; here it is the last `end' in the file, so it would
// have eaten this assert, its PASS message, the three P2-85 path checks and
// the final summary, and the script would have run off the end reporting
// success.  This is the same interaction as Bug 15, where python:...end
// closed a `program define' early (see test_ado_loads.cscript).
//
// The block therefore runs at the top level, the form the passing
// test_abbreviations.cscript uses, and reports its own failure through a
// global rather than through braces and -capture-.
local p486_rc = 0
global ZADV_PARSE_RC "0"
python:
import ast
import sfi

try:
    with open(r"`inj_py_path'", "r", encoding="utf-8") as _f:
        _src = _f.read()
    ast.parse(_src)
except Exception:
    sfi.Macro.setGlobal("ZADV_PARSE_RC", "1")
end
local p486_rc = $ZADV_PARSE_RC
macro drop ZADV_PARSE_RC

assert `p486_rc' == 0
display "P4-86 PASS: data/label with injection chars → .py still compiles"
dash clear

// ================================================================
// P2-85 — Backtick in saving() path → rc=198, not "too few quotes" crash
//         Regression: _dash_validate_path iterated _shell_bad char-by-char;
//         when _bc == char(96) (backtick), compound-quote expansion of
//         `"`_bc'"' produced `"`"' causing r(132) instead of a clean r(198).
// ================================================================
qui sysuse auto, clear
// dash.ado is already loaded by the setup block above; running it again
// redefines `dash' and exits 110.  This line was unreachable until the
// script stopped aborting earlier, which is why it never showed up.
// Build a path that contains a backtick (char 96)
local bad_path = "evil" + char(96) + "cmd.html"
capture _dash_validate_path "`bad_path'"
assert _rc == 198
display "P2-85 PASS: backtick in saving() path → rc=198 (not too-few-quotes crash)"

// Also verify the dollar sign is rejected.
//
// It cannot be delivered through a macro: "`bad_dollar'" expands $HOME as a
// global-macro reference before the program ever sees it, so the path that
// arrived was "evilHOME.html" -- a perfectly valid path, and the assertion
// was testing something it had never sent.  Measured: rc 0, not 198.
// The check is made where the character actually reaches, in the Mata
// character scan _dash_validate_path now runs first.
mata: st_local("_bad36", strofreal(_dash_path_badchar("evil" + char(36) + "HOME.html")))
assert `_bad36' == 36
display "P2-85b PASS: dollar sign in saving() path is rejected by the scan"

local bad_pipe = "evil|cmd.html"
capture _dash_validate_path "`bad_pipe'"
assert _rc == 198
display "P2-85c PASS: pipe in saving() path → rc=198"

// ================================================================
// P8-86..89 — malformed UTF-8 and control bytes through every text input
// ================================================================
// The UTF-8 gate ran at exactly one entry point, so KPI titles, build
// titles and subtitles, tabs() and filter labels had none at all.  These
// drive each of them with a UTF-16 surrogate -- ED A0 80, which the old
// validator accepted and which then ended the render with r(7102).

mata:
string scalar _adv_bytes(string scalar spec)
{
    string scalar    s
    string rowvector parts
    real scalar      i
    parts = tokens(subinstr(spec, ",", " ", .))
    s = ""
    for (i = 1; i <= length(parts); i++) s = s + char(strtoreal(parts[i]))
    return(s)
}
end
mata: st_local("_adv_surr", _adv_bytes("237,160,128"))

qui sysuse auto, clear
global dash_nobrowser 1

// A surrogate in a build title must be refused by dash, not by Python.
capture dash clear
dash scatter mpg weight, name(adv8a)
tempfile advout
capture dash build, saving("`advout'.html") replace nobrowser ///
    title(`"bad`_adv_surr'title"')
assert _rc == 198
display "P8-86 PASS: malformed UTF-8 in build title() → rc=198, not r(7102)"

// And in a KPI title.
capture dash clear
capture dash kpi mean(mpg), name(advk) title(`"bad`_adv_surr'kpi"')
assert _rc == 198
display "P8-87 PASS: malformed UTF-8 in KPI title() → rc=198"

// And in tabs().
capture dash clear
dash scatter mpg weight, name(adv8b)
tempfile advout2
capture dash build, saving("`advout2'.html") replace nobrowser ///
    tabs(`"bad`_adv_surr'tab"')
assert _rc == 198
display "P8-88 PASS: malformed UTF-8 in tabs() → rc=198"

// A CONTROL byte, by contrast, is well-formed UTF-8 and must BUILD -- the
// escaper carries it into the document as \u00XX.  Rejecting it would
// refuse a title with a stray control character pasted from a web page.
capture dash clear
dash scatter mpg weight, name(adv8c)
tempfile advout3
local _adv_c1 = "bad" + char(1) + "title"
capture noisily dash build, saving("`advout3'.html") replace nobrowser ///
    title(`"`_adv_c1'"')
assert _rc == 0
display "P8-89 PASS: a control byte in title() builds, escaped, not r(7102)"

// ================================================================
// P9-01..P9-14 — option VALUES as an attack surface (WP-15)
// ================================================================
// Before WP-15 a number-only option carried whatever text it was given
// into the spec JSON and on to the renderer, where float() raised or --
// for the KPI fmt() -- Stata's own `: display' ran the text as a display
// directive.  The option-validation table in dash.ado now refuses such a
// value with ONE `display as error' line naming the option, exit 198,
// before anything is registered.  Each probe below is read back from a
// captured log so the refusal can be checked to name its option and to be
// a refusal, not the "ignoring unsupported option(s)" note.
//
// Style kinds (msize, lwidth ...) are deliberately NOT a surface here:
// twoway passes an unknown style NAME through with a note, and so does
// dash, so the injection strings go into the number-only options.
capture program drop _adv_p9_probe
program define _adv_p9_probe, rclass
    version 16.0
    args cmdtext opt
    local logfile "`c(tmpdir)'dash_adv_p9.log"
    set linesize 80
    capture log close _p9log
    capture erase "`logfile'"
    capture dash clear
    log using "`logfile'", name(_p9log) text replace
    capture noisily `cmdtext'
    local rc = _rc
    log close _p9log
    cert_file_has "`logfile'", needle("`opt'()")
    local named = r(found)
    cert_file_has "`logfile'", needle("unsupported option")
    local ignored = r(found)
    return scalar rc      = `rc'
    return scalar named   = `named'
    return scalar ignored = `ignored'
end

qui sysuse auto, clear
global dash_nobrowser 1

// P9-01 — code after a number in jitter() → rc 198 naming jitter()
_adv_p9_probe `"dash scatter mpg weight, jitter(5; import os) name(p901)"' jitter
assert r(rc) == 198
assert r(named) == 1 & r(ignored) == 0
assert "${dash_graph_registry}" == ""
display "P9-01 PASS: jitter(5; import os) → rc=198 naming jitter(), nothing registered"

// P9-02 — code after a number in level() → rc 198 naming level()
_adv_p9_probe `"dash lfitci mpg weight, level(95; sysuse auto) name(p902)"' level
assert r(rc) == 198
assert r(named) == 1 & r(ignored) == 0
assert "${dash_graph_registry}" == ""
display "P9-02 PASS: level(95; sysuse auto) → rc=198 naming level(), nothing registered"

// P9-03 — a word after a number in bin() → rc 198 naming bin()
_adv_p9_probe `"dash histogram mpg, bin(5 or 1) name(p903)"' bin
assert r(rc) == 198
assert r(named) == 1 & r(ignored) == 0
assert "${dash_graph_registry}" == ""
display "P9-03 PASS: bin(5 or 1) → rc=198 naming bin(), nothing registered"

// P9-04 — a backtick in n().  Built with char(96) and handed to Stata
// through _stata(), so no macro expands it on the way.  Measured: Stata's
// own line parser refuses an unbalanced backtick with r(132) "too few
// quotes" before any program runs, whichever route delivers it (a macro,
// a literal line, stata(), _stata()), so the validator's macval() echo of
// the value cannot be reached from a command line.  What is asserted is
// what can be: the command fails and registers nothing.
local _p9_cmd = "dash kdensity mpg, n(" + char(96) + "x" + char(96) + ") name(p904)"
capture dash clear
mata: st_local("_p9_rc", strofreal(_stata(st_local("_p9_cmd"), 0)))
assert `_p9_rc' != 0
assert "${dash_graph_registry}" == ""
display "P9-04 PASS: a backtick in n() → rc=`_p9_rc' at Stata's own parser, nothing registered"

// P9-05 — a $ payload is not deliverable: "`x'" and _stata() alike expand
// $name as a global-macro reference before dash sees the text (measured in
// P2-85b for saving()), and a value with no $ left in it is not the test.
// Skipped, and said so.
display "P9-05 NOTE: a $ payload in an option value cannot reach dash from a command line; not probed"

// P9-06..P9-10 — resource exhaustion through a count or a size → rc 198
_adv_p9_probe `"dash histogram mpg, bin(999999999) name(p906)"' bin
assert r(rc) == 198
assert r(named) == 1 & r(ignored) == 0
assert "${dash_graph_registry}" == ""
display "P9-06 PASS: bin(999999999) → rc=198 naming bin()"

_adv_p9_probe `"dash kdensity mpg, n(1000000000) name(p907)"' n
assert r(rc) == 198
assert r(named) == 1 & r(ignored) == 0
assert "${dash_graph_registry}" == ""
display "P9-07 PASS: n(1000000000) → rc=198 naming n()"

_adv_p9_probe `"dash mband mpg weight, bands(1e9) name(p908)"' bands
assert r(rc) == 198
assert r(named) == 1 & r(ignored) == 0
assert "${dash_graph_registry}" == ""
display "P9-08 PASS: bands(1e9) → rc=198 naming bands()"

_adv_p9_probe `"dash scatter mpg weight, colorvar(price) colornlevels(1e9) name(p909)"' colornlevels
assert r(rc) == 198
assert r(named) == 1 & r(ignored) == 0
assert "${dash_graph_registry}" == ""
display "P9-09 PASS: colornlevels(1e9) → rc=198 naming colornlevels()"

_adv_p9_probe `"dash scatter mpg weight, xsize(1e9) name(p910)"' xsize
assert r(rc) == 198
assert r(named) == 1 & r(ignored) == 0
assert "${dash_graph_registry}" == ""
display "P9-10 PASS: xsize(1e9) → rc=198 naming xsize()"

// P9-11..P9-14 — code in the KPI fmt().  Before the gate, `: display'
// ran the text: _request(x) asked for input, c(username) printed it, a
// quoted word became display output.  Now: rc 198 naming fmt(), and no
// KPI registered under the name.
_adv_p9_probe `"dash kpi mean(mpg), name(p9k) title(T) fmt(%9.2f _request(x))"' fmt
assert r(rc) == 198
assert r(named) == 1 & r(ignored) == 0
assert "${dash_kpi_p9k}" == "" & "${dash_graph_registry}" == ""
display "P9-11 PASS: fmt(%9.2f _request(x)) → rc=198 naming fmt(), no KPI registered"

_adv_p9_probe `"dash kpi mean(mpg), name(p9k) title(T) fmt(c(username))"' fmt
assert r(rc) == 198
assert r(named) == 1 & r(ignored) == 0
assert "${dash_kpi_p9k}" == "" & "${dash_graph_registry}" == ""
display "P9-12 PASS: fmt(c(username)) → rc=198 naming fmt(), no KPI registered"

_adv_p9_probe `"dash kpi mean(mpg), name(p9k) title(T) fmt("HACKED" %9.2f)"' fmt
assert r(rc) == 198
assert r(named) == 1 & r(ignored) == 0
assert "${dash_kpi_p9k}" == "" & "${dash_graph_registry}" == ""
display `"P9-13 PASS: fmt("HACKED" %9.2f) → rc=198 naming fmt(), no KPI registered"'

_adv_p9_probe `"dash kpi mean(mpg), name(p9k) title(T) fmt(%9.2f;)"' fmt
assert r(rc) == 198
assert r(named) == 1 & r(ignored) == 0
assert "${dash_kpi_p9k}" == "" & "${dash_graph_registry}" == ""
display "P9-14 PASS: fmt(%9.2f;) → rc=198 naming fmt(), no KPI registered"

capture dash clear
capture erase "`c(tmpdir)'dash_adv_p9.log"

// ================================================================
// P19 — resource limits (WP-19)
// ================================================================
// ROADMAP WP-19: no input may produce unbounded output or memory use
// (BR-19.1), and every limit names the setting that would raise it
// (BR-19.2).  Measured on the development machine, a standalone dashboard
// embedding 2,000,000 values is 47.6 MB of HTML at 1.0 GB of renderer RSS,
// 4,000,000 is 94.9 MB at 2.1 GB, and Chrome cannot hold a string longer
// than about 512 MB -- roughly 20,000,000 values.
//
// dash.ado enforces three limits itself -- items in the registry, plots in
// a graph, values embedded in a dashboard -- and hands every limit the
// session has set to the renderer as build_options.limits.  Each is raised
// or lowered with global dash_max_<key>, a whole number in digits only
// from 1 to the key's ceiling.  Every case asserts the rc, the message, and
// that nothing was registered or written.
//
// Messages are read back from a log written at linesize 255: at 80 columns
// Stata wraps a refusal mid-word, and a needle split across two lines is
// not found.

mata:
// The value a refusal echoed between "(got '" and the next "'", read from
// the log in Mata, where a line is a value: nothing in it can be parsed as
// Stata code on the way.  Empty when the log holds no echo at all.
string scalar _adv_p19_echo(string scalar path)
{
    real scalar   fh, p, q
    string scalar ln, rest

    fh = _fopen(path, "r")
    if (fh < 0) return("")
    while ((ln = fget(fh)) != J(0, 0, "")) {
        p = strpos(ln, "(got '")
        if (p > 0) {
            rest = substr(ln, p + 6, .)
            q    = strpos(rest, "'")
            fclose(fh)
            return(q > 0 ? substr(rest, 1, q - 1) : rest)
        }
    }
    fclose(fh)
    return("")
}

// 1 when s is non-empty, at most 20 bytes, and made only of A-Z a-z 0-9
// _ . - and the ? that stands in for every other byte.
real scalar _adv_p19_safe(string scalar s)
{
    real scalar i, c

    if (strlen(s) == 0 | strlen(s) > 20) return(0)
    for (i = 1; i <= strlen(s); i++) {
        c = ascii(substr(s, i, 1))
        if (!((c >= 48 & c <= 57) | (c >= 65 & c <= 90) |
              (c >= 97 & c <= 122) | c == 95 | c == 46 | c == 45 |
              c == 63)) return(0)
    }
    return(1)
}

// The hostile values for a key whose ceiling is `ceiling': a word, zero, a
// negative, a decimal, e-notation, one past the ceiling, ten digits, a
// command after a semicolon, 5,000 characters of backtick, semicolon and
// brace, a backtick macro reference, a trailing newline (measured:
// StataNow's regexm() matches "^[0-9]+$" against "12" + char(10)), a
// full-width digit, and two that real() reads as a number although they
// are not digits only -- a leading plus and a leading space.
string colvector _adv_p19_bad(real scalar ceiling)
{
    string colvector v

    v = J(14, 1, "")
    v[1]  = "abc"
    v[2]  = "0"
    v[3]  = "-5"
    v[4]  = "1.5"
    v[5]  = "1e6"
    v[6]  = strofreal(ceiling + 1, "%12.0f")
    v[7]  = "9999999999"
    v[8]  = "1; shell echo hi"
    v[9]  = 1000 * (char(96) + ";{x}")
    v[10] = "5" + char(96) + "rm" + char(39)
    v[11] = "12" + char(10)
    v[12] = "1" + char(239) + char(188) + char(146)
    v[13] = "+5"
    v[14] = " 5"
    return(v)
}
end

// Run one command with its output captured to a log: r(rc), r(log).
capture program drop _adv_p19_run
program define _adv_p19_run, rclass
    version 16.0
    args cmdtext
    local logfile "`c(tmpdir)'dash_adv_p19.log"
    local ls = c(linesize)
    set linesize 255
    capture log close _p19log
    capture erase "`logfile'"
    quietly log using "`logfile'", name(_p19log) text replace
    capture noisily `cmdtext'
    local rc = _rc
    quietly log close _p19log
    set linesize `ls'
    return scalar rc  = `rc'
    return local  log "`logfile'"
end

// Every hostile value of dash_max_<key> must make <cmdtext> fail with
// r(198), naming the global and its range, echoing nothing but safe
// characters -- no semicolon and no backtick anywhere in the output --
// registering nothing and, when <file> is given, writing no file.  The
// global is dropped afterwards.
capture program drop _adv_p19_refuses
program define _adv_p19_refuses
    version 16.0
    args key ceiling cmdtext file
    local cfmt : display %12.0fc `ceiling'
    local cfmt = strtrim("`cfmt'")
    local reg0 "${dash_graph_registry}"
    mata: _adv_p19_vals = _adv_p19_bad(`ceiling')
    mata: st_local("nv", strofreal(rows(_adv_p19_vals)))
    forvalues j = 1/`nv' {
        mata: st_global("dash_max_`key'", _adv_p19_vals[`j'])
        _adv_p19_run `"`cmdtext'"'
        local rc = r(rc)
        local lg "`r(log)'"
        if `rc' != 198 {
            display as error `"P19 FAIL: hostile value `j' of dash_max_`key' gave rc=`rc', not 198: `cmdtext'"'
            exit 9
        }
        cert_file_has "`lg'", needle("global dash_max_`key' must be a whole number from 1 to `cfmt'")
        assert r(found) == 1
        mata: st_local("eok", strofreal(_adv_p19_safe(_adv_p19_echo(st_local("lg")))))
        assert `eok' == 1
        cert_file_has "`lg'", needle(";")
        assert r(found) == 0
        mata: st_local("bt", strofreal(_cert_file_has(st_local("lg"), char(96), 0)))
        assert `bt' == 0
        assert "${dash_graph_registry}" == "`reg0'"
        if `"`file'"' != "" {
            capture confirm file `"`file'"'
            assert _rc != 0
        }
    }
    macro drop dash_max_`key'
end

qui sysuse auto, clear
global dash_nobrowser 1
capture dash clear
local p19_keys "cells bytes graphs plots filter_options by_groups tabs filters"
local p19_defs "5000000 50000000 100 100 1000 100 50 20"
local p19_ceil "20000000 500000000 1000 1000 100000 1000 500 200"
foreach k of local p19_keys {
    capture macro drop dash_max_`k'
}

// P19-01 — a fourth graph, and a fourth KPI, at dash_max_graphs 3 → r(134)
global dash_max_graphs 3
dash scatter mpg weight, name(g1)
dash scatter price weight, name(g2)
dash kpi mean(mpg), name(k1) title("Mean mpg")
assert "${dash_graph_registry}" == "g1 g2 k1"
_adv_p19_run "dash scatter mpg weight, name(g4)"
assert r(rc) == 134
local lg "`r(log)'"
cert_file_has "`lg'", needle("dash: the registry already holds 3 graphs and KPI cards, the most one dashboard draws.")
assert r(found) == 1
cert_file_has "`lg'", needle("Run dash clear, reuse a name with name(<name>, replace), or set global dash_max_graphs to a higher value (at most 1,000).")
assert r(found) == 1
assert "${dash_graph_registry}" == "g1 g2 k1"
local left : all globals "dash_*_g4"
assert "`left'" == ""
_adv_p19_run `"dash kpi mean(price), name(k4) title("Mean price")"'
assert r(rc) == 134
local lg "`r(log)'"
cert_file_has "`lg'", needle("dash: the registry already holds 3 graphs and KPI cards, the most one dashboard draws.")
assert r(found) == 1
cert_file_has "`lg'", needle("set global dash_max_graphs to a higher value (at most 1,000).")
assert r(found) == 1
assert "${dash_graph_registry}" == "g1 g2 k1"
local left : all globals "dash_kpi_k4*"
assert "`left'" == ""
display "P19-01 PASS: a 4th graph and a 4th KPI at dash_max_graphs 3 → rc=134 naming 3 and dash_max_graphs, nothing registered"

// P19-02 — a name already in the registry is a replace, and never counts
capture noisily dash scatter mpg turn, name(g1, replace)
assert _rc == 0
assert strpos("${dash_spec_g1}", "turn") > 0
capture noisily dash kpi mean(price), name(k1, replace) title("Mean price")
assert _rc == 0
assert "${dash_kpi_k1__var}" == "price"
assert "${dash_graph_registry}" == "g1 g2 k1"
display "P19-02 PASS: name(g1, replace) and a KPI replace succeed at the cap"

// P19-03 — after dash clear a new name registers again
dash clear
capture noisily dash scatter mpg weight, name(g4)
assert _rc == 0
assert "${dash_graph_registry}" == "g4"
display "P19-03 PASS: after dash clear, registering works again"

// P19-04 — a registry already past a lowered limit says so
dash clear
macro drop dash_max_graphs
dash scatter mpg weight, name(h1)
dash scatter mpg weight, name(h2)
dash scatter mpg weight, name(h3)
global dash_max_graphs 2
_adv_p19_run "dash scatter mpg weight, name(h4)"
assert r(rc) == 134
cert_file_has "`r(log)'", needle("dash: the registry already holds 3 graphs and KPI cards, more than the 2 one dashboard draws.")
assert r(found) == 1
assert "${dash_graph_registry}" == "h1 h2 h3"
macro drop dash_max_graphs
dash clear
display "P19-04 PASS: 3 registered at dash_max_graphs 2 → rc=134 saying more than 2"

// P19-05 — unset, each limit is its default: graphs 100
_dash_limit, name(graphs)
assert r(value) == 100 & r(default) == 100 & r(ceiling) == 1000
assert "`r(global)'" == "dash_max_graphs"
forvalues i = 1/8 {
    local k : word `i' of `p19_keys'
    _dash_limit, name(`k')
    assert r(value)   == `: word `i' of `p19_defs''
    assert r(default) == `: word `i' of `p19_defs''
    assert r(ceiling) == `: word `i' of `p19_ceil''
    assert "`r(global)'" == "dash_max_`k'"
}
display "P19-05 PASS: unset, _dash_limit gives graphs 100 and every default, ceiling and global"

// P19-06 — two y variables at dash_max_plots 2 register
global dash_max_plots 2
capture noisily dash scatter mpg price weight, name(p1)
assert _rc == 0
assert "${dash_graph_registry}" == "p1"
display "P19-06 PASS: scatter mpg price weight (2 plots) registers at dash_max_plots 2"

// P19-07 — three y variables → r(134), p2 not registered
_adv_p19_run "dash scatter mpg price turn weight, name(p2)"
assert r(rc) == 134
local lg "`r(log)'"
cert_file_has "`lg'", needle("dash: this graph has 3 plots (each y variable is one), more than the 2 one graph draws.")
assert r(found) == 1
cert_file_has "`lg'", needle("Split it into several graphs, or set global dash_max_plots to a higher value (at most 1,000).")
assert r(found) == 1
assert "${dash_graph_registry}" == "p1"
local left : all globals "dash_*_p2"
assert "`left'" == ""
display "P19-07 PASS: scatter mpg price turn weight (3 plots) → rc=134, p2 not registered"

// P19-08 — three segments of one plot each → r(134)
_adv_p19_run "dash (scatter mpg weight) (line price weight) (lfit mpg weight), name(p3)"
assert r(rc) == 134
local lg "`r(log)'"
cert_file_has "`lg'", needle("dash: this graph has 3 plots (each y variable is one), more than the 2 one graph draws.")
assert r(found) == 1
cert_file_has "`lg'", needle("set global dash_max_plots to a higher value (at most 1,000).")
assert r(found) == 1
assert "${dash_graph_registry}" == "p1"
local left : all globals "dash_*_p3"
assert "`left'" == ""
display "P19-08 PASS: three one-plot segments → rc=134, p3 not registered"

// P19-09 — refused before the last segment, the total is not known yet
_adv_p19_run "dash (scatter mpg weight) (line price weight) (lfit mpg weight) (qfit mpg weight), name(p4)"
assert r(rc) == 134
cert_file_has "`r(log)'", needle("dash: this graph has more than 2 plots (each y variable is one), the most one graph draws.")
assert r(found) == 1
_adv_p19_run "dash (scatter mpg price turn weight) (line mpg weight), name(p5)"
assert r(rc) == 134
cert_file_has "`r(log)'", needle("dash: this graph has more than 2 plots (each y variable is one), the most one graph draws.")
assert r(found) == 1
assert "${dash_graph_registry}" == "p1"
display "P19-09 PASS: a refusal before the last segment says more than 2 plots"

// P19-10 — the immediate route is capped too, and writes nothing
tempfile p19p
local p19pf "`p19p'.html"
capture erase "`p19pf'"
_adv_p19_run `"dash scatter mpg price turn weight, saving("`p19pf'")"'
assert r(rc) == 134
cert_file_has "`r(log)'", needle("dash: this graph has 3 plots (each y variable is one)")
assert r(found) == 1
capture confirm file "`p19pf'"
assert _rc != 0
macro drop dash_max_plots
dash clear
display "P19-10 PASS: the immediate route refuses 3 plots at dash_max_plots 2 and writes no file"

// P19-11 — 148 values at dash_max_cells 100 → r(134) before any export
qui sysuse auto, clear
generate double d = mdy(1, 1, 2000) + _n
format d %td
quietly datasignature
local sig0 "`r(datasignature)'"
global dash_max_cells 100
tempfile p19c
local p19cf "`p19c'.html"
capture erase "`p19cf'"
_adv_p19_run `"dash scatter mpg d, saving("`p19cf'")"'
assert r(rc) == 134
local lg "`r(log)'"
cert_file_has "`lg'", needle("dash: this dashboard would embed 148 values (74 observations x 2 variables), more than the 100 dash embeds.")
assert r(found) == 1
cert_file_has "`lg'", needle("Reduce the data in memory first (keep, drop, sample or collapse, inside preserve/restore), or set global dash_max_cells to a higher value (at most 20,000,000).")
assert r(found) == 1
// if/in reduce nothing that is exported, so they are not offered.
cert_file_has "`lg'", needle("if/in")
assert r(found) == 0
// Nothing writes "if/in" here -- dash.ado names it only in the comment
// above _dash_cell_cap, and the refusal came in without it, beside this
// check (72d94e5) -- and a remedy in other words, "an if qualifier", would
// pass the search.  So the refusal is held to its
// whole output: the log holds these two lines and nothing else (measured
// 24sep2026, 2 lines at linesize 255), so no third remedy can be added in
// any wording without failing here.
mata: st_local("p1911n", strofreal(rows(cat(st_local("lg")))))
assert `p1911n' == 2
capture confirm file "`p19cf'"
assert _rc != 0
quietly datasignature
assert "`r(datasignature)'" == "`sig0'"
local fmt_d : format d
assert "`fmt_d'" == "%td"
display "P19-11 PASS: 148 values at dash_max_cells 100 → rc=134, no file, data and %td format unchanged"

// P19-12 — dash_max_cells 148 accepts the same command
global dash_max_cells 148
capture noisily dash scatter mpg d, saving("`p19cf'")
assert _rc == 0
confirm file "`p19cf'"
local fmt_d : format d
assert "`fmt_d'" == "%td"
display "P19-12 PASS: the same command at dash_max_cells 148 writes the dashboard"

// P19-13 — dash build is capped the same way
dash clear
global dash_max_cells 100
dash scatter mpg weight, name(c1)
tempfile p19b
local p19bf "`p19b'.html"
capture erase "`p19bf'"
_adv_p19_run `"dash build, saving("`p19bf'") replace nobrowser"'
assert r(rc) == 134
local lg "`r(log)'"
cert_file_has "`lg'", needle("dash: this dashboard would embed 148 values (74 observations x 2 variables), more than the 100 dash embeds.")
assert r(found) == 1
cert_file_has "`lg'", needle("set global dash_max_cells to a higher value (at most 20,000,000).")
assert r(found) == 1
capture confirm file "`p19bf'"
assert _rc != 0
local opts : all globals "dash_opts_*"
assert "`opts'" == ""
quietly datasignature
assert "`r(datasignature)'" == "`sig0'"
global dash_max_cells 148
capture noisily dash build, saving("`p19bf'") replace nobrowser
assert _rc == 0
confirm file "`p19bf'"
macro drop dash_max_cells
dash clear
display "P19-13 PASS: dash build refuses 148 values at 100 (no file, no dash_opts_*), builds at 148"

// P19-14 — _dash_limits_json carries only the limits that are set
foreach k of local p19_keys {
    capture macro drop dash_max_`k'
}
_dash_limits_json
assert `"`r(json)'"' == "{}"
global dash_max_by_groups 7
_dash_limits_json
assert `"`r(json)'"' == `"{"by_groups":7}"'
global dash_max_cells 00148
global dash_max_tabs 3
_dash_limits_json
assert `"`r(json)'"' == `"{"cells":148,"by_groups":7,"tabs":3}"'
display `"P19-14 PASS: _dash_limits_json gives {} unset, {"by_groups":7}, and set keys in table order"'

// P19-15 — the master specs carry it as build_options.limits
dash clear
dash scatter mpg weight, name(j1)
tempfile p19js p19jd
_dash_serve_spec, specpath("`p19js'") datapath("`p19jd'")
cert_file_has "`p19js'", needle(`","limits":{"cells":148,"by_groups":7,"tabs":3}}}"')
assert r(found) == 1
// The immediate route leaves no spec file to read; that the renderer
// parsed a spec carrying limits is what rc 0 shows, on both routes.
tempfile p19j
local p19jf "`p19j'.html"
capture noisily dash scatter mpg weight, saving("`p19jf'")
assert _rc == 0
confirm file "`p19jf'"
capture noisily dash build, saving("`p19jf'") replace nobrowser
assert _rc == 0
display "P19-15 PASS: build_options.limits is in the build/serve spec, and both routes render with it"

// P19-16 — dash clear keeps the limits: they are settings, not registry
dash scatter mpg weight, name(z1)
dash clear
assert "${dash_max_cells}" == "00148"
assert "${dash_max_by_groups}" == "7"
assert "${dash_graph_registry}" == ""
display "P19-16 PASS: dash clear leaves global dash_max_cells set"

// P19-17 — accepted values: 1, the ceiling, leading zeros, empty = default,
// and the same answers under a caller's version 16 (the old regex engine)
foreach k of local p19_keys {
    capture macro drop dash_max_`k'
}
global dash_max_graphs 1
_dash_limit, name(graphs)
assert r(value) == 1
global dash_max_graphs 1000
_dash_limit, name(graphs)
assert r(value) == 1000
global dash_max_cells 20000000
_dash_limit, name(cells)
assert r(value) == 20000000
global dash_max_cells 000000148
_dash_limit, name(cells)
assert r(value) == 148
global dash_max_graphs ""
_dash_limit, name(graphs)
assert r(value) == 100
version 16: _dash_limit, name(cells)
assert r(value) == 148
mata: st_global("dash_max_cells", "12" + char(10))
capture version 16: _dash_limit, name(cells)
assert _rc == 198
capture _dash_limit, name(cells)
assert _rc == 198
foreach k of local p19_keys {
    capture macro drop dash_max_`k'
}
display "P19-17 PASS: 1, the ceiling and leading zeros accepted, empty is the default, same under version 16"

// P19-18 — every hostile value, for every key, straight to _dash_limit
forvalues i = 1/8 {
    local k : word `i' of `p19_keys'
    _adv_p19_refuses `k' `: word `i' of `p19_ceil'' "_dash_limit, name(`k')" ""
    _dash_limit, name(`k')
    assert r(value) == `: word `i' of `p19_defs''
}
display "P19-18 PASS: 14 hostile values x 8 globals → rc=198 naming the global, echo safe; dropped → default"

// P19-19 — the immediate route refuses each of them and writes nothing
qui sysuse auto, clear
tempfile p19r
local p19rf "`p19r'.html"
capture erase "`p19rf'"
forvalues i = 1/8 {
    local k : word `i' of `p19_keys'
    _adv_p19_refuses `k' `: word `i' of `p19_ceil'' `"dash scatter mpg weight, saving("`p19rf'")"' "`p19rf'"
}
capture noisily dash scatter mpg weight, saving("`p19rf'")
assert _rc == 0
confirm file "`p19rf'"
display "P19-19 PASS: the immediate route refuses every hostile value of every global; dropped, it renders"

// P19-20 — and so does dash build
capture erase "`p19rf'"
dash clear
dash scatter mpg weight, name(b1)
forvalues i = 1/8 {
    local k : word `i' of `p19_keys'
    _adv_p19_refuses `k' `: word `i' of `p19_ceil'' `"dash build, saving("`p19rf'") replace nobrowser"' "`p19rf'"
}
local opts : all globals "dash_opts_*"
assert "`opts'" == ""
capture noisily dash build, saving("`p19rf'") replace nobrowser
assert _rc == 0
confirm file "`p19rf'"
dash clear
display "P19-20 PASS: dash build refuses every hostile value of every global; dropped, it builds"

// P19-21 — registration reads dash_max_graphs and dash_max_plots itself
_adv_p19_refuses graphs 1000 "dash scatter mpg weight, name(r1)" ""
_adv_p19_refuses plots  1000 "dash scatter mpg weight, name(r1)" ""
global dash_max_graphs 0
_adv_p19_run "dash scatter mpg weight, name(r1)"
assert r(rc) == 198
cert_file_has "`r(log)'", needle("global dash_max_graphs must be a whole number from 1 to 1,000")
assert r(found) == 1
_adv_p19_run "dash kpi mean(mpg), name(r2) title(T)"
assert r(rc) == 198
cert_file_has "`r(log)'", needle("global dash_max_graphs must be a whole number from 1 to 1,000")
assert r(found) == 1
assert "${dash_graph_registry}" == ""
macro drop dash_max_graphs
capture noisily dash scatter mpg weight, name(r1)
assert _rc == 0
assert "${dash_graph_registry}" == "r1"
display "P19-21 PASS: a graph or KPI registration refuses every hostile value; global dash_max_graphs 0 too"

// P19-22 — the message helpers: a thirteen-digit count keeps its commas
// (%12.0fc would print 1.23457e+12), and one variable is "1 variable"
_dash_count_fmt p19s 1234567890123
assert "`p19s'" == "1,234,567,890,123"
_dash_count_fmt p19s 20000000
assert "`p19s'" == "20,000,000"
qui sysuse auto, clear
global dash_max_cells 50
_adv_p19_run "_dash_cell_cap 1"
assert r(rc) == 134
cert_file_has "`r(log)'", needle("dash: this dashboard would embed 74 values (74 observations x 1 variable), more than the 50 dash embeds.")
assert r(found) == 1
_adv_p19_run "_dash_cell_cap 0"
assert r(rc) == 0
macro drop dash_max_cells
display "P19-22 PASS: counts past 10^12 keep their separators; 74 x 1 is refused as 1 variable"

// P19-23 — the default, with no global set: 2,600,000 observations of two
// variables (5,200,000 values) are refused before jsonio sees them, and
// 2,500,000 x 2 -- exactly 5,000,000 -- is within it.
clear
quietly set obs 2600000
generate double y = mod(_n, 7)
generate double x = _n
tempfile p19big
local p19gf "`p19big'.html"
capture erase "`p19gf'"
_adv_p19_run `"dash scatter y x, saving("`p19gf'")"'
assert r(rc) == 134
cert_file_has "`r(log)'", needle("dash: this dashboard would embed 5,200,000 values (2,600,000 observations x 2 variables), more than the 5,000,000 dash embeds.")
assert r(found) == 1
capture confirm file "`p19gf'"
assert _rc != 0
quietly keep in 1/2500000
_adv_p19_run "_dash_cell_cap 2"
assert r(rc) == 0
quietly set obs 2500001
_adv_p19_run "_dash_cell_cap 2"
assert r(rc) == 134
qui sysuse auto, clear
display "P19-23 PASS: the default refuses 5,200,000 values and admits exactly 5,000,000"

// P19-24..26 — a refused name is echoed as text, never as SMCL.  The
// filter() echo replaced only the FIRST run of unsafe characters
// (regexr), and the graph and KPI name refusals echoed the name raw, so
// `name(a{bf:X})' printed a bold X and `{hline 43}' a rule: Stata drew the
// user's text as its own markup, and SMCL has {browse} and {stata} links a
// click would follow.  Found by WP-19's review.  In a text log a rendered
// {bf:INJMARK} is plain "INJMARK"; only an echo that neutralised the
// braces and the colon leaves "bf?INJMARK".
dash clear
dash scatter mpg weight, name(p19e)
tempfile p19ef
local p19ef "`p19ef'.html"
capture erase "`p19ef'"
_adv_p19_run `"dash build, saving("`p19ef'") replace nobrowser filter(a b{bf:INJMARKF}{hline 43}, type(dropdown))"'
assert r(rc) == 198
cert_file_has "`r(log)'", needle("bf?INJMARKF??hline?43?")
assert r(found) == 1
capture confirm file "`p19ef'"
assert _rc != 0
display "P19-24 PASS: a refused filter() name is echoed with every unsafe character neutralised"

dash clear
_adv_p19_run "dash scatter mpg weight, name(a{bf:INJMARKG}{hline 43})"
assert r(rc) == 198
cert_file_has "`r(log)'", needle("a?bf?INJMARKG??hline?43?")
assert r(found) == 1
assert "${dash_graph_registry}" == ""
display "P19-25 PASS: a refused graph name is echoed as text, not SMCL"

_adv_p19_run `"dash kpi mean(mpg), name(k{bf:INJMARKK}) title("x")"'
assert r(rc) == 198
cert_file_has "`r(log)'", needle("k?bf?INJMARKK?")
assert r(found) == 1
assert "${dash_graph_registry}" == ""
display "P19-26 PASS: a refused KPI name is echoed as text, not SMCL"

// P19-27..30 -- the bytes of text exported ($dash_max_bytes).  The cells
// limit counts values, not bytes, and a strL is exported in full since
// dash writes its own data file (24sep2026): 60 observations of a
// 1,000,000-byte strL passed the cells limit (60 values) and made a page
// of 60 MB.  make in auto is 871 bytes of text (measured: the sum of
// strlen(make)), str18, so its bound, 18 x 74 = 1,332, is over 870 and the
// values themselves are counted.
qui sysuse auto, clear
quietly datasignature
local sig0 "`r(datasignature)'"
foreach k of local p19_keys {
    capture macro drop dash_max_`k'
}
dash clear
tempfile p19t
local p19tf "`p19t'.html"
capture erase "`p19tf'"
global dash_max_bytes 870
_adv_p19_run `"dash scatter mpg weight, mlabel(make) saving("`p19tf'")"'
assert r(rc) == 134
local lg "`r(log)'"
cert_file_has "`lg'", needle("dash: this dashboard would embed 871 bytes of text (in 1 string variable), more than the 870 dash embeds.")
assert r(found) == 1
cert_file_has "`lg'", needle("Reduce the data in memory first (keep, drop, sample or collapse, inside preserve/restore), or set global dash_max_bytes to a higher value (at most 500,000,000).")
assert r(found) == 1
mata: st_local("p1927n", strofreal(rows(cat(st_local("lg")))))
assert `p1927n' == 2
capture confirm file "`p19tf'"
assert _rc != 0
quietly datasignature
assert "`r(datasignature)'" == "`sig0'"
display "P19-27 PASS: 871 bytes of text at dash_max_bytes 870 → rc=134 in the cells limit's words, no file, data unchanged"

// P19-28 -- at 871 the same command draws, and so does a dashboard with no
// string variable at dash_max_bytes 1: numbers are the cells limit's.
global dash_max_bytes 871
capture noisily dash scatter mpg weight, mlabel(make) saving("`p19tf'")
assert _rc == 0
confirm file "`p19tf'"
capture erase "`p19tf'"
global dash_max_bytes 1
capture noisily dash scatter mpg weight, saving("`p19tf'")
assert _rc == 0
confirm file "`p19tf'"
capture erase "`p19tf'"
display "P19-28 PASS: at dash_max_bytes 871 it draws; with no string variable, dash_max_bytes 1 refuses nothing"

// P19-29 -- dash build and the served spec are held to it the same way
global dash_max_bytes 870
dash scatter mpg weight, mlabel(make) name(t1)
_adv_p19_run `"dash build, saving("`p19tf'") replace nobrowser"'
assert r(rc) == 134
cert_file_has "`r(log)'", needle("dash: this dashboard would embed 871 bytes of text (in 1 string variable), more than the 870 dash embeds.")
assert r(found) == 1
capture confirm file "`p19tf'"
assert _rc != 0
local opts : all globals "dash_opts_*"
assert "`opts'" == ""
tempfile p19ts p19td
_adv_p19_run `"_dash_serve_spec, specpath("`p19ts'") datapath("`p19td'")"'
assert r(rc) == 134
capture confirm file "`p19td'"
assert _rc != 0
global dash_max_bytes 871
capture noisily dash build, saving("`p19tf'") replace nobrowser
assert _rc == 0
confirm file "`p19tf'"
capture erase "`p19tf'"
dash clear
quietly datasignature
assert "`r(datasignature)'" == "`sig0'"
display "P19-29 PASS: dash build and the served spec refuse 871 bytes at 870 (no file, no dash_opts_*), build at 871"

// P19-30 -- the default, with no global set: 60 observations of a
// 1,000,000-byte strL, 60 values, are 60,000,000 bytes and refused before
// the file is written; 50 of them, exactly 50,000,000, are within it.
foreach k of local p19_keys {
    capture macro drop dash_max_`k'
}
clear
quietly set obs 60
generate double y = _n
generate double x = _n
generate strL s = "a" * 1000000
capture erase "`p19tf'"
_adv_p19_run `"dash scatter y x, mlabel(s) saving("`p19tf'")"'
assert r(rc) == 134
cert_file_has "`r(log)'", needle("dash: this dashboard would embed 60,000,000 bytes of text (in 1 string variable), more than the 50,000,000 dash embeds.")
assert r(found) == 1
capture confirm file "`p19tf'"
assert _rc != 0
quietly keep in 1/50
_adv_p19_run "_dash_byte_cap y x s"
assert r(rc) == 0
quietly set obs 51
quietly replace s = "a" in 51
_adv_p19_run "_dash_byte_cap y x s s"
assert r(rc) == 134
cert_file_has "`r(log)'", needle("dash: this dashboard would embed 50,000,001 bytes of text (in 1 string variable)")
assert r(found) == 1
// A name that is not a variable is not counted, and not an error here.
_adv_p19_run "_dash_byte_cap nosuchvar y"
assert r(rc) == 0
qui sysuse auto, clear
display "P19-30 PASS: the default refuses 60,000,000 bytes of strL text and admits exactly 50,000,000; a variable named twice counts once"

foreach k of local p19_keys {
    capture macro drop dash_max_`k'
}
capture dash clear
capture erase "`c(tmpdir)'dash_adv_p19.log"
foreach f in p19pf p19cf p19bf p19jf p19rf p19gf p19ef p19tf {
    capture erase "``f''"
}

// ================================================================
// P20 — the rest of the input surfaces (WP-20, AC-20.3)
// ================================================================
// CLAUDE.md rule 18 asks for an auth-bypass, an injection and an exhaustion
// case per input surface.  dash has no authentication model (GAPS.md L10),
// so "bypass" means getting past the surface's OWN guard.  The registry of
// every surface and the test behind each of its three cases is
// test/test_adversarial_matrix.py, which also checks that each case id
// below is displayed here as "<id> PASS".
//
// P20-01..13.  P19-24..26 found that a refused filter, graph or KPI name
// was echoed raw, so `display' drew the user's text as SMCL -- {bf:X} bold,
// {hline} a rule, and {browse} and {stata} links a click would follow.
// Every OTHER echo of user text had the same hole (measured 23sep2026 at
// e932446): each option-value refusal (_dash_validate_value), the plot
// type, link(), exclude(), theme(), the KPI fmt(), port(), timeout(), the
// saving() refusals, and the saving() path in the success messages.  A text
// log shows a rendered {bf:INJMARK} as plain INJMARK; only an echo whose
// braces were escaped (written as SMCL's {c -(} and {c )-}) shows the
// literal "{bf:INJMARK}", so finding that literal is the assertion.

qui sysuse auto, clear
global dash_nobrowser 1
capture dash clear

// P20-01 — the plot-type token
_adv_p19_run "dash {bf:INJMARKPT} mpg weight, name(p2001)"
assert r(rc) == 198
cert_file_has "`r(log)'", needle("unrecognised plot type '{bf:INJMARKPT}'")
assert r(found) == 1
assert "${dash_graph_registry}" == ""
display "P20-01 PASS: an unrecognised plot type is echoed as text, not SMCL"

// P20-02 — a numeric plot option (every num/int/pos rule shares the echo)
_adv_p19_run "dash scatter mpg weight, jitter({bf:INJMARKJIT}) name(p2002)"
assert r(rc) == 198
cert_file_has "`r(log)'", needle("jitter() must be a number between 0 and 100 (got: {bf:INJMARKJIT})")
assert r(found) == 1
assert "${dash_graph_registry}" == ""
display "P20-02 PASS: a refused jitter() value is echoed as text, not SMCL"

// P20-03 — a keyword option (the enum rule)
_adv_p19_run "dash kdensity mpg, kernel({bf:INJMARKKER}) name(p2003)"
assert r(rc) == 198
cert_file_has "`r(log)'", needle("(got: {bf:INJMARKKER})")
assert r(found) == 1
assert "${dash_graph_registry}" == ""
display "P20-03 PASS: a refused kernel() keyword is echoed as text, not SMCL"

// P20-04 — a variable option: mlabel(), the marker-label text source
_adv_p19_run "dash scatter mpg weight, mlabel({bf:INJMARKML}) name(p2004)"
assert r(rc) == 111
cert_file_has "`r(log)'", needle("mlabel(): variable {bf:INJMARKML} not found")
assert r(found) == 1
assert "${dash_graph_registry}" == ""
display "P20-04 PASS: a refused mlabel() variable is echoed as text, not SMCL"

// P20-05 — by()
_adv_p19_run "dash scatter mpg weight, by({bf:INJMARKBY}) name(p2005)"
assert r(rc) == 111
cert_file_has "`r(log)'", needle("by(): variable {bf:INJMARKBY} not found")
assert r(found) == 1
assert "${dash_graph_registry}" == ""
display "P20-05 PASS: a refused by() variable is echoed as text, not SMCL"

// P20-06 — scheme() on a graph
_adv_p19_run "dash scatter mpg weight, scheme({bf:INJMARKSCH}) name(p2006)"
assert r(rc) == 198
cert_file_has "`r(log)'", needle("(got: {bf:INJMARKSCH})")
assert r(found) == 1
assert "${dash_graph_registry}" == ""
display "P20-06 PASS: a refused scheme() is echoed as text, not SMCL"

// P20-07 — the saving() path in the immediate route's success message.
// The braces are legal in a file name, so the file is written under the
// literal name and the message must show that name, not bold text.
local p2007 "`c(tmpdir)'p2007{bf:INJMARKSAV}.html"
capture erase "`p2007'"
_adv_p19_run `"dash scatter mpg weight, saving("`p2007'")"'
assert r(rc) == 0
cert_file_has "`r(log)'", needle("saved to `p2007'")
assert r(found) == 1
confirm file "`p2007'"
capture erase "`p2007'"
display "P20-07 PASS: the saving() path in the success message is shown as the file's real name"

// P20-08 — dash build: the extension refusal, the "already exists"
// refusal and the server-mode success lines all repeat the path.
dash scatter mpg weight, name(p2008)
local p2008e "`c(tmpdir)'p2008{bf:INJMARKEXT}.htm"
_adv_p19_run `"dash build, saving("`p2008e'") replace nobrowser"'
assert r(rc) == 198
cert_file_has "`r(log)'", needle("p2008{bf:INJMARKEXT}.htm)")
assert r(found) == 1
local p2008x "`c(tmpdir)'p2008{bf:INJMARKEX}.html"
capture erase "`p2008x'"
_adv_p19_run `"dash build, saving("`p2008x'") nobrowser"'
assert r(rc) == 0
cert_file_has "`r(log)'", needle("saved to `p2008x'")
assert r(found) == 1
_adv_p19_run `"dash build, saving("`p2008x'") nobrowser"'
assert r(rc) == 198
cert_file_has "`r(log)'", needle("p2008{bf:INJMARKEX}.html' already exists")
assert r(found) == 1
local p2008y "`c(tmpdir)'p2008{bf:INJMARKPY}.py"
capture erase "`p2008y'"
_adv_p19_run `"dash build, saving("`p2008y'") server replace"'
local p20lg "`r(log)'"
assert r(rc) == 0
cert_file_has "`p20lg'", needle("server app written to `p2008y'")
assert r(found) == 1
cert_file_has "`p20lg'", needle(`"To launch: python "`p2008y'""')
assert r(found) == 1
capture erase "`p2008x'"
capture erase "`p2008y'"
display "P20-08 PASS: dash build's saving() refusals and server lines show the path as text"

// P20-09 — link()
capture erase "`c(tmpdir)'p2009.html"
_adv_p19_run `"dash build, saving("`c(tmpdir)'p2009.html") replace nobrowser link({bf:INJMARKLNK})"'
assert r(rc) == 198
cert_file_has "`r(log)'", needle("link() name '{bf:INJMARKLNK}' not found in registry.")
assert r(found) == 1
capture confirm file "`c(tmpdir)'p2009.html"
assert _rc != 0
display "P20-09 PASS: a refused link() name is echoed as text, not SMCL"

// P20-10 — filter(..., exclude())
capture erase "`c(tmpdir)'p2010.html"
_adv_p19_run `"dash build, saving("`c(tmpdir)'p2010.html") replace nobrowser filter(mpg, type(range) exclude({bf:INJMARKEXC}))"'
assert r(rc) == 198
cert_file_has "`r(log)'", needle("exclude() name '{bf:INJMARKEXC}' not found in registry.")
assert r(found) == 1
capture confirm file "`c(tmpdir)'p2010.html"
assert _rc != 0
display "P20-10 PASS: a refused exclude() name is echoed as text, not SMCL"

// P20-11 — theme()
_adv_p19_run `"dash build, saving("`c(tmpdir)'p2011.html") replace nobrowser theme({bf:INJMARKTHM})"'
assert r(rc) == 198
cert_file_has "`r(log)'", needle("(got: {bf:INJMARKTHM})")
assert r(found) == 1
display "P20-11 PASS: a refused theme() is echoed as text, not SMCL"

// P20-12 — the KPI fmt()
_adv_p19_run "dash kpi mean(mpg), name(p2012) title(T) fmt({bf:INJMARKFMT})"
assert r(rc) == 198
cert_file_has "`r(log)'", needle("(got: {bf:INJMARKFMT})")
assert r(found) == 1
assert "${dash_kpi_p2012}" == ""
display "P20-12 PASS: a refused KPI fmt() is echoed as text, not SMCL"

// P20-13 — dash serve's port() and timeout(), through _dash_serve_spec,
// which validates exactly as dash serve does and never starts a server.
tempfile p20sp p20dp
_adv_p19_run `"_dash_serve_spec, specpath("`p20sp'") datapath("`p20dp'") port({bf:INJMARKPRT})"'
assert r(rc) == 198
cert_file_has "`r(log)'", needle("(got: {bf:INJMARKPRT})")
assert r(found) == 1
_adv_p19_run `"_dash_serve_spec, specpath("`p20sp'") datapath("`p20dp'") timeout({bf:INJMARKTMO})"'
assert r(rc) == 198
cert_file_has "`r(log)'", needle("(got: {bf:INJMARKTMO})")
assert r(found) == 1
display "P20-13 PASS: refused port() and timeout() values are echoed as text, not SMCL"

// P20-14 — digits and a trailing newline.  Measured 23sep2026: StataNow's
// regexm() matches "^[0-9]+$" against "7" + char(10) (the P19 note), so
// timeout() took it with rc 0 and handed "7<LF>" to the one-line python:
// statement that launches the server.  port() was refused only because
// real() of it is missing, by the range message.  Both are now digits only.
capture dash clear
dash scatter mpg weight, name(p2014)
mata: st_local("p20nl", "7" + char(10))
local p2014c `"_dash_serve_spec, specpath("`p20sp'") datapath("`p20dp'") timeout(`p20nl')"'
_adv_p19_run `"`p2014c'"'
assert r(rc) == 198
cert_file_has "`r(log)'", needle("timeout() must be a non-negative integer in minutes")
assert r(found) == 1
mata: st_local("p20nl", "5007" + char(10))
local p2014c `"_dash_serve_spec, specpath("`p20sp'") datapath("`p20dp'") port(`p20nl')"'
_adv_p19_run `"`p2014c'"'
assert r(rc) == 198
cert_file_has "`r(log)'", needle("port() must be a positive integer")
assert r(found) == 1
display "P20-14 PASS: port() and timeout() refuse digits followed by a newline"

// P20-15 — an overlong UTF-8 encoding of "<" and ">" (C0 BC, C0 BE) in a
// graph title().  Overlong forms are the classic way past an HTML filter
// that looks for the one-byte character; the gate refuses them first.
capture dash clear
mata: st_local("p20ov", char(192) + char(188) + "script" + char(192) + char(190))
capture dash scatter mpg weight, name(p2015) title(`"x`p20ov'y"')
assert _rc == 198
capture dash scatter mpg weight, name(p2015) note(`"x`p20ov'y"')
assert _rc == 198
assert "${dash_graph_registry}" == ""
display "P20-15 PASS: an overlong-encoded <script> in title() or note() is refused at the UTF-8 gate"

// P20-16 — saving() spelled to slip past the traversal check: the minimum
// abbreviation, a `///' continuation inside the option, and upper case,
// which is not an alias of saving() at all and so cannot carry a path:
// SAVING() is no option, and twoway refuses it, "option SAVING() not
// allowed", r(198), as dash does (test_twoway_option_parity.cscript TP-15).
capture erase "../p2016c.html"
capture dash scatter mpg weight, sav("../p2016a.html")
assert _rc == 198
capture dash scatter mpg weight, saving( ///
    "../p2016b.html")
assert _rc == 198
capture noisily dash scatter mpg weight, SAVING("../p2016c.html")
assert _rc == 198
capture confirm file "../p2016c.html"
assert _rc != 0
display "P20-16 PASS: sav(), a /// continuation and SAVING() cannot carry a traversal"

// P20-17 — layout() was the one build option written into the spec raw.
// Its check read only the start of the value (bs..., or name:r,c...), so
// layout("bs\") passed and its backslash escaped the closing quote of the
// JSON string: measured, r(7102) and a JSONDecodeError traceback.  The
// spec now escapes layout() like every other string (pinned in
// test_security_surface.py), and the value never gets that far: a layout()
// that is not one of its forms whole is refused (P20-30), and no value that
// is one can hold a backslash or a quote.
capture dash clear
dash scatter mpg weight, name(p2017)
local p2017f "`c(tmpdir)'p2017.html"
capture erase "`p2017f'"
_adv_p19_run `"dash build, saving("`p2017f'") replace nobrowser layout("bs\")"'
local p20lg "`r(log)'"
assert r(rc) == 198
cert_file_has "`p20lg'", needle("layout() must be")
assert r(found) == 1
cert_file_has "`p20lg'", needle("JSONDecodeError")
assert r(found) == 0
capture confirm file "`p2017f'"
assert _rc != 0
// A placement with a backslash after it used to build too -- drawn as
// layout(auto), in silence, because the renderer could not read it.  It is
// now refused as a layout() dash cannot read (P20-30); either way it never
// reaches the spec unescaped.
_adv_p19_run `"dash build, saving("`p2017f'") replace nobrowser layout("p2017:1,1\")"'
assert r(rc) == 198
cert_file_has "`r(log)'", needle("layout() must be")
assert r(found) == 1
capture confirm file "`p2017f'"
assert _rc != 0
display "P20-17 PASS: a backslash in layout() never reaches the spec: refused, not a JSON breakout"

// P20-18 — a compound-quote breakout inside an option value.  If "' could
// end the quotes a value is expanded in, what followed would be read as
// display directives (the fmt() hole P9-11..14 closed).  No directive runs.
// Stata's own syntax does not take this text for jitter()'s value -- it
// leaves the whole option to the catch-all (measured 24sep2026 with syntax
// [, JITter(string) *]) -- and twoway refuses the command, "type mismatch",
// r(109).  dash named jitter() as an unsupported option and registered the
// graph (BUGS.md, S3); it now refuses as twoway does, r(109), naming the
// option, and registers nothing.
capture dash clear
local p2018 = "x" + char(34) + char(39) + " _dup(3) " + char(34) + "INJ" + char(34) + " " + char(96) + char(34)
local p2018lg "`c(tmpdir)'dash_adv_p20.log"
local p2018ls = c(linesize)
set linesize 255
capture log close _p20log
capture erase "`p2018lg'"
quietly log using "`p2018lg'", name(_p20log) text replace
capture noisily dash scatter mpg weight, name(p2018) jitter(`p2018')
local p2018rc = _rc
capture noisily twoway scatter mpg weight, jitter(`p2018') nodraw
local p2018tw = _rc
quietly log close _p20log
set linesize `p2018ls'
assert `p2018tw' == 109
assert `p2018rc' == 109
cert_file_has "`p2018lg'", needle("INJINJINJ")
assert r(found) == 0
cert_file_has "`p2018lg'", needle("dash: option jitter() has a value Stata cannot read, as twoway reads it: type mismatch.")
assert r(found) == 1
cert_file_has "`p2018lg'", needle("ignoring unsupported option(s)")
assert r(found) == 0
assert "${dash_graph_registry}" == ""
capture erase "`p2018lg'"
capture dash clear
display "P20-18 PASS: a quote breakout in an option value runs no directive, and is refused r(109) as twoway refuses it"

// P20-18b — the same, for every place such a value can stand: another
// plot option (msize()), an abbreviation (jit()), a graph option after the
// paren-mode comma (saving()), a || segment, and a value like a" "b, which
// twoway refuses with "parentheses do not balance", r(198) (measured
// 24sep2026, sixteen values).  Each twoway verdict is measured again here.
// What twoway accepts is not refused: an option given twice, whose second
// copy -syntax- also leaves to the catch-all, and an option dash does not
// declare, which stays in the note.
local p18q = char(34)
local p18b = "a" + char(34) + " " + char(34) + "b"
local p18c1 "scatter mpg weight, msize(@V@)"
local p18w1 109
local p18c2 "scatter mpg weight, jit(@V@)"
local p18w2 109
local p18c3 "(scatter mpg weight), saving(@V@)"
local p18w3 109
local p18c4 "scatter mpg weight || scatter price weight, msize(@V@)"
local p18w4 109
local p18c5 "scatter mpg weight, jitter(@B@)"
local p18w5 198
forvalues k = 1/5 {
    local want `p18w`k''
    mata: st_local("cmd", subinstr(subinstr(st_local("p18c" + st_local("k")), "@V@", st_local("p2018")), "@B@", st_local("p18b")))
    capture dash clear
    capture twoway `macval(cmd)' nodraw
    local tw = _rc
    capture dash `macval(cmd)' name(p2018b)
    local rc = _rc
    if `tw' != `want' | `rc' != `want' {
        display as error "P20-18b FAIL: twoway r(`tw'), dash r(`rc'); want r(`want')"
        exit 9
    }
    assert "${dash_graph_registry}" == ""
}
// Accepted, as twoway accepts them.
capture dash clear
capture twoway scatter mpg weight, jitter(1) jitter(2) nodraw
assert _rc == 0
capture noisily dash scatter mpg weight, jitter(1) jitter(2) name(p2018c)
assert _rc == 0
capture dash clear
capture noisily dash scatter mpg weight, name(p2018d) nosuchopt(`p18q'a`p18q')
assert _rc == 0
capture dash clear
// Resource exhaustion: 60 undeclared options each holding a quote (Stata's
// -syntax- itself refuses a few more, "too many options") are named in the
// note, only the first 50 put to the parser, and quickly.
local p18many ""
forvalues i = 1/60 {
    local p18many `"`p18many' zz`i'(`p18q'a`p18q')"'
}
timer clear 18
timer on 18
capture noisily dash scatter mpg weight, name(p2018e) `p18many'
local rc = _rc
timer off 18
assert `rc' == 0
quietly timer list 18
assert r(t18) < 10
capture dash clear
display "P20-18b PASS: an option dash declares whose value Stata cannot bind is refused with twoway's code wherever it stands; a repeat and an unknown option are not"

// P20-19 — timeout() of 400 digits.  Measured: accepted with rc 0; the
// launcher multiplies it by 60 into a float and the app died with
// OverflowError after binding its port.  At most nine digits now.
dash scatter mpg weight, name(p2019)
local p2019 = 400 * "9"
_adv_p19_run `"_dash_serve_spec, specpath("`p20sp'") datapath("`p20dp'") timeout(`p2019')"'
assert r(rc) == 198
cert_file_has "`r(log)'", needle("timeout() must be a non-negative integer in minutes")
assert r(found) == 1
capture noisily _dash_serve_spec, specpath("`p20sp'") datapath("`p20dp'") timeout(999999999)
assert _rc == 0
assert "`r(timeout)'" == "999999999"
display "P20-19 PASS: a 400-digit timeout() is refused; nine digits are accepted"

// P20-20 — an if qualifier of 600 !s.  Stata reads it; the renderer's
// qualifier check and pandas' evaluator each recurse once per operator, and
// the RecursionError escaped both guards: measured, r(7102) and a traceback
// on the immediate route, and on dash build for the same KPI qualifier.  It
// was then reported as a qualifier that could not be applied; since WP-27
// Stata evaluates it, as it evaluates every qualifier dash writes, and the
// renderer never parses it: applied, no skip, no traceback.
capture dash clear
local p2020 = 600 * "!"
local p2020f "`c(tmpdir)'p2020.html"
capture erase "`p2020f'"
_adv_p19_run `"dash scatter mpg weight if `p2020'(mpg > 1), saving("`p2020f'")"'
local p20lg "`r(log)'"
assert r(rc) == 0
confirm file "`p2020f'"
cert_file_has "`p20lg'", needle("if_expr filter skipped")
assert r(found) == 0
cert_file_has "`p20lg'", needle("RecursionError")
assert r(found) == 0
capture erase "`p2020f'"
dash kpi mean(mpg) if `p2020'(mpg > 1), name(p2020k) title(T)
dash scatter mpg weight, name(p2020g)
_adv_p19_run `"dash build, saving("`p2020f'") replace nobrowser"'
assert r(rc) == 0
confirm file "`p2020f'"
cert_file_has "`r(log)'", needle("RecursionError")
assert r(found) == 0
capture erase "`p2020f'"
capture dash clear
display "P20-20 PASS: a 600-operator if qualifier is evaluated in Stata, not a traceback"

// P20-21 — name() of 5,000 characters, graph and KPI: refused, and the
// echo is cut at 40 characters, so the refusal is bounded too.
local p2021 = 5000 * "a"
local p2021e = 40 * "a"
_adv_p19_run "dash scatter mpg weight, name(`p2021')"
assert r(rc) == 198
cert_file_has "`r(log)'", needle("invalid graph name '`p2021e''")
assert r(found) == 1
_adv_p19_run "dash kpi mean(mpg), name(`p2021') title(T)"
assert r(rc) == 198
cert_file_has "`r(log)'", needle("invalid name '`p2021e''")
assert r(found) == 1
assert "${dash_graph_registry}" == ""
display "P20-21 PASS: a 5,000-character name() is refused with a 40-character echo"

// P20-22..23 — dash_setup.  Its inputs are what the environment reports:
// installed package names and versions, read back from Python.
do "../dash_setup.ado"

// P20-22 — _dash_pkg_version refuses anything but a plain package name
// before the name is interpolated into its python: line.  A name with
// code characters, a blank, or a trailing newline comes back "unknown",
// and a name carrying a double quote cannot reach Python at all.
global ZZADV20 ""
foreach p2022 in "bokeh;import" "bo keh" "bokeh.lower()or(1)" "bokeh)#" {
    local p2022v "x"
    capture _dash_pkg_version "`p2022'" p2022v
    assert _rc == 0
    assert "`p2022v'" == "unknown"
}
mata: st_local("p2022n", "bokeh" + char(10))
local p2022v "x"
capture _dash_pkg_version "`p2022n'" p2022v
assert "`p2022v'" == "unknown"
local p2022q = "bokeh" + char(34) + ") or __import__(" + char(34) + "sfi" + char(34) + ").Macro.setGlobal(" + char(34) + "ZZADV20" + char(34) + "," + char(34) + "1" + char(34) + ") or (" + char(34)
local p2022v "x"
capture _dash_pkg_version `"`p2022q'"' p2022v
assert "${ZZADV20}" == ""
assert inlist("`p2022v'", "x", "unknown")
macro drop ZZADV20
display "P20-22 PASS: a package name that is not a plain name never reaches Python as code"

// P20-23 — a version string of 5,001 components, all equal to the minimum
// at every place, is judged in bounded time and does not fail.
local p2023 = "3." + 4999 * "0." + "0"
timer clear 20
timer on 20
_dash_setup_gate bokeh "`p2023'" "3.0" 0
local p2023v "`r(verdict)'"
timer off 20
quietly timer list 20
assert "`p2023v'" == "unverified"
assert r(t20) < 60
display "P20-23 PASS: a 5,001-component version string is judged in bounded time"

// P20-24 — exclude() in upper or mixed case.  The registry check searched
// for "exclude(" case-sensitively while the renderer reads the sub-option
// in any case, so EXCLUDE(nosuch) skipped the check, built with rc 0, and
// excluded nothing -- the typo the check exists to catch, in silence.
capture dash clear
dash scatter mpg weight, name(p2024)
// Erased first: "no file written" must not be answered by a file an
// earlier run left behind.
capture erase "`c(tmpdir)'p2024.html"
foreach p2024x in EXCLUDE Exclude {
    _adv_p19_run `"dash build, saving("`c(tmpdir)'p2024.html") replace nobrowser filter(mpg, type(range) `p2024x'(nosuch))"'
    assert r(rc) == 198
    cert_file_has "`r(log)'", needle("exclude() name 'nosuch' not found in registry.")
    assert r(found) == 1
}
capture confirm file "`c(tmpdir)'p2024.html"
assert _rc != 0
display "P20-24 PASS: EXCLUDE() and Exclude() get the same registry check as exclude()"

// P20-25 — layout() grid size.  The saved page pads its grid out to rows x
// cols cells before drawing it: measured 23sep2026, a 4000 x 4000 grid of
// two graphs peaked at 1.5 GB and the cost grows with the cells, so
// layout(99999 99999) -- ten billion -- could not finish.  No grid needs
// more cells than a dashboard can hold graphs and KPI cards, so rows x cols
// (for name:row,col, the largest row by the largest column) is held to the
// graphs limit that dash_max_graphs sets.
capture dash clear
dash scatter mpg weight, name(p2025a)
dash scatter price weight, name(p2025b)
local p2025f "`c(tmpdir)'p2025.html"
capture erase "`p2025f'"
foreach p2025l in "99999 99999" "10 11" "p2025a:1,1 p2025b:99999,99999" "p2025a:1,1 p2025b:11,10" {
    _adv_p19_run `"dash build, saving("`p2025f'") replace nobrowser layout(`p2025l')"'
    local p20lg "`r(log)'"
    assert r(rc) == 198
    cert_file_has "`p20lg'", needle("graphs and KPI cards one dashboard draws")
    assert r(found) == 1
    cert_file_has "`p20lg'", needle("set global dash_max_graphs to a higher value (at most 1,000)")
    assert r(found) == 1
    capture confirm file "`p2025f'"
    assert _rc != 0
}
_adv_p19_run `"dash build, saving("`p2025f'") replace nobrowser layout(10 10)"'
assert r(rc) == 0
confirm file "`p2025f'"
capture erase "`p2025f'"
global dash_max_graphs 110
_adv_p19_run `"dash build, saving("`p2025f'") replace nobrowser layout(10 11)"'
assert r(rc) == 0
confirm file "`p2025f'"
macro drop dash_max_graphs
capture erase "`p2025f'"
display "P20-25 PASS: a layout() grid larger than the graphs limit is refused; 10 x 10 builds, and 10 x 11 at dash_max_graphs 110"

// P20-26 — port() at and past its bounds, and spelled to slip past a
// digits check: a sign, a decimal, e-notation and full-width digits.
// A graph is registered first, so a refusal here is port()'s own and not
// the empty registry's (which also exits 198).
capture dash clear
dash scatter mpg weight, name(p2026)
mata: st_local("p2026fw", char(239) + char(188) + char(149) + char(239) + char(188) + char(144) + char(239) + char(188) + char(144) + char(239) + char(188) + char(150))
foreach p2026p in 1023 65536 +5006 5006.0 1e4 0x138e `p2026fw' 99999999999999999999 {
    capture _dash_serve_spec, specpath("`p20sp'") datapath("`p20dp'") port(`p2026p')
    assert _rc == 198
}
foreach p2026p in 1024 65535 05006 {
    capture noisily _dash_serve_spec, specpath("`p20sp'") datapath("`p20dp'") port(`p2026p')
    assert _rc == 0
    assert "`r(port)'" == strofreal(real("`p2026p'"))
}
capture dash clear
display "P20-26 PASS: port() refuses 1023, 65536, signs, decimals, hex and full-width digits; accepts 1024 and 65535"

// P20-27 — dash kpi's stat(var), spelled to slip past its allow-list:
// upper and mixed case, the percentile bounds, malformed fractional
// percentiles (two points, an exponent that makes 100), trailing text,
// unbalanced or doubled parentheses, a blank inside, and two variables.
// Every one is refused and registers nothing.  p97.5 itself is a
// percentile, as dash.sthlp says, and is accepted since WP-23
// (test_help_claims_4.cscript HC4-01..07).
capture dash clear
foreach p2027s in "MEAN(mpg)" "Mean(mpg)" "p0(mpg)" "p100(mpg)" "p97.5.5(mpg)" "p1e2(mpg)" "mean(mpg);x" "mean(mpg))" "mean( mpg)" "sum(mpg price)" "mean(mpg)(price)" {
    capture dash kpi `p2027s', name(p2027) title(T)
    assert _rc != 0
    assert "${dash_kpi_p2027}" == ""
    assert "${dash_graph_registry}" == ""
}
display "P20-27 PASS: KPI stat(var) spellings outside the allow-list are refused, nothing registered"

// P20-28 — malformed UTF-8 inside the DATA.  The UTF-8 gate reads command
// text only; a Latin-1 byte in a string value, a variable label and a value
// label reaches jsonio, which must still hand the renderer a file it can
// decode.  Measured 23sep2026: it does, and the page is drawn.
qui sysuse auto, clear
generate str20 p2028s = "caf" + char(233) in 1/10
replace p2028s = "ok" in 11/74
local p2028l = "Mile" + char(233) + "age"
label variable mpg "`p2028l'"
local p2028v = "For" + char(255)
label define p2028b 0 "Dom" 1 "`p2028v'"
label values foreign p2028b
local p2028f "`c(tmpdir)'p2028.html"
capture erase "`p2028f'"
_adv_p19_run `"dash scatter mpg weight, mlabel(p2028s) by(foreign) saving("`p2028f'")"'
assert r(rc) == 0
confirm file "`p2028f'"
cert_file_has "`r(log)'", needle("UnicodeDecodeError")
assert r(found) == 0
capture erase "`p2028f'"
qui sysuse auto, clear
display "P20-28 PASS: malformed UTF-8 in a string value, a variable label and a value label renders"

// P20-29 — the echoes P20-01..13 did not list: a scatteri coordinate that
// has no pair, and the note that saving(x.gph) is written as x.html.  Both
// repeat the user's text, and both drew it as SMCL -- measured at e932446,
// `dash scatteri {bf:X}' named a bold X.  (A lone token is too little for
// a point, as twoway reads scatteri, and is named so -- P20-34..36 attack
// the reader itself.)  The .gph note was also displayed
// BEFORE the path was validated, inside plain quotes, so a double quote in
// the name ended the string and what followed ran as display directives:
// measured at e932446, saving(`"p" _dup(3) "INJ.gph"') printed
// "INJ.htmlINJ.htmlINJ.html".  The path is validated first now, which
// refuses the quote, and the note is shown as written.  (A weight
// expression is echoed the same way, but cannot carry SMCL: Stata's own
// parser refuses a brace in it -- [aw={bf:X}] is "invalid syntax".)
capture dash clear
_adv_p19_run "dash scatteri {bf:INJMARKSI}, name(p2029b)"
assert r(rc) == 198
cert_file_has "`r(log)'", needle("'{bf:INJMARKSI}' is too little for one.")
assert r(found) == 1
assert "${dash_graph_registry}" == ""
local p2029g "`c(tmpdir)'p2029{bf:INJMARKGP}.gph"
local p2029h "`c(tmpdir)'p2029{bf:INJMARKGP}.html"
capture erase "`p2029h'"
_adv_p19_run `"dash scatter mpg weight, saving("`p2029g'")"'
assert r(rc) == 0
cert_file_has "`r(log)'", needle("not a Stata .gph; using `p2029h'")
assert r(found) == 1
confirm file "`p2029h'"
capture erase "`p2029h'"
local p2029q = "p2029" + char(34) + " _dup(3) " + char(34) + "INJ.gph"
local p2029lg "`c(tmpdir)'dash_adv_p2029.log"
local p2029ls = c(linesize)
set linesize 255
capture log close _p2029log
capture erase "`p2029lg'"
quietly log using "`p2029lg'", name(_p2029log) text replace
capture noisily dash scatter mpg weight, saving(`"`c(tmpdir)'`p2029q'"')
local p2029rc = _rc
quietly log close _p2029log
set linesize `p2029ls'
assert `p2029rc' == 198
cert_file_has "`p2029lg'", needle("INJ.htmlINJ.html")
assert r(found) == 0
cert_file_has "`p2029lg'", needle("saving() path contains disallowed characters")
assert r(found) == 1
capture erase "`p2029lg'"
assert "${dash_graph_registry}" == ""
display "P20-29 PASS: a scatteri coordinate and the .gph note are echoed as text, and the note runs no directive"

// P20-30 — a layout() dash cannot read whole, or that names something
// the registry does not hold.  The check read only the START of the value
// (bs..., or name:r,c...), so the renderer was handed what it could not
// read and drew it some other way, in silence: measured at f2ecdd4,
// layout(p:1,1 junk) and layout(bs\) were drawn as auto, layout(nosuch:1,1)
// was a 3 x 1 grid saved and 1 x 2 served, and layout(bs: ...) dropped an
// unknown name and clamped a span of 13 to 12.  link() and exclude() have
// always refused a name the registry does not hold; layout() now does too,
// and refuses a value that is not one of its forms whole.
capture dash clear
dash scatter mpg weight, name(p2030a)
dash scatter price weight, name(p2030b)
dash kpi mean(mpg), name(p2030k) title(T)
local p2030f "`c(tmpdir)'p2030.html"
foreach p2030l in "p2030a:1,1 junk" "p2030a:1,1,p2030b:1,2" "bs\" "bsx" "bs:" "bs: p2030a = 6" {
    capture erase "`p2030f'"
    _adv_p19_run `"dash build, saving("`p2030f'") replace nobrowser layout(`p2030l')"'
    assert r(rc) == 198
    cert_file_has "`r(log)'", needle("layout() must be")
    assert r(found) == 1
    capture confirm file "`p2030f'"
    assert _rc != 0
}
foreach p2030l in "nosuch:1,1" "p2030a:1,1 nosuch:2,2" "bs: p2030a=6 nosuch=6" "bs: nosuch" {
    capture erase "`p2030f'"
    _adv_p19_run `"dash build, saving("`p2030f'") replace nobrowser layout(`p2030l')"'
    assert r(rc) == 198
    cert_file_has "`r(log)'", needle("layout() name 'nosuch' not found in registry.")
    assert r(found) == 1
    capture confirm file "`p2030f'"
    assert _rc != 0
}
foreach p2030l in "bs: p2030a=13" "bs: p2030a=0" "bs: p2030a=x" "bs: p2030a=" "bs: p2030a=0012" {
    capture erase "`p2030f'"
    _adv_p19_run `"dash build, saving("`p2030f'") replace nobrowser layout(`p2030l')"'
    assert r(rc) == 198
    cert_file_has "`r(log)'", needle("must be a whole number from 1 to 12")
    assert r(found) == 1
    capture confirm file "`p2030f'"
    assert _rc != 0
}
foreach p2030l in "p2030a:1,1 p2030b:1,2" "p2030b:1,1 p2030k:2,1 p2030a:1,2" "p2030a:0,0" "bs" "BS" "bs: p2030a=6 p2030b=6" "bs: p2030k=3 p2030a=9 / p2030b" "1 3" {
    capture erase "`p2030f'"
    _adv_p19_run `"dash build, saving("`p2030f'") replace nobrowser layout(`p2030l')"'
    assert r(rc) == 0
    confirm file "`p2030f'"
    cert_file_has "`r(log)'", needle("layout(")
    assert r(found) == 0
}
capture erase "`p2030f'"
capture dash clear
display "P20-30 PASS: a layout() that is not one of its forms whole, names an unregistered item, or gives a Bootstrap span outside 1..12 is refused"

// P20-31 — a layout() that places one name more than once.  Measured
// 23sep2026: layout(bs: ...) embedded the item once per repeat on the saved
// page -- 100,000 repeats made an 18.1 MB page of duplicate element ids --
// and a repeated placement kept its last place without a word.  Refused
// now, in either form.
capture dash clear
dash scatter mpg weight, name(p2031a)
dash scatter price weight, name(p2031b)
local p2031f "`c(tmpdir)'p2031.html"
foreach p2031l in "bs: p2031a=6 p2031a=6 p2031b=6" "bs: p2031a / p2031b p2031a=12" "p2031a:1,1 p2031b:1,2 p2031a:2,1" {
    capture erase "`p2031f'"
    _adv_p19_run `"dash build, saving("`p2031f'") replace nobrowser layout(`p2031l')"'
    assert r(rc) == 198
    cert_file_has "`r(log)'", needle("layout() places 'p2031a' more than once.")
    assert r(found) == 1
    capture confirm file "`p2031f'"
    assert _rc != 0
}
capture dash clear
display "P20-31 PASS: a layout() that places a name twice is refused"

// P20-32 — a graph or KPI name that holds two underscores in a row.  The
// renderer names what it generates with them: a by() graph g1's panels are
// g1__by__0, g1__by__1, ..., a KPI's per-panel cards the same, and the
// saved layout(bs) page keys its tab strip __tabs__ and its filters
// __fw_0__.  Measured 23sep2026: name(g1__by__0) beside by(foreign)
// name(g1) was registered, and dash build drew it in place of g1's
// Domestic panel.  Refused now, for a graph and a KPI card alike, with or
// without replace, and nothing is registered; single underscores are still
// a name, and the dashboard builds.
capture dash clear
dash scatter mpg weight, by(foreign) name(g1)
foreach p2032n in g1__by__0 __tabs__ __fw_0__ a__b {
    _adv_p19_run "dash scatter price weight, name(`p2032n')"
    assert r(rc) == 198
    cert_file_has "`r(log)'", needle("dash: graph name '`p2032n'' holds two underscores in a row")
    assert r(found) == 1
}
_adv_p19_run "dash scatter price weight, name(g1__by__0, replace)"
assert r(rc) == 198
_adv_p19_run "dash kpi mean(mpg), title(T) name(k1__by__0)"
assert r(rc) == 198
cert_file_has "`r(log)'", needle("dash kpi: name 'k1__by__0' holds two underscores in a row")
assert r(found) == 1
assert "${dash_graph_registry}" == "g1"
dash scatter price weight, name(_p2032_b_)
assert "${dash_graph_registry}" == "g1 _p2032_b_"
local p2032f "`c(tmpdir)'p2032.html"
capture erase "`p2032f'"
_adv_p19_run `"dash build, saving("`p2032f'") replace nobrowser"'
assert r(rc) == 0
confirm file "`p2032f'"
capture erase "`p2032f'"
capture dash clear
display "P20-32 PASS: a graph or KPI name holding two underscores in a row is refused, and nothing is registered"

// P20-33 -- name(g1, replace) stored the graph under the name "g1, replace".
// Stata's name(string) captures the whole of "g1, replace".  _dash_plot
// wrote that text into the graph's JSON as graph_options "name", and
// _dash_register_graph then split ", replace" off and registered g1 -- so
// the registry said g1 while the stored spec, which both renderers key
// every item by, said "g1, replace".  Measured 23sep2026 at 9f48cf7, both
// registrations rc 0 and the registry "g1": layout(g2:1,1 g1:1,2) warned
// that g1 "is not a registered graph or KPI card" and drew it below g2;
// layout(bs: g1=6 g2=6) drew it alone on a row at width 12 and saved its
// PNG as "dashboard", not g1; tabs(A: g1)
// built no tabs and tabs(A: g1 / B: g2) only tab B; link(g1 g2) left two
// sources; exclude(g1) did not protect it; a plain build drew it after g2.
// A by() graph did the same under panel keys "g1, replace__by__0", and so
// did a replace naming a new name.  The stored name must be exactly the
// registered one, in every spelling twoway allows around the comma (spaces
// only: rep, REPLACE and a tab before replace are refused by twoway), and
// the build is read back from each page's own Bokeh document: where the
// graph is drawn, which tab holds it, which source it draws from, and
// which sources the filter reaches.  Every verdict is collected before the
// one assert, so a failing run names each check that failed.
capture dash clear
local p2033bad ""
dash scatter mpg weight, name(g1) title("Old G1")
dash scatter price weight, name(g1, replace) title("New G1")
dash scatter mpg turn, name(g2) title("G2")
assert "${dash_graph_registry}" == "g1 g2"
mata: st_global("P2033_J_g1", st_global("dash_json_g1"))
local p2033o_plain ""
local p2033o_place "layout(g2:1,1 g1:1,2)"
local p2033o_bs    "layout(bs: g1=6 g2=6)"
local p2033o_tabs1 "tabs(A: g1)"
local p2033o_tabs2 "tabs(A: g1 / B: g2)"
local p2033o_link  "link(g1 g2)"
local p2033o_excl  "filter(foreign, type(dropdown) exclude(g1))"
local p2033o_byplace "layout(g2:1,1 g1:1,2)"
local p2033o_byexcl  "filter(foreign, type(dropdown) exclude(g1))"
foreach p2033c in plain place bs tabs1 tabs2 link excl byplace byexcl {
    // The by() half: the same g1, replaced once more, now faceted.
    if "`p2033c'" == "byplace" {
        dash scatter price weight, by(foreign) name(g1, replace) title("New G1")
        assert "${dash_graph_registry}" == "g1 g2"
        mata: st_global("P2033_J_by", st_global("dash_json_g1"))
    }
    local p2033f "`c(tmpdir)'p2033_`p2033c'.html"
    capture erase "`p2033f'"
    _adv_p19_run `"dash build, saving("`p2033f'") replace nobrowser `p2033o_`p2033c''"'
    local p2033rc = r(rc)
    local p2033lg "`r(log)'"
    if `p2033rc' != 0 local p2033bad "`p2033bad' `p2033c':rc=`p2033rc'"
    capture confirm file "`p2033f'"
    if _rc local p2033bad "`p2033bad' `p2033c':no-page"
    cert_file_has "`p2033lg'", needle("is not a registered graph or KPI card")
    if r(found) != 0 local p2033bad "`p2033bad' `p2033c':log-says-g1-is-not-registered"
}
// A replace naming a new name, the spellings twoway allows, the paren
// forms (after the comma and inside a segment), and by() on a new name.
foreach p2033s in "p2033n, replace" "p2033s1 ,replace" "p2033s2,replace" " p2033s3 ,  replace " "a_stat, replace" {
    dash scatter mpg weight, name(`p2033s')
}
dash (scatter mpg weight) (line mpg weight), name(p2033p1, replace)
dash (scatter mpg weight, name(p2033p2, replace)) (line mpg weight)
dash scatter mpg weight, by(foreign) name(p2033nb, replace)
assert "${dash_graph_registry}" == "g1 g2 p2033n p2033s1 p2033s2 p2033s3 a_stat p2033p1 p2033p2 p2033nb"
foreach p2033n in p2033n p2033s1 p2033s2 p2033s3 a_stat p2033p1 p2033p2 p2033nb {
    mata: st_global("P2033_J_" + "`p2033n'", st_global("dash_json_" + "`p2033n'"))
}
// Replace itself is unchanged: a spelled replace replaces in place, and a
// bare reuse is still refused.
_adv_p19_run "dash scatter price weight, name(p2033s1 , replace)"
if r(rc) != 0 local p2033bad "`p2033bad' respelled-replace:rc=`r(rc)'"
mata: st_global("P2033_J_s1again", st_global("dash_json_p2033s1"))
_adv_p19_run "dash scatter price weight, name(g2)"
local p2033rc = r(rc)
local p2033lg "`r(log)'"
if `p2033rc' != 198 local p2033bad "`p2033bad' bare-reuse:rc=`p2033rc'"
cert_file_has "`p2033lg'", needle("dash: graph name 'g2' already exists. Use name(g2, replace) to overwrite.")
if r(found) != 1 local p2033bad "`p2033bad' bare-reuse:message"
if "${dash_graph_registry}" != "g1 g2 p2033n p2033s1 p2033s2 p2033s3 a_stat p2033p1 p2033p2 p2033nb" {
    local p2033bad "`p2033bad' registry-changed"
}
global P2033_DIR "`c(tmpdir)'"
global P2033_FAIL ""
python:
import html as _p2033_html
import json as _p2033_json
import os as _p2033_os
import re as _p2033_re
from sfi import Macro as _p2033_M

def _p2033_load(fname):
    # The page and its Bokeh document as an id -> model map.  file_html
    # pages embed the document HTML-escaped in <script type=
    # "application/json">; the layout(bs) page embeds components()'s
    # docs_json, a JS string literal HTML-escaped with a single quote as
    # &#x27; and every backslash doubled.  No backslash is written in this
    # block: Stata reads a do-file's python lines for macros first, and a
    # backslash can escape one.  chr(92) is the backslash.
    with open(_p2033_os.path.join(_p2033_M.getGlobal("P2033_DIR"), fname), encoding="utf-8") as fh:
        page = fh.read()
    m = _p2033_re.search(r'<script type="application/json"[^>]*>(.*?)</script>', page, _p2033_re.S)
    if m:
        blob = _p2033_html.unescape(m.group(1))
    else:
        m = _p2033_re.search(r"const docs_json = '(.*?)';", page, _p2033_re.S)
        blob = _p2033_html.unescape(m.group(1).replace(chr(92) * 2, chr(92)))
    docs = _p2033_json.loads(blob)
    objs = {}
    stack = [docs]
    while stack:
        v = stack.pop()
        if isinstance(v, dict):
            if v.get("type") == "object" and "id" in v and "name" in v:
                objs[v["id"]] = v
            stack.extend(v.values())
        elif isinstance(v, list):
            stack.extend(v)
    roots = []
    for d in docs.values():
        roots.extend(d.get("roots") or [])
    return page, objs, roots

def _p2033_ref(objs, v):
    if isinstance(v, dict) and "id" in v:
        return objs.get(v["id"], v)
    return v

def _p2033_kids(objs, node):
    a = node.get("attributes", {})
    out = []
    for key in ("children", "tabs", "child"):
        ch = a.get(key)
        if ch is None:
            continue
        for c in (ch if isinstance(ch, list) else [ch]):
            out.append(_p2033_ref(objs, c[0] if isinstance(c, list) else c))
    return out

def _p2033_title(objs, fig):
    t = _p2033_ref(objs, fig.get("attributes", {}).get("title"))
    return t.get("attributes", {}).get("text") if isinstance(t, dict) else None

def _p2033_under(objs, node):
    # The titles of every figure in node's subtree, sorted.
    out = []
    stack = [_p2033_ref(objs, node)]
    while stack:
        n = stack.pop()
        if not isinstance(n, dict):
            continue
        if n.get("name") == "Figure":
            out.append(str(_p2033_title(objs, n)))
        stack.extend(_p2033_kids(objs, n))
    return sorted(out)

def _p2033_cells(objs, roots):
    # {figure title: (row, col)} over the outermost GridPlot: a figure is
    # keyed by the cell of that grid which holds it, so a by() graph's panels
    # share their graph's cell.
    queue = [_p2033_ref(objs, r) for r in roots]
    while queue:
        n = queue.pop(0)
        if not isinstance(n, dict):
            continue
        if n.get("name") == "GridPlot":
            out = {}
            for c in n.get("attributes", {}).get("children", []):
                for t in _p2033_under(objs, c[0]):
                    out[t] = (c[1], c[2])
            return out
        queue.extend(_p2033_kids(objs, n))
    return {}

def _p2033_tabs(objs):
    # [(tab title, figure titles)] for every tab of every Tabs model.
    out = []
    for o in objs.values():
        if o.get("name") == "Tabs":
            for p in o.get("attributes", {}).get("tabs", []):
                p = _p2033_ref(objs, p)
                out.append((p.get("attributes", {}).get("title"), _p2033_under(objs, p)))
    return out

def _p2033_srcs(objs, prefix):
    # The data sources of every figure whose title begins with prefix.
    out = set()
    for o in objs.values():
        if o.get("name") == "Figure" and str(_p2033_title(objs, o)).startswith(prefix):
            for r in o.get("attributes", {}).get("renderers", []):
                r = _p2033_ref(objs, r)
                if r.get("name") == "GlyphRenderer":
                    out.add(_p2033_ref(objs, r["attributes"]["data_source"])["id"])
    return out

def _p2033_filtered(objs):
    # For each filter callback, the set of sources it filters.
    out = []
    for o in objs.values():
        if o.get("name") == "CustomJS":
            args = o.get("attributes", {}).get("args", {})
            args = dict(args.get("entries", [])) if "entries" in args else args
            if "all_graph_sources" in args:
                out.append({_p2033_ref(objs, s)["id"] for s in args["all_graph_sources"]})
    return out

def _p2033_bs_rows(page, objs):
    # The saved layout(bs) page's rows that hold an item: [[(title, span)]].
    rows = []
    span = None
    for m in _p2033_re.finditer(r'class="db-row[^"]*"|class="([^"]*db-col-lg-([0-9]+)[^"]*)"|data-root-id="([^"]+)"', page):
        if m.group(0).startswith('class="db-row'):
            rows.append([])
        elif m.group(2):
            span = int(m.group(2))
        elif rows:
            rows[-1].append((" ".join(_p2033_under(objs, {"id": m.group(3)})), span))
    return [r for r in rows if r]

def _p2033_verdict(case, page, objs, roots):
    # None when the page draws what its build asked for, else what it drew.
    # g1 is the figure titled "New G1" -- by(foreign) makes it two panels,
    # "New G1" then an em dash and the group -- and g2 the one titled "G2".
    new, g2 = "New G1", "G2"
    cells = _p2033_cells(objs, roots)
    panels = sorted(t for t in cells if t.startswith(new))
    if case == "plain":
        want = {new: (0, 0), g2: (0, 1)}
        return None if cells == want else "cells %r" % sorted(cells.items())
    if case == "place":
        want = {g2: (0, 0), new: (0, 1)}
        return None if cells == want else "cells %r" % sorted(cells.items())
    if case == "byplace":
        ok = (len(panels) == 2 and len(cells) == 3 and cells.get(g2) == (0, 0)
              and all(cells[t] == (0, 1) for t in panels))
        return None if ok else "cells %r" % sorted(cells.items())
    if case == "bs":
        # An item layout(bs) embeds on its own saves its PNG under its
        # stored name; "g1, replace" is not a Stata name, so it was saved
        # as "dashboard".
        rows = _p2033_bs_rows(page, objs)
        saves = sorted(str(o.get("attributes", {}).get("filename")) for o in objs.values() if o.get("name") == "SaveTool")
        ok = rows == [[(new, 6), (g2, 6)]] and saves == ["g1", "g2"]
        return None if ok else "rows %r, PNG names %r" % (rows, saves)
    if case in ("tabs1", "tabs2"):
        want = [("A", [new])] + ([("B", [g2])] if case == "tabs2" else [])
        tabs = _p2033_tabs(objs)
        return None if tabs == want else "tabs %r" % tabs
    s_new, s_g2 = _p2033_srcs(objs, new), _p2033_srcs(objs, g2)
    if case == "link":
        ok = len(s_new) > 0 and s_new == s_g2
        return None if ok else "sources g1 %r g2 %r" % (sorted(s_new), sorted(s_g2))
    if case in ("excl", "byexcl"):
        fl = _p2033_filtered(objs)
        ok = (len(fl) > 0 and len(s_new) > 0 and len(s_g2) > 0
              and all(not (s_new & s) and s_g2 <= s for s in fl))
        if case == "byexcl":
            fig_new = [o for o in objs.values() if o.get("name") == "Figure" and str(_p2033_title(objs, o)).startswith(new)]
            ok = ok and len(fig_new) == 2
        return None if ok else "sources g1 %r g2 %r, filtered %r" % (sorted(s_new), sorted(s_g2), [sorted(s) for s in fl])
    return "no check for %s" % case

def _p2033_run():
    bad = []
    names = [("P2033_J_g1", "g1"), ("P2033_J_by", "g1"), ("P2033_J_p2033n", "p2033n"),
             ("P2033_J_p2033s1", "p2033s1"), ("P2033_J_p2033s2", "p2033s2"),
             ("P2033_J_p2033s3", "p2033s3"), ("P2033_J_a_stat", "a_stat"),
             ("P2033_J_p2033p1", "p2033p1"), ("P2033_J_p2033p2", "p2033p2"),
             ("P2033_J_p2033nb", "p2033nb"), ("P2033_J_s1again", "p2033s1")]
    for key, want in names:
        try:
            got = _p2033_json.loads(_p2033_M.getGlobal(key))["graph_options"].get("name")
        except Exception as e:
            got = "unreadable (%s)" % type(e).__name__
        if got != want:
            bad.append("%s stores name %r, not %r" % (key, got, want))
    try:
        if _p2033_json.loads(_p2033_M.getGlobal("P2033_J_by"))["graph_options"].get("by") != "foreign":
            bad.append("P2033_J_by is not the by(foreign) graph")
        if '"yvar":"price"' not in _p2033_M.getGlobal("P2033_J_s1again"):
            bad.append("the respelled replace did not replace p2033s1")
    except Exception as e:
        bad.append("stored spec unreadable (%s)" % type(e).__name__)
    for case in ("plain", "place", "bs", "tabs1", "tabs2", "link", "excl", "byplace", "byexcl"):
        try:
            page, objs, roots = _p2033_load("p2033_%s.html" % case)
            why = _p2033_verdict(case, page, objs, roots)
        except Exception as e:
            why = "unreadable (%s: %s)" % (type(e).__name__, e)
        if why is not None:
            bad.append("%s page: %s" % (case, why))
    return bad

_p2033_M.setGlobal("P2033_FAIL", " | ".join(_p2033_run()).replace("{", "(").replace("}", ")"))
end
mata: st_local("p2033pyn", strofreal(strlen(st_global("P2033_FAIL"))))
if `p2033pyn' > 0 {
    mata: printf("{err}P20-33 spec/page checks failed: %s\n", st_global("P2033_FAIL"))
}
if "`p2033bad'" != "" {
    display as error "P20-33 build checks failed:`p2033bad'"
}
foreach p2033c in plain place bs tabs1 tabs2 link excl byplace byexcl {
    capture erase "`c(tmpdir)'p2033_`p2033c'.html"
}
macro drop P2033_*
capture dash clear
assert "`p2033bad'" == "" & `p2033pyn' == 0
display "P20-33 PASS: name(g1, replace) stores the graph as g1 -- with by(), on a new name, in every spelling -- and layout(), tabs(), link() and exclude() reach it"
// ================================================================
// P20-34..36 -- scatteri's and pci's immediate values
// ================================================================
// `scatteri #y #x [(#clockpos)] ["label"] ...' and `pci #y1 #x1 #y2 #x2
// [(#clockpos)] ["label"] ...' carry numbers, clock positions and free
// text from the command line into the spec, read now by the reader
// pcarrowi's values go through (dash_parse.mata, section 2c).  Until then
// dash.ado wrote each token into the spec as it was typed
// (test_parser.cscript P1A-60..67): a token that is not a JSON number
// broke the spec, and the render stopped on a JSONDecodeError, r(7102).
// The three cases CLAUDE.md rule 18 asks for, against that surface's own
// guards.

// P20-34 -- tokens spelled to pass for a coordinate or a clock position:
// SMCL, hex, digits followed by letters, full-width, Arabic-Indic and
// superscript digits, a Unicode minus, a no-break space and a tab glued
// to a digit, a numlist range, an expression, an uppercase missing value
// and a quoted non-number.  Each is refused r(198), as twoway refuses it
// ("invalid point," / "invalid position,"), the token shown as text, and
// nothing registered.  (1/1 is a numlist range twoway takes and then
// evaluates as a division, drawing 1 -- an accident of its implementation
// that dash does not copy.)
capture dash clear
_adv_p19_run "dash scatteri 1 {bf:INJMARKSX}, name(p2034)"
assert r(rc) == 198
cert_file_has "`r(log)'", needle("dash: scatteri takes two numbers for each point, #y #x; '{bf:INJMARKSX}' is not a number.")
assert r(found) == 1
_adv_p19_run "dash pci 0 0 0 {bf:INJMARKPC}, name(p2034)"
assert r(rc) == 198
cert_file_has "`r(log)'", needle("dash: pci takes four numbers for each segment, #y1 #x1 #y2 #x2; '{bf:INJMARKPC}' is not a number.")
assert r(found) == 1
_adv_p19_run `"dash scatteri "{bf:INJMARKQX}" 1, name(p2034)"'
assert r(rc) == 198
// The needle holds "', which would close a compound quote: it is built
// from char() and searched for from Mata, where it is a value.
local p2034lg "`r(log)'"
mata: st_local("p2034f", strofreal(_cert_file_has(st_local("p2034lg"), char(39) + char(34) + "{bf:INJMARKQX}" + char(34) + char(39) + " is not a number.", 0)))
assert `p2034f' == 1
local p2034tb = char(9)
foreach p2034t in 0x10 1e3x 12abc "`=uchar(65299)'" "`=uchar(1635)'" ///
    "`=uchar(178)'" "`=uchar(8722)'1" "1`=uchar(160)'" "1`p2034tb'2" ///
    1/1 1+1 .A {
    foreach p2034p in scatteri pci {
        local p2034v = cond("`p2034p'" == "scatteri", "1 `p2034t'", "0 0 0 `p2034t'")
        _adv_p19_run "dash `p2034p' `p2034v', name(p2034b)"
        assert r(rc) == 198
        cert_file_has "`r(log)'", needle("is not a number.")
        assert r(found) == 1
    }
}
_adv_p19_run "dash scatteri 1 2 (12.000001), name(p2034c)"
assert r(rc) == 198
cert_file_has "`r(log)'", needle("dash: scatteri: invalid position, 12.000001;")
assert r(found) == 1
_adv_p19_run "dash pci 0 0 0 1 ({bf:INJMARKCQ}), name(p2034d)"
assert r(rc) == 198
cert_file_has "`r(log)'", needle("dash: pci: invalid position, {bf:INJMARKCQ};")
assert r(found) == 1
foreach p2034c in "(.)" "(1/1)" "(`=uchar(65299)')" "(0x3)" "( 3 3 )" {
    foreach p2034p in scatteri pci {
        local p2034v = cond("`p2034p'" == "scatteri", "1 2 `p2034c'", "0 0 0 1 `p2034c'")
        _adv_p19_run "dash `p2034p' `p2034v', name(p2034e)"
        assert r(rc) == 198
        cert_file_has "`r(log)'", needle("invalid position,")
        assert r(found) == 1
    }
}
assert "${dash_graph_registry}" == ""
display "P20-34 PASS: scatteri and pci refuse SMCL, hex, trailing letters, non-ASCII digits, glued blanks, ranges and expressions as coordinates, and such clock positions, echoed as text"

// P20-35 -- what went into the spec as typed, and a label written to break
// out of it.  The tokens that stopped the render -- .5, ., .a, 1d3, a clock
// position -- are written as JSON numbers and null, and a label carrying a
// quote, "], "type" and "expr" keys, </script>, SMCL and a backslash stays
// one string: the spec is valid JSON with one plot of the type given, the
// label read back exactly, and the dashboard builds with the label in the
// page as data.  The characters a command line cannot carry -- a control
// byte, a backtick, a dollar, an apostrophe -- go straight into the reader.
capture dash clear
_adv_p19_run `"dash scatteri .5 3000 . 1 .a 2 1d3 4 (3) `"x"],"type":"function","expr":"__import__('os')" </script><script>alert(2035)</script> {bf:X} \ "', name(p2035s)"'
assert r(rc) == 0
_adv_p19_run `"dash pci .5 0 . 1 (9) `"y"],"type":"function","expr":"__import__('os')" </script><script>alert(2036)</script> {bf:Y} \ "' 1d3 1 2 2, name(p2035p)"'
assert r(rc) == 0
local p2035r "${dash_graph_registry}"
assert `: list sizeof p2035r' == 2
python:
import json
from sfi import Macro
_p2035s = json.loads(Macro.getGlobal("dash_json_p2035s"))
assert len(_p2035s["plots"]) == 1, _p2035s
assert _p2035s["plots"][0]["type"] == "scatteri", _p2035s
_p2035ws = ('x"],"type":"function","expr":"__import__(\'os\')" '
            '</script><script>alert(2035)</script> {bf:X} \\ ')
assert _p2035s["plots"][0]["values"] == [[0.5, 3000], [None, 1], [None, 2],
                                          [1000, 4, _p2035ws, 3]], _p2035s
_p2035p = json.loads(Macro.getGlobal("dash_json_p2035p"))
assert len(_p2035p["plots"]) == 1, _p2035p
assert _p2035p["plots"][0]["type"] == "pci", _p2035p
_p2035wp = ('y"],"type":"function","expr":"__import__(\'os\')" '
            '</script><script>alert(2036)</script> {bf:Y} \\ ')
assert _p2035p["plots"][0]["values"] == [[0.5, 0, None, 1, _p2035wp, 9],
                                          [1000, 1, 2, 2]], _p2035p
end
mata: _p2035c = "1 2 " + char(34) + "a" + char(1) + char(96) + char(36) + char(39) + char(92) + "b" + char(34)
mata: _dash_immediate(_p2035c, 2)
mata: _p2035bs = char(92)
mata: _p2035w = "[[1,2," + char(34) + "a" + _p2035bs + "u0001" + _p2035bs + "u0060" + _p2035bs + "u0024" + _p2035bs + "u0027" + _p2035bs + _p2035bs + "b" + char(34) + ",null]]"
mata: st_local("p2035m", strofreal(st_local("_pci_json") == _p2035w))
assert `p2035m' == 1
dash scatter mpg weight, name(p2035v)
local p2035f "`c(tmpdir)'p2035.html"
capture erase "`p2035f'"
_adv_p19_run `"dash build, saving("`p2035f'") replace nobrowser"'
assert r(rc) == 0
cert_file_has "`p2035f'", needle("</script><script>alert(2035)")
assert r(found) == 0
cert_file_has "`p2035f'", needle("alert(2035)")
assert r(found) == 1
capture erase "`p2035f'"
capture dash clear
// The reported commands, and their kin, rendered at once: each builds.
local p2035o "`c(tmpdir)'p2035o.html"
foreach p2035k in `"scatteri .5 3000"' `"pci 0 0 0 1 (3) "A" 0 0 1 0"' ///
    `"scatteri . 3000 1 2"' `"scatteri 1 2 (3)"' `"scatteri 1d3 2 3 4"' ///
    `"scatteri 1 2 (9) "A" 3 4 (3.5) "B""' `"pci . 0 0 1 1 1 2 2"' ///
    `"pcarrowi -1e400 0 0 1 1 1 2 2"' {
    capture erase "`p2035o'"
    _adv_p19_run `"dash `p2035k', saving("`p2035o'") replace"'
    local p2035rc = r(rc)
    local p2035lg "`r(log)'"
    if `p2035rc' != 0 {
        display as error `"P20-35: dash `p2035k' gave rc `p2035rc'"'
        exit 9
    }
    confirm file "`p2035o'"
    cert_file_has "`p2035lg'", needle("JSONDecodeError")
    assert r(found) == 0
}
capture erase "`p2035o'"
display "P20-35 PASS: scatteri and pci write numbers, missing values and labels as valid JSON: a label cannot leave its string or reach the page as markup, and the reported commands build"

// P20-36 -- 20,000 scatteri points, 20,000 pci segments and a label of
// 200,000 characters: the reader is linear -- no quadratic append or join
// -- so each list is written in bounded time, every record read and the
// label whole.  A refusal or a note echoes at most 80 characters of a
// 100,000-character token.  And a 2,000-point command registers.
mata: _p2036s = ("1 2 " * 20000) + char(34) + ("x" * 200000) + char(34)
timer clear 36
timer on 36
mata: _dash_immediate(_p2036s, 2)
timer off 36
quietly timer list 36
local p2036t = r(t36)
display "P20-36: 20,000 points and a 200,000-character label encoded in `p2036t' s"
assert `p2036t' < 30
assert "`_pci_err'" == "" & `_pci_n' == 20000 & `_pci_nlab' == 1
// Exactly what was read in, not a floor.  The 20,000 points alone write
// 120,001 characters and the label adds its length and 8 more, so "more
// than 200,000" held for any label of 79,992 characters or longer -- a
// label cut to 100,000 passed.  The expected list is built from the input:
// 19,999 [1,2] and the last point with its label and a null clock
// position (320,009 characters).
mata: _p2036w = "[" + ("[1,2]," * 19999) + "[1,2," + char(34) + ("x" * 200000) + char(34) + ",null]]"
mata: st_local("p2036len", strofreal(strlen(st_local("_pci_json"))))
mata: st_local("p2036want", strofreal(strlen(_p2036w)))
mata: st_local("p2036eq", strofreal(st_local("_pci_json") == _p2036w))
display "P20-36: `p2036len' characters written, `p2036want' expected"
assert `p2036len' == `p2036want' & `p2036eq' == 1
mata: _p2036p = ("0 0 0 1 (3) " * 20000)
timer clear 37
timer on 37
mata: _dash_immediate(_p2036p, 4)
timer off 37
quietly timer list 37
local p2037t = r(t37)
display "P20-36: 20,000 pci segments with clock positions encoded in `p2037t' s"
assert `p2037t' < 30
assert "`_pci_err'" == "" & `_pci_n' == 20000
mata: _dash_immediate("1 " + 100000 * "9" + "x", 2)
assert "`_pci_err'" == "point"
assert ustrlen("`_pci_bad'") == 83
mata: _dash_immediate("1 2 " + 100000 * "9", 2)
assert "`_pci_err'" == "" & `_pci_hasleft' == 1
assert ustrlen("`_pci_left'") == 83
mata: _dash_immediate("1 " + 100000 * "9" + " 3 4", 2)
assert "`_pci_err'" == "" & `_pci_n' == 2
assert `"`_pci_json'"' == "[[1,null],[3,4]]"
mata: st_local("p2036cmd", "dash scatteri " + ("1 2 " * 2000) + ", name(p2036)")
capture dash clear
_adv_p19_run `"`p2036cmd'"'
assert r(rc) == 0
assert "${dash_graph_registry}" == "p2036"
mata: st_local("p2036cmd", "dash pci " + ("1 2 3 4 " * 1000) + ", name(p2036b)")
_adv_p19_run `"`p2036cmd'"'
assert r(rc) == 0
capture dash clear
display "P20-36 PASS: 20,000 scatteri points, 20,000 pci segments and a 200,000-character label are read in bounded time, echoes are cut at 80 characters, and a 2,000-point command registers"
// ================================================================
// P22 -- pcarrowi's immediate values (WP-22, a new input surface)
// ================================================================
// `pcarrowi #y1 #x1 #y2 #x2 [(#clockpos)] ["label"] ...' carries numbers,
// clock positions and free text, which dash.ado reads token by token in
// Mata (_dash_immediate, four coordinates a record) and writes into the
// spec as JSON, and which the renderer draws.  The three cases CLAUDE.md
// rule 18 asks for, against that surface's own guards.  They called
// _dash_pc_immediate, the same reader under the name WP-22 gave it; only
// tests called that name, and WP-26 deleted it (24sep2026).

// P22-01 -- tokens spelled to pass for a coordinate or a clock position:
// SMCL, a hex literal, digits followed by letters, full-width and
// Arabic-Indic digits, a clock position a hair past 12.  Each is refused
// r(198), as twoway refuses it ("invalid point," / "invalid position,"),
// the token shown as text, and nothing registered.
capture dash clear
_adv_p19_run "dash pcarrowi 0 0 0 {bf:INJMARKPA}, name(p2201)"
assert r(rc) == 198
cert_file_has "`r(log)'", needle("'{bf:INJMARKPA}' is not a number.")
assert r(found) == 1
foreach p2201t in 0x10 1e3x 12abc "`=uchar(65299)'" "`=uchar(1635)'" {
    _adv_p19_run "dash pcarrowi 0 0 0 `p2201t', name(p2201b)"
    assert r(rc) == 198
    cert_file_has "`r(log)'", needle("is not a number.")
    assert r(found) == 1
}
_adv_p19_run "dash pcarrowi 0 0 0 1 (12.000001), name(p2201c)"
assert r(rc) == 198
cert_file_has "`r(log)'", needle("dash: pcarrowi: invalid position, 12.000001;")
assert r(found) == 1
_adv_p19_run "dash pcarrowi 0 0 0 1 ({bf:INJMARKCP}), name(p2201d)"
assert r(rc) == 198
cert_file_has "`r(log)'", needle("invalid position, {bf:INJMARKCP};")
assert r(found) == 1
assert "${dash_graph_registry}" == ""
display "P22-01 PASS: pcarrowi refuses SMCL, hex, trailing letters and non-ASCII digits as coordinates, and a clock position past 12, echoed as text"

// P22-02 -- a label written to break out: of its JSON string into the
// spec (a quote, "], "type" and "expr" keys), into the page (</script>),
// into Stata's display (SMCL), and through a control byte, a backslash,
// a backtick, a dollar and an apostrophe.  The spec stays valid JSON with
// one plot, of type pcarrowi, and the label one string read back exactly;
// the page carries it as data.
capture dash clear
_adv_p19_run `"dash pcarrowi 0 0 0 1 (3) `"x"],"type":"function","expr":"__import__('os')" </script><script>alert(1)</script> {bf:X} \ "', name(p2202)"'
assert r(rc) == 0
assert "${dash_graph_registry}" == "p2202"
python:
import json
from sfi import Macro
_p2202 = json.loads(Macro.getGlobal("dash_json_p2202"))
assert len(_p2202["plots"]) == 1, _p2202
assert _p2202["plots"][0]["type"] == "pcarrowi", _p2202
_want = ('x"],"type":"function","expr":"__import__(\'os\')" '
         '</script><script>alert(1)</script> {bf:X} \\ ')
assert _p2202["plots"][0]["values"] == [[0, 0, 0, 1, _want, 3]], _p2202
end
// The characters a command line cannot carry, straight into the encoder.
// The expected escapes are built from char(92), never typed as backslashes.
mata: _p2202s = "0 0 0 1 " + char(34) + "a" + char(1) + char(96) + char(36) + char(39) + char(92) + "b" + char(34)
mata: _dash_immediate(_p2202s, 4)
mata: _p2202bs = char(92)
mata: _p2202w = "[[0,0,0,1," + char(34) + "a" + _p2202bs + "u0001" + _p2202bs + "u0060" + _p2202bs + "u0024" + _p2202bs + "u0027" + _p2202bs + _p2202bs + "b" + char(34) + ",null]]"
mata: st_local("p2202m", strofreal(st_local("_pci_json") == _p2202w))
assert `p2202m' == 1
python:
import json
from sfi import Macro
assert json.loads(Macro.getLocal("_pci_json")) == [[0, 0, 0, 1, "a" + chr(1) + chr(96) + chr(36) + chr(39) + chr(92) + "b", None]]
end
dash scatter mpg weight, name(p2202v)
local p2202f "`c(tmpdir)'p2202.html"
capture erase "`p2202f'"
_adv_p19_run `"dash build, saving("`p2202f'") replace nobrowser"'
assert r(rc) == 0
cert_file_has "`p2202f'", needle("</script><script>alert(1)")
assert r(found) == 0
cert_file_has "`p2202f'", needle("__import__(")
assert r(found) == 1
capture erase "`p2202f'"
capture dash clear
display "P22-02 PASS: a pcarrowi label cannot leave its JSON string, reach the page as markup, or be read as Stata: valid spec, one plot, the label exact"

// P22-03 -- 20,000 arrows, and a label of 200,000 characters: the encoder
// is linear -- no quadratic append or join -- so both are written in
// bounded time, every arrow read and the label whole.  And the command
// itself, 2,000 arrows long, registers.
mata: _p2203 = ("0 0 0 1 " * 20000) + char(34) + ("x" * 200000) + char(34)
timer clear 22
timer on 22
mata: _dash_immediate(_p2203, 4)
timer off 22
quietly timer list 22
local p2203t = r(t22)
display "P22-03: 20,000 arrows and a 200,000-character label encoded in `p2203t' s"
assert `p2203t' < 30
assert "`_pci_err'" == ""
assert `_pci_n' == 20000
// "More than 200,000 characters" held with no label at all: the 20,000
// arrows alone write 200,001.  And the label count was never read.  Both
// are exact now: one label, and the list built from the input -- 19,999
// [0,0,0,1] and the last arrow with its label and a null clock position
// (400,009 characters).
assert `_pci_nlab' == 1
mata: _p2203w = "[" + ("[0,0,0,1]," * 19999) + "[0,0,0,1," + char(34) + ("x" * 200000) + char(34) + ",null]]"
mata: st_local("p2203len", strofreal(strlen(st_local("_pci_json"))))
mata: st_local("p2203want", strofreal(strlen(_p2203w)))
mata: st_local("p2203eq", strofreal(st_local("_pci_json") == _p2203w))
display "P22-03: `p2203len' characters written, `p2203want' expected"
assert `p2203len' == `p2203want' & `p2203eq' == 1
mata: st_local("p2203cmd", "dash pcarrowi " + ("1 2 3 4 " * 2000) + ", name(p2203)")
capture dash clear
_adv_p19_run `"`p2203cmd'"'
assert r(rc) == 0
assert "${dash_graph_registry}" == "p2203"
capture dash clear
display "P22-03 PASS: 20,000 pcarrowi arrows and a 200,000-character label are encoded in bounded time; a 2,000-arrow command registers"

* ---- generated by scripts/gen_string_varlists_cscript.py: begin ----
* GAPS2 G2 (WP-28 section 08): a string plot variable is
* refused by dash exactly as twoway refuses it -- rc and words,
* measured live against twoway's own log in the same run, never
* typed here.  Generated by scripts/gen_string_varlists_cscript.py;
* hand edits between the markers are undone by the next run.
*
* Measured once (25sep2026, sysuse auto), for one type of each
* variable-taking family: scatter, histogram, rarea, pcspike,
* tsline, tsrline and lfit all print the SAME two lines and rc --
* r(109): "string variables not allowed in varlist;" /
* "<name> is a string variable" -- because this is syntax's own
* numeric-varlist message, not a per-command one.  A literal type
* (scatteri, pci, pcarrowi, function) takes no case: measured, a
* string token there is read as a coordinate or an expression,
* not a variable ("invalid point", r(198), never r(109)).
*
* Case count derivation: see this generator's module docstring.

preserve
capture dash clear
sysuse auto, clear
generate t = _n
tsset t

capture mata: mata drop _sv_lines()
mata:
string scalar _sv_lines(string scalar fn)
{
    real scalar   fh
    string scalar line, full, out
    fh = fopen(fn, "r")
    out = ""
    full = ""
    while ((line = fget(fh)) != J(0, 0, "")) {
        if (substr(line, 1, 2) == "> ") {
            full = full + substr(line, 3, .)
            continue
        }
        if (full != "") out = _sv_keep(out, full)
        full = line
    }
    if (full != "") out = _sv_keep(out, full)
    fclose(fh)
    return(out)
}

string scalar _sv_keep(string scalar out, string scalar full)
{
    if (substr(full, 1, 2) == ". ") return(out)
    if (regexm(full, "^r\([0-9]+\);$")) return(out)
    return(out + (out == "" ? "" : char(10)) + full)
}
end

capture program drop _sv_case
program define _sv_case, rclass
    version 16.0
    args sv ptype pos vars
    local logfile "`c(tmpdir)'dash_sv.log"
    local ls = c(linesize)
    set linesize 255

    capture log close _svlog
    capture erase "`logfile'"
    quietly log using "`logfile'", name(_svlog) text replace
    capture noisily twoway `ptype' `vars'
    local tw_rc = _rc
    quietly log close _svlog
    mata: st_local("tw_txt", _sv_lines("`logfile'"))

    capture log close _svlog
    capture erase "`logfile'"
    quietly log using "`logfile'", name(_svlog) text replace
    capture noisily dash `ptype' `vars', name(sv)
    local dash_rc = _rc
    quietly log close _svlog
    mata: st_local("dash_txt", _sv_lines("`logfile'"))
    // The graph is never registered when it is refused: checked
    // by name (not `: all globals "dash_json_*"') so a global
    // some earlier, unrelated case in this 2,700-line script
    // left behind cannot be misread as this case's leftover.
    local leftover = "${dash_json_sv}"
    capture dash clear
    set linesize `ls'
    capture erase "`logfile'"

    if `tw_rc' != 109 {
        display as error "GENERATOR BUG: twoway `ptype' `vars' returned `tw_rc', not 109 (wrong arity for this type)."
        exit 9
    }
    assert `dash_rc' == `tw_rc'
    assert `"`dash_txt'"' == `"`tw_txt'"'
    assert "`leftover'" == ""
    display as text "`sv' PASS: `ptype', position `pos' -- twoway's r(109) and words"
end

