* ---- generated by scripts/gen_string_varlists_cscript.py: end ----

* ==== S08 G3: data limit (DL-01..DL-06) ====
// The saved page's cells limit counts what it embeds: a histogram alone
// (bin(10): 4 x 10 = 40 values) passes at dash_max_cells 70, where 74
// observations x 1 variable (74) would have refused it; a scatter (74 x
// 2 = 148) is still refused, byte for byte as P19-11 shows it, and a
// filter, link(), csv or hover() that reaches the histogram makes it
// count its own row again.  All on sysuse auto (74 obs); no fixture, no
// git add -f -- these numbers are measured live in this run, against
// dash's own arithmetic, not typed in twice.
preserve
capture dash clear
sysuse auto, clear

global dash_max_cells 70
tempfile dl1
local dl1f "`dl1'.html"
capture erase "`dl1f'"
_adv_p19_run `"dash histogram price, bin(10) saving("`dl1f'")"'
assert r(rc) == 0
confirm file "`dl1f'"
dash clear
display "DL-01 PASS: a histogram's own drawn output (40 values) passes dash_max_cells 70, where 74 observations x 1 variable would not"

tempfile dl2
local dl2f "`dl2'.html"
capture erase "`dl2f'"
_adv_p19_run `"dash scatter mpg price, saving("`dl2f'")"'
assert r(rc) == 134
local lg "`r(log)'"
cert_file_has "`lg'", needle("dash: this dashboard would embed 148 values (74 observations x 2 variables), more than the 70 dash embeds.")
assert r(found) == 1
cert_file_has "`lg'", needle("Reduce the data in memory first (keep, drop, sample or collapse, inside preserve/restore), or set global dash_max_cells to a higher value (at most 20,000,000).")
assert r(found) == 1
mata: st_local("dl2n", strofreal(rows(cat("`lg'"))))
assert `dl2n' == 2
capture confirm file "`dl2f'"
assert _rc != 0
dash clear
display "DL-02 PASS: a row-drawing scatter (148 values) is still refused at dash_max_cells 70, the two lines byte-identical to P19-11's shape"

// DL-03: the named route -- a filter, link(), csv or hover() that
// reaches the lone histogram graph makes it count its own row.
tempfile dl3
local dl3f "`dl3'.html"
dash histogram price, bin(10) name(h1)
capture erase "`dl3f'"
_adv_p19_run `"dash build, saving("`dl3f'") replace nobrowser"'
assert r(rc) == 0
confirm file "`dl3f'"
display "DL-03a PASS: the named route builds h1 alone at dash_max_cells 70 (40 values)"

capture erase "`dl3f'"
_adv_p19_run `"dash build, saving("`dl3f'") replace nobrowser filter(foreign, type(dropdown))"'
assert r(rc) == 134
cert_file_has "`r(log)'", needle("dash: this dashboard would embed 148 values (74 observations x 2 variables), more than the 70 dash embeds.")
assert r(found) == 1
display "DL-03b PASS: filter() with no exclude() reaches h1 -- 74 observations x 2 variables (price, foreign)"

capture erase "`dl3f'"
_adv_p19_run `"dash build, saving("`dl3f'") replace nobrowser link(_all)"'
assert r(rc) == 134
cert_file_has "`r(log)'", needle("dash: this dashboard would embed 74 values (74 observations x 1 variable), more than the 70 dash embeds.")
assert r(found) == 1
display "DL-03c PASS: link(_all) reaches the lone graph -- its own row counts again"

capture erase "`dl3f'"
_adv_p19_run `"dash build, saving("`dl3f'") replace nobrowser csv"'
assert r(rc) == 134
cert_file_has "`r(log)'", needle("dash: this dashboard would embed 74 values (74 observations x 1 variable), more than the 70 dash embeds.")
assert r(found) == 1
display "DL-03d PASS: csv reaches the lone graph the same way"

dash clear
dash histogram price, bin(10) hover(foreign) name(h1)
capture erase "`dl3f'"
_adv_p19_run `"dash build, saving("`dl3f'") replace nobrowser"'
assert r(rc) == 134
cert_file_has "`r(log)'", needle("dash: this dashboard would embed 74 values (74 observations x 1 variable), more than the 70 dash embeds.")
assert r(found) == 1
display "DL-03e PASS: hover() reaches the graph too; the hover variable itself is not exported and does not inflate the count"

// DL-04: a KPI beside the untouched histogram always counts its own
// variable, and h1's own bars still add their drawn cells beside it --
// the two parts of TR-08.7's "both" message form.
dash clear
dash histogram price, bin(10) name(h1)
dash kpi mean(price), name(k1) title(T)
tempfile dl4
local dl4f "`dl4'.html"
capture erase "`dl4f'"
_adv_p19_run `"dash build, saving("`dl4f'") replace nobrowser"'
assert r(rc) == 134
cert_file_has "`r(log)'", needle("dash: this dashboard would embed 114 values (74 observations x 1 variable, and 40 values of computed layers), more than the 70 dash embeds.")
assert r(found) == 1
display "DL-04 PASS: a KPI's own variable (74 observations x 1 variable) and h1's own bars (40 values of computed layers) both count, 114 in all"

// DL-05: a served app always embeds every observation of every variable,
// and says so.
dash clear
dash histogram price, bin(10) name(h1)
tempfile dl5
local dl5f "`dl5'.py"
capture erase "`dl5f'"
_adv_p19_run `"dash build, server saving("`dl5f'") replace nobrowser"'
assert r(rc) == 134
local lg "`r(log)'"
cert_file_has "`lg'", needle("dash: this dashboard would embed 74 values (74 observations x 1 variable), more than the 70 dash embeds.")
assert r(found) == 1
cert_file_has "`lg'", needle("A served app embeds every observation of every variable it uses.")
assert r(found) == 1
capture confirm file "`dl5f'"
assert _rc != 0
display "DL-05 PASS: dash build, server counts every observation of every variable and says a served app always does"

// DL-06: a lower limit that the histogram's own drawn output still
// crosses names the drawn output, not a row x column shape.
dash clear
global dash_max_cells 30
dash histogram price, bin(10) name(h1)
tempfile dl6
local dl6f "`dl6'.html"
capture erase "`dl6f'"
_adv_p19_run `"dash build, saving("`dl6f'") replace nobrowser"'
assert r(rc) == 134
cert_file_has "`r(log)'", needle("dash: this dashboard would embed 40 values (the drawn output of its computed layers), more than the 30 dash embeds.")
assert r(found) == 1
capture confirm file "`dl6f'"
assert _rc != 0
display "DL-06 PASS: a computed-only graph over the limit names the drawn output, not a row x column shape"

macro drop dash_max_cells
capture dash clear
restore
* ==== end S08 ====

capture dash clear
capture erase "`c(tmpdir)'dash_adv_p19.log"

// ================================================================
// Final summary
// ================================================================
display ""
display "All adversarial security tests PASSED."
display "  P2-78: XSS in title → HTML-escaped in output"
display "  P2-79: Injection chars in varname → Mata rejects"
display "  P2-80: Path traversal in saving() → rc=198"
display "  P2-81: Python injection in option value → literal, no OS call"
display "  P2-82: Resource exhaustion (100 bogus vars) → graceful error"
display "  P2-83: Stack overflow (50-level nested parens) → graceful error"
display "  P2-84: JS injection in filter varname → invalid varname rejected"
display "  P4-84: Port value with semicolon → rejected by integer regex"
display "  P4-85: XSS in KPI title (server mode) → HTML-escaped in .py"
display "  P4-86: Data/label with injection chars → .py compiles"
display "  P8-86..88: Malformed UTF-8 in build/KPI/tabs titles → rc=198"
display "  P8-89: Control byte in title() → escaped and built, not r(7102)"
display "  P9-01..03: Code in a number-only option value → rc=198 naming it"
display "  P9-04: Backtick in n() → refused by Stata's own line parser, nothing registered"
display "  P9-06..10: Resource-exhaustion counts and sizes → rc=198 naming the option"
display "  P9-11..14: Code in KPI fmt() → rc=198 naming fmt(), no KPI registered"
display "  P19-01..05: Registry cap (dash_max_graphs) → rc=134 for a new name; replace and dash clear still work"
display "  P19-06..10: Plot cap (dash_max_plots) → rc=134, each y variable counted, nothing registered or written"
display "  P19-11..13: Cell cap (dash_max_cells) → rc=134 before export on both routes, data and formats unchanged"
display "  P19-14..16: build_options.limits carries only the set limits; dash clear keeps them"
display "  P19-17..21: Hostile dash_max_* values → rc=198 on every route, echo reduced to safe characters"
display "  P19-22: Message helpers — separators past 10^12, singular variable"
display "  P19-23: Default cell cap at scale — 5,200,000 values refused, 5,000,000 admitted"
display "  P19-24..26: A refused filter, graph or KPI name → echoed as text, never as SMCL"
display "  P19-27..30: Byte cap (dash_max_bytes) → rc=134 before export on every route; strL text counted"
display "  P20-01..13: Every other echo of user text (option values, plot type, link, exclude, theme, fmt, port, timeout, saving) → shown as text, never as SMCL"
display "  P20-14, 19: port()/timeout() → digits only (no trailing newline), timeout() at most nine digits"
display "  P20-15..18: Overlong UTF-8, saving() spellings, a layout() backslash, a quote breakout → refused or escaped"
display "  P20-20..21: A 600-operator if qualifier and a 5,000-character name() → bounded, no traceback"
display "  P20-22..23: dash_setup package names and versions → never code, judged in bounded time"
display "  P20-24: EXCLUDE() in any case → the same registry check as exclude()"
display "  P20-25: A layout() grid larger than the graphs limit → rc=198, not gigabytes of padding"
display "  P20-26: port() bounds and spellings (sign, decimal, hex, full-width digits) → rc=198"
display "  P20-27: KPI stat(var) outside its allow-list (case, p0, p100, p97.5.5, p1e2, trailing text) → refused"
display "  P20-28: Malformed UTF-8 inside the data (string value, variable and value labels) → rendered"
display "  P20-29: A scatteri coordinate and the .gph note → shown as text; the note runs no directive"
display "  P20-30: layout() not one of its forms whole, an unregistered name, a Bootstrap span outside 1..12 → rc=198"
display "  P20-31: layout() placing a name twice (bs or name:row,col) → rc=198"
display "  P20-32: A graph or KPI name holding __ (dash's own, as in g1__by__0) → rc=198"
display "  P20-33: name(g1, replace) in any spelling, with by(), on a new name -> stored as g1, placed, tabbed, linked and excluded as g1"
display "  P20-34: scatteri and pci coordinates and clock positions spelled to pass (SMCL, hex, non-ASCII digits, glued blanks, ranges) -> rc=198, echoed as text"
display "  P20-35: scatteri and pci values that broke the spec, and a label carrying JSON, </script>, SMCL and control bytes -> valid spec, the label exact, the page builds"
display "  P20-36: 20,000 scatteri points, 20,000 pci segments and a 200,000-character label -> read in bounded time, echoes cut at 80 characters"
display "  P22-01: pcarrowi coordinates and clock positions spelled to pass (SMCL, hex, non-ASCII digits, 12.000001) -> rc=198, echoed as text"
display "  P22-02: A pcarrowi label carrying JSON, </script>, SMCL and control bytes -> valid spec, one plot, the label exact, data in the page"
display "  P22-03: 20,000 pcarrowi arrows and a 200,000-character label -> encoded in bounded time"
display "  SV-01..SV-87: every plot type and variable position that takes one -> a string variable refused with twoway's own r(109) and words"
display "  DL-01..DL-06: a computed-only graph's drawn output, not its rows, counts against the cells limit; a filter, link(), csv or hover() reaches it again; a served app always embeds every row"
