*! test_wp33_truth.cscript
*! WP-33's ONE certification script (.ultraplan/sections/index.md PD-6):
*! every comparison with twoway's drawing or with Stata's own values that
*! WP-33's sections need lives here, one block per GAPS4 row (or per
*! harness tool), appended above the "append new blocks above this line"
*! marker in section order.  Refusal, message and return-code checks join
*! the EXISTING script for their area (merge rule R1).
*!
*! Made from test/templates/wp_truth_template.cscript (33 -> the WP's
*! number).  S00 is the scaffold smoke (Q3300-1).  A section appends
*! `* ==== S<MM> <lead id>: <what> ====` ... `* ==== end S<MM> ====` (or
*! `S<MM> tool: <what>` for a section with no item), its helper programs
*! directly above its first header, and writes only inside its own
*! blocks.  Case ids are Q33<MM>-<k> (PD-5).
*!
*! Usage: via run_all_cscripts.do.  One block alone: WP33_ONLY=S<MM> in
*! the driver's environment.  Each block prints "S<MM> start" and "S<MM>
*! end" with the date and time.  Its row in run_all_cscripts.do's shard
*! table is `*' when the script is long enough to split
*! (scripts/cert_shards.py's rule), else a shard number, and then the
*! session that runs it runs every block; under a `*' row
*! DASH_CERT_SHARD=k/N runs part k of N of the blocks, and a part with no
*! block ends 0.  A new WP's row: `python3 scripts/cert_shards.py add
*! test_wpNN_truth.cscript'.

cscript "WP-33 truth: twoway comparisons" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off


do "cert_helpers.do"
quietly do "cert_svg.do"
qui run "../dash_parse.mata"
qui run "../dash.ado"
global dash_nobrowser 1

// ----------------------------------------------------------------
// Tally helpers -- test_wp29_truth.cscript's _w29_expect/_w29_done,
// renamed _w33_ for this script.  A case is any number of
// _w33_expect lines closed by one _w33_done.
// ----------------------------------------------------------------
global w33_nfail    = 0
global w33_faillist ""
global w33_bad      = 0
global w33_ncase    = 0

capture program drop _w33_expect
program define _w33_expect
    version 19
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global w33_bad = 1
    }
end

capture program drop _w33_done
program define _w33_done
    version 19
    args id msg
    if ${w33_bad} {
        global w33_nfail    = ${w33_nfail} + 1
        global w33_faillist "${w33_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global w33_bad   = 0
    global w33_ncase = ${w33_ncase} + 1
end

// A fresh directory for this run's files, never one that already exists:
// a fixed name in a shared temp directory could be planted by another
// account (rule 1), so a name Stata has not handed out before is made and
// the run fails if it cannot be.  Every block writes only under it.
tempfile w33_base
local w33_work "`w33_base'_w33"
capture mkdir "`w33_work'"
if _rc {
    display as error "test_wp33_truth: cannot create the work directory `w33_work' (rc `=_rc')"
    exit 9
}

// ---- parts: begin (WP-33 test performance) ----
// Its row in run_all_cscripts.do's shard table is "*" when the script is
// long enough to split (scripts/cert_shards.py's rule), else a shard
// number, and then the session that runs it runs every block
// (_w33_whole reads the row).  Under a "*" row, with
// DASH_CERT_SHARD=k/N set, the session runs part k of N of the blocks.
// The parts are balanced longest first onto the least loaded part (the
// lowest numbered of equals), by the blocks' seconds -- a block not listed
// counts 1 s (section-01 D-01.f) -- the rule scripts/cert_shards.py uses
// for the scripts.  Unset, or with WP33_ONLY set
// (which keeps its precedence), every block runs.  A block runs when its
// gate finds its id in w33_run.
// Seconds: the runner's block seconds line for this script (secs
// test_wp33_truth.cscript S00 1 ..., after the shard table), where
// cert_shards.py write puts each block's start/end lines of a measured
// certification run, rounded up, at least 1; no line: S00 1.
capture mata: mata drop _w33_part()
capture mata: mata drop _w33_whole()
capture mata: mata drop _w33_secs()
mata:
// 1 when the runner's shard table gives the script a shard number for n
// sessions (its row's word n + 2), so that it runs whole; 0 for "*" or
// "*r", no runner, no table or no row (the script then splits).
real scalar _w33_whole(string scalar runner, string scalar script,
                       real scalar n)
{
    string colvector l
    string rowvector t
    real scalar i, inside

    if (n < 2 | !fileexists(runner)) return(0)
    l = cat(runner)
    inside = 0
    for (i = 1; i <= rows(l); i++) {
        if (strpos(l[i], "// ---- shards: begin") == 1) inside = 1
        else if (strpos(l[i], "// ---- shards: end") == 1) inside = 0
        else if (inside) {
            t = tokens(l[i])
            if (cols(t) < n + 2) continue
            if (t[1] != script) continue
            return(ustrregexm(t[n + 2], "^[0-9]+$"))
        }
    }
    return(0)
}
// The blocks' seconds, "S00 1 S01 12 ...", from the runner's
// block seconds line for the script; none (or no runner): "S00 1".
string scalar _w33_secs(string scalar runner, string scalar script)
{
    string colvector l
    string rowvector t
    real scalar i

    if (!fileexists(runner)) return("S00 1")
    l = cat(runner)
    for (i = 1; i <= rows(l); i++) {
        t = tokens(l[i])
        if (cols(t) < 5) continue
        if (t[1] == "//" & t[2] == "secs" & t[3] == script) {
            return(invtokens(t[|4 \ cols(t)|]))
        }
    }
    return("S00 1")
}
end
mata: st_local("w33_secs", _w33_secs("run_all_cscripts.do", "test_wp33_truth.cscript"))
local w33_sh : environment DASH_CERT_SHARD
mata: st_local("w33_ok", strofreal(st_local("w33_sh") == "" | ustrregexm(st_local("w33_sh"), "^[1-8]/[1-8]$")))
if !`w33_ok' {
    display as error "test_wp33_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 8"
    exit 198
}
local w33_k 1
local w33_N 1
if "`w33_sh'" != "" {
    local w33_k = real(substr("`w33_sh'", 1, 1))
    local w33_N = real(substr("`w33_sh'", 3, 1))
}
local w33_only : env WP33_ONLY
if `"`macval(w33_only)'"' != "" | `w33_N' == 1 {
    local w33_k 1
    local w33_N 1
}
if `w33_k' > `w33_N' {
    display as error "test_wp33_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 8"
    exit 198
}
// A shard number in its row: the runner runs the script only in that
// shard's session, so the session runs every block.
local w33_how ""
if `w33_N' > 1 {
    mata: st_local("w33_whole", strofreal(_w33_whole("run_all_cscripts.do", "test_wp33_truth.cscript", `w33_N')))
    if `w33_whole' {
        local w33_how " whole (shard `w33_k'/`w33_N')"
        local w33_k 1
        local w33_N 1
    }
}
capture confirm file "test_wp33_truth.cscript"
if _rc {
    display as error "test_wp33_truth: run it from test/, where it reads its own blocks"
    exit 601
}
mata:
// The ids of the blocks (their header lines, in file order), and those of
// part k of n: longest first onto the least loaded part.
void _w33_part(string scalar file, string scalar table, real scalar k,
               real scalar n)
{
    string colvector lines, ids
    string rowvector tok
    real colvector sec, o, at
    real rowvector load
    real scalar i, j, p, best
    string scalar run

    lines = cat(file)
    ids = J(0, 1, "")
    for (i = 1; i <= rows(lines); i++) {
        if (ustrregexm(lines[i], "^\* ==== (S[0-9]+) ")) {
            if (!anyof(ids, ustrregexs(1))) ids = ids \ ustrregexs(1)
        }
    }
    sec = J(rows(ids), 1, 1)
    tok = tokens(table)
    for (j = 1; j + 1 <= cols(tok); j = j + 2) {
        for (i = 1; i <= rows(ids); i++) {
            if (ids[i] == tok[j]) sec[i] = strtoreal(tok[j + 1])
        }
    }
    o = order((-sec, (1::rows(ids))), (1, 2))
    load = J(1, n, 0)
    at = J(rows(ids), 1, 0)
    for (i = 1; i <= rows(o); i++) {
        best = 1
        for (p = 2; p <= n; p++) if (load[p] < load[best]) best = p
        load[best] = load[best] + sec[o[i]]
        at[o[i]] = best
    }
    run = ""
    for (i = 1; i <= rows(ids); i++) if (at[i] == k) run = run + " " + ids[i]
    st_local("w33_run", strtrim(run))
}
end
// The part this session runs: the runner's shard table may turn the
// parts (cert_helpers.do's cert_split_part, 11nov2026), so that
// each script's longest part lands on a different session.
cert_split_part "test_wp33_truth.cscript" `w33_k' `w33_N'
local w33_p = r(part)
mata: _w33_part("test_wp33_truth.cscript", st_local("w33_secs"), `w33_p', `w33_N')
if "`w33_how'" != "" display as text "test_wp33_truth: runs`w33_how', `: word count `w33_run'' blocks: `w33_run'"
else display as text "test_wp33_truth: session `w33_k'/`w33_N' runs part `w33_p', `: word count `w33_run'' blocks: `w33_run'"
// ---- parts: end ----

* ==== S00 scaffold: the helpers load and a twoway SVG is read ====
local only : env WP33_ONLY
if inlist("`only'", "", "S00") & `: list posof "S00" in w33_run' {
    display as text "S00 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3300-1: cert_svg_export and cert_svg_texts on one twoway scatter,
    // and dash's own programs are loaded from this tree.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(w33s01, replace)
    cert_svg_export, name(w33s01) file("`w33_work'/w33s01.svg")
    local s01_rc   = r(rc)
    local s01_file "`r(file)'"
    _w33_expect Q3300-1 "(`s01_rc' == 0)" "cert_svg_export rc `s01_rc'"
    capture confirm file "`s01_file'"
    _w33_expect Q3300-1 "(_rc == 0)" "r(file) `s01_file' does not exist"
    cert_svg_texts, file("`s01_file'")
    local s01_n    = r(n)
    local s01_list "`r(list)'"
    _w33_expect Q3300-1 "(`s01_n' > 0)" "cert_svg_texts found no text elements"
    capture program list _dash_serve
    _w33_expect Q3300-1 "(_rc == 0)" "dash.ado's _dash_serve is not loaded"
    _w33_done Q3300-1 "a twoway SVG was written and read (`s01_n' texts); dash is loaded"

    capture erase "`s01_file'"
    capture erase "`s01_list'"
    capture graph drop w33s01
    display as text "S00 end " c(current_date) " " c(current_time)
}
* ==== end S00 ====

// ----------------------------------------------------------------
// S09 helpers (WP-33 section 33-09, the corpus guard).  _w33s09_prepare
// writes the guard's run folder from the fixture's frozen records
// (scripts/corpus/guard.py: examples.jsonl, the twoway and dash do-files
// and the guard.do that wraps them) and says whether headless Chrome is
// found; _w33s09_judge measures every example (33-04's export, 33-05's
// judge) and compares the rows with the fixture's (D-33-09.c).
// ----------------------------------------------------------------
python:
def _w33s09_paths(repo):
    import os, sys
    added = [p for p in (repo, os.path.join(repo, "test")) if p not in sys.path]
    for p in reversed(added):
        sys.path.insert(0, p)
    return added


def _w33s09_unpaths(added):
    import sys
    for p in added:
        while p in sys.path:
            sys.path.remove(p)


def _w33s09_prepare(fixture, run, repo):
    import json, os, shutil
    from sfi import Macro
    repo = os.path.abspath(repo)
    added = _w33s09_paths(repo)
    try:
        from scripts.corpus import datasets, guard
        import responsive_probe
        chrome = bool(responsive_probe.find_chrome())
        Macro.setGlobal("w33_s09_chrome", "1" if chrome else "0")
        if not chrome:
            shutil.rmtree(run, ignore_errors=True)
            return
        with open(fixture, encoding="utf-8") as fh:
            fx = json.load(fh)
        recs = {i: row["record"] for i, row in fx["examples"].items()}
        guard.write_examples(recs, run)
        ex = [recs[i] for i in sorted(recs)]
        Macro.setLocal("gdo", guard.guard_do(ex, run, datasets.cache_dir(), repo))
    finally:
        _w33s09_unpaths(added)


def _w33s09_judge(fixture, run, repo):
    import json, os, shutil
    from sfi import Macro
    repo = os.path.abspath(repo)
    added = _w33s09_paths(repo)
    try:
        from scripts.corpus import guard
        with open(fixture, encoding="utf-8") as fh:
            fx = json.load(fh)
        recs = [fx["examples"][i]["record"] for i in sorted(fx["examples"])]
        try:
            got = guard.measure(run, recs,
                                os.path.join(repo, fx["_meta"]["rules"]),
                                os.path.join(repo, fx["_meta"]["ledger"]),
                                os.path.join(repo, "GAPS4.md"))
            probs = guard.compare(fx["examples"], got)
        except Exception as exc:
            probs = ["the guard could not measure: %s: %s"
                     % (type(exc).__name__, str(exc).replace(run, "<run>"))]
        for pr in probs:
            print("S09 problem: " + pr)
        Macro.setGlobal("w33_s09_n", str(len(probs)))
        # Quotes, backticks and dollars would break the _w33_expect line.
        bad = "; ".join(probs[:10])[:2000]
        for ch, to in (('"', "'"), ("\x60", "'"), ("$", "S")):
            bad = bad.replace(ch, to)
        Macro.setGlobal("w33_s09_bad", bad)
    finally:
        shutil.rmtree(run, ignore_errors=True)
        _w33s09_unpaths(added)
end

* ==== S09 tool: corpus guard ====
local only : env WP33_ONLY
if inlist("`only'", "", "S09") & `: list posof "S09" in w33_run' {
    display as text "S09 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3309-1: about twenty help-file examples (scripts/corpus/
    // guard_examples.txt, frozen in fixtures/corpus_guard_truth.json),
    // drawn by twoway and by dash in this session under guard.do, which
    // leaves the scheme, line size, ado-path, data and graphs as it found
    // them; dash's page is exported at twoway's size in headless Chrome
    // and judged; every rc, first line, verdict, check list and summary
    // is the fixture's.  No Chrome is a failure, never a skip.
    // ------------------------------------------------------------
    local run "`w33_work'/s09"
    local gdo ""
    capture noisily python: __import__("__main__")._w33s09_prepare("fixtures/corpus_guard_truth.json", r"`run'", "..")
    local s09_rc = _rc
    if `s09_rc' {
        _w33_expect Q3309-1 "(0)" "the guard could not write its run (r(`s09_rc'))"
    }
    else if "${w33_s09_chrome}" != "1" {
        _w33_expect Q3309-1 "(0)" "headless Chrome not found; the guard cannot run"
    }
    else {
        capture noisily do "`gdo'"
        local s09_rc = _rc
        _w33_expect Q3309-1 "(`s09_rc' == 0)" "guard.do ended r(`s09_rc')"
        global w33_s09_n 1
        global w33_s09_bad "the guard's judge did not run"
        capture noisily python: __import__("__main__")._w33s09_judge("fixtures/corpus_guard_truth.json", r"`run'", "..")
        _w33_expect Q3309-1 "(${w33_s09_n} == 0)" "${w33_s09_bad}"
    }
    _w33_done Q3309-1 "the guard's examples draw the recorded twoway and dash pictures and verdicts"

    macro drop w33_s09_*
    dash clear
    display as text "S09 end " c(current_date) " " c(current_time)
}
* ==== end S09 ====

// ----------------------------------------------------------------
// S10 helpers (WP-33 section 33-10, TR-11).  _w33s10_list writes one line
// <id>|<twoway rc>|dash <probe command without "twoway "> per probe of
// value_truth.json; _w33s10_one runs one probe through dash under its own
// log; _w33s10_judge compares dash's rc and first line with twoway's
// (D-33-10.d) and applies test/known_differences.py's rule to
// test/value_truth_known.py's VALUE_KNOWN and DELIBERATE.
// ----------------------------------------------------------------
python:
def _w33s10_list(fixture, out):
    import json
    with open(fixture, encoding="utf-8") as fh:
        probes = json.load(fh)["twoway"]
    with open(out, "w", encoding="utf-8") as fh:
        for p in probes:
            cmd = p["command"]
            assert cmd.startswith("twoway ") and "|" not in cmd, p["id"]
            fh.write("%s|%d|dash %s\n" % (p["id"], p["rc"],
                                          cmd[len("twoway "):]))


def _w33s10_first(path):
    # dash's first line: the first non-blank line of its log that is not
    # a command echo, runs of blanks made one (D-33-10.d).
    import re
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for ln in fh:
                if not ln.strip() or ln.startswith((". ", "> ")):
                    continue
                return re.sub(r"\s+", " ", ln).strip()
    except OSError:
        pass
    return ""


def _w33s10_judge(fixture, logdir, known_module_dir):
    import importlib, json, os, sys
    from sfi import Macro
    with open(fixture, encoding="utf-8") as fh:
        probes = json.load(fh)["twoway"]
    results = {}
    for p in probes:
        try:
            with open(os.path.join(logdir, p["id"] + ".rc")) as fh:
                drc = int(fh.read().strip())
        except (OSError, ValueError):
            drc = -1
        line = _w33s10_first(os.path.join(logdir, p["id"] + ".log"))
        msg = p["message"]
        agree = drc == p["rc"] and (
            p["rc"] == 0 or msg == line
            or (line != "" and msg.startswith(line + " ")))
        results[p["id"]] = None if agree else (
            "twoway r(%d) %s / dash r(%d) %s"
            % (p["rc"], msg[:80], drc, line[:80]))
    with open(os.path.join(logdir, "results.json"), "w",
              encoding="utf-8") as fh:
        json.dump(results, fh, indent=1, sort_keys=True)
    sys.path.insert(0, known_module_dir)
    try:
        kd = importlib.import_module("known_differences")
        vk = importlib.import_module("value_truth_known")
        probs = kd.known_problems(results, vk.VALUE_KNOWN, "value_truth",
                                  deliberate=vk.DELIBERATE)
    finally:
        sys.path.remove(known_module_dir)
    for pr in probs:
        print("S10 problem: " + pr)
    Macro.setGlobal("w33_s10_n", str(len(probs)))
    # Quotes, backticks and dollars would break the _w33_expect line.
    bad = "; ".join(probs[:15])[:2000]
    for ch, to in (('"', "'"), ("\x60", "'"), ("$", "S")):
        bad = bad.replace(ch, to)
    Macro.setGlobal("w33_s10_bad", bad)
end

capture program drop _w33s10_one
program define _w33s10_one
    // _w33s10_one <dir> <id> <twoway rc> <dash command...>: register the
    // probe (Stata-side checks only); where that passes and twoway
    // refused, run the one-line form too, which renders (D-33-10.c), and
    // keep its answer.  The output goes to <dir>/<id>.log, the rc to
    // <dir>/<id>.rc.
    version 19
    gettoken d 0 : 0
    gettoken pid 0 : 0
    gettoken trc 0 : 0
    quietly dash clear
    capture log close _s10
    quietly log using "`d'/`pid'.log", text replace name(_s10) nomsg
    capture noisily `0' name(s10g, replace)
    local drc = _rc
    quietly log close _s10
    if `drc' == 0 & `trc' != 0 {
        // The render's answer replaces the registration's, first line
        // included.
        quietly dash clear
        quietly log using "`d'/`pid'.log", text replace name(_s10) nomsg
        capture noisily `0'
        local drc = _rc
        quietly log close _s10
    }
    tempname fh
    file open `fh' using "`d'/`pid'.rc", write text replace
    file write `fh' "`drc'" _n
    file close `fh'
end

* ==== S10 TR-11: value_truth probe by probe ====
local only : env WP33_ONLY
if inlist("`only'", "", "S10") & `: list posof "S10" in w33_run' {
    display as text "S10 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3310-1: each of fixtures/value_truth.json's 311 probes through
    // dash: the rc (and, where twoway refused, the first line) is
    // twoway's, or the probe is a live known difference listed in
    // test/value_truth_known.py under the GAPS4 item that fixes it.  The
    // 230 probes twoway draws are registered, not rendered (A-10).
    // ------------------------------------------------------------
    sysuse auto, clear
    local s10_d "`w33_work'/s10"
    capture mkdir "`s10_d'"
    local s10_ls = c(linesize)
    set linesize 255
    python: __import__("__main__")._w33s10_list("fixtures/value_truth.json", r"`s10_d'/list.txt")
    tempname s10_fh
    file open `s10_fh' using "`s10_d'/list.txt", read text
    file read `s10_fh' line
    while r(eof) == 0 {
        gettoken pid rest : line, parse("|")
        gettoken bar rest : rest, parse("|")
        gettoken trc rest : rest, parse("|")
        gettoken bar rest : rest, parse("|")
        _w33s10_one "`s10_d'" `pid' `trc' `rest'
        file read `s10_fh' line
    }
    file close `s10_fh'
    set linesize `s10_ls'
    python: __import__("__main__")._w33s10_judge("fixtures/value_truth.json", r"`s10_d'", r"`c(pwd)'")
    _w33_expect Q3310-1 "(${w33_s10_n} == 0)" "${w33_s10_bad}"
    _w33_done Q3310-1 "every value_truth probe: twoway's rc and first line, or a live known difference of a GAPS4 item"

    local s10_files : dir "`s10_d'" files "*"
    foreach f of local s10_files {
        capture erase "`s10_d'/`f'"
    }
    capture rmdir "`s10_d'"
    macro drop w33_s10_*
    dash clear
    display as text "S10 end " c(current_date) " " c(current_time)
}
* ==== end S10 ====

* ==== S10 syn:SD-20: abbreviation bindings ====
local only : env WP33_ONLY
if inlist("`only'", "", "S10") & `: list posof "S10" in w33_run' {
    display as text "S10 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3310-2: bgc(), bgcol() and bgcolor() are twoway's graph option
    // (twowaygraph_g.class declares BGColor) and dash's; the fixture
    // abbrev_truth.json said twoway had no bgcolor().
    // ------------------------------------------------------------
    sysuse auto, clear
    foreach s in bgc bgcol bgcolor {
        capture twoway scatter mpg weight, `s'(red) nodraw
        local s10_trc = _rc
        _w33_expect Q3310-2 "(`s10_trc' == 0)" "twoway `s'(red): rc `s10_trc'"
        quietly dash clear
        capture dash scatter mpg weight, `s'(red) name(s10b)
        local s10_drc = _rc
        _w33_expect Q3310-2 "(`s10_drc' == 0)" "dash `s'(red): rc `s10_drc'"
        local s10_has = strpos(`"${dash_json_s10b}"', `""bgcolor""') > 0
        _w33_expect Q3310-2 "(`s10_has')" "dash `s'(red) recorded no bgcolor"
    }
    _w33_done Q3310-2 "bgc(), bgcol() and bgcolor() are twoway's graph option in both"
    capture graph drop _all
    quietly dash clear
    display as text "S10 end " c(current_date) " " c(current_time)
}
* ==== end S10 ====

python:
def _w33s11_plot():
    # S11 GW-11: twoway's plot region (the plotregion(lcolor("1 2 3"))
    # sentinel) in the SVG named by the local svg, and the committed
    # fixture's for the local key; read as extract_scale_frame_truth.do
    # reads it.  No macro is expanded into Python text.
    import json, os, sys
    from sfi import Macro
    svg = Macro.getLocal("svg")
    key = Macro.getLocal("key")
    sys.path.insert(0, os.path.join(os.path.abspath(".."), "scripts"))
    try:
        import svg_chrome
        r = svg_chrome.svg_region(svg, "#010203")
        Macro.setLocal("top", "%.3f" % r["top"] if r else ".")
        Macro.setLocal("left", "%.3f" % r["left"] if r else ".")
        with open("fixtures/scale_frame_truth.json", encoding="utf-8") as fh:
            f = json.load(fh)[key]["plot"]
        Macro.setLocal("ftop", "%.3f" % f["top"])
        Macro.setLocal("fleft", "%.3f" % f["left"])
    finally:
        try:
            os.remove(svg)
        except OSError:
            pass
end

* ==== S11 GW-11: scale() frame geometry ====
local only : env WP33_ONLY
if inlist("`only'", "", "S11") & `: list posof "S11" in w33_run' {
    display as text "S11 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3311-1: twoway's plot region under scale(0.5) and scale(1.5) is
    // the committed truth (fixtures/scale_frame_truth.json, written by
    // scripts/extract_scale_frame_truth.do), so the fixture the Chrome
    // comparison reads has not drifted.  The scheme is set for this
    // session only and put back.
    // ------------------------------------------------------------
    local s11_scheme "`c(scheme)'"
    set scheme s2color
    local d "`w33_work'/s11"
    capture mkdir "`d'"
    foreach k in 0.5 1.5 {
        sysuse auto, clear
        twoway scatter mpg weight, title("T") scale(`k') plotregion(lcolor("1 2 3")) graphregion(lcolor("4 5 6")) name(zf1, replace)
        capture erase "`d'/zf1_`k'.svg"
        cert_svg_export, name(zf1) file("`d'/zf1_`k'.svg")
        local svg "`r(file)'"
        local key "A:`k'"
        python: __import__("__main__")._w33s11_plot()
        _w33_expect Q3311-1 "(abs(`top' - `ftop') <= 0.5 & abs(`left' - `fleft') <= 0.5)" "scale(`k'): twoway's plot region top `top' left `left', the fixture's `ftop' `fleft'"
    }
    _w33_done Q3311-1 "twoway's plot region under scale() is the committed truth"
    capture graph drop zf1
    capture rmdir "`d'"
    set scheme `s11_scheme'
    display as text "S11 end " c(current_date) " " c(current_time)
}
* ==== end S11 ====

python:
def _w33s12_serset():
    # S12 BY-23: serset number j (0-based, in order) of the committed
    # fixture's probe pid (fixtures/by_types_truth.json, written by
    # scripts/extract_by_types_truth.do): its N and first row's first two
    # values, as the locals fn, fa and fb.  No macro is expanded into
    # Python text.
    import json
    from sfi import Macro
    pid = Macro.getLocal("pid")
    j = int(Macro.getLocal("j"))
    with open("fixtures/by_types_truth.json", encoding="utf-8") as fh:
        s = json.load(fh)["probes"][pid]["sersets"][j]
    row = (s.get("rows") or s.get("samples"))[0]
    Macro.setLocal("fn", str(s["n"]))
    Macro.setLocal("fa", "%.17g" % row[0])
    Macro.setLocal("fb", "%.17g" % row[1])
end

* ==== S12 BY-23: per-type by() truth ====
local only : env WP33_ONLY
if inlist("`only'", "", "S12") & `: list posof "S12" in w33_run' {
    display as text "S12 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3312-1: twoway's per-panel sersets under by() are the committed
    // truth (fixtures/by_types_truth.json), so the per-type comparison
    // test/test_by_types.py reads has not drifted: lfit under
    // by(foreign) (one 3-row serset per panel) and kdensity under
    // by(foreign, total) (three of 300 rows).
    // ------------------------------------------------------------
    foreach pc in "bt_lfit_by|lfit mpg weight|" "bt_kdensity_total|kdensity mpg|, total" {
        gettoken pid rest : pc, parse("|")
        gettoken bar rest : rest, parse("|")
        gettoken cmd rest : rest, parse("|")
        gettoken bar byo : rest, parse("|")
        sysuse auto, clear
        capture serset drop _all
        capture graph drop _all
        twoway (`cmd'), by(foreign`byo') nodraw
        local np = `.Graph.graphs.arrnels'
        forvalues j = 0/`=`np' - 1' {
            serset set `j'
            serset use, clear
            quietly ds
            local v1 : word 1 of `r(varlist)'
            local v2 : word 2 of `r(varlist)'
            local n = _N
            local a = `v1'[1]
            local b = `v2'[1]
            python: __import__("__main__")._w33s12_serset()
            _w33_expect Q3312-1 "(`n' == `fn' & reldif(`a', `fa') <= 1e-9 & reldif(`b', `fb') <= 1e-9)" "`pid' serset `j': N `n', first row `a' `b'; the fixture's `fn', `fa' `fb'"
        }
    }
    _w33_done Q3312-1 "twoway's per-panel sersets are the committed truth"
    capture serset drop _all
    capture graph drop _all
    display as text "S12 end " c(current_date) " " c(current_time)
}
* ==== end S12 ====

python:
def _w33s12_text_x():
    # S12 BY-24: the x of the first text "X" in the SVG texts list named
    # by the local tlist (cert_svg_texts' JSON lines) and in the committed
    # fixture's probe named by the local pid (fixtures/by_text_truth.json,
    # written by scripts/extract_by_text_truth.do), as the locals x and fx
    # ("." when there is none).  No macro is expanded into Python text.
    import json
    from sfi import Macro
    pid = Macro.getLocal("pid")
    x = "."
    with open(Macro.getLocal("tlist"), encoding="utf-8") as fh:
        for line in fh:
            t = json.loads(line)
            if t.get("text") == "X":
                x = "%.3f" % t["x"]
                break
    Macro.setLocal("x", x)
    with open("fixtures/by_text_truth.json", encoding="utf-8") as fh:
        svg = json.load(fh)["probes"][pid]["svg"]
    fx = [t["x"] for t in svg if t["text"] == "X"]
    Macro.setLocal("fx", "%.3f" % fx[0] if fx else ".")
end

* ==== S12 BY-24: by() text positions ====
local only : env WP33_ONLY
if inlist("`only'", "", "S12") & `: list posof "S12" in w33_run' {
    display as text "S12 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3312-2: by()'s note at clock 5 and title at clock 11 are where
    // the committed truth (fixtures/by_text_truth.json bp55 and bp40)
    // puts them, drawn as extract_by_text_truth.do's bt draws (scheme
    // stcolor for this session only, put back after).
    // ------------------------------------------------------------
    local s12_scheme "`c(scheme)'"
    set scheme stcolor
    foreach pc in "bp55|note" "bp40|title" {
        gettoken pid rest : pc, parse("|")
        gettoken bar what : rest, parse("|")
        local clock = cond("`what'" == "note", 5, 11)
        sysuse auto, clear
        twoway scatter mpg weight, by(foreign, `what'("X", position(`clock'))) name(Graph, replace)
        capture erase "`w33_work'/s12_`pid'.svg"
        cert_svg_export, name(Graph) file("`w33_work'/s12_`pid'.svg")
        local svg "`r(file)'"
        cert_svg_texts, file("`svg'")
        local tlist "`r(list)'"
        python: __import__("__main__")._w33s12_text_x()
        _w33_expect Q3312-2 "(abs(`x' - `fx') <= 1)" "`pid': X at x `x', the fixture's `fx'"
        capture erase "`svg'"
        capture erase "`tlist'"
    }
    _w33_done Q3312-2 "by()'s note at clock 5 and title at clock 11 are where the committed truth puts them"
    capture graph drop Graph
    set scheme `s12_scheme'
    display as text "S12 end " c(current_date) " " c(current_time)
}
* ==== end S12 ====

python:
def _w33s13_combo():
    # S13 stat:PT-23: the serset in memory (columns in serset order,
    # named by the local cols, "-" for one not compared) against the
    # committed combos record of the local key, at its sample_index.
    import json
    from sfi import Data, Macro
    key = Macro.getLocal("key")
    cols = Macro.getLocal("cols").split()
    with open("fixtures/stat_truth.json", encoding="utf-8") as fh:
        rec = json.load(fh)["combos"][key]
    n = Data.getObsTotal()
    bad = []
    if n != rec["n_points"]:
        bad.append("%d rows, the fixture %s" % (n, rec["n_points"]))
    idx = rec.get("sample_index") or list(range(1, n + 1))
    for j, name in enumerate(cols):
        if name == "-" or bad:
            continue
        want = rec[name]
        for k, i in enumerate(idx):
            got = Data.getAt(j, i - 1)
            w = want[k]
            if w is None or abs(got - w) > 1e-9 * max(1.0, abs(w)):
                bad.append("%s[%d] %r, the fixture %r" % (name, i, got, w))
                break
    Macro.setLocal("ok", "0" if bad else "1")
    Macro.setLocal("msg", "; ".join(bad)[:500].replace('"', "'"))
end

* ==== S13 stat:PT-23: estimator combinations ====
local only : env WP33_ONLY
if inlist("`only'", "", "S13") & `: list posof "S13" in w33_run' {
    display as text "S13 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3313-1: twoway lfitci [pw=price] and histogram rep78 [fw=fw],
    // discrete percent draw the sersets fixtures/stat_truth.json's
    // combos section holds (scripts/extract_stat_truth.do), so the
    // truth test_statistical_truth.py::TestEstimatorCombinations reads
    // has not drifted.
    // ------------------------------------------------------------
    local d "`w33_work'/s13"
    capture mkdir "`d'"
    foreach c in lfitci hist {
        sysuse auto, clear
        quietly generate fw = int(price/1000)
        capture erase "`d'/s13_`c'.gph"
        if "`c'" == "lfitci" {
            twoway lfitci mpg weight [pw=price] || , nodraw saving("`d'/s13_`c'.gph", replace)
            local key "auto:lfitci_pw"
            local cols "fit lower upper fit_x"
        }
        else {
            twoway histogram rep78 [fw=fw], discrete percent || , nodraw saving("`d'/s13_`c'.gph", replace)
            local key "auto:hist_disc_fw_pct"
            local cols "bar_height - bin_midpoint"
        }
        capture graph drop _all
        capture serset drop _all
        quietly graph use "`d'/s13_`c'.gph"
        serset set 0
        serset use, clear
        python: __import__("__main__")._w33s13_combo()
        _w33_expect Q3313-1 "(`ok')" "`key': `msg'"
        capture graph drop _all
        capture serset drop _all
        capture erase "`d'/s13_`c'.gph"
    }
    _w33_done Q3313-1 "twoway's lfitci [pw] and histogram discrete [fw] percent sersets are the committed combos truth"
    capture rmdir "`d'"
    display as text "S13 end " c(current_date) " " c(current_time)
}
* ==== end S13 ====

python:
def _w33s13_key():
    # S13 CV-16: the colour key texts (D-33-13.d: unrotated texts right of
    # the plot region, top to bottom) of the SVG named by the local svg,
    # and of the committed disc_rep78 probe.
    import json, os, sys
    from sfi import Macro
    svg = Macro.getLocal("svg")
    sys.path.insert(0, os.path.join(os.path.abspath(".."), "scripts"))
    import svg_truth

    def key(texts, right):
        return [t["text"] for t in sorted(
            (t for t in texts if t["x"] is not None and t["x"] > right + 1
             and not t["rotate"]), key=lambda t: (t["y"], t["x"]))]

    doc = svg_truth.svg_document(svg)
    got = key(doc["texts"], doc["plotregion"]["right"])
    with open("fixtures/colorvar_truth.json", encoding="utf-8") as fh:
        p = json.load(fh)["probes"]["disc_rep78"]
    want = key(p["texts"], p["plot"]["right"])
    Macro.setLocal("ok", "1" if got == want and got else "0")
    Macro.setLocal("msg", ("twoway %s, the fixture %s" % (got, want))[:400]
                   .replace('"', "'"))
end

* ==== S13 CV-16: colorvar key truth ====
local only : env WP33_ONLY
if inlist("`only'", "", "S13") & `: list posof "S13" in w33_run' {
