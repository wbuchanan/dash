* ==== append new blocks above this line ====

// ----------------------------------------------------------------
// Summary (test_wp29_truth.cscript's shape)
// ----------------------------------------------------------------
capture graph drop _all
capture dash clear
capture rmdir "`w33_work'"
local nfail    = ${w33_nfail}
local faillist "${w33_faillist}"
local ncase    = ${w33_ncase}
local only : env WP33_ONLY
macro drop w33_nfail w33_faillist w33_bad w33_ncase
display as text ""
display as text "============================================================"
if `ncase' == 0 {
    if `w33_N' > 1 & `"`macval(only)'"' == "" & "`w33_run'" == "" {
        display as text "test_wp33_truth: part `w33_k'/`w33_N' has no block to run"
        display as text "============================================================"
        exit 0
    }
    // A WP33_ONLY that names no block, or only a stub, ran nothing:
    // that is not a pass.
    display as error "  test_wp33_truth: no case ran (WP33_ONLY=`only')"
    display as text "============================================================"
    exit 9
}
else if `nfail' == 0 {
    display as text "  test_wp33_truth: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_wp33_truth: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
