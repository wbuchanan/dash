*! test_wp33_truth.cscript
*! WP-33's ONE certification script (.ultraplan/sections/index.md PD-6):
*! every comparison with twoway's drawing or with Stata's own values that
*! WP-33's sections need lives here, one block per GAPS4 row (or per
*! harness tool), appended above the "append new blocks above this line"
*! marker in section order.  Refusal, message and return-code checks join
*! the EXISTING script for their area (merge rule R1).
*!
*! Made from test/templates/wp_truth_template.cscript (33 -> the WP's
*! number).  S00 is the scaffold smoke (Q3300-1).  A section appends
*! `* ==== S<MM> <lead id>: <what> ====` ... `* ==== end S<MM> ====` (or
*! `S<MM> tool: <what>` for a section with no item), its helper programs
*! directly above its first header, and writes only inside its own
*! blocks.  Case ids are Q33<MM>-<k> (PD-5).
*!
*! Usage: via run_all_cscripts.do.  One block alone: WP33_ONLY=S<MM> in
*! the driver's environment.  Each block prints "S<MM> start" and "S<MM>
*! end" with the date and time.  The suite runs it in every session;
*! DASH_CERT_SHARD=k/N runs part k of N of the blocks; a part with no
*! block ends 0.

cscript "WP-33 truth: twoway comparisons" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off

if `"`c(python_exec)'"' == "" {
    display as error "SKIP: Python not available."
    exit 222
}

do "cert_helpers.do"
quietly do "cert_svg.do"
qui do "../dash_parse.mata"
qui do "../dash.ado"
global dash_nobrowser 1

// ----------------------------------------------------------------
// Tally helpers -- test_wp29_truth.cscript's _w29_expect/_w29_done,
// renamed _w33_ for this script.  A case is any number of
// _w33_expect lines closed by one _w33_done.
// ----------------------------------------------------------------
global w33_nfail    = 0
global w33_faillist ""
global w33_bad      = 0
global w33_ncase    = 0

capture program drop _w33_expect
program define _w33_expect
    version 19
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global w33_bad = 1
    }
end

capture program drop _w33_done
program define _w33_done
    version 19
    args id msg
    if ${w33_bad} {
        global w33_nfail    = ${w33_nfail} + 1
        global w33_faillist "${w33_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global w33_bad   = 0
    global w33_ncase = ${w33_ncase} + 1
end

// A fresh directory for this run's files, never one that already exists:
// a fixed name in a shared temp directory could be planted by another
// account (rule 1), so a name Stata has not handed out before is made and
// the run fails if it cannot be.  Every block writes only under it.
tempfile w33_base
local w33_work "`w33_base'_w33"
capture mkdir "`w33_work'"
if _rc {
    display as error "test_wp33_truth: cannot create the work directory `w33_work' (rc `=_rc')"
    exit 9
}

// ---- parts: begin (WP-33 test performance) ----
// The certification suite runs this script in every one of its sessions
// (its row in run_all_cscripts.do's shard table is "* * *"); with
// DASH_CERT_SHARD=k/N set, the session runs part k of N of the blocks.
// The parts are balanced longest first onto the least loaded part (the
// lowest numbered of equals), by the seconds below -- a block not listed
// counts 1 s (section-01 D-01.f) -- the rule scripts/cert_shards.py uses
// for the scripts.  Unset, or with WP33_ONLY set
// (which keeps its precedence), every block runs.  A block runs when its
// gate finds its id in w33_run.
// Seconds: each block's start/end lines in the WP's last measured
// certification run, rounded up, at least 1; a block not listed
// counts 1 s.
local w33_secs S00 1
local w33_sh : environment DASH_CERT_SHARD
mata: st_local("w33_ok", strofreal(st_local("w33_sh") == "" | ustrregexm(st_local("w33_sh"), "^[1-4]/[1-4]$")))
if !`w33_ok' {
    display as error "test_wp33_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 4"
    exit 198
}
local w33_k 1
local w33_N 1
if "`w33_sh'" != "" {
    local w33_k = real(substr("`w33_sh'", 1, 1))
    local w33_N = real(substr("`w33_sh'", 3, 1))
}
local w33_only : env WP33_ONLY
if `"`macval(w33_only)'"' != "" | `w33_N' == 1 {
    local w33_k 1
    local w33_N 1
}
if `w33_k' > `w33_N' {
    display as error "test_wp33_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 4"
    exit 198
}
capture confirm file "test_wp33_truth.cscript"
if _rc {
    display as error "test_wp33_truth: run it from test/, where it reads its own blocks"
    exit 601
}
capture mata: mata drop _w33_part()
mata:
// The ids of the blocks (their header lines, in file order), and those of
// part k of n: longest first onto the least loaded part.
void _w33_part(string scalar file, string scalar table, real scalar k,
               real scalar n)
{
    string colvector lines, ids
    string rowvector tok
    real colvector sec, o, at
    real rowvector load
    real scalar i, j, p, best
    string scalar run

    lines = cat(file)
    ids = J(0, 1, "")
    for (i = 1; i <= rows(lines); i++) {
        if (ustrregexm(lines[i], "^\* ==== (S[0-9]+) ")) {
            if (!anyof(ids, ustrregexs(1))) ids = ids \ ustrregexs(1)
        }
    }
    sec = J(rows(ids), 1, 1)
    tok = tokens(table)
    for (j = 1; j + 1 <= cols(tok); j = j + 2) {
        for (i = 1; i <= rows(ids); i++) {
            if (ids[i] == tok[j]) sec[i] = strtoreal(tok[j + 1])
        }
    }
    o = order((-sec, (1::rows(ids))), (1, 2))
    load = J(1, n, 0)
    at = J(rows(ids), 1, 0)
    for (i = 1; i <= rows(o); i++) {
        best = 1
        for (p = 2; p <= n; p++) if (load[p] < load[best]) best = p
        load[best] = load[best] + sec[o[i]]
        at[o[i]] = best
    }
    run = ""
    for (i = 1; i <= rows(ids); i++) if (at[i] == k) run = run + " " + ids[i]
    st_local("w33_run", strtrim(run))
}
end
mata: _w33_part("test_wp33_truth.cscript", st_local("w33_secs"), `w33_k', `w33_N')
display as text "test_wp33_truth: part `w33_k'/`w33_N' runs `: word count `w33_run'' blocks: `w33_run'"
// ---- parts: end ----

* ==== S00 scaffold: the helpers load and a twoway SVG is read ====
local only : env WP33_ONLY
if inlist("`only'", "", "S00") & `: list posof "S00" in w33_run' {
    display as text "S00 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3300-1: cert_svg_export and cert_svg_texts on one twoway scatter,
    // and dash's own programs are loaded from this tree.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(w33s01, replace)
    cert_svg_export, name(w33s01) file("`w33_work'/w33s01.svg")
    local s01_rc   = r(rc)
    local s01_file "`r(file)'"
    _w33_expect Q3300-1 "(`s01_rc' == 0)" "cert_svg_export rc `s01_rc'"
    capture confirm file "`s01_file'"
    _w33_expect Q3300-1 "(_rc == 0)" "r(file) `s01_file' does not exist"
    cert_svg_texts, file("`s01_file'")
    local s01_n    = r(n)
    local s01_list "`r(list)'"
    _w33_expect Q3300-1 "(`s01_n' > 0)" "cert_svg_texts found no text elements"
    capture program list _dash_serve
    _w33_expect Q3300-1 "(_rc == 0)" "dash.ado's _dash_serve is not loaded"
    _w33_done Q3300-1 "a twoway SVG was written and read (`s01_n' texts); dash is loaded"

    capture erase "`s01_file'"
    capture erase "`s01_list'"
    capture graph drop w33s01
    display as text "S00 end " c(current_date) " " c(current_time)
}
* ==== end S00 ====

// ----------------------------------------------------------------
// S10 helpers (WP-33 section 33-10, TR-11).  _w33s10_list writes one line
// <id>|<twoway rc>|dash <probe command without "twoway "> per probe of
// value_truth.json; _w33s10_one runs one probe through dash under its own
// log; _w33s10_judge compares dash's rc and first line with twoway's
// (D-33-10.d) and applies test/known_differences.py's rule to
// test/value_truth_known.py's VALUE_KNOWN and DELIBERATE.
// ----------------------------------------------------------------
python:
def _w33s10_list(fixture, out):
    import json
    with open(fixture, encoding="utf-8") as fh:
        probes = json.load(fh)["twoway"]
    with open(out, "w", encoding="utf-8") as fh:
        for p in probes:
            cmd = p["command"]
            assert cmd.startswith("twoway ") and "|" not in cmd, p["id"]
            fh.write("%s|%d|dash %s\n" % (p["id"], p["rc"],
                                          cmd[len("twoway "):]))


def _w33s10_first(path):
    # dash's first line: the first non-blank line of its log that is not
    # a command echo, runs of blanks made one (D-33-10.d).
    import re
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for ln in fh:
                if not ln.strip() or ln.startswith((". ", "> ")):
                    continue
                return re.sub(r"\s+", " ", ln).strip()
    except OSError:
        pass
    return ""


def _w33s10_judge(fixture, logdir, known_module_dir):
    import importlib, json, os, sys
    from sfi import Macro
    with open(fixture, encoding="utf-8") as fh:
        probes = json.load(fh)["twoway"]
    results = {}
    for p in probes:
        try:
            with open(os.path.join(logdir, p["id"] + ".rc")) as fh:
                drc = int(fh.read().strip())
        except (OSError, ValueError):
            drc = -1
        line = _w33s10_first(os.path.join(logdir, p["id"] + ".log"))
        msg = p["message"]
        agree = drc == p["rc"] and (
            p["rc"] == 0 or msg == line
            or (line != "" and msg.startswith(line + " ")))
        results[p["id"]] = None if agree else (
            "twoway r(%d) %s / dash r(%d) %s"
            % (p["rc"], msg[:80], drc, line[:80]))
    with open(os.path.join(logdir, "results.json"), "w",
              encoding="utf-8") as fh:
        json.dump(results, fh, indent=1, sort_keys=True)
    sys.path.insert(0, known_module_dir)
    try:
        kd = importlib.import_module("known_differences")
        vk = importlib.import_module("value_truth_known")
        probs = kd.known_problems(results, vk.VALUE_KNOWN, "value_truth",
                                  deliberate=vk.DELIBERATE)
    finally:
        sys.path.remove(known_module_dir)
    for pr in probs:
        print("S10 problem: " + pr)
    Macro.setGlobal("w33_s10_n", str(len(probs)))
    # Quotes, backticks and dollars would break the _w33_expect line.
    bad = "; ".join(probs[:15])[:2000]
    for ch, to in (('"', "'"), ("\x60", "'"), ("$", "S")):
        bad = bad.replace(ch, to)
    Macro.setGlobal("w33_s10_bad", bad)
end

capture program drop _w33s10_one
program define _w33s10_one
    // _w33s10_one <dir> <id> <twoway rc> <dash command...>: register the
    // probe (Stata-side checks only); where that passes and twoway
    // refused, run the one-line form too, which renders (D-33-10.c), and
    // keep its answer.  The output goes to <dir>/<id>.log, the rc to
    // <dir>/<id>.rc.
    version 19
    gettoken d 0 : 0
    gettoken pid 0 : 0
    gettoken trc 0 : 0
    quietly dash clear
    capture log close _s10
    quietly log using "`d'/`pid'.log", text replace name(_s10) nomsg
    capture noisily `0' name(s10g, replace)
    local drc = _rc
    quietly log close _s10
    if `drc' == 0 & `trc' != 0 {
        // The render's answer replaces the registration's, first line
        // included.
        quietly dash clear
        quietly log using "`d'/`pid'.log", text replace name(_s10) nomsg
        capture noisily `0'
        local drc = _rc
        quietly log close _s10
    }
    tempname fh
    file open `fh' using "`d'/`pid'.rc", write text replace
    file write `fh' "`drc'" _n
    file close `fh'
end

* ==== S10 TR-11: value_truth probe by probe ====
local only : env WP33_ONLY
if inlist("`only'", "", "S10") & `: list posof "S10" in w33_run' {
    display as text "S10 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3310-1: each of fixtures/value_truth.json's 311 probes through
    // dash: the rc (and, where twoway refused, the first line) is
    // twoway's, or the probe is a live known difference listed in
    // test/value_truth_known.py under the GAPS4 item that fixes it.  The
    // 230 probes twoway draws are registered, not rendered (A-10).
    // ------------------------------------------------------------
    sysuse auto, clear
    local s10_d "`w33_work'/s10"
    capture mkdir "`s10_d'"
    local s10_ls = c(linesize)
    set linesize 255
    python: __import__("__main__")._w33s10_list("fixtures/value_truth.json", r"`s10_d'/list.txt")
    tempname s10_fh
    file open `s10_fh' using "`s10_d'/list.txt", read text
    file read `s10_fh' line
    while r(eof) == 0 {
        gettoken pid rest : line, parse("|")
        gettoken bar rest : rest, parse("|")
        gettoken trc rest : rest, parse("|")
        gettoken bar rest : rest, parse("|")
        _w33s10_one "`s10_d'" `pid' `trc' `rest'
        file read `s10_fh' line
    }
    file close `s10_fh'
    set linesize `s10_ls'
    python: __import__("__main__")._w33s10_judge("fixtures/value_truth.json", r"`s10_d'", r"`c(pwd)'")
    _w33_expect Q3310-1 "(${w33_s10_n} == 0)" "${w33_s10_bad}"
    _w33_done Q3310-1 "every value_truth probe: twoway's rc and first line, or a live known difference of a GAPS4 item"

    local s10_files : dir "`s10_d'" files "*"
    foreach f of local s10_files {
        capture erase "`s10_d'/`f'"
    }
    capture rmdir "`s10_d'"
    macro drop w33_s10_*
    dash clear
    display as text "S10 end " c(current_date) " " c(current_time)
}
* ==== end S10 ====

* ==== S10 syn:SD-20: abbreviation bindings ====
local only : env WP33_ONLY
if inlist("`only'", "", "S10") & `: list posof "S10" in w33_run' {
    display as text "S10 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3310-2: bgc(), bgcol() and bgcolor() are twoway's graph option
    // (twowaygraph_g.class declares BGColor) and dash's; the fixture
    // abbrev_truth.json said twoway had no bgcolor().
    // ------------------------------------------------------------
    sysuse auto, clear
    foreach s in bgc bgcol bgcolor {
        capture twoway scatter mpg weight, `s'(red) nodraw
        local s10_trc = _rc
        _w33_expect Q3310-2 "(`s10_trc' == 0)" "twoway `s'(red): rc `s10_trc'"
        quietly dash clear
        capture dash scatter mpg weight, `s'(red) name(s10b)
        local s10_drc = _rc
        _w33_expect Q3310-2 "(`s10_drc' == 0)" "dash `s'(red): rc `s10_drc'"
        local s10_has = strpos(`"${dash_json_s10b}"', `""bgcolor""') > 0
        _w33_expect Q3310-2 "(`s10_has')" "dash `s'(red) recorded no bgcolor"
    }
    _w33_done Q3310-2 "bgc(), bgcol() and bgcolor() are twoway's graph option in both"
    capture graph drop _all
    quietly dash clear
    display as text "S10 end " c(current_date) " " c(current_time)
}
* ==== end S10 ====

* ==== append new blocks above this line ====

// ----------------------------------------------------------------
// Summary (test_wp29_truth.cscript's shape)
// ----------------------------------------------------------------
capture graph drop _all
capture dash clear
capture rmdir "`w33_work'"
local nfail    = ${w33_nfail}
local faillist "${w33_faillist}"
local ncase    = ${w33_ncase}
local only : env WP33_ONLY
macro drop w33_nfail w33_faillist w33_bad w33_ncase
display as text ""
display as text "============================================================"
if `ncase' == 0 {
    if `w33_N' > 1 & `"`macval(only)'"' == "" & "`w33_run'" == "" {
        display as text "test_wp33_truth: part `w33_k'/`w33_N' has no block to run"
        display as text "============================================================"
        exit 0
    }
    // A WP33_ONLY that names no block, or only a stub, ran nothing:
    // that is not a pass.
    display as error "  test_wp33_truth: no case ran (WP33_ONLY=`only')"
    display as text "============================================================"
    exit 9
}
else if `nfail' == 0 {
    display as text "  test_wp33_truth: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_wp33_truth: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
