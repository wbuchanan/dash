*! test_by_suboptions.cscript  v1.0
*! Certification script for by() sub-options dash does not implement.
*!
*! Stata's by() takes some thirty sub-options.  dash implements three --
*! cols(#), total and missing -- and used to discard every other one
*! without a word: `by(foreign, rows(2) compact)' faceted as if the user had
*! typed `by(foreign)', and nothing told them.  ROADMAP BR-11.2: a by()
*! sub-option that is not implemented is NAMED, not discarded.
*!
*! The renderer names them in one Python warning, which Stata prints into
*! the log; this script captures the log and reads it back, the way
*! test_render_log_clean.cscript and test_conformance.cscript do.
*!
*! Tests: BYS-01 through BYS-06; BSC-08 through BSC-10 (WP-29 P0.2);
*! BYG-01 through BYG-18 (WP-30 P1.15b)
*!
*! Usage:  do test/test_by_suboptions.cscript
*! Version: 1.0  22sep2026

cscript "an unimplemented by() sub-option is named" adodir ".."
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}

if "`c(python_exec)'" == "" {
    display as error "SKIP: Python not available."
    exit 222
}

qui sysuse auto, clear
global dash_nobrowser 1
qui do "../dash_parse.mata"
qui do "../dash.ado"

mata:
// Read a captured log, re-join "> " continuations into logical lines, and
// report how many carry the by() sub-option warning and the first that does.
void _bys_scan(string scalar fn)
{
    real scalar   fh, n
    string scalar line, full, first
    fh = fopen(fn, "r")
    n = 0
    full = ""
    first = ""
    while ((line = fget(fh)) != J(0, 0, "")) {
        if (substr(line, 1, 2) == "> ") {
            full = full + substr(line, 3, .)
            continue
        }
        if (strpos(full, "by() sub-option")) {
            n = n + 1
            if (first == "") first = full
        }
        full = line
    }
    if (strpos(full, "by() sub-option")) {
        n = n + 1
        if (first == "") first = full
    }
    fclose(fh)
    st_local("_bys_scan_n", strofreal(n))
    st_local("_bys_scan_line", first)
}
end

// Render one command with the log captured, and count the logical lines of
// the log that carry the by() sub-option warning.  Returns the count in
// r(n) and the first matching line in r(line); the caller copies them into
// `_bys_n' and `_bys_line'.
capture program drop _bys_render
program define _bys_render, rclass
    version 16.0
    args byspec
    tempfile out
    local logfile "`c(tmpdir)'dash_bys_`=subinstr("`c(current_time)'", ":", "", .)'.log"
    // A fixed width, so the renderer's message wraps at the same place in
    // every run and the re-join below is exercised every time.
    set linesize 80
    capture log close _byslog
    log using "`logfile'", name(_byslog) text replace
    dash clear
    capture noisily dash scatter mpg weight, by(`byspec') saving("`out'.html") replace
    local rc = _rc
    log close _byslog
    if `rc' != 0 {
        display as error "render failed with rc=`rc'"
        exit `rc'
    }
    // Stata wraps the log at c(linesize) and prefixes each continuation
    // with "> ".  The renderer's message can break anywhere -- measured, it
    // broke between "not implemented" and "and ignored: rows(2)" -- so the
    // physical lines are re-joined into logical ones before matching.  In
    // Mata, the way test_option_surface.cscript reads its notes: a log line
    // can carry a quote (the unknown-scheme warning does), and a Stata
    // macro that is re-expanded to accumulate such text loses it.
    mata: _bys_scan("`logfile'")
    capture erase "`logfile'"
    return scalar n = `_bys_scan_n'
    return local line `"`macval(_bys_scan_line)'"'
end

// The caller-side copy, so each case reads like the others.
capture program drop _bys_take
program define _bys_take
    c_local _bys_n    = r(n)
    c_local _bys_line `"`r(line)'"'
end


// ================================================================
// BYS-01 — the implemented sub-options draw no warning
// ================================================================
_bys_render "foreign, cols(1) total"
_bys_take
assert `_bys_n' == 0
display "BYS-01 PASS: by(foreign, cols(1) total) is not warned about"


// ================================================================
// BYS-02..03 — an unimplemented sub-option is named, once
// ================================================================
// Once means one logical line of the log, so the counts below are exact.
// They were `>= 1', which a render reporting the same sub-options twice
// also passes -- and the saved renderer did report them twice, parsing a
// graph's by() once to group the frame and again for the layout, until
// _dash_parse_by grew warn=False for the second parse (dash_render.py).
// Measured 24sep2026: each render below writes the warning exactly once.
// Flipped (WP-30 P1.15b): rows(), compact and holes() were the examples;
// they are drawn now (by_grid_truth.json grid and sizes), so the still
// unimplemented subtitleformat() and shrink are.
// Flipped (WP-31 D10): subtitleformat() is drawn now (a numeric format,
// measured), so overallshrink and shrink are the examples.
// Flipped (WP-31 D10b): shrink and overallshrink are drawn now
// (by_remainder_truth.json shrink_*), so style(econ) and bgcolor(red) are (twoway
// refuses a second style()).
_bys_render "foreign, style(econ)"
_bys_take
display `"  read: `macval(_bys_line)'"'
assert `_bys_n' == 1
assert strpos(`"`macval(_bys_line)'"', "style(econ)") > 0
display "BYS-02 PASS: by(foreign, style(econ)) names it"

// Flipped (WP-31 D10c): style(econ) is drawn as the options its
// bygraphstyle file gives (bystyle_truth.json) and names only its label
// margin, in its own line; bgcolor(red) is named in the list line.
_bys_render "foreign, style(econ) bgcolor(red)"
_bys_take
assert `_bys_n' == 2
assert strpos(`"`_bys_line'"', "style(econ)") > 0
assert strpos(`"`_bys_line'"', "bgcolor(red)") == 0
display "BYS-03 PASS: style(econ)'s remainder and bgcolor(red) are named, once each"


// ================================================================
// BYS-04 — the supported ones beside them are not named
// ================================================================
_bys_render "foreign, cols(2) shrink style(econ)"
_bys_take
assert `_bys_n' == 1
assert strpos(`"`_bys_line'"', "style(econ)") > 0
assert strpos(`"`_bys_line'"', "cols") == 0
assert strpos(`"`_bys_line'"', "shrink") == 0
display "BYS-04 PASS: cols(2) and shrink are not reported alongside style(econ)"


// ================================================================
// BYS-05 — and the dashboard is still built
// ================================================================
// A warning, not an error: the user asked for facets and gets them.
tempfile out5
dash clear
dash scatter mpg weight, by(foreign, shrink) saving("`out5'.html") replace
confirm file "`out5'.html"
display "BYS-05 PASS: the faceted dashboard is written despite the warning"


// ================================================================
// BYS-06 — the warning survives dash_setup's own probe
// ================================================================
// dash_setup's scheme probe used to install warnings.simplefilter("ignore")
// in the embedded interpreter and never remove it, so a user who ran
// dash_setup and then dash in one session saw NONE of dash's reports.
// Found because test_setup_honesty.cscript runs the probe four scripts
// before this one in the same session, and BYS-02 could not see the
// warning it was written to read.
qui do "../dash_setup.ado"
capture noisily _dash_setup_check_files
// Flipped (WP-31 D10b): overallshrink is drawn; style(econ) is named.
_bys_render "foreign, style(econ)"
_bys_take
assert `_bys_n' == 1
assert strpos(`"`_bys_line'"', "style(econ)") > 0
display "BYS-06 PASS: the report is still printed after dash_setup's probe"

// ================================================================
// BSC-08..10 -- twoway's rescale sub-options are honoured, not named,
// and a range() a rescaled axis does not apply is said once in the log
// of a saved and of a served build (WP-29 P0.2)
// ================================================================
mata:
// How many logical lines of a captured log hold `needle'.
void _bsc_scan(string scalar fn, string scalar needle)
{
    real scalar   fh, n
    string scalar line, full
    fh = fopen(fn, "r")
    n = 0
    full = ""
    while ((line = fget(fh)) != J(0, 0, "")) {
        if (substr(line, 1, 2) == "> ") {
            full = full + substr(line, 3, .)
            continue
        }
        if (strpos(full, needle)) n = n + 1
        full = line
    }
    if (strpos(full, needle)) n = n + 1
    fclose(fh)
    st_local("_bsc_n", strofreal(n))
}
end

// Run one command with the log captured; r(n) is how many logical lines
// of the log hold the range() note.
capture program drop _bsc_logrun
program define _bsc_logrun, rclass
    version 16.0
    args cmd
    local logfile "`c(tmpdir)'dash_bsc_`=subinstr("`c(current_time)'", ":", "", .)'.log"
    set linesize 80
    capture log close _bsclog
    log using "`logfile'", name(_bsclog) text replace
    capture noisily `cmd'
    local rc = _rc
    log close _bsclog
    mata: _bsc_scan("`logfile'", "scale(range()) is not applied, as in twoway")
    capture erase "`logfile'"
    if `rc' != 0 {
        display as error "command failed with rc=`rc'"
        exit `rc'
    }
    return scalar n = `_bsc_n'
end

// BSC-08: no rescale spelling is named; style(rescale) has its own note.
// Flipped (WP-30 P1.15b): r is a spelling of rescale, and twoway refuses
// a second copy ("option r not allowed", by_grid_truth.json refusals
// "yrescale yrescale"), so r is drawn on its own.
_bys_render "foreign, yrescale xrescale rescale norescale noyrescale"
_bys_take
assert `_bys_n' == 0
_bys_render "foreign, r"
_bys_take
assert `_bys_n' == 0
// Flipped (WP-31 D10c): style(rescale) is drawn as its bygraphstyle
// file's options (bystyle_truth.json); its own note names only the label
// box's astextbox and outline.  style(combine) keeps the scales note.
_bys_render "foreign, style(rescale)"
_bys_take
assert `_bys_n' == 1
assert strpos(`"`_bys_line'"', "astextbox and foreground outline") > 0
_bys_render "foreign, style(combine)"
_bys_take
assert `_bys_n' == 1
assert strpos(`"`_bys_line'"', "only its separate scales are drawn") > 0
display "BSC-08 PASS: yrescale, xrescale, rescale, r, norescale and noyrescale are honoured, not named; style(rescale) has its own note"

// BSC-09: the saved build says once that range() is not applied.
tempfile out9
dash clear
_bsc_logrun `"dash scatter mpg weight, by(foreign, yrescale) yscale(range(0)) saving("`out9'.html") replace"'
assert r(n) == 1
display "BSC-09 PASS: by(foreign, yrescale) yscale(range(0)) says once that range() is not applied (saved)"

// BSC-10: and so does the served build, where the user reads it.
tempfile out10
dash clear
quietly dash scatter mpg weight, by(foreign, yrescale) yscale(range(0)) name(bsc10)
_bsc_logrun `"dash build, saving("`out10'.py") replace server"'
assert r(n) == 1
display "BSC-10 PASS: the served build says it once too, at build time"
capture erase "`out10'.py"

capture program drop _bys_render
dash clear

// ================================================================
// BYG: by() arguments refused as twoway refuses them (WP-30 P1.15b)
//
// Each case runs the by() sub-options through live twoway (drawn, then
// exported, so a draw-time refusal counts) and through dash (registered
// by name(), where dash.ado validates by()), and compares the return code
// and, when it is not 0, the error line; a case with twoway's note also
// finds that note in dash's log.  A mismatch prints "BYG-nn FAIL" and is
// counted; the run fails at its end.  Truth: by_grid_truth.json.
// ================================================================
mata:
// The last line of a captured log that is not blank, a note, a command
// echo or an r() line (the error line), and the first note line.
void _byg_read(string scalar fn)
{
    real scalar   fh
    string scalar line, last, note, t
    fh = fopen(fn, "r")
    last = ""
    note = ""
    while ((line = fget(fh)) != J(0, 0, "")) {
        t = strtrim(line)
        if (t == "" | substr(t, 1, 2) == ". " | regexm(t, "^r\([0-9]+\);$")) continue
        if (substr(t, 1, 6) == "(note:") {
            if (note == "") note = t
            continue
        }
        if (substr(t, 1, 4) == "log:" | substr(t, 1, 5) == "name:" | substr(t, 1, 9) == "log type:" | substr(t, 1, 10) == "opened on:" | substr(t, 1, 10) == "closed on:") continue
        last = t
    }
    fclose(fh)
    st_local("_byg_line", last)
    st_local("_byg_note", note)
}
end

capture program drop _byg_run
program define _byg_run, rclass
    version 19
    args which a
    local logfile "`c(tmpdir)'dash_byg_`which'.log"
    capture log close _byglog
    quietly log using "`logfile'", name(_byglog) text replace
    if "`which'" == "tw" {
        capture noisily twoway scatter mpg weight, by(foreign, `a') name(_byg, replace)
        local rc = _rc
        if !`rc' {
            capture noisily graph export "`c(tmpdir)'dash_byg.svg", name(_byg) replace
            local rc = _rc
        }
    }
    else {
        capture noisily dash scatter mpg weight, by(foreign, `a') name(byg)
        local rc = _rc
    }
    quietly log close _byglog
    capture graph drop _all
    capture dash clear
    mata: _byg_read(st_local("logfile"))
    capture erase "`logfile'"
    return scalar rc = `rc'
    return local line `"`macval(_byg_line)'"'
    return local note `"`macval(_byg_note)'"'
end

// _byg_cmp id "args": twoway's and dash's rc, error line and first note.
capture program drop _byg_cmp
program define _byg_cmp
    version 19
    args id a
    _byg_run tw `"`a'"'
    local trc = r(rc)
    local tline `"`r(line)'"'
    local tnote `"`r(note)'"'
    _byg_run dash `"`a'"'
    local drc = r(rc)
    local dline `"`r(line)'"'
    local dnote `"`r(note)'"'
    local ok = (`trc' == `drc')
    if `ok' & `trc' != 0 {
        local ok = (`"`macval(tline)'"' == `"`macval(dline)'"')
    }
    if `ok' & `"`macval(tnote)'"' != "" {
        local ok = (`"`macval(tnote)'"' == `"`macval(dnote)'"')
    }
    if !`ok' {
        scalar _byg_nfail = _byg_nfail + 1
        display as error `"`id' FAIL: by(foreign, `macval(a)'): twoway rc `trc' "`macval(tline)'" `macval(tnote)'; dash rc `drc' "`macval(dline)'" `macval(dnote)'"'
    }
    scalar _byg_case = _byg_case + `ok'
end

capture program drop _byg_group
program define _byg_group
    version 19
    gettoken id 0 : 0
    gettoken what 0 : 0
    scalar _byg_case = 0
    local before = _byg_nfail
    local n 0
    foreach a of local 0 {
        _byg_cmp `id' `"`a'"'
        local ++n
    }
    if _byg_nfail == `before' display "`id' PASS: `what' (`n' probes)"
    else display as error "`id' FAIL: `what'"
end

scalar _byg_nfail = 0
qui sysuse auto, clear
_byg_group BYG-01 "rows() and cols() numbers, rows first" ///
    "rows(0) cols(0)" "cols(0) rows(2)" "cols(0) rows(0)"
_byg_group BYG-02 "a rows() that is not one positive integer" ///
    "rows(1.5)" "rows(2 3)" "rows(abc)"
_byg_group BYG-03 "rows() with cols(), before any leftover" ///
    "rows(2) cols(2) YRESCALE" "rows(1) cols(1) holes(0)"
_byg_group BYG-04 "holes() numbers, after the leftovers' stage is reached" ///
    "YRESCALE holes(0)" "holes(1.5)" "holes(abc)" "holes(1/301)"
_byg_group BYG-05 "a repeated rows() or cols(): the first copy is checked" ///
    "rows(2) rows(3)" "rows(0) rows(2)" "cols(2) cols(0)"
_byg_group BYG-06 "a number error before a repeat or a capital" ///
    "colfirst colfirst rows(0)" "TOTAL rows(0)"
_byg_group BYG-07 "the first leftover in typed order" ///
    "holes(1) holes(2) style(compact) style(default)" ///
    "style(compact) style(default) YRESCALE"
_byg_group BYG-08 "a capitalised sub-option" "COMPACT" "Rows(2)" "total TOTAL"
_byg_group BYG-09 "a word twoway reads once, given twice" ///
    "compact compact" "iscale(.5) iscale(2)" "imargin(small) imargin(large)" ///
    "yrescale yrescale" "missing missing" "total total"
_byg_group BYG-10 "iscale() below 0 or above 10,000" ///
    "iscale(-1)" "iscale(*-1)" "iscale(1e5)"
_byg_group BYG-11 "iscale()'s bound after the parse stages" ///
    "iscale(-1) rows(0)" "iscale(-1) YRESCALE"
_byg_group BYG-12 "iscale() inside its bounds" "iscale(1e4)" "iscale(0)" "iscale(100)"
_byg_group BYG-13 "unreadable iscale() and imargin() text: twoway's note" ///
    "iscale(abc)" "iscale(.)" "iscale(1 2)" "imargin(bogus)"
_byg_group BYG-14 "empty and valid grid arguments are accepted" ///
    "rows()" "holes()" "iscale()" "holes(301)" "r(2)" "c(1) colf" "hol(2 2 9)" ///
    "imargin(-1)" "imargin(1 2 3 4)" "imargin(l=5)" "rows(2) cols()"
_byg_group BYG-15 "repeats twoway refuses and repeats its loops read" ///
    "legend(off) legend(on)" "clegend(on) clegend(off)" `"title("a") title("b")"' ///
    "graphregion(color(white)) graphregion(color(red))" "t1title(a) t1title(b)" ///
    "spacers(ring(1)) spacers(ring(2))" "bgcolor(white) bgcolor(red)" "ixt"
_byg_group BYG-16 "cols() beyond the panels draws as twoway does (its limit note: BYG-19)" "cols(500)"
_byg_group BYG-17 "an unknown word, in typed order" ///
    "bogus" `"bogus TITLE("x")"' `"TITLE("x") bogus"' "bogus rows(0)" "nolegend"
_byg_group BYG-18 "every by() word's minimum is accepted; one letter less is not" ///
        `"total"' `"tot"' `"to"' `"missing"' `"miss"' `"mis"' ///
        `"rows(2)"' `"r(2)"' `"colfirst"' `"colf"' `"col"' `"cols(2)"' ///
        `"c(2)"' `"scale(1)"' `"scal(1)"' `"iscale(.5)"' `"iscal(.5)"' `"legend(off)"' ///
        `"leg(off)"' `"le(off)"' `"legloc(6)"' `"leglo(6)"' `"plegend(off)"' `"pleg(off)"' ///
        `"ple(off)"' `"plegloc(6)"' `"pleglo(6)"' `"clegend(on)"' `"cleg(on)"' `"cle(on)"' ///
        `"clegloc(3)"' `"cleglo(3)"' `"compact"' `"com"' `"co"' `"style(compact)"' ///
        `"styl(compact)"' `"norescale"' `"nor"' `"no"' `"rescale"' `"r"' ///
        `"noxrescale"' `"noxr"' `"noyrescale"' `"noyr"' `"xrescale"' `"xr"' ///
        `"x"' `"yrescale"' `"yr"' `"y"' `"holes(3)"' `"hol(3)"' ///
        `"ho(3)"' `"noedgelabel"' `"noedge"' `"noed"' `"edgelabel"' `"edge"' ///
        `"edg"' `"noixaxes"' `"noix"' `"noiyaxes"' `"noiy"' `"ixaxes"' ///
        `"ix"' `"iyaxes"' `"iy"' `"i"' `"noxtitles"' `"noxt"' ///
        `"xtitles"' `"xt"' `"noytitles"' `"noyt"' `"ytitles"' `"yt"' ///
        `"noixlabels"' `"noixl"' `"noiylabels"' `"noiyl"' `"ixlabels"' `"ixl"' ///
        `"iylabels"' `"iyl"' `"noixticks"' `"noixt"' `"noiyticks"' `"noiyt"' ///
        `"ixticks"' `"ixt"' `"iyticks"' `"iyt"' `"noixtitles"' `"noixti"' ///
        `"noiytitles"' `"noiyti"' `"ixtitles"' `"ixti"' `"iytitles"' `"iyti"' ///
        `"noindividual"' `"noind"' `"noin"' `"individual"' `"ind"' `"in"' ///
        `"ilegends"' `"ileg"' `"ile"' `"imargin(small)"' `"im(small)"' `"noshrink"' ///
        `"noshr"' `"noishrink"' `"noishr"' `"nooverallshrink"' `"nooverallshr"' `"shrink"' ///
        `"shr"' `"sh"' `"ishrink"' `"ishr"' `"ish"' `"overallshrink"' ///
        `"overallshr"' `"subtitleformat(%9s)"' `"subtitleforma(%9s)"' `"graphregion(color(white))"' `"graphr(color(white))"' `"graph(color(white))"' ///
        `"plotregion(margin(zero))"' `"plotr(margin(zero))"' `"plot(margin(zero))"' `"r1title("a")"' `"r1("a")"' `"r2("a")"' ///
        `"l1("a")"' `"l2("a")"' `"t1("a")"' `"t2("a")"' `"b1("a")"' `"b2("a")"' ///
        `"note("a")"' `"not("a")"' `"caption("a")"' `"cap("a")"' `"ca("a")"' `"subtitle("a")"' ///
        `"sub("a")"' `"su("a")"' `"title("a")"' `"t("a")"' `"spacers(ring(1))"' `"space(ring(1))"' ///
        `"spac(ring(1))"' `"bgcolor(white)"' `"bgc(white)"' `"bg(white)"'
// BYG-19: cols() or rows() above the by_groups limit is drawn at the limit
// with one note naming the global (BR-48.7, TR-48.3).  _dash_by_clamp was
// never built, so cols(500) passed unchanged and silently (WP-30 P1.15a
// follow-up).  At or under the limit, or with the limit raised:
// the tail is kept and nothing is noted.  Compared in Mata, by value.
capture program drop _byg_lim
program define _byg_lim
    version 19
    args a want note
    // The note is read as one log line, so the log is not wrapped.
    local ls = c(linesize)
    set linesize 255
    _byg_run dash `"`a'"'
    local rc = r(rc)
    set linesize `ls'
    mata: st_local("_gn", st_global("r(note)"))
    capture dash clear
    quietly dash scatter mpg weight, by(foreign, `a') name(byg)
    mata: st_local("ok", strofreal(`rc' == 0 & st_local("_gn") == st_local("note") & strpos(st_global("dash_json_byg"), st_local("want")) > 0))
    capture dash clear
    if !`ok' {
        scalar _byg_nfail = _byg_nfail + 1
        display as error `"BYG-19 FAIL: by(foreign, `a'): rc `rc', note "`macval(_gn)'"; want "`macval(note)'" and `want' in the spec"'
    }
end
local _gmax `"$dash_max_by_groups"'
global dash_max_by_groups
local before = _byg_nfail
_byg_lim "cols(500)" "cols(100)" "(note:  by(, cols(#)) is above the by_groups limit of 100; drawn with 100 columns; \$dash_max_by_groups raises it)"
_byg_lim "r(500) colf" "r(100) colf" "(note:  by(, rows(#)) is above the by_groups limit of 100; drawn with 100 rows; \$dash_max_by_groups raises it)"
_byg_lim "cols(100)" "cols(100)" ""
global dash_max_by_groups 600
_byg_lim "cols(500)" "cols(500)" ""
global dash_max_by_groups `_gmax'
if _byg_nfail == `before' display "BYG-19 PASS: cols() and rows() above the by_groups limit are drawn at it, with one note"
capture program drop _byg_lim

display "BYG summary: " _byg_nfail " failing group probe(s)"
assert _byg_nfail == 0
scalar drop _byg_nfail _byg_case
capture program drop _byg_run _byg_cmp _byg_group

display ""
display "All by() sub-option tests PASSED."
