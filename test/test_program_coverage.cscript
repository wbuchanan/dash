*! test_program_coverage.cscript
*! WP-24 AC-24.3 (every program define and every Mata function has a
*! behavioural test) and GAPS.md L7: tests for the programs and functions
*! the certification suite never executed, or executed without an
*! assertion that would fail if they broke.
*!
*! Usage:  do test/test_program_coverage.cscript  (from test/, through the
*!         runner, which puts dash's directory on the ado-path)
*!
*! Requires: Python configured (c(python_exec)), bokeh, numpy, pandas and
*!           packaging importable there.
*! Version: 1.0.0  24sep2026
*!
*! HOW THE GAPS WERE MEASURED
*!
*! scripts/measure_stata_coverage.py ran every certification script once
*! (59 passed, 0 failed, 0 skipped at 68327a8) on a scratch copy of the tree
*! in which each ado program and each Mata function records its entry.
*! Stata's profiler could not do it: clear all, clear and discard each
*! destroy its counts, and every script starts with cscript's clear all.
*! Of 63 ado programs 61 were entered -- _dash_kv_json and
*! _dash_graph_opts_to_json never -- and dash_setup only by
*! test_setup_honesty's HON-14/15, which its syntax line refuses: its body
*! never ran.  Of 55 Mata functions 52 ran; _html_escape, _dash_json_esc
*! and _dash_html_esc never did.  WP-26 deleted those five, which nothing
*! called (24sep2026; test_no_orphans.py now fails on a unit nothing
*! calls).  test/program_coverage_map.py names the test that exercises
*! every unit and test_program_coverage_map.py holds it to the sources.
*!
*! WHAT THIS SCRIPT HOLDS
*!
*!   PC-01..04  _dash_formats_json: the formats map and the date variables,
*!              ordinary, edge and hostile display formats
*!   PC-08..11  the routes that carry a date format: dash <plot>, saving()
*!              and dash build, with ordinary and hostile formats, and with
*!              an export that fails.  PC-05..07 tested
*!              _dash_date_fmts_swap / _dash_date_fmts_restore, which
*!              bracketed jsonio's export; dash writes its own data file
*!              now, reading each stored value whatever its format, and the
*!              two went with jsonio (24sep2026)
*!   PC-12..13  _dash_filter_setvars, which the whole suite called once
*!   PC-14      the sandbox dash_setup runs in (test/setup_sandbox.py)
*!   PC-15..26  dash_setup end to end, through every branch this machine
*!              can reach, installing nothing; PC-23 holds that it neither
*!              checks nor installs jsonio (PC-24, its restart advice, went
*!              with the jsonio step)
*!   PEP-01..16 dash_setup on externally managed (PEP 668) Pythons and
*!              dash_setup, venv(path), in the same sandbox (WP-29 P0.19)
*!   PC-28      _json_escape, read back by JSON as the original.  PC-27
*!              and PC-29 tested _html_escape, _dash_html_esc and
*!              _dash_kv_json, and went with them (WP-26)
*!   PC-30      the Mata library check names _dash_path_badchar, which
*!              dash.ado calls and the check left out
*!   PC-31      a variable named by an abbreviation -- in a qualifier, or
*!              among the words of its string literal -- on both routes
*!
*! A DISPLAY FORMAT IS USER TEXT.  Stata accepts %td!" and %td!` (a !
*! escapes any character into a date picture) and %tdDD!$DD, and all three
*! reached dash.ado as macro text: the first lost the variable's format on
*! every render (the saved list was passed in plain quotes), the second
*! refused every render with r(132) "too few quotes", and the third was
*! written to the spec as %tdDD! -- the $DD expanded as a global -- and lost
*! too.  A jsonio that failed left every date variable %12.0g.  Measured
*! 24sep2026 at 68327a8: `dash scatter y d, saving()' and `dash build',
*! with d %td!" or %tdDD!$DD, returned rc 0 and left d %12.0g, and with d
*! %td!` both were refused r(132) -- what PC-09 and PC-10 check.  PC-03,
*! PC-11 and PC-30 each fail with its fix reverted (BUGS.md).
*!
*! Hostile strings are assembled in Mata, where a string is a value, and
*! compared there or in Python: nothing here expands one as macro text.

cscript "every program and function has a behavioural test" adodir ".."

if "`c(python_exec)'" == "" {
    display as error "SKIP: Python not available."
    exit 222
}

// Sets $dash_nobrowser (cscript dropped it) and defines cert_file_has.
do "cert_helpers.do"
do "../dash_parse.mata"
do "../dash.ado"
quietly do "../dash_setup.ado"

local ls0 = c(linesize)
set linesize 255

// The hostile display formats, each accepted by Stata (measured with
// st_varformat, 24sep2026): a double quote, a backslash escaped and raw, a
// backtick, an apostrophe, a dollar alone and before a name, braces, a
// less-than, a </script> picture, one mixing a quote and a backtick, and
// the longest format Stata takes (49 characters).
mata:
_pc_hostile = ("%td!" + char(34),
               "%td!" + char(92),
               "%td" + char(92),
               "%td!" + char(96),
               "%td!" + char(39),
               "%td!" + char(36),
               "%tdDD!" + char(36) + "DD",
               "%td!{",
               "%td!}",
               "%td!<",
               "%td!<!/!s!c!r!i!p!t!>",
               "%tcHH!:MM!" + char(34) + "!" + char(96),
               "%td" + 23 * "!x")
st_numscalar("pc_nhostile", cols(_pc_hostile))
end
local nhost = pc_nhostile

// Python helpers.  No backslash, backtick or dollar sign is written in this
// block (the do-file expands them), and every call's value is assigned: a
// python block echoes a bare expression's value.
python:
import json as _pc_json
import os as _pc_os
import sys as _pc_sys
from sfi import Data as _pc_Data, Macro as _pc_M

def _pc_formats_ok():
    # pc_j: the map _dash_formats_json wrote; pc_vars: the variables it
    # should hold, in order.  Each value must be the variable's format as
    # Stata holds it, read here through sfi, not through dash.
    ok, why = 0, ""
    try:
        got = _pc_json.loads(_pc_M.getLocal("pc_j"))
        names = _pc_M.getLocal("pc_vars").split()
        want = [(n, _pc_Data.getVarFormat(n)) for n in names]
        ok = int(list(got.items()) == want)
        if not ok:
            why = repr((list(got.items()), want))
    except Exception as exc:
        why = repr(exc)
    _pc_M.setLocal("pc_ok", str(ok))
    _pc_M.setLocal("pc_why", why[:900])

# WP-29 P0.19 (PEP-01..16): the argument vectors a case expects, each
# element "F" standing for pip's three fixed flags, set as $PC_SB_EXPECT;
# and the shlex oracle of a command line naming c(python_exec).
def _pep_vec(vecs):
    flags = ["--disable-pip-version-check", "--no-input", "--only-binary=:all:"]
    out = []
    for v in vecs:
        w = []
        for a in v:
            if a == "F":
                w.extend(flags)
            else:
                w.append(a)
        out.append(w)
    _pc_M.setGlobal("PC_SB_EXPECT", _pc_json.dumps(out))

def _pep_oracle(name, *args):
    import shlex
    from sfi import SFIToolkit
    exe = SFIToolkit.macroExpand(chr(96) + "c(python_exec)'")
    _pc_M.setLocal(name, shlex.join([exe] + list(args)))

_pc_sys.path.insert(0, _pc_os.getcwd())
import setup_sandbox
end

// Report a failed check by value (the reason may hold any character) and
// stop the script.
capture program drop _pc_fail
program define _pc_fail
    args id
    mata: printf("{err}%s FAIL: %s\n", st_local("id"), st_global("PC_WHY"))
    exit 9
end

// WP-29 P0.19: a PEP case reports and the run goes on; the ids that failed
// are listed, and the script fails, after the last of them.
capture program drop _pep_fail
program define _pep_fail
    args id rc
    global PEP_FAILED `"$PEP_FAILED `id'"'
    mata: printf("{err}%s FAIL rc %s: %s\n", st_local("id"), st_local("rc"), st_global("PC_WHY"))
    global PC_WHY ""
end

// A case whose recorded process starts are not $PC_SB_EXPECT says what was
// recorded, then fails.
capture program drop _pep_match
program define _pep_match
    args match
    if "`match'" != "1" {
        mata: st_global("PC_WHY", st_global("PC_SB_WHY"))
        exit 9
    }
end


// ================================================================
// PC-01 -- _dash_formats_json: the map and the date variables
// ================================================================
clear
quietly set obs 3
generate double y = _n / 3
format y %9.2f
generate double d = mdy(1, _n, 2020)
format d %tdDD/NN/CCYY
generate double t = clock("2020-01-0" + string(_n) + " 10:30", "YMDhm")
format t %tcHH:MM
generate str8 s = "a"
format s %-8s
_dash_formats_json "y d t s" pc_j pc_dv
local pc_vars "y d t s"
python: _pc_formats_ok()
if "`pc_ok'" != "1" {
    mata: st_global("PC_WHY", st_local("pc_why"))
    _pc_fail PC-01
}
// The date variables, in order, and no other.
local pc_dv = strtrim("`pc_dv'")
assert "`pc_dv'" == "d t"
display "PC-01 PASS: the formats map holds each variable's format in order, and names d and t as dates"


// ================================================================
// PC-02 -- edge input: no variables, a name that is not one, every
//          date kind, and formats that are not dates
// ================================================================
_dash_formats_json "" pc_j pc_dv
assert `"`pc_j'"' == "{}"
assert strtrim("`pc_dv'") == ""
// A name that is not a variable is skipped, not written.
_dash_formats_json "y nosuchvariable d" pc_j pc_dv
local pc_vars "y d"
python: _pc_formats_ok()
assert "`pc_ok'" == "1"
assert strtrim("`pc_dv'") == "d"
// %t or %-t, then exactly one of the eight kind letters, case sensitively.
clear
quietly set obs 2
local k = 0
foreach f in %tc %tC %td %tw %tm %tq %th %ty %-tdCCYY-NN-DD %tg %9.0gc %10.0e %-20s {
    local ++k
    if "`f'" == "%-20s" {
        quietly generate str20 v`k' = "x"
    }
    else {
        quietly generate double v`k' = _n
    }
    format v`k' `f'
}
_dash_formats_json "v1 v2 v3 v4 v5 v6 v7 v8 v9 v10 v11 v12 v13" pc_j pc_dv
local pc_vars "v1 v2 v3 v4 v5 v6 v7 v8 v9 v10 v11 v12 v13"
python: _pc_formats_ok()
assert "`pc_ok'" == "1"
assert strtrim("`pc_dv'") == "v1 v2 v3 v4 v5 v6 v7 v8 v9"
display "PC-02 PASS: no variables give {}, a non-variable is skipped, the eight date kinds and %-t are dates and %tg is not"


// ================================================================
// PC-03 -- hostile formats reach the map exactly, as valid JSON
// ================================================================
clear
quietly set obs 3
generate double y = _n
generate double d = mdy(1, _n, 2020)
local pc_vars "y d"
forvalues i = 1/`nhost' {
    mata: st_varformat("d", _pc_hostile[`i'])
    capture noisily _dash_formats_json "y d" pc_j pc_dv
    local rc = _rc
    if `rc' != 0 {
        mata: st_global("PC_WHY", "format " + _pc_hostile[`i'] + ": rc " + st_local("rc"))
        _pc_fail PC-03
    }
    python: _pc_formats_ok()
    if "`pc_ok'" != "1" {
        mata: st_global("PC_WHY", "format " + _pc_hostile[`i'] + ": " + st_local("pc_why"))
        _pc_fail PC-03
    }
    if strtrim("`pc_dv'") != "d" {
        mata: st_global("PC_WHY", "format " + _pc_hostile[`i'] + " was not taken for a date")
        _pc_fail PC-03
    }
}
display "PC-03 PASS: `nhost' hostile formats each reach the map exactly, and each is a date"


// ================================================================
// PC-04 -- a Unicode variable name is a key as written
// ================================================================
clear
quietly set obs 2
mata: st_local("uvar", "caf" + char(195) + char(169))
quietly generate double `uvar' = _n
format `uvar' %9.1f
_dash_formats_json "`uvar'" pc_j pc_dv
local pc_vars "`uvar'"
python: _pc_formats_ok()
assert "`pc_ok'" == "1"
display "PC-04 PASS: a Unicode variable name keys its format as written"


// ================================================================
// PC-08 -- the immediate route carries a date format and leaves it
// ================================================================
clear
quietly set obs 5
generate double y = _n
generate double d = mdy(1, _n, 2020)
format d %tdDD/NN/CCYY
quietly datasignature
local sig0 "`r(datasignature)'"
local pg "`c(tmpdir)'pc08.html"
capture erase "`pg'"
local lg "`c(tmpdir)'pc08.log"
capture log close _pc08
quietly log using "`lg'", text replace name(_pc08)
capture noisily dash scatter y d, saving("`pg'")
local rc = _rc
quietly log close _pc08
assert `rc' == 0
confirm file "`pg'"
local fd : format d
assert "`fd'" == "%tdDD/NN/CCYY"
quietly datasignature
assert "`r(datasignature)'" == "`sig0'"
// The date reached the renderer as a number and its format as a date
// format: the x axis is a date axis, and no "arrived as text" note.
cert_file_has "`pg'", needle("DatetimeAxis")
assert r(found) == 1
cert_file_has "`lg'", needle("arrived as text")
assert r(found) == 0
capture erase "`pg'"
display "PC-08 PASS: dash scatter y d draws a date axis and leaves d's format and the data as they were"


// ================================================================
// PC-09 -- the immediate route with hostile formats
// ================================================================
forvalues i = 1/`nhost' {
    mata: st_varformat("d", _pc_hostile[`i'])
    capture erase "`pg'"
    capture noisily dash scatter y d, saving("`pg'")
    local rc = _rc
    mata: st_local("same", strofreal(st_varformat("d") == _pc_hostile[`i']))
    capture confirm file "`pg'"
    local made = (_rc == 0)
    if `rc' != 0 | "`same'" != "1" | `made' != 1 {
        mata: st_global("PC_WHY", "format " + _pc_hostile[`i'] + ": rc " + st_local("rc") + ", format now " + st_varformat("d") + ", page written " + st_local("made"))
        _pc_fail PC-09
    }
    cert_file_has "`pg'", needle("DatetimeAxis")
    if r(found) != 1 {
        mata: st_global("PC_WHY", "format " + _pc_hostile[`i'] + ": no date axis")
        _pc_fail PC-09
    }
    quietly datasignature
    assert "`r(datasignature)'" == "`sig0'"
}
capture erase "`pg'"
display "PC-09 PASS: `nhost' hostile date formats each draw a date axis on the immediate route and come back exactly"


// ================================================================
// PC-10 -- dash build with hostile formats
// ================================================================
forvalues i = 1/`nhost' {
    dash clear
    mata: st_varformat("d", _pc_hostile[`i'])
    quietly dash scatter y d, name(pc10)
    capture erase "`pg'"
    capture noisily dash build, saving("`pg'") replace
    local rc = _rc
    mata: st_local("same", strofreal(st_varformat("d") == _pc_hostile[`i']))
    capture confirm file "`pg'"
    local made = (_rc == 0)
    if `rc' != 0 | "`same'" != "1" | `made' != 1 {
        mata: st_global("PC_WHY", "format " + _pc_hostile[`i'] + ": rc " + st_local("rc") + ", format now " + st_varformat("d") + ", page written " + st_local("made"))
        _pc_fail PC-10
    }
    cert_file_has "`pg'", needle("DatetimeAxis")
    if r(found) != 1 {
        mata: st_global("PC_WHY", "format " + _pc_hostile[`i'] + ": no date axis")
        _pc_fail PC-10
    }
}
dash clear
capture erase "`pg'"
display "PC-10 PASS: `nhost' hostile date formats each draw a date axis through dash build and come back exactly"


// ================================================================
// PC-11 -- an export that fails leaves the formats as they were
// It failed inside jsonio until 24sep2026, and this test planted a jsonio
// that failed.  The data are now written by _dash_write_data, which refuses
// a binary strL, r(198) (test_string_values.cscript SV-07): the real
// failure.  No format is touched on the way now; this holds that none is
// left changed either.
// ================================================================
generate strL pcbin = "text"
mata: st_sstore(2, "pcbin", "a" + char(0) + "b")
// Captured as a whole, so pcbin is dropped whatever happens.
local rc1 = -1
local rc2 = -1
capture noisily {
    format d %tdDD/NN/CCYY
    capture erase "`pg'"
    capture noisily dash scatter y d, mlabel(pcbin) saving("`pg'")
    local rc1 = _rc
    local fd1 : format d
    format d %tdDD/NN/CCYY
    dash clear
    quietly dash scatter y d, mlabel(pcbin) name(pc11)
    capture noisily dash build, saving("`pg'") replace
    local rc2 = _rc
    local fd2 : format d
}
local pc11rc = _rc
capture drop pcbin
dash clear
capture erase "`pg'"
assert `pc11rc' == 0
// The failure is still the failure -- the writer's own code -- and the
// format is the user's again.
assert `rc1' == 198
assert `rc2' == 198
assert "`fd1'" == "%tdDD/NN/CCYY"
assert "`fd2'" == "%tdDD/NN/CCYY"
quietly datasignature
assert "`r(datasignature)'" == "`sig0'"
display "PC-11 PASS: when the export fails, both routes fail with its code and give the date format back"


// ================================================================
// PC-12 -- _dash_filter_setvars: each group's variable replaced by the
//          next full name, the rest of the group as written
// The whole suite called it once (test_help_claims_3.cscript HC3-16, one
// group with a comma): its no-comma branch, a second group, the ";"
// separator and a group with no name left had never run.
// ================================================================
mata:
_q = char(34)
_e = J(0, 1, .)
// One group, with and without its sub-options; blanks around the name.
_e = _e \ (_dash_filter_setvars("fore, type(dropdown)", "foreign") == "foreign, type(dropdown)")
_e = _e \ (_dash_filter_setvars("fore", "foreign") == "foreign")
_e = _e \ (_dash_filter_setvars("  fore  , type(dropdown)", "foreign") == "foreign, type(dropdown)")
_e = _e \ (_dash_filter_setvars("fore type(dropdown)", "foreign") == "foreign type(dropdown)")
// Two groups, by || and by ;, joined again with " || ".
_e = _e \ (_dash_filter_setvars("fore || rep, type(range)", "foreign rep78") == "foreign || rep78, type(range)")
_e = _e \ (_dash_filter_setvars("fore; rep", "foreign rep78") == "foreign || rep78")
// A label holding the separators, a comma or quotes stays whole.
_e = _e \ (_dash_filter_setvars("rep, label(" + _q + "A || B; C, D" + _q + ")", "rep78") == "rep78, label(" + _q + "A || B; C, D" + _q + ")")
_e = _e \ (_dash_filter_setvars("rep, label(" + char(96) + _q + "a " + _q + "b" + _q + " c" + _q + char(39) + ")", "rep78") == "rep78, label(" + char(96) + _q + "a " + _q + "b" + _q + " c" + _q + char(39) + ")")
// Macro and markup characters are data.
_e = _e \ (_dash_filter_setvars("rep, label(" + char(96) + "x" + char(39) + char(36) + "y{bf:z})", "rep78") == "rep78, label(" + char(96) + "x" + char(39) + char(36) + "y{bf:z})")
// More groups than names: the rest are kept as written.
_e = _e \ (_dash_filter_setvars("fore || rep || x", "foreign rep78") == "foreign || rep78 || x")
// No names, or no groups.
_e = _e \ (_dash_filter_setvars("fore, type(dropdown)", "") == "fore, type(dropdown)")
_e = _e \ (_dash_filter_setvars("", "foreign") == "")
// Its blanks are the six ASCII ones (_dash_is_blank, _dash_blank_trim):
// HC3-19 held the split to Python's with spaces alone.
for (_b = 9; _b <= 13; _b++) _e = _e \ (_dash_is_blank(char(_b)) == 1)
_e = _e \ (_dash_is_blank(" ") == 1)
_e = _e \ (_dash_is_blank("a") == 0)
_e = _e \ (_dash_is_blank("") == 0)
_e = _e \ (_dash_is_blank("  ") == 0)
_e = _e \ (_dash_is_blank(char(8)) == 0)
_e = _e \ (_dash_is_blank(char(194) + char(160)) == 0)
_e = _e \ (_dash_blank_trim(char(9) + char(10) + " a  b " + char(11) + char(12) + char(13)) == "a  b")
_e = _e \ (_dash_blank_trim(char(9) + " " + char(13)) == "")
_e = _e \ (_dash_blank_trim("") == "")
_e = _e \ (_dash_filter_setvars(char(9) + "fore" + char(13) + "," + char(10) + "type(range)", "foreign") == "foreign," + char(10) + "type(range)")
st_local("pc12", strofreal(all(_e)))
st_local("pc12n", strofreal(rows(_e)))
end
assert `pc12' == 1
display "PC-12 PASS: _dash_filter_setvars names each group by its full variable and keeps the rest of it whole, blanks being the six ASCII ones (`pc12n' checks)"


// ================================================================
// PC-13 -- dash build: abbreviated filter() variables, one with no
//          sub-option and one whose label holds || and ;, filter on the
//          variables they abbreviate
// ================================================================
sysuse auto, clear
dash clear
quietly dash scatter mpg weight, name(pc13)
local pg "`c(tmpdir)'pc13.html"
capture erase "`pg'"
local lg "`c(tmpdir)'pc13.log"
capture log close _pc13
quietly log using "`lg'", text replace name(_pc13)
capture noisily dash build, saving("`pg'") replace filter(fore) filter(rep, type(range) label("A || B; C"))
local rc = _rc
quietly log close _pc13
dash clear
assert `rc' == 0
cert_file_has "`lg'", needle("not in the data")
assert r(found) == 0
// foreign's dropdown, titled by its variable label, with its value labels
// GAPS2 X1 writes a numeric variable's option values typed, so the
// Domestic option is now [0.0,"Domestic"], not ["0","Domestic"].
mata: st_local("f1", strofreal(_cert_file_has(st_local("pg"), char(34) + "title" + char(34) + ":" + char(34) + "Car origin" + char(34) + "," + char(34) + "options" + char(34) + ":[[" + char(34) + "__all__" + char(34) + "," + char(34) + "All" + char(34) + "],[" + "0.0," + char(34) + "Domestic" + char(34) + "]", 0)))
// rep78's range slider, 1 to 5, titled by the label, whole
// GAPS2 G6/E3 put the slider's Stata display-format writer right after
// its title, so the title is now followed by "format":{ and the value
// [1.0,5.0] is checked on its own.
mata: st_local("f2", strofreal(_cert_file_has(st_local("pg"), char(34) + "title" + char(34) + ":" + char(34) + "A || B; C" + char(34) + "," + char(34) + "format" + char(34) + ":{", 0)))
mata: st_local("f3", strofreal(_cert_file_has(st_local("pg"), char(34) + "value" + char(34) + ":[1.0,5.0]", 0)))
assert `f1' == 1
assert `f2' == 1
assert `f3' == 1
capture erase "`pg'"
display "PC-13 PASS: filter(fore) and filter(rep, type(range) label(A || B; C)) filter on foreign and rep78"


// ================================================================
// dash_setup end to end
// ================================================================
// dash_setup installs through pip, run by subprocess.run inside python:.
// test/setup_sandbox.py closes that door before each run (every process
// start is recorded and none is made; sys.executable and PATH lead to
// recording stubs).  Until 24sep2026 it also ran `ssc install jsonio,
// replace'; this ssc still stands in for SSC, so any SSC call dash_setup
// made again would be recorded, not made.  A program in memory is found
// before an ado-file.  Its return code is $PC_SSC_RC.
capture program drop ssc
program define ssc
    mata: st_global("PC_SSC_CALLS", st_global("PC_SSC_CALLS") + "[" + strtrim(st_local("0")) + "]")
    exit ${PC_SSC_RC}
end

// dash's own directory (PC-23), and a stand-in renderer whose scheme
// parser can read no scheme (PC-26).  Each is written into an ado-path in
// compound quotes, as adopath writes a directory, so a path with a space
// in it stays one entry.
quietly cd ..
local pc_dashdir "`c(pwd)'"
quietly cd "`pc_dashdir'/test"
local pc_stubr "`c(tmpdir)'pc_stub_render"
capture mkdir "`pc_stubr'"
mata:
// A run that stopped early leaves it behind, and fopen(, "w") will not
// replace a file.
if (fileexists(st_local("pc_stubr") + "/dash_render.py")) unlink(st_local("pc_stubr") + "/dash_render.py")
_fh = fopen(st_local("pc_stubr") + "/dash_render.py", "w")
fput(_fh, "class _Fallback:")
fput(_fh, "    is_fallback = True")
fput(_fh, "class SchemeParser:")
fput(_fh, "    @staticmethod")
fput(_fh, "    def resolve_or_fallback(name, who):")
fput(_fh, "        return _Fallback()")
fclose(_fh)
_q = char(96) + char(34)
_qq = char(34) + char(39)
st_local("pc_ado_nodash", "BASE")
st_local("pc_ado_dash", "BASE;" + _q + st_local("pc_dashdir") + "/" + _qq)
st_local("pc_ado_stubr", "BASE;" + _q + st_local("pc_stubr") + "/" + _qq)
end

// One run of dash_setup inside the sandbox.
//   $PC_SB_SPEC   the simulated state (JSON; see setup_sandbox.install)
//   $PC_SB_ADO    the ado-path to run under ("" keeps it)
//   $PC_SSC_RC    the stand-in ssc's return code
//   $PC_SB_EXPECT the argument vectors pip is expected to be run with
//   $PC_SB_CMD    the command to run ("" runs plain dash_setup; WP-29 P0.19)
// Returns r(rc), r(match) (1 when the recorded process starts are exactly
// $PC_SB_EXPECT and no PATH stub ran) and r(ncalls); $PC_SSC_CALLS holds
// the ssc calls and $PC_SB_WHY what was recorded when r(match) is 0.  The
// log is `c(tmpdir)'pc_setup.log.  It also returns dash_setup's
// r(hint_cmd), r(venv_python), r(venv_linked) and r(externally_managed),
// and what the first recorded pip install was started with: r(pip_cwd),
// r(pip_cwdgone), r(pip_pp), r(pip_bsp), r(pip_puser), r(pip_dwb) and
// r(pip_umask) (setup_sandbox.stata_pip_kwargs).
capture program drop _pc_setup
program define _pc_setup, rclass
    local lg "`c(tmpdir)'pc_setup.log"
    capture erase "`lg'"
    global PC_SSC_CALLS ""
    python: import setup_sandbox; setup_sandbox.stata_install()
    if "`pc_sb_ok'" != "1" {
        mata: printf("{err}the sandbox refused to install: %s\n", st_local("pc_sb_why"))
        exit 9
    }
    // Everything between the install and the restore is captured, so the
    // ado-path and Python are put back whatever happens in it.
    mata: st_local("ado0", st_global("S_ADO"))
    local rc = -1
    capture noisily {
        if `"$PC_SB_ADO"' != "" {
            mata: st_global("S_ADO", st_global("PC_SB_ADO"))
        }
        capture log close _pcsetup
        quietly log using "`lg'", text replace name(_pcsetup)
        // The command is run from the global by value, so a path holding a
        // double quote reaches dash_setup as typed (PEP-11).
        mata: st_local("pc_hascmd", strofreal(st_global("PC_SB_CMD") != ""))
        if `pc_hascmd' {
            mata: st_local("rc", strofreal(_stata(st_global("PC_SB_CMD"))))
        }
        else {
            capture noisily dash_setup
            local rc = _rc
        }
        mata: st_local("pc_hint", st_global("r(hint_cmd)"))
        mata: st_local("pc_vpy", st_global("r(venv_python)"))
        mata: st_local("pc_vlinked", st_global("r(venv_linked)"))
        mata: st_local("pc_em", st_global("r(externally_managed)"))
        quietly log close _pcsetup
    }
    local brc = _rc
    capture log close _pcsetup
    mata: st_global("S_ADO", st_local("ado0"))
    python: import setup_sandbox; setup_sandbox.stata_pip_kwargs()
    python: import setup_sandbox; setup_sandbox.stata_verdict()
    python: import setup_sandbox; setup_sandbox.restore()
    python: import setup_sandbox; setup_sandbox.stata_restored()
    mata: st_global("PC_SB_WHY", st_local("pc_sb_mwhy"))
    if "`pc_sb_clean'" != "1" {
        display as error "the sandbox did not restore Python"
        exit 9
    }
    if `brc' != 0 {
        exit `brc'
    }
    return scalar rc = `rc'
    return scalar match = `pc_sb_match'
    return scalar ncalls = `pc_sb_n'
    return local hint_cmd `"`pc_hint'"'
    return local venv_python `"`pc_vpy'"'
    return local venv_linked "`pc_vlinked'"
    return local externally_managed "`pc_em'"
    foreach k in cwd cwdgone pp bsp puser dwb umask {
        return local pip_`k' "`pc_sb_`k''"
    }
end

// Does the setup log hold a phrase?  Searched in Mata, by value, in the
// log's logical lines: Stata wraps a line at the column, anywhere, so a
// phrase is looked for with the wrapped pieces re-joined.  r(found) is -1
// when the log cannot be read.
capture program drop _pc_said
program define _pc_said, rclass
    args phrase
    mata: st_local("n", strofreal(_cert_log_count(st_global("PC_SETUP_LOG"), st_local("phrase"), 0)))
    return scalar found = cond(`n' < 0, -1, `n' > 0)
end
global PC_SETUP_LOG "`c(tmpdir)'pc_setup.log"


// ================================================================
// PC-14 -- the sandbox itself: a process start is recorded, not made,
//          and restore gives Python back
// ================================================================
global PC_SB_SPEC "{}"
python: setup_sandbox.stata_install()
assert "`pc_sb_ok'" == "1"
local mk "`c(tmpdir)'pc12_marker"
capture erase "`mk'"
python: import subprocess as _pc_sp, sfi as _pc_sfi; _pc_r = _pc_sp.run([_pc_sys.executable, "-c", "open(" + repr(_pc_sfi.Macro.getLocal("mk")) + ", 'w').close()"], capture_output=True, text=True)
global PC_SB_EXPECT `"[["PYTHON", "-c", "open('`mk'', 'w').close()"]]"'
python: setup_sandbox.stata_verdict()
python: setup_sandbox.restore()
python: setup_sandbox.stata_restored()
capture confirm file "`mk'"
assert _rc != 0
assert "`pc_sb_match'" == "1"
assert "`pc_sb_clean'" == "1"
display "PC-14 PASS: inside the sandbox a process start is recorded and not made, and restore puts subprocess and sys.executable back"


// ================================================================
// PC-15 -- every dependency present: dash_setup verifies and reports,
//          and starts no process and no ssc
// ================================================================
global PC_SB_SPEC "{}"
global PC_SB_ADO ""
global PC_SSC_RC 0
global PC_SB_EXPECT "[]"
_pc_setup
local rc = r(rc)
local match = r(match)
assert `rc' == 0
assert `match' == 1
assert `"$PC_SSC_CALLS"' == ""
foreach p in "Stata .............. OK (version" ///
    "Python ............. OK (version" "bokeh ............. OK (version" ///
    "numpy ............. OK (version" "pandas ............. OK (version" ///
    "dash_render.py ..... OK" "schemes ............ OK" ///
    "dash_setup complete. All dependencies are satisfied." {
    _pc_said "`p'"
    assert r(found) == 1
}
_pc_said "jsonio"
assert r(found) == 0
display "PC-15 PASS: with every dependency present dash_setup reports each OK, exits 0 and installs nothing"


// ================================================================
// PC-16 -- Python below the minimum is counted, and the run goes on
// ================================================================
// The minimum is read from _dash_pymin, never copied (WP-30 P1.33).
_dash_pymin
local pymin "`r(pymin)'"
global PC_SB_SPEC `"{"pyversion": "3.7.9 (dash test sandbox)"}"'
_pc_setup
local rc = r(rc)
local match = r(match)
assert `rc' == 198
assert `match' == 1
foreach p in "version 3.7.9 is below the minimum `pymin'." ///
    "bokeh ............. OK (version" "dash_render.py ..... OK" ///
    "dash_setup did not complete: 1 unmet requirement(s)." ///
    "Unmet:  Python 3.7.9 (needs `pymin')" {
    _pc_said "`p'"
    assert r(found) == 1
}
_pc_said "All dependencies are satisfied"
assert r(found) == 0
display "PC-16 PASS: Python 3.7.9 is reported below the minimum, every other check still runs, and the run fails naming it"


// ================================================================
// PC-17 -- a Python version that cannot be read is not a failure
// ================================================================
_dash_pymin
local pymin "`r(pymin)'"
global PC_SB_SPEC `"{"pyversion": "abc (dash test sandbox)"}"'
_pc_setup
local rc = r(rc)
assert `rc' == 0
assert r(match) == 1
_pc_said "OK (version abc; could not be compared to `pymin')"
assert r(found) == 1
display "PC-17 PASS: an unreadable Python version is reported as such and does not fail the run"


// ================================================================
// PC-18 -- packaging missing: one pip install, then a warning
// ================================================================
// WP-29 P0.19: the linked Python is inspected first (DETECT), and pip runs
// c(python_exec), not sys.executable (N2), with -P and its fixed flags (N3).
global PC_SB_SPEC `"{"block": ["packaging"]}"'
python: _pep_vec([["PYTHON_EXEC", "-c", "<ANY>"], ["PYTHON_EXEC", "-P", "-m", "pip", "install", "F", "packaging"]])
_pc_setup
local rc = r(rc)
local match = r(match)
if `match' != 1 {
    // _pc_setup leaves what the sandbox recorded in $PC_SB_WHY.
    mata: st_global("PC_WHY", st_global("PC_SB_WHY"))
    _pc_fail PC-18
}
assert `rc' == 0
foreach p in "packaging .......... missing" "could not install" ///
    "(not verified against 3.8)" "(not verified against 2.3)" ///
    "dash_setup complete, with 1 warning(s)." ///
    "Warned:  packaging (version checks approximate)" {
    _pc_said "`p'"
    assert r(found) == 1
}
display "PC-18 PASS: without packaging, pip is asked for it once, versions are unverified, and the run ends with one warning"


// ================================================================
// PC-19 -- bokeh missing and not installable: the minimum reaches pip,
//          --user is tried once, and the run stops there
// ================================================================
// WP-29 P0.19: DETECT first, pip runs c(python_exec) with its flags, and
// the manual line is the shlex oracle (the bare `python -m pip install
// bokeh>=3.8' a shell runs as an unpinned install writing a file =3.8).
global PC_SB_SPEC `"{"block": ["bokeh"]}"'
python: _pep_vec([["PYTHON_EXEC", "-c", "<ANY>"], ["PYTHON_EXEC", "-P", "-m", "pip", "install", "F", "bokeh>=3.8"], ["PYTHON_EXEC", "-P", "-m", "pip", "install", "F", "--user", "bokeh>=3.8"]])
python: _pep_oracle("pc19want", "-m", "pip", "install", "bokeh>=3.8")
_pc_setup
local rc = r(rc)
local match = r(match)
mata: st_local("pc19hint", strofreal(st_global("r(hint_cmd)") == st_local("pc19want")))
if `match' != 1 {
    // _pc_setup leaves what the sandbox recorded in $PC_SB_WHY.
    mata: st_global("PC_WHY", st_global("PC_SB_WHY"))
    _pc_fail PC-19
}
assert `rc' == 198
assert `pc19hint' == 1
foreach p in "bokeh ............. missing" "retrying with --user..." ///
    "Failed to install bokeh. Please install manually:" ///
    "Unmet:  bokeh (could not install)" {
    _pc_said "`p'"
    assert r(found) == 1
}
_pc_said `"`pc19want'"'
assert r(found) == 1
_pc_said "numpy ............."
assert r(found) == 0
display "PC-19 PASS: a bokeh pip cannot install is asked for as bokeh>=3.8, retried with --user, and stops the run"


// ================================================================
// PC-20 -- bokeh missing and installed: one pip run, no retry
// ================================================================
// WP-29 P0.19: DETECT first, then pip with c(python_exec) and its flags.
global PC_SB_SPEC `"{"block": ["bokeh"], "unblock_on_install": ["bokeh"]}"'
python: _pep_vec([["PYTHON_EXEC", "-c", "<ANY>"], ["PYTHON_EXEC", "-P", "-m", "pip", "install", "F", "bokeh>=3.8"]])
_pc_setup
local rc = r(rc)
local match = r(match)
if `match' != 1 {
    // _pc_setup leaves what the sandbox recorded in $PC_SB_WHY.
    mata: st_global("PC_WHY", st_global("PC_SB_WHY"))
    _pc_fail PC-20
}
assert `rc' == 0
_pc_said "bokeh ............. OK (version"
assert r(found) == 1
_pc_said "retrying with --user"
assert r(found) == 0
display "PC-20 PASS: a bokeh that installs is installed once, never retried, and reported OK"


// ================================================================
// PC-21 -- bokeh below its minimum is reported, not upgraded
// ================================================================
// WP-29 P0.19: the below verdict asks whether the Python is managed
// (DETECT; N4), and the upgrade line is the shlex oracle.
global PC_SB_SPEC `"{"fake": [["bokeh", "2.4.3"]]}"'
python: _pep_vec([["PYTHON_EXEC", "-c", "<ANY>"]])
_pc_setup
local rc = r(rc)
local match = r(match)
if `match' != 1 {
    mata: st_global("PC_WHY", st_global("PC_SB_WHY"))
    _pc_fail PC-21
}
assert `rc' == 198
// Q27: the upgrade line names the interpreter Stata is linked to.
python: _pep_oracle("pc21wantcmd", "-m", "pip", "install", "bokeh>=3.8")
foreach p in "2.4.3 (below minimum 3.8)" ///
    "Unmet:  bokeh 2.4.3 (needs 3.8)" {
    _pc_said "`p'"
    assert r(found) == 1
}
_pc_said `"`pc21wantcmd'"'
assert r(found) == 1
display "PC-21 PASS: bokeh 2.4.3 is reported below 3.8 with the c(python_exec) upgrade command, and nothing is installed"


// ================================================================
// PC-22 -- a hostile installed version is not shown, and not SMCL
// ================================================================
global PC_SB_SPEC `"{"fake": [["bokeh", "3.9{bf:PCVERMARK}x"]]}"'
global PC_SB_EXPECT "[]"
_pc_setup
local rc = r(rc)
assert `rc' == 0
assert r(match) == 1
_pc_said "bokeh ............. installed (version could not be read)"
assert r(found) == 1
_pc_said "PCVERMARK"
assert r(found) == 0
display "PC-22 PASS: a version that is not made of version characters is reported unreadable and never displayed"


// ================================================================
// PC-23 -- jsonio off the ado-path: dash_setup neither asks SSC for it
//          nor names it
// ================================================================
// dash writes its data from Python (_dash_write_data) and has not used
// jsonio since 24sep2026, but dash_setup still asked SSC for it when it
// was missing and failed the run, r(198), if SSC could not supply it.
// Here the ado-path is Stata's BASE and dash's own directory only, and the
// stand-in SSC fails every call: the run must complete, call SSC never,
// and say nothing of jsonio.
mata: st_global("PC_SB_ADO", st_local("pc_ado_dash"))
capture findfile jsonio.ado, path(`"$PC_SB_ADO"')
local pc23off = (_rc != 0)
global PC_SB_SPEC "{}"
global PC_SB_EXPECT "[]"
global PC_SSC_RC 631
_pc_setup
local rc = r(rc)
local match = r(match)
_pc_said "jsonio"
local pc23said = r(found)
_pc_said "dash_setup complete. All dependencies are satisfied."
local pc23ok = r(found)
display as text "  PC-23: jsonio off the path `pc23off', rc `rc', SSC calls [$PC_SSC_CALLS], jsonio named `pc23said'"
assert `pc23off' == 1
assert `match' == 1
assert `"$PC_SSC_CALLS"' == ""
assert `pc23said' == 0
assert `rc' == 0
assert `pc23ok' == 1
display "PC-23 PASS: with jsonio off the ado-path dash_setup completes, asks SSC for nothing and never names jsonio"


// ================================================================
// PC-25 -- dash's renderer not reachable
// ================================================================
mata: st_global("PC_SB_ADO", st_local("pc_ado_nodash"))
_pc_setup
local rc = r(rc)
assert `rc' == 198
assert `"$PC_SSC_CALLS"' == ""
foreach p in "dash_render.py ..... not found" ///
    "Unmet:  dash's own files" {
    _pc_said "`p'"
    assert r(found) == 1
}
display "PC-25 PASS: a dash_render.py that is not on the ado-path fails the run naming dash's own files"


// ================================================================
// PC-26 -- a renderer that can read no scheme
// ================================================================
mata: st_global("PC_SB_ADO", st_local("pc_ado_stubr"))
_pc_setup
local rc = r(rc)
assert `rc' == 198
foreach p in "dash_render.py ..... OK" "schemes ............ unreachable" ///
    "Unmet:  dash's own files" {
    _pc_said "`p'"
    assert r(found) == 1
}
display "PC-26 PASS: a renderer that falls back for every scheme fails the run"


// ================================================================
// PEP-01..16 -- dash_setup on externally managed (PEP 668) Pythons, and
//               dash_setup, venv(path) (WP-29 P0.19, GAPS2 H7, N1-N4)
// ================================================================
// Each case runs dash_setup in the sandbox, which answers dash_setup_lib's
// DETECT probe (the linked Python: ordinary, externally managed, in a venv,
// without pip), its venv and VERIFY steps, and replays pip's measured
// refusals (test/fixtures/pip_refusals.json); nothing is installed.  Each
// case reports and the run goes on; the ids that failed are listed after
// the last one.  DETECT is [PYTHON_EXEC, "-c", <code>]; "F" stands for
// pip's three fixed flags (_pep_vec).
global PEP_FAILED ""
global PC_SB_ADO ""
global PC_SSC_RC 0
local pep_tmp "`c(tmpdir)'"

// ---- PEP-01: a managed Python, bokeh missing: no pip, the PEP 668 way ----
capture noisily {
    global PC_SB_SPEC `"{"block": ["bokeh"], "env": {"managed": true}}"'
    global PC_SB_CMD ""
    python: _pep_vec([["PYTHON_EXEC", "-c", "<ANY>"]])
    _pc_setup
    local rc = r(rc)
    local m = r(match)
    local em "`r(externally_managed)'"
    mata: st_local("hint", st_global("r(hint_cmd)"))
    _pep_match `m'
    assert `rc' == 198
    assert "`em'" == "1"
    mata: st_local("hintok", strofreal(st_local("hint") == "dash_setup, venv(" + char(34) + "~/.dash/venv" + char(34) + ")"))
    assert `hintok' == 1
    foreach p in "This Python is externally managed (PEP 668):" ///
        "bokeh (externally managed Python)" {
        _pc_said "`p'"
        assert r(found) == 1
    }
    _pc_said "break-system-packages"
    assert r(found) == 0
    display "PEP-01 PASS: on a managed Python a missing bokeh starts no pip, names PEP 668 and suggests venv(), r(198)"
}
if _rc _pep_fail PEP-01 `=_rc'

// ---- PEP-02: a managed Python, only packaging missing: a warning, rc 0 ----
capture noisily {
    global PC_SB_SPEC `"{"block": ["packaging", "packaging.version"], "env": {"managed": true}}"'
    global PC_SB_CMD ""
    python: _pep_vec([["PYTHON_EXEC", "-c", "<ANY>"]])
    _pc_setup
    local rc = r(rc)
    _pep_match `r(match)'
    assert `rc' == 0
    _pc_said "packaging (version checks approximate)"
    assert r(found) == 1
    _pc_said "break-system-packages"
    assert r(found) == 0
    display "PEP-02 PASS: on a managed Python a missing packaging alone starts no pip and is a warning, rc 0"
}
if _rc _pep_fail PEP-02 `=_rc'

// ---- PEP-03: pip itself refuses (PEP 668): no --user retry, pip's
//      advice to override is not shown ----
capture noisily {
    global PC_SB_SPEC `"{"block": ["bokeh"], "pip": {"rc": 1, "stderr": "externally_managed"}}"'
    global PC_SB_CMD ""
    python: _pep_vec([["PYTHON_EXEC", "-c", "<ANY>"], ["PYTHON_EXEC", "-P", "-m", "pip", "install", "F", "bokeh>=3.8"]])
    _pc_setup
    local rc = r(rc)
    _pep_match `r(match)'
    assert `rc' == 198
    foreach p in "error: externally-managed-environment" ///
        "This Python is externally managed (PEP 668):" {
        _pc_said "`p'"
        assert r(found) == 1
    }
    foreach p in "break-system-packages" "retrying with --user" {
        _pc_said "`p'"
        assert r(found) == 0
    }
    display "PEP-03 PASS: a PEP 668 refusal from pip is not retried with --user and shows dash's guidance, not pip's override, r(198)"
}
if _rc _pep_fail PEP-03 `=_rc'

// ---- PEP-04: a Python without pip: the ensurepip line, no pip ----
capture noisily {
    global PC_SB_SPEC `"{"block": ["bokeh"], "env": {"pip": false}}"'
    global PC_SB_CMD ""
    python: _pep_vec([["PYTHON_EXEC", "-c", "<ANY>"]])
    python: _pep_oracle("want", "-m", "ensurepip", "--upgrade")
    _pc_setup
    local rc = r(rc)
    mata: st_local("hint", st_global("r(hint_cmd)"))
    _pep_match `r(match)'
    assert `rc' == 198
    mata: st_local("hintok", strofreal(st_local("hint") == st_local("want")))
    assert `hintok' == 1
    _pc_said "This Python has no pip:"
    assert r(found) == 1
    display "PEP-04 PASS: a Python without pip is not asked to run it, and the ensurepip line names c(python_exec), r(198)"
}
if _rc _pep_fail PEP-04 `=_rc'

// ---- PEP-05: a venv-linked Python: pip runs c(python_exec), no --user ----
capture noisily {
    global PC_SB_SPEC `"{"block": ["bokeh"], "env": {"in_venv": true}}"'
    global PC_SB_CMD ""
    python: _pep_vec([["PYTHON_EXEC", "-c", "<ANY>"], ["PYTHON_EXEC", "-P", "-m", "pip", "install", "F", "bokeh>=3.8"]])
    _pc_setup
    local rc = r(rc)
    _pep_match `r(match)'
    assert `rc' == 198
    _pc_said "retrying with --user"
    assert r(found) == 0
    display "PEP-05 PASS: in a venv pip runs the linked interpreter and is never retried with --user, r(198)"
}
if _rc _pep_fail PEP-05 `=_rc'

// ---- PEP-06: a --user install is found in the same run ----
capture noisily {
    global PC_SB_SPEC `"{"block": ["bokeh"], "user_site_gate": "bokeh"}"'
    global PC_SB_CMD ""
    python: _pep_vec([["PYTHON_EXEC", "-c", "<ANY>"], ["PYTHON_EXEC", "-P", "-m", "pip", "install", "F", "bokeh>=3.8"], ["PYTHON_EXEC", "-P", "-m", "pip", "install", "F", "--user", "bokeh>=3.8"]])
    _pc_setup
    local rc = r(rc)
    _pep_match `r(match)'
    assert `rc' == 0
    _pc_said "bokeh ............. OK"
    assert r(found) == 1
    display "PEP-06 PASS: a package --user installed is added to sys.path and imports in the same run, rc 0"
}
if _rc _pep_fail PEP-06 `=_rc'

// ---- PEP-07: how pip is started: a private, removed directory, no
//      PYTHONPATH, PEP 668 forced on, no --user from config, no bytecode,
//      umask 022 ----
capture noisily {
    global PC_SB_SPEC `"{"block": ["bokeh"], "unblock_on_install": ["bokeh"], "pythonpath": "/dash/hostile/pythonpath"}"'
    global PC_SB_CMD ""
    python: _pep_vec([["PYTHON_EXEC", "-c", "<ANY>"], ["PYTHON_EXEC", "-P", "-m", "pip", "install", "F", "bokeh>=3.8"]])
    _pc_setup
    local rc = r(rc)
    local m = r(match)
    foreach k in cwd cwdgone pp bsp puser dwb umask {
        local p_`k' "`r(pip_`k')'"
    }
    display as text "  PEP-07: cwd [`p_cwd'] gone [`p_cwdgone'] PYTHONPATH [`p_pp'] BSP [`p_bsp'] PIP_USER [`p_puser'] DWB [`p_dwb'] umask [`p_umask']"
    _pep_match `m'
    assert `rc' == 0
    assert `"`p_cwd'"' != ""
    assert `"`p_cwd'"' != `"`c(pwd)'"'
    assert "`p_cwdgone'" == "1"
    assert "`p_pp'" == "0"
    assert "`p_bsp'" == "0"
    assert "`p_puser'" == "0"
    assert "`p_dwb'" == "1"
    assert "`p_umask'" == "18"
    display "PEP-07 PASS: pip runs from a private directory it removes, without PYTHONPATH, with PEP 668 forced on, umask 022"
}
if _rc _pep_fail PEP-07 `=_rc'

// ---- PEP-08: dash_setup, venv(): created, installed, verified, linked by
//      the printed line ----
capture noisily {
    local p08 "`pep_tmp'pep08 dir"
    python: import shutil, sfi; shutil.rmtree(sfi.Macro.getLocal("p08"), True)
    mata: mkdir(st_local("p08"))
    mata: st_global("PC_SB_CMD", "dash_setup, venv(" + char(34) + st_local("p08") + "/venv" + char(34) + ")")
    global PC_SB_SPEC `"{"pip": {"rc": 0}}"'
    python: import os, sfi; _pep_a = os.path.join(os.path.realpath(sfi.Macro.getLocal("p08")), "venv"); _pep_py = os.path.join(_pep_a, "bin", "python"); _pep_r = os.path.normpath(os.path.join(sfi.SFIToolkit.macroExpand(chr(96) + "c(pwd)'"), "..", "dash_render.py")); sfi.Macro.setLocal("a08", _pep_a); sfi.Macro.setLocal("py08", _pep_py)
    python: _pep_vec([["PYTHON_EXEC", "-P", "-m", "venv", _pep_a], [_pep_py, "-c", "<ANY>"], [_pep_py, "-P", "-m", "pip", "install", "F", "packaging", "bokeh>=3.8", "numpy>=2.3", "pandas>=2.3"], [_pep_py, "-P", "-c", "<ANY>", "<ANY>", _pep_r]])
    _pc_setup
    local rc = r(rc)
    local m = r(match)
    mata: st_local("vpy", st_global("r(venv_python)"))
    mata: st_local("hint", st_global("r(hint_cmd)"))
    local vl "`r(venv_linked)'"
    python: import shutil, sfi; shutil.rmtree(sfi.Macro.getLocal("p08"), True)
    _pep_match `m'
    assert `rc' == 0
    mata: st_local("vpyok", strofreal(st_local("vpy") == st_local("py08")))
    mata: st_local("hintok", strofreal(st_local("hint") == "python set exec " + char(34) + st_local("py08") + char(34) + ", permanently"))
    assert `vpyok' == 1
    assert `hintok' == 1
    assert "`vl'" == "0"
    _pc_said "dash_setup complete for the environment named above."
    assert r(found) == 1
    _pc_said "All dependencies are satisfied"
    assert r(found) == 0
    display "PEP-08 PASS: venv() creates, installs into and verifies the environment and returns its python set exec line, rc 0"
}
if _rc _pep_fail PEP-08 `=_rc'

// ---- PEP-09..12: venv() paths refused before anything runs ----
// 09 a directory that is neither empty nor a venv; 10 a venv others can
// write; 11 a path holding a double quote (built in Mata: it reaches the
// option as typed, M9); 12 a symbolic link.
python: import os, sfi; _pep_t = sfi.Macro.getLocal("pep_tmp"); os.makedirs(os.path.join(_pep_t, "pep09"), exist_ok=True); open(os.path.join(_pep_t, "pep09", "x"), "w").close()
python: import os, sfi; _pep_t = sfi.Macro.getLocal("pep_tmp"); os.makedirs(os.path.join(_pep_t, "pep10", "bin"), exist_ok=True); open(os.path.join(_pep_t, "pep10", "pyvenv.cfg"), "w").close(); os.chmod(os.path.join(_pep_t, "pep10"), 0o775)
python: import os, sfi; _pep_t = sfi.Macro.getLocal("pep_tmp"); os.makedirs(os.path.join(_pep_t, "pep12real"), exist_ok=True); (os.path.lexists(os.path.join(_pep_t, "pep12link")) or os.symlink(os.path.join(_pep_t, "pep12real"), os.path.join(_pep_t, "pep12link")))
local pep_n 8
foreach pair in "pep09|is not empty and is not a virtual environment" ///
        "pep10|can be written by other users" ///
        "pep11|holds a character dash_setup will not put in a command" ///
        "pep12link|is a symbolic link" {
    local ++pep_n
    local pid = "PEP-" + string(`pep_n', "%02.0f")
    gettoken dir why : pair, parse("|")
    local why = substr("`why'", 2, .)
    capture noisily {
        global PC_SB_SPEC "{}"
        global PC_SB_EXPECT "[]"
        if "`dir'" == "pep11" {
            mata: st_global("PC_SB_CMD", "dash_setup, venv(" + char(96) + char(34) + st_local("pep_tmp") + "pep11" + char(34) + "x" + char(34) + char(39) + ")")
        }
        else {
            mata: st_global("PC_SB_CMD", "dash_setup, venv(" + char(34) + st_local("pep_tmp") + st_local("dir") + char(34) + ")")
        }
        _pc_setup
        local rc = r(rc)
        _pep_match `r(match)'
        assert `rc' == 198
        _pc_said "`why'"
        assert r(found) == 1
        _pc_said "venv() (path refused)"
        assert r(found) == 1
        display "`pid' PASS: venv() refuses a path that `why', before anything runs, r(198)"
    }
    if _rc _pep_fail `pid' `=_rc'
}
python: import shutil, os, sfi; _pep_t = sfi.Macro.getLocal("pep_tmp"); [shutil.rmtree(os.path.join(_pep_t, d), True) for d in ("pep09", "pep10", "pep12real")]; os.path.lexists(os.path.join(_pep_t, "pep12link")) and os.remove(os.path.join(_pep_t, "pep12link"))

// ---- PEP-13: venv() on a linked Python below the floor starts nothing ----
capture noisily {
    _dash_pymin
    local pymin "`r(pymin)'"
    global PC_SB_SPEC `"{"pyversion": "3.10.10 (dash test sandbox)"}"'
    global PC_SB_EXPECT "[]"
    mata: st_global("PC_SB_CMD", "dash_setup, venv(" + char(34) + st_local("pep_tmp") + "pep13" + char(34) + ")")
    _pc_setup
    local rc = r(rc)
    _pep_match `r(match)'
    assert `rc' == 198
    _pc_said "venv() ............ not started: Python 3.10.10 is below `pymin'."
    assert r(found) == 1
    capture confirm file "`pep_tmp'pep13/pyvenv.cfg"
    assert _rc != 0
    display "PEP-13 PASS: venv() on a Python below the minimum starts no process, r(198)"
}
if _rc _pep_fail PEP-13 `=_rc'

// ---- PEP-14: a reused venv whose Python is below the floor ----
