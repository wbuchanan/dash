global PC_SB_CMD ""
global PC_SB_ADO ""

global PC_SB_ADO ""
capture program drop ssc
capture erase "`pc_stubr'/dash_render.py"
capture rmdir "`pc_stubr'"
python: setup_sandbox.stata_restored()
assert "`pc_sb_clean'" == "1"


// ================================================================
// PC-28 -- _json_escape: every byte below 0x20 and the three characters a
//          macro could misread (backtick, dollar, apostrophe) escaped, and
//          the text read back by JSON as the original.  It went through
//          _dash_json_esc, which WP-26 deleted with _html_escape and
//          _dash_html_esc (PC-27) and _dash_kv_json (PC-29): nothing called
//          them (24sep2026).
// ================================================================
mata:
_s = "a" + char(34) + "b" + char(92) + "c" + char(96) + char(36) + char(39)
for (_c = 1; _c <= 31; _c++) _s = _s + char(_c)
st_global("PC26_RAW", _s)
st_global("PC26_ESC", _json_escape(_s))
st_local("pc26empty", strofreal(_json_escape("") == ""))
end
assert `pc26empty' == 1
python: _pc_M.setLocal("pc26rt", str(int(_pc_json.loads(chr(34) + _pc_M.getGlobal("PC26_ESC") + chr(34)) == _pc_M.getGlobal("PC26_RAW"))))
assert "`pc26rt'" == "1"
// No raw control byte, backtick, dollar or apostrophe is left.
mata: st_local("pc26raw", strofreal(regexm(st_global("PC26_ESC"), "[" + char(1) + "-" + char(31) + char(96) + char(36) + char(39) + "]")))
assert `pc26raw' == 0
macro drop PC26_RAW PC26_ESC
display "PC-28 PASS: _json_escape writes text JSON reads back as the original, with no raw control byte, backtick, dollar or apostrophe"


// ================================================================
// PC-30 -- the Mata library check names every function dash.ado calls
// _dash_require_mata reloads dash's Mata library when it is gone and then
// checks, by name, that every function dash.ado calls is there.  Its list
// left out _dash_path_badchar, which _dash_validate_path calls, so a
// library that compiled without it passed the check and the first saving()
// ended in "_dash_path_badchar() not found", r(3499), naming an internal
// function (measured 24sep2026).  A copy of the library that lacks only
// that function is staged first on the ado-path, and Mata is cleared, so
// the check loads the copy the way it loads a partial install.  Last,
// because `mata clear' drops this script's Mata helpers too.
// ================================================================
local stage "`c(tmpdir)'pc30_lib"
capture mkdir "`stage'"
mata:
_src = fopen("../dash_parse.mata", "r")
_dfn = st_local("stage") + "/dash_parse.mata"
if (fileexists(_dfn)) unlink(_dfn)
_dst = fopen(_dfn, "w")
_n = 0
while ((_l = fget(_src)) != J(0, 0, "")) {
    if (strpos(_l, "real scalar _dash_path_badchar(")) {
        _l = subinstr(_l, "_dash_path_badchar(", "_pc30_not_badchar(")
        _n = _n + 1
    }
    fput(_dst, _l)
}
fclose(_src)
fclose(_dst)
st_local("pc30n", strofreal(_n))
end
assert `pc30n' == 1
local pg "`c(tmpdir)'pc30.html"
capture erase "`pg'"
local lg "`c(tmpdir)'pc30.log"
mata: st_local("ado0", st_global("S_ADO"))
local rc = -1
// Captured as a whole, so the ado-path and dash's library are put back
// whatever happens: left as they are here, every later script would fail.
capture noisily {
    mata: st_global("S_ADO", char(96) + char(34) + st_local("stage") + "/" + char(34) + char(39) + ";BASE")
    capture mata: mata clear
    capture log close _pc30
    quietly log using "`lg'", text replace name(_pc30)
    capture noisily dash scatter mpg weight, saving("`pg'")
    local rc = _rc
    quietly log close _pc30
}
local pc30rc = _rc
capture log close _pc30
mata: st_global("S_ADO", st_local("ado0"))
// dash's real library, and the helpers, back before anything is asserted.
capture mata: mata clear
quietly run "../dash_parse.mata"
quietly run "cert_helpers.do"
capture erase "`stage'/dash_parse.mata"
capture rmdir "`stage'"
assert `pc30rc' == 0
assert `rc' == 198
cert_file_has "`lg'", needle("dash's Mata library could not be loaded.")
assert r(found) == 1
cert_file_has "`lg'", needle("Missing: _dash_path_badchar()")
assert r(found) == 1
cert_file_has "`lg'", needle("_dash_path_badchar() not found")
assert r(found) == 0
capture confirm file "`pg'"
assert _rc != 0
display "PC-30 PASS: a library without _dash_path_badchar is refused by name, r(198), not r(3499) at the first saving()"


// ================================================================
// PC-31 -- a variable named by an abbreviation
// ================================================================
// A qualifier may abbreviate a variable, as Stata's own do: `if dis > 100'
// reads displacement.  The formats are read with st_varformat(), which
// takes no abbreviation, while `confirm variable' takes one -- so `dash
// scatter mpg weight if dis > 100, saving()' stopped with r(3500) "invalid
// Stata variable name", on both routes, where 68327a8 drew it (measured
// 24sep2026).  So did `if make != "d"': the words of a qualifier's string
// literal are among the names read, and d abbreviates displacement.  An
// abbreviated date variable was worse: the restore runs under capture, so
// the variable was left %12.0g after the render.  Each name is read, and
// keyed, as Stata stores it -- the column the renderer reads -- and once.
sysuse auto, clear
_dash_formats_json "dis mpg displacement" pc31_j pc31_dv
local pc31_want `"{"displacement":"%8.0g","mpg":"%8.0g"}"'
if `"`pc31_j'"' != `"`pc31_want'"' {
    display as error `"PC-31 map: `pc31_j'"'
}
assert `"`pc31_j'"' == `"`pc31_want'"'
generate double tdate = mdy(1, 1, 2000) + _n
format tdate %tdDD/NN/CCYY
_dash_formats_json "tda" pc31_j pc31_dv
assert strtrim("`pc31_dv'") == "tdate"
// Both routes, with each qualifier, draw, and leave the date's format.
local pc31n = 0
foreach q in `"dis > 100"' `"make != "d""' `"tda > 0"' {
    local ++pc31n
    local pg "`c(tmpdir)'pc31_`pc31n'.html"
    capture erase "`pg'"
    dash clear
    capture noisily dash scatter mpg weight if `q', saving("`pg'") replace
    local rci = _rc
    capture confirm file "`pg'"
    local wrote_i = (_rc == 0)
    capture erase "`pg'"
    dash scatter mpg weight if `q', name(pc31)
    capture noisily dash build, saving("`pg'") replace nobrowser
    local rcb = _rc
    capture confirm file "`pg'"
    local wrote_b = (_rc == 0)
    capture erase "`pg'"
    local fq : format tdate
    if `rci' | `rcb' | !`wrote_i' | !`wrote_b' | "`fq'" != "%tdDD/NN/CCYY" {
        display as error `"PC-31 [if `q']: immediate rc `rci' wrote `wrote_i', build rc `rcb' wrote `wrote_b', tdate `fq'"'
    }
    assert `rci' == 0 & `wrote_i' == 1
    assert `rcb' == 0 & `wrote_b' == 1
    assert "`fq'" == "%tdDD/NN/CCYY"
}
dash clear
display "PC-31 PASS: an abbreviated variable, in a qualifier or its string literal, is read as the variable it names, on both routes, and a date's format comes back"

// ================================================================
// PYF-01..02 -- the measured Python floor (WP-30 P1.33)
// ================================================================
// ---- PYF-01: venv() from a linked Python 3.12: created, installed,
//      verified, as on 3.13 (PEP-08 on 3.12.12) ----
capture noisily {
    local pf1 "`pep_tmp'pyf01 dir"
    python: import shutil, sfi; shutil.rmtree(sfi.Macro.getLocal("pf1"), True)
    mata: mkdir(st_local("pf1"))
    mata: st_global("PC_SB_CMD", "dash_setup, venv(" + char(34) + st_local("pf1") + "/venv" + char(34) + ")")
    global PC_SB_SPEC `"{"pip": {"rc": 0}, "pyversion": "3.12.12 (dash test sandbox)"}"'
    python: import os, sfi; _pep_a = os.path.join(os.path.realpath(sfi.Macro.getLocal("pf1")), "venv"); _pep_py = os.path.join(_pep_a, "bin", "python"); _pep_r = os.path.normpath(os.path.join(sfi.SFIToolkit.macroExpand(chr(96) + "c(pwd)'"), "..", "dash_render.py")); sfi.Macro.setLocal("apf1", _pep_a); sfi.Macro.setLocal("pypf1", _pep_py)
    python: _pep_vec([["PYTHON_EXEC", "-P", "-m", "venv", _pep_a], [_pep_py, "-c", "<ANY>"], [_pep_py, "-P", "-m", "pip", "install", "F", "packaging", "bokeh>=3.8", "numpy>=2.3", "pandas>=2.3"], [_pep_py, "-P", "-c", "<ANY>", "<ANY>", _pep_r]])
    _pc_setup
    local rc = r(rc)
    local m = r(match)
    mata: st_local("vpy", st_global("r(venv_python)"))
    mata: st_local("hint", st_global("r(hint_cmd)"))
    python: import shutil, sfi; shutil.rmtree(sfi.Macro.getLocal("pf1"), True)
    _pep_match `m'
    assert `rc' == 0
    mata: st_local("vpyok", strofreal(st_local("vpy") == st_local("pypf1")))
    mata: st_local("hintok", strofreal(st_local("hint") == "python set exec " + char(34) + st_local("pypf1") + char(34) + ", permanently"))
    assert `vpyok' == 1
    assert `hintok' == 1
    _pc_said "dash_setup complete for the environment named above."
    assert r(found) == 1
    _pc_said "is below"
    assert r(found) == 0
    display "PYF-01 PASS: venv() from a linked Python 3.12.12 creates, installs into and verifies the environment, rc 0"
}
if _rc _pep_fail PYF-01 `=_rc'

// ---- PYF-02: below the floor on a managed Python: no venv() advice ----
// A private environment made from it would be below the floor too, so the
// guidance says to link a newer Python and hands back no command.
capture noisily {
    _dash_pymin
    local pymin "`r(pymin)'"
    global PC_SB_SPEC `"{"block": ["bokeh"], "env": {"managed": true}, "pyversion": "3.10.10 (dash test sandbox)"}"'
    global PC_SB_CMD ""
    python: _pep_vec([["PYTHON_EXEC", "-c", "<ANY>"]])
    _pc_setup
    local rc = r(rc)
    mata: st_local("hintnone", strofreal(st_global("r(hint_cmd)") == ""))
    _pep_match `r(match)'
    assert `rc' == 198
    assert `hintnone' == 1
    foreach p in "A private environment made from it would be below" ///
        "Link Stata to Python `pymin' or later" {
        _pc_said "`p'"
        assert r(found) == 1
    }
    foreach p in "venv(" "break-system-packages" {
        _pc_said "`p'"
        assert r(found) == 0
    }
    display "PYF-02 PASS: a managed Python below the floor is told to link a newer Python, no venv() suggested, r(hint_cmd) empty, r(198)"
}
if _rc _pep_fail PYF-02 `=_rc'

set linesize `ls0'
local pep_failed `"$PEP_FAILED"'
macro drop PC_SB_SPEC PC_SB_ADO PC_SSC_RC PC_SB_EXPECT PC_SSC_CALLS PC_SB_WHY PC_SETUP_LOG PC_WHY PC_SB_CMD PEP_FAILED
capture program drop _pc_fail
capture program drop _pep_fail
capture program drop _pep_match
capture program drop _pc_setup
capture program drop _pc_said

if `"`pep_failed'"' != "" {
    display as error "PEP FAILED: `pep_failed'"
    exit 9
}

display ""
display "test_program_coverage.cscript: ALL CHECKS PASSED"
