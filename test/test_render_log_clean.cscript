*! test_render_log_clean.cscript
*! Certification script: rendering must not dump Python's namespace into the log.
*!
*! Usage:  do test/test_render_log_clean.cscript
*!
*! Requires: dash_setup completed (jsonio, Python).
*! Version: 1.1.0  22sep2026
*!
*! WHY THIS EXISTS
*!
*! A single-line `python:' statement ECHOES the value of the expression it
*! evaluates, and runpy.run_path() returns the executed module's globals
*! dict.  So
*!
*!     python: runpy.run_path("`_py_renderpy'", run_name="__main__")
*!
*! printed the whole of dash_render.py's namespace -- every class, every
*! constant, the colour table, __builtins__ -- into the Stata log on EVERY
*! render.  Measured: `dash scatter mpg weight, saving(x.html)' produced a
*! 48 KB, 653-line log, of which the dump began at line 91.
*!
*! That is contrary to project rule 14 (robust logging without a performance
*! penalty), and it buries any real message dash displays.
*!
*! `dash serve' had the same line and was fixed when it was rewritten; this
*! script covers the path every other command takes.
*!
*! NO PYTHON WARNING EITHER (WP-17, 22sep2026)
*!
*! cscript sets the session scheme to c(scheme_cscript) -- s2color8 -- so
*! every certification render inherits s2color8 as its c(scheme).  Until
*! WP-17 dash shipped no translation of s2color8, and the renderer put one
*! Python UserWarning ("'s2color8' is not a known theme or scheme; using
*! s2color") into the log of every render, this script's own captured log
*! included (test/run_all_cscripts.log, the WP-16 run: the render below
*! printed it, wrapped by Stata as "UserWar" / "> ning").  s2color8 is one
*! of the twenty shipped translations since WP-17, so the log of a plain
*! render must carry no Python warning at all.  Check 4 re-joins Stata's
*! "> " continuation lines -- a raw line-by-line search would miss the
*! wrapped word -- and asserts that no logical line carries "UserWarning".
*! A session scheme dash cannot translate is still one warning
*! (test_custom_scheme.cscript CS-10); this script asserts that the scheme
*! cscript sets is not such a scheme.  Check 5 is check 4's control: a
*! render under such a scheme, counted by the same scanner, must show its
*! one warning (24sep2026).

cscript "render log clean" adodir ".."

capture which jsonio
if _rc != 0 {
    display as error "SKIP: jsonio not installed. Run dash_setup first."
    exit 222
}

// See test_cscript_hygiene.py: do NOT probe Python by running it.
if "`c(python_exec)'" == "" {
    display as error "SKIP: Python not available."
    exit 222
}

qui do "../dash.ado"
do "cert_helpers.do"

// Log scanner for check 4: re-join "> " continuations, then count the
// logical lines that carry `needle'.  Mata strings are values, so nothing
// read from the log is ever expanded as Stata code.
capture mata: mata drop _rlc_count()
mata:
real scalar _rlc_count(string scalar fn, string scalar needle)
{
    real scalar   fh, n
    string scalar line, full
    fh = fopen(fn, "r")
    n = 0
    full = ""
    while ((line = fget(fh)) != J(0, 0, "")) {
        if (substr(line, 1, 2) == "> ") {
            full = full + substr(line, 3, .)
            continue
        }
        if (strpos(full, needle)) n = n + 1
        full = line
    }
    if (strpos(full, needle)) n = n + 1
    fclose(fh)
    return(n)
}
end

global dash_nobrowser 1

tempfile outhtml
// An explicit name: `log using' appends its own extension, and a tempfile
// macro's path is easier to get wrong than to read.
local logdir  "`c(tmpdir)'"
local logfile "`logdir'dash_render_log_clean.log"
capture erase "`logfile'"
sysuse auto, clear
dash clear

// A nested, named log captures exactly what this one command emits.
capture log close _dashlog
log using "`logfile'", name(_dashlog) text replace

dash scatter mpg weight, saving("`outhtml'.html") replace

log close _dashlog

// ---------------------------------------------------------------
// 1. The dashboard was actually produced (a silent failure would
//    leave the log clean for the wrong reason)
// ---------------------------------------------------------------
capture confirm file "`outhtml'.html"
assert _rc == 0
cert_file_has "`outhtml'.html", needle("bokeh") lower
assert r(found) == 1

display as result "  [1/5] the dashboard was rendered: PASS"

// ---------------------------------------------------------------
// 2. No Python namespace dump
// ---------------------------------------------------------------
cert_file_has "`logfile'", needle("__builtins__")
assert r(found) == 0
cert_file_has "`logfile'", needle("DashRenderer")
assert r(found) == 0
cert_file_has "`logfile'", needle("GlyphMapper")
assert r(found) == 0

display as result "  [2/5] no Python namespace in the log: PASS"

// ---------------------------------------------------------------
// 3. The log stays small.  653 lines for one command was the
//    measured before; a clean render is a handful.
// ---------------------------------------------------------------
tempname fh
file open `fh' using "`logfile'", read text
local nlines = 0
file read `fh' line
while r(eof) == 0 {
    local nlines = `nlines' + 1
    file read `fh' line
}
file close `fh'
display as text "     log lines for one render: `nlines'"
assert `nlines' < 60

display as result "  [3/5] the log is short: PASS"

// ---------------------------------------------------------------
// 4. No Python warning.  The session scheme cscript sets (s2color8)
//    ships since WP-17, so a plain render inherits it silently; the
//    one line every certification log used to carry is gone.
// ---------------------------------------------------------------
mata: st_local("nwarn", strofreal(_rlc_count(st_local("logfile"), "UserWarning")))
display as text "     UserWarning lines in the log (wrapped lines re-joined): `nwarn'"
assert `nwarn' == 0

display as result "  [4/5] no Python warning in the log: PASS"

// ---------------------------------------------------------------
// 5. The control for check 4: a render that must warn does, and the
//    same counter counts it.  Without one (until 24sep2026 the only
//    control was test_custom_scheme.cscript CS-10's), check 4 could
//    not fail on a warning that never reached the log -- a filter
//    silencing Python's warnings for the session passes it whatever
//    the renderer says, as dash_setup's scheme probe once did,
//    leaving warnings.simplefilter("ignore") installed for every
//    later render.  A session scheme dash cannot translate is one
//    warning (CS-10): zzdashrlc, a scheme file in a scratch working
//    directory that includes s2color, so that `set scheme' takes it
//    and the renderer does not.
// ---------------------------------------------------------------
local rlc_home    "`c(pwd)'"
local rlc_scheme0 "`c(scheme)'"
local rlc_dir     "`logdir'dash_rlc_wd"
local ctlfile     "`logdir'dash_render_log_clean_ctl.log"
capture mkdir "`rlc_dir'"
tempname sfh
file open `sfh' using "`rlc_dir'/scheme-zzdashrlc.scheme", write text replace
file write `sfh' "#include s2color" _n
file close `sfh'
capture erase "`ctlfile'"
quietly cd "`rlc_dir'"
capture noisily set scheme zzdashrlc
local src = _rc
dash clear
capture log close _dashctl
log using "`ctlfile'", name(_dashctl) text replace
capture noisily dash scatter mpg weight, saving("`outhtml'_ctl.html") replace
local crc = _rc
log close _dashctl
capture set scheme `rlc_scheme0'
quietly cd "`rlc_home'"
capture erase "`rlc_dir'/scheme-zzdashrlc.scheme"
capture rmdir "`rlc_dir'"
capture erase "`outhtml'_ctl.html"

mata: st_local("nctl", strofreal(_rlc_count(st_local("ctlfile"), "UserWarning")))
display as text "     UserWarning lines in the control's log: `nctl'"
assert `src' == 0
assert `crc' == 0
assert `nctl' == 1

display as result "  [5/5] a render that must warn is counted: PASS"

dash clear
display as result "test_render_log_clean.cscript: ALL PASS"
