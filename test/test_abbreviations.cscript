        quietly log using "`u15log'", text replace name(_zu15)
        if "`who'" == "twoway" capture noisily twoway `pre' `macval(o)' nodraw
        else capture noisily dash `pre' `macval(o)' name(zu1506)
        local rc_`who' = _rc
        quietly log close _zu15
        python: from sfi import Macro as _u15M; _u15l = [l.rstrip() for l in open(_u15M.getLocal("u15log"), encoding="utf-8", errors="replace") if l.strip() and not l.lstrip().startswith((".", ">", "-")) and ":" not in l[:12] and "dash:" not in l]; _u15M.setLocal("line_`who'", (_u15l[0] if _u15l else "")[:120])
    }
    if `rc_twoway' != `rc_dash' | `"`line_twoway'"' != `"`line_dash'"' {
        display as error `"U15-06 FAIL case `i': twoway r(`rc_twoway') [`line_twoway'], dash r(`rc_dash') [`line_dash']"'
        local u1506 1
    }
    if `i' == 7 & `rc_dash' != 0 local u1506 1
}
capture erase "`u15log'"
capture dash clear
if `u1506' {
    local nfail = `nfail' + 1
    local faillist `"`faillist' U15-06"'
}
else display as text "U15-06 PASS: j() ji() jit() jitt() jitte() and bare jit refused as twoway refuses them, in the plot and after the comma, jitter(5) taken"

// CRA-01 (18oct2026): colorrule() and crule() names abbreviate as
// zyx2rule.class's _unabbrev declares them -- HUE CHUE PHUE LINear
// INTensity REVLINear -- so lin, inte and revlinea are linear, intensity
// and revlinear to twoway (rc 0, the full rule's colours, measured from
// its SVG), and li, in, revli, LIN and hsv are named styles it has not
// (two notes, r(198) when it draws).  dash refused every abbreviation;
// each spelling's rc is twoway's, and one twoway takes reaches the
// renderer as the full name, its %# or *# kept (the served spec).
local cra01 0
local craspec "`c(tmpdir)'zcra01_s.json"
local cradata "`c(tmpdir)'zcra01_d.json"
sysuse auto, clear
local i 0
foreach o in "lin~linear" "linea~linear" "int~intensity" "intensi~intensity" "revlin~revlinear" "revlinea~revlinear" "lin %50~linear %50" "int *2~intensity *2" "li~" "in~" "revli~" "LIN~" "hsv~" "hue~hue" "C:lin~linear" "C:revlin~revlinear" "C:li~" {
    local ++i
    gettoken r want : o, parse("~")
    local want = substr(`"`want'"', 2, .)
    local cmd `"scatter mpg weight, colorvar(price) colorrule(`r')"'
    local key "colorrule"
    if substr(`"`r'"', 1, 2) == "C:" {
        local r = substr(`"`r'"', 3, .)
        local cmd `"contour mpg weight price, crule(`r')"'
        local key "crule"
    }
    capture twoway `cmd' name(_zcra, replace)
    local rc_twoway = _rc
    capture graph drop _zcra
    capture dash clear
    capture noisily dash `cmd' name(zcra01)
    local rc_dash = _rc
    if `rc_twoway' != `rc_dash' {
        display as error `"CRA-01 FAIL case `i' [`cmd']: twoway r(`rc_twoway'), dash r(`rc_dash')"'
        local cra01 1
    }
    if `rc_dash' == 0 {
        _dash_serve_spec, specpath("`craspec'") datapath("`cradata'")
        python: import json as _craj; from sfi import Macro as _craM; _cras = open(_craM.getLocal("craspec"), encoding="utf-8").read().replace('":"', '": "'); _craM.setLocal("cra_ok", "1" if ('"%s": %s' % (_craM.getLocal("key"), _craj.dumps(_craM.getLocal("want")))) in _cras else "0")
        if "`cra_ok'" != "1" {
            display as error `"CRA-01 FAIL case `i' [`cmd']: the spec does not carry `key'(`want')"'
            local cra01 1
        }
    }
}
capture erase "`craspec'"
capture erase "`cradata'"
capture dash clear
if `cra01' {
    local nfail = `nfail' + 1
    local faillist `"`faillist' CRA-01"'
}
else display as text "CRA-01 PASS: colorrule() and crule() abbreviate as twoway's zyx2rule names do, the full name drawn; the rest refused with twoway's rc"

// MLF-01 (18oct2026): mlabfontface() is no option twoway draws:
// twoway_yxview_parse.class factors MLABFontface into the label's
// textstyle, which has no fontface, so mlabfon() .. mlabfontface()
// holding a value are "option(s) fontface(<its first word>) not allowed",
// r(198), on every plot type, the rightmost copy that is not empty named
// (mlabf() and mlabfo() are mlabformat(), declared first); a value that
// opens with a quote is read to its closing quote -- empty, "option(s)
// fontface(`') not allowed"; one word, r(198) with the word and a stray
// quote; blanks in it, "option(s) fontface(`<first word> not found",
// r(111); compound-quoted with a double quote inside, an odd count of
// them is r(132), twoway's line broken where its own display of the
// value broke, and an even count the one-word refusal, a leading "..."
// losing its quotes -- a bare mlabfontface is "option mlabfontface not
// allowed", and after the paren-mode comma it is "option mlabfontface()
// not allowed".
// An empty mlabfontface() is taken in silence (rc 0, no note).  dash
// named every one in its note.  Each spelling's rc and first error line
// are twoway's, and where twoway is rc 0 dash's note does not name it.
local mlf01 0
local mlflog "`c(tmpdir)'zmlf01.log"
python: from sfi import Macro as _mlfM; _mlfc = ["mlabfon(x)", "mlabfont(bold)", "mlabfontface(bold)", "mlabfontface( a  b )", "mlabfontface(Courier) mcolor(red)", "mlabfontface(x) mlabfontface(y)", "mlabfontface", "mlabfontface()", "mlabfontface( )", "mlabfontface(x) mlabfontface()", "mlabfontface() mlabfontface(x)", 'mlabfontface("a b")', 'mlabfontface("ab")', 'mlabfontface("")', 'mlabfontface( "ab cd" x)', 'mlabfontface(x "ab")', 'mlabfontface(`"ab cd"\')', 'mlabfontface(`"ab"\')', 'mlabfontface(`"a"b"\')', 'mlabfontface(`"a"b c"\')', 'mlabfontface(`"a b"c"\')', 'mlabfontface(`""a"\')', 'mlabfontface(`""a b"\')', 'mlabfontface(`"""a"\')', 'mlabfontface(`""ab"c"\')', 'mlabfontface(`""a c"d"\')', 'mlabfontface(`""""\')', 'mlabfontface(`"a"b"c"\')', 'mlabfontface(`"""a""b"\')', 'mlabfontface(`"a"b"\') mlabfontface()', 'mlabfontface(`"a`"b"\'c"\')', "L:mlabfontface(bold)", "P:mlabfontface(x)", "P:mlabfon(x)", "P:mlabfontface"]; [_mlfM.setLocal("mlf_c%d" % (k + 1), c) for k, c in enumerate(_mlfc)]; _mlfM.setLocal("mlf_n", str(len(_mlfc)))
forvalues i = 1/`mlf_n' {
    local o : copy local mlf_c`i'
    local pre "scatter mpg weight, mlabel(make)"
    mata: st_local("_mlf_p", substr(st_local("o"), 1, 2))
    if "`_mlf_p'" == "P:" {
        mata: st_local("o", substr(st_local("o"), 3, .))
        local pre "(scatter mpg weight),"
    }
    else if "`_mlf_p'" == "L:" {
        mata: st_local("o", substr(st_local("o"), 3, .))
        local pre "line mpg weight,"
    }
    foreach who in twoway dash {
        capture dash clear
        capture log close _zmlf
        quietly log using "`mlflog'", text replace name(_zmlf)
        if "`who'" == "twoway" capture noisily twoway `pre' `macval(o)' nodraw
        else capture noisily dash `pre' `macval(o)' name(zmlf01)
        local rc_`who' = _rc
        quietly log close _zmlf
        python: from sfi import Macro as _mlfM; _mlfa = [l.rstrip() for l in open(_mlfM.getLocal("mlflog"), encoding="utf-8", errors="replace")]; _mlfl = [l for l in _mlfa if l.strip() and not l.lstrip().startswith((".", ">", "-")) and ":" not in l[:12] and "dash:" not in l]; _mlfM.setLocal("line_`who'", (_mlfl[0] if _mlfl else "")[:120]); _mlfM.setLocal("note_`who'", "1" if any("ignoring unsupported" in l and "mlabf" in l for l in _mlfa) else "0")
    }
    mata: st_local("_mlf_same", strofreal(st_local("line_twoway") == st_local("line_dash")))
    if `rc_twoway' != `rc_dash' | !`_mlf_same' | (`rc_twoway' == 0 & `note_dash') {
        mata: printf("{err}MLF-01 FAIL case %s [%s]: twoway r(%s) [%s], dash r(%s) [%s] note %s\n", st_local("i"), st_local("o"), st_local("rc_twoway"), st_local("line_twoway"), st_local("rc_dash"), st_local("line_dash"), st_local("note_dash"))
        local mlf01 1
    }
}
capture erase "`mlflog'"
capture dash clear
if `mlf01' {
    local nfail = `nfail' + 1
    local faillist `"`faillist' MLF-01"'
}
else display as text "MLF-01 PASS: mlabfontface() refused as twoway refuses it, in its words and rc, quoted values too, on a plot and after the comma; an empty one taken in silence"

