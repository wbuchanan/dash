*! test_abbreviations.cscript
*! Certification script for option and plot-type ABBREVIATIONS.
*!
*! Plan task 04-02 (batch 2).  Every check here is written BEFORE the fix, per
*! project rule 8, and the failing ones document defects measured end to end
*! against the pre-fix code base.
*!
*! GROUND TRUTH
*! ------------
*! Nothing in this file is asserted from memory or from the help file.  Every
*! expectation is read at run time out of
*!
*!     test/fixtures/abbrev_truth.json
*!
*! which task 04-01 produced by probing Stata itself: for each twoway option it
*! recorded the shortest prefix that twoway accepts AND that resolves to the
*! intended option (verified by comparing live-format .gph output, not by
*! return code, because twoway accepts xl(3000) and resolves it to xlabel()).
*!
*! GROUPS
*! ------
*!   A1  every option's minimum abbreviation is accepted (assertion 1) and is
*!       recorded under its FULL option name (assertion 2).  Assertion 2 is the
*!       one that catches the silent mis-mappings: mlc(red) must land on
*!       mlcolor, not on mlabcolor.  An rc-only test passes today for mlc.
*!   A2  every prefix from the minimum to the full name behaves identically
*!       (this is what "abbreviation" means; dash's table accepts exactly one
*!       short form per option, so mlab(), xlab(), scat() all fail today).
*!   A3  the seven mis-mappings, called out by name and by value.
*!   A4  every abbreviation dash.sthlp documents is accepted by dash (A4b:
*!       the ones that belong to dash build, on dash build).
*!   A5  every plot type's minimum abbreviation is accepted and yields that
*!       plot type.
*!   A6  the plot-type prefix ladder (scat, conn, lin, ...).
*!   A7  COLLISION guard.  Where one prefix is a legal abbreviation of more
*!       than one twoway option, dash must land where twoway lands.  See the
*!       note on "ambiguity" below.
*!   A8  KPI nam() and upd().
*!   R1  REGRESSION GUARD: every full option name still works and still lands
*!       on its own key.
*!   R2  REGRESSION GUARD: every short form the Mata table accepts today, and
*!       that is a genuine prefix of its target, still works unchanged.
*!   R3  NO-SILENT-CHANGE GUARD: the short forms that are NOT prefixes of their
*!       target (cv, colv, pbgc, mlg, bw, xla2, ...) cannot survive as Stata
*!       abbreviations.  They may stop working, but they must never be accepted
*!       and quietly routed to a different option.
*!   R4  REGRESSION GUARD: plot-type full names and today's short forms.
*!
*! A NOTE ON "AMBIGUOUS PREFIX PRODUCES STATA'S AMBIGUITY ERROR"
*! ------------------------------------------------------------
*! Measured, not assumed: Stata's -syntax- has NO ambiguity diagnostic.  With
*!
*!     program define zq
*!         syntax [, MLABColor(string) MLABCuts(string) ]
*!
*! the call  zq, mlabc(red)  returns _rc==0 and fills mlabcolor; declaring the
*! two options in the other order makes the same call fill mlabcuts instead.
*! No error, no warning, first declaration wins.  Probing twoway itself with
*! ~110 one- and two-letter prefixes produced zero "ambiguous" messages.
*!
*! So the testable property is not "dash raises Stata's ambiguity error" -- no
*! such error exists -- but "where a prefix is legal for more than one option,
*! dash resolves it exactly as twoway does".  That is group A7, and its cases
*! are read out of the fixture's abbrev_resolution table (the abbreviations
*! whose stata_accepted_prefix_in_context_of list holds more than one option).
*!
*! Like test_varlist_expansion.cscript this script does NOT stop at the first
*! failure: every check is wrapped in -capture-, the failures are tallied, and
*! the script exits 9 if any failed.
*!
*!   NP-30..NP-33 (WP-30 P1.14a) the named styles' minimums land on their
*!       keys and are not named; pst() ps() as() are named as typed, rc 0;
*!       ml(p3) is r(111) as in twoway.
*!
*! Usage:  do test/test_abbreviations.cscript   (run from test/)
*! Version: 1.0

cscript "dash option and plot-type abbreviations" adodir ".."

// `cscript' drops every global macro, the runner's $dash_nobrowser with them;
// set it again before this script builds a dashboard (test_cscript_hygiene.py).
global dash_nobrowser 1

// Certification scripts share one Stata session, so start from a clean
// state: leftover data, globals, tsset settings or loaded programs from an
// earlier script otherwise leak in and change what this one measures.
clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}

// ----------------------------------------------------------------
// Dependency guards
// ----------------------------------------------------------------

// Do NOT probe with `capture python: pass'.  Measured: that returns a
// nonzero rc inside the runner even though the very same session renders
// Bokeh output through `dash build' moments later, and it made 9 of the 14
// scripts -- every end-to-end one -- skip while the suite reported ALL TESTS
// PASSED.  c(python_exec) is set by Stata's own Python configuration and
// reads without executing anything, so it cannot fail for reasons unrelated
// to Python being present.
if "`c(python_exec)'" == "" {
    display as error "SKIP: Python not available."
    exit 222
}

// ----------------------------------------------------------------
// Locate the fixture and the help file without hardcoding a path.
// run_all_cscripts.do runs cscripts with test/ as the working directory.
// ----------------------------------------------------------------
global ZQA_FIXTURE ""
global ZQA_HELP    ""

foreach cand in "fixtures/abbrev_truth.json" "test/fixtures/abbrev_truth.json" {
    if "${ZQA_FIXTURE}" == "" {
        capture confirm file "`cand'"
        if _rc == 0 global ZQA_FIXTURE "`cand'"
    }
}
if "${ZQA_FIXTURE}" == "" {
    display as error "SKIP: test/fixtures/abbrev_truth.json not found " ///
        "(run scripts/extract_abbrev_truth.do to build it)."
    exit 222
}

foreach cand in "../dash.sthlp" "dash.sthlp" {
    if "${ZQA_HELP}" == "" {
        capture confirm file "`cand'"
        if _rc == 0 global ZQA_HELP "`cand'"
    }
}
if "${ZQA_HELP}" == "" {
    display as error "SKIP: dash.sthlp not found."
    exit 222
}

do "../dash_parse.mata"
do "../dash.ado"

tempfile savtmp
global ZQA_TMPSAV "`savtmp'.html"

// ----------------------------------------------------------------
// Mata helpers
//
// The spec JSON is read straight out of the global macro rather than being
// passed through a Stata local: it contains double quotes, which cannot
// survive being pasted into a -mata:- one-liner.
// ----------------------------------------------------------------
mata:

// Which of the candidate option keys does this spec record?
// The spec is flat -- "key":"value" pairs inside "options":{...} and
// "graph_options":{...} -- so a search for the quoted key token is exact.
// Structural keys (type, yvar, xvar, options, if_expr, ...) are simply not
// in the candidate list, and no probe value used here contains a quote.
void _zqa_keys(string scalar gname, string scalar cands, string scalar outmac)
{
    string rowvector k
    string scalar    spec, q, out
    real scalar      i

    spec = st_global(gname)
    q    = char(34)
    k    = tokens(cands)
    out  = ""
    for (i = 1; i <= length(k); i++) {
        if (strpos(spec, q + k[i] + q + ":" + q) > 0) out = out + " " + k[i]
    }
    st_local(outmac, strtrim(out))
}

// The plot type the spec recorded for its first plot.
void _zqa_type(string scalar gname, string scalar outmac)
{
    string scalar spec, q, pat, rest
    real scalar   p, e

    spec = st_global(gname)
    q    = char(34)
    pat  = q + "type" + q + ":" + q
    p    = strpos(spec, pat)
    if (p == 0) {
        st_local(outmac, "")
        return
    }
    rest = substr(spec, p + strlen(pat), .)
    e    = strpos(rest, q)
    if (e == 0) {
        st_local(outmac, "")
        return
    }
    st_local(outmac, substr(rest, 1, e - 1))
}

// Non-empty test that survives quotes in the value.
void _zqa_nonempty(string scalar gname, string scalar outmac)
{
    st_local(outmac, strlen(st_global(gname)) > 0 ? "1" : "0")
}

end

// ----------------------------------------------------------------
// Build the case table from the fixture.
//
// Python only READS the fixture and sets macros; it never calls back into
// Stata with SFIToolkit.stata(), which desynchronises the interpreter's input
// stream when issued in bulk from a do-file block.
// ----------------------------------------------------------------
python:
import json, re, sfi

FX     = sfi.Macro.getGlobal("ZQA_FIXTURE")
HELP   = sfi.Macro.getGlobal("ZQA_HELP")
TMPSAV = sfi.Macro.getGlobal("ZQA_TMPSAV")

with open(FX) as fh:
    D = json.load(fh)

OPTS = D["options"]
PTS  = D["plottypes"]
RES  = D["abbrev_resolution"]
# The fixture's own record of its size, written with the data by the
# extraction (scripts/extract_abbrev_truth.do): the per-group checks after
# the loop compare A1, A3 and A5 with it, so a truncated or partly
# regenerated fixture runs fewer cases and FAILS rather than passing them.
META = D["_meta"]["counts"]

# ---------------------------------------------------------------- pinned
# The option surface dash declares TODAY, copied from the two syntax blocks
# in dash.ado (_dash_parse_plot_opts and _dash_parse_graph_opts) at the time
# this test was written.  It is pinned here on purpose: a regression guard
# that re-derived the list from the code it guards could not notice an option
# being dropped.
DASH_PLOT_KEYS = [
    "mcolor", "msymbol", "msize", "msangle", "mfcolor", "mlcolor",
    "mlabel", "mlabcolor", "mlabsize", "mlabposition", "mlabgap",
    "mlabwidth", "malpha", "marker",
    "lcolor", "lwidth", "lpattern", "lalpha",
    "fcolor", "fintensity", "falpha",
    "barwidth", "base", "blcolor", "bfcolor",
    "jitter", "jseed", "yaxis", "xaxis",
    "colorvar", "colpalette", "colordiscrete", "coloruseplegend",
    "colornlevels", "colorcuts", "colormissing",
    "bwidth", "degree", "pstyle", "cmissing", "recast", "connect",
]
DASH_GRAPH_KEYS = [
    "title", "subtitle", "note", "caption", "name", "saving",
    "xtitle", "ytitle", "xlabel", "ylabel", "xline", "yline",
    "legend", "by", "xscale", "yscale", "aspectratio", "scheme",
    "plotregion", "graphregion", "bgcolor", "plotbgcolor",
    "link", "filter",
    "ytitle2", "xtitle2", "ylabel2", "xlabel2", "yscale2", "xscale2",
]
DASH_FLAGS = {"colordiscrete", "coloruseplegend"}

# dash's hard-coded abbreviation table today (dash_parse.mata, _expand_optkey).
MATA_OPT_ALIAS = {
    "mc": "mcolor", "ms": "msymbol", "msi": "msize", "msa": "msangle",
    "mla": "mlabel", "mlc": "mlabcolor", "mls": "mlabsize",
    "mlp": "mlabposition", "mlg": "mlabgap", "mlw": "mlabwidth",
    "mfc": "mfcolor", "mal": "malpha", "m": "marker",
    "fc": "fcolor", "fi": "fintensity", "fa": "falpha",
    "blc": "blcolor", "bfc": "bfcolor", "bw": "barwidth",
    "lc": "lcolor", "lw": "lwidth", "lp": "lpattern", "lal": "lalpha",
    "fal": "falpha",
    "ti": "title", "sub": "subtitle", "xti": "xtitle", "yti": "ytitle",
    "xla": "xlabel", "yla": "ylabel", "note": "note", "cap": "caption",
    "leg": "legend", "sav": "saving", "nam": "name", "by": "by",
    "xsc": "xscale", "ysc": "yscale", "xl": "xline", "yl": "yline",
    "asp": "aspectratio", "bgc": "bgcolor", "pbgc": "plotbgcolor",
    "plotr": "plotregion", "graphr": "graphregion",
    "jit": "jitter", "jse": "jseed", "yax": "yaxis", "xax": "xaxis",
    "yti2": "ytitle2", "xti2": "xtitle2", "yla2": "ylabel2",
    "xla2": "xlabel2", "ysc2": "yscale2", "xsc2": "xscale2",
    "sch": "scheme", "cv": "colorvar", "colv": "colorvar",
    "colpal": "colpalette", "bwid": "bwidth", "deg": "degree",
}

# dash's hard-coded plot-type table today (_expand_plottype_str).
MATA_PT_ALIAS = {
    "sc": "scatter", "li": "line", "con": "connected", "ar": "area",
    "ba": "bar", "sp": "spike", "lfi": "lfit", "qfi": "qfit",
    "low": "lowess", "lpo": "lpoly", "lpol": "lpoly", "fp": "fpfit",
    "fpf": "fpfit", "hist": "histogram", "kde": "kdensity",
    "dr": "dropline", "tsl": "tsline", "tsrl": "tsrline",
    "msp": "mspline", "func": "function",
}
MATA_PT_FULL = [
    "scatter", "line", "connected", "area", "bar", "spike", "lfit", "qfit",
    "lfitci", "qfitci", "lowess", "lpoly", "lpolyci", "fpfit", "fpfitci",
    "histogram", "kdensity", "rarea", "rbar", "rspike", "rcap", "rline",
    "rconnected", "dot", "dropline", "rcapsym", "pcspike", "pcarrow",
    "pcbarrow", "pci", "pcscatter", "tsline", "tsrline", "mspline",
    "mband", "rscatter", "function", "scatteri",
    # WP-22.  twoway takes neither by any shorter name (measured 23sep2026:
    # "pccapsy is not a twoway plot type"; pcarrow is its own type), so the
    # full names are all there is to guard.
    "pccapsym", "pcarrowi",
]
# varlists that make each plot type legal; fixture first, then dash-only ones.
PT_VARS = {
    "rcapsym": "turn mpg weight", "pcbarrow": "mpg weight turn length",
    "pccapsym": "mpg weight turn length", "pcarrowi": "20 3000 25 3500",
    "pci": "20 3000 25 3500", "pcscatter": "mpg weight turn length",
    "tsrline": "mpg price", "rconnected": "turn mpg weight",
    "rline": "turn mpg weight", "rscatter": "turn mpg weight",
    "function": "y=x", "scatteri": "20 3000", "qfit": "mpg weight",
    "qfitci": "mpg weight", "fpfit": "mpg weight", "fpfitci": "mpg weight",
    "tsline": "mpg", "mband": "mpg weight", "mspline": "mpg weight",
    "lowess": "mpg weight", "dot": "mpg weight",
}
for _n, _m in PTS.items():
    PT_VARS[_n] = _m["varlist"]
# tsline and tsrline draw against the time variable tsset set, as twoway
# does, and take no x of their own: `tsline mpg turn' is two series, and
# `tsrline mpg price turn' is r(103) in twoway and in dash
# (test_help_claims_1.cscript HC1-09).  The data are tsset below, before any
# case runs, so these probe the ABBREVIATION rather than tsset behaviour.
PT_VARS["tsline"] = "mpg"
PT_VARS["tsrline"] = "mpg price"

# a usable value for every option dash declares but the fixture cannot probe
EXTRA_VALUES = {
    "bgcolor": "white", "plotbgcolor": "white", "link": "zqlink",
    "jseed": "123",
    "filter": "foreign", "marker": "1", "mlabwidth": "thick",
    "malpha": "50", "lalpha": "50", "falpha": "50",
    "colpalette": "viridis", "colornlevels": "4", "colormissing": "gray",
    "bwidth": "2", "xtitle2": "X2", "ytitle2": "Y2",
    "xlabel2": "2000 3000", "ylabel2": "20 30",
    "xscale2": "log", "yscale2": "log",
    "mlcolor": "red", "mlpattern": "dash", "mlstyle": "p2",
    "mlwidth": "thick",
    # hover() takes a varlist: dash.sthlp documents hov() for it (WP-23),
    # and the default value "1" names no variable, r(111).
    "hover": "mpg",
}

CAND = sorted((set(OPTS) | set(DASH_PLOT_KEYS) | set(DASH_GRAPH_KEYS) |
               {"mlwidth", "mlpattern", "mlstyle"}) - {"name"})

def value_of(name):
    if name in OPTS and OPTS[name].get("probe_value") is not None:
        return OPTS[name]["probe_value"]
    if name in EXTRA_VALUES:
        return EXTRA_VALUES[name]
    return None

def is_flag(name):
    if name in DASH_FLAGS:
        return True
    return name in OPTS and OPTS[name].get("probe_value") is None and \
        name not in ("name", "saving") and name not in EXTRA_VALUES

def opt_token(abb, name):
    """The option as typed on the dash command line."""
    if name == "saving":
        return abb + "(" + TMPSAV + ")"
    if name == "name":
        return abb + "(zqab)"
    v = value_of(name)
    if v is None:
        return abb
    return abb + "(" + v + ")"

def opt_cmd(abb, name):
    tok = opt_token(abb, name)
    if name == "name":
        return "scatter mpg weight, " + tok
    return "scatter mpg weight, " + tok + " name(zqab)"

CASES = []
def add(grp, ident, cmd, keys="", ptype="", optname="", mode="ok"):
    CASES.append({"g": grp, "i": ident, "c": cmd, "k": keys,
                  "t": ptype, "o": optname, "m": mode})

# ---- A1: minimum abbreviation, per option -----------------------------
for name in sorted(OPTS):
    mn = OPTS[name]["min_abbrev"]
    add("A1", name + " [" + mn + "]", opt_cmd(mn, name),
        keys=("" if name == "name" else name), optname=name)

# ---- A2: the whole prefix ladder --------------------------------------
for name in sorted(OPTS):
    mn = OPTS[name]["min_abbrev"]
    if not name.startswith(mn):
        continue
    for L in range(len(mn) + 1, len(name) + 1):
        pre = name[:L]
        add("A2", name + " [" + pre + "]", opt_cmd(pre, name),
            keys=("" if name == "name" else name), optname=name)

# ---- A3: the mis-mappings, by name ------------------------------------
MISMAP = []
for row in D["dash_mismaps"]:
    ab, rest = row.split(":", 1)
    ab = ab.strip()
    m = re.search(r"dash->(\S+?),\s*stata->(\S+)", rest)
    MISMAP.append((ab, m.group(1), m.group(2)))
for ab, wrong, right in MISMAP:
    add("A3", ab + " -> " + right + " (not " + wrong + ")",
        opt_cmd(ab, right), keys=right, optname=right)

# ---- A4: everything dash.sthlp documents ------------------------------
with open(HELP, encoding="utf-8", errors="replace") as fh:
    HELPTXT = fh.read()
DOC = []
for tok in re.findall(r"\{cmdab:([^}]*)\}", HELPTXT):
    if ":" not in tok or " " in tok:
        continue
    mn, rest = tok.split(":", 1)
    full = (mn + rest).split("(")[0]
    if not re.match(r"^[a-z][a-z0-9]*$", mn) or not full:
        continue
    if full in ("update", "layout", "fmt"):     # dash kpi / dash build: group A8
        continue
    for spelling in (mn, full):
        if (spelling, full) not in DOC:
            DOC.append((spelling, full))
# How many spellings the help documents, before any is set aside: the
# Stata section below holds it to the count measured on 24sep2026, so a
# change to the help's markup that this regex no longer reads fails there
# instead of running no cases.
N_DOC = len(DOC)
# `dash build' options.  The one-line command cannot carry them: measured
# 24sep2026, `scatter mpg weight, nobr(1) name(zqab)' is rc 0 with the note
# "ignoring unsupported option(s): nobr()", and so is filterpos(top).  They
# are sent to dash build instead (A4b, after the loop), whose syntax
# refuses an option it does not declare.
A4_BUILD = {"nobrowser": "", "filterposition": "top"}
DOC_BUILD = [(s, f) for s, f in DOC if f in A4_BUILD]
DOC = [(s, f) for s, f in DOC if f not in A4_BUILD]
def doc_cmd(spelling, full):
    """A documented spelling must be ACCEPTED; the value only has to be legal.
    A spelling the help invented (mlacolor) has no fixture value, and must not
    be sent bare, which would make it look like a flag option.  A real flag
    (colordiscrete) is sent bare: given a value, the one-line command
    ignores it with a note."""
    if full == "name":
        return "scatter mpg weight, " + spelling + "(zqab)"
    if full == "saving":
        return "scatter mpg weight, " + spelling + "(" + TMPSAV + ") name(zqab)"
    if full == "scheme":
        return "scatter mpg weight, " + spelling + "(s2color) name(zqab)"
    # colorlevels() and colorvarminmax (GAPS2 X2) act only beside a
    # colorvar(); alone, dash ignores them with a note and records nothing
    # (measured 30sep2026; twoway ignores them silently).  colorlevels(4),
    # not the default 1: dash takes 2 to 256.
    if full == "colorlevels":
        return "scatter mpg weight, colorvar(price) " + spelling + "(4) name(zqab)"
    if full == "colorvarminmax":
        return "scatter mpg weight, colorvar(price) " + spelling + " name(zqab)"
    if is_flag(full):
        return "scatter mpg weight, " + spelling + " name(zqab)"
    # clstyle() styles a connecting line, which scatter does not draw:
    # dash.ado clears it off scatter as twoway ignores it there (WP-30
    # P1.14a), so it is sent on line.
    if full == "clstyle":
        return "line mpg weight, " + spelling + "(p3) name(zqab)"
    v = value_of(full)
    if v is None:
        v = "1"
    return "scatter mpg weight, " + spelling + "(" + v + ") name(zqab)"

# Accepted means RECORDED, under the full name, as A1 means it.  This was
# mode "rconly", and the one-line command returns rc 0 for any option at all
# -- measured 24sep2026, `scatter mpg weight, zzzz(1) name(zqab)' is rc 0,
# spec written, "ignoring unsupported option(s): zzzz()" -- so no A4 case
# could fail.  The spec must now hold the option under its full name.
for spelling, full in DOC:
    # doc_cmd sends colorlevels() and colorvarminmax beside colorvar(), so
    # the spec holds both keys, in the sorted order the driver records.
    k = "" if full == "name" else full
    if full in ("colorlevels", "colorvarminmax"):
        k = " ".join(sorted([full, "colorvar"]))
    add("A4", "dash.sthlp documents " + spelling + "() for " + full + "()",
        doc_cmd(spelling, full), keys=k,
        optname=spelling + "->" + full)
# The documented names are candidates too: mlabangle, mlabformat and hover
# are in neither the fixture nor the pinned lists above.
CAND = sorted(set(CAND) | {f for _, f in DOC if f != "name"})

# ---- A5/A6: plot types -------------------------------------------------
for name in sorted(PTS):
    mn   = PTS[name]["min_abbrev"]
    vrs  = PT_VARS[name]
    add("A5", name + " [" + mn + "]", mn + " " + vrs + ", name(zqab)",
        ptype=name, optname=name)
    if not name.startswith(mn):
        continue
    for L in range(len(mn) + 1, len(name) + 1):
        pre = name[:L]
        add("A6", name + " [" + pre + "]", pre + " " + vrs + ", name(zqab)",
            ptype=name, optname=name)

# ---- A7: collision prefixes -------------------------------------------
# null is the fixture's "no candidates" / "not resolved" (24 of 61 entries
# on 24sep2026), and reads as none here.  A MISSING key read the same way
# through r.get(...) or [], so a key renamed in the fixture dropped every
# case from this group in silence; and a collision recorded without a
# resolution was skipped.  Both are counted as malformed, and the Stata
# section below requires none.
A7_BAD = []
for ab in sorted(RES):
    r    = RES[ab]
    if ("stata_accepted_prefix_in_context_of" not in r
            or "stata_resolves_to" not in r):
        A7_BAD.append(ab + ":key-missing")
        continue
    cand = r["stata_accepted_prefix_in_context_of"] or []
    tgt  = r["stata_resolves_to"]
    if len(cand) > 1 and not tgt:
        A7_BAD.append(ab + ":unresolved")
        continue
    if len(cand) > 1 and tgt:
        add("A7", ab + "() is legal for " + str(len(cand)) +
            " twoway options; twoway picks " + tgt,
            opt_cmd(ab, tgt), keys=tgt, optname=tgt)

# ---- R1: every full option name ---------------------------------------
for name in DASH_PLOT_KEYS + DASH_GRAPH_KEYS:
    add("R1", name + "()", opt_cmd(name, name),
        keys=("" if name == "name" else name), optname=name)

# ---- R2/R3: today's short forms ---------------------------------------
for ab in sorted(MATA_OPT_ALIAS):
    tgt = MATA_OPT_ALIAS[ab]
    sr  = (RES.get(ab) or {}).get("stata_resolves_to")
    mismapped = bool(sr) and sr != tgt
    if tgt.startswith(ab) and not mismapped:
        add("R2", ab + "() -> " + tgt + "()", opt_cmd(ab, tgt),
            keys=("" if tgt == "name" else tgt), optname=tgt)
    else:
        allowed = tgt if not sr else (tgt + " " + sr)
        if ab in D["dash_abbrev_unresolved"]:
            allowed = "barwidth bwidth"
        if ab == "bw":
            # bw() is resolved by plot type since WP-13: barwidth on the
            # bar family, bwidth on the bandwidth types, named elsewhere.
            # test_alias_semantics.cscript certifies every type; here the
            # bar context keeps the historical fold observable.
            add("R3", ab + "() -> barwidth() on bar",
                "bar mpg weight, bw(100) name(zqab)",
                keys="barwidth", optname=ab, mode="nosilent")
            continue
        add("R3", ab + "() must never land anywhere but [" + allowed + "]",
            opt_cmd(ab, sr or tgt),
            keys=("" if (sr or tgt) == "name" else allowed),
            optname=ab, mode="nosilent")

# ---- R4: plot-type full names and today's short forms ------------------
# "function" is deliberately absent from R4.  dash cannot parse ANY function
# varlist today -- `dash function y=x` returns r(101), which is a varlist
# defect covered by test_varlist_expansion.cscript V2-06, not an abbreviation
# defect.  Putting it in a guard that must be green today would misattribute
# that bug to this section.  It is still exercised in A5 and A6.
R4_SKIP = {"function"}
for name in MATA_PT_FULL:
    if name in R4_SKIP:
        continue
    add("R4", name, name + " " + PT_VARS.get(name, "mpg weight") +
        ", name(zqab)", ptype=name, optname=name)
for ab in sorted(MATA_PT_ALIAS):
    tgt = MATA_PT_ALIAS[ab]
    if tgt in R4_SKIP:
        continue
    add("R4", ab + " -> " + tgt, ab + " " + PT_VARS.get(tgt, "mpg weight") +
        ", name(zqab)", ptype=tgt, optname=tgt)

# ---------------------------------------------------------------- export
sfi.Macro.setGlobal("ZQACAND", " ".join(CAND))
sfi.Macro.setGlobal("ZQAN", str(len(CASES)))
for n, c in enumerate(CASES, start=1):
    sfi.Macro.setGlobal("ZQAG%d" % n, c["g"])
    sfi.Macro.setGlobal("ZQAI%d" % n, c["i"])
    sfi.Macro.setGlobal("ZQAC%d" % n, c["c"])
    sfi.Macro.setGlobal("ZQAK%d" % n, c["k"])
    sfi.Macro.setGlobal("ZQAT%d" % n, c["t"])
    sfi.Macro.setGlobal("ZQAO%d" % n, c["o"])
    sfi.Macro.setGlobal("ZQAM%d" % n, c["m"])

# what the fixture says the pre-fix failures are
sfi.Macro.setGlobal("ZQA_EXP_RCFAIL", " ".join(D["dash_rejects_min_abbrev"]))
sfi.Macro.setGlobal("ZQA_EXP_RCFAIL_N", str(D["_meta"]["counts"]["dash_rejects_min_abbrev"]))
sfi.Macro.setGlobal("ZQA_EXP_MISMAP",
                    " ".join(sorted(n for n, e in OPTS.items()
                                    if e["dash"].get("accepts") and
                                    e["dash"].get("key") != n)))
sfi.Macro.setGlobal("ZQA_EXP_MISMAP_N", str(D["_meta"]["counts"]["dash_mismaps"]))
sfi.Macro.setGlobal("ZQA_EXP_PTFAIL",
                    " ".join(sorted(n for n, e in PTS.items()
                                    if not e["dash"].get("accepts"))))
sfi.Macro.setGlobal("ZQA_FIXDATE", D["_meta"]["run_date"])
sfi.Macro.setGlobal("ZQA_NOPT", str(len(OPTS)))
sfi.Macro.setGlobal("ZQA_NPT", str(len(PTS)))

# ---------------------------------------------------------------- sizes
# The number of cases each group must run.  ZQA_BUILT_<g> is what was built
# here, which the driver must match; ZQA_EXPN_<g> is the same number from a
# source other than the loop that built it wherever there is one -- the
# fixture's _meta.counts for A1, A3 and A5, and the pinned lists above for
# R1 and for R2 and R3 together.  Elsewhere it is the built count.
BUILT = {}
for c in CASES:
    BUILT[c["g"]] = BUILT.get(c["g"], 0) + 1
EXPN = dict(BUILT)
EXPN["A1"] = META["options"]
EXPN["A3"] = META["dash_mismaps"]
EXPN["A5"] = META["plottypes"]
EXPN["R1"] = len(DASH_PLOT_KEYS) + len(DASH_GRAPH_KEYS)
for g in ("A1", "A2", "A3", "A4", "A5", "A6", "A7", "R1", "R2", "R3", "R4"):
    sfi.Macro.setGlobal("ZQA_BUILT_" + g, str(BUILT.get(g, 0)))
    sfi.Macro.setGlobal("ZQA_EXPN_" + g, str(EXPN.get(g, 0)))
sfi.Macro.setGlobal("ZQA_EXPN_R23", str(len(MATA_OPT_ALIAS)))
sfi.Macro.setGlobal("ZQA_NDOC", str(N_DOC))
sfi.Macro.setGlobal("ZQA_A7_BAD", " ".join(A7_BAD))
sfi.Macro.setGlobal("ZQA_A7_NBAD", str(len(A7_BAD)))
sfi.Macro.setGlobal("ZQA_A4B_N", str(len(DOC_BUILD)))
for n, (s, f) in enumerate(DOC_BUILD, start=1):
    sfi.Macro.setGlobal("ZQA_A4B_S%d" % n, s)
    sfi.Macro.setGlobal("ZQA_A4B_F%d" % n, f)
    sfi.Macro.setGlobal("ZQA_A4B_V%d" % n, A4_BUILD[f])
end

// ----------------------------------------------------------------
// Fixtures
// ----------------------------------------------------------------
qui sysuse auto, clear
// tsline and tsrline read their time variable from tsset, as twoway does.
qui generate int zqa_t = _n
qui tsset zqa_t

display as text ""
display as text "============================================================"
display as text "  test_abbreviations"
display as text "  fixture: ${ZQA_FIXTURE}  (probed ${ZQA_FIXDATE})"
display as text "  ${ZQA_NOPT} options, ${ZQA_NPT} plot types, ${ZQAN} cases"
display as text "============================================================"

local nfail   = 0
local faillist ""

// per-group tallies and identity lists
local rcfail   ""
local keyfail  ""
local ptfail   ""
local docfail  ""
foreach g in A1 A2 A3 A4 A5 A6 A7 R1 R2 R3 R4 {
    local n_`g' = 0
    local f_`g' = 0
}

// ----------------------------------------------------------------
// Drive every case
// ----------------------------------------------------------------
// -forvalues- does not accept a ${global} in its range spec
// ("code follows on the same line as open brace"), so copy it to a local.
local zqa_ncase = ${ZQAN}
forvalues i = 1/`zqa_ncase' {
    local grp  "${ZQAG`i'}"
    local id   `"${ZQAI`i'}"'
    local expk "${ZQAK`i'}"
    local expt "${ZQAT`i'}"
    local onam "${ZQAO`i'}"
    local mode "${ZQAM`i'}"
    local n_`grp' = `n_`grp'' + 1

    capture quietly dash clear
    capture macro drop dash_json_zqab
    capture quietly dash ${ZQAC`i'}
    local rc = _rc

    local gotk ""
    local gott ""
    local nonempty "0"
    if `rc' == 0 {
        mata: _zqa_nonempty("dash_json_zqab", "nonempty")
        mata: _zqa_keys("dash_json_zqab", "${ZQACAND}", "gotk")
        mata: _zqa_type("dash_json_zqab", "gott")
    }
    local gotk : list sort gotk
    local expk : list sort expk

    // ---- assertion 1: accepted (or, for R3, at least not silently wrong)
    local bad1 = 0
    local bad2 = 0
    if "`mode'" == "nosilent" {
        if `rc' == 0 {
            local extra : list gotk - expk
            if "`extra'" != "" | `: word count `gotk'' != 1 local bad2 = 1
        }
    }
    else {
        if `rc' != 0            local bad1 = 1
        else if "`nonempty'" != "1" local bad1 = 1
    }

    // ---- assertion 2: the value landed under the FULL option name
    if `bad1' == 0 & "`mode'" == "ok" {
        if "`gotk'" != "`expk'"           local bad2 = 1
        if "`expt'" != "" & "`gott'" != "`expt'" local bad2 = 1
    }

    if `bad1' | `bad2' {
        local f_`grp' = `f_`grp'' + 1
        local nfail   = `nfail' + 1
        if `bad1' {
            display as error `"`grp' FAIL rc: `id'  (rc=`rc')  cmd: dash ${ZQAC`i'}"'  
            if "`grp'" == "A1" local rcfail `"`rcfail' `onam'"'
            if "`grp'" == "A5" local ptfail `"`ptfail' `onam'"'
            if "`grp'" == "A4" local docfail `"`docfail' `onam'"' 
        }
        else {
            display as error `"`grp' FAIL map: `id'  recorded [`gotk']"' ///
                `" type [`gott'], expected [`expk'`expt']"'  
            if "`grp'" == "A1" local keyfail `"`keyfail' `onam'"'
            if "`grp'" == "A5" local ptfail  `"`ptfail' `onam'"'
        }
    }
}

// ----------------------------------------------------------------
// A8 — dash kpi abbreviations
//
// dash.ado:1065 declares  name(string)   all lowercase  -> no abbreviation
// dash.ado:1070 declares  UPDATE(string) all capitals   -> no abbreviation
// dash.sthlp:61 and :66 document nam() and upd().
// ----------------------------------------------------------------
capture quietly dash clear
capture noisily dash kpi mean(mpg), ti(Average) nam(zqk1)
local rc_nam = _rc
capture {
    assert `rc_nam' == 0
    assert "${dash_kpi_zqk1}" == "1"
    assert "${dash_kpi_zqk1__sta}" == "mean"
}
if _rc {
    display as error "A8 FAIL: -dash kpi mean(mpg), ti() nam(zqk1)- rc=`rc_nam'; " ///
        "dash.sthlp:61 documents nam(), dash.ado:1065 declares name() lowercase."
    local nfail = `nfail' + 1
    local faillist `"`faillist' A8(nam)"'
}
else display as text "A8 PASS: dash kpi nam() accepted"

capture quietly dash clear
capture noisily dash kpi mean(mpg), title(Average) name(zqk2) upd(both)
local rc_upd = _rc
capture {
    assert `rc_upd' == 0
    assert "${dash_kpi_zqk2__upd}" == "both"
}
if _rc {
    display as error "A8 FAIL: -dash kpi ..., upd(both)- rc=`rc_upd', " ///
        "update recorded as '${dash_kpi_zqk2__upd}'; dash.sthlp:66 documents " ///
        "upd(), dash.ado:1070 declares UPDATE() in full capitals."
    local nfail = `nfail' + 1
    local faillist `"`faillist' A8(upd)"'
}
else display as text "A8 PASS: dash kpi upd() accepted"

// A8 regression guard: the KPI spellings that work today must keep working
capture quietly dash clear
capture noisily dash kpi mean(mpg), title(Average) name(zqk3) ///
    fmt(%9.2f) sub(sub) color(navy) bgcolor(white) update(brush)
local rc_kfull = _rc
capture {
    assert `rc_kfull' == 0
    assert "${dash_kpi_zqk3__upd}" == "brush"
    assert "${dash_kpi_zqk3__fmt}" == "%9.2f"
    assert "${dash_kpi_zqk3__sub}" == "sub"
}
if _rc {
    display as error "A8 FAIL (guard): the full KPI option names regressed, rc=`rc_kfull'."
    local nfail = `nfail' + 1
    local faillist `"`faillist' A8(guard)"'
}
else display as text "A8 PASS: full KPI option names still work"

capture quietly dash clear

// ----------------------------------------------------------------
// A4b -- the dash build options dash.sthlp documents with an abbreviation
//
// nobr:owser and filterpos:ition belong to dash build, and the one-line
// command ignores both with a note and rc 0 (see A4 above), so they are
// sent to dash build, whose -syntax- refuses an option it does not declare:
// the control below, nobrowserz, is r(198).
// ----------------------------------------------------------------
local n_A4b = 0
local f_A4b = 0
local zqa_nb = ${ZQA_A4B_N}
forvalues j = 1/`zqa_nb' {
    local sp  "${ZQA_A4B_S`j'}"
    local v   "${ZQA_A4B_V`j'}"
    local tok = cond("`v'" == "", "`sp'", "`sp'(`v')")
    capture quietly dash clear
    quietly dash scatter mpg weight, name(zqab)
    capture quietly dash build, saving("${ZQA_TMPSAV}") replace `tok'
    local rc = _rc
    local n_A4b = `n_A4b' + 1
    if `rc' != 0 {
        display as error "A4b FAIL rc: dash.sthlp documents `sp'() for ${ZQA_A4B_F`j'}() and dash build refuses `tok' (rc=`rc')"
        local f_A4b = `f_A4b' + 1
        local nfail = `nfail' + 1
        local faillist `"`faillist' A4b(`sp')"'
    }
}
capture quietly dash clear
quietly dash scatter mpg weight, name(zqab)
capture quietly dash build, saving("${ZQA_TMPSAV}") replace nobrowserz
local rc = _rc
if `rc' != 198 {
    display as error "A4b FAIL control: dash build, nobrowserz gave rc=`rc', not 198"
    local nfail = `nfail' + 1
    local faillist `"`faillist' A4b(control)"'
}
capture quietly dash clear

// ----------------------------------------------------------------
// Sizes -- every group ran every case its source holds
//
// The per-group counts were only displayed, so a group whose source had
// emptied -- a fixture key renamed, the help's {cmdab:} markup changed --
// ran no cases and passed.  Each group must now be non-empty, must have
// run every case built for it, and must match its source where the source
// states a size: the fixture's _meta.counts for A1 (options), A3
// (dash_mismaps) and A5 (plottypes), the pinned lists above for R1 and for
// R2 and R3 together.  And dash.sthlp documents 102 spellings, measured
// 24sep2026 from its {cmdab:} tokens, 112 since GAPS2 X2 (7acdcb1) added
// zti(), zlab(), zsc(), colorlev() and colorvarminm() and their full names (the KPI and layout ones set aside;
// 88 before the S3 batch's table of a ci band's options added ac(),
// alc(), alw(), alp(), fc(), fi() and lc() and their full names) -- A4
// runs the one-line ones and A4b the dash build ones.  A help
// file that documents another abbreviation changes that count on purpose;
// one whose markup this parser no longer reads fails here.
// ----------------------------------------------------------------
foreach g in A1 A2 A3 A4 A5 A6 A7 R1 R2 R3 R4 {
    capture {
        assert `n_`g'' > 0
        assert `n_`g'' == ${ZQA_BUILT_`g'}
        assert `n_`g'' == ${ZQA_EXPN_`g'}
    }
    if _rc {
        display as error "SIZE FAIL: `g' ran `n_`g'' cases; ${ZQA_BUILT_`g'} were built and its source holds ${ZQA_EXPN_`g'}"
        local nfail = `nfail' + 1
        local faillist `"`faillist' size(`g')"'
    }
}
if `n_R2' + `n_R3' != ${ZQA_EXPN_R23} {
    display as error "SIZE FAIL: R2 and R3 ran `=`n_R2' + `n_R3'' cases for ${ZQA_EXPN_R23} short forms"
    local nfail = `nfail' + 1
    local faillist `"`faillist' size(R2+R3)"'
}
// 130 since WP-30 P1.14a documented the named styles' nine minimums and
// their full names (18).
if ${ZQA_NDOC} != 130 | `n_A4' + `n_A4b' != ${ZQA_NDOC} | `n_A4b' != 4 {
    display as error "SIZE FAIL: dash.sthlp documents ${ZQA_NDOC} spellings (130 measured); A4 ran `n_A4' and A4b `n_A4b'"
    local nfail = `nfail' + 1
    local faillist `"`faillist' size(A4)"'
}
if ${ZQA_A7_NBAD} != 0 {
    display as error "SIZE FAIL: abbrev_resolution entries A7 could not read: ${ZQA_A7_BAD}"
    local nfail = `nfail' + 1
    local faillist `"`faillist' size(A7)"'
}

// ----------------------------------------------------------------
// NP-30..NP-33 (WP-30 P1.14a): the named styles' minimum abbreviations,
// twoway's (test/fixtures/named_style_truth.json A01-A13).  NP-30 each
// lands on its key; NP-31 none is named; NP-32 pst(), ps() and as(), which
// twoway refuses, are named as typed, rc 0 (P2.21); NP-33 ml(p3) is
// mlabel(p3), r(111) as in twoway.
// ----------------------------------------------------------------
capture mata: mata drop _znp_logn()
mata:
real scalar _znp_logn(string scalar path, string scalar needle)
{
    real scalar fh, n
    string scalar ln
    n = 0
    fh = fopen(path, "r")
    while ((ln = fget(fh)) != J(0, 0, "")) n = n + (strpos(ln, needle) > 0)
    fclose(fh)
    return(n)
}
end
tempfile znp_log
local np30 0
local np31 0
local i 0
foreach c in "scatter mpg weight, psty(p3)|pstyle" "scatter mpg weight, p(p3)|p" ///
    "line mpg weight, ls(p3)|lstyle" "line mpg weight, cls(p3)|clstyle" ///
    "scatter mpg weight, mst(p3)|mstyle" "scatter mpg weight, mls(p3)|mlstyle" ///
    "area mpg weight, ast(p3)|astyle" "spike mpg weight, al(p3)|alstyle" ///
    "bar mpg weight, bst(p3)|bstyle" "bar mpg weight, bl(p3)|blstyle" {
    local ++i
    gettoken cmd key : c, parse("|")
    local key = substr("`key'", 2, .)
    capture dash clear
    capture log close _znp
    quietly log using "`znp_log'", text replace name(_znp)
    capture noisily dash `cmd' name(znp`i')
    local rc = _rc
    quietly log close _znp
    mata: st_local("hit", strofreal(strpos(st_global("dash_json_znp`i'"), char(34) + "`key'" + char(34) + ":" + char(34) + "p3" + char(34)) > 0))
    if `rc' | !`hit' {
        display as error "NP-30 FAIL: `cmd' did not land on `key': ${dash_json_znp`i'}"
        local np30 1
    }
    mata: st_local("nn", strofreal(_znp_logn(st_local("znp_log"), "ignoring unsupported")))
    if `nn' {
        display as error "NP-31 FAIL: `cmd' was named"
        local np31 1
    }
}
foreach g in 30 31 {
    if `np`g'' {
        local nfail = `nfail' + 1
        local faillist `"`faillist' NP-`g'"'
    }
    else display as text "NP-`g' PASS: " cond(`g' == 30, "the ten minimums land on their keys", "none of them is named")
}
local np32 0
foreach c in "scatter mpg weight, pst(p3)|pst()" "scatter mpg weight, ps(p3)|ps()" "area mpg weight, as(p3)|as()" {
    gettoken cmd nm : c, parse("|")
    local nm = substr("`nm'", 2, .)
    capture dash clear
    capture log close _znp
    quietly log using "`znp_log'", text replace name(_znp)
    capture noisily dash `cmd' name(znp32)
    local rc = _rc
    quietly log close _znp
    mata: st_local("nn", strofreal(_znp_logn(st_local("znp_log"), "`nm'")))
    if `rc' | !`nn' {
        display as error "NP-32 FAIL: `cmd': rc `rc', `nm' named `nn'"
        local np32 1
    }
}
if `np32' {
    local nfail = `nfail' + 1
    local faillist `"`faillist' NP-32"'
}
else display as text "NP-32 PASS: pst(), ps() and as() are named as typed, rc 0"
capture dash clear
capture noisily dash scatter mpg weight, ml(p3) name(znp33)
local rc = _rc
capture noisily twoway scatter mpg weight, ml(p3) nodraw
if `rc' != 111 | _rc != 111 {
    local nfail = `nfail' + 1
    local faillist `"`faillist' NP-33"'
    display as error "NP-33 FAIL: dash r(`rc'), twoway r(`=_rc')"
}
else display as text "NP-33 PASS: ml(p3) is r(111) in dash and in twoway"
capture dash clear

// ----------------------------------------------------------------
// Report
// ----------------------------------------------------------------
local rcfail  : list sort rcfail
local keyfail : list sort keyfail
local ptfail  : list sort ptfail
local exprc   "${ZQA_EXP_RCFAIL}"
local expmap  "${ZQA_EXP_MISMAP}"
local exppt   "${ZQA_EXP_PTFAIL}"
local exprc   : list sort exprc
local expmap  : list sort expmap
local exppt   : list sort exppt

display as text ""
display as text "------------------------------------------------------------"
display as text "  per-group results (failures / cases)"
display as text "------------------------------------------------------------"
foreach g in A1 A2 A3 A4 A5 A6 A7 R1 R2 R3 R4 {
    display as text "   `g' : `f_`g'' / `n_`g''"
}
display as text "   A4b: `f_A4b' / `n_A4b'"

display as text ""
display as text "------------------------------------------------------------"
display as text "  cross-check against ${ZQA_FIXTURE}"
display as text "------------------------------------------------------------"
display as text "  A1 rc-failures observed : `: word count `rcfail''" ///
    "   fixture dash_rejects_min_abbrev : ${ZQA_EXP_RCFAIL_N}"
local d1 : list rcfail - exprc
local d2 : list exprc - rcfail
if "`d1'`d2'" == "" {
    display as text "  -> identical set"
}
else {
    display as error "  -> MISMATCH.  observed but not in fixture: `d1'"
    display as error "  ->            in fixture but not observed: `d2'"
}

display as text "  A1 map-failures observed: `: word count `keyfail''" ///
    "   fixture dash_mismaps            : ${ZQA_EXP_MISMAP_N}"
local d3 : list keyfail - expmap
local d4 : list expmap - keyfail
if "`d3'`d4'" == "" {
    display as text "  -> identical set"
}
else {
    display as error "  -> MISMATCH.  observed but not in fixture: `d3'"
    display as error "  ->            in fixture but not observed: `d4'"
}

display as text "  A5 plot-type failures   : `: word count `ptfail''" ///
    "   fixture plottypes dash rejects  : `: word count `exppt''"
local d5 : list ptfail - exppt
local d6 : list exppt - ptfail
if "`d5'`d6'" == "" {
    display as text "  -> identical set"
}
else {
    display as error "  -> MISMATCH.  observed but not in fixture: `d5'"
    display as error "  ->            in fixture but not observed: `d6'"
}

display as text ""
display as text "  A1 rc-failures : `rcfail'"
display as text ""
display as text "  A1 map-failures: `keyfail'"
display as text ""
display as text "  A4 spellings dash.sthlp documents that dash rejects:"
display as text `"  `docfail'"'
display as text ""

capture quietly dash clear
capture macro drop ZQA*

display as text "============================================================"
if `nfail' == 0 {
    display as text "  test_abbreviations: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_abbreviations: `nfail' CHECK(S) FAILED"
    if `"`faillist'"' != "" display as error "  named failures:`faillist'"
    display as text "============================================================"
    exit 9
}
