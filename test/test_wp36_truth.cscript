*! test_wp36_truth.cscript
*! WP-36's ONE certification script (.ultraplan/sections/index.md PD-6):
*! every comparison with twoway's drawing or with Stata's own values that
*! WP-36's sections need lives here, one block per GAPS4 row (or per
*! harness tool), appended above the "append new blocks above this line"
*! marker in section order.  Refusal, message and return-code checks join
*! the EXISTING script for their area (merge rule R1).
*!
*! Made from test/templates/wp_truth_template.cscript (36 -> the WP's
*! number).  S00 is the scaffold smoke (Q3600-1).  A section appends
*! `* ==== S<MM> <lead id>: <what> ====` ... `* ==== end S<MM> ====` (or
*! `S<MM> tool: <what>` for a section with no item), its helper programs
*! directly above its first header, and writes only inside its own
*! blocks.  Case ids are Q36<MM>-<k> (PD-5).
*!
*! Usage: via run_all_cscripts.do.  One block alone: WP36_ONLY=S<MM> in
*! the driver's environment.  Each block prints "S<MM> start" and "S<MM>
*! end" with the date and time.  The suite runs it in every session;
*! DASH_CERT_SHARD=k/N runs part k of N of the blocks; a part with no
*! block ends 0.

cscript "WP-36 truth: twoway comparisons" adodir ".."

clear all
// Certification timing: run_all_cscripts.do reads timer 100 when this
// script ends; with DASH_CERT_PROFILE set it also prints the profile.
timer clear 100
timer on 100
local _cert_prof : environment DASH_CERT_PROFILE
if "`_cert_prof'" != "" {
    capture profiler clear
    profiler on
}
set more off


do "cert_helpers.do"
quietly do "cert_svg.do"
qui do "../dash_parse.mata"
qui do "../dash.ado"
global dash_nobrowser 1

// ----------------------------------------------------------------
// Tally helpers -- test_wp29_truth.cscript's _w29_expect/_w29_done,
// renamed _w36_ for this script.  A case is any number of
// _w36_expect lines closed by one _w36_done.
// ----------------------------------------------------------------
global w36_nfail    = 0
global w36_faillist ""
global w36_bad      = 0
global w36_ncase    = 0

capture program drop _w36_expect
program define _w36_expect
    version 19
    args id cond msg
    if !(`cond') {
        display as error `"`id' FAIL: `macval(msg)'"'
        global w36_bad = 1
    }
end

capture program drop _w36_done
program define _w36_done
    version 19
    args id msg
    if ${w36_bad} {
        global w36_nfail    = ${w36_nfail} + 1
        global w36_faillist "${w36_faillist} `id'"
    }
    else display as text `"`id' PASS: `macval(msg)'"'
    global w36_bad   = 0
    global w36_ncase = ${w36_ncase} + 1
end

// A fresh directory for this run's files, never one that already exists:
// a fixed name in a shared temp directory could be planted by another
// account (rule 1), so a name Stata has not handed out before is made and
// the run fails if it cannot be.  Every block writes only under it.
tempfile w36_base
local w36_work "`w36_base'_w36"
capture mkdir "`w36_work'"
if _rc {
    display as error "test_wp36_truth: cannot create the work directory `w36_work' (rc `=_rc')"
    exit 9
}

// ---- parts: begin (WP-36 test performance) ----
// The certification suite runs this script in every one of its sessions
// (its row in run_all_cscripts.do's shard table is "* * *"); with
// DASH_CERT_SHARD=k/N set, the session runs part k of N of the blocks.
// The parts are balanced longest first onto the least loaded part (the
// lowest numbered of equals), by the seconds below -- a block not listed
// counts 1 s (section-01 D-01.f) -- the rule scripts/cert_shards.py uses
// for the scripts.  Unset, or with WP36_ONLY set
// (which keeps its precedence), every block runs.  A block runs when its
// gate finds its id in w36_run.
// Seconds: each block's start/end lines in the WP's last measured
// certification run, rounded up, at least 1; a block not listed
// counts 1 s.
local w36_secs S00 1
local w36_sh : environment DASH_CERT_SHARD
mata: st_local("w36_ok", strofreal(st_local("w36_sh") == "" | ustrregexm(st_local("w36_sh"), "^[1-4]/[1-4]$")))
if !`w36_ok' {
    display as error "test_wp36_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 4"
    exit 198
}
local w36_k 1
local w36_N 1
if "`w36_sh'" != "" {
    local w36_k = real(substr("`w36_sh'", 1, 1))
    local w36_N = real(substr("`w36_sh'", 3, 1))
}
local w36_only : env WP36_ONLY
if `"`macval(w36_only)'"' != "" | `w36_N' == 1 {
    local w36_k 1
    local w36_N 1
}
if `w36_k' > `w36_N' {
    display as error "test_wp36_truth: DASH_CERT_SHARD must be k/N, 1 <= k <= N <= 4"
    exit 198
}
capture confirm file "test_wp36_truth.cscript"
if _rc {
    display as error "test_wp36_truth: run it from test/, where it reads its own blocks"
    exit 601
}
capture mata: mata drop _w36_part()
mata:
// The ids of the blocks (their header lines, in file order), and those of
// part k of n: longest first onto the least loaded part.
void _w36_part(string scalar file, string scalar table, real scalar k,
               real scalar n)
{
    string colvector lines, ids
    string rowvector tok
    real colvector sec, o, at
    real rowvector load
    real scalar i, j, p, best
    string scalar run

    lines = cat(file)
    ids = J(0, 1, "")
    for (i = 1; i <= rows(lines); i++) {
        if (ustrregexm(lines[i], "^\* ==== (S[0-9]+) ")) {
            if (!anyof(ids, ustrregexs(1))) ids = ids \ ustrregexs(1)
        }
    }
    sec = J(rows(ids), 1, 1)
    tok = tokens(table)
    for (j = 1; j + 1 <= cols(tok); j = j + 2) {
        for (i = 1; i <= rows(ids); i++) {
            if (ids[i] == tok[j]) sec[i] = strtoreal(tok[j + 1])
        }
    }
    o = order((-sec, (1::rows(ids))), (1, 2))
    load = J(1, n, 0)
    at = J(rows(ids), 1, 0)
    for (i = 1; i <= rows(o); i++) {
        best = 1
        for (p = 2; p <= n; p++) if (load[p] < load[best]) best = p
        load[best] = load[best] + sec[o[i]]
        at[o[i]] = best
    }
    run = ""
    for (i = 1; i <= rows(ids); i++) if (at[i] == k) run = run + " " + ids[i]
    st_local("w36_run", strtrim(run))
}
end
mata: _w36_part("test_wp36_truth.cscript", st_local("w36_secs"), `w36_k', `w36_N')
display as text "test_wp36_truth: part `w36_k'/`w36_N' runs `: word count `w36_run'' blocks: `w36_run'"
// ---- parts: end ----

* ==== S00 scaffold: the helpers load and a twoway SVG is read ====
local only : env WP36_ONLY
if inlist("`only'", "", "S00") & `: list posof "S00" in w36_run' {
    display as text "S00 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3600-1: cert_svg_export and cert_svg_texts on one twoway scatter,
    // and dash's own programs are loaded from this tree.
    // ------------------------------------------------------------
    sysuse auto, clear
    quietly twoway scatter mpg weight, name(w36s01, replace)
    cert_svg_export, name(w36s01) file("`w36_work'/w36s01.svg")
    local s01_rc   = r(rc)
    local s01_file "`r(file)'"
    _w36_expect Q3600-1 "(`s01_rc' == 0)" "cert_svg_export rc `s01_rc'"
    capture confirm file "`s01_file'"
    _w36_expect Q3600-1 "(_rc == 0)" "r(file) `s01_file' does not exist"
    cert_svg_texts, file("`s01_file'")
    local s01_n    = r(n)
    local s01_list "`r(list)'"
    _w36_expect Q3600-1 "(`s01_n' > 0)" "cert_svg_texts found no text elements"
    capture program list _dash_serve
    _w36_expect Q3600-1 "(_rc == 0)" "dash.ado's _dash_serve is not loaded"
    _w36_done Q3600-1 "a twoway SVG was written and read (`s01_n' texts); dash is loaded"

    capture erase "`s01_file'"
    capture erase "`s01_list'"
    capture graph drop w36s01
    display as text "S00 end " c(current_date) " " c(current_time)
}
* ==== end S00 ====

python:
import json as _w36s02_json
import re as _w36s02_re
from html import unescape as _w36s02_unescape
from sfi import Macro as _w36s02_M


def _w36s02_backends(path):
    """Global w36s02_be: each Figure's output_backend on the saved page
    path, "canvas" where the document writes none (Bokeh's default)."""
    out = []
    try:
        page = open(path, encoding="utf-8").read()
        m = _w36s02_re.search(
            r'<script[^>]+type=["\']application/json["\'][^>]*>', page)
        body = page[m.end():page.index("</script>", m.end())]

        def walk(node):
            if isinstance(node, dict):
                attrs = node.get("attributes")
                if node.get("name") == "Figure" and isinstance(attrs, dict):
                    out.append(str(attrs.get("output_backend", "canvas")))
                for v in node.values():
                    walk(v)
            elif isinstance(node, list):
                for v in node:
                    walk(v)

        walk(_w36s02_json.loads(_w36s02_unescape(body)))
        _w36s02_M.setGlobal("w36s02_be", " ".join(out))
    except Exception as e:
        _w36s02_M.setGlobal("w36s02_be", "error " + str(e)[:200])
end

* ==== S02 DG-14: WebGL on the rows a graph draws, dashes on canvas ====
local only : env WP36_ONLY
if inlist("`only'", "", "S02") & `: list posof "S02" in w36_run' {
    display as text "S02 start " c(current_date) " " c(current_time)

    // twoway has one renderer: the rule is dash's own (research [B]
    // section 4.7).  20,000 rows, past _WEBGL_THRESHOLD (10,000).
    clear
    quietly set obs 20000
    quietly gen x = _n
    quietly gen y = mod(_n, 97)

    // ------------------------------------------------------------
    // Q3602-1: a dashed line over 20,000 rows is drawn on canvas.
    // ------------------------------------------------------------
    capture erase "`w36_work'/s02_1.html"
    capture noisily dash line y x, lpattern(dash) saving("`w36_work'/s02_1.html", replace)
    _w36_expect Q3602-1 "(_rc == 0)" "dash line ... lpattern(dash) rc `=_rc'"
    python: _w36s02_backends(r"`w36_work'/s02_1.html")
    _w36_expect Q3602-1 `"("${w36s02_be}" == "canvas")"' "backends: ${w36s02_be}"
    _w36_done Q3602-1 "lpattern(dash) on 20,000 rows: ${w36s02_be}"
    capture erase "`w36_work'/s02_1.html"
    capture dash clear

    // ------------------------------------------------------------
    // Q3602-2: a graph of in 1/100 draws 100 rows: canvas.
    // ------------------------------------------------------------
    capture erase "`w36_work'/s02_2.html"
    capture noisily dash scatter y x in 1/100, saving("`w36_work'/s02_2.html", replace)
    _w36_expect Q3602-2 "(_rc == 0)" "dash scatter ... in 1/100 rc `=_rc'"
    python: _w36s02_backends(r"`w36_work'/s02_2.html")
    _w36_expect Q3602-2 `"("${w36s02_be}" == "canvas")"' "backends: ${w36s02_be}"
    _w36_done Q3602-2 "scatter in 1/100 of 20,000 rows: ${w36s02_be}"
    capture erase "`w36_work'/s02_2.html"
    capture dash clear

    // ------------------------------------------------------------
    // Q3602-3: a solid scatter of all 20,000 rows keeps WebGL.
    // ------------------------------------------------------------
    capture erase "`w36_work'/s02_3.html"
    capture noisily dash scatter y x, saving("`w36_work'/s02_3.html", replace)
    _w36_expect Q3602-3 "(_rc == 0)" "dash scatter rc `=_rc'"
    python: _w36s02_backends(r"`w36_work'/s02_3.html")
    _w36_expect Q3602-3 `"("${w36s02_be}" == "webgl")"' "backends: ${w36s02_be}"
    _w36_done Q3602-3 "scatter of 20,000 rows: ${w36s02_be}"
    capture erase "`w36_work'/s02_3.html"
    capture dash clear

    macro drop w36s02_be
    display as text "S02 end " c(current_date) " " c(current_time)
}
* ==== end S02 ====

* ==== S03 plat:PT-4: function points of a named graph off the macro ====
local only : env WP36_ONLY
if inlist("`only'", "", "S03") & `: list posof "S03" in w36_run' {
    display as text "S03 start " c(current_date) " " c(current_time)
    local s03d "`w36_work'/s03"
    capture mkdir "`s03d'"

    // ------------------------------------------------------------
    // Q3603-1: the five accessors and _dash_fpts_open on a scratch
    // folder: a shorter text replaces a longer one, G and g are two
    // files, a second drop is no error, clear empties the folder.  The
    // session's $dash__fpdir is put back afterwards.
    // ------------------------------------------------------------
    mata: st_local("s03_keep", st_global("dash__fpdir"))
    local s03f "`s03d'/q1"
    capture mkdir "`s03f'"
    global dash__fpdir "`s03f'"
    capture noisily _dash_fpts_open q1
    _w36_expect Q3603-1 "(_rc == 0)" "_dash_fpts_open q1 rc `=_rc'"
    capture noisily mata: _dash_fpts_put("q1", "abc")
    _w36_expect Q3603-1 "(_rc == 0)" "_dash_fpts_put rc `=_rc'"
    capture mata: st_local("s03_g", _dash_fpts_get("q1"))
    _w36_expect Q3603-1 `"("`s03_g'" == "abc")"' "get after put abc read `s03_g'"
    capture mata: _dash_fpts_put("q1", "x")
    capture mata: st_local("s03_g", _dash_fpts_get("q1"))
    _w36_expect Q3603-1 `"("`s03_g'" == "x")"' "get after put x read `s03_g'"
    capture mata: st_local("s03_two", strofreal(_dash_fpts_path("Q1") != _dash_fpts_path("q1") & _dash_fpts_path("q1") != ""))
    _w36_expect Q3603-1 "(0`s03_two' == 1)" "Q1 and q1 share a path"
    capture mata: _dash_fpts_drop("q1")
    capture mata: st_local("s03_g", _dash_fpts_get("q1"))
    _w36_expect Q3603-1 `"("`s03_g'" == "")"' "get after drop read `s03_g'"
    capture noisily mata: _dash_fpts_drop("q1")
    _w36_expect Q3603-1 "(_rc == 0)" "a second drop rc `=_rc'"
    capture _dash_fpts_open q1
    capture _dash_fpts_open Q1
    capture mata: st_local("s03_n", strofreal(rows(dir(st_global("dash__fpdir"), "files", "fp-*.txt"))))
    _w36_expect Q3603-1 "(0`s03_n' == 2)" "two files expected, `s03_n' found"
    capture mata: _dash_fpts_clear()
    capture mata: st_local("s03_n", strofreal(rows(dir(st_global("dash__fpdir"), "files", "fp-*.txt"))))
    _w36_expect Q3603-1 `"("`s03_n'" == "0")"' "clear left `s03_n' files"
    mata: st_global("dash__fpdir", st_local("s03_keep"))
    capture rmdir "`s03f'"
    _w36_done Q3603-1 "the accessors write, replace, read, drop and clear one private file a graph"

    // ------------------------------------------------------------
    // Q3603-2: four 10,000-point function layers, past one macro at
    // this session's c(macrolen), with name(): twoway draws them and
    // dash registers and builds them with all 40,000 points; with a
    // variable that moves the working-column prefix too.  No set maxvar.
    // ------------------------------------------------------------
    display as text "Q3603-2: c(macrolen) is " %12.0fc c(macrolen)
    sysuse auto, clear
    capture dash clear
    local s03l "(function y = sin(x)/x, range(-100 100) n(10000))"
    capture noisily twoway `s03l' `s03l' `s03l' `s03l', nodraw
    local s03_trc = _rc
    capture noisily dash `s03l' `s03l' `s03l' `s03l', name(q2)
    local s03_drc = _rc
    _w36_expect Q3603-2 "(`s03_trc' == 0 & `s03_drc' == 0)" "twoway rc `s03_trc', dash rc `s03_drc'"
    capture mata: st_local("s03_len", strofreal(strlen(_dash_fpts_get("q2"))))
    _w36_expect Q3603-2 "(0`s03_len' > c(macrolen))" "the stored points are `s03_len' characters, not past c(macrolen)"
    local s03h "`s03d'/q2.html"
    capture erase "`s03h'"
    capture noisily dash build, saving("`s03h'") replace nobrowser
    _w36_expect Q3603-2 "(_rc == 0)" "dash build rc `=_rc'"
    capture confirm file "`s03h'"
    _w36_expect Q3603-2 "(_rc == 0)" "no page at `s03h'"
    forvalues s03k = 1/2 {
        if `s03k' == 2 quietly generate byte __dashz = 1
        local s03sp "`s03d'/q2s`s03k'.json"
        capture erase "`s03sp'"
        capture noisily _dash_serve_spec, specpath("`s03sp'") datapath("`s03d'/q2d`s03k'.json")
        _w36_expect Q3603-2 "(_rc == 0)" "the spec seam (pass `s03k') rc `=_rc'"
        local s03np ""
        python: import json, sfi; _s03j = json.load(open(sfi.Macro.getLocal("s03sp"), encoding="utf-8")); sfi.Macro.setLocal("s03np", str(sum(len(v.get("y", [])) for g in _s03j.get("function_points", {}).values() for v in g.values()))); del _s03j
        _w36_expect Q3603-2 `"("`s03np'" == "40000")"' "the spec (pass `s03k') carries `s03np' function points, not 40000"
        capture erase "`s03sp'"
        capture erase "`s03d'/q2d`s03k'.json"
    }
    capture erase "`s03h'"
    _w36_done Q3603-2 "four 10,000-point layers past c(macrolen): twoway rc 0, dash registers and builds all 40,000 points"

    // ------------------------------------------------------------
    // Q3603-3: replacing a function graph takes its file; dash clear
    // empties the session's points folder.
    // ------------------------------------------------------------
    sysuse auto, clear
    capture noisily dash scatter mpg weight, name(q2, replace)
    capture mata: st_local("s03_e", strofreal(fileexists(_dash_fpts_path("q2"))))
    _w36_expect Q3603-3 `"("`s03_e'" == "0")"' "q2's file is still there after the scatter replaced it"
    capture noisily dash function y = x, name(q3)
    capture mata: st_local("s03_e", strofreal(fileexists(_dash_fpts_path("q3"))))
    _w36_expect Q3603-3 `"("`s03_e'" == "1")"' "q3 has no file"
    capture dash clear
    capture mata: st_local("s03_n", strofreal(rows(dir(st_global("dash__fpdir"), "files", "fp-*.txt"))))
    _w36_expect Q3603-3 `"("`s03_n'" == "0")"' "dash clear left `s03_n' point files"
    _w36_done Q3603-3 "a replaced graph's file goes, and dash clear empties the points folder"

    capture rmdir "`s03d'"
    display as text "S03 end " c(current_date) " " c(current_time)
}
* ==== end S03 ====

* ==== S04 plat:PT-2: the Stata 19 floor ====
local only : env WP36_ONLY
if inlist("`only'", "", "S04") & `: list posof "S04" in w36_run' {
    display as text "S04 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3604-1: the help's floor -- dash refuses a Stata older than 19,
    // r(9).  No older Stata is run: _dash_stata_ok, the test
    // _dash_require_stata makes, is driven by value (as SF-01 of
    // test_wp30_truth.cscript measures Stata's own r(9)), and
    // _dash_require_stata passes on this Stata.
    // ------------------------------------------------------------
    capture noisily _dash_stata_ok "18.5" "19"
    local s04_rc = _rc
    local s04_ok = r(ok)
    local s04_sh "`r(shown)'"
    _w36_expect Q3604-1 "(`s04_rc' == 0 & `s04_ok' == 0)" "18.5 against floor 19: rc `s04_rc', ok `s04_ok'"
    _w36_expect Q3604-1 `"("`s04_sh'" == "18.5")"' "18.5 shown as `s04_sh'"
    capture noisily _dash_stata_ok "19.5" "19"
    local s04_ok = r(ok)
    _w36_expect Q3604-1 "(`s04_ok' == 1)" "19.5 against floor 19: ok `s04_ok'"
    capture noisily _dash_require_stata
    local s04_rc = _rc
    _w36_expect Q3604-1 "(`s04_rc' == 0)" "_dash_require_stata on Stata `c(stata_version)' gave rc `s04_rc'"
    _w36_done Q3604-1 "a Stata below 19 is refused by dash's floor test; this Stata passes it"

    display as text "S04 end " c(current_date) " " c(current_time)
}
* ==== end S04 ====

* ==== S04 plat:PT-12: the lock's coverage ====
local only : env WP36_ONLY
if inlist("`only'", "", "S04") & `: list posof "S04" in w36_run' {
    display as text "S04 start " c(current_date) " " c(current_time)

    // ------------------------------------------------------------
    // Q3604-3: dash_setup's help names the Pythons and platforms of the
    // lock's two header lines; lines 6 and 7 of dash_requirements.txt
    // are exactly those the sentence lists.
    // ------------------------------------------------------------
    capture mata: st_local("s04_n", strofreal(rows(cat("../dash_requirements.txt"))))
    _w36_expect Q3604-3 "(_rc == 0 & 0`s04_n' >= 7)" "dash_requirements.txt not read (rc `=_rc', `s04_n' lines)"
    capture mata: st_local("s04_py", cat("../dash_requirements.txt")[6])
    capture mata: st_local("s04_pf", cat("../dash_requirements.txt")[7])
    _w36_expect Q3604-3 `"("`s04_py'" == "# pythons: 3.11 3.12 3.13 3.14")"' "line 6 reads `s04_py'"
    _w36_expect Q3604-3 `"("`s04_pf'" == "# platforms: macos-arm64 macos-x86_64 linux-x86_64 linux-aarch64 windows-amd64")"' "line 7 reads `s04_pf'"
    _w36_done Q3604-3 "the lock covers Python 3.11 to 3.14 on the five platforms the help names"

    display as text "S04 end " c(current_date) " " c(current_time)
}
* ==== end S04 ====

* ==== append new blocks above this line ====

// ----------------------------------------------------------------
// Summary (test_wp29_truth.cscript's shape)
// ----------------------------------------------------------------
capture graph drop _all
capture dash clear
capture rmdir "`w36_work'"
local nfail    = ${w36_nfail}
local faillist "${w36_faillist}"
local ncase    = ${w36_ncase}
local only : env WP36_ONLY
macro drop w36_nfail w36_faillist w36_bad w36_ncase
display as text ""
display as text "============================================================"
if `ncase' == 0 {
    if `w36_N' > 1 & `"`macval(only)'"' == "" & "`w36_run'" == "" {
        display as text "test_wp36_truth: part `w36_k'/`w36_N' has no block to run"
        display as text "============================================================"
        exit 0
    }
    // A WP36_ONLY that names no block, or only a stub, ran nothing:
    // that is not a pass.
    display as error "  test_wp36_truth: no case ran (WP36_ONLY=`only')"
    display as text "============================================================"
    exit 9
}
else if `nfail' == 0 {
    display as text "  test_wp36_truth: ALL CHECKS PASSED"
    display as text "============================================================"
}
else {
    display as error "  test_wp36_truth: `nfail' CHECK(S) FAILED"
    display as error "  failing:`faillist'"
    display as text "============================================================"
    exit 9
}
