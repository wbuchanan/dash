#!/bin/sh
# Before a push, run `make check' (WP-25): pytest under the Python Stata
# ships and under the development interpreter, both strict, then the
# certification suite.  Any failure or unexpected skip stops the push.
# Installed by `make hooks'; `git push --no-verify' skips it.
cd "$(git rev-parse --show-toplevel)" || exit 1
exec make check
