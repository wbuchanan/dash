*! extract_natscale_axes_truth.do -- regenerate
*! test/fixtures/natscale_axes_truth.json from live Stata: the axes twoway
*! draws under by(), yscale(log), natscale overflow and %t date axes, and
*! _tsnatscale's own answers.
*!   by          sysuse auto; per command and panel k, .Graph.graphs[k]
*!               yaxis1/xaxis1 .major min/max/delta and plotregion1's
*!               yscale min/max.
*!   log         [lo, hi, N, min, max, delta]: 30 values from lo to hi
*!               evenly spaced in log (sysuse auto price where lo, hi are
*!               its range), `twoway scatter y x, yscale(log) ylabel(#N)'.
*!   overflow    [lo, hi, N, min, max, delta]: two observations lo and hi,
*!               `twoway scatter y x, ylabel(#N)'.
*!   date_graph  [kind, lo, hi, N, min, max, delta, list]: 30 values of a
*!               %t<kind> variable from lo to hi, `twoway scatter y t,
*!               xlabel(#N)', .Graph.xaxis1.major (list from dlg_tickpos
*!               when delta is 0).
*!   tsnatscale, tsnatscale_sweeps
*!               [unit, lo, hi, N, r(min), r(max), r(delta), r(list)] of
*!               `_tsnatscale lo hi N, <unit>'.
*! The probe inputs (the random ranges drawn once on 24sep2026 with set
*! seed 20260924, the log and date ranges, and the sweeps, run-length
*! encoded) are constants below, so a rerun asks Stata the same questions.
*! Strings in the python blocks spell a backtick \x60.
*!
*! Output: test/fixtures/natscale_axes_truth.json
*!
*! Run through the slot wrapper only:
*!
*!   DASH_REPO=<repo> <repo>/scripts/stata_slot.sh <scratch> <repo>/scripts/extract_natscale_axes_truth.do
*!
*! The git commit is read from a file `shell' wrote, never with shell=True.

clear all
set more off
set linesize 255

* Root (WP-30 P1.34): DASH_REPO, else the current directory when it is a
* dash tree; never another checkout.
local repo : environment DASH_REPO
if `"`macval(repo)'"' == "" local repo `"`c(pwd)'"'
mata: st_local("_za_bad", strofreal(any(strpos(st_local("repo"), (char(34), char(36), char(39), char(96), char(10), char(13))))))
if `_za_bad' {
    display as error "extract_natscale_axes_truth.do: DASH_REPO may not hold a double quote, dollar sign, single quote, backtick or line break"
    exit 198
}
while strlen(`"`repo'"') > 1 & inlist(substr(`"`repo'"', -1, 1), "/", char(92)) {
    local repo = substr(`"`repo'"', 1, strlen(`"`repo'"') - 1)
}
capture confirm file `"`repo'/dash.ado"'
local _za_rc = _rc
capture confirm file `"`repo'/test/run_all_cscripts.do"'
if `_za_rc' | _rc {
    local _za_show = substr(`"`repo'"', 1, 200)
    display as error `"extract_natscale_axes_truth.do: `_za_show' is not a dash tree; set DASH_REPO to the repository root"'
    exit 601
}
global ZA_REPO "`repo'"
global ZA_OUT "${ZA_REPO}/test/fixtures/natscale_axes_truth.json"
global dash_nobrowser 1
set graphics off

local work "`c(tmpdir)'dash_natscale_axes_probe"
capture mkdir "`work'"
global ZA_WORK "`work'"
quietly shell git -C "${ZA_REPO}" rev-parse HEAD > "${ZA_WORK}/git_head.txt"
global ZA_VERSION "`c(stata_version)'"
global ZA_BORN "`c(born_date)'"
global ZA_WHEN "`c(current_date)' `c(current_time)'"

