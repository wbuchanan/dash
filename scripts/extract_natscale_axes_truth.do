by, cur, ci = [], [], 0
for ln in lines("za_by_out.txt"):
    if ln == "END":
        by.append({"command": BY_COMMANDS[ci], "panels": cur})
        cur, ci = [], ci + 1
        continue
    f = ln.split("|")
    cur.append({"y_major": nums(f[1]), "x_major": nums(f[2]),
                "y_scale": nums(f[3])})
log = [[_in(r[0]), _in(r[1]), int(r[2])] + nums(b)
       for r, b in zip(_split(LOG_IN, 3), lines("za_log_out.txt"))]
overflow = [[int(v) for v in r] + nums(b)
            for r, b in zip(_split(OVERFLOW_IN, 3), lines("za_ovf_out.txt"))]
date_graph = []
for r, b in zip(_split(DATE_IN, 4), lines("za_date_out.txt")):
    m, l = b.split("|")
    m = nums(m)
    date_graph.append([r[0], int(r[1]), int(r[2]), int(r[3])] + m
                      + [nums(l) if m[2] == 0 else None])
ts, sw = [], []
for a, b in zip(lines("za_ts.txt"), lines("za_ts_out.txt")):
    a = a.split()
    f = b.split("|")
    row = ([a[1], int(a[2]), int(a[3]), int(a[4])] + [num(v) for v in f[:3]]
           + [nums(f[3]) or None])
    (ts if a[0] == "T" else sw).append(row)
try:
    with open(os.path.join(_work, "git_head.txt")) as fh:
        commit = fh.read().strip()
except OSError:
    commit = ""
meta = {"stata_version": G("ZA_VERSION"), "born_date": G("ZA_BORN"),
        "dash_commit": commit, "extracted": G("ZA_WHEN"),
        "source": "scripts/extract_natscale_axes_truth.do"}
meta.update(NOTES)
out = {"_meta": meta, "by": by, "log": log, "overflow": overflow,
       "date_graph": date_graph, "tsnatscale": ts, "tsnatscale_sweeps": sw}
with open(G("ZA_OUT"), "w", encoding="utf-8") as fh:
    json.dump(out, fh, separators=(",", ":"))
    fh.write("\n")
for name in ("git_head.txt", "za_by.txt", "za_log.txt", "za_ovf.txt",
             "za_date.txt", "za_ts.txt"):
    try:
        os.remove(os.path.join(_work, name))
    except OSError:
        pass
print("wrote", G("ZA_OUT"), len(by), len(log), len(overflow),
      len(date_graph), len(ts), len(sw))
end
