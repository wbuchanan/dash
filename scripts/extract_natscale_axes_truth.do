def _split(text, width):
    t = text.split()
    return [t[i:i + width] for i in range(0, len(t), width)]


def _in(w):
    return float(w) if ("." in w or "e" in w) else int(w)


_work = Macro.getGlobal("ZA_WORK")
with open(os.path.join(_work, "za_by.txt"), "w") as fh:
    for c in BY_COMMANDS:
        fh.write(c + "\n")
for name, text, width in (("za_log.txt", LOG_IN, 3), ("za_ovf.txt", OVERFLOW_IN, 3),
                          ("za_date.txt", DATE_IN, 4)):
    with open(os.path.join(_work, name), "w") as fh:
        for r in _split(text, width):
            fh.write(" ".join(r) + "\n")
with open(os.path.join(_work, "za_ts.txt"), "w") as fh:
    for r in _split(TS_IN, 4):
        fh.write("T " + " ".join(r) + "\n")
    for r in _split(SWEEP_RUNS, 7):
        n, lo, hi, dl, dh, c = (int(v) for v in r[1:])
        for k in range(c):
            fh.write("S %s %d %d %d\n" % (r[0], lo + k * dl, hi + k * dh, n))
end

capture program drop _za_major
program define _za_major
    * _za_major <object path> : c_local maj "min max delta" of <path>.major
    args p
    c_local maj "`.`p'.major.min' `.`p'.major.max' `.`p'.major.delta'"
end

* ---- by() ----
file open zab using "${ZA_WORK}/za_by_out.txt", write text replace
file open zbi using "${ZA_WORK}/za_by.txt", read text
file read zbi zcmd
while r(eof) == 0 {
    quietly sysuse auto, clear
    capture graph drop _all
    quietly `zcmd'
    local np "`.Graph.graphs.arrnels'"
    forvalues k = 1/`np' {
        _za_major Graph.graphs[`k'].yaxis1
        local ym "`maj'"
        _za_major Graph.graphs[`k'].xaxis1
        local xm "`maj'"
        local ys "`.Graph.graphs[`k'].plotregion1.yscale.min' `.Graph.graphs[`k'].plotregion1.yscale.max'"
        file write zab `"`k'|`ym'|`xm'|`ys'"' _n
    }
    file write zab "END" _n
    file read zbi zcmd
}
file close zbi
file close zab

* ---- log and overflow (y axis) ----
foreach part in log ovf {
    file open zgi using "${ZA_WORK}/za_`part'.txt", read text
    file open zgo using "${ZA_WORK}/za_`part'_out.txt", write text replace
    file read zgi zline
    while r(eof) == 0 {
        tokenize `"`zline'"'
        capture graph drop _all
        if "`part'" == "log" & "`1'" == "3291" & "`2'" == "15906" {
            quietly sysuse auto, clear
            quietly twoway scatter price mpg, yscale(log) ylabel(#`3')
        }
        else if "`part'" == "log" {
            clear
            quietly set obs 30
            quietly generate double y = exp(ln(`1') + (_n - 1) / 29 * (ln(`2') - ln(`1')))
            quietly generate x = _n
            quietly twoway scatter y x, yscale(log) ylabel(#`3')
        }
        else {
            clear
            quietly set obs 2
            quietly generate double y = cond(_n == 1, `1', `2')
            quietly generate x = _n
            quietly twoway scatter y x, ylabel(#`3')
        }
        _za_major Graph.yaxis1
        file write zgo `"`maj'"' _n
        file read zgi zline
    }
    file close zgi
    file close zgo
}

* ---- date axes (x axis) ----
file open zdi using "${ZA_WORK}/za_date.txt", read text
file open zdo using "${ZA_WORK}/za_date_out.txt", write text replace
file read zdi zline
while r(eof) == 0 {
    tokenize `"`zline'"'
    capture graph drop _all
    clear
    quietly set obs 30
    quietly generate double t = `2' + (`3' - `2') * (_n - 1) / 29
    if "`1'" != "c" quietly replace t = round(t)
    format t %t`1'
    quietly generate y = _n
    quietly twoway scatter y t, xlabel(#`4')
    _za_major Graph.xaxis1
    local nt "`.Graph.xaxis1.major.dlg_tickpos.arrnels'"
    if "`nt'" == "" | "`nt'" == "." local nt 0
    local v ""
    forvalues i = 1/`nt' {
        local v "`v' `.Graph.xaxis1.major.dlg_tickpos[`i']'"
    }
    file write zdo `"`maj'|`v'"' _n
    file read zdi zline
}
file close zdi
file close zdo
capture graph drop _all

* ---- _tsnatscale ----
file open zti using "${ZA_WORK}/za_ts.txt", read text
file open zto using "${ZA_WORK}/za_ts_out.txt", write text replace
file read zti zline
while r(eof) == 0 {
    tokenize `"`zline'"'
    local word : word `=strpos("dwmqhy", "`2'")' of daily weekly monthly quarterly halfyearly yearly
    quietly _tsnatscale `3' `4' `5', `word'
    file write zto `"`=strofreal(r(min), "%24.17g")'|`=strofreal(r(max), "%24.17g")'|`=strofreal(r(delta), "%24.17g")'|`r(list)'"' _n
    file read zti zline
}
file close zti
file close zto

