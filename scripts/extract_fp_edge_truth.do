import json, os
from sfi import Macro


def G(k):
    return Macro.getGlobal(k)


out = {
    "_about": ("twoway fpfit and fpfitci on edge cases, " + G("ZF_VERSION")
               + " (the WP-18 review): the data each probe used, and the "
               "plotted serset of each graph read back with serset use "
               "(float32; rows with a missing fit dropped, a missing band "
               "kept as null; rc is twoway's return code). tc: hourly %tc "
               "over 3 days; tc2: 5-minute %tc over a day; d30/d90/daily: "
               "%td; bin0/binx: x with two values; n2/n3: auto in 1/2, 1/3; "
               "fw3: collapsed data with fweights; yc: constant y; awneg: a "
               "negative aweight; fwn: non-integer fweights; xoff: x offset "
               "by 1e6. Empty stata fp/ci means twoway drew nothing."),
    "cases": CASES,
}
work = G("ZF_WORK")
try:
    with open(os.path.join(work, "git_head.txt")) as fh:
        commit = fh.read().strip()
except OSError:
    commit = ""
out["_meta"] = {"stata_version": G("ZF_VERSION"), "born_date": G("ZF_BORN"),
                "dash_commit": commit, "extracted": G("ZF_WHEN"),
                "source": "scripts/extract_fp_edge_truth.do"}
with open(G("ZF_OUT"), "w", encoding="utf-8") as fh:
    json.dump(out, fh, indent=1)
    fh.write("\n")
try:
    os.remove(os.path.join(work, "git_head.txt"))
except OSError:
    pass
print("wrote", G("ZF_OUT"))
end
