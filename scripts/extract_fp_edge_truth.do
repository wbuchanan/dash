    "tc2": {"y": ys("tc2"), "x": [1931385600000.0 + 300000.0 * i for i in range(288)]},
    "d30": {"y": ys("d30"), "x": [23436.0 + i for i in range(30)]},
    "d90": {"y": ys("d90"), "x": [23011.0 + i // 2 for i in range(180)]},
    "daily": {"y": ys("daily"), "x": [21915.0 + i for i in range(366)]},
    "bin0": {"y": ys("bin0"), "x": list(BIN0_X)},
    "binx": {"y": a["mpg"], "x": a["foreign"]},
    "n2": {"y": a["mpg"][:2], "x": a["weight"][:2]},
    "n3": {"y": a["mpg"][:3], "x": a["weight"][:3]},
    "fw3": {"y": [10.0, 14.0, 13.0], "x": [1.0, 2.0, 4.0], "w": [5.0, 7.0, 6.0],
            "wtype": "fweight"},
    "yc": {"y": [20.0] * 74, "x": a["weight"]},
    "awneg": {"y": a["mpg"], "x": a["weight"],
              "w": [-1.0] * 5 + a["price"][5:], "wtype": "aweight"},
    "fwn": {"y": a["mpg"], "x": a["weight"],
            "w": [p / 1000.0 for p in a["price"]], "wtype": "fweight"},
    "xoff": {"y": a["mpg"], "x": [w + 1e6 for w in a["weight"]]},
}
for name, c in CASES.items():
    Macro.setGlobal("ZF_WT_" + name, " [%s=w]" % c["wtype"] if "w" in c else "")
Macro.setGlobal("ZF_CASES", " ".join(CASES))
