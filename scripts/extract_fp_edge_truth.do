def ys(k):
    return [float(v) for v in Y[k].split()]


def put(cols):
    """Fill the empty data in memory with cols (name -> list of doubles)."""
    n = len(next(iter(cols.values())))
    Data.setObsTotal(n)
    for name, vals in cols.items():
        Data.addVarDouble(name)
        Data.store(name, None, vals)


def auto():
    """sysuse auto's (in memory) mpg, weight, foreign and price as lists."""
    return {v: [float(r[0] if isinstance(r, list) else r) for r in Data.get(v)]
            for v in ("mpg", "weight", "foreign", "price")}


def num(v):
    return None if v is None or v != v or abs(v) >= 8.988e307 else float(v)


def load(name):
    """Put case name's inputs in the (empty) data in memory."""
    c = CASES[name]
    cols = {"y": c["y"], "x": c["x"]}
    if "w" in c:
        cols["w"] = c["w"]
    put(cols)


def grab(name, which, rc, drew):
    """Record the serset in memory (fit[, lower, upper], x) for case name's
    fpfit or fpfitci, the rows whose fit is missing dropped; empty lists
    when twoway drew nothing."""
    ncol = 4 if which == "fpfitci" else 2
    names = (["fit", "lower", "upper"] if ncol == 4 else ["fit"]) + ["fit_x"]
    out = {k: [] for k in names}
    if drew:
        nv = Data.getVarCount()
        if nv != ncol:
            raise SystemExit("extract_fp_edge_truth.do: %s %s serset has %d columns, not %d" % (name, which, nv, ncol))
        for r in Data.get(None, missingval=None):
            if num(r[0]) is None:
                continue
            for k, v in zip(names, r):
                out[k].append(num(v))
    out["rc"] = int(rc)
    CASES[name].setdefault("stata", {})["fp" if which == "fpfit" else "ci"] = out
    print("ZF", name, which, rc, len(out["fit"]))


a = auto()
