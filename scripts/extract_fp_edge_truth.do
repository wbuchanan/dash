* Each case: fpfit and fpfitci drawn with nodraw, and the first plot's
* serset (fpfitci's band holds the fit, the band and x) read back.
foreach c of global ZF_CASES {
    foreach t in fpfit fpfitci {
        clear
        python: load("`c'")
        capture graph drop _all
        serset clear
        capture twoway `t' y x ${ZF_WT_`c'}, nodraw
        local rc = _rc
        local cls "`.Graph.plotregion1.plot1.classname'"
        local id "`.Graph.plotregion1.plot1.serset.id'"
        local drew = `rc' == 0 & "`cls'" != "" & "`id'" != ""
        if `drew' {
            serset set `id'
            serset use, clear
        }
        python: grab("`c'", "`t'", `rc', `drew')
    }
}

