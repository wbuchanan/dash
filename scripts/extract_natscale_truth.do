*! extract_natscale_truth.do -- regenerate test/fixtures/natscale_truth.json
*! from live Stata.  Two parts:
*!   drawn    -- for 24 variables of four shipped datasets and N = 2..12:
*!               `twoway scatter <var> __x, ylabel(#N)' (graphics off), the
*!               drawn .Graph.yaxis1.major min/max/delta, the ticks they give
*!               (min in steps of delta while <= max), the variable's
*!               summarize min/max, and `_natscale <min> <max> N'.
*!   natscale -- `_natscale lo hi N' over 3,000 fixed ranges, rows
*!               [lo, hi, N, r(min), r(max), r(delta), r(n)].  The ranges
*!               were drawn at random once (24sep2026) and are held below
*!               as constants, so a rerun asks Stata the same questions.
*! Values are written to 15 significant digits, as the fixture always was.
*! Strings in the python blocks spell a backtick \x60.
*!
*! Output: test/fixtures/natscale_truth.json
*!
*! Run through the slot wrapper only:
*!
*!   DASH_REPO=<repo> <repo>/scripts/stata_slot.sh <scratch> <repo>/scripts/extract_natscale_truth.do
*!
*! The git commit is read from a file `shell' wrote, never with shell=True.

clear all
set more off
set linesize 255

* Root (WP-30 P1.34): DASH_REPO, else the current directory when it is a
* dash tree; never another checkout.
local repo : environment DASH_REPO
if `"`macval(repo)'"' == "" local repo `"`c(pwd)'"'
mata: st_local("_zn_bad", strofreal(any(strpos(st_local("repo"), (char(34), char(36), char(39), char(96), char(10), char(13))))))
if `_zn_bad' {
    display as error "extract_natscale_truth.do: DASH_REPO may not hold a double quote, dollar sign, single quote, backtick or line break"
    exit 198
}
while strlen(`"`repo'"') > 1 & inlist(substr(`"`repo'"', -1, 1), "/", char(92)) {
    local repo = substr(`"`repo'"', 1, strlen(`"`repo'"') - 1)
}
capture confirm file `"`repo'/dash.ado"'
local _zn_rc = _rc
capture confirm file `"`repo'/test/run_all_cscripts.do"'
if `_zn_rc' | _rc {
    local _zn_show = substr(`"`repo'"', 1, 200)
    display as error `"extract_natscale_truth.do: `_zn_show' is not a dash tree; set DASH_REPO to the repository root"'
    exit 601
}
global ZN_REPO "`repo'"
global ZN_OUT "${ZN_REPO}/test/fixtures/natscale_truth.json"
global dash_nobrowser 1
set graphics off

local work "`c(tmpdir)'dash_natscale_probe"
capture mkdir "`work'"
global ZN_WORK "`work'"
quietly shell git -C "${ZN_REPO}" rev-parse HEAD > "${ZN_WORK}/git_head.txt"
global ZN_VERSION "`c(stata_version)'"
global ZN_BORN "`c(born_date)'"
global ZN_WHEN "`c(current_date)' `c(current_time)'"

* ---- drawn: the y axis twoway draws for #N, beside _natscale ----
file open znd using "${ZN_WORK}/ns_drawn.txt", write text replace
foreach dv in auto:mpg auto:weight auto:price auto:length auto:displacement ///
    auto:headroom auto:trunk auto:turn auto:gear_ratio nlsw88:wage ///
    nlsw88:hours nlsw88:ttl_exp nlsw88:tenure nlsw88:age nlsw88:grade ///
    lifeexp:lexp lifeexp:gnppc lifeexp:safewater lifeexp:popgrowth ///
    census:pop census:medage census:death census:marriage census:divorce {
    local p = strpos("`dv'", ":")
    local ds = substr("`dv'", 1, `p' - 1)
    local v = substr("`dv'", `p' + 1, .)
    quietly sysuse `ds', clear
    quietly generate long __x = _n
    quietly summarize `v'
    local lo = strofreal(r(min), "%21x")
    local hi = strofreal(r(max), "%21x")
    local dmin = strofreal(r(min), "%24.17g")
    local dmax = strofreal(r(max), "%24.17g")
    forvalues n = 2/12 {
        quietly _natscale `lo' `hi' `n'
        local ns = strofreal(r(min), "%24.17g") + " " + strofreal(r(max), "%24.17g") + " " + strofreal(r(delta), "%24.17g")
        capture graph drop _all
        quietly twoway scatter `v' __x, ylabel(#`n')
        local g "`.Graph.yaxis1.major.min' `.Graph.yaxis1.major.max' `.Graph.yaxis1.major.delta'"
        file write znd "`ds' `v' `n' `dmin' `dmax' `ns' `g'" _n
    }
    capture graph drop _all
}
file close znd

