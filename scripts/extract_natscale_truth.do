import json, os
from sfi import Macro


def G(k):
    return Macro.getGlobal(k)


NOTES = {"why": ("BUGS.md \x27ylabel(#N) and xlabel(#N) ticks fall where Bokeh puts "
         "them, not where twoway does\x27. twoway\x27s #N rule is tickset_g.class\x27s "
         "set_ticks: \x60gdi natscale <scale.min> <scale.max> <N>\x27 (the "
         "builtin behind _natscale), ticks from r(min) in steps of r(delta) "
         "while <= r(max); #1 is minmax."),
 "drawn": ("For each variable and N = 2..12: \x60twoway scatter <var> __x, ylabel(#N)\x27 "
           "(set graphics off), then \x60.Graph.yaxis1.major.min\x27, \x60.major.max\x27 "
           "and \x60.major.delta\x27 read from the drawn graph; \x27ticks\x27 "
           "lists min, min+delta, ... <= max. \x27natscale\x27 is \x60_natscale "
           "<r(min) of summarize> <r(max)> N\x27 -- identical to the graph\x27s "
           "record in all 264 cases, so the axis\x27s scale is the data\x27s "
           "min and max."),
 "natscale": ("3,000 random ranges, drawn once on 24sep2026 and held as constants "
              "in the generator (set seed 12345; lo = (U*2-0.6)*10^e for e in -5..6, "
              "width U^2*10^(e+j-1), 15% rounded, N = 1..25): \x60_natscale lo "
              "hi N\x27, rows [lo, hi, N, r(min), r(max), r(delta), r(n)].  Rows "
              "with N = 1 are kept; dash draws #1 as minmax (tickset\x27s rule), "
              "not from natscale."),
 "quirk": ("natscale sometimes reports r(max) as the data\x27s max (not a multiple "
           "of r(delta)), e.g. 0.13 2.12 9 -> 0 2.12 2; the ticks twoway draws "
           "are then r(min) in steps of r(delta) while <= r(max) (graph record: "
           "\x60.major.max\x27 2.1199999, ticks 0 and 2).")}


def g15(s):
    return float("%.15g" % float(s))


work = G("ZN_WORK")
drawn = []
with open(os.path.join(work, "ns_drawn.txt"), encoding="utf-8") as fh:
    for ln in fh:
        f = ln.split()
        if not f:
            continue
        gmin, gmax, gdel = float(f[8]), float(f[9]), float(f[10])
        ticks, k = [], 0
        while gmin + k * gdel <= gmax + 1e-9 * abs(gdel) and k <= 1000:
            ticks.append(g15(gmin + k * gdel))
            k += 1
            if gdel == 0:
                break
        drawn.append({"dataset": f[0], "var": f[1], "n": int(f[2]),
                      "min": g15(f[3]), "max": g15(f[4]), "ticks": ticks,
                      "natscale": [g15(f[5]), g15(f[6]), g15(f[7])]})
rows = []
with open(os.path.join(work, "ns_out.txt"), encoding="utf-8") as fh:
    for ln in fh:
        f = ln.split()
        if f:
            rows.append([float(f[0]), float(f[1]), int(f[2]), g15(f[3]),
                         g15(f[4]), g15(f[5]), int(float(f[6]))])
try:
    with open(os.path.join(work, "git_head.txt")) as fh:
        commit = fh.read().strip()
except OSError:
    commit = ""
meta = {"stata_version": G("ZN_VERSION"), "born_date": G("ZN_BORN"),
        "dash_commit": commit, "extracted": G("ZN_WHEN"),
        "source": "scripts/extract_natscale_truth.do"}
meta.update(NOTES)
out = {"_meta": meta, "drawn": drawn, "natscale": rows}
with open(G("ZN_OUT"), "w", encoding="utf-8") as fh:
    json.dump(out, fh, indent=0)
    fh.write("\n")
for name in ("git_head.txt", "ns_in.txt"):
    try:
        os.remove(os.path.join(work, name))
    except OSError:
        pass
print("wrote", G("ZN_OUT"), len(drawn), "drawn,", len(rows), "ranges")
end
