* stmono1.scheme
* dash translation of Stata's stmono1 graph scheme.
*
* SOURCE            : /Applications/StataNow/ado/base/s/scheme-stmono1.scheme
*                     (resolved through its #include chain:
*                      s2color -> s1color -> s1mono -> stmono1,
*                      plus /Applications/StataNow/ado/base/style/*.style)
* STATA VERSION     : StataNow 19.5 (MP), born 12 Aug 2026
* EXTRACTED (UTC)   : 2026-09-18T18:58:04Z
* DERIVED FROM      : test/fixtures/scheme_truth.json ["stmono1"], generated by
*                     scripts/extract_scheme_truth.py.  Regenerate that fixture
*                     and re-derive this file if Stata is upgraded; the values
*                     below were last true as of the date above.
*
* Every colour is written as a RESOLVED #rrggbb hex triplet, never as a Stata
* colour name.  OptionTranslator._COLOR_MAP covers only a subset of Stata's
* colour names, and SchemeParser._color() silently substitutes its #000000
* default for any token it cannot translate -- which is how an unresolved name
* turns a whole scheme black.  Hex is self-contained and cannot be swallowed.
*
* Property categories used by dash SchemeParser:
*   color, symbol, linepattern, linewidth, intensity, gsize, graphsize,
*   symbolsize, clockdir, numstyle, yesno
*
* No property of stmono1 is null in the fixture, so nothing is omitted here.

label "Stata mono 1"

* ---------------------------------------------------------------------------
* Background and region colors
* ---------------------------------------------------------------------------
color background      #ffffff
color plotregion      #ffffff
color legend          #ffffff
color legend_line     #ffffff
color major_grid      #e0e0e0
color minor_grid      #505050
color heading         #000000
color axisline        #000000

* ---------------------------------------------------------------------------
* Per-plot color cycle (p1-p15)   [Stata: color p1 .. color p15]
* ---------------------------------------------------------------------------
color p1      #606060
color p2      #a0a0a0
color p3      #808080
color p4      #404040
color p5      #000000
color p6      #c0c0c0
color p7      #202020
color p8      #707070
color p9      #909090
color p10     #b0b0b0
color p11     #d0d0d0
color p12     #505050
color p13     #303030
color p14     #c0c0c0
color p15     #505050

* Per-plot line color.  Stata resolves all 15 through the single directive
* "color pline"; dash has no pstub key, so the one value is spelled out p1-p15.
color p1line   #000000
color p2line   #000000
color p3line   #000000
color p4line   #000000
color p5line   #000000
color p6line   #000000
color p7line   #000000
color p8line   #000000
color p9line   #000000
color p10line  #000000
color p11line  #000000
color p12line  #000000
color p13line  #000000
color p14line  #000000
color p15line  #000000

* Per-plot bar/area fill color   [Stata: falls back to color p1 .. color p15]
color p1bar    #606060
color p2bar    #a0a0a0
color p3bar    #808080
color p4bar    #404040
color p5bar    #000000
color p6bar    #c0c0c0
color p7bar    #202020
color p8bar    #707070
color p9bar    #909090
color p10bar   #b0b0b0
color p11bar   #d0d0d0
color p12bar   #505050
color p13bar   #303030
color p14bar   #c0c0c0
color p15bar   #505050

* Per-plot marker fill color   [Stata: falls back to color p1 .. color p15]
color p1mark   #606060
color p2mark   #a0a0a0
color p3mark   #808080
color p4mark   #404040
color p5mark   #000000
color p6mark   #c0c0c0
color p7mark   #202020
color p8mark   #707070
color p9mark   #909090
color p10mark  #b0b0b0
color p11mark  #d0d0d0
color p12mark  #505050
color p13mark  #303030
color p14mark  #c0c0c0
color p15mark  #505050

* ---------------------------------------------------------------------------
* Marker symbol cycle
* ---------------------------------------------------------------------------
symbol p1     circle
symbol p2     diamond
symbol p3     square
symbol p4     triangle
symbol p5     x
symbol p6     plus
symbol p7     circle_hollow
symbol p8     diamond_hollow
symbol p9     square_hollow
symbol p10    triangle_hollow
symbol p11    smcircle
symbol p12    smdiamond
symbol p13    smsquare
symbol p14    smtriangle
symbol p15    smx

* ---------------------------------------------------------------------------
* Line patterns for line/connected plots
* ---------------------------------------------------------------------------
linepattern p1line   solid
linepattern p2line   dash
linepattern p3line   vshortdash
linepattern p4line   longdash_dot
linepattern p5line   longdash
linepattern p6line   dash_dot
linepattern p7line   dot
linepattern p8line   shortdash_dot
linepattern p9line   tight_dot
linepattern p10line  dash_dot_dot
linepattern p11line  longdash_shortdash
linepattern p12line  dash_3dot
linepattern p13line  longdash_dot_dot
linepattern p14line  shortdash_dot_dot
linepattern p15line  longdash_3dot

* ---------------------------------------------------------------------------
* Line widths (Stata linewidth style names)
* ---------------------------------------------------------------------------
linewidth p           medium
linewidth major_grid  medium

* ---------------------------------------------------------------------------
* Fill intensities
* "intensity area" is not set by any Stata base scheme; stmono1 resolves it
* through the bare intensity class default, which is "full".
* ---------------------------------------------------------------------------
intensity p        inten80
intensity bar      full
intensity area     full

* ---------------------------------------------------------------------------
* Font sizes (Stata gsize keywords)
* ---------------------------------------------------------------------------
gsize text          medium
gsize heading       large
gsize axis_title    medsmall
gsize tick_label    medsmall
gsize note          small

* ---------------------------------------------------------------------------
* Graph dimensions, in inches (consumed by section 10)
* ---------------------------------------------------------------------------
graphsize x   7.5
graphsize y   4.5

* ---------------------------------------------------------------------------
* Default marker size, legend placement, and major-grid switches
* ---------------------------------------------------------------------------
symbolsize p              small
clockdir legend_position  3
numstyle legend_cols      1
yesno draw_major_hgrid    no
yesno draw_major_grid     no
